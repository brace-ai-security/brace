                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 50
                }
              }
            }
          ]
        },
        {
          "ruleId": "E06",
          "level": "error",
          "message": {
            "text": "The agent talks straight to the accounting server. Nothing in between checks, limits or logs each call.\n\nLead: Infrastructure. Fix before release, or get a written risk approval.\n\nHow to fix:\n1. Choose a gateway that sits between the agent and the accounting server.\n2. Set it to check who is calling and which tool they may use.\n3. Set a limit on how many calls the agent can make each minute.\n4. Turn on a log entry for every call.\n5. Change the address in `.mcp.json` so the agent connects to the gateway, not the server.\n\nDone when: Every accounting call goes through the gateway and shows up in its log."
          },
