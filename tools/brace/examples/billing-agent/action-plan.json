      ],
      "problem": "The agent can email any address, give credits with no approval, and refund up to $500 with no approval.",
      "steps": [
        "Make a list of actions that move money or send messages outside: refunds, credits and emails.",
        "For each one, ask a person to approve it before it runs.",
        "Only send email to the customer's address on file. Refuse any other address.",
        "Send email as plain text, not HTML, so it cannot load images or links from other sites.",
        "Add a test for each action that runs it with no approval. Each one should be refused."
      ],
      "steps_plain": true,
      "done_when": "Refunds, credits and emails to new addresses all wait for a person to approve them.",
      "effort": "medium",
      "test": null,
      "evidence": [
