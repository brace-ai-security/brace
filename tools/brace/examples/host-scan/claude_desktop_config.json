{
  "mcpServers": {
    "travel-docs": {
      "type": "http",
      "url": "https://travel-docs.internal.example/mcp?key=should-not-be-copied"
    },
    "web-fetch": {
      "command": "/usr/local/bin/npx",
      "args": ["-y", "example-web-fetch-mcp", "--api-key", "sk-sample-not-a-real-key"],
      "env": {"FETCH_TOKEN": "tok_sample_value_never_copied", "LOG_LEVEL": "info"}
    }
  }
}
