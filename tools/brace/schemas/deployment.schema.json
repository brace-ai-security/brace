{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brace.dev/schemas/deployment.schema.json",
  "title": "BRACE deployment record (.brace/deployment.yaml)",
  "description": "classification is deliberately not required here: a missing or incomplete rating is a NO-GO reason, not an invalid file.",
  "type": "object",
  "required": ["brace_checklist", "deployment", "roles"],
  "additionalProperties": false,
  "properties": {
    "brace_checklist": {"$ref": "#/$defs/date"},
    "deployment": {
      "type": "object",
      "required": ["name", "environment", "release"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "environment": {"$ref": "#/$defs/text"},
        "release": {"type": ["string", "integer"]},
        "task": {"type": "string"},
        "allowed_actions": {"type": "array", "items": {"type": "string"}},
        "tenants": {"type": "string"},
        "data_sensitivity": {"type": "string"},
        "worst_credible_damage": {"type": "string"}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stakes": {"enum": ["high", "low"]},
        "autonomy": {"enum": ["high", "low"]},
        "rationale": {"type": "string"},
        "approved_by": {"type": "string"}
      }
    },
    "agent_type_id": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "manifest": {"$ref": "#/$defs/text"}
      }
    },
    "roles": {
      "type": "object",
      "required": ["governance"],
      "additionalProperties": false,
      "properties": {
        "agent_team": {"$ref": "#/$defs/people"},
        "operations": {"$ref": "#/$defs/people"},
        "security": {"$ref": "#/$defs/people"},
        "infrastructure": {"$ref": "#/$defs/people"},
        "governance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "business_owner": {"$ref": "#/$defs/people"},
        "data_privacy": {"$ref": "#/$defs/people"},
        "model_team": {"$ref": "#/$defs/people"},
        "vendors": {"$ref": "#/$defs/people"},
        "independent_audit": {"$ref": "#/$defs/people"}
      }
    },
    "approvals": {
      "type": "object",
      "required": ["provider"],
      "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["github", "none"]},
        "approvers": {
          "type": "array",
          "items": {"type": "string", "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:/[A-Za-z0-9._-]+)?$"}
        }
      }
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "text": {"type": "string", "minLength": 1},
    "people": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
