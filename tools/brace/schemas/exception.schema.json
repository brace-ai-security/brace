{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brace.dev/schemas/exception.schema.json",
  "title": "BRACE risk acceptance (.brace/exceptions/<ITEM>-<slug>.yaml)",
  "description": "Field types are checked here. A missing or blank field is not a schema error: brace.py check reports it as an incomplete exception (NO-GO), because a blank exception counts as an open gap. There is no expiry field. Approval comes from the merged pull request review, not from accepted_by.",
  "type": "object",
  "required": ["item"],
  "additionalProperties": false,
  "properties": {
    "item": {"type": "string", "pattern": "^[BRACE][0-9]{2}$"},
    "threat": {"type": "string"},
    "affected_systems": {"type": "string"},
    "compensating_controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "control": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    },
    "accepted_by": {"type": "string"},
    "accepted_on": {"$ref": "#/$defs/date"},
    "remediation_owner": {"type": "string"},
    "tracking": {"type": "string"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
