{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brace.dev/schemas/manifest.schema.json",
  "title": "BRACE agent-type-id manifest (.brace/manifest.yaml)",
  "description": "Each input has a name and exactly one of value (a literal) or path (a file or directory, relative to the repository root). Names must be unique; brace.py checks that.",
  "type": "object",
  "required": ["inputs"],
  "additionalProperties": false,
  "properties": {
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "value": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        },
        "oneOf": [
          {"required": ["value"]},
          {"required": ["path"]}
        ]
      }
    }
  }
}
