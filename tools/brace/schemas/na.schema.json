{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brace.dev/schemas/na.schema.json",
  "title": "BRACE N/A decision (.brace/na/<ITEM>-<slug>.yaml)",
  "description": "Field types are checked here. A missing reason, evidence, or reviewer is reported by brace.py check as an unresolved record finding. Approval comes from the merged pull request review.",
  "type": "object",
  "required": ["item"],
  "additionalProperties": false,
  "properties": {
    "item": {"type": "string", "pattern": "^[BRACE][0-9]{2}$"},
    "reason": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "reviewer": {"type": "string"},
    "reviewed_on": {"$ref": "#/$defs/date"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
