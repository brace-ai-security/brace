{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://braceframework.org/schemas/action-plan.schema.json",
  "title": "BRACE action plan (brace-action-plan/1)",
  "description": "Structured output of tools/brace/action_plan.py --json, for CI/CD. One entry per component, connection and action. Fields may be added in later minor versions; the schema id changes on incompatible changes.",
  "type": "object",
  "required": ["schema", "agent", "summary", "components", "connections", "actions", "notes", "limits"],
  "properties": {
    "schema": {"const": "brace-action-plan/1"},
    "agent": {"type": "string"},
    "repo": {"type": ["string", "null"]},
    "commit": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"]},
    "summary": {
      "type": "object",
      "required": ["actions", "gaps", "needs_evidence", "g1_gaps", "risky_connections", "components",
                   "input_notes", "stale_map_entries"],
      "properties": {
        "actions": {"type": "integer", "minimum": 0},
        "gaps": {"type": "integer", "minimum": 0},
        "needs_evidence": {"type": "integer", "minimum": 0},
        "g1_gaps": {"type": "integer", "minimum": 0},
        "risky_connections": {"type": "integer", "minimum": 0},
        "components": {"type": "integer", "minimum": 0},
        "input_notes": {"type": "integer", "minimum": 0},
        "stale_map_entries": {"type": "integer", "minimum": 0}
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "name", "kind", "source", "actions"],
        "properties": {
          "ref": {"type": "string", "description": "CycloneDX bom-ref in the topology"},
          "name": {"type": "string"},
          "kind": {"type": "string"},
          "trust_zone": {"type": ["string", "null"]},
          "source": {"type": "string", "enum": ["agent_config", "mcp_config", "inventory", "traced", "repository", "unknown"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "actions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "risks", "risk_text", "actions"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "label": {"type": "string"},
          "risks": {"type": "array", "items": {"enum": ["writes", "money", "personal_data", "untrusted_input",
                                                          "code_execution", "credential", "crosses_boundary", "unknown_zone"]}},
          "risk_text": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": ["string", "null"]},
          "source": {"type": "string"},
          "actions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "gate", "rating", "priority", "priority_rank", "lead_role", "lead",
                     "assignee", "components", "problem", "steps", "steps_plain", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[BRACE][0-9]{2}$"},
          "title": {"type": "string"},
          "gate": {"enum": ["G1", "G2", "G3"]},
          "rating": {"enum": ["gap", "needs_evidence"]},
          "priority": {"type": "string"},
          "priority_rank": {"type": "integer", "minimum": 1, "maximum": 6},
          "lead_role": {"type": "string"},
          "lead": {"type": "string"},
          "assignee": {"type": ["string", "null"]},
          "components": {"type": "array", "items": {"type": "string"}},
          "problem": {"type": "string"},
          "steps": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "steps_plain": {"type": "boolean", "description": "false when steps fell back to the reviewer's next_step"},
          "done_when": {"type": ["string", "null"]},
          "effort": {"enum": ["small", "medium", "large", null]},
          "test": {"type": ["object", "null"], "properties": {"file": {"type": "string"}, "code": {"type": "string"}, "run": {"type": "string"}}},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "also_affects": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "stale_map_entries": {"type": "array", "items": {"type": "string"}},
    "limits": {"type": "array", "items": {"type": "string"}}
  }
}
