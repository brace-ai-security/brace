{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brace.dev/schemas/record.schema.json",
  "title": "BRACE evidence record (.brace/record.yaml)",
  "description": "One entry per checklist item. Whether all 53 are present, and whether each outcome is backed, is decided by brace.py check, not by this schema.",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[BRACE][0-9]{2}$": {"$ref": "#/$defs/item"}
      }
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "stem": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "item": {
      "type": "object",
      "required": ["outcome"],
      "additionalProperties": false,
      "properties": {
        "outcome": {"enum": ["pass", "gap", "na", "not_reviewed"]},
        "lead": {"type": "string"},
        "shares": {"type": "array", "items": {"type": "string"}},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "link": {"type": "string"},
              "date": {"$ref": "#/$defs/date"},
              "note": {"type": "string"}
            }
          }
        },
        "verified_by": {"type": "string"},
        "notes": {"type": "string"},
        "exception": {"$ref": "#/$defs/stem"},
        "na": {"$ref": "#/$defs/stem"}
      }
    }
  }
}
