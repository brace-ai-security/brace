            {
              "id": "AP04",
              "name": "MCPServerInstalledFromAnUnpinnedPackage",
              "shortDescription": {
                "text": "MCP server installed from an unpinned package"
              },
              "fullDescription": {
                "text": "npx/uvx/bunx fetch the newest version at every start. A hijacked or malicious update becomes code running with your agent's access, with no review."
              },
              "help": {
                "text": "Pin an exact version (for example pkg@1.4.2), or install it once from a reviewed lockfile. BRACE checklist: E02, E03, C05.",
                "markdown": "npx/uvx/bunx fetch the newest version at every start. A hijacked or malicious update becomes code running with your agent's access, with no review.\n\n**Fix:** Pin an exact version (for example pkg@1.4.2), or install it once from a reviewed lockfile.\n\nBRACE checklist: E02, E03, C05. [Details](https://braceframework.org/anti-patterns/#ap04-mcp-server-installed-from-an-unpinned-package)"
              },
              "helpUri": "https://braceframework.org/anti-patterns/#ap04-mcp-server-installed-from-an-unpinned-package",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "ai-agent",
                  "external/cwe/cwe-829"
                ]
              },
              "relationships": [
                {
                  "target": {
                    "id": "ASI04",
                    "toolComponent": {
                      "name": "OWASP Top 10 for Agentic Applications"
                    }
                  },
                  "kinds": [
                    "relevant"
                  ]
                },
