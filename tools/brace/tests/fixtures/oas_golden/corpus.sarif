            {
              "id": "AP06",
              "name": "AgentAllowedToRunAnyShellCommand",
              "shortDescription": {
                "text": "Agent allowed to run any shell command"
              },
              "fullDescription": {
                "text": "An allow-rule like Bash(*) or a bare Bash lets the agent run any command without asking. That includes curl to send your files out, rm -rf and git push --force."
              },
              "help": {
                "text": "Allow only the specific commands the task needs, such as Bash(npm test), and keep deny rules for network and destructive commands. BRACE checklist: B01, B05.",
                "markdown": "An allow-rule like Bash(*) or a bare Bash lets the agent run any command without asking. That includes curl to send your files out, rm -rf and git push --force.\n\n**Fix:** Allow only the specific commands the task needs, such as Bash(npm test), and keep deny rules for network and destructive commands.\n\nBRACE checklist: B01, B05. [Details](https://braceframework.org/anti-patterns/#ap06-agent-allowed-to-run-any-shell-command)"
              },
              "helpUri": "https://braceframework.org/anti-patterns/#ap06-agent-allowed-to-run-any-shell-command",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "ai-agent"
                ]
              },
              "relationships": [
                {
                  "target": {
                    "id": "ASI02",
                    "toolComponent": {
