{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "open-agent-security",
          "version": "VERSION",
          "informationUri": "https://braceframework.org/anti-patterns/",
          "rules": [
            {
              "id": "AP01",
              "name": "AgentRunsWithAllPermissionChecksTurnedOff",
              "shortDescription": {
                "text": "Agent runs with all permission checks turned off"
              },
              "fullDescription": {
                "text": "Every tool call, including shell commands and file deletes, runs without approval. One prompt injection in a file, issue or web page the agent reads can run any command as you."
              },
              "help": {
                "text": "Remove the bypass. Allow specific tools instead, and run unattended agents in a throwaway sandbox with no secrets and no network beyond what the task needs. BRACE checklist: B05, B01, B08.",
                "markdown": "Every tool call, including shell commands and file deletes, runs without approval. One prompt injection in a file, issue or web page the agent reads can run any command as you.\n\n**Fix:** Remove the bypass. Allow specific tools instead, and run unattended agents in a throwaway sandbox with no secrets and no network beyond what the task needs.\n\nBRACE checklist: B05, B01, B08. [Details](https://braceframework.org/anti-patterns/#ap01-agent-runs-with-all-permission-checks-turned-off)"
              },
              "helpUri": "https://braceframework.org/anti-patterns/#ap01-agent-runs-with-all-permission-checks-turned-off",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "ai-agent"
                ]
              },
              "relationships": [
                {
                  "target": {
                    "id": "ASI02",
                    "toolComponent": {
                      "name": "OWASP Top 10 for Agentic Applications"
                    }
                  },
                  "kinds": [
                    "relevant"
                  ]
                },
                {
                  "target": {
                    "id": "AML.T0053",
                    "toolComponent": {
                      "name": "MITRE ATLAS"
                    }
                  },
                  "kinds": [
                    "relevant"
                  ]
                },
                {
                  "target": {
                    "id": "AML.T0086",
                    "toolComponent": {
                      "name": "MITRE ATLAS"
                    }
                  },
                  "kinds": [
                    "relevant"
                  ]
                },
                {
                  "target": {
                    "id": "AML.T0100",
                    "toolComponent": {
                      "name": "MITRE ATLAS"
                    }
                  },
                  "kinds": [
                    "relevant"
                  ]
                },
                {
                  "target": {
                    "id": "AML.T0101",
                    "toolComponent": {
                      "name": "MITRE ATLAS"
                    }
                  },
                  "kinds": [
                    "relevant"
                  ]
                }
              ]
            },
            {
              "id": "AP02",
              "name": "UnattendedAgentInCIWithPermissionChecksTurnedOff",
              "shortDescription": {
                "text": "Unattended agent in CI with permission checks turned off"
              },
              "fullDescription": {
                "text": "A CI agent with no approvals and the job's token can be steered by anyone who can write an issue, PR, commit message or file it reads, and then push code, read secrets or publish packages."
              },
              "help": {
                "text": "Keep approvals on, give the job read-only permissions, and run untrusted-input jobs without repository secrets. BRACE checklist: B05, B02, B03, B09.",
                "markdown": "A CI agent with no approvals and the job's token can be steered by anyone who can write an issue, PR, commit message or file it reads, and then push code, read secrets or publish packages.\n\n**Fix:** Keep approvals on, give the job read-only permissions, and run untrusted-input jobs without repository secrets.\n\nBRACE checklist: B05, B02, B03, B09. [Details](https://braceframework.org/anti-patterns/#ap02-unattended-agent-in-ci-with-permission-checks-turned-off)"
              },
              "helpUri": "https://braceframework.org/anti-patterns/#ap02-unattended-agent-in-ci-with-permission-checks-turned-off",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "ai-agent"
                ]
              },
              "relationships": [
                {
                  "target": {
                    "id": "MCP01",
                    "toolComponent": {
                      "name": "OWASP MCP Top 10"
                    }
                  },
                  "kinds": [
                    "relevant"
                  ]
                },
                {
