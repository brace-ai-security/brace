                {
                  "target": {
                    "id": "AML.T0110.000",
                    "toolComponent": {
                      "name": "MITRE ATLAS"
                    }
                  },
                  "kinds": [
                    "relevant"
                  ]
                },
                {
                  "target": {
                    "id": "829",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "relevant"
                  ]
                }
              ]
            },
            {
              "id": "AP05",
              "name": "SecretWrittenDirectlyInAgentConfiguration",
              "shortDescription": {
                "text": "Secret written directly in agent configuration"
              },
              "fullDescription": {
                "text": "Config files get committed, copied and read by the agent itself. A literal token is long-lived, shared and easy to leak through the agent's output."
              },
              "help": {
                "text": "Load the secret from the environment or a secret manager, use a short-lived scoped token, and rotate the exposed one. BRACE checklist: B03, R03.",
                "markdown": "Config files get committed, copied and read by the agent itself. A literal token is long-lived, shared and easy to leak through the agent's output.\n\n**Fix:** Load the secret from the environment or a secret manager, use a short-lived scoped token, and rotate the exposed one.\n\nBRACE checklist: B03, R03. [Details](https://braceframework.org/anti-patterns/#ap05-secret-written-directly-in-agent-configuration)"
              },
              "helpUri": "https://braceframework.org/anti-patterns/#ap05-secret-written-directly-in-agent-configuration",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "ai-agent",
                  "external/cwe/cwe-798"
                ]
              },
              "relationships": [
                {
                  "target": {
                    "id": "MCP01",
