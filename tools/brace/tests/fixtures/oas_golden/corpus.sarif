            {
              "id": "AP07",
              "name": "RemoteMCPServerReachedOverPlainHTTP",
              "shortDescription": {
                "text": "Remote MCP server reached over plain HTTP"
              },
              "fullDescription": {
                "text": "Tool calls, results and credentials cross the network unencrypted and can be read or changed in transit, including the tool descriptions the model trusts."
              },
              "help": {
                "text": "Use https, and authenticate the server. BRACE checklist: E05, E06.",
                "markdown": "Tool calls, results and credentials cross the network unencrypted and can be read or changed in transit, including the tool descriptions the model trusts.\n\n**Fix:** Use https, and authenticate the server.\n\nBRACE checklist: E05, E06. [Details](https://braceframework.org/anti-patterns/#ap07-remote-mcp-server-reached-over-plain-http)"
              },
              "helpUri": "https://braceframework.org/anti-patterns/#ap07-remote-mcp-server-reached-over-plain-http",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "ai-agent",
                  "external/cwe/cwe-319"
                ]
              },
              "relationships": [
                {
                  "target": {
                    "id": "MCP07",
