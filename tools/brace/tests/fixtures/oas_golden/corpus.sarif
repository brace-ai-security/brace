                  ]
                }
              ]
            },
            {
              "id": "AP09",
              "name": "LethalCombinationUntrustedInputPrivateDataAndAWayOut",
              "shortDescription": {
                "text": "Lethal combination: untrusted input, private data and a way out"
              },
              "fullDescription": {
                "text": "The same agent can read content an attacker controls, reach private data and send data or act outside. Prompt injection then becomes data theft; no system prompt reliably stops it."
              },
              "help": {
                "text": "Split the capabilities across agents, remove one leg, or require a person to approve every outbound or consequential action. BRACE checklist: B05, B01, R02.",
                "markdown": "The same agent can read content an attacker controls, reach private data and send data or act outside. Prompt injection then becomes data theft; no system prompt reliably stops it.\n\n**Fix:** Split the capabilities across agents, remove one leg, or require a person to approve every outbound or consequential action.\n\nBRACE checklist: B05, B01, R02. [Details](https://braceframework.org/anti-patterns/#ap09-lethal-combination-untrusted-input-private-data-and-a-way-out)"
              },
              "helpUri": "https://braceframework.org/anti-patterns/#ap09-lethal-combination-untrusted-input-private-data-and-a-way-out",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "ai-agent"
                ]
              },
              "relationships": [
                {
                  "target": {
