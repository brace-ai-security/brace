              ]
            },
            {
              "id": "AP08",
              "name": "AgentToolContainerCanTakeOverTheHost",
              "shortDescription": {
                "text": "Agent tool container can take over the host"
              },
              "fullDescription": {
                "text": "--privileged, a mounted Docker socket, host networking or a mounted root filesystem remove the container boundary. A compromised tool then controls the machine."
              },
              "help": {
                "text": "Drop these flags. Mount only the folders the tool needs, read-only where possible. BRACE checklist: B08, B11, B09.",
                "markdown": "--privileged, a mounted Docker socket, host networking or a mounted root filesystem remove the container boundary. A compromised tool then controls the machine.\n\n**Fix:** Drop these flags. Mount only the folders the tool needs, read-only where possible.\n\nBRACE checklist: B08, B11, B09. [Details](https://braceframework.org/anti-patterns/#ap08-agent-tool-container-can-take-over-the-host)"
              },
              "helpUri": "https://braceframework.org/anti-patterns/#ap08-agent-tool-container-can-take-over-the-host",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "ai-agent",
                  "external/cwe/cwe-250"
                ]
              },
              "relationships": [
                {
                  "target": {
                    "id": "ASI05",
                    "toolComponent": {
                      "name": "OWASP Top 10 for Agentic Applications"
                    }
                  },
                  "kinds": [
