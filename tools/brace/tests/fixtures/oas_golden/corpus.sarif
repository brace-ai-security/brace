              ]
            },
            {
              "id": "AP03",
              "name": "AgentWorkflowTriggeredByPullRequestTarget",
              "shortDescription": {
                "text": "Agent workflow triggered by pull_request_target"
              },
              "fullDescription": {
                "text": "pull_request_target runs with the base repository's secrets and write token on events from forks. An agent that reads the fork's PR text or code can be told to leak or misuse them."
              },
              "help": {
                "text": "Use pull_request for agent jobs, or split the job so the agent never sees secrets or a write token while it reads outside content. BRACE checklist: B02, B05, R02.",
                "markdown": "pull_request_target runs with the base repository's secrets and write token on events from forks. An agent that reads the fork's PR text or code can be told to leak or misuse them.\n\n**Fix:** Use pull_request for agent jobs, or split the job so the agent never sees secrets or a write token while it reads outside content.\n\nBRACE checklist: B02, B05, R02. [Details](https://braceframework.org/anti-patterns/#ap03-agent-workflow-triggered-by-pull_request_target)"
              },
              "helpUri": "https://braceframework.org/anti-patterns/#ap03-agent-workflow-triggered-by-pull_request_target",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "ai-agent"
                ]
              },
              "relationships": [
                {
                  "target": {
                    "id": "ASI01",
                    "toolComponent": {
