{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WwjoZiUSShuTFUJNfNafKK","type":"tool_result","content":"1\timport base64, hashlib, hmac, json, os, time\n2\tISSUER = \"https://identity.example.test\"\n3\tRESOURCE = \"https://records.example.test/mcp\"\n4\tPOLICY_VERSION = \"records-17\"\n5\tCACHE, TASKS, REVOKED = {}, {}, set()\n6\t\n7\tdef unpack(value):\n8\t    return base64.urlsafe_b64decode(value + \"=\" * (-len(value) % 4))\n9\t\n10\tdef authenticate(token):\n11\t    head, payload, sig = token.split(\".\")\n12\t    if json.loads(unpack(head)).get(\"alg\") != \"HS256\":\n13\t        raise PermissionError(\"algorithm\")\n14\t    expected = hmac.new(os.environ[\"JWT_VERIFY_SECRET\"].encode(), (head + \".\" + payload).encode(), hashlib.sha256).digest()\n15\t    if not hmac.compare_digest(expected, unpack(sig)):\n16\t        raise PermissionError(\"signature\")\n17\t    claims = json.loads(unpack(payload))\n18\t    if claims[\"iss\"] != ISSUER or claims[\"exp\"] <= time.time() or claims[\"sub\"] in REVOKED:\n19\t        raise PermissionError(\"issuer, expiry or revocation\")\n20\t    # Other accepted claims are handled below.\n21\t    return claims\n22\t\n23\tdef invoke(claims, name, args, backend):\n24\t    if args[\"tenant\"] != claims[\"tenant\"]:\n25\t        raise PermissionError(\"tenant\")\n26\t    if name not in claims[\"tools\"]:\n27\t        raise PermissionError(\"operation\")\n28\t    return backend(name, args)\n29\t\n30\tdef dispatch(claims, request, backend):\n31\t    if request[\"mode\"] == \"batch\":\n32\t        return [backend(call[\"tool\"], call[\"args\"]) for call in request[\"calls\"]]\n33\t    return invoke(claims, request[\"tool\"], request[\"args\"], backend)\n34\t\n35\tdef read_records(claims, query, backend):\n36\t    key = query\n37\t    if key not in CACHE:\n38\t        CACHE[key] = invoke(claims, \"read\", {\"tenant\": claims[\"tenant\"], \"query\": query}, backend)\n39\t    return CACHE[key]\n40\t\n41\tdef cancel(claims, handle):\n42\t    task = TASKS[handle]\n43\t    if task[\"tenant\"] != claims[\"tenant\"]:\n44\t        raise PermissionError(\"task tenant\")\n45\t    task[\"cancelled\"] = True\n46\t\n47\tdef worker_step(handle, backend):\n48\t    task = TASKS[handle]\n49\t    # The scheduler runs this function once for every queued handle.\n50\t    return invoke(task[\"claims\"], task[\"tool\"], task[\"args\"], backend)\n51\t\n52\tdef fingerprint(definition):\n53\t    material = {k: definition[k] for k in (\"name\", \"description\", \"inputSchema\")}\n54\t    return hashlib.sha256(json.dumps(material, sort_keys=True).encode()).hexdigest()\n55\t\n56\tdef handle_http(origin, token, body, backend, audit_sink):\n57\t    if origin != \"https://console.example.test\":\n58\t        raise PermissionError(\"origin\")\n59\t    if len(body) > 8192:\n60\t        raise ValueError(\"body too large\")\n61\t    claims = authenticate(token)\n62\t    request = json.loads(body)\n63\t    ticket = audit_sink.begin({\"subject\": claims[\"sub\"], \"tenant\": claims[\"tenant\"], \"request\": request, \"policy\": POLICY_VERSION})\n64\t    if request[\"method\"] == \"read\":\n65\t        result = read_records(claims, request[\"query\"], backend)\n66\t    elif request[\"method\"] == \"cancel\":\n67\t        result = cancel(claims, request[\"handle\"])\n68\t    else:\n69\t        result = dispatch(claims, request, backend)\n70\t    audit_sink.complete(ticket, result)\n71\t    return result\n72\t"}]},"parent_tool_use_id":null,"session_id":"120ce20f-79b2-43f2-9ba3-618950af86a9","uuid":"a94193dd-f8a8-4b75-8133-563cc1d56a86","timestamp":"2026-10-23T08:58:15.563Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-mcp-primary-e0h50f6t/repo/gateway.py","content":"import base64, hashlib, hmac, json, os, time\nISSUER = \"https://identity.example.test\"\nRESOURCE = \"https://records.example.test/mcp\"\nPOLICY_VERSION = \"records-17\"\nCACHE, TASKS, REVOKED = {}, {}, set()\n\ndef unpack(value):\n    return base64.urlsafe_b64decode(value + \"=\" * (-len(value) % 4))\n\ndef authenticate(token):\n    head, payload, sig = token.split(\".\")\n    if json.loads(unpack(head)).get(\"alg\") != \"HS256\":\n        raise PermissionError(\"algorithm\")\n    expected = hmac.new(os.environ[\"JWT_VERIFY_SECRET\"].encode(), (head + \".\" + payload).encode(), hashlib.sha256).digest()\n    if not hmac.compare_digest(expected, unpack(sig)):\n        raise PermissionError(\"signature\")\n    claims = json.loads(unpack(payload))\n    if claims[\"iss\"] != ISSUER or claims[\"exp\"] <= time.time() or claims[\"sub\"] in REVOKED:\n        raise PermissionError(\"issuer, expiry or revocation\")\n    # Other accepted claims are handled below.\n    return claims\n\ndef invoke(claims, name, args, backend):\n    if args[\"tenant\"] != claims[\"tenant\"]:\n        raise PermissionError(\"tenant\")\n    if name not in claims[\"tools\"]:\n        raise PermissionError(\"operation\")\n    return backend(name, args)\n\ndef dispatch(claims, request, backend):\n    if request[\"mode\"] == \"batch\":\n        return [backend(call[\"tool\"], call[\"args\"]) for call in request[\"calls\"]]\n    return invoke(claims, request[\"tool\"], request[\"args\"], backend)\n\ndef read_records(claims, query, backend):\n    key = query\n    if key not in CACHE:\n        CACHE[key] = invoke(claims, \"read\", {\"tenant\": claims[\"tenant\"], \"query\": query}, backend)\n    return CACHE[key]\n\ndef cancel(claims, handle):\n    task = TASKS[handle]\n    if task[\"tenant\"] != claims[\"tenant\"]:\n        raise PermissionError(\"task tenant\")\n    task[\"cancelled\"] = True\n\ndef worker_step(handle, backend):\n    task = TASKS[handle]\n    # The scheduler runs this function once for every queued handle.\n    return invoke(task[\"claims\"], task[\"tool\"], task[\"args\"], backend)\n\ndef fingerprint(definition):\n    material = {k: definition[k] for k in (\"name\", \"description\", \"inputSchema\")}\n    return hashlib.sha256(json.dumps(material, sort_keys=True).encode()).hexdigest()\n\ndef handle_http(origin, token, body, backend, audit_sink):\n    if origin != \"https://console.example.test\":\n        raise PermissionError(\"origin\")\n    if len(body) > 8192:\n        raise ValueError(\"body too large\")\n    claims = authenticate(token)\n    request = json.loads(body)\n    ticket = audit_sink.begin({\"subject\": claims[\"sub\"], \"tenant\": claims[\"tenant\"], \"request\": request, \"policy\": POLICY_VERSION})\n    if request[\"method\"] == \"read\":\n        result = read_records(claims, request[\"query\"], backend)\n    elif request[\"method\"] == \"cancel\":\n        result = cancel(claims, request[\"handle\"])\n    else:\n        result = dispatch(claims, request, backend)\n    audit_sink.complete(ticket, result)\n    return result\n","numLines":72,"startLine":1,"totalLines":72}},"tool_result_meta":[{"id":"toolu_01WwjoZiUSShuTFUJNfNafKK","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
