diff --git a/tests/test_approval_scope.py b/tests/test_approval_scope.py
new file mode 100644
index 0000000..e1135ee
--- /dev/null
+++ b/tests/test_approval_scope.py
@@ -0,0 +1,63 @@
+"""B06: an approval cannot be used under a scope other than the one it was granted for.
+
+This checks that the scope is stored and that consume() sends it in the WHERE clause.
+Whether Postgres actually refuses a mismatched row needs a real database; no test DB exists here.
+"""
+import pathlib
+import sys
+
+import pytest
+
+REPO = pathlib.Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(REPO))
+
+from src.approvals import ApprovalInvalid, ApprovalStore  # noqa: E402
+from src.audit import RunContext  # noqa: E402
+
+
+class FakePool:
+    def __init__(self, fetch_result=None):
+        self.executed = []
+        self.fetched = []
+        self._fetch_result = fetch_result
+
+    async def execute(self, sql, *params):
+        self.executed.append((sql, params))
+
+    async def fetchrow(self, sql, *params):
+        self.fetched.append((sql, params))
+        return self._fetch_result
+
+
+def _ctx():
+    return RunContext(
+        run_id="00000000-0000-0000-0000-000000000001", agent_instance_id="inst-1", agent_type_id="type-1",
+        tenant="t", subject="employee-1", accountable_party="ap", operational_owner="oo",
+        agent_principal="principal",
+    )
+
+
+ARGS = {"leave_type": "annual", "start_date": "2026-12-01", "end_date": "2026-12-02"}
+
+
+@pytest.mark.asyncio
+async def test_request_stores_tool_scope():
+    pool = FakePool()
+    store = ApprovalStore(pool, ttl_seconds=300)
+    await store.request(_ctx(), "hris/file_leave_request", "employee:employee-1", ARGS, "tu-1", "hris.leave.request")
+    sql, params = pool.executed[0]
+    assert "scope" in sql
+    assert "hris.leave.request" in params
+
+
+@pytest.mark.asyncio
+async def test_consume_with_different_scope_is_refused():
+    # The database returns no row when the scope in the WHERE clause does not match.
+    pool = FakePool(fetch_result=None)
+    store = ApprovalStore(pool, ttl_seconds=300)
+    with pytest.raises(ApprovalInvalid):
+        await store.consume(_ctx(), "a-1", "hris/file_leave_request", "employee:employee-1", ARGS,
+                            "hris.leave.balance.other")
+    sql, params = pool.fetched[0]
+    assert "AND scope = $7" in sql
+    assert params[-1] == "hris.leave.balance.other"
diff --git a/tests/test_escalate_gateway.py b/tests/test_escalate_gateway.py
new file mode 100644
index 0000000..61f41e1
--- /dev/null
+++ b/tests/test_escalate_gateway.py
@@ -0,0 +1,75 @@
+"""B01: a tool the gateway has disabled cannot be called by any route."""
+import pathlib
+import sys
+
+import pytest
+
+REPO = pathlib.Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(REPO))
+
+from src.audit import RunContext  # noqa: E402
+from src.gateway_client import GATEWAY_URL, GatewayClient, GatewayUnavailable, ToolDenied  # noqa: E402
+from src.tools import ToolRegistry  # noqa: E402
+
+
+class FakeResponse:
+    def __init__(self, status_code, body=None):
+        self.status_code = status_code
+        self._body = body or {}
+        self.text = str(self._body)
+
+    def json(self):
+        return self._body
+
+
+class FakeHttp:
+    """Records every URL posted to. Answers with the status it was given."""
+
+    def __init__(self, status_code):
+        self.status_code = status_code
+        self.urls = []
+
+    async def post(self, url, json=None, headers=None, timeout=None):
+        self.urls.append(url)
+        return FakeResponse(self.status_code, {"error": "disabled"})
+
+
+class FakeCreds:
+    async def token(self, audience, scope, subject_token, subject):
+        return "token"
+
+
+def _ctx():
+    return RunContext(
+        run_id="00000000-0000-0000-0000-000000000001", agent_instance_id="inst-1", agent_type_id="type-1",
+        tenant="t", subject="employee-1", accountable_party="ap", operational_owner="oo",
+        agent_principal="principal",
+    )
+
+
+def _spec():
+    return ToolRegistry.from_config().get("escalate_to_human")
+
+
+def test_escalate_has_no_direct_route():
+    assert _spec().direct_route is None
+
+
+@pytest.mark.asyncio
+async def test_gateway_refusal_is_final_and_no_other_route_is_called():
+    http = FakeHttp(403)
+    client = GatewayClient(http, FakeCreds())
+    with pytest.raises(ToolDenied):
+        await client.call(_spec(), {"summary": "x" * 12, "category": "other"}, _ctx(), "subject-token",
+                          operation_id="op-1")
+    assert http.urls == [GATEWAY_URL]
+
+
+@pytest.mark.asyncio
+async def test_gateway_down_does_not_fall_back_to_helpdesk():
+    http = FakeHttp(503)
+    client = GatewayClient(http, FakeCreds())
+    with pytest.raises(GatewayUnavailable):
+        await client.call(_spec(), {"summary": "x" * 12, "category": "other"}, _ctx(), "subject-token",
+                          operation_id="op-1")
+    assert http.urls == [GATEWAY_URL]
diff --git a/tests/test_gateway_audit.py b/tests/test_gateway_audit.py
new file mode 100644
index 0000000..4ac7f5c
--- /dev/null
+++ b/tests/test_gateway_audit.py
@@ -0,0 +1,55 @@
+"""R13: when the gateway is down, the failed tool call leaves one audit event."""
+import pathlib
+import sys
+
+import pytest
+
+REPO = pathlib.Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(REPO))
+
+from src.agent import Agent, RunState  # noqa: E402
+from src.audit import RunContext  # noqa: E402
+from src.budgets import RunBudget  # noqa: E402
+from src.gateway_client import GatewayUnavailable  # noqa: E402
+from src.tools import ToolRegistry  # noqa: E402
+
+
+class FakeAudit:
+    def __init__(self):
+        self.events = []
+
+    async def record(self, ctx, event_type, **kwargs):
+        self.events.append((event_type, kwargs))
+        return "event-id"
+
+
+class DownGateway:
+    async def call(self, *args, **kwargs):
+        raise GatewayUnavailable("connection refused")
+
+
+def _ctx():
+    return RunContext(
+        run_id="00000000-0000-0000-0000-000000000001", agent_instance_id="inst-1", agent_type_id="type-1",
+        tenant="t", subject="employee-1", accountable_party="ap", operational_owner="oo",
+        agent_principal="principal",
+    )
+
+
+@pytest.mark.asyncio
+async def test_gateway_down_leaves_one_audit_event():
+    registry = ToolRegistry.from_config()
+    audit = FakeAudit()
+    agent = Agent(cfg={}, registry=registry, llm=None, gateway=DownGateway(), index=None,
+                  approvals=None, quotas=None, audit=audit, stop=None)
+    state = RunState(messages=[], budget=None, subject_token="subject-token")
+    spec = registry.get("get_leave_balance")
+
+    result = await agent._execute(_ctx(), state, "step-1", "tu-1", spec, "employee:employee-1",
+                                  {"leave_type": "annual"}, approval_id=None)
+
+    assert result["is_error"] is True
+    gateway_events = [e for e in audit.events if e[0] == "gateway_unavailable"]
+    assert len(gateway_events) == 1
+    assert gateway_events[0][1]["result"]["operation_id"]
+    assert gateway_events[0][1]["tool"] == "hris/get_leave_balance"
