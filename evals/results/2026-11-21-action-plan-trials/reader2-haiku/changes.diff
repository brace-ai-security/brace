diff --git a/tests/test_approval_scope.py b/tests/test_approval_scope.py
new file mode 100644
index 0000000..12d3a37
--- /dev/null
+++ b/tests/test_approval_scope.py
@@ -0,0 +1,32 @@
+import asyncio
+
+import pytest
+
+from src.approvals import ApprovalInvalid, ApprovalStore
+from src.audit import RunContext
+
+
+class Pool:
+    async def fetchrow(self, sql, *p):
+        self.sql, self.p = sql, p
+        return None
+
+
+def test_consume_refuses_when_scope_differs():
+    pool = Pool()
+    store = ApprovalStore(pool, ttl_seconds=600)
+    ctx = RunContext(
+        run_id="r1",
+        agent_instance_id="i1",
+        agent_type_id="t1",
+        tenant="tenant1",
+        subject="employee1",
+        accountable_party="ap1",
+        operational_owner="oo1",
+        agent_principal="p1",
+    )
+    args = {"leave_type": "annual", "start_date": "2026-12-01", "end_date": "2026-12-02"}
+    with pytest.raises(ApprovalInvalid):
+        asyncio.run(store.consume(ctx, "a1", "hris/file_leave_request", "employee:employee1", args, "hris.leave.request"))
+    assert "scope = $7" in pool.sql
+    assert pool.p[-1] == "hris.leave.request"
diff --git a/tests/test_audit_gateway_down.py b/tests/test_audit_gateway_down.py
new file mode 100644
index 0000000..937b41e
--- /dev/null
+++ b/tests/test_audit_gateway_down.py
@@ -0,0 +1,46 @@
+import asyncio
+
+from src.agent import Agent, RunState
+from src.audit import RunContext
+from src.gateway_client import GatewayUnavailable
+from src.tools import ToolRegistry
+
+
+class Audit:
+    events = []
+
+    async def record(self, ctx, event_type, **kw):
+        self.events.append((event_type, kw))
+
+
+class Gateway:
+    async def call(self, *a, **kw):
+        raise GatewayUnavailable("down")
+
+
+def test_gateway_outage_is_audited_with_operation_id():
+    agent = Agent.__new__(Agent)
+    agent.audit = Audit()
+    agent.audit.events = []
+    agent.gateway = Gateway()
+    agent.cfg = {"limits": {"max_tool_output_bytes": 1000}}
+    spec = ToolRegistry.from_config().get("get_leave_balance")
+    ctx = RunContext(
+        run_id="r1",
+        agent_instance_id="i1",
+        agent_type_id="t1",
+        tenant="tenant1",
+        subject="employee1",
+        accountable_party="ap1",
+        operational_owner="oo1",
+        agent_principal="p1",
+    )
+    state = RunState(messages=[], budget=None, subject_token="subject-token")
+    result = asyncio.run(agent._execute(ctx, state, "step1", "tool1", spec,
+                                        "employee:employee1", {"leave_type": "annual"}, None))
+    assert result["is_error"] is True
+    events = agent.audit.events
+    sent = [kw for t, kw in events if t == "tool_call_sent"]
+    errs = [kw for t, kw in events if t == "tool_error"]
+    assert sent and sent[0]["operation_id"]
+    assert errs and errs[0]["operation_id"]
diff --git a/tests/test_gateway_down.py b/tests/test_gateway_down.py
new file mode 100644
index 0000000..2bf0f4a
--- /dev/null
+++ b/tests/test_gateway_down.py
@@ -0,0 +1,42 @@
+import asyncio
+
+import httpx
+import pytest
+
+from src.gateway_client import GATEWAY_URL, GatewayClient, GatewayUnavailable
+from src.audit import RunContext
+from src.tools import ToolRegistry
+
+
+class Creds:
+    async def token(self, **kw):
+        return "t"
+
+
+class Down:
+    urls = []
+
+    async def post(self, url, **kw):
+        self.urls.append(url)
+        raise httpx.ConnectError("down")
+
+
+def test_gateway_down_escalation_goes_only_through_gateway():
+    spec = ToolRegistry.from_config().get("escalate_to_human")
+    ctx = RunContext(
+        run_id="r1",
+        agent_instance_id="i1",
+        agent_type_id="t1",
+        tenant="tenant1",
+        subject="employee1",
+        accountable_party="ap1",
+        operational_owner="oo1",
+        agent_principal="p1",
+    )
+    down = Down()
+    down.urls = []
+    client = GatewayClient(down, Creds())
+    args = {"summary": "Need help with a payslip question", "category": "payroll"}
+    with pytest.raises(GatewayUnavailable):
+        asyncio.run(client.call(spec, args, ctx, "subject-token", operation_id="op1"))
+    assert down.urls == [GATEWAY_URL]
