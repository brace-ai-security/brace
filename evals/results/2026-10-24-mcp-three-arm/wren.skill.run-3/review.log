d none is a security Pass or release verdict. Any deployment decision belongs to accountable people, with a gradual, monitored rollout and tested recovery.","ttft_ms":1863,"type":"result","duration_ms":50832,"uuid":"5bdf1abf-2683-428f-a082-f4d3fbf552f3","ttft_stream_ms":1119,"time_to_request_ms":130,"first_content_frame_ms":1119,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-sonnet-5-5":{"inputTokens":8,"outputTokens":6714,"cacheReadInputTokens":36334,"cacheCreationInputTokens":15262,"webSearchRequests":0,"costUSD":0.1318374,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":1372,"canonicalModel":"claude-sonnet-5-5","provider":"firstParty","costBasis":"list"}}}
