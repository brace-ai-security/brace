lation's worker effect is outside scope. There is no MCP TypeScript SDK or OAuth client in this Python component.\n","numLines":4,"startLine":1,"totalLines":4}},"tool_result_meta":[{"id":"toolu_01Fp4E1WVT9zEDEgXMPmpK5X","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
