    21	    ("erp_session", re.compile(r"\berp_sess_[A-Za-z0-9_]{8,}\b")),
    22	    ("password_kv", re.compile(r"(?i)\b(password|passwd|secret|api[_-]?key)\s*[:=]\s*\S+")),
    23	]
    24	
    25	# Bank details: keep the last four characters so staff can still match records.
    26	ACCOUNT_PATTERNS: list[tuple[str, re.Pattern[str]]] = [
    27	    ("iban", re.compile(r"\b[A-Z]{2}\d{2}[A-Z0-9]{11,30}\b")),
    28	    ("account_no", re.compile(r"(?i)\b(account|acct|routing)\s*(no\.?|number|#)?\s*[:#]?\s*(\d[\d -]{6,}\d)")),
    29	]
    30	
    31	MARKDOWN_IMAGE = re.compile(r"!\[[^\]]*\]\(([^)\s]+)[^)]*\)")
    32	MARKDOWN_LINK = re.compile(r"(?<!!)\[([^\]]*)\]\(([^)\s]+)[^)]*\)")
    33	SLACK_LINK = re.compile(r"<(https?://[^|>]+)(\|[^>]*)?>")
    34	BARE_URL = re.compile(r"https?://[^\s<>()]+")
    35	
    36	APPROVED_LINK_HOSTS = frozenset({"erp.example-corp.test", "intranet.example-corp.test"})
    37	
    38	
    39	def _mask_tail(match: re.Match[str]) -> str:
    40	    text = match.group(0)
    41	    return "[REDACTED:" + "*" * 4 + text[-4:] + "]"
    42	
    43	
    44	def redact_text(text: str) -> str:
    45	    for name, pattern in SECRET_PATTERNS:
    46	        text = pattern.sub(f"[REDACTED:{name}]", text)
    47	    for _name, pattern in ACCOUNT_PATTERNS:
    48	        text = pattern.sub(_mask_tail, text)
    49	    return text
    50	
    51	
    52	def redact_value(value: Any) -> Any:
    53	    if isinstance(value, str):
    54	        return redact_text(value)
    55	    if isinstance(value, dict):
    56	        return {k: redact_value(v) for k, v in value.items()}
    57	    if isinstance(value, (list, tuple)):
    58	        return [redact_value(v) for v in value]
    59	    return value
    60	
    61	
    62	def redact_for_model(value: Any) -> str:
    63	    if not isinstance(value, str):
    64	        import json
    65	
    66	        value = json.dumps(value, default=str)
    67	    return redact_text(value)
    68	
    69	
    70	def _host_ok(url: str) -> bool:
    71	    host = (urlparse(url).hostname or "").lower()
    72	    return host in APPROVED_LINK_HOSTS
    73	
    74	
    75	def strip_unapproved_links(text: str) -> str:
    76	    """Remove images entirely and drop links to hosts outside the allowlist.
    77	
    78	    Slack and most chat clients fetch link and image URLs to render previews,
    79	    so an attacker-chosen URL can carry data out without any tool call.
    80	    """
    81	    text = MARKDOWN_IMAGE.sub("[image removed]", text)
    82	    text = MARKDOWN_LINK.sub(
    83	        lambda m: m.group(0) if _host_ok(m.group(2)) else m.group(1), text
    84	    )
    85	    text = SLACK_LINK.sub(
    86	        lambda m: m.group(0) if _host_ok(m.group(1)) else "[link removed]", text
    87	    )
    88	    text = BARE_URL.sub(
    89	        lambda m: m.group(0) if _host_ok(m.group(0)) else "[link removed]", text
    90	    )
    91	    return text
    92	
    93	
    94	class RedactingFilter(logging.Filter):
    95	    def filter(self, record: logging.LogRecord) -> bool:
    96	        if isinstance(record.msg, str):
    97	            record.msg = redact_text(record.msg)
    98	        if record.args:
    99	            record.args = tuple(redact_value(a) for a in record.args)
   100	        return True
agent/app/killswitch.py
     1	"""Operator stop control.
     2	
     3	Operators halt the fleet or one business unit by setting a row in
     4	``control_flags`` with the ``procurement_ops`` database role (see
     5	ops/README in the platform runbook). The agent's own database role has
     6	SELECT only on this table, so the agent cannot clear or delay a halt.
     7	"""
     8	from __future__ import annotations
     9	
    10	
    11	class AgentHalted(Exception):
    12	    pass
    13	
    14	
    15	_QUERY = """
    16	SELECT scope, reason, set_by, set_at
    17	FROM control_flags
    18	WHERE halted
    19	  AND (scope = 'fleet' OR scope = $1)
    20	ORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END
    21	LIMIT 1
    22	"""
    23	
    24	
    25	async def assert_running(pool, tenant: str) -> None:
    26	    row = await pool.fetchrow(_QUERY, f"tenant:{tenant}")
    27	    if row is not None:
    28	        raise AgentHalted(
    29	            f"halted by {row['set_by']} at {row['set_at'].isoformat()} "
    30	            f"(scope={row['scope']}): {row['reason']}"
    31	        )
