#!/usr/bin/env python3
"""Write one answer into a findings file, check it, and show what's next.

Use this instead of editing the JSON by hand.

  Answer a check:
    python answer.py FINDINGS.json check B05.2 --met no --evidence src/x.py:41 \\
        --quote "exact code on that line" --note "what the code does" [--counter "what you searched"]

  Add a red flag:
    python answer.py FINDINGS.json flag B05 --evidence src/x.py:41 --note "what's wrong"

  Finish an item:
    python answer.py FINDINGS.json item B05 --rating gap --confidence high \\
        --summary "one sentence" --next "what to fix" [--violates "exact words from the requirement"] \\
        [--also-affects E06]

  Resolve a pre-scan hit:
    python answer.py FINDINGS.json prescan H003 --verdict confirmed --item R03 --reason "..."

  Show the next unanswered check:
    python answer.py FINDINGS.json next

The quote is checked against the file right away; a "yes" without a matching quote
and a counter-search is refused. Paths are relative to the repo, which defaults to the
folder holding FINDINGS.json (set --repo to change it).
"""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from validate_findings import quote_found, norm, refs  # noqa: E402

CHECKS_FILE = Path(__file__).resolve().parent.parent / "references" / "checks.json"


def load(path):
    return json.loads(Path(path).read_text())


def save(path, doc):
    Path(path).write_text(json.dumps(doc, indent=2) + "\n")


def find_item(doc, item):
    for f in doc["findings"]:
        if f["item"] == item:
            return f
    sys.exit(f"{item} isn't in this findings file.")


def next_open(doc):
    for f in doc["findings"]:
        for c in f.get("checks", []):
            if c.get("met") == "unknown" and not norm(c.get("note", "")):
                return f"Next: {c['id']} — {c.get('check', '')}\n  How to verify: {c.get('verify', '')}"
        if str(f.get("summary", "")).startswith("TODO"):
            return f"Next: finish item {f['item']} with `answer.py ... item {f['item']} --rating ...`"
    return "All checks and items have answers. Run validate_findings.py --fix."


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("findings")
    ap.add_argument("kind", choices=["check", "flag", "item", "prescan", "next"])
    ap.add_argument("target", nargs="?")
    ap.add_argument("--repo")
    ap.add_argument("--met", choices=["yes", "no", "unknown"])
    ap.add_argument("--evidence", default="")
    ap.add_argument("--quote", default="")
    ap.add_argument("--counter", default="")
    ap.add_argument("--note", default="")
    ap.add_argument("--rating", choices=["likely_pass", "gap", "needs_evidence", "na_candidate"])
    ap.add_argument("--confidence", choices=["high", "medium", "low"], default="medium")
    ap.add_argument("--summary", default="")
    ap.add_argument("--next", dest="next_step", default="")
    ap.add_argument("--violates", action="append", default=[])
    ap.add_argument("--also-affects", action="append", default=[])
    ap.add_argument("--verdict", choices=["confirmed", "dismissed"])
    ap.add_argument("--item")
    ap.add_argument("--reason", default="")
    a = ap.parse_args()
    path = Path(a.findings)
    repo = Path(a.repo) if a.repo else path.resolve().parent
    doc = load(path)

    if a.kind == "next":
        print(next_open(doc))
        return

    if a.kind == "check":
        item = a.target.split(".")[0]
        f = find_item(doc, item)
        c = next((c for c in f["checks"] if c["id"] == a.target), None)
        if not c:
            sys.exit(f"{a.target} isn't a check of {item}. Checks: {', '.join(c['id'] for c in f['checks'])}")
        if not a.met or len(norm(a.note).split()) < 4:
            sys.exit("Give --met and a --note of at least four words.")
        if a.met in ("yes", "no"):
            if not refs(a.evidence):
                sys.exit("--evidence must be path:line.")
            if not quote_found(repo, a.evidence, a.quote):
                sys.exit(f"The quote isn't in {a.evidence} (within 3 lines). Copy the exact code text.")
        if a.met == "yes" and len(norm(a.counter).split()) < 4:
            sys.exit("A yes needs --counter: what you searched for that would make it false, and what you found.")
        c.update(met=a.met, evidence=a.evidence, quote=a.quote, counter_search=a.counter, note=a.note)
        save(path, doc)
        print(f"Saved {a.target} = {a.met}. " + next_open(doc))
        return

    if a.kind == "flag":
        f = find_item(doc, a.target)
        if not refs(a.evidence) or len(norm(a.note).split()) < 4:
            sys.exit("A red flag needs --evidence path:line and a --note of at least four words.")
        f.setdefault("red_flags_found", []).append(f"{a.evidence} {a.note}")
        save(path, doc)
        print(f"Added red flag to {a.target}.")
        return

    if a.kind == "item":
        f = find_item(doc, a.target)
        if not a.rating or len(norm(a.summary).split()) < 6 or not norm(a.next_step):
            sys.exit("Give --rating, a --summary of at least six words, and --next.")
        if a.rating == "gap":
            req = norm(json.loads(CHECKS_FILE.read_text()).get(a.target, {}).get("requirement", ""))
            bad = [v for v in a.violates if len(norm(v).strip(" .")) < 15
                   or norm(v).lower().strip(" .") not in req.lower()]
            if req and (bad or not a.violates):
                sys.exit(f"A gap needs --violates: words copied exactly from {a.target}'s requirement, one phrase "
                         f"per --violates, at least 15 characters each. "
                         + (f"Not found in it: {bad}. " if bad else "")
                         + f"The requirement is:\n{req}")
        f.update(rating=a.rating, confidence=a.confidence, summary=a.summary, next_step=a.next_step)
        if a.violates:
            f["violates"] = a.violates
        if a.also_affects:
            f["also_affects"] = a.also_affects
        ev = next((c for c in f["checks"] if c.get("met") in ("no", "yes") and refs(c.get("evidence"))), None)
        if ev and not f.get("evidence"):
            p, line, _ = refs(ev["evidence"])[0]
            f["evidence"] = [{"file": p, "line": line, "note": ev.get("note", "")}]
        save(path, doc)
        print(f"Saved item {a.target} = {a.rating}. " + next_open(doc))
        return

    if a.kind == "prescan":
        if not a.verdict or len(norm(a.reason).split()) < 6:
            sys.exit("Give --verdict and a --reason of at least six words.")
        if a.verdict == "confirmed" and not a.item:
            sys.exit("A confirmed hit needs --item: the item whose requirement it breaks.")
        res = doc.setdefault("prescan_resolutions", {})
        res[a.target] = {"verdict": a.verdict, "item": a.item, "reason": a.reason}
        save(path, doc)
        print(f"Saved pre-scan {a.target} = {a.verdict}.")


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""Pre-scan a repository for code that looks like a BRACE control but often fails.

Each hit is a place for the reviewer to read, not a finding. The `ask` on each hit
says what to check to confirm or dismiss it.

Usage: python prescan.py REPO [--out FILE]

Patterns live in ../prescan/patterns.yaml. Writes JSON (default REPO/brace-prescan.json):
  {"hits": [{"id": "H001", "pattern": "P01", "item": "B01", "title": ..., "file": ...,
             "line": 41, "text": ..., "ask": ...}],
   "capped": [{"pattern": "P07", "found": 60, "kept": 25}], ...}
"""
import argparse
import fnmatch
import json
import os
import re
import sys
from collections import Counter
from pathlib import Path

PATTERNS_FILE = Path(__file__).resolve().parent.parent / "prescan" / "patterns.yaml"
MAX_HITS_PER_PATTERN = 25
MAX_TEXT = 200
MAX_FILE_BYTES = 2_000_000
MAX_LINE_CHARS = 2_000  # longer lines are usually minified or generated

SKIP_DIRS = {".git", "node_modules", "venv", ".venv", "__pycache__", "brace-challenges"}
SKIP_DIR_PREFIXES = ("brace-findings",)
SKIP_FILE_PREFIXES = ("brace-findings", "brace-prescan")
SKIP_FILE_GLOBS = ("*.min.js", "*.bundle.js", "*.bundled.js", "*.min.css", "*.map", "*.lock",
                   "package-lock.json", "pnpm-lock.yaml")
COMMENT_LINE = re.compile(r"^\s*(#|//|/\*|\*(\s|/|$))")

LANGUAGE_GLOBS = {
    "python": ["*.py", "*.pyi"],
    "typescript": ["*.ts", "*.tsx", "*.mts", "*.cts"],
    "javascript": ["*.js", "*.jsx", "*.mjs", "*.cjs"],
    "go": ["*.go"],
    "yaml": ["*.yaml", "*.yml"],
    "json": ["*.json", "*.jsonc"],
    "hcl": ["*.tf", "*.tfvars", "*.hcl"],
    "dockerfile": ["Dockerfile", "Dockerfile.*", "*.Dockerfile", "*.dockerfile", "Containerfile"],
    "shell": ["*.sh", "*.bash", "*.zsh"],
    "toml": ["*.toml"],
    "env": [".env", ".env.*", "*.env"],
}


def load_patterns(path=PATTERNS_FILE):
    try:
        import yaml
    except ImportError:
        sys.exit("prescan.py needs PyYAML to read patterns.yaml. Install it with: pip install pyyaml")
    data = yaml.safe_load(Path(path).read_text(encoding="utf-8"))
    if not isinstance(data, list):
        sys.exit(f"{path}: expected a list of patterns")
    patterns, errors, seen = [], [], set()
    for p in data:
        pid = p.get("id", "?")
        missing = [k for k in ("id", "item", "title", "regex", "ask") if not p.get(k)]
        if missing:
            errors.append(f"{pid}: missing {', '.join(missing)}")
            continue
        if pid in seen:
            errors.append(f"{pid}: duplicate id")
        seen.add(pid)
        langs = p.get("languages") or []
        unknown = [l for l in langs if l not in LANGUAGE_GLOBS]
        if unknown:
            errors.append(f"{pid}: unknown languages {unknown}")
        globs = p.get("file_glob") or [g for l in langs for g in LANGUAGE_GLOBS.get(l, [])]
        if not globs:
            errors.append(f"{pid}: no languages or file_glob")
        try:
            rx = re.compile(p["regex"])
        except re.error as e:
            errors.append(f"{pid}: bad regex: {e}")
            continue
        window = int(p.get("window") or 0)
        if window and not re.sub(r"^\(\?i\)", "", p["regex"]).startswith("^"):
            errors.append(f"{pid}: a pattern with window must start with ^")
        patterns.append({**p, "_rx": rx, "_globs": globs, "_window": window,
                         "_comments": bool(p.get("include_comments"))})
    if errors:
        sys.exit(f"{path}: invalid patterns:\n  " + "\n  ".join(errors))
    return patterns


def glob_match(rel, globs):
    name = rel.rsplit("/", 1)[-1]
    return any(fnmatch.fnmatchcase(name, g) or fnmatch.fnmatchcase(rel, g) for g in globs)


def walk(repo):
    for root, dirs, files in os.walk(repo):
        dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS and not d.startswith(SKIP_DIR_PREFIXES))
        for f in sorted(files):
            if f.startswith(SKIP_FILE_PREFIXES) or any(fnmatch.fnmatchcase(f, g) for g in SKIP_FILE_GLOBS):
                continue
            full = Path(root) / f
            if full.is_symlink() or not full.is_file():
                continue
            yield full, full.relative_to(repo).as_posix()


def scan(repo, patterns):
    repo = Path(repo).resolve()
    found = {p["id"]: [] for p in patterns}
    counts = Counter()
    files_scanned = 0
    for full, rel in walk(repo):
        applicable = [p for p in patterns if glob_match(rel, p["_globs"])]
        if not applicable:
            continue
        try:
            if full.stat().st_size > MAX_FILE_BYTES:
                continue
            raw = full.read_bytes()
        except OSError:
            continue
        if b"\0" in raw[:4096]:
            continue
        files_scanned += 1
        lines = raw.decode("utf-8", errors="replace").splitlines()
        is_comment = [bool(COMMENT_LINE.match(l)) for l in lines]
        for p in applicable:
            rx, window = p["_rx"], p["_window"]
            for i, line in enumerate(lines):
                if len(line) > MAX_LINE_CHARS or (is_comment[i] and not p["_comments"]):
                    continue
                subject = "\n".join(lines[i:i + window + 1]) if window else line
                if not rx.search(subject):
                    continue
                counts[p["id"]] += 1
                if len(found[p["id"]]) < MAX_HITS_PER_PATTERN:
                    found[p["id"]].append((rel, i + 1, line.strip()[:MAX_TEXT]))
    hits, capped = [], []
    for p in patterns:
        for rel, lineno, text in found[p["id"]]:
            hits.append({
                "id": f"H{len(hits) + 1:03d}", "pattern": p["id"], "item": p["item"],
                "title": p["title"], "file": rel, "line": lineno, "text": text, "ask": p["ask"].strip(),
            })
        if counts[p["id"]] > MAX_HITS_PER_PATTERN:
            capped.append({"pattern": p["id"], "item": p["item"], "found": counts[p["id"]],
                           "kept": MAX_HITS_PER_PATTERN})
    return {
        "repo": str(repo),
        "patterns_file": str(PATTERNS_FILE),
        "files_scanned": files_scanned,
        "note": "Hits are places to read, not findings. Answer each hit's ask before citing it.",
        "capped": capped,
        "hits": hits,
    }


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("repo")
    ap.add_argument("--out", help="output JSON (default REPO/brace-prescan.json)")
    ap.add_argument("--patterns", default=str(PATTERNS_FILE), help=argparse.SUPPRESS)
    args = ap.parse_args()
    repo = Path(args.repo)
    if not repo.is_dir():
        sys.exit(f"{repo} is not a directory")
    patterns = load_patterns(args.patterns)
    result = scan(repo, patterns)
    out = Path(args.out) if args.out else repo / "brace-prescan.json"
    out.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")

    per_item = Counter(h["item"] for h in result["hits"])
    print(f"Scanned {result['files_scanned']} files with {len(patterns)} patterns: "
          f"{len(result['hits'])} hits written to {out}")
    for item in sorted(per_item):
        print(f"  {item}: {per_item[item]}")
    for c in result["capped"]:
        print(f"  capped {c['pattern']} ({c['item']}): {c['found']} matches, kept {c['kept']}")


if __name__ == "__main__":
    main()

