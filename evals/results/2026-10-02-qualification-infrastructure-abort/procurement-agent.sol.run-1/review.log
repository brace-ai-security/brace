    26	
    27	COMPACT_AFTER_MESSAGES = 40
    28	KEEP_RECENT_MESSAGES = 12
    29	
    30	
    31	@dataclass
    32	class AgentDeps:
    33	    settings: Any
    34	    pool: Any
    35	    gate: PolicyGate
    36	    erp: Any
