string types, mask input and store securely (default: false)\"\n  },\n  {\n    \"id\": \"ts_redirect\",\n    \"verified_on\": \"2026-10-24\",\n    \"url\": \"https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-6prh-2h8m-c8cw\",\n    \"authority\": \"Maintainer security advisory\",\n    \"ghsa_id\": \"GHSA-6prh-2h8m-c8cw\",\n    \"published_at\": \"2026-10-02T20:42:34Z\",\n    \"updated_at\": \"2026-10-19T20:07:25Z\",\n    \"vulnerabilities\": [\n      {\n        \"package\": {\n          \"ecosystem\": \"npm\",\n          \"name\": \"@modelcontextprotocol/sdk\"\n        },\n        \"vulnerable_version_range\": \"< 1.32.0\",\n        \"patched_versions\": \"1.32.0\",\n        \"vulnerable_functions\": []\n      },\n      {\n        \"package\": {\n          \"ecosystem\": \"npm\",\n          \"name\": \"@modelcontextprotocol/client\"\n        },\n        \"vulnerable_version_range\": \">= 2.0.0, < 2.3.0\",\n        \"patched_versions\": \"2.3.0\",\n        \"vulnerable_functions\": []\n      }\n    ]\n  }\n]\n","numLines":56,"startLine":1,"totalLines":56}},"tool_result_meta":[{"id":"toolu_01RZ2xyKYSbyekmn7GRWn798","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
