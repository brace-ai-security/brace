 to the gateway team. Stop conditions: no real tenant data and no production backends."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14334,"cache_read_input_tokens":5290,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14334},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"af0c7745-20f5-4b6d-9897-1973977604bf","uuid":"73881e92-2953-497b-b647-8ed9e9c41a7d","timestamp":"2026-10-23T08:31:20.670Z","request_id":"req_011CgJrc4UCqKNUMfzWKVNjX"}
