{
  "dxt_version": "0.1",
  "name": "ledger-connector",
  "version": "1.0.0",
  "user_config": {
    "access_token": {
      "type": "string",
      "required": true,
      "sensitive": true
    }
  },
  "server": {
    "type": "node",
    "entry_point": "bin/adapter.mjs",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/bin/adapter.mjs"
      ],
      "env": {
        "ACCESS_TOKEN": "${user_config.access_token}"
      }
    }
  },
  "description": "Local ledger MCP bridge",
  "author": {
    "name": "Sample Publisher"
  }
}
