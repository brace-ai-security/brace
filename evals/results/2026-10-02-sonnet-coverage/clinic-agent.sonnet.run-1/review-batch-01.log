eta.get('attempt_categories', [])) - categories:\n        errors.append('needs falsification attempts: ' + ', '.join(sorted(set(meta['attempt_categories']) - categories)))\n    return errors\n\n\ndef failure_rows(c):\n    \"\"\"Return admitted failures and uncertainty, without interpreting free prose.\"\"\"\n    lists = {k: c.get(k) if isinstance(c.get(k),list) else [] for k in ('coverage','deviations','attempts')}\n    rows = [r for r in lists['coverage'] if isinstance(r, dict) and r.get('status') in ('missing', 'unclear')]\n    rows += [r for r in lists['deviations'] if isinstance(r, dict)]\n    rows += [r for r in lists['attempts'] if isinstance(r, dict) and r.get('outcome') in ('accepted', 'unclear')]\n    return rows\n\n\ndef main():\n{'brace_checklist': '2026-10-01', 'repo': '', 'commit': None, 'reviewed_at': '2026-10-02T17:56:08Z', 'scope': \"TODO: what was reviewed and what wasn't.\", 'review_protocol': 'coverage-first-v1', 'injection_attempts': [], 'prescan_resolutions': {}}\n{\n \"item\": \"B01\",\n \"gate\": \"G1\",\n \"title\": \"Minimal tool surface\",\n \"requirement\": \"List every built-in tool, MCP server, API, program, and file permission this agent type can use. Give a task-based reason for each. Enforce a role-based allowlist, and check that an unlisted tool can't be called. Don't base allow or approval decisions on hints a server gives about its own tools, such as \\\"read-only.\\\" MCP treats those hints as untrusted unless you trust the server.\",\n \"not_covered\": [\n  {\n   \"problem\": \"A tool call that skips the MCP gateway or reaches a tool server directly\",\n   \"owner\": \"E06\"\n  },\n  {\n   \"problem\": \"A token or credential with too much access\",\n   \"owner\": \"B02\"\n  },\n  {\n   \"problem\": \"Hidden instructions inside a tool's description or schema\",\n   \"owner\": \"E04\"\n  },\n  {\n   \"problem\": \"A tool's description or schema changing after it was approved\",\n   \"owner\": \"E03\"\n  },\n  {\n   \"problem\": \"