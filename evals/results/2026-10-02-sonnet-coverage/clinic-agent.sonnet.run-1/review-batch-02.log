  \"kind\": \"tool_registration\",\n      \"evidence\": \"src/control/kill-switch.ts:36\",\n      \"quote\": \"if (item.halted === true) next.add(String(item.pk));\"\n    },\n    {\n      \"id\": \"I302e6a1980\",\n      \"kind\": \"handoff\",\n      \"evidence\": \"src/routes/webchat.ts:57\",\n      \"quote\": \"return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });\"\n    },\n    {\n      \"id\": \"I1861b59462\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/server.ts:49\",\n      \"quote\": \"registry.registerMcp(\\\"ehr\\\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\"\n    },\n    {\n      \"id\": \"I8fa6be25eb\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/tools/executor.ts:51\",\n      \"quote\": \"await audit.record({ ...base, event: \\\"tool.denied\\\", reason });\"\n    },\n    {\n      \"id\": \"Ia3450fc0b4\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/tools/executor.ts:77\",\n      \"quote\": \"await audit.record({ ...base, event: \\\"tool.approval_requested\\\", approvalId: rec.id });\"\n    },\n    {\n      \"id\": \"I5b433eb517\",\n      \"kind\": \"tool_call\",\n      \"evidence\": \"src/tools/executor.ts:86\",\n      \"quote\": \"const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\"\n    },\n    {\n      \"id\": \"Ifd82e31a71\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/tools/executor.ts:89\",\n      \"quote\": \"await audit.record({ ...base, event: \\\"tool.executed\\\", approvalId, detail: { clinicId } });\"\n    },\n    {\n      \"id\": \"I077346bcfe\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/tools/executor.ts:93\",\n      \"quote\": \"await audit.record({ ...base, event: \\\"tool.failed\\\", approvalId, reason: (err as Error).message.slice(0, 300) });\"\n    },\n    {\n      \"id\": \"I140bd2f97f\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/tools/registry.ts:101\",\n      \"quote\": \"registerMcp(\"\n    },\n    {\n      \"id\": \"I131c91d8de\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/tools/registry.ts:127\",\n      \"quote\": \"this.add({\"\n    },\n    {\n      \"id\": \"I18aec0bd94\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/tools/registry.ts:94\",\n      \"quote\": \"for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\"\n    },\n    {\n      \"id\": \"I3a7e594185\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/workers/reminders.ts:36\",","is_error":false}]},"parent_tool_use_id":null,"session_id":"b4cc3c69-55e0-473e-bfe4-b389a6e801c0","uuid":"503a2b07-0a5d-4331-bc25-52ed2784cc8d","timestamp":"2026-10-02T18:00:20.984Z","tool_use_result":{"stdout":"     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport { createHash, randomUUID } from \"node:crypto\";\n     4\timport { env, policy } from \"../config.js\";\n     5\t\n     6\t// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n     7\t// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n     8\t// approvedAt); the agent then retries the tool with the approval id.\n     9\t\n    10\texport interface ApprovalRecord {\n    11\t  id: string;\n    12\t  status: \"pending\" | \"approved\" | \"rejected\";\n    13\t  tool: string;\n    14\t  tenantId: string;\n    15\t  agentInstanceId: string;\n    16\t  runId: string;\n    17\t  argsHash: string;\n    18\t  summary: string;\n    19\t  requestedAt: string;\n    20\t  expiresAt: string;\n    21\t  approvedBy?: string;\n    22\t  approverRole?: string;\n    23\t  approvedAt?: string;\n    24\t}\n    25\t\n    26\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    27\t\n    28\texport function hashArgs(args: Record<string, unknown>): string {\n    29\t  const canonical = JSON.stringify(args, Object.keys(args).sort());\n    30\t  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n    31\t}\n    32\t\n    33\texport async function requestApproval(req: {\n    34\t  tool: string;\n    35\t  tenantId: string;\n    36\t  agentInstanceId: string;\n    37\t  runId: string;\n    38\t  args: Record<string, unknown>;\n    39\t  summary: string;\n    40\t}): Promise<ApprovalRecord> {\n    41\t  const now = Date.now();\n    42\t  const rec: ApprovalRecord = {\n    43\t    id: randomUUID(),\n    44\t    status: \"pending\",\n    45\t    tool: req.tool,\n    46\t    tenantId: req.tenantId,\n    47\t    agentInstanceId: req.agentInstanceId,\n    48\t    runId: req.runId,\n    49\t    argsHash: hashArgs(req.args),\n    50\t    summary: req.summary,\n    51\t    requestedAt: new Date(now).toISOString(),\n    52\t    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n    53\t  };\n    54\t  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n    55\t  return rec;\n    56\t}\n    57\t\n    58\texport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n    59\t\n    60\texport async function checkApproval(req: {\n    61\t  approvalId: string;\n    62\t  tool: string;\n    63\t  tenantId: string;\n    64\t  args: Record<string, unknown>;\n    65\t}): Promise<ApprovalCheck> {\n    66\t  let rec: ApprovalRecord | undefined;\n    67\t  try {\n    68\t    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    69\t    rec = res.Item as ApprovalRecord | undefined;\n    70\t  } catch (err) {\n    71\t    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n    72\t  }\n    73\t  if (!rec) return { ok: false, reason: \"approval not found\" };\n    74\t  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n    75\t  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n    76\t  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n    77\t  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n    78\t  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    79\t    return { ok: false, reason: \"approver lacks authority\" };\n    80\t  }\n    81\t  return { ok: true, approval: rec };\n    82\t}\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { allowlist, policy } from \"../config.js\";\n     3\timport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\n     4\timport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\n     5\timport type { ContextSize } from \"../agent/context-size.js\";\n     6\timport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\n     7\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     8\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     9\timport { payments } from \"../integrations/payments.js\";\n    10\timport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\n    11\timport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\n    12\timport { checkApproval, requestApproval } from \"./approvals.js\";\n    13\timport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n    14\t\n    15\texport interface Decision {\n    16\t  contextSize: ContextSize;\n    17\t  budget: RunBudget;\n    18\t}\n    19\t\n    20\tconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n    21\t// Arguments the harness consumes itself; they are never forwarded to a tool.\n    22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n    23\t\n    24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n    25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n    26\t}\n    27\t\n    28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n    29\t  return `${tool}(${Object.entries(args)\n    30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    31\t    .join(\", \")})`.slice(0, 500);\n    32\t}\n    33\t\n    34\texport async function executeTool(\n    35\t  registry: ToolRegistry,\n    36\t  ctx: RunContext,\n    37\t  call: Anthropic.ToolUseBlock,\n    38\t  d: Decision,\n    39\t): Promise<Anthropic.ToolResultBlockParam> {\n    40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n    41\t  const base = {\n    42\t    ...ctx.identity(),\n    43\t    runId: ctx.runId,\n    44\t    subject: ctx.subject,\n    45\t    tool: call.name,\n    46\t    toolUseId: call.id,\n    47\t    policyVersion: policy.version,\n    48\t    context: d.contextSize,\n    49\t  };\n    50\t  const deny = async (reason: string) => {\n    51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n    52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n    53\t  };\n    54\t\n    55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n    56\t  const tool = registry.get(call.name);\n    57\t  if (!tool) return deny(\"not_registered\");\n    58\t\n    59\t  await killSwitch.assertRunning(ctx.tenantId);\n    60\t  await d.budget.toolCall(call.name);\n    61\t\n    62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n    63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n    64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n    65\t\n    66\t  let approvalId: string | undefined;\n    67\t  if (policy.highImpactTools.includes(call.name)) {\n    68\t    if (typeof input.approvalId !== \"string\") {\n    69\t      const rec = await requestApproval({\n    70\t        tool: call.name,\n    71\t        tenantId: clinicId,\n    72\t        agentInstanceId: AGENT_INSTANCE_ID,\n    73\t        runId: ctx.runId,\n    74\t        args,\n    75\t        summary: summarize(call.name, args),\n    76\t      });\n    77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n    78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    79\t    }\n    80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    81\t    if (!check.ok) return deny(check.reason);\n    82\t    approvalId = check.approval.id;\n    83\t  }\n    84\t\n    85\t  try {\n    86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    88\t    const safe = redactPhi(raw);\n    89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    90\t    return toolResult(call.id, safe);\n    91\t  } catch (err) {\n    92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n    95\t  }\n    96\t}\n    97\t\n    98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n    99\t\n   100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n   101\t  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n   102\t    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n   103\t\n   104\t  return {\n   105\t    payments: [\n   106\t      {\n   107\t        name: \"refund_deposit\",\n   108\t        definition: {\n   109\t          name: \"payments__refund_deposit\",\n   110\t          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n   111\t          input_schema: {\n   112\t            type: \"object\",\n   113\t            properties: {\n   114\t              depositId: { type: \"string\" },\n   115\t              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n   116\t              approvalId: { type: \"string\" },\n   117\t            },\n   118\t            required: [\"depositId\", \"reason\"],\n   119\t          },\n   120\t        },\n   121\t        invoke: async (a, o) =>\n   122\t          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n   123\t      },\n   124\t    ],\n   125\t    sms: [\n   126\t      {\n   127\t        name: \"send_to_patient\",\n   128\t        definition: {\n   129\t          name: \"sms__send_to_patient\",\n   130\t          description: \"Send a templated SMS to the phone number on the patient's record.\",\n   131\t          input_schema: {\n   132\t            type: \"object\",\n   133\t            properties: {\n   134\t              patientId: { type: \"string\" },\n   135\t              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n   136\t              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n   137\t            },\n   138\t            required: [\"patientId\", \"template\"],\n   139\t          },\n   140\t        },\n   141\t        invoke: async (a, o) => {\n   142\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   143\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   144\t          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n   145\t          return sms.send(o.clinicId, c.phone, body, o.signal);\n   146\t        },\n   147\t      },\n   148\t      {\n   149\t        name: \"send_freeform\",\n   150\t        definition: {\n   151\t          name: \"sms__send_freeform\",\n   152\t          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n   153\t          input_schema: {\n   154\t            type: \"object\",\n   155\t            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n   156\t            required: [\"patientId\", \"body\"],\n   157\t          },\n   158\t        },\n   159\t        invoke: async (a, o) => {\n   160\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   161\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   162\t          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n   163\t        },\n   164\t      },\n   165\t    ],\n   166\t    insurance: [\n   167\t      {\n   168\t        name: \"check_eligibility\",\n   169\t        definition: {\n   170\t          name: \"insurance__check_eligibility\",\n   171\t          description: \"Check whether the patient's insurance covers an appointment.\",\n   172\t          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n   173\t        },\n   174\t        invoke: async (a, o) =>\n   175\t          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n   176\t            clinicId: o.clinicId,\n   177\t            ctx: o.runCtx as RunContext,\n   178\t            signal: o.signal,\n   179\t            context: o.context,\n   180\t          }),\n   181\t      },\n   182\t    ],\n   183\t  };\n   184\t}\n     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, UpdateCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport type { Budgets } from \"../config.js\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\texport type LimitName =\n     7\t  | \"turns\"\n     8\t  | \"wall_time\"\n     9\t  | \"input_tokens\"\n    10\t  | \"output_tokens\"\n    11\t  | \"run_cost\"\n    12\t  | \"tool_calls\"\n    13\t  | \"tool_call_rate\"\n    14\t  | \"peer_calls\"\n    15\t  | \"subject_daily_cost\"\n    16\t  | \"tenant_daily_cost\"\n    17\t  | \"fleet_daily_cost\"\n    18\t  | \"tenant_tool_rate\"\n    19\t  | \"fleet_tool_rate\";\n    20\t\n    21\texport class BudgetExceeded extends Error {\n    22\t  constructor(public limit: LimitName, public used: number, public max: number) {\n    23\t    super(`budget exceeded: ${limit} (${used} > ${max})`);\n    24\t  }\n    25\t}\n    26\t\n    27\t// Shared counters across runs and pods. add() must be atomic and refuse to go past max.\n    28\texport interface QuotaStore {\n    29\t  add(key: string, amount: number, max: number, ttlSeconds: number): Promise<{ ok: boolean; used: number }>;\n    30\t}\n    31\t\n    32\texport class DynamoQuotaStore implements QuotaStore {\n    33\t  private ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    34\t  async add(key: string, amount: number, max: number, ttlSeconds: number) {\n    35\t    try {\n    36\t      const res = await this.ddb.send(\n    37\t        new UpdateCommand({\n    38\t          TableName: env.budgetTable,\n    39\t          Key: { pk: key },\n    40\t          UpdateExpression: \"ADD used :n SET expiresAt = if_not_exists(expiresAt, :exp)\",\n    41\t          ConditionExpression: \"attribute_not_exists(used) OR used <= :room\",\n    42\t          ExpressionAttributeValues: {\n    43\t            \":n\": amount,\n    44\t            \":room\": max - amount,\n    45\t            \":exp\": Math.floor(Date.now() / 1000) + ttlSeconds,\n    46\t          },\n    47\t          ReturnValues: \"UPDATED_NEW\",\n    48\t        }),\n    49\t      );\n    50\t      return { ok: true, used: Number(res.Attributes?.used ?? amount) };\n    51\t    } catch (err) {\n    52\t      if ((err as { name?: string }).name === \"ConditionalCheckFailedException\") return { ok: false, used: max };\n    53\t      throw err;\n    54\t    }\n    55\t  }\n    56\t}\n    57\t\n    58\texport interface Usage {\n    59\t  input_tokens: number;\n    60\t  output_tokens: number;\n    61\t  cache_read_input_tokens?: number | null;\n    62\t  cache_creation_input_tokens?: number | null;\n    63\t}\n    64\t\n    65\tconst day = () => new Date().toISOString().slice(0, 10);\n    66\tconst minute = () => new Date().toISOString().slice(0, 16);\n    67\t\n    68\texport class RunBudget {\n    69\t  readonly abort = new AbortController();\n    70\t  private started = Date.now();\n    71\t  private timer: NodeJS.Timeout;\n    72\t  private turns = 0;\n    73\t  private inTok = 0;\n    74\t  private outTok = 0;\n    75\t  private cost = 0;\n    76\t  private toolCalls = 0;\n    77\t  private toolTimes: number[] = [];\n    78\t  private peerCalls = 0;\n    79\t\n    80\t  constructor(\n    81\t    private b: Budgets,\n    82\t    private store: QuotaStore,\n    83\t    private scope: { tenantId: string; subjectId: string },\n    84\t    private now: () => number = Date.now,\n    85\t  ) {\n    86\t    this.started = this.now();\n    87\t    this.timer = setTimeout(\n    88\t      () => this.abort.abort(new BudgetExceeded(\"wall_time\", this.b.run.maxWallMs, this.b.run.maxWallMs)),\n    89\t      this.b.run.maxWallMs,\n    90\t    );\n    91\t  }\n    92\t\n    93\t  get signal(): AbortSignal {\n    94\t    return this.abort.signal;\n    95\t  }\n    96\t\n    97\t  dispose(): void {\n    98\t    clearTimeout(this.timer);\n    99\t  }\n   100\t\n   101\t  private check(limit: LimitName, used: number, max: number): void {\n   102\t    if (used > max) {\n   103\t      const e = new BudgetExceeded(limit, used, max);\n   104\t      this.abort.abort(e);\n   105\t      throw e;\n   106\t    }\n   107\t  }\n   108\t\n   109\t  private checkWall(): void {\n   110\t    this.check(\"wall_time\", this.now() - this.started, this.b.run.maxWallMs);\n   111\t  }\n   112\t\n   113\t  turn(): void {\n   114\t    this.checkWall();\n   115\t    this.turns += 1;\n   116\t    this.check(\"turns\", this.turns, this.b.run.maxTurns);\n   117\t  }\n   118\t\n   119\t  async recordUsage(u: Usage, model: string): Promise<void> {\n   120\t    const price = this.b.pricingUsdPerMTok[model];\n   121\t    if (!price) throw new Error(`no pricing for model ${model}`);\n   122\t    const cacheRead = u.cache_read_input_tokens ?? 0;\n   123\t    const cacheWrite = u.cache_creation_input_tokens ?? 0;\n   124\t    const callCost =\n   125\t      (u.input_tokens * price.input +\n   126\t        u.output_tokens * price.output +\n   127\t        cacheRead * price.cacheRead +\n   128\t        cacheWrite * price.cacheWrite) /\n   129\t      1_000_000;\n   130\t\n   131\t    this.inTok += u.input_tokens + cacheRead + cacheWrite;\n   132\t    this.outTok += u.output_tokens;\n   133\t    this.cost += callCost;\n   134\t    this.check(\"input_tokens\", this.inTok, this.b.run.maxInputTokens);\n   135\t    this.check(\"output_tokens\", this.outTok, this.b.run.maxOutputTokens);\n   136\t    this.check(\"run_cost\", this.cost, this.b.run.maxCostUsd);\n   137\t\n   138\t    const q = this.b.quotas;\n   139\t    await this.shared(\"subject_daily_cost\", `cost#subject#${this.scope.subjectId}#${day()}`, callCost, q.perSubjectDailyUsd, 86400);\n   140\t    await this.shared(\"tenant_daily_cost\", `cost#tenant#${this.scope.tenantId}#${day()}`, callCost, q.perTenantDailyUsd, 86400);\n   141\t    await this.shared(\"fleet_daily_cost\", `cost#fleet#${day()}`, callCost, q.fleetDailyUsd, 86400);\n   142\t  }\n   143\t\n   144\t  async toolCall(tool: string): Promise<void> {\n   145\t    this.checkWall();\n   146\t    this.toolCalls += 1;\n   147\t    this.check(\"tool_calls\", this.toolCalls, this.b.run.maxToolCalls);\n   148\t\n   149\t    const t = this.now();\n   150\t    this.toolTimes = this.toolTimes.filter((x) => t - x < 60_000);\n   151\t    this.toolTimes.push(t);\n   152\t    this.check(\"tool_call_rate\", this.toolTimes.length, this.b.run.maxToolCallsPerMinute);\n   153\t\n   154\t    if (tool.startsWith(\"insurance__\")) {\n   155\t      this.peerCalls += 1;\n   156\t      this.check(\"peer_calls\", this.peerCalls, this.b.run.maxPeerCalls);\n   157\t    }\n   158\t\n   159\t    const q = this.b.quotas;\n   160\t    await this.shared(\"tenant_tool_rate\", `rate#tenant#${this.scope.tenantId}#${minute()}`, 1, q.perTenantToolCallsPerMinute, 120);\n   161\t    await this.shared(\"fleet_tool_rate\", `rate#fleet#${minute()}`, 1, q.fleetToolCallsPerMinute, 120);\n   162\t  }\n   163\t\n   164\t  private async shared(limit: LimitName, key: string, amount: number, max: number, ttl: number): Promise<void> {\n   165\t    const r = await this.store.add(key, amount, max, ttl);\n   166\t    if (!r.ok) {\n   167\t      const e = new BudgetExceeded(limit, r.used + amount, max);\n   168\t      this.abort.abort(e);\n   169\t      throw e;\n   170\t    }\n   171\t  }\n   172\t}\n{\n  \"sites\": [\n    {\n      \"id\": \"If7878f59fe\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/agent/budget.ts:165\",\n      \"quote\": \"const r = await this.store.add(key, amount, max, ttl);\"\n    },\n    {\n      \"id\": \"I11c134ddd9\",\n      \"kind\": \"m