{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011Cfdr5axkDRjNSKcAVExPK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HDucmfcPBJqYviZKtXWSZz","name":"Bash","input":{"command":"cat -n src/agent/context-size.ts src/workflows/eligibility-check.ts src/workers/reminders.ts src/integrations/eligibility-a2a.ts; cat -n k8s/deployment.yaml Dockerfile"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6321,"cache_read_input_tokens":34342,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6321},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b4cc3c69-55e0-473e-bfe4-b389a6e801c0","uuid":"810306c4-10ce-45e9-9e97-15d086b0d9b1","timestamp":"2026-10-02T18:00:28.947Z","request_id":"req_011Cfdr5aaRHDXMUcTBjoaJa","wire_tool_inputs":{"toolu_01HDucmfcPBJqYviZKtXWSZz":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-k_2p1gcg/agent && cat -n src/agent/context-size.ts src/workflows/eligibility-check.ts src/workers/reminders.ts src/integrations/eligibility-a2a.ts; cat -n k8s/deployment.yaml Dockerfile"}},"wire_ingest_context":{"toolu_01HDucmfcPBJqYviZKtXWSZz":{"cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-k_2p1gcg/agent"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HDucmfcPBJqYviZKtXWSZz","type":"tool_result","content":"     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\t\n     3\t// Context size at decision time, in tokens.\n     4\t//\n     5\t// Counting method. Each model decision is one Messages API call. Its response usage reports the\n     6\t// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and\n     7\t// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,\n     8\t// including the part served from the prompt cache and the provider's own tool-use preamble, which\n     9\t// the provider counts but does not show. This is a per-call value, not a run or billing total.\n    10\t// We record it as \"measured\", with the cached share kept separately.\n    11\t//\n    12\t// If the response carries no usage (stream cut off, aborted call), we fall back to the\n    13\t// count_tokens estimate taken just before the call for the same request, and mark it \"estimated\".\n    14\t// If neither exists the value is null with status \"unavailable\". It is never reported as 0.\n    15\t//\n    16\t// This harness never compacts, summarizes, or truncates history inside a run, so compacted is\n    17\t// always false; a run that would outgrow its token budget stops instead (see budget.ts).\n    18\texport interface ContextSize {\n    19\t  tokens: number | null;\n    20\t  status: \"measured\" | \"estimated\" | \"unavailable\";\n    21\t  method: string;\n    22\t  cachedInputTokens: number | null;\n    23\t  compacted: boolean;\n    24\t}\n    25\t\n    26\texport const USAGE_METHOD = \"anthropic.messages.usage(input+cache_read+cache_creation)\";\n    27\texport const COUNT_METHOD = \"anthropic.messages.count_tokens(pre-call estimate)\";\n    28\t\n    29\texport async function measureBeforeCall(\n    30\t  client: Anthropic,\n    31\t  req: Anthropic.MessageCountTokensParams,\n    32\t  signal: AbortSignal,\n    33\t): Promise<ContextSize> {\n    34\t  try {\n    35\t    const r = await client.messages.countTokens(req, { signal });\n    36\t    return { tokens: r.input_tokens, status: \"estimated\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    37\t  } catch {\n    38\t    return { tokens: null, status: \"unavailable\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    39\t  }\n    40\t}\n    41\t\n    42\texport function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {\n    43\t  if (!usage) return pre;\n    44\t  const cacheRead = usage.cache_read_input_tokens ?? 0;\n    45\t  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);\n    46\t  return { tokens: total, status: \"measured\", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };\n    47\t}\n    48\t\n    49\t// Span attributes so the value is searchable next to the action in traces as well as audit.\n    50\texport function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {\n    51\t  return {\n    52\t    ...(c.tokens === null ? {} : { \"clinic_agent.context.tokens\": c.tokens }),\n    53\t    \"clinic_agent.context.status\": c.status,\n    54\t    \"clinic_agent.context.method\": c.method,\n    55\t    \"gen_ai.conversation.compacted\": c.compacted,\n    56\t  };\n    57\t}\n     1\timport { audit } from \"../audit/recorder.js\";\n     2\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     3\timport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\n     4\timport { payments } from \"../integrations/payments.js\";\n     5\timport type { RunContext } from \"../agent/identity.js\";\n     6\timport type { ContextSize } from \"../agent/context-size.js\";\n     7\t\n     8\t// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n     9\t// agent, and settles the visit deposit when the plan covers the visit.\n    10\t\n    11\texport async function checkEligibilityForAppointment(\n    12\t  ehr: Ehr,\n    13\t  input: { appointmentId: string },\n    14\t  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n    15\t): Promise<Eligibility & { depositRefundId?: string }> {\n    16\t  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n    17\t\n    18\t  const result = await checkEligibility(\n    19\t    {\n    20\t      clinicId: opts.clinicId,\n    21\t      patientId: appt.patientId,\n    22\t      payerId: appt.payerId,\n    23\t      serviceCode: appt.serviceCode,\n    24\t      dateOfService: appt.start.slice(0, 10),\n    25\t    },\n    26\t    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n    27\t  );\n    28\t  await audit.record({\n    29\t    ...opts.ctx.identity(),\n    30\t    runId: opts.ctx.runId,\n    31\t    subject: opts.ctx.subject,\n    32\t    event: \"peer.call\",\n    33\t    tool: \"insurance__check_eligibility\",\n    34\t    context: opts.context,\n    35\t    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n    36\t  });\n    37\t\n    38\t  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n    39\t  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n    40\t    const refund = await payments.refundDeposit(\n    41\t      opts.clinicId,\n    42\t      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n    43\t      opts.signal,\n    44\t    );\n    45\t    await audit.record({\n    46\t      ...opts.ctx.identity(),\n    47\t      runId: opts.ctx.runId,\n    48\t      subject: opts.ctx.subject,\n    49\t      event: \"payment.refund\",\n    50\t      tool: \"insurance__check_eligibility\",\n    51\t      context: opts.context,\n    52\t      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n    53\t    });\n    54\t    return { ...result, depositRefundId: refund.id };\n    55\t  }\n    56\t  return result;\n    57\t}\n     1\timport pino from \"pino\";\n     2\timport { manifest } from \"../config.js\";\n     3\timport { audit } from \"../audit/recorder.js\";\n     4\timport { computeAgentTypeId, newRunContext, setAgentTypeId } from \"../agent/identity.js\";\n     5\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"../integrations/ehr-mcp.js\";\n     7\timport { render, sms } from \"../integrations/sms.js\";\n     8\t\n     9\t// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.\n    10\tconst log = pino({ level: \"info\" });\n    11\t\n    12\tconst directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    13\tsetAgentTypeId(\n    14\t  computeAgentTypeId({\n    15\t    imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    16\t    harnessVersion: manifest.harness.version,\n    17\t    harnessGitSha: process.env.GIT_SHA ?? \"\",\n    18\t  }),\n    19\t);\n    20\t\n    21\tconst ehr = ehrClient(manifest.tools.mcpServers.find((s: { id: string }) => s.id === \"ehr\"));\n    22\tconst tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);\n    23\t\n    24\tfor (const clinic of directory) {\n    25\t  const ctx = newRunContext({ tenantId: clinic.id, subject: { kind: \"system\", id: \"reminders-cron\" }, channel: \"reminder\", log });\n    26\t  const abort = new AbortController();\n    27\t  const unregister = killSwitch.register(ctx.runId, clinic.id, abort);\n    28\t  try {\n    29\t    await killSwitch.assertRunning(clinic.id);\n    30\t    const appts = await ehr.appointmentsOn(clinic.id, tomorrow, abort.signal);\n    31\t    for (const a of appts) {\n    32\t      if (!a.smsOptIn) continue;\n    33\t      await killSwitch.assertRunning(clinic.id);\n    34\t      const when = new Date(a.start).toLocaleString(\"en-US\", { weekday: \"short\", hour: \"numeric\", minute: \"2-digit\" });\n    35\t      const res = await sms.send(clinic.id, a.phone, render(\"reminder\", { firstName: \"\", when, location: a.locationName }), abort.signal);\n    36\t      await audit.record({\n    37\t        ...ctx.identity(),\n    38\t        runId: ctx.runId,\n    39\t        subject: ctx.subject,\n    40\t        event: \"reminder.sent\",\n    41\t        tool: \"sms__send_to_patient\",\n    42\t        // Scheduled, templated send: no model decided this action.\n    43\t        context: { tokens: null, status: \"unavailable\", method: \"no_model_decision\", cachedInputTokens: null, compacted: false },\n    44\t        detail: { appointmentId: a.id, messageId: res.messageId },\n    45\t      });\n    46\t    }\n    47\t  } catch (err) {\n    48\t    if (err instanceof Halted) {\n    49\t      log.warn({ clinic: clinic.id, scope: err.scope }, \"reminders halted\");\n    50\t      break;\n    51\t    }\n    52\t    log.error({ clinic: clinic.id, err: (err as Error).message }, \"reminder run failed\");\n    53\t    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \"run.stopped\", reason: (err as Error).message.slice(0, 200) });\n    54\t  } finally {\n    55\t    unregister();\n    56\t  }\n    57\t}\n    58\tprocess.exit(0);\n     1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n     7\t//\n     8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n     9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n    10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n    11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n    12\t//\n    13\t// Answers come back as a signed attestation (JWS) inside a data part.\n    14\t\n    15\tconst Eligibility = z\n    16\t  .object({\n    17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    18\t    planName: z.string().max(120).optional(),\n    19\t    copayCents: z.number().int().nonnegative().optional(),\n    20\t    depositWaived: z.boolean().default(false),\n    21\t    checkedAt: z.string().datetime(),\n    22\t  })\n    23\t  .strict();\n    24\texport type Eligibility = z.infer<typeof Eligibility>;\n    25\t\n    26\tconst Rpc = z.object({\n    27\t  jsonrpc: z.literal(\"2.0\"),\n    28\t  id: z.string(),\n    29\t  result: z.object({\n    30\t    kind: z.literal(\"message\"),\n    31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n    32\t  }),\n    33\t});\n    34\t\n    35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n    36\t  const res = await fetch(env.tokenExchangeUrl, {\n    37\t    method: \"POST\",\n    38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    39\t    body: new URLSearchParams({\n    40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    41\t      subject_token: workloadToken,\n    42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n    43\t      audience: \"eligibility-agent\",\n    44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n    45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    46\t    }),\n    47\t  });\n    48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n    49\t  return ((await res.json()) as { access_token: string }).access_token;\n    50\t}\n    51\t\n    52\texport async function checkEligibility(\n    53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n    54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n    55\t): Promise<Eligibility> {\n    56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n    57\t  const requestId = randomUUID();\n    58\t  const res = await fetch(env.eligibilityUrl, {\n    59\t    method: \"POST\",\n    60\t    signal: opts.signal,\n    61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    62\t    body: JSON.stringify({\n    63\t      jsonrpc: \"2.0\",\n    64\t      id: requestId,\n    65\t      method: \"message/send\",\n    66\t      params: {\n    67\t        message: {\n    68\t          role: \"user\",\n    69\t          messageId: requestId,\n    70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n    71\t        },\n    72\t      },\n    73\t    }),\n    74\t  });\n    75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n    76\t  const text = await res.text();\n    77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n    78\t  const rpc = Rpc.parse(JSON.parse(text));\n    79\t\n    80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n    81\t  const header = decodeProtectedHeader(attestation);\n    82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n    83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n    84\t  const { payload } = await jwtVerify(attestation, keys, {\n    85\t    issuer: env.eligibilityIssuer,\n    86\t    audience: \"clinic-agent\",\n    87\t    maxTokenAge: \"5m\",\n    88\t    algorithms: [\"ES256\"],\n    89\t  });\n    90\t  return Eligibility.parse(payload.eligibility);\n    91\t}\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: clinic-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.33\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: clinic-agent\n    15\t  namespace: clinic-agent\n    16\t  annotations:\n    17\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    18\t    eks.amazonaws.com/token-expiration: \"3600\"\n    19\tautomountServiceAccountToken: false\n    20\t---\n    21\tapiVersion: v1\n    22\tkind: ServiceAccount\n    23\tmetadata:\n    24\t  name: clinic-agent-reminders\n    25\t  namespace: clinic-agent\n    26\t  annotations:\n    27\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    28\tautomountServiceAccountToken: false\n    29\t---\n    30\tapiVersion: v1\n    31\tkind: ConfigMap\n    32\tmetadata:\n    33\t  name: clinic-agent\n    34\t  namespace: clinic-agent\n    35\tdata:\n    36\t  CLINIC_DIRECTORY: |\n    37\t    [{\"id\":\"nb-castro\",\"name\":\"Northbay Castro\",\"smsNumber\":\"+14155550110\"},\n    38\t     {\"id\":\"nb-fremont\",\"name\":\"Northbay Fremont\",\"smsNumber\":\"+15105550111\"},\n    39\t     {\"id\":\"nb-oakland\",\"name\":\"Northbay Oakland\",\"smsNumber\":\"+15105550112\"},\n    40\t     {\"id\":\"nb-sanmateo\",\"name\":\"Northbay San Mateo\",\"smsNumber\":\"+16505550113\"},\n    41\t     {\"id\":\"nb-walnutcreek\",\"name\":\"Northbay Walnut Creek\",\"smsNumber\":\"+19255550114\"}]\n    42\t  SMS_SIGNING_SECRET_ARN: arn:aws:secretsmanager:us-west-2:418295730611:secret:clinic-agent/sms-signing\n    43\t  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n    44\t  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n    45\t---\n    46\tapiVersion: apps/v1\n    47\tkind: Deployment\n    48\tmetadata:\n    49\t  name: clinic-agent\n    50\t  namespace: clinic-agent\n    51\t  labels: { app: clinic-agent }\n    52\tspec:\n    53\t  replicas: 3\n    54\t  selector:\n    55\t    matchLabels: { app: clinic-agent }\n    56\t  template:\n    57\t    metadata:\n    58\t      labels: { app: clinic-agent }\n    59\t    spec:\n    60\t      serviceAccountName: clinic-agent\n    61\t      automountServiceAccountToken: false\n    62\t      hostUsers: false\n    63\t      hostNetwork: false\n    64\t      hostPID: false\n    65\t      hostIPC: false\n    66\t      enableServiceLinks: false\n    67\t      securityContext:\n    68\t        runAsNonRoot: true\n    69\t        runAsUser: 65532\n    70\t        runAsGroup: 65532\n    71\t        fsGroup: 65532\n    72\t        seccompProfile:\n    73\t          type: RuntimeDefault\n    74\t      containers:\n    75\t        - name: agent\n    76\t          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    77\t          ports:\n    78\t            - containerPort: 8080\n    79\t          envFrom:\n    80\t            - configMapRef: { name: clinic-agent }\n    81\t          env:\n    82\t            - name: IMAGE_DIGEST\n    83\t              value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    84\t            - name: GIT_SHA\n    85\t              value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n    86\t          securityContext:\n    87\t            allowPrivilegeEscalation: false\n    88\t            privileged: false\n    89\t            readOnlyRootFilesystem: true\n    90\t            runAsNonRoot: true\n    91\t            capabilities:\n    92\t              drop: [\"ALL\"]\n    93\t            seccompProfile:\n    94\t              type: RuntimeDefault\n    95\t          resources:\n    96\t            requests: { cpu: 250m, memory: 384Mi }\n    97\t            limits: { cpu: \"1\", memory: 768Mi }\n    98\t          readinessProbe:\n    99\t            httpGet: { path: /healthz, port: 8080 }\n   100\t          volumeMounts:\n   101\t            - { name: tmp, mountPath: /tmp }\n   102\t            - { name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true }\n   103\t      volumes:\n   104\t        - name: tmp\n   105\t          emptyDir: { medium: Memory, sizeLimit: 32Mi }\n   106\t        - name: sts-token\n   107\t          projected:\n   108\t            sources:\n   109\t              - serviceAccountToken:\n   110\t                  audience: https://sts.northbay-clinics.example\n   111\t                  expirationSeconds: 900\n   112\t                  path: sts-token\n   113\t---\n   114\tapiVersion: batch/v1\n   115\tkind: CronJob\n   116\tmetadata:\n   117\t  name: clinic-agent-reminders\n   118\t  namespace: clinic-agent\n   119\tspec:\n   120\t  schedule: \"0 17 * * *\"\n   121\t  timeZone: America/Los_Angeles\n   122\t  concurrencyPolicy: Forbid\n   123\t  jobTemplate:\n   124\t    spec:\n   125\t      backoffLimit: 0\n   126\t      activeDeadlineSeconds: 1800\n   127\t      template:\n   128\t        metadata:\n   129\t          labels: { app: clinic-agent-reminders }\n   130\t        spec:\n   131\t          serviceAccountName: clinic-agent-reminders\n   132\t          automountServiceAccountToken: false\n   133\t          restartPolicy: Never\n   134\t          hostUsers: false\n   135\t          securityContext:\n   136\t            runAsNonRoot: true\n   137\t            runAsUser: 65532\n   138\t            runAsGroup: 65532\n   139\t            seccompProfile:\n   140\t              type: RuntimeDefault\n   141\t          containers:\n   142\t            - name: reminders\n   143\t              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   144\t              args: [\"dist/workers/reminders.js\"]\n   145\t              envFrom:\n   146\t                - configMapRef: { name: clinic-agent }\n   147\t              env:\n   148\t                - name: IMAGE_DIGEST\n   149\t                  value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   150\t                - name: GIT_SHA\n   151\t                  value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n   152\t              securityContext:\n   153\t                allowPrivilegeEscalation: false\n   154\t                privileged: false\n   155\t                readOnlyRootFilesystem: true\n   156\t                capabilities:\n   157\t                  drop: [\"ALL\"]\n   158\t---\n   159\t# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n   160\t# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,\n   161\t# the group STS and auth service, and AWS service endpoints.\n   162\tapiVersion: networking.k8s.io/v1\n   163\tkind: NetworkPolicy\n   164\tmetadata:\n   165\t  name: clinic-agent-egress\n   166\t  namespace: clinic-agent\n   167\tspec:\n   168\t  podSelector: {}\n   169\t  policyTypes: [\"Egress\", \"Ingress\"]\n   170\t  ingress:\n   171\t    - from:\n   172\t        - namespaceSelector:\n   173\t            matchLabels: { kubernetes.io/metadata.name: ingress }\n   174\t      ports:\n   175\t        - { port: 8080, protocol: TCP }\n   176\t  egress:\n   177\t    - to:\n   178\t        - namespaceSelector:\n   179\t            matchLabels: { kubernetes.io/metadata.name: kube-system }\n   180\t          podSelector:\n   181\t            matchLabels: { k8s-app: kube-dns }\n   182\t      ports:\n   183\t        - { port: 53, protocol: UDP }\n   184\t        - { port: 53, protocol: TCP }\n   185\t    - to:\n   186\t        - namespaceSelector:\n   187\t            matchLabels: { kubernetes.io/metadata.name: platform }\n   188\t          podSelector:\n   189\t            matchLabels: { app: egress-proxy }\n   190\t      ports:\n   191\t        - { port: 3128, protocol: TCP }\n   192\t    - to:\n   193\t        - ipBlock: { cidr: 10.60.12.0/28 }\n   194\t      ports:\n   195\t        - { port: 443, protocol: TCP }\n     1\t# syntax=docker/dockerfile:1.7\n     2\tFROM node:22.11-bookworm-slim@sha256:3f1a8d2c9b7e4f6a5d0c8b1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a AS build\n     3\tWORKDIR /app\n     4\tCOPY package.json package-lock.json ./\n     5\tRUN npm ci --ignore-scripts\n     6\tCOPY tsconfig.json ./\n     7\tCOPY src ./src\n     8\tRUN npm run build && npm prune --omit=dev\n     9\t\n    10\tFROM gcr.io/distroless/nodejs22-debian12:nonroot@sha256:9b2e4c6a8d0f1e3c5a7b9d1f3e5c7a9b1d3f5e7c9a1b3d5f7e9c1a3b5d7f9e1c\n    11\tWORKDIR /app\n    12\tENV NODE_ENV=production \\\n    13\t    CLINIC_AGENT_ROOT=/app\n    14\tCOPY --from=build --chown=65532:65532 /app/node_modules ./node_modules\n    15\tCOPY --from=build --chown=65532:65532 /app/dist ./dist\n    16\tCOPY --chown=65532:65532 package.json ./\n    17\tCOPY --chown=65532:65532 prompts ./prompts\n    18\tCOPY --chown=65532:65532 config ./config\n    19\tCOPY --chown=65532:65532 release ./release\n    20\tUSER 65532:65532\n    21\tEXPOSE 8080\n    22\tCMD [\"dist/server.js\"]","is_error":false}]},"parent_tool_use_id":null,"session_id":"b4cc3c69-55e0-473e-bfe4-b389a6e801c0","uuid":"0c198243-735b-4a4b-ba75-66cfb08e2397","timestamp":"2026-10-02T18:00:29.002Z","tool_use_result":{"stdout":"     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\t\n     3\t// Context size at decision time, in tokens.\n     4\t//\n     5\t// Counting method. Each model decision is one Messages API call. Its response usage reports the\n     6\t// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and\n     7\t// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,\n     8\t// including the part served from the prompt cache and the provider's own tool-use preamble, which\n     9\t// the provider counts but does not show. This is a per-call value, not a run or billing total.\n    10\t// We record it as \"measured\", with the cached share kept separately.\n    11\t//\n    12\t// If the response carries no usage (stream cut off, aborted call), we fall back to the\n    13\t// count_tokens estimate taken just before the call for the same request, and mark it \"estimated\".\n    14\t// If neither exists the value is null with status \"unavailable\". It is never reported as 0.\n    15\t//\n    16\t// This harness never compacts, summarizes, or truncates history inside a run, so compacted is\n    17\t// always false; a run that would outgrow its token budget stops instead (see budget.ts).\n    18\texport interface ContextSize {\n    19\t  tokens: number | null;\n    20\t  status: \"measured\" | \"estimated\" | \"unavailable\";\n    21\t  method: string;\n    22\t  cachedInputTokens: number | null;\n    23\t  compacted: boolean;\n    24\t}\n    25\t\n    26\texport const USAGE_METHOD = \"anthropic.messages.usage(input+cache_read+cache_creation)\";\n    27\texport const COUNT_METHOD = \"anthropic.messages.count_tokens(pre-call estimate)\";\n    28\t\n    29\texport async function measureBeforeCall(\n    30\t  client: Anthropic,\n    31\t  req: Anthropic.MessageCountTokensParams,\n    32\t  signal: AbortSignal,\n    33\t): Promise<ContextSize> {\n    34\t  try {\n    35\t    const r = await client.messages.countTokens(req, { signal });\n    36\t    return { tokens: r.input_tokens, status: \"estimated\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    37\t  } catch {\n    38\t    return { tokens: null, status: \"unavailable\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    39\t  }\n    40\t}\n    41\t\n    42\texport function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {\n    43\t  if (!usage) return pre;\n    44\t  const cacheRead = usage.cache_read_input_tokens ?? 0;\n    45\t  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);\n    46\t  return { tokens: total, status: \"measured\", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };\n    47\t}\n    48\t\n    49\t// Span attributes so the value is searchable next to the action in traces as well as audit.\n    50\texport function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {\n    51\t  return {\n    52\t    ...(c.tokens === null ? {} : { \"clinic_agent.context.tokens\": c.tokens }),\n    53\t    \"clinic_agent.context.status\": c.status,\n    54\t    \"clinic_agent.context.method\": c.method,\n    55\t    \"gen_ai.conversation.compacted\": c.compacted,\n    56\t  };\n    57\t}\n     1\timport { audit } from \"../audit/recorder.js\";\n     2\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     3\timport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\n     4\timport { payments } from \"../integrations/payments.js\";\n     5\timport type { RunContext } from \"../agent/identity.js\";\n     6\timport type { ContextSize } from \"../agent/context-size.js\";\n     7\t\n     8\t// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n     9\t// agent, and settles the visit deposit when the plan covers the visit.\n    10\t\n    11\texport async function checkEligibilityForAppointment(\n    12\t  ehr: Ehr,\n    13\t  input: { appointmentId: string },\n    14\t  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n    15\t): Promise<Eligibility & { depositRefundId?: string }> {\n    16\t  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n    17\t\n    18\t  const result = await checkEligibility(\n    19\t    {\n    20\t      clinicId: opts.clinicId,\n    21\t      patientId: appt.patientId,\n    22\t      payerId: appt.payerId,\n    23\t      serviceCode: appt.serviceCode,\n    24\t      dateOfService: appt.start.slice(0, 10),\n    25\t    },\n    26\t    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n    27\t  );\n    28\t  await audit.record({\n    29\t    ...opts.ctx.identity(),\n    30\t    runId: opts.ctx.runId,\n    31\t    subject: opts.ctx.subject,\n    32\t    event: \"peer.call\",\n    33\t    tool: \"insurance__check_eligibility\",\n    34\t    context: opts.context,\n    35\t    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n    36\t  });\n    37\t\n    38\t  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n    39\t  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n    40\t    const refund = await payments.refundDeposit(\n    41\t      opts.clinicId,\n    42\t      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n    43\t      opts.signal,\n    44\t    );\n    45\t    await audit.record({\n    46\t      ...opts.ctx.identity(),\n    47\t      runId: opts.ctx.runId,\n    48\t      subject: opts.ctx.subject,\n    49\t      event: \"payment.refund\",\n    50\t      tool: \"insurance__check_eligibility\",\n    51\t      context: opts.context,\n    52\t      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n    53\t    });\n    54\t    return { ...result, depositRefundId: refund.id };\n    55\t  }\n    56\t  return result;\n    57\t}\n     1\timport pino from \"pino\";\n     2\timport { manifest } from \"../config.js\";\n     3\timport { audit } from \"../audit/recorder.js\";\n     4\timport { computeAgentTypeId, newRunContext, setAgentTypeId } from \"../agent/identity.js\";\n     5\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"../integrations/ehr-mcp.js\";\n     7\timport { render, sms } from \"../integrations/sms.js\";\n     8\t\n     9\t// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.\n    10\tconst log = pino({ level: \"info\" });\n    11\t\n    12\tconst directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    13\tsetAgentTypeId(\n    14\t  computeAgentTypeId({\n    15\t    imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    16\t    harnessVersion: manifest.harness.version,\n    17\t    harnessGitSha: process.env.GIT_SHA ?? \"\",\n    18\t  }),\n    19\t);\n    20\t\n    21\tconst ehr = ehrClient(manifest.tools.mcpServers.find((s: { id: string }) => s.id === \"ehr\"));\n    22\tconst tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);\n    23\t\n    24\tfor (const clinic of directory) {\n    25\t  const ctx = newRunContext({ tenantId: clinic.id, subject: { kind: \"system\", id: \"reminders-cron\" }, channel: \"reminder\", log });\n    26\t  const abort = new AbortController();\n    27\t  const unregister = killSwitch.register(ctx.runId, clinic.id, abort);\n    28\t  try {\n    29\t    await killSwitch.assertRunning(clinic.id);\n    30\t    const appts = await ehr.appointmentsOn(clinic.id, tomorrow, abort.signal);\n    31\t    for (const a of appts) {\n    32\t      if (!a.smsOptIn) continue;\n    33\t      await killSwitch.assertRunning(clinic.id);\n    34\t      const when = new Date(a.start).toLocaleString(\"en-US\", { weekday: \"short\", hour: \"numeric\", minute: \"2-digit\" });\n    35\t      const res = await sms.send(clinic.id, a.phone, render(\"reminder\", { firstName: \"\", when, location: a.locationName }), abort.signal);\n    36\t      await audit.record({\n    37\t        ...ctx.identity(),\n    38\t        runId: ctx.runId,\n    39\t        subject: ctx.subject,\n    40\t        event: \"reminder.sent\",\n    41\t        tool: \"sms__send_to_patient\",\n    42\t        // Scheduled, templated send: no model decided this action.\n    43\t        context: { tokens: null, status: \"unavailable\", method: \"no_model_decision\", cachedInputTokens: null, compacted: false },\n    44\t        detail: { appointmentId: a.id, messageId: res.messageId },\n    45\t      });\n    46\t    }\n    47\t  } catch (err) {\n    48\t    if (err instanceof Halted) {\n    49\t      log.warn({ clinic: clinic.id, scope: err.scope }, \"reminders halted\");\n    50\t      break;\n    51\t    }\n    52\t    log.error({ clinic: clinic.id, err: (err as Error).message }, \"reminder run failed\");\n    53\t    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \"run.stopped\", reason: (err as Error).message.slice(0, 200) });\n    54\t  } finally {\n    55\t    unregister();\n    56\t  }\n    57\t}\n    58\tprocess.exit(0);\n     1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n     7\t//\n     8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n     9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n    10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n    11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n    12\t//\n    13\t// Answers come back as a signed attestation (JWS) inside a data part.\n    14\t\n    15\tconst Eligibility = z\n    16\t  .object({\n    17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    18\t    planName: z.string().max(120).optional(),\n    19\t    copayCents: z.number().int().nonnegative().optional(),\n    20\t    depositWaived: z.boolean().default(false),\n    21\t    checkedAt: z.string().datetime(),\n    22\t  })\n    23\t  .strict();\n    24\texport type Eligibility = z.infer<typeof Eligibility>;\n    25\t\n    26\tconst Rpc = z.object({\n    27\t  jsonrpc: z.literal(\"2.0\"),\n    28\t  id: z.string(),\n    29\t  result: z.object({\n    30\t    kind: z.literal(\"message\"),\n    31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n    32\t  }),\n    33\t});\n    34\t\n    35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n    36\t  const res = await fetch(env.tokenExchangeUrl, {\n    37\t    method: \"POST\",\n    38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    39\t    body: new URLSearchParams({\n    40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    41\t      subject_token: workloadToken,\n    42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n    43\t      audience: \"eligibility-agent\",\n    44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n    45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    46\t    }),\n    47\t  });\n    48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n    49\t  return ((await res.json()) as { access_token: string }).access_token;\n    50\t}\n    51\t\n    52\texport async function checkEligibility(\n    53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n    54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n    55\t): Promise<Eligibility> {\n    56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n    57\t  const requestId = randomUUID();\n    58\t  const res = await fetch(env.eligibilityUrl, {\n    59\t    method: \"POST\",\n    60\t    signal: opts.signal,\n    61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    62\t    body: JSON.stringify({\n    63\t      jsonrpc: \"2.0\",\n    64\t      id: requestId,\n    65\t      method: \"message/send\",\n    66\t      params: {\n    67\t        message: {\n    68\t          role: \"user\",\n    69\t          messageId: requestId,\n    70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n    71\t        },\n    72\t      },\n    73\t    }),\n    74\t  });\n    75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n    76\t  const text = await res.text();\n    77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n    78\t  const rpc = Rpc.parse(JSON.parse(text));\n    79\t\n    80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n    81\t  const header = decodeProtectedHeader(attestation);\n    82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n    83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n    84\t  const { payload } = await jwtVerify(attestation, keys, {\n    85\t    issuer: env.eligibilityIssuer,\n    86\t    audience: \"clinic-agent\",\n    87\t    maxTokenAge: \"5m\",\n    88\t    algorithms: [\"ES256\"],\n    89\t  });\n    90\t  return Eligibility.parse(payload.eligibility);\n    91\t}\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: clinic-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.33\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: clinic-agent\n    15\t  namespace: clinic-agent\n    16\t  annotations:\n    17\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    18\t    eks.amazonaws.com/token-expiration: \"3600\"\n    19\tautomountServiceAccountToken: false\n    20\t---\n    21\tapiVersion: v1\n    22\tkind: ServiceAccount\n    23\tmetadata:\n    24\t  name: clinic-agent-reminders\n    25\t  namespace: clinic-agent\n    26\t  annotations:\n    27\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    28\tautomountServiceAccountToken: false\n    29\t---\n    30\tapiVersion: v1\n    31\tkind: ConfigMap\n    32\tmetadata:\n    33\t  name: clinic-agent\n    34\t  namespace: clinic-agent\n    35\tdata:\n    36\t  CLINIC_DIRECTORY: |\n    37\t    [{\"id\":\"nb-castro\",\"name\":\"Northbay Castro\",\"smsNumber\":\"+14155550110\"},\n    38\t     {\"id\":\"nb-fremont\",\"name\":\"Northbay Fremont\",\"smsNumber\":\"+15105550111\"},\n    39\t     {\"id\":\"nb-oakland\",\"name\":\"Northbay Oakland\",\"smsNumber\":\"+15105550112\"},\n    40\t     {\"id\":\"nb-sanmateo\",\"name\":\"Northbay San Mateo\",\"smsNumber\":\"+16505550113\"},\n    41\t     {\"id\":\"nb-walnutcreek\",\"name\":\"Northbay Walnut Creek\",\"smsNumber\":\"+19255550114\"}]\n    42\t  SMS_SIGNING_SECRET_ARN: arn:aws:secretsmanager:us-west-2:418295730611:secret:clinic-agent/sms-signing\n    43\t  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n    44\t  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n    45\t---\n    46\tapiVersion: apps/v1\n    47\tkind: Deployment\n    48\tmetadata:\n    49\t  name: clinic-agent\n    50\t  namespace: clinic-agent\n    51\t  labels: { app: clinic-agent }\n    52\tspec:\n    53\t  replicas: 3\n    54\t  selector:\n    55\t    matchLabels: { app: clinic-agent }\n    56\t  template:\n    57\t    metadata:\n    58\t      labels: { app: clinic-agent }\n    59\t    spec:\n    60\t      serviceAccountName: clinic-agent\n    61\t      automountServiceAccountToken: false\n    62\t      hostUsers: false\n    63\t      hostNetwork: false\n    64\t      hostPID: false\n    65\t      hostIPC: false\n    66\t      enableServiceLinks: false\n    67\t      securityContext:\n    68\t        runAsNonRoot: true\n    69\t        runAsUser: 65532\n    70\t        runAsGroup: 65532\n    71\t        fsGroup: 65532\n    72\t        seccompProfile:\n    73\t          type: RuntimeDefault\n    74\t      containers:\n    75\t        - name: agent\n    76\t          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    77\t          ports:\n    78\t            - containerPort: 8080\n    79\t          envFrom:\n    80\t            - configMapRef: { name: clinic-agent }\n    81\t          env:\n    82\t            - name: IMAGE_DIGEST\n    83\t              value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    84\t            - name: GIT_SHA\n    85\t              value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n    86\t          securityContext:\n    87\t            allowPrivilegeEscalation: false\n    88\t            privileged: false\n    89\t            readOnlyRootFilesystem: true\n    90\t            runAsNonRoot: true\n    91\t            capabilities:\n    92\t              drop: [\"ALL\"]\n    93\t            seccompProfile:\n    94\t              type: RuntimeDefault\n    95\t          resources:\n    96\t            requests: { cpu: 250m, memory: 384Mi }\n    97\t            limits: { cpu: \"1\", memory: 768Mi }\n    98\t          readinessProbe:\n    99\t            httpGet: { path: /healthz, port: 8080 }\n   100\t          volumeMounts:\n   101\t            - { name: tmp, mountPath: /tmp }\n   102\t            - { name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true }\n   103\t      volumes:\n   104\t        - name: tmp\n   105\t          emptyDir: { medium: Memory, sizeLimit: 32Mi }\n   106\t        - name: sts-token\n   107\t          projected:\n   108\t            sources:\n   109\t              - serviceAccountToken:\n   110\t                  audience: https://sts.northbay-clinics.example\n   111\t                  expirationSeconds: 900\n   112\t                  path: sts-token\n   113\t---\n   114\tapiVersion: batch/v1\n   115\tkind: CronJob\n   116\tmetadata:\n   117\t  name: clinic-agent-reminders\n   118\t  namespace: clinic-agent\n   119\tspec:\n   120\t  schedule: \"0 17 * * *\"\n   121\t  timeZone: America/Los_Angeles\n   122\t  concurrencyPolicy: Forbid\n   123\t  jobTemplate:\n   124\t    spec:\n   125\t      backoffLimit: 0\n   126\t      activeDeadlineSeconds: 1800\n   127\t      template:\n   128\t        metadata:\n   129\t          labels: { app: clinic-agent-reminders }\n   130\t        spec:\n   131\t          serviceAccountName: clinic-agent-reminders\n   132\t          automountServiceAccountToken: false\n   133\t          restartPolicy: Never\n   134\t          hostUsers: false\n   135\t          securityContext:\n   136\t            runAsNonRoot: true\n   137\t            runAsUser: 65532\n   138\t            runAsGroup: 65532\n   139\t            seccompProfile:\n   140\t              type: RuntimeDefault\n   141\t          containers:\n   142\t            - name: reminders\n   143\t              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   144\t              args: [\"dist/workers/reminders.js\"]\n   145\t              envFrom:\n   146\t                - configMapRef: { name: clinic-agent }\n   147\t              env:\n   148\t                - name: IMAGE_DIGEST\n   149\t                  value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   150\t                - name: GIT_SHA\n   151\t                  value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n   152\t              securityContext:\n   153\t                allowPrivilegeEscalation: false\n   154\t                privileged: false\n   155\t                readOnlyRootFilesystem: true\n   156\t                capabilities:\n   157\t                  drop: [\"ALL\"]\n   158\t---\n   159\t# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n   160\t# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,\n   161\t# the group STS and auth service, and AWS service endpoints.\n   162\tapiVersion: networking.k8s.io/v1\n   163\tkind: NetworkPolicy\n   164\tmetadata:\n   165\t  name: clinic-agent-egress\n   166\t  namespace: clinic-agent\n   167\tspec:\n   168\t  podSelector: {}\n   169\t  policyTypes: [\"Egress\", \"Ingress\"]\n   170\t  ingress:\n   171\t    - from:\n   172\t        - namespaceSelector:\n   173\t            matchLabels: { kubernetes.io/metadata.name: ingress }\n   174\t      ports:\n   175\t        - { port: 8080, protocol: TCP }\n   176\t  egress:\n   177\t    - to:\n   178\t        - namespaceSelector:\n   179\t            matchLabels: { kubernetes.io/metadata.name: kube-system }\n   180\t          podSelector:\n   181\t            matchLabels: { k8s-app: kube-dns }\n   182\t      ports:\n   183\t        - { port: 53, protocol: UDP }\n   184\t        - { port: 53, protocol: TCP }\n   185\t    - to:\n   186\t        - namespaceSelector:\n   187\t            matchLabels: { kubernetes.io/metadata.name: platform }\n   188\t          podSelector:\n   189\t            matchLabels: { app: egress-proxy }\n   190\t      ports:\n   191\t        - { port: 3128, protocol: TCP }\n   192\t    - to:\n   193\t        - ipBlock: { cidr: 10.60.12.0/28 }\n   194\t      ports:\n   195\t        - { port: 443, protocol: TCP }\n     1\t# syntax=docker/dockerfile:1.7\n     2\tFROM node:22.11-bookworm-slim@sha256:3f1a8d2c9b7e4f6a5d0c8b1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a AS build\n     3\tWORKDIR /app\n     4\tCOPY package.json package-lock.json ./\n     5\tRUN npm ci --ignore-scripts\n     6\tCOPY tsconfig.json ./\n     7\tCOPY src ./src\n     8\tRUN npm run build && npm prune --omit=dev\n     9\t\n    10\tFROM gcr.io/distroless/nodejs22-debian12:nonroot@sha256:9b2e4c6a8d0f1e3c5a7b9d1f3e5c7a9b1d3f5e7c9a1b3d5f7e9c1a3b5d7f9e1c\n    11\tWORKDIR /app\n    12\tENV NODE_ENV=production \\\n    13\t    CLINIC_AGENT_ROOT=/app\n    14\tCOPY --from=build --chown=65532:65532 /app/node_modules ./node_modules\n    15\tCOPY --from=build --chown=65532:65532 /app/dist ./dist\n    16\tCOPY --chown=65532:65532 package.json ./\n    17\tCOPY --chown=65532:65532 prompts ./prompts\n    18\tCOPY --chown=65532:65532 config ./config\n    19\tCOPY --chown=65532:65532 release ./release\n    20\tUSER 65532:65532\n    21\tEXPOSE 8080\n    22\tCMD [\"dist/server.js\"]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
