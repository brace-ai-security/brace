{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XzthRB12PeWodZ5TMmwK45","type":"tool_result","content":"     1\t\"\"\"Synthetic ticket triage harness. Dependencies are injected; read, never run.\"\"\"\n     2\timport re\n     3\timport json\n     4\timport unicodedata\n     5\t\n     6\t\n     7\tdef context(response):\n     8\t    return {\"tokens\": response.usage.input_tokens + response.usage.cached_input_tokens,\n     9\t            \"method\": \"provider_input_plus_cache\", \"status\": \"measured\", \"compacted\": False}\n    10\t\n    11\t\n    12\tasync def record(db, run, action, measure, result):\n    13\t    await db.execute(\"INSERT INTO events(run_id, action, context, result) VALUES($1,$2,$3,$4)\",\n    14\t                     run.id, action, measure, result)\n    15\t\n    16\t\n    17\tasync def decide(client, db, run, text):\n    18\t    answer = await client.responses.create(model=\"route-2026-09\", input=text, max_output_tokens=64)\n    19\t    await record(db, run, \"routing\", context(answer), answer.output_text)\n    20\t    return answer.output_text  # no decision measure crosses this handoff\n    21\t\n    22\t\n    23\tasync def reserve(db, run):\n    24\t    # PostgreSQL shared by all replicas; serialize all three scope rows.\n    25\t    async with db.transaction():\n    26\t        for key in (\"user:\" + run.user, \"tenant:\" + run.tenant, \"fleet\"):\n    27\t            await db.execute(\"UPDATE quotas SET spent=spent+1 WHERE id=$1 AND spent+1<=cap RETURNING id\", key)\n    28\t\n    29\t\n    30\tasync def run_ticket(client, db, run, ticket, server, tools):\n    31\t    route = await decide(client, db, run, ticket)\n    32\t    await record(db, run, \"delegate_result\", None, route)\n    33\t    catalog = {\"instructions\": server.instructions, \"tools\": load_catalog(server, tools),\n    34\t               \"prompts\": server.prompts, \"resources\": server.resource_templates}\n    35\t    for turn in range(4):\n    36\t        await reserve(db, run)\n    37\t        response = await client.responses.create(model=\"main-2026-09\", input=route + json.dumps(catalog), max_output_tokens=256)\n    38\t        await record(db, run, \"decision\", context(response), response.output_text)\n    39\t        if response.output_text == \"done\":\n    40\t            return response.output_text\n    41\t\n    42\t\n    43\tdef scan_text(text):\n    44\t    if len(text) > 1024 or re.search(r\"[\\x00-\\x1f\\u200b\\u202a-\\u202e]\", text):\n    45\t        raise ValueError(\"metadata rejected\")\n    46\t    if re.search(r\"ignore.*instructions|system\\s*:|https?://|[a-f0-9]{32,}|[A-Za-z0-9+/]{48,}={0,2}\", text, re.I | re.S):\n    47\t        raise ValueError(\"metadata rejected\")\n    48\t\n    49\t\n    50\tdef load_catalog(server, tools):\n    51\t    accepted = []\n    52\t    for tool in tools:\n    53\t        for field in (\"name\", \"title\", \"description\", \"inputSchema\", \"outputSchema\", \"annotations\"):\n    54\t            scan_text(str(tool.get(field, \"\")))\n    55\t        accepted.append({\"key\": server.endpoint + \"__\" + tool[\"name\"], **tool})\n    56\t    return accepted  # server instructions/prompts/resources skip all scanner rules\n    57\t\n    58\t\n    59\tdef canonical(name):\n    60\t    return re.sub(r\"[_-]\", \"\", unicodedata.normalize(\"NFKC\", name).casefold()).replace(\"1\", \"i\")\n    61\t\n    62\t\n    63\tdef register(existing, server, tool):\n    64\t    for prior in existing:\n    65\t        if prior[\"server\"] == server.endpoint and canonical(prior[\"name\"]) == canonical(tool[\"name\"]):\n    66\t            raise ValueError(\"name conflict\")\n    67\t    entry = {\"server\": server.endpoint, \"name\": tool[\"name\"], \"key\": server.endpoint + \"__\" + tool[\"name\"]}\n    68\t    existing.append(entry)\n    69\t    return entry\ntotal 64\ndrwxr-xr-x@ 5 brenn  staff    160 Oct  2 20:03 .\ndrwx------@ 5 brenn  staff    160 Oct  2 