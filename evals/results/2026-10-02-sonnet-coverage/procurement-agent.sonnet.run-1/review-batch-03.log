       return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n...\n</persisted-output>","is_error":false}]},"parent_tool_use_id":null,"session_id":"422fd315-a0f9-49c7-bdf9-64937721f06b","uuid":"04bd49bd-c04b-427f-aceb-070a5d15d45a","timestamp":"2026-10-02T18:03:41.460Z","tool_use_result":{"stdout":"=== app/loop.py\n     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n=== app/extractor.py\n     1\t\"\"\"Line-item extraction sub-agent.\n     2\t\n     3\tThe parent procurement agent delegates structured extraction to a smaller\n     4\tmodel. The child runs under its own instance id, links to its parent in the\n     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport json\n    10\timport logging\n    11\tfrom typing import Any\n    12\t\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom app import audit\n    16\tfrom app.budget import Budget\n    17\tfrom app.context_size import measure_context\n    18\tfrom app.identity import RunIdentity\n    19\tfrom app.redact import redact_for_model\n    20\tfrom app.tools import build_registry\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n    24\t\n    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n    26\tMAX_TURNS = 4\n    27\t\n    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n    29\t\n    30\t\n    31\tclass ExtractionFailed(Exception):\n    32\t    pass\n    33\t\n    34\t\n    35\tclass LineItemExtractor:\n    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n    37\t        self.client = client\n    38\t        self.settings = settings\n    39\t        self.deps = deps\n    40\t        self.system_prompt = system_prompt\n    41\t\n    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n    43\t        budget.check_subagent()\n    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n    47\t\n    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n    51\t            start_node = await audit.record(\n    52\t                self.deps.pool,\n    53\t                ident,\n    54\t                kind=\"subagent_started\",\n    55\t                payload={\n    56\t                    \"role\": EXTRACTOR_ROLE,\n    57\t                    \"doc_id\": doc_id,\n    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n    59\t                    \"tools\": registry.names(),\n    60\t                },\n    61\t            )\n    62\t\n    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n    64\t            for _turn in range(MAX_TURNS):\n    65\t                budget.check_step()\n    66\t                request = {\n    67\t                    \"model\": self.settings.extractor_model_id,\n    68\t                    \"system\": self.system_prompt,\n    69\t                    \"messages\": messages,\n    70\t                    \"tools\": registry.schemas(),\n    71\t                    \"max_tokens\": 4096,\n    72\t                }\n    73\t                ctx = await measure_context(self.client, request, compacted=False)\n    74\t                response = await self.client.messages.create(**request)\n    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n    76\t                await budget.flush(self.deps.pool)\n    77\t                ctx = ctx.finalize(response.usage)\n    78\t                decision = await audit.record(\n    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n    81\t                             \"stop_reason\": response.stop_reason},\n    82\t                )\n    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n    85\t                if not uses:\n    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n    87\t                    items = _parse_items(text)\n    88\t                    await audit.record(\n    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n    90\t                        payload={\"items\": len(items)},\n    91\t                    )\n    92\t                    return items\n    93\t                results = []\n    94\t                for use in uses:\n    95\t                    budget.check_tool_call()\n    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n    97\t                messages.append({\"role\": \"user\", \"content\": results})\n    98\t\n    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n   100\t\n   101\t\n   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n   103\t    try:\n   104\t        data = json.loads(text)\n   105\t    except json.JSONDecodeError as exc:\n   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n   107\t    if not isinstance(data, list) or len(data) > 500:\n   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n   109\t    items = []\n   110\t    for raw in data:\n   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n   114\t    return items\n=== app/redact.py\n     1\t\"\"\"Redaction for model input, logs, audit payloads, and outbound messages.\n     2\t\n     3\tApplied in four places:\n     4\t  * tool results before they are appended to the model context (loop.py)\n     5\t  * every audit payload (audit.py)\n     6\t  * the root logging filter (main.py)\n     7\t  * outbound Slack text (tools/slack.py)\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport logging\n    12\timport re\n    13\tfrom typing import Any\n    14\tfrom urllib.parse import urlparse\n    15\t\n    16\tSECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n    17\t    (\"bearer\", re.compile(r\"(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]{16,}\")),\n    18\t    (\"jwt\", re.compile(r\"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b\")),\n    19\t    (\"acct_token\", re.compile(r\"\\bacct_tok_[A-Za-z0-9_]{8,}\\b\")),\n    20\t    (\"pay_token\", re.compile(r\"\\bpay_tok_[A-Za-z0-9_]{8,}\\b\")),\n    21\t    (\"erp_session\", re.compile(r\"\\berp_sess_[A-Za-z0-9_]{8,}\\b\")),\n    22\t    (\"password_kv\", re.compile(r\"(?i)\\b(password|passwd|secret|api[_-]?key)\\s*[:=]\\s*\\S+\")),\n    23\t]\n    24\t\n    25\t# Bank details: keep the last four characters so staff can still match records.\n    26\tACCOUNT_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n    27\t    (\"iban\", re.compile(r\"\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b\")),\n    28\t    (\"account_no\", re.compile(r\"(?i)\\b(account|acct|routing)\\s*(no\\.?|number|#)?\\s*[:#]?\\s*(\\d[\\d -]{6,}\\d)\")),\n    29\t]\n    30\t\n    31\tMARKDOWN_IMAGE = re.compile(r\"!\\[[^\\]]*\\]\\(([^)\\s]+)[^)]*\\)\")\n    32\tMARKDOWN_LINK = re.compile(r\"(?<!!)\\[([^\\]]*)\\]\\(([^)\\s]+)[^)]*\\)\")\n    33\tSLACK_LINK = re.compile(r\"<(https?://[^|>]+)(\\|[^>]*)?>\")\n    34\tBARE_URL = re.compile(r\"https?://[^\\s<>()]+\")\n    35\t\n    36\tAPPROVED_LINK_HOSTS = frozenset({\"erp.example-corp.test\", \"intranet.example-corp.test\"})\n    37\t\n    38\t\n    39\tdef _mask_tail(match: re.Match[str]) -> str:\n    40\t    text = match.group(0)\n    41\t    return \"[REDACTED:\" + \"*\" * 4 + text[-4:] + \"]\"\n    42\t\n    43\t\n    44\tdef redact_text(text: str) -> str:\n    45\t    for name, pattern in SECRET_PATTERNS:\n    46\t        text = pattern.sub(f\"[REDACTED:{name}]\", text)\n    47\t    for _name, pattern in ACCOUNT_PATTERNS:\n    48\t        text = pattern.sub(_mask_tail, text)\n    49\t    return text\n    50\t\n    51\t\n    52\tdef redact_value(value: Any) -> Any:\n    53\t    if isinstance(value, str):\n    54\t        return redact_text(value)\n    55\t    if isinstance(value, dict):\n    56\t        return {k: redact_value(v) for k, v in value.items()}\n    57\t    if isinstance(value, (list, tuple)):\n    58\t        return [redact_value(v) for v in value]\n    59\t    return value\n    60\t\n    61\t\n    62\tdef redact_for_model(value: Any) -> str:\n    63\t    if not isinstance(value, str):\n    64\t        import json\n    65\t\n    66\t        value = json.dumps(value, default=str)\n    67\t    return redact_text(value)\n    68\t\n    69\t\n    70\tdef _host_ok(url: str) -> bool:\n    71\t    host = (urlparse(url).hostname or \"\").lower()\n    72\t    return host in APPROVED_LINK_HOSTS\n    73\t\n    74\t\n    75\tdef strip_unapproved_links(text: str) -> str:\n    76\t    \"\"\"Remove images entirely and drop links to hosts outside the allowlist.\n    77\t\n    78\t    Slack and most chat clients fetch link and image URLs to render previews,\n    79\t    so an attacker-chosen URL can carry data out without any tool call.\n    80\t    \"\"\"\n    81\t    text = MARKDOWN_IMAGE.sub(\"[image removed]\", text)\n    82\t    text = MARKDOWN_LINK.sub(\n    83\t        lambda m: m.group(0) if _host_ok(m.group(2)) else m.group(1), text\n    84\t    )\n    85\t    text = SLACK_LINK.sub(\n    86\t        lambda m: m.group(0) if _host_ok(m.group(1)) else \"[link removed]\", text\n    87\t    )\n    88\t    text = BARE_URL.sub(\n    89\t        lambda m: m.group(0) if _host_ok(m.group(0)) else \"[link removed]\", text\n    90\t    )\n    91\t    return text\n    92\t\n    93\t\n    94\tclass RedactingFilter(logging.Filter):\n    95\t    def filter(self, record: logging.LogRecord) -> bool:\n    96\t        if isinstance(record.msg, str):\n    97\t            record.msg = redact_text(record.msg)\n    98\t        if record.args:\n    99\t            record.args = tuple(redact_value(a) for a in record.args)\n   100\t        return True\n=== app/ingest.py\n     1\t\"\"\"Inbound documents: vendor quotes and invoices from the mail gateway.\n     2\t\n     3\tThe mail gateway posts each received message to ``/ingest/mail`` signed with\n     4\tan HMAC over the timestamp and body. Accepted documents are stored per\n     5\tbusiness unit and are only ever shown to the model inside an\n     6\t``untrusted_document`` wrapper (tools/documents.py).\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport base64\n    11\timport email\n    12\timport email.policy\n    13\timport hashlib\n    14\timport hmac\n    15\timport io\n    16\timport re\n    17\timport time\n    18\timport uuid\n    19\tfrom dataclasses import dataclass\n    20\tfrom pathlib import Path\n    21\t\n    22\tfrom fastapi import APIRouter, HTTPException, Request\n    23\tfrom pypdf import PdfReader\n    24\t\n    25\trouter = APIRouter()\n    26\t\n    27\tMAX_BODY_BYTES = 10 * 1024 * 1024\n    28\tMAX_TEXT_CHARS = 200_000\n    29\tMAX_SKEW_SECONDS = 300\n    30\tALLOWED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\", \"message/rfc822\"}\n    31\tSCANNED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\"}\n    32\t\n    33\tINJECTION_PATTERNS = [\n    34\t    re.compile(r\"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)\"),\n    35\t    re.compile(r\"(?i)\\b(system|developer) (prompt|message)\\b\"),\n    36\t    re.compile(r\"(?i)\\byou are (now )?(an?|the) \\w+ (agent|assistant)\\b\"),\n    37\t    re.compile(r\"(?i)\\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\\b\"),\n    38\t    re.compile(r\"(?i)\\b(update|change) (our|the) (bank|remit|payee)\\b\"),\n    39\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    40\t]\n    41\t\n    42\t\n    43\tclass Rejected(Exception):\n    44\t    pass\n    45\t\n    46\t\n    47\t@dataclass\n    48\tclass Inbound:\n    49\t    business_unit: str\n    50\t    sender: str\n    51\t    media_type: str\n    52\t    raw: bytes\n    53\t\n    54\t\n    55\tdef verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:\n    56\t    try:\n    57\t        ts = int(timestamp)\n    58\t    except ValueError as exc:\n    59\t        raise Rejected(\"bad timestamp\") from exc\n    60\t    if abs(time.time() - ts) > MAX_SKEW_SECONDS:\n    61\t        raise Rejected(\"stale request\")\n    62\t    expected = hmac.new(key, f\"{timestamp}.\".encode() + body, hashlib.sha256).hexdigest()\n    63\t    if not hmac.compare_digest(expected, signature):\n    64\t        raise Rejected(\"bad signature\")\n    65\t\n    66\t\n    67\tdef extract_text(doc: Inbound) -> str:\n    68\t    if doc.media_type == \"application/pdf\":\n    69\t        reader = PdfReader(io.BytesIO(doc.raw))\n    70\t        if len(reader.pages) > 50:\n    71\t            raise Rejected(\"too many pages\")\n    72\t        return \"\\n\".join(page.extract_text() or \"\" for page in reader.pages)\n    73\t    if doc.media_type == \"message/rfc822\":\n    74\t        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)\n    75\t        body = msg.get_body(preferencelist=(\"plain\", \"html\"))\n    76\t        return body.get_content() if body is not None else \"\"\n    77\t    return doc.raw.decode(\"utf-8\", errors=\"strict\")\n    78\t\n    79\t\n    80\tdef scan_for_injection(text: str) -> list[str]:\n    81\t    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]\n    82\t\n    83\t\n    84\tdef validate(doc: Inbound) -> str:\n    85\t    if doc.media_type not in ALLOWED_MEDIA_TYPES:\n    86\t        raise Rejected(f\"media type {doc.media_type} not accepted\")\n    87\t    if len(doc.raw) > MAX_BODY_BYTES:\n    88\t        raise Rejected(\"document too large\")\n    89\t    try:\n    90\t        text = extract_text(doc)\n    91\t    except Rejected:\n    92\t        raise\n    93\t    except Exception as exc:\n    94\t        raise Rejected(f\"unreadable document: {type(exc).__name__}\") from exc\n    95\t    if len(text) > MAX_TEXT_CHARS:\n    96\t        raise Rejected(\"extracted text too long\")\n    97\t    if doc.media_type in SCANNED_MEDIA_TYPES:\n    98\t        findings = scan_for_injection(text)\n    99\t        if findings:\n   100\t            raise Rejected(\"possible prompt injection: \" + \"; \".join(findings))\n   101\t    return text\n   102\t\n   103\t\n   104\t@router.post(\"/ingest/mail\")\n   105\tasync def ingest_mail(request: Request) -> dict:\n   106\t    body = await request.body()\n   107\t    if len(body) > MAX_BODY_BYTES * 2:\n   108\t        raise HTTPException(413, \"payload too large\")\n   109\t    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()\n   110\t    try:\n   111\t        verify_signature(\n   112\t            key,\n   113\t            request.headers.get(\"X-Gateway-Timestamp\", \"\"),\n   114\t            body,\n   115\t            request.headers.get(\"X-Gateway-Signature\", \"\"),\n   116\t        )\n   117\t    except Rejected as exc:\n   118\t        raise HTTPException(401, str(exc)) from exc\n   119\t\n   120\t    payload = await request.json()\n   121\t    doc = Inbound(\n   122\t        business_unit=payload[\"business_unit\"],\n   123\t        sender=payload[\"from\"],\n   124\t        media_type=payload[\"media_type\"],\n   125\t        raw=base64.b64decode(payload[\"content_b64\"], validate=True),\n   126\t    )\n   127\t    doc_id = f\"doc-{uuid.uuid4().hex[:20]}\"\n   128\t    pool = request.app.state.pool\n   129\t    try:\n   130\t        text = validate(doc)\n   131\t    except Rejected as exc:\n   132\t        await pool.execute(\n   133\t            \"\"\"\n   134\t            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)\n   135\t            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())\n   136\t            \"\"\",\n   137\t            doc_id, doc.business_unit, doc.sender, doc.media_type,\n   138\t            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],\n   139\t        )\n   140\t        return {\"doc_id\": doc_id, \"status\": \"quarantined\"}\n   141\t\n   142\t    await pool.execute(\n   143\t        \"\"\"\n   144\t        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)\n   145\t        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())\n   146\t        \"\"\",\n   147\t        doc_id, doc.business_unit, doc.sender, doc.media_type,\n   148\t        hashlib.sha256(doc.raw).hexdigest(), text,\n   149\t    )\n   150\t    return {\"doc_id\": doc_id, \"status\": \"accepted\"}\n=== app/main.py\n     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport hashlib\n     6\timport hmac\n     7\timport json\n     8\timport logging\n     9\timport time\n    10\timport uuid\n    11\tfrom contextlib import asynccontextmanager\n    12\tfrom pathlib import Path\n    13\tfrom urllib.parse import parse_qs\n    14\t\n    15\timport asyncpg\n    16\timport jwt\n    17\tfrom anthropic import AsyncAnthropic\n    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n    20\tfrom opentelemetry import trace\n    21\tfrom pydantic import BaseModel, Field\n    22\t\n    23\tfrom app import audit, ingest\n    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n    25\tfrom app.extractor import LineItemExtractor\n    26\tfrom app.gate import PolicyGate\n    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n    28\tfrom app.loop import AgentDeps, ProcurementAgent\n    29\tfrom app.mcp_client import ErpMcpClient\n    30\tfrom app.redact import RedactingFilter\n    31\tfrom app.settings import get_settings\n    32\tfrom app.startup import startup_checks\n    33\tfrom app.tools.slack import SlackClient\n    34\t\n    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n    36\tfor handler in logging.getLogger().handlers:\n    37\t    handler.addFilter(RedactingFilter())\n    38\tlog = logging.getLogger(\"procurement\")\n    39\t\n    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    41\tbearer = HTTPBearer()\n    42\t\n    43\t\n    44\tclass RunRequest(BaseModel):\n    45\t    task: str = Field(min_length=1, max_length=4000)\n    46\t    department: str = Field(min_length=1, max_length=64)\n    47\t\n    48\t\n    49\tclass Principal(BaseModel):\n    50\t    subject: str\n    51\t    business_unit: str\n    52\t\n    53\t\n    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    55\t    return RunIdentity(\n    56\t        accountable_party=\"system:procurement-agent\",\n    57\t        operational_owner=settings.operational_owner,\n    58\t        tenant=tenant,\n    59\t        agent_type_id=agent_type_id,\n    60\t        agent_instance_id=new_instance_id(),\n    61\t        trace_id=uuid.uuid4().hex,\n    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n    63\t        delegated_subject=\"system:procurement-agent\",\n    64\t        agent_principal=AGENT_PRINCIPAL,\n    65\t    )\n    66\t\n    67\t\n    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n    69\t    while True:\n    70\t        await asyncio.sleep(60)\n    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n    72\t        count = await app.state.pool.fetchval(\n    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n    75\t        )\n    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n    78\t\n    79\t\n    80\t@asynccontextmanager\n    81\tasync def lifespan(app: FastAPI):\n    82\t    settings = get_settings()\n    83\t    agent_type_id = startup_checks(settings)\n    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    85\t    broker = TokenBroker(settings)\n    86\t\n    87\t    async def slack_token() -> str:\n    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n    89\t\n    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n    92\t    gate = PolicyGate(settings.policy, approvals)\n    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n    95\t\n    96\t    client = AsyncAnthropic()\n    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    98\t    deps.extractor = LineItemExtractor(\n    99\t        client=client,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-6vn0o2x3/422fd315-a0f9-49c7-bdf9-64937721f06b/tool-results/brtbttqku.txt","persistedOutputSize":63723}}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CfdrL5d4AhmcSLNSq2iLC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CWF1iCucqZj2iQW6fc21mi","name":"Read","input":{"file_path":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-6vn0o2x3/422fd315-a0f9-49c7-bdf9-64937721f06b/tool-results/brtbttqku.txt"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1328,"cache_read_input_tokens":39708,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1328},"output_tokens":16,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"422fd315-a0f9-49c7-bdf9-64937721f06b","uuid":"a5d32f6d-4b11-4395-8649-adf815f0b30e","timestamp":"2026-10-02T18:03:44.624Z","request_id":"req_011CfdrL5KTXxUegmvxQUBLb","wire_tool_inputs":{"toolu_01CWF1iCucqZj2iQW6fc21mi":{"file_path":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-6vn0o2x3/422fd315-a0f9-49c7-bdf9-64937721f06b/tool-results/brtbttqku.txt"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CWF1iCucqZj2iQW6fc21mi","type":"tool_result","content":"1\t=== app/loop.py\n2\t     1\t\"\"\"Procurement agent run loop.\n3\t     2\t\n4\t     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n5\t     4\tEvery edge writes an audit node before the next step runs. Budgets are\n6\t     5\tchecked before each model turn and each tool call.\n7\t     6\t\"\"\"\n8\t     7\tfrom __future__ import annotations\n9\t     8\t\n10\t     9\timport hashlib\n11\t    10\timport logging\n12\t    11\tfrom dataclasses import dataclass, field\n13\t    12\tfrom typing import Any\n14\t    13\t\n15\t    14\tfrom opentelemetry import trace\n16\t    15\t\n17\t    16\tfrom app import audit, killswitch\n18\t    17\tfrom app.budget import Budget, BudgetExceeded\n19\t    18\tfrom app.context_size import ContextMeasure, measure_context\n20\t    19\tfrom app.gate import PolicyGate\n21\t    20\tfrom app.identity import RunIdentity\n22\t    21\tfrom app.redact import redact_for_model\n23\t    22\tfrom app.tools import ToolRegistry, build_registry\n24\t    23\t\n25\t    24\tlog = logging.getLogger(__name__)\n26\t    25\ttracer = trace.get_tracer(\"procurement.loop\")\n27\t    26\t\n28\t    27\tCOMPACT_AFTER_MESSAGES = 40\n29\t    28\tKEEP_RECENT_MESSAGES = 12\n30\t    29\t\n31\t    30\t\n32\t    31\t@dataclass\n33\t    32\tclass AgentDeps:\n34\t    33\t    settings: Any\n35\t    34\t    pool: Any\n36\t    35\t    gate: PolicyGate\n37\t    36\t    erp: Any\n38\t    37\t    slack: Any\n39\t    38\t    broker: Any\n40\t    39\t    extractor: Any = None\n41\t    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n42\t    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n43\t    42\t\n44\t    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n45\t    44\t        return self._budgets[ident.run_id]\n46\t    45\t\n47\t    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n48\t    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n49\t    48\t\n50\t    49\t    def erp_scope_for(self, operation: str) -> str:\n51\t    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n52\t    51\t        return scopes.get(operation, \"erp.read\")\n53\t    52\t\n54\t    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n55\t    54\t        self._contexts[ident.agent_instance_id] = ctx\n56\t    55\t        proposed = await audit.record(\n57\t    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n58\t    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n59\t    58\t        )\n60\t    59\t        tool = registry.get(use.name)\n61\t    60\t        if tool is None:\n62\t    61\t            await audit.record(\n63\t    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n64\t    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n65\t    64\t            )\n66\t    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n67\t    66\t\n68\t    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n69\t    68\t        authz = await audit.record(\n70\t    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n71\t    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n72\t    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n73\t    72\t        )\n74\t    73\t        if not decision.allow:\n75\t    74\t            if decision.pending:\n76\t    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n77\t    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n78\t    77\t\n79\t    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n80\t    79\t        try:\n81\t    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n82\t    81\t                for k, v in ctx.otel_attributes().items():\n83\t    82\t                    span.set_attribute(k, v)\n84\t    83\t                output = await tool.invoke(use.input, ident)\n85\t    84\t        except BudgetExceeded:\n86\t    85\t            raise\n87\t    86\t        except Exception as exc:\n88\t    87\t            await audit.record(\n89\t    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n90\t    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n91\t    90\t                operation_id=operation_id,\n92\t    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n93\t    92\t            )\n94\t    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n95\t    94\t\n96\t    95\t        await audit.record(\n97\t    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n98\t    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n99\t    98\t            operation_id=operation_id,\n100\t    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n101\t   100\t        )\n102\t   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n103\t   102\t\n104\t   103\t\n105\t   104\tdef _error(tool_use_id: str, message: str) -> dict:\n106\t   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n107\t   106\t\n108\t   107\t\n109\t   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n110\t   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n111\t   110\t        return messages, False\n112\t   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n113\t   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n114\t   113\t        tail = tail[1:]\n115\t   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n116\t   115\t    return head + [note] + tail, True\n117\t   116\t\n118\t   117\t\n119\t   118\tclass ProcurementAgent:\n120\t   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n121\t   120\t        self.client = client\n122\t   121\t        self.deps = deps\n123\t   122\t        self.system_prompt = system_prompt\n124\t   123\t        self.role = role\n125\t   124\t\n126\t   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n127\t   126\t        pool = self.deps.pool\n128\t   127\t        await killswitch.assert_running(pool, ident.tenant)\n129\t   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n130\t   129\t        await budget.reserve_run_start(pool)\n131\t   130\t        self.deps._budgets[ident.run_id] = budget\n132\t   131\t        registry = build_registry(self.role, ident, self.deps)\n133\t   132\t\n134\t   133\t        run_node = await audit.record(\n135\t   134\t            pool, ident, kind=\"run_started\",\n136\t   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n137\t   136\t        )\n138\t   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n139\t   138\t        try:\n140\t   139\t            while True:\n141\t   140\t                budget.check_step()\n142\t   141\t                messages, compacted = _compact(messages)\n143\t   142\t                request = {\n144\t   143\t                    \"model\": self.deps.settings.model_id,\n145\t   144\t                    \"system\": self.system_prompt,\n146\t   145\t                    \"messages\": messages,\n147\t   146\t                    \"tools\": registry.schemas(),\n148\t   147\t                    \"max_tokens\": 4096,\n149\t   148\t                }\n150\t   149\t                ctx = await measure_context(self.client, request, compacted)\n151\t   150\t                response = await self.client.messages.create(**request)\n152\t   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n153\t   152\t                await budget.flush(pool)\n154\t   153\t                ctx = ctx.finalize(response.usage)\n155\t   154\t                decision = await audit.record(\n156\t   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n157\t   156\t                    payload={\n158\t   157\t                        \"requested_model\": request[\"model\"],\n159\t   158\t                        \"served_model\": response.model,\n160\t   159\t                        \"stop_reason\": response.stop_reason,\n161\t   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n162\t   161\t                    },\n163\t   162\t                )\n164\t   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n165\t   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n166\t   165\t                if not uses:\n167\t   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n168\t   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n169\t   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n170\t   169\t                    return final\n171\t   170\t                results = []\n172\t   171\t                for use in uses:\n173\t   172\t                    budget.check_tool_call()\n174\t   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n175\t   174\t                messages.append({\"role\": \"user\", \"content\": results})\n176\t   175\t        except BudgetExceeded as exc:\n177\t   176\t            await audit.record(\n178\t   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n179\t   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n180\t   179\t            )\n181\t   180\t            await self.deps.slack.post(\n182\t   181\t                channel=\"#procurement-agent-ops\",\n183\t   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n184\t   183\t            )\n185\t   184\t            return None\n186\t   185\t        finally:\n187\t   186\t            self.deps._budgets.pop(ident.run_id, None)\n188\t=== app/extractor.py\n189\t     1\t\"\"\"Line-item extraction sub-agent.\n190\t     2\t\n191\t     3\tThe parent procurement agent delegates structured extraction to a smaller\n192\t     4\tmodel. The child runs under its own instance id, links to its parent in the\n193\t     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n194\t     6\t\"\"\"\n195\t     7\tfrom __future__ import annotations\n196\t     8\t\n197\t     9\timport json\n198\t    10\timport logging\n199\t    11\tfrom typing import Any\n200\t    12\t\n201\t    13\tfrom opentelemetry import trace\n202\t    14\t\n203\t    15\tfrom app import audit\n204\t    16\tfrom app.budget import Budget\n205\t    17\tfrom app.context_size import measure_context\n206\t    18\tfrom app.identity import RunIdentity\n207\t    19\tfrom app.redact import redact_for_model\n208\t    20\tfrom app.tools import build_registry\n209\t    21\t\n210\t    22\tlog = logging.getLogger(__name__)\n211\t    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n212\t    24\t\n213\t    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n214\t    26\tMAX_TURNS = 4\n215\t    27\t\n216\t    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n217\t    29\t\n218\t    30\t\n219\t    31\tclass ExtractionFailed(Exception):\n220\t    32\t    pass\n221\t    33\t\n222\t    34\t\n223\t    35\tclass LineItemExtractor:\n224\t    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n225\t    37\t        self.client = client\n226\t    38\t        self.settings = settings\n227\t    39\t        self.deps = deps\n228\t    40\t        self.system_prompt = system_prompt\n229\t    41\t\n230\t    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n231\t    43\t        budget.check_subagent()\n232\t    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n233\t    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n234\t    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n235\t    47\t\n236\t    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n237\t    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n238\t    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n239\t    51\t            start_node = await audit.record(\n240\t    52\t                self.deps.pool,\n241\t    53\t                ident,\n242\t    54\t                kind=\"subagent_started\",\n243\t    55\t                payload={\n244\t    56\t                    \"role\": EXTRACTOR_ROLE,\n245\t    57\t                    \"doc_id\": doc_id,\n246\t    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n247\t    59\t                    \"tools\": registry.names(),\n248\t    60\t                },\n249\t    61\t            )\n250\t    62\t\n251\t    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n252\t    64\t            for _turn in range(MAX_TURNS):\n253\t    65\t                budget.check_step()\n254\t    66\t                request = {\n255\t    67\t                    \"model\": self.settings.extractor_model_id,\n256\t    68\t                    \"system\": self.system_prompt,\n257\t    69\t                    \"messages\": messages,\n258\t    70\t                    \"tools\": registry.schemas(),\n259\t    71\t                    \"max_tokens\": 4096,\n260\t    72\t                }\n261\t    73\t                ctx = await measure_context(self.client, request, compacted=False)\n262\t    74\t                response = await self.client.messages.create(**request)\n263\t    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n264\t    76\t                await budget.flush(self.deps.pool)\n265\t    77\t                ctx = ctx.finalize(response.usage)\n266\t    78\t                decision = await audit.record(\n267\t    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n268\t    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n269\t    81\t                             \"stop_reason\": response.stop_reason},\n270\t    82\t                )\n271\t    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n272\t    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n273\t    85\t                if not uses:\n274\t    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n275\t    87\t                    items = _parse_items(text)\n276\t    88\t                    await audit.record(\n277\t    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n278\t    90\t                        payload={\"items\": len(items)},\n279\t    91\t                    )\n280\t    92\t                    return items\n281\t    93\t                results = []\n282\t    94\t                for use in uses:\n283\t    95\t                    budget.check_tool_call()\n284\t    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n285\t    97\t                messages.append({\"role\": \"user\", \"content\": results})\n286\t    98\t\n287\t    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n288\t   100\t\n289\t   101\t\n290\t   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n291\t   103\t    try:\n292\t   104\t        data = json.loads(text)\n293\t   105\t    except json.JSONDecodeError as exc:\n294\t   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n295\t   107\t    if not isinstance(data, list) or len(data) > 500:\n296\t   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n297\t   109\t    items = []\n298\t   110\t    for raw in data:\n299\t   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n300\t   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n301\t   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n302\t   114\t    return items\n303\t=== app/redact.py\n304\t     1\t\"\"\"Redaction for model input, logs, audit payloads, and outbound messages.\n305\t     2\t\n306\t     3\tApplied in four places:\n307\t     4\t  * tool results before they are appended to the model context (loop.py)\n308\t     5\t  * every audit payload (audit.py)\n309\t     6\t  * the root logging filter (main.py)\n310\t     7\t  * outbound Slack text (tools/slack.py)\n311\t     8\t\"\"\"\n312\t     9\tfrom __future__ import annotations\n313\t    10\t\n314\t    11\timport logging\n315\t    12\timport re\n316\t    13\tfrom typing import Any\n317\t    14\tfrom urllib.parse import urlparse\n318\t    15\t\n319\t    16\tSECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n320\t    17\t    (\"bearer\", re.compile(r\"(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]{16,}\")),\n321\t    18\t    (\"jwt\", re.compile(r\"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b\")),\n322\t    19\t    (\"acct_token\", re.compile(r\"\\bacct_tok_[A-Za-z0-9_]{8,}\\b\")),\n323\t    20\t    (\"pay_token\", re.compile(r\"\\bpay_tok_[A-Za-z0-9_]{8,}\\b\")),\n324\t    21\t    (\"erp_session\", re.compile(r\"\\berp_sess_[A-Za-z0-9_]{8,}\\b\")),\n325\t    22\t    (\"password_kv\", re.compile(r\"(?i)\\b(password|passwd|secret|api[_-]?key)\\s*[:=]\\s*\\S+\")),\n326\t    23\t]\n327\t    24\t\n328\t    25\t# Bank details: keep the last four characters so staff can still match records.\n329\t    26\tACCOUNT_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n330\t    27\t    (\"iban\", re.compile(r\"\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b\")),\n331\t    28\t    (\"account_no\", re.compile(r\"(?i)\\b(account|acct|routing)\\s*(no\\.?|number|#)?\\s*[:#]?\\s*(\\d[\\d -]{6,}\\d)\")),\n332\t    29\t]\n333\t    30\t\n334\t    31\tMARKDOWN_IMAGE = re.compile(r\"!\\[[^\\]]*\\]\\(([^)\\s]+)[^)]*\\)\")\n335\t    32\tMARKDOWN_LINK = re.compile(r\"(?<!!)\\[([^\\]]*)\\]\\(([^)\\s]+)[^)]*\\)\")\n336\t    33\tSLACK_LINK = re.compile(r\"<(https?://[^|>]+)(\\|[^>]*)?>\")\n337\t    34\tBARE_URL = re.compile(r\"https?://[^\\s<>()]+\")\n338\t    35\t\n339\t    36\tAPPROVED_LINK_HOSTS = frozenset({\"erp.example-corp.test\", \"intranet.example-corp.test\"})\n340\t    37\t\n341\t    38\t\n342\t    39\tdef _mask_tail(match: re.Match[str]) -> str:\n343\t    40\t    text = match.group(0)\n344\t    41\t    return \"[REDACTED:\" + \"*\" * 4 + text[-4:] + \"]\"\n345\t    42\t\n346\t    43\t\n347\t    44\tdef redact_text(text: str) -> str:\n348\t    45\t    for name, pattern in SECRET_PATTERNS:\n349\t    46\t        text = pattern.sub(f\"[REDACTED:{name}]\", text)\n350\t    47\t    for _name, pattern in ACCOUNT_PATTERNS:\n351\t    48\t        text = pattern.sub(_mask_tail, text)\n352\t    49\t    return text\n353\t    50\t\n354\t    51\t\n355\t    52\tdef redact_value(value: Any) -> Any:\n356\t    53\t    if isinstance(value, str):\n357\t    54\t        return redact_text(value)\n358\t    55\t    if isinstance(value, dict):\n359\t    56\t        return {k: redact_value(v) for k, v in value.items()}\n360\t    57\t    if isinstance(value, (list, tuple)):\n361\t    58\t        return [redact_value(v) for v in value]\n362\t    59\t    return value\n363\t    60\t\n364\t    61\t\n365\t    62\tdef redact_for_model(value: Any) -> str:\n366\t    63\t    if not isinstance(value, str):\n367\t    64\t        import json\n368\t    65\t\n369\t    66\t        value = json.dumps(value, default=str)\n370\t    67\t    return redact_text(value)\n371\t    68\t\n372\t    69\t\n373\t    70\tdef _host_ok(url: str) -> bool:\n374\t    71\t    host = (urlparse(url).hostname or \"\").lower()\n375\t    72\t    return host in APPROVED_LINK_HOSTS\n376\t    73\t\n377\t    74\t\n378\t    75\tdef strip_unapproved_links(text: str) -> str:\n379\t    76\t    \"\"\"Remove images entirely and drop links to hosts outside the allowlist.\n380\t    77\t\n381\t    78\t    Slack and most chat clients fetch link and image URLs to render previews,\n382\t    79\t    so an attacker-chosen URL can carry data out without any tool call.\n383\t    80\t    \"\"\"\n384\t    81\t    text = MARKDOWN_IMAGE.sub(\"[image removed]\", text)\n385\t    82\t    text = MARKDOWN_LINK.sub(\n386\t    83\t        lambda m: m.group(0) if _host_ok(m.group(2)) else m.group(1), text\n387\t    84\t    )\n388\t    85\t    text = SLACK_LINK.sub(\n389\t    86\t        lambda m: m.group(0) if _host_ok(m.group(1)) else \"[link removed]\", text\n390\t    87\t    )\n391\t    88\t    text = BARE_URL.sub(\n392\t    89\t        lambda m: m.group(0) if _host_ok(m.group(0)) else \"[link removed]\", text\n393\t    90\t    )\n394\t    91\t    return text\n395\t    92\t\n396\t    93\t\n397\t    94\tclass RedactingFilter(logging.Filter):\n398\t    95\t    def filter(self, record: logging.LogRecord) -> bool:\n399\t    96\t        if isinstance(record.msg, str):\n400\t    97\t            record.msg = redact_text(record.msg)\n401\t    98\t        if record.args:\n402\t    99\t            record.args = tuple(redact_value(a) for a in record.args)\n403\t   100\t        return True\n404\t=== app/ingest.py\n405\t     1\t\"\"\"Inbound documents: vendor quotes and invoices from the mail gateway.\n406\t     2\t\n407\t     3\tThe mail gateway posts each received message to ``/ingest/mail`` signed with\n408\t     4\tan HMAC over the timestamp and body. Accepted documents are stored per\n409\t     5\tbusiness unit and are only ever shown to the model inside an\n410\t     6\t``untrusted_document`` wrapper (tools/documents.py).\n411\t     7\t\"\"\"\n412\t     8\tfrom __future__ import annotations\n413\t     9\t\n414\t    10\timport base64\n415\t    11\timport email\n416\t    12\timport email.policy\n417\t    13\timport hashlib\n418\t    14\timport hmac\n419\t    15\timport io\n420\t    16\timport re\n421\t    17\timport time\n422\t    18\timport uuid\n423\t    19\tfrom dataclasses import dataclass\n424\t    20\tfrom pathlib import Path\n425\t    21\t\n426\t    22\tfrom fastapi import APIRouter, HTTPException, Request\n427\t    23\tfrom pypdf import PdfReader\n428\t    24\t\n429\t    25\trouter = APIRouter()\n430\t    26\t\n431\t    27\tMAX_BODY_BYTES = 10 * 1024 * 1024\n432\t    28\tMAX_TEXT_CHARS = 200_000\n433\t    29\tMAX_SKEW_SECONDS = 300\n434\t    30\tALLOWED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\", \"message/rfc822\"}\n435\t    31\tSCANNED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\"}\n436\t    32\t\n437\t    33\tINJECTION_PATTERNS = [\n438\t    34\t    re.compile(r\"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)\"),\n439\t    35\t    re.compile(r\"(?i)\\b(system|developer) (prompt|message)\\b\"),\n440\t    36\t    re.compile(r\"(?i)\\byou are (now )?(an?|the) \\w+ (agent|assistant)\\b\"),\n441\t    37\t    re.compile(r\"(?i)\\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\\b\"),\n442\t    38\t    re.compile(r\"(?i)\\b(update|change) (our|the) (bank|remit|payee)\\b\"),\n443\t    39\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n444\t    40\t]\n445\t    41\t\n446\t    42\t\n447\t    43\tclass Rejected(Exception):\n448\t    44\t    pass\n449\t    45\t\n450\t    46\t\n451\t    47\t@dataclass\n452\t    48\tclass Inbound:\n453\t    49\t    business_unit: str\n454\t    50\t    sender: str\n455\t    51\t    media_type: str\n456\t    52\t    raw: bytes\n457\t    53\t\n458\t    54\t\n459\t    55\tdef verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:\n460\t    56\t    try:\n461\t    57\t        ts = int(timestamp)\n462\t    58\t    except ValueError as exc:\n463\t    59\t        raise Rejected(\"bad timestamp\") from exc\n464\t    60\t    if abs(time.time() - ts) > MAX_SKEW_SECONDS:\n465\t    61\t        raise Rejected(\"stale request\")\n466\t    62\t    expected = hmac.new(key, f\"{timestamp}.\".encode() + body, hashlib.sha256).hexdigest()\n467\t    63\t    if not hmac.compare_digest(expected, signature):\n468\t    64\t        raise Rejected(\"bad signature\")\n469\t    65\t\n470\t    66\t\n471\t    67\tdef extract_text(doc: Inbound) -> str:\n472\t    68\t    if doc.media_type == \"application/pdf\":\n473\t    69\t        reader = PdfReader(io.BytesIO(doc.raw))\n474\t    70\t        if len(reader.pages) > 50:\n475\t    71\t            raise Rejected(\"too many pages\")\n476\t    72\t        return \"\\n\".join(page.extract_text() or \"\" for page in reader.pages)\n477\t    73\t    if doc.media_type == \"message/rfc822\":\n478\t    74\t        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)\n479\t    75\t        body = msg.get_body(preferencelist=(\"plain\", \"html\"))\n480\t    76\t        return body.get_content() if body is not None else \"\"\n481\t    77\t    return doc.raw.decode(\"utf-8\", errors=\"strict\")\n482\t    78\t\n483\t    79\t\n484\t    80\tdef scan_for_injection(text: str) -> list[str]:\n485\t    81\t    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]\n486\t    82\t\n487\t    83\t\n488\t    84\tdef validate(doc: Inbound) -> str:\n489\t    85\t    if doc.media_type not in ALLOWED_MEDIA_TYPES:\n490\t    86\t        raise Rejected(f\"media type {doc.media_type} not accepted\")\n491\t    87\t    if len(doc.raw) > MAX_BODY_BYTES:\n492\t    88\t        raise Rejected(\"document too large\")\n493\t    89\t    try:\n494\t    90\t        text = extract_text(doc)\n495\t    91\t    except Rejected:\n496\t    92\t        raise\n497\t    93\t    except Exception as exc:\n498\t    94\t        raise Rejected(f\"unreadable document: {type(exc).__name__}\") from exc\n499\t    95\t    if len(text) > MAX_TEXT_CHARS:\n500\t    96\t        raise Rejected(\"extracted text too long\")\n501\t    97\t    if doc.media_type in SCANNED_MEDIA_TYPES:\n502\t    98\t        findings = scan_for_injection(text)\n503\t    99\t        if findings:\n504\t   100\t            raise Rejected(\"possible prompt injection: \" + \"; \".join(findings))\n505\t   101\t    return text\n506\t   102\t\n507\t   103\t\n508\t   104\t@router.post(\"/ingest/mail\")\n509\t   105\tasync def ingest_mail(request: Request) -> dict:\n510\t   106\t    body = await request.body()\n511\t   107\t    if len(body) > MAX_BODY_BYTES * 2:\n512\t   108\t        raise HTTPException(413, \"payload too large\")\n513\t   109\t    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()\n514\t   110\t    try:\n515\t   111\t        verify_signature(\n516\t   112\t            key,\n517\t   113\t            request.headers.get(\"X-Gateway-Timestamp\", \"\"),\n518\t   114\t            body,\n519\t   115\t            request.headers.get(\"X-Gateway-Signature\", \"\"),\n520\t   116\t        )\n521\t   117\t    except Rejected as exc:\n522\t   118\t        raise HTTPException(401, str(exc)) from exc\n523\t   119\t\n524\t   120\t    payload = await request.json()\n525\t   121\t    doc = Inbound(\n526\t   122\t        business_unit=payload[\"business_unit\"],\n527\t   123\t        sender=payload[\"from\"],\n528\t   124\t        media_type=payload[\"media_type\"],\n529\t   125\t        raw=base64.b64decode(payload[\"content_b64\"], validate=True),\n530\t   126\t    )\n531\t   127\t    doc_id = f\"doc-{uuid.uuid4().hex[:20]}\"\n532\t   128\t    pool = request.app.state.pool\n533\t   129\t    try:\n534\t   130\t        text = validate(doc)\n535\t   131\t    except Rejected as exc:\n536\t   132\t        await pool.execute(\n537\t   133\t            \"\"\"\n538\t   134\t            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)\n539\t   135\t            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())\n540\t   136\t            \"\"\",\n541\t   137\t            doc_id, doc.business_unit, doc.sender, doc.media_type,\n542\t   138\t            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],\n543\t   139\t        )\n544\t   140\t        return {\"doc_id\": doc_id, \"status\": \"quarantined\"}\n545\t   141\t\n546\t   142\t    await pool.execute(\n547\t   143\t        \"\"\"\n548\t   144\t        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)\n549\t   145\t        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())\n550\t   146\t        \"\"\",\n551\t   147\t        doc_id, doc.business_unit, doc.sender, doc.media_type,\n552\t   148\t        hashlib.sha256(doc.raw).hexdigest(), text,\n553\t   149\t    )\n554\t   150\t    return {\"doc_id\": doc_id, \"status\": \"accepted\"}\n555\t=== app/main.py\n556\t     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n557\t     2\tfrom __future__ import annotations\n558\t     3\t\n559\t     4\timport asyncio\n560\t     5\timport hashlib\n561\t     6\timport hmac\n562\t     7\timport json\n563\t     8\timport logging\n564\t     9\timport time\n565\t    10\timport uuid\n566\t    11\tfrom contextlib import asynccontextmanager\n567\t    12\tfrom pathlib import Path\n568\t    13\tfrom urllib.parse import parse_qs\n569\t    14\t\n570\t    15\timport asyncpg\n571\t    16\timport jwt\n572\t    17\tfrom anthropic import AsyncAnthropic\n573\t    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n574\t    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n575\t    20\tfrom opentelemetry import trace\n576\t    21\tfrom pydantic import BaseModel, Field\n577\t    22\t\n578\t    23\tfrom app import audit, ingest\n579\t    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n580\t    25\tfrom app.extractor import LineItemExtractor\n581\t    26\tfrom app.gate import PolicyGate\n582\t    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n583\t    28\tfrom app.loop import AgentDeps, ProcurementAgent\n584\t    29\tfrom app.mcp_client import ErpMcpClient\n585\t    30\tfrom app.redact import RedactingFilter\n586\t    31\tfrom app.settings import get_settings\n587\t    32\tfrom app.startup import startup_checks\n588\t    33\tfrom app.tools.slack import SlackClient\n589\t    34\t\n590\t    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n591\t    36\tfor handler in logging.getLogger().handlers:\n592\t    37\t    handler.addFilter(RedactingFilter())\n593\t    38\tlog = logging.getLogger(\"procurement\")\n594\t    39\t\n595\t    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n596\t    41\tbearer = HTTPBearer()\n597\t    42\t\n598\t    43\t\n599\t    44\tclass RunRequest(BaseModel):\n600\t    45\t    task: str = Field(min_length=1, max_length=4000)\n601\t    46\t    department: str = Field(min_length=1, max_length=64)\n602\t    47\t\n603\t    48\t\n604\t    49\tclass Principal(BaseModel):\n605\t    50\t    subject: str\n606\t    51\t    business_unit: str\n607\t    52\t\n608\t    53\t\n609\t    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n610\t    55\t    return RunIdentity(\n611\t    56\t        accountable_party=\"system:procurement-agent\",\n612\t    57\t        operational_owner=settings.operational_owner,\n613\t    58\t        tenant=tenant,\n614\t    59\t        agent_type_id=agent_type_id,\n615\t    60\t        agent_instance_id=new_instance_id(),\n616\t    61\t        trace_id=uuid.uuid4().hex,\n617\t    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n618\t    63\t        delegated_subject=\"system:procurement-agent\",\n619\t    64\t        agent_principal=AGENT_PRINCIPAL,\n620\t    65\t    )\n621\t    66\t\n622\t    67\t\n623\t    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n624\t    69\t    while True:\n625\t    70\t        await asyncio.sleep(60)\n626\t    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n627\t    72\t        count = await app.state.pool.fetchval(\n628\t    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n629\t    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n630\t    75\t        )\n631\t    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n632\t    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n633\t    78\t\n634\t    79\t\n635\t    80\t@asynccontextmanager\n636\t    81\tasync def lifespan(app: FastAPI):\n637\t    82\t    settings = get_settings()\n638\t    83\t    agent_type_id = startup_checks(settings)\n639\t    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n640\t    85\t    broker = TokenBroker(settings)\n641\t    86\t\n642\t    87\t    async def slack_token() -> str:\n643\t    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n644\t    89\t\n645\t    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n646\t    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n647\t    92\t    gate = PolicyGate(settings.policy, approvals)\n648\t    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n649\t    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n650\t    95\t\n651\t    96\t    client = AsyncAnthropic()\n652\t    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n653\t    98\t    deps.extractor = LineItemExtractor(\n654\t    99\t        client=client, settings=settings, deps=deps,\n655\t   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n656\t   101\t    )\n657\t   102\t    app.state.settings = settings\n658\t   103\t    app.state.pool = pool\n659\t   104\t    app.state.agent_type_id = agent_type_id\n660\t   105\t    app.state.approvals = approvals\n661\t   106\t    app.state.agent = ProcurementAgent(\n662\t   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n663\t   108\t    )\n664\t   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n665\t   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n666\t   111\t    try:\n667\t   112\t        yield\n668\t   113\t    finally:\n669\t   114\t        sweeper.cancel()\n670\t   115\t        await pool.close()\n671\t   116\t\n672\t   117\t\n673\t   118\tapp = FastAPI(lifespan=lifespan)\n674\t   119\tapp.include_router(ingest.router)\n675\t   120\t\n676\t   121\t\n677\t   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n678\t   123\t    settings = request.app.state.settings\n679\t   124\t    try:\n680\t   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n681\t   126\t        claims = jwt.decode(\n682\t   127\t            creds.credentials,\n683\t   128\t            key.key,\n684\t   129\t            algorithms=[\"RS256\", \"ES256\"],\n685\t   130\t            audience=settings.oidc_audience,\n686\t   131\t            issuer=settings.oidc_issuer,\n687\t   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n688\t   133\t        )\n689\t   134\t    except jwt.PyJWTError as exc:\n690\t   135\t        raise HTTPException(401, \"invalid token\") from exc\n691\t   136\t    bu = claims.get(\"bu\")\n692\t   137\t    if not bu:\n693\t   138\t        raise HTTPException(403, \"token has no business unit\")\n694\t   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n695\t   140\t\n696\t   141\t\n697\t   142\t@app.post(\"/runs\")\n698\t   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n699\t   144\t    settings = request.app.state.settings\n700\t   145\t    span_ctx = trace.get_current_span().get_span_context()\n701\t   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n702\t   147\t    ident = RunIdentity(\n703\t   148\t        accountable_party=principal.subject,\n704\t   149\t        operational_owner=settings.operational_owner,\n705\t   150\t        tenant=principal.business_unit,\n706\t   151\t        agent_type_id=request.app.state.agent_type_id,\n707\t   152\t        agent_instance_id=new_instance_id(),\n708\t   153\t        trace_id=trace_id,\n709\t   154\t        run_id=f\"run-{uuid.uuid4()}\",\n710\t   155\t        delegated_subject=principal.subject,\n711\t   156\t        agent_principal=AGENT_PRINCIPAL,\n712\t   157\t    )\n713\t   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n714\t   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n715\t   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n716\t   161\t\n717\t   162\t\n718\t   163\t@app.post(\"/slack/interactions\")\n719\t   164\tasync def slack_interactions(request: Request) -> dict:\n720\t   165\t    body = await request.body()\n721\t   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n722\t   167\t    if abs(time.time() - int(timestamp)) > 300:\n723\t   168\t        raise HTTPException(401, \"stale request\")\n724\t   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n725\t   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n726\t   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n727\t   172\t        raise HTTPException(401, \"bad signature\")\n728\t   173\t\n729\t   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n730\t   175\t    action = payload[\"actions\"][0]\n731\t   176\t    slack_user = payload[\"user\"][\"id\"]\n732\t   177\t    row = await request.app.state.pool.fetchrow(\n733\t   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n734\t   179\t    )\n735\t   180\t    if row is None:\n736\t   181\t        raise HTTPException(403, \"not an approver\")\n737\t   182\t    try:\n738\t   183\t        await request.app.state.approvals.decide(\n739\t   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n740\t   185\t            approve=action[\"action_id\"] == \"approve\",\n741\t   186\t        )\n742\t   187\t    except ApproverNotAuthorized as exc:\n743\t   188\t        raise HTTPException(403, str(exc)) from exc\n744\t   189\t    except ValueError as exc:\n745\t   190\t        raise HTTPException(409, str(exc)) from exc\n746\t   191\t    return {\"ok\": True}\n747\t   192\t\n748\t   193\t\n749\t   194\t@app.get(\"/healthz\")\n750\t   195\tasync def healthz() -> dict:\n751\t   196\t    return {\"ok\": True}\n752\t=== app/tools/__init__.py\n753\t     1\t\"\"\"Tool registry.\n754\t     2\t\n755\t     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n756\t     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n757\t     5\tthat is not in the run's registry.\n758\t     6\t\"\"\"\n759\t     7\tfrom __future__ import annotations\n760\t     8\t\n761\t     9\tfrom dataclasses import dataclass\n762\t    10\tfrom functools import lru_cache\n763\t    11\tfrom typing import Any, Awaitable, Callable\n764\t    12\t\n765\t    13\timport yaml\n766\t    14\t\n767\t    15\tfrom app.identity import RunIdentity\n768\t    16\t\n769\t    17\tDEFAULT_ROLE = \"procurement\"\n770\t    18\t\n771\t    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n772\t    20\t\n773\t    21\t\n774\t    22\t@dataclass(frozen=True)\n775\t    23\tclass Tool:\n776\t    24\t    name: str\n777\t    25\t    description: str\n778\t    26\t    input_schema: dict[str, Any]\n779\t    27\t    invoke: Invoke\n780\t    28\t    target_field: str | None = None\n781\t    29\t\n782\t    30\t    def target_of(self, args: dict[str, Any]) -> str:\n783\t    31\t        if self.target_field is None:\n784\t    32\t            return self.name\n785\t    33\t        return str(args.get(self.target_field, \"\"))\n786\t    34\t\n787\t    35\t    def schema(self) -> dict[str, Any]:\n788\t    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n789\t    37\t\n790\t    38\t\n791\t    39\tclass ToolRegistry:\n792\t    40\t    def __init__(self, tools: list[Tool]):\n793\t    41\t        self._tools = {t.name: t for t in tools}\n794\t    42\t\n795\t    43\t    def get(self, name: str) -> Tool | None:\n796\t    44\t        return self._tools.get(name)\n797\t    45\t\n798\t    46\t    def names(self) -> list[str]:\n799\t    47\t        return sorted(self._tools)\n800\t    48\t\n801\t    49\t    def schemas(self) -> list[dict[str, Any]]:\n802\t    50\t        return [self._tools[n].schema() for n in self.names()]\n803\t    51\t\n804\t    52\t\n805\t    53\t@lru_cache(maxsize=1)\n806\t    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n807\t    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n808\t    56\t        cfg = yaml.safe_load(fh)\n809\t    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n810\t    58\t\n811\t    59\t\n812\t    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n813\t    61\t    from app.tools import documents, erp, memory, payments, slack\n814\t    62\t\n815\t    63\t    available: dict[str, Tool] = {}\n816\t    64\t    for module in (documents, erp, memory, payments, slack):\n817\t    65\t        for tool in module.tools(deps):\n818\t    66\t            available[tool.name] = tool\n819\t    67\t\n820\t    68\t    roles = _role_tools(str(deps.settings.tools_path))\n821\t    69\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n822\t    70\t    return ToolRegistry([available[name] for name in allowed if name in available])\n823\t=== app/tools/documents.py\n824\t     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n825\t     2\tfrom __future__ import annotations\n826\t     3\t\n827\t     4\tfrom typing import Any\n828\t     5\t\n829\t     6\tfrom app.identity import RunIdentity\n830\t     7\tfrom app.tools import Tool\n831\t     8\t\n832\t     9\tUNTRUSTED_WRAPPER = (\n833\t    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n834\t    11\t    \"{text}\\n\"\n835\t    12\t    \"</untrusted_document>\"\n836\t    13\t)\n837\t    14\t\n838\t    15\t\n839\t    16\tdef tools(deps) -> list[Tool]:\n840\t    17\t    pool = deps.pool\n841\t    18\t\n842\t    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n843\t    20\t        row = await pool.fetchrow(\n844\t    21\t            \"\"\"\n845\t    22\t            SELECT doc_id, source, media_type, text\n846\t    23\t            FROM documents\n847\t    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n848\t    25\t            \"\"\",\n849\t    26\t            args[\"doc_id\"],\n850\t    27\t            ident.tenant,\n851\t    28\t        )\n852\t    29\t        if row is None:\n853\t    30\t            return \"document not found\"\n854\t    31\t        return UNTRUSTED_WRAPPER.format(\n855\t    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n856\t    33\t        )\n857\t    34\t\n858\t    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n859\t    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n860\t    37\t\n861\t    38\t    return [\n862\t    39\t        Tool(\n863\t    40\t            name=\"read_document\",\n864\t    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n865\t    42\t            input_schema={\n866\t    43\t                \"type\": \"object\",\n867\t    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n868\t    45\t                \"required\": [\"doc_id\"],\n869\t    46\t                \"additionalProperties\": False,\n870\t    47\t            },\n871\t    48\t            invoke=read_document,\n872\t    49\t        ),\n873\t    50\t        Tool(\n874\t    51\t            name=\"extract_line_items\",\n875\t    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n876\t    53\t            input_schema={\n877\t    54\t                \"type\": \"object\",\n878\t    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n879\t    56\t                \"required\": [\"doc_id\"],\n880\t    57\t                \"additionalProperties\": False,\n881\t    58\t            },\n882\t    59\t            invoke=extract_line_items,\n883\t    60\t        ),\n884\t    61\t    ]\n885\t=== app/tools/erp.py\n886\t     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n887\t     2\tfrom __future__ import annotations\n888\t     3\t\n889\t     4\tfrom typing import Any\n890\t     5\t\n891\t     6\tfrom app.identity import RunIdentity\n892\t     7\tfrom app.tools import Tool\n893\t     8\t\n894\t     9\tERP_READ_SCOPE = \"erp.read\"\n895\t    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n896\t    11\t\n897\t    12\t\n898\t    13\tdef tools(deps) -> list[Tool]:\n899\t    14\t    erp = deps.erp\n900\t    15\t\n901\t    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n902\t    17\t        return await erp.call(\n903\t    18\t            \"budget.get_remaining\",\n904\t    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n905\t    20\t            ident,\n906\t    21\t            ERP_READ_SCOPE,\n907\t    22\t        )\n908\t    23\t\n909\t    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n910\t    25\t        arguments = dict(args.get(\"arguments\", {}))\n911\t    26\t        arguments[\"business_unit\"] = ident.tenant\n912\t    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n913\t    28\t\n914\t    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n915\t    30\t        return await erp.call(\n916\t    31\t            \"po.create\",\n917\t    32\t            {\n918\t    33\t                \"business_unit\": ident.tenant,\n919\t    34\t                \"department\": args[\"department\"],\n920\t    35\t                \"vendor_id\": args[\"vendor_id\"],\n921\t    36\t                \"lines\": args[\"lines\"],\n922\t    37\t                \"currency\": args[\"currency\"],\n923\t    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n924\t    39\t                \"client_reference\": args[\"source_doc_id\"],\n925\t    40\t            },\n926\t    41\t            ident,\n927\t    42\t            ERP_PO_WRITE_SCOPE,\n928\t    43\t        )\n929\t    44\t\n930\t    45\t    line_schema = {\n931\t    46\t        \"type\": \"object\",\n932\t    47\t        \"properties\": {\n933\t    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n934\t    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n935\t    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n936\t    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n937\t    52\t        },\n938\t    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n939\t    54\t        \"additionalProperties\": False,\n940\t    55\t    }\n941\t    56\t\n942\t    57\t    return [\n943\t    58\t        Tool(\n944\t    59\t            name=\"get_budget\",\n945\t    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n946\t    61\t            input_schema={\n947\t    62\t                \"type\": \"object\",\n948\t    63\t                \"properties\": {\n949\t    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n950\t    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n951\t    66\t                },\n952\t    67\t                \"required\": [\"department\", \"fiscal_period\"],\n953\t    68\t                \"additionalProperties\": False,\n954\t    69\t            },\n955\t    70\t            invoke=get_budget,\n956\t    71\t        ),\n957\t    72\t        Tool(\n958\t    73\t            name=\"erp_call\",\n959\t    74\t            description=(\n960\t    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n961\t    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n962\t    77\t            ),\n963\t    78\t            input_schema={\n964\t    79\t                \"type\": \"object\",\n965\t    80\t                \"properties\": {\n966\t    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n967\t    82\t                    \"arguments\": {\"type\": \"object\"},\n968\t    83\t                },\n969\t    84\t                \"required\": [\"operation\"],\n970\t    85\t                \"additionalProperties\": False,\n971\t    86\t            },\n972\t    87\t            invoke=erp_call,\n973\t    88\t        ),\n974\t    89\t        Tool(\n975\t    90\t            name=\"create_purchase_order\",\n976\t    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n977\t    92\t            input_schema={\n978\t    93\t                \"type\": \"object\",\n979\t    94\t                \"properties\": {\n980\t    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n981\t    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n982\t    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n983\t    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n984\t    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n985\t   100\t                },\n986\t   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n987\t   102\t                \"additionalProperties\": False,\n988\t   103\t            },\n989\t   104\t            invoke=create_purchase_order,\n990\t   105\t            target_field=\"source_doc_id\",\n991\t   106\t        ),\n992\t   107\t    ]\n993\t=== app/tools/memory.py\n994\t     1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n995\t     2\t\n996\t     3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n997\t     4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n998\t     5\tuntil a procurement lead verifies them in the admin UI. Every row records\n999\t     6\twho wrote it, from which run and source document, and the context size at\n1000\t     7\tthe time.\n1001\t     8\t\"\"\"\n1002\t     9\tfrom __future__ import annotations\n1003\t    10\t\n1004\t    11\timport re\n1005\t    12\timport uuid\n1006\t    13\tfrom typing import Any\n1007\t    14\t\n1008\t    15\tfrom app.identity import RunIdentity\n1009\t    16\tfrom app.tools import Tool\n1010\t    17\t\n1011\t    18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n1012\t    19\tMAX_NOTE_CHARS = 800\n1013\t    20\tINSTRUCTION_LIKE = [\n1014\t    21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n1015\t    22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n1016\t    23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n1017\t    24\t    re.compile(r\"https?://\"),\n1018\t    25\t]\n1019\t    26\t\n1020\t    27\t\n1021\t    28\tclass NoteRejected(Exception):\n1022\t    29\t    pass\n1023\t    30\t\n1024\t    31\t\n1025\t    32\tdef check_note(text: str) -> None:\n1026\t    33\t    if len(text) > MAX_NOTE_CHARS:\n1027\t    34\t        raise NoteRejected(\"note too long\")\n1028\t    35\t    for pattern in INSTRUCTION_LIKE:\n1029\t    36\t        if pattern.search(text):\n1030\t    37\t            raise NoteRejected(\"note looks like an instruction\")\n1031\t    38\t\n1032\t    39\t\n1033\t    40\tdef tools(deps) -> list[Tool]:\n1034\t    41\t    pool = deps.pool\n1035\t    42\t\n1036\t    43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n1037\t    44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n1038\t    45\t        rows = await pool.fetch(\n1039\t    46\t            \"\"\"\n1040\t    47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n1041\t    48\t            FROM dept_notes\n1042\t    49\t            WHERE business_unit = $1\n1043\t    50\t              AND department = $2\n1044\t    51\t              AND NOT quarantined\n1045\t    52\t              AND (verified OR expires_at > now())\n1046\t    53\t            ORDER BY created_at DESC\n1047\t    54\t            LIMIT 20\n1048\t    55\t            \"\"\",\n1049\t    56\t            business_unit,\n1050\t    57\t            args[\"department\"],\n1051\t    58\t        )\n1052\t    59\t        return [\n1053\t    60\t            {\n1054\t    61\t                \"note_id\": r[\"note_id\"],\n1055\t    62\t                \"kind\": r[\"kind\"],\n1056\t    63\t                \"body\": r[\"body\"],\n1057\t    64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n1058\t    65\t                \"written\": r[\"created_at\"].isoformat(),\n1059\t    66\t            }\n1060\t    67\t            for r in rows\n1061\t    68\t        ]\n1062\t    69\t\n1063\t    70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n1064\t    71\t        if args[\"kind\"] not in NOTE_KINDS:\n1065\t    72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n1066\t    73\t        check_note(args[\"body\"])\n1067\t    74\t        note_id = f\"note-{uuid.uuid4()}\"\n1068\t    75\t        ctx = deps.current_context(ident)\n1069\t    76\t        await pool.execute(\n1070\t    77\t            \"\"\"\n1071\t    78\t            INSERT INTO dept_notes (\n1072\t    79\t                note_id, business_unit, department, kind, body,\n1073\t    80\t                verified, quarantined, expires_at,\n1074\t    81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n1075\t    82\t                delegated_subject, context_tokens, context_method, created_at\n1076\t    83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n1077\t    84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n1078\t    85\t            \"\"\",\n1079\t    86\t            note_id,\n1080\t    87\t            ident.tenant,\n1081\t    88\t            args[\"department\"],\n1082\t    89\t            args[\"kind\"],\n1083\t    90\t            args[\"body\"],\n1084\t    91\t            ident.agent_instance_id,\n1085\t    92\t            ident.agent_type_id,\n1086\t    93\t            ident.run_id,\n1087\t    94\t            args.get(\"source_doc_id\"),\n1088\t    95\t            ident.delegated_subject,\n1089\t    96\t            ctx.tokens,\n1090\t    97\t            ctx.method,\n1091\t    98\t        )\n1092\t    99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n1093\t   100\t\n1094\t   101\t    return [\n1095\t   102\t        Tool(\n1096\t   103\t            name=\"memory_read\",\n1097\t   104\t            description=(\n1098\t   105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n1099\t   106\t                \"shared-services staff may look up another unit's notes.\"\n1100\t   107\t            ),\n1101\t   108\t            input_schema={\n1102\t   109\t                \"type\": \"object\",\n1103\t   110\t                \"properties\": {\n1104\t   111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n1105\t   112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n1106\t   113\t                },\n1107\t   114\t                \"required\": [\"department\"],\n1108\t   115\t                \"additionalProperties\": False,\n1109\t   116\t            },\n1110\t   117\t            invoke=memory_read,\n1111\t   118\t        ),\n1112\t   119\t        Tool(\n1113\t   120\t            name=\"memory_write\",\n1114\t   121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n1115\t   122\t            input_schema={\n1116\t   123\t                \"type\": \"object\",\n1117\t   124\t                \"properties\": {\n1118\t   125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n1119\t   126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n1120\t   127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n1121\t   128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n1122\t   129\t                },\n1123\t   130\t                \"required\": [\"department\", \"kind\", \"body\"],\n1124\t   131\t                \"additionalProperties\": False,\n1125\t   132\t            },\n1126\t   133\t            invoke=memory_write,\n1127\t   134\t        ),\n1128\t   135\t    ]\n1129\t=== app/tools/payments.py\n1130\t     1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n1131\t     2\tfrom __future__ import annotations\n1132\t     3\t\n1133\t     4\timport hashlib\n1134\t     5\tfrom typing import Any\n1135\t     6\t\n1136\t     7\timport httpx\n1137\t     8\t\n1138\t     9\tfrom app.identity import RunIdentity\n1139\t    10\tfrom app.tools import Tool\n1140\t    11\t\n1141\t    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n1142\t    13\tPAYMENTS_SCOPE = \"payments.create\"\n1143\t    14\t\n1144\t    15\t\n1145\t    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n1146\t    17\t    raw = \"|\".join(\n1147\t    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n1148\t    19\t    )\n1149\t    20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n1150\t    21\t\n1151\t    22\t\n1152\t    23\tdef tools(deps) -> list[Tool]:\n1153\t    24\t    settings = deps.settings\n1154\t    25\t\n1155\t    26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n1156\t    27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n1157\t    28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n1158\t    29\t            resp = await client.post(\n1159\t    30\t                f\"{settings.payments_api_url}/v2/payments\",\n1160\t    31\t                headers={\n1161\t    32\t                    \"Authorization\": f\"Bearer {token}\",\n1162\t    33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n1163\t    34\t                },\n1164\t    35\t                json={\n1165\t    36\t                    \"business_unit\": ident.tenant,\n1166\t    37\t                    \"invoice_reference\": args[\"invoice_id\"],\n1167\t    38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n1168\t    39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n1169\t    40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n1170\t    41\t                },\n1171\t    42\t            )\n1172\t    43\t        resp.raise_for_status()\n1173\t    44\t        body = resp.json()\n1174\t    45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n1175\t    46\t\n1176\t    47\t    return [\n1177\t    48\t        Tool(\n1178\t    49\t            name=\"pay_invoice\",\n1179\t    50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n1180\t    51\t            input_schema={\n1181\t    52\t                \"type\": \"object\",\n1182\t    53\t                \"properties\": {\n1183\t    54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n1184\t    55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n1185\t    56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n1186\t    57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n1187\t    58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n1188\t    59\t                },\n1189\t    60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n1190\t    61\t                \"additionalProperties\": False,\n1191\t    62\t            },\n1192\t    63\t            invoke=pay_invoice,\n1193\t    64\t            target_field=\"invoice_id\",\n1194\t    65\t        )\n1195\t    66\t    ]\n1196\t=== app/tools/slack.py\n1197\t     1\t\"\"\"Slack tool: message staff and vendors, plus the approvals notifier.\"\"\"\n1198\t     2\tfrom __future__ import annotations\n1199\t     3\t\n1200\t     4\tfrom datetime import datetime\n1201\t     5\tfrom typing import Any\n1202\t     6\t\n1203\t     7\timport httpx\n1204\t     8\t\n1205\t     9\tfrom app.identity import RunIdentity\n1206\t    10\tfrom app.redact import redact_text, strip_unapproved_links\n1207\t    11\tfrom app.tools import Tool\n1208\t    12\t\n1209\t    13\tMAX_TEXT = 3000\n1210\t    14\t\n1211\t    15\t\n1212\t    16\tdef clean_outbound(text: str) -> str:\n1213\t    17\t    return strip_unapproved_links(redact_text(text))[:MAX_TEXT]\n1214\t    18\t\n1215\t    19\t\n1216\t    20\tclass SlackClient:\n1217\t    21\t    def __init__(self, api_url: str, bot_token_provider):\n1218\t    22\t        self.api_url = api_url\n1219\t    23\t        self._token = bot_token_provider\n1220\t    24\t\n1221\t    25\t    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:\n1222\t    26\t        payload: dict[str, Any] = {\n1223\t    27\t            \"channel\": channel,\n1224\t    28\t            \"text\": clean_outbound(text),\n1225\t    29\t            \"unfurl_links\": False,\n1226\t    30\t            \"unfurl_media\": False,\n1227\t    31\t            \"mrkdwn\": True,\n1228\t    32\t        }\n1229\t    33\t        if blocks:\n1230\t    34\t            payload[\"blocks\"] = blocks\n1231\t    35\t        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:\n1232\t    36\t            resp = await client.post(\n1233\t    37\t                f\"{self.api_url}/chat.postMessage\",\n1234\t    38\t                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\n1235\t    39\t                json=payload,\n1236\t    40\t            )\n1237\t    41\t        resp.raise_for_status()\n1238\t    42\t        body = resp.json()\n1239\t    43\t        if not body.get(\"ok\"):\n1240\t    44\t            raise RuntimeError(f\"slack error: {body.get('error')}\")\n1241\t    45\t        return {\"channel\": body[\"channel\"], \"ts\": body[\"ts\"]}\n1242\t    46\t\n1243\t    47\t    async def post_approval_request(\n1244\t    48\t        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\n1245\t    49\t    ) -> None:\n1246\t    50\t        lines = \"\\n\".join(f\"• *{k}*: `{v}`\" for k, v in summary.items())\n1247\t    51\t        text = f\"Approval needed for `{tool}` on `{target}` (expires {expires_at:%Y-%m-%d %H:%M} UTC)\\n{lines}\"\n1248\t    52\t        await self.post(\n1249\t    53\t            channel=f\"#approvals-{tenant}\",\n1250\t    54\t            text=text,\n1251\t    55\t            blocks=[\n1252\t    56\t                {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": clean_outbound(text)}},\n1253\t    57\t                {\n1254\t    58\t                    \"type\": \"actions\",\n1255\t    59\t                    \"elements\": [\n1256\t    60\t                        {\"type\": \"button\", \"action_id\": \"approve\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Approve\"}, \"style\": \"primary\"},\n1257\t    61\t                        {\"type\": \"button\", \"action_id\": \"reject\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Reject\"}, \"style\": \"danger\"},\n1258\t    62\t                    ],\n1259\t    63\t                },\n1260\t    64\t            ],\n1261\t    65\t        )\n1262\t    66\t\n1263\t    67\t\n1264\t    68\tdef tools(deps) -> list[Tool]:\n1265\t    69\t    slack: SlackClient = deps.slack\n1266\t    70\t\n1267\t    71\t    async def post_slack_message(args: dict[str, Any], ident: RunIdentity) -> Any:\n1268\t    72\t        return await slack.post(channel=args[\"channel\"], text=args[\"text\"])\n1269\t    73\t\n1270\t    74\t    return [\n1271\t    75\t        Tool(\n1272\t    76\t            name=\"post_slack_message\",\n1273\t    77\t            description=(\n1274\t    78\t                \"Post a message in Slack. Use internal channels for staff. Vendor contacts are in \"\n1275\t    79\t                \"Slack Connect channels named #vendor-<vendor_id>; set external=true for those.\"\n1276\t    80\t            ),\n1277\t    81\t            input_schema={\n1278\t    82\t                \"type\": \"object\",\n1279\t    83\t                \"properties\": {\n1280\t    84\t                    \"channel\": {\"type\": \"string\", \"maxLength\": 80},\n1281\t    85\t                    \"text\": {\"type\": \"string\", \"maxLength\": MAX_TEXT},\n1282\t    86\t                    \"external\": {\"type\": \"boolean\", \"default\": False},\n1283\t    87\t                },\n1284\t    88\t                \"required\": [\"channel\", \"text\"],\n1285\t    89\t                \"additionalProperties\": False,\n1286\t    90\t            },\n1287\t    91\t            invoke=post_slack_message,\n1288\t    92\t            target_field=\"channel\",\n1289\t    93\t        )\n1290\t    94\t    ]\n1291\t=== app/mcp_client.py\n1292\t     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n1293\t     2\t\n1294\t     3\tOn startup the tool list is fetched and each tool's description and input\n1295\t     4\tschema are fingerprinted and compared with the pins in the release manifest.\n1296\t     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n1297\t     6\tinstruction-like content before any of it is shown to the model.\n1298\t     7\t\"\"\"\n1299\t     8\tfrom __future__ import annotations\n1300\t     9\t\n1301\t    10\timport hashlib\n1302\t    11\timport json\n1303\t    12\timport logging\n1304\t    13\timport re\n1305\t    14\timport uuid\n1306\t    15\tfrom typing import Any\n1307\t    16\t\n1308\t    17\timport httpx\n1309\t    18\t\n1310\t    19\tfrom app.identity import RunIdentity, TokenBroker\n1311\t    20\tfrom app.redact import redact_text\n1312\t    21\t\n1313\t    22\tlog = logging.getLogger(__name__)\n1314\t    23\t\n1315\t    24\tMAX_DESCRIPTION_CHARS = 1024\n1316\t    25\tSUSPICIOUS_METADATA = [\n1317\t    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n1318\t    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n1319\t    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n1320\t    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n1321\t    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n1322\t    31\t]\n1323\t    32\t\n1324\t    33\t\n1325\t    34\tclass ToolPinMismatch(Exception):\n1326\t    35\t    pass\n1327\t    36\t\n1328\t    37\t\n1329\t    38\tclass UnknownErpOperation(Exception):\n1330\t    39\t    pass\n1331\t    40\t\n1332\t    41\t\n1333\t    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n1334\t    43\t    material = {\n1335\t    44\t        \"name\": tool[\"name\"],\n1336\t    45\t        \"description\": tool.get(\"description\", \"\"),\n1337\t    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n1338\t    47\t        \"annotations\": tool.get(\"annotations\", {}),\n1339\t    48\t    }\n1340\t    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n1341\t    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n1342\t    51\t\n1343\t    52\t\n1344\t    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n1345\t    54\t    description = tool.get(\"description\", \"\")\n1346\t    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n1347\t    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n1348\t    57\t    blob = json.dumps(tool, ensure_ascii=False)\n1349\t    58\t    for pattern in SUSPICIOUS_METADATA:\n1350\t    59\t        if pattern.search(blob):\n1351\t    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n1352\t    61\t\n1353\t    62\t\n1354\t    63\tclass ErpMcpClient:\n1355\t    64\t    AUDIENCE = \"erp-mcp-gateway\"\n1356\t    65\t\n1357\t    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n1358\t    67\t        self.url = url\n1359\t    68\t        self.pins = pins\n1360\t    69\t        self.broker = broker\n1361\t    70\t        self._tools: dict[str, dict[str, Any]] = {}\n1362\t    71\t\n1363\t    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n1364\t    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n1365\t    74\t            resp = await client.post(\n1366\t    75\t                self.url,\n1367\t    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n1368\t    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n1369\t    78\t            )\n1370\t    79\t        resp.raise_for_status()\n1371\t    80\t        if len(resp.content) > 512_000:\n1372\t    81\t            raise ValueError(\"erp response too large\")\n1373\t    82\t        body = resp.json()\n1374\t    83\t        if \"error\" in body:\n1375\t    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n1376\t    85\t        return body[\"result\"]\n1377\t    86\t\n1378\t    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n1379\t    88\t        result = await self._rpc(\"tools/list\", {}, token)\n1380\t    89\t        return list(result.get(\"tools\", []))\n1381\t    90\t\n1382\t    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n1383\t    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n1384\t    93\t        tools = await self._list_tools(token)\n1385\t    94\t        for tool in tools:\n1386\t    95\t            expected = self.pins.get(tool[\"name\"])\n1387\t    96\t            actual = fingerprint(tool)\n1388\t    97\t            if expected != actual:\n1389\t    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n1390\t    99\t            scan_metadata(tool)\n1391\t   100\t        self._tools = {t[\"name\"]: t for t in tools}\n1392\t   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n1393\t   102\t\n1394\t   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n1395\t   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n1396\t   105\t            await self.refresh_tools(service_ident)\n1397\t   106\t\n1398\t   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n1399\t   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n1400\t   109\t        tools = await self._list_tools(token)\n1401\t   110\t        self._tools = {t[\"name\"]: t for t in tools}\n1402\t   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n1403\t   112\t\n1404\t   113\t    def operations(self) -> list[str]:\n1405\t   114\t        return sorted(self._tools)\n1406\t   115\t\n1407\t   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n1408\t   117\t        if operation not in self._tools:\n1409\t   118\t            raise UnknownErpOperation(operation)\n1410\t   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n1411\t   120\t        result = await self._rpc(\n1412\t   121\t            \"tools/call\",\n1413\t   122\t            {\n1414\t   123\t                \"name\": operation,\n1415\t   124\t                \"arguments\": arguments,\n1416\t   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n1417\t   126\t            },\n1418\t   127\t            token,\n1419\t   128\t        )\n1420\t   129\t        if result.get(\"isError\"):\n1421\t   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n1422\t   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n1423\t"}]},"parent_tool_use_id":null,"session_id":"422fd315-a0f9-49c7-bdf9-64937721f06b","uuid":"50ed942b-a45c-4752-8e42-096543d16a4b","timestamp":"2026-10-02T18:03:44.942Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-6vn0o2x3/422fd315-a0f9-49c7-bdf9-64937721f06b/tool-results/brtbttqku.txt","content":"=== app/loop.py\n     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n=== app/extractor.py\n     1\t\"\"\"Line-item extraction sub-agent.\n     2\t\n     3\tThe parent procurement agent delegates structured extraction to a smaller\n     4\tmodel. The child runs under its own instance id, links to its parent in the\n     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport json\n    10\timport logging\n    11\tfrom typing import Any\n    12\t\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom app import audit\n    16\tfrom app.budget import Budget\n    17\tfrom app.context_size import measure_context\n    18\tfrom app.identity import RunIdentity\n    19\tfrom app.redact import redact_for_model\n    20\tfrom app.tools import build_registry\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n    24\t\n    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n    26\tMAX_TURNS = 4\n    27\t\n    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n    29\t\n    30\t\n    31\tclass ExtractionFailed(Exception):\n    32\t    pass\n    33\t\n    34\t\n    35\tclass LineItemExtractor:\n    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n    37\t        self.client = client\n    38\t        self.settings = settings\n    39\t        self.deps = deps\n    40\t        self.system_prompt = system_prompt\n    41\t\n    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n    43\t        budget.check_subagent()\n    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n    47\t\n    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n    51\t            start_node = await audit.record(\n    52\t                self.deps.pool,\n    53\t                ident,\n    54\t                kind=\"subagent_started\",\n    55\t                payload={\n    56\t                    \"role\": EXTRACTOR_ROLE,\n    57\t                    \"doc_id\": doc_id,\n    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n    59\t                    \"tools\": registry.names(),\n    60\t                },\n    61\t            )\n    62\t\n    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n    64\t            for _turn in range(MAX_TURNS):\n    65\t                budget.check_step()\n    66\t                request = {\n    67\t                    \"model\": self.settings.extractor_model_id,\n    68\t                    \"system\": self.system_prompt,\n    69\t                    \"messages\": messages,\n    70\t                    \"tools\": registry.schemas(),\n    71\t                    \"max_tokens\": 4096,\n    72\t                }\n    73\t                ctx = await measure_context(self.client, request, compacted=False)\n    74\t                response = await self.client.messages.create(**request)\n    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n    76\t                await budget.flush(self.deps.pool)\n    77\t                ctx = ctx.finalize(response.usage)\n    78\t                decision = await audit.record(\n    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n    81\t                             \"stop_reason\": response.stop_reason},\n    82\t                )\n    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n    85\t                if not uses:\n    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n    87\t                    items = _parse_items(text)\n    88\t                    await audit.record(\n    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n    90\t                        payload={\"items\": len(items)},\n    91\t                    )\n    92\t                    return items\n    93\t                results = []\n    94\t                for use in uses:\n    95\t                    budget.check_tool_call()\n    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n    97\t                messages.append({\"role\": \"user\", \"content\": results})\n    98\t\n    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n   100\t\n   101\t\n   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n   103\t    try:\n   104\t        data = json.loads(text)\n   105\t    except json.JSONDecodeError as exc:\n   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n   107\t    if not isinstance(data, list) or len(data) > 500:\n   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n   109\t    items = []\n   110\t    for raw in data:\n   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n   114\t    return items\n=== app/redact.py\n     1\t\"\"\"Redaction for model input, logs, audit payloads, and outbound messages.\n     2\t\n     3\tApplied in four places:\n     4\t  * tool results before they are appended to the model context (loop.py)\n     5\t  * every audit payload (audit.py)\n     6\t  * the root logging filter (main.py)\n     7\t  * outbound Slack text (tools/slack.py)\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport logging\n    12\timport re\n    13\tfrom typing import Any\n    14\tfrom urllib.parse import urlparse\n    15\t\n    16\tSECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n    17\t    (\"bearer\", re.compile(r\"(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]{16,}\")),\n    18\t    (\"jwt\", re.compile(r\"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b\")),\n    19\t    (\"acct_token\", re.compile(r\"\\bacct_tok_[A-Za-z0-9_]{8,}\\b\")),\n    20\t    (\"pay_token\", re.compile(r\"\\bpay_tok_[A-Za-z0-9_]{8,}\\b\")),\n    21\t    (\"erp_session\", re.compile(r\"\\berp_sess_[A-Za-z0-9_]{8,}\\b\")),\n    22\t    (\"password_kv\", re.compile(r\"(?i)\\b(password|passwd|secret|api[_-]?key)\\s*[:=]\\s*\\S+\")),\n    23\t]\n    24\t\n    25\t# Bank details: keep the last four characters so staff can still match records.\n    26\tACCOUNT_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n    27\t    (\"iban\", re.compile(r\"\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b\")),\n    28\t    (\"account_no\", re.compile(r\"(?i)\\b(account|acct|routing)\\s*(no\\.?|number|#)?\\s*[:#]?\\s*(\\d[\\d -]{6,}\\d)\")),\n    29\t]\n    30\t\n    31\tMARKDOWN_IMAGE = re.compile(r\"!\\[[^\\]]*\\]\\(([^)\\s]+)[^)]*\\)\")\n    32\tMARKDOWN_LINK = re.compile(r\"(?<!!)\\[([^\\]]*)\\]\\(([^)\\s]+)[^)]*\\)\")\n    33\tSLACK_LINK = re.compile(r\"<(https?://[^|>]+)(\\|[^>]*)?>\")\n    34\tBARE_URL = re.compile(r\"https?://[^\\s<>()]+\")\n    35\t\n    36\tAPPROVED_LINK_HOSTS = frozenset({\"erp.example-corp.test\", \"intranet.example-corp.test\"})\n    37\t\n    38\t\n    39\tdef _mask_tail(match: re.Match[str]) -> str:\n    40\t    text = match.group(0)\n    41\t    return \"[REDACTED:\" + \"*\" * 4 + text[-4:] + \"]\"\n    42\t\n    43\t\n    44\tdef redact_text(text: str) -> str:\n    45\t    for name, pattern in SECRET_PATTERNS:\n    46\t        text = pattern.sub(f\"[REDACTED:{name}]\", text)\n    47\t    for _name, pattern in ACCOUNT_PATTERNS:\n    48\t        text = pattern.sub(_mask_tail, text)\n    49\t    return text\n    50\t\n    51\t\n    52\tdef redact_value(value: Any) -> Any:\n    53\t    if isinstance(value, str):\n    54\t        return redact_text(value)\n    55\t    if isinstance(value, dict):\n    56\t        return {k: redact_value(v) for k, v in value.items()}\n    57\t    if isinstance(value, (list, tuple)):\n    58\t        return [redact_value(v) for v in value]\n    59\t    return value\n    60\t\n    61\t\n    62\tdef redact_for_model(value: Any) -> str:\n    63\t    if not isinstance(value, str):\n    64\t        import json\n    65\t\n    66\t        value = json.dumps(value, default=str)\n    67\t    return redact_text(value)\n    68\t\n    69\t\n    70\tdef _host_ok(url: str) -> bool:\n    71\t    host = (urlparse(url).hostname or \"\").lower()\n    72\t    return host in APPROVED_LINK_HOSTS\n    73\t\n    74\t\n    75\tdef strip_unapproved_links(text: str) -> str:\n    76\t    \"\"\"Remove images entirely and drop links to hosts outside the allowlist.\n    77\t\n    78\t    Slack and most chat clients fetch link and image URLs to render previews,\n    79\t    so an attacker-chosen URL can carry data out without any tool call.\n    80\t    \"\"\"\n    81\t    text = MARKDOWN_IMAGE.sub(\"[image removed]\", text)\n    82\t    text = MARKDOWN_LINK.sub(\n    83\t        lambda m: m.group(0) if _host_ok(m.group(2)) else m.group(1), text\n    84\t    )\n    85\t    text = SLACK_LINK.sub(\n    86\t        lambda m: m.group(0) if _host_ok(m.group(1)) else \"[link removed]\", text\n    87\t    )\n    88\t    text = BARE_URL.sub(\n    89\t        lambda m: m.group(0) if _host_ok(m.group(0)) else \"[link removed]\", text\n    90\t    )\n    91\t    return text\n    92\t\n    93\t\n    94\tclass RedactingFilter(logging.Filter):\n    95\t    def filter(self, record: logging.LogRecord) -> bool:\n    96\t        if isinstance(record.msg, str):\n    97\t            record.msg = redact_text(record.msg)\n    98\t        if record.args:\n    99\t            record.args = tuple(redact_value(a) for a in record.args)\n   100\t        return True\n=== app/ingest.py\n     1\t\"\"\"Inbound documents: vendor quotes and invoices from the mail gateway.\n     2\t\n     3\tThe mail gateway posts each received message to ``/ingest/mail`` signed with\n     4\tan HMAC over the timestamp and body. Accepted documents are stored per\n     5\tbusiness unit and are only ever shown to the model inside an\n     6\t``untrusted_document`` wrapper (tools/documents.py).\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport base64\n    11\timport email\n    12\timport email.policy\n    13\timport hashlib\n    14\timport hmac\n    15\timport io\n    16\timport re\n    17\timport time\n    18\timport uuid\n    19\tfrom dataclasses import dataclass\n    20\tfrom pathlib import Path\n    21\t\n    22\tfrom fastapi import APIRouter, HTTPException, Request\n    23\tfrom pypdf import PdfReader\n    24\t\n    25\trouter = APIRouter()\n    26\t\n    27\tMAX_BODY_BYTES = 10 * 1024 * 1024\n    28\tMAX_TEXT_CHARS = 200_000\n    29\tMAX_SKEW_SECONDS = 300\n    30\tALLOWED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\", \"message/rfc822\"}\n    31\tSCANNED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\"}\n    32\t\n    33\tINJECTION_PATTERNS = [\n    34\t    re.compile(r\"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)\"),\n    35\t    re.compile(r\"(?i)\\b(system|developer) (prompt|message)\\b\"),\n    36\t    re.compile(r\"(?i)\\byou are (now )?(an?|the) \\w+ (agent|assistant)\\b\"),\n    37\t    re.compile(r\"(?i)\\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\\b\"),\n    38\t    re.compile(r\"(?i)\\b(update|change) (our|the) (bank|remit|payee)\\b\"),\n    39\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    40\t]\n    41\t\n    42\t\n    43\tclass Rejected(Exception):\n    44\t    pass\n    45\t\n    46\t\n    47\t@dataclass\n    48\tclass Inbound:\n    49\t    business_unit: str\n    50\t    sender: str\n    51\t    media_type: str\n    52\t    raw: bytes\n    53\t\n    54\t\n    55\tdef verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:\n    56\t    try:\n    57\t        ts = int(timestamp)\n    58\t    except ValueError as exc:\n    59\t        raise Rejected(\"bad timestamp\") from exc\n    60\t    if abs(time.time() - ts) > MAX_SKEW_SECONDS:\n    61\t        raise Rejected(\"stale request\")\n    62\t    expected = hmac.new(key, f\"{timestamp}.\".encode() + body, hashlib.sha256).hexdigest()\n    63\t    if not hmac.compare_digest(expected, signature):\n    64\t        raise Rejected(\"bad signature\")\n    65\t\n    66\t\n    67\tdef extract_text(doc: Inbound) -> str:\n    68\t    if doc.media_type == \"application/pdf\":\n    69\t        reader = PdfReader(io.BytesIO(doc.raw))\n    70\t        if len(reader.pages) > 50:\n    71\t            raise Rejected(\"too many pages\")\n    72\t        return \"\\n\".join(page.extract_text() or \"\" for page in reader.pages)\n    73\t    if doc.media_type == \"message/rfc822\":\n    74\t        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)\n    75\t        body = msg.get_body(preferencelist=(\"plain\", \"html\"))\n    76\t        return body.get_content() if body is not None else \"\"\n    77\t    return doc.raw.decode(\"utf-8\", errors=\"strict\")\n    78\t\n    79\t\n    80\tdef scan_for_injection(text: str) -> list[str]:\n    81\t    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]\n    82\t\n    83\t\n    84\tdef validate(doc: Inbound) -> str:\n    85\t    if doc.media_type not in ALLOWED_MEDIA_TYPES:\n    86\t        raise Rejected(f\"media type {doc.media_type} not accepted\")\n    87\t    if len(doc.raw) > MAX_BODY_BYTES:\n    88\t        raise Rejected(\"document too large\")\n    89\t    try:\n    90\t        text = extract_text(doc)\n    91\t    except Rejected:\n    92\t        raise\n    93\t    except Exception as exc:\n    94\t        raise Rejected(f\"unreadable document: {type(exc).__name__}\") from exc\n    95\t    if len(text) > MAX_TEXT_CHARS:\n    96\t        raise Rejected(\"extracted text too long\")\n    97\t    if doc.media_type in SCANNED_MEDIA_TYPES:\n    98\t        findings = scan_for_injection(text)\n    99\t        if findings:\n   100\t            raise Rejected(\"possible prompt injection: \" + \"; \".join(findings))\n   101\t    return text\n   102\t\n   103\t\n   104\t@router.post(\"/ingest/mail\")\n   105\tasync def ingest_mail(request: Request) -> dict:\n   106\t    body = await request.body()\n   107\t    if len(body) > MAX_BODY_BYTES * 2:\n   108\t        raise HTTPException(413, \"payload too large\")\n   109\t    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()\n   110\t    try:\n   111\t        verify_signature(\n   112\t            key,\n   113\t            request.headers.get(\"X-Gateway-Timestamp\", \"\"),\n   114\t            body,\n   115\t            request.headers.get(\"X-Gateway-Signature\", \"\"),\n   116\t        )\n   117\t    except Rejected as exc:\n   118\t        raise HTTPException(401, str(exc)) from exc\n   119\t\n   120\t    payload = await request.json()\n   121\t    doc = Inbound(\n   122\t        business_unit=payload[\"business_unit\"],\n   123\t        sender=payload[\"from\"],\n   124\t        media_type=payload[\"media_type\"],\n   125\t        raw=base64.b64decode(payload[\"content_b64\"], validate=True),\n   126\t    )\n   127\t    doc_id = f\"doc-{uuid.uuid4().hex[:20]}\"\n   128\t    pool = request.app.state.pool\n   129\t    try:\n   130\t        text = validate(doc)\n   131\t    except Rejected as exc:\n   132\t        await pool.execute(\n   133\t            \"\"\"\n   134\t            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)\n   135\t            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())\n   136\t            \"\"\",\n   137\t            doc_id, doc.business_unit, doc.sender, doc.media_type,\n   138\t            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],\n   139\t        )\n   140\t        return {\"doc_id\": doc_id, \"status\": \"quarantined\"}\n   141\t\n   142\t    await pool.execute(\n   143\t        \"\"\"\n   144\t        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)\n   145\t        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())\n   146\t        \"\"\",\n   147\t        doc_id, doc.business_unit, doc.sender, doc.media_type,\n   148\t        hashlib.sha256(doc.raw).hexdigest(), text,\n   149\t    )\n   150\t    return {\"doc_id\": doc_id, \"status\": \"accepted\"}\n=== app/main.py\n     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport hashlib\n     6\timport hmac\n     7\timport json\n     8\timport logging\n     9\timport time\n    10\timport uuid\n    11\tfrom contextlib import asynccontextmanager\n    12\tfrom pathlib import Path\n    13\tfrom urllib.parse import parse_qs\n    14\t\n    15\timport asyncpg\n    16\timport jwt\n    17\tfrom anthropic import AsyncAnthropic\n    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n    20\tfrom opentelemetry import trace\n    21\tfrom pydantic import BaseModel, Field\n    22\t\n    23\tfrom app import audit, ingest\n    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n    25\tfrom app.extractor import LineItemExtractor\n    26\tfrom app.gate import PolicyGate\n    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n    28\tfrom app.loop import AgentDeps, ProcurementAgent\n    29\tfrom app.mcp_client import ErpMcpClient\n    30\tfrom app.redact import RedactingFilter\n    31\tfrom app.settings import get_settings\n    32\tfrom app.startup import startup_checks\n    33\tfrom app.tools.slack import SlackClient\n    34\t\n    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n    36\tfor handler in logging.getLogger().handlers:\n    37\t    handler.addFilter(RedactingFilter())\n    38\tlog = logging.getLogger(\"procurement\")\n    39\t\n    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    41\tbearer = HTTPBearer()\n    42\t\n    43\t\n    44\tclass RunRequest(BaseModel):\n    45\t    task: str = Field(min_length=1, max_length=4000)\n    46\t    department: str = Field(min_length=1, max_length=64)\n    47\t\n    48\t\n    49\tclass Principal(BaseModel):\n    50\t    subject: str\n    51\t    business_unit: str\n    52\t\n    53\t\n    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    55\t    return RunIdentity(\n    56\t        accountable_party=\"system:procurement-agent\",\n    57\t        operational_owner=settings.operational_owner,\n    58\t        tenant=tenant,\n    59\t        agent_type_id=agent_type_id,\n    60\t        agent_instance_id=new_instance_id(),\n    61\t        trace_id=uuid.uuid4().hex,\n    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n    63\t        delegated_subject=\"system:procurement-agent\",\n    64\t        agent_principal=AGENT_PRINCIPAL,\n    65\t    )\n    66\t\n    67\t\n    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n    69\t    while True:\n    70\t        await asyncio.sleep(60)\n    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n    72\t        count = await app.state.pool.fetchval(\n    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n    75\t        )\n    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n    78\t\n    79\t\n    80\t@asynccontextmanager\n    81\tasync def lifespan(app: FastAPI):\n    82\t    settings = get_settings()\n    83\t    agent_type_id = startup_checks(settings)\n    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    85\t    broker = TokenBroker(settings)\n    86\t\n    87\t    async def slack_token() -> str:\n    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n    89\t\n    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n    92\t    gate = PolicyGate(settings.policy, approvals)\n    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n    95\t\n    96\t    client = AsyncAnthropic()\n    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    98\t    deps.extractor = LineItemExtractor(\n    99\t        client=client, settings=settings, deps=deps,\n   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n   101\t    )\n   102\t    app.state.settings = settings\n   103\t    app.state.pool = pool\n   104\t    app.state.agent_type_id = agent_type_id\n   105\t    app.state.approvals = approvals\n   106\t    app.state.agent = ProcurementAgent(\n   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n   108\t    )\n   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n   111\t    try:\n   112\t        yield\n   113\t    finally:\n   114\t        sweeper.cancel()\n   115\t        await pool.close()\n   116\t\n   117\t\n   118\tapp = FastAPI(lifespan=lifespan)\n   119\tapp.include_router(ingest.router)\n   120\t\n   121\t\n   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n   123\t    settings = request.app.state.settings\n   124\t    try:\n   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n   126\t        claims = jwt.decode(\n   127\t            creds.credentials,\n   128\t            key.key,\n   129\t            algorithms=[\"RS256\", \"ES256\"],\n   130\t            audience=settings.oidc_audience,\n   131\t            issuer=settings.oidc_issuer,\n   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n   133\t        )\n   134\t    except jwt.PyJWTError as exc:\n   135\t        raise HTTPException(401, \"invalid token\") from exc\n   136\t    bu = claims.get(\"bu\")\n   137\t    if not bu:\n   138\t        raise HTTPException(403, \"token has no business unit\")\n   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n   140\t\n   141\t\n   142\t@app.post(\"/runs\")\n   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n   144\t    settings = request.app.state.settings\n   145\t    span_ctx = trace.get_current_span().get_span_context()\n   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n   147\t    ident = RunIdentity(\n   148\t        accountable_party=principal.subject,\n   149\t        operational_owner=settings.operational_owner,\n   150\t        tenant=principal.business_unit,\n   151\t        agent_type_id=request.app.state.agent_type_id,\n   152\t        agent_instance_id=new_instance_id(),\n   153\t        trace_id=trace_id,\n   154\t        run_id=f\"run-{uuid.uuid4()}\",\n   155\t        delegated_subject=principal.subject,\n   156\t        agent_principal=AGENT_PRINCIPAL,\n   157\t    )\n   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n   161\t\n   162\t\n   163\t@app.post(\"/slack/interactions\")\n   164\tasync def slack_interactions(request: Request) -> dict:\n   165\t    body = await request.body()\n   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n   167\t    if abs(time.time() - int(timestamp)) > 300:\n   168\t        raise HTTPException(401, \"stale request\")\n   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n   172\t        raise HTTPException(401, \"bad signature\")\n   173\t\n   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n   175\t    action = payload[\"actions\"][0]\n   176\t    slack_user = payload[\"user\"][\"id\"]\n   177\t    row = await request.app.state.pool.fetchrow(\n   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n   179\t    )\n   180\t    if row is None:\n   181\t        raise HTTPException(403, \"not an approver\")\n   182\t    try:\n   183\t        await request.app.state.approvals.decide(\n   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n   185\t            approve=action[\"action_id\"] == \"approve\",\n   186\t        )\n   187\t    except ApproverNotAuthorized as exc:\n   188\t        raise HTTPException(403, str(exc)) from exc\n   189\t    except ValueError as exc:\n   190\t        raise HTTPException(409, str(exc)) from exc\n   191\t    return {\"ok\": True}\n   192\t\n   193\t\n   194\t@app.get(\"/healthz\")\n   195\tasync def healthz() -> dict:\n   196\t    return {\"ok\": True}\n=== app/tools/__init__.py\n     1\t\"\"\"Tool registry.\n     2\t\n     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n     5\tthat is not in the run's registry.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom functools import lru_cache\n    11\tfrom typing import Any, Awaitable, Callable\n    12\t\n    13\timport yaml\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\t\n    17\tDEFAULT_ROLE = \"procurement\"\n    18\t\n    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Tool:\n    24\t    name: str\n    25\t    description: str\n    26\t    input_schema: dict[str, Any]\n    27\t    invoke: Invoke\n    28\t    target_field: str | None = None\n    29\t\n    30\t    def target_of(self, args: dict[str, Any]) -> str:\n    31\t        if self.target_field is None:\n    32\t            return self.name\n    33\t        return str(args.get(self.target_field, \"\"))\n    34\t\n    35\t    def schema(self) -> dict[str, Any]:\n    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n    37\t\n    38\t\n    39\tclass ToolRegistry:\n    40\t    def __init__(self, tools: list[Tool]):\n    41\t        self._tools = {t.name: t for t in tools}\n    42\t\n    43\t    def get(self, name: str) -> Tool | None:\n    44\t        return self._tools.get(name)\n    45\t\n    46\t    def names(self) -> list[str]:\n    47\t        return sorted(self._tools)\n    48\t\n    49\t    def schemas(self) -> list[dict[str, Any]]:\n    50\t        return [self._tools[n].schema() for n in self.names()]\n    51\t\n    52\t\n    53\t@lru_cache(maxsize=1)\n    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        cfg = yaml.safe_load(fh)\n    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n    58\t\n    59\t\n    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n    61\t    from app.tools import documents, erp, memory, payments, slack\n    62\t\n    63\t    available: dict[str, Tool] = {}\n    64\t    for module in (documents, erp, memory, payments, slack):\n    65\t        for tool in module.tools(deps):\n    66\t            available[tool.name] = tool\n    67\t\n    68\t    roles = _role_tools(str(deps.settings.tools_path))\n    69\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n    70\t    return ToolRegistry([available[name] for name in allowed if name in available])\n=== app/tools/documents.py\n     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tUNTRUSTED_WRAPPER = (\n    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n    11\t    \"{text}\\n\"\n    12\t    \"</untrusted_document>\"\n    13\t)\n    14\t\n    15\t\n    16\tdef tools(deps) -> list[Tool]:\n    17\t    pool = deps.pool\n    18\t\n    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n    20\t        row = await pool.fetchrow(\n    21\t            \"\"\"\n    22\t            SELECT doc_id, source, media_type, text\n    23\t            FROM documents\n    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n    25\t            \"\"\",\n    26\t            args[\"doc_id\"],\n    27\t            ident.tenant,\n    28\t        )\n    29\t        if row is None:\n    30\t            return \"document not found\"\n    31\t        return UNTRUSTED_WRAPPER.format(\n    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n    33\t        )\n    34\t\n    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n    37\t\n    38\t    return [\n    39\t        Tool(\n    40\t            name=\"read_document\",\n    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n    42\t            input_schema={\n    43\t                \"type\": \"object\",\n    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    45\t                \"required\": [\"doc_id\"],\n    46\t                \"additionalProperties\": False,\n    47\t            },\n    48\t            invoke=read_document,\n    49\t        ),\n    50\t        Tool(\n    51\t            name=\"extract_line_items\",\n    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n    53\t            input_schema={\n    54\t                \"type\": \"object\",\n    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    56\t                \"required\": [\"doc_id\"],\n    57\t                \"additionalProperties\": False,\n    58\t            },\n    59\t            invoke=extract_line_items,\n    60\t        ),\n    61\t    ]\n=== app/tools/erp.py\n     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tERP_READ_SCOPE = \"erp.read\"\n    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n    11\t\n    12\t\n    13\tdef tools(deps) -> list[Tool]:\n    14\t    erp = deps.erp\n    15\t\n    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n    17\t        return await erp.call(\n    18\t            \"budget.get_remaining\",\n    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n    20\t            ident,\n    21\t            ERP_READ_SCOPE,\n    22\t        )\n    23\t\n    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n    25\t        arguments = dict(args.get(\"arguments\", {}))\n    26\t        arguments[\"business_unit\"] = ident.tenant\n    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n    28\t\n    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n    30\t        return await erp.call(\n    31\t            \"po.create\",\n    32\t            {\n    33\t                \"business_unit\": ident.tenant,\n    34\t                \"department\": args[\"department\"],\n    35\t                \"vendor_id\": args[\"vendor_id\"],\n    36\t                \"lines\": args[\"lines\"],\n    37\t                \"currency\": args[\"currency\"],\n    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n    39\t                \"client_reference\": args[\"source_doc_id\"],\n    40\t            },\n    41\t            ident,\n    42\t            ERP_PO_WRITE_SCOPE,\n    43\t        )\n    44\t\n    45\t    line_schema = {\n    46\t        \"type\": \"object\",\n    47\t        \"properties\": {\n    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n    52\t        },\n    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n    54\t        \"additionalProperties\": False,\n    55\t    }\n    56\t\n    57\t    return [\n    58\t        Tool(\n    59\t            name=\"get_budget\",\n    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n    61\t            input_schema={\n    62\t                \"type\": \"object\",\n    63\t                \"properties\": {\n    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n    66\t                },\n    67\t                \"required\": [\"department\", \"fiscal_period\"],\n    68\t                \"additionalProperties\": False,\n    69\t            },\n    70\t            invoke=get_budget,\n    71\t        ),\n    72\t        Tool(\n    73\t            name=\"erp_call\",\n    74\t            description=(\n    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n    77\t            ),\n    78\t            input_schema={\n    79\t                \"type\": \"object\",\n    80\t                \"properties\": {\n    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n    82\t                    \"arguments\": {\"type\": \"object\"},\n    83\t                },\n    84\t                \"required\": [\"operation\"],\n    85\t                \"additionalProperties\": False,\n    86\t            },\n    87\t            invoke=erp_call,\n    88\t        ),\n    89\t        Tool(\n    90\t            name=\"create_purchase_order\",\n    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n    92\t            input_schema={\n    93\t                \"type\": \"object\",\n    94\t                \"properties\": {\n    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n   100\t                },\n   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n   102\t                \"additionalProperties\": False,\n   103\t            },\n   104\t            invoke=create_purchase_order,\n   105\t            target_field=\"source_doc_id\",\n   106\t        ),\n   107\t    ]\n=== app/tools/memory.py\n     1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n     2\t\n     3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n     4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n     5\tuntil a procurement lead verifies them in the admin UI. Every row records\n     6\twho wrote it, from which run and source document, and the context size at\n     7\tthe time.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport re\n    12\timport uuid\n    13\tfrom typing import Any\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\tfrom app.tools import Tool\n    17\t\n    18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n    19\tMAX_NOTE_CHARS = 800\n    20\tINSTRUCTION_LIKE = [\n    21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n    22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n    23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n    24\t    re.compile(r\"https?://\"),\n    25\t]\n    26\t\n    27\t\n    28\tclass NoteRejected(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tdef check_note(text: str) -> None:\n    33\t    if len(text) > MAX_NOTE_CHARS:\n    34\t        raise NoteRejected(\"note too long\")\n    35\t    for pattern in INSTRUCTION_LIKE:\n    36\t        if pattern.search(text):\n    37\t            raise NoteRejected(\"note looks like an instruction\")\n    38\t\n    39\t\n    40\tdef tools(deps) -> list[Tool]:\n    41\t    pool = deps.pool\n    42\t\n    43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n    44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n    45\t        rows = await pool.fetch(\n    46\t            \"\"\"\n    47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n    48\t            FROM dept_notes\n    49\t            WHERE business_unit = $1\n    50\t              AND department = $2\n    51\t              AND NOT quarantined\n    52\t              AND (verified OR expires_at > now())\n    53\t            ORDER BY created_at DESC\n    54\t            LIMIT 20\n    55\t            \"\"\",\n    56\t            business_unit,\n    57\t            args[\"department\"],\n    58\t        )\n    59\t        return [\n    60\t            {\n    61\t                \"note_id\": r[\"note_id\"],\n    62\t                \"kind\": r[\"kind\"],\n    63\t                \"body\": r[\"body\"],\n    64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n    65\t                \"written\": r[\"created_at\"].isoformat(),\n    66\t            }\n    67\t            for r in rows\n    68\t        ]\n    69\t\n    70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n    71\t        if args[\"kind\"] not in NOTE_KINDS:\n    72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n    73\t        check_note(args[\"body\"])\n    74\t        note_id = f\"note-{uuid.uuid4()}\"\n    75\t        ctx = deps.current_context(ident)\n    76\t        await pool.execute(\n    77\t            \"\"\"\n    78\t            INSERT INTO dept_notes (\n    79\t                note_id, business_unit, department, kind, body,\n    80\t                verified, quarantined, expires_at,\n    81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n    82\t                delegated_subject, context_tokens, context_method, created_at\n    83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n    84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n    85\t            \"\"\",\n    86\t            note_id,\n    87\t            ident.tenant,\n    88\t            args[\"department\"],\n    89\t            args[\"kind\"],\n    90\t            args[\"body\"],\n    91\t            ident.agent_instance_id,\n    92\t            ident.agent_type_id,\n    93\t            ident.run_id,\n    94\t            args.get(\"source_doc_id\"),\n    95\t            ident.delegated_subject,\n    96\t            ctx.tokens,\n    97\t            ctx.method,\n    98\t        )\n    99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n   100\t\n   101\t    return [\n   102\t        Tool(\n   103\t            name=\"memory_read\",\n   104\t            description=(\n   105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n   106\t                \"shared-services staff may look up another unit's notes.\"\n   107\t            ),\n   108\t            input_schema={\n   109\t                \"type\": \"object\",\n   110\t                \"properties\": {\n   111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n   113\t                },\n   114\t                \"required\": [\"department\"],\n   115\t                \"additionalProperties\": False,\n   116\t            },\n   117\t            invoke=memory_read,\n   118\t        ),\n   119\t        Tool(\n   120\t            name=\"memory_write\",\n   121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n   122\t            input_schema={\n   123\t                \"type\": \"object\",\n   124\t                \"properties\": {\n   125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n   127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n   128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n   129\t                },\n   130\t                \"required\": [\"department\", \"kind\", \"body\"],\n   131\t                \"additionalProperties\": False,\n   132\t            },\n   133\t            invoke=memory_write,\n   134\t        ),\n   135\t    ]\n=== app/tools/payments.py\n     1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.tools import Tool\n    11\t\n    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n    13\tPAYMENTS_SCOPE = \"payments.create\"\n    14\t\n    15\t\n    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n    17\t    raw = \"|\".join(\n    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n    19\t    )\n    20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n    21\t\n    22\t\n    23\tdef tools(deps) -> list[Tool]:\n    24\t    settings = deps.settings\n    25\t\n    26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n    27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n    28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n    29\t            resp = await client.post(\n    30\t                f\"{settings.payments_api_url}/v2/payments\",\n    31\t                headers={\n    32\t                    \"Authorization\": f\"Bearer {token}\",\n    33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n    34\t                },\n    35\t                json={\n    36\t                    \"business_unit\": ident.tenant,\n    37\t                    \"invoice_reference\": args[\"invoice_id\"],\n    38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n    39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n    40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n    41\t                },\n    42\t            )\n    43\t        resp.raise_for_status()\n    44\t        body = resp.json()\n    45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n    46\t\n    47\t    return [\n    48\t        Tool(\n    49\t            name=\"pay_invoice\",\n    50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n    51\t            input_schema={\n    52\t                \"type\": \"object\",\n    53\t                \"properties\": {\n    54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n    55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n    56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n    57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n    59\t                },\n    60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n    61\t                \"additionalProperties\": False,\n    62\t            },\n    63\t            invoke=pay_invoice,\n    64\t            target_field=\"invoice_id\",\n    65\t        )\n    66\t    ]\n=== app/tools/slack.py\n     1\t\"\"\"Slack tool: message staff and vendors, plus the approvals notifier.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom datetime import datetime\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.redact import redact_text, strip_unapproved_links\n    11\tfrom app.tools import Tool\n    12\t\n    13\tMAX_TEXT = 3000\n    14\t\n    15\t\n    16\tdef clean_outbound(text: str) -> str:\n    17\t    return strip_unapproved_links(redact_text(text))[:MAX_TEXT]\n    18\t\n    19\t\n    20\tclass SlackClient:\n    21\t    def __init__(self, api_url: str, bot_token_provider):\n    22\t        self.api_url = api_url\n    23\t        self._token = bot_token_provider\n    24\t\n    25\t    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:\n    26\t        payload: dict[str, Any] = {\n    27\t            \"channel\": channel,\n    28\t            \"text\": clean_outbound(text),\n    29\t            \"unfurl_links\": False,\n    30\t            \"unfurl_media\": False,\n    31\t            \"mrkdwn\": True,\n    32\t        }\n    33\t        if blocks:\n    34\t            payload[\"blocks\"] = blocks\n    35\t        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:\n    36\t            resp = await client.post(\n    37\t                f\"{self.api_url}/chat.postMessage\",\n    38\t                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\n    39\t                json=payload,\n    40\t            )\n    41\t        resp.raise_for_status()\n    42\t        body = resp.json()\n    43\t        if not body.get(\"ok\"):\n    44\t            raise RuntimeError(f\"slack error: {body.get('error')}\")\n    45\t        return {\"channel\": body[\"channel\"], \"ts\": body[\"ts\"]}\n    46\t\n    47\t    async def post_approval_request(\n    48\t        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\n    49\t    ) -> None:\n    50\t        lines = \"\\n\".join(f\"• *{k}*: `{v}`\" for k, v in summary.items())\n    51\t        text = f\"Approval needed for `{tool}` on `{target}` (expires {expires_at:%Y-%m-%d %H:%M} UTC)\\n{lines}\"\n    52\t        await self.post(\n    53\t            channel=f\"#approvals-{tenant}\",\n    54\t            text=text,\n    55\t            blocks=[\n    56\t                {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": clean_outbound(text)}},\n    57\t                {\n    58\t                    \"type\": \"actions\",\n    59\t                    \"elements\": [\n    60\t                        {\"type\": \"button\", \"action_id\": \"approve\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Approve\"}, \"style\": \"primary\"},\n    61\t                        {\"type\": \"button\", \"action_id\": \"reject\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Reject\"}, \"style\": \"danger\"},\n    62\t                    ],\n    63\t                },\n    64\t            ],\n    65\t        )\n    66\t\n    67\t\n    68\tdef tools(deps) -> list[Tool]:\n    69\t    slack: SlackClient = deps.slack\n    70\t\n    71\t    async def post_slack_message(args: dict[str, Any], ident: RunIdentity) -> Any:\n    72\t        return await slack.post(channel=args[\"channel\"], text=args[\"text\"])\n    73\t\n    74\t    return [\n    75\t        Tool(\n    76\t            name=\"post_slack_message\",\n    77\t            description=(\n    78\t                \"Post a message in Slack. Use internal channels for staff. Vendor contacts are in \"\n    79\t                \"Slack Connect channels named #vendor-<vendor_id>; set external=true for those.\"\n    80\t            ),\n    81\t            input_schema={\n    82\t                \"type\": \"object\",\n    83\t                \"properties\": {\n    84\t                    \"channel\": {\"type\": \"string\", \"maxLength\": 80},\n    85\t                    \"text\": {\"type\": \"string\", \"maxLength\": MAX_TEXT},\n    86\t                    \"external\": {\"type\": \"boolean\", \"default\": False},\n    87\t                },\n    88\t                \"required\": [\"channel\", \"text\"],\n    89\t                \"additionalProperties\": False,\n    90\t            },\n    91\t            invoke=post_slack_message,\n    92\t            target_field=\"channel\",\n    93\t        )\n    94\t    ]\n=== app/mcp_client.py\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n","numLines":1423,"startLine":1,"totalLines":1423}}}
