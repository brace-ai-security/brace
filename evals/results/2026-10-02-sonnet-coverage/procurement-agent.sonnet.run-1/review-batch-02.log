{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011yhDCmqJXutrnTy81ztmLQ","type":"tool_result","content":"50\t    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n51\t    51\t        return scopes.get(operation, \"erp.read\")\n52\t    52\t\n53\t    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n54\t    54\t        self._contexts[ident.agent_instance_id] = ctx\n55\t    55\t        proposed = await audit.record(\n56\t    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n57\t    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n58\t    58\t        )\n59\t    59\t        tool = registry.get(use.name)\n60\t    60\t        if tool is None:\n61\t    61\t            await audit.record(\n62\t    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n63\t    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n64\t    64\t            )\n65\t    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n66\t    66\t\n67\t    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n68\t    68\t        authz = await audit.record(\n69\t    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n70\t    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n71\t    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n72\t    72\t        )\n73\t    73\t        if not decision.allow:\n74\t    74\t            if decision.pending:\n75\t    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n76\t    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n77\t    77\t\n78\t    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n79\t    79\t        try:\n80\t    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n81\t    81\t                for k, v in ctx.otel_attributes().items():\n82\t    82\t                    span.set_attribute(k, v)\n83\t    83\t                output = await tool.invoke(use.input, ident)\n84\t    84\t        except BudgetExceeded:\n85\t    85\t            raise\n86\t    86\t        except Exception as exc:\n87\t    87\t            await audit.record(\n88\t    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n89\t    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n90\t    90\t                operation_id=operation_id,\n91\t    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n92\t    92\t            )\n93\t    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n94\t    94\t\n95\t    95\t        await audit.record(\n96\t    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n97\t    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n98\t    98\t            operation_id=operation_id,\n99\t    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n100\t   100\t        )\n101\t   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n102\t   102\t\n103\t   103\t\n104\t   104\tdef _error(tool_use_id: str, message: str) -> dict:\n105\t   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n106\t   106\t\n107\t   107\t\n108\t   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n109\t   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n110\t   110\t        return messages, False\n111\t   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n112\t   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n113\t   113\t        tail = tail[1:]\n114\t   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n115\t   115\t    return head + [note] + tail, True\n116\t   116\t\n117\t   117\t\n118\t   118\tclass ProcurementAgent:\n119\t   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n120\t   120\t        self.client = client\n121\t   121\t        self.deps = deps\n122\t   122\t        self.system_prompt = system_prompt\n123\t   123\t        self.role = role\n124\t   124\t\n125\t   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n126\t   126\t        pool = self.deps.pool\n127\t   127\t        await killswitch.assert_running(pool, ident.tenant)\n128\t   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n129\t   129\t        await budget.reserve_run_start(pool)\n130\t   130\t        self.deps._budgets[ident.run_id] = budget\n131\t   131\t        registry = build_registry(self.role, ident, self.deps)\n132\t   132\t\n133\t   133\t        run_node = await audit.record(\n134\t   134\t            pool, ident, kind=\"run_started\",\n135\t   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n136\t   136\t        )\n137\t   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n138\t   138\t        try:\n139\t   139\t            while True:\n140\t   140\t                budget.check_step()\n141\t   141\t                messages, compacted = _compact(messages)\n142\t   142\t                request = {\n143\t   143\t                    \"model\": self.deps.settings.model_id,\n144\t   144\t                    \"system\": self.system_prompt,\n145\t   145\t                    \"messages\": messages,\n146\t   146\t                    \"tools\": registry.schemas(),\n147\t   147\t                    \"max_tokens\": 4096,\n148\t   148\t                }\n149\t   149\t                ctx = await measure_context(self.client, request, compacted)\n150\t   150\t                response = await self.client.messages.create(**request)\n151\t   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n152\t   152\t                await budget.flush(pool)\n153\t   153\t                ctx = ctx.finalize(response.usage)\n154\t   154\t                decision = await audit.record(\n155\t   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n156\t   156\t                    payload={\n157\t   157\t                        \"requested_model\": request[\"model\"],\n158\t   158\t                        \"served_model\": response.model,\n159\t   159\t                        \"stop_reason\": response.stop_reason,\n160\t   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n161\t   161\t                    },\n162\t   162\t                )\n163\t   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n164\t   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n165\t   165\t                if not uses:\n166\t   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n167\t   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n168\t   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n169\t   169\t                    return final\n170\t   170\t                results = []\n171\t   171\t                for use in uses:\n172\t   172\t                    budget.check_tool_call()\n173\t   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n174\t   174\t                messages.append({\"role\": \"user\", \"content\": results})\n175\t   175\t        except BudgetExceeded as exc:\n176\t   176\t            await audit.record(\n177\t   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n178\t   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n179\t   179\t            )\n180\t   180\t            await self.deps.slack.post(\n181\t   181\t                channel=\"#procurement-agent-ops\",\n182\t   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n183\t   183\t            )\n184\t   184\t            return None\n185\t   185\t        finally:\n186\t   186\t            self.deps._budgets.pop(ident.run_id, None)\n187\t     1\tapiVersion: apps/v1\n188\t     2\tkind: Deployment\n189\t     3\tmetadata:\n190\t     4\t  name: procurement-agent\n191\t     5\t  namespace: procurement-prod\n192\t     6\t  labels:\n193\t     7\t    app: procurement-agent\n194\t     8\t    owner: team-procurement-platform\n195\t     9\tspec:\n196\t    10\t  replicas: 3\n197\t    11\t  selector:\n198\t    12\t    matchLabels:\n199\t    13\t      app: procurement-agent\n200\t    14\t  template:\n201\t    15\t    metadata:\n202\t    16\t      labels:\n203\t    17\t        app: procurement-agent\n204\t    18\t    spec:\n205\t    19\t      serviceAccountName: procurement-agent\n206\t    20\t      automountServiceAccountToken: false\n207\t    21\t      hostUsers: false\n208\t    22\t      enableServiceLinks: false\n209\t    23\t      securityContext:\n210\t    24\t        runAsNonRoot: true\n211\t    25\t        runAsUser: 65532\n212\t    26\t        runAsGroup: 65532\n213\t    27\t        fsGroup: 65532\n214\t    28\t        seccompProfile:\n215\t    29\t          type: RuntimeDefault\n216\t    30\t      containers:\n217\t    31\t        - name: agent\n218\t    32\t          image: registry.example-corp.test/procurement/agent@sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\n219\t    33\t          imagePullPolicy: IfNotPresent\n220\t    34\t          ports:\n221\t    35\t            - containerPort: 8080\n222\t    36\t              name: http\n223\t    37\t          env:\n224\t    38\t            - name: IMAGE_DIGEST\n225\t    39\t              value: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n226\t    40\t            - name: MODEL_ID\n227\t    41\t              value: \"claude-sonnet-4-5-20250929\"\n228\t    42\t            - name: EXTRACTOR_MODEL_ID\n229\t    43\t              value: \"claude-haiku-4-5-20251001\"\n230\t    44\t            - name: DATABASE_URL\n231\t    45\t              value: \"postgresql://procurement_agent@procurement-db.procurement-data.svc.cluster.local:5432/procurement?sslmode=verify-full\"\n232\t    46\t            - name: ERP_MCP_URL\n233\t    47\t              value: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n234\t    48\t            - name: PAYMENTS_API_URL\n235\t    49\t              value: \"https://api.payments.example-pay.test\"\n236\t    50\t            - name: SLACK_API_URL\n237\t    51\t              value: \"https://slack-proxy.egress.svc.cluster.local:8443/api\"\n238\t    52\t            - name: STS_URL\n239\t    53\t              value: \"https://sts.identity.svc.cluster.local/oauth2/token\"\n240\t    54\t            - name: OIDC_ISSUER\n241\t    55\t              value: \"https://login.example-corp.test\"\n242\t    56\t            - name: OIDC_JWKS_URL\n243\t    57\t              value: \"https://login.example-corp.test/.well-known/jwks.json\"\n244\t    58\t            - name: HTTPS_PROXY\n245\t    59\t              value: \"http://egress-proxy.egress.svc.cluster.local:3128\"\n246\t    60\t            - name: NO_PROXY\n247\t    61\t              value: \".svc.cluster.local\"\n248\t    62\t            - name: OTEL_EXPORTER_OTLP_ENDPOINT\n249\t    63\t              value: \"http://otel-collector.observability.svc.cluster.local:4317\"\n250\t    64\t            - name: OTEL_SERVICE_NAME\n251\t    65\t              value: \"procurement-agent\"\n252\t    66\t            - name: OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT\n253\t    67\t              value: \"false\"\n254\t    68\t          securityContext:\n255\t    69\t            allowPrivilegeEscalation: false\n256\t    70\t            privileged: false\n257\t    71\t            readOnlyRootFilesystem: true\n258\t    72\t            runAsNonRoot: true\n259\t    73\t            capabilities:\n260\t    74\t              drop: [\"ALL\"]\n261\t    75\t            seccompProfile:\n262\t    76\t              type: RuntimeDefault\n263\t    77\t          resources:\n264\t    78\t            requests:\n265\t    79\t              cpu: 250m\n266\t    80\t              memory: 512Mi\n267\t    81\t            limits:\n268\t    82\t              cpu: \"1\"\n269\t    83\t              memory: 1Gi\n270\t    84\t          readinessProbe:\n271\t    85\t            httpGet:\n272\t    86\t              path: /healthz\n273\t    87\t              port: http\n274\t    88\t          volumeMounts:\n275\t    89\t            - name: workload-token\n276\t    90\t              mountPath: /var/run/secrets/tokens\n277\t    91\t              readOnly: true\n278\t    92\t            - name: slack-signing\n279\t    93\t              mountPath: /var/run/secrets/slack\n280\t    94\t              readOnly: true\n281\t    95\t            - name: mail-hmac\n282\t    96\t              mountPath: /var/run/secrets/mail\n283\t    97\t              readOnly: true\n284\t    98\t            - name: tmp\n285\t    99\t              mountPath: /tmp\n286\t   100\t      volumes:\n287\t   101\t        - name: workload-token\n288\t   102\t          projected:\n289\t   103\t            sources:\n290\t   104\t              - serviceAccountToken:\n291\t   105\t                  path: procurement-agent\n292\t   106\t                  audience: sts.identity.example-corp.test\n293\t   107\t                  expirationSeconds: 600\n294\t   108\t        - name: slack-signing\n295\t   109\t          secret:\n296\t   110\t            secretName: procurement-slack-signing\n297\t   111\t        - name: mail-hmac\n298\t   112\t          secret:\n299\t   113\t            secretName: procurement-mail-gateway-hmac\n300\t   114\t        - name: tmp\n301\t   115\t          emptyDir:\n302\t   116\t            medium: Memory\n303\t   117\t            sizeLimit: 64Mi\n304\t     1\tapiVersion: kyverno.io/v1\n305\t     2\tkind: ClusterPolicy\n306\t     3\tmetadata:\n307\t     4\t  name: procurement-verify-images\n308\t     5\t  annotations:\n309\t     6\t    policies.kyverno.io/title: Verify procurement agent images\n310\t     7\t    kyverno.io/kyverno-version: \"1.15.2\"\n311\t     8\tspec:\n312\t     9\t  validationFailureAction: Enforce\n313\t    10\t  background: false\n314\t    11\t  webhookTimeoutSeconds: 15\n315\t    12\t  failurePolicy: Fail\n316\t    13\t  rules:\n317\t    14\t    - name: only-approved-registry\n318\t    15\t      match:\n319\t    16\t        any:\n320\t    17\t          - resources:\n321\t    18\t              kinds: [Pod]\n322\t    19\t              namespaces: [procurement-prod]\n323\t    20\t      validate:\n324\t    21\t        message: \"Images in procurement-prod must come from registry.example-corp.test/procurement and be pinned by digest.\"\n325\t    22\t        pattern:\n326\t    23\t          spec:\n327\t    24\t            =(initContainers):\n328\t    25\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n329\t    26\t            containers:\n330\t    27\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n331\t    28\t    - name: verify-signature-and-provenance\n332\t    29\t      match:\n333\t    30\t        any:\n334\t    31\t          - resources:\n335\t    32\t              kinds: [Pod]\n336\t    33\t              namespaces: [procurement-prod]\n337\t    34\t      verifyImages:\n338\t    35\t        - imageReferences:\n339\t    36\t            - \"registry.example-corp.test/procurement/*\"\n340\t    37\t          mutateDigest: false\n341\t    38\t          verifyDigest: true\n342\t    39\t          required: true\n343\t    40\t          attestors:\n344\t    41\t            - entries:\n345\t    42\t                - keyless:\n346\t    43\t                    issuer: \"https://token.actions.githubusercontent.com\"\n347\t    44\t                    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n348\t    45\t                    rekor:\n349\t    46\t                      url: https://rekor.sigstore.dev\n350\t    47\t          attestations:\n351\t    48\t            - type: https://slsa.dev/provenance/v1\n352\t    49\t              attestors:\n353\t    50\t                - entries:\n354\t    51\t                    - keyless:\n355\t    52\t                        issuer: \"https://token.actions.githubusercontent.com\"\n356\t    53\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n357\t    54\t              conditions:\n358\t    55\t                - all:\n359\t    56\t                    - key: \"{{ buildDefinition.buildType }}\"\n360\t    57\t                      operator: Equals\n361\t    58\t                      value: \"https://actions.github.io/buildtypes/workflow/v1\"\n362\t    59\t                    - key: \"{{ buildDefinition.externalParameters.workflow.repository }}\"\n363\t    60\t                      operator: Equals\n364\t    61\t                      value: \"https://github.com/example-corp/procurement-agent\"\n365\t    62\t                    - key: \"{{ buildDefinition.externalParameters.workflow.ref }}\"\n366\t    63\t                      operator: Equals\n367\t    64\t                      value: \"refs/heads/main\"\n368\t    65\t                    - key: \"{{ buildDefinition.externalParameters.workflow.path }}\"\n369\t    66\t                      operator: Equals\n370\t    67\t                      value: \".github/workflows/ci.yaml\"\n371\t    68\t                    - key: \"{{ runDetails.builder.id }}\"\n372\t    69\t                      operator: Equals\n373\t    70\t                      value: \"https://github.com/actions/runner/github-hosted\"\n374\t    71\t            - type: https://cyclonedx.org/bom\n375\t    72\t              attestors:\n376\t    73\t                - entries:\n377\t    74\t                    - keyless:\n378\t    75\t                        issuer: \"https://token.actions.githubusercontent.com\"\n379\t    76\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n380\t     1\tapiVersion: networking.k8s.io/v1\n381\t     2\tkind: NetworkPolicy\n382\t     3\tmetadata:\n383\t     4\t  name: procurement-agent-default-deny\n384\t     5\t  namespace: procurement-prod\n385\t     6\tspec:\n386\t     7\t  podSelector: {}\n387\t     8\t  policyTypes: [\"Ingress\", \"Egress\"]\n388\t     9\t---\n389\t    10\tapiVersion: networking.k8s.io/v1\n390\t    11\tkind: NetworkPolicy\n391\t    12\tmetadata:\n392\t    13\t  name: procurement-agent-egress\n393\t    14\t  namespace: procurement-prod\n394\t    15\tspec:\n395\t    16\t  podSelector:\n396\t    17\t    matchLabels:\n397\t    18\t      app: procurement-agent\n398\t    19\t  policyTypes: [\"Egress\"]\n399\t    20\t  egress:\n400\t    21\t    - to:\n401\t    22\t        - namespaceSelector:\n402\t    23\t            matchLabels:\n403\t    24\t              kubernetes.io/metadata.name: kube-system\n404\t    25\t          podSelector:\n405\t    26\t            matchLabels:\n406\t    27\t              k8s-app: kube-dns\n407\t    28\t      ports:\n408\t    29\t        - { protocol: UDP, port: 53 }\n409\t    30\t        - { protocol: TCP, port: 53 }\n410\t    31\t    - to:\n411\t    32\t        - namespaceSelector:\n412\t    33\t            matchLabels:\n413\t    34\t              kubernetes.io/metadata.name: egress\n414\t    35\t          podSelector:\n415\t    36\t            matchLabels:\n416\t    37\t              app: egress-proxy\n417\t    38\t      ports:\n418\t    39\t        - { protocol: TCP, port: 3128 }\n419\t    40\t    - to:\n420\t    41\t        - namespaceSelector:\n421\t    42\t            matchLabels:\n422\t    43\t              kubernetes.io/metadata.name: egress\n423\t    44\t          podSelector:\n424\t    45\t            matchLabels:\n425\t    46\t              app: slack-proxy\n426\t    47\t      ports:\n427\t    48\t        - { protocol: TCP, port: 8443 }\n428\t    49\t    - to:\n429\t    50\t        - namespaceSelector:\n430\t    51\t            matchLabels:\n431\t    52\t              kubernetes.io/metadata.name: procurement-data\n432\t    53\t          podSelector:\n433\t    54\t            matchLabels:\n434\t    55\t              app: procurement-db\n435\t    56\t      ports:\n436\t    57\t        - { protocol: TCP, port: 5432 }\n437\t    58\t    - to:\n438\t    59\t        - namespaceSelector:\n439\t    60\t            matchLabels:\n440\t    61\t              kubernetes.io/metadata.name: erp-mcp-gateway\n441\t    62\t      ports:\n442\t    63\t        - { protocol: TCP, port: 8443 }\n443\t    64\t    - to:\n444\t    65\t        - namespaceSelector:\n445\t    66\t            matchLabels:\n446\t    67\t              kubernetes.io/metadata.name: identity\n447\t    68\t          podSelector:\n448\t    69\t            matchLabels:\n449\t    70\t              app: sts\n450\t    71\t      ports:\n451\t    72\t        - { protocol: TCP, port: 443 }\n452\t    73\t    - to:\n453\t    74\t        - ipBlock:\n454\t    75\t            cidr: 0.0.0.0/0\n455\t    76\t            except:\n456\t    77\t              - 10.0.0.0/8\n457\t    78\t              - 172.16.0.0/12\n458\t    79\t              - 192.168.0.0/16\n459\t    80\t              - 169.254.0.0/16\n460\t    81\t      ports:\n461\t    82\t        - { protocol: TCP, port: 443 }\n462\t    83\t---\n463\t    84\tapiVersion: networking.k8s.io/v1\n464\t    85\tkind: NetworkPolicy\n465\t    86\tmetadata:\n466\t    87\t  name: procurement-agent-ingress\n467\t    88\t  namespace: procurement-prod\n468\t    89\tspec:\n469\t    90\t  podSelector:\n470\t    91\t    matchLabels:\n471\t    92\t      app: procurement-agent\n472\t    93\t  policyTypes: [\"Ingress\"]\n473\t    94\t  ingress:\n474\t    95\t    - from:\n475\t    96\t        - namespaceSelector:\n476\t    97\t            matchLabels:\n477\t    98\t              kubernetes.io/metadata.name: ingress\n478\t    99\t      ports:\n479\t   100\t        - { protocol: TCP, port: 8080 }\n480\t   101\t---\n481\t   102\t# Egress proxy allowlist (applied in the egress namespace by the platform team).\n482\t   103\tapiVersion: v1\n483\t   104\tkind: ConfigMap\n484\t   105\tmetadata:\n485\t   106\t  name: egress-proxy-allowlist-procurement\n486\t   107\t  namespace: egress\n487\t   108\tdata:\n488\t   109\t  allowlist.txt: |\n489\t   110\t    api.anthropic.com\n490\t   111\t    api.payments.example-pay.test\n491\t   112\t    login.example-corp.test\n492\t     1\tapiVersion: v1\n493\t     2\tkind: Namespace\n494\t     3\tmetadata:\n495\t     4\t  name: procurement-prod\n496\t     5\t  labels:\n497\t     6\t    pod-security.kubernetes.io/enforce: restricted\n498\t     7\t    pod-security.kubernetes.io/enforce-version: latest\n499\t     8\t    pod-security.kubernetes.io/audit: restricted\n500\t     9\t    pod-security.kubernetes.io/warn: restricted\n501\t    10\t---\n502\t    11\tapiVersion: v1\n503\t    12\tkind: ServiceAccount\n504\t    13\tmetadata:\n505\t    14\t  name: procurement-agent\n506\t    15\t  namespace: procurement-prod\n507\t    16\t  labels:\n508\t    17\t    app: procurement-agent\n509\t    18\tautomountServiceAccountToken: false\n510\t     1\t# syntax=docker/dockerfile:1.10\n511\t     2\tFROM python:3.11.10-slim-bookworm@sha256:2a6386ad2db20e7f55073f69a98d6da2cf9f168e05e7487d2670c22e4ad2a1bd AS build\n512\t     3\tWORKDIR /src\n513\t     4\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n514\t     5\tCOPY pyproject.toml ./\n515\t     6\tCOPY app ./app\n516\t     7\tRUN pip install --target /opt/site .\n517\t     8\tRUN python -m compileall -q app\n518\t     9\t\n519\t    10\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:8f3c1a6e2b9d4f7a0c5e8b1d3f6a9c2e5b8d1f4a7c0e3b6d9f2a5c8e1b4d7f0a\n520\t    11\tWORKDIR /app\n521\t    12\tENV PYTHONPATH=/opt/site:/app \\\n522\t    13\t    PYTHONDONTWRITEBYTECODE=1 \\\n523\t    14\t    APP_ROOT=/app\n524\t    15\tCOPY --from=build /opt/site /opt/site\n525\t    16\tCOPY --from=build /src/app /app/app\n526\t    17\tCOPY prompts /app/prompts\n527\t    18\tCOPY config /app/config\n528\t    19\tCOPY release/manifest.yaml /app/release/manifest.yaml\n529\t    20\tUSER 65532:65532\n530\t    21\tEXPOSE 8080\n531\t    22\tENTRYPOINT [\"python\", \"-m\", \"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\", \"--no-server-header\"]\n532\t     1\tname: ci\n533\t     2\t\n534\t     3\ton:\n535\t     4\t  pull_request:\n536\t     5\t  push:\n537\t     6\t    branches: [main]\n538\t     7\t\n539\t     8\tpermissions:\n540\t     9\t  contents: read\n541\t    10\t\n542\t    11\tjobs:\n543\t    12\t  test:\n544\t    13\t    runs-on: ubuntu-24.04\n545\t    14\t    steps:\n546\t    15\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n547\t    16\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n548\t    17\t        with:\n549\t    18\t          python-version: \"3.11\"\n550\t    19\t      - run: pip install -e '.[test]'\n551\t    20\t      - run: pytest -q\n552\t    21\t      - name: Secret scan\n553\t    22\t        uses: gitleaks/gitleaks-action@83373cf2f8c4db6e24b41c1a9b086bb9619e9cd3 # v2.3.7\n554\t    23\t      - name: Manifest hashes match files\n555\t    24\t        run: |\n556\t    25\t          python - <<'PY'\n557\t    26\t          import hashlib, yaml, sys\n558\t    27\t          m = yaml.safe_load(open(\"release/manifest.yaml\"))\n559\t    28\t          bad = []\n560\t    29\t          for group in (\"prompts\", \"config\"):\n561\t    30\t              for name, e in m[group].items():\n562\t    31\t                  if isinstance(e, dict) and \"sha256\" in e:\n563\t    32\t                      got = \"sha256:\" + hashlib.sha256(open(e[\"path\"], \"rb\").read()).hexdigest()\n564\t    33\t                      if got != e[\"sha256\"]:\n565\t    34\t                          bad.append(e[\"path\"])\n566\t    35\t          if bad:\n567\t    36\t              sys.exit(\"manifest out of date: \" + \", \".join(bad))\n568\t    37\t          PY\n569\t    38\t\n570\t    39\t  release:\n571\t    40\t    if: github.ref == 'refs/heads/main'\n572\t    41\t    needs: test\n573\t    42\t    runs-on: ubuntu-24.04\n574\t    43\t    permissions:\n575\t    44\t      contents: read\n576\t    45\t      id-token: write\n577\t    46\t      packages: write\n578\t    47\t      attestations: write\n579\t    48\t    steps:\n580\t    49\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n581\t    50\t      - uses: sigstore/cosign-installer@dc72c7d5c4d10cd6bcb8cf6e3fd625a9e5e537da # v3.7.0\n582\t    51\t        with:\n583\t    52\t          cosign-release: \"v2.6.2\"\n584\t    53\t      - uses: docker/setup-buildx-action@c47758b77c9736f4b2ef4073d4d51994fabfe349 # v3.7.1\n585\t    54\t      - uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0\n586\t    55\t        with:\n587\t    56\t          registry: registry.example-corp.test\n588\t    57\t          username: ${{ github.actor }}\n589\t    58\t          password: ${{ secrets.GITHUB_TOKEN }}\n590\t    59\t      - id: build\n591\t    60\t        uses: docker/build-push-action@4f58ea79222b3b9dc2c8bbdd6debcef730109a75 # v6.9.0\n592\t    61\t        with:\n593\t    62\t          context: .\n594\t    63\t          push: true\n595\t    64\t          tags: registry.example-corp.test/procurement/agent:${{ github.sha }}\n596\t    65\t          provenance: false\n597\t    66\t          sbom: false\n598\t    67\t      - name: SBOM\n599\t    68\t        uses: anchore/sbom-action@251a468eed47e5082b105c3ba6ee500c0e65a764 # v0.17.6\n600\t    69\t        with:\n601\t    70\t          image: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n602\t    71\t          format: cyclonedx-json\n603\t    72\t          output-file: sbom.cdx.json\n604\t    73\t      - name: Sign and attest\n605\t    74\t        env:\n606\t    75\t          IMAGE: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n607\t    76\t        run: |\n608\t    77\t          cosign sign --yes \"$IMAGE\"\n609\t    78\t          cosign attest --yes --type cyclonedx --predicate sbom.cdx.json \"$IMAGE\"\n610\t    79\t      - uses: actions/attest-build-provenance@1c608d11d69870c2092266b3f9a6f3abbf17002c # v1.4.3\n611\t    80\t        with:\n612\t    81\t          subject-name: registry.example-corp.test/procurement/agent\n613\t    82\t          subject-digest: ${{ steps.build.outputs.digest }}\n614\t    83\t          push-to-registry: true\n615\t     1\t# Release manifest for the procurement agent. Regenerated by CI on every\n616\t     2\t# release build (see .github/workflows/ci.yaml, job \"release\").\n617\t     3\trelease: \"procurement-agent 2026.09.4\"\n618\t     4\towner: team-procurement-platform\n619\t     5\t\n620\t     6\timage:\n621\t     7\t  repository: registry.example-corp.test/procurement/agent\n622\t     8\t  digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n623\t     9\t  sbom: \"registry.example-corp.test/procurement/agent:sha256-7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0.sbom\"\n624\t    10\t  signer:\n625\t    11\t    issuer: \"https://token.actions.githubusercontent.com\"\n626\t    12\t    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n627\t    13\t\n628\t    14\tharness:\n629\t    15\t  source_commit: \"3f9a1c7e2b8d4f6a0c5e9b1d7f3a8c2e6b4d0f91\"\n630\t    16\t  digest: \"sha256:5b2d8f1a9c3e7b0d4f6a2c8e1b5d9f3a7c0e4b8d2f6a1c5e9b3d7f0a4c8e2b6d\"\n631\t    17\t\n632\t    18\tprompts:\n633\t    19\t  system:\n634\t    20\t    path: prompts/system.md\n635\t    21\t    sha256: \"sha256:dcf69216667e65a0be3711d99aac81b707ba843296e7ce26d6fcbdb50c5bcc50\"\n636\t    22\t  extractor:\n637\t    23\t    path: prompts/extractor.md\n638\t    24\t    sha256: \"sha256:6ef6527b77ffcca8851e7a8760e6373f3daede15d5b343b878737f0deec28de3\"\n639\t    25\t\n640\t    26\tconfig:\n641\t    27\t  policy:\n642\t    28\t    path: config/policy.yaml\n643\t    29\t    version: \"proc-policy-2026.09.3\"\n644\t    30\t    sha256: \"sha256:d6a55f1e170bdd457958243ddd9aa938f4ca707a3e1e9d1e7bca2a54df33ad32\"\n645\t    31\t  tools:\n646\t    32\t    path: config/tools.yaml\n647\t    33\t    sha256: \"sha256:86dccc3d7d166bf8e131c3b2afbe5f2b846a57eaaf087b55f9e308844eda9400\"\n648\t    34\t  network_policy: deploy/k8s/networkpolicy.yaml\n649\t    35\t  image_policy: deploy/k8s/kyverno-verify-images.yaml\n650\t    36\t\n651\t    37\tmodels:\n652\t    38\t  primary:\n653\t    39\t    role: \"main agent\"\n654\t    40\t    owner: team-procurement-platform\n655\t    41\t    provider: anthropic\n656\t    42\t    model_id: \"claude-sonnet-4-5-20250929\"\n657\t    43\t    id_kind: \"pinned snapshot\"\n658\t    44\t    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n659\t    45\t    adapter: none\n660\t    46\t    fine_tune: none\n661\t    47\t    training_run: \"not applicable\"\n662\t    48\t    served_version: \"recorded per call from response.model\"\n663\t    49\t    provider_undisclosed: [weights digest, pretraining data version]\n664\t    50\t  extractor:\n665\t    51\t    role: \"line-item extraction sub-agent\"\n666\t    52\t    owner: team-procurement-platform\n667\t    53\t    provider: anthropic\n668\t    54\t    model_id: \"claude-haiku-4-5-20251001\"\n669\t    55\t    id_kind: \"pinned snapshot\"\n670\t    56\t    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n671\t    57\t    adapter: none\n672\t    58\t    fine_tune: none\n673\t    59\t    training_run: \"not applicable\"\n674\t    60\t    served_version: \"recorded per call from response.model\"\n675\t    61\t    provider_undisclosed: [weights digest, pretraining data version]\n676\t    62\t\n677\t    63\tmcp_servers:\n678\t    64\t  erp:\n679\t    65\t    endpoint: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n680\t    66\t    owner: team-erp-integrations\n681\t    67\t\n682\t    68\t# Fingerprints of the approved ERP MCP tools (name, description, inputSchema,\n683\t    69\t# annotations), computed by app.mcp_client.fingerprint.\n684\t    70\ttool_pins:\n685\t    71\t  budget.get_remaining: \"sha256:bc96af69ba1cfd67b5428269dc74aa3e754f4dfe2d5dfa81deb0af68819379ca\"\n686\t    72\t  vendor.get: \"sha256:7db5e65fb6d482d06985b19b7f1fce7422398b117bc7482f0380108cd6a6a1fe\"\n687\t    73\t  vendor.search: \"sha256:3bd5aa0908885e967ce8ee1aa22e37b4f4fba867c8eac2b4127bca626731092c\"\n688\t    74\t  vendor.update_remit_to: \"sha256:d3d3916ee6d742311c92f4972a1ffeb0f24782e729351f3e375f13eb05b94c1b\"\n689\t    75\t  invoice.get: \"sha256:848ece38456338a085cb7091a2bbf1024e07946d62beb32a9ee94d2fa2fa8876\"\n690\t    76\t  invoice.list_open: \"sha256:12bb2318f3876da6421183032cdd36727e545275e8eaf6fff66451d09371f12b\"\n691\t    77\t  invoice.mark_paid: \"sha256:3a208eb55ee3a39962316b5d25fe6ba23457380c01aa39a5469ce3691130b05a\"\n692\t    78\t  invoice.void: \"sha256:9645bec805f2ffdfa44f698f49e8701a6487afa3cb3e3c5c44e721cb21633d4c\"\n693\t    79\t  po.get: \"sha256:121df83a279fc2ae3764c83faeb34f3037026586991c9192144ad7b727d18d7b\"\n694\t    80\t  po.list_open: \"sha256:203c57fd158a8edf11b8dc02be534bc805d8caaf0959db8280f59ea0e5beb70a\"\n695\t    81\t  po.create: \"sha256:fb15c157f7d79321972b310d74ee6c88a0fc76fd8edbbe4e821dcaa95a0852c6\"\n696\t    82\t\n697\t    83\tbudgets: config/policy.yaml#budgets\n698\t    84\tidentity:\n699\t    85\t  service_account: procurement-agent\n700\t    86\t  spiffe_id: \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n701\t    87\t  sts_audiences: [erp-mcp-gateway, payments-api, slack-proxy]\n702\t    88\tmemory:\n703\t    89\t  store: \"postgres procurement.dept_notes\"\n704\t    90\t  expiry_unverified_days: 30\n705\t    91\tretrieval: none\n706\t"}]},"parent_tool_use_id":null,"session_id":"35779640-2a0a-46bf-9815-9ff2e081196b","uuid":"5548a996-911c-4c67-88a2-d6907a889d3f","timestamp":"2026-10-02T17:59:35.044Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-gvo4aj76/35779640-2a0a-46bf-9815-9ff2e081196b/tool-results/b4wo8upvm.txt","content":"    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n     1\tapiVersion: apps/v1\n     2\tkind: Deployment\n     3\tmetadata:\n     4\t  name: procurement-agent\n     5\t  namespace: procurement-prod\n     6\t  labels:\n     7\t    app: procurement-agent\n     8\t    owner: team-procurement-platform\n     9\tspec:\n    10\t  replicas: 3\n    11\t  selector:\n    12\t    matchLabels:\n    13\t      app: procurement-agent\n    14\t  template:\n    15\t    metadata:\n    16\t      labels:\n    17\t        app: procurement-agent\n    18\t    spec:\n    19\t      serviceAccountName: procurement-agent\n    20\t      automountServiceAccountToken: false\n    21\t      hostUsers: false\n    22\t      enableServiceLinks: false\n    23\t      securityContext:\n    24\t        runAsNonRoot: true\n    25\t        runAsUser: 65532\n    26\t        runAsGroup: 65532\n    27\t        fsGroup: 65532\n    28\t        seccompProfile:\n    29\t          type: RuntimeDefault\n    30\t      containers:\n    31\t        - name: agent\n    32\t          image: registry.example-corp.test/procurement/agent@sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\n    33\t          imagePullPolicy: IfNotPresent\n    34\t          ports:\n    35\t            - containerPort: 8080\n    36\t              name: http\n    37\t          env:\n    38\t            - name: IMAGE_DIGEST\n    39\t              value: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n    40\t            - name: MODEL_ID\n    41\t              value: \"claude-sonnet-4-5-20250929\"\n    42\t            - name: EXTRACTOR_MODEL_ID\n    43\t              value: \"claude-haiku-4-5-20251001\"\n    44\t            - name: DATABASE_URL\n    45\t              value: \"postgresql://procurement_agent@procurement-db.procurement-data.svc.cluster.local:5432/procurement?sslmode=verify-full\"\n    46\t            - name: ERP_MCP_URL\n    47\t              value: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    48\t            - name: PAYMENTS_API_URL\n    49\t              value: \"https://api.payments.example-pay.test\"\n    50\t            - name: SLACK_API_URL\n    51\t              value: \"https://slack-proxy.egress.svc.cluster.local:8443/api\"\n    52\t            - name: STS_URL\n    53\t              value: \"https://sts.identity.svc.cluster.local/oauth2/token\"\n    54\t            - name: OIDC_ISSUER\n    55\t              value: \"https://login.example-corp.test\"\n    56\t            - name: OIDC_JWKS_URL\n    57\t              value: \"https://login.example-corp.test/.well-known/jwks.json\"\n    58\t            - name: HTTPS_PROXY\n    59\t              value: \"http://egress-proxy.egress.svc.cluster.local:3128\"\n    60\t            - name: NO_PROXY\n    61\t              value: \".svc.cluster.local\"\n    62\t            - name: OTEL_EXPORTER_OTLP_ENDPOINT\n    63\t              value: \"http://otel-collector.observability.svc.cluster.local:4317\"\n    64\t            - name: OTEL_SERVICE_NAME\n    65\t              value: \"procurement-agent\"\n    66\t            - name: OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT\n    67\t              value: \"false\"\n    68\t          securityContext:\n    69\t            allowPrivilegeEscalation: false\n    70\t            privileged: false\n    71\t            readOnlyRootFilesystem: true\n    72\t            runAsNonRoot: true\n    73\t            capabilities:\n    74\t              drop: [\"ALL\"]\n    75\t            seccompProfile:\n    76\t              type: RuntimeDefault\n    77\t          resources:\n    78\t            requests:\n    79\t              cpu: 250m\n    80\t              memory: 512Mi\n    81\t            limits:\n    82\t              cpu: \"1\"\n    83\t              memory: 1Gi\n    84\t          readinessProbe:\n    85\t            httpGet:\n    86\t              path: /healthz\n    87\t              port: http\n    88\t          volumeMounts:\n    89\t            - name: workload-token\n    90\t              mountPath: /var/run/secrets/tokens\n    91\t              readOnly: true\n    92\t            - name: slack-signing\n    93\t              mountPath: /var/run/secrets/slack\n    94\t              readOnly: true\n    95\t            - name: mail-hmac\n    96\t              mountPath: /var/run/secrets/mail\n    97\t              readOnly: true\n    98\t            - name: tmp\n    99\t              mountPath: /tmp\n   100\t      volumes:\n   101\t        - name: workload-token\n   102\t          projected:\n   103\t            sources:\n   104\t              - serviceAccountToken:\n   105\t                  path: procurement-agent\n   106\t                  audience: sts.identity.example-corp.test\n   107\t                  expirationSeconds: 600\n   108\t        - name: slack-signing\n   109\t          secret:\n   110\t            secretName: procurement-slack-signing\n   111\t        - name: mail-hmac\n   112\t          secret:\n   113\t            secretName: procurement-mail-gateway-hmac\n   114\t        - name: tmp\n   115\t          emptyDir:\n   116\t            medium: Memory\n   117\t            sizeLimit: 64Mi\n     1\tapiVersion: kyverno.io/v1\n     2\tkind: ClusterPolicy\n     3\tmetadata:\n     4\t  name: procurement-verify-images\n     5\t  annotations:\n     6\t    policies.kyverno.io/title: Verify procurement agent images\n     7\t    kyverno.io/kyverno-version: \"1.15.2\"\n     8\tspec:\n     9\t  validationFailureAction: Enforce\n    10\t  background: false\n    11\t  webhookTimeoutSeconds: 15\n    12\t  failurePolicy: Fail\n    13\t  rules:\n    14\t    - name: only-approved-registry\n    15\t      match:\n    16\t        any:\n    17\t          - resources:\n    18\t              kinds: [Pod]\n    19\t              namespaces: [procurement-prod]\n    20\t      validate:\n    21\t        message: \"Images in procurement-prod must come from registry.example-corp.test/procurement and be pinned by digest.\"\n    22\t        pattern:\n    23\t          spec:\n    24\t            =(initContainers):\n    25\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n    26\t            containers:\n    27\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n    28\t    - name: verify-signature-and-provenance\n    29\t      match:\n    30\t        any:\n    31\t          - resources:\n    32\t              kinds: [Pod]\n    33\t              namespaces: [procurement-prod]\n    34\t      verifyImages:\n    35\t        - imageReferences:\n    36\t            - \"registry.example-corp.test/procurement/*\"\n    37\t          mutateDigest: false\n    38\t          verifyDigest: true\n    39\t          required: true\n    40\t          attestors:\n    41\t            - entries:\n    42\t                - keyless:\n    43\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    44\t                    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    45\t                    rekor:\n    46\t                      url: https://rekor.sigstore.dev\n    47\t          attestations:\n    48\t            - type: https://slsa.dev/provenance/v1\n    49\t              attestors:\n    50\t                - entries:\n    51\t                    - keyless:\n    52\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    53\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    54\t              conditions:\n    55\t                - all:\n    56\t                    - key: \"{{ buildDefinition.buildType }}\"\n    57\t                      operator: Equals\n    58\t                      value: \"https://actions.github.io/buildtypes/workflow/v1\"\n    59\t                    - key: \"{{ buildDefinition.externalParameters.workflow.repository }}\"\n    60\t                      operator: Equals\n    61\t                      value: \"https://github.com/example-corp/procurement-agent\"\n    62\t                    - key: \"{{ buildDefinition.externalParameters.workflow.ref }}\"\n    63\t                      operator: Equals\n    64\t                      value: \"refs/heads/main\"\n    65\t                    - key: \"{{ buildDefinition.externalParameters.workflow.path }}\"\n    66\t                      operator: Equals\n    67\t                      value: \".github/workflows/ci.yaml\"\n    68\t                    - key: \"{{ runDetails.builder.id }}\"\n    69\t                      operator: Equals\n    70\t                      value: \"https://github.com/actions/runner/github-hosted\"\n    71\t            - type: https://cyclonedx.org/bom\n    72\t              attestors:\n    73\t                - entries:\n    74\t                    - keyless:\n    75\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    76\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n     1\tapiVersion: networking.k8s.io/v1\n     2\tkind: NetworkPolicy\n     3\tmetadata:\n     4\t  name: procurement-agent-default-deny\n     5\t  namespace: procurement-prod\n     6\tspec:\n     7\t  podSelector: {}\n     8\t  policyTypes: [\"Ingress\", \"Egress\"]\n     9\t---\n    10\tapiVersion: networking.k8s.io/v1\n    11\tkind: NetworkPolicy\n    12\tmetadata:\n    13\t  name: procurement-agent-egress\n    14\t  namespace: procurement-prod\n    15\tspec:\n    16\t  podSelector:\n    17\t    matchLabels:\n    18\t      app: procurement-agent\n    19\t  policyTypes: [\"Egress\"]\n    20\t  egress:\n    21\t    - to:\n    22\t        - namespaceSelector:\n    23\t            matchLabels:\n    24\t              kubernetes.io/metadata.name: kube-system\n    25\t          podSelector:\n    26\t            matchLabels:\n    27\t              k8s-app: kube-dns\n    28\t      ports:\n    29\t        - { protocol: UDP, port: 53 }\n    30\t        - { protocol: TCP, port: 53 }\n    31\t    - to:\n    32\t        - namespaceSelector:\n    33\t            matchLabels:\n    34\t              kubernetes.io/metadata.name: egress\n    35\t          podSelector:\n    36\t            matchLabels:\n    37\t              app: egress-proxy\n    38\t      ports:\n    39\t        - { protocol: TCP, port: 3128 }\n    40\t    - to:\n    41\t        - namespaceSelector:\n    42\t            matchLabels:\n    43\t              kubernetes.io/metadata.name: egress\n    44\t          podSelector:\n    45\t            matchLabels:\n    46\t              app: slack-proxy\n    47\t      ports:\n    48\t        - { protocol: TCP, port: 8443 }\n    49\t    - to:\n    50\t        - namespaceSelector:\n    51\t            matchLabels:\n    52\t              kubernetes.io/metadata.name: procurement-data\n    53\t          podSelector:\n    54\t            matchLabels:\n    55\t              app: procurement-db\n    56\t      ports:\n    57\t        - { protocol: TCP, port: 5432 }\n    58\t    - to:\n    59\t        - namespaceSelector:\n    60\t            matchLabels:\n    61\t              kubernetes.io/metadata.name: erp-mcp-gateway\n    62\t      ports:\n    63\t        - { protocol: TCP, port: 8443 }\n    64\t    - to:\n    65\t        - namespaceSelector:\n    66\t            matchLabels:\n    67\t              kubernetes.io/metadata.name: identity\n    68\t          podSelector:\n    69\t            matchLabels:\n    70\t              app: sts\n    71\t      ports:\n    72\t        - { protocol: TCP, port: 443 }\n    73\t    - to:\n    74\t        - ipBlock:\n    75\t            cidr: 0.0.0.0/0\n    76\t            except:\n    77\t              - 10.0.0.0/8\n    78\t              - 172.16.0.0/12\n    79\t              - 192.168.0.0/16\n    80\t              - 169.254.0.0/16\n    81\t      ports:\n    82\t        - { protocol: TCP, port: 443 }\n    83\t---\n    84\tapiVersion: networking.k8s.io/v1\n    85\tkind: NetworkPolicy\n    86\tmetadata:\n    87\t  name: procurement-agent-ingress\n    88\t  namespace: procurement-prod\n    89\tspec:\n    90\t  podSelector:\n    91\t    matchLabels:\n    92\t      app: procurement-agent\n    93\t  policyTypes: [\"Ingress\"]\n    94\t  ingress:\n    95\t    - from:\n    96\t        - namespaceSelector:\n    97\t            matchLabels:\n    98\t              kubernetes.io/metadata.name: ingress\n    99\t      ports:\n   100\t        - { protocol: TCP, port: 8080 }\n   101\t---\n   102\t# Egress proxy allowlist (applied in the egress namespace by the platform team).\n   103\tapiVersion: v1\n   104\tkind: ConfigMap\n   105\tmetadata:\n   106\t  name: egress-proxy-allowlist-procurement\n   107\t  namespace: egress\n   108\tdata:\n   109\t  allowlist.txt: |\n   110\t    api.anthropic.com\n   111\t    api.payments.example-pay.test\n   112\t    login.example-corp.test\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: procurement-prod\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: latest\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: procurement-agent\n    15\t  namespace: procurement-prod\n    16\t  labels:\n    17\t    app: procurement-agent\n    18\tautomountServiceAccountToken: false\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.11.10-slim-bookworm@sha256:2a6386ad2db20e7f55073f69a98d6da2cf9f168e05e7487d2670c22e4ad2a1bd AS build\n     3\tWORKDIR /src\n     4\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     5\tCOPY pyproject.toml ./\n     6\tCOPY app ./app\n     7\tRUN pip install --target /opt/site .\n     8\tRUN python -m compileall -q app\n     9\t\n    10\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:8f3c1a6e2b9d4f7a0c5e8b1d3f6a9c2e5b8d1f4a7c0e3b6d9f2a5c8e1b4d7f0a\n    11\tWORKDIR /app\n    12\tENV PYTHONPATH=/opt/site:/app \\\n    13\t    PYTHONDONTWRITEBYTECODE=1 \\\n    14\t    APP_ROOT=/app\n    15\tCOPY --from=build /opt/site /opt/site\n    16\tCOPY --from=build /src/app /app/app\n    17\tCOPY prompts /app/prompts\n    18\tCOPY config /app/config\n    19\tCOPY release/manifest.yaml /app/release/manifest.yaml\n    20\tUSER 65532:65532\n    21\tEXPOSE 8080\n    22\tENTRYPOINT [\"python\", \"-m\", \"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\", \"--no-server-header\"]\n     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    16\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    17\t        with:\n    18\t          python-version: \"3.11\"\n    19\t      - run: pip install -e '.[test]'\n    20\t      - run: pytest -q\n    21\t      - name: Secret scan\n    22\t        uses: gitleaks/gitleaks-action@83373cf2f8c4db6e24b41c1a9b086bb9619e9cd3 # v2.3.7\n    23\t      - name: Manifest hashes match files\n    24\t        run: |\n    25\t          python - <<'PY'\n    26\t          import hashlib, yaml, sys\n    27\t          m = yaml.safe_load(open(\"release/manifest.yaml\"))\n    28\t          bad = []\n    29\t          for group in (\"prompts\", \"config\"):\n    30\t              for name, e in m[group].items():\n    31\t                  if isinstance(e, dict) and \"sha256\" in e:\n    32\t                      got = \"sha256:\" + hashlib.sha256(open(e[\"path\"], \"rb\").read()).hexdigest()\n    33\t                      if got != e[\"sha256\"]:\n    34\t                          bad.append(e[\"path\"])\n    35\t          if bad:\n    36\t              sys.exit(\"manifest out of date: \" + \", \".join(bad))\n    37\t          PY\n    38\t\n    39\t  release:\n    40\t    if: github.ref == 'refs/heads/main'\n    41\t    needs: test\n    42\t    runs-on: ubuntu-24.04\n    43\t    permissions:\n    44\t      contents: read\n    45\t      id-token: write\n    46\t      packages: write\n    47\t      attestations: write\n    48\t    steps:\n    49\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    50\t      - uses: sigstore/cosign-installer@dc72c7d5c4d10cd6bcb8cf6e3fd625a9e5e537da # v3.7.0\n    51\t        with:\n    52\t          cosign-release: \"v2.6.2\"\n    53\t      - uses: docker/setup-buildx-action@c47758b77c9736f4b2ef4073d4d51994fabfe349 # v3.7.1\n    54\t      - uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0\n    55\t        with:\n    56\t          registry: registry.example-corp.test\n    57\t          username: ${{ github.actor }}\n    58\t          password: ${{ secrets.GITHUB_TOKEN }}\n    59\t      - id: build\n    60\t        uses: docker/build-push-action@4f58ea79222b3b9dc2c8bbdd6debcef730109a75 # v6.9.0\n    61\t        with:\n    62\t          context: .\n    63\t          push: true\n    64\t          tags: registry.example-corp.test/procurement/agent:${{ github.sha }}\n    65\t          provenance: false\n    66\t          sbom: false\n    67\t      - name: SBOM\n    68\t        uses: anchore/sbom-action@251a468eed47e5082b105c3ba6ee500c0e65a764 # v0.17.6\n    69\t        with:\n    70\t          image: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    71\t          format: cyclonedx-json\n    72\t          output-file: sbom.cdx.json\n    73\t      - name: Sign and attest\n    74\t        env:\n    75\t          IMAGE: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    76\t        run: |\n    77\t          cosign sign --yes \"$IMAGE\"\n    78\t          cosign attest --yes --type cyclonedx --predicate sbom.cdx.json \"$IMAGE\"\n    79\t      - uses: actions/attest-build-provenance@1c608d11d69870c2092266b3f9a6f3abbf17002c # v1.4.3\n    80\t        with:\n    81\t          subject-name: registry.example-corp.test/procurement/agent\n    82\t          subject-digest: ${{ steps.build.outputs.digest }}\n    83\t          push-to-registry: true\n     1\t# Release manifest for the procurement agent. Regenerated by CI on every\n     2\t# release build (see .github/workflows/ci.yaml, job \"release\").\n     3\trelease: \"procurement-agent 2026.09.4\"\n     4\towner: team-procurement-platform\n     5\t\n     6\timage:\n     7\t  repository: registry.example-corp.test/procurement/agent\n     8\t  digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n     9\t  sbom: \"registry.example-corp.test/procurement/agent:sha256-7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0.sbom\"\n    10\t  signer:\n    11\t    issuer: \"https://token.actions.githubusercontent.com\"\n    12\t    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    13\t\n    14\tharness:\n    15\t  source_commit: \"3f9a1c7e2b8d4f6a0c5e9b1d7f3a8c2e6b4d0f91\"\n    16\t  digest: \"sha256:5b2d8f1a9c3e7b0d4f6a2c8e1b5d9f3a7c0e4b8d2f6a1c5e9b3d7f0a4c8e2b6d\"\n    17\t\n    18\tprompts:\n    19\t  system:\n    20\t    path: prompts/system.md\n    21\t    sha256: \"sha256:dcf69216667e65a0be3711d99aac81b707ba843296e7ce26d6fcbdb50c5bcc50\"\n    22\t  extractor:\n    23\t    path: prompts/extractor.md\n    24\t    sha256: \"sha256:6ef6527b77ffcca8851e7a8760e6373f3daede15d5b343b878737f0deec28de3\"\n    25\t\n    26\tconfig:\n    27\t  policy:\n    28\t    path: config/policy.yaml\n    29\t    version: \"proc-policy-2026.09.3\"\n    30\t    sha256: \"sha256:d6a55f1e170bdd457958243ddd9aa938f4ca707a3e1e9d1e7bca2a54df33ad32\"\n    31\t  tools:\n    32\t    path: config/tools.yaml\n    33\t    sha256: \"sha256:86dccc3d7d166bf8e131c3b2afbe5f2b846a57eaaf087b55f9e308844eda9400\"\n    34\t  network_policy: deploy/k8s/networkpolicy.yaml\n    35\t  image_policy: deploy/k8s/kyverno-verify-images.yaml\n    36\t\n    37\tmodels:\n    38\t  primary:\n    39\t    role: \"main agent\"\n    40\t    owner: team-procurement-platform\n    41\t    provider: anthropic\n    42\t    model_id: \"claude-sonnet-4-5-20250929\"\n    43\t    id_kind: \"pinned snapshot\"\n    44\t    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    45\t    adapter: none\n    46\t    fine_tune: none\n    47\t    training_run: \"not applicable\"\n    48\t    served_version: \"recorded per call from response.model\"\n    49\t    provider_undisclosed: [weights digest, pretraining data version]\n    50\t  extractor:\n    51\t    role: \"line-item extraction sub-agent\"\n    52\t    owner: team-procurement-platform\n    53\t    provider: anthropic\n    54\t    model_id: \"claude-haiku-4-5-20251001\"\n    55\t    id_kind: \"pinned snapshot\"\n    56\t    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    57\t    adapter: none\n    58\t    fine_tune: none\n    59\t    training_run: \"not applicable\"\n    60\t    served_version: \"recorded per call from response.model\"\n    61\t    provider_undisclosed: [weights digest, pretraining data version]\n    62\t\n    63\tmcp_servers:\n    64\t  erp:\n    65\t    endpoint: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    66\t    owner: team-erp-integrations\n    67\t\n    68\t# Fingerprints of the approved ERP MCP tools (name, description, inputSchema,\n    69\t# annotations), computed by app.mcp_client.fingerprint.\n    70\ttool_pins:\n    71\t  budget.get_remaining: \"sha256:bc96af69ba1cfd67b5428269dc74aa3e754f4dfe2d5dfa81deb0af68819379ca\"\n    72\t  vendor.get: \"sha256:7db5e65fb6d482d06985b19b7f1fce7422398b117bc7482f0380108cd6a6a1fe\"\n    73\t  vendor.search: \"sha256:3bd5aa0908885e967ce8ee1aa22e37b4f4fba867c8eac2b4127bca626731092c\"\n    74\t  vendor.update_remit_to: \"sha256:d3d3916ee6d742311c92f4972a1ffeb0f24782e729351f3e375f13eb05b94c1b\"\n    75\t  invoice.get: \"sha256:848ece38456338a085cb7091a2bbf1024e07946d62beb32a9ee94d2fa2fa8876\"\n    76\t  invoice.list_open: \"sha256:12bb2318f3876da6421183032cdd36727e545275e8eaf6fff66451d09371f12b\"\n    77\t  invoice.mark_paid: \"sha256:3a208eb55ee3a39962316b5d25fe6ba23457380c01aa39a5469ce3691130b05a\"\n    78\t  invoice.void: \"sha256:9645bec805f2ffdfa44f698f49e8701a6487afa3cb3e3c5c44e721cb21633d4c\"\n    79\t  po.get: \"sha256:121df83a279fc2ae3764c83faeb34f3037026586991c9192144ad7b727d18d7b\"\n    80\t  po.list_open: \"sha256:203c57fd158a8edf11b8dc02be534bc805d8caaf0959db8280f59ea0e5beb70a\"\n    81\t  po.create: \"sha256:fb15c157f7d79321972b310d74ee6c88a0fc76fd8edbbe4e821dcaa95a0852c6\"\n    82\t\n    83\tbudgets: config/policy.yaml#budgets\n    84\tidentity:\n    85\t  service_account: procurement-agent\n    86\t  spiffe_id: \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    87\t  sts_audiences: [erp-mcp-gateway, payments-api, slack-proxy]\n    88\tmemory:\n    89\t  store: \"postgres procurement.dept_notes\"\n    90\t  expiry_unverified_days: 30\n    91\tretrieval: none\n","numLines":657,"startLine":50,"totalLines":706}}}
