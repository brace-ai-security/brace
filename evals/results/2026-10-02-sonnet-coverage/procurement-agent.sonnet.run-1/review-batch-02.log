e\": \"app/loop.py:176\",\n   \"quote\": \"await audit.record(\"\n  },\n  {\n   \"id\": \"Icbe3633cb6\",\n   \"kind\": \"audit_write\",\n   \"evidence\": \"app/loop.py:55\",\n   \"quote\": \"proposed = await audit.record(\"\n  },\n  {\n   \"id\": \"I4db5797679\",\n   \"kind\": \"audit_write\",\n   \"evidence\": \"app/loop.py:61\",\n   \"quote\": \"await audit.record(\"\n  },\n  {\n   \"id\": \"Ia389c28cba\",\n   \"kind\": \"audit_write\",\n   \"evidence\": \"app/loop.py:68\",\n   \"quote\": \"authz = await audit.record(\"\n  },\n  {\n   \"id\": \"I8165b2309f\",\n   \"kind\": \"tool_call\",\n   \"evidence\": \"app/loop.py:83\",\n   \"quote\": \"output = await tool.invoke(use.input, ident)\"\n  },\n  {\n   \"id\": \"I588419ff8b\",\n   \"kind\": \"audit_write\",\n   \"evidence\": \"app/loop.py:87\",\n   \"quote\": \"await audit.record(\"\n  },\n  {\n   \"id\": \"I12a6ffed84\",\n   \"kind\": \"audit_write\",\n   \"evidence\": \"app/loop.py:95\",\n   \"quote\": \"await audit.record(\"\n  },\n  {\n   \"id\": \"Iffaa43b340\",\n   \"kind\": \"audit_write\",\n   \"evidence\": \"app/main.py:76\",\n   \"quote\": \"await audit.record(app.state.pool, ident, kind=\\\"background_job\\\",\"\n  }\n ],\n \"skipped\": [],\n \"limitations\": \"Candidate inventory only: manually trace aliases, wrappers, computed calls and unsupported languages. Tests excluded; no code executed.\"\n}\n\"\"\"Approval requests and decisions for high-impact operations.\n\nRequests are posted to the business unit's approvals channel in Slack with\nthe full argument summary. Approvers decide with the Slack buttons; the\ninteractive callback is signature-checked in main.py and then calls\n``decide``. Approver authority is checked against the role map in policy.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport uuid\nfrom dataclasses import dataclass\nfrom datetime import datetime, timedelta, timezone\nfrom typing import Any\n\nfrom app.audit import digest, summarize_args\nfrom app.identity import RunIdentity\n\n\n@dataclass(frozen=True)\nclass Approval:\n    id: str\n    approver: str\n    approver_role: str\n    expires_at: datetime\n\n\nclass ApproverNotAuthorized(Exception):\n    pass\n\n\nclass ApprovalStore:\n    def __init__(self, pool, policy: dict, notifier):\n        self.pool = pool\n        self.ttl = timedelta(minutes=int(policy[\"approvals\"][\"ttl_minutes\"]))\n        self.approver_roles: dict[str, list[str]] = policy[\"approvals\"][\"approver_roles\"]\n        self.notifier = notifier\n\n    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n        approval_id = f\"apr-{uuid.uuid4()}\"\n        expires_at = datetime.now(timezone.utc) + self.ttl\n        await self.pool.execute(\n            \"\"\"\n            INSERT INTO approvals (\n                id, tool, target, args_sha256, args_summary, tenant,\n                requested_by_instance, requested_by_run, delegated_subject,\n                status, requested_at, expires_at\n            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)\n            \"\"\",\n            approval_id,\n            tool,\n            target,\n            digest(args),\n            json.dumps(summarize_args(args)),\n            ident.tenant,\n            ident.agent_instance_id,\n            ident.run_id,\n            ident.delegated_subject,\n            expires_at,\n        )\n        await self.notifier.post_approval_request(\n            tenant=ident.tenant,\n            approval_id=approval_id,\n            tool=tool,\n            target=target,\n            summary=summarize_args(args),\n            expires_at=expires_at,\n        )\n        return approval_id\n\n    async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:\n        row = await self.pool.fetchrow(\n            \"\"\"\n            SELECT id, approver, approver_role, expires_at\n            FROM approvals\n            WHERE tool = $1\n              AND target = $2\n              AND tenant = $3\n              AND status = 'approved'\n              AND expires_at > now()\n            ORDER BY decided_at DESC\n            LIMIT 1\n            \"\"\",\n            tool,\n            target,\n            ident.tenant,\n        )\n        if row is None:\n            return None\n        if row[\"approver_role\"] not in self.approver_roles.get(tool, []):\n            return None\n        return Approval(row[\"id\"], row[\"approver\"], row[\"approver_role\"], row[\"expires_at\"])\n\n    async def decide(self, approval_id: str, approver: str, approver_role: str, approve: bool) -> None:\n        row = await self.pool.fetchrow(\n            \"SELECT tool, status, expires_at FROM approvals WHERE id = $1\", approval_id\n        )\n        if row is None or row[\"status\"] != \"pending\":\n            raise ValueError(\"approval is not pending\")\n        if row[\"expires_at\"] <= datetime.now(timezone.utc):\n            raise ValueError(\"approval request expired\")\n        if approver_role not in self.approver_roles.get(row[\"tool\"], []):\n            raise ApproverNotAuthorized(f\"{approver_role} cannot approve {row['tool']}\")\n        await self.pool.execute(\n            \"\"\"\n            UPDATE approvals\n            SET status = $2, approver = $3, approver_role = $4, decided_at = now()\n            WHERE id = $1 AND status = 'pending'\n            \"\"\",\n            approval_id,\n            \"approved\" if approve else \"rejected\",\n            approver,\n            approver_role,\n        )\n\"\"\"Policy gate for tool calls.\n\nRuns in the harness between the model's proposed call and the integration.\nHigh-impact operations are denied unless a valid approval exists; when none\nexists an approval request is opened and the call returns as pending.\n\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import Any\n\nfrom app.approvals import ApprovalStore\nfrom app.identity import RunIdentity\n\n\n@dataclass(frozen=True)\nclass Decision:\n    allow: bool\n    reason: str\n    policy_version: str\n    approval_id: str | None = None\n    pending: bool = False\n\n\nclass PolicyGate:\n    def __init__(self, policy: dict, approvals: ApprovalStore):\n        self.version: str = policy[\"version\"]\n        self.high_impact: frozenset[str] = frozenset(policy[\"high_impact_tools\"])\n        self.erp_read_prefixes: tuple[str, ...] = tuple(policy[\"erp\"][\"read_prefixes\"])\n        self.approvals = approvals\n\n    async def authorize(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n        if tool.name == \"erp_call\":\n            operation = str(args.get(\"operation\", \"\"))\n            if not operation.startswith(self.erp_read_prefixes):\n                return Decision(False, f\"erp operation not permitted: {operation}\", self.version)\n            return Decision(True, \"erp read operation\", self.version)\n\n        if tool.name == \"post_slack_message\":\n            if args.get(\"external\", False):\n                return await self._require_approval(ident, tool, args)\n            return Decision(True, \"internal staff message\", self.version)\n\n        if tool.name in self.high_impact:\n            return await self._require_approval(ident, tool, args)\n\n        return Decision(True, \"low-impact tool\", self.version)\n\n    async def _require_approval(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n        target = tool.target_of(args)\n        approval = await self.approvals.find_valid(ident, tool.name, target)\n        if approval is not None:\n            return Decision(True, \"approved\", self.version, approval_id=approval.id)\n        approval_id = await self.approvals.request(ident, tool.name, target, args)\n        return Decision(\n            False,\n            \"approval required; request opened\",\n            self.version,\n            approval_id=approval_id,\n            pending=True,\n        )\n\"\"\"Hard execution budgets, enforced by the harness and not by the model.\n\nPer run: step count, wall-clock time, tokens, cost, tool-call rate, and\nnumber of sub-agents. Sub-agents charge the parent's budget, so a child\ncannot widen what the parent was given.\n\nAcross runs: daily spend and per-minute run starts per user, per tenant\n(business unit), and for the whole fleet. Quotas are reserved in Postgres\ninside one transaction, so concurrent runs cannot overshoot them.\n\"\"\"\nfrom __future__ import annotations\n\nimport time\nfrom collections import deque\nfrom dataclasses import dataclass, field\nfrom decimal import Decimal\n\nfrom app.identity import RunIdentity\n\n\nclass BudgetExceeded(Exception):\n    def __init__(self, limit: str, used, allowed):\n        super().__init__(f\"{limit} exceeded: used={used} allowed={allowed}\")\n        self.limit = limit\n        self.used = used\n        self.allowed = allowed\n\n\n# USD per million tokens, from the provider price sheet referenced in the manifest.\nPRICES = {\n    \"claude-sonnet-4-5-20250929\": (Decimal(\"3.00\"), Decimal(\"15.00\")),\n    \"claude-haiku-4-5-20251001\": (Decimal(\"1.00\"), Decimal(\"5.00\")),\n}\n\n\n@dataclass\nclass Budget:\n    ident: RunIdentity\n    max_steps: int\n    max_wall_seconds: float\n    max_tokens: int\n    max_cost_usd: Decimal\n    max_tool_calls_per_minute: int\n    max_subagents: int\n    quotas_daily_usd: dict[str, Decimal]\n    run_starts_per_minute: dict[str, int]\n    started_at: float = field(default_factory=time.monotonic)\n    steps: int = 0\n    tokens: int = 0\n    cost_usd: Decimal = Decimal(\"0\")\n    unflushed_cost_usd: Decimal = Decimal(\"0\")\n    subagents: int = 0\n    _tool_calls: deque = field(default_factory=deque)\n\n    @classmethod\n    def for_run(cls, cfg: dict, ident: RunIdentity) -> \"Budget\":\n        run = cfg[\"per_run\"]\n        return cls(\n            ident=ident,\n            max_steps=int(run[\"max_steps\"]),\n            max_wall_seconds=float(run[\"max_wall_seconds\"]),\n            max_tokens=int(run[\"max_tokens\"]),\n            max_cost_usd=Decimal(str(run[\"max_cost_usd\"])),\n            max_tool_calls_per_minute=int(run[\"max_tool_calls_per_minute\"]),\n            max_subagents=int(run[\"max_subagents\"]),\n            quotas_daily_usd={k: Decimal(str(v)) for k, v in cfg[\"quotas_daily_usd\"].items()},\n            run_starts_per_minute={k: int(v) for k, v in cfg[\"run_starts_per_minute\"].items()},\n        )\n\n    def _scopes(self) -> list[tuple[str, str]]:\n        return [\n            (\"user\", self.ident.accountable_party),\n            (\"tenant\", self.ident.tenant),\n            (\"fleet\", \"all\"),\n        ]\n\n    # --- per-run limits -------------------------------------------------\n\n    def check_step(self) -> None:\n        self.steps += 1\n        if self.steps > self.max_steps:\n            raise BudgetExceeded(\"max_steps\", self.steps, self.max_steps)\n        elapsed = time.monotonic() - self.started_at\n        if elapsed > self.max_wall_seconds:\n            raise BudgetExceeded(\"max_wall_seconds\", round(elapsed, 1), self.max_wall_seconds)\n\n    def charge_model(self, model: str, usage) -> None:\n        price_in, price_out = PRICES[model]\n        tokens_in = (\n            int(usage.input_tokens or 0)\n            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n        )\n        tokens_out = int(usage.output_tokens or 0)\n        self.tokens += tokens_in + tokens_out\n        cost = (price_in * tokens_in + price_out * tokens_out) / Decimal(1_000_000)\n        self.cost_usd += cost\n        self.unflushed_cost_usd += cost\n        if self.tokens > self.max_tokens:\n            raise BudgetExceeded(\"max_tokens\", self.tokens, self.max_tokens)\n        if self.cost_usd > self.max_cost_usd:\n            raise BudgetExceeded(\"max_cost_usd\", self.cost_usd, self.max_cost_usd)\n\n    def check_tool_call(self, now: float | None = None) -> None:\n        now = time.monotonic() if now is None else now\n        while self._tool_calls and now - self._tool_calls[0] > 60:\n            self._tool_calls.popleft()\n        if len(self._tool_calls) >= self.max_tool_calls_per_minute:\n            raise BudgetExceeded(\n                \"max_tool_calls_per_minute\", len(self._tool_calls) + 1, self.max_tool_calls_per_minute\n            )\n        self._tool_calls.append(now)\n\n    def check_subagent(self) -> None:\n        if self.subagents >= self.max_subagents:\n            raise BudgetExceeded(\"max_subagents\", self.subagents + 1, self.max_subagents)\n        self.subagents += 1\n\n    # --- cross-run quotas -----------------------------------------------\n\n    async def reserve_run_start(self, pool) -> None:\n        async with pool.acquire() as conn:\n            async with conn.transaction():\n                for scope, key in self._scopes():\n                    limit = self.run_starts_per_minute[scope]\n                    count = await conn.fetchval(\n                        \"\"\"\n                        INSERT INTO run_start_window (scope, key, minute, starts)\n                        VALUES ($1, $2, date_trunc('minute', now()), 1)\n                        ON CONFLICT (scope, key, minute)\n                        DO UPDATE SET starts = run_start_window.starts + 1\n                        RETURNING starts\n                        \"\"\",\n                        scope,\n                        key,\n                    )\n                    if count > limit:\n                        raise BudgetExceeded(f\"run_starts_per_minute.{scope}\", count, limit)\n\n    async def flush(self, pool) -> None:\n        \"\"\"Add this run's unflushed spend to the daily quotas, or stop the run.\"\"\"\n        if self.unflushed_cost_usd <= 0:\n            return\n        amount = self.unflushed_cost_usd\n        async with pool.acquire() as conn:\n            async with conn.transaction():\n                for scope, key in self._scopes():\n                    limit = self.quotas_daily_usd[scope]\n                    spent = await conn.fetchval(\n                        \"\"\"\n                        INSERT INTO spend_quota (scope, key, day, spent_usd)\n                        VALUES ($1, $2, current_date, $3)\n                        ON CONFLICT (scope, key, day)\n                        DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd\n                        RETURNING spent_usd\n                        \"\"\",\n                        scope,\n                        key,\n                        amount,\n                    )\n                    if spent > limit:\n                        raise BudgetExceeded(f\"quota_daily_usd.{scope}\", spent, limit)\n        self.unflushed_cost_usd = Decimal(\"0\")","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
