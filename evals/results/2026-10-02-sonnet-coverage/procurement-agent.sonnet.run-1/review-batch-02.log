30 > time.time():\n            return cached.value\n        async with httpx.AsyncClient(timeout=5.0) as client:\n            resp = await client.post(\n                self.settings.sts_url,\n                data={\n                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n                    \"subject_token\": self._workload_token(),\n                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n                    \"audience\": audience,\n                    \"scope\": scope,\n                    \"resource\": f\"urn:bu:{ident.tenant}\",\n                    \"actor_token\": ident.delegated_subject,\n                    \"actor_token_type\": \"urn:example:params:subject-id\",\n    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:\n        payload: dict[str, Any] = {\n            \"channel\": channel,\n            \"text\": clean_outbound(text),\n            \"unfurl_links\": False,\n            \"unfurl_media\": False,\n            \"mrkdwn\": True,\n        }\n        if blocks:\n            payload[\"blocks\"] = blocks\n        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:\n            resp = await client.post(\n                f\"{self.api_url}/chat.postMessage\",\n                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\n                json=payload,\n            )\n        resp.raise_for_status()\n        body = resp.json()\n        if not body.get(\"ok\"):\n            raise RuntimeError(f\"slack error: {body.get('error')}\")\n        return {\"channel\": body[\"channel\"], \"ts\": body[\"ts\"]}\n\n    async def post_approval_request(\n        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\n    ) -> None:\n        lines = \"\\n\".join(f\"• *{k}*: `{v}`\" for k, v in summary.items())\nusage: answer.py [-h] [--repo REPO] [--met {yes,no,unknown}]\n                 [--evidence EVIDENCE] [--quote QUOTE] [--counter COUNTER]\n                 [--note NOTE]\n                 [--rating {likely_pass,gap,needs_evidence,na_candidate}]\n                 [--confidence {high,medium,low}] [--summary SUMMARY]\n                 [--next NEXT_STEP] [--violates VIOLATES]\n                 [--also-affects ALSO_AFFECTS]\n                 [--verdict {confirmed,dismissed}] [--item ITEM]\n                 [--reason REASON]\n                 findings {check,flag,item,prescan,next} [target]\n\nWrite one answer into a findings file, check it, and show what's next.\n\nUse this instead of editing the JSON by hand.\n\n  Answer a check:\n    python answer.py FINDINGS.json check B05.2 --met no --evidence src/x.py:41 \\\n        --quote \"exact code on that line\" --note \"what the code does\" [--counter \"what you searched\"]\n\n  Add a red flag:\n    python answer.py FINDINGS.json flag B05 --evidence src/x.py:41 --note \"what's wrong\"\n\n  Finish an item:\n    python answer.py FINDINGS.json item B05 --rating gap --confidence high \\\n        --summary \"one sentence\" --next \"what to fix\" [--violates \"exact words from the requirement\"] \\\n        [--also-affects E06]\n\n  Resolve a pre-scan hit:\n    python answer.py FINDINGS.json prescan H003 --verdict confirmed --item R03 --reason \"...\"\n\n  Show the next unanswered check:\n    python answer.py FINDINGS.json next\n\nThe quote is checked against the file right away; a \"yes\" without a matching quote\nand a counter-search is refused. Paths are relative to the repo, which defaults to the\nfolder holding FINDINGS.json (set --repo to change it).\n\npositional arguments:\n  findings\n  {check,flag,item,prescan,next}\n  target\n\noptions:\n  -h, --help            show this help message and exit\n  --repo REPO\n  --met {yes,no,unknown}\n  --evidence EVIDENCE\n  --quote QUOTE\n  --counter COUNTER\n  --note NOTE\n  --rating {likely_pass,gap,needs_evidence,na_candidate}\n  --confidence {high,medium,low}\n  --summary SUMMARY\n  --next NEXT_STEP\n  --violates VIOLATES\n  --also-affects ALSO_AFFECTS\n  --verdict {confirmed,dismissed}\n  --item ITEM\n  --reason REASON\nusage: review_coverage.py ledger [-h] --rows ROWS [--attempts ATTEMPTS]\n                                 [--deviations DEVIATIONS]\n                                 findings check\n\npositional arguments:\n  findings\n  check\n\noptions:\n  -h, --help            show this help message and exit\n  --rows ROWS\n  --attempts ATTEMPTS\n  --deviations DEVIATIONS\n{} TODO: what was reviewed and what wasn't. None","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
