: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n     1\tapiVersion: apps/v1\n     2\tkind: Deployment\n     3\tmetadata:\n     4\t  name: procurement-agent\n     5\t  namespace: procurement-prod\n     6\t  labels:\n     7\t    app: procurement-agent\n     8\t    owner: team-procurement-platform\n     9\tspec:\n    10\t  replicas: 3\n    11\t  selector:\n    12\t    matchLabels:\n    13\t      app: procurement-agent\n    14\t  template:\n    15\t    metadata:\n    16\t      labels:\n    17\t        app: procurement-agent\n    18\t    spec:\n    19\t      serviceAccountName: procurement-agent\n    20\t      automountServiceAccountToken: false\n    21\t      hostUsers: false\n    22\t      enableServiceLinks: false\n    23\t      securityContext:\n    24\t        runAsNonRoot: true\n    25\t        runAsUser: 65532\n    26\t        runAsGroup: 65532\n    27\t        fsGroup: 65532\n    28\t        seccompProfile:\n    29\t          type: RuntimeDefault\n    30\t      containers:\n    31\t        - name: agent\n    32\t          image: registry.example-corp.test/procurement/agent@sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\n    33\t          imagePullPolicy: IfNotPresent\n    34\t          ports:\n    35\t            - containerPort: 8080\n    36\t              name: http\n    37\t          env:\n    38\t            - name: IMAGE_DIGEST\n    39\t              value: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n    40\t            - name: MODEL_ID\n    41\t              value: \"claude-sonnet-4-5-20250929\"\n    42\t            - name: EXTRACTOR_MODEL_ID\n    43\t              value: \"claude-haiku-4-5-20251001\"\n    44\t            - name: DATABASE_URL\n    45\t              value: \"postgresql://procurement_agent@procurement-db.procurement-data.svc.cluster.local:5432/procurement?sslmode=verify-full\"\n    46\t            - name: ERP_MCP_URL\n    47\t              value: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    48\t            - name: PAYMENTS_API_URL\n    49\t              value: \"https://api.payments.example-pay.test\"\n    50\t            - name: SLACK_API_URL\n    51\t              value: \"https://slack-proxy.egress.svc.cluster.local:8443/api\"\n    52\t            - name: STS_URL\n    53\t              value: \"https://sts.identity.svc.cluster.local/oauth2/token\"\n    54\t            - name: OIDC_ISSUER\n    55\t              value: \"https://login.example-corp.test\"\n    56\t            - name: OIDC_JWKS_URL\n    57\t              value: \"https://login.example-corp.test/.well-known/jwks.json\"\n    58\t            - name: HTTPS_PROXY\n    59\t              value: \"http://egress-proxy.egress.svc.cluster.local:3128\"\n    60\t            - name: NO_PROXY\n    61\t              value: \".svc.cluster.local\"\n    62\t            - name: OTEL_EXPORTER_OTLP_ENDPOINT\n    63\t              value: \"http://otel-collector.observability.svc.cluster.local:4317\"\n    64\t            - name: OTEL_SERVICE_NAME\n    65\t              value: \"procurement-agent\"\n    66\t            - name: OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT\n    67\t              value: \"false\"\n    68\t          securityContext:\n    69\t            allowPrivilegeEscalation: false\n    70\t            privileged: false\n    71\t            readOnlyRootFilesystem: true\n    72\t            runAsNonRoot: true\n    73\t            capabilities:\n    74\t              drop: [\"ALL\"]\n    75\t            seccompProfile:\n    76\t              type: RuntimeDefault\n    77\t          resources:\n    78\t            requests:\n    79\t              cpu: 250m\n    80\t              memory: 512Mi\n    81\t            limits:\n    82\t              cpu: \"1\"\n    83\t              memory: 1Gi\n    84\t          readinessProbe:\n    85\t            httpGet:\n    86\t              path: /healthz\n    87\t              port: http\n    88\t          volumeMounts:\n    89\t            - name: workload-token\n    90\t              mountPath: /var/run/secrets/tokens\n    91\t              readOnly: true\n    92\t            - name: slack-signing\n    93\t              mountPath: /var/run/secrets/slack\n    94\t              readOnly: true\n    95\t            - name: mail-hmac\n    96\t              mountPath: /var/run/secrets/mail\n    97\t              readOnly: true\n    98\t            - name: tmp\n    99\t              mountPath: /tmp\n   100\t      volumes:\n   101\t        - name: workload-token\n   102\t          projected:\n   103\t            sources:\n   104\t              - serviceAccountToken:\n   105\t                  path: procurement-agent\n   106\t                  audience: sts.identity.example-corp.test\n   107\t                  expirationSeconds: 600\n   108\t        - name: slack-signing\n   109\t          secret:\n   110\t            secretName: procurement-slack-signing\n   111\t        - name: mail-hmac\n   112\t          secret:\n   113\t            secretName: procurement-mail-gateway-hmac\n   114\t        - name: tmp\n   115\t          emptyDir:\n   116\t            medium: Memory\n   117\t            sizeLimit: 64Mi\n     1\tapiVersion: kyverno.io/v1\n     2\tkind: ClusterPolicy\n     3\tmetadata:\n     4\t  name: procurement-verify-images\n     5\t  annotations:\n     6\t    policies.kyverno.io/title: Verify procurement agent images\n     7\t    kyverno.io/kyverno-version: \"1.15.2\"\n     8\tspec:\n     9\t  validationFailureAction: Enforce\n    10\t  background: false\n    11\t  webhookTimeoutSeconds: 15\n    12\t  failurePolicy: Fail\n    13\t  rules:\n    14\t    - name: only-approved-registry\n    15\t      match:\n    16\t        any:\n    17\t          - resources:\n    18\t              kinds: [Pod]\n    19\t              namespaces: [procurement-prod]\n    20\t      validate:\n    21\t        message: \"Images in procurement-prod must come from registry.example-corp.test/procurement and be pinned by digest.\"\n    22\t        pattern:\n    23\t          spec:\n    24\t            =(initContainers):\n    25\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n    26\t            containers:\n    27\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n    28\t    - name: verify-signature-and-provenance\n    29\t      match:\n    30\t        any:\n    31\t          - resources:\n    32\t              kinds: [Pod]\n    33\t              namespaces: [procurement-prod]\n    34\t      verifyImages:\n    35\t        - imageReferences:\n    36\t            - \"registry.example-corp.test/procurement/*\"\n    37\t          mutateDigest: false\n    38\t          verifyDigest: true\n    39\t          required: true\n    40\t          attestors:\n    41\t            - entries:\n    42\t                - keyless:\n    43\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    44\t                    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    45\t                    rekor:\n    46\t                      url: https://rekor.sigstore.dev\n    47\t          attestations:\n    48\t            - type: https://slsa.dev/provenance/v1\n    49\t              attestors:\n    50\t                - entries:\n    51\t                    - keyless:\n    52\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    53\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    54\t              conditions:\n    55\t                - all:\n    56\t                    - key: \"{{ buildDefinition.buildType }}\"\n    57\t                      operator: Equals\n    58\t                      value: \"https://actions.github.io/buildtypes/workflow/v1\"\n    59\t                    - key: \"{{ buildDefinition.externalParameters.workflow.repository }}\"\n    60\t                      operator: Equals\n    61\t                      value: \"https://github.com/example-corp/procurement-agent\"\n    62\t                    - key: \"{{ buildDefinition.externalParameters.workflow.ref }}\"\n    63\t                      operator: Equals\n    64\t                      value: \"refs/heads/main\"\n    65\t                    - key: \"{{ buildDefinition.externalParameters.workflow.path }}\"\n    66\t                      operator: Equals\n    67\t                      value: \".github/workflows/ci.yaml\"\n    68\t                    - key: \"{{ runDetails.builder.id }}\"\n    69\t                      operator: Equals\n    70\t                      value: \"https://github.com/actions/runner/github-hosted\"\n    71\t            - type: https://cyclonedx.org/bom\n    72\t              attestors:\n    73\t                - entries:\n    74\t                    - keyless:\n    75\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    76\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n     1\tapiVersion: networking.k8s.io/v1\n     2\tkind: NetworkPolicy\n     3\tmetadata:\n     4\t  name: procurement-agent-default-deny\n     5\t  namespace: procurement-prod\n     6\tspec:\n     7\t  podSelector: {}\n     8\t  policyTypes: [\"Ingress\", \"Egress\"]\n     9\t---\n    10\tapiVersion: networking.k8s.io/v1\n    11\tkind: NetworkPolicy\n    12\tmetadata:\n    13\t  name: procurement-agent-egress\n    14\t  namespace: procurement-prod\n    15\tspec:\n    16\t  podSelector:\n    17\t    matchLabels:\n    18\t      app: procurement-agent\n    19\t  policyTypes: [\"Egress\"]\n    20\t  egress:\n    21\t    - to:\n    22\t        - namespaceSelector:\n    23\t            matchLabels:\n    24\t              kubernetes.io/metadata.name: kube-system\n    25\t          podSelector:\n    26\t            matchLabels:\n    27\t              k8s-app: kube-dns\n    28\t      ports:\n    29\t        - { protocol: UDP, port: 53 }\n    30\t        - { protocol: TCP, port: 53 }\n    31\t    - to:\n    32\t        - namespaceSelector:\n    33\t            matchLabels:\n    34\t              kubernetes.io/metadata.name: egress\n    35\t          podSelector:\n    36\t            matchLabels:\n    37\t              app: egress-proxy\n    38\t      ports:\n    39\t        - { protocol: TCP, port: 3128 }\n    40\t    - to:\n    41\t        - namespaceSelector:\n    42\t            matchLabels:\n    43\t              kubernetes.io/metadata.name: egress\n    44\t          podSelector:\n    45\t            matchLabels:\n    46\t              app: slack-proxy\n    47\t      ports:\n    48\t        - { protocol: TCP, port: 8443 }\n    49\t    - to:\n    50\t        - namespaceSelector:\n    51\t            matchLabels:\n    52\t              kubernetes.io/metadata.name: procurement-data\n    53\t          podSelector:\n    54\t            matchLabels:\n    55\t              app: procurement-db\n    56\t      ports:\n    57\t        - { protocol: TCP, port: 5432 }\n    58\t    - to:\n    59\t        - namespaceSelector:\n    60\t            matchLabels:\n    61\t              kubernetes.io/metadata.name: erp-mcp-gateway\n    62\t      ports:\n    63\t        - { protocol: TCP, port: 8443 }\n    64\t    - to:\n    65\t        - namespaceSelector:\n    66\t            matchLabels:\n    67\t              kubernetes.io/metadata.name: identity\n    68\t          podSelector:\n    69\t            matchLabels:\n    70\t              app: sts\n    71\t      ports:\n    72\t        - { protocol: TCP, port: 443 }\n    73\t    - to:\n    74\t        - ipBlock:\n    75\t            cidr: 0.0.0.0/0\n    76\t            except:\n    77\t              - 10.0.0.0/8\n    78\t              - 172.16.0.0/12\n    79\t              - 192.168.0.0/16\n    80\t              - 169.254.0.0/16\n    81\t      ports:\n    82\t        - { protocol: TCP, port: 443 }\n    83\t---\n    84\tapiVersion: networking.k8s.io/v1\n    85\tkind: NetworkPolicy\n    86\tmetadata:\n    87\t  name: procurement-agent-ingress\n    88\t  namespace: procurement-prod\n    89\tspec:\n    90\t  podSelector:\n    91\t    matchLabels:\n    92\t      app: procurement-agent\n    93\t  policyTypes: [\"Ingress\"]\n    94\t  ingress:\n    95\t    - from:\n    96\t        - namespaceSelector:\n    97\t            matchLabels:\n    98\t              kubernetes.io/metadata.name: ingress\n    99\t      ports:\n   100\t        - { protocol: TCP, port: 8080 }\n   101\t---\n   102\t# Egress proxy allowlist (applied in the egress namespace by the platform team).\n   103\tapiVersion: v1\n   104\tkind: ConfigMap\n   105\tmetadata:\n   106\t  name: egress-proxy-allowlist-procurement\n   107\t  namespace: egress\n   108\tdata:\n   109\t  allowlist.txt: |\n   110\t    api.anthropic.com\n   111\t    api.payments.example-pay.test\n   112\t    login.example-corp.test\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: procurement-prod\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: latest\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: procurement-agent\n    15\t  namespace: procurement-prod\n    16\t  labels:\n    17\t    app: procurement-agent\n    18\tautomountServiceAccountToken: false\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.11.10-slim-bookworm@sha256:2a6386ad2db20e7f55073f69a98d6da2cf9f168e05e7487d2670c22e4ad2a1bd AS build\n     3\tWORKDIR /src\n     4\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     5\tCOPY pyproject.toml ./\n     6\tCOPY app ./app\n     7\tRUN pip install --target /opt/site .\n     8\tRUN python -m compileall -q app\n     9\t\n    10\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:8f3c1a6e2b9d4f7a0c5e8b1d3f6a9c2e5b8d1f4a7c0e3b6d9f2a5c8e1b4d7f0a\n    11\tWORKDIR /app\n    12\tENV PYTHONPATH=/opt/site:/app \\\n    13\t    PYTHONDONTWRITEBYTECODE=1 \\\n    14\t    APP_ROOT=/app\n    15\tCOPY --from=build /opt/site /opt/site\n    16\tCOPY --from=build /src/app /app/app\n    17\tCOPY prompts /app/prompts\n    18\tCOPY config /app/config\n    19\tCOPY release/manifest.yaml /app/release/manifest.yaml\n    20\tUSER 65532:65532\n    21\tEXPOSE 8080\n    22\tENTRYPOINT [\"python\", \"-m\", \"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\", \"--no-server-header\"]\n     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    16\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    17\t        with:\n    18\t          python-version: \"3.11\"\n    19\t      - run: pip install -e '.[test]'\n    20\t      - run: pytest -q\n    21\t      - name: Secret scan\n    22\t        uses: gitleaks/gitleaks-action@83373cf2f8c4db6e24b41c1a9b086bb9619e9cd3 # v2.3.7\n    23\t      - name: Manifest hashes match files\n    24\t        run: |\n    25\t          python - <<'PY'\n    26\t          import hashlib, yaml, sys\n    27\t          m = yaml.safe_load(open(\"release/manifest.yaml\"))\n    28\t          bad = []\n    29\t          for group in (\"prompts\", \"config\"):\n    30\t              for name, e in m[group].items():\n    31\t                  if isinstance(e, dict) and \"sha256\" in e:\n    32\t                      got = \"sha256:\" + hashlib.sha256(open(e[\"path\"], \"rb\").read()).hexdigest()\n    33\t                      if got != e[\"sha256\"]:\n    34\t                          bad.append(e[\"path\"])\n    35\t          if bad:\n    36\t              sys.exit(\"manifest out of date: \" + \", \".join(bad))\n    37\t          PY\n    38\t\n    39\t  release:\n    40\t    if: github.ref == 'refs/heads/main'\n    41\t    needs: test\n    42\t    runs-on: ubuntu-24.04\n    43\t    permissions:\n    44\t      contents: read\n    45\t      id-token: write\n    46\t      packages: write\n    47\t      attestations: write\n    48\t    steps:\n    49\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    50\t      - uses: sigstore/cosign-installer@dc72c7d5c4d10cd6bcb8cf6e3fd625a9e5e537da # v3.7.0\n    51\t        with:\n    52\t          cosign-release: \"v2.6.2\"\n    53\t      - uses: docker/setup-buildx-action@c47758b77c9736f4b2ef4073d4d51994fabfe349 # v3.7.1\n    54\t      - uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0\n    55\t        with:\n    56\t          registry: registry.example-corp.test\n    57\t          username: ${{ github.actor }}\n    58\t          password: ${{ secrets.GITHUB_TOKEN }}\n    59\t      - id: build\n    60\t        uses: docker/build-push-action@4f58ea79222b3b9dc2c8bbdd6debcef730109a75 # v6.9.0\n    61\t        with:\n    62\t          context: .\n    63\t          push: true\n    64\t          tags: registry.example-corp.test/procurement/agent:${{ github.sha }}\n    65\t          provenance: false\n    66\t          sbom: false\n    67\t      - name: SBOM\n    68\t        uses: anchore/sbom-action@251a468eed47e5082b105c3ba6ee500c0e65a764 # v0.17.6\n    69\t        with:\n    70\t          image: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    71\t          format: cyclonedx-json\n    72\t          output-file: sbom.cdx.json\n    73\t      - name: Sign and attest\n    74\t        env:\n    75\t          IMAGE: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    76\t        run: |\n    77\t          cosign sign --yes \"$IMAGE\"\n    78\t          cosign attest --yes --type cyclonedx --predicate sbom.cdx.json \"$IMAGE\"\n    79\t      - uses: actions/attest-build-provenance@1c608d11d69870c2092266b3f9a6f3abbf17002c # v1.4.3\n    80\t        with:\n    81\t          subject-name: registry.example-corp.test/procurement/agent\n    82\t          subject-digest: ${{ steps.build.outputs.digest }}\n    83\t          push-to-registry: true\n     1\t# Release manifest for the procurement agent. Regenerated by CI on every\n     2\t# release build (see .github/workflows/ci.yaml, job \"release\").\n     3\trelease: \"procurement-agent 2026.09.4\"\n     4\towner: team-procurement-platform\n     5\t\n     6\timage:\n     7\t  repository: registry.example-corp.test/procurement/agent\n     8\t  digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n     9\t  sbom: \"registry.example-corp.test/procurement/agent:sha256-7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0.sbom\"\n    10\t  signer:\n    11\t    issuer: \"https://token.actions.githubusercontent.com\"\n    12\t    subject: \"https://github.com/example-corp/procurement-agent/.github/workf