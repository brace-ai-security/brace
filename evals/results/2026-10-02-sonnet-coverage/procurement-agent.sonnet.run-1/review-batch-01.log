{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CfdqnthrwfQsiJnToH9ha","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016rVMzucMNDhQA2QScAiqCE","name":"Bash","input":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-n0y2sv85/agent; for f in app/approvals.py app/identity.py app/killswitch.py app/startup.py app/main.py app/settings.py; do echo \"=== $f\"; cat -n $f; done"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12841,"cache_read_input_tokens":37733,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12841},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"65f8d82b-17db-4aa3-8a31-97c7d53b8832","uuid":"dbde7ddd-e26c-407d-98e9-fa6493ee6542","timestamp":"2026-10-02T17:56:46.486Z","request_id":"req_011CfdqntKJYFe8vsMXFf9DQ","wire_tool_inputs":{"toolu_016rVMzucMNDhQA2QScAiqCE":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-n0y2sv85/agent; for f in app/approvals.py app/identity.py app/killswitch.py app/startup.py app/main.py app/settings.py; do echo \"=== $f\"; cat -n $f; done"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016rVMzucMNDhQA2QScAiqCE","type":"tool_result","content":"=== app/approvals.py\n     1\t\"\"\"Approval requests and decisions for high-impact operations.\n     2\t\n     3\tRequests are posted to the business unit's approvals channel in Slack with\n     4\tthe full argument summary. Approvers decide with the Slack buttons; the\n     5\tinteractive callback is signature-checked in main.py and then calls\n     6\t``decide``. Approver authority is checked against the role map in policy.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport json\n    11\timport uuid\n    12\tfrom dataclasses import dataclass\n    13\tfrom datetime import datetime, timedelta, timezone\n    14\tfrom typing import Any\n    15\t\n    16\tfrom app.audit import digest, summarize_args\n    17\tfrom app.identity import RunIdentity\n    18\t\n    19\t\n    20\t@dataclass(frozen=True)\n    21\tclass Approval:\n    22\t    id: str\n    23\t    approver: str\n    24\t    approver_role: str\n    25\t    expires_at: datetime\n    26\t\n    27\t\n    28\tclass ApproverNotAuthorized(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tclass ApprovalStore:\n    33\t    def __init__(self, pool, policy: dict, notifier):\n    34\t        self.pool = pool\n    35\t        self.ttl = timedelta(minutes=int(policy[\"approvals\"][\"ttl_minutes\"]))\n    36\t        self.approver_roles: dict[str, list[str]] = policy[\"approvals\"][\"approver_roles\"]\n    37\t        self.notifier = notifier\n    38\t\n    39\t    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n    40\t        approval_id = f\"apr-{uuid.uuid4()}\"\n    41\t        expires_at = datetime.now(timezone.utc) + self.ttl\n    42\t        await self.pool.execute(\n    43\t            \"\"\"\n    44\t            INSERT INTO approvals (\n    45\t                id, tool, target, args_sha256, args_summary, tenant,\n    46\t                requested_by_instance, requested_by_run, delegated_subject,\n    47\t                status, requested_at, expires_at\n    48\t            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)\n    49\t            \"\"\",\n    50\t            approval_id,\n    51\t            tool,\n    52\t            target,\n    53\t            digest(args),\n    54\t            json.dumps(summarize_args(args)),\n    55\t            ident.tenant,\n    56\t            ident.agent_instance_id,\n    57\t            ident.run_id,\n    58\t            ident.delegated_subject,\n    59\t            expires_at,\n    60\t        )\n    61\t        await self.notifier.post_approval_request(\n    62\t            tenant=ident.tenant,\n    63\t            approval_id=approval_id,\n    64\t            tool=tool,\n    65\t            target=target,\n    66\t            summary=summarize_args(args),\n    67\t            expires_at=expires_at,\n    68\t        )\n    69\t        return approval_id\n    70\t\n    71\t    async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:\n    72\t        row = await self.pool.fetchrow(\n    73\t            \"\"\"\n    74\t            SELECT id, approver, approver_role, expires_at\n    75\t            FROM approvals\n    76\t            WHERE tool = $1\n    77\t              AND target = $2\n    78\t              AND tenant = $3\n    79\t              AND status = 'approved'\n    80\t              AND expires_at > now()\n    81\t            ORDER BY decided_at DESC\n    82\t            LIMIT 1\n    83\t            \"\"\",\n    84\t            tool,\n    85\t            target,\n    86\t            ident.tenant,\n    87\t        )\n    88\t        if row is None:\n    89\t            return None\n    90\t        if row[\"approver_role\"] not in self.approver_roles.get(tool, []):\n    91\t            return None\n    92\t        return Approval(row[\"id\"], row[\"approver\"], row[\"approver_role\"], row[\"expires_at\"])\n    93\t\n    94\t    async def decide(self, approval_id: str, approver: str, approver_role: str, approve: bool) -> None:\n    95\t        row = await self.pool.fetchrow(\n    96\t            \"SELECT tool, status, expires_at FROM approvals WHERE id = $1\", approval_id\n    97\t        )\n    98\t        if row is None or row[\"status\"] != \"pending\":\n    99\t            raise ValueError(\"approval is not pending\")\n   100\t        if row[\"expires_at\"] <= datetime.now(timezone.utc):\n   101\t            raise ValueError(\"approval request expired\")\n   102\t        if approver_role not in self.approver_roles.get(row[\"tool\"], []):\n   103\t            raise ApproverNotAuthorized(f\"{approver_role} cannot approve {row['tool']}\")\n   104\t        await self.pool.execute(\n   105\t            \"\"\"\n   106\t            UPDATE approvals\n   107\t            SET status = $2, approver = $3, approver_role = $4, decided_at = now()\n   108\t            WHERE id = $1 AND status = 'pending'\n   109\t            \"\"\",\n   110\t            approval_id,\n   111\t            \"approved\" if approve else \"rejected\",\n   112\t            approver,\n   113\t            approver_role,\n   114\t        )\n=== app/identity.py\n     1\t\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n     2\t\n     3\tThe agent runs under its own Kubernetes service account. Its projected\n     4\tservice-account token is exchanged at the internal STS for short-lived,\n     5\taudience-bound tokens. The launching user's token is never forwarded to an\n     6\tintegration; the user is carried as the delegated subject of the exchange.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport time\n    13\timport uuid\n    14\tfrom dataclasses import dataclass, field, replace\n    15\tfrom pathlib import Path\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.settings import Settings\n    20\t\n    21\tIDENTITY_FIELDS = (\n    22\t    \"accountable_party\",\n    23\t    \"operational_owner\",\n    24\t    \"tenant\",\n    25\t    \"agent_type_id\",\n    26\t    \"agent_instance_id\",\n    27\t    \"trace_id\",\n    28\t)\n    29\t\n    30\t\n    31\t@dataclass(frozen=True)\n    32\tclass RunIdentity:\n    33\t    accountable_party: str\n    34\t    operational_owner: str\n    35\t    tenant: str\n    36\t    agent_type_id: str\n    37\t    agent_instance_id: str\n    38\t    trace_id: str\n    39\t    run_id: str\n    40\t    delegated_subject: str\n    41\t    agent_principal: str\n    42\t    parent_instance_id: str | None = None\n    43\t    role: str = \"procurement\"\n    44\t\n    45\t    def __post_init__(self) -> None:\n    46\t        for name in IDENTITY_FIELDS:\n    47\t            if not getattr(self, name):\n    48\t                raise ValueError(f\"identity field {name} is empty\")\n    49\t\n    50\t    def child(self, role: str) -> \"RunIdentity\":\n    51\t        return replace(\n    52\t            self,\n    53\t            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n    54\t            parent_instance_id=self.agent_instance_id,\n    55\t            role=role,\n    56\t        )\n    57\t\n    58\t\n    59\tdef new_instance_id() -> str:\n    60\t    return f\"inst-{uuid.uuid4()}\"\n    61\t\n    62\t\n    63\tdef compute_agent_type_id(manifest: dict) -> str:\n    64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    65\t    material = {\n    66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n    67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n    68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n    69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n    70\t        \"models\": manifest[\"models\"],\n    71\t        \"config\": manifest[\"config\"],\n    72\t        \"tools\": manifest[\"tool_pins\"],\n    73\t    }\n    74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n    76\t\n    77\t\n    78\t@dataclass\n    79\tclass _CachedToken:\n    80\t    value: str\n    81\t    expires_at: float\n    82\t\n    83\t\n    84\t@dataclass\n    85\tclass TokenBroker:\n    86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n    87\t\n    88\t    settings: Settings\n    89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n    90\t\n    91\t    def _workload_token(self) -> str:\n    92\t        return Path(self.settings.workload_token_path).read_text().strip()\n    93\t\n    94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n    95\t        key = (audience, scope, ident.tenant)\n    96\t        cached = self._cache.get(key)\n    97\t        if cached and cached.expires_at - 30 > time.time():\n    98\t            return cached.value\n    99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n   100\t            resp = await client.post(\n   101\t                self.settings.sts_url,\n   102\t                data={\n   103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n   104\t                    \"subject_token\": self._workload_token(),\n   105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n   106\t                    \"audience\": audience,\n   107\t                    \"scope\": scope,\n   108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n   109\t                    \"actor_token\": ident.delegated_subject,\n   110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n   111\t                },\n   112\t            )\n   113\t            resp.raise_for_status()\n   114\t            body = resp.json()\n   115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n   116\t        self._cache[key] = token\n   117\t        return token.value\n=== app/killswitch.py\n     1\t\"\"\"Operator stop control.\n     2\t\n     3\tOperators halt the fleet or one business unit by setting a row in\n     4\t``control_flags`` with the ``procurement_ops`` database role (see\n     5\tops/README in the platform runbook). The agent's own database role has\n     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\t\n    11\tclass AgentHalted(Exception):\n    12\t    pass\n    13\t\n    14\t\n    15\t_QUERY = \"\"\"\n    16\tSELECT scope, reason, set_by, set_at\n    17\tFROM control_flags\n    18\tWHERE halted\n    19\t  AND (scope = 'fleet' OR scope = $1)\n    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n    21\tLIMIT 1\n    22\t\"\"\"\n    23\t\n    24\t\n    25\tasync def assert_running(pool, tenant: str) -> None:\n    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n    27\t    if row is not None:\n    28\t        raise AgentHalted(\n    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n    31\t        )\n=== app/startup.py\n     1\t\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\timport logging\n     6\tfrom pathlib import Path\n     7\t\n     8\tfrom app.identity import compute_agent_type_id\n     9\tfrom app.settings import Settings\n    10\t\n    11\tlog = logging.getLogger(__name__)\n    12\t\n    13\t\n    14\tdef sha256_file(path: Path) -> str:\n    15\t    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n    16\t\n    17\t\n    18\tdef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n    19\t    mismatches: list[str] = []\n    20\t    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n    21\t        mismatches.append(f\"image: running {settings.image_digest}\")\n    22\t    for name, entry in manifest[\"prompts\"].items():\n    23\t        path = settings.prompt_dir / Path(entry[\"path\"]).name\n    24\t        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n    25\t            mismatches.append(f\"prompt:{name}\")\n    26\t    for name in (\"policy\", \"tools\"):\n    27\t        entry = manifest[\"config\"][name]\n    28\t        path = settings.policy_path if name == \"policy\" else settings.tools_path\n    29\t        if sha256_file(path) != entry[\"sha256\"]:\n    30\t            mismatches.append(f\"config:{name}\")\n    31\t    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n    32\t        mismatches.append(\"model:primary\")\n    33\t    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n    34\t        mismatches.append(\"model:extractor\")\n    35\t    return mismatches\n    36\t\n    37\t\n    38\tdef startup_checks(settings: Settings) -> str:\n    39\t    \"\"\"Return the agent-type-id for this process.\"\"\"\n    40\t    manifest = settings.manifest\n    41\t    mismatches = running_state_mismatches(settings, manifest)\n    42\t    if mismatches:\n    43\t        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n    44\t    agent_type_id = compute_agent_type_id(manifest)\n    45\t    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n    46\t    return agent_type_id\n=== app/main.py\n     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport hashlib\n     6\timport hmac\n     7\timport json\n     8\timport logging\n     9\timport time\n    10\timport uuid\n    11\tfrom contextlib import asynccontextmanager\n    12\tfrom pathlib import Path\n    13\tfrom urllib.parse import parse_qs\n    14\t\n    15\timport asyncpg\n    16\timport jwt\n    17\tfrom anthropic import AsyncAnthropic\n    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n    20\tfrom opentelemetry import trace\n    21\tfrom pydantic import BaseModel, Field\n    22\t\n    23\tfrom app import audit, ingest\n    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n    25\tfrom app.extractor import LineItemExtractor\n    26\tfrom app.gate import PolicyGate\n    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n    28\tfrom app.loop import AgentDeps, ProcurementAgent\n    29\tfrom app.mcp_client import ErpMcpClient\n    30\tfrom app.redact import RedactingFilter\n    31\tfrom app.settings import get_settings\n    32\tfrom app.startup import startup_checks\n    33\tfrom app.tools.slack import SlackClient\n    34\t\n    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n    36\tfor handler in logging.getLogger().handlers:\n    37\t    handler.addFilter(RedactingFilter())\n    38\tlog = logging.getLogger(\"procurement\")\n    39\t\n    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    41\tbearer = HTTPBearer()\n    42\t\n    43\t\n    44\tclass RunRequest(BaseModel):\n    45\t    task: str = Field(min_length=1, max_length=4000)\n    46\t    department: str = Field(min_length=1, max_length=64)\n    47\t\n    48\t\n    49\tclass Principal(BaseModel):\n    50\t    subject: str\n    51\t    business_unit: str\n    52\t\n    53\t\n    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    55\t    return RunIdentity(\n    56\t        accountable_party=\"system:procurement-agent\",\n    57\t        operational_owner=settings.operational_owner,\n    58\t        tenant=tenant,\n    59\t        agent_type_id=agent_type_id,\n    60\t        agent_instance_id=new_instance_id(),\n    61\t        trace_id=uuid.uuid4().hex,\n    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n    63\t        delegated_subject=\"system:procurement-agent\",\n    64\t        agent_principal=AGENT_PRINCIPAL,\n    65\t    )\n    66\t\n    67\t\n    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n    69\t    while True:\n    70\t        await asyncio.sleep(60)\n    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n    72\t        count = await app.state.pool.fetchval(\n    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n    75\t        )\n    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n    78\t\n    79\t\n    80\t@asynccontextmanager\n    81\tasync def lifespan(app: FastAPI):\n    82\t    settings = get_settings()\n    83\t    agent_type_id = startup_checks(settings)\n    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    85\t    broker = TokenBroker(settings)\n    86\t\n    87\t    async def slack_token() -> str:\n    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n    89\t\n    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n    92\t    gate = PolicyGate(settings.policy, approvals)\n    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n    95\t\n    96\t    client = AsyncAnthropic()\n    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    98\t    deps.extractor = LineItemExtractor(\n    99\t        client=client, settings=settings, deps=deps,\n   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n   101\t    )\n   102\t    app.state.settings = settings\n   103\t    app.state.pool = pool\n   104\t    app.state.agent_type_id = agent_type_id\n   105\t    app.state.approvals = approvals\n   106\t    app.state.agent = ProcurementAgent(\n   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n   108\t    )\n   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n   111\t    try:\n   112\t        yield\n   113\t    finally:\n   114\t        sweeper.cancel()\n   115\t        await pool.close()\n   116\t\n   117\t\n   118\tapp = FastAPI(lifespan=lifespan)\n   119\tapp.include_router(ingest.router)\n   120\t\n   121\t\n   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n   123\t    settings = request.app.state.settings\n   124\t    try:\n   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n   126\t        claims = jwt.decode(\n   127\t            creds.credentials,\n   128\t            key.key,\n   129\t            algorithms=[\"RS256\", \"ES256\"],\n   130\t            audience=settings.oidc_audience,\n   131\t            issuer=settings.oidc_issuer,\n   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n   133\t        )\n   134\t    except jwt.PyJWTError as exc:\n   135\t        raise HTTPException(401, \"invalid token\") from exc\n   136\t    bu = claims.get(\"bu\")\n   137\t    if not bu:\n   138\t        raise HTTPException(403, \"token has no business unit\")\n   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n   140\t\n   141\t\n   142\t@app.post(\"/runs\")\n   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n   144\t    settings = request.app.state.settings\n   145\t    span_ctx = trace.get_current_span().get_span_context()\n   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n   147\t    ident = RunIdentity(\n   148\t        accountable_party=principal.subject,\n   149\t        operational_owner=settings.operational_owner,\n   150\t        tenant=principal.business_unit,\n   151\t        agent_type_id=request.app.state.agent_type_id,\n   152\t        agent_instance_id=new_instance_id(),\n   153\t        trace_id=trace_id,\n   154\t        run_id=f\"run-{uuid.uuid4()}\",\n   155\t        delegated_subject=principal.subject,\n   156\t        agent_principal=AGENT_PRINCIPAL,\n   157\t    )\n   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n   161\t\n   162\t\n   163\t@app.post(\"/slack/interactions\")\n   164\tasync def slack_interactions(request: Request) -> dict:\n   165\t    body = await request.body()\n   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n   167\t    if abs(time.time() - int(timestamp)) > 300:\n   168\t        raise HTTPException(401, \"stale request\")\n   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n   172\t        raise HTTPException(401, \"bad signature\")\n   173\t\n   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n   175\t    action = payload[\"actions\"][0]\n   176\t    slack_user = payload[\"user\"][\"id\"]\n   177\t    row = await request.app.state.pool.fetchrow(\n   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n   179\t    )\n   180\t    if row is None:\n   181\t        raise HTTPException(403, \"not an approver\")\n   182\t    try:\n   183\t        await request.app.state.approvals.decide(\n   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n   185\t            approve=action[\"action_id\"] == \"approve\",\n   186\t        )\n   187\t    except ApproverNotAuthorized as exc:\n   188\t        raise HTTPException(403, str(exc)) from exc\n   189\t    except ValueError as exc:\n   190\t        raise HTTPException(409, str(exc)) from exc\n   191\t    return {\"ok\": True}\n   192\t\n   193\t\n   194\t@app.get(\"/healthz\")\n   195\tasync def healthz() -> dict:\n   196\t    return {\"ok\": True}\n=== app/settings.py\n     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t\n    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )","is_error":false}]},"parent_tool_use_id":null,"session_id":"65f8d82b-17db-4aa3-8a31-97c7d53b8832","uuid":"4eb5e553-1978-4e55-9f74-0c6073544b8b","timestamp":"2026-10-02T17:56:46.526Z","tool_use_result":{"stdout":"=== app/approvals.py\n     1\t\"\"\"Approval requests and decisions for high-impact operations.\n     2\t\n     3\tRequests are posted to the business unit's approvals channel in Slack with\n     4\tthe full argument summary. Approvers decide with the Slack buttons; the\n     5\tinteractive callback is signature-checked in main.py and then calls\n     6\t``decide``. Approver authority is checked against the role map in policy.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport json\n    11\timport uuid\n    12\tfrom dataclasses import dataclass\n    13\tfrom datetime import datetime, timedelta, timezone\n    14\tfrom typing import Any\n    15\t\n    16\tfrom app.audit import digest, summarize_args\n    17\tfrom app.identity import RunIdentity\n    18\t\n    19\t\n    20\t@dataclass(frozen=True)\n    21\tclass Approval:\n    22\t    id: str\n    23\t    approver: str\n    24\t    approver_role: str\n    25\t    expires_at: datetime\n    26\t\n    27\t\n    28\tclass ApproverNotAuthorized(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tclass ApprovalStore:\n    33\t    def __init__(self, pool, policy: dict, notifier):\n    34\t        self.pool = pool\n    35\t        self.ttl = timedelta(minutes=int(policy[\"approvals\"][\"ttl_minutes\"]))\n    36\t        self.approver_roles: dict[str, list[str]] = policy[\"approvals\"][\"approver_roles\"]\n    37\t        self.notifier = notifier\n    38\t\n    39\t    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n    40\t        approval_id = f\"apr-{uuid.uuid4()}\"\n    41\t        expires_at = datetime.now(timezone.utc) + self.ttl\n    42\t        await self.pool.execute(\n    43\t            \"\"\"\n    44\t            INSERT INTO approvals (\n    45\t                id, tool, target, args_sha256, args_summary, tenant,\n    46\t                requested_by_instance, requested_by_run, delegated_subject,\n    47\t                status, requested_at, expires_at\n    48\t            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)\n    49\t            \"\"\",\n    50\t            approval_id,\n    51\t            tool,\n    52\t            target,\n    53\t            digest(args),\n    54\t            json.dumps(summarize_args(args)),\n    55\t            ident.tenant,\n    56\t            ident.agent_instance_id,\n    57\t            ident.run_id,\n    58\t            ident.delegated_subject,\n    59\t            expires_at,\n    60\t        )\n    61\t        await self.notifier.post_approval_request(\n    62\t            tenant=ident.tenant,\n    63\t            approval_id=approval_id,\n    64\t            tool=tool,\n    65\t            target=target,\n    66\t            summary=summarize_args(args),\n    67\t            expires_at=expires_at,\n    68\t        )\n    69\t        return approval_id\n    70\t\n    71\t    async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:\n    72\t        row = await self.pool.fetchrow(\n    73\t            \"\"\"\n    74\t            SELECT id, approver, approver_role, expires_at\n    75\t            FROM approvals\n    76\t            WHERE tool = $1\n    77\t              AND target = $2\n    78\t              AND tenant = $3\n    79\t              AND status = 'approved'\n    80\t              AND expires_at > now()\n    81\t            ORDER BY decided_at DESC\n    82\t            LIMIT 1\n    83\t            \"\"\",\n    84\t            tool,\n    85\t            target,\n    86\t            ident.tenant,\n    87\t        )\n    88\t        if row is None:\n    89\t            return None\n    90\t        if row[\"approver_role\"] not in self.approver_roles.get(tool, []):\n    91\t            return None\n    92\t        return Approval(row[\"id\"], row[\"approver\"], row[\"approver_role\"], row[\"expires_at\"])\n    93\t\n    94\t    async def decide(self, approval_id: str, approver: str, approver_role: str, approve: bool) -> None:\n    95\t        row = await self.pool.fetchrow(\n    96\t            \"SELECT tool, status, expires_at FROM approvals WHERE id = $1\", approval_id\n    97\t        )\n    98\t        if row is None or row[\"status\"] != \"pending\":\n    99\t            raise ValueError(\"approval is not pending\")\n   100\t        if row[\"expires_at\"] <= datetime.now(timezone.utc):\n   101\t            raise ValueError(\"approval request expired\")\n   102\t        if approver_role not in self.approver_roles.get(row[\"tool\"], []):\n   103\t            raise ApproverNotAuthorized(f\"{approver_role} cannot approve {row['tool']}\")\n   104\t        await self.pool.execute(\n   105\t            \"\"\"\n   106\t            UPDATE approvals\n   107\t            SET status = $2, approver = $3, approver_role = $4, decided_at = now()\n   108\t            WHERE id = $1 AND status = 'pending'\n   109\t            \"\"\",\n   110\t            approval_id,\n   111\t            \"approved\" if approve else \"rejected\",\n   112\t            approver,\n   113\t            approver_role,\n   114\t        )\n=== app/identity.py\n     1\t\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n     2\t\n     3\tThe agent runs under its own Kubernetes service account. Its projected\n     4\tservice-account token is exchanged at the internal STS for short-lived,\n     5\taudience-bound tokens. The launching user's token is never forwarded to an\n     6\tintegration; the user is carried as the delegated subject of the exchange.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport time\n    13\timport uuid\n    14\tfrom dataclasses import dataclass, field, replace\n    15\tfrom pathlib import Path\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.settings import Settings\n    20\t\n    21\tIDENTITY_FIELDS = (\n    22\t    \"accountable_party\",\n    23\t    \"operational_owner\",\n    24\t    \"tenant\",\n    25\t    \"agent_type_id\",\n    26\t    \"agent_instance_id\",\n    27\t    \"trace_id\",\n    28\t)\n    29\t\n    30\t\n    31\t@dataclass(frozen=True)\n    32\tclass RunIdentity:\n    33\t    accountable_party: str\n    34\t    operational_owner: str\n    35\t    tenant: str\n    36\t    agent_type_id: str\n    37\t    agent_instance_id: str\n    38\t    trace_id: str\n    39\t    run_id: str\n    40\t    delegated_subject: str\n    41\t    agent_principal: str\n    42\t    parent_instance_id: str | None = None\n    43\t    role: str = \"procurement\"\n    44\t\n    45\t    def __post_init__(self) -> None:\n    46\t        for name in IDENTITY_FIELDS:\n    47\t            if not getattr(self, name):\n    48\t                raise ValueError(f\"identity field {name} is empty\")\n    49\t\n    50\t    def child(self, role: str) -> \"RunIdentity\":\n    51\t        return replace(\n    52\t            self,\n    53\t            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n    54\t            parent_instance_id=self.agent_instance_id,\n    55\t            role=role,\n    56\t        )\n    57\t\n    58\t\n    59\tdef new_instance_id() -> str:\n    60\t    return f\"inst-{uuid.uuid4()}\"\n    61\t\n    62\t\n    63\tdef compute_agent_type_id(manifest: dict) -> str:\n    64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    65\t    material = {\n    66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n    67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n    68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n    69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n    70\t        \"models\": manifest[\"models\"],\n    71\t        \"config\": manifest[\"config\"],\n    72\t        \"tools\": manifest[\"tool_pins\"],\n    73\t    }\n    74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n    76\t\n    77\t\n    78\t@dataclass\n    79\tclass _CachedToken:\n    80\t    value: str\n    81\t    expires_at: float\n    82\t\n    83\t\n    84\t@dataclass\n    85\tclass TokenBroker:\n    86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n    87\t\n    88\t    settings: Settings\n    89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n    90\t\n    91\t    def _workload_token(self) -> str:\n    92\t        return Path(self.settings.workload_token_path).read_text().strip()\n    93\t\n    94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n    95\t        key = (audience, scope, ident.tenant)\n    96\t        cached = self._cache.get(key)\n    97\t        if cached and cached.expires_at - 30 > time.time():\n    98\t            return cached.value\n    99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n   100\t            resp = await client.post(\n   101\t                self.settings.sts_url,\n   102\t                data={\n   103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n   104\t                    \"subject_token\": self._workload_token(),\n   105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n   106\t                    \"audience\": audience,\n   107\t                    \"scope\": scope,\n   108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n   109\t                    \"actor_token\": ident.delegated_subject,\n   110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n   111\t                },\n   112\t            )\n   113\t            resp.raise_for_status()\n   114\t            body = resp.json()\n   115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n   116\t        self._cache[key] = token\n   117\t        return token.value\n=== app/killswitch.py\n     1\t\"\"\"Operator stop control.\n     2\t\n     3\tOperators halt the fleet or one business unit by setting a row in\n     4\t``control_flags`` with the ``procurement_ops`` database role (see\n     5\tops/README in the platform runbook). The agent's own database role has\n     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\t\n    11\tclass AgentHalted(Exception):\n    12\t    pass\n    13\t\n    14\t\n    15\t_QUERY = \"\"\"\n    16\tSELECT scope, reason, set_by, set_at\n    17\tFROM control_flags\n    18\tWHERE halted\n    19\t  AND (scope = 'fleet' OR scope = $1)\n    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n    21\tLIMIT 1\n    22\t\"\"\"\n    23\t\n    24\t\n    25\tasync def assert_running(pool, tenant: str) -> None:\n    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n    27\t    if row is not None:\n    28\t        raise AgentHalted(\n    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n    31\t        )\n=== app/startup.py\n     1\t\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\timport logging\n     6\tfrom pathlib import Path\n     7\t\n     8\tfrom app.identity import compute_agent_type_id\n     9\tfrom app.settings import Settings\n    10\t\n    11\tlog = logging.getLogger(__name__)\n    12\t\n    13\t\n    14\tdef sha256_file(path: Path) -> str:\n    15\t    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n    16\t\n    17\t\n    18\tdef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n    19\t    mismatches: list[str] = []\n    20\t    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n    21\t        mismatches.append(f\"image: running {settings.image_digest}\")\n    22\t    for name, entry in manifest[\"prompts\"].items():\n    23\t        path = settings.prompt_dir / Path(entry[\"path\"]).name\n    24\t        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n    25\t            mismatches.append(f\"prompt:{name}\")\n    26\t    for name in (\"policy\", \"tools\"):\n    27\t        entry = manifest[\"config\"][name]\n    28\t        path = settings.policy_path if name == \"policy\" else settings.tools_path\n    29\t        if sha256_file(path) != entry[\"sha256\"]:\n    30\t            mismatches.append(f\"config:{name}\")\n    31\t    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n    32\t        mismatches.append(\"model:primary\")\n    33\t    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n    34\t        mismatches.append(\"model:extractor\")\n    35\t    return mismatches\n    36\t\n    37\t\n    38\tdef startup_checks(settings: Settings) -> str:\n    39\t    \"\"\"Return the agent-type-id for this process.\"\"\"\n    40\t    manifest = settings.manifest\n    41\t    mismatches = running_state_mismatches(settings, manifest)\n    42\t    if mismatches:\n    43\t        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n    44\t    agent_type_id = compute_agent_type_id(manifest)\n    45\t    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n    46\t    return agent_type_id\n=== app/main.py\n     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport hashlib\n     6\timport hmac\n     7\timport json\n     8\timport logging\n     9\timport time\n    10\timport uuid\n    11\tfrom contextlib import asynccontextmanager\n    12\tfrom pathlib import Path\n    13\tfrom urllib.parse import parse_qs\n    14\t\n    15\timport asyncpg\n    16\timport jwt\n    17\tfrom anthropic import AsyncAnthropic\n    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n    20\tfrom opentelemetry import trace\n    21\tfrom pydantic import BaseModel, Field\n    22\t\n    23\tfrom app import audit, ingest\n    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n    25\tfrom app.extractor import LineItemExtractor\n    26\tfrom app.gate import PolicyGate\n    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n    28\tfrom app.loop import AgentDeps, ProcurementAgent\n    29\tfrom app.mcp_client import ErpMcpClient\n    30\tfrom app.redact import RedactingFilter\n    31\tfrom app.settings import get_settings\n    32\tfrom app.startup import startup_checks\n    33\tfrom app.tools.slack import SlackClient\n    34\t\n    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n    36\tfor handler in logging.getLogger().handlers:\n    37\t    handler.addFilter(RedactingFilter())\n    38\tlog = logging.getLogger(\"procurement\")\n    39\t\n    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    41\tbearer = HTTPBearer()\n    42\t\n    43\t\n    44\tclass RunRequest(BaseModel):\n    45\t    task: str = Field(min_length=1, max_length=4000)\n    46\t    department: str = Field(min_length=1, max_length=64)\n    47\t\n    48\t\n    49\tclass Principal(BaseModel):\n    50\t    subject: str\n    51\t    business_unit: str\n    52\t\n    53\t\n    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    55\t    return RunIdentity(\n    56\t        accountable_party=\"system:procurement-agent\",\n    57\t        operational_owner=settings.operational_owner,\n    58\t        tenant=tenant,\n    59\t        agent_type_id=agent_type_id,\n    60\t        agent_instance_id=new_instance_id(),\n    61\t        trace_id=uuid.uuid4().hex,\n    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n    63\t        delegated_subject=\"system:procurement-agent\",\n    64\t        agent_principal=AGENT_PRINCIPAL,\n    65\t    )\n    66\t\n    67\t\n    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n    69\t    while True:\n    70\t        await asyncio.sleep(60)\n    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n    72\t        count = await app.state.pool.fetchval(\n    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n    75\t        )\n    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n    78\t\n    79\t\n    80\t@asynccontextmanager\n    81\tasync def lifespan(app: FastAPI):\n    82\t    settings = get_settings()\n    83\t    agent_type_id = startup_checks(settings)\n    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    85\t    broker = TokenBroker(settings)\n    86\t\n    87\t    async def slack_token() -> str:\n    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n    89\t\n    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n    92\t    gate = PolicyGate(settings.policy, approvals)\n    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n    95\t\n    96\t    client = AsyncAnthropic()\n    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    98\t    deps.extractor = LineItemExtractor(\n    99\t        client=client, settings=settings, deps=deps,\n   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n   101\t    )\n   102\t    app.state.settings = settings\n   103\t    app.state.pool = pool\n   104\t    app.state.agent_type_id = agent_type_id\n   105\t    app.state.approvals = approvals\n   106\t    app.state.agent = ProcurementAgent(\n   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n   108\t    )\n   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n   111\t    try:\n   112\t        yield\n   113\t    finally:\n   114\t        sweeper.cancel()\n   115\t        await pool.close()\n   116\t\n   117\t\n   118\tapp = FastAPI(lifespan=lifespan)\n   119\tapp.include_router(ingest.router)\n   120\t\n   121\t\n   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n   123\t    settings = request.app.state.settings\n   124\t    try:\n   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n   126\t        claims = jwt.decode(\n   127\t            creds.credentials,\n   128\t            key.key,\n   129\t            algorithms=[\"RS256\", \"ES256\"],\n   130\t            audience=settings.oidc_audience,\n   131\t            issuer=settings.oidc_issuer,\n   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n   133\t        )\n   134\t    except jwt.PyJWTError as exc:\n   135\t        raise HTTPException(401, \"invalid token\") from exc\n   136\t    bu = claims.get(\"bu\")\n   137\t    if not bu:\n   138\t        raise HTTPException(403, \"token has no business unit\")\n   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n   140\t\n   141\t\n   142\t@app.post(\"/runs\")\n   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n   144\t    settings = request.app.state.settings\n   145\t    span_ctx = trace.get_current_span().get_span_context()\n   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n   147\t    ident = RunIdentity(\n   148\t        accountable_party=principal.subject,\n   149\t        operational_owner=settings.operational_owner,\n   150\t        tenant=principal.business_unit,\n   151\t        agent_type_id=request.app.state.agent_type_id,\n   152\t        agent_instance_id=new_instance_id(),\n   153\t        trace_id=trace_id,\n   154\t        run_id=f\"run-{uuid.uuid4()}\",\n   155\t        delegated_subject=principal.subject,\n   156\t        agent_principal=AGENT_PRINCIPAL,\n   157\t    )\n   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n   161\t\n   162\t\n   163\t@app.post(\"/slack/interactions\")\n   164\tasync def slack_interactions(request: Request) -> dict:\n   165\t    body = await request.body()\n   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n   167\t    if abs(time.time() - int(timestamp)) > 300:\n   168\t        raise HTTPException(401, \"stale request\")\n   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n   172\t        raise HTTPException(401, \"bad signature\")\n   173\t\n   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n   175\t    action = payload[\"actions\"][0]\n   176\t    slack_user = payload[\"user\"][\"id\"]\n   177\t    row = await request.app.state.pool.fetchrow(\n   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n   179\t    )\n   180\t    if row is None:\n   181\t        raise HTTPException(403, \"not an approver\")\n   182\t    try:\n   183\t        await request.app.state.approvals.decide(\n   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n   185\t            approve=action[\"action_id\"] == \"approve\",\n   186\t        )\n   187\t    except ApproverNotAuthorized as exc:\n   188\t        raise HTTPException(403, str(exc)) from exc\n   189\t    except ValueError as exc:\n   190\t        raise HTTPException(409, str(exc)) from exc\n   191\t    return {\"ok\": True}\n   192\t\n   193\t\n   194\t@app.get(\"/healthz\")\n   195\tasync def healthz() -> dict:\n   196\t    return {\"ok\": True}\n=== app/settings.py\n     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t\n    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
