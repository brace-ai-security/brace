_for(args[\"operation\"]))\n    28\t\n    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n    30\t        return await erp.call(\n    31\t            \"po.create\",\n    32\t            {\n    33\t                \"business_unit\": ident.tenant,\n    34\t                \"department\": args[\"department\"],\n    35\t                \"vendor_id\": args[\"vendor_id\"],\n    36\t                \"lines\": args[\"lines\"],\n    37\t                \"currency\": args[\"currency\"],\n    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n    39\t                \"client_reference\": args[\"source_doc_id\"],\n    40\t            },\n    41\t            ident,\n    42\t            ERP_PO_WRITE_SCOPE,\n    43\t        )\n    44\t\n    45\t    line_schema = {\n    46\t        \"type\": \"object\",\n    47\t        \"properties\": {\n    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n    52\t        },\n    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n    54\t        \"additionalProperties\": False,\n    55\t    }\n    56\t\n    57\t    return [\n    58\t        Tool(\n    59\t            name=\"get_budget\",\n    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n    61\t            input_schema={\n    62\t                \"type\": \"object\",\n    63\t                \"properties\": {\n    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n    66\t                },\n    67\t                \"required\": [\"department\", \"fiscal_period\"],\n    68\t                \"additionalProperties\": False,\n    69\t            },\n    70\t            invoke=get_budget,\n    71\t        ),\n    72\t        Tool(\n    73\t            name=\"erp_call\",\n    74\t            description=(\n    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n    77\t            ),\n    78\t            input_schema={\n    79\t                \"type\": \"object\",\n    80\t                \"properties\": {\n    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n    82\t                    \"arguments\": {\"type\": \"object\"},\n    83\t                },\n    84\t                \"required\": [\"operation\"],\n    85\t                \"additionalProperties\": False,\n    86\t            },\n    87\t            invoke=erp_call,\n    88\t        ),\n    89\t        Tool(\n    90\t            name=\"create_purchase_order\",\n    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n    92\t            input_schema={\n    93\t                \"type\": \"object\",\n    94\t                \"properties\": {\n    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n   100\t                },\n   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n   102\t                \"additionalProperties\": False,\n   103\t            },\n   104\t            invoke=create_purchase_order,\n   105\t            target_field=\"source_doc_id\",\n   106\t        ),\n   107\t    ]\n=== app/tools/payments.py\n     1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.tools import Tool\n    11\t\n    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n    13\tPAYMENTS_SCOPE = \"payments.create\"\n    14\t\n    15\t\n    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n    17\t    raw = \"|\".join(\n    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n    19\t    )\n    20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n    21\t\n    22\t\n    23\tdef tools(deps) -> list[Tool]:\n    24\t    settings = deps.settings\n    25\t\n    26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n    27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n    28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n    29\t            resp = await client.post(\n    30\t                f\"{settings.payments_api_url}/v2/payments\",\n    31\t                headers={\n    32\t                    \"Authorization\": f\"Bearer {token}\",\n    33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n    34\t                },\n    35\t                json={\n    36\t                    \"business_unit\": ident.tenant,\n    37\t                    \"invoice_reference\": args[\"invoice_id\"],\n    38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n    39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n    40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n    41\t                },\n    42\t            )\n    43\t        resp.raise_for_status()\n    44\t        body = resp.json()\n    45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n    46\t\n    47\t    return [\n    48\t        Tool(\n    49\t            name=\"pay_invoice\",\n    50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n    51\t            input_schema={\n    52\t                \"type\": \"object\",\n    53\t                \"properties\": {\n    54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n    55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n    56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n    57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n    59\t                },\n    60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n    61\t                \"additionalProperties\": False,\n    62\t            },\n    63\t            invoke=pay_invoice,\n    64\t            target_field=\"invoice_id\",\n    65\t        )\n    66\t    ]\n=== app/tools/slack.py\n     1\t\"\"\"Slack tool: message staff and vendors, plus the approvals notifier.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom datetime import datetime\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.redact import redact_text, strip_unapproved_links\n    11\tfrom app.tools import Tool\n    12\t\n    13\tMAX_TEXT = 3000\n    14\t\n    15\t\n    16\tdef clean_outbound(text: str) -> str:\n    17\t    return strip_unapproved_links(redact_text(text))[:MAX_TEXT]\n    18\t\n    19\t\n    20\tclass SlackClient:\n    21\t    def __init__(self, api_url: str, bot_token_provider):\n    22\t        self.api_url = api_url\n    23\t        self._token = bot_token_provider\n    24\t\n    25\t    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:\n    26\t        payload: dict[str, Any] = {\n    27\t            \"channel\": channel,\n    28\t            \"text\": clean_outbound(text),\n    29\t            \"unfurl_links\": False,\n    30\t            \"unfurl_media\": False,\n    31\t            \"mrkdwn\": True,\n    32\t        }\n    33\t        if blocks:\n    34\t            payload[\"blocks\"] = blocks\n    35\t        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:\n    36\t            resp = await client.post(\n    37\t                f\"{self.api_url}/chat.postMessage\",\n    38\t                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\n    39\t                json=payload,\n    40\t            )\n    41\t        resp.raise_for_status()\n    42\t        body = resp.json()\n    43\t        if not body.get(\"ok\"):\n    44\t            raise RuntimeError(f\"slack error: {body.get('error')}\")\n    45\t        return {\"channel\": body[\"channel\"], \"ts\": body[\"ts\"]}\n    46\t\n    47\t    async def post_approval_request(\n    48\t        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\n    49\t    ) -> None:\n    50\t        lines = \"\\n\".join(f\"• *{k}*: `{v}`\" for k, v in summary.items())\n    51\t        text = f\"Approval needed for `{tool}` on `{target}` (expires {expires_at:%Y-%m-%d %H:%M} UTC)\\n{lines}\"\n    52\t        await self.post(\n    53\t            channel=f\"#approvals-{tenant}\",\n    54\t            text=text,\n    55\t            blocks=[\n    56\t                {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": clean_outbound(text)}},\n    57\t                {\n    58\t                    \"type\": \"actions\",\n    59\t                    \"elements\": [\n    60\t                        {\"type\": \"button\", \"action_id\": \"approve\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Approve\"}, \"style\": \"primary\"},\n    61\t                        {\"type\": \"button\", \"action_id\": \"reject\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Reject\"}, \"style\": \"danger\"},\n    62\t                    ],\n    63\t                },\n    64\t            ],\n    65\t        )\n    66\t\n    67\t\n    68\tdef tools(deps) -> list[Tool]:\n    69\t    slack: SlackClient = deps.slack\n    70\t\n    71\t    async def post_slack_message(args: dict[str, Any], ident: RunIdentity) -> Any:\n    72\t        return await slack.post(channel=args[\"channel\"], text=args[\"text\"])\n    73\t\n    74\t    return [\n    75\t        Tool(\n    76\t            name=\"post_slack_message\",\n    77\t            description=(\n    78\t                \"Post a message in Slack. Use internal channels for staff. Vendor contacts are in \"\n    79\t                \"Slack Connect channels named #vendor-<vendor_id>; set external=true for those.\"\n    80\t            ),\n    81\t            input_schema={\n    82\t                \"type\": \"object\",\n    83\t                \"properties\": {\n    84\t                    \"channel\": {\"type\": \"string\", \"maxLength\": 80},\n    85\t                    \"text\": {\"type\": \"string\", \"maxLength\": MAX_TEXT},\n    86\t                    \"external\": {\"type\": \"boolean\", \"default\": False},\n    87\t                },\n    88\t                \"required\": [\"channel\", \"text\"],\n    89\t                \"additionalProperties\": False,\n    90\t            },\n    91\t            invoke=post_slack_message,\n    92\t            target_field=\"channel\",\n    93\t        )\n    94\t    ]\n=== app/tools/documents.py\n     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tUNTRUSTED_WRAPPER = (\n    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n    11\t    \"{text}\\n\"\n    12\t    \"</untrusted_document>\"\n    13\t)\n    14\t\n    15\t\n    16\tdef tools(deps) -> list[Tool]:\n    17\t    pool = deps.pool\n    18\t\n    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n    20\t        row = await pool.fetchrow(\n    21\t            \"\"\"\n    22\t            SELECT doc_id, source, media_type, text\n    23\t            FROM documents\n    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n    25\t            \"\"\",\n    26\t            args[\"doc_id\"],\n    27\t            ident.tenant,\n    28\t        )\n    29\t        if row is None:\n    30\t            return \"document not found\"\n    31\t        return UNTRUSTED_WRAPPER.format(\n    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n    33\t        )\n    34\t\n    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n    37\t\n    38\t    return [\n    39\t        Tool(\n    40\t            name=\"read_document\",\n    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n    42\t            input_schema={\n    43\t                \"type\": \"object\",\n    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    45\t                \"required\": [\"doc_id\"],\n    46\t                \"additionalProperties\": False,\n    47\t            },\n    48\t            invoke=read_document,\n    49\t        ),\n    50\t        Tool(\n    51\t            name=\"extract_line_items\",\n    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n    53\t            input_schema={\n    54\t                \"type\": \"object\",\n    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    56\t                \"required\": [\"doc_id\"],\n    57\t                \"additionalProperties\": False,\n    58\t            },\n    59\t            invoke=extract_line_items,\n    60\t        ),\n    61\t    ]\n=== app/tools/memory.py\n     1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n     2\t\n     3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n     4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n     5\tuntil a procurement lead verifies them in the admin UI. Every row records\n     6\twho wrote it, from which run and source document, and the context size at\n     7\tthe time.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport re\n    12\timport uuid\n    13\tfrom typing import Any\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\tfrom app.tools import Tool\n    17\t\n    18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n    19\tMAX_NOTE_CHARS = 800\n    20\tINSTRUCTION_LIKE = [\n    21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n    22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n    23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n    24\t    re.compile(r\"https?://\"),\n    25\t]\n    26\t\n    27\t\n    28\tclass NoteRejected(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tdef check_note(text: str) -> None:\n    33\t    if len(text) > MAX_NOTE_CHARS:\n    34\t        raise NoteRejected(\"note too long\")\n    35\t    for pattern in INSTRUCTION_LIKE:\n    36\t        if pattern.search(text):\n    37\t            raise NoteRejected(\"note looks like an instruction\")\n    38\t\n    39\t\n    40\tdef tools(deps) -> list[Tool]:\n    41\t    pool = deps.pool\n    42\t\n    43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n    44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n    45\t        rows = await pool.fetch(\n    46\t            \"\"\"\n    47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n    48\t            FROM dept_notes\n    49\t            WHERE business_unit = $1\n    50\t              AND department = $2\n    51\t              AND NOT quarantined\n    52\t              AND (verified OR expires_at > now())\n    53\t            ORDER BY created_at DESC\n    54\t            LIMIT 20\n    55\t            \"\"\",\n    56\t            business_unit,\n    57\t            args[\"department\"],\n    58\t        )\n    59\t        return [\n    60\t            {\n    61\t                \"note_id\": r[\"note_id\"],\n    62\t                \"kind\": r[\"kind\"],\n    63\t                \"body\": r[\"body\"],\n    64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n    65\t                \"written\": r[\"created_at\"].isoformat(),\n    66\t            }\n    67\t            for r in rows\n    68\t        ]\n    69\t\n    70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n    71\t        if args[\"kind\"] not in NOTE_KINDS:\n    72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n    73\t        check_note(args[\"body\"])\n    74\t        note_id = f\"note-{uuid.uuid4()}\"\n    75\t        ctx = deps.current_context(ident)\n    76\t        await pool.execute(\n    77\t            \"\"\"\n    78\t            INSERT INTO dept_notes (\n    79\t                note_id, business_unit, department, kind, body,\n    80\t                verified, quarantined, expires_at,\n    81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n    82\t                delegated_subject, context_tokens, context_method, created_at\n    83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n    84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n    85\t            \"\"\",\n    86\t            note_id,\n    87\t            ident.tenant,\n    88\t            args[\"department\"],\n    89\t            args[\"kind\"],\n    90\t            args[\"body\"],\n    91\t            ident.agent_instance_id,\n    92\t            ident.agent_type_id,\n    93\t            ident.run_id,\n    94\t            args.get(\"source_doc_id\"),\n    95\t            ident.delegated_subject,\n    96\t            ctx.tokens,\n    97\t            ctx.method,\n    98\t        )\n    99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n   100\t\n   101\t    return [\n   102\t        Tool(\n   103\t            name=\"memory_read\",\n   104\t            description=(\n   105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n   106\t                \"shared-services staff may look up another unit's notes.\"\n   107\t            ),\n   108\t            input_schema={\n   109\t                \"type\": \"object\",\n   110\t                \"properties\": {\n   111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n   113\t                },\n   114\t                \"required\": [\"department\"],\n   115\t                \"additionalProperties\": False,\n   116\t            },\n   117\t            invoke=memory_read,\n   118\t        ),\n   119\t        Tool(\n   120\t            name=\"memory_write\",\n   121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n   122\t            input_schema={\n   123\t                \"type\": \"object\",\n   124\t                \"properties\": {\n   125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n   127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n   128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n   129\t                },\n   130\t                \"required\": [\"department\", \"kind\", \"body\"],\n   131\t                \"additionalProperties\": False,\n   132\t            },\n   133\t            invoke=memory_write,\n   134\t        ),\n   135\t    ]\n=== app/mcp_client.py\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n=== app/extractor.py\n     1\t\"\"\"Line-item extraction sub-agent.\n     2\t\n     3\tThe parent procurement agent delegates structured extraction to a smaller\n     4\tmodel. The child runs under its own instance id, links to its parent in the\n     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport json\n    10\timport logging\n    11\tfrom typing import Any\n    12\t\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom app import audit\n    16\tfrom app.budget import Budget\n    17\tfrom app.context_size import measure_context\n    18\tfrom app.identity import RunIdentity\n    19\tfrom app.redact import redact_for_model\n    20\tfrom app.tools import build_registry\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n    24\t\n    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n    26\tMAX_TURNS = 4\n    27\t\n    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n    29\t\n    30\t\n    31\tclass ExtractionFailed(Exception):\n    32\t    pass\n    33\t\n    34\t\n    35\tclass LineItemExtractor:\n    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n    37\t        self.client = client\n    38\t        self.settings = settings\n    39\t        self.deps = deps\n    40\t        self.system_prompt = system_prompt\n    41\t\n    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n    43\t        budget.check_subagent()\n    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n    47\t\n    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n    51\t            start_node = await audit.record(\n    52\t                self.deps.pool,\n    53\t                ident,\n    54\t                kind=\"subagent_started\",\n    55\t                payload={\n    56\t                    \"role\": EXTRACTOR_ROLE,\n    57\t                    \"doc_id\": doc_id,\n    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n    59\t                    \"tools\": registry.names(),\n    60\t                },\n    61\t            )\n    62\t\n    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n    64\t            for _turn in range(MAX_TURNS):\n    65\t                budget.check_step()\n    66\t                request = {\n    67\t                    \"model\": self.settings.extractor_model_id,\n    68\t                    \"system\": self.system_prompt,\n    69\t                    \"messages\": messages,\n    70\t                    \"tools\": registry.schemas(),\n    71\t                    \"max_tokens\": 4096,\n    72\t                }\n    73\t                ctx = await measure_context(self.client, request, compacted=False)\n    74\t                response = await self.client.messages.create(**request)\n    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n    76\t                await budget.flush(self.deps.pool)\n    77\t                ctx = ctx.finalize(response.usage)\n    78","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-n0y2sv85/65f8d82b-17db-4aa3-8a31-97c7d53b8832/tool-results/b3eg1dyv6.txt","persistedOutputSize":32143}}
