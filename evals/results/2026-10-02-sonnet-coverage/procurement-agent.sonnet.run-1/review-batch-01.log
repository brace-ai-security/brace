{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018LjU2xEYEbbs2j1mHMSzFK","type":"tool_result","content":"1\t\"\"\"Policy gate for tool calls.\n2\t\n3\tRuns in the harness between the model's proposed call and the integration.\n4\tHigh-impact operations are denied unless a valid approval exists; when none\n5\texists an approval request is opened and the call returns as pending.\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\tfrom dataclasses import dataclass\n10\tfrom typing import Any\n11\t\n12\tfrom app.approvals import ApprovalStore\n13\tfrom app.identity import RunIdentity\n14\t\n15\t\n16\t@dataclass(frozen=True)\n17\tclass Decision:\n18\t    allow: bool\n19\t    reason: str\n20\t    policy_version: str\n21\t    approval_id: str | None = None\n22\t    pending: bool = False\n23\t\n24\t\n25\tclass PolicyGate:\n26\t    def __init__(self, policy: dict, approvals: ApprovalStore):\n27\t        self.version: str = policy[\"version\"]\n28\t        self.high_impact: frozenset[str] = frozenset(policy[\"high_impact_tools\"])\n29\t        self.erp_read_prefixes: tuple[str, ...] = tuple(policy[\"erp\"][\"read_prefixes\"])\n30\t        self.approvals = approvals\n31\t\n32\t    async def authorize(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n33\t        if tool.name == \"erp_call\":\n34\t            operation = str(args.get(\"operation\", \"\"))\n35\t            if not operation.startswith(self.erp_read_prefixes):\n36\t                return Decision(False, f\"erp operation not permitted: {operation}\", self.version)\n37\t            return Decision(True, \"erp read operation\", self.version)\n38\t\n39\t        if tool.name == \"post_slack_message\":\n40\t            if args.get(\"external\", False):\n41\t                return await self._require_approval(ident, tool, args)\n42\t            return Decision(True, \"internal staff message\", self.version)\n43\t\n44\t        if tool.name in self.high_impact:\n45\t            return await self._require_approval(ident, tool, args)\n46\t\n47\t        return Decision(True, \"low-impact tool\", self.version)\n48\t\n49\t    async def _require_approval(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n50\t        target = tool.target_of(args)\n51\t        approval = await self.approvals.find_valid(ident, tool.name, target)\n52\t        if approval is not None:\n53\t            return Decision(True, \"approved\", self.version, approval_id=approval.id)\n54\t        approval_id = await self.approvals.request(ident, tool.name, target, args)\n55\t        return Decision(\n56\t            False,\n57\t            \"approval required; request opened\",\n58\t            self.version,\n59\t            approval_id=approval_id,\n60\t            pending=True,\n61\t        )\n62\t"}]},"parent_tool_use_id":null,"session_id":"65f8d82b-17db-4aa3-8a31-97c7d53b8832","uuid":"a2d84817-ce14-4f1e-b1af-c559e2606afd","timestamp":"2026-10-02T17:56:26.693Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-n0y2sv85/agent/app/gate.py","content":"\"\"\"Policy gate for tool calls.\n\nRuns in the harness between the model's proposed call and the integration.\nHigh-impact operations are denied unless a valid approval exists; when none\nexists an approval request is opened and the call returns as pending.\n\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import Any\n\nfrom app.approvals import ApprovalStore\nfrom app.identity import RunIdentity\n\n\n@dataclass(frozen=True)\nclass Decision:\n    allow: bool\n    reason: str\n    policy_version: str\n    approval_id: str | None = None\n    pending: bool = False\n\n\nclass PolicyGate:\n    def __init__(self, policy: dict, approvals: ApprovalStore):\n        self.version: str = policy[\"version\"]\n        self.high_impact: frozenset[str] = frozenset(policy[\"high_impact_tools\"])\n        self.erp_read_prefixes: tuple[str, ...] = tuple(policy[\"erp\"][\"read_prefixes\"])\n        self.approvals = approvals\n\n    async def authorize(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n        if tool.name == \"erp_call\":\n            operation = str(args.get(\"operation\", \"\"))\n            if not operation.startswith(self.erp_read_prefixes):\n                return Decision(False, f\"erp operation not permitted: {operation}\", self.version)\n            return Decision(True, \"erp read operation\", self.version)\n\n        if tool.name == \"post_slack_message\":\n            if args.get(\"external\", False):\n                return await self._require_approval(ident, tool, args)\n            return Decision(True, \"internal staff message\", self.version)\n\n        if tool.name in self.high_impact:\n            return await self._require_approval(ident, tool, args)\n\n        return Decision(True, \"low-impact tool\", self.version)\n\n    async def _require_approval(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n        target = tool.target_of(args)\n        approval = await self.approvals.find_valid(ident, tool.name, target)\n        if approval is not None:\n            return Decision(True, \"approved\", self.version, approval_id=approval.id)\n        approval_id = await self.approvals.request(ident, tool.name, target, args)\n        return Decision(\n            False,\n            \"approval required; request opened\",\n            self.version,\n            approval_id=approval_id,\n            pending=True,\n        )\n","numLines":62,"startLine":1,"totalLines":62}}}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011Cfdqmr466jHY7BuhN6Dvr","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WU8prUwwwsBu2ANVzkWBRJ","name":"Read","input":{"file_path":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-n0y2sv85/agent/app/loop.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3957,"cache_read_input_tokens":26782,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3957},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"65f8d82b-17db-4aa3-8a31-97c7d53b8832","uuid":"bfee30db-a5ae-461d-b7e4-fae0bcdd0a9b","timestamp":"2026-10-02T17:56:27.124Z","request_id":"req_011CfdqmqjVdGjZF9pRSXt7P","wire_tool_inputs":{"toolu_01WU8prUwwwsBu2ANVzkWBRJ":{"file_path":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-n0y2sv85/agent/app/loop.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WU8prUwwwsBu2ANVzkWBRJ","type":"tool_result","content":"1\t\"\"\"Procurement agent run loop.\n2\t\n3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n4\tEvery edge writes an audit node before the next step runs. Budgets are\n5\tchecked before each model turn and each tool call.\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\timport hashlib\n10\timport logging\n11\tfrom dataclasses import dataclass, field\n12\tfrom typing import Any\n13\t\n14\tfrom opentelemetry import trace\n15\t\n16\tfrom app import audit, killswitch\n17\tfrom app.budget import Budget, BudgetExceeded\n18\tfrom app.context_size import ContextMeasure, measure_context\n19\tfrom app.gate import PolicyGate\n20\tfrom app.identity import RunIdentity\n21\tfrom app.redact import redact_for_model\n22\tfrom app.tools import ToolRegistry, build_registry\n23\t\n24\tlog = logging.getLogger(__name__)\n25\ttracer = trace.get_tracer(\"procurement.loop\")\n26\t\n27\tCOMPACT_AFTER_MESSAGES = 40\n28\tKEEP_RECENT_MESSAGES = 12\n29\t\n30\t\n31\t@dataclass\n32\tclass AgentDeps:\n33\t    settings: Any\n34\t    pool: Any\n35\t    gate: PolicyGate\n36\t    erp: Any\n37\t    slack: Any\n38\t    broker: Any\n39\t    extractor: Any = None\n40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n42\t\n43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n44\t        return self._budgets[ident.run_id]\n45\t\n46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n48\t\n49\t    def erp_scope_for(self, operation: str) -> str:\n50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n51\t        return scopes.get(operation, \"erp.read\")\n52\t\n53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n54\t        self._contexts[ident.agent_instance_id] = ctx\n55\t        proposed = await audit.record(\n56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n58\t        )\n59\t        tool = registry.get(use.name)\n60\t        if tool is None:\n61\t            await audit.record(\n62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n64\t            )\n65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n66\t\n67\t        decision = await self.gate.authorize(ident, tool, use.input)\n68\t        authz = await audit.record(\n69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n72\t        )\n73\t        if not decision.allow:\n74\t            if decision.pending:\n75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n76\t            return _error(use.id, f\"denied: {decision.reason}\")\n77\t\n78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n79\t        try:\n80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n81\t                for k, v in ctx.otel_attributes().items():\n82\t                    span.set_attribute(k, v)\n83\t                output = await tool.invoke(use.input, ident)\n84\t        except BudgetExceeded:\n85\t            raise\n86\t        except Exception as exc:\n87\t            await audit.record(\n88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n90\t                operation_id=operation_id,\n91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n92\t            )\n93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n94\t\n95\t        await audit.record(\n96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n98\t            operation_id=operation_id,\n99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n100\t        )\n101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n102\t\n103\t\n104\tdef _error(tool_use_id: str, message: str) -> dict:\n105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n106\t\n107\t\n108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n110\t        return messages, False\n111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n112\t    while tail and tail[0][\"role\"] != \"assistant\":\n113\t        tail = tail[1:]\n114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n115\t    return head + [note] + tail, True\n116\t\n117\t\n118\tclass ProcurementAgent:\n119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n120\t        self.client = client\n121\t        self.deps = deps\n122\t        self.system_prompt = system_prompt\n123\t        self.role = role\n124\t\n125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n126\t        pool = self.deps.pool\n127\t        await killswitch.assert_running(pool, ident.tenant)\n128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n129\t        await budget.reserve_run_start(pool)\n130\t        self.deps._budgets[ident.run_id] = budget\n131\t        registry = build_registry(self.role, ident, self.deps)\n132\t\n133\t        run_node = await audit.record(\n134\t            pool, ident, kind=\"run_started\",\n135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n136\t        )\n137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n138\t        try:\n139\t            while True:\n140\t                budget.check_step()\n141\t                messages, compacted = _compact(messages)\n142\t                request = {\n143\t                    \"model\": self.deps.settings.model_id,\n144\t                    \"system\": self.system_prompt,\n145\t                    \"messages\": messages,\n146\t                    \"tools\": registry.schemas(),\n147\t                    \"max_tokens\": 4096,\n148\t                }\n149\t                ctx = await measure_context(self.client, request, compacted)\n150\t                response = await self.client.messages.create(**request)\n151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n152\t                await budget.flush(pool)\n153\t                ctx = ctx.finalize(response.usage)\n154\t                decision = await audit.record(\n155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n156\t                    payload={\n157\t                        \"requested_model\": request[\"model\"],\n158\t                        \"served_model\": response.model,\n159\t                        \"stop_reason\": response.stop_reason,\n160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n161\t                    },\n162\t                )\n163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n165\t                if not uses:\n166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n168\t                                       payload={\"final_sha256\": audit.digest(final)})\n169\t                    return final\n170\t                results = []\n171\t                for use in uses:\n172\t                    budget.check_tool_call()\n173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n174\t                messages.append({\"role\": \"user\", \"content\": results})\n175\t        except BudgetExceeded as exc:\n176\t            await audit.record(\n177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n179\t            )\n180\t            await self.deps.slack.post(\n181\t                channel=\"#procurement-agent-ops\",\n182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n183\t            )\n184\t            return None\n185\t        finally:\n186\t            self.deps._budgets.pop(ident.run_id, None)\n187\t"}]},"parent_tool_use_id":null,"session_id":"65f8d82b-17db-4aa3-8a31-97c7d53b8832","uuid":"90e2074e-235e-4ae7-9191-f5c5033a5323","timestamp":"2026-10-02T17:56:27.130Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-n0y2sv85/agent/app/loop.py","content":"\"\"\"Procurement agent run loop.\n\nGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\nEvery edge writes an audit node before the next step runs. Budgets are\nchecked before each model turn and each tool call.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport logging\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nfrom opentelemetry import trace\n\nfrom app import audit, killswitch\nfrom app.budget import Budget, BudgetExceeded\nfrom app.context_size import ContextMeasure, measure_context\nfrom app.gate import PolicyGate\nfrom app.identity import RunIdentity\nfrom app.redact import redact_for_model\nfrom app.tools import ToolRegistry, build_registry\n\nlog = logging.getLogger(__name__)\ntracer = trace.get_tracer(\"procurement.loop\")\n\nCOMPACT_AFTER_MESSAGES = 40\nKEEP_RECENT_MESSAGES = 12\n\n\n@dataclass\nclass AgentDeps:\n    settings: Any\n    pool: Any\n    gate: PolicyGate\n    erp: Any\n    slack: Any\n    broker: Any\n    extractor: Any = None\n    _budgets: dict[str, Budget] = field(default_factory=dict)\n    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n\n    def current_budget(self, ident: RunIdentity) -> Budget:\n        return self._budgets[ident.run_id]\n\n    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n\n    def erp_scope_for(self, operation: str) -> str:\n        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n        return scopes.get(operation, \"erp.read\")\n\n    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n        self._contexts[ident.agent_instance_id] = ctx\n        proposed = await audit.record(\n            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n        )\n        tool = registry.get(use.name)\n        if tool is None:\n            await audit.record(\n                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n            )\n            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n\n        decision = await self.gate.authorize(ident, tool, use.input)\n        authz = await audit.record(\n            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n            policy_version=decision.policy_version, approval_id=decision.approval_id,\n            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n        )\n        if not decision.allow:\n            if decision.pending:\n                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n            return _error(use.id, f\"denied: {decision.reason}\")\n\n        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n        try:\n            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n                for k, v in ctx.otel_attributes().items():\n                    span.set_attribute(k, v)\n                output = await tool.invoke(use.input, ident)\n        except BudgetExceeded:\n            raise\n        except Exception as exc:\n            await audit.record(\n                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n                policy_version=decision.policy_version, approval_id=decision.approval_id,\n                operation_id=operation_id,\n                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n            )\n            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n\n        await audit.record(\n            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n            policy_version=decision.policy_version, approval_id=decision.approval_id,\n            operation_id=operation_id,\n            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n        )\n        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n\n\ndef _error(tool_use_id: str, message: str) -> dict:\n    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n\n\ndef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n    if len(messages) <= COMPACT_AFTER_MESSAGES:\n        return messages, False\n    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n    while tail and tail[0][\"role\"] != \"assistant\":\n        tail = tail[1:]\n    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n    return head + [note] + tail, True\n\n\nclass ProcurementAgent:\n    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n        self.client = client\n        self.deps = deps\n        self.system_prompt = system_prompt\n        self.role = role\n\n    async def run(self, ident: RunIdentity, task: str) -> str | None:\n        pool = self.deps.pool\n        await killswitch.assert_running(pool, ident.tenant)\n        budget = Budget.for_run(self.deps.settings.budgets, ident)\n        await budget.reserve_run_start(pool)\n        self.deps._budgets[ident.run_id] = budget\n        registry = build_registry(self.role, ident, self.deps)\n\n        run_node = await audit.record(\n            pool, ident, kind=\"run_started\",\n            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n        )\n        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n        try:\n            while True:\n                budget.check_step()\n                messages, compacted = _compact(messages)\n                request = {\n                    \"model\": self.deps.settings.model_id,\n                    \"system\": self.system_prompt,\n                    \"messages\": messages,\n                    \"tools\": registry.schemas(),\n                    \"max_tokens\": 4096,\n                }\n                ctx = await measure_context(self.client, request, compacted)\n                response = await self.client.messages.create(**request)\n                budget.charge_model(self.deps.settings.model_id, response.usage)\n                await budget.flush(pool)\n                ctx = ctx.finalize(response.usage)\n                decision = await audit.record(\n                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n                    payload={\n                        \"requested_model\": request[\"model\"],\n                        \"served_model\": response.model,\n                        \"stop_reason\": response.stop_reason,\n                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n                    },\n                )\n                messages.append({\"role\": \"assistant\", \"content\": response.content})\n                uses = [b for b in response.content if b.type == \"tool_use\"]\n                if not uses:\n                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n                                       payload={\"final_sha256\": audit.digest(final)})\n                    return final\n                results = []\n                for use in uses:\n                    budget.check_tool_call()\n                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n                messages.append({\"role\": \"user\", \"content\": results})\n        except BudgetExceeded as exc:\n            await audit.record(\n                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n            )\n            await self.deps.slack.post(\n                channel=\"#procurement-agent-ops\",\n                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n            )\n            return None\n        finally:\n            self.deps._budgets.pop(ident.run_id, None)\n","numLines":187,"startLine":1,"totalLines":187}}}
