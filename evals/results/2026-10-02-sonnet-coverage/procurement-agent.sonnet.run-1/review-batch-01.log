curement-platform\n    53\t    provider: anthropic\n    54\t    model_id: \"claude-haiku-4-5-20251001\"\n    55\t    id_kind: \"pinned snapshot\"\n    56\t    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    57\t    adapter: none\n    58\t    fine_tune: none\n    59\t    training_run: \"not applicable\"\n    60\t    served_version: \"recorded per call from response.model\"\n    61\t    provider_undisclosed: [weights digest, pretraining data version]\n    62\t\n    63\tmcp_servers:\n    64\t  erp:\n    65\t    endpoint: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    66\t    owner: team-erp-integrations\n    67\t\n    68\t# Fingerprints of the approved ERP MCP tools (name, description, inputSchema,\n    69\t# annotations), computed by app.mcp_client.fingerprint.\n    70\ttool_pins:\n    71\t  budget.get_remaining: \"sha256:bc96af69ba1cfd67b5428269dc74aa3e754f4dfe2d5dfa81deb0af68819379ca\"\n    72\t  vendor.get: \"sha256:7db5e65fb6d482d06985b19b7f1fce7422398b117bc7482f0380108cd6a6a1fe\"\n    73\t  vendor.search: \"sha256:3bd5aa0908885e967ce8ee1aa22e37b4f4fba867c8eac2b4127bca626731092c\"\n    74\t  vendor.update_remit_to: \"sha256:d3d3916ee6d742311c92f4972a1ffeb0f24782e729351f3e375f13eb05b94c1b\"\n    75\t  invoice.get: \"sha256:848ece38456338a085cb7091a2bbf1024e07946d62beb32a9ee94d2fa2fa8876\"\n    76\t  invoice.list_open: \"sha256:12bb2318f3876da6421183032cdd36727e545275e8eaf6fff66451d09371f12b\"\n    77\t  invoice.mark_paid: \"sha256:3a208eb55ee3a39962316b5d25fe6ba23457380c01aa39a5469ce3691130b05a\"\n    78\t  invoice.void: \"sha256:9645bec805f2ffdfa44f698f49e8701a6487afa3cb3e3c5c44e721cb21633d4c\"\n    79\t  po.get: \"sha256:121df83a279fc2ae3764c83faeb34f3037026586991c9192144ad7b727d18d7b\"\n    80\t  po.list_open: \"sha256:203c57fd158a8edf11b8dc02be534bc805d8caaf0959db8280f59ea0e5beb70a\"\n    81\t  po.create: \"sha256:fb15c157f7d79321972b310d74ee6c88a0fc76fd8edbbe4e821dcaa95a0852c6\"\n    82\t\n    83\tbudgets: config/policy.yaml#budgets\n    84\tidentity:\n    85\t  service_account: procurement-agent\n    86\t  spiffe_id: \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    87\t  sts_audiences: [erp-mcp-gateway, payments-api, slack-proxy]\n    88\tmemory:\n    89\t  store: \"postgres procurement.dept_notes\"\n    90\t  expiry_unverified_days: 30\n    91\tretrieval: none\n=== .github/workflows/ci.yaml\n     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    16\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    17\t        with:\n    18\t          python-version: \"3.11\"\n    19\t      - run: pip install -e '.[test]'\n    20\t      - run: pytest -q\n    21\t      - name: Secret scan\n    22\t        uses: gitleaks/gitleaks-action@83373cf2f8c4db6e24b41c1a9b086bb9619e9cd3 # v2.3.7\n    23\t      - name: Manifest hashes match files\n    24\t        run: |\n    25\t          python - <<'PY'\n    26\t          import hashlib, yaml, sys\n    27\t          m = yaml.safe_load(open(\"release/manifest.yaml\"))\n    28\t          bad = []\n    29\t          for group in (\"prompts\", \"config\"):\n    30\t              for name, e in m[group].items():\n    31\t                  if isinstance(e, dict) and \"sha256\" in e:\n    32\t                      got = \"sha256:\" + hashlib.sha256(open(e[\"path\"], \"rb\").read()).hexdigest()\n    33\t                      if got != e[\"sha256\"]:\n    34\t                          bad.append(e[\"path\"])\n    35\t          if bad:\n    36\t              sys.exit(\"manifest out of date: \" + \", \".join(bad))\n    37\t          PY\n    38\t\n    39\t  release:\n    40\t    if: github.ref == 'refs/heads/main'\n    41\t    needs: test\n    42\t    runs-on: ubuntu-24.04\n    43\t    permissions:\n    44\t      contents: read\n    45\t      id-token: write\n    46\t      packages: write\n    47\t      attestations: write\n    48\t    steps:\n    49\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    50\t      - uses: sigstore/cosign-installer@dc72c7d5c4d10cd6bcb8cf6e3fd625a9e5e537da # v3.7.0\n    51\t        with:\n    52\t          cosign-release: \"v2.6.2\"\n    53\t      - uses: docker/setup-buildx-action@c47758b77c9736f4b2ef4073d4d51994fabfe349 # v3.7.1\n    54\t      - uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0\n    55\t        with:\n    56\t          registry: registry.example-corp.test\n    57\t          username: ${{ github.actor }}\n    58\t          password: ${{ secrets.GITHUB_TOKEN }}\n    59\t      - id: build\n    60\t        uses: docker/build-push-action@4f58ea79222b3b9dc2c8bbdd6debcef730109a75 # v6.9.0\n    61\t        with:\n    62\t          context: .\n    63\t          push: true\n    64\t          tags: registry.example-corp.test/procurement/agent:${{ github.sha }}\n    65\t          provenance: false\n    66\t          sbom: false\n    67\t      - name: SBOM\n    68\t        uses: anchore/sbom-action@251a468eed47e5082b105c3ba6ee500c0e65a764 # v0.17.6\n    69\t        with:\n    70\t          image: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    71\t          format: cyclonedx-json\n    72\t          output-file: sbom.cdx.json\n    73\t      - name: Sign and attest\n    74\t        env:\n    75\t          IMAGE: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    76\t        run: |\n    77\t          cosign sign --yes \"$IMAGE\"\n    78\t          cosign attest --yes --type cyclonedx --predicate sbom.cdx.json \"$IMAGE\"\n    79\t      - uses: actions/attest-build-provenance@1c608d11d69870c209