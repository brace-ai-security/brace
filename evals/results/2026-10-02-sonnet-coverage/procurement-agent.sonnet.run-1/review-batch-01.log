n    25\t        runAsUser: 65532\n    26\t        runAsGroup: 65532\n    27\t        fsGroup: 65532\n    28\t        seccompProfile:\n    29\t          type: RuntimeDefault\n    30\t      containers:\n    31\t        - name: agent\n    32\t          image: registry.example-corp.test/procurement/agent@sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\n    33\t          imagePullPolicy: IfNotPresent\n    34\t          ports:\n    35\t            - containerPort: 8080\n    36\t              name: http\n    37\t          env:\n    38\t            - name: IMAGE_DIGEST\n    39\t              value: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n    40\t            - name: MODEL_ID\n    41\t              value: \"claude-sonnet-4-5-20250929\"\n    42\t            - name: EXTRACTOR_MODEL_ID\n    43\t              value: \"claude-haiku-4-5-20251001\"\n    44\t            - name: DATABASE_URL\n    45\t              value: \"postgresql://procurement_agent@procurement-db.procurement-data.svc.cluster.local:5432/procurement?sslmode=verify-full\"\n    46\t            - name: ERP_MCP_URL\n    47\t              value: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    48\t            - name: PAYMENTS_API_URL\n    49\t              value: \"https://api.payments.example-pay.test\"\n    50\t            - name: SLACK_API_URL\n    51\t              value: \"https://slack-proxy.egress.svc.cluster.local:8443/api\"\n    52\t            - name: STS_URL\n    53\t              value: \"https://sts.identity.svc.cluster.local/oauth2/token\"\n    54\t            - name: OIDC_ISSUER\n    55\t              value: \"https://login.example-corp.test\"\n    56\t            - name: OIDC_JWKS_URL\n    57\t              value: \"https://login.example-corp.test/.well-known/jwks.json\"\n    58\t            - name: HTTPS_PROXY\n    59\t              value: \"http://egress-proxy.egress.svc.cluster.local:3128\"\n    60\t            - name: NO_PROXY\n    61\t              value: \".svc.cluster.local\"\n    62\t            - name: OTEL_EXPORTER_OTLP_ENDPOINT\n    63\t              value: \"http://otel-collector.observability.svc.cluster.local:4317\"\n    64\t            - name: OTEL_SERVICE_NAME\n    65\t              value: \"procurement-agent\"\n    66\t            - name: OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT\n    67\t              value: \"false\"\n    68\t          securityContext:\n    69\t            allowPrivilegeEscalation: false\n    70\t            privileged: false\n    71\t            readOnlyRootFilesystem: true\n    72\t            runAsNonRoot: true\n    73\t            capabilities:\n    74\t              drop: [\"ALL\"]\n    75\t            seccompProfile:\n    76\t              type: RuntimeDefault\n    77\t          resources:\n    78\t            requests:\n    79\t              cpu: 250m\n    80\t              memory: 512Mi\n    81\t            limits:\n    82\t              cpu: \"1\"\n    83\t              memory: 1Gi\n    84\t          readinessProbe:\n    85\t            httpGet:\n    86\t              path: /healthz\n    87\t              port: http\n    88\t          volumeMounts:\n    89\t            - name: workload-token\n    90\t              mountPath: /var/run/secrets/tokens\n    91\t              readOnly: true\n    92\t            - name: slack-signing\n    93\t              mountPath: /var/run/secrets/slack\n    94\t              readOnly: true\n    95\t            - name: mail-hmac\n    96\t              mountPath: /var/run/secrets/mail\n    97\t              readOnly: true\n    98\t            - name: tmp\n    99\t              mountPath: /tmp\n   100\t      volumes:\n   101\t        - name: workload-token\n   102\t          projected:\n   103\t            sources:\n   104\t              - serviceAccountToken:\n   105\t                  path: procurement-agent\n   106\t                  audience: sts.identity.example-corp.test\n   107\t                  expirationSeconds: 600\n   108\t        - name: slack-signing\n   109\t          secret:\n   110\t            secretName: procurement-slack-signing\n   111\t        - name: mail-hmac\n   112\t          secret:\n   113\t            secretName: procurement-mail-gateway-hmac\n   114\t        - name: tmp\n   115\t          emptyDir:\n   116\t            medium: Memory\n   117\t            sizeLimit: 64Mi\n=== deploy/k8s/kyverno-verify-images.yaml\n     1\tapiVersion: kyverno.io/v1\n     2\tkind: ClusterPolicy\n     3\tmetadata:\n     4\t  name: procurement-verify-images\n     5\t  annotations:\n     6\t    policies.kyverno.io/title: Verify procurement agent images\n     7\t    kyverno.io/kyverno-version: \"1.15.2\"\n     8\tspec:\n     9\t  validationFailureAction: Enforce\n    10\t  background: false\n    11\t  webhookTimeoutSeconds: 15\n    12\t  failurePolicy: Fail\n    13\t  rules:\n    14\t    - name: only-approved-registry\n    15\t      match:\n    16\t        any:\n    17\t          - resources:\n    18\t              kinds: [Pod]\n    19\t              namespaces: [procurement-prod]\n    20\t      validate:\n    21\t        message: \"Images in procurement-prod must come from registry.example-corp.test/procurement and be pinned by digest.\"\n    22\t        pattern:\n    23\t          spec:\n    24\t            =(initContainers):\n    25\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n    26\t            containers:\n    27\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n    28\t    - name: verify-signature-and-provenance\n    29\t      match:\n    30\t        any:\n    31\t          - resources:\n    32\t              kinds: [Pod]\n    33\t              namespaces: [procurement-prod]\n    34\t      verifyImages:\n    35\t        - imageReferences:\n    36\t            - \"registry.example-corp.test/procurement/*\"\n    37\t          mutateDigest: false\n    38\t          verifyDigest: true\n    39\t          required: true\n    40\t          attestors:\n    41\t            - entries:\n    42\t                - keyless:\n    43\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    44\t                    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    45\t                    rekor:\n    46\t                      url: https://rekor.sigstore.dev\n    47\t          attestations:\n    48\t            - type: https://slsa.dev/provenance/v1\n    49\t              attestors:\n    50\t                - entries:\n    51\t                    - keyless:\n    52\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    53\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    54\t              conditions:\n    55\t                - all:\n    56\t                    - key: \"{{ buildDefinition.buildType }}\"\n    57\t                      operator: Equals\n    58\t                      value: \"https://actions.github.io/buildtypes/workflow/v1\"\n    59\t                    - key: \"{{ buildDefinition.externalParameters.workflow.repository }}\"\n    60\t                      operator: Equals\n    61\t                      value: \"https://github.com/example-corp/procurement-agent\"\n    62\t                    - key: \"{{ buildDefinition.externalParameters.workflow.ref }}\"\n    63\t                      operator: Equals\n    64\t                      value: \"refs/heads/main\"\n    65\t                    - key: \"{{ buildDefinition.externalParameters.workflow.path }}\"\n    66\t                      operator: Equals\n    67\t                      value: \".github/workflows/ci.yaml\"\n    68\t                    - key: \"{{ runDetails.builder.id }}\"\n    69\t                      operator: Equals\n    70\t                      value: \"https://github.com/actions/runner/github-hosted\"\n    71\t            - type: https://cyclonedx.org/bom\n    72\t              attestors:\n    73\t                - entries:\n    74\t                    - keyless:\n    75\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    76\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n=== deploy/k8s/networkpolicy.yaml\n     1\tapiVersion: networking.k8s.io/v1\n     2\tkind: NetworkPolicy\n     3\tmetadata:\n     4\t  name: procurement-agent-default-deny\n     5\t  namespace: procurement-prod\n     6\tspec:\n     7\t  podSelector: {}\n     8\t  policyTypes: [\"Ingress\", \"Egress\"]\n     9\t---\n    10\tapiVersion: networking.k8s.io/v1\n    11\tkind: NetworkPolicy\n    12\tmetadata:\n    13\t  name: procurement-agent-egress\n    14\t  namespace: procurement-prod\n    15\tspec:\n    16\t  podSelector:\n    17\t    matchLabels:\n    18\t      app: procurement-agent\n    19\t  policyTypes: [\"Egress\"]\n    20\t  egress:\n    21\t    - to:\n    22\t        - namespaceSelector:\n    23\t            matchLabels:\n    24\t              kubernetes.io/metadata.name: kube-system\n    25\t          podSelector:\n    26\t            matchLabels:\n    27\t              k8s-app: kube-dns\n    28\t      ports:\n    29\t        - { protocol: UDP, port: 53 }\n    30\t        - { protocol: TCP, port: 53 }\n    31\t    - to:\n    32\t        - namespaceSelector:\n    33\t            matchLabels:\n    34\t              kubernetes.io/metadata.name: egress\n    35\t          podSelector:\n    36\t            matchLabels:\n    37\t              app: egress-proxy\n    38\t      ports:\n    39\t        - { protocol: TCP, port: 3128 }\n    40\t    - to:\n    41\t        - namespaceSelector:\n    42\t            matchLabels:\n    43\t              kubernetes.io/metadata.name: egress\n    44\t          podSelector:\n    45\t            matchLabels:\n    46\t              app: slack-proxy\n    47\t      ports:\n    48\t        - { protocol: TCP, port: 8443 }\n    49\t    - to:\n    50\t        - namespaceSelector:\n    51\t            matchLabels:\n    52\t              kubernetes.io/metadata.name: procurement-data\n    53\t          podSelector:\n    54\t            matchLabels:\n    55\t              app: procurement-db\n    56\t      ports:\n    57\t        - { protocol: TCP, port: 5432 }\n    58\t    - to:\n    59\t        - namespaceSelector:\n    60\t            matchLabels:\n    61\t              kubernetes.io/metadata.name: erp-mcp-gateway\n    62\t      ports:\n    63\t        - { protocol: TCP, port: 8443 }\n    64\t    - to:\n    65\t        - namespaceSelector:\n    66\t            matchLabels:\n    67\t              kubernetes.io/metadata.name: identity\n    68\t          podSelector:\n    69\t            matchLabels:\n    70\t              app: sts\n    71\t      ports:\n    72\t        - { protocol: TCP, port: 443 }\n    73\t    - to:\n    74\t        - ipBlock:\n    75\t            cidr: 0.0.0.0/0\n    76\t            except:\n    77\t              - 10.0.0.0/8\n    78\t              - 172.16.0.0/12\n    79\t              - 192.168.0.0/16\n    80\t              - 169.254.0.0/16\n    81\t      ports:\n    82\t        - { protocol: TCP, port: 443 }\n    83\t---\n    84\tapiVersion: networking.k8s.io/v1\n    85\tkind: NetworkPolicy\n    86\tmetadata:\n    87\t  name: procurement-agent-ingress\n    88\t  namespace: procurement-prod\n    89\tspec:\n    90\t  podSelector:\n    91\t    matchLabels:\n    92\t      app: procurement-agent\n    93\t  policyTypes: [\"Ingress\"]\n    94\t  ingress:\n    95\t    - from:\n    96\t        - namespaceSelector:\n    97\t            matchLabels:\n    98\t              kubernetes.io/metadata.name: ingress\n    99\t      ports:\n   100\t        - { protocol: TCP, port: 8080 }\n   101\t---\n   102\t# Egress proxy allowlist (applied in the egress namespace by the platform team).\n   103\tapiVersion: v1\n   104\tkind: ConfigMap\n   105\tmetadata:\n   106\t  name: egress-proxy-allowlist-procurement\n   107\t  namespace: egress\n   108\tdata:\n   109\t  allowlist.txt: |\n   110\t    api.anthropic.com\n   111\t    api.payments.example-pay.test\n   112\t    login.example-corp.test\n=== deploy/k8s/serviceaccount.yaml\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: procurement-prod\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: latest\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: procurement-agent\n    15\t  namespace: procurement-prod\n    16\t  labels:\n    17\t    app: procurement-agent\n    18\tautomountServiceAccountToken: false\n=== migrations/001_init.sql\n     1\t-- Procurement agent schema. Applied by the migration job with the\n     2\t-- procurement_owner role; the running agent connects as procurement_agent.\n     3\t\n     4\tCREATE TABLE audit_events (\n     5\t    node_id             text PRIMARY KEY,\n     6\t    parent_node_id      text REFERENCES audit_events (node_id),\n     7\t    run_id              text NOT NULL,\n     8\t    ts                  timestamptz NOT NULL,\n     9\t    kind                text NOT NULL,\n    10\t    accountable_party   text NOT NULL CHECK (accountable_party <> ''),\n    11\t    operational_owner   text NOT NULL CHECK (operational_owner <> ''),\n    12\t    tenant              text NOT NULL CHECK (tenant <> ''),\n    13\t    agent_type_id       text NOT NULL CHECK (agent_type_id <> ''),\n    14\t    agent_instance_id   text NOT NULL CHECK (agent_instance_id <> ''),\n    15\t    trace_id            text NOT NULL CHECK (trace_id <> ''),\n    16\t    span_id             text,\n    17\t    delegated_subject   text NOT NULL,\n    18\t    agent_principal     text NOT NULL,\n    19\t    parent_instance_id  text,\n    20\t    policy_version      text,\n    21\t    approval_id         text,\n    22\t    operation_id        text,\n    23\t    context_tokens      integer CHECK (context_tokens IS NULL OR context_tokens > 0),\n    24\t    context_method      text NOT NULL,\n    25\t    context_compacted   boolean NOT NULL,\n    26\t    payload             jsonb NOT NULL\n    27\t);\n    28\tCREATE INDEX audit_events_run ON audit_events (run_id, ts);\n    29\tCREATE INDEX audit_events_instance ON audit_events (agent_instance_id, ts);\n    30\tCREATE INDEX audit_events_trace ON audit_events (trace_id);\n    31\t\n    32\tCREATE TABLE approvals (\n    33\t    id                     text PRIMARY KEY,\n    34\t    tool                   text NOT NULL,\n    35\t    target                 text NOT NULL,\n    36\t    args_sha256            text NOT NULL,\n    37\t    args_summary           jsonb NOT NULL,\n    38\t    tenant                 text NOT NULL,\n    39\t    requested_by_instance  text NOT NULL,\n    40\t    requested_by_run       text NOT NULL,\n    41\t    delegated_subject      text NOT NULL,\n    42\t    status                 text NOT NULL CHECK (status IN ('pending', 'approved', 'rejected', 'expired')),\n    43\t    requested_at           timestamptz NOT NULL,\n    44\t    expires_at             timestamptz NOT NULL,\n    45\t    approver               text,\n    46\t    approver_role          text,\n    47\t    decided_at             timestamptz\n    48\t);\n    49\tCREATE INDEX approvals_lookup ON approvals (tool, target, tenant, status);\n    50\t\n    51\tCREATE TABLE approvers (\n    52\t    slack_user_id  text PRIMARY KEY,\n    53\t    email          text NOT NULL,\n    54\t    role           text NOT NULL,\n    55\t    business_unit  text NOT NULL,\n    56\t    active         boolean NOT NULL DEFAULT true\n    57\t);\n    58\t\n    59\tCREATE TABLE documents (\n    60\t    doc_id         text PRIMARY KEY,\n    61\t    business_unit  text NOT NULL,\n    62\t    source         text NOT NULL,\n    63\t    media_type     text NOT NULL,\n    64\t    sha256         text NOT NULL,\n    65\t    status         text NOT NULL CHECK (status IN ('accepted', 'quarantined')),\n    66\t    reject_reason  text,\n    67\t    text           text,\n    68\t    received_at    timestamptz NOT NULL\n    69\t);\n    70\tCREATE INDEX documents_bu ON documents (business_unit, doc_id);\n    71\t\n    72\tCREATE TABLE dept_notes (\n    73\t    note_id            text PRIMARY KEY,\n    74\t    business_unit      text NOT NULL,\n    75\t    department         text NOT NULL,\n    76\t    kind               text NOT NULL,\n    77\t    body               text NOT NULL,\n    78\t    verified           boolean NOT NULL DEFAULT false,\n    79\t    verified_by        text,\n    80\t    quarantined        boolean NOT NULL DEFAULT false,\n    81\t    expires_at         timestamptz,\n    82\t    writer_instance    text NOT NULL,\n    83\t    writer_type_id     text NOT NULL,\n    84\t    run_id             text NOT NULL,\n    85\t    source_doc_id      text,\n    86\t    delegated_subject  text NOT NULL,\n    87\t    context_tokens     integer,\n    88\t    context_method     text NOT NULL,\n    89\t    created_at         timestamptz NOT NULL\n    90\t);\n    91\tCREATE INDEX dept_notes_lookup ON dept_notes (business_unit, department, created_at DESC);\n    92\tCREATE INDEX dept_notes_source ON dept_notes (source_doc_id);\n    93\tCREATE INDEX dept_notes_writer ON dept_notes (writer_instance);\n    94\t\n    95\tCREATE TABLE control_flags (\n    96\t    scope    text PRIMARY KEY,           -- 'fleet' or 'tenant:<business_unit>'\n    97\t    halted   boolean NOT NULL,\n    98\t    reason   text NOT NULL,\n    99\t    set_by   text NOT NULL,\n   100\t    set_at   timestamptz NOT NULL DEFAULT now()\n   101\t);\n   102\t\n   103\tCREATE TABLE spend_quota (\n   104\t    scope      text NOT NULL,\n   105\t    key        text NOT NULL,\n   106\t    day        date NOT NULL,\n   107\t    spent_usd  numeric(12, 4) NOT NULL,\n   108\t    PRIMARY KEY (scope, key, day)\n   109\t);\n   110\t\n   111\tCREATE TABLE run_start_window (\n   112\t    scope   text NOT NULL,\n   113\t    key     text NOT NULL,\n   114\t    minute  timestamptz NOT NULL,\n   115\t    starts  integer NOT NULL,\n   116\t    PRIMARY KEY (scope, key, minute)\n   117\t);\n   118\t\n   119\t-- Runtime role: append-only audit, no access to control flags beyond reading.\n   120\tREVOKE ALL ON ALL TABLES IN SCHEMA public FROM procurement_agent;\n   121\tGRANT SELECT, INSERT ON audit_events TO procurement_agent;\n   122\tGRANT SELECT, INSERT, UPDATE ON approvals TO procurement_agent;\n   123\tGRANT SELECT ON approvers TO procurement_agent;\n   124\tGRANT SELECT, INSERT ON documents TO procurement_agent;\n   125\tGRANT SELECT, INSERT ON dept_notes TO procurement_agent;\n   126\tGRANT SELECT ON control_flags TO procurement_agent;\n   127\tGRANT SELECT, INSERT, UPDATE ON spend_quota TO procurement_agent;\n   128\tGRANT SELECT, INSERT, UPDATE ON run_start_window TO procurement_agent;\n   129\t\n   130\t-- Operators: halt and resume.\n   131\tGRANT SELECT, INSERT, UPDATE ON control_flags TO procurement_ops;\n   132\tGRANT SELECT ON audit_events TO procurement_ops;\n   133\tGRANT SELECT, UPDATE (verified, verified_by, quarantined) ON dept_notes TO procurement_ops;\n=== release/manifest.yaml\n     1\t# Release manifest for the procurement agent. Regenerated by CI on every\n     2\t# release build (see .github/workflows/ci.yaml, job \"release\").\n     3\trelease: \"procurement-agent 2026.09.4\"\n     4\towner: team-procurement-platform\n     5\t\n     6\timage:\n     7\t  repository: registry.example-corp.test/procurement/agent\n     8\t  digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n     9\t  sbom: \"registry.example-corp.test/procurement/agent:sha256-7c1