  8\t\n118\t     9\tfrom app.identity import RunIdentity\n119\t    10\tfrom app.tools import Tool\n120\t    11\t\n121\t    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n122\t    13\tPAYMENTS_SCOPE = \"payments.create\"\n123\t    14\t\n124\t    15\t\n125\t    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n126\t    17\t    raw = \"|\".join(\n127\t    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n128\t    19\t    )\n129\t    20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n130\t    21\t\n131\t    22\t\n132\t    23\tdef tools(deps) -> list[Tool]:\n133\t    24\t    settings = deps.settings\n134\t    25\t\n135\t    26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n136\t    27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n137\t    28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n138\t    29\t            resp = await client.post(\n139\t    30\t                f\"{settings.payments_api_url}/v2/payments\",\n140\t    31\t                headers={\n141\t    32\t                    \"Authorization\": f\"Bearer {token}\",\n142\t    33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n143\t    34\t                },\n144\t    35\t                json={\n145\t    36\t                    \"business_unit\": ident.tenant,\n146\t    37\t                    \"invoice_reference\": args[\"invoice_id\"],\n147\t    38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n148\t    39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n149\t    40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n150\t    41\t                },\n151\t    42\t            )\n152\t    43\t        resp.raise_for_status()\n153\t    44\t        body = resp.json()\n154\t    45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n155\t    46\t\n156\t    47\t    return [\n157\t    48\t        Tool(\n158\t    49\t            name=\"pay_invoice\",\n159\t    50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n160\t    51\t            input_schema={\n161\t    52\t                \"type\": \"object\",\n162\t    53\t                \"properties\": {\n163\t    54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n164\t    55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n165\t    56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n166\t    57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n167\t    58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n168\t    59\t                },\n169\t    60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n170\t    61\t                \"additionalProperties\": False,\n171\t    62\t            },\n172\t    63\t            invoke=pay_invoice,\n173\t    64\t            target_field=\"invoice_id\",\n174\t    65\t        )\n175\t    66\t    ]\n176\t=== app/tools/slack.py\n177\t     1\t\"\"\"Slack tool: message staff and vendors, plus the approvals notifier.\"\"\"\n178\t     2\tfrom __future__ import annotations\n179\t     3\t\n180\t     4\tfrom datetime import datetime\n181\t     5\tfrom typing import Any\n182\t     6\t\n183\t     7\timport httpx\n184\t     8\t\n185\t     9\tfrom app.identity import RunIdentity\n186\t    10\tfrom app.redact import redact_text, strip_unapproved_links\n187\t    11\tfrom app.tools import Tool\n188\t    12\t\n189\t    13\tMAX_TEXT = 3000\n190\t    14\t\n191\t    15\t\n192\t    16\tdef clean_outbound(text: str) -> str:\n193\t    17\t    return strip_unapproved_links(redact_text(text))[:MAX_TEXT]\n194\t    18\t\n195\t    19\t\n196\t    20\tclass SlackClient:\n197\t    21\t    def __init__(self, api_url: str, bot_token_provider):\n198\t    22\t        self.api_url = api_url\n199\t    23\t        self._token = bot_token_provider\n200\t    24\t\n201\t    25\t    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:\n202\t    26\t        payload: dict[str, Any] = {\n203\t    27\t            \"channel\": channel,\n204\t    28\t            \"text\": clean_outbound(text),\n205\t    29\t            \"unfurl_links\": False,\n206\t    30\t            \"unfurl_media\": False,\n207\t    31\t            \"mrkdwn\": True,\n208\t    32\t        }\n209\t    33\t        if blocks:\n210\t    34\t            payload[\"blocks\"] = blocks\n211\t    35\t        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:\n212\t    36\t            resp = await client.post(\n213\t    37\t                f\"{self.api_url}/chat.postMessage\",\n214\t    38\t                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\n215\t    39\t                json=payload,\n216\t    40\t            )\n217\t    41\t        resp.raise_for_status()\n218\t    42\t        body = resp.json()\n219\t    43\t        if not body.get(\"ok\"):\n220\t    44\t            raise RuntimeError(f\"slack error: {body.get('error')}\")\n221\t    45\t        return {\"channel\": body[\"channel\"], \"ts\": body[\"ts\"]}\n222\t    46\t\n223\t    47\t    async def post_approval_request(\n224\t    48\t        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\n225\t    49\t    ) -> None:\n226\t    50\t        lines = \"\\n\".join(f\"• *{k}*: `{v}`\" for k, v in summary.items())\n227\t    51\t        text = f\"Approval needed for `{tool}` on `{target}` (expires {expires_at:%Y-%m-%d %H:%M} UTC)\\n{lines}\"\n228\t    52\t        await self.post(\n229\t    53\t            channel=f\"#approvals-{tenant}\",\n230\t    54\t            text=text,\n231\t    55\t            blocks=[\n232\t    56\t                {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": clean_outbound(text)}},\n233\t    57\t                {\n234\t    58\t                    \"type\": \"actions\",\n235\t    59\t                    \"elements\": [\n236\t    60\t                        {\"type\": \"button\", \"action_id\": \"approve\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Approve\"}, \"style\": \"primary\"},\n237\t    61\t                        {\"type\": \"button\", \"action_id\": \"reject\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Reject\"}, \"style\": \"danger\"},\n238\t    62\t                    ],\n239\t    63\t                },\n240\t    64\t            ],\n241\t    65\t        )\n242\t    66\t\n243\t    67\t\n244\t    68\tdef tools(deps) -> list[Tool]:\n245\t    69\t    slack: SlackClient = deps.slack\n246\t    70\t\n247\t    71\t    async def post_slack_message(args: dict[str, Any], ident: RunIdentity) -> Any:\n248\t    72\t        return await slack.post(channel=args[\"channel\"], text=args[\"text\"])\n249\t    73\t\n250\t    74\t    return [\n251\t    75\t        Tool(\n252\t    76\t            name=\"post_slack_message\",\n253\t    77\t            description=(\n254\t    78\t                \"Post a message in Slack. Use internal channels for staff. Vendor contacts are in \"\n255\t    79\t                \"Slack Connect channels named #vendor-<vendor_id>; set external=true for those.\"\n256\t    80\t            ),\n257\t    81\t            input_schema={\n258\t    82\t                \"type\": \"object\",\n259\t    83\t                \"properties\": {\n260\t    84\t                    \"channel\": {\"type\": \"string\", \"maxLength\": 80},\n261\t    85\t                    \"text\": {\"type\": \"string\", \"maxLength\": MAX_TEXT},\n262\t    86\t                    \"external\": {\"type\": \"boolean\", \"default\": False},\n263\t    87\t                },\n264\t    88\t                \"required\": [\"channel\", \"text\"],\n265\t    89\t                \"additionalProperties\": False,\n266\t    90\t            },\n267\t    91\t            invoke=post_slack_message,\n268\t    92\t            target_field=\"channel\",\n269\t    93\t        )\n270\t    94\t    ]\n271\t=== app/tools/documents.py\n272\t     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n273\t     2\tfrom __future__ import annotations\n274\t     3\t\n275\t     4\tfrom typing import Any\n276\t     5\t\n277\t     6\tfrom app.identity import RunIdentity\n278\t     7\tfrom app.tools import Tool\n279\t     8\t\n280\t     9\tUNTRUSTED_WRAPPER = (\n281\t    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n282\t    11\t    \"{text}\\n\"\n283\t    12\t    \"</untrusted_document>\"\n284\t    13\t)\n285\t    14\t\n286\t    15\t\n287\t    16\tdef tools(deps) -> list[Tool]:\n288\t    17\t    pool = deps.pool\n289\t    18\t\n290\t    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n291\t    20\t        row = await pool.fetchrow(\n292\t    21\t            \"\"\"\n293\t    22\t            SELECT doc_id, source, media_type, text\n294\t    23\t            FROM documents\n295\t    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n296\t    25\t            \"\"\",\n297\t    26\t            args[\"doc_id\"],\n298\t    27\t            ident.tenant,\n299\t    28\t        )\n300\t    29\t        if row is None:\n301\t    30\t            return \"document not found\"\n302\t    31\t        return UNTRUSTED_WRAPPER.format(\n303\t    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n304\t    33\t        )\n305\t    34\t\n306\t    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n307\t    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n308\t    37\t\n309\t    38\t    return [\n310\t    39\t        Tool(\n311\t    40\t            name=\"read_document\",\n312\t    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n313\t    42\t            input_schema={\n314\t    43\t                \"type\": \"object\",\n315\t    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n316\t    45\t                \"required\": [\"doc_id\"],\n317\t    46\t                \"additionalProperties\": False,\n318\t    47\t            },\n319\t    48\t            invoke=read_document,\n320\t    49\t        ),\n321\t    50\t        Tool(\n322\t    51\t            name=\"extract_line_items\",\n323\t    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n324\t    53\t            input_schema={\n325\t    54\t                \"type\": \"object\",\n326\t    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n327\t    56\t                \"required\": [\"doc_id\"],\n328\t    57\t                \"additionalProperties\": False,\n329\t    58\t            },\n330\t    59\t            invoke=extract_line_items,\n331\t    60\t        ),\n332\t    61\t    ]\n333\t=== app/tools/memory.py\n334\t     1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n335\t     2\t\n336\t     3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n337\t     4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n338\t     5\tuntil a procurement lead verifies them in the admin UI. Every row records\n339\t     6\twho wrote it, from which run and source document, and the context size at\n340\t     7\tthe time.\n341\t     8\t\"\"\"\n342\t     9\tfrom __future__ import annotations\n343\t    10\t\n344\t    11\timport re\n345\t    12\timport uuid\n346\t    13\tfrom typing import Any\n347\t    14\t\n348\t    15\tfrom app.identity import RunIdentity\n349\t    16\tfrom app.tools import Tool\n350\t    17\t\n351\t    18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n352\t    19\tMAX_NOTE_CHARS = 800\n353\t    20\tINSTRUCTION_LIKE = [\n354\t    21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n355\t    22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n356\t    23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n357\t    24\t    re.compile(r\"https?://\"),\n358\t    25\t]\n359\t    26\t\n360\t    27\t\n361\t    28\tclass NoteRejected(Exception):\n362\t    29\t    pass\n363\t    30\t\n364\t    31\t\n365\t    32\tdef check_note(text: str) -> None:\n366\t    33\t    if len(text) > MAX_NOTE_CHARS:\n367\t    34\t        raise NoteRejected(\"note too long\")\n368\t    35\t    for pattern in INSTRUCTION_LIKE:\n369\t    36\t        if pattern.search(text):\n370\t    37\t            raise NoteRejected(\"note looks like an instruction\")\n371\t    38\t\n372\t    39\t\n373\t    40\tdef tools(deps) -> list[Tool]:\n374\t    41\t    pool = deps.pool\n375\t    42\t\n376\t    43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n377\t    44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n378\t    45\t        rows = await pool.fetch(\n379\t    46\t            \"\"\"\n380\t    47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n381\t    48\t            FROM dept_notes\n382\t    49\t            WHERE business_unit = $1\n383\t    50\t              AND department = $2\n384\t    51\t              AND NOT quarantined\n385\t    52\t              AND (verified OR expires_at > now())\n386\t    53\t            ORDER BY created_at DESC\n387\t    54\t            LIMIT 20\n388\t    55\t            \"\"\",\n389\t    56\t            business_unit,\n390\t    57\t            args[\"department\"],\n391\t    58\t        )\n392\t    59\t        return [\n393\t    60\t            {\n394\t    61\t                \"note_id\": r[\"note_id\"],\n395\t    62\t                \"kind\": r[\"kind\"],\n396\t    63\t                \"body\": r[\"body\"],\n397\t    64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n398\t    65\t                \"written\": r[\"created_at\"].isoformat(),\n399\t    66\t            }\n400\t    67\t            for r in rows\n401\t    68\t        ]\n402\t    69\t\n403\t    70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n404\t    71\t        if args[\"kind\"] not in NOTE_KINDS:\n405\t    72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n406\t    73\t        check_note(args[\"body\"])\n407\t    74\t        note_id = f\"note-{uuid.uuid4()}\"\n408\t    75\t        ctx = deps.current_context(ident)\n409\t    76\t        await pool.execute(\n410\t    77\t            \"\"\"\n411\t    78\t            INSERT INTO dept_notes (\n412\t    79\t                note_id, business_unit, department, kind, body,\n413\t    80\t                verified, quarantined, expires_at,\n414\t    81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n415\t    82\t                delegated_subject, context_tokens, context_method, created_at\n416\t    83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n417\t    84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n418\t    85\t            \"\"\",\n419\t    86\t            note_id,\n420\t    87\t            ident.tenant,\n421\t    88\t            args[\"department\"],\n422\t    89\t            args[\"kind\"],\n423\t    90\t            args[\"body\"],\n424\t    91\t            ident.agent_instance_id,\n425\t    92\t            ident.agent_type_id,\n426\t    93\t            ident.run_id,\n427\t    94\t            args.get(\"source_doc_id\"),\n428\t    95\t            ident.delegated_subject,\n429\t    96\t            ctx.tokens,\n430\t    97\t            ctx.method,\n431\t    98\t        )\n432\t    99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n433\t   100\t\n434\t   101\t    return [\n435\t   102\t        Tool(\n436\t   103\t            name=\"memory_read\",\n437\t   104\t            description=(\n438\t   105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n439\t   106\t                \"shared-services staff may look up another unit's notes.\"\n440\t   107\t            ),\n441\t   108\t            input_schema={\n442\t   109\t                \"type\": \"object\",\n443\t   110\t                \"properties\": {\n444\t   111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n445\t   112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n446\t   113\t                },\n447\t   114\t                \"required\": [\"department\"],\n448\t   115\t                \"additionalProperties\": False,\n449\t   116\t            },\n450\t   117\t            invoke=memory_read,\n451\t   118\t        ),\n452\t   119\t        Tool(\n453\t   120\t            name=\"memory_write\",\n454\t   121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n455\t   122\t            input_schema={\n456\t   123\t                \"type\": \"object\",\n457\t   124\t                \"properties\": {\n458\t   125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n459\t   126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n460\t   127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n461\t   128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n462\t   129\t                },\n463\t   130\t                \"required\": [\"department\", \"kind\", \"body\"],\n464\t   131\t                \"additionalProperties\": False,\n465\t   132\t            },\n466\t   133\t            invoke=memory_write,\n467\t   134\t        ),\n468\t   135\t    ]\n469\t=== app/mcp_client.py\n470\t     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n471\t     2\t\n472\t     3\tOn startup the tool list is fetched and each tool's description and input\n473\t     4\tschema are fingerprinted and compared with the pins in the release manifest.\n474\t     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n475\t     6\tinstruction-like content before any of it is shown to the model.\n476\t     7\t\"\"\"\n477\t     8\tfrom __future__ import annotations\n478\t     9\t\n479\t    10\timport hashlib\n480\t    11\timport json\n481\t    12\timport logging\n482\t    13\timport re\n483\t    14\timport uuid\n484\t    15\tfrom typing import Any\n485\t    16\t\n486\t    17\timport httpx\n487\t    18\t\n488\t    19\tfrom app.identity import RunIdentity, TokenBroker\n489\t    20\tfrom app.redact import redact_text\n490\t    21\t\n491\t    22\tlog = logging.getLogger(__name__)\n492\t    23\t\n493\t    24\tMAX_DESCRIPTION_CHARS = 1024\n494\t    25\tSUSPICIOUS_METADATA = [\n495\t    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n496\t    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n497\t    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n498\t    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n499\t    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n500\t    31\t]\n501\t    32\t\n502\t    33\t\n503\t    34\tclass ToolPinMismatch(Exception):\n504\t    35\t    pass\n505\t    36\t\n506\t    37\t\n507\t    38\tclass UnknownErpOperation(Exception):\n508\t    39\t    pass\n509\t    40\t\n510\t    41\t\n511\t    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n512\t    43\t    material = {\n513\t    44\t        \"name\": tool[\"name\"],\n514\t    45\t        \"description\": tool.get(\"description\", \"\"),\n515\t    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n516\t    47\t        \"annotations\": tool.get(\"annotations\", {}),\n517\t    48\t    }\n518\t    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n519\t    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n520\t    51\t\n521\t    52\t\n522\t    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n523\t    54\t    description = tool.get(\"description\", \"\")\n524\t    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n525\t    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n526\t    57\t    blob = json.dumps(tool, ensure_ascii=False)\n527\t    58\t    for pattern in SUSPICIOUS_METADATA:\n528\t    59\t        if pattern.search(blob):\n529\t    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n530\t    61\t\n531\t    62\t\n532\t    63\tclass ErpMcpClient:\n533\t    64\t    AUDIENCE = \"erp-mcp-gateway\"\n534\t    65\t\n535\t    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n536\t    67\t        self.url = url\n537\t    68\t        self.pins = pins\n538\t    69\t        self.broker = broker\n539\t    70\t        self._tools: dict[str, dict[str, Any]] = {}\n540\t    71\t\n541\t    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n542\t    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n543\t    74\t            resp = await client.post(\n544\t    75\t                self.url,\n545\t    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n546\t    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n547\t    78\t            )\n548\t    79\t        resp.raise_for_status()\n549\t    80\t        if len(resp.content) > 512_000:\n550\t    81\t            raise ValueError(\"erp response too large\")\n551\t    82\t        body = resp.json()\n552\t    83\t        if \"error\" in body:\n553\t    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n554\t    85\t        return body[\"result\"]\n555\t    86\t\n556\t    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n557\t    88\t        result = await self._rpc(\"tools/list\", {}, token)\n558\t    89\t        return list(result.get(\"tools\", []))\n559\t    90\t\n560\t    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n561\t    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n562\t    93\t        tools = await self._list_tools(token)\n563\t    94\t        for tool in tools:\n564\t    95\t            expected = self.pins.get(tool[\"name\"])\n565\t    96\t            actual = fingerprint(tool)\n566\t    97\t            if expected != actual:\n567\t    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n568\t    99\t            scan_metadata(tool)\n569\t   100\t        self._tools = {t[\"name\"]: t for t in tools}\n570\t   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n571\t   102\t\n572\t   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n573\t   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n574\t   105\t            await self.refresh_tools(service_ident)\n575\t   106\t\n576\t   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n577\t   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n578\t   109\t        tools = await self._list_tools(token)\n579\t   110\t        self._tools = {t[\"name\"]: t for t in tools}\n580\t   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n581\t   112\t\n582\t   113\t    def operations(self) -> list[str]:\n583\t   114\t        return sorted(self._tools)\n584\t   115\t\n585\t   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n586\t   117\t        if operation not in self._tools:\n587\t   118\t            raise UnknownErpOperation(operation)\n588\t   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n589\t   120\t        result = await self._rpc(\n590\t   121\t            \"tools/call\",\n591\t   122\t            {\n592\t   123\t                \"name\": operation,\n593\t   124\t                \"arguments\": arguments,\n594\t   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n595\t   126\t            },\n596\t   127\t            token,\n597\t   128\t        )\n598\t   129\t        if result.get(\"isError\"):\n599\t   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n600\t   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n601\t=== app/extractor.py\n602\t     1\t\"\"\"Line-item extraction sub-agent.\n603\t     2\t\n604\t     3\tThe parent procurement agent delegates structured extraction to a smaller\n605\t     4\tmodel. The child runs under its own instance id, links to its parent in the\n606\t     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n607\t     6\t\"\"\"\n608\t     7\tfrom __future__ import annotations\n609\t     8\t\n610\t     9\timport json\n611\t    10\timport logging\n612\t    11\tfrom typing import Any\n613\t    12\t\n614\t    13\tfrom opentelemetry import trace\n615\t    14\t\n616\t    15\tfrom app import audit\n617\t    16\tfrom app.budget import Budget\n618\t    17\tfrom app.context_size import measure_context\n619\t    18\tfrom app.identity import RunIdentity\n620\t    19\tfrom app.redact import redact_for_model\n621\t    20\tfrom app.tools import build_registry\n622\t    21\t\n623\t    22\tlog = logging.getLogger(__name__)\n624\t    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n625\t    24\t\n626\t    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n627\t    26\tMAX_TURNS = 4\n628\t    27\t\n629\t    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n630\t    29\t\n631\t    30\t\n632\t    31\tclass ExtractionFailed(Exception):\n633\t    32\t    pass\n634\t    33\t\n635\t    34\t\n636\t    35\tclass LineItemExtractor:\n637\t    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n638\t    37\t        self.client = client\n639\t    38\t        self.settings = settings\n640\t    39\t        self.deps = deps\n641\t    40\t        self.system_prompt = system_prompt\n642\t    41\t\n643\t    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n644\t    43\t        budget.check_subagent()\n645\t    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n646\t    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n647\t    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n648\t    47\t\n649\t    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n650\t    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n651\t    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n652\t    51\t            start_node = await audit.record(\n653\t    52\t                self.deps.pool,\n654\t    53\t                ident,\n655\t    54\t                kind=\"subagent_started\",\n656\t    55\t                payload={\n657\t    56\t                    \"role\": EXTRACTOR_ROLE,\n658\t    57\t                    \"doc_id\": doc_id,\n659\t    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n660\t    59\t                    \"tools\": registry.names(),\n661\t    60\t                },\n662\t    61\t            )\n663\t    62\t\n664\t    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n665\t    64\t            for _turn in range(MAX_TURNS):\n666\t    65\t                budget.check_step()\n667\t    66\t                request = {\n668\t    67\t                    \"model\": self.settings.extractor_model_id,\n669\t    68\t                    \"system\": self.system_prompt,\n670\t    69\t                    \"messages\": messages,\n671\t    70\t                    \"tools\": registry.schemas(),\n672\t    71\t                    \"max_tokens\": 4096,\n673\t    72\t                }\n674\t    73\t                ctx = await measure_context(self.client, request, compacted=False)\n675\t    74\t                response = await self.client.messages.create(**request)\n676\t    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n677\t    76\t                await budget.flush(self.deps.pool)\n678\t    77\t                ctx = ctx.finalize(response.usage)\n679\t    78\t                decision = await audit.record(\n680\t    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n681\t    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n682\t    81\t                             \"stop_reason\": response.stop_reason},\n683\t    82\t                )\n684\t    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n685\t    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n686\t    85\t                if not uses:\n687\t    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n688\t    87\t                    items = _parse_items(text)\n689\t    88\t                    await audit.record(\n690\t    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n691\t    90\t                        payload={\"items\": len(items)},\n692\t    91\t                    )\n693\t    92\t                    return items\n694\t    93\t                results = []\n695\t    94\t                for use in uses:\n696\t    95\t                    budget.check_tool_call()\n697\t    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n698\t    97\t                messages.append({\"role\": \"user\", \"content\": results})\n699\t    98\t\n700\t    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n701\t   100\t\n702\t   101\t\n703\t   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n704\t   103\t    try:\n705\t   104\t        data = json.loads(text)\n706\t   105\t    except json.JSONDecodeError as exc:\n707\t   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n708\t   107\t    if not isinstance(data, list) or len(data) > 500:\n709\t   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n710\t   109\t    items = []\n711\t   110\t    for raw in data:\n712\t   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n713\t   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n714\t   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n715\t   114\t    return items\n716\t"}]},"parent_tool_use_id":null,"session_id":"65f8d82b-17db-4aa3-8a31-97c7d53b8832","uuid":"889537ce-60b3-46cd-95a5-e993075ea32b","timestamp":"2026-10-02T17:56:38.482Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-n0y2sv85/65f8d82b-17db-4aa3-8a31-97c7d53b8832/tool-results/b3eg1dyv6.txt","content":"    44\t\n    45\t    line_schema = {\n    46\t        \"type\": \"object\",\n    47\t        \"properties\": {\n    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n    52\t        },\n    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n    54\t        \"additionalProperties\": False,\n    55\t    }\n    56\t\n    57\t    return [\n    58\t        Tool(\n    59\t            name=\"get_budget\",\n    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n    61\t            input_schema={\n    62\t                \"type\": \"object\",\n    63\t                \"properties\": {\n    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n    66\t                },\n    67\t                \"required\": [\"department\", \"fiscal_period\"],\n    68\t                \"additionalProperties\": False,\n    69\t            },\n    70\t            invoke=get_budget,\n    71\t        ),\n    72\t        Tool(\n    73\t            name=\"erp_call\",\n    74\t            description=(\n    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n    77\t            ),\n    78\t            input_schema={\n    79\t                \"type\": \"object\",\n    80\t                \"properties\": {\n    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n    82\t                    \"arguments\": {\"type\": \"object\"},\n    83\t                },\n    84\t                \"required\": [\"operation\"],\n    85\t                \"additionalProperties\": False,\n    86\t            },\n    87\t            invoke=erp_call,\n    88\t        ),\n    89\t        Tool(\n    90\t            name=\"create_purchase_order\",\n    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n    92\t            input_schema={\n    93\t                \"type\": \"object\",\n    94\t                \"properties\": {\n    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n   100\t                },\n   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n   102\t                \"additionalProperties\": False,\n   103\t            },\n   104\t            invoke=create_purchase_order,\n   105\t            target_field=\"source_doc_id\",\n   106\t        ),\n   107\t    ]\n=== app/tools/payments.py\n     1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.tools import Tool\n    11\t\n    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n    13\tPAYMENTS_SCOPE = \"payments.create\"\n    14\t\n    15\t\n    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n    17\t    raw = \"|\".join(\n    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n    19\t    )\n    20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n    21\t\n    22\t\n    23\tdef tools(deps) -> list[Tool]:\n    24\t    settings = deps.settings\n    25\t\n    26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n    27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n    28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n    29\t            resp = await client.post(\n    30\t                f\"{settings.payments_api_url}/v2/payments\",\n    31\t                headers={\n    32\t                    \"Authorization\": f\"Bearer {token}\",\n    33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n    34\t                },\n    35\t                json={\n    36\t                    \"business_unit\": ident.tenant,\n    37\t                    \"invoice_reference\": args[\"invoice_id\"],\n    38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n    39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n    40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n    41\t                },\n    42\t            )\n    43\t        resp.raise_for_status()\n    44\t        body = resp.json()\n    45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n    46\t\n    47\t    return [\n    48\t        Tool(\n    49\t            name=\"pay_invoice\",\n    50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n    51\t            input_schema={\n    52\t                \"type\": \"object\",\n    53\t                \"properties\": {\n    54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n    55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n    56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n    57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n    59\t                },\n    60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n    61\t                \"additionalProperties\": False,\n    62\t            },\n    63\t            invoke=pay_invoice,\n    64\t            target_field=\"invoice_id\",\n    65\t        )\n    66\t    ]\n=== app/tools/slack.py\n     1\t\"\"\"Slack tool: message staff and vendors, plus the approvals notifier.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom datetime import datetime\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.redact import redact_text, strip_unapproved_links\n    11\tfrom app.tools import Tool\n    12\t\n    13\tMAX_TEXT = 3000\n    14\t\n    15\t\n    16\tdef clean_outbound(text: str) -> str:\n    17\t    return strip_unapproved_links(redact_text(text))[:MAX_TEXT]\n    18\t\n    19\t\n    20\tclass SlackClient:\n    21\t    def __init__(self, api_url: str, bot_token_provider):\n    22\t        self.api_url = api_url\n    23\t        self._token = bot_token_provider\n    24\t\n    25\t    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:\n    26\t        payload: dict[str, Any] = {\n    27\t            \"channel\": channel,\n    28\t            \"text\": clean_outbound(text),\n    29\t            \"unfurl_links\": False,\n    30\t            \"unfurl_media\": False,\n    31\t            \"mrkdwn\": True,\n    32\t        }\n    33\t        if blocks:\n    34\t            payload[\"blocks\"] = blocks\n    35\t        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:\n    36\t            resp = await client.post(\n    37\t                f\"{self.api_url}/chat.postMessage\",\n    38\t                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\n    39\t                json=payload,\n    40\t            )\n    41\t        resp.raise_for_status()\n    42\t        body = resp.json()\n    43\t        if not body.get(\"ok\"):\n    44\t            raise RuntimeError(f\"slack error: {body.get('error')}\")\n    45\t        return {\"channel\": body[\"channel\"], \"ts\": body[\"ts\"]}\n    46\t\n    47\t    async def post_approval_request(\n    48\t        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\n    49\t    ) -> None:\n    50\t        lines = \"\\n\".join(f\"• *{k}*: `{v}`\" for k, v in summary.items())\n    51\t        text = f\"Approval needed for `{tool}` on `{target}` (expires {expires_at:%Y-%m-%d %H:%M} UTC)\\n{lines}\"\n    52\t        await self.post(\n    53\t            channel=f\"#approvals-{tenant}\",\n    54\t            text=text,\n    55\t            blocks=[\n    56\t                {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": clean_outbound(text)}},\n    57\t                {\n    58\t                    \"type\": \"actions\",\n    59\t                    \"elements\": [\n    60\t                        {\"type\": \"button\", \"action_id\": \"approve\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Approve\"}, \"style\": \"primary\"},\n    61\t                        {\"type\": \"button\", \"action_id\": \"reject\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Reject\"}, \"style\": \"danger\"},\n    62\t                    ],\n    63\t                },\n    64\t            ],\n    65\t        )\n    66\t\n    67\t\n    68\tdef tools(deps) -> list[Tool]:\n    69\t    slack: SlackClient = deps.slack\n    70\t\n    71\t    async def post_slack_message(args: dict[str, Any], ident: RunIdentity) -> Any:\n    72\t        return await slack.post(channel=args[\"channel\"], text=args[\"text\"])\n    73\t\n    74\t    return [\n    75\t        Tool(\n    76\t            name=\"post_slack_message\",\n    77\t            description=(\n    78\t                \"Post a message in Slack. Use internal channels for staff. Vendor contacts are in \"\n    79\t                \"Slack Connect channels named #vendor-<vendor_id>; set external=true for those.\"\n    80\t            ),\n    81\t            input_schema={\n    82\t                \"type\": \"object\",\n    83\t                \"properties\": {\n    84\t                    \"channel\": {\"type\": \"string\", \"maxLength\": 80},\n    85\t                    \"text\": {\"type\": \"string\", \"maxLength\": MAX_TEXT},\n    86\t                    \"external\": {\"type\": \"boolean\", \"default\": False},\n    87\t                },\n    88\t                \"required\": [\"channel\", \"text\"],\n    89\t                \"additionalProperties\": False,\n    90\t            },\n    91\t            invoke=post_slack_message,\n    92\t            target_field=\"channel\",\n    93\t        )\n    94\t    ]\n=== app/tools/documents.py\n     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tUNTRUSTED_WRAPPER = (\n    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n    11\t    \"{text}\\n\"\n    12\t    \"</untrusted_document>\"\n    13\t)\n    14\t\n    15\t\n    16\tdef tools(deps) -> list[Tool]:\n    17\t    pool = deps.pool\n    18\t\n    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n    20\t        row = await pool.fetchrow(\n    21\t            \"\"\"\n    22\t            SELECT doc_id, source, media_type, text\n    23\t            FROM documents\n    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n    25\t            \"\"\",\n    26\t            args[\"doc_id\"],\n    27\t            ident.tenant,\n    28\t        )\n    29\t        if row is None:\n    30\t            return \"document not found\"\n    31\t        return UNTRUSTED_WRAPPER.format(\n    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n    33\t        )\n    34\t\n    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n    37\t\n    38\t    return [\n    39\t        Tool(\n    40\t            name=\"read_document\",\n    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n    42\t            input_schema={\n    43\t                \"type\": \"object\",\n    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    45\t                \"required\": [\"doc_id\"],\n    46\t                \"additionalProperties\": False,\n    47\t            },\n    48\t            invoke=read_document,\n    49\t        ),\n    50\t        Tool(\n    51\t            name=\"extract_line_items\",\n    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n    53\t            input_schema={\n    54\t                \"type\": \"object\",\n    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    56\t                \"required\": [\"doc_id\"],\n    57\t                \"additionalProperties\": False,\n    58\t            },\n    59\t            invoke=extract_line_items,\n    60\t        ),\n    61\t    ]\n=== app/tools/memory.py\n     1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n     2\t\n     3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n     4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n     5\tuntil a procurement lead verifies them in the admin UI. Every row records\n     6\twho wrote it, from which run and source document, and the context size at\n     7\tthe time.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport re\n    12\timport uuid\n    13\tfrom typing import Any\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\tfrom app.tools import Tool\n    17\t\n    18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n    19\tMAX_NOTE_CHARS = 800\n    20\tINSTRUCTION_LIKE = [\n    21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n    22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n    23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n    24\t    re.compile(r\"https?://\"),\n    25\t]\n    26\t\n    27\t\n    28\tclass NoteRejected(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tdef check_note(text: str) -> None:\n    33\t    if len(text) > MAX_NOTE_CHARS:\n    34\t        raise NoteRejected(\"note too long\")\n    35\t    for pattern in INSTRUCTION_LIKE:\n    36\t        if pattern.search(text):\n    37\t            raise NoteRejected(\"note looks like an instruction\")\n    38\t\n    39\t\n    40\tdef tools(deps) -> list[Tool]:\n    41\t    pool = deps.pool\n    42\t\n    43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n    44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n    45\t        rows = await pool.fetch(\n    46\t            \"\"\"\n    47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n    48\t            FROM dept_notes\n    49\t            WHERE business_unit = $1\n    50\t              AND department = $2\n    51\t              AND NOT quarantined\n    52\t              AND (verified OR expires_at > now())\n    53\t            ORDER BY created_at DESC\n    54\t            LIMIT 20\n    55\t            \"\"\",\n    56\t            business_unit,\n    57\t            args[\"department\"],\n    58\t        )\n    59\t        return [\n    60\t            {\n    61\t                \"note_id\": r[\"note_id\"],\n    62\t                \"kind\": r[\"kind\"],\n    63\t                \"body\": r[\"body\"],\n    64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n    65\t                \"written\": r[\"created_at\"].isoformat(),\n    66\t            }\n    67\t            for r in rows\n    68\t        ]\n    69\t\n    70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n    71\t        if args[\"kind\"] not in NOTE_KINDS:\n    72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n    73\t        check_note(args[\"body\"])\n    74\t        note_id = f\"note-{uuid.uuid4()}\"\n    75\t        ctx = deps.current_context(ident)\n    76\t        await pool.execute(\n    77\t            \"\"\"\n    78\t            INSERT INTO dept_notes (\n    79\t                note_id, business_unit, department, kind, body,\n    80\t                verified, quarantined, expires_at,\n    81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n    82\t                delegated_subject, context_tokens, context_method, created_at\n    83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n    84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n    85\t            \"\"\",\n    86\t            note_id,\n    87\t            ident.tenant,\n    88\t            args[\"department\"],\n    89\t            args[\"kind\"],\n    90\t            args[\"body\"],\n    91\t            ident.agent_instance_id,\n    92\t            ident.agent_type_id,\n    93\t            ident.run_id,\n    94\t            args.get(\"source_doc_id\"),\n    95\t            ident.delegated_subject,\n    96\t            ctx.tokens,\n    97\t            ctx.method,\n    98\t        )\n    99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n   100\t\n   101\t    return [\n   102\t        Tool(\n   103\t            name=\"memory_read\",\n   104\t            description=(\n   105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n   106\t                \"shared-services staff may look up another unit's notes.\"\n   107\t            ),\n   108\t            input_schema={\n   109\t                \"type\": \"object\",\n   110\t                \"properties\": {\n   111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n   113\t                },\n   114\t                \"required\": [\"department\"],\n   115\t                \"additionalProperties\": False,\n   116\t            },\n   117\t            invoke=memory_read,\n   118\t        ),\n   119\t        Tool(\n   120\t            name=\"memory_write\",\n   121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n   122\t            input_schema={\n   123\t                \"type\": \"object\",\n   124\t                \"properties\": {\n   125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n   127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n   128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n   129\t                },\n   130\t                \"required\": [\"department\", \"kind\", \"body\"],\n   131\t                \"additionalProperties\": False,\n   132\t            },\n   133\t            invoke=memory_write,\n   134\t        ),\n   135\t    ]\n=== app/mcp_client.py\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n=== app/extractor.py\n     1\t\"\"\"Line-item extraction sub-agent.\n     2\t\n     3\tThe parent procurement agent delegates structured extraction to a smaller\n     4\tmodel. The child runs under its own instance id, links to its parent in the\n     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport json\n    10\timport logging\n    11\tfrom typing import Any\n    12\t\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom app import audit\n    16\tfrom app.budget import Budget\n    17\tfrom app.context_size import measure_context\n    18\tfrom app.identity import RunIdentity\n    19\tfrom app.redact import redact_for_model\n    20\tfrom app.tools import build_registry\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n    24\t\n    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n    26\tMAX_TURNS = 4\n    27\t\n    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n    29\t\n    30\t\n    31\tclass ExtractionFailed(Exception):\n    32\t    pass\n    33\t\n    34\t\n    35\tclass LineItemExtractor:\n    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n    37\t        self.client = client\n    38\t        self.settings = settings\n    39\t        self.deps = deps\n    40\t        self.system_prompt = system_prompt\n    41\t\n    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n    43\t        budget.check_subagent()\n    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n    47\t\n    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n    51\t            start_node = await audit.record(\n    52\t                self.deps.pool,\n    53\t                ident,\n    54\t                kind=\"subagent_started\",\n    55\t                payload={\n    56\t                    \"role\": EXTRACTOR_ROLE,\n    57\t                    \"doc_id\": doc_id,\n    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n    59\t                    \"tools\": registry.names(),\n    60\t                },\n    61\t            )\n    62\t\n    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n    64\t            for _turn in range(MAX_TURNS):\n    65\t                budget.check_step()\n    66\t                request = {\n    67\t                    \"model\": self.settings.extractor_model_id,\n    68\t                    \"system\": self.system_prompt,\n    69\t                    \"messages\": messages,\n    70\t                    \"tools\": registry.schemas(),\n    71\t                    \"max_tokens\": 4096,\n    72\t                }\n    73\t                ctx = await measure_context(self.client, request, compacted=False)\n    74\t                response = await self.client.messages.create(**request)\n    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n    76\t                await budget.flush(self.deps.pool)\n    77\t                ctx = ctx.finalize(response.usage)\n    78\t                decision = await audit.record(\n    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n    81\t                             \"stop_reason\": response.stop_reason},\n    82\t                )\n    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n    85\t                if not uses:\n    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n    87\t                    items = _parse_items(text)\n    88\t                    await audit.record(\n    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n    90\t                        payload={\"items\": len(items)},\n    91\t                    )\n    92\t                    return items\n    93\t                results = []\n    94\t                for use in uses:\n    95\t                    budget.check_tool_call()\n    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n    97\t                messages.append({\"role\": \"user\", \"content\": results})\n    98\t\n    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n   100\t\n   101\t\n   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n   103\t    try:\n   104\t        data = json.loads(text)\n   105\t    except json.JSONDecodeError as exc:\n   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n   107\t    if not isinstance(data, list) or len(data) > 500:\n   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n   109\t    items = []\n   110\t    for raw in data:\n   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n   114\t    return items\n","numLines":672,"startLine":45,"totalLines":716}}}
