{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013GZVDbd7vxaPoSowRsq6Gq","type":"tool_result","content":"     1\t\"\"\"Policy gate for tool calls.\n     2\t\n     3\tRuns in the harness between the model's proposed call and the integration.\n     4\tHigh-impact operations are denied unless a valid approval exists; when none\n     5\texists an approval request is opened and the call returns as pending.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom typing import Any\n    11\t\n    12\tfrom app.approvals import ApprovalStore\n    13\tfrom app.identity import RunIdentity\n    14\t\n    15\t\n    16\t@dataclass(frozen=True)\n    17\tclass Decision:\n    18\t    allow: bool\n    19\t    reason: str\n    20\t    policy_version: str\n    21\t    approval_id: str | None = None\n    22\t    pending: bool = False\n    23\t\n    24\t\n    25\tclass PolicyGate:\n    26\t    def __init__(self, policy: dict, approvals: ApprovalStore):\n    27\t        self.version: str = policy[\"version\"]\n    28\t        self.high_impact: frozenset[str] = frozenset(policy[\"high_impact_tools\"])\n    29\t        self.erp_read_prefixes: tuple[str, ...] = tuple(policy[\"erp\"][\"read_prefixes\"])\n    30\t        self.approvals = approvals\n    31\t\n    32\t    async def authorize(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n    33\t        if tool.name == \"erp_call\":\n    34\t            operation = str(args.get(\"operation\", \"\"))\n    35\t            if not operation.startswith(self.erp_read_prefixes):\n    36\t                return Decision(False, f\"erp operation not permitted: {operation}\", self.version)\n    37\t            return Decision(True, \"erp read operation\", self.version)\n    38\t\n    39\t        if tool.name == \"post_slack_message\":\n    40\t            if args.get(\"external\", False):\n    41\t                return await self._require_approval(ident, tool, args)\n    42\t            return Decision(True, \"internal staff message\", self.version)\n    43\t\n    44\t        if tool.name in self.high_impact:\n    45\t            return await self._require_approval(ident, tool, args)\n    46\t\n    47\t        return Decision(True, \"low-impact tool\", self.version)\n    48\t\n    49\t    async def _require_approval(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n    50\t        target = tool.target_of(args)\n    51\t        approval = await self.approvals.find_valid(ident, tool.name, target)\n    52\t        if approval is not None:\n    53\t            return Decision(True, \"approved\", self.version, approval_id=approval.id)\n    54\t        approval_id = await self.approvals.request(ident, tool.name, target, args)\n    55\t        return Decision(\n    56\t            False,\n    57\t            \"approval required; request opened\",\n    58\t            self.version,\n    59\t            approval_id=approval_id,\n    60\t            pending=True,\n    61\t        )\napp/tools/memory.py:45:        rows = await pool.fetch(\napp/tools/memory.py:76:        await pool.execute(\napp/tools/documents.py:20:        row = await pool.fetchrow(\napp/approvals.py:16:from app.audit import digest, summarize_args\napp/approvals.py:42:        await self.pool.execute(\napp/approvals.py:72:        row = await self.pool.fetchrow(\napp/approvals.py:95:        row = await self.pool.fetchrow(\napp/approvals.py:104:        await self.pool.execute(\napp/budget.py:122:        async with pool.acquire() as conn:\napp/budget.py:126:                    count = await conn.fetchval(\napp/budget.py:145:        async with pool.acquire() as conn:\napp/budget.py:149:                    spent = await conn.fetchval(\napp/ingest.py:132:        await pool.execute(\napp/ingest.py:142:    await pool.execute(\n     1\tapiVersion: apps/v1\n     2\tkind: Deployment\n     3\tmetadata:\n     4\t  name: procurement-agent\n     5\t  namespace: procurement-prod\n     6\t  labels:\n     7\t    app: procurement-agent\n     8\t    owner: team-procurement-platform\n     9\tspec:\n    10\t  replicas: 3\n    11\t  selector:\n    12\t    matchLabels:\n    13\t      app: procurement-agent\n    14\t  template:\n    15\t    metadata:\n    16\t      labels:\n    17\t        app: procurement-agent\n    18\t    spec:\n    19\t      serviceAccountName: procurement-agent\n    20\t      automountServiceAccountToken: false\n    21\t      hostUsers: false\n    22\t      enableServiceLinks: false\n    23\t      securityContext:\n    24\t        runAsNonRoot: true\n    25\t        runAsUser: 65532\n    26\t        runAsGroup: 65532\n    27\t        fsGroup: 65532\n    28\t        seccompProfile:\n    29\t          type: RuntimeDefault\n    30\t      containers:\n    31\t        - name: agent\n    32\t          image: registry.example-corp.test/procurement/agent@sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\n    33\t          imagePullPolicy: IfNotPresent\n    34\t          ports:\n    35\t            - containerPort: 8080\n    36\t              name: http\n    37\t          env:\n    38\t            - name: IMAGE_DIGEST\n    39\t              value: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n    40\t            - name: MODEL_ID\n    41\t              value: \"claude-sonnet-4-5-20250929\"\n    42\t            - name: EXTRACTOR_MODEL_ID\n    43\t              value: \"claude-haiku-4-5-20251001\"\n    44\t            - name: DATABASE_URL\n    45\t              value: \"postgresql://procurement_agent@procurement-db.procurement-data.svc.cluster.local:5432/procurement?sslmode=verify-full\"\n    46\t            - name: ERP_MCP_URL\n    47\t              value: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    48\t            - name: PAYMENTS_API_URL\n    49\t              value: \"https://api.payments.example-pay.test\"\n    50\