{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019nBxgicR5W2Rqyiaw6AHnq","type":"tool_result","content":"     1\t\"\"\"Execution audit graph.\n     2\t\n     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n     5\ttool call -> authorization decision -> result or error. Writes are\n     6\tsynchronous and are made before the action they describe; if the write\n     7\tfails, the caller raises and the action does not run.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport hashlib\n    12\timport json\n    13\timport uuid\n    14\tfrom datetime import datetime, timezone\n    15\tfrom typing import Any\n    16\t\n    17\tfrom opentelemetry import trace\n    18\t\n    19\tfrom app.context_size import ContextMeasure\n    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n    21\tfrom app.redact import redact_value\n    22\t\n    23\tEVENT_KINDS = {\n    24\t    \"run_started\",\n    25\t    \"run_finished\",\n    26\t    \"run_halted\",\n    27\t    \"model_decision\",\n    28\t    \"tool_proposed\",\n    29\t    \"authz_decision\",\n    30\t    \"approval_requested\",\n    31\t    \"approval_decided\",\n    32\t    \"tool_result\",\n    33\t    \"tool_error\",\n    34\t    \"tool_denied\",\n    35\t    \"budget_exceeded\",\n    36\t    \"subagent_started\",\n    37\t    \"subagent_finished\",\n    38\t    \"background_job\",\n    39\t}\n    40\t\n    41\t_INSERT = \"\"\"\n    42\tINSERT INTO audit_events (\n    43\t    node_id, parent_node_id, run_id, ts, kind,\n    44\t    accountable_party, operational_owner, tenant,\n    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n    46\t    delegated_subject, agent_principal, parent_instance_id,\n    47\t    policy_version, approval_id, operation_id,\n    48\t    context_tokens, context_method, context_compacted,\n    49\t    payload\n    50\t) VALUES (\n    51\t    $1, $2, $3, $4, $5,\n    52\t    $6, $7, $8,\n    53\t    $9, $10, $11, $12,\n    54\t    $13, $14, $15,\n    55\t    $16, $17, $18,\n    56\t    $19, $20, $21,\n    57\t    $22::jsonb\n    58\t)\n    59\t\"\"\"\n    60\t\n    61\t\n    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n    64\t    return {k: redact_value(v) for k, v in args.items()}\n    65\t\n    66\t\n    67\tdef digest(value: Any) -> str:\n    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    70\t\n    71\t\n    72\tasync def record(\n    73\t    pool,\n    74\t    ident: RunIdentity,\n    75\t    *,\n    76\t    kind: str,\n    77\t    payload: dict[str, Any] | None = None,\n    78\t    parent: str | None = None,\n    79\t    context: ContextMeasure | None = None,\n    80\t    policy_version: str | None = None,\n    81\t    approval_id: str | None = None,\n    82\t    operation_id: str | None = None,\n    83\t) -> str:\n    84\t    if kind not in EVENT_KINDS:\n    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n    86\t    for name in IDENTITY_FIELDS:\n    87\t        if not getattr(ident, name):\n    88\t            raise ValueError(f\"audit record missing {name}\")\n    89\t    span_ctx = trace.get_current_span().get_span_context()\n    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n    91\t    node_id = f\"node-{uuid.uuid4()}\"\n    92\t    measure = context or ContextMeasure.unavailable()\n    93\t    await pool.execute(\n    94\t        _INSERT,\n    95\t        node_id,\n    96\t        parent,\n    97\t        ident.run_id,\n    98\t        datetime.now(timezone.utc),\n    99\t        kind,\n   100\t        ident.accountable_party,\n   101\t        ident.operational_owner,\n   102\t        ident.tenant,\n   103\t        ident.agent_type_id,\n   104\t        ident.agent_instance_id,\n   105\t        ident.trace_id,\n   106\t        span_id,\n   107\t        ident.delegated_subject,\n   108\t        ident.agent_principal,\n   109\t        ident.parent_instance_id,\n   110\t        policy_version,\n   111\t        approval_id,\n   112\t        operation_id,\n   113\t        measure.tokens,\n   114\t        measure.method,\n   115\t        measure.compacted,\n   116\t        json.dumps(redact_value(payload or {}), default=str),\n   117\t    )\n   118\t    return node_id\n     1\t-- Procurement agent schema. Applied by the migration job with the\n     2\t-- procurement_owner role; the running agent connects as procurement_agent.\n     3\t\n     4\tCREATE TABLE audit_events (\n     5\t    node_id             text PRIMARY KEY,\n     6\t    parent_node_id      text REFERENCES audit_events (node_id),\n     7\t    run_id              text NOT NULL,\n     8\t    ts                  timestamptz NOT NULL,\n     9\t    kind                text NOT NULL,\n    10\t    accountable_party   text NOT NULL CHECK (accountable_party <> ''),\n    11\t    operational_owner   text NOT NULL CHECK (operational_owner <> ''),\n    12\t    tenant              text NOT NULL CHECK (tenant <> ''),\n    13\t    agent_type_id       text NOT NULL CHECK (agent_type_id <> ''),\n    14\t    agent_instance_id   text NOT NULL CHECK (agent_instance_id <> ''),\n    15\t    trace_id            text NOT NULL CHECK (trace_id <> ''),\n    16\t    span_id             text,\n    17\t    delegated_subject   text NOT NULL,\n    18\t    agent_principal     text NOT NULL,\n    19\t    parent_instance_id  text,\n    20\t    policy_version      text,\n    21\t    approval_id         text,\n    22\t    operation_id        text,\n    23\t    context_tokens      integer CHECK (context_tokens IS NULL OR context_tokens > 0),\n    24\t    context_method      text NOT NULL,\n    25\t    context_compacted   boolean NOT NULL,\n    26\t    payload             jsonb NOT NULL\n    27\t);\n    28\tCREATE INDEX audit_events_run ON audit_events (run_id, ts);\n    29\tCREATE INDEX audit_events_instance ON audit_events (agent_instance_id, ts);\n    30\tCREATE INDEX audit_events_trace ON audit_events (trace_id);\n    31\t\n    32\tCREATE TABLE approvals (\n    33\t    id                     text PRIMARY KEY,\n    34\t    tool                   text NOT NULL,\n    35\t    target                 text NOT NULL,\n    36\t    args_sha256            text NOT NULL,\n    37\t    args_summary           jsonb NOT NULL,\n    38\t    tenant                 text NOT NULL,\n    39\t    requested_by_instance  text NOT NULL,\n    40\t    requested_by_run       text NOT NULL,\n    41\t    delegated_subject      text NOT NULL,\n    42\t    status                 text NOT NULL CHECK (status IN ('pending', 'approved', 'rejected', 'expired')),\n    43\t    requested_at           timestamptz NOT NULL,\n    44\t    expires_at             timestamptz NOT NULL,\n    45\t    approver               text,\n    46\t    approver_role          text,\n    47\t    decided_at             timestamptz\n    48\t);\n    49\tCREATE INDEX approvals_lookup ON approvals (tool, target, tenant, status);\n    50\t\n    51\tCREATE TABLE approvers (\n    52\t    slack_user_id  text PRIMARY KEY,\n    53\t    email          text NOT NULL,\n    54\t    role           text NOT NULL,\n    55\t    business_unit  text NOT NULL,\n    56\t    active         boolean NOT NULL DEFAULT true\n    57\t);\n    58\t\n    59\tCREATE TABLE documents (\n    60\t    doc_id         text PRIMARY KEY,\n    61\t    business_unit  text NOT NULL,\n    62\t    source         text NOT NULL,\n    63\t    media_type     text NOT NULL,\n    64\t    sha256         text NOT NULL,\n    65\t    status         text NOT NULL CHECK (status IN ('accepted', 'quarantined')),\n    66\t    reject_reason  text,\n    67\t    text           text,\n    68\t    received_at    timestamptz NOT NULL\n    69\t);\n    70\tCREATE INDEX documents_bu ON documents (business_unit, doc_id);\n    71\t\n    72\tCREATE TABLE dept_notes (\n    73\t    note_id            text PRIMARY KEY,\n    74\t    business_unit      text NOT NULL,\n    75\t    department         text NOT NULL,\n    76\t    kind               text NOT NULL,\n    77\t    body               text NOT NULL,\n    78\t    verified           boolean NOT NULL DEFAULT false,\n    79\t    verified_by        text,\n    80\t    quarantined        boolean NOT NULL DEFAULT false,\n    81\t    expires_at         timestamptz,\n    82\t    writer_instance    text NOT NULL,\n    83\t    writer_type_id     text NOT NULL,\n    84\t    run_id             text NOT NULL,\n    85\t    source_doc_id      text,\n    86\t    delegated_subject  text NOT NULL,\n    87\t    context_tokens     integer,\n    88\t    context_method     text NOT NULL,\n    89\t    created_at         timestamptz NOT NULL\n    90\t);\n    91\tCREATE INDEX dept_notes_lookup ON dept_notes (business_unit, department, created_at DESC);\n    92\tCREATE INDEX dept_notes_source ON dept_notes (source_doc_id);\n    93\tCREATE INDEX dept_notes_writer ON dept_notes (writer_instance);\n    94\t\n    95\tCREATE TABLE control_flags (\n    96\t    scope    text PRIMARY KEY,           -- 'fleet' or 'tenant:<business_unit>'\n    97\t    halted   boolean NOT NULL,\n    98\t    reason   text NOT NULL,\n    99\t    set_by   text NOT NULL,\n   100\t    set_at   timestamptz NOT NULL DEFAULT now()\n   101\t);\n   102\t\n   103\tCREATE TABLE spend_quota (\n   104\t    scope      text NOT NULL,\n   105\t    key        text NOT NULL,\n   106\t    day        date NOT NULL,\n   107\t    spent_usd  numeric(12, 4) NOT NULL,\n   108\t    PRIMARY KEY (scope, key, day)\n   109\t);\n   110\t\n   111\tCREATE TABLE run_start_window (\n   112\t    scope   text NOT NULL,\n   113\t    key     text NOT NULL,\n   114\t    minute  timestamptz NOT NULL,\n   115\t    starts  integer NOT NULL,\n   116\t    PRIMARY KEY (scope, key, minute)\n   117\t);\n   118\t\n   119\t-- Runtime role: append-only audit, no access to control flags beyond reading.\n   120\tREVOKE ALL ON ALL TABLES IN SCHEMA public FROM procurement_agent;\n   121\tGRANT SELECT, INSERT ON audit_events TO procurement_agent;\n   122\tGRANT SELECT, INSERT, UPDATE ON approvals TO procurement_agent;\n   123\tGRANT SELECT ON approvers TO procurement_agent;\n   124\tGRANT SELECT, INSERT ON documents TO procurement_agent;\n   125\tGRANT SELECT, INSERT ON dept_notes TO procurement_agent;\n   126\tGRANT SELECT ON control_flags TO procurement_agent;\n   127\tGRANT SELECT, INSERT, UPDATE ON spend_quota TO procurement_agent;\n   128\tGRANT SELECT, INSERT, UPDATE ON run_start_window TO procurement_agent;\n   129\t\n   130\t-- Operators: halt and resume.\n   131\tGRANT SELECT, INSERT, UPDATE ON control_flags TO procurement_ops;\n   132\tGRANT SELECT ON audit_events TO procurement_ops;\n   133\tGRANT SELECT, UPDATE (verified, verified_by, quarantined) ON dept_notes TO procurement_ops;\n     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n{\n  \"sites\": [\n    {\n      \"id\": \"Ibbf3d10c2d\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/extractor.py:51\",\n      \"quote\": \"start_node = await audit.record(\"\n    },\n    {\n      \"id\": \"I1bba76f5cb\",\n      \"kind\": \"model_call\",\n      \"evidence\": \"app/extractor.py:74\",\n      \"quote\": \"response = await self.client.messages.create(**request)\"\n    },\n    {\n      \"id\": \"Idfed0c6536\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/extractor.py:78\",\n      \"quote\": \"decision = await audit.record(\"\n    },\n    {\n      \"id\": \"I989251408e\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/extractor.py:88\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"I4721ae44be\",\n      \"kind\": \"tool_call\",\n      \"evidence\": \"app/extractor.py:96\",\n      \"quote\": \"results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\"\n    },\n    {\n      \"id\": \"I27809e3c3d\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:133\",\n      \"quote\": \"run_node = await audit.record(\"\n    },\n    {\n      \"id\": \"I11d074af40\",\n      \"kind\": \"model_call\",\n      \"evidence\": \"app/loop.py:150\",\n      \"quote\": \"response = await self.client.messages.create(**request)\"\n    },\n    {\n      \"id\": \"Ib3e4db612c\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:154\",\n      \"quote\": \"decision = await audit.record(\"\n    },\n    {\n      \"id\": \"I687b22db00\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:167\",\n      \"quote\": \"await audit.record(pool, ident, kind=\\\"run_finished\\\", parent=run_node, context=ctx,\"\n    },\n    {\n      \"id\": \"I65e59182e1\",\n      \"kind\": \"tool_call\",\n      \"evidence\": \"app/loop.py:173\",\n      \"quote\": \"results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\"\n    },\n    {\n      \"id\": \"I6e9f9a2638\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:176\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"Icbe3633cb6\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:55\",\n      \"quote\": \"proposed = await audit.record(\"\n    },\n    {\n      \"id\": \"I4db5797679\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:61\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"Ia389c28cba\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:68\",\n      \"quote\": \"authz = await audit.record(\"\n    },\n    {\n      \"id\": \"I8165b2309f\",\n      \"kind\": \"tool_call\",\n      \"evidence\": \"app/loop.py:83\",\n      \"quote\": \"output = await tool.invoke(use.input, ident)\"\n    },\n    {\n      \"id\": \"I588419ff8b\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:87\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"I12a6ffed84\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:95\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"Iffaa43b340\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/main.py:76\",\n      \"quote\": \"await audit.record(app.state.pool, ident, kind=\\\"background_job\\\",\"\n    }\n  ],\n  \"s726:## E12 · G3 · C7/C8 — Fleet incident response\n727-\n728-**Lead:** Security. **Shares:** Operations, Governance, Business owner.\n729-\n730-### Requirement\n731-\n732-Run a drill where a shared tool or agent type is compromised. Find the affected instances and tenants. Quarantine the dependency, revoke the access involved, stop affected work, and alert the named responders. Check that alerts about abuse across agents, and about budgets, reach the team that can act. Name who decides whether to report outside the organization and share information.\n733-\n734-### Verification recipe\n735-\n736-Mark a shared test tool or version as compromised. Query which instances and tenants it affects, quarantine it, revoke the access involved, and trigger response alerts. Affected work must stop within the set targets. Responders must get identities and traces they can act on. Record who decided on outside reporting and information sharing.\n737-\n738-**Evidence to keep:** Fleet impact query, quarantine and revocation records, alert delivery and response times.\n739-\n740-### Checks for likely_pass\n741-\n742-Checks for likely_pass:\n743-\n744-- (none) Code can't show this item. Don't rate it likely_pass; use needs_evidence, gap, or na_candidate.\n745-\n746-### Not covered here\n747-\n748-File these problems under their owning item, not this one, unless this item's own requirement is also broken:\n749-\n750-- Kill switch for a single agent not drilled → **R11**\n751-- No owner named on each side of a shared control → **E01**\n752-- Tool or MCP server approved without vetting or pinning → **E02**\n753-- Budget and rate limits not enforced outside the model → **B07**\n754-\n755-### Heuristics\n756-\n757-**Provable from code:** no\n758-\n759-**Look for:**\n760-- An inventory or query that maps tool and dependency versions to instances and tenants.\n761-- Quarantine controls for a shared tool or agent type (gateway deny rule, registry block, feature flag).\n762-- Alert routes for cross-agent abuse and budget alerts to a named responder team.\n763-- An incident runbook that names who decides on outside reporting and information sharing.\n764-\n765-**Red flags:**\n766-- No way to find which deployments or tenants use a given tool version.\n{\n  \"brace_checklist\": \"2026-10-01\",\n  \"repo\": \"\",\n  \"commit\": null,\n  \"reviewed_at\": \"2026-10-20T15:04:04Z\",\n  \"scope\": \"TODO: what was reviewed and what wasn't.\",\n  \"review_protocol\": \"coverage-first-v1\",\n  \"findings\": [\n    {\n      \"item\": \"E10\",\n      \"gate\": \"G1\",\n      \"title\": \"Audit across service boundaries\",\n      \"requirement\": \"Rebuild a run across the gateway, tool services, and delegated workers, with all six identity fields kept. Check that the agent can't erase or rewrite its audit history, either directly or by asking a more powerful tool or peer. Check that a vendor boundary doesn't leave any action untraceable to the agent and instance that did it.\",\n      \"not_covered\": [\n        {\n          \"problem\": \"Audit retention, access, redaction, or export rules missing\",\n          \"owner\": \"E11\"\n        },\n        {\n          \"problem\": \"Authorization decisions missing the policy version in the run record\",\n          \"owner\": \"R13\"\n        },\n        {\n          \"problem\": \"Instance or tenant labels taken from what the model supplies\",\n          \"owner\": \"A04\"\n        },\n        {\n          \"problem\": \"Recovery checkpoints not tamper-evident\",\n          \"owner\": \"R14\"\n        }\n      ],\n      \"rating\": \"needs_evidence\",\n      \"confidence\": \"low\",\n      \"evidence\": [],\n      \"checks\": [\n        {\n          \"id\": \"E10.1\",\n          \"check\": \"The gateway, tool services, and delegated workers each write audit records with all six identity fields and the shared trace context.\",\n          \"verify\": \"1) Find audit writers in the gateway, tool services, and delegated workers. 2) Check each writes all six identity fields and the shared trace context. 3) Answer no if any component writes records without them or starts a new trace. Answer unknown if a component's code is outside this repo.\",\n          \"met\": \"unknown\",\n          \"evidence\": \"\",\n          \"quote\": \"\",\n          \"counter_search\": \"\",\n          \"note\": \"\",\n          \"coverage\": [],\n          \"deviations\": [],\n          \"attempts\": []\n        },\n        {\n          \"id\": \"E10.2\",\n          \"check\": \"The agent's credentials have no permission to delete, update, or overwrite audit records (for example an append-only or WORM store with IAM denies).\",\n          \"verify\": \"1) Find the agent's IAM role or database grants and the audit store config. 2) Check the agent has no delete, update, or overwrite rights (`DeleteObject`, overwriting `PutObject`, `UPDATE`, `DELETE`, `TRUNCATE`) and the store is append-only or WORM (Object Lock). 3) Answer no if the agent's credentials can delete or rewrite records, or grant `*`. Answer unknown if these are set outside this repo.\",\n          \"met\": \"unknown\",\n          \"evidence\": \"\",\n          \"quote\": \"\",\n          \"counter_search\": \"\",\n          \"note\": \"\",\n          \"coverage\": [],\n          \"deviations\": [],\n          \"attempts\": []","is_error":false}]},"parent_tool_use_id":null,"session_id":"f7d17348-1955-4597-8170-470f44b94428","uuid":"f232e3ca-561b-4a39-ac5a-f9b39a16d629","timestamp":"2026-10-20T15:04:16.523Z","tool_use_result":{"stdout":"     1\t\"\"\"Execution audit graph.\n     2\t\n     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n     5\ttool call -> authorization decision -> result or error. Writes are\n     6\tsynchronous and are made before the action they describe; if the write\n     7\tfails, the caller raises and the action does not run.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport hashlib\n    12\timport json\n    13\timport uuid\n    14\tfrom datetime import datetime, timezone\n    15\tfrom typing import Any\n    16\t\n    17\tfrom opentelemetry import trace\n    18\t\n    19\tfrom app.context_size import ContextMeasure\n    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n    21\tfrom app.redact import redact_value\n    22\t\n    23\tEVENT_KINDS = {\n    24\t    \"run_started\",\n    25\t    \"run_finished\",\n    26\t    \"run_halted\",\n    27\t    \"model_decision\",\n    28\t    \"tool_proposed\",\n    29\t    \"authz_decision\",\n    30\t    \"approval_requested\",\n    31\t    \"approval_decided\",\n    32\t    \"tool_result\",\n    33\t    \"tool_error\",\n    34\t    \"tool_denied\",\n    35\t    \"budget_exceeded\",\n    36\t    \"subagent_started\",\n    37\t    \"subagent_finished\",\n    38\t    \"background_job\",\n    39\t}\n    40\t\n    41\t_INSERT = \"\"\"\n    42\tINSERT INTO audit_events (\n    43\t    node_id, parent_node_id, run_id, ts, kind,\n    44\t    accountable_party, operational_owner, tenant,\n    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n    46\t    delegated_subject, agent_principal, parent_instance_id,\n    47\t    policy_version, approval_id, operation_id,\n    48\t    context_tokens, context_method, context_compacted,\n    49\t    payload\n    50\t) VALUES (\n    51\t    $1, $2, $3, $4, $5,\n    52\t    $6, $7, $8,\n    53\t    $9, $10, $11, $12,\n    54\t    $13, $14, $15,\n    55\t    $16, $17, $18,\n    56\t    $19, $20, $21,\n    57\t    $22::jsonb\n    58\t)\n    59\t\"\"\"\n    60\t\n    61\t\n    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n    64\t    return {k: redact_value(v) for k, v in args.items()}\n    65\t\n    66\t\n    67\tdef digest(value: Any) -> str:\n    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    70\t\n    71\t\n    72\tasync def record(\n    73\t    pool,\n    74\t    ident: RunIdentity,\n    75\t    *,\n    76\t    kind: str,\n    77\t    payload: dict[str, Any] | None = None,\n    78\t    parent: str | None = None,\n    79\t    context: ContextMeasure | None = None,\n    80\t    policy_version: str | None = None,\n    81\t    approval_id: str | None = None,\n    82\t    operation_id: str | None = None,\n    83\t) -> str:\n    84\t    if kind not in EVENT_KINDS:\n    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n    86\t    for name in IDENTITY_FIELDS:\n    87\t        if not getattr(ident, name):\n    88\t            raise ValueError(f\"audit record missing {name}\")\n    89\t    span_ctx = trace.get_current_span().get_span_context()\n    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n    91\t    node_id = f\"node-{uuid.uuid4()}\"\n    92\t    measure = context or ContextMeasure.unavailable()\n    93\t    await pool.execute(\n    94\t        _INSERT,\n    95\t        node_id,\n    96\t        parent,\n    97\t        ident.run_id,\n    98\t        datetime.now(timezone.utc),\n    99\t        kind,\n   100\t        ident.accountable_party,\n   101\t        ident.operational_owner,\n   102\t        ident.tenant,\n   103\t        ident.agent_type_id,\n   104\t        ident.agent_instance_id,\n   105\t        ident.trace_id,\n   106\t        span_id,\n   107\t        ident.delegated_subject,\n   108\t        ident.agent_principal,\n   109\t        ident.parent_instance_id,\n   110\t        policy_version,\n   111\t        approval_id,\n   112\t        operation_id,\n   113\t        measure.tokens,\n   114\t        measure.method,\n   115\t        measure.compacted,\n   116\t        json.dumps(redact_value(payload or {}), default=str),\n   117\t    )\n   118\t    return node_id\n     1\t-- Procurement agent schema. Applied by the migration job with the\n     2\t-- procurement_owner role; the running agent connects as procurement_agent.\n     3\t\n     4\tCREATE TABLE audit_events (\n     5\t    node_id             text PRIMARY KEY,\n     6\t    parent_node_id      text REFERENCES audit_events (node_id),\n     7\t    run_id              text NOT NULL,\n     8\t    ts                  timestamptz NOT NULL,\n     9\t    kind                text NOT NULL,\n    10\t    accountable_party   text NOT NULL CHECK (accountable_party <> ''),\n    11\t    operational_owner   text NOT NULL CHECK (operational_owner <> ''),\n    12\t    tenant              text NOT NULL CHECK (tenant <> ''),\n    13\t    agent_type_id       text NOT NULL CHECK (agent_type_id <> ''),\n    14\t    agent_instance_id   text NOT NULL CHECK (agent_instance_id <> ''),\n    15\t    trace_id            text NOT NULL CHECK (trace_id <> ''),\n    16\t    span_id             text,\n    17\t    delegated_subject   text NOT NULL,\n    18\t    agent_principal     text NOT NULL,\n    19\t    parent_instance_id  text,\n    20\t    policy_version      text,\n    21\t    approval_id         text,\n    22\t    operation_id        text,\n    23\t    context_tokens      integer CHECK (context_tokens IS NULL OR context_tokens > 0),\n    24\t    context_method      text NOT NULL,\n    25\t    context_compacted   boolean NOT NULL,\n    26\t    payload             jsonb NOT NULL\n    27\t);\n    28\tCREATE INDEX audit_events_run ON audit_events (run_id, ts);\n    29\tCREATE INDEX audit_events_instance ON audit_events (agent_instance_id, ts);\n    30\tCREATE INDEX audit_events_trace ON audit_events (trace_id);\n    31\t\n    32\tCREATE TABLE approvals (\n    33\t    id                     text PRIMARY KEY,\n    34\t    tool                   text NOT NULL,\n    35\t    target                 text NOT NULL,\n    36\t    args_sha256            text NOT NULL,\n    37\t    args_summary           jsonb NOT NULL,\n    38\t    tenant                 text NOT NULL,\n    39\t    requested_by_instance  text NOT NULL,\n    40\t    requested_by_run       text NOT NULL,\n    41\t    delegated_subject      text NOT NULL,\n    42\t    status                 text NOT NULL CHECK (status IN ('pending', 'approved', 'rejected', 'expired')),\n    43\t    requested_at           timestamptz NOT NULL,\n    44\t    expires_at             timestamptz NOT NULL,\n    45\t    approver               text,\n    46\t    approver_role          text,\n    47\t    decided_at             timestamptz\n    48\t);\n    49\tCREATE INDEX approvals_lookup ON approvals (tool, target, tenant, status);\n    50\t\n    51\tCREATE TABLE approvers (\n    52\t    slack_user_id  text PRIMARY KEY,\n    53\t    email          text NOT NULL,\n    54\t    role           text NOT NULL,\n    55\t    business_unit  text NOT NULL,\n    56\t    active         boolean NOT NULL DEFAULT true\n    57\t);\n    58\t\n    59\tCREATE TABLE documents (\n    60\t    doc_id         text PRIMARY KEY,\n    61\t    business_unit  text NOT NULL,\n    62\t    source         text NOT NULL,\n    63\t    media_type     text NOT NULL,\n    64\t    sha256         text NOT NULL,\n    65\t    status         text NOT NULL CHECK (status IN ('accepted', 'quarantined')),\n    66\t    reject_reason  text,\n    67\t    text           text,\n    68\t    received_at    timestamptz NOT NULL\n    69\t);\n    70\tCREATE INDEX documents_bu ON documents (business_unit, doc_id);\n    71\t\n    72\tCREATE TABLE dept_notes (\n    73\t    note_id            text PRIMARY KEY,\n    74\t    business_unit      text NOT NULL,\n    75\t    department         text NOT NULL,\n    76\t    kind               text NOT NULL,\n    77\t    body               text NOT NULL,\n    78\t    verified           boolean NOT NULL DEFAULT false,\n    79\t    verified_by        text,\n    80\t    quarantined        boolean NOT NULL DEFAULT false,\n    81\t    expires_at         timestamptz,\n    82\t    writer_instance    text NOT NULL,\n    83\t    writer_type_id     text NOT NULL,\n    84\t    run_id             text NOT NULL,\n    85\t    source_doc_id      text,\n    86\t    delegated_subject  text NOT NULL,\n    87\t    context_tokens     integer,\n    88\t    context_method     text NOT NULL,\n    89\t    created_at         timestamptz NOT NULL\n    90\t);\n    91\tCREATE INDEX dept_notes_lookup ON dept_notes (business_unit, department, created_at DESC);\n    92\tCREATE INDEX dept_notes_source ON dept_notes (source_doc_id);\n    93\tCREATE INDEX dept_notes_writer ON dept_notes (writer_instance);\n    94\t\n    95\tCREATE TABLE control_flags (\n    96\t    scope    text PRIMARY KEY,           -- 'fleet' or 'tenant:<business_unit>'\n    97\t    halted   boolean NOT NULL,\n    98\t    reason   text NOT NULL,\n    99\t    set_by   text NOT NULL,\n   100\t    set_at   timestamptz NOT NULL DEFAULT now()\n   101\t);\n   102\t\n   103\tCREATE TABLE spend_quota (\n   104\t    scope      text NOT NULL,\n   105\t    key        text NOT NULL,\n   106\t    day        date NOT NULL,\n   107\t    spent_usd  numeric(12, 4) NOT NULL,\n   108\t    PRIMARY KEY (scope, key, day)\n   109\t);\n   110\t\n   111\tCREATE TABLE run_start_window (\n   112\t    scope   text NOT NULL,\n   113\t    key     text NOT NULL,\n   114\t    minute  timestamptz NOT NULL,\n   115\t    starts  integer NOT NULL,\n   116\t    PRIMARY KEY (scope, key, minute)\n   117\t);\n   118\t\n   119\t-- Runtime role: append-only audit, no access to control flags beyond reading.\n   120\tREVOKE ALL ON ALL TABLES IN SCHEMA public FROM procurement_agent;\n   121\tGRANT SELECT, INSERT ON audit_events TO procurement_agent;\n   122\tGRANT SELECT, INSERT, UPDATE ON approvals TO procurement_agent;\n   123\tGRANT SELECT ON approvers TO procurement_agent;\n   124\tGRANT SELECT, INSERT ON documents TO procurement_agent;\n   125\tGRANT SELECT, INSERT ON dept_notes TO procurement_agent;\n   126\tGRANT SELECT ON control_flags TO procurement_agent;\n   127\tGRANT SELECT, INSERT, UPDATE ON spend_quota TO procurement_agent;\n   128\tGRANT SELECT, INSERT, UPDATE ON run_start_window TO procurement_agent;\n   129\t\n   130\t-- Operators: halt and resume.\n   131\tGRANT SELECT, INSERT, UPDATE ON control_flags TO procurement_ops;\n   132\tGRANT SELECT ON audit_events TO procurement_ops;\n   133\tGRANT SELECT, UPDATE (verified, verified_by, quarantined) ON dept_notes TO procurement_ops;\n     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n{\n  \"sites\": [\n    {\n      \"id\": \"Ibbf3d10c2d\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/extractor.py:51\",\n      \"quote\": \"start_node = await audit.record(\"\n    },\n    {\n      \"id\": \"I1bba76f5cb\",\n      \"kind\": \"model_call\",\n      \"evidence\": \"app/extractor.py:74\",\n      \"quote\": \"response = await self.client.messages.create(**request)\"\n    },\n    {\n      \"id\": \"Idfed0c6536\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/extractor.py:78\",\n      \"quote\": \"decision = await audit.record(\"\n    },\n    {\n      \"id\": \"I989251408e\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/extractor.py:88\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"I4721ae44be\",\n      \"kind\": \"tool_call\",\n      \"evidence\": \"app/extractor.py:96\",\n      \"quote\": \"results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\"\n    },\n    {\n      \"id\": \"I27809e3c3d\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:133\",\n      \"quote\": \"run_node = await audit.record(\"\n    },\n    {\n      \"id\": \"I11d074af40\",\n      \"kind\": \"model_call\",\n      \"evidence\": \"app/loop.py:150\",\n      \"quote\": \"response = await self.client.messages.create(**request)\"\n    },\n    {\n      \"id\": \"Ib3e4db612c\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:154\",\n      \"quote\": \"decision = await audit.record(\"\n    },\n    {\n      \"id\": \"I687b22db00\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:167\",\n      \"quote\": \"await audit.record(pool, ident, kind=\\\"run_finished\\\", parent=run_node, context=ctx,\"\n    },\n    {\n      \"id\": \"I65e59182e1\",\n      \"kind\": \"tool_call\",\n      \"evidence\": \"app/loop.py:173\",\n      \"quote\": \"results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\"\n    },\n    {\n      \"id\": \"I6e9f9a2638\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:176\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"Icbe3633cb6\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:55\",\n      \"quote\": \"proposed = await audit.record(\"\n    },\n    {\n      \"id\": \"I4db5797679\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:61\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"Ia389c28cba\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:68\",\n      \"quote\": \"authz = await audit.record(\"\n    },\n    {\n      \"id\": \"I8165b2309f\",\n      \"kind\": \"tool_call\",\n      \"evidence\": \"app/loop.py:83\",\n      \"quote\": \"output = await tool.invoke(use.input, ident)\"\n    },\n    {\n      \"id\": \"I588419ff8b\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:87\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"I12a6ffed84\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:95\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"Iffaa43b340\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/main.py:76\",\n      \"quote\": \"await audit.record(app.state.pool, ident, kind=\\\"background_job\\\",\"\n    }\n  ],\n  \"s726:## E12 · G3 · C7/C8 — Fleet incident response\n727-\n728-**Lead:** Security. **Shares:** Operations, Governance, Business owner.\n729-\n730-### Requirement\n731-\n732-Run a drill where a shared tool or agent type is compromised. Find the affected instances and tenants. Quarantine the dependency, revoke the access involved, stop affected work, and alert the named responders. Check that alerts about abuse across agents, and about budgets, reach the team that can act. Name who decides whether to report outside the organization and share information.\n733-\n734-### Verification recipe\n735-\n736-Mark a shared test tool or version as compromised. Query which instances and tenants it affects, quarantine it, revoke the access involved, and trigger response alerts. Affected work must stop within the set targets. Responders must get identities and traces they can act on. Record who decided on outside reporting and information sharing.\n737-\n738-**Evidence to keep:** Fleet impact query, quarantine and revocation records, alert delivery and response times.\n739-\n740-### Checks for likely_pass\n741-\n742-Checks for likely_pass:\n743-\n744-- (none) Code can't show this item. Don't rate it likely_pass; use needs_evidence, gap, or na_candidate.\n745-\n746-### Not covered here\n747-\n748-File these problems under their owning item, not this one, unless this item's own requirement is also broken:\n749-\n750-- Kill switch for a single agent not drilled → **R11**\n751-- No owner named on each side of a shared control → **E01**\n752-- Tool or MCP server approved without vetting or pinning → **E02**\n753-- Budget and rate limits not enforced outside the model → **B07**\n754-\n755-### Heuristics\n756-\n757-**Provable from code:** no\n758-\n759-**Look for:**\n760-- An inventory or query that maps tool and dependency versions to instances and tenants.\n761-- Quarantine controls for a shared tool or agent type (gateway deny rule, registry block, feature flag).\n762-- Alert routes for cross-agent abuse and budget alerts to a named responder team.\n763-- An incident runbook that names who decides on outside reporting and information sharing.\n764-\n765-**Red flags:**\n766-- No way to find which deployments or tenants use a given tool version.\n{\n  \"brace_checklist\": \"2026-10-01\",\n  \"repo\": \"\",\n  \"commit\": null,\n  \"reviewed_at\": \"2026-10-20T15:04:04Z\",\n  \"scope\": \"TODO: what was reviewed and what wasn't.\",\n  \"review_protocol\": \"coverage-first-v1\",\n  \"findings\": [\n    {\n      \"item\": \"E10\",\n      \"gate\": \"G1\",\n      \"title\": \"Audit across service boundaries\",\n      \"requirement\": \"Rebuild a run across the gateway, tool services, and delegated workers, with all six identity fields kept. Check that the agent can't erase or rewrite its audit history, either directly or by asking a more powerful tool or peer. Check that a vendor boundary doesn't leave any action untraceable to the agent and instance that did it.\",\n      \"not_covered\": [\n        {\n          \"problem\": \"Audit retention, access, redaction, or export rules missing\",\n          \"owner\": \"E11\"\n        },\n        {\n          \"problem\": \"Authorization decisions missing the policy version in the run record\",\n          \"owner\": \"R13\"\n        },\n        {\n          \"problem\": \"Instance or tenant labels taken from what the model supplies\",\n          \"owner\": \"A04\"\n        },\n        {\n          \"problem\": \"Recovery checkpoints not tamper-evident\",\n          \"owner\": \"R14\"\n        }\n      ],\n      \"rating\": \"needs_evidence\",\n      \"confidence\": \"low\",\n      \"evidence\": [],\n      \"checks\": [\n        {\n          \"id\": \"E10.1\",\n          \"check\": \"The gateway, tool services, and delegated workers each write audit records with all six identity fields and the shared trace context.\",\n          \"verify\": \"1) Find audit writers in the gateway, tool services, and delegated workers. 2) Check each writes all six identity fields and the shared trace context. 3) Answer no if any component writes records without them or starts a new trace. Answer unknown if a component's code is outside this repo.\",\n          \"met\": \"unknown\",\n          \"evidence\": \"\",\n          \"quote\": \"\",\n          \"counter_search\": \"\",\n          \"note\": \"\",\n          \"coverage\": [],\n          \"deviations\": [],\n          \"attempts\": []\n        },\n        {\n          \"id\": \"E10.2\",\n          \"check\": \"The agent's credentials have no permission to delete, update, or overwrite audit records (for example an append-only or WORM store with IAM denies).\",\n          \"verify\": \"1) Find the agent's IAM role or database grants and the audit store config. 2) Check the agent has no delete, update, or overwrite rights (`DeleteObject`, overwriting `PutObject`, `UPDATE`, `DELETE`, `TRUNCATE`) and the store is append-only or WORM (Object Lock). 3) Answer no if the agent's credentials can delete or rewrite records, or grant `*`. Answer unknown if these are set outside this repo.\",\n          \"met\": \"unknown\",\n          \"evidence\": \"\",\n          \"quote\": \"\",\n          \"counter_search\": \"\",\n          \"note\": \"\",\n          \"coverage\": [],\n          \"deviations\": [],\n          \"attempts\": []","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_019nBxgicR5W2Rqyiaw6AHnq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
