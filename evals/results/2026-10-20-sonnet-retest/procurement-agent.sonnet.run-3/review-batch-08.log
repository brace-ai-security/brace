{ runDetails.builder.id }}\"\n   324\t                      operator: Equals\n   325\t                      value: \"https://github.com/actions/runner/github-hosted\"\n   326\t            - type: https://cyclonedx.org/bom\n   327\t              attestors:\n   328\t                - entries:\n   329\t                    - keyless:\n   330\t                        issuer: \"https://token.actions.githubusercontent.com\"\n   331\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n   332\tname: ci\n   333\t\n   334\ton:\n   335\t  pull_request:\n   336\t  push:\n   337\t    branches: [main]\n   338\t\n   339\tpermissions:\n   340\t  contents: read\n   341\t\n   342\tjobs:\n   343\t  test:\n   344\t    runs-on: ubuntu-24.04\n   345\t    steps:\n   346\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n   347\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n   348\t        with:\n   349\t          python-version: \"3.11\"\n   350\t      - run: pip install -e '.[test]'\n   351\t      - run: pytest -q\n   352\t      - name: Secret scan\n   353\t        uses: gitleaks/gitleaks-action@83373cf2f8c4db6e24b41c1a9b086bb9619e9cd3 # v2.3.7\n   354\t      - name: Manifest hashes match files\n   355\t        run: |\n   356\t          python - <<'PY'\n   357\t          import hashlib, yaml, sys\n   358\t          m = yaml.safe_load(open(\"release/manifest.yaml\"))\n   359\t          bad = []\n   360\t          for group in (\"prompts\", \"config\"):\n   361\t              for name, e in m[group].items():\n   362\t                  if isinstance(e, dict) and \"sha256\" in e:\n   363\t                      got = \"sha256:\" + hashlib.sha256(open(e[\"path\"], \"rb\").read()).hexdigest()\n   364\t                      if got != e[\"sha256\"]:\n   365\t                          bad.append(e[\"path\"])\n   366\t          if bad:\n   367\t       