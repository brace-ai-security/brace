nt\n   158\t      automountServiceAccountToken: false\n   159\t      hostUsers: false\n   160\t      enableServiceLinks: false\n   161\t      securityContext:\n   162\t        runAsNonRoot: true\n   163\t        runAsUser: 65532\n   164\t        runAsGroup: 65532\n   165\t        fsGroup: 65532\n   166\t        seccompProfile:\n   167\t          type: RuntimeDefault\n   168\t      containers:\n   169\t        - name: agent\n   170\t          image: registry.example-corp.test/procurement/agent@sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\n   171\t          imagePullPolicy: IfNotPresent\n   172\t          ports:\n   173\t            - containerPort: 8080\n   174\t              name: http\n   175\t          env:\n   176\t            - name: IMAGE_DIGEST\n   177\t              value: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n   178\t            - name: MODEL_ID\n   179\t              value: \"claude-sonnet-4-5-20250929\"\n   180\t            - name: EXTRACTOR_MODEL_ID\n   181\t              value: \"claude-haiku-4-5-20251001\"\n   182\t            - name: DATABASE_URL\n   183\t              value: \"postgresql://procurement_agent@procurement-db.procurement-data.svc.cluster.local:5432/procurement?sslmode=verify-full\"\n   184\t            - name: ERP_MCP_URL\n   185\t              value: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n   186\t            - name: PAYMENTS_API_URL\n   187\t              value: \"https://api.payments.example-pay.test\"\n   188\t            - name: SLACK_API_URL\n   189\t              value: \"https://slack-proxy.egress.svc.cluster.local:8443/api\"\n   190\t            - name: STS_URL\n   191\t              value: \"https://sts.identity.svc.cluster.local/oauth2/token\"\n   192\t            - name: OIDC_ISSUER\n   193\t              value: \"https://login.example-corp.test\"\n   194\t            - name: OIDC_JWKS_URL\n   195\t              value: \"https://login.example-corp.test/.well-known/jwks.json\"\n   196\t            - name: HTTPS_PROXY\n   197\t              value: \"http://egress-proxy.egress.svc.cluster.local:3128\"\n   198\t            - name: NO_PROXY\n   199\t              value: \".svc.cluster.local\"\n   200\t            - name: OTEL_EXPORTER_OTLP_ENDPOINT\n   201\t              value: \"http://otel-collector.observability.svc.cluster.local:4317\"\n   202\t            - name: OTEL_SERVICE_NAME\n   203\t              value: \"procurement-agent\"\n   204\t            - name: OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT\n   205\t              value: \"false\"\n   206\t          securityContext:\n   207\t            allowPrivilegeEscalation: false\n   208\t            privileged: false\n   209\t            readOnlyRootFilesystem: true\n   210\t            runAsNonRoot: true\n   211\t            capabilities:\n   212\t              drop: [\"ALL\"]\n   213\t            seccompProfile:\n   214\t              type: RuntimeDefault\n   215\t          resources:\n   216\t            requests:\n   217\t              cpu: 250m\n   218\t              memory: 512Mi\n   219\t            limits:\n   220\t              cpu: \"1\"\n   221\t              memory: 1Gi\n   222\t          readinessProbe:\n   223\t            httpGet:\n   224\t              path: /healthz\n   225\t              port: http\n   226\t          volumeMounts:\n   227\t            - name: workload-token\n   228\t              mountPath: /var/run/secrets/tokens\n   229\t              readOnly: true\n   230\t            - name: slack-signing\n   231\t              mountPath: /var/run/secrets/slack\n   232\t              readOnly: true\n   233\t            - name: mail-hmac\n   234\t              mountPath: /var/run/secrets/mail\n   235\t              readOnly: true\n   236\t            - name: tmp\n   237\t              mountPath: /tmp\n   238\t      volumes:\n   239\t        - name: workload-token\n   240\t          projected:\n   241\t            sources:\n   242\t              - serviceAccountToken:\n   243\t                  path: procurement-agent\n   244\t                  audience: sts.identity.example-corp.test\n   245\t                  expirationSeconds: 600\n   246\t        - name: slack-signing\n   247\t          secret:\n   248\t            secretName: procurement-slack-signing\n   249\t        - name: mail-hmac\n   250\t          secret:\n   251\t            secretName: procurement-mail-gateway-hmac\n   252\t        - name: tmp\n   253\t          emptyDir:\n   254\t            medium: Memory\n   255\t            sizeLimit: 64Mi\n   256\tapiVersion: kyverno.io/v1\n   257\tkind: ClusterPolicy\n   258\tmetadata:\n   259\t  name: procurement-verify-images\n   260\t  annotations:\n   261\t    policies.kyverno.io/title: Verify procurement agent images\n   262\t    kyverno.io/kyverno-version: \"1.15.2\"\n   263\tspec:\n   264\t  validationFailureAction: Enforce\n   265\t  background: false\n   266\t  webhookTimeoutSeconds: 15\n   267\t  failurePolicy: Fail\n   268\t  rules:\n   269\t    - name: only-approved-registry\n   270\t      match:\n   271\t        any:\n   272\t          - resources:\n   273\t              kinds: [Pod]\n   274\t              namespaces: [procurement-prod]\n   275\t      validate:\n   276\t        message: \"Images in procurement-prod must come from registry.example-corp.test/procurement and be pinned by digest.\"\n   277\t        pattern:\n   278\t          spec:\n   279\t            =(initContainers):\n   280\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n   281\t            containers:\n   282\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n   283\t    - name: verify-signature-and-provenance\n   284\t      match:\n   285\t        any:\n   286\t          - resources:\n   287\t              kinds: [Pod]\n   288\t              namespaces: [procurement-prod]\n   289\t      verifyImages:\n   290\t        - imageRefere