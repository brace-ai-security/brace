1\t  \"asyncpg==0.30.0\",\n    32\t  \"httpx==0.28.1\",\n    33\t  \"pydantic==2.10.4\",\n    34\t  \"pyyaml==6.0.2\",\n    35\t  \"pyjwt[crypto]==2.10.1\",\n    36\t  \"pypdf==5.1.0\",\n    37\t  \"anthropic==0.75.0\",\n    38\t  \"opentelemetry-sdk==1.29.0\",\n    39\t  \"opentelemetry-exporter-otlp==1.29.0\",\n    40\t]\n    41\t\n    42\t[project.optional-dependencies]\n    43\ttest = [\"pytest==8.3.4\", \"pytest-asyncio==0.25.0\"]\n    44\t\n    45\t[tool.pytest.ini_options]\n    46\tasyncio_mode = \"auto\"\n    47\ttestpaths = [\"tests\"]\n    48\t# Release manifest for the procurement agent. Regenerated by CI on every\n    49\t# release build (see .github/workflows/ci.yaml, job \"release\").\n    50\trelease: \"procurement-agent 2026.09.4\"\n    51\towner: team-procurement-platform\n    52\t\n    53\timage:\n    54\t  repository: registry.example-corp.test/procurement/agent\n    55\t  digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n    56\t  sbom: \"registry.example-corp.test/procurement/agent:sha256-7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0.sbom\"\n    57\t  signer:\n    58\t    issuer: \"https://token.actions.githubusercontent.com\"\n    59\t    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    60\t\n    61\tharness:\n    62\t  source_commit: \"3f9a1c7e2b8d4f6a0c5e9b1d7f3a8c2e6b4d0f91\"\n    63\t  digest: \"sha256:5b2d8f1a9c3e7b0d4f6a2c8e1b5d9f3a7c0e4b8d2f6a1c5e9b3d7f0a4c8e2b6d\"\n    64\t\n    65\tprompts:\n    66\t  system:\n    67\t    path: prompts/system.md\n    68\t    sha256: \"sha256:dcf69216667e65a0be3711d99aac81b707ba843296e7ce26d6fcbdb50c5bcc50\"\n    69\t  extractor:\n    70\t    path: prompts/extractor.md\n    71\t    sha256: \"sha256:6ef6527b77ffcca8851e7a8760e6373f3daede15d5b343b878737f0deec28de3\"\n    72\t\n    73\tconfig:\n    74\t  policy:\n    75\t    path: config/policy.yaml\n    76\t    version: \"proc-policy-2026.09.