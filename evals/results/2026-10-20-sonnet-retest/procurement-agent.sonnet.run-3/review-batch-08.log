{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014deM989TBAAfLc5jg8Mdx5","type":"tool_result","content":"     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t\n    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )\n     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport hashlib\n     6\timport hmac\n     7\timport json\n     8\timport logging\n     9\timport time\n    10\timport uuid\n    11\tfrom contextlib import asynccontextmanager\n    12\tfrom pathlib import Path\n    13\tfrom urllib.parse import parse_qs\n    14\t\n    15\timport asyncpg\n    16\timport jwt\n    17\tfrom anthropic import AsyncAnthropic\n    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n    20\tfrom opentelemetry import trace\n    21\tfrom pydantic import BaseModel, Field\n    22\t\n    23\tfrom app import audit, ingest\n    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n    25\tfrom app.extractor import LineItemExtractor\n    26\tfrom app.gate import PolicyGate\n    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n    28\tfrom app.loop import AgentDeps, ProcurementAgent\n    29\tfrom app.mcp_client import ErpMcpClient\n    30\tfrom app.redact import RedactingFilter\n    31\tfrom app.settings import get_settings\n    32\tfrom app.startup import startup_checks\n    33\tfrom app.tools.slack import SlackClient\n    34\t\n    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n    36\tfor handler in logging.getLogger().handlers:\n    37\t    handler.addFilter(RedactingFilter())\n    38\tlog = logging.getLogger(\"procurement\")\n    39\t\n    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    41\tbearer = HTTPBearer()\n    42\t\n    43\t\n    44\tclass RunRequest(BaseModel):\n    45\t    task: str = Field(min_length=1, max_length=4000)\n    46\t    department: str = Field(min_length=1, max_length=64)\n    47\t\n    48\t\n    49\tclass Principal(BaseModel):\n    50\t    subject: str\n    51\t    business_unit: str\n    52\t\n    53\t\n    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    55\t    return RunIdentity(\n    56\t        accountable_party=\"system:procurement-agent\",\n    57\t        operational_owner=settings.operational_owner,\n    58\t        tenant=tenant,\n    59\t        agent_type_id=agent_type_id,\n    60\t        agent_instance_id=new_instance_id(),\n    61\t        trace_id=uuid.uuid4().hex,\n    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n    63\t        delegated_subject=\"system:procurement-agent\",\n    64\t        agent_principal=AGENT_PRINCIPAL,\n    65\t    )\n    66\t\n    67\t\n    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n    69\t    while True:\n    70\t        await asyncio.sleep(60)\n    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n    72\t        count = await app.state.pool.fetchval(\n    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n    75\t        )\n    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n    78\t\n    79\t\n    80\t@asynccontextmanager\n    81\tasync def lifespan(app: FastAPI):\n    82\t    settings = get_settings()\n    83\t    agent_type_id = startup_checks(settings)\n    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    85\t    broker = TokenBroker(settings)\n    86\t\n    87\t    async def slack_token() -> str:\n    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n    89\t\n    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n    92\t    gate = PolicyGate(settings.policy, approvals)\n    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n    95\t\n    96\t    client = AsyncAnthropic()\n    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    98\t    deps.extractor = LineItemExtractor(\n    99\t        client=client, settings=settings, deps=deps,\n   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n   101\t    )\n   102\t    app.state.settings = settings\n   103\t    app.state.pool = pool\n   104\t    app.state.agent_type_id = agent_type_id\n   105\t    app.state.approvals = approvals\n   106\t    app.state.agent = ProcurementAgent(\n   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n   108\t    )\n   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n   111\t    try:\n   112\t        yield\n   113\t    finally:\n   114\t        sweeper.cancel()\n   115\t        await pool.close()\n   116\t\n   117\t\n   118\tapp = FastAPI(lifespan=lifespan)\n   119\tapp.include_router(ingest.router)\n   120\t\n   121\t\n   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n   123\t    settings = request.app.state.settings\n   124\t    try:\n   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n   126\t        claims = jwt.decode(\n   127\t            creds.credentials,\n   128\t            key.key,\n   129\t            algorithms=[\"RS256\", \"ES256\"],\n   130\t            audience=settings.oidc_audience,\n   131\t            issuer=settings.oidc_issuer,\n   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n   133\t        )\n   134\t    except jwt.PyJWTError as exc:\n   135\t        raise HTTPException(401, \"invalid token\") from exc\n   136\t    bu = claims.get(\"bu\")\n   137\t    if not bu:\n   138\t        raise HTTPException(403, \"token has no business unit\")\n   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n   140\t\n   141\t\n   142\t@app.post(\"/runs\")\n   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n   144\t    settings = request.app.state.settings\n   145\t    span_ctx = trace.get_current_span().get_span_context()\n   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n   147\t    ident = RunIdentity(\n   148\t        accountable_party=principal.subject,\n   149\t        operational_owner=settings.operational_owner,\n   150\t        tenant=principal.business_unit,\n   151\t        agent_type_id=request.app.state.agent_type_id,\n   152\t        agent_instance_id=new_instance_id(),\n   153\t        trace_id=trace_id,\n   154\t        run_id=f\"run-{uuid.uuid4()}\",\n   155\t        delegated_subject=principal.subject,\n   156\t        agent_principal=AGENT_PRINCIPAL,\n   157\t    )\n   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n   161\t\n   162\t\n   163\t@app.post(\"/slack/interactions\")\n   164\tasync def slack_interactions(request: Request) -> dict:\n   165\t    body = await request.body()\n   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n   167\t    if abs(time.time() - int(timestamp)) > 300:\n   168\t        raise HTTPException(401, \"stale request\")\n   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n   172\t        raise HTTPException(401, \"bad signature\")\n   173\t\n   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n   175\t    action = payload[\"actions\"][0]\n   176\t    slack_user = payload[\"user\"][\"id\"]\n   177\t    row = await request.app.state.pool.fetchrow(\n   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n   179\t    )\n   180\t    if row is None:\n   181\t        raise HTTPException(403, \"not an approver\")\n   182\t    try:\n   183\t        await request.app.state.approvals.decide(\n   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n   185\t            approve=action[\"action_id\"] == \"approve\",\n   186\t        )\n   187\t    except ApproverNotAuthorized as exc:\n   188\t        raise HTTPException(403, str(exc)) from exc\n   189\t    except ValueError as exc:\n   190\t        raise HTTPException(409, str(exc)) from exc\n   191\t    return {\"ok\": True}\n   192\t\n   193\t\n   194\t@app.get(\"/healthz\")\n   195\tasync def healthz() -> dict:\n   196\t    return {\"ok\": True}\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n# procurement-agent\n\nProcurement agent for Example Corp business units. It reads vendor quotes and\ninvoices that arrive by email, checks them against department budgets, raises\npurchase orders in the ERP, pays matched invoices, and talks to staff and\nvendors in Slack. It keeps short per-department notes between runs.\n\n## Architecture\n\n```\nmail gateway --HMAC--> /ingest/mail --> documents (Postgres, per business unit)\nstaff (OIDC JWT) ----> /runs --> ProcurementAgent loop (app/loop.py)\n                                   |-- PolicyGate (app/gate.py) + approvals (Slack buttons)\n                                   |-- Budget (app/budget.py)\n                                   |-- audit graph (app/audit.py -> audit_events)\n                                   |-- tools:\n                                   |     read_document, extract_line_items -> LineItemExtractor sub-agent\n                                   |     get_budget, erp_call, create_purchase_order -> ERP MCP via gateway\n                                   |     pay_invoice -> payments API\n                                   |     post_slack_message -> Slack (via slack-proxy)\n                                   |     memory_read, memory_write -> dept_notes\n```\n\n* **Tenancy.** Each run belongs to one business unit, taken from the `bu`\n  claim of the caller's verified OIDC token. Documents, notes, approvals and\n  quotas are keyed by business unit.\n* **Identity.** The agent runs as the `procurement-agent` service account.\n  Its projected token (10-minute lifetime) is exchanged at the internal STS\n  for audience-bound tokens for the ERP gateway, payments API and Slack\n  proxy. User tokens are never forwarded.\n* **Approvals.** `create_purchase_order`, `pay_invoice` and vendor messages\n  require an approval from a role listed in `config/policy.yaml`. Approval\n  requests are posted to `#approvals-<bu>` with the argument summary.\n* **Budgets.** Per-run step, time, token, cost, tool-rate and sub-agent\n  limits, plus per-user, per-business-unit and fleet quotas for daily spend\n  and run starts. See `config/policy.yaml`.\n* **Audit.** Every run step is a row in `audit_events` linked to its parent\n  step, with the six identity fields, policy version, approval id and\n  decision-time context size. The agent's database role can insert audit\n  rows but not update or delete them.\n\n## Context size\n\nLogged on every audit row as `context_tokens` and `context_method`:\n\n| method | meaning |\n|---|---|\n| `count_tokens_api` | exact request counted with the provider's token-count endpoint before the call (includes cached prefix) |\n| `usage_sum_estimate` | counting failed; `input_tokens + cache_read + cache_creation` from the response |\n| `unavailable` | neither available; `context_tokens` is NULL, never 0 |\n\n`context_compacted` is true when the harness dropped earlier turns before the\ncall (`app/loop.py:_compact`). Provider-side truncation is not visible.\n\n## Operating\n\n* **Halt.** Insert or update a row in `control_flags` (`scope = 'fleet'` or\n  `'tenant:<bu>'`, `halted = true`) as `procurement_ops`. New runs refuse to\n  start while a halt is set.\n* **Release.** Merges to `main` build, sign (keyless cosign), and attest the\n  image (SLSA provenance and CycloneDX SBOM). Kyverno rejects unsigned or\n  unattested images in `procurement-prod`.\n* **Network.** Default-deny egress with explicit rules for DNS, the egress\n  proxy, the Slack proxy, the database, the ERP gateway and the STS.\n\n## Tests\n\n```bash\npip install -e '.[test]'\npytest -q\n```\nversion: \"proc-policy-2026.09.3\"\n\n# Operations that change money, vendor records, or purchase commitments.\n# Denied unless a valid approval exists for the operation and its target.\nhigh_impact_tools:\n  - create_purchase_order\n  - pay_invoice\n\nerp:\n  # Namespaces the agent may reach through the generic erp_call tool.\n  read_prefixes:\n    - \"budget.\"\n    - \"vendor.\"\n    - \"invoice.\"\n    - \"po.get\"\n    - \"po.list\"\n  # Scope requested from the STS for each ERP operation; the ERP enforces it.\n  operation_scopes:\n    budget.get_remaining: \"erp.read\"\n    vendor.get: \"erp.read\"\n    vendor.search: \"erp.read\"\n    vendor.update_remit_to: \"erp.read erp.vendor.write\"\n    invoice.get: \"erp.read\"\n    invoice.list_open: \"erp.read\"\n    invoice.mark_paid: \"erp.read erp.invoice.write\"\n    invoice.void: \"erp.read erp.invoice.write\"\n    po.get: \"erp.read\"\n    po.list_open: \"erp.read\"\n    po.create: \"erp.read erp.po.create\"\n\napprovals:\n  ttl_minutes: 60\n  approver_roles:\n    pay_invoice: [ap_manager, finance_controller]\n    create_purchase_order: [budget_owner, finance_controller]\n    post_slack_message: [procurement_lead]\n\nbudgets:\n  per_run:\n    max_steps: 25\n    max_wall_seconds: 300\n    max_tokens: 400000\n    max_cost_usd: 4.00\n    max_tool_calls_per_minute: 30\n    max_subagents: 3\n  quotas_daily_usd:\n    user: 25\n    tenant: 250\n    fleet: 1500\n  run_starts_per_minute:\n    user: 5\n    tenant: 40\n    fleet: 200","is_error":false}]},"parent_tool_use_id":null,"session_id":"5f869e3f-f241-45bc-af3e-8b584d6df4d1","uuid":"57369611-fe22-49a7-a26c-0c14aab20f9d","timestamp":"2026-10-20T14:50:29.429Z","tool_use_result":{"stdout":"     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t\n    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )\n     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport hashlib\n     6\timport hmac\n     7\timport json\n     8\timport logging\n     9\timport time\n    10\timport uuid\n    11\tfrom contextlib import asynccontextmanager\n    12\tfrom pathlib import Path\n    13\tfrom urllib.parse import parse_qs\n    14\t\n    15\timport asyncpg\n    16\timport jwt\n    17\tfrom anthropic import AsyncAnthropic\n    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n    20\tfrom opentelemetry import trace\n    21\tfrom pydantic import BaseModel, Field\n    22\t\n    23\tfrom app import audit, ingest\n    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n    25\tfrom app.extractor import LineItemExtractor\n    26\tfrom app.gate import PolicyGate\n    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n    28\tfrom app.loop import AgentDeps, ProcurementAgent\n    29\tfrom app.mcp_client import ErpMcpClient\n    30\tfrom app.redact import RedactingFilter\n    31\tfrom app.settings import get_settings\n    32\tfrom app.startup import startup_checks\n    33\tfrom app.tools.slack import SlackClient\n    34\t\n    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n    36\tfor handler in logging.getLogger().handlers:\n    37\t    handler.addFilter(RedactingFilter())\n    38\tlog = logging.getLogger(\"procurement\")\n    39\t\n    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    41\tbearer = HTTPBearer()\n    42\t\n    43\t\n    44\tclass RunRequest(BaseModel):\n    45\t    task: str = Field(min_length=1, max_length=4000)\n    46\t    department: str = Field(min_length=1, max_length=64)\n    47\t\n    48\t\n    49\tclass Principal(BaseModel):\n    50\t    subject: str\n    51\t    business_unit: str\n    52\t\n    53\t\n    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    55\t    return RunIdentity(\n    56\t        accountable_party=\"system:procurement-agent\",\n    57\t        operational_owner=settings.operational_owner,\n    58\t        tenant=tenant,\n    59\t        agent_type_id=agent_type_id,\n    60\t        agent_instance_id=new_instance_id(),\n    61\t        trace_id=uuid.uuid4().hex,\n    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n    63\t        delegated_subject=\"system:procurement-agent\",\n    64\t        agent_principal=AGENT_PRINCIPAL,\n    65\t    )\n    66\t\n    67\t\n    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n    69\t    while True:\n    70\t        await asyncio.sleep(60)\n    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n    72\t        count = await app.state.pool.fetchval(\n    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n    75\t        )\n    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n    78\t\n    79\t\n    80\t@asynccontextmanager\n    81\tasync def lifespan(app: FastAPI):\n    82\t    settings = get_settings()\n    83\t    agent_type_id = startup_checks(settings)\n    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    85\t    broker = TokenBroker(settings)\n    86\t\n    87\t    async def slack_token() -> str:\n    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n    89\t\n    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n    92\t    gate = PolicyGate(settings.policy, approvals)\n    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n    95\t\n    96\t    client = AsyncAnthropic()\n    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    98\t    deps.extractor = LineItemExtractor(\n    99\t        client=client, settings=settings, deps=deps,\n   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n   101\t    )\n   102\t    app.state.settings = settings\n   103\t    app.state.pool = pool\n   104\t    app.state.agent_type_id = agent_type_id\n   105\t    app.state.approvals = approvals\n   106\t    app.state.agent = ProcurementAgent(\n   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n   108\t    )\n   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n   111\t    try:\n   112\t        yield\n   113\t    finally:\n   114\t        sweeper.cancel()\n   115\t        await pool.close()\n   116\t\n   117\t\n   118\tapp = FastAPI(lifespan=lifespan)\n   119\tapp.include_router(ingest.router)\n   120\t\n   121\t\n   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n   123\t    settings = request.app.state.settings\n   124\t    try:\n   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n   126\t        claims = jwt.decode(\n   127\t            creds.credentials,\n   128\t            key.key,\n   129\t            algorithms=[\"RS256\", \"ES256\"],\n   130\t            audience=settings.oidc_audience,\n   131\t            issuer=settings.oidc_issuer,\n   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n   133\t        )\n   134\t    except jwt.PyJWTError as exc:\n   135\t        raise HTTPException(401, \"invalid token\") from exc\n   136\t    bu = claims.get(\"bu\")\n   137\t    if not bu:\n   138\t        raise HTTPException(403, \"token has no business unit\")\n   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n   140\t\n   141\t\n   142\t@app.post(\"/runs\")\n   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n   144\t    settings = request.app.state.settings\n   145\t    span_ctx = trace.get_current_span().get_span_context()\n   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n   147\t    ident = RunIdentity(\n   148\t        accountable_party=principal.subject,\n   149\t        operational_owner=settings.operational_owner,\n   150\t        tenant=principal.business_unit,\n   151\t        agent_type_id=request.app.state.agent_type_id,\n   152\t        agent_instance_id=new_instance_id(),\n   153\t        trace_id=trace_id,\n   154\t        run_id=f\"run-{uuid.uuid4()}\",\n   155\t        delegated_subject=principal.subject,\n   156\t        agent_principal=AGENT_PRINCIPAL,\n   157\t    )\n   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n   161\t\n   162\t\n   163\t@app.post(\"/slack/interactions\")\n   164\tasync def slack_interactions(request: Request) -> dict:\n   165\t    body = await request.body()\n   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n   167\t    if abs(time.time() - int(timestamp)) > 300:\n   168\t        raise HTTPException(401, \"stale request\")\n   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n   172\t        raise HTTPException(401, \"bad signature\")\n   173\t\n   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n   175\t    action = payload[\"actions\"][0]\n   176\t    slack_user = payload[\"user\"][\"id\"]\n   177\t    row = await request.app.state.pool.fetchrow(\n   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n   179\t    )\n   180\t    if row is None:\n   181\t        raise HTTPException(403, \"not an approver\")\n   182\t    try:\n   183\t        await request.app.state.approvals.decide(\n   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n   185\t            approve=action[\"action_id\"] == \"approve\",\n   186\t        )\n   187\t    except ApproverNotAuthorized as exc:\n   188\t        raise HTTPException(403, str(exc)) from exc\n   189\t    except ValueError as exc:\n   190\t        raise HTTPException(409, str(exc)) from exc\n   191\t    return {\"ok\": True}\n   192\t\n   193\t\n   194\t@app.get(\"/healthz\")\n   195\tasync def healthz() -> dict:\n   196\t    return {\"ok\": True}\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n# procurement-agent\n\nProcurement agent for Example Corp business units. It reads vendor quotes and\ninvoices that arrive by email, checks them against department budgets, raises\npurchase orders in the ERP, pays matched invoices, and talks to staff and\nvendors in Slack. It keeps short per-department notes between runs.\n\n## Architecture\n\n```\nmail gateway --HMAC--> /ingest/mail --> documents (Postgres, per business unit)\nstaff (OIDC JWT) ----> /runs --> ProcurementAgent loop (app/loop.py)\n                                   |-- PolicyGate (app/gate.py) + approvals (Slack buttons)\n                                   |-- Budget (app/budget.py)\n                                   |-- audit graph (app/audit.py -> audit_events)\n                                   |-- tools:\n                                   |     read_document, extract_line_items -> LineItemExtractor sub-agent\n                                   |     get_budget, erp_call, create_purchase_order -> ERP MCP via gateway\n                                   |     pay_invoice -> payments API\n                                   |     post_slack_message -> Slack (via slack-proxy)\n                                   |     memory_read, memory_write -> dept_notes\n```\n\n* **Tenancy.** Each run belongs to one business unit, taken from the `bu`\n  claim of the caller's verified OIDC token. Documents, notes, approvals and\n  quotas are keyed by business unit.\n* **Identity.** The agent runs as the `procurement-agent` service account.\n  Its projected token (10-minute lifetime) is exchanged at the internal STS\n  for audience-bound tokens for the ERP gateway, payments API and Slack\n  proxy. User tokens are never forwarded.\n* **Approvals.** `create_purchase_order`, `pay_invoice` and vendor messages\n  require an approval from a role listed in `config/policy.yaml`. Approval\n  requests are posted to `#approvals-<bu>` with the argument summary.\n* **Budgets.** Per-run step, time, token, cost, tool-rate and sub-agent\n  limits, plus per-user, per-business-unit and fleet quotas for daily spend\n  and run starts. See `config/policy.yaml`.\n* **Audit.** Every run step is a row in `audit_events` linked to its parent\n  step, with the six identity fields, policy version, approval id and\n  decision-time context size. The agent's database role can insert audit\n  rows but not update or delete them.\n\n## Context size\n\nLogged on every audit row as `context_tokens` and `context_method`:\n\n| method | meaning |\n|---|---|\n| `count_tokens_api` | exact request counted with the provider's token-count endpoint before the call (includes cached prefix) |\n| `usage_sum_estimate` | counting failed; `input_tokens + cache_read + cache_creation` from the response |\n| `unavailable` | neither available; `context_tokens` is NULL, never 0 |\n\n`context_compacted` is true when the harness dropped earlier turns before the\ncall (`app/loop.py:_compact`). Provider-side truncation is not visible.\n\n## Operating\n\n* **Halt.** Insert or update a row in `control_flags` (`scope = 'fleet'` or\n  `'tenant:<bu>'`, `halted = true`) as `procurement_ops`. New runs refuse to\n  start while a halt is set.\n* **Release.** Merges to `main` build, sign (keyless cosign), and attest the\n  image (SLSA provenance and CycloneDX SBOM). Kyverno rejects unsigned or\n  unattested images in `procurement-prod`.\n* **Network.** Default-deny egress with explicit rules for DNS, the egress\n  proxy, the Slack proxy, the database, the ERP gateway and the STS.\n\n## Tests\n\n```bash\npip install -e '.[test]'\npytest -q\n```\nversion: \"proc-policy-2026.09.3\"\n\n# Operations that change money, vendor records, or purchase commitments.\n# Denied unless a valid approval exists for the operation and its target.\nhigh_impact_tools:\n  - create_purchase_order\n  - pay_invoice\n\nerp:\n  # Namespaces the agent may reach through the generic erp_call tool.\n  read_prefixes:\n    - \"budget.\"\n    - \"vendor.\"\n    - \"invoice.\"\n    - \"po.get\"\n    - \"po.list\"\n  # Scope requested from the STS for each ERP operation; the ERP enforces it.\n  operation_scopes:\n    budget.get_remaining: \"erp.read\"\n    vendor.get: \"erp.read\"\n    vendor.search: \"erp.read\"\n    vendor.update_remit_to: \"erp.read erp.vendor.write\"\n    invoice.get: \"erp.read\"\n    invoice.list_open: \"erp.read\"\n    invoice.mark_paid: \"erp.read erp.invoice.write\"\n    invoice.void: \"erp.read erp.invoice.write\"\n    po.get: \"erp.read\"\n    po.list_open: \"erp.read\"\n    po.create: \"erp.read erp.po.create\"\n\napprovals:\n  ttl_minutes: 60\n  approver_roles:\n    pay_invoice: [ap_manager, finance_controller]\n    create_purchase_order: [budget_owner, finance_controller]\n    post_slack_message: [procurement_lead]\n\nbudgets:\n  per_run:\n    max_steps: 25\n    max_wall_seconds: 300\n    max_tokens: 400000\n    max_cost_usd: 4.00\n    max_tool_calls_per_minute: 30\n    max_subagents: 3\n  quotas_daily_usd:\n    user: 25\n    tenant: 250\n    fleet: 1500\n  run_starts_per_minute:\n    user: 5\n    tenant: 40\n    fleet: 200","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014deM989TBAAfLc5jg8Mdx5","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
