{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDgjptBAp1CmYxTpuiAD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WwhC7ekV8bhc6GUXcjTWSA","name":"Bash","input":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-wor1kxam/agent; cat -n app/tools/documents.py app/budget.py | head -330; cat release/manifest.yaml; grep -rn -i \"peer\\|a2a\\|webhook\\|callback\\|cancel\\|revoke\\|retry\\|restart\\|queue\\|schedul\" --include=* -r app deploy config Dockerfile prompts | grep -v \"^brace\" | head -40; sed -n 1,60p app/approvals.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9715,"cache_read_input_tokens":34668,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9715},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cbd916c9-65cb-4ab5-bb81-2cf8214fc421","uuid":"59180df4-ad2e-455d-9430-98be8a044ace","timestamp":"2026-10-20T14:58:14.433Z","request_id":"req_011CgDgjpLgCzS5f3MJjcKWb","wire_tool_inputs":{"toolu_01WwhC7ekV8bhc6GUXcjTWSA":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-wor1kxam/agent; cat -n app/tools/documents.py app/budget.py | head -330; cat release/manifest.yaml; grep -rn -i \"peer\\|a2a\\|webhook\\|callback\\|cancel\\|revoke\\|retry\\|restart\\|queue\\|schedul\" --include=* -r app deploy config Dockerfile prompts | grep -v \"^brace\" | head -40; sed -n 1,60p app/approvals.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WwhC7ekV8bhc6GUXcjTWSA","type":"tool_result","content":"     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tUNTRUSTED_WRAPPER = (\n    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n    11\t    \"{text}\\n\"\n    12\t    \"</untrusted_document>\"\n    13\t)\n    14\t\n    15\t\n    16\tdef tools(deps) -> list[Tool]:\n    17\t    pool = deps.pool\n    18\t\n    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n    20\t        row = await pool.fetchrow(\n    21\t            \"\"\"\n    22\t            SELECT doc_id, source, media_type, text\n    23\t            FROM documents\n    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n    25\t            \"\"\",\n    26\t            args[\"doc_id\"],\n    27\t            ident.tenant,\n    28\t        )\n    29\t        if row is None:\n    30\t            return \"document not found\"\n    31\t        return UNTRUSTED_WRAPPER.format(\n    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n    33\t        )\n    34\t\n    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n    37\t\n    38\t    return [\n    39\t        Tool(\n    40\t            name=\"read_document\",\n    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n    42\t            input_schema={\n    43\t                \"type\": \"object\",\n    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    45\t                \"required\": [\"doc_id\"],\n    46\t                \"additionalProperties\": False,\n    47\t            },\n    48\t            invoke=read_document,\n    49\t        ),\n    50\t        Tool(\n    51\t            name=\"extract_line_items\",\n    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n    53\t            input_schema={\n    54\t                \"type\": \"object\",\n    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    56\t                \"required\": [\"doc_id\"],\n    57\t                \"additionalProperties\": False,\n    58\t            },\n    59\t            invoke=extract_line_items,\n    60\t        ),\n    61\t    ]\n     1\t\"\"\"Hard execution budgets, enforced by the harness and not by the model.\n     2\t\n     3\tPer run: step count, wall-clock time, tokens, cost, tool-call rate, and\n     4\tnumber of sub-agents. Sub-agents charge the parent's budget, so a child\n     5\tcannot widen what the parent was given.\n     6\t\n     7\tAcross runs: daily spend and per-minute run starts per user, per tenant\n     8\t(business unit), and for the whole fleet. Quotas are reserved in Postgres\n     9\tinside one transaction, so concurrent runs cannot overshoot them.\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport time\n    14\tfrom collections import deque\n    15\tfrom dataclasses import dataclass, field\n    16\tfrom decimal import Decimal\n    17\t\n    18\tfrom app.identity import RunIdentity\n    19\t\n    20\t\n    21\tclass BudgetExceeded(Exception):\n    22\t    def __init__(self, limit: str, used, allowed):\n    23\t        super().__init__(f\"{limit} exceeded: used={used} allowed={allowed}\")\n    24\t        self.limit = limit\n    25\t        self.used = used\n    26\t        self.allowed = allowed\n    27\t\n    28\t\n    29\t# USD per million tokens, from the provider price sheet referenced in the manifest.\n    30\tPRICES = {\n    31\t    \"claude-sonnet-4-5-20250929\": (Decimal(\"3.00\"), Decimal(\"15.00\")),\n    32\t    \"claude-haiku-4-5-20251001\": (Decimal(\"1.00\"), Decimal(\"5.00\")),\n    33\t}\n    34\t\n    35\t\n    36\t@dataclass\n    37\tclass Budget:\n    38\t    ident: RunIdentity\n    39\t    max_steps: int\n    40\t    max_wall_seconds: float\n    41\t    max_tokens: int\n    42\t    max_cost_usd: Decimal\n    43\t    max_tool_calls_per_minute: int\n    44\t    max_subagents: int\n    45\t    quotas_daily_usd: dict[str, Decimal]\n    46\t    run_starts_per_minute: dict[str, int]\n    47\t    started_at: float = field(default_factory=time.monotonic)\n    48\t    steps: int = 0\n    49\t    tokens: int = 0\n    50\t    cost_usd: Decimal = Decimal(\"0\")\n    51\t    unflushed_cost_usd: Decimal = Decimal(\"0\")\n    52\t    subagents: int = 0\n    53\t    _tool_calls: deque = field(default_factory=deque)\n    54\t\n    55\t    @classmethod\n    56\t    def for_run(cls, cfg: dict, ident: RunIdentity) -> \"Budget\":\n    57\t        run = cfg[\"per_run\"]\n    58\t        return cls(\n    59\t            ident=ident,\n    60\t            max_steps=int(run[\"max_steps\"]),\n    61\t            max_wall_seconds=float(run[\"max_wall_seconds\"]),\n    62\t            max_tokens=int(run[\"max_tokens\"]),\n    63\t            max_cost_usd=Decimal(str(run[\"max_cost_usd\"])),\n    64\t            max_tool_calls_per_minute=int(run[\"max_tool_calls_per_minute\"]),\n    65\t            max_subagents=int(run[\"max_subagents\"]),\n    66\t            quotas_daily_usd={k: Decimal(str(v)) for k, v in cfg[\"quotas_daily_usd\"].items()},\n    67\t            run_starts_per_minute={k: int(v) for k, v in cfg[\"run_starts_per_minute\"].items()},\n    68\t        )\n    69\t\n    70\t    def _scopes(self) -> list[tuple[str, str]]:\n    71\t        return [\n    72\t            (\"user\", self.ident.accountable_party),\n    73\t            (\"tenant\", self.ident.tenant),\n    74\t            (\"fleet\", \"all\"),\n    75\t        ]\n    76\t\n    77\t    # --- per-run limits -------------------------------------------------\n    78\t\n    79\t    def check_step(self) -> None:\n    80\t        self.steps += 1\n    81\t        if self.steps > self.max_steps:\n    82\t            raise BudgetExceeded(\"max_steps\", self.steps, self.max_steps)\n    83\t        elapsed = time.monotonic() - self.started_at\n    84\t        if elapsed > self.max_wall_seconds:\n    85\t            raise BudgetExceeded(\"max_wall_seconds\", round(elapsed, 1), self.max_wall_seconds)\n    86\t\n    87\t    def charge_model(self, model: str, usage) -> None:\n    88\t        price_in, price_out = PRICES[model]\n    89\t        tokens_in = (\n    90\t            int(usage.input_tokens or 0)\n    91\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n    92\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n    93\t        )\n    94\t        tokens_out = int(usage.output_tokens or 0)\n    95\t        self.tokens += tokens_in + tokens_out\n    96\t        cost = (price_in * tokens_in + price_out * tokens_out) / Decimal(1_000_000)\n    97\t        self.cost_usd += cost\n    98\t        self.unflushed_cost_usd += cost\n    99\t        if self.tokens > self.max_tokens:\n   100\t            raise BudgetExceeded(\"max_tokens\", self.tokens, self.max_tokens)\n   101\t        if self.cost_usd > self.max_cost_usd:\n   102\t            raise BudgetExceeded(\"max_cost_usd\", self.cost_usd, self.max_cost_usd)\n   103\t\n   104\t    def check_tool_call(self, now: float | None = None) -> None:\n   105\t        now = time.monotonic() if now is None else now\n   106\t        while self._tool_calls and now - self._tool_calls[0] > 60:\n   107\t            self._tool_calls.popleft()\n   108\t        if len(self._tool_calls) >= self.max_tool_calls_per_minute:\n   109\t            raise BudgetExceeded(\n   110\t                \"max_tool_calls_per_minute\", len(self._tool_calls) + 1, self.max_tool_calls_per_minute\n   111\t            )\n   112\t        self._tool_calls.append(now)\n   113\t\n   114\t    def check_subagent(self) -> None:\n   115\t        if self.subagents >= self.max_subagents:\n   116\t            raise BudgetExceeded(\"max_subagents\", self.subagents + 1, self.max_subagents)\n   117\t        self.subagents += 1\n   118\t\n   119\t    # --- cross-run quotas -----------------------------------------------\n   120\t\n   121\t    async def reserve_run_start(self, pool) -> None:\n   122\t        async with pool.acquire() as conn:\n   123\t            async with conn.transaction():\n   124\t                for scope, key in self._scopes():\n   125\t                    limit = self.run_starts_per_minute[scope]\n   126\t                    count = await conn.fetchval(\n   127\t                        \"\"\"\n   128\t                        INSERT INTO run_start_window (scope, key, minute, starts)\n   129\t                        VALUES ($1, $2, date_trunc('minute', now()), 1)\n   130\t                        ON CONFLICT (scope, key, minute)\n   131\t                        DO UPDATE SET starts = run_start_window.starts + 1\n   132\t                        RETURNING starts\n   133\t                        \"\"\",\n   134\t                        scope,\n   135\t                        key,\n   136\t                    )\n   137\t                    if count > limit:\n   138\t                        raise BudgetExceeded(f\"run_starts_per_minute.{scope}\", count, limit)\n   139\t\n   140\t    async def flush(self, pool) -> None:\n   141\t        \"\"\"Add this run's unflushed spend to the daily quotas, or stop the run.\"\"\"\n   142\t        if self.unflushed_cost_usd <= 0:\n   143\t            return\n   144\t        amount = self.unflushed_cost_usd\n   145\t        async with pool.acquire() as conn:\n   146\t            async with conn.transaction():\n   147\t                for scope, key in self._scopes():\n   148\t                    limit = self.quotas_daily_usd[scope]\n   149\t                    spent = await conn.fetchval(\n   150\t                        \"\"\"\n   151\t                        INSERT INTO spend_quota (scope, key, day, spent_usd)\n   152\t                        VALUES ($1, $2, current_date, $3)\n   153\t                        ON CONFLICT (scope, key, day)\n   154\t                        DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd\n   155\t                        RETURNING spent_usd\n   156\t                        \"\"\",\n   157\t                        scope,\n   158\t                        key,\n   159\t                        amount,\n   160\t                    )\n   161\t                    if spent > limit:\n   162\t                        raise BudgetExceeded(f\"quota_daily_usd.{scope}\", spent, limit)\n   163\t        self.unflushed_cost_usd = Decimal(\"0\")\n# Release manifest for the procurement agent. Regenerated by CI on every\n# release build (see .github/workflows/ci.yaml, job \"release\").\nrelease: \"procurement-agent 2026.09.4\"\nowner: team-procurement-platform\n\nimage:\n  repository: registry.example-corp.test/procurement/agent\n  digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n  sbom: \"registry.example-corp.test/procurement/agent:sha256-7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0.sbom\"\n  signer:\n    issuer: \"https://token.actions.githubusercontent.com\"\n    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n\nharness:\n  source_commit: \"3f9a1c7e2b8d4f6a0c5e9b1d7f3a8c2e6b4d0f91\"\n  digest: \"sha256:5b2d8f1a9c3e7b0d4f6a2c8e1b5d9f3a7c0e4b8d2f6a1c5e9b3d7f0a4c8e2b6d\"\n\nprompts:\n  system:\n    path: prompts/system.md\n    sha256: \"sha256:dcf69216667e65a0be3711d99aac81b707ba843296e7ce26d6fcbdb50c5bcc50\"\n  extractor:\n    path: prompts/extractor.md\n    sha256: \"sha256:6ef6527b77ffcca8851e7a8760e6373f3daede15d5b343b878737f0deec28de3\"\n\nconfig:\n  policy:\n    path: config/policy.yaml\n    version: \"proc-policy-2026.09.3\"\n    sha256: \"sha256:d6a55f1e170bdd457958243ddd9aa938f4ca707a3e1e9d1e7bca2a54df33ad32\"\n  tools:\n    path: config/tools.yaml\n    sha256: \"sha256:86dccc3d7d166bf8e131c3b2afbe5f2b846a57eaaf087b55f9e308844eda9400\"\n  network_policy: deploy/k8s/networkpolicy.yaml\n  image_policy: deploy/k8s/kyverno-verify-images.yaml\n\nmodels:\n  primary:\n    role: \"main agent\"\n    owner: team-procurement-platform\n    provider: anthropic\n    model_id: \"claude-sonnet-4-5-20250929\"\n    id_kind: \"pinned snapshot\"\n    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    adapter: none\n    fine_tune: none\n    training_run: \"not applicable\"\n    served_version: \"recorded per call from response.model\"\n    provider_undisclosed: [weights digest, pretraining data version]\n  extractor:\n    role: \"line-item extraction sub-agent\"\n    owner: team-procurement-platform\n    provider: anthropic\n    model_id: \"claude-haiku-4-5-20251001\"\n    id_kind: \"pinned snapshot\"\n    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    adapter: none\n    fine_tune: none\n    training_run: \"not applicable\"\n    served_version: \"recorded per call from response.model\"\n    provider_undisclosed: [weights digest, pretraining data version]\n\nmcp_servers:\n  erp:\n    endpoint: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    owner: team-erp-integrations\n\n# Fingerprints of the approved ERP MCP tools (name, description, inputSchema,\n# annotations), computed by app.mcp_client.fingerprint.\ntool_pins:\n  budget.get_remaining: \"sha256:bc96af69ba1cfd67b5428269dc74aa3e754f4dfe2d5dfa81deb0af68819379ca\"\n  vendor.get: \"sha256:7db5e65fb6d482d06985b19b7f1fce7422398b117bc7482f0380108cd6a6a1fe\"\n  vendor.search: \"sha256:3bd5aa0908885e967ce8ee1aa22e37b4f4fba867c8eac2b4127bca626731092c\"\n  vendor.update_remit_to: \"sha256:d3d3916ee6d742311c92f4972a1ffeb0f24782e729351f3e375f13eb05b94c1b\"\n  invoice.get: \"sha256:848ece38456338a085cb7091a2bbf1024e07946d62beb32a9ee94d2fa2fa8876\"\n  invoice.list_open: \"sha256:12bb2318f3876da6421183032cdd36727e545275e8eaf6fff66451d09371f12b\"\n  invoice.mark_paid: \"sha256:3a208eb55ee3a39962316b5d25fe6ba23457380c01aa39a5469ce3691130b05a\"\n  invoice.void: \"sha256:9645bec805f2ffdfa44f698f49e8701a6487afa3cb3e3c5c44e721cb21633d4c\"\n  po.get: \"sha256:121df83a279fc2ae3764c83faeb34f3037026586991c9192144ad7b727d18d7b\"\n  po.list_open: \"sha256:203c57fd158a8edf11b8dc02be534bc805d8caaf0959db8280f59ea0e5beb70a\"\n  po.create: \"sha256:fb15c157f7d79321972b310d74ee6c88a0fc76fd8edbbe4e821dcaa95a0852c6\"\n\nbudgets: config/policy.yaml#budgets\nidentity:\n  service_account: procurement-agent\n  spiffe_id: \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n  sts_audiences: [erp-mcp-gateway, payments-api, slack-proxy]\nmemory:\n  store: \"postgres procurement.dept_notes\"\n  expiry_unverified_days: 30\nretrieval: none\n(eval):1: no matches found: --include=*\n\"\"\"Approval requests and decisions for high-impact operations.\n\nRequests are posted to the business unit's approvals channel in Slack with\nthe full argument summary. Approvers decide with the Slack buttons; the\ninteractive callback is signature-checked in main.py and then calls\n``decide``. Approver authority is checked against the role map in policy.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport uuid\nfrom dataclasses import dataclass\nfrom datetime import datetime, timedelta, timezone\nfrom typing import Any\n\nfrom app.audit import digest, summarize_args\nfrom app.identity import RunIdentity\n\n\n@dataclass(frozen=True)\nclass Approval:\n    id: str\n    approver: str\n    approver_role: str\n    expires_at: datetime\n\n\nclass ApproverNotAuthorized(Exception):\n    pass\n\n\nclass ApprovalStore:\n    def __init__(self, pool, policy: dict, notifier):\n        self.pool = pool\n        self.ttl = timedelta(minutes=int(policy[\"approvals\"][\"ttl_minutes\"]))\n        self.approver_roles: dict[str, list[str]] = policy[\"approvals\"][\"approver_roles\"]\n        self.notifier = notifier\n\n    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n        approval_id = f\"apr-{uuid.uuid4()}\"\n        expires_at = datetime.now(timezone.utc) + self.ttl\n        await self.pool.execute(\n            \"\"\"\n            INSERT INTO approvals (\n                id, tool, target, args_sha256, args_summary, tenant,\n                requested_by_instance, requested_by_run, delegated_subject,\n                status, requested_at, expires_at\n            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)\n            \"\"\",\n            approval_id,\n            tool,\n            target,\n            digest(args),\n            json.dumps(summarize_args(args)),\n            ident.tenant,\n            ident.agent_instance_id,\n            ident.run_id,\n            ident.delegated_subject,\n            expires_at,\n        )","is_error":false}]},"parent_tool_use_id":null,"session_id":"cbd916c9-65cb-4ab5-bb81-2cf8214fc421","uuid":"b75183ef-500f-4642-82e8-97b92901180b","timestamp":"2026-10-20T14:58:14.480Z","tool_use_result":{"stdout":"     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tUNTRUSTED_WRAPPER = (\n    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n    11\t    \"{text}\\n\"\n    12\t    \"</untrusted_document>\"\n    13\t)\n    14\t\n    15\t\n    16\tdef tools(deps) -> list[Tool]:\n    17\t    pool = deps.pool\n    18\t\n    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n    20\t        row = await pool.fetchrow(\n    21\t            \"\"\"\n    22\t            SELECT doc_id, source, media_type, text\n    23\t            FROM documents\n    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n    25\t            \"\"\",\n    26\t            args[\"doc_id\"],\n    27\t            ident.tenant,\n    28\t        )\n    29\t        if row is None:\n    30\t            return \"document not found\"\n    31\t        return UNTRUSTED_WRAPPER.format(\n    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n    33\t        )\n    34\t\n    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n    37\t\n    38\t    return [\n    39\t        Tool(\n    40\t            name=\"read_document\",\n    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n    42\t            input_schema={\n    43\t                \"type\": \"object\",\n    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    45\t                \"required\": [\"doc_id\"],\n    46\t                \"additionalProperties\": False,\n    47\t            },\n    48\t            invoke=read_document,\n    49\t        ),\n    50\t        Tool(\n    51\t            name=\"extract_line_items\",\n    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n    53\t            input_schema={\n    54\t                \"type\": \"object\",\n    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    56\t                \"required\": [\"doc_id\"],\n    57\t                \"additionalProperties\": False,\n    58\t            },\n    59\t            invoke=extract_line_items,\n    60\t        ),\n    61\t    ]\n     1\t\"\"\"Hard execution budgets, enforced by the harness and not by the model.\n     2\t\n     3\tPer run: step count, wall-clock time, tokens, cost, tool-call rate, and\n     4\tnumber of sub-agents. Sub-agents charge the parent's budget, so a child\n     5\tcannot widen what the parent was given.\n     6\t\n     7\tAcross runs: daily spend and per-minute run starts per user, per tenant\n     8\t(business unit), and for the whole fleet. Quotas are reserved in Postgres\n     9\tinside one transaction, so concurrent runs cannot overshoot them.\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport time\n    14\tfrom collections import deque\n    15\tfrom dataclasses import dataclass, field\n    16\tfrom decimal import Decimal\n    17\t\n    18\tfrom app.identity import RunIdentity\n    19\t\n    20\t\n    21\tclass BudgetExceeded(Exception):\n    22\t    def __init__(self, limit: str, used, allowed):\n    23\t        super().__init__(f\"{limit} exceeded: used={used} allowed={allowed}\")\n    24\t        self.limit = limit\n    25\t        self.used = used\n    26\t        self.allowed = allowed\n    27\t\n    28\t\n    29\t# USD per million tokens, from the provider price sheet referenced in the manifest.\n    30\tPRICES = {\n    31\t    \"claude-sonnet-4-5-20250929\": (Decimal(\"3.00\"), Decimal(\"15.00\")),\n    32\t    \"claude-haiku-4-5-20251001\": (Decimal(\"1.00\"), Decimal(\"5.00\")),\n    33\t}\n    34\t\n    35\t\n    36\t@dataclass\n    37\tclass Budget:\n    38\t    ident: RunIdentity\n    39\t    max_steps: int\n    40\t    max_wall_seconds: float\n    41\t    max_tokens: int\n    42\t    max_cost_usd: Decimal\n    43\t    max_tool_calls_per_minute: int\n    44\t    max_subagents: int\n    45\t    quotas_daily_usd: dict[str, Decimal]\n    46\t    run_starts_per_minute: dict[str, int]\n    47\t    started_at: float = field(default_factory=time.monotonic)\n    48\t    steps: int = 0\n    49\t    tokens: int = 0\n    50\t    cost_usd: Decimal = Decimal(\"0\")\n    51\t    unflushed_cost_usd: Decimal = Decimal(\"0\")\n    52\t    subagents: int = 0\n    53\t    _tool_calls: deque = field(default_factory=deque)\n    54\t\n    55\t    @classmethod\n    56\t    def for_run(cls, cfg: dict, ident: RunIdentity) -> \"Budget\":\n    57\t        run = cfg[\"per_run\"]\n    58\t        return cls(\n    59\t            ident=ident,\n    60\t            max_steps=int(run[\"max_steps\"]),\n    61\t            max_wall_seconds=float(run[\"max_wall_seconds\"]),\n    62\t            max_tokens=int(run[\"max_tokens\"]),\n    63\t            max_cost_usd=Decimal(str(run[\"max_cost_usd\"])),\n    64\t            max_tool_calls_per_minute=int(run[\"max_tool_calls_per_minute\"]),\n    65\t            max_subagents=int(run[\"max_subagents\"]),\n    66\t            quotas_daily_usd={k: Decimal(str(v)) for k, v in cfg[\"quotas_daily_usd\"].items()},\n    67\t            run_starts_per_minute={k: int(v) for k, v in cfg[\"run_starts_per_minute\"].items()},\n    68\t        )\n    69\t\n    70\t    def _scopes(self) -> list[tuple[str, str]]:\n    71\t        return [\n    72\t            (\"user\", self.ident.accountable_party),\n    73\t            (\"tenant\", self.ident.tenant),\n    74\t            (\"fleet\", \"all\"),\n    75\t        ]\n    76\t\n    77\t    # --- per-run limits -------------------------------------------------\n    78\t\n    79\t    def check_step(self) -> None:\n    80\t        self.steps += 1\n    81\t        if self.steps > self.max_steps:\n    82\t            raise BudgetExceeded(\"max_steps\", self.steps, self.max_steps)\n    83\t        elapsed = time.monotonic() - self.started_at\n    84\t        if elapsed > self.max_wall_seconds:\n    85\t            raise BudgetExceeded(\"max_wall_seconds\", round(elapsed, 1), self.max_wall_seconds)\n    86\t\n    87\t    def charge_model(self, model: str, usage) -> None:\n    88\t        price_in, price_out = PRICES[model]\n    89\t        tokens_in = (\n    90\t            int(usage.input_tokens or 0)\n    91\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n    92\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n    93\t        )\n    94\t        tokens_out = int(usage.output_tokens or 0)\n    95\t        self.tokens += tokens_in + tokens_out\n    96\t        cost = (price_in * tokens_in + price_out * tokens_out) / Decimal(1_000_000)\n    97\t        self.cost_usd += cost\n    98\t        self.unflushed_cost_usd += cost\n    99\t        if self.tokens > self.max_tokens:\n   100\t            raise BudgetExceeded(\"max_tokens\", self.tokens, self.max_tokens)\n   101\t        if self.cost_usd > self.max_cost_usd:\n   102\t            raise BudgetExceeded(\"max_cost_usd\", self.cost_usd, self.max_cost_usd)\n   103\t\n   104\t    def check_tool_call(self, now: float | None = None) -> None:\n   105\t        now = time.monotonic() if now is None else now\n   106\t        while self._tool_calls and now - self._tool_calls[0] > 60:\n   107\t            self._tool_calls.popleft()\n   108\t        if len(self._tool_calls) >= self.max_tool_calls_per_minute:\n   109\t            raise BudgetExceeded(\n   110\t                \"max_tool_calls_per_minute\", len(self._tool_calls) + 1, self.max_tool_calls_per_minute\n   111\t            )\n   112\t        self._tool_calls.append(now)\n   113\t\n   114\t    def check_subagent(self) -> None:\n   115\t        if self.subagents >= self.max_subagents:\n   116\t            raise BudgetExceeded(\"max_subagents\", self.subagents + 1, self.max_subagents)\n   117\t        self.subagents += 1\n   118\t\n   119\t    # --- cross-run quotas -----------------------------------------------\n   120\t\n   121\t    async def reserve_run_start(self, pool) -> None:\n   122\t        async with pool.acquire() as conn:\n   123\t            async with conn.transaction():\n   124\t                for scope, key in self._scopes():\n   125\t                    limit = self.run_starts_per_minute[scope]\n   126\t                    count = await conn.fetchval(\n   127\t                        \"\"\"\n   128\t                        INSERT INTO run_start_window (scope, key, minute, starts)\n   129\t                        VALUES ($1, $2, date_trunc('minute', now()), 1)\n   130\t                        ON CONFLICT (scope, key, minute)\n   131\t                        DO UPDATE SET starts = run_start_window.starts + 1\n   132\t                        RETURNING starts\n   133\t                        \"\"\",\n   134\t                        scope,\n   135\t                        key,\n   136\t                    )\n   137\t                    if count > limit:\n   138\t                        raise BudgetExceeded(f\"run_starts_per_minute.{scope}\", count, limit)\n   139\t\n   140\t    async def flush(self, pool) -> None:\n   141\t        \"\"\"Add this run's unflushed spend to the daily quotas, or stop the run.\"\"\"\n   142\t        if self.unflushed_cost_usd <= 0:\n   143\t            return\n   144\t        amount = self.unflushed_cost_usd\n   145\t        async with pool.acquire() as conn:\n   146\t            async with conn.transaction():\n   147\t                for scope, key in self._scopes():\n   148\t                    limit = self.quotas_daily_usd[scope]\n   149\t                    spent = await conn.fetchval(\n   150\t                        \"\"\"\n   151\t                        INSERT INTO spend_quota (scope, key, day, spent_usd)\n   152\t                        VALUES ($1, $2, current_date, $3)\n   153\t                        ON CONFLICT (scope, key, day)\n   154\t                        DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd\n   155\t                        RETURNING spent_usd\n   156\t                        \"\"\",\n   157\t                        scope,\n   158\t                        key,\n   159\t                        amount,\n   160\t                    )\n   161\t                    if spent > limit:\n   162\t                        raise BudgetExceeded(f\"quota_daily_usd.{scope}\", spent, limit)\n   163\t        self.unflushed_cost_usd = Decimal(\"0\")\n# Release manifest for the procurement agent. Regenerated by CI on every\n# release build (see .github/workflows/ci.yaml, job \"release\").\nrelease: \"procurement-agent 2026.09.4\"\nowner: team-procurement-platform\n\nimage:\n  repository: registry.example-corp.test/procurement/agent\n  digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n  sbom: \"registry.example-corp.test/procurement/agent:sha256-7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0.sbom\"\n  signer:\n    issuer: \"https://token.actions.githubusercontent.com\"\n    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n\nharness:\n  source_commit: \"3f9a1c7e2b8d4f6a0c5e9b1d7f3a8c2e6b4d0f91\"\n  digest: \"sha256:5b2d8f1a9c3e7b0d4f6a2c8e1b5d9f3a7c0e4b8d2f6a1c5e9b3d7f0a4c8e2b6d\"\n\nprompts:\n  system:\n    path: prompts/system.md\n    sha256: \"sha256:dcf69216667e65a0be3711d99aac81b707ba843296e7ce26d6fcbdb50c5bcc50\"\n  extractor:\n    path: prompts/extractor.md\n    sha256: \"sha256:6ef6527b77ffcca8851e7a8760e6373f3daede15d5b343b878737f0deec28de3\"\n\nconfig:\n  policy:\n    path: config/policy.yaml\n    version: \"proc-policy-2026.09.3\"\n    sha256: \"sha256:d6a55f1e170bdd457958243ddd9aa938f4ca707a3e1e9d1e7bca2a54df33ad32\"\n  tools:\n    path: config/tools.yaml\n    sha256: \"sha256:86dccc3d7d166bf8e131c3b2afbe5f2b846a57eaaf087b55f9e308844eda9400\"\n  network_policy: deploy/k8s/networkpolicy.yaml\n  image_policy: deploy/k8s/kyverno-verify-images.yaml\n\nmodels:\n  primary:\n    role: \"main agent\"\n    owner: team-procurement-platform\n    provider: anthropic\n    model_id: \"claude-sonnet-4-5-20250929\"\n    id_kind: \"pinned snapshot\"\n    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    adapter: none\n    fine_tune: none\n    training_run: \"not applicable\"\n    served_version: \"recorded per call from response.model\"\n    provider_undisclosed: [weights digest, pretraining data version]\n  extractor:\n    role: \"line-item extraction sub-agent\"\n    owner: team-procurement-platform\n    provider: anthropic\n    model_id: \"claude-haiku-4-5-20251001\"\n    id_kind: \"pinned snapshot\"\n    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    adapter: none\n    fine_tune: none\n    training_run: \"not applicable\"\n    served_version: \"recorded per call from response.model\"\n    provider_undisclosed: [weights digest, pretraining data version]\n\nmcp_servers:\n  erp:\n    endpoint: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    owner: team-erp-integrations\n\n# Fingerprints of the approved ERP MCP tools (name, description, inputSchema,\n# annotations), computed by app.mcp_client.fingerprint.\ntool_pins:\n  budget.get_remaining: \"sha256:bc96af69ba1cfd67b5428269dc74aa3e754f4dfe2d5dfa81deb0af68819379ca\"\n  vendor.get: \"sha256:7db5e65fb6d482d06985b19b7f1fce7422398b117bc7482f0380108cd6a6a1fe\"\n  vendor.search: \"sha256:3bd5aa0908885e967ce8ee1aa22e37b4f4fba867c8eac2b4127bca626731092c\"\n  vendor.update_remit_to: \"sha256:d3d3916ee6d742311c92f4972a1ffeb0f24782e729351f3e375f13eb05b94c1b\"\n  invoice.get: \"sha256:848ece38456338a085cb7091a2bbf1024e07946d62beb32a9ee94d2fa2fa8876\"\n  invoice.list_open: \"sha256:12bb2318f3876da6421183032cdd36727e545275e8eaf6fff66451d09371f12b\"\n  invoice.mark_paid: \"sha256:3a208eb55ee3a39962316b5d25fe6ba23457380c01aa39a5469ce3691130b05a\"\n  invoice.void: \"sha256:9645bec805f2ffdfa44f698f49e8701a6487afa3cb3e3c5c44e721cb21633d4c\"\n  po.get: \"sha256:121df83a279fc2ae3764c83faeb34f3037026586991c9192144ad7b727d18d7b\"\n  po.list_open: \"sha256:203c57fd158a8edf11b8dc02be534bc805d8caaf0959db8280f59ea0e5beb70a\"\n  po.create: \"sha256:fb15c157f7d79321972b310d74ee6c88a0fc76fd8edbbe4e821dcaa95a0852c6\"\n\nbudgets: config/policy.yaml#budgets\nidentity:\n  service_account: procurement-agent\n  spiffe_id: \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n  sts_audiences: [erp-mcp-gateway, payments-api, slack-proxy]\nmemory:\n  store: \"postgres procurement.dept_notes\"\n  expiry_unverified_days: 30\nretrieval: none\n(eval):1: no matches found: --include=*\n\"\"\"Approval requests and decisions for high-impact operations.\n\nRequests are posted to the business unit's approvals channel in Slack with\nthe full argument summary. Approvers decide with the Slack buttons; the\ninteractive callback is signature-checked in main.py and then calls\n``decide``. Approver authority is checked against the role map in policy.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport uuid\nfrom dataclasses import dataclass\nfrom datetime import datetime, timedelta, timezone\nfrom typing import Any\n\nfrom app.audit import digest, summarize_args\nfrom app.identity import RunIdentity\n\n\n@dataclass(frozen=True)\nclass Approval:\n    id: str\n    approver: str\n    approver_role: str\n    expires_at: datetime\n\n\nclass ApproverNotAuthorized(Exception):\n    pass\n\n\nclass ApprovalStore:\n    def __init__(self, pool, policy: dict, notifier):\n        self.pool = pool\n        self.ttl = timedelta(minutes=int(policy[\"approvals\"][\"ttl_minutes\"]))\n        self.approver_roles: dict[str, list[str]] = policy[\"approvals\"][\"approver_roles\"]\n        self.notifier = notifier\n\n    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n        approval_id = f\"apr-{uuid.uuid4()}\"\n        expires_at = datetime.now(timezone.utc) + self.ttl\n        await self.pool.execute(\n            \"\"\"\n            INSERT INTO approvals (\n                id, tool, target, args_sha256, args_summary, tenant,\n                requested_by_instance, requested_by_run, delegated_subject,\n                status, requested_at, expires_at\n            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)\n            \"\"\",\n            approval_id,\n            tool,\n            target,\n            digest(args),\n            json.dumps(summarize_args(args)),\n            ident.tenant,\n            ident.agent_instance_id,\n            ident.run_id,\n            ident.delegated_subject,\n            expires_at,\n        )","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WwhC7ekV8bhc6GUXcjTWSA","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
