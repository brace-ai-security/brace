nly one in repo; other k8s files are image policy and network policy.\"),\n R(\"app/main.py AGENT_PRINCIPAL\",\"app/main.py:40\",'AGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"',\"SPIFFE id maps to the same SA; workload token is projected for it.\")],\n \"deploy/k8s/deployment.yaml:19\",\"serviceAccountName: procurement-agent\",\n \"Searched repo for other serviceAccountName, Deployments and SAs; only one Deployment and one SA (procurement-agent), not default.\",\n \"Dedicated SA with projected token; no sharing found in repo.\")\nno(\"A01.2\",\"app/identity.py:95\",\"key = (audience, scope, ident.tenant)\",\n \"Exchanged token cache key omits the delegated subject, so a token minted with user A as actor is reused for user B in the same tenant; actor is also passed as a bare subject-id string (identity.py:109,110), not a verified token.\")\nno(\"A01.3\",\"app/identity.py:109\",'\"actor_token\": ident.delegated_subject,',\n \"Delegated user goes to the STS as an unverified plain string, and the cache at identity.py:95-98 serves tokens exchanged for another user in the same tenant, so the delegated subject is not preserved per run.\")\nunk(\"A01.4\",\"No RoleBinding/ClusterRole/IAM/STS policy in the repo (only serviceaccount.yaml, deployment.yaml, networkpolicy.yaml, kyverno policy). Grants live in the STS/ERP/payments services outside this repo.\")\n\n# A02\nyes(\"A02.1\",[\n R(\"accountable_party\",\"migrations/001_init.sql:10\",\"accountable_party   text NOT NULL CHECK (accountable_party <> ''),\",\"NOT NULL, non-empty.\"),\n R(\"operational_owner\",\"migrations/001_init.sql:11\",\"operational_owner   text NOT NULL CHECK (operational_owner <> ''),\",\"NOT NULL, non-empty.\"),\n R(\"tenant\",\"migrations/001_init.sql:12\",\"tenant              text NOT NULL CHECK (tenant <> ''),\",\"NOT NULL, non-empty.\"),\n R(\"agent_type_id\",\"migrations/001_init.sql:13\",\"agent_type_id       text NOT NULL CHECK (agent_type_id <> ''),\