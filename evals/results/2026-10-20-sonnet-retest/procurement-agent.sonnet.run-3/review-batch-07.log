{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HcqcuwYsejNRwvCf5mYMsz","type":"tool_result","content":"1\t=== app/audit.py\n2\t     1\t\"\"\"Execution audit graph.\n3\t     2\t\n4\t     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n5\t     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n6\t     5\ttool call -> authorization decision -> result or error. Writes are\n7\t     6\tsynchronous and are made before the action they describe; if the write\n8\t     7\tfails, the caller raises and the action does not run.\n9\t     8\t\"\"\"\n10\t     9\tfrom __future__ import annotations\n11\t    10\t\n12\t    11\timport hashlib\n13\t    12\timport json\n14\t    13\timport uuid\n15\t    14\tfrom datetime import datetime, timezone\n16\t    15\tfrom typing import Any\n17\t    16\t\n18\t    17\tfrom opentelemetry import trace\n19\t    18\t\n20\t    19\tfrom app.context_size import ContextMeasure\n21\t    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n22\t    21\tfrom app.redact import redact_value\n23\t    22\t\n24\t    23\tEVENT_KINDS = {\n25\t    24\t    \"run_started\",\n26\t    25\t    \"run_finished\",\n27\t    26\t    \"run_halted\",\n28\t    27\t    \"model_decision\",\n29\t    28\t    \"tool_proposed\",\n30\t    29\t    \"authz_decision\",\n31\t    30\t    \"approval_requested\",\n32\t    31\t    \"approval_decided\",\n33\t    32\t    \"tool_result\",\n34\t    33\t    \"tool_error\",\n35\t    34\t    \"tool_denied\",\n36\t    35\t    \"budget_exceeded\",\n37\t    36\t    \"subagent_started\",\n38\t    37\t    \"subagent_finished\",\n39\t    38\t    \"background_job\",\n40\t    39\t}\n41\t    40\t\n42\t    41\t_INSERT = \"\"\"\n43\t    42\tINSERT INTO audit_events (\n44\t    43\t    node_id, parent_node_id, run_id, ts, kind,\n45\t    44\t    accountable_party, operational_owner, tenant,\n46\t    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n47\t    46\t    delegated_subject, agent_principal, parent_instance_id,\n48\t    47\t    policy_version, approval_id, operation_id,\n49\t    48\t    context_tokens, context_method, context_compacted,\n50\t    49\t    payload\n51\t    50\t) VALUES (\n52\t    51\t    $1, $2, $3, $4, $5,\n53\t    52\t    $6, $7, $8,\n54\t    53\t    $9, $10, $11, $12,\n55\t    54\t    $13, $14, $15,\n56\t    55\t    $16, $17, $18,\n57\t    56\t    $19, $20, $21,\n58\t    57\t    $22::jsonb\n59\t    58\t)\n60\t    59\t\"\"\"\n61\t    60\t\n62\t    61\t\n63\t    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n64\t    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n65\t    64\t    return {k: redact_value(v) for k, v in args.items()}\n66\t    65\t\n67\t    66\t\n68\t    67\tdef digest(value: Any) -> str:\n69\t    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n70\t    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n71\t    70\t\n72\t    71\t\n73\t    72\tasync def record(\n74\t    73\t    pool,\n75\t    74\t    ident: RunIdentity,\n76\t    75\t    *,\n77\t    76\t    kind: str,\n78\t    77\t    payload: dict[str, Any] | None = None,\n79\t    78\t    parent: str | None = None,\n80\t    79\t    context: ContextMeasure | None = None,\n81\t    80\t    policy_version: str | None = None,\n82\t    81\t    approval_id: str | None = None,\n83\t    82\t    operation_id: str | None = None,\n84\t    83\t) -> str:\n85\t    84\t    if kind not in EVENT_KINDS:\n86\t    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n87\t    86\t    for name in IDENTITY_FIELDS:\n88\t    87\t        if not getattr(ident, name):\n89\t    88\t            raise ValueError(f\"audit record missing {name}\")\n90\t    89\t    span_ctx = trace.get_current_span().get_span_context()\n91\t    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n92\t    91\t    node_id = f\"node-{uuid.uuid4()}\"\n93\t    92\t    measure = context or ContextMeasure.unavailable()\n94\t    93\t    await pool.execute(\n95\t    94\t        _INSERT,\n96\t    95\t        node_id,\n97\t    96\t        parent,\n98\t    97\t        ident.run_id,\n99\t    98\t        datetime.now(timezone.utc),\n100\t    99\t        kind,\n101\t   100\t        ident.accountable_party,\n102\t   101\t        ident.operational_owner,\n103\t   102\t        ident.tenant,\n104\t   103\t        ident.agent_type_id,\n105\t   104\t        ident.agent_instance_id,\n106\t   105\t        ident.trace_id,\n107\t   106\t        span_id,\n108\t   107\t        ident.delegated_subject,\n109\t   108\t        ident.agent_principal,\n110\t   109\t        ident.parent_instance_id,\n111\t   110\t        policy_version,\n112\t   111\t        approval_id,\n113\t   112\t        operation_id,\n114\t   113\t        measure.tokens,\n115\t   114\t        measure.method,\n116\t   115\t        measure.compacted,\n117\t   116\t        json.dumps(redact_value(payload or {}), default=str),\n118\t   117\t    )\n119\t   118\t    return node_id\n120\t=== app/identity.py\n121\t     1\t\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n122\t     2\t\n123\t     3\tThe agent runs under its own Kubernetes service account. Its projected\n124\t     4\tservice-account token is exchanged at the internal STS for short-lived,\n125\t     5\taudience-bound tokens. The launching user's token is never forwarded to an\n126\t     6\tintegration; the user is carried as the delegated subject of the exchange.\n127\t     7\t\"\"\"\n128\t     8\tfrom __future__ import annotations\n129\t     9\t\n130\t    10\timport hashlib\n131\t    11\timport json\n132\t    12\timport time\n133\t    13\timport uuid\n134\t    14\tfrom dataclasses import dataclass, field, replace\n135\t    15\tfrom pathlib import Path\n136\t    16\t\n137\t    17\timport httpx\n138\t    18\t\n139\t    19\tfrom app.settings import Settings\n140\t    20\t\n141\t    21\tIDENTITY_FIELDS = (\n142\t    22\t    \"accountable_party\",\n143\t    23\t    \"operational_owner\",\n144\t    24\t    \"tenant\",\n145\t    25\t    \"agent_type_id\",\n146\t    26\t    \"agent_instance_id\",\n147\t    27\t    \"trace_id\",\n148\t    28\t)\n149\t    29\t\n150\t    30\t\n151\t    31\t@dataclass(frozen=True)\n152\t    32\tclass RunIdentity:\n153\t    33\t    accountable_party: str\n154\t    34\t    operational_owner: str\n155\t    35\t    tenant: str\n156\t    36\t    agent_type_id: str\n157\t    37\t    agent_instance_id: str\n158\t    38\t    trace_id: str\n159\t    39\t    run_id: str\n160\t    40\t    delegated_subject: str\n161\t    41\t    agent_principal: str\n162\t    42\t    parent_instance_id: str | None = None\n163\t    43\t    role: str = \"procurement\"\n164\t    44\t\n165\t    45\t    def __post_init__(self) -> None:\n166\t    46\t        for name in IDENTITY_FIELDS:\n167\t    47\t            if not getattr(self, name):\n168\t    48\t                raise ValueError(f\"identity field {name} is empty\")\n169\t    49\t\n170\t    50\t    def child(self, role: str) -> \"RunIdentity\":\n171\t    51\t        return replace(\n172\t    52\t            self,\n173\t    53\t            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n174\t    54\t            parent_instance_id=self.agent_instance_id,\n175\t    55\t            role=role,\n176\t    56\t        )\n177\t    57\t\n178\t    58\t\n179\t    59\tdef new_instance_id() -> str:\n180\t    60\t    return f\"inst-{uuid.uuid4()}\"\n181\t    61\t\n182\t    62\t\n183\t    63\tdef compute_agent_type_id(manifest: dict) -> str:\n184\t    64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n185\t    65\t    material = {\n186\t    66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n187\t    67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n188\t    68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n189\t    69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n190\t    70\t        \"models\": manifest[\"models\"],\n191\t    71\t        \"config\": manifest[\"config\"],\n192\t    72\t        \"tools\": manifest[\"tool_pins\"],\n193\t    73\t    }\n194\t    74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n195\t    75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n196\t    76\t\n197\t    77\t\n198\t    78\t@dataclass\n199\t    79\tclass _CachedToken:\n200\t    80\t    value: str\n201\t    81\t    expires_at: float\n202\t    82\t\n203\t    83\t\n204\t    84\t@dataclass\n205\t    85\tclass TokenBroker:\n206\t    86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n207\t    87\t\n208\t    88\t    settings: Settings\n209\t    89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n210\t    90\t\n211\t    91\t    def _workload_token(self) -> str:\n212\t    92\t        return Path(self.settings.workload_token_path).read_text().strip()\n213\t    93\t\n214\t    94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n215\t    95\t        key = (audience, scope, ident.tenant)\n216\t    96\t        cached = self._cache.get(key)\n217\t    97\t        if cached and cached.expires_at - 30 > time.time():\n218\t    98\t            return cached.value\n219\t    99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n220\t   100\t            resp = await client.post(\n221\t   101\t                self.settings.sts_url,\n222\t   102\t                data={\n223\t   103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n224\t   104\t                    \"subject_token\": self._workload_token(),\n225\t   105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n226\t   106\t                    \"audience\": audience,\n227\t   107\t                    \"scope\": scope,\n228\t   108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n229\t   109\t                    \"actor_token\": ident.delegated_subject,\n230\t   110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n231\t   111\t                },\n232\t   112\t            )\n233\t   113\t            resp.raise_for_status()\n234\t   114\t            body = resp.json()\n235\t   115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n236\t   116\t        self._cache[key] = token\n237\t   117\t        return token.value\n238\t=== app/extractor.py\n239\t     1\t\"\"\"Line-item extraction sub-agent.\n240\t     2\t\n241\t     3\tThe parent procurement agent delegates structured extraction to a smaller\n242\t     4\tmodel. The child runs under its own instance id, links to its parent in the\n243\t     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n244\t     6\t\"\"\"\n245\t     7\tfrom __future__ import annotations\n246\t     8\t\n247\t     9\timport json\n248\t    10\timport logging\n249\t    11\tfrom typing import Any\n250\t    12\t\n251\t    13\tfrom opentelemetry import trace\n252\t    14\t\n253\t    15\tfrom app import audit\n254\t    16\tfrom app.budget import Budget\n255\t    17\tfrom app.context_size import measure_context\n256\t    18\tfrom app.identity import RunIdentity\n257\t    19\tfrom app.redact import redact_for_model\n258\t    20\tfrom app.tools import build_registry\n259\t    21\t\n260\t    22\tlog = logging.getLogger(__name__)\n261\t    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n262\t    24\t\n263\t    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n264\t    26\tMAX_TURNS = 4\n265\t    27\t\n266\t    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n267\t    29\t\n268\t    30\t\n269\t    31\tclass ExtractionFailed(Exception):\n270\t    32\t    pass\n271\t    33\t\n272\t    34\t\n273\t    35\tclass LineItemExtractor:\n274\t    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n275\t    37\t        self.client = client\n276\t    38\t        self.settings = settings\n277\t    39\t        self.deps = deps\n278\t    40\t        self.system_prompt = system_prompt\n279\t    41\t\n280\t    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n281\t    43\t        budget.check_subagent()\n282\t    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n283\t    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n284\t    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n285\t    47\t\n286\t    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n287\t    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n288\t    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n289\t    51\t            start_node = await audit.record(\n290\t    52\t                self.deps.pool,\n291\t    53\t                ident,\n292\t    54\t                kind=\"subagent_started\",\n293\t    55\t                payload={\n294\t    56\t                    \"role\": EXTRACTOR_ROLE,\n295\t    57\t                    \"doc_id\": doc_id,\n296\t    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n297\t    59\t                    \"tools\": registry.names(),\n298\t    60\t                },\n299\t    61\t            )\n300\t    62\t\n301\t    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n302\t    64\t            for _turn in range(MAX_TURNS):\n303\t    65\t                budget.check_step()\n304\t    66\t                request = {\n305\t    67\t                    \"model\": self.settings.extractor_model_id,\n306\t    68\t                    \"system\": self.system_prompt,\n307\t    69\t                    \"messages\": messages,\n308\t    70\t                    \"tools\": registry.schemas(),\n309\t    71\t                    \"max_tokens\": 4096,\n310\t    72\t                }\n311\t    73\t                ctx = await measure_context(self.client, request, compacted=False)\n312\t    74\t                response = await self.client.messages.create(**request)\n313\t    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n314\t    76\t                await budget.flush(self.deps.pool)\n315\t    77\t                ctx = ctx.finalize(response.usage)\n316\t    78\t                decision = await audit.record(\n317\t    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n318\t    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n319\t    81\t                             \"stop_reason\": response.stop_reason},\n320\t    82\t                )\n321\t    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n322\t    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n323\t    85\t                if not uses:\n324\t    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n325\t    87\t                    items = _parse_items(text)\n326\t    88\t                    await audit.record(\n327\t    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n328\t    90\t                        payload={\"items\": len(items)},\n329\t    91\t                    )\n330\t    92\t                    return items\n331\t    93\t                results = []\n332\t    94\t                for use in uses:\n333\t    95\t                    budget.check_tool_call()\n334\t    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n335\t    97\t                messages.append({\"role\": \"user\", \"content\": results})\n336\t    98\t\n337\t    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n338\t   100\t\n339\t   101\t\n340\t   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n341\t   103\t    try:\n342\t   104\t        data = json.loads(text)\n343\t   105\t    except json.JSONDecodeError as exc:\n344\t   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n345\t   107\t    if not isinstance(data, list) or len(data) > 500:\n346\t   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n347\t   109\t    items = []\n348\t   110\t    for raw in data:\n349\t   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n350\t   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n351\t   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n352\t   114\t    return items\n353\t=== app/killswitch.py\n354\t     1\t\"\"\"Operator stop control.\n355\t     2\t\n356\t     3\tOperators halt the fleet or one business unit by setting a row in\n357\t     4\t``control_flags`` with the ``procurement_ops`` database role (see\n358\t     5\tops/README in the platform runbook). The agent's own database role has\n359\t     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n360\t     7\t\"\"\"\n361\t     8\tfrom __future__ import annotations\n362\t     9\t\n363\t    10\t\n364\t    11\tclass AgentHalted(Exception):\n365\t    12\t    pass\n366\t    13\t\n367\t    14\t\n368\t    15\t_QUERY = \"\"\"\n369\t    16\tSELECT scope, reason, set_by, set_at\n370\t    17\tFROM control_flags\n371\t    18\tWHERE halted\n372\t    19\t  AND (scope = 'fleet' OR scope = $1)\n373\t    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n374\t    21\tLIMIT 1\n375\t    22\t\"\"\"\n376\t    23\t\n377\t    24\t\n378\t    25\tasync def assert_running(pool, tenant: str) -> None:\n379\t    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n380\t    27\t    if row is not None:\n381\t    28\t        raise AgentHalted(\n382\t    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n383\t    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n384\t    31\t        )\n385\t=== app/loop.py\n386\t     1\t\"\"\"Procurement agent run loop.\n387\t     2\t\n388\t     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n389\t     4\tEvery edge writes an audit node before the next step runs. Budgets are\n390\t     5\tchecked before each model turn and each tool call.\n391\t     6\t\"\"\"\n392\t     7\tfrom __future__ import annotations\n393\t     8\t\n394\t     9\timport hashlib\n395\t    10\timport logging\n396\t    11\tfrom dataclasses import dataclass, field\n397\t    12\tfrom typing import Any\n398\t    13\t\n399\t    14\tfrom opentelemetry import trace\n400\t    15\t\n401\t    16\tfrom app import audit, killswitch\n402\t    17\tfrom app.budget import Budget, BudgetExceeded\n403\t    18\tfrom app.context_size import ContextMeasure, measure_context\n404\t    19\tfrom app.gate import PolicyGate\n405\t    20\tfrom app.identity import RunIdentity\n406\t    21\tfrom app.redact import redact_for_model\n407\t    22\tfrom app.tools import ToolRegistry, build_registry\n408\t    23\t\n409\t    24\tlog = logging.getLogger(__name__)\n410\t    25\ttracer = trace.get_tracer(\"procurement.loop\")\n411\t    26\t\n412\t    27\tCOMPACT_AFTER_MESSAGES = 40\n413\t    28\tKEEP_RECENT_MESSAGES = 12\n414\t    29\t\n415\t    30\t\n416\t    31\t@dataclass\n417\t    32\tclass AgentDeps:\n418\t    33\t    settings: Any\n419\t    34\t    pool: Any\n420\t    35\t    gate: PolicyGate\n421\t    36\t    erp: Any\n422\t    37\t    slack: Any\n423\t    38\t    broker: Any\n424\t    39\t    extractor: Any = None\n425\t    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n426\t    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n427\t    42\t\n428\t    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n429\t    44\t        return self._budgets[ident.run_id]\n430\t    45\t\n431\t    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n432\t    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n433\t    48\t\n434\t    49\t    def erp_scope_for(self, operation: str) -> str:\n435\t    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n436\t    51\t        return scopes.get(operation, \"erp.read\")\n437\t    52\t\n438\t    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n439\t    54\t        self._contexts[ident.agent_instance_id] = ctx\n440\t    55\t        proposed = await audit.record(\n441\t    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n442\t    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n443\t    58\t        )\n444\t    59\t        tool = registry.get(use.name)\n445\t    60\t        if tool is None:\n446\t    61\t            await audit.record(\n447\t    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n448\t    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n449\t    64\t            )\n450\t    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n451\t    66\t\n452\t    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n453\t    68\t        authz = await audit.record(\n454\t    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n455\t    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n456\t    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n457\t    72\t        )\n458\t    73\t        if not decision.allow:\n459\t    74\t            if decision.pending:\n460\t    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n461\t    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n462\t    77\t\n463\t    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n464\t    79\t        try:\n465\t    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n466\t    81\t                for k, v in ctx.otel_attributes().items():\n467\t    82\t                    span.set_attribute(k, v)\n468\t    83\t                output = await tool.invoke(use.input, ident)\n469\t    84\t        except BudgetExceeded:\n470\t    85\t            raise\n471\t    86\t        except Exception as exc:\n472\t    87\t            await audit.record(\n473\t    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n474\t    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n475\t    90\t                operation_id=operation_id,\n476\t    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n477\t    92\t            )\n478\t    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n479\t    94\t\n480\t    95\t        await audit.record(\n481\t    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n482\t    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n483\t    98\t            operation_id=operation_id,\n484\t    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n485\t   100\t        )\n486\t   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n487\t   102\t\n488\t   103\t\n489\t   104\tdef _error(tool_use_id: str, message: str) -> dict:\n490\t   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n491\t   106\t\n492\t   107\t\n493\t   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n494\t   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n495\t   110\t        return messages, False\n496\t   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n497\t   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n498\t   113\t        tail = tail[1:]\n499\t   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n500\t   115\t    return head + [note] + tail, True\n501\t   116\t\n502\t   117\t\n503\t   118\tclass ProcurementAgent:\n504\t   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n505\t   120\t        self.client = client\n506\t   121\t        self.deps = deps\n507\t   122\t        self.system_prompt = system_prompt\n508\t   123\t        self.role = role\n509\t   124\t\n510\t   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n511\t   126\t        pool = self.deps.pool\n512\t   127\t        await killswitch.assert_running(pool, ident.tenant)\n513\t   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n514\t   129\t        await budget.reserve_run_start(pool)\n515\t   130\t        self.deps._budgets[ident.run_id] = budget\n516\t   131\t        registry = build_registry(self.role, ident, self.deps)\n517\t   132\t\n518\t   133\t        run_node = await audit.record(\n519\t   134\t            pool, ident, kind=\"run_started\",\n520\t   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n521\t   136\t        )\n522\t   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n523\t   138\t        try:\n524\t   139\t            while True:\n525\t   140\t                budget.check_step()\n526\t   141\t                messages, compacted = _compact(messages)\n527\t   142\t                request = {\n528\t   143\t                    \"model\": self.deps.settings.model_id,\n529\t   144\t                    \"system\": self.system_prompt,\n530\t   145\t                    \"messages\": messages,\n531\t   146\t                    \"tools\": registry.schemas(),\n532\t   147\t                    \"max_tokens\": 4096,\n533\t   148\t                }\n534\t   149\t                ctx = await measure_context(self.client, request, compacted)\n535\t   150\t                response = await self.client.messages.create(**request)\n536\t   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n537\t   152\t                await budget.flush(pool)\n538\t   153\t                ctx = ctx.finalize(response.usage)\n539\t   154\t                decision = await audit.record(\n540\t   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n541\t   156\t                    payload={\n542\t   157\t                        \"requested_model\": request[\"model\"],\n543\t   158\t                        \"served_model\": response.model,\n544\t   159\t                        \"stop_reason\": response.stop_reason,\n545\t   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n546\t   161\t                    },\n547\t   162\t                )\n548\t   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n549\t   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n550\t   165\t                if not uses:\n551\t   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n552\t   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n553\t   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n554\t   169\t                    return final\n555\t   170\t                results = []\n556\t   171\t                for use in uses:\n557\t   172\t                    budget.check_tool_call()\n558\t   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n559\t   174\t                messages.append({\"role\": \"user\", \"content\": results})\n560\t   175\t        except BudgetExceeded as exc:\n561\t   176\t            await audit.record(\n562\t   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n563\t   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n564\t   179\t            )\n565\t   180\t            await self.deps.slack.post(\n566\t   181\t                channel=\"#procurement-agent-ops\",\n567\t   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n568\t   183\t            )\n569\t   184\t            return None\n570\t   185\t        finally:\n571\t   186\t            self.deps._budgets.pop(ident.run_id, None)\n572\t=== app/main.py\n573\t     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n574\t     2\tfrom __future__ import annotations\n575\t     3\t\n576\t     4\timport asyncio\n577\t     5\timport hashlib\n578\t     6\timport hmac\n579\t     7\timport json\n580\t     8\timport logging\n581\t     9\timport time\n582\t    10\timport uuid\n583\t    11\tfrom contextlib import asynccontextmanager\n584\t    12\tfrom pathlib import Path\n585\t    13\tfrom urllib.parse import parse_qs\n586\t    14\t\n587\t    15\timport asyncpg\n588\t    16\timport jwt\n589\t    17\tfrom anthropic import AsyncAnthropic\n590\t    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n591\t    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n592\t    20\tfrom opentelemetry import trace\n593\t    21\tfrom pydantic import BaseModel, Field\n594\t    22\t\n595\t    23\tfrom app import audit, ingest\n596\t    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n597\t    25\tfrom app.extractor import LineItemExtractor\n598\t    26\tfrom app.gate import PolicyGate\n599\t    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n600\t    28\tfrom app.loop import AgentDeps, ProcurementAgent\n601\t    29\tfrom app.mcp_client import ErpMcpClient\n602\t    30\tfrom app.redact import RedactingFilter\n603\t    31\tfrom app.settings import get_settings\n604\t    32\tfrom app.startup import startup_checks\n605\t    33\tfrom app.tools.slack import SlackClient\n606\t    34\t\n607\t    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n608\t    36\tfor handler in logging.getLogger().handlers:\n609\t    37\t    handler.addFilter(RedactingFilter())\n610\t    38\tlog = logging.getLogger(\"procurement\")\n611\t    39\t\n612\t    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n613\t    41\tbearer = HTTPBearer()\n614\t    42\t\n615\t    43\t\n616\t    44\tclass RunRequest(BaseModel):\n617\t    45\t    task: str = Field(min_length=1, max_length=4000)\n618\t    46\t    department: str = Field(min_length=1, max_length=64)\n619\t    47\t\n620\t    48\t\n621\t    49\tclass Principal(BaseModel):\n622\t    50\t    subject: str\n623\t    51\t    business_unit: str\n624\t    52\t\n625\t    53\t\n626\t    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n627\t    55\t    return RunIdentity(\n628\t    56\t        accountable_party=\"system:procurement-agent\",\n629\t    57\t        operational_owner=settings.operational_owner,\n630\t    58\t        tenant=tenant,\n631\t    59\t        agent_type_id=agent_type_id,\n632\t    60\t        agent_instance_id=new_instance_id(),\n633\t    61\t        trace_id=uuid.uuid4().hex,\n634\t    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n635\t    63\t        delegated_subject=\"system:procurement-agent\",\n636\t    64\t        agent_principal=AGENT_PRINCIPAL,\n637\t    65\t    )\n638\t    66\t\n639\t    67\t\n640\t    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n641\t    69\t    while True:\n642\t    70\t        await asyncio.sleep(60)\n643\t    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n644\t    72\t        count = await app.state.pool.fetchval(\n645\t    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n646\t    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n647\t    75\t        )\n648\t    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n649\t    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n650\t    78\t\n651\t    79\t\n652\t    80\t@asynccontextmanager\n653\t    81\tasync def lifespan(app: FastAPI):\n654\t    82\t    settings = get_settings()\n655\t    83\t    agent_type_id = startup_checks(settings)\n656\t    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n657\t    85\t    broker = TokenBroker(settings)\n658\t    86\t\n659\t    87\t    async def slack_token() -> str:\n660\t    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n661\t    89\t\n662\t    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n663\t    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n664\t    92\t    gate = PolicyGate(settings.policy, approvals)\n665\t    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n666\t    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n667\t    95\t\n668\t    96\t    client = AsyncAnthropic()\n669\t    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n670\t    98\t    deps.extractor = LineItemExtractor(\n671\t    99\t        client=client, settings=settings, deps=deps,\n672\t   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n673\t   101\t    )\n674\t   102\t    app.state.settings = settings\n675\t   103\t    app.state.pool = pool\n676\t   104\t    app.state.agent_type_id = agent_type_id\n677\t   105\t    app.state.approvals = approvals\n678\t   106\t    app.state.agent = ProcurementAgent(\n679\t   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n680\t   108\t    )\n681\t   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n682\t   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n683\t   111\t    try:\n684\t   112\t        yield\n685\t   113\t    finally:\n686\t   114\t        sweeper.cancel()\n687\t   115\t        await pool.close()\n688\t   116\t\n689\t   117\t\n690\t   118\tapp = FastAPI(lifespan=lifespan)\n691\t   119\tapp.include_router(ingest.router)\n692\t   120\t\n693\t   121\t\n694\t   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n695\t   123\t    settings = request.app.state.settings\n696\t   124\t    try:\n697\t   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n698\t   126\t        claims = jwt.decode(\n699\t   127\t            creds.credentials,\n700\t   128\t            key.key,\n701\t   129\t            algorithms=[\"RS256\", \"ES256\"],\n702\t   130\t            audience=settings.oidc_audience,\n703\t   131\t            issuer=settings.oidc_issuer,\n704\t   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n705\t   133\t        )\n706\t   134\t    except jwt.PyJWTError as exc:\n707\t   135\t        raise HTTPException(401, \"invalid token\") from exc\n708\t   136\t    bu = claims.get(\"bu\")\n709\t   137\t    if not bu:\n710\t   138\t        raise HTTPException(403, \"token has no business unit\")\n711\t   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n712\t   140\t\n713\t   141\t\n714\t   142\t@app.post(\"/runs\")\n715\t   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n716\t   144\t    settings = request.app.state.settings\n717\t   145\t    span_ctx = trace.get_current_span().get_span_context()\n718\t   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n719\t   147\t    ident = RunIdentity(\n720\t   148\t        accountable_party=principal.subject,\n721\t   149\t        operational_owner=settings.operational_owner,\n722\t   150\t        tenant=principal.business_unit,\n723\t   151\t        agent_type_id=request.app.state.agent_type_id,\n724\t   152\t        agent_instance_id=new_instance_id(),\n725\t   153\t        trace_id=trace_id,\n726\t   154\t        run_id=f\"run-{uuid.uuid4()}\",\n727\t   155\t        delegated_subject=principal.subject,\n728\t   156\t        agent_principal=AGENT_PRINCIPAL,\n729\t   157\t    )\n730\t   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n731\t   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n732\t   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n733\t   161\t\n734\t   162\t\n735\t   163\t@app.post(\"/slack/interactions\")\n736\t   164\tasync def slack_interactions(request: Request) -> dict:\n737\t   165\t    body = await request.body()\n738\t   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n739\t   167\t    if abs(time.time() - int(timestamp)) > 300:\n740\t   168\t        raise HTTPException(401, \"stale request\")\n741\t   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n742\t   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n743\t   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n744\t   172\t        raise HTTPException(401, \"bad signature\")\n745\t   173\t\n746\t   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n747\t   175\t    action = payload[\"actions\"][0]\n748\t   176\t    slack_user = payload[\"user\"][\"id\"]\n749\t   177\t    row = await request.app.state.pool.fetchrow(\n750\t   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n751\t   179\t    )\n752\t   180\t    if row is None:\n753\t   181\t        raise HTTPException(403, \"not an approver\")\n754\t   182\t    try:\n755\t   183\t        await request.app.state.approvals.decide(\n756\t   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n757\t   185\t            approve=action[\"action_id\"] == \"approve\",\n758\t   186\t        )\n759\t   187\t    except ApproverNotAuthorized as exc:\n760\t   188\t        raise HTTPException(403, str(exc)) from exc\n761\t   189\t    except ValueError as exc:\n762\t   190\t        raise HTTPException(409, str(exc)) from exc\n763\t   191\t    return {\"ok\": True}\n764\t   192\t\n765\t   193\t\n766\t   194\t@app.get(\"/healthz\")\n767\t   195\tasync def healthz() -> dict:\n768\t   196\t    return {\"ok\": True}\n769\t"}]},"parent_tool_use_id":null,"session_id":"ffba58d5-df04-4124-855f-107eebce3f74","uuid":"900f6905-788d-4267-bff8-e5f017c1edac","timestamp":"2026-10-20T14:46:41.275Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-1kcleihw/ffba58d5-df04-4124-855f-107eebce3f74/tool-results/batjq326b.txt","content":"=== app/audit.py\n     1\t\"\"\"Execution audit graph.\n     2\t\n     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n     5\ttool call -> authorization decision -> result or error. Writes are\n     6\tsynchronous and are made before the action they describe; if the write\n     7\tfails, the caller raises and the action does not run.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport hashlib\n    12\timport json\n    13\timport uuid\n    14\tfrom datetime import datetime, timezone\n    15\tfrom typing import Any\n    16\t\n    17\tfrom opentelemetry import trace\n    18\t\n    19\tfrom app.context_size import ContextMeasure\n    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n    21\tfrom app.redact import redact_value\n    22\t\n    23\tEVENT_KINDS = {\n    24\t    \"run_started\",\n    25\t    \"run_finished\",\n    26\t    \"run_halted\",\n    27\t    \"model_decision\",\n    28\t    \"tool_proposed\",\n    29\t    \"authz_decision\",\n    30\t    \"approval_requested\",\n    31\t    \"approval_decided\",\n    32\t    \"tool_result\",\n    33\t    \"tool_error\",\n    34\t    \"tool_denied\",\n    35\t    \"budget_exceeded\",\n    36\t    \"subagent_started\",\n    37\t    \"subagent_finished\",\n    38\t    \"background_job\",\n    39\t}\n    40\t\n    41\t_INSERT = \"\"\"\n    42\tINSERT INTO audit_events (\n    43\t    node_id, parent_node_id, run_id, ts, kind,\n    44\t    accountable_party, operational_owner, tenant,\n    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n    46\t    delegated_subject, agent_principal, parent_instance_id,\n    47\t    policy_version, approval_id, operation_id,\n    48\t    context_tokens, context_method, context_compacted,\n    49\t    payload\n    50\t) VALUES (\n    51\t    $1, $2, $3, $4, $5,\n    52\t    $6, $7, $8,\n    53\t    $9, $10, $11, $12,\n    54\t    $13, $14, $15,\n    55\t    $16, $17, $18,\n    56\t    $19, $20, $21,\n    57\t    $22::jsonb\n    58\t)\n    59\t\"\"\"\n    60\t\n    61\t\n    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n    64\t    return {k: redact_value(v) for k, v in args.items()}\n    65\t\n    66\t\n    67\tdef digest(value: Any) -> str:\n    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    70\t\n    71\t\n    72\tasync def record(\n    73\t    pool,\n    74\t    ident: RunIdentity,\n    75\t    *,\n    76\t    kind: str,\n    77\t    payload: dict[str, Any] | None = None,\n    78\t    parent: str | None = None,\n    79\t    context: ContextMeasure | None = None,\n    80\t    policy_version: str | None = None,\n    81\t    approval_id: str | None = None,\n    82\t    operation_id: str | None = None,\n    83\t) -> str:\n    84\t    if kind not in EVENT_KINDS:\n    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n    86\t    for name in IDENTITY_FIELDS:\n    87\t        if not getattr(ident, name):\n    88\t            raise ValueError(f\"audit record missing {name}\")\n    89\t    span_ctx = trace.get_current_span().get_span_context()\n    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n    91\t    node_id = f\"node-{uuid.uuid4()}\"\n    92\t    measure = context or ContextMeasure.unavailable()\n    93\t    await pool.execute(\n    94\t        _INSERT,\n    95\t        node_id,\n    96\t        parent,\n    97\t        ident.run_id,\n    98\t        datetime.now(timezone.utc),\n    99\t        kind,\n   100\t        ident.accountable_party,\n   101\t        ident.operational_owner,\n   102\t        ident.tenant,\n   103\t        ident.agent_type_id,\n   104\t        ident.agent_instance_id,\n   105\t        ident.trace_id,\n   106\t        span_id,\n   107\t        ident.delegated_subject,\n   108\t        ident.agent_principal,\n   109\t        ident.parent_instance_id,\n   110\t        policy_version,\n   111\t        approval_id,\n   112\t        operation_id,\n   113\t        measure.tokens,\n   114\t        measure.method,\n   115\t        measure.compacted,\n   116\t        json.dumps(redact_value(payload or {}), default=str),\n   117\t    )\n   118\t    return node_id\n=== app/identity.py\n     1\t\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n     2\t\n     3\tThe agent runs under its own Kubernetes service account. Its projected\n     4\tservice-account token is exchanged at the internal STS for short-lived,\n     5\taudience-bound tokens. The launching user's token is never forwarded to an\n     6\tintegration; the user is carried as the delegated subject of the exchange.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport time\n    13\timport uuid\n    14\tfrom dataclasses import dataclass, field, replace\n    15\tfrom pathlib import Path\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.settings import Settings\n    20\t\n    21\tIDENTITY_FIELDS = (\n    22\t    \"accountable_party\",\n    23\t    \"operational_owner\",\n    24\t    \"tenant\",\n    25\t    \"agent_type_id\",\n    26\t    \"agent_instance_id\",\n    27\t    \"trace_id\",\n    28\t)\n    29\t\n    30\t\n    31\t@dataclass(frozen=True)\n    32\tclass RunIdentity:\n    33\t    accountable_party: str\n    34\t    operational_owner: str\n    35\t    tenant: str\n    36\t    agent_type_id: str\n    37\t    agent_instance_id: str\n    38\t    trace_id: str\n    39\t    run_id: str\n    40\t    delegated_subject: str\n    41\t    agent_principal: str\n    42\t    parent_instance_id: str | None = None\n    43\t    role: str = \"procurement\"\n    44\t\n    45\t    def __post_init__(self) -> None:\n    46\t        for name in IDENTITY_FIELDS:\n    47\t            if not getattr(self, name):\n    48\t                raise ValueError(f\"identity field {name} is empty\")\n    49\t\n    50\t    def child(self, role: str) -> \"RunIdentity\":\n    51\t        return replace(\n    52\t            self,\n    53\t            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n    54\t            parent_instance_id=self.agent_instance_id,\n    55\t            role=role,\n    56\t        )\n    57\t\n    58\t\n    59\tdef new_instance_id() -> str:\n    60\t    return f\"inst-{uuid.uuid4()}\"\n    61\t\n    62\t\n    63\tdef compute_agent_type_id(manifest: dict) -> str:\n    64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    65\t    material = {\n    66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n    67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n    68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n    69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n    70\t        \"models\": manifest[\"models\"],\n    71\t        \"config\": manifest[\"config\"],\n    72\t        \"tools\": manifest[\"tool_pins\"],\n    73\t    }\n    74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n    76\t\n    77\t\n    78\t@dataclass\n    79\tclass _CachedToken:\n    80\t    value: str\n    81\t    expires_at: float\n    82\t\n    83\t\n    84\t@dataclass\n    85\tclass TokenBroker:\n    86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n    87\t\n    88\t    settings: Settings\n    89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n    90\t\n    91\t    def _workload_token(self) -> str:\n    92\t        return Path(self.settings.workload_token_path).read_text().strip()\n    93\t\n    94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n    95\t        key = (audience, scope, ident.tenant)\n    96\t        cached = self._cache.get(key)\n    97\t        if cached and cached.expires_at - 30 > time.time():\n    98\t            return cached.value\n    99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n   100\t            resp = await client.post(\n   101\t                self.settings.sts_url,\n   102\t                data={\n   103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n   104\t                    \"subject_token\": self._workload_token(),\n   105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n   106\t                    \"audience\": audience,\n   107\t                    \"scope\": scope,\n   108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n   109\t                    \"actor_token\": ident.delegated_subject,\n   110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n   111\t                },\n   112\t            )\n   113\t            resp.raise_for_status()\n   114\t            body = resp.json()\n   115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n   116\t        self._cache[key] = token\n   117\t        return token.value\n=== app/extractor.py\n     1\t\"\"\"Line-item extraction sub-agent.\n     2\t\n     3\tThe parent procurement agent delegates structured extraction to a smaller\n     4\tmodel. The child runs under its own instance id, links to its parent in the\n     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport json\n    10\timport logging\n    11\tfrom typing import Any\n    12\t\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom app import audit\n    16\tfrom app.budget import Budget\n    17\tfrom app.context_size import measure_context\n    18\tfrom app.identity import RunIdentity\n    19\tfrom app.redact import redact_for_model\n    20\tfrom app.tools import build_registry\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n    24\t\n    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n    26\tMAX_TURNS = 4\n    27\t\n    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n    29\t\n    30\t\n    31\tclass ExtractionFailed(Exception):\n    32\t    pass\n    33\t\n    34\t\n    35\tclass LineItemExtractor:\n    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n    37\t        self.client = client\n    38\t        self.settings = settings\n    39\t        self.deps = deps\n    40\t        self.system_prompt = system_prompt\n    41\t\n    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n    43\t        budget.check_subagent()\n    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n    47\t\n    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n    51\t            start_node = await audit.record(\n    52\t                self.deps.pool,\n    53\t                ident,\n    54\t                kind=\"subagent_started\",\n    55\t                payload={\n    56\t                    \"role\": EXTRACTOR_ROLE,\n    57\t                    \"doc_id\": doc_id,\n    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n    59\t                    \"tools\": registry.names(),\n    60\t                },\n    61\t            )\n    62\t\n    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n    64\t            for _turn in range(MAX_TURNS):\n    65\t                budget.check_step()\n    66\t                request = {\n    67\t                    \"model\": self.settings.extractor_model_id,\n    68\t                    \"system\": self.system_prompt,\n    69\t                    \"messages\": messages,\n    70\t                    \"tools\": registry.schemas(),\n    71\t                    \"max_tokens\": 4096,\n    72\t                }\n    73\t                ctx = await measure_context(self.client, request, compacted=False)\n    74\t                response = await self.client.messages.create(**request)\n    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n    76\t                await budget.flush(self.deps.pool)\n    77\t                ctx = ctx.finalize(response.usage)\n    78\t                decision = await audit.record(\n    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n    81\t                             \"stop_reason\": response.stop_reason},\n    82\t                )\n    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n    85\t                if not uses:\n    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n    87\t                    items = _parse_items(text)\n    88\t                    await audit.record(\n    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n    90\t                        payload={\"items\": len(items)},\n    91\t                    )\n    92\t                    return items\n    93\t                results = []\n    94\t                for use in uses:\n    95\t                    budget.check_tool_call()\n    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n    97\t                messages.append({\"role\": \"user\", \"content\": results})\n    98\t\n    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n   100\t\n   101\t\n   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n   103\t    try:\n   104\t        data = json.loads(text)\n   105\t    except json.JSONDecodeError as exc:\n   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n   107\t    if not isinstance(data, list) or len(data) > 500:\n   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n   109\t    items = []\n   110\t    for raw in data:\n   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n   114\t    return items\n=== app/killswitch.py\n     1\t\"\"\"Operator stop control.\n     2\t\n     3\tOperators halt the fleet or one business unit by setting a row in\n     4\t``control_flags`` with the ``procurement_ops`` database role (see\n     5\tops/README in the platform runbook). The agent's own database role has\n     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\t\n    11\tclass AgentHalted(Exception):\n    12\t    pass\n    13\t\n    14\t\n    15\t_QUERY = \"\"\"\n    16\tSELECT scope, reason, set_by, set_at\n    17\tFROM control_flags\n    18\tWHERE halted\n    19\t  AND (scope = 'fleet' OR scope = $1)\n    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n    21\tLIMIT 1\n    22\t\"\"\"\n    23\t\n    24\t\n    25\tasync def assert_running(pool, tenant: str) -> None:\n    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n    27\t    if row is not None:\n    28\t        raise AgentHalted(\n    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n    31\t        )\n=== app/loop.py\n     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n=== app/main.py\n     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport hashlib\n     6\timport hmac\n     7\timport json\n     8\timport logging\n     9\timport time\n    10\timport uuid\n    11\tfrom contextlib import asynccontextmanager\n    12\tfrom pathlib import Path\n    13\tfrom urllib.parse import parse_qs\n    14\t\n    15\timport asyncpg\n    16\timport jwt\n    17\tfrom anthropic import AsyncAnthropic\n    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n    20\tfrom opentelemetry import trace\n    21\tfrom pydantic import BaseModel, Field\n    22\t\n    23\tfrom app import audit, ingest\n    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n    25\tfrom app.extractor import LineItemExtractor\n    26\tfrom app.gate import PolicyGate\n    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n    28\tfrom app.loop import AgentDeps, ProcurementAgent\n    29\tfrom app.mcp_client import ErpMcpClient\n    30\tfrom app.redact import RedactingFilter\n    31\tfrom app.settings import get_settings\n    32\tfrom app.startup import startup_checks\n    33\tfrom app.tools.slack import SlackClient\n    34\t\n    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n    36\tfor handler in logging.getLogger().handlers:\n    37\t    handler.addFilter(RedactingFilter())\n    38\tlog = logging.getLogger(\"procurement\")\n    39\t\n    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    41\tbearer = HTTPBearer()\n    42\t\n    43\t\n    44\tclass RunRequest(BaseModel):\n    45\t    task: str = Field(min_length=1, max_length=4000)\n    46\t    department: str = Field(min_length=1, max_length=64)\n    47\t\n    48\t\n    49\tclass Principal(BaseModel):\n    50\t    subject: str\n    51\t    business_unit: str\n    52\t\n    53\t\n    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    55\t    return RunIdentity(\n    56\t        accountable_party=\"system:procurement-agent\",\n    57\t        operational_owner=settings.operational_owner,\n    58\t        tenant=tenant,\n    59\t        agent_type_id=agent_type_id,\n    60\t        agent_instance_id=new_instance_id(),\n    61\t        trace_id=uuid.uuid4().hex,\n    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n    63\t        delegated_subject=\"system:procurement-agent\",\n    64\t        agent_principal=AGENT_PRINCIPAL,\n    65\t    )\n    66\t\n    67\t\n    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n    69\t    while True:\n    70\t        await asyncio.sleep(60)\n    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n    72\t        count = await app.state.pool.fetchval(\n    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n    75\t        )\n    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n    78\t\n    79\t\n    80\t@asynccontextmanager\n    81\tasync def lifespan(app: FastAPI):\n    82\t    settings = get_settings()\n    83\t    agent_type_id = startup_checks(settings)\n    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    85\t    broker = TokenBroker(settings)\n    86\t\n    87\t    async def slack_token() -> str:\n    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n    89\t\n    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n    92\t    gate = PolicyGate(settings.policy, approvals)\n    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n    95\t\n    96\t    client = AsyncAnthropic()\n    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    98\t    deps.extractor = LineItemExtractor(\n    99\t        client=client, settings=settings, deps=deps,\n   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n   101\t    )\n   102\t    app.state.settings = settings\n   103\t    app.state.pool = pool\n   104\t    app.state.agent_type_id = agent_type_id\n   105\t    app.state.approvals = approvals\n   106\t    app.state.agent = ProcurementAgent(\n   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n   108\t    )\n   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n   111\t    try:\n   112\t        yield\n   113\t    finally:\n   114\t        sweeper.cancel()\n   115\t        await pool.close()\n   116\t\n   117\t\n   118\tapp = FastAPI(lifespan=lifespan)\n   119\tapp.include_router(ingest.router)\n   120\t\n   121\t\n   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n   123\t    settings = request.app.state.settings\n   124\t    try:\n   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n   126\t        claims = jwt.decode(\n   127\t            creds.credentials,\n   128\t            key.key,\n   129\t            algorithms=[\"RS256\", \"ES256\"],\n   130\t            audience=settings.oidc_audience,\n   131\t            issuer=settings.oidc_issuer,\n   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n   133\t        )\n   134\t    except jwt.PyJWTError as exc:\n   135\t        raise HTTPException(401, \"invalid token\") from exc\n   136\t    bu = claims.get(\"bu\")\n   137\t    if not bu:\n   138\t        raise HTTPException(403, \"token has no business unit\")\n   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n   140\t\n   141\t\n   142\t@app.post(\"/runs\")\n   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n   144\t    settings = request.app.state.settings\n   145\t    span_ctx = trace.get_current_span().get_span_context()\n   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n   147\t    ident = RunIdentity(\n   148\t        accountable_party=principal.subject,\n   149\t        operational_owner=settings.operational_owner,\n   150\t        tenant=principal.business_unit,\n   151\t        agent_type_id=request.app.state.agent_type_id,\n   152\t        agent_instance_id=new_instance_id(),\n   153\t        trace_id=trace_id,\n   154\t        run_id=f\"run-{uuid.uuid4()}\",\n   155\t        delegated_subject=principal.subject,\n   156\t        agent_principal=AGENT_PRINCIPAL,\n   157\t    )\n   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n   161\t\n   162\t\n   163\t@app.post(\"/slack/interactions\")\n   164\tasync def slack_interactions(request: Request) -> dict:\n   165\t    body = await request.body()\n   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n   167\t    if abs(time.time() - int(timestamp)) > 300:\n   168\t        raise HTTPException(401, \"stale request\")\n   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n   172\t        raise HTTPException(401, \"bad signature\")\n   173\t\n   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n   175\t    action = payload[\"actions\"][0]\n   176\t    slack_user = payload[\"user\"][\"id\"]\n   177\t    row = await request.app.state.pool.fetchrow(\n   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n   179\t    )\n   180\t    if row is None:\n   181\t        raise HTTPException(403, \"not an approver\")\n   182\t    try:\n   183\t        await request.app.state.approvals.decide(\n   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n   185\t            approve=action[\"action_id\"] == \"approve\",\n   186\t        )\n   187\t    except ApproverNotAuthorized as exc:\n   188\t        raise HTTPException(403, str(exc)) from exc\n   189\t    except ValueError as exc:\n   190\t        raise HTTPException(409, str(exc)) from exc\n   191\t    return {\"ok\": True}\n   192\t\n   193\t\n   194\t@app.get(\"/healthz\")\n   195\tasync def healthz() -> dict:\n   196\t    return {\"ok\": True}\n","numLines":769,"startLine":1,"totalLines":769}},"tool_result_meta":[{"id":"toolu_01HcqcuwYsejNRwvCf5mYMsz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
