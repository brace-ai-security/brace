a4c8e2b6d\"\n\nprompts:\n  system:\n    path: prompts/system.md\n    sha256: \"sha256:dcf69216667e65a0be3711d99aac81b707ba843296e7ce26d6fcbdb50c5bcc50\"\n  extractor:\n    path: prompts/extractor.md\n    sha256: \"sha256:6ef6527b77ffcca8851e7a8760e6373f3daede15d5b343b878737f0deec28de3\"\n\nconfig:\n  policy:\n    path: config/policy.yaml\n    version: \"proc-policy-2026.09.3\"\n    sha256: \"sha256:d6a55f1e170bdd457958243ddd9aa938f4ca707a3e1e9d1e7bca2a54df33ad32\"\n  tools:\n    path: config/tools.yaml\n    sha256: \"sha256:86dccc3d7d166bf8e131c3b2afbe5f2b846a57eaaf087b55f9e308844eda9400\"\n  network_policy: deploy/k8s/networkpolicy.yaml\n  image_policy: deploy/k8s/kyverno-verify-images.yaml\n\nmodels:\n  primary:\n    role: \"main agent\"\n    owner: team-procurement-platform\n    provider: anthropic\n    model_id: \"claude-sonnet-4-5-20250929\"\n    id_kind: \"pinned snapshot\"\n    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    adapter: none\n    fine_tune: none\n    training_run: \"not applicable\"\n    served_version: \"recorded per call from response.model\"\n    provider_undisclosed: [weights digest, pretraining data version]\n  extractor:\n    role: \"line-item extraction sub-agent\"\n    owner: team-procurement-platform\n    provider: anthropic\n    model_id: \"claude-haiku-4-5-20251001\"\n    id_kind: \"pinned snapshot\"\n    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    adapter: none\n    fine_tune: none\n    training_run: \"not applicable\"\n    served_version: \"recorded per call from response.model\"\n    provider_undisclosed: [weights digest, pretraining data version]\n\nmcp_servers:\n  erp:\n    endpoint: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    owner: team-erp-integrations\n\n# Fingerprints of the approved ERP MCP tools (name, description, inputSchema,\n# annotations), computed by app.mcp_client.fingerprint.\ntool_pins:\n  budget.get_remaining: \"sha256:bc96af69ba1cfd67b5428269dc74aa3e754f4dfe2d5dfa81deb0af68819379ca\"\n  vendor.get: \"sha256:7db5e65fb6d482d06985b19b7f1fce7422398b117bc7482f0380108cd6a6a1fe\"\n  vendor.search: \"sha256:3bd5aa0908885e967ce8ee1aa22e37b4f4fba867c8eac2b4127bca626731092c\"\n  vendor.update_remit_to: \"sha256:d3d3916ee6d742311c92f4972a1ffeb0f24782e729351f3e375f13eb05b94c1b\"\n  invoice.get: \"sha256:848ece38456338a085cb7091a2bbf1024e07946d62beb32a9ee94d2fa2fa8876\"\n  invoice.list_open: \"sha256:12bb2318f3876da6421183032cdd36727e545275e8eaf6fff66451d09371f12b\"\n  invoice.mark_paid: \"sha256:3a208eb55ee3a39962316b5d25fe6ba23457380c01aa39a5469ce3691130b05a\"\n  invoice.void: \"sha256:9645bec805f2ffdfa44f698f49e8701a6487afa3cb3e3c5c44e721cb21633d4c\"\n  po.get: \"sha256:121df83a279fc2ae3764c83faeb34f3037026586991c9192144ad7b727d18d7b\"\n  po.list_open: \"sha256:203c57fd158a8edf11b8dc02be534bc805d8caaf0959db8280f59ea0e5beb70a\"\n  po.create: \"sha256:fb15c157f7d79321972b310d74ee6c88a0fc76fd8edbbe4e821dcaa95a0852c6\"\n\nbudgets: config/policy.yaml#budgets\nidentity:\n  service_account: procurement-agent\n  spiffe_id: \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n  sts_audiences: [erp-mcp-gateway, payments-api, slack-proxy]\nmemory:\n  store: \"postgres procurement.dept_notes\"\n  expiry_unverified_days: 30\nretrieval: none\nversion: \"proc-policy-2026.09.3\"\n\n# Operations that change money, vendor records, or purchase commitments.\n# Denied unless a valid approval exists for the operation and its target.\nhigh_impact_tools:\n  - create_purchase_order\n  - pay_invoice\n\nerp:\n  # Namespaces the agent may reach through the generic erp_call tool.\n  read_prefixes:\n    - \"budget.\"\n    - \"vendor.\"\n    - \"invoice.\"\n    - \"po.get\"\n    - \"po.list\"\n  # Scope requested from the STS for each ERP operation; the ERP enforces it.\n  operation_scopes:\n    budget.get_remaining: \"erp.read\"\n    vendor.get: \"erp.read\"\n    vendor.search: \"erp.read\"\n    vendor.update_remit_to: \"erp.read erp.vendor.write\"\n    invoice.get: \"erp.read\"\n    invoice.list_open: \"erp.read\"\n    invoice.mark_paid: \"erp.read erp.invoice.write\"\n    invoice.void: \"erp.read erp.invoice.write\"\n    po.get: \"erp.read\"\n    po.list_open: \"erp.read\"\n    po.create: \"erp.read erp.po.create\"\n\napprovals:\n  ttl_minutes: 60\n  approver_roles:\n    pay_invoice: [ap_manager, finance_controller]\n    create_purchase_order: [budget_owner, finance_controller]\n    post_slack_message: [procurement_lead]\n\nbudgets:\n  per_run:\n    max_steps: 25\n    max_wall_seconds: 300\n    max_tokens: 400000\n    max_cost_usd: 4.00\n    max_tool_calls_per_minute: 30\n    max_subagents: 3\n  quotas_daily_usd:\n    user: 25\n    tenant: 250\n    fleet: 1500\n  run_starts_per_minute:\n    user: 5\n    tenant: 40\n    fleet: 200\n# Tools per agent role, each with the task reason it is granted.\nroles:\n  procurement:\n    tools:\n      read_document: \"Read vendor quotes, invoices and emails that arrived through the mail gateway.\"\n      extract_line_items: \"Delegate line-item extraction from long documents to the extractor.\"\n      get_budget: \"Check remaining department budget before raising a purchase order.\"\n      erp_call: \"Look up vendors, open invoices and purchase orders for matching.\"\n      create_purchase_order: \"Raise a purchase order once a quote is within budget and approved.\"\n      pay_invoice: \"Pay an invoice that is matched to a purchase order and approved.\"\n      post_slack_message: \"Ask staff for missing details and confirm orders with vendors.\"\n      memory_read: \"Recall department preferences and contract terms from earlier runs.\"\n      memory_write: \"Save new department preferences and contract terms.\"\n  extractor:\n    tools:\n      read_document: \"Read the document whose line items are being extracted.\"\n# procurement-agent\n\nProcurement agent for Example Corp business units. It reads vendor quotes and\ninvoices that arrive by email, checks them against department budgets, raises\npurchase orders in the ERP, pays matched invoices, and talks to staff and\nvendors in Slack. It keeps short per-department notes between runs.\n\n## Architecture\n\n```\nmail gateway --HMAC--> /ingest/mail --> documents (Postgres, per business unit)\nstaff (OIDC JWT) ----> /runs --> ProcurementAgent loop (app/loop.py)\n                                   |-- PolicyGate (app/gate.py) + approvals (Slack buttons)\n                                   |-- Budget (app/budget.py)\n                                   |-- audit graph (app/audit.py -> audit_events)\n                                   |-- tools:\n                                   |     read_document, extract_line_items -> LineItemExtractor sub-agent\n                                   |     get_budget, erp_call, create_purchase_order -> ERP MCP via gateway\n                                   |     pay_invoice -> payments API\n                                   |     post_slack_message -> Slack (via slack-proxy)\n                                   |     memory_read, memory_write -> dept_notes\n```\n\n* **Tenancy.** Each run belongs to one business unit, taken from the `bu`\n  claim of the caller's verified OIDC token. Documents, notes, approvals and\n  quotas are keyed by business unit.\n* **Identity.** The agent runs as the `procurement-agent` service account.\n  Its projected token (10-minute lifetime) is exchanged at the internal STS\n  for audience-bound tokens for the ERP gateway, payments API and Slack\n  proxy. User tokens are never forwarded.\n* **Approvals.** `create_purchase_order`, `pay_invoice` and vendor messages\n  require an approval from a role listed in `config/policy.yaml`. Approval\n  requests are posted to `#approvals-<bu>` with the argument summary.\n* **Budgets.** Per-run step, time, token, cost, tool-rate and sub-agent\n  limits, plus per-user, per-business-unit and fleet quotas for daily spend\n  and run starts. See `config/policy.yaml`.\n* **Audit.** Every run step is a row in `audit_events` linked to its parent\n  step, with the six identity fields, policy version, approval id and\n  decision-time context size. The agent's database role can insert audit\n  rows but not update or delete them.\n\n## Context size\n\nLogged on every audit row as `context_tokens` and `context_method`:\n\n| method | meaning |\n|---|---|\n| `count_tokens_api` | exact request counted with the provider's token-count endpoint before the call (includes cached prefix) |\n| `usage_sum_estimate` | counting failed; `input_tokens + cache_read + cache_creation` from the response |\n| `unavailable` | neither available; `context_tokens` is NULL, never 0 |\n\n`context_compacted` is true when the harness dropped earlier turns before the\ncall (`app/loop.py:_compact`). Provider-side truncation is not visible.\n\n## Operating\n\n* **Halt.** Insert or update a row in `control_flags` (`scope = 'fleet'` or\n  `'tenant:<bu>'`, `halted = true`) as `procurement_ops`. New runs refuse to\n  start while a halt is set.\n* **Release.** Merges to `main` build, sign (keyless cosign), and attest the\n  image (SLSA provenance and CycloneDX SBOM). Kyverno rejects unsigned or\n  unattested images in `procurement-prod`.\n* **Network.** Default-deny egress with explicit rules for DNS, the egress\n  proxy, the Slack proxy, the database, the ERP gateway and the STS.\n\n## Tests\n\n```bash\npip install -e '.[test]'\npytest -q\n```","is_error":false}]},"parent_tool_use_id":null,"session_id":"ffba58d5-df04-4124-855f-107eebce3f74","uuid":"9e121b89-76df-4d3b-af26-803c3b0b1c6b","timestamp":"2026-10-20T14:46:34.365Z","tool_use_result":{"stdout":"{\n  \"repo\": \"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-1kcleihw/agent\",\n  \"patterns_file\": \"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-1kcleihw/skill/prescan/patterns.yaml\",\n  \"files_scanned\": 35,\n  \"note\": \"Hits are places to read, not findings