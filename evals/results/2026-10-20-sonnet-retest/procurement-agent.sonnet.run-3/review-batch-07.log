{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P79Vy8oqqBK9JjiQtPgR6S","type":"tool_result","content":"     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tUNTRUSTED_WRAPPER = (\n    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n    11\t    \"{text}\\n\"\n    12\t    \"</untrusted_document>\"\n    13\t)\n    14\t\n    15\t\n    16\tdef tools(deps) -> list[Tool]:\n    17\t    pool = deps.pool\n    18\t\n    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n    20\t        row = await pool.fetchrow(\n    21\t            \"\"\"\n    22\t            SELECT doc_id, source, media_type, text\n    23\t            FROM documents\n    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n    25\t            \"\"\",\n    26\t            args[\"doc_id\"],\n    27\t            ident.tenant,\n    28\t        )\n    29\t        if row is None:\n    30\t            return \"document not found\"\n    31\t        return UNTRUSTED_WRAPPER.format(\n    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n    33\t        )\n    34\t\n    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n    37\t\n    38\t    return [\n    39\t        Tool(\n    40\t            name=\"read_document\",\n    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n    42\t            input_schema={\n    43\t                \"type\": \"object\",\n    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    45\t                \"required\": [\"doc_id\"],\n    46\t                \"additionalProperties\": False,\n    47\t            },\n    48\t            invoke=read_document,\n    49\t        ),\n    50\t        Tool(\n    51\t            name=\"extract_line_items\",\n    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n    53\t            input_schema={\n    54\t                \"type\": \"object\",\n    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    56\t                \"required\": [\"doc_id\"],\n    57\t                \"additionalProperties\": False,\n    58\t            },\n    59\t            invoke=extract_line_items,\n    60\t        ),\n    61\t    ]\n\nclass BudgetExceeded(Exception):\n    def __init__(self, limit: str, used, allowed):\n        super().__init__(f\"{limit} exceeded: used={used} allowed={allowed}\")\n        self.limit = limit\n        self.used = used\n        self.allowed = allowed\n\n\n# USD per million tokens, from the provider price sheet referenced in the manifest.\nPRICES = {\n    \"claude-sonnet-4-5-20250929\": (Decimal(\"3.00\"), Decimal(\"15.00\")),\n    \"claude-haiku-4-5-20251001\": (Decimal(\"1.00\"), Decimal(\"5.00\")),\n}\n\n\n@dataclass\nclass Budget:\n    ident: RunIdentity\n    max_steps: int\n    max_wall_seconds: float\n    max_tokens: int\n    max_cost_usd: Decimal\n    max_tool_calls_per_minute: int\n    max_subagents: int\n    quotas_daily_usd: dict[str, Decimal]\n    run_starts_per_minute: dict[str, int]\n    started_at: float = field(default_factory=time.monotonic)\n    steps: int = 0\n    tokens: int = 0\n    cost_usd: Decimal = Decimal(\"0\")\n    unflushed_cost_usd: Decimal = Decimal(\"0\")\n    subagents: int = 0\n    _tool_calls: deque = field(default_factory=deque)\n\n    @classmethod\n    def for_run(cls, cfg: dict, ide