   12\t      memory_read: \"Recall department preferences and contract terms from earlier runs.\"\n    13\t      memory_write: \"Save new department preferences and contract terms.\"\n    14\t  extractor:\n    15\t    tools:\n    16\t      read_document: \"Read the document whose line items are being extracted.\"\n     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tUNTRUSTED_WRAPPER = (\n    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n    11\t    \"{text}\\n\"\n    12\t    \"</untrusted_document>\"\n    13\t)\n    14\t\n    15\t\n    16\tdef tools(deps) -> list[Tool]:\n    17\t    pool = deps.pool\n    18\t\n    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n    20\t        row = await pool.fetchrow(\n    21\t            \"\"\"\n    22\t            SELECT doc_id, source, media_type, text\n    23\t            FROM documents\n    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n    25\t            \"\"\",\n    26\t            args[\"doc_id\"],\n    27\t            ident.tenant,\n    28\t        )\n    29\t        if row is None:\n    30\t            return \"document not found\"\n    31\t        return UNTRUSTED_WRAPPER.format(\n    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n    33\t        )\n    34\t\n    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n    37\t\n    38\t    return [\n    39\t        Tool(\n    40\t            name=\"read_document\",\n    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n    42\t            input_schema={\n    43\t                \"type\": \"object\",\n    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    45\t                \"required\": [\"doc_id\"],\n    46\t                \"additionalProperties\": False,\n    47\t            },\n    48\t            invoke=read_document,\n    49\t        ),\n    50\t        Tool(\n    51\t            name=\"extract_line_items\",\n    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n    53\t            input_schema={\n    54\t                \"type\": \"object\",\n    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    56\t                \"required\": [\"doc_id\"],\n    57\t                \"additionalProperties\": False,\n    58\t            },\n    59\t            invoke=extract_line_items,\n    60\t        ),\n    61\t    ]\n@asynccontextmanager\nasync def lifespan(app: FastAPI):\n    settings = get_settings()\n    agent_type_id = startup_checks(settings)\n    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    broker = TokenBroker(settings)\n\n    async def slack_token() -> str:\n        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n\n    slack = SlackClient(settings.slack_api_url, slack_token)\n    approvals = ApprovalStore(pool, settings.policy, slack)\n    gate = PolicyGate(settings.policy, approvals)\n    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    await erp.initialize(service_identity(settings, agent_type_id))\n\n    client = AsyncAnthropic()\n    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    deps.extractor = LineItemExtractor(\n        client=client, settings=set