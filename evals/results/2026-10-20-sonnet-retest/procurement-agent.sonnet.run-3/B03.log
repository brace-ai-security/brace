{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RKkzjFY3N9fq3m9E6gRTPo","type":"tool_result","content":"60\t    return f\"inst-{uuid.uuid4()}\"\n61\t\n62\t\n63\tdef compute_agent_type_id(manifest: dict) -> str:\n64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n65\t    material = {\n66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n70\t        \"models\": manifest[\"models\"],\n71\t        \"config\": manifest[\"config\"],\n72\t        \"tools\": manifest[\"tool_pins\"],\n73\t    }\n74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n76\t\n77\t\n78\t@dataclass\n79\tclass _CachedToken:\n80\t    value: str\n81\t    expires_at: float\n82\t\n83\t\n84\t@dataclass\n85\tclass TokenBroker:\n86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n87\t\n88\t    settings: Settings\n89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n90\t\n91\t    def _workload_token(self) -> str:\n92\t        return Path(self.settings.workload_token_path).read_text().strip()\n93\t\n94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n95\t        key = (audience, scope, ident.tenant)\n96\t        cached = self._cache.get(key)\n97\t        if cached and cached.expires_at - 30 > time.time():\n98\t            return cached.value\n99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n100\t            resp = await client.post(\n101\t                self.settings.sts_url,\n102\t                data={\n103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n104\t                    \"subject_token\": self._workload_token(),\n105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n106\t                    \"audience\": audience,\n107\t                    \"scope\": scope,\n108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n109\t                    \"actor_token\": ident.delegated_subject,\n110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n111\t                },\n112\t            )\n113\t            resp.raise_for_status()\n114\t            body = resp.json()\n115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n116\t        self._cache[key] = token\n117\t        return token.value\n118\t"}]},"parent_tool_use_id":null,"session_id":"9d0b55e7-28b7-4bab-91a8-2419e1121998","uuid":"5043059f-9b02-4b33-9d46-839b46d50c0e","timestamp":"2026-10-20T15:06:58.353Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-g_gs_b6f/agent/app/identity.py","content":"    return f\"inst-{uuid.uuid4()}\"\n\n\ndef compute_agent_type_id(manifest: dict) -> str:\n    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    material = {\n        \"image_digest\": manifest[\"image\"][\"digest\"],\n        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n        \"models\": manifest[\"models\"],\n        \"config\": manifest[\"config\"],\n        \"tools\": manifest[\"tool_pins\"],\n    }\n    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n\n\n@dataclass\nclass _CachedToken:\n    value: str\n    expires_at: float\n\n\n@dataclass\nclass TokenBroker:\n    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n\n    settings: Settings\n    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n\n    def _workload_token(self) -> str:\n        return Path(self.settings.workload_token_path).read_text().strip()\n\n    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n        key = (audience, scope, ident.tenant)\n        cached = self._cache.get(key)\n        if cached and cached.expires_at - 30 > time.time():\n            return cached.value\n        async with httpx.AsyncClient(timeout=5.0) as client:\n            resp = await client.post(\n                self.settings.sts_url,\n                data={\n                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n                    \"subject_token\": self._workload_token(),\n                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n                    \"audience\": audience,\n                    \"scope\": scope,\n                    \"resource\": f\"urn:bu:{ident.tenant}\",\n                    \"actor_token\": ident.delegated_subject,\n                    \"actor_token_type\": \"urn:example:params:subject-id\",\n                },\n            )\n            resp.raise_for_status()\n            body = resp.json()\n        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n        self._cache[key] = token\n        return token.value\n","numLines":59,"startLine":60,"totalLines":118}},"tool_result_meta":[{"id":"toolu_01RKkzjFY3N9fq3m9E6gRTPo","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
