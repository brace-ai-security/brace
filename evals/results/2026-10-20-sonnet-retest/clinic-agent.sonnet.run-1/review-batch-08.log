{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ecs4UkmSkr34ZZR8RZJ8EL","type":"tool_result","content":"     1\tterraform {\n     2\t  required_version = \">= 1.9.0\"\n     3\t  required_providers {\n     4\t    aws    = { source = \"hashicorp/aws\", version = \"~> 6.14\" }\n     5\t    github = { source = \"integrations/github\", version = \"~> 6.6\" }\n     6\t  }\n     7\t  backend \"s3\" {\n     8\t    bucket         = \"northbay-tfstate-418295730611\"\n     9\t    key            = \"clinic-agent/prod.tfstate\"\n    10\t    region         = \"us-west-2\"\n    11\t    dynamodb_table = \"northbay-tf-locks\"\n    12\t    encrypt        = true\n    13\t  }\n    14\t}\n    15\t\n    16\tprovider \"aws\" {\n    17\t  region = var.region\n    18\t  default_tags {\n    19\t    tags = { app = \"clinic-agent\", owner = \"agent-platform\", data = \"phi\" }\n    20\t  }\n    21\t}\n    22\t\n    23\tvariable \"region\" {\n    24\t  type    = string\n    25\t  default = \"us-west-2\"\n    26\t}\n    27\t\n    28\tvariable \"clinic_ids\" {\n    29\t  type    = list(string)\n    30\t  default = [\"nb-castro\", \"nb-fremont\", \"nb-oakland\", \"nb-sanmateo\", \"nb-walnutcreek\"]\n    31\t}\n    32\t\n    33\tdata \"aws_caller_identity\" \"current\" {}\n    34\t\n    35\tmodule \"eks\" {\n    36\t  source  = \"terraform-aws-modules/eks/aws\"\n    37\t  version = \"21.3.1\"\n    38\t\n    39\t  name               = \"clinic-agent-prod\"\n    40\t  kubernetes_version = \"1.33\"\n    41\t  vpc_id             = module.vpc.vpc_id\n    42\t  subnet_ids         = module.vpc.private_subnets\n    43\t\n    44\t  endpoint_public_access = false\n    45\t  enable_irsa            = true\n    46\t\n    47\t  authentication_mode = \"API\"\n    48\t  access_entries = {\n    49\t    deploy = {\n    50\t      principal_arn = aws_iam_role.deploy.arn\n    51\t      policy_associations = {\n    52\t        ns = {\n    53\t          policy_arn   = \"arn:aws:eks::aws:cluster-access-policy/AmazonEKSEditPolicy\"\n    54\t          access_scope = { type = \"namespace\", namespaces = [\"clinic-agent\"] }\n    55\t        }\n    56\t      }\n    57\t    }\n    58\t  }\n    59\t\n    60\t  eks_managed_node_groups = {\n    61\t    agents = {\n    62\t      instance_types = [\"m7g.large\"]\n    63\t      ami_type       = \"BOTTLEROCKET_ARM_64\"\n    64\t      min_size       = 2\n    65\t      max_size       = 6\n    66\t      desired_size   = 3\n    67\t      metadata_options = {\n    68\t        http_tokens                 = \"required\"\n    69\t        http_put_response_hop_limit = 1\n    70\t      }\n    71\t    }\n    72\t  }\n    73\t}\n    74\t\n    75\tmodule \"vpc\" {\n    76\t  source  = \"terraform-aws-modules/vpc/aws\"\n    77\t  version = \"6.4.0\"\n    78\t\n    79\t  name            = \"clinic-agent-prod\"\n    80\t  cidr            = \"10.42.0.0/16\"\n    81\t  azs             = [\"us-west-2a\", \"us-west-2b\", \"us-west-2c\"]\n    82\t  private_subnets = [\"10.42.1.0/24\", \"10.42.2.0/24\", \"10.42.3.0/24\"]\n    83\t  public_subnets  = [\"10.42.101.0/24\", \"10.42.102.0/24\", \"10.42.103.0/24\"]\n    84\t\n    85\t  enable_nat_gateway = true\n    86\t  single_nat_gateway = false\n    87\t}\n    88\t\n    89\tresource \"aws_ecr_repository\" \"agent\" {\n    90\t  name                 = \"clinic-agent\"\n    91\t  image_tag_mutability = \"IMMUTABLE\"\n    92\t  image_scanning_configuration { scan_on_push = true }\n    93\t}\n    94\t\n    95\t# State tables. Approvals are written by the staff console; budgets by the agent; the control\n    96\t# table holds the stop flags operators set.\n    97\tresource \"aws_dynamodb_table\" \"approvals\" {\n    98\t  name         = \"clinic-agent-approvals\"\n    99\t  billing_mode = \"PAY_PER_REQUEST\"\n   100\t  hash_key     = \"id\"\n   101\t  attribute {\n   102\t    name = \"id\"\n   103\t    type = \"S\"\n   104\t  }\n   105\t  point_in_time_recovery { enabled = true }\n   106\t}\n   107\t\n   108\tresource \"aws_dynamodb_table\" \"budgets\" {\n   109\t  name         = \"clinic-agent-budgets\"\n   110\t  billing_mode = \"PAY_PER_REQUEST\"\n   111\t  hash_key     = \"pk\"\n   112\t  attribute {\n   113\t    name = \"pk\"\n   114\t    type = \"S\"\n   115\t  }\n   116\t  ttl {\n   117\t    attribute_name = \"expiresAt\"\n   118\t    enabled        = true\n   119\t  }\n   120\t}\n   121\t\n   122\tresource \"aws_dynamodb_table\" \"control\" {\n   123\t  name         = \"clinic-agent-control\"\n   124\t  billing_mode = \"PAY_PER_REQUEST\"\n   125\t  hash_key     = \"pk\"\n   126\t  attribute {\n   127\t    name = \"pk\"\n   128\t    type = \"S\"\n   129\t  }\n   130\t  point_in_time_recovery { enabled = true }\n   131\t}\n   132\t\n   133\t# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).\n   134\tresource \"aws_s3_bucket\" \"audit\" {\n   135\t  bucket              = \"clinic-agent-audit-${data.aws_caller_identity.current.account_id}\"\n   136\t  object_lock_enabled = true\n   137\t}\n   138\t\n   139\tresource \"aws_s3_bucket_object_lock_configuration\" \"audit\" {\n   140\t  bucket = aws_s3_bucket.audit.id\n   141\t  rule {\n   142\t    default_retention {\n   143\t      mode  = \"COMPLIANCE\"\n   144\t      years = 7\n   145\t    }\n   146\t  }\n   147\t}\n   148\t\n   149\tresource \"aws_kinesis_firehose_delivery_stream\" \"audit\" {\n   150\t  name        = \"clinic-agent-audit\"\n   151\t  destination = \"extended_s3\"\n   152\t  extended_s3_configuration {\n   153\t    role_arn            = aws_iam_role.firehose.arn\n   154\t    bucket_arn          = aws_s3_bucket.audit.arn\n   155\t    prefix              = \"audit/dt=!{timestamp:yyyy-MM-dd}/\"\n   156\t    error_output_prefix = \"audit-errors/!{firehose:error-output-type}/\"\n   157\t    buffering_interval  = 60\n   158\t  }\n   159\t}\n   160\t\n   161\tresource \"aws_secretsmanager_secret\" \"ehr\" {\n   162\t  for_each = toset(concat(var.clinic_ids, [\"_catalog\"]))\n   163\t  name     = \"clinic-agent/ehr/${each.key}\"\n   164\t}\n   165\t\n   166\tresource \"aws_secretsmanager_secret\" \"payments\" {\n   167\t  for_each = toset(var.clinic_ids)\n   168\t  name     = \"clinic-agent/payments/${each.key}\"\n   169\t}\n   170\t\n   171\tresource \"aws_secretsmanager_secret\" \"sms\" {\n   172\t  for_each = toset(var.clinic_ids)\n   173\t  name     = \"clinic-agent/sms/${each.key}\"\n   174\t}\n   175\t\n   176\tresource \"aws_secretsmanager_secret\" \"sms_signing\" {\n   177\t  name = \"clinic-agent/sms-signing\"\n   178\t}\n     1\t# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:\n     2\t# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.\n     3\tresource \"aws_iam_role\" \"runtime\" {\n     4\t  name                 = \"clinic-agent-runtime\"\n     5\t  max_session_duration = 3600\n     6\t  assume_role_policy = jsonencode({\n     7\t    Version = \"2012-10-17\"\n     8\t    Statement = [{\n     9\t      Effect    = \"Allow\"\n    10\t      Principal = { Federated = module.eks.oidc_provider_arn }\n    11\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n    12\t      Condition = {\n    13\t        StringEquals = {\n    14\t          \"${module.eks.oidc_provider}:sub\" = [\n    15\t            \"system:serviceaccount:clinic-agent:clinic-agent\",\n    16\t            \"system:serviceaccount:clinic-agent:clinic-agent-reminders\",\n    17\t          ]\n    18\t          \"${module.eks.oidc_provider}:aud\" = \"sts.amazonaws.com\"\n    19\t        }\n    20\t      }\n    21\t    }]\n    22\t  })\n    23\t}\n    24\t\n    25\tresource \"aws_iam_role_policy\" \"runtime\" {\n    26\t  name = \"clinic-agent-runtime\"\n    27\t  role = aws_iam_role.runtime.id\n    28\t  policy = jsonencode({\n    29\t    Version = \"2012-10-17\"\n    30\t    Statement = [\n    31\t      {\n    32\t        Sid      = \"ReadClinicSecrets\"\n    33\t        Effect   = \"Allow\"\n    34\t        Action   = [\"secretsmanager:GetSecretValue\"]\n    35\t        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\n    36\t      },\n    37\t      {\n    38\t        Sid    = \"AgentState\"\n    39\t        Effect = \"Allow\"\n    40\t        Action = [\n    41\t          \"dynamodb:GetItem\",\n    42\t          \"dynamodb:BatchGetItem\",\n    43\t          \"dynamodb:PutItem\",\n    44\t          \"dynamodb:UpdateItem\",\n    45\t          \"dynamodb:Query\",\n    46\t        ]\n    47\t        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*\"\n    48\t      },\n    49\t      {\n    50\t        Sid      = \"Audit\"\n    51\t        Effect   = \"Allow\"\n    52\t        Action   = [\"firehose:PutRecord\", \"firehose:PutRecordBatch\"]\n    53\t        Resource = aws_kinesis_firehose_delivery_stream.audit.arn\n    54\t      },\n    55\t    ]\n    56\t  })\n    57\t}\n    58\t\n    59\t# Operators who may stop the agent. Assumable only through SSO by the on-call group.\n    60\tresource \"aws_iam_role\" \"ops_killswitch\" {\n    61\t  name = \"clinic-agent-ops\"\n    62\t  assume_role_policy = jsonencode({\n    63\t    Version = \"2012-10-17\"\n    64\t    Statement = [{\n    65\t      Effect    = \"Allow\"\n    66\t      Principal = { AWS = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\" }\n    67\t      Action    = \"sts:AssumeRole\"\n    68\t      Condition = {\n    69\t        StringLike = { \"aws:PrincipalArn\" = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*\" }\n    70\t      }\n    71\t    }]\n    72\t  })\n    73\t}\n    74\t\n    75\tresource \"aws_iam_role_policy\" \"ops_killswitch\" {\n    76\t  name = \"clinic-agent-ops\"\n    77\t  role = aws_iam_role.ops_killswitch.id\n    78\t  policy = jsonencode({\n    79\t    Version = \"2012-10-17\"\n    80\t    Statement = [{\n    81\t      Effect   = \"Allow\"\n    82\t      Action   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:GetItem\"]\n    83\t      Resource = aws_dynamodb_table.control.arn\n    84\t    }]\n    85\t  })\n    86\t}\n    87\t\n    88\tresource \"aws_iam_role\" \"firehose\" {\n    89\t  name = \"clinic-agent-audit-firehose\"\n    90\t  assume_role_policy = jsonencode({\n    91\t    Version   = \"2012-10-17\"\n    92\t    Statement = [{ Effect = \"Allow\", Principal = { Service = \"firehose.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n    93\t  })\n    94\t}\n    95\t\n    96\tresource \"aws_iam_role_policy\" \"firehose\" {\n    97\t  name = \"write-audit-bucket\"\n    98\t  role = aws_iam_role.firehose.id\n    99\t  policy = jsonencode({\n   100\t    Version = \"2012-10-17\"\n   101\t    Statement = [{\n   102\t      Effect   = \"Allow\"\n   103\t      Action   = [\"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:GetBucketLocation\"]\n   104\t      Resource = [aws_s3_bucket.audit.arn, \"${aws_s3_bucket.audit.arn}/*\"]\n   105\t    }]\n   106\t  })\n   107\t}\n\nresource \"github_repository_environment\" \"production_emergency\" {\n  repository  = \"clinic-agent\"\n  environment = \"production-emergency\"\n  reviewers {\n    teams = [data.github_team.leads.id]\n  }\n  prevent_self_review = true\n  deployment_branch_policy {\n    protected_branches     = false\n    custom_branch_policies = true\n  }\n}\n\nresource \"github_repository_environment_deployment_policy\" \"emergency_branches\" {\n  repository     = \"clinic-agent\"\n  environment    = github_repository_environment.production_emergency.environment\n  branch_pattern = \"hotfix/*\"\n}\n\nresource \"aws_iam_role\" \"deploy\" {\n  name = \"clinic-agent-deploy\"\n  assume_role_policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect    = \"Allow\"\n      Principal = { Federated = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/token.actions.githubusercontent.com\" }\n      Action    = \"sts:AssumeRoleWithWebIdentity\"\n      Condition = {\n        StringEquals = {\n          \"token.actions.githubusercontent.com:aud\" = \"sts.amazonaws.com\"\n          \"token.actions.githubusercontent.com:sub\" = [\n            \"repo:northbay-clinics/clinic-agent:environment:production\",\n            \"repo:northbay-clinics/clinic-agent:environment:production-emergency\",\n          ]\n        }\n      }\n    }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"deploy\" {\n  name = \"clinic-agent-deploy\"\n  role = aws_iam_role.deploy.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [\n      {\n        Effect   = \"Allow\"\n        Action   = [\"ecr:GetAuthorizationToken\"]\n        Resource = \"*\"\n      },\n      {\n        Effect   = \"Allow\"\n        Action   = [\"ecr:BatchCheckLayerAvailability\", \"ecr:PutImage\", \"ecr:InitiateLayerUpload\", \"ecr:UploadLayerPart\", \"ecr:CompleteLayerUpload\", \"ecr:BatchGetImage\"]\n        Resource = aws_ecr_repository.agent.arn\n      },\n      {\n        Effect   = \"Allow\"\n        Action   = [\"eks:DescribeCluster\"]\n        Resource = module.eks.cluster_arn\n      },\n    ]\n  })\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"353f539c-b503-4f8c-a257-49cee1184c29","uuid":"9907752f-ab18-4049-b21f-d6a760cf3c98","timestamp":"2026-10-20T12:43:25.813Z","tool_use_result":{"stdout":"     1\tterraform {\n     2\t  required_version = \">= 1.9.0\"\n     3\t  required_providers {\n     4\t    aws    = { source = \"hashicorp/aws\", version = \"~> 6.14\" }\n     5\t    github = { source = \"integrations/github\", version = \"~> 6.6\" }\n     6\t  }\n     7\t  backend \"s3\" {\n     8\t    bucket         = \"northbay-tfstate-418295730611\"\n     9\t    key            = \"clinic-agent/prod.tfstate\"\n    10\t    region     