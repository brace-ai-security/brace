{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDoRHfGoqp1UqViqh7RS","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01U18Pp7HoUEP5MxUTHPEMzU","name":"Bash","input":{"command":"cd agent; ls -a; cat infra/terraform/*.tf release/manifest.json; cat -n k8s/deployment.yaml config/policy.yaml; grep -rniE \"codeowners|emergency|break.?glass|override|readFile|fetch\\(|http\" --include=* . | grep -v node_modules | head -50"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2210,"cache_read_input_tokens":7021,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2210},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2b5811a-c7d5-498d-8cd2-9630aae88222","uuid":"a2ef8fcb-1389-43a2-812d-9be79b47bdbb","timestamp":"2026-10-20T16:25:47.765Z","request_id":"req_011CgDoRHQdtCC6sXrfQ3grL","wire_tool_inputs":{"toolu_01U18Pp7HoUEP5MxUTHPEMzU":{"command":"cd agent; ls -a; cat infra/terraform/*.tf release/manifest.json; cat -n k8s/deployment.yaml config/policy.yaml; grep -rniE \"codeowners|emergency|break.?glass|override|readFile|fetch\\(|http\" --include=* . | grep -v node_modules | head -50"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U18Pp7HoUEP5MxUTHPEMzU","type":"tool_result","content":".\n..\n.github\nconfig\nDockerfile\ninfra\nk8s\npackage.json\nprompts\nREADME.md\nrelease\nsrc\ntest\ntsconfig.json\n# Who can change production: only the deploy workflow running in the \"production\" or\n# \"production-emergency\" GitHub environment can assume the deploy role, and both environments\n# require a named reviewer from agent-platform-leads. Nobody else has write access to the\n# clinic-agent namespace (see access_entries in main.tf), and the cluster API is private.\n\nprovider \"github\" {\n  owner = \"northbay-clinics\"\n}\n\ndata \"github_team\" \"leads\" {\n  slug = \"agent-platform-leads\"\n}\n\nresource \"github_branch_protection\" \"main\" {\n  repository_id = \"clinic-agent\"\n  pattern       = \"main\"\n\n  enforce_admins                  = true\n  allows_force_pushes             = false\n  allows_deletions                = false\n  required_linear_history         = true\n  require_signed_commits          = true\n  require_conversation_resolution = true\n\n  required_pull_request_reviews {\n    required_approving_review_count = 2\n    require_code_owner_reviews      = true\n    dismiss_stale_reviews           = true\n    require_last_push_approval      = true\n  }\n\n  required_status_checks {\n    strict   = true\n    contexts = [\"ci / test\", \"ci / manifest-check\"]\n  }\n}\n\nresource \"github_repository_environment\" \"production\" {\n  repository  = \"clinic-agent\"\n  environment = \"production\"\n  reviewers {\n    teams = [data.github_team.leads.id]\n  }\n  prevent_self_review = true\n  deployment_branch_policy {\n    protected_branches     = true\n    custom_branch_policies = false\n  }\n}\n\nresource \"github_repository_environment\" \"production_emergency\" {\n  repository  = \"clinic-agent\"\n  environment = \"production-emergency\"\n  reviewers {\n    teams = [data.github_team.leads.id]\n  }\n  prevent_self_review = true\n  deployment_branch_policy {\n    protected_branches     = false\n    custom_branch_policies = true\n  }\n}\n\nresource \"github_repository_environment_deployment_policy\" \"emergency_branches\" {\n  repository     = \"clinic-agent\"\n  environment    = github_repository_environment.production_emergency.environment\n  branch_pattern = \"hotfix/*\"\n}\n\nresource \"aws_iam_role\" \"deploy\" {\n  name = \"clinic-agent-deploy\"\n  assume_role_policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect    = \"Allow\"\n      Principal = { Federated = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/token.actions.githubusercontent.com\" }\n      Action    = \"sts:AssumeRoleWithWebIdentity\"\n      Condition = {\n        StringEquals = {\n          \"token.actions.githubusercontent.com:aud\" = \"sts.amazonaws.com\"\n          \"token.actions.githubusercontent.com:sub\" = [\n            \"repo:northbay-clinics/clinic-agent:environment:production\",\n            \"repo:northbay-clinics/clinic-agent:environment:production-emergency\",\n          ]\n        }\n      }\n    }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"deploy\" {\n  name = \"clinic-agent-deploy\"\n  role = aws_iam_role.deploy.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [\n      {\n        Effect   = \"Allow\"\n        Action   = [\"ecr:GetAuthorizationToken\"]\n        Resource = \"*\"\n      },\n      {\n        Effect   = \"Allow\"\n        Action   = [\"ecr:BatchCheckLayerAvailability\", \"ecr:PutImage\", \"ecr:InitiateLayerUpload\", \"ecr:UploadLayerPart\", \"ecr:CompleteLayerUpload\", \"ecr:BatchGetImage\"]\n        Resource = aws_ecr_repository.agent.arn\n      },\n      {\n        Effect   = \"Allow\"\n        Action   = [\"eks:DescribeCluster\"]\n        Resource = module.eks.cluster_arn\n      },\n    ]\n  })\n}\n# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:\n# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.\nresource \"aws_iam_role\" \"runtime\" {\n  name                 = \"clinic-agent-runtime\"\n  max_session_duration = 3600\n  assume_role_policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect    = \"Allow\"\n      Principal = { Federated = module.eks.oidc_provider_arn }\n      Action    = \"sts:AssumeRoleWithWebIdentity\"\n      Condition = {\n        StringEquals = {\n          \"${module.eks.oidc_provider}:sub\" = [\n            \"system:serviceaccount:clinic-agent:clinic-agent\",\n            \"system:serviceaccount:clinic-agent:clinic-agent-reminders\",\n          ]\n          \"${module.eks.oidc_provider}:aud\" = \"sts.amazonaws.com\"\n        }\n      }\n    }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"runtime\" {\n  name = \"clinic-agent-runtime\"\n  role = aws_iam_role.runtime.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [\n      {\n        Sid      = \"ReadClinicSecrets\"\n        Effect   = \"Allow\"\n        Action   = [\"secretsmanager:GetSecretValue\"]\n        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\n      },\n      {\n        Sid    = \"AgentState\"\n        Effect = \"Allow\"\n        Action = [\n          \"dynamodb:GetItem\",\n          \"dynamodb:BatchGetItem\",\n          \"dynamodb:PutItem\",\n          \"dynamodb:UpdateItem\",\n          \"dynamodb:Query\",\n        ]\n        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*\"\n      },\n      {\n        Sid      = \"Audit\"\n        Effect   = \"Allow\"\n        Action   = [\"firehose:PutRecord\", \"firehose:PutRecordBatch\"]\n        Resource = aws_kinesis_firehose_delivery_stream.audit.arn\n      },\n    ]\n  })\n}\n\n# Operators who may stop the agent. Assumable only through SSO by the on-call group.\nresource \"aws_iam_role\" \"ops_killswitch\" {\n  name = \"clinic-agent-ops\"\n  assume_role_policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect    = \"Allow\"\n      Principal = { AWS = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\" }\n      Action    = \"sts:AssumeRole\"\n      Condition = {\n        StringLike = { \"aws:PrincipalArn\" = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*\" }\n      }\n    }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"ops_killswitch\" {\n  name = \"clinic-agent-ops\"\n  role = aws_iam_role.ops_killswitch.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect   = \"Allow\"\n      Action   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:GetItem\"]\n      Resource = aws_dynamodb_table.control.arn\n    }]\n  })\n}\n\nresource \"aws_iam_role\" \"firehose\" {\n  name = \"clinic-agent-audit-firehose\"\n  assume_role_policy = jsonencode({\n    Version   = \"2012-10-17\"\n    Statement = [{ Effect = \"Allow\", Principal = { Service = \"firehose.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"firehose\" {\n  name = \"write-audit-bucket\"\n  role = aws_iam_role.firehose.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect   = \"Allow\"\n      Action   = [\"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:GetBucketLocation\"]\n      Resource = [aws_s3_bucket.audit.arn, \"${aws_s3_bucket.audit.arn}/*\"]\n    }]\n  })\n}\nterraform {\n  required_version = \">= 1.9.0\"\n  required_providers {\n    aws    = { source = \"hashicorp/aws\", version = \"~> 6.14\" }\n    github = { source = \"integrations/github\", version = \"~> 6.6\" }\n  }\n  backend \"s3\" {\n    bucket         = \"northbay-tfstate-418295730611\"\n    key            = \"clinic-agent/prod.tfstate\"\n    region         = \"us-west-2\"\n    dynamodb_table = \"northbay-tf-locks\"\n    encrypt        = true\n  }\n}\n\nprovider \"aws\" {\n  region = var.region\n  default_tags {\n    tags = { app = \"clinic-agent\", owner = \"agent-platform\", data = \"phi\" }\n  }\n}\n\nvariable \"region\" {\n  type    = string\n  default = \"us-west-2\"\n}\n\nvariable \"clinic_ids\" {\n  type    = list(string)\n  default = [\"nb-castro\", \"nb-fremont\", \"nb-oakland\", \"nb-sanmateo\", \"nb-walnutcreek\"]\n}\n\ndata \"aws_caller_identity\" \"current\" {}\n\nmodule \"eks\" {\n  source  = \"terraform-aws-modules/eks/aws\"\n  version = \"21.3.1\"\n\n  name               = \"clinic-agent-prod\"\n  kubernetes_version = \"1.33\"\n  vpc_id             = module.vpc.vpc_id\n  subnet_ids         = module.vpc.private_subnets\n\n  endpoint_public_access = false\n  enable_irsa            = true\n\n  authentication_mode = \"API\"\n  access_entries = {\n    deploy = {\n      principal_arn = aws_iam_role.deploy.arn\n      policy_associations = {\n        ns = {\n          policy_arn   = \"arn:aws:eks::aws:cluster-access-policy/AmazonEKSEditPolicy\"\n          access_scope = { type = \"namespace\", namespaces = [\"clinic-agent\"] }\n        }\n      }\n    }\n  }\n\n  eks_managed_node_groups = {\n    agents = {\n      instance_types = [\"m7g.large\"]\n      ami_type       = \"BOTTLEROCKET_ARM_64\"\n      min_size       = 2\n      max_size       = 6\n      desired_size   = 3\n      metadata_options = {\n        http_tokens                 = \"required\"\n        http_put_response_hop_limit = 1\n      }\n    }\n  }\n}\n\nmodule \"vpc\" {\n  source  = \"terraform-aws-modules/vpc/aws\"\n  version = \"6.4.0\"\n\n  name            = \"clinic-agent-prod\"\n  cidr            = \"10.42.0.0/16\"\n  azs             = [\"us-west-2a\", \"us-west-2b\", \"us-west-2c\"]\n  private_subnets = [\"10.42.1.0/24\", \"10.42.2.0/24\", \"10.42.3.0/24\"]\n  public_subnets  = [\"10.42.101.0/24\", \"10.42.102.0/24\", \"10.42.103.0/24\"]\n\n  enable_nat_gateway = true\n  single_nat_gateway = false\n}\n\nresource \"aws_ecr_repository\" \"agent\" {\n  name                 = \"clinic-agent\"\n  image_tag_mutability = \"IMMUTABLE\"\n  image_scanning_configuration { scan_on_push = true }\n}\n\n# State tables. Approvals are written by the staff console; budgets by the agent; the control\n# table holds the stop flags operators set.\nresource \"aws_dynamodb_table\" \"approvals\" {\n  name         = \"clinic-agent-approvals\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"id\"\n  attribute {\n    name = \"id\"\n    type = \"S\"\n  }\n  point_in_time_recovery { enabled = true }\n}\n\nresource \"aws_dynamodb_table\" \"budgets\" {\n  name         = \"clinic-agent-budgets\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n  ttl {\n    attribute_name = \"expiresAt\"\n    enabled        = true\n  }\n}\n\nresource \"aws_dynamodb_table\" \"control\" {\n  name         = \"clinic-agent-control\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n  point_in_time_recovery { enabled = true }\n}\n\n# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).\nresource \"aws_s3_bucket\" \"audit\" {\n  bucket              = \"clinic-agent-audit-${data.aws_caller_identity.current.account_id}\"\n  object_lock_enabled = true\n}\n\nresource \"aws_s3_bucket_object_lock_configuration\" \"audit\" {\n  bucket = aws_s3_bucket.audit.id\n  rule {\n    default_retention {\n      mode  = \"COMPLIANCE\"\n      years = 7\n    }\n  }\n}\n\nresource \"aws_kinesis_firehose_delivery_stream\" \"audit\" {\n  name        = \"clinic-agent-audit\"\n  destination = \"extended_s3\"\n  extended_s3_configuration {\n    role_arn            = aws_iam_role.firehose.arn\n    bucket_arn          = aws_s3_bucket.audit.arn\n    prefix              = \"audit/dt=!{timestamp:yyyy-MM-dd}/\"\n    error_output_prefix = \"audit-errors/!{firehose:error-output-type}/\"\n    buffering_interval  = 60\n  }\n}\n\nresource \"aws_secretsmanager_secret\" \"ehr\" {\n  for_each = toset(concat(var.clinic_ids, [\"_catalog\"]))\n  name     = \"clinic-agent/ehr/${each.key}\"\n}\n\nresource \"aws_secretsmanager_secret\" \"payments\" {\n  for_each = toset(var.clinic_ids)\n  name     = \"clinic-agent/payments/${each.key}\"\n}\n\nresource \"aws_secretsmanager_secret\" \"sms\" {\n  for_each = toset(var.clinic_ids)\n  name     = \"clinic-agent/sms/${each.key}\"\n}\n\nresource \"aws_secretsmanager_secret\" \"sms_signing\" {\n  name = \"clinic-agent/sms-signing\"\n}\n{\n  \"release\": \"clinic-agent-3.4.1\",\n  \"agentTypeId\": \"sha256:7c2e91f04ab35d6e8f1029c4b7a6d3e5f8091a2b3c4d5e6f708192a3b4c5d6e7\",\n  \"image\": {\n    \"repository\": \"418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent\",\n    \"digest\": \"sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\"\n  },\n  \"harness\": {\n    \"version\": \"3.4.1\",\n    \"gitSha\": \"e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\"\n  },\n  \"prompts\": [\n    { \"path\": \"prompts/system.md\", \"sha256\": \"5d1e0c9b8a7f6e5d4c3b2a1908f7e6d5c4b3a291807f6e5d4c3b2a19087f6e5d\" },\n    { \"path\": \"prompts/intent-classifier.txt\", \"sha256\": \"a3f9e1d7c5b3a1f9e7d5c3b1a9f7e5d3c1b9a7f5e3d1c9b7a5f3e1d9c7b5a3f1\" }\n  ],\n  \"models\": [\n    {\n      \"role\": \"agent\",\n      \"provider\": \"anthropic\",\n      \"requestedId\": \"claude-sonnet-4-5-20250929\",\n      \"kind\": \"pinned_snapshot\",\n      \"versionDoc\": { \"url\": \"https://docs.anthropic.com/en/docs/about-claude/models/overview\", \"checked\": \"2026-09-15\" },\n      \"adapter\": null,\n      \"providerHidden\": [\"weights\", \"training_data\", \"serving_stack\"]\n    },\n    {\n      \"role\": \"intent_classifier\",\n      \"provider\": \"anthropic\",\n      \"requestedId\": \"claude-haiku-4-5-20251001\",\n      \"kind\": \"pinned_snapshot\",\n      \"versionDoc\": { \"url\": \"https://docs.anthropic.com/en/docs/about-claude/models/overview\", \"checked\": \"2026-09-15\" },\n      \"adapter\": null,\n      \"providerHidden\": [\"weights\", \"training_data\", \"serving_stack\"]\n    }\n  ],\n  \"tools\": {\n    \"allowlist\": \"config/tools.allowlist.yaml\",\n    \"mcpServers\": [\n      {\n        \"id\": \"ehr\",\n        \"url\": \"https://ehr-mcp.internal.northbay-clinics.example/mcp\",\n        \"tlsCertSha256\": \"1f6a9c3e5b7d9f1a3c5e7b9d1f3a5c7e9b1d3f5a7c9e1b3d5f7a9c1e3b5d7f9a\",\n        \"owner\": \"ehr-integrations@northbay-clinics.example\"\n      }\n    ],\n    \"native\": [\"payments\", \"sms\", \"insurance\"]\n  },\n  \"peers\": [\n    {\n      \"id\": \"eligibility-agent\",\n      \"url\": \"https://eligibility.partners.northbay-clinics.example/a2a\",\n      \"owner\": \"revenue-cycle@northbay-clinics.example\"\n    }\n  ],\n  \"permissions\": {\n    \"awsRole\": \"arn:aws:iam::418295730611:role/clinic-agent-runtime\",\n    \"ehrScopes\": [\"patient.read\", \"appointment.read\", \"appointment.write\"],\n    \"paymentsScopes\": [\"deposits.refund\"],\n    \"eligibilityScopes\": [\"eligibility:read\"]\n  },\n  \"memory\": \"none\",\n  \"retrieval\": \"none\",\n  \"network\": { \"policy\": \"k8s/deployment.yaml#clinic-agent-egress\", \"egressProxy\": \"egress-proxy.platform.svc:3128\" },\n  \"budgets\": \"config/budgets.yaml\",\n  \"policies\": { \"action\": \"config/policy.yaml\", \"actionPolicyVersion\": \"2026-09-18.3\" }\n}\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: clinic-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.33\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: clinic-agent\n    15\t  namespace: clinic-agent\n    16\t  annotations:\n    17\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    18\t    eks.amazonaws.com/token-expiration: \"3600\"\n    19\tautomountServiceAccountToken: false\n    20\t---\n    21\tapiVersion: v1\n    22\tkind: ServiceAccount\n    23\tmetadata:\n    24\t  name: clinic-agent-reminders\n    25\t  namespace: clinic-agent\n    26\t  annotations:\n    27\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    28\tautomountServiceAccountToken: false\n    29\t---\n    30\tapiVersion: v1\n    31\tkind: ConfigMap\n    32\tmetadata:\n    33\t  name: clinic-agent\n    34\t  namespace: clinic-agent\n    35\tdata:\n    36\t  CLINIC_DIRECTORY: |\n    37\t    [{\"id\":\"nb-castro\",\"name\":\"Northbay Castro\",\"smsNumber\":\"+14155550110\"},\n    38\t     {\"id\":\"nb-fremont\",\"name\":\"Northbay Fremont\",\"smsNumber\":\"+15105550111\"},\n    39\t     {\"id\":\"nb-oakland\",\"name\":\"Northbay Oakland\",\"smsNumber\":\"+15105550112\"},\n    40\t     {\"id\":\"nb-sanmateo\",\"name\":\"Northbay San Mateo\",\"smsNumber\":\"+16505550113\"},\n    41\t     {\"id\":\"nb-walnutcreek\",\"name\":\"Northbay Walnut Creek\",\"smsNumber\":\"+19255550114\"}]\n    42\t  SMS_SIGNING_SECRET_ARN: arn:aws:secretsmanager:us-west-2:418295730611:secret:clinic-agent/sms-signing\n    43\t  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n    44\t  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n    45\t---\n    46\tapiVersion: apps/v1\n    47\tkind: Deployment\n    48\tmetadata:\n    49\t  name: clinic-agent\n    50\t  namespace: clinic-agent\n    51\t  labels: { app: clinic-agent }\n    52\tspec:\n    53\t  replicas: 3\n    54\t  selector:\n    55\t    matchLabels: { app: clinic-agent }\n    56\t  template:\n    57\t    metadata:\n    58\t      labels: { app: clinic-agent }\n    59\t    spec:\n    60\t      serviceAccountName: clinic-agent\n    61\t      automountServiceAccountToken: false\n    62\t      hostUsers: false\n    63\t      hostNetwork: false\n    64\t      hostPID: false\n    65\t      hostIPC: false\n    66\t      enableServiceLinks: false\n    67\t      securityContext:\n    68\t        runAsNonRoot: true\n    69\t        runAsUser: 65532\n    70\t        runAsGroup: 65532\n    71\t        fsGroup: 65532\n    72\t        seccompProfile:\n    73\t          type: RuntimeDefault\n    74\t      containers:\n    75\t        - name: agent\n    76\t          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    77\t          ports:\n    78\t            - containerPort: 8080\n    79\t          envFrom:\n    80\t            - configMapRef: { name: clinic-agent }\n    81\t          env:\n    82\t            - name: IMAGE_DIGEST\n    83\t              value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    84\t            - name: GIT_SHA\n    85\t              value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n    86\t          securityContext:\n    87\t            allowPrivilegeEscalation: false\n    88\t            privileged: false\n    89\t            readOnlyRootFilesystem: true\n    90\t            runAsNonRoot: true\n    91\t            capabilities:\n    92\t              drop: [\"ALL\"]\n    93\t            seccompProfile:\n    94\t              type: RuntimeDefault\n    95\t          resources:\n    96\t            requests: { cpu: 250m, memory: 384Mi }\n    97\t            limits: { cpu: \"1\", memory: 768Mi }\n    98\t          readinessProbe:\n    99\t            httpGet: { path: /healthz, port: 8080 }\n   100\t          volumeMounts:\n   101\t            - { name: tmp, mountPath: /tmp }\n   102\t            - { name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true }\n   103\t      volumes:\n   104\t        - name: tmp\n   105\t          emptyDir: { medium: Memory, sizeLimit: 32Mi }\n   106\t        - name: sts-token\n   107\t          projected:\n   108\t            sources:\n   109\t              - serviceAccountToken:\n   110\t                  audience: https://sts.northbay-clinics.example\n   111\t                  expirationSeconds: 900\n   112\t                  path: sts-token\n   113\t---\n   114\tapiVersion: batch/v1\n   115\tkind: CronJob\n   116\tmetadata:\n   117\t  name: clinic-agent-reminders\n   118\t  namespace: clinic-agent\n   119\tspec:\n   120\t  schedule: \"0 17 * * *\"\n   121\t  timeZone: America/Los_Angeles\n   122\t  concurrencyPolicy: Forbid\n   123\t  jobTemplate:\n   124\t    spec:\n   125\t      backoffLimit: 0\n   126\t      activeDeadlineSeconds: 1800\n   127\t      template:\n   128\t        metadata:\n   129\t          labels: { app: clinic-agent-reminders }\n   130\t        spec:\n   131\t          serviceAccountName: clinic-agent-reminders\n   132\t          automountServiceAccountToken: false\n   133\t          restartPolicy: Never\n   134\t          hostUsers: false\n   135\t          securityContext:\n   136\t            runAsNonRoot: true\n   137\t            runAsUser: 65532\n   138\t            runAsGroup: 65532\n   139\t            seccompProfile:\n   140\t              type: RuntimeDefault\n   141\t          containers:\n   142\t            - name: reminders\n   143\t              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   144\t              args: [\"dist/workers/reminders.js\"]\n   145\t              envFrom:\n   146\t                - configMapRef: { name: clinic-agent }\n   147\t              env:\n   148\t                - name: IMAGE_DIGEST\n   149\t                  value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   150\t                - name: GIT_SHA\n   151\t                  value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n   152\t              securityContext:\n   153\t                allowPrivilegeEscalation: false\n   154\t                privileged: false\n   155\t                readOnlyRootFilesystem: true\n   156\t                capabilities:\n   157\t                  drop: [\"ALL\"]\n   158\t---\n   159\t# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n   160\t# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,\n   161\t# the group STS and auth service, and AWS service endpoints.\n   162\tapiVersion: networking.k8s.io/v1\n   163\tkind: NetworkPolicy\n   164\tmetadata:\n   165\t  name: clinic-agent-egress\n   166\t  namespace: clinic-agent\n   167\tspec:\n   168\t  podSelector: {}\n   169\t  policyTypes: [\"Egress\", \"Ingress\"]\n   170\t  ingress:\n   171\t    - from:\n   172\t        - namespaceSelector:\n   173\t            matchLabels: { kubernetes.io/metadata.name: ingress }\n   174\t      ports:\n   175\t        - { port: 8080, protocol: TCP }\n   176\t  egress:\n   177\t    - to:\n   178\t        - namespaceSelector:\n   179\t            matchLabels: { kubernetes.io/metadata.name: kube-system }\n   180\t          podSelector:\n   181\t            matchLabels: { k8s-app: kube-dns }\n   182\t      ports:\n   183\t        - { port: 53, protocol: UDP }\n   184\t        - { port: 53, protocol: TCP }\n   185\t    - to:\n   186\t        - namespaceSelector:\n   187\t            matchLabels: { kubernetes.io/metadata.name: platform }\n   188\t          podSelector:\n   189\t            matchLabels: { app: egress-proxy }\n   190\t      ports:\n   191\t        - { port: 3128, protocol: TCP }\n   192\t    - to:\n   193\t        - ipBlock: { cidr: 10.60.12.0/28 }\n   194\t      ports:\n   195\t        - { port: 443, protocol: TCP }\n     1\t# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\n     2\tpolicyVersion: \"2026-09-18.3\"\n     3\t\n     4\t# Tools that never run without a staff approval bound to the request.\n     5\thighImpactTools:\n     6\t  - ehr__cancel_appointment\n     7\t  - payments__refund_deposit\n     8\t  - sms__send_freeform\n     9\t\n    10\tapproval:\n    11\t  ttlSeconds: 900\n    12\t  approverRoles:\n    13\t    - front_desk_lead\n    14\t    - clinic_manager\n    15\t  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n    16\t  table: clinic-agent-approvals\n(eval):1: no matches found: --include=*","is_error":false}]},"parent_tool_use_id":null,"session_id":"d2b5811a-c7d5-498d-8cd2-9630aae88222","uuid":"ece34138-3eca-47a7-9d7f-d4b1c76534f2","timestamp":"2026-10-20T16:25:47.812Z","tool_use_result":{"stdout":".\n..\n.github\nconfig\nDockerfile\ninfra\nk8s\npackage.json\nprompts\nREADME.md\nrelease\nsrc\ntest\ntsconfig.json\n# Who can change production: only the deploy workflow running in the \"production\" or\n# \"production-emergency\" GitHub environment can assume the deploy role, and both environments\n# require a named reviewer from agent-platform-leads. Nobody else has write access to the\n# clinic-agent namespace (see access_entries in main.tf), and the cluster API is private.\n\nprovider \"github\" {\n  owner = \"northbay-clinics\"\n}\n\ndata \"github_team\" \"leads\" {\n  slug = \"agent-platform-leads\"\n}\n\nresource \"github_branch_protection\" \"main\" {\n  repository_id = \"clinic-agent\"\n  pattern       = \"main\"\n\n  enforce_admins                  = true\n  allows_force_pushes             = false\n  allows_deletions                = false\n  required_linear_history         = true\n  require_signed_commits          = true\n  require_conversation_resolution = true\n\n  required_pull_request_reviews {\n    required_approving_review_count = 2\n    require_code_owner_reviews      = true\n    dismiss_stale_reviews           = true\n    require_last_push_approval      = true\n  }\n\n  required_status_checks {\n    strict   = true\n    contexts = [\"ci / test\", \"ci / manifest-check\"]\n  }\n}\n\nresource \"github_repository_environment\" \"production\" {\n  repository  = \"clinic-agent\"\n  environment = \"production\"\n  reviewers {\n    teams = [data.github_team.leads.id]\n  }\n  prevent_self_review = true\n  deployment_branch_policy {\n    protected_branches     = true\n    custom_branch_policies = false\n  }\n}\n\nresource \"github_repository_environment\" \"production_emergency\" {\n  repository  = \"clinic-agent\"\n  environment = \"production-emergency\"\n  reviewers {\n    teams = [data.github_team.leads.id]\n  }\n  prevent_self_review = true\n  deployment_branch_policy {\n    protected_branches     = false\n    custom_branch_policies = true\n  }\n}\n\nresource \"github_repository_environment_deployment_policy\" \"emergency_branches\" {\n  repository     = \"clinic-agent\"\n  environment    = github_repository_environment.production_emergency.environment\n  branch_pattern = \"hotfix/*\"\n}\n\nresource \"aws_iam_role\" \"deploy\" {\n  name = \"clinic-agent-deploy\"\n  assume_role_policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect    = \"Allow\"\n      Principal = { Federated = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/token.actions.githubusercontent.com\" }\n      Action    = \"sts:AssumeRoleWithWebIdentity\"\n      Condition = {\n        StringEquals = {\n          \"token.actions.githubusercontent.com:aud\" = \"sts.amazonaws.com\"\n          \"token.actions.githubusercontent.com:sub\" = [\n            \"repo:northbay-clinics/clinic-agent:environment:production\",\n            \"repo:northbay-clinics/clinic-agent:environment:production-emergency\",\n          ]\n        }\n      }\n    }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"deploy\" {\n  name = \"clinic-agent-deploy\"\n  role = aws_iam_role.deploy.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [\n      {\n        Effect   = \"Allow\"\n        Action   = [\"ecr:GetAuthorizationToken\"]\n        Resource = \"*\"\n      },\n      {\n        Effect   = \"Allow\"\n        Action   = [\"ecr:BatchCheckLayerAvailability\", \"ecr:PutImage\", \"ecr:InitiateLayerUpload\", \"ecr:UploadLayerPart\", \"ecr:CompleteLayerUpload\", \"ecr:BatchGetImage\"]\n        Resource = aws_ecr_repository.agent.arn\n      },\n      {\n        Effect   = \"Allow\"\n        Action   = [\"eks:DescribeCluster\"]\n        Resource = module.eks.cluster_arn\n      },\n    ]\n  })\n}\n# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:\n# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.\nresource \"aws_iam_role\" \"runtime\" {\n  name                 = \"clinic-agent-runtime\"\n  max_session_duration = 3600\n  assume_role_policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect    = \"Allow\"\n      Principal = { Federated = module.eks.oidc_provider_arn }\n      Action    = \"sts:AssumeRoleWithWebIdentity\"\n      Condition = {\n        StringEquals = {\n          \"${module.eks.oidc_provider}:sub\" = [\n            \"system:serviceaccount:clinic-agent:clinic-agent\",\n            \"system:serviceaccount:clinic-agent:clinic-agent-reminders\",\n          ]\n          \"${module.eks.oidc_provider}:aud\" = \"sts.amazonaws.com\"\n        }\n      }\n    }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"runtime\" {\n  name = \"clinic-agent-runtime\"\n  role = aws_iam_role.runtime.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [\n      {\n        Sid      = \"ReadClinicSecrets\"\n        Effect   = \"Allow\"\n        Action   = [\"secretsmanager:GetSecretValue\"]\n        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\n      },\n      {\n        Sid    = \"AgentState\"\n        Effect = \"Allow\"\n        Action = [\n          \"dynamodb:GetItem\",\n          \"dynamodb:BatchGetItem\",\n          \"dynamodb:PutItem\",\n          \"dynamodb:UpdateItem\",\n          \"dynamodb:Query\",\n        ]\n        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*\"\n      },\n      {\n        Sid      = \"Audit\"\n        Effect   = \"Allow\"\n        Action   = [\"firehose:PutRecord\", \"firehose:PutRecordBatch\"]\n        Resource = aws_kinesis_firehose_delivery_stream.audit.arn\n      },\n    ]\n  })\n}\n\n# Operators who may stop the agent. Assumable only through SSO by the on-call group.\nresource \"aws_iam_role\" \"ops_killswitch\" {\n  name = \"clinic-agent-ops\"\n  assume_role_policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect    = \"Allow\"\n      Principal = { AWS = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\" }\n      Action    = \"sts:AssumeRole\"\n      Condition = {\n        StringLike = { \"aws:PrincipalArn\" = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*\" }\n      }\n    }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"ops_killswitch\" {\n  name = \"clinic-agent-ops\"\n  role = aws_iam_role.ops_killswitch.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect   = \"Allow\"\n      Action   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:GetItem\"]\n      Resource = aws_dynamodb_table.control.arn\n    }]\n  })\n}\n\nresource \"aws_iam_role\" \"firehose\" {\n  name = \"clinic-agent-audit-firehose\"\n  assume_role_policy = jsonencode({\n    Version   = \"2012-10-17\"\n    Statement = [{ Effect = \"Allow\", Principal = { Service = \"firehose.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"firehose\" {\n  name = \"write-audit-bucket\"\n  role = aws_iam_role.firehose.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect   = \"Allow\"\n      Action   = [\"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:GetBucketLocation\"]\n      Resource = [aws_s3_bucket.audit.arn, \"${aws_s3_bucket.audit.arn}/*\"]\n    }]\n  })\n}\nterraform {\n  required_version = \">= 1.9.0\"\n  required_providers {\n    aws    = { source = \"hashicorp/aws\", version = \"~> 6.14\" }\n    github = { source = \"integrations/github\", version = \"~> 6.6\" }\n  }\n  backend \"s3\" {\n    bucket         = \"northbay-tfstate-418295730611\"\n    key            = \"clinic-agent/prod.tfstate\"\n    region         = \"us-west-2\"\n    dynamodb_table = \"northbay-tf-locks\"\n    encrypt        = true\n  }\n}\n\nprovider \"aws\" {\n  region = var.region\n  default_tags {\n    tags = { app = \"clinic-agent\", owner = \"agent-platform\", data = \"phi\" }\n  }\n}\n\nvariable \"region\" {\n  type    = string\n  default = \"us-west-2\"\n}\n\nvariable \"clinic_ids\" {\n  type    = list(string)\n  default = [\"nb-castro\", \"nb-fremont\", \"nb-oakland\", \"nb-sanmateo\", \"nb-walnutcreek\"]\n}\n\ndata \"aws_caller_identity\" \"current\" {}\n\nmodule \"eks\" {\n  source  = \"terraform-aws-modules/eks/aws\"\n  version = \"21.3.1\"\n\n  name               = \"clinic-agent-prod\"\n  kubernetes_version = \"1.33\"\n  vpc_id             = module.vpc.vpc_id\n  subnet_ids         = module.vpc.private_subnets\n\n  endpoint_public_access = false\n  enable_irsa            = true\n\n  authentication_mode = \"API\"\n  access_entries = {\n    deploy = {\n      principal_arn = aws_iam_role.deploy.arn\n      policy_associations = {\n        ns = {\n          policy_arn   = \"arn:aws:eks::aws:cluster-access-policy/AmazonEKSEditPolicy\"\n          access_scope = { type = \"namespace\", namespaces = [\"clinic-agent\"] }\n        }\n      }\n    }\n  }\n\n  eks_managed_node_groups = {\n    agents = {\n      instance_types = [\"m7g.large\"]\n      ami_type       = \"BOTTLEROCKET_ARM_64\"\n      min_size       = 2\n      max_size       = 6\n      desired_size   = 3\n      metadata_options = {\n        http_tokens                 = \"required\"\n        http_put_response_hop_limit = 1\n      }\n    }\n  }\n}\n\nmodule \"vpc\" {\n  source  = \"terraform-aws-modules/vpc/aws\"\n  version = \"6.4.0\"\n\n  name            = \"clinic-agent-prod\"\n  cidr            = \"10.42.0.0/16\"\n  azs             = [\"us-west-2a\", \"us-west-2b\", \"us-west-2c\"]\n  private_subnets = [\"10.42.1.0/24\", \"10.42.2.0/24\", \"10.42.3.0/24\"]\n  public_subnets  = [\"10.42.101.0/24\", \"10.42.102.0/24\", \"10.42.103.0/24\"]\n\n  enable_nat_gateway = true\n  single_nat_gateway = false\n}\n\nresource \"aws_ecr_repository\" \"agent\" {\n  name                 = \"clinic-agent\"\n  image_tag_mutability = \"IMMUTABLE\"\n  image_scanning_configuration { scan_on_push = true }\n}\n\n# State tables. Approvals are written by the staff console; budgets by the agent; the control\n# table holds the stop flags operators set.\nresource \"aws_dynamodb_table\" \"approvals\" {\n  name         = \"clinic-agent-approvals\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"id\"\n  attribute {\n    name = \"id\"\n    type = \"S\"\n  }\n  point_in_time_recovery { enabled = true }\n}\n\nresource \"aws_dynamodb_table\" \"budgets\" {\n  name         = \"clinic-agent-budgets\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n  ttl {\n    attribute_name = \"expiresAt\"\n    enabled        = true\n  }\n}\n\nresource \"aws_dynamodb_table\" \"control\" {\n  name         = \"clinic-agent-control\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n  point_in_time_recovery { enabled = true }\n}\n\n# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).\nresource \"aws_s3_bucket\" \"audit\" {\n  bucket              = \"clinic-agent-audit-${data.aws_caller_identity.current.account_id}\"\n  object_lock_enabled = true\n}\n\nresource \"aws_s3_bucket_object_lock_configuration\" \"audit\" {\n  bucket = aws_s3_bucket.audit.id\n  rule {\n    default_retention {\n      mode  = \"COMPLIANCE\"\n      years = 7\n    }\n  }\n}\n\nresource \"aws_kinesis_firehose_delivery_stream\" \"audit\" {\n  name        = \"clinic-agent-audit\"\n  destination = \"extended_s3\"\n  extended_s3_configuration {\n    role_arn            = aws_iam_role.firehose.arn\n    bucket_arn          = aws_s3_bucket.audit.arn\n    prefix              = \"audit/dt=!{timestamp:yyyy-MM-dd}/\"\n    error_output_prefix = \"audit-errors/!{firehose:error-output-type}/\"\n    buffering_interval  = 60\n  }\n}\n\nresource \"aws_secretsmanager_secret\" \"ehr\" {\n  for_each = toset(concat(var.clinic_ids, [\"_catalog\"]))\n  name     = \"clinic-agent/ehr/${each.key}\"\n}\n\nresource \"aws_secretsmanager_secret\" \"payments\" {\n  for_each = toset(var.clinic_ids)\n  name     = \"clinic-agent/payments/${each.key}\"\n}\n\nresource \"aws_secretsmanager_secret\" \"sms\" {\n  for_each = toset(var.clinic_ids)\n  name     = \"clinic-agent/sms/${each.key}\"\n}\n\nresource \"aws_secretsmanager_secret\" \"sms_signing\" {\n  name = \"clinic-agent/sms-signing\"\n}\n{\n  \"release\": \"clinic-agent-3.4.1\",\n  \"agentTypeId\": \"sha256:7c2e91f04ab35d6e8f1029c4b7a6d3e5f8091a2b3c4d5e6f708192a3b4c5d6e7\",\n  \"image\": {\n    \"repository\": \"418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent\",\n    \"digest\": \"sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\"\n  },\n  \"harness\": {\n    \"version\": \"3.4.1\",\n    \"gitSha\": \"e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\"\n  },\n  \"prompts\": [\n    { \"path\": \"prompts/system.md\", \"sha256\": \"5d1e0c9b8a7f6e5d4c3b2a1908f7e6d5c4b3a291807f6e5d4c3b2a19087f6e5d\" },\n    { \"path\": \"prompts/intent-classifier.txt\", \"sha256\": \"a3f9e1d7c5b3a1f9e7d5c3b1a9f7e5d3c1b9a7f5e3d1c9b7a5f3e1d9c7b5a3f1\" }\n  ],\n  \"models\": [\n    {\n      \"role\": \"agent\",\n      \"provider\": \"anthropic\",\n      \"requestedId\": \"claude-sonnet-4-5-20250929\",\n      \"kind\": \"pinned_snapshot\",\n      \"versionDoc\": { \"url\": \"https://docs.anthropic.com/en/docs/about-claude/models/overview\", \"checked\": \"2026-09-15\" },\n      \"adapter\": null,\n      \"providerHidden\": [\"weights\", \"training_data\", \"serving_stack\"]\n    },\n    {\n      \"role\": \"intent_classifier\",\n      \"provider\": \"anthropic\",\n      \"requestedId\": \"claude-haiku-4-5-20251001\",\n      \"kind\": \"pinned_snapshot\",\n      \"versionDoc\": { \"url\": \"https://docs.anthropic.com/en/docs/about-claude/models/overview\", \"checked\": \"2026-09-15\" },\n      \"adapter\": null,\n      \"providerHidden\": [\"weights\", \"training_data\", \"serving_stack\"]\n    }\n  ],\n  \"tools\": {\n    \"allowlist\": \"config/tools.allowlist.yaml\",\n    \"mcpServers\": [\n      {\n        \"id\": \"ehr\",\n        \"url\": \"https://ehr-mcp.internal.northbay-clinics.example/mcp\",\n        \"tlsCertSha256\": \"1f6a9c3e5b7d9f1a3c5e7b9d1f3a5c7e9b1d3f5a7c9e1b3d5f7a9c1e3b5d7f9a\",\n        \"owner\": \"ehr-integrations@northbay-clinics.example\"\n      }\n    ],\n    \"native\": [\"payments\", \"sms\", \"insurance\"]\n  },\n  \"peers\": [\n    {\n      \"id\": \"eligibility-agent\",\n      \"url\": \"https://eligibility.partners.northbay-clinics.example/a2a\",\n      \"owner\": \"revenue-cycle@northbay-clinics.example\"\n    }\n  ],\n  \"permissions\": {\n    \"awsRole\": \"arn:aws:iam::418295730611:role/clinic-agent-runtime\",\n    \"ehrScopes\": [\"patient.read\", \"appointment.read\", \"appointment.write\"],\n    \"paymentsScopes\": [\"deposits.refund\"],\n    \"eligibilityScopes\": [\"eligibility:read\"]\n  },\n  \"memory\": \"none\",\n  \"retrieval\": \"none\",\n  \"network\": { \"policy\": \"k8s/deployment.yaml#clinic-agent-egress\", \"egressProxy\": \"egress-proxy.platform.svc:3128\" },\n  \"budgets\": \"config/budgets.yaml\",\n  \"policies\": { \"action\": \"config/policy.yaml\", \"actionPolicyVersion\": \"2026-09-18.3\" }\n}\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: clinic-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.33\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: clinic-agent\n    15\t  namespace: clinic-agent\n    16\t  annotations:\n    17\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    18\t    eks.amazonaws.com/token-expiration: \"3600\"\n    19\tautomountServiceAccountToken: false\n    20\t---\n    21\tapiVersion: v1\n    22\tkind: ServiceAccount\n    23\tmetadata:\n    24\t  name: clinic-agent-reminders\n    25\t  namespace: clinic-agent\n    26\t  annotations:\n    27\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    28\tautomountServiceAccountToken: false\n    29\t---\n    30\tapiVersion: v1\n    31\tkind: ConfigMap\n    32\tmetadata:\n    33\t  name: clinic-agent\n    34\t  namespace: clinic-agent\n    35\tdata:\n    36\t  CLINIC_DIRECTORY: |\n    37\t    [{\"id\":\"nb-castro\",\"name\":\"Northbay Castro\",\"smsNumber\":\"+14155550110\"},\n    38\t     {\"id\":\"nb-fremont\",\"name\":\"Northbay Fremont\",\"smsNumber\":\"+15105550111\"},\n    39\t     {\"id\":\"nb-oakland\",\"name\":\"Northbay Oakland\",\"smsNumber\":\"+15105550112\"},\n    40\t     {\"id\":\"nb-sanmateo\",\"name\":\"Northbay San Mateo\",\"smsNumber\":\"+16505550113\"},\n    41\t     {\"id\":\"nb-walnutcreek\",\"name\":\"Northbay Walnut Creek\",\"smsNumber\":\"+19255550114\"}]\n    42\t  SMS_SIGNING_SECRET_ARN: arn:aws:secretsmanager:us-west-2:418295730611:secret:clinic-agent/sms-signing\n    43\t  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n    44\t  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n    45\t---\n    46\tapiVersion: apps/v1\n    47\tkind: Deployment\n    48\tmetadata:\n    49\t  name: clinic-agent\n    50\t  namespace: clinic-agent\n    51\t  labels: { app: clinic-agent }\n    52\tspec:\n    53\t  replicas: 3\n    54\t  selector:\n    55\t    matchLabels: { app: clinic-agent }\n    56\t  template:\n    57\t    metadata:\n    58\t      labels: { app: clinic-agent }\n    59\t    spec:\n    60\t      serviceAccountName: clinic-agent\n    61\t      automountServiceAccountToken: false\n    62\t      hostUsers: false\n    63\t      hostNetwork: false\n    64\t      hostPID: false\n    65\t      hostIPC: false\n    66\t      enableServiceLinks: false\n    67\t      securityContext:\n    68\t        runAsNonRoot: true\n    69\t        runAsUser: 65532\n    70\t        runAsGroup: 65532\n    71\t        fsGroup: 65532\n    72\t        seccompProfile:\n    73\t          type: RuntimeDefault\n    74\t      containers:\n    75\t        - name: agent\n    76\t          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    77\t          ports:\n    78\t            - containerPort: 8080\n    79\t          envFrom:\n    80\t            - configMapRef: { name: clinic-agent }\n    81\t          env:\n    82\t            - name: IMAGE_DIGEST\n    83\t              value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    84\t            - name: GIT_SHA\n    85\t              value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n    86\t          securityContext:\n    87\t            allowPrivilegeEscalation: false\n    88\t            privileged: false\n    89\t            readOnlyRootFilesystem: true\n    90\t            runAsNonRoot: true\n    91\t            capabilities:\n    92\t              drop: [\"ALL\"]\n    93\t            seccompProfile:\n    94\t              type: RuntimeDefault\n    95\t          resources:\n    96\t            requests: { cpu: 250m, memory: 384Mi }\n    97\t            limits: { cpu: \"1\", memory: 768Mi }\n    98\t          readinessProbe:\n    99\t            httpGet: { path: /healthz, port: 8080 }\n   100\t          volumeMounts:\n   101\t            - { name: tmp, mountPath: /tmp }\n   102\t            - { name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true }\n   103\t      volumes:\n   104\t        - name: tmp\n   105\t          emptyDir: { medium: Memory, sizeLimit: 32Mi }\n   106\t        - name: sts-token\n   107\t          projected:\n   108\t            sources:\n   109\t              - serviceAccountToken:\n   110\t                  audience: https://sts.northbay-clinics.example\n   111\t                  expirationSeconds: 900\n   112\t                  path: sts-token\n   113\t---\n   114\tapiVersion: batch/v1\n   115\tkind: CronJob\n   116\tmetadata:\n   117\t  name: clinic-agent-reminders\n   118\t  namespace: clinic-agent\n   119\tspec:\n   120\t  schedule: \"0 17 * * *\"\n   121\t  timeZone: America/Los_Angeles\n   122\t  concurrencyPolicy: Forbid\n   123\t  jobTemplate:\n   124\t    spec:\n   125\t      backoffLimit: 0\n   126\t      activeDeadlineSeconds: 1800\n   127\t      template:\n   128\t        metadata:\n   129\t          labels: { app: clinic-agent-reminders }\n   130\t        spec:\n   131\t          serviceAccountName: clinic-agent-reminders\n   132\t          automountServiceAccountToken: false\n   133\t          restartPolicy: Never\n   134\t          hostUsers: false\n   135\t          securityContext:\n   136\t            runAsNonRoot: true\n   137\t            runAsUser: 65532\n   138\t            runAsGroup: 65532\n   139\t            seccompProfile:\n   140\t              type: RuntimeDefault\n   141\t          containers:\n   142\t            - name: reminders\n   143\t              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   144\t              args: [\"dist/workers/reminders.js\"]\n   145\t              envFrom:\n   146\t                - configMapRef: { name: clinic-agent }\n   147\t              env:\n   148\t                - name: IMAGE_DIGEST\n   149\t                  value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   150\t                - name: GIT_SHA\n   151\t                  value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n   152\t              securityContext:\n   153\t                allowPrivilegeEscalation: false\n   154\t                privileged: false\n   155\t                readOnlyRootFilesystem: true\n   156\t                capabilities:\n   157\t                  drop: [\"ALL\"]\n   158\t---\n   159\t# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n   160\t# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,\n   161\t# the group STS and auth service, and AWS service endpoints.\n   162\tapiVersion: networking.k8s.io/v1\n   163\tkind: NetworkPolicy\n   164\tmetadata:\n   165\t  name: clinic-agent-egress\n   166\t  namespace: clinic-agent\n   167\tspec:\n   168\t  podSelector: {}\n   169\t  policyTypes: [\"Egress\", \"Ingress\"]\n   170\t  ingress:\n   171\t    - from:\n   172\t        - namespaceSelector:\n   173\t            matchLabels: { kubernetes.io/metadata.name: ingress }\n   174\t      ports:\n   175\t        - { port: 8080, protocol: TCP }\n   176\t  egress:\n   177\t    - to:\n   178\t        - namespaceSelector:\n   179\t            matchLabels: { kubernetes.io/metadata.name: kube-system }\n   180\t          podSelector:\n   181\t            matchLabels: { k8s-app: kube-dns }\n   182\t      ports:\n   183\t        - { port: 53, protocol: UDP }\n   184\t        - { port: 53, protocol: TCP }\n   185\t    - to:\n   186\t        - namespaceSelector:\n   187\t            matchLabels: { kubernetes.io/metadata.name: platform }\n   188\t          podSelector:\n   189\t            matchLabels: { app: egress-proxy }\n   190\t      ports:\n   191\t        - { port: 3128, protocol: TCP }\n   192\t    - to:\n   193\t        - ipBlock: { cidr: 10.60.12.0/28 }\n   194\t      ports:\n   195\t        - { port: 443, protocol: TCP }\n     1\t# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\n     2\tpolicyVersion: \"2026-09-18.3\"\n     3\t\n     4\t# Tools that never run without a staff approval bound to the request.\n     5\thighImpactTools:\n     6\t  - ehr__cancel_appointment\n     7\t  - payments__refund_deposit\n     8\t  - sms__send_freeform\n     9\t\n    10\tapproval:\n    11\t  ttlSeconds: 900\n    12\t  approverRoles:\n    13\t    - front_desk_lead\n    14\t    - clinic_manager\n    15\t  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n    16\t  table: clinic-agent-approvals\n(eval):1: no matches found: --include=*","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01U18Pp7HoUEP5MxUTHPEMzU","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
