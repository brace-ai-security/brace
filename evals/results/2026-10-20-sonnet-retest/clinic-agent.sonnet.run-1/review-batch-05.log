{"type":"system","subtype":"init","cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-5bhm2c6_","session_id":"b885df4c-cfaf-404d-9f29-140acda878af","tools":["Bash","Edit","Glob","Grep","Read","Write"],"mcp_servers":[],"model":"claude-sonnet-5-5","permissionMode":"bypassPermissions","slash_commands":["deep-research","design","design-sync","dataviz","update-config","verify","debug","code-review","simplify","batch","fewer-permission-prompts","doctor","loop","schedule","claude-api","workflow-authoring","run","run-skill-generator","plugin-authoring","advisor","agents","auto-mode-setup","autocompact","clear","color","compact","config","output-style","context","effort","fast","focus","heapdump","init","mcp","import","model","__remote-workflow","workflow-launch-exec","reload-plugins","reload-skills","rename","ultrareview","security-review","usage-credits","extra-usage","usage","insights","recap","skill-doctor","goal","design-consent","design-revoke","list-agents","team-onboarding"],"terminal_slash_commands":["doctor","color","focus","reload-plugins"],"apiKeySource":"none","claude_code_version":"2.1.304","output_style":"default","agents":["claude","Explore","general-purpose","Plan"],"skills":["deep-research","design","design-sync","dataviz","update-config","verify","debug","code-review","simplify","batch","fewer-permission-prompts","doctor","loop","schedule","claude-api","workflow-authoring","run","run-skill-generator","plugin-authoring"],"plugins":[{"name":"codacy-skills","path":"/Users/brenn/.claude/plugins/cache/codacy/codacy-skills/1.3.0","source":"codacy-skills@codacy","version":"1.3.0"},{"name":"portal","path":"/Users/brenn/.claude/plugins/cache/portal/portal/0.1.0","source":"portal@portal","version":"0.1.0"},{"name":"warp","path":"/Users/brenn/.claude/plugins/cache/claude-code-warp/warp/2.1.0","source":"warp@claude-code-warp","version":"2.1.0"},{"name":"mattpocock-skills","path":"/Users/brenn/.claude/plugins/cache/claude-plugins-official/mattpo