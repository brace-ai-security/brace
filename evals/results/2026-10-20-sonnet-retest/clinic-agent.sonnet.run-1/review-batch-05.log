{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XPmyjQM8djR1WWb4nSQ7mT","type":"tool_result","content":"     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, UpdateCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport type { Budgets } from \"../config.js\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\texport type LimitName =\n     7\t  | \"turns\"\n     8\t  | \"wall_time\"\n     9\t  | \"input_tokens\"\n    10\t  | \"output_tokens\"\n    11\t  | \"run_cost\"\n    12\t  | \"tool_calls\"\n    13\t  | \"tool_call_rate\"\n    14\t  | \"peer_calls\"\n    15\t  | \"subject_daily_cost\"\n    16\t  | \"tenant_daily_cost\"\n    17\t  | \"fleet_daily_cost\"\n    18\t  | \"tenant_tool_rate\"\n    19\t  | \"fleet_tool_rate\";\n    20\t\n    21\texport class BudgetExceeded extends Error {\n    22\t  constructor(public limit: LimitName, public used: number, public max: number) {\n    23\t    super(`budget exceeded: ${limit} (${used} > ${max})`);\n    24\t  }\n    25\t}\n    26\t\n    27\t// Shared counters across runs and pods. add() must be atomic and refuse to go past max.\n    28\texport interface QuotaStore {\n    29\t  add(key: string, amount: number, max: number, ttlSeconds: number): Promise<{ ok: boolean; used: number }>;\n    30\t}\n    31\t\n    32\texport class DynamoQuotaStore implements QuotaStore {\n    33\t  private ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    34\t  async add(key: string, amount: number, max: number, ttlSeconds: number) {\n    35\t    try {\n    36\t      const res = await this.ddb.send(\n    37\t        new UpdateCommand({\n    38\t          TableName: env.budgetTable,\n    39\t          Key: { pk: key },\n    40\t          UpdateExpression: \"ADD used :n SET expiresAt = if_not_exists(expiresAt, :exp)\",\n    41\t          ConditionExpression: \"attribute_not_exists(used) OR used <= :room\",\n    42\t          ExpressionAttributeValues: {\n    43\t            \":n\": amount,\n    44\t            \":room\": max - amount,\n    45\t            \":exp\": Math.floor(Date.now() / 1000) + ttlSeconds,\n    46\t          },\n    47\t          ReturnValues: \"UPDATED_NEW\",\n    48\t        }),\n    49\t      );\n    50\t      return { ok: true, used: Number(res.Attributes?.used ?? amount) };\n    51\t    } catch (err) {\n    52\t      if ((err as { name?: string }).name === \"ConditionalCheckFailedException\") return { ok: false, used: max };\n    53\t      throw err;\n    54\t    }\n    55\t  }\n    56\t}\n    57\t\n    58\texport interface Usage {\n    59\t  input_tokens: number;\n    60\t  output_tokens: number;\n    61\t  cache_read_input_tokens?: number | null;\n    62\t  cache_creation_input_tokens?: number | null;\n    63\t}\n    64\t\n    65\tconst day = () => new Date().toISOString().slice(0, 10);\n    66\tconst minute = () => new Date().toISOString().slice(0, 16);\n    67\t\n    68\texport class RunBudget {\n    69\t  readonly abort = new AbortController();\n    70\t  private started = Date.now();\n    71\t  private timer: NodeJS.Timeout;\n    72\t  private turns = 0;\n    73\t  private inTok = 0;\n    74\t  private outTok = 0;\n    75\t  private cost = 0;\n    76\t  private toolCalls = 0;\n    77\t  private toolTimes: number[] = [];\n    78\t  private peerCalls = 0;\n    79\t\n    80\t  constructor(\n    81\t    private b: Budgets,\n    82\t    private store: QuotaStore,\n    83\t    private scope: { tenantId: string; subjectId: string },\n    84\t    private now: () => number = Date.now,\n    85\t  ) {\n    86\t    this.started = this.now();\n    87\t    this.timer = setTimeout(\n    88\t      () => this.abort.abort(new BudgetExceeded(\"wall_time\", this.b.run.maxWallMs, this.b.run.maxWallMs)),\n    89\t      this.b.run.maxWallMs,\n    90\t    );\n    91\t  }\n    92\t\n    93\t  get signal(): AbortSignal {\n    94\t    return this.abort.signal;\n    95\t  }\n    96\t\n    97\t  dispose(): void {\n    98\t    clearTimeout(this.timer);\n    99\t  }\n   100\t\n   101\t  private check(limit: LimitName, used: number, max: number): void {\n   102\t    if (used > max) {\n   103\t      const e = new BudgetExceeded(limit, used, max);\n   104\t      this.abort.abort(e);\n   105\t      throw e;\n   106\t    }\n   107\t  }\n   108\t\n   109\t  private checkWall(): void {\n   110\t    this.check(\"wall_time\", this.now() - this.started, this.b.run.maxWallMs);\n   111\t  }\n   112\t\n   113\t  turn(): void {\n   114\t    this.checkWall();\n   115\t    this.turns += 1;\n   116\t    this.check(\"turns\", this.turns, this.b.run.maxTurns);\n   117\t  }\n   118\t\n   119\t  async recordUsage(u: Usage, model: string): Promise<void> {\n   120\t    const price = this.b.pricingUsdPerMTok[model];\n   121\t    if (!price) throw new Error(`no pricing for model ${model}`);\n   122\t    const cacheRead = u.cache_read_input_tokens ?? 0;\n   123\t    const cacheWrite = u.cache_creation_input_tokens ?? 0;\n   124\t    const callCost =\n   125\t      (u.input_tokens * price.input +\n   126\t        u.output_tokens * price.output +\n   127\t        cacheRead * price.cacheRead +\n   128\t        cacheWrite * price.cacheWrite) /\n   129\t      1_000_000;\n   130\t\n   131\t    this.inTok += u.input_tokens + cacheRead + cacheWrite;\n   132\t    this.outTok += u.output_tokens;\n   133\t    this.cost += callCost;\n   134\t    this.check(\"input_tokens\", this.inTok, this.b.run.maxInputTokens);\n   135\t    this.check(\"output_tokens\", this.outTok, this.b.run.maxOutputTokens);\n   136\t    this.check(\"run_cost\", this.cost, this.b.run.maxCostUsd);\n   137\t\n   138\t    const q = this.b.quotas;\n   139\t    await this.shared(\"subject_daily_cost\", `cost#subject#${this.scope.subjectId}#${day()}`, callCost, q.perSubjectDailyUsd, 86400);\n   140\t    await this.shared(\"tenant_daily_cost\", `cost#tenant#${this.scope.tenantId}#${day()}`, callCost, q.perTenantDailyUsd, 86400);\n   141\t    await this.shared(\"fleet_daily_cost\", `cost#fleet#${day()}`, callCost, q.fleetDailyUsd, 86400);\n   142\t  }\n   143\t\n   144\t  async toolCall(tool: string): Promise<void> {\n   145\t    this.checkWall();\n   146\t    this.toolCalls += 1;\n   147\t    this.check(\"tool_calls\", this.toolCalls, this.b.run.maxToolCalls);\n   148\t\n   149\t    const t = this.now();\n   150\t    this.toolTimes = this.toolTimes.filter((x) => t - x < 60_000);\n   151\t    this.toolTimes.push(t);\n   152\t    this.check(\"tool_call_rate\", this.toolTimes.length, this.b.run.maxToolCallsPerMinute);\n   153\t\n   154\t    if (tool.startsWith(\"insurance__\")) {\n   155\t      this.peerCalls += 1;\n   156\t      this.check(\"peer_calls\", this.peerCalls, this.b.run.maxPeerCalls);\n   157\t    }\n   158\t\n   159\t    const q = this.b.quotas;\n   160\t    await this.shared(\"tenant_tool_rate\", `rate#tenant#${this.scope.tenantId}#${minute()}`, 1, q.perTenantToolCallsPerMinute, 120);\n   161\t    await this.shared(\"fleet_tool_rate\", `rate#fleet#${minute()}`, 1, q.fleetToolCallsPerMinute, 120);\n   162\t  }\n   163\t\n   164\t  private async shared(limit: LimitName, key: string, amount: number, max: number, ttl: number): Promise<void> {\n   165\t    const r = await this.store.add(key, amount, max, ttl);\n   166\t    if (!r.ok) {\n   167\t      const e = new BudgetExceeded(limit, r.used + amount, max);\n   168\t      this.abort.abort(e);\n   169\t      throw e;\n   170\t    }\n   171\t  }\n   172\t}\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { createHash } from \"node:crypto\";\n     3\timport { readFileSync } from \"node:fs\";\n     4\timport { join } from \"node:path\";\n     5\timport { z } from \"zod\";\n     6\timport { CLASSIFIER_MODEL, ROOT } from \"../config.js\";\n     7\t\n     8\t// Helper model that routes messages before the agent sees them. Urgent and complaint messages go\n     9\t// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\n    10\t// malformed output, unknown label, or a served model other than the pinned snapshot) routes the\n    11\t// message to staff. A failed classifier never defaults to \"send it to the agent\".\n    12\t\n    13\texport const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");\n    14\texport const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\n    15\t\n    16\texport const CLASSIFIER_ID = `sha256:${createHash(\"sha256\")\n    17\t  .update(CLASSIFIER_MODEL)\n    18\t  .update(\"\\0\")\n    19\t  .update(CLASSIFIER_PROMPT)\n    20\t  .update(\"\\0\")\n    21\t  .update(JSON.stringify(CLASSIFIER_CONFIG))\n    22\t  .digest(\"hex\")}`;\n    23\t\n    24\tconst Intent = z.enum([\"book\", \"reschedule\", \"cancel\", \"confirm\", \"coverage\", \"info\", \"urgent\", \"complaint\", \"other\"]);\n    25\tconst Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();\n    26\t\n    27\texport type Route = \"agent\" | \"staff\";\n    28\t\n    29\texport interface ClassifierDecision {\n    30\t  classifierId: string;\n    31\t  requestedModel: string;\n    32\t  servedModel: string | null;\n    33\t  intent: z.infer<typeof Intent> | null;\n    34\t  confidence: number | null;\n    35\t  route: Route;\n    36\t  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n    37\t}\n    38\t\n    39\tconst MIN_CONFIDENCE = 0.6;\n    40\t\n    41\texport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n    42\t  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n    43\t  let res: Anthropic.Message;\n    44\t  try {\n    45\t    res = await client.messages.create(\n    46\t      {\n    47\t        model: CLASSIFIER_MODEL,\n    48\t        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n    49\t        temperature: CLASSIFIER_CONFIG.temperature,\n    50\t        system: CLASSIFIER_PROMPT,\n    51\t        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n    52\t      },\n    53\t      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n    54\t    );\n    55\t  } catch (err) {\n    56\t    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n    57\t    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n    58\t  }\n    59\t\n    60\t  if (res.model !== CLASSIFIER_MODEL) {\n    61\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n    62\t  }\n    63\t\n    64\t  const textOut = res.content.find((b) => b.type === \"text\");\n    65\t  let parsed: z.infer<typeof Output>;\n    66\t  try {\n    67\t    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n    68\t  } catch {\n    69\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n    70\t  }\n    71\t\n    72\t  if (parsed.confidence < MIN_CONFIDENCE) {\n    73\t    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n    74\t  }\n    75\t  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n    76\t  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n    77\t}\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\t\n     3\t// Context size at decision time, in tokens.\n     4\t//\n     5\t// Counting method. Each model decision is one Messages API call. Its response usage reports the\n     6\t// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and\n     7\t// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,\n     8\t// including the part served from the prompt cache and the provider's own tool-use preamble, which\n     9\t// the provider counts but does not show. This is a per-call value, not a run or billing total.\n    10\t// We record it as \"measured\", with the cached share kept separately.\n    11\t//\n    12\t// If the response carries no usage (stream cut off, aborted call), we fall back to the\n    13\t// count_tokens estimate taken just before the call for the same request, and mark it \"estimated\".\n    14\t// If neither exists the value is null with status \"unavailable\". It is never reported as 0.\n    15\t//\n    16\t// This harness never compacts, summarizes, or truncates history inside a run, so compacted is\n    17\t// always false; a run that would outgrow its token budget stops instead (see budget.ts).\n    18\texport interface ContextSize {\n    19\t  tokens: number | null;\n    20\t  status: \"measured\" | \"estimated\" | \"unavailable\";\n    21\t  method: string;\n    22\t  cachedInputTokens: number | null;\n    23\t  compacted: boolean;\n    24\t}\n    25\t\n    26\texport const USAGE_METHOD = \"anthropic.messages.usage(input+cache_read+cache_creation)\";\n    27\texport const COUNT_METHOD = \"anthropic.messages.count_tokens(pre-call estimate)\";\n    28\t\n    29\texport async function measureBeforeCall(\n    30\t  client: Anthropic,\n    31\t  req: Anthropic.MessageCountTokensParams,\n    32\t  signal: AbortSignal,\n    33\t): Promise<ContextSize> {\n    34\t  try {\n    35\t    const r = await client.messages.countTokens(req, { signal });\n    36\t    return { tokens: r.input_tokens, status: \"estimated\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    37\t  } catch {\n    38\t    return { tokens: null, status: \"unavailable\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    39\t  }\n    40\t}\n    41\t\n    42\texport function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {\n    43\t  if (!usage) return pre;\n    44\t  const cacheRead = usage.cache_read_input_tokens ?? 0;\n    45\t  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);\n    46\t  return { tokens: total, status: \"measured\", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };\n    47\t}\n    48\t\n    49\t// Span attributes so the value is searchable next to the action in traces as well as audit.\n    50\texport function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {\n    51\t  return {\n    52\t    ...(c.tokens === null ? {} : { \"clinic_agent.context.tokens\": c.tokens }),\n    53\t    \"clinic_agent.context.status\": c.status,\n    54\t    \"clinic_agent.context.method\": c.method,\n    55\t    \"gen_ai.conversation.compacted\": c.compacted,\n    56\t  };\n    57\t}\n\n`config/policy.yaml` lists the tools that need a staff approval before they run. The agent asks for\nthe approval, a front-desk lead or clinic manager approves it in the staff console, and the agent\nretries with the approval ID. Approvals expire after 15 minutes.\n\n## Stopping the agent\n\nOperators with the `clinic-agent-ops` role set `halted = true` on the `global` item (all clinics) or a\n`tenant#<clinicId>` item in the `clinic-agent-control` DynamoDB table:\n\n```bash\naws dynamodb put-item --table-name clinic-agent-control \\\n  --item '{\"pk\":{\"S\":\"global\"},\"halted\":{\"BOOL\":true},\"by\":{\"S\":\"<you>\"}}'\n```\n\nRunning work checks the flag before each model turn and each tool call, and a watcher aborts in-flight\nrequests within 2 seconds.\n\n## Identity\n\n`src/agent/identity.ts` computes the agent-type-id from the image digest, harness version, prompts,\nmodel IDs, and config. Each pod also gets a random agent-instance-id at start. Both are on every\naudit record together with the accountable party, operational owner, tenant, and trace context.\n\n## Build and test\n\n```bash\nnpm ci\nnpm run lint\nnpm test\nnpm run build\n  name                 = \"clinic-agent\"\n  image_tag_mutability = \"IMMUTABLE\"\n  image_scanning_configuration { scan_on_push = true }\n}\n\n# State tables. Approvals are written by the staff console; budgets by the agent; the control\n# table holds the stop flags operators set.\nresource \"aws_dynamodb_table\" \"approvals\" {\n  name         = \"clinic-agent-approvals\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"id\"\n  attribute {\n    name = \"id\"\n    type = \"S\"\n  }\n  point_in_time_recovery { enabled = true }\n}\n\nresource \"aws_dynamodb_table\" \"budgets\" {\n  name         = \"clinic-agent-budgets\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n  ttl {\n    attribute_name = \"expiresAt\"\n    enabled        = true\n  }\n}\n\nresource \"aws_dynamodb_table\" \"control\" {\n  name         = \"clinic-agent-control\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n  point_in_time_recovery { enabled = true }\n}\n\n# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).\nresource \"aws_s3_bucket\" \"audit\" {\n  bucket              = \"clinic-agent-audit-${data.aws_caller_identity.current.account_id}\"\n# Every tool the scheduling agent may call, with the task it serves.\n# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n# are not used for allow or approval decisions.\nrole: scheduling_agent\ntools:\n  - tool: ehr__find_patient\n    reason: Match the sender to a patient record by date of birth and phone or email.\n  - tool: ehr__search_slots\n    reason: List open slots for a provider, location, and visit type.\n  - tool: ehr__get_appointment\n    reason: Read one appointment the patient asks about.\n  - tool: ehr__list_patient_appointments\n    reason: Show the patient their upcoming appointments.\n  - tool: ehr__book_appointment\n    reason: Book a slot the patient chose.\n  - tool: ehr__update_appointment\n    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n  - tool: ehr__cancel_appointment\n    reason: Cancel an appointment at the patient's request.\n  - tool: payments__refund_deposit\n    reason: Refund a no-show deposit after staff review.\n  - tool: sms__send_to_patient\n    reason: Send a templated message to the phone number on the patient's record.\n  - tool: sms__send_freeform\n    reason: Send a staff-approved message that is not one of the templates.\n  - tool: insurance__check_eligibility\n    reason: Ask the eligibility agent whether a visit is covered.","is_error":false}]},"parent_tool_use_id":null,"session_id":"b885df4c-cfaf-404d-9f29-140acda878af","uuid":"6ff294b8-0347-473b-9c0f-74311cc81a2d","timestamp":"2026-10-20T12:30:12.604Z","tool_use_result":{"stdout":"     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, UpdateCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport type { Budgets } from \"../config.js\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\texport type LimitName =\n     7\t  | \"turns\"\n     8\t  | \"wall_time\"\n     9\t  | \"input_tokens\"\n    10\t  | \"output_tokens\"\n    11\t  | \"run_cost\"\n    12\t  | \"tool_calls\"\n    13\t  | \"tool_call_rate\"\n    14\t  | \"peer_calls\"\n    15\t  | \"subject_daily_cost\"\n    16\t  | \"tenant_daily_cost\"\n    17\t  | \"fleet_daily_cost\"\n    18\t  | \"tenant_tool_rate\"\n    19\t  | \"fleet_tool_rate\";\n    20\t\n    21\texport class BudgetExceeded extends Error {\n    22\t  constructor(public limit: LimitName, public used: number, public max: number) {\n    23\t    super(`budget exceeded: ${limit} (${used} > ${max})`);\n    24\t  }\n    25\t}\n    26\t\n    27\t// Shared counters across runs and pods. add() must be atomic and refuse to go past max.\n    28\texport interface QuotaStore {\n    29\t  add(key: string, amount: number, max: number, ttlSeconds: number): Promise<{ ok: boolean; used: number }>;\n    30\t}\n    31\t\n    32\texport class DynamoQuotaStore implements QuotaStore {\n    33\t  private ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    34\t  async add(key: string, amount: number, max: number, ttlSeconds: number) {\n    35\t    try {\n    36\t      const res = await this.ddb.send(\n    37\t        new UpdateCommand({\n    38\t          TableName: env.budgetTable,\n    39\t          Key: { pk: key },\n    40\t          UpdateExpression: \"ADD used :n SET expiresAt = if_not_exists(expiresAt, :exp)\",\n    41\t          ConditionExpression: \"attribute_not_exists(used) OR used <= :room\",\n    42\t          ExpressionAttributeValues: {\n    43\t            \":n\": amount,\n    44\t            \":room\": max - amount,\n    45\t            \":exp\": Math.floor(Date.now() / 1000) + ttlSeconds,\n    46\t          },\n    47\t          ReturnValues: \"UPDATED_NEW\",\n    48\t        }),\n    49\t      );\n    50\t      return { ok: true, used: Number(res.Attributes?.used ?? amount) };\n    51\t    } catch (err) {\n    52\t      if ((err as { name?: string }).name === \"ConditionalCheckFailedException\") return { ok: false, used: max };\n    53\t      throw err;\n    54\t    }\n    55\t  }\n    56\t}\n    57\t\n    58\texport interface Usage {\n    59\t  input_tokens: number;\n    60\t  output_tokens: number;\n    61\t  cache_read_input_tokens?: number | null;\n    62\t  cache_creation_input_tokens?: number | null;\n    63\t}\n    64\t\n    65\tconst day = () => new Date().toISOString().slice(0, 10);\n    66\tconst minute = () => new Date().toISOString().slice(0, 16);\n    67\t\n    68\texport class RunBudget {\n    69\t  readonly abort = new AbortController();\n    70\t  private started = Date.now();\n    71\t  private timer: NodeJS.Timeout;\n    72\t  private turns = 0;\n    73\t  private inTok = 0;\n    74\t  private outTok = 0;\n    75\t  private cost = 0;\n    76\t  private toolCalls = 0;\n    77\t  private toolTimes: number[] = [];\n    78\t  private peerCalls = 0;\n    79\t\n    80\t  constructor(\n    81\t    private b: Budgets,\n    82\t    private store: QuotaStore,\n    83\t    private scope: { tenantId: string; subjectId: string },\n    84\t    private now: () => number = Date.now,\n    85\t  ) {\n    86\t    this.started = this.now();\n    87\t    this.timer = setTimeout(\n    88\t      () => this.abort.abort(new BudgetExceeded(\"wall_time\", this.b.run.maxWallMs, this.b.run.maxWallMs)),\n    89\t      this.b.run.maxWallMs,\n    90\t    );\n    91\t  }\n    92\t\n    93\t  get signal(): AbortSignal {\n    94\t    return this.abort.signal;\n    95\t  }\n    96\t\n    97\t  dispose(): void {\n    98\t    clearTimeout(this.timer);\n    99\t  }\n   100\t\n   101\t  private check(limit: LimitName, used: number, max: number): void {\n   102\t    if (used > max) {\n   103\t      const e = new BudgetExceeded(limit, used, max);\n   104\t      this.abort.abort(e);\n   105\t      throw e;\n   106\t    }\n   107\t  }\n   108\t\n   109\t  private checkWall(): void {\n   110\t    this.check(\"wall_time\", this.now() - this.started, this.b.run.maxWallMs);\n   111\t  }\n   112\t\n   113\t  turn(): void {\n   114\t    this.checkWall();\n   115\t    this.turns += 1;\n   116\t    this.check(\"turns\", this.turns, this.b.run.maxTurns);\n   117\t  }\n   118\t\n   119\t  async recordUsage(u: Usage, model: string): Promise<void> {\n   120\t    const price = this.b.pricingUsdPerMTok[model];\n   121\t    if (!price) throw new Error(`no pricing for model ${model}`);\n   122\t    const cacheRead = u.cache_read_input_tokens ?? 0;\n   123\t    const cacheWrite = u.cache_creation_input_tokens ?? 0;\n   124\t    const callCost =\n   125\t      (u.input_tokens * price.input +\n   126\t        u.output_tokens * price.output +\n   127\t        cacheRead * price.cacheRead +\n   128\t        cacheWrite * price.cacheWrite) /\n   129\t      1_000_000;\n   130\t\n   131\t    this.inTok += u.input_tokens + cacheRead + cacheWrite;\n   132\t    this.outTok += u.output_tokens;\n   133\t    this.cost += callCost;\n   134\t    this.check(\"input_tokens\", this.inTok, this.b.run.maxInputTokens);\n   135\t    this.check(\"output_tokens\", this.outTok, this.b.run.maxOutputTokens);\n   136\t    this.check(\"run_cost\", this.cost, this.b.run.maxCostUsd);\n   137\t\n   138\t    const q = this.b.quotas;\n   139\t    await this.shared(\"subject_daily_cost\", `cost#subject#${this.scope.subjectId}#${day()}`, callCost, q.perSubjectDailyUsd, 86400);\n   140\t    await this.shared(\"tenant_daily_cost\", `cost#tenant#${this.scope.tenantId}#${day()}`, callCost, q.perTenantDailyUsd, 86400);\n   141\t    await this.shared(\"fleet_daily_cost\", `cost#fleet#${day()}`, callCost, q.fleetDailyUsd, 86400);\n   142\t  }\n   143\t\n   144\t  async toolCall(tool: string): Promise<void> {\n   145\t    this.checkWall();\n   146\t    this.toolCalls += 1;\n   147\t    this.check(\"tool_calls\", this.toolCalls, this.b.run.maxToolCalls);\n   148\t\n   149\t    const t = this.now();\n   150\t    this.toolTimes = this.toolTimes.filter((x) => t - x < 60_000);\n   151\t    this.toolTimes.push(t);\n   152\t    this.check(\"tool_call_rate\", this.toolTimes.length, this.b.run.maxToolCallsPerMinute);\n   153\t\n   154\t    if (tool.startsWith(\"insurance__\")) {\n   155\t      this.peerCalls += 1;\n   156\t      this.check(\"peer_calls\", this.peerCalls, this.b.run.maxPeerCalls);\n   157\t    }\n   158\t\n   159\t    const q = this.b.quotas;\n   160\t    await this.shared(\"tenant_tool_rate\", `rate#tenant#${this.scope.tenantId}#${minute()}`, 1, q.perTenantToolCallsPerMinute, 120);\n   161\t    await this.shared(\"fleet_tool_rate\", `rate#fleet#${minute()}`, 1, q.fleetToolCallsPerMinute, 120);\n   162\t  }\n   163\t\n   164\t  private async shared(limit: LimitName, key: string, amount: number, max: number, ttl: number): Promise<void> {\n   165\t    const r = await this.store.add(key, amount, max, ttl);\n   166\t    if (!r.ok) {\n   167\t      const e = new BudgetExceeded(limit, r.used + amount, max);\n   168\t      this.abort.abort(e);\n   169\t      throw e;\n   170\t    }\n   171\t  }\n   172\t}\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { createHash } from \"node:crypto\";\n     3\timport { readFileSync } from \"node:fs\";\n     4\timport { join } from \"node:path\";\n     5\timport { z } from \"zod\";\n     6\timport { CLASSIFIER_MODEL, ROOT } from \"../config.js\";\n     7\t\n     8\t// Helper model that routes messages before the agent sees them. Urgent and complaint messages go\n     9\t// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\n    10\t// malformed output, unknown label, or a served model other than the pinned snapshot) routes the\n    11\t// message to staff. A failed classifier never defaults to \"send it to the agent\".\n    12\t\n    13\texport const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");\n    14\texport const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\n    15\t\n    16\texport const CLASSIFIER_ID = `sha256:${createHash(\"sha256\")\n    17\t  .update(CLASSIFIER_MODEL)\n    18\t  .update(\"\\0\")\n    19\t  .update(CLASSIFIER_PROMPT)\n    20\t  .update(\"\\0\")\n    21\t  .update(JSON.stringify(CLASSIFIER_CONFIG))\n    22\t  .digest(\"hex\")}`;\n    23\t\n    24\tconst Intent = z.enum([\"book\", \"reschedule\", \"cancel\", \"confirm\", \"coverage\", \"info\", \"urgent\", \"complaint\", \"other\"]);\n    25\tconst Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();\n    26\t\n    27\texport type Route = \"agent\" | \"staff\";\n    28\t\n    29\texport interface ClassifierDecision {\n    30\t  classifierId: string;\n    31\t  requestedModel: string;\n    32\t  servedModel: string | null;\n    33\t  intent: z.infer<typeof Intent> | null;\n    34\t  confidence: number | null;\n    35\t  route: Route;\n    36\t  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n    37\t}\n    38\t\n    39\tconst MIN_CONFIDENCE = 0.6;\n    40\t\n    41\texport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n    42\t  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n    43\t  let res: Anthropic.Message;\n    44\t  try {\n    45\t    res = await client.messages.create(\n    46\t      {\n    47\t        model: CLASSIFIER_MODEL,\n    48\t        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n    49\t        temperature: CLASSIFIER_CONFIG.temperature,\n    50\t        system: CLASSIFIER_PROMPT,\n    51\t        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n    52\t      },\n    53\t      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n    54\t    );\n    55\t  } catch (err) {\n    56\t    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n    57\t    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n    58\t  }\n    59\t\n    60\t  if (res.model !== CLASSIFIER_MODEL) {\n    61\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n    62\t  }\n    63\t\n    64\t  const textOut = res.content.find((b) => b.type === \"text\");\n    65\t  let parsed: z.infer<typeof Output>;\n    66\t  try {\n    67\t    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n    68\t  } catch {\n    69\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n    70\t  }\n    71\t\n    72\t  if (parsed.confidence < MIN_CONFIDENCE) {\n    73\t    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n    74\t  }\n    75\t  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n    76\t  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n    77\t}\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\t\n     3\t// Context size at decision time, in tokens.\n     4\t//\n     5\t// Counting method. Each model decision is one Messages API call. Its response usage reports the\n     6\t// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and\n     7\t// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,\n     8\t// including the part served from the prompt cache and the provider's own tool-use preamble, which\n     9\t// the provider counts but does not show. This is a per-call value, not a run or billing total.\n    10\t// We record it as \"measured\", with the cached share kept separately.\n    11\t//\n    12\t// If the response carries no usage (stream cut off, aborted call), we fall back to the\n    13\t// count_tokens estimate taken just before the call for the same request, and mark it \"estimated\".\n    14\t// If neither exists the value is null with status \"unavailable\". It is never reported as 0.\n    15\t//\n    16\t// This harness never compacts, summarizes, or truncates history inside a run, so compacted is\n    17\t// always false; a run that would outgrow its token budget stops instead (see budget.ts).\n    18\texport interface ContextSize {\n    19\t  tokens: number | null;\n    20\t  status: \"measured\" | \"estimated\" | \"unavailable\";\n    21\t  method: string;\n    22\t  cachedInputTokens: number | null;\n    23\t  compacted: boolean;\n    24\t}\n    25\t\n    26\texport const USAGE_METHOD = \"anthropic.messages.usage(input+cache_read+cache_creation)\";\n    27\texport const COUNT_METHOD = \"anthropic.messages.count_tokens(pre-call estimate)\";\n    28\t\n    29\texport async function measureBeforeCall(\n    30\t  client: Anthropic,\n    31\t  req: Anthropic.MessageCountTokensParams,\n    32\t  signal: AbortSignal,\n    33\t): Promise<ContextSize> {\n    34\t  try {\n    35\t    const r = await client.messages.countTokens(req, { signal });\n    36\t    return { tokens: r.input_tokens, status: \"estimated\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    37\t  } catch {\n    38\t    return { tokens: null, status: \"unavailable\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    39\t  }\n    40\t}\n    41\t\n    42\texport function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {\n    43\t  if (!usage) return pre;\n    44\t  const cacheRead = usage.cache_read_input_tokens ?? 0;\n    45\t  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);\n    46\t  return { tokens: total, status: \"measured\", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };\n    47\t}\n    48\t\n    49\t// Span attributes so the value is searchable next to the action in traces as well as audit.\n    50\texport function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {\n    51\t  return {\n    52\t    ...(c.tokens === null ? {} : { \"clinic_agent.context.tokens\": c.tokens }),\n    53\t    \"clinic_agent.context.status\": c.status,\n    54\t    \"clinic_agent.context.method\": c.method,\n    55\t    \"gen_ai.conversation.compacted\": c.compacted,\n    56\t  };\n    57\t}\n\n`config/policy.yaml` lists the tools that need a staff approval before they run. The agent asks for\nthe approval, a front-desk lead or clinic manager approves it in the staff console, and the agent\nretries with the approval ID. Approvals expire after 15 minutes.\n\n## Stopping the agent\n\nOperators with the `clinic-agent-ops` role set `halted = true` on the `global` item (all clinics) or a\n`tenant#<clinicId>` item in the `clinic-agent-control` DynamoDB table:\n\n```bash\naws dynamodb put-item --table-name clinic-agent-control \\\n  --item '{\"pk\":{\"S\":\"global\"},\"halted\":{\"BOOL\":true},\"by\":{\"S\":\"<you>\"}}'\n```\n\nRunning work checks the flag before each model turn and each tool call, and a watcher aborts in-flight\nrequests within 2 seconds.\n\n## Identity\n\n`src/agent/identity.ts` computes the agent-type-id from the image digest, harness version, prompts,\nmodel IDs, and config. Each pod also gets a random agent-instance-id at start. Both are on every\naudit record together with the accountable party, operational owner, tenant, and trace context.\n\n## Build and test\n\n```bash\nnpm ci\nnpm run lint\nnpm test\nnpm run build\n  name                 = \"clinic-agent\"\n  image_tag_mutability = \"IMMUTABLE\"\n  image_scanning_configuration { scan_on_push = true }\n}\n\n# State tables. Approvals are written by the staff console; budgets by the agent; the control\n# table holds the stop flags operators set.\nresource \"aws_dynamodb_table\" \"approvals\" {\n  name         = \"clinic-agent-approvals\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"id\"\n  attribute {\n    name = \"id\"\n    type = \"S\"\n  }\n  point_in_time_recovery { enabled = true }\n}\n\nresource \"aws_dynamodb_table\" \"budgets\" {\n  name         = \"clinic-agent-budgets\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n  ttl {\n    attribute_name = \"expiresAt\"\n    enabled        = true\n  }\n}\n\nresource \"aws_dynamodb_table\" \"control\" {\n  name         = \"clinic-agent-control\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n  point_in_time_recovery { enabled = true }\n}\n\n# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).\nresource \"aws_s3_bucket\" \"audit\" {\n  bucket              = \"clinic-agent-audit-${data.aws_caller_identity.current.account_id}\"\n# Every tool the scheduling agent may call, with the task it serves.\n# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n# are not used for allow or approval decisions.\nrole: scheduling_agent\ntools:\n  - tool: ehr__find_patient\n    reason: Match the sender to a patient record by date of birth and phone or email.\n  - tool: ehr__search_slots\n    reason: List open slots for a provider, location, and visit type.\n  - tool: ehr__get_appointment\n    reason: Read one appointment the patient asks about.\n  - tool: ehr__list_patient_appointments\n    reason: Show the patient their upcoming appointments.\n  - tool: ehr__book_appointment\n    reason: Book a slot the patient chose.\n  - tool: ehr__update_appointment\n    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n  - tool: ehr__cancel_appointment\n    reason: Cancel an appointment at the patient's request.\n  - tool: payments__refund_deposit\n    reason: Refund a no-show deposit after staff review.\n  - tool: sms__send_to_patient\n    reason: Send a templated message to the phone number on the patient's record.\n  - tool: sms__send_freeform\n    reason: Send a staff-approved message that is not one of the templates.\n  - tool: insurance__check_eligibility\n    reason: Ask the eligibility agent whether a visit is covered.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01XPmyjQM8djR1WWb4nSQ7mT","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
