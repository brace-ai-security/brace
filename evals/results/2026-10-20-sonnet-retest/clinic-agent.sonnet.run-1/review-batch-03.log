{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012yxaDRnWK8TxmedAgubiHh","type":"tool_result","content":"     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    16\t      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5.0.0\n    17\t        with:\n    18\t          node-version: \"22.11\"\n    19\t          cache: npm\n    20\t      - run: npm ci --ignore-scripts\n    21\t      - run: npm run lint\n    22\t      - run: npm test\n    23\t      - run: npm run build\n    24\t\n    25\t  manifest-check:\n    26\t    runs-on: ubuntu-24.04\n    27\t    steps:\n    28\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    29\t      - name: Prompt digests match the release manifest\n    30\t        run: |\n    31\t          node -e '\n    32\t            const fs = require(\"fs\"), crypto = require(\"crypto\");\n    33\t            const m = JSON.parse(fs.readFileSync(\"release/manifest.json\", \"utf8\"));\n    34\t            let bad = 0;\n    35\t            for (const p of m.prompts) {\n    36\t              const got = crypto.createHash(\"sha256\").update(fs.readFileSync(p.path)).digest(\"hex\");\n    37\t              if (got !== p.sha256) { console.error(`${p.path}: manifest ${p.sha256} != file ${got}`); bad++; }\n    38\t            }\n    39\t            const ver = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\")).version;\n    40\t            if (m.harness.version !== ver) { console.error(`harness version ${m.harness.version} != package ${ver}`); bad++; }\n    41\t            process.exit(bad ? 1 : 0);\n    42\t          '\n    43\t\n    44\t  image:\n    45\t    if: github.ref == 'refs/heads/main'\n    46\t    needs: [test, manifest-check]\n    47\t    runs-on: ubuntu-24.04\n    48\t    permissions:\n    49\t      contents: read\n    50\t      id-token: write\n    51\t      attestations: write\n    52\t      packages: write\n    53\t    steps:\n    54\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    55\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    56\t        with:\n    57\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-image-build\n    58\t          aws-region: us-west-2\n    59\t      - uses: aws-actions/amazon-ecr-login@062b18b96a7aff071d4dc91bc00c4c1a7945b076 # v2.0.1\n    60\t        id: ecr\n    61\t      - uses: docker/setup-buildx-action@e468171a9de216ec08956ac3ada2f0791b6bd435 # v3.11.1\n    62\t      - uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    63\t        id: build\n    64\t        with:\n    65\t          push: true\n    66\t          tags: ${{ steps.ecr.outputs.registry }}/clinic-agent:${{ github.sha }}\n    67\t          provenance: mode=max\n    68\t          sbom: true\n    69\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    70\t        with:\n    71\t          cosign-release: v2.6.2\n    72\t      - name: Sign image\n    73\t        run: cosign sign --yes ${{ steps.ecr.outputs.registry }}/clinic-agent@${{ steps.build.outputs.digest }}\n    74\t      - uses: actions/attest-build-provenance@977bb373ede98d70efdf65b84cb5f73e068dcc2a # v3.0.0\n    75\t        with:\n    76\t          subject-name: ${{ steps.ecr.outputs.registry }}/clinic-agent\n    77\t          subject-digest: ${{ steps.build.outputs.digest }}\n    78\t          push-to-registry: true\n     1\t{\n     2\t  \"release\": \"clinic-agent-3.4.1\",\n     3\t  \"agentTypeId\": \"sha256:7c2e91f04ab35d6e8f1029c4b7a6d3e5f8091a2b3c4d5e6f708192a3b4c5d6e7\",\n     4\t  \"image\": {\n     5\t    \"repository\": \"418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent\",\n     6\t    \"digest\": \"sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\"\n     7\t  },\n     8\t  \"harness\": {\n     9\t    \"version\": \"3.4.1\",\n    10\t    \"gitSha\": \"e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\"\n    11\t  },\n    12\t  \"prompts\": [\n    13\t    { \"path\": \"prompts/system.md\", \"sha256\": \"5d1e0c9b8a7f6e5d4c3b2a1908f7e6d5c4b3a291807f6e5d4c3b2a19087f6e5d\" },\n    14\t    { \"path\": \"prompts/intent-classifier.txt\", \"sha256\": \"a3f9e1d7c5b3a1f9e7d5c3b1a9f7e5d3c1b9a7f5e3d1c9b7a5f3e1d9c7b5a3f1\" }\n    15\t  ],\n    16\t  \"models\": [\n    17\t    {\n    18\t      \"role\": \"agent\",\n    19\t      \"provider\": \"anthropic\",\n    20\t      \"requestedId\": \"claude-sonnet-4-5-20250929\",\n    21\t      \"kind\": \"pinned_snapshot\",\n    22\t      \"versionDoc\": { \"url\": \"https://docs.anthropic.com/en/docs/about-claude/models/overview\", \"checked\": \"2026-09-15\" },\n    23\t      \"adapter\": null,\n    24\t      \"providerHidden\": [\"weights\", \"training_data\", \"serving_stack\"]\n    25\t    },\n    26\t    {\n    27\t      \"role\": \"intent_classifier\",\n    28\t      \"provider\": \"anthropic\",\n    29\t      \"requestedId\": \"claude-haiku-4-5-20251001\",\n    30\t      \"kind\": \"pinned_snapshot\",\n    31\t      \"versionDoc\": { \"url\": \"https://docs.anthropic.com/en/docs/about-claude/models/overview\", \"checked\": \"2026-09-15\" },\n    32\t      \"adapter\": null,\n    33\t      \"providerHidden\": [\"weights\", \"training_data\", \"serving_stack\"]\n    34\t    }\n    35\t  ],\n    36\t  \"tools\": {\n    37\t    \"allowlist\": \"config/tools.allowlist.yaml\",\n    38\t    \"mcpServers\": [\n    39\t      {\n    40\t        \"id\": \"ehr\",\n    41\t        \"url\": \"https://ehr-mcp.internal.northbay-clinics.example/mcp\",\n    42\t        \"tlsCertSha256\": \"1f6a9c3e5b7d9f1a3c5e7b9d1f3a5c7e9b1d3f5a7c9e1b3d5f7a9c1e3b5d7f9a\",\n    43\t        \"owner\": \"ehr-integrations@northbay-clinics.example\"\n    44\t      }\n    45\t    ],\n    46\t    \"native\": [\"payments\", \"sms\", \"insurance\"]\n    47\t  },\n    48\t  \"peers\": [\n    49\t    {\n    50\t      \"id\": \"eligibility-agent\",\n    51\t      \"url\": \"https://eligibility.partners.northbay-clinics.example/a2a\",\n    52\t      \"owner\": \"revenue-cycle@northbay-clinics.example\"\n    53\t    }\n    54\t  ],\n    55\t  \"permissions\": {\n    56\t    \"awsRole\": \"arn:aws:iam::418295730611:role/clinic-agent-runtime\",\n    57\t    \"ehrScopes\": [\"patient.read\", \"appointment.read\", \"appointment.write\"],\n    58\t    \"paymentsScopes\": [\"deposits.refund\"],\n    59\t    \"eligibilityScopes\": [\"eligibility:read\"]\n    60\t  },\n    61\t  \"memory\": \"none\",\n    62\t  \"retrieval\": \"none\",\n    63\t  \"network\": { \"policy\": \"k8s/deployment.yaml#clinic-agent-egress\", \"egressProxy\": \"egress-proxy.platform.svc:3128\" },\n    64\t  \"budgets\": \"config/budgets.yaml\",\n    65\t  \"policies\": { \"action\": \"config/policy.yaml\", \"actionPolicyVersion\": \"2026-09-18.3\" }\n    66\t}\n     1\t{\n     2\t  \"name\": \"clinic-agent\",\n     3\t  \"version\": \"3.4.1\",\n     4\t  \"private\": true,\n     5\t  \"type\": \"module\",\n     6\t  \"engines\": {\n     7\t    \"node\": \">=22.11\"\n     8\t  },\n     9\t  \"scripts\": {\n    10\t    \"build\": \"tsc -p tsconfig.json\",\n    11\t    \"start\": \"node dist/server.js\",\n    12\t    \"reminders\": \"node dist/workers/reminders.js\",\n    13\t    \"lint\": \"eslint src test\",\n    14\t    \"test\": \"vitest run\"\n    15\t  },\n    16\t  \"dependencies\": {\n    17\t    \"@anthropic-ai/sdk\": \"0.65.0\",\n    18\t    \"@aws-sdk/client-dynamodb\": \"3.893.0\",\n    19\t    \"@aws-sdk/client-firehose\": \"3.893.0\",\n    20\t    \"@aws-sdk/client-secrets-manager\": \"3.893.0\",\n    21\t    \"@aws-sdk/lib-dynamodb\": \"3.893.0\",\n    22\t    \"@modelcontextprotocol/sdk\": \"1.18.2\",\n    23\t    \"fastify\": \"5.6.1\",\n    24\t    \"jose\": \"6.1.0\",\n    25\t    \"pino\": \"9.11.0\",\n    26\t    \"undici\": \"7.16.0\",\n    27\t    \"yaml\": \"2.8.1\",\n    28\t    \"zod\": \"3.25.76\"\n    29\t  },\n    30\t  \"devDependencies\": {\n    31\t    \"@types/node\": \"22.18.6\",\n    32\t    \"eslint\": \"9.36.0\",\n    33\t    \"typescript\": \"5.9.2\",\n    34\t    \"typescript-eslint\": \"8.44.1\",\n    35\t    \"vitest\": \"3.2.4\"\n    36\t  }\n    37\t}\n     1\t# clinic-agent\n     2\t\n     3\tPatient-scheduling agent for the Northbay Clinic Group. Patients reach it by SMS or by the web chat\n     4\twidget on each clinic's site. It looks up, books, reschedules, and cancels appointments in the EHR,\n     5\tsends SMS reminders, refunds no-show deposits, and asks the insurance-eligibility agent whether a\n     6\tvisit is covered.\n     7\t\n     8\tEach clinic is a tenant. A clinic's patients, appointments, deposits, and EHR credentials are kept\n     9\tseparate from every other clinic's.\n    10\t\n    11\t## Components\n    12\t\n    13\t| Piece | Where | Notes |\n    14\t|---|---|---|\n    15\t| HTTP service (Fastify) | `src/server.ts` | `/v1/sms/inbound` webhook, `/v1/chat` web chat |\n    16\t| Agent loop | `src/agent/loop.ts` | Claude Sonnet 4.5 snapshot, tool use |\n    17\t| Intent classifier | `src/agent/classifier.ts` | Claude Haiku 4.5 snapshot, routes emergencies and complaints to staff |\n    18\t| Tool registry | `src/tools/registry.ts` | EHR MCP server plus native tools, scanned on load |\n    19\t| Tool executor | `src/tools/executor.ts` | allowlist, kill switch, budgets, approvals, audit |\n    20\t| EHR | `src/integrations/ehr-mcp.ts` | MCP over streamable HTTP with mTLS, per-clinic OAuth client |\n    21\t| Payments | `src/integrations/payments.ts` | deposit refunds, provider idempotency keys |\n    22\t| SMS | `src/integrations/sms.ts` | outbound reminders and replies |\n    23\t| Eligibility peer | `src/integrations/eligibility-a2a.ts` | A2A `message/send`, token exchange per call |\n    24\t| Reminder job | `src/workers/reminders.ts` | Kubernetes CronJob, 17:00 local each day |\n    25\t\n    26\tThere is no vector store and no conversation memory. Every run starts from the patient's message and\n    27\tthe EHR. Conversation transcripts are not stored by this service.\n    28\t\n    29\t## High-impact actions\n    30\t\n    31\t`config/policy.yaml` lists the tools that need a staff approval before they run. The agent asks for\n    32\tthe approval, a front-desk lead or clinic manager approves it in the staff console, and the agent\n    33\tretries with the approval ID. Approvals expire after 15 minutes.\n    34\t\n    35\t## Stopping the agent\n    36\t\n    37\tOperators with the `clinic-agent-ops` role set `halted = true` on the `global` item (all clinics) or a\n    38\t`tenant#<clinicId>` item in the `clinic-agent-control` DynamoDB table:\n    39\t\n    40\t```bash\n    41\taws dynamodb put-item --table-name clinic-agent-control \\\n    42\t  --item '{\"pk\":{\"S\":\"global\"},\"halted\":{\"BOOL\":true},\"by\":{\"S\":\"<you>\"}}'\n    43\t```\n    44\t\n    45\tRunning work checks the flag before each model turn and each tool call, and a watcher aborts in-flight\n    46\trequests within 2 seconds.\n    47\t\n    48\t## Identity\n    49\t\n    50\t`src/agent/identity.ts` computes the agent-type-id from the image digest, harness version, prompts,\n    51\tmodel IDs, and config. Each pod also gets a random agent-instance-id at start. Both are on every\n    52\taudit record together with the accountable party, operational owner, tenant, and trace context.\n    53\t\n    54\t## Build and test\n    55\t\n    56\t```bash\n    57\tnpm ci\n    58\tnpm run lint\n    59\tnpm test\n    60\tnpm run build\n    61\t```\n    62\t\n    63\t## Release\n    64\t\n    65\tMerges to `main` need two reviews and a code owner review for prompts, config, infra, and manifests.\n    66\t`deploy.yml` builds, signs, and deploys by digest to the `production` environment, which has required\n    67\treviewers. Emergency deploys use the same workflow with `emergency: true` and must name an owner,\n    68\ta reason, and an end date; the workflow opens a follow-up review issue.\n    69\t\n    70\t## Owners\n    71\t\n    72\t- Accountable party: Northbay Clinic Group, Patient Access (VP Patient Access)\n    73\t- Operational owner: agent-platform team, `#agent-platform-oncall`\n     1\t# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\n     2\tpolicyVersion: \"2026-09-18.3\"\n     3\t\n     4\t# Tools that never run without a staff approval bound to the request.\n     5\thighImpactTools:\n     6\t  - ehr__cancel_appointment\n     7\t  - payments__refund_deposit\n     8\t  - sms__send_freeform\n     9\t\n    10\tapproval:\n    11\t  ttlSeconds: 900\n    12\t  approverRoles:\n    13\t    - front_desk_lead\n    14\t    - clinic_manager\n    15\t  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n    16\t  table: clinic-agent-approvals\n     1\t# Every tool the scheduling agent may call, with the task it serves.\n     2\t# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n     3\t# are not used for allow or approval decisions.\n     4\trole: scheduling_agent\n     5\ttools:\n     6\t  - tool: ehr__find_patient\n     7\t    reason: Match the sender to a patient record by date of birth and phone or email.\n     8\t  - tool: ehr__search_slots\n     9\t    reason: List open slots for a provider, location, and visit type.\n    10\t  - tool: ehr__get_appointment\n    11\t    reason: Read one appointment the patient asks about.\n    12\t  - tool: ehr__list_patient_appointments\n    13\t    reason: Show the patient their upcoming appointments.\n    14\t  - tool: ehr__book_appointment\n    15\t    reason: Book a slot the patient chose.\n    16\t  - tool: ehr__update_appointment\n    17\t    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n    18\t  - tool: ehr__cancel_appointment\n    19\t    reason: Cancel an appointment at the patient's request.\n    20\t  - tool: payments__refund_deposit\n    21\t    reason: Refund a no-show deposit after staff review.\n    22\t  - tool: sms__send_to_patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.\n1:terraform {\n2:  required_version = \">= 1.9.0\"\n3:  required_providers {\n4:    aws    = { source = \"hashicorp/aws\", version = \"~> 6.14\" }\n5:    github = { source = \"integrations/github\", version = \"~> 6.6\" }\n6:  }\n7:  backend \"s3\" {\n8:    bucket         = \"northbay-tfstate-418295730611\"\n9:    key            = \"clinic-agent/prod.tfstate\"\n10:    region         = \"us-west-2\"\n11:    dynamodb_table = \"northbay-tf-locks\"\n12:    encrypt        = true\n13:  }\n14:}\n15:\n16:provider \"aws\" {\n17:  region = var.region\n18:  default_tags {\n19:    tags = { app = \"clinic-agent\", owner = \"agent-platform\", data = \"phi\" }\n20:  }\n21:}\n22:\n23:variable \"region\" {\n24:  type    = string\n25:  default = \"us-west-2\"\n26:}\n27:\n28:variable \"clinic_ids\" {\n29:  type    = list(string)\n30:  default = [\"nb-castro\", \"nb-fremont\", \"nb-oakland\", \"nb-sanmateo\", \"nb-walnutcreek\"]\n31:}\n32:\n33:data \"aws_caller_identity\" \"current\" {}\n34:\n35:module \"eks\" {\n36:  source  = \"terraform-aws-modules/eks/aws\"\n37:  version = \"21.3.1\"\n38:\n39:  name               = \"clinic-agent-prod\"\n40:  kubernetes_version = \"1.33\"\n41:  vpc_id             = module.vpc.vpc_id\n42:  subnet_ids         = module.vpc.private_subnets\n43:\n44:  endpoint_public_access = false\n45:  enable_irsa            = true\n46:\n47:  authentication_mode = \"API\"\n48:  access_entries = {\n49:    deploy = {\n50:      principal_arn = aws_iam_role.deploy.arn\n51:      policy_associations = {\n52:        ns = {\n53:          policy_arn   = \"arn:aws:eks::aws:cluster-access-policy/AmazonEKSEditPolicy\"\n54:          access_scope = { type = \"namespace\", namespaces = [\"clinic-agent\"] }\n55:        }\n56:      }\n57:    }\n58:  }\n59:\n60:  eks_managed_node_groups = {\n61:    agents = {\n62:      instance_types = [\"m7g.large\"]\n63:      ami_type       = \"BOTTLEROCKET_ARM_64\"\n64:      min_size       = 2\n65:      max_size       = 6\n66:      desired_size   = 3\n67:      metadata_options = {\n68:        http_tokens                 = \"required\"\n69:        http_put_response_hop_limit = 1\n70:      }\n71:    }\n72:  }\n73:}\n74:\n75:module \"vpc\" {\n76:  source  = \"terraform-aws-modules/vpc/aws\"\n77:  version = \"6.4.0\"\n78:\n79:  name            = \"clinic-agent-prod\"\n80:  cidr            = \"10.42.0.0/16\"\n81:  azs             = [\"us-west-2a\", \"us-west-2b\", \"us-west-2c\"]\n82:  private_subnets = [\"10.42.1.0/24\", \"10.42.2.0/24\", \"10.42.3.0/24\"]\n83:  public_subnets  = [\"10.42.101.0/24\", \"10.42.102.0/24\", \"10.42.103.0/24\"]\n84:\n85:  enable_nat_gateway = true\n86:  single_nat_gateway = false\n87:}\n88:\n89:resource \"aws_ecr_repository\" \"agent\" {\n90:  name                 = \"clinic-agent\"\n91:  image_tag_mutability = \"IMMUTABLE\"\n92:  image_scanning_configuration { scan_on_push = true }\n93:}\n94:\n95:# State tables. Approvals are written by the staff console; budgets by the agent; the control\n96:# table holds the stop flags operators set.\n97:resource \"aws_dynamodb_table\" \"approvals\" {\n98:  name         = \"clinic-agent-approvals\"\n99:  billing_mode = \"PAY_PER_REQUEST\"\n100:  hash_key     = \"id\"\n101:  attribute {\n102:    name = \"id\"\n103:    type = \"S\"\n104:  }\n105:  point_in_time_recovery { enabled = true }\n106:}\n107:\n108:resource \"aws_dynamodb_table\" \"budgets\" {\n109:  name         = \"clinic-agent-budgets\"\n110:  billing_mode = \"PAY_PER_REQUEST\"\n111:  hash_key     = \"pk\"\n112:  attribute {\n113:    name = \"pk\"\n114:    type = \"S\"\n115:  }\n116:  ttl {\n117:    attribute_name = \"expiresAt\"\n118:    enabled        = true\n119:  }\n120:}\n121:\n122:resource \"aws_dynamodb_table\" \"control\" {\n123:  name         = \"clinic-agent-control\"\n124:  billing_mode = \"PAY_PER_REQUEST\"\n125:  hash_key     = \"pk\"\n126:  attribute {\n127:    name = \"pk\"\n128:    type = \"S\"\n129:  }\n130:  point_in_time_recovery { enabled = true }\n131:}\n132:\n133:# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).\n134:resource \"aws_s3_bucket\" \"audit\" {\n135:  bucket              = \"clinic-agent-audit-${data.aws_caller_identity.current.account_id}\"\n136:  object_lock_enabled = true\n137:}\n138:\n139:resource \"aws_s3_bucket_object_lock_configuration\" \"audit\" {\n140:  bucket = aws_s3_bucket.audit.id\n141:  rule {\n142:    default_retention {\n143:      mode  = \"COMPLIANCE\"\n144:      years = 7\n145:    }\n146:  }\n147:}\n148:\n149:resource \"aws_kinesis_firehose_delivery_stream\" \"audit\" {\n150:  name        = \"clinic-agent-audit\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"3fd11636-4580-4d06-b89e-334cd7c3483c","uuid":"0d6de13b-7d1b-418b-822e-6b656a847462","timestamp":"2026-10-20T12:24:22.412Z","tool_use_result":{"stdout":"     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    16\t      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5.0.0\n    17\t        with:\n    18\t          node-version: \"22.11\"\n    19\t          cache: npm\n    20\t      - run: npm ci --ignore-scripts\n    21\t      - run: npm run lint\n    22\t      - run: npm test\n    23\t      - run: npm run build\n    24\t\n    25\t  manifest-check:\n    26\t    runs-on: ubuntu-24.04\n    27\t    steps:\n    28\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    29\t      - name: Prompt digests match the release manifest\n    30\t        run: |\n    31\t          node -e '\n    32\t            const fs = require(\"fs\"), crypto = require(\"crypto\");\n    33\t            const m = JSON.parse(fs.readFileSync(\"release/manifest.json\", \"utf8\"));\n    34\t            let bad = 0;\n    35\t            for (const p of m.prompts) {\n    36\t              const got = crypto.createHash(\"sha256\").update(fs.readFileSync(p.path)).digest(\"hex\");\n    37\t              if (got !== p.sha256) { console.error(`${p.path}: manifest ${p.sha256} != file ${got}`); bad++; }\n    38\t            }\n    39\t            const ver = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\")).version;\n    40\t            if (m.harness.version !== ver) { console.error(`harness version ${m.harness.version} != package ${ver}`); bad++; }\n    41\t            process.exit(bad ? 1 : 0);\n    42\t          '\n    43\t\n    44\t  image:\n    45\t    if: github.ref == 'refs/heads/main'\n    46\t    needs: [test, manifest-check]\n    47\t    runs-on: ubuntu-24.04\n    48\t    permissions:\n    49\t      contents: read\n    50\t      id-token: write\n    51\t      attestations: write\n    52\t      packages: write\n    53\t    steps:\n    54\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    55\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    56\t        with:\n    57\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-image-build\n    58\t          aws-region: us-west-2\n    59\t      - uses: aws-actions/amazon-ecr-login@062b18b96a7aff071d4dc91bc00c4c1a7945b076 # v2.0.1\n    60\t        id: ecr\n    61\t      - uses: docker/setup-buildx-action@e468171a9de216ec08956ac3ada2f0791b6bd435 # v3.11.1\n    62\t      - uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    63\t        id: build\n    64\t        with:\n    65\t          push: true\n    66\t          tags: ${{ steps.ecr.outputs.registry }}/clinic-agent:${{ github.sha }}\n    67\t          provenance: mode=max\n    68\t          sbom: true\n    69\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    70\t        with:\n    71\t          cosign-release: v2.6.2\n    72\t      - name: Sign image\n    73\t        run: cosign sign --yes ${{ steps.ecr.outputs.registry }}/clinic-agent@${{ steps.build.outputs.digest }}\n    74\t      - uses: actions/attest-build-provenance@977bb373ede98d70efdf65b84cb5f73e068dcc2a # v3.0.0\n    75\t        with:\n    76\t          subject-name: ${{ steps.ecr.outputs.registry }}/clinic-agent\n    77\t          subject-digest: ${{ steps.build.outputs.digest }}\n    78\t          push-to-registry: true\n     1\t{\n     2\t  \"release\": \"clinic-agent-3.4.1\",\n     3\t  \"agentTypeId\": \"sha256:7c2e91f04ab35d6e8f1029c4b7a6d3e5f8091a2b3c4d5e6f708192a3b4c5d6e7\",\n     4\t  \"image\": {\n     5\t    \"repository\": \"418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent\",\n     6\t    \"digest\": \"sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\"\n     7\t  },\n     8\t  \"harness\": {\n     9\t    \"version\": \"3.4.1\",\n    10\t    \"gitSha\": \"e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\"\n    11\t  },\n    12\t  \"prompts\": [\n    13\t    { \"path\": \"prompts/system.md\", \"sha256\": \"5d1e0c9b8a7f6e5d4c3b2a1908f7e6d5c4b3a291807f6e5d4c3b2a19087f6e5d\" },\n    14\t    { \"path\": \"prompts/intent-classifier.txt\", \"sha256\": \"a3f9e1d7c5b3a1f9e7d5c3b1a9f7e5d3c1b9a7f5e3d1c9b7a5f3e1d9c7b5a3f1\" }\n    15\t  ],\n    16\t  \"models\": [\n    17\t    {\n    18\t      \"role\": \"agent\",\n    19\t      \"provider\": \"anthropic\",\n    20\t      \"requestedId\": \"claude-sonnet-4-5-20250929\",\n    21\t      \"kind\": \"pinned_snapshot\",\n    22\t      \"versionDoc\": { \"url\": \"https://docs.anthropic.com/en/docs/about-claude/models/overview\", \"checked\": \"2026-09-15\" },\n    23\t      \"adapter\": null,\n    24\t      \"providerHidden\": [\"weights\", \"training_data\", \"serving_stack\"]\n    25\t    },\n    26\t    {\n    27\t      \"role\": \"intent_classifier\",\n    28\t      \"provider\": \"anthropic\",\n    29\t      \"requestedId\": \"claude-haiku-4-5-20251001\",\n    30\t      \"kind\": \"pinned_snapshot\",\n    31\t      \"versionDoc\": { \"url\": \"https://docs.anthropic.com/en/docs/about-claude/models/overview\", \"checked\": \"2026-09-15\" },\n    32\t      \"adapter\": null,\n    33\t      \"providerHidden\": [\"weights\", \"training_data\", \"serving_stack\"]\n    34\t    }\n    35\t  ],\n    36\t  \"tools\": {\n    37\t    \"allowlist\": \"config/tools.allowlist.yaml\",\n    38\t    \"mcpServers\": [\n    39\t      {\n    40\t        \"id\": \"ehr\",\n    41\t        \"url\": \"https://ehr-mcp.internal.northbay-clinics.example/mcp\",\n    42\t        \"tlsCertSha256\": \"1f6a9c3e5b7d9f1a3c5e7b9d1f3a5c7e9b1d3f5a7c9e1b3d5f7a9c1e3b5d7f9a\",\n    43\t        \"owner\": \"ehr-integrations@northbay-clinics.example\"\n    44\t      }\n    45\t    ],\n    46\t    \"native\": [\"payments\", \"sms\", \"insurance\"]\n    47\t  },\n    48\t  \"peers\": [\n    49\t    {\n    50\t      \"id\": \"eligibility-agent\",\n    51\t      \"url\": \"https://eligibility.partners.northbay-clinics.example/a2a\",\n    52\t      \"owner\": \"revenue-cycle@northbay-clinics.example\"\n    53\t    }\n    54\t  ],\n    55\t  \"permissions\": {\n    56\t    \"awsRole\": \"arn:aws:iam::418295730611:role/clinic-agent-runtime\",\n    57\t    \"ehrScopes\": [\"patient.read\", \"appointment.read\", \"appointment.write\"],\n    58\t    \"paymentsScopes\": [\"deposits.refund\"],\n    59\t    \"eligibilityScopes\": [\"eligibility:read\"]\n    60\t  },\n    61\t  \"memory\": \"none\",\n    62\t  \"retrieval\": \"none\",\n    63\t  \"network\": { \"policy\": \"k8s/deployment.yaml#clinic-agent-egress\", \"egressProxy\": \"egress-proxy.platform.svc:3128\" },\n    64\t  \"budgets\": \"config/budgets.yaml\",\n    65\t  \"policies\": { \"action\": \"config/policy.yaml\", \"actionPolicyVersion\": \"2026-09-18.3\" }\n    66\t}\n     1\t{\n     2\t  \"name\": \"clinic-agent\",\n     3\t  \"version\": \"3.4.1\",\n     4\t  \"private\": true,\n     5\t  \"type\": \"module\",\n     6\t  \"engines\": {\n     7\t    \"node\": \">=22.11\"\n     8\t  },\n     9\t  \"scripts\": {\n    10\t    \"build\": \"tsc -p tsconfig.json\",\n    11\t    \"start\": \"node dist/server.js\",\n    12\t    \"reminders\": \"node dist/workers/reminders.js\",\n    13\t    \"lint\": \"eslint src test\",\n    14\t    \"test\": \"vitest run\"\n    15\t  },\n    16\t  \"dependencies\": {\n    17\t    \"@anthropic-ai/sdk\": \"0.65.0\",\n    18\t    \"@aws-sdk/client-dynamodb\": \"3.893.0\",\n    19\t    \"@aws-sdk/client-firehose\": \"3.893.0\",\n    20\t    \"@aws-sdk/client-secrets-manager\": \"3.893.0\",\n    21\t    \"@aws-sdk/lib-dynamodb\": \"3.893.0\",\n    22\t    \"@modelcontextprotocol/sdk\": \"1.18.2\",\n    23\t    \"fastify\": \"5.6.1\",\n    24\t    \"jose\": \"6.1.0\",\n    25\t    \"pino\": \"9.11.0\",\n    26\t    \"undici\": \"7.16.0\",\n    27\t    \"yaml\": \"2.8.1\",\n    28\t    \"zod\": \"3.25.76\"\n    29\t  },\n    30\t  \"devDependencies\": {\n    31\t    \"@types/node\": \"22.18.6\",\n    32\t    \"eslint\": \"9.36.0\",\n    33\t    \"typescript\": \"5.9.2\",\n    34\t    \"typescript-eslint\": \"8.44.1\",\n    35\t    \"vitest\": \"3.2.4\"\n    36\t  }\n    37\t}\n     1\t# clinic-agent\n     2\t\n     3\tPatient-scheduling agent for the Northbay Clinic Group. Patients reach it by SMS or by the web chat\n     4\twidget on each clinic's site. It looks up, books, reschedules, and cancels appointments in the EHR,\n     5\tsends SMS reminders, refunds no-show deposits, and asks the insurance-eligibility agent whether a\n     6\tvisit is covered.\n     7\t\n     8\tEach clinic is a tenant. A clinic's patients, appointments, deposits, and EHR credentials are kept\n     9\tseparate from every other clinic's.\n    10\t\n    11\t## Components\n    12\t\n    13\t| Piece | Where | Notes |\n    14\t|---|---|---|\n    15\t| HTTP service (Fastify) | `src/server.ts` | `/v1/sms/inbound` webhook, `/v1/chat` web chat |\n    16\t| Agent loop | `src/agent/loop.ts` | Claude Sonnet 4.5 snapshot, tool use |\n    17\t| Intent classifier | `src/agent/classifier.ts` | Claude Haiku 4.5 snapshot, routes emergencies and complaints to staff |\n    18\t| Tool registry | `src/tools/registry.ts` | EHR MCP server plus native tools, scanned on load |\n    19\t| Tool executor | `src/tools/executor.ts` | allowlist, kill switch, budgets, approvals, audit |\n    20\t| EHR | `src/integrations/ehr-mcp.ts` | MCP over streamable HTTP with mTLS, per-clinic OAuth client |\n    21\t| Payments | `src/integrations/payments.ts` | deposit refunds, provider idempotency keys |\n    22\t| SMS | `src/integrations/sms.ts` | outbound reminders and replies |\n    23\t| Eligibility peer | `src/integrations/eligibility-a2a.ts` | A2A `message/send`, token exchange per call |\n    24\t| Reminder job | `src/workers/reminders.ts` | Kubernetes CronJob, 17:00 local each day |\n    25\t\n    26\tThere is no vector store and no conversation memory. Every run starts from the patient's message and\n    27\tthe EHR. Conversation transcripts are not stored by this service.\n    28\t\n    29\t## High-impact actions\n    30\t\n    31\t`config/policy.yaml` lists the tools that need a staff approval before they run. The agent asks for\n    32\tthe approval, a front-desk lead or clinic manager approves it in the staff console, and the agent\n    33\tretries with the approval ID. Approvals expire after 15 minutes.\n    34\t\n    35\t## Stopping the agent\n    36\t\n    37\tOperators with the `clinic-agent-ops` role set `halted = true` on the `global` item (all clinics) or a\n    38\t`tenant#<clinicId>` item in the `clinic-agent-control` DynamoDB table:\n    39\t\n    40\t```bash\n    41\taws dynamodb put-item --table-name clinic-agent-control \\\n    42\t  --item '{\"pk\":{\"S\":\"global\"},\"halted\":{\"BOOL\":true},\"by\":{\"S\":\"<you>\"}}'\n    43\t```\n    44\t\n    45\tRunning work checks the flag before each model turn and each tool call, and a watcher aborts in-flight\n    46\trequests within 2 seconds.\n    47\t\n    48\t## Identity\n    49\t\n    50\t`src/agent/identity.ts` computes the agent-type-id from the image digest, harness version, prompts,\n    51\tmodel IDs, and config. Each pod also gets a random agent-instance-id at start. Both are on every\n    52\taudit record together with the accountable party, operational owner, tenant, and trace context.\n    53\t\n    54\t## Build and test\n    55\t\n    56\t```bash\n    57\tnpm ci\n    58\tnpm run lint\n    59\tnpm test\n    60\tnpm run build\n    61\t```\n    62\t\n    63\t## Release\n    64\t\n    65\tMerges to `main` need two reviews and a code owner review for prompts, config, infra, and manifests.\n    66\t`deploy.yml` builds, signs, and deploys by digest to the `production` environment, which has required\n    67\treviewers. Emergency deploys use the same workflow with `emergency: true` and must name an owner,\n    68\ta reason, and an end date; the workflow opens a follow-up review issue.\n    69\t\n    70\t## Owners\n    71\t\n    72\t- Accountable party: Northbay Clinic Group, Patient Access (VP Patient Access)\n    73\t- Operational owner: agent-platform team, `#agent-platform-oncall`\n     1\t# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\n     2\tpolicyVersion: \"2026-09-18.3\"\n     3\t\n     4\t# Tools that never run without a staff approval bound to the request.\n     5\thighImpactTools:\n     6\t  - ehr__cancel_appointment\n     7\t  - payments__refund_deposit\n     8\t  - sms__send_freeform\n     9\t\n    10\tapproval:\n    11\t  ttlSeconds: 900\n    12\t  approverRoles:\n    13\t    - front_desk_lead\n    14\t    - clinic_manager\n    15\t  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n    16\t  table: clinic-agent-approvals\n     1\t# Every tool the scheduling agent may call, with the task it serves.\n     2\t# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n     3\t# are not used for allow or approval decisions.\n     4\trole: scheduling_agent\n     5\ttools:\n     6\t  - tool: ehr__find_patient\n     7\t    reason: Match the sender to a patient record by date of birth and phone or email.\n     8\t  - tool: ehr__search_slots\n     9\t    reason: List open slots for a provider, location, and visit type.\n    10\t  - tool: ehr__get_appointment\n    11\t    reason: Read one appointment the patient asks about.\n    12\t  - tool: ehr__list_patient_appointments\n    13\t    reason: Show the patient their upcoming appointments.\n    14\t  - tool: ehr__book_appointment\n    15\t    reason: Book a slot the patient chose.\n    16\t  - tool: ehr__update_appointment\n    17\t    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n    18\t  - tool: ehr__cancel_appointment\n    19\t    reason: Cancel an appointment at the patient's request.\n    20\t  - tool: payments__refund_deposit\n    21\t    reason: Refund a no-show deposit after staff review.\n    22\t  - tool: sms__send_to_patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.\n1:terraform {\n2:  required_version = \">= 1.9.0\"\n3:  required_providers {\n4:    aws    = { source = \"hashicorp/aws\", version = \"~> 6.14\" }\n5:    github = { source = \"integrations/github\", version = \"~> 6.6\" }\n6:  }\n7:  backend \"s3\" {\n8:    bucket         = \"northbay-tfstate-418295730611\"\n9:    key            = \"clinic-agent/prod.tfstate\"\n10:    region         = \"us-west-2\"\n11:    dynamodb_table = \"northbay-tf-locks\"\n12:    encrypt        = true\n13:  }\n14:}\n15:\n16:provider \"aws\" {\n17:  region = var.region\n18:  default_tags {\n19:    tags = { app = \"clinic-agent\", owner = \"agent-platform\", data = \"phi\" }\n20:  }\n21:}\n22:\n23:variable \"region\" {\n24:  type    = string\n25:  default = \"us-west-2\"\n26:}\n27:\n28:variable \"clinic_ids\" {\n29:  type    = list(string)\n30:  default = [\"nb-castro\", \"nb-fremont\", \"nb-oakland\", \"nb-sanmateo\", \"nb-walnutcreek\"]\n31:}\n32:\n33:data \"aws_caller_identity\" \"current\" {}\n34:\n35:module \"eks\" {\n36:  source  = \"terraform-aws-modules/eks/aws\"\n37:  version = \"21.3.1\"\n38:\n39:  name               = \"clinic-agent-prod\"\n40:  kubernetes_version = \"1.33\"\n41:  vpc_id             = module.vpc.vpc_id\n42:  subnet_ids         = module.vpc.private_subnets\n43:\n44:  endpoint_public_access = false\n45:  enable_irsa            = true\n46:\n47:  authentication_mode = \"API\"\n48:  access_entries = {\n49:    deploy = {\n50:      principal_arn = aws_iam_role.deploy.arn\n51:      policy_associations = {\n52:        ns = {\n53:          policy_arn   = \"arn:aws:eks::aws:cluster-access-policy/AmazonEKSEditPolicy\"\n54:          access_scope = { type = \"namespace\", namespaces = [\"clinic-agent\"] }\n55:        }\n56:      }\n57:    }\n58:  }\n59:\n60:  eks_managed_node_groups = {\n61:    agents = {\n62:      instance_types = [\"m7g.large\"]\n63:      ami_type       = \"BOTTLEROCKET_ARM_64\"\n64:      min_size       = 2\n65:      max_size       = 6\n66:      desired_size   = 3\n67:      metadata_options = {\n68:        http_tokens                 = \"required\"\n69:        http_put_response_hop_limit = 1\n70:      }\n71:    }\n72:  }\n73:}\n74:\n75:module \"vpc\" {\n76:  source  = \"terraform-aws-modules/vpc/aws\"\n77:  version = \"6.4.0\"\n78:\n79:  name            = \"clinic-agent-prod\"\n80:  cidr            = \"10.42.0.0/16\"\n81:  azs             = [\"us-west-2a\", \"us-west-2b\", \"us-west-2c\"]\n82:  private_subnets = [\"10.42.1.0/24\", \"10.42.2.0/24\", \"10.42.3.0/24\"]\n83:  public_subnets  = [\"10.42.101.0/24\", \"10.42.102.0/24\", \"10.42.103.0/24\"]\n84:\n85:  enable_nat_gateway = true\n86:  single_nat_gateway = false\n87:}\n88:\n89:resource \"aws_ecr_repository\" \"agent\" {\n90:  name                 = \"clinic-agent\"\n91:  image_tag_mutability = \"IMMUTABLE\"\n92:  image_scanning_configuration { scan_on_push = true }\n93:}\n94:\n95:# State tables. Approvals are written by the staff console; budgets by the agent; the control\n96:# table holds the stop flags operators set.\n97:resource \"aws_dynamodb_table\" \"approvals\" {\n98:  name         = \"clinic-agent-approvals\"\n99:  billing_mode = \"PAY_PER_REQUEST\"\n100:  hash_key     = \"id\"\n101:  attribute {\n102:    name = \"id\"\n103:    type = \"S\"\n104:  }\n105:  point_in_time_recovery { enabled = true }\n106:}\n107:\n108:resource \"aws_dynamodb_table\" \"budgets\" {\n109:  name         = \"clinic-agent-budgets\"\n110:  billing_mode = \"PAY_PER_REQUEST\"\n111:  hash_key     = \"pk\"\n112:  attribute {\n113:    name = \"pk\"\n114:    type = \"S\"\n115:  }\n116:  ttl {\n117:    attribute_name = \"expiresAt\"\n118:    enabled        = true\n119:  }\n120:}\n121:\n122:resource \"aws_dynamodb_table\" \"control\" {\n123:  name         = \"clinic-agent-control\"\n124:  billing_mode = \"PAY_PER_REQUEST\"\n125:  hash_key     = \"pk\"\n126:  attribute {\n127:    name = \"pk\"\n128:    type = \"S\"\n129:  }\n130:  point_in_time_recovery { enabled = true }\n131:}\n132:\n133:# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).\n134:resource \"aws_s3_bucket\" \"audit\" {\n135:  bucket              = \"clinic-agent-audit-${data.aws_caller_identity.current.account_id}\"\n136:  object_lock_enabled = true\n137:}\n138:\n139:resource \"aws_s3_bucket_object_lock_configuration\" \"audit\" {\n140:  bucket = aws_s3_bucket.audit.id\n141:  rule {\n142:    default_retention {\n143:      mode  = \"COMPLIANCE\"\n144:      years = 7\n145:    }\n146:  }\n147:}\n148:\n149:resource \"aws_kinesis_firehose_delivery_stream\" \"audit\" {\n150:  name        = \"clinic-agent-audit\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_012yxaDRnWK8TxmedAgubiHh","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
