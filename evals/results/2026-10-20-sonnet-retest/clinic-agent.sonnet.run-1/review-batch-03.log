{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDV1oNSBX7byKoKgjRRx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012R1qPTA9nkFGnGbJyfB2Hf","name":"Bash","input":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-3mn5k2_w/agent/src; cat -n agent/loop.ts agent/classifier.ts tools/executor.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9084,"cache_read_input_tokens":37035,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9084},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3fd11636-4580-4d06-b89e-334cd7c3483c","uuid":"1840b6c2-2e35-440d-919c-9b752f9fd14a","timestamp":"2026-10-20T12:24:28.287Z","request_id":"req_011CgDV1o5pgVF7wLc9XYeyc","wire_tool_inputs":{"toolu_012R1qPTA9nkFGnGbJyfB2Hf":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-3mn5k2_w/agent/src; cat -n agent/loop.ts agent/classifier.ts tools/executor.ts"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012R1qPTA9nkFGnGbJyfB2Hf","type":"tool_result","content":"     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { createHash } from \"node:crypto\";\n     3\timport { readFileSync } from \"node:fs\";\n     4\timport { join } from \"node:path\";\n     5\timport { z } from \"zod\";\n     6\timport { CLASSIFIER_MODEL, ROOT } from \"../config.js\";\n     7\t\n     8\t// Helper model that routes messages before the agent sees them. Urgent and complaint messages go\n     9\t// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\n    10\t// malformed output, unknown label, or a served model other than the pinned snapshot) routes the\n    11\t// message to staff. A failed classifier never defaults to \"send it to the agent\".\n    12\t\n    13\texport const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");\n    14\texport const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\n    15\t\n    16\texport const CLASSIFIER_ID = `sha256:${createHash(\"sha256\")\n    17\t  .update(CLASSIFIER_MODEL)\n    18\t  .update(\"\\0\")\n    19\t  .update(CLASSIFIER_PROMPT)\n    20\t  .update(\"\\0\")\n    21\t  .update(JSON.stringify(CLASSIFIER_CONFIG))\n    22\t  .digest(\"hex\")}`;\n    23\t\n    24\tconst Intent = z.enum([\"book\", \"reschedule\", \"cancel\", \"confirm\", \"coverage\", \"info\", \"urgent\", \"complaint\", \"other\"]);\n    25\tconst Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();\n    26\t\n    27\texport type Route = \"agent\" | \"staff\";\n    28\t\n    29\texport interface ClassifierDecision {\n    30\t  classifierId: string;\n    31\t  requestedModel: string;\n    32\t  servedModel: string | null;\n    33\t  intent: z.infer<typeof Intent> | null;\n    34\t  confidence: number | null;\n    35\t  route: Route;\n    36\t  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n    37\t}\n    38\t\n    39\tconst MIN_CONFIDENCE = 0.6;\n    40\t\n    41\texport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n    42\t  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n    43\t  let res: Anthropic.Message;\n    44\t  try {\n    45\t    res = await client.messages.create(\n    46\t      {\n    47\t        model: CLASSIFIER_MODEL,\n    48\t        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n    49\t        temperature: CLASSIFIER_CONFIG.temperature,\n    50\t        system: CLASSIFIER_PROMPT,\n    51\t        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n    52\t      },\n    53\t      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n    54\t    );\n    55\t  } catch (err) {\n    56\t    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n    57\t    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n    58\t  }\n    59\t\n    60\t  if (res.model !== CLASSIFIER_MODEL) {\n    61\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n    62\t  }\n    63\t\n    64\t  const textOut = res.content.find((b) => b.type === \"text\");\n    65\t  let parsed: z.infer<typeof Output>;\n    66\t  try {\n    67\t    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n    68\t  } catch {\n    69\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n    70\t  }\n    71\t\n    72\t  if (parsed.confidence < MIN_CONFIDENCE) {\n    73\t    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n    74\t  }\n    75\t  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n    76\t  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n    77\t}\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { allowlist, policy } from \"../config.js\";\n     3\timport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\n     4\timport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\n     5\timport type { ContextSize } from \"../agent/context-size.js\";\n     6\timport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\n     7\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     8\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     9\timport { payments } from \"../integrations/payments.js\";\n    10\timport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\n    11\timport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\n    12\timport { checkApproval, requestApproval } from \"./approvals.js\";\n    13\timport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n    14\t\n    15\texport interface Decision {\n    16\t  contextSize: ContextSize;\n    17\t  budget: RunBudget;\n    18\t}\n    19\t\n    20\tconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n    21\t// Arguments the harness consumes itself; they are never forwarded to a tool.\n    22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n    23\t\n    24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n    25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n    26\t}\n    27\t\n    28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n    29\t  return `${tool}(${Object.entries(args)\n    30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    31\t    .join(\", \")})`.slice(0, 500);\n    32\t}\n    33\t\n    34\texport async function executeTool(\n    35\t  registry: ToolRegistry,\n    36\t  ctx: RunContext,\n    37\t  call: Anthropic.ToolUseBlock,\n    38\t  d: Decision,\n    39\t): Promise<Anthropic.ToolResultBlockParam> {\n    40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n    41\t  const base = {\n    42\t    ...ctx.identity(),\n    43\t    runId: ctx.runId,\n    44\t    subject: ctx.subject,\n    45\t    tool: call.name,\n    46\t    toolUseId: call.id,\n    47\t    policyVersion: policy.version,\n    48\t    context: d.contextSize,\n    49\t  };\n    50\t  const deny = async (reason: string) => {\n    51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n    52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n    53\t  };\n    54\t\n    55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n    56\t  const tool = registry.get(call.name);\n    57\t  if (!tool) return deny(\"not_registered\");\n    58\t\n    59\t  await killSwitch.assertRunning(ctx.tenantId);\n    60\t  await d.budget.toolCall(call.name);\n    61\t\n    62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n    63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n    64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n    65\t\n    66\t  let approvalId: string | undefined;\n    67\t  if (policy.highImpactTools.includes(call.name)) {\n    68\t    if (typeof input.approvalId !== \"string\") {\n    69\t      const rec = await requestApproval({\n    70\t        tool: call.name,\n    71\t        tenantId: clinicId,\n    72\t        agentInstanceId: AGENT_INSTANCE_ID,\n    73\t        runId: ctx.runId,\n    74\t        args,\n    75\t        summary: summarize(call.name, args),\n    76\t      });\n    77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n    78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    79\t    }\n    80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    81\t    if (!check.ok) return deny(check.reason);\n    82\t    approvalId = check.approval.id;\n    83\t  }\n    84\t\n    85\t  try {\n    86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    88\t    const safe = redactPhi(raw);\n    89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    90\t    return toolResult(call.id, safe);\n    91\t  } catch (err) {\n    92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n    95\t  }\n    96\t}\n    97\t\n    98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n    99\t\n   100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n   101\t  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n   102\t    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n   103\t\n   104\t  return {\n   105\t    payments: [\n   106\t      {\n   107\t        name: \"refund_deposit\",\n   108\t        definition: {\n   109\t          name: \"payments__refund_deposit\",\n   110\t          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n   111\t          input_schema: {\n   112\t            type: \"object\",\n   113\t            properties: {\n   114\t              depositId: { type: \"string\" },\n   115\t              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n   116\t              approvalId: { type: \"string\" },\n   117\t            },\n   118\t            required: [\"depositId\", \"reason\"],\n   119\t          },\n   120\t        },\n   121\t        invoke: async (a, o) =>\n   122\t          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n   123\t      },\n   124\t    ],\n   125\t    sms: [\n   126\t      {\n   127\t        name: \"send_to_patient\",\n   128\t        definition: {\n   129\t          name: \"sms__send_to_patient\",\n   130\t          description: \"Send a templated SMS to the phone number on the patient's record.\",\n   131\t          input_schema: {\n   132\t            type: \"object\",\n   133\t            properties: {\n   134\t              patientId: { type: \"string\" },\n   135\t              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n   136\t              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n   137\t            },\n   138\t            required: [\"patientId\", \"template\"],\n   139\t          },\n   140\t        },\n   141\t        invoke: async (a, o) => {\n   142\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   143\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   144\t          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n   145\t          return sms.send(o.clinicId, c.phone, body, o.signal);\n   146\t        },\n   147\t      },\n   148\t      {\n   149\t        name: \"send_freeform\",\n   150\t        definition: {\n   151\t          name: \"sms__send_freeform\",\n   152\t          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n   153\t          input_schema: {\n   154\t            type: \"object\",\n   155\t            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n   156\t            required: [\"patientId\", \"body\"],\n   157\t          },\n   158\t        },\n   159\t        invoke: async (a, o) => {\n   160\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   161\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   162\t          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n   163\t        },\n   164\t      },\n   165\t    ],\n   166\t    insurance: [\n   167\t      {\n   168\t        name: \"check_eligibility\",\n   169\t        definition: {\n   170\t          name: \"insurance__check_eligibility\",\n   171\t          description: \"Check whether the patient's insurance covers an appointment.\",\n   172\t          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n   173\t        },\n   174\t        invoke: async (a, o) =>\n   175\t          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n   176\t            clinicId: o.clinicId,\n   177\t            ctx: o.runCtx as RunContext,\n   178\t            signal: o.signal,\n   179\t            context: o.context,\n   180\t          }),\n   181\t      },\n   182\t    ],\n   183\t  };\n   184\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"3fd11636-4580-4d06-b89e-334cd7c3483c","uuid":"2f8f510c-0054-46c1-832b-b8e68c30a0ef","timestamp":"2026-10-20T12:24:28.312Z","tool_use_result":{"stdout":"     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { createHash } from \"node:crypto\";\n     3\timport { readFileSync } from \"node:fs\";\n     4\timport { join } from \"node:path\";\n     5\timport { z } from \"zod\";\n     6\timport { CLASSIFIER_MODEL, ROOT } from \"../config.js\";\n     7\t\n     8\t// Helper model that routes messages before the agent sees them. Urgent and complaint messages go\n     9\t// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\n    10\t// malformed output, unknown label, or a served model other than the pinned snapshot) routes the\n    11\t// message to staff. A failed classifier never defaults to \"send it to the agent\".\n    12\t\n    13\texport const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");\n    14\texport const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\n    15\t\n    16\texport const CLASSIFIER_ID = `sha256:${createHash(\"sha256\")\n    17\t  .update(CLASSIFIER_MODEL)\n    18\t  .update(\"\\0\")\n    19\t  .update(CLASSIFIER_PROMPT)\n    20\t  .update(\"\\0\")\n    21\t  .update(JSON.stringify(CLASSIFIER_CONFIG))\n    22\t  .digest(\"hex\")}`;\n    23\t\n    24\tconst Intent = z.enum([\"book\", \"reschedule\", \"cancel\", \"confirm\", \"coverage\", \"info\", \"urgent\", \"complaint\", \"other\"]);\n    25\tconst Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();\n    26\t\n    27\texport type Route = \"agent\" | \"staff\";\n    28\t\n    29\texport interface ClassifierDecision {\n    30\t  classifierId: string;\n    31\t  requestedModel: string;\n    32\t  servedModel: string | null;\n    33\t  intent: z.infer<typeof Intent> | null;\n    34\t  confidence: number | null;\n    35\t  route: Route;\n    36\t  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n    37\t}\n    38\t\n    39\tconst MIN_CONFIDENCE = 0.6;\n    40\t\n    41\texport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n    42\t  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n    43\t  let res: Anthropic.Message;\n    44\t  try {\n    45\t    res = await client.messages.create(\n    46\t      {\n    47\t        model: CLASSIFIER_MODEL,\n    48\t        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n    49\t        temperature: CLASSIFIER_CONFIG.temperature,\n    50\t        system: CLASSIFIER_PROMPT,\n    51\t        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n    52\t      },\n    53\t      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n    54\t    );\n    55\t  } catch (err) {\n    56\t    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n    57\t    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n    58\t  }\n    59\t\n    60\t  if (res.model !== CLASSIFIER_MODEL) {\n    61\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n    62\t  }\n    63\t\n    64\t  const textOut = res.content.find((b) => b.type === \"text\");\n    65\t  let parsed: z.infer<typeof Output>;\n    66\t  try {\n    67\t    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n    68\t  } catch {\n    69\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n    70\t  }\n    71\t\n    72\t  if (parsed.confidence < MIN_CONFIDENCE) {\n    73\t    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n    74\t  }\n    75\t  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n    76\t  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n    77\t}\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { allowlist, policy } from \"../config.js\";\n     3\timport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\n     4\timport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\n     5\timport type { ContextSize } from \"../agent/context-size.js\";\n     6\timport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\n     7\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     8\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     9\timport { payments } from \"../integrations/payments.js\";\n    10\timport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\n    11\timport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\n    12\timport { checkApproval, requestApproval } from \"./approvals.js\";\n    13\timport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n    14\t\n    15\texport interface Decision {\n    16\t  contextSize: ContextSize;\n    17\t  budget: RunBudget;\n    18\t}\n    19\t\n    20\tconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n    21\t// Arguments the harness consumes itself; they are never forwarded to a tool.\n    22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n    23\t\n    24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n    25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n    26\t}\n    27\t\n    28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n    29\t  return `${tool}(${Object.entries(args)\n    30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    31\t    .join(\", \")})`.slice(0, 500);\n    32\t}\n    33\t\n    34\texport async function executeTool(\n    35\t  registry: ToolRegistry,\n    36\t  ctx: RunContext,\n    37\t  call: Anthropic.ToolUseBlock,\n    38\t  d: Decision,\n    39\t): Promise<Anthropic.ToolResultBlockParam> {\n    40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n    41\t  const base = {\n    42\t    ...ctx.identity(),\n    43\t    runId: ctx.runId,\n    44\t    subject: ctx.subject,\n    45\t    tool: call.name,\n    46\t    toolUseId: call.id,\n    47\t    policyVersion: policy.version,\n    48\t    context: d.contextSize,\n    49\t  };\n    50\t  const deny = async (reason: string) => {\n    51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n    52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n    53\t  };\n    54\t\n    55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n    56\t  const tool = registry.get(call.name);\n    57\t  if (!tool) return deny(\"not_registered\");\n    58\t\n    59\t  await killSwitch.assertRunning(ctx.tenantId);\n    60\t  await d.budget.toolCall(call.name);\n    61\t\n    62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n    63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n    64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n    65\t\n    66\t  let approvalId: string | undefined;\n    67\t  if (policy.highImpactTools.includes(call.name)) {\n    68\t    if (typeof input.approvalId !== \"string\") {\n    69\t      const rec = await requestApproval({\n    70\t        tool: call.name,\n    71\t        tenantId: clinicId,\n    72\t        agentInstanceId: AGENT_INSTANCE_ID,\n    73\t        runId: ctx.runId,\n    74\t        args,\n    75\t        summary: summarize(call.name, args),\n    76\t      });\n    77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n    78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    79\t    }\n    80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    81\t    if (!check.ok) return deny(check.reason);\n    82\t    approvalId = check.approval.id;\n    83\t  }\n    84\t\n    85\t  try {\n    86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    88\t    const safe = redactPhi(raw);\n    89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    90\t    return toolResult(call.id, safe);\n    91\t  } catch (err) {\n    92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n    95\t  }\n    96\t}\n    97\t\n    98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n    99\t\n   100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n   101\t  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n   102\t    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n   103\t\n   104\t  return {\n   105\t    payments: [\n   106\t      {\n   107\t        name: \"refund_deposit\",\n   108\t        definition: {\n   109\t          name: \"payments__refund_deposit\",\n   110\t          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n   111\t          input_schema: {\n   112\t            type: \"object\",\n   113\t            properties: {\n   114\t              depositId: { type: \"string\" },\n   115\t              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n   116\t              approvalId: { type: \"string\" },\n   117\t            },\n   118\t            required: [\"depositId\", \"reason\"],\n   119\t          },\n   120\t        },\n   121\t        invoke: async (a, o) =>\n   122\t          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n   123\t      },\n   124\t    ],\n   125\t    sms: [\n   126\t      {\n   127\t        name: \"send_to_patient\",\n   128\t        definition: {\n   129\t          name: \"sms__send_to_patient\",\n   130\t          description: \"Send a templated SMS to the phone number on the patient's record.\",\n   131\t          input_schema: {\n   132\t            type: \"object\",\n   133\t            properties: {\n   134\t              patientId: { type: \"string\" },\n   135\t              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n   136\t              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n   137\t            },\n   138\t            required: [\"patientId\", \"template\"],\n   139\t          },\n   140\t        },\n   141\t        invoke: async (a, o) => {\n   142\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   143\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   144\t          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n   145\t          return sms.send(o.clinicId, c.phone, body, o.signal);\n   146\t        },\n   147\t      },\n   148\t      {\n   149\t        name: \"send_freeform\",\n   150\t        definition: {\n   151\t          name: \"sms__send_freeform\",\n   152\t          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n   153\t          input_schema: {\n   154\t            type: \"object\",\n   155\t            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n   156\t            required: [\"patientId\", \"body\"],\n   157\t          },\n   158\t        },\n   159\t        invoke: async (a, o) => {\n   160\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   161\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   162\t          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n   163\t        },\n   164\t      },\n   165\t    ],\n   166\t    insurance: [\n   167\t      {\n   168\t        name: \"check_eligibility\",\n   169\t        definition: {\n   170\t          name: \"insurance__check_eligibility\",\n   171\t          description: \"Check whether the patient's insurance covers an appointment.\",\n   172\t          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n   173\t        },\n   174\t        invoke: async (a, o) =>\n   175\t          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n   176\t            clinicId: o.clinicId,\n   177\t            ctx: o.runCtx as RunContext,\n   178\t            signal: o.signal,\n   179\t            context: o.context,\n   180\t          }),\n   181\t      },\n   182\t    ],\n   183\t  };\n   184\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_012R1qPTA9nkFGnGbJyfB2Hf","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDV1oNSBX7byKoKgjRRx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Fn9bSkkVV7EWCJZsmhNV6r","name":"Bash","input":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-3mn5k2_w/agent/src; cat -n tools/registry.ts tools/metadata-scan.ts routes/*.ts server.ts agent/context-size.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9084,"cache_read_input_tokens":37035,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9084},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3fd11636-4580-4d06-b89e-334cd7c3483c","uuid":"b461a8de-1939-4abc-b1a3-5448b31739e6","timestamp":"2026-10-20T12:24:29.574Z","request_id":"req_011CgDV1o5pgVF7wLc9XYeyc","wire_tool_inputs":{"toolu_01Fn9bSkkVV7EWCJZsmhNV6r":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-3mn5k2_w/agent/src; cat -n tools/registry.ts tools/metadata-scan.ts routes/*.ts server.ts agent/context-size.ts"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fn9bSkkVV7EWCJZsmhNV6r","type":"tool_result","content":"     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport type { ContextSize } from \"../agent/context-size.js\";\n     3\timport { scanServer, type ServerMeta, type ToolMeta } from \"./metadata-scan.js\";\n     4\t\n     5\t// Tool identity is \"<serverId>__<toolName>\", where serverId is the id this deployment assigned in\n     6\t// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about\n     7\t// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.\n     8\t// Only servers listed in the manifest can contribute tools.\n     9\t\n    10\texport interface ConfiguredServer {\n    11\t  id: string;\n    12\t  url: string;\n    13\t  tlsCertSha256: string;\n    14\t}\n    15\t\n    16\texport interface InvokeOptions {\n    17\t  clinicId: string;\n    18\t  signal: AbortSignal;\n    19\t  runCtx: unknown;\n    20\t  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */\n    21\t  context: ContextSize;\n    22\t}\n    23\t\n    24\texport interface RegisteredTool {\n    25\t  key: string;\n    26\t  serverId: string;\n    27\t  name: string;\n    28\t  definition: Anthropic.Tool;\n    29\t  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;\n    30\t}\n    31\t\n    32\texport interface Conflict {\n    33\t  key: string;\n    34\t  conflictsWith: string;\n    35\t  kind: \"duplicate\" | \"lookalike\";\n    36\t}\n    37\t\n    38\tconst CONFUSABLES: Record<string, string> = { \"0\": \"o\", \"1\": \"l\", \"3\": \"e\", \"5\": \"s\", \"7\": \"t\", \"@\": \"a\", \"$\": \"s\" };\n    39\t\n    40\texport function canonical(name: string): string {\n    41\t  return name\n    42\t    .normalize(\"NFKC\")\n    43\t    .toLowerCase()\n    44\t    .replace(/rn/g, \"m\")\n    45\t    .replace(/vv/g, \"w\")\n    46\t    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)\n    47\t    .replace(/[^a-z]/g, \"\");\n    48\t}\n    49\t\n    50\tfunction editDistanceAtMostOne(a: string, b: string): boolean {\n    51\t  if (a === b) return true;\n    52\t  if (Math.abs(a.length - b.length) > 1) return false;\n    53\t  let i = 0;\n    54\t  let j = 0;\n    55\t  let edits = 0;\n    56\t  while (i < a.length && j < b.length) {\n    57\t    if (a[i] === b[j]) {\n    58\t      i++;\n    59\t      j++;\n    60\t      continue;\n    61\t    }\n    62\t    if (++edits > 1) return false;\n    63\t    if (a.length > b.length) i++;\n    64\t    else if (b.length > a.length) j++;\n    65\t    else {\n    66\t      i++;\n    67\t      j++;\n    68\t    }\n    69\t  }\n    70\t  return edits + (a.length - i) + (b.length - j) <= 1;\n    71\t}\n    72\t\n    73\texport class ToolRegistry {\n    74\t  private tools = new Map<string, RegisteredTool>();\n    75\t  readonly conflicts: Conflict[] = [];\n    76\t  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];\n    77\t\n    78\t  constructor(private servers: ConfiguredServer[]) {}\n    79\t\n    80\t  get(key: string): RegisteredTool | undefined {\n    81\t    return this.tools.get(key);\n    82\t  }\n    83\t\n    84\t  definitions(): Anthropic.Tool[] {\n    85\t    return [...this.tools.values()].map((t) => t.definition);\n    86\t  }\n    87\t\n    88\t  bareNamesExcept(serverId: string): Set<string> {\n    89\t    return new Set([...this.tools.values()].filter((t) => t.serverId !== serverId).map((t) => t.name));\n    90\t  }\n    91\t\n    92\t  /** Native tools are registered first so MCP metadata that names them is caught by the scanner. */\n    93\t  registerNative(serverId: string, tools: Array<Omit<RegisteredTool, \"key\" | \"serverId\">>): void {\n    94\t    for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\n    95\t  }\n    96\t\n    97\t  /**\n    98\t   * serverId must be one of the configured servers, and the caller must have connected using that\n    99\t   * server's pinned URL and certificate. reportedName is informational only.\n   100\t   */\n   101\t  registerMcp(\n   102\t    serverId: string,\n   103\t    reportedName: string | undefined,\n   104\t    meta: ServerMeta,\n   105\t    invoke: (tool: string, input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>,\n   106\t  ): void {\n   107\t    const cfg = this.servers.find((s) => s.id === serverId);\n   108\t    if (!cfg) {\n   109\t      this.rejected.push({ serverId, reason: `server not in release manifest (reported name ${reportedName ?? \"none\"})` });\n   110\t      return;\n   111\t    }\n   112\t    let scan;\n   113\t    try {\n   114\t      scan = scanServer(meta, this.bareNamesExcept(serverId));\n   115\t    } catch (err) {\n   116\t      this.rejected.push({ serverId, reason: `metadata scan error: ${(err as Error).message}` });\n   117\t      return;\n   118\t    }\n   119\t    if (scan.serverRejected) {\n   120\t      this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });\n   121\t      return;\n   122\t    }\n   123\t    for (const [tool, findings] of scan.rejectedTools) {\n   124\t      this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });\n   125\t    }\n   126\t    for (const t of scan.acceptedTools) {\n   127\t      this.add({\n   128\t        key: `${serverId}__${t.name}`,\n   129\t        serverId,\n   130\t        name: t.name,\n   131\t        definition: toDefinition(`${serverId}__${t.name}`, t),\n   132\t        invoke: (input, opts) => invoke(t.name, input, opts),\n   133\t      });\n   134\t    }\n   135\t  }\n   136\t\n   137\t  private add(t: RegisteredTool): void {\n   138\t    if (this.tools.has(t.key)) {\n   139\t      this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: \"duplicate\" });\n   140\t      this.rejected.push({ serverId: t.serverId, tool: t.name, reason: \"duplicate tool key\" });\n   141\t      return;\n   142\t    }\n   143\t    const c = canonical(t.name);\n   144\t    for (const existing of this.tools.values()) {\n   145\t      if (existing.serverId === t.serverId) continue;\n   146\t      if (existing.name === t.name) {\n   147\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"duplicate\" });\n   148\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });\n   149\t        return;\n   150\t      }\n   151\t      if (editDistanceAtMostOne(canonical(existing.name), c)) {\n   152\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"lookalike\" });\n   153\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `looks like ${existing.key}` });\n   154\t        return;\n   155\t      }\n   156\t    }\n   157\t    this.tools.set(t.key, t);\n   158\t  }\n   159\t}\n   160\t\n   161\tfunction toDefinition(key: string, t: ToolMeta): Anthropic.Tool {\n   162\t  return {\n   163\t    name: key,\n   164\t    description: t.description ?? \"\",\n   165\t    input_schema: (t.inputSchema as Anthropic.Tool.InputSchema) ?? { type: \"object\", properties: {} },\n   166\t  };\n   167\t}\n     1\t// Scans MCP server metadata before any of it reaches the model.\n     2\t//\n     3\t// Covered fields: server instructions, tool name, title, description, every string inside the\n     4\t// input and output schemas (titles, descriptions, enum values, defaults, examples), annotations,\n     5\t// prompt names/descriptions/argument descriptions, and resource template names/descriptions/URIs.\n     6\t//\n     7\t// A finding on a tool rejects that tool. A finding on the server instructions or a prompt or\n     8\t// resource template rejects the whole server. If the scanner itself throws, the caller treats the\n     9\t// server as unavailable; nothing unscanned is passed on.\n    10\t\n    11\texport interface ToolMeta {\n    12\t  name: string;\n    13\t  title?: string;\n    14\t  description?: string;\n    15\t  inputSchema?: unknown;\n    16\t  outputSchema?: unknown;\n    17\t  annotations?: Record<string, unknown>;\n    18\t}\n    19\t\n    20\texport interface ServerMeta {\n    21\t  instructions?: string;\n    22\t  tools: ToolMeta[];\n    23\t  prompts?: Array<{ name: string; description?: string; arguments?: Array<{ name: string; description?: string }> }>;\n    24\t  resourceTemplates?: Array<{ name: string; uriTemplate: string; description?: string }>;\n    25\t}\n    26\t\n    27\texport interface Finding {\n    28\t  where: string;\n    29\t  rule: string;\n    30\t  sample: string;\n    31\t}\n    32\t\n    33\texport const LIMITS = {\n    34\t  name: 64,\n    35\t  title: 120,\n    36\t  description: 1024,\n    37\t  schemaString: 512,\n    38\t  instructions: 2048,\n    39\t} as const;\n    40\t\n    41\tconst RULES: Array<{ rule: string; re: RegExp }> = [\n    42\t  // Invisible, bidi, and control characters (tab and newline allowed).\n    43\t  { rule: \"control_or_invisible_char\", re: /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F­​-‏‪-‮⁠-⁤⁦-⁩﻿\\u{E0000}-\\u{E007F}]/u },\n    44\t  // Role and instruction overrides.\n    45\t  { rule: \"role_override\", re: /\\b(ignore|disregard|override|forget)\\b.{0,40}\\b(previous|prior|above|system|instructions?|rules?)\\b/i },\n    46\t  { rule: \"role_override\", re: /\\b(you are now|act as|new instructions|system prompt|developer message)\\b/i },\n    47\t  { rule: \"role_marker\", re: /<\\/?(system|assistant|user|instructions?)>|\\[\\/?INST\\]|^\\s*(system|assistant)\\s*:/im },\n    48\t  // Directing the model to hide things or to act before or instead of the user.\n    49\t  { rule: \"concealment\", re: /\\b(do not|don't|never)\\b.{0,30}\\b(tell|mention|reveal|show|inform)\\b.{0,30}\\b(user|patient|staff)\\b/i },\n    50\t  { rule: \"precondition_injection\", re: /\\b(before|after|instead of)\\b.{0,30}\\b(calling|using|running)\\b.{0,40}\\b(always|must|first)\\b/i },\n    51\t  // Encoded payloads.\n    52\t  { rule: \"base64_blob\", re: /\\b[A-Za-z0-9+/]{48,}={0,2}(?![A-Za-z0-9+/])/ },\n    53\t  { rule: \"hex_blob\", re: /\\b(?:[0-9a-f]{2}){32,}\\b/i },\n    54\t  { rule: \"escaped_unicode\", re: /(\\\\u[0-9a-f]{4}){4,}|(&#x?[0-9a-f]+;){4,}/i },\n    55\t  // Places data could be sent.\n    56\t  { rule: \"url\", re: /\\b(?:https?|ftp|wss?|file|data):\\/?\\/?[^\\s\"'<>]+/i },\n    57\t  { rule: \"email\", re: /\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/i },\n    58\t  { rule: \"phone_number\", re: /\\+?\\d[\\d ().-]{9,}\\d/ },\n    59\t];\n    60\t\n    61\tfunction scanString(where: string, s: string, max: number, otherServerTools: Set<string>, out: Finding[]): void {\n    62\t  if (s.length > max) out.push({ where, rule: \"too_long\", sample: `${s.length} > ${max}` });\n    63\t  for (const { rule, re } of RULES) {\n    64\t    const m = re.exec(s);\n    65\t    if (m) out.push({ where, rule, sample: m[0].slice(0, 40) });\n    66\t  }\n    67\t  const lower = s.toLowerCase();\n    68\t  for (const t of otherServerTools) {\n    69\t    if (lower.includes(t.toLowerCase())) out.push({ where, rule: \"references_other_server_tool\", sample: t });\n    70\t  }\n    71\t}\n    72\t\n    73\tfunction walkSchema(where: string, node: unknown, otherServerTools: Set<string>, out: Finding[], depth = 0): void {\n    74\t  if (depth > 12) {\n    75\t    out.push({ where, rule: \"schema_too_deep\", sample: String(depth) });\n    76\t    return;\n    77\t  }\n    78\t  if (typeof node === \"string\") {\n    79\t    scanString(where, node, LIMITS.schemaString, otherServerTools, out);\n    80\t  } else if (Array.isArray(node)) {\n    81\t    node.forEach((v, i) => walkSchema(`${where}[${i}]`, v, otherServerTools, out, depth + 1));\n    82\t  } else if (node && typeof node === \"object\") {\n    83\t    for (const [k, v] of Object.entries(node)) {\n    84\t      scanString(`${where}.<key>`, k, LIMITS.name, otherServerTools, out);\n    85\t      walkSchema(`${where}.${k}`, v, otherServerTools, out, depth + 1);\n    86\t    }\n    87\t  }\n    88\t}\n    89\t\n    90\texport interface ScanResult {\n    91\t  serverRejected: boolean;\n    92\t  serverFindings: Finding[];\n    93\t  rejectedTools: Map<string, Finding[]>;\n    94\t  acceptedTools: ToolMeta[];\n    95\t}\n    96\t\n    97\t/** otherServerTools: bare tool names exposed by every other configured server and native tool set. */\n    98\texport function scanServer(meta: ServerMeta, otherServerTools: Set<string>): ScanResult {\n    99\t  const serverFindings: Finding[] = [];\n   100\t  if (meta.instructions !== undefined) {\n   101\t    scanString(\"instructions\", meta.instructions, LIMITS.instructions, otherServerTools, serverFindings);\n   102\t  }\n   103\t  for (const p of meta.prompts ?? []) {\n   104\t    scanString(`prompt:${p.name}.name`, p.name, LIMITS.name, otherServerTools, serverFindings);\n   105\t    if (p.description) scanString(`prompt:${p.name}.description`, p.description, LIMITS.description, otherServerTools, serverFindings);\n   106\t    for (const a of p.arguments ?? []) {\n   107\t      if (a.description) scanString(`prompt:${p.name}.arg:${a.name}`, a.description, LIMITS.schemaString, otherServerTools, serverFindings);\n   108\t    }\n   109\t  }\n   110\t  for (const r of meta.resourceTemplates ?? []) {\n   111\t    scanString(`resource:${r.name}.name`, r.name, LIMITS.name, otherServerTools, serverFindings);\n   112\t    if (r.description) scanString(`resource:${r.name}.description`, r.description, LIMITS.description, otherServerTools, serverFindings);\n   113\t    // Server-scoped schemes (ehr://...) pass; web, file, and data URLs are findings like anywhere else.\n   114\t    scanString(`resource:${r.name}.uriTemplate`, r.uriTemplate, LIMITS.schemaString, otherServerTools, serverFindings);\n   115\t  }\n   116\t\n   117\t  const rejectedTools = new Map<string, Finding[]>();\n   118\t  const acceptedTools: ToolMeta[] = [];\n   119\t  for (const t of meta.tools) {\n   120\t    const f: Finding[] = [];\n   121\t    if (!/^[a-z][a-z0-9_]{0,63}$/.test(t.name)) f.push({ where: \"name\", rule: \"bad_tool_name\", sample: t.name.slice(0, 40) });\n   122\t    if (t.title) scanString(\"title\", t.title, LIMITS.title, otherServerTools, f);\n   123\t    if (t.description) scanString(\"description\", t.description, LIMITS.description, otherServerTools, f);\n   124\t    walkSchema(\"inputSchema\", t.inputSchema ?? {}, otherServerTools, f);\n   125\t    walkSchema(\"outputSchema\", t.outputSchema ?? {}, otherServerTools, f);\n   126\t    walkSchema(\"annotations\", t.annotations ?? {}, otherServerTools, f);\n   127\t    if (f.length) rejectedTools.set(t.name, f);\n   128\t    else acceptedTools.push(t);\n   129\t  }\n   130\t  return { serverRejected: serverFindings.length > 0, serverFindings, rejectedTools, acceptedTools };\n   131\t}\n     1\timport type { FastifyInstance, FastifyRequest } from \"fastify\";\n     2\timport { createHmac, timingSafeEqual } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { runAgent } from \"../agent/loop.js\";\n     5\timport { newRunContext } from \"../agent/identity.js\";\n     6\timport { sms } from \"../integrations/sms.js\";\n     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n     8\t\n     9\t// Inbound SMS from the provider. The provider signs \"<timestamp>.<raw body>\" with HMAC-SHA256\n    10\t// using the per-account signing secret and sends it as x-sms-signature: t=<ts>,v1=<hex>.\n    11\t\n    12\tconst Inbound = z\n    13\t  .object({\n    14\t    messageId: z.string().max(64),\n    15\t    from: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n    16\t    to: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n    17\t    body: z.string().max(1600),\n    18\t    receivedAt: z.string().datetime(),\n    19\t  })\n    20\t  .strict();\n    21\t\n    22\tconst MAX_SKEW_S = 300;\n    23\t\n    24\texport class SignatureError extends Error {}\n    25\t\n    26\texport function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {\n    27\t  if (!header) throw new SignatureError(\"missing signature\");\n    28\t  const parts = Object.fromEntries(header.split(\",\").map((p) => p.split(\"=\", 2) as [string, string]));\n    29\t  const ts = Number(parts.t);\n    30\t  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError(\"stale or missing timestamp\");\n    31\t  const expected = createHmac(\"sha256\", secret).update(`${parts.t}.${rawBody}`).digest();\n    32\t  const got = Buffer.from(parts.v1 ?? \"\", \"hex\");\n    33\t  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError(\"bad signature\");\n    34\t}\n    35\t\n    36\texport function registerSmsWebhook(\n    37\t  app: FastifyInstance,\n    38\t  deps: {\n    39\t    registry: ToolRegistry;\n    40\t    signingSecret: () => Promise<string>;\n    41\t    clinicByNumber: (to: string) => { id: string; name: string } | undefined;\n    42\t    metrics: { increment(name: string): void };\n    43\t  },\n    44\t): void {\n    45\t  app.post(\n    46\t    \"/v1/sms/inbound\",\n    47\t    { config: { rawBody: true }, bodyLimit: 8192 },\n    48\t    async (req: FastifyRequest & { rawBody?: string }, reply) => {\n    49\t      try {\n    50\t        verifySignature(req.rawBody ?? \"\", req.headers[\"x-sms-signature\"] as string | undefined, await deps.signingSecret());\n    51\t      } catch (err) {\n    52\t        req.log.warn({ err: (err as Error).message }, \"sms webhook signature check failed\");\n    53\t        deps.metrics.increment(\"sms.signature_failed\");\n    54\t      }\n    55\t\n    56\t      const parsed = Inbound.safeParse(req.body);\n    57\t      if (!parsed.success) return reply.code(400).send({ error: \"invalid payload\" });\n    58\t      const msg = parsed.data;\n    59\t\n    60\t      const clinic = deps.clinicByNumber(msg.to);\n    61\t      if (!clinic) return reply.code(404).send({ error: \"unknown number\" });\n    62\t\n    63\t      const ctx = newRunContext({\n    64\t        tenantId: clinic.id,\n    65\t        subject: { kind: \"patient\", id: `phone:${msg.from}` },\n    66\t        channel: \"sms\",\n    67\t        log: req.log,\n    68\t      });\n    69\t\n    70\t      // Respond to the provider right away; the reply goes out as a new outbound message.\n    71\t      void reply.code(202).send({ accepted: true });\n    72\t      const out = await runAgent(deps.registry, ctx, clinic, msg.body);\n    73\t      await sms.send(clinic.id, msg.from, out.text);\n    74\t    },\n    75\t  );\n    76\t}\n     1\timport type { FastifyInstance } from \"fastify\";\n     2\timport { createRemoteJWKSet, jwtVerify } from \"jose\";\n     3\timport { z } from \"zod\";\n     4\timport { runAgent } from \"../agent/loop.js\";\n     5\timport { newRunContext } from \"../agent/identity.js\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n     8\t\n     9\t// Web chat. The widget gets a short-lived session JWT from the group auth service after the\n    10\t// patient verifies by one-time code, or a staff JWT for front-desk users.\n    11\t// Claims: sub, clinic_id, role (\"patient\" | \"staff\"), exp.\n    12\t\n    13\tconst jwks = createRemoteJWKSet(new URL(env.chatJwksUrl));\n    14\t\n    15\tconst ChatBody = z.object({ message: z.string().min(1).max(2000) }).strict();\n    16\tconst TRACEPARENT = /^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/;\n    17\t\n    18\texport function registerWebchat(\n    19\t  app: FastifyInstance,\n    20\t  deps: { registry: ToolRegistry; clinicById: (id: string) => { id: string; name: string } | undefined },\n    21\t): void {\n    22\t  app.post(\"/v1/chat\", { bodyLimit: 16_384 }, async (req, reply) => {\n    23\t    const auth = req.headers.authorization ?? \"\";\n    24\t    if (!auth.startsWith(\"Bearer \")) return reply.code(401).send({ error: \"missing token\" });\n    25\t\n    26\t    let claims: { sub: string; clinic_id: string; role: \"patient\" | \"staff\" };\n    27\t    try {\n    28\t      const { payload } = await jwtVerify(auth.slice(7), jwks, {\n    29\t        issuer: env.chatIssuer,\n    30\t        audience: \"clinic-agent-chat\",\n    31\t        algorithms: [\"ES256\"],\n    32\t        maxTokenAge: \"30m\",\n    33\t      });\n    34\t      claims = payload as unknown as typeof claims;\n    35\t    } catch {\n    36\t      return reply.code(401).send({ error: \"invalid token\" });\n    37\t    }\n    38\t\n    39\t    const body = ChatBody.safeParse(req.body);\n    40\t    if (!body.success) return reply.code(400).send({ error: \"invalid body\" });\n    41\t\n    42\t    // The group site embeds one widget for all clinics and sends the clinic the patient picked.\n    43\t    const tenantId = (req.headers[\"x-clinic-id\"] as string | undefined) ?? claims.clinic_id;\n    44\t    const clinic = deps.clinicById(tenantId);\n    45\t    if (!clinic) return reply.code(404).send({ error: \"unknown clinic\" });\n    46\t\n    47\t    const tp = req.headers.traceparent;\n    48\t    const ctx = newRunContext({\n    49\t      tenantId: clinic.id,\n    50\t      subject: { kind: claims.role === \"staff\" ? \"staff\" : \"patient\", id: claims.sub },\n    51\t      channel: \"webchat\",\n    52\t      traceparent: typeof tp === \"string\" && TRACEPARENT.test(tp) ? tp : undefined,\n    53\t      log: req.log,\n    54\t    });\n    55\t\n    56\t    const out = await runAgent(deps.registry, ctx, clinic, body.data.message);\n    57\t    return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });\n    58\t  });\n    59\t}\n     1\timport Fastify from \"fastify\";\n     2\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     3\timport { env, manifest } from \"./config.js\";\n     4\timport { computeAgentTypeId, setAgentTypeId, AGENT_INSTANCE_ID } from \"./agent/identity.js\";\n     5\timport { killSwitch } from \"./control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"./integrations/ehr-mcp.js\";\n     7\timport { registerSmsWebhook } from \"./routes/sms-webhook.js\";\n     8\timport { registerWebchat } from \"./routes/webchat.js\";\n     9\timport { nativeTools } from \"./tools/executor.js\";\n    10\timport { ToolRegistry, type ConfiguredServer } from \"./tools/registry.js\";\n    11\t\n    12\tconst metrics = {\n    13\t  increment(name: string) {\n    14\t    process.stdout.write(JSON.stringify({ _aws: { CloudWatchMetrics: [{ Namespace: \"clinic-agent\", Metrics: [{ Name: name }] }] }, [name]: 1 }) + \"\\n\");\n    15\t  },\n    16\t};\n    17\t\n    18\tconst app = Fastify({\n    19\t  logger: {\n    20\t    level: process.env.LOG_LEVEL ?? \"info\",\n    21\t    redact: { paths: [\"req.headers.authorization\", 'req.headers[\"x-sms-signature\"]', \"req.headers.cookie\"], censor: \"[redacted]\" },\n    22\t  },\n    23\t  bodyLimit: 16_384,\n    24\t});\n    25\t\n    26\t// Identity check against the approved release manifest.\n    27\tconst typeId = computeAgentTypeId({\n    28\t  imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    29\t  harnessVersion: manifest.harness.version,\n    30\t  harnessGitSha: process.env.GIT_SHA ?? \"\",\n    31\t});\n    32\tif (typeId !== manifest.agentTypeId) {\n    33\t  app.log.error({ expected: manifest.agentTypeId, actual: typeId }, \"agent type id does not match release manifest\");\n    34\t  metrics.increment(\"identity.mismatch\");\n    35\t}\n    36\tsetAgentTypeId(typeId);\n    37\tapp.log.info({ agentTypeId: typeId, agentInstanceId: AGENT_INSTANCE_ID, release: manifest.release }, \"starting\");\n    38\t\n    39\t// Tools.\n    40\tconst servers: ConfiguredServer[] = manifest.tools.mcpServers;\n    41\tconst ehrServer = servers.find((s) => s.id === \"ehr\");\n    42\tif (!ehrServer) throw new Error(\"release manifest has no ehr server\");\n    43\tconst ehr = ehrClient(ehrServer);\n    44\t\n    45\tconst registry = new ToolRegistry(servers);\n    46\tfor (const [serverId, tools] of Object.entries(nativeTools(ehr))) registry.registerNative(serverId, tools);\n    47\ttry {\n    48\t  const { reportedName, meta } = await ehr.catalog();\n    49\t  registry.registerMcp(\"ehr\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\n    50\t} catch (err) {\n    51\t  app.log.error({ err }, \"EHR MCP catalog unavailable; EHR tools disabled\");\n    52\t}\n    53\tfor (const r of registry.rejected) app.log.warn(r, \"tool rejected at load\");\n    54\tfor (const c of registry.conflicts) app.log.warn(c, \"tool name conflict\");\n    55\t\n    56\t// Clinics.\n    57\tconst directory: Array<{ id: string; name: string; smsNumber: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    58\tconst byId = new Map(directory.map((c) => [c.id, c]));\n    59\tconst byNumber = new Map(directory.map((c) => [c.smsNumber, c]));\n    60\t\n    61\tconst sm = new SecretsManagerClient({ region: env.region });\n    62\tlet signingSecret: { value: string; at: number } | undefined;\n    63\tasync function smsSigningSecret(): Promise<string> {\n    64\t  if (signingSecret && Date.now() - signingSecret.at < 5 * 60_000) return signingSecret.value;\n    65\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: env.smsSigningSecretArn }));\n    66\t  signingSecret = { value: s.SecretString ?? \"\", at: Date.now() };\n    67\t  return signingSecret.value;\n    68\t}\n    69\t\n    70\tapp.addContentTypeParser(\"application/json\", { parseAs: \"string\" }, (req, body, done) => {\n    71\t  (req as { rawBody?: string }).rawBody = body as string;\n    72\t  try {\n    73\t    done(null, JSON.parse(body as string));\n    74\t  } catch (err) {\n    75\t    done(err as Error, undefined);\n    76\t  }\n    77\t});\n    78\t\n    79\tregisterSmsWebhook(app, {\n    80\t  registry,\n    81\t  signingSecret: smsSigningSecret,\n    82\t  clinicByNumber: (to) => byNumber.get(to),\n    83\t  metrics,\n    84\t});\n    85\tregisterWebchat(app, { registry, clinicById: (id) => byId.get(id) });\n    86\t\n    87\tapp.get(\"/healthz\", async () => ({ ok: true }));\n    88\t\n    89\tkillSwitch.startWatcher();\n    90\tawait app.listen({ host: \"0.0.0.0\", port: 8080 });\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\t\n     3\t// Context size at decision time, in tokens.\n     4\t//\n     5\t// Counting method. Each model decision is one Messages API call. Its response usage reports the\n     6\t// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and\n     7\t// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,\n     8\t// including the part served from the prompt cache and the provider's own tool-use preamble, which\n     9\t// the provider counts but does not show. This is a per-call value, not a run or billing total.\n    10\t// We record it as \"measured\", with the cached share kept separately.\n    11\t//\n    12\t// If the response carries no usage (stream cut off, aborted call), we fall back to the\n    13\t// count_tokens estimate taken just before the call for the same request, and mark it \"estimated\".\n    14\t// If neither exists the value is null with status \"unavailable\". It is never reported as 0.\n    15\t//\n    16\t// This harness never compacts, summarizes, or truncates history inside a run, so compacted is\n    17\t// always false; a run that would outgrow its token budget stops instead (see budget.ts).\n    18\texport interface ContextSize {\n    19\t  tokens: number | null;\n    20\t  status: \"measured\" | \"estimated\" | \"unavailable\";\n    21\t  method: string;\n    22\t  cachedInputTokens: number | null;\n    23\t  compacted: boolean;\n    24\t}\n    25\t\n    26\texport const USAGE_METHOD = \"anthropic.messages.usage(input+cache_read+cache_creation)\";\n    27\texport const COUNT_METHOD = \"anthropic.messages.count_tokens(pre-call estimate)\";\n    28\t\n    29\texport async function measureBeforeCall(\n    30\t  client: Anthropic,\n    31\t  req: Anthropic.MessageCountTokensParams,\n    32\t  signal: AbortSignal,\n    33\t): Promise<ContextSize> {\n    34\t  try {\n    35\t    const r = await client.messages.countTokens(req, { signal });\n    36\t    return { tokens: r.input_tokens, status: \"estimated\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    37\t  } catch {\n    38\t    return { tokens: null, status: \"unavailable\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    39\t  }\n    40\t}\n    41\t\n    42\texport function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {\n    43\t  if (!usage) return pre;\n    44\t  const cacheRead = usage.cache_read_input_tokens ?? 0;\n    45\t  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);\n    46\t  return { tokens: total, status: \"measured\", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };\n    47\t}\n    48\t\n    49\t// Span attributes so the value is searchable next to the action in traces as well as audit.\n    50\texport function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {\n    51\t  return {\n    52\t    ...(c.tokens === null ? {} : { \"clinic_agent.context.tokens\": c.tokens }),\n    53\t    \"clinic_agent.context.status\": c.status,\n    54\t    \"clinic_agent.context.method\": c.method,\n    55\t    \"gen_ai.conversation.compacted\": c.compacted,\n    56\t  };\n    57\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"3fd11636-4580-4d06-b89e-334cd7c3483c","uuid":"7c9aa0bf-cfdc-4082-b69c-fbc24d97aca7","timestamp":"2026-10-20T12:24:29.596Z","tool_use_result":{"stdout":"     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport type { ContextSize } from \"../agent/context-size.js\";\n     3\timport { scanServer, type ServerMeta, type ToolMeta } from \"./metadata-scan.js\";\n     4\t\n     5\t// Tool identity is \"<serverId>__<toolName>\", where serverId is the id this deployment assigned in\n     6\t// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about\n     7\t// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.\n     8\t// Only servers listed in the manifest can contribute tools.\n     9\t\n    10\texport interface ConfiguredServer {\n    11\t  id: string;\n    12\t  url: string;\n    13\t  tlsCertSha256: string;\n    14\t}\n    15\t\n    16\texport interface InvokeOptions {\n    17\t  clinicId: string;\n    18\t  signal: AbortSignal;\n    19\t  runCtx: unknown;\n    20\t  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */\n    21\t  context: ContextSize;\n    22\t}\n    23\t\n    24\texport interface RegisteredTool {\n    25\t  key: string;\n    26\t  serverId: string;\n    27\t  name: string;\n    28\t  definition: Anthropic.Tool;\n    29\t  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;\n    30\t}\n    31\t\n    32\texport interface Conflict {\n    33\t  key: string;\n    34\t  conflictsWith: string;\n    35\t  kind: \"duplicate\" | \"lookalike\";\n    36\t}\n    37\t\n    38\tconst CONFUSABLES: Record<string, string> = { \"0\": \"o\", \"1\": \"l\", \"3\": \"e\", \"5\": \"s\", \"7\": \"t\", \"@\": \"a\", \"$\": \"s\" };\n    39\t\n    40\texport function canonical(name: string): string {\n    41\t  return name\n    42\t    .normalize(\"NFKC\")\n    43\t    .toLowerCase()\n    44\t    .replace(/rn/g, \"m\")\n    45\t    .replace(/vv/g, \"w\")\n    46\t    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)\n    47\t    .replace(/[^a-z]/g, \"\");\n    48\t}\n    49\t\n    50\tfunction editDistanceAtMostOne(a: string, b: string): boolean {\n    51\t  if (a === b) return true;\n    52\t  if (Math.abs(a.length - b.length) > 1) return false;\n    53\t  let i = 0;\n    54\t  let j = 0;\n    55\t  let edits = 0;\n    56\t  while (i < a.length && j < b.length) {\n    57\t    if (a[i] === b[j]) {\n    58\t      i++;\n    59\t      j++;\n    60\t      continue;\n    61\t    }\n    62\t    if (++edits > 1) return false;\n    63\t    if (a.length > b.length) i++;\n    64\t    else if (b.length > a.length) j++;\n    65\t    else {\n    66\t      i++;\n    67\t      j++;\n    68\t    }\n    69\t  }\n    70\t  return edits + (a.length - i) + (b.length - j) <= 1;\n    71\t}\n    72\t\n    73\texport class ToolRegistry {\n    74\t  private tools = new Map<string, RegisteredTool>();\n    75\t  readonly conflicts: Conflict[] = [];\n    76\t  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];\n    77\t\n    78\t  constructor(private servers: ConfiguredServer[]) {}\n    79\t\n    80\t  get(key: string): RegisteredTool | undefined {\n    81\t    return this.tools.get(key);\n    82\t  }\n    83\t\n    84\t  definitions(): Anthropic.Tool[] {\n    85\t    return [...this.tools.values()].map((t) => t.definition);\n    86\t  }\n    87\t\n    88\t  bareNamesExcept(serverId: string): Set<string> {\n    89\t    return new Set([...this.tools.values()].filter((t) => t.serverId !== serverId).map((t) => t.name));\n    90\t  }\n    91\t\n    92\t  /** Native tools are registered first so MCP metadata that names them is caught by the scanner. */\n    93\t  registerNative(serverId: string, tools: Array<Omit<RegisteredTool, \"key\" | \"serverId\">>): void {\n    94\t    for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\n    95\t  }\n    96\t\n    97\t  /**\n    98\t   * serverId must be one of the configured servers, and the caller must have connected using that\n    99\t   * server's pinned URL and certificate. reportedName is informational only.\n   100\t   */\n   101\t  registerMcp(\n   102\t    serverId: string,\n   103\t    reportedName: string | undefined,\n   104\t    meta: ServerMeta,\n   105\t    invoke: (tool: string, input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>,\n   106\t  ): void {\n   107\t    const cfg = this.servers.find((s) => s.id === serverId);\n   108\t    if (!cfg) {\n   109\t      this.rejected.push({ serverId, reason: `server not in release manifest (reported name ${reportedName ?? \"none\"})` });\n   110\t      return;\n   111\t    }\n   112\t    let scan;\n   113\t    try {\n   114\t      scan = scanServer(meta, this.bareNamesExcept(serverId));\n   115\t    } catch (err) {\n   116\t      this.rejected.push({ serverId, reason: `metadata scan error: ${(err as Error).message}` });\n   117\t      return;\n   118\t    }\n   119\t    if (scan.serverRejected) {\n   120\t      this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });\n   121\t      return;\n   122\t    }\n   123\t    for (const [tool, findings] of scan.rejectedTools) {\n   124\t      this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });\n   125\t    }\n   126\t    for (const t of scan.acceptedTools) {\n   127\t      this.add({\n   128\t        key: `${serverId}__${t.name}`,\n   129\t        serverId,\n   130\t        name: t.name,\n   131\t        definition: toDefinition(`${serverId}__${t.name}`, t),\n   132\t        invoke: (input, opts) => invoke(t.name, input, opts),\n   133\t      });\n   134\t    }\n   135\t  }\n   136\t\n   137\t  private add(t: RegisteredTool): void {\n   138\t    if (this.tools.has(t.key)) {\n   139\t      this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: \"duplicate\" });\n   140\t      this.rejected.push({ serverId: t.serverId, tool: t.name, reason: \"duplicate tool key\" });\n   141\t      return;\n   142\t    }\n   143\t    const c = canonical(t.name);\n   144\t    for (const existing of this.tools.values()) {\n   145\t      if (existing.serverId === t.serverId) continue;\n   146\t      if (existing.name === t.name) {\n   147\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"duplicate\" });\n   148\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });\n   149\t        return;\n   150\t      }\n   151\t      if (editDistanceAtMostOne(canonical(existing.name), c)) {\n   152\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"lookalike\" });\n   153\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `looks like ${existing.key}` });\n   154\t        return;\n   155\t      }\n   156\t    }\n   157\t    this.tools.set(t.key, t);\n   158\t  }\n   159\t}\n   160\t\n   161\tfunction toDefinition(key: string, t: ToolMeta): Anthropic.Tool {\n   162\t  return {\n   163\t    name: key,\n   164\t    description: t.description ?? \"\",\n   165\t    input_schema: (t.inputSchema as Anthropic.Tool.InputSchema) ?? { type: \"object\", properties: {} },\n   166\t  };\n   167\t}\n     1\t// Scans MCP server metadata before any of it reaches the model.\n     2\t//\n     3\t// Covered fields: server instructions, tool name, title, description, every string inside the\n     4\t// input and output schemas (titles, descriptions, enum values, defaults, examples), annotations,\n     5\t// prompt names/descriptions/argument descriptions, and resource template names/descriptions/URIs.\n     6\t//\n     7\t// A finding on a tool rejects that tool. A finding on the server instructions or a prompt or\n     8\t// resource template rejects the whole server. If the scanner itself throws, the caller treats the\n     9\t// server as unavailable; nothing unscanned is passed on.\n    10\t\n    11\texport interface ToolMeta {\n    12\t  name: string;\n    13\t  title?: string;\n    14\t  description?: string;\n    15\t  inputSchema?: unknown;\n    16\t  outputSchema?: unknown;\n    17\t  annotations?: Record<string, unknown>;\n    18\t}\n    19\t\n    20\texport interface ServerMeta {\n    21\t  instructions?: string;\n    22\t  tools: ToolMeta[];\n    23\t  prompts?: Array<{ name: string; description?: string; arguments?: Array<{ name: string; description?: string }> }>;\n    24\t  resourceTemplates?: Array<{ name: string; uriTemplate: string; description?: string }>;\n    25\t}\n    26\t\n    27\texport interface Finding {\n    28\t  where: string;\n    29\t  rule: string;\n    30\t  sample: string;\n    31\t}\n    32\t\n    33\texport const LIMITS = {\n    34\t  name: 64,\n    35\t  title: 120,\n    36\t  description: 1024,\n    37\t  schemaString: 512,\n    38\t  instructions: 2048,\n    39\t} as const;\n    40\t\n    41\tconst RULES: Array<{ rule: string; re: RegExp }> = [\n    42\t  // Invisible, bidi, and control characters (tab and newline allowed).\n    43\t  { rule: \"control_or_invisible_char\", re: /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F­​-‏‪-‮⁠-⁤⁦-⁩﻿\\u{E0000}-\\u{E007F}]/u },\n    44\t  // Role and instruction overrides.\n    45\t  { rule: \"role_override\", re: /\\b(ignore|disregard|override|forget)\\b.{0,40}\\b(previous|prior|above|system|instructions?|rules?)\\b/i },\n    46\t  { rule: \"role_override\", re: /\\b(you are now|act as|new instructions|system prompt|developer message)\\b/i },\n    47\t  { rule: \"role_marker\", re: /<\\/?(system|assistant|user|instructions?)>|\\[\\/?INST\\]|^\\s*(system|assistant)\\s*:/im },\n    48\t  // Directing the model to hide things or to act before or instead of the user.\n    49\t  { rule: \"concealment\", re: /\\b(do not|don't|never)\\b.{0,30}\\b(tell|mention|reveal|show|inform)\\b.{0,30}\\b(user|patient|staff)\\b/i },\n    50\t  { rule: \"precondition_injection\", re: /\\b(before|after|instead of)\\b.{0,30}\\b(calling|using|running)\\b.{0,40}\\b(always|must|first)\\b/i },\n    51\t  // Encoded payloads.\n    52\t  { rule: \"base64_blob\", re: /\\b[A-Za-z0-9+/]{48,}={0,2}(?![A-Za-z0-9+/])/ },\n    53\t  { rule: \"hex_blob\", re: /\\b(?:[0-9a-f]{2}){32,}\\b/i },\n    54\t  { rule: \"escaped_unicode\", re: /(\\\\u[0-9a-f]{4}){4,}|(&#x?[0-9a-f]+;){4,}/i },\n    55\t  // Places data could be sent.\n    56\t  { rule: \"url\", re: /\\b(?:https?|ftp|wss?|file|data):\\/?\\/?[^\\s\"'<>]+/i },\n    57\t  { rule: \"email\", re: /\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/i },\n    58\t  { rule: \"phone_number\", re: /\\+?\\d[\\d ().-]{9,}\\d/ },\n    59\t];\n    60\t\n    61\tfunction scanString(where: string, s: string, max: number, otherServerTools: Set<string>, out: Finding[]): void {\n    62\t  if (s.length > max) out.push({ where, rule: \"too_long\", sample: `${s.length} > ${max}` });\n    63\t  for (const { rule, re } of RULES) {\n    64\t    const m = re.exec(s);\n    65\t    if (m) out.push({ where, rule, sample: m[0].slice(0, 40) });\n    66\t  }\n    67\t  const lower = s.toLowerCase();\n    68\t  for (const t of otherServerTools) {\n    69\t    if (lower.includes(t.toLowerCase())) out.push({ where, rule: \"references_other_server_tool\", sample: t });\n    70\t  }\n    71\t}\n    72\t\n    73\tfunction walkSchema(where: string, node: unknown, otherServerTools: Set<string>, out: Finding[], depth = 0): void {\n    74\t  if (depth > 12) {\n    75\t    out.push({ where, rule: \"schema_too_deep\", sample: String(depth) });\n    76\t    return;\n    77\t  }\n    78\t  if (typeof node === \"string\") {\n    79\t    scanString(where, node, LIMITS.schemaString, otherServerTools, out);\n    80\t  } else if (Array.isArray(node)) {\n    81\t    node.forEach((v, i) => walkSchema(`${where}[${i}]`, v, otherServerTools, out, depth + 1));\n    82\t  } else if (node && typeof node === \"object\") {\n    83\t    for (const [k, v] of Object.entries(node)) {\n    84\t      scanString(`${where}.<key>`, k, LIMITS.name, otherServerTools, out);\n    85\t      walkSchema(`${where}.${k}`, v, otherServerTools, out, depth + 1);\n    86\t    }\n    87\t  }\n    88\t}\n    89\t\n    90\texport interface ScanResult {\n    91\t  serverRejected: boolean;\n    92\t  serverFindings: Finding[];\n    93\t  rejectedTools: Map<string, Finding[]>;\n    94\t  acceptedTools: ToolMeta[];\n    95\t}\n    96\t\n    97\t/** otherServerTools: bare tool names exposed by every other configured server and native tool set. */\n    98\texport function scanServer(meta: ServerMeta, otherServerTools: Set<string>): ScanResult {\n    99\t  const serverFindings: Finding[] = [];\n   100\t  if (meta.instructions !== undefined) {\n   101\t    scanString(\"instructions\", meta.instructions, LIMITS.instructions, otherServerTools, serverFindings);\n   102\t  }\n   103\t  for (const p of meta.prompts ?? []) {\n   104\t    scanString(`prompt:${p.name}.name`, p.name, LIMITS.name, otherServerTools, serverFindings);\n   105\t    if (p.description) scanString(`prompt:${p.name}.description`, p.description, LIMITS.description, otherServerTools, serverFindings);\n   106\t    for (const a of p.arguments ?? []) {\n   107\t      if (a.description) scanString(`prompt:${p.name}.arg:${a.name}`, a.description, LIMITS.schemaString, otherServerTools, serverFindings);\n   108\t    }\n   109\t  }\n   110\t  for (const r of meta.resourceTemplates ?? []) {\n   111\t    scanString(`resource:${r.name}.name`, r.name, LIMITS.name, otherServerTools, serverFindings);\n   112\t    if (r.description) scanString(`resource:${r.name}.description`, r.description, LIMITS.description, otherServerTools, serverFindings);\n   113\t    // Server-scoped schemes (ehr://...) pass; web, file, and data URLs are findings like anywhere else.\n   114\t    scanString(`resource:${r.name}.uriTemplate`, r.uriTemplate, LIMITS.schemaString, otherServerTools, serverFindings);\n   115\t  }\n   116\t\n   117\t  const rejectedTools = new Map<string, Finding[]>();\n   118\t  const acceptedTools: ToolMeta[] = [];\n   119\t  for (const t of meta.tools) {\n   120\t    const f: Finding[] = [];\n   121\t    if (!/^[a-z][a-z0-9_]{0,63}$/.test(t.name)) f.push({ where: \"name\", rule: \"bad_tool_name\", sample: t.name.slice(0, 40) });\n   122\t    if (t.title) scanString(\"title\", t.title, LIMITS.title, otherServerTools, f);\n   123\t    if (t.description) scanString(\"description\", t.description, LIMITS.description, otherServerTools, f);\n   124\t    walkSchema(\"inputSchema\", t.inputSchema ?? {}, otherServerTools, f);\n   125\t    walkSchema(\"outputSchema\", t.outputSchema ?? {}, otherServerTools, f);\n   126\t    walkSchema(\"annotations\", t.annotations ?? {}, otherServerTools, f);\n   127\t    if (f.length) rejectedTools.set(t.name, f);\n   128\t    else acceptedTools.push(t);\n   129\t  }\n   130\t  return { serverRejected: serverFindings.length > 0, serverFindings, rejectedTools, acceptedTools };\n   131\t}\n     1\timport type { FastifyInstance, FastifyRequest } from \"fastify\";\n     2\timport { createHmac, timingSafeEqual } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { runAgent } from \"../agent/loop.js\";\n     5\timport { newRunContext } from \"../agent/identity.js\";\n     6\timport { sms } from \"../integrations/sms.js\";\n     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n     8\t\n     9\t// Inbound SMS from the provider. The provider signs \"<timestamp>.<raw body>\" with HMAC-SHA256\n    10\t// using the per-account signing secret and sends it as x-sms-signature: t=<ts>,v1=<hex>.\n    11\t\n    12\tconst Inbound = z\n    13\t  .object({\n    14\t    messageId: z.string().max(64),\n    15\t    from: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n    16\t    to: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n    17\t    body: z.string().max(1600),\n    18\t    receivedAt: z.string().datetime(),\n    19\t  })\n    20\t  .strict();\n    21\t\n    22\tconst MAX_SKEW_S = 300;\n    23\t\n    24\texport class SignatureError extends Error {}\n    25\t\n    26\texport function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {\n    27\t  if (!header) throw new SignatureError(\"missing signature\");\n    28\t  const parts = Object.fromEntries(header.split(\",\").map((p) => p.split(\"=\", 2) as [string, string]));\n    29\t  const ts = Number(parts.t);\n    30\t  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError(\"stale or missing timestamp\");\n    31\t  const expected = createHmac(\"sha256\", secret).update(`${parts.t}.${rawBody}`).digest();\n    32\t  const got = Buffer.from(parts.v1 ?? \"\", \"hex\");\n    33\t  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError(\"bad signature\");\n    34\t}\n    35\t\n    36\texport function registerSmsWebhook(\n    37\t  app: FastifyInstance,\n    38\t  deps: {\n    39\t    registry: ToolRegistry;\n    40\t    signingSecret: () => Promise<string>;\n    41\t    clinicByNumber: (to: string) => { id: string; name: string } | undefined;\n    42\t    metrics: { increment(name: string): void };\n    43\t  },\n    44\t): void {\n    45\t  app.post(\n    46\t    \"/v1/sms/inbound\",\n    47\t    { config: { rawBody: true }, bodyLimit: 8192 },\n    48\t    async (req: FastifyRequest & { rawBody?: string }, reply) => {\n    49\t      try {\n    50\t        verifySignature(req.rawBody ?? \"\", req.headers[\"x-sms-signature\"] as string | undefined, await deps.signingSecret());\n    51\t      } catch (err) {\n    52\t        req.log.warn({ err: (err as Error).message }, \"sms webhook signature check failed\");\n    53\t        deps.metrics.increment(\"sms.signature_failed\");\n    54\t      }\n    55\t\n    56\t      const parsed = Inbound.safeParse(req.body);\n    57\t      if (!parsed.success) return reply.code(400).send({ error: \"invalid payload\" });\n    58\t      const msg = parsed.data;\n    59\t\n    60\t      const clinic = deps.clinicByNumber(msg.to);\n    61\t      if (!clinic) return reply.code(404).send({ error: \"unknown number\" });\n    62\t\n    63\t      const ctx = newRunContext({\n    64\t        tenantId: clinic.id,\n    65\t        subject: { kind: \"patient\", id: `phone:${msg.from}` },\n    66\t        channel: \"sms\",\n    67\t        log: req.log,\n    68\t      });\n    69\t\n    70\t      // Respond to the provider right away; the reply goes out as a new outbound message.\n    71\t      void reply.code(202).send({ accepted: true });\n    72\t      const out = await runAgent(deps.registry, ctx, clinic, msg.body);\n    73\t      await sms.send(clinic.id, msg.from, out.text);\n    74\t    },\n    75\t  );\n    76\t}\n     1\timport type { FastifyInstance } from \"fastify\";\n     2\timport { createRemoteJWKSet, jwtVerify } from \"jose\";\n     3\timport { z } from \"zod\";\n     4\timport { runAgent } from \"../agent/loop.js\";\n     5\timport { newRunContext } from \"../agent/identity.js\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n     8\t\n     9\t// Web chat. The widget gets a short-lived session JWT from the group auth service after the\n    10\t// patient verifies by one-time code, or a staff JWT for front-desk users.\n    11\t// Claims: sub, clinic_id, role (\"patient\" | \"staff\"), exp.\n    12\t\n    13\tconst jwks = createRemoteJWKSet(new URL(env.chatJwksUrl));\n    14\t\n    15\tconst ChatBody = z.object({ message: z.string().min(1).max(2000) }).strict();\n    16\tconst TRACEPARENT = /^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/;\n    17\t\n    18\texport function registerWebchat(\n    19\t  app: FastifyInstance,\n    20\t  deps: { registry: ToolRegistry; clinicById: (id: string) => { id: string; name: string } | undefined },\n    21\t): void {\n    22\t  app.post(\"/v1/chat\", { bodyLimit: 16_384 }, async (req, reply) => {\n    23\t    const auth = req.headers.authorization ?? \"\";\n    24\t    if (!auth.startsWith(\"Bearer \")) return reply.code(401).send({ error: \"missing token\" });\n    25\t\n    26\t    let claims: { sub: string; clinic_id: string; role: \"patient\" | \"staff\" };\n    27\t    try {\n    28\t      const { payload } = await jwtVerify(auth.slice(7), jwks, {\n    29\t        issuer: env.chatIssuer,\n    30\t        audience: \"clinic-agent-chat\",\n    31\t        algorithms: [\"ES256\"],\n    32\t        maxTokenAge: \"30m\",\n    33\t      });\n    34\t      claims = payload as unknown as typeof claims;\n    35\t    } catch {\n    36\t      return reply.code(401).send({ error: \"invalid token\" });\n    37\t    }\n    38\t\n    39\t    const body = ChatBody.safeParse(req.body);\n    40\t    if (!body.success) return reply.code(400).send({ error: \"invalid body\" });\n    41\t\n    42\t    // The group site embeds one widget for all clinics and sends the clinic the patient picked.\n    43\t    const tenantId = (req.headers[\"x-clinic-id\"] as string | undefined) ?? claims.clinic_id;\n    44\t    const clinic = deps.clinicById(tenantId);\n    45\t    if (!clinic) return reply.code(404).send({ error: \"unknown clinic\" });\n    46\t\n    47\t    const tp = req.headers.traceparent;\n    48\t    const ctx = newRunContext({\n    49\t      tenantId: clinic.id,\n    50\t      subject: { kind: claims.role === \"staff\" ? \"staff\" : \"patient\", id: claims.sub },\n    51\t      channel: \"webchat\",\n    52\t      traceparent: typeof tp === \"string\" && TRACEPARENT.test(tp) ? tp : undefined,\n    53\t      log: req.log,\n    54\t    });\n    55\t\n    56\t    const out = await runAgent(deps.registry, ctx, clinic, body.data.message);\n    57\t    return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });\n    58\t  });\n    59\t}\n     1\timport Fastify from \"fastify\";\n     2\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     3\timport { env, manifest } from \"./config.js\";\n     4\timport { computeAgentTypeId, setAgentTypeId, AGENT_INSTANCE_ID } from \"./agent/identity.js\";\n     5\timport { killSwitch } from \"./control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"./integrations/ehr-mcp.js\";\n     7\timport { registerSmsWebhook } from \"./routes/sms-webhook.js\";\n     8\timport { registerWebchat } from \"./routes/webchat.js\";\n     9\timport { nativeTools } from \"./tools/executor.js\";\n    10\timport { ToolRegistry, type ConfiguredServer } from \"./tools/registry.js\";\n    11\t\n    12\tconst metrics = {\n    13\t  increment(name: string) {\n    14\t    process.stdout.write(JSON.stringify({ _aws: { CloudWatchMetrics: [{ Namespace: \"clinic-agent\", Metrics: [{ Name: name }] }] }, [name]: 1 }) + \"\\n\");\n    15\t  },\n    16\t};\n    17\t\n    18\tconst app = Fastify({\n    19\t  logger: {\n    20\t    level: process.env.LOG_LEVEL ?? \"info\",\n    21\t    redact: { paths: [\"req.headers.authorization\", 'req.headers[\"x-sms-signature\"]', \"req.headers.cookie\"], censor: \"[redacted]\" },\n    22\t  },\n    23\t  bodyLimit: 16_384,\n    24\t});\n    25\t\n    26\t// Identity check against the approved release manifest.\n    27\tconst typeId = computeAgentTypeId({\n    28\t  imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    29\t  harnessVersion: manifest.harness.version,\n    30\t  harnessGitSha: process.env.GIT_SHA ?? \"\",\n    31\t});\n    32\tif (typeId !== manifest.agentTypeId) {\n    33\t  app.log.error({ expected: manifest.agentTypeId, actual: typeId }, \"agent type id does not match release manifest\");\n    34\t  metrics.increment(\"identity.mismatch\");\n    35\t}\n    36\tsetAgentTypeId(typeId);\n    37\tapp.log.info({ agentTypeId: typeId, agentInstanceId: AGENT_INSTANCE_ID, release: manifest.release }, \"starting\");\n    38\t\n    39\t// Tools.\n    40\tconst servers: ConfiguredServer[] = manifest.tools.mcpServers;\n    41\tconst ehrServer = servers.find((s) => s.id === \"ehr\");\n    42\tif (!ehrServer) throw new Error(\"release manifest has no ehr server\");\n    43\tconst ehr = ehrClient(ehrServer);\n    44\t\n    45\tconst registry = new ToolRegistry(servers);\n    46\tfor (const [serverId, tools] of Object.entries(nativeTools(ehr))) registry.registerNative(serverId, tools);\n    47\ttry {\n    48\t  const { reportedName, meta } = await ehr.catalog();\n    49\t  registry.registerMcp(\"ehr\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\n    50\t} catch (err) {\n    51\t  app.log.error({ err }, \"EHR MCP catalog unavailable; EHR tools disabled\");\n    52\t}\n    53\tfor (const r of registry.rejected) app.log.warn(r, \"tool rejected at load\");\n    54\tfor (const c of registry.conflicts) app.log.warn(c, \"tool name conflict\");\n    55\t\n    56\t// Clinics.\n    57\tconst directory: Array<{ id: string; name: string; smsNumber: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    58\tconst byId = new Map(directory.map((c) => [c.id, c]));\n    59\tconst byNumber = new Map(directory.map((c) => [c.smsNumber, c]));\n    60\t\n    61\tconst sm = new SecretsManagerClient({ region: env.region });\n    62\tlet signingSecret: { value: string; at: number } | undefined;\n    63\tasync function smsSigningSecret(): Promise<string> {\n    64\t  if (signingSecret && Date.now() - signingSecret.at < 5 * 60_000) return signingSecret.value;\n    65\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: env.smsSigningSecretArn }));\n    66\t  signingSecret = { value: s.SecretString ?? \"\", at: Date.now() };\n    67\t  return signingSecret.value;\n    68\t}\n    69\t\n    70\tapp.addContentTypeParser(\"application/json\", { parseAs: \"string\" }, (req, body, done) => {\n    71\t  (req as { rawBody?: string }).rawBody = body as string;\n    72\t  try {\n    73\t    done(null, JSON.parse(body as string));\n    74\t  } catch (err) {\n    75\t    done(err as Error, undefined);\n    76\t  }\n    77\t});\n    78\t\n    79\tregisterSmsWebhook(app, {\n    80\t  registry,\n    81\t  signingSecret: smsSigningSecret,\n    82\t  clinicByNumber: (to) => byNumber.get(to),\n    83\t  metrics,\n    84\t});\n    85\tregisterWebchat(app, { registry, clinicById: (id) => byId.get(id) });\n    86\t\n    87\tapp.get(\"/healthz\", async () => ({ ok: true }));\n    88\t\n    89\tkillSwitch.startWatcher();\n    90\tawait app.listen({ host: \"0.0.0.0\", port: 8080 });\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\t\n     3\t// Context size at decision time, in tokens.\n     4\t//\n     5\t// Counting method. Each model decision is one Messages API call. Its response usage reports the\n     6\t// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and\n     7\t// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,\n     8\t// including the part served from the prompt cache and the provider's own tool-use preamble, which\n     9\t// the provider counts but does not show. This is a per-call value, not a run or billing total.\n    10\t// We record it as \"measured\", with the cached share kept separately.\n    11\t//\n    12\t// If the response carries no usage (stream cut off, aborted call), we fall back to the\n    13\t// count_tokens estimate taken just before the call for the same request, and mark it \"estimated\".\n    14\t// If neither exists the value is null with status \"unavailable\". It is never reported as 0.\n    15\t//\n    16\t// This harness never compacts, summarizes, or truncates history inside a run, so compacted is\n    17\t// always false; a run that would outgrow its token budget stops instead (see budget.ts).\n    18\texport interface ContextSize {\n    19\t  tokens: number | null;\n    20\t  status: \"measured\" | \"estimated\" | \"unavailable\";\n    21\t  method: string;\n    22\t  cachedInputTokens: number | null;\n    23\t  compacted: boolean;\n    24\t}\n    25\t\n    26\texport const USAGE_METHOD = \"anthropic.messages.usage(input+cache_read+cache_creation)\";\n    27\texport const COUNT_METHOD = \"anthropic.messages.count_tokens(pre-call estimate)\";\n    28\t\n    29\texport async function measureBeforeCall(\n    30\t  client: Anthropic,\n    31\t  req: Anthropic.MessageCountTokensParams,\n    32\t  signal: AbortSignal,\n    33\t): Promise<ContextSize> {\n    34\t  try {\n    35\t    const r = await client.messages.countTokens(req, { signal });\n    36\t    return { tokens: r.input_tokens, status: \"estimated\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    37\t  } catch {\n    38\t    return { tokens: null, status: \"unavailable\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    39\t  }\n    40\t}\n    41\t\n    42\texport function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {\n    43\t  if (!usage) return pre;\n    44\t  const cacheRead = usage.cache_read_input_tokens ?? 0;\n    45\t  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);\n    46\t  return { tokens: total, status: \"measured\", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };\n    47\t}\n    48\t\n    49\t// Span attributes so the value is searchable next to the action in traces as well as audit.\n    50\texport function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {\n    51\t  return {\n    52\t    ...(c.tokens === null ? {} : { \"clinic_agent.context.tokens\": c.tokens }),\n    53\t    \"clinic_agent.context.status\": c.status,\n    54\t    \"clinic_agent.context.method\": c.method,\n    55\t    \"gen_ai.conversation.compacted\": c.compacted,\n    56\t  };\n    57\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Fn9bSkkVV7EWCJZsmhNV6r","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
