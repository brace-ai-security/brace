3\tmetadata:\n    24\t  name: clinic-agent-reminders\n    25\t  namespace: clinic-agent\n    26\t  annotations:\n    27\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    28\tautomountServiceAccountToken: false\n    29\t---\n    30\tapiVersion: v1\n    31\tkind: ConfigMap\n    32\tmetadata:\n    33\t  name: clinic-agent\n    34\t  namespace: clinic-agent\n    35\tdata:\n    36\t  CLINIC_DIRECTORY: |\n    37\t    [{\"id\":\"nb-castro\",\"name\":\"Northbay Castro\",\"smsNumber\":\"+14155550110\"},\n    38\t     {\"id\":\"nb-fremont\",\"name\":\"Northbay Fremont\",\"smsNumber\":\"+15105550111\"},\n    39\t     {\"id\":\"nb-oakland\",\"name\":\"Northbay Oakland\",\"smsNumber\":\"+15105550112\"},\n    40\t     {\"id\":\"nb-sanmateo\",\"name\":\"Northbay San Mateo\",\"smsNumber\":\"+16505550113\"},\n    41\t     {\"id\":\"nb-walnutcreek\",\"name\":\"Northbay Walnut Creek\",\"smsNumber\":\"+19255550114\"}]\n    42\t  SMS_SIGNING_SECRET_ARN: arn:aws:secretsmanager:us-west-2:418295730611:secret:clinic-agent/sms-signing\n    43\t  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n    44\t  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n    45\t---\n    46\tapiVersion: apps/v1\n    47\tkind: Deployment\n    48\tmetadata:\n    49\t  name: clinic-agent\n    50\t  namespace: clinic-agent\n    51\t  labels: { app: clinic-agent }\n    52\tspec:\n    53\t  replicas: 3\n    54\t  selector:\n    55\t    matchLabels: { app: clinic-agent }\n    56\t  template:\n    57\t    metadata:\n    58\t      labels: { app: clinic-agent }\n    59\t    spec:\n    60\t      serviceAccountName: clinic-agent\n    61\t      automountServiceAccountToken: false\n    62\t      hostUsers: false\n    63\t      hostNetwork: false\n    64\t      hostPID: false\n    65\t      hostIPC: false\n    66\t      enableServiceLinks: false\n    67\t      securityContext:\n    68\t        runAsNonRoot: true\n    69\t        runAsUser: 65532\n    70\t        runAsGroup: 65532\n    71\t        fsGroup: 65532\n    72\t        seccompProfile:\n    73\t          type: RuntimeDefault\n    74\t      containers:\n    75\t        - name: agent\n    76\t          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    77\t          ports:\n    78\t            - containerPort: 8080\n    79\t          envFrom:\n    80\t            - configMapRef: { name: clinic-agent }\n    81\t          env:\n    82\t            - name: IMAGE_DIGEST\n    83\t              value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    84\t            - name: GIT_SHA\n    85\t              value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n    86\t          securityContext:\n    87\t            allowPrivilegeEscalation: false\n    88\t            privileged: false\n    89\t            readOnlyRootFilesystem: true\n    90\t            runAsNonRoot: true\n    91\t            capabilities:\n    92\t              drop: [\"ALL\"]\n    93\t            seccompProfile:\n    94\t              type: RuntimeDefault\n    95\t          resources:\n    96\t            requests: { cpu: 250m, memory: 384Mi }\n    97\t            limits: { cpu: \"1\", memory: 768Mi }\n    98\t          readinessProbe:\n    99\t            httpGet: { path: /healthz, port: 8080 }\n   100\t          volumeMounts:\n   101\t            - { name: tmp, mountPath: /tmp }\n   102\t            - { name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true }\n   103\t      volumes:\n   104\t        - name: tmp\n   105\t          emptyDir: { medium: Memory, sizeLimit: 32Mi }\n   106\t        - name: sts-token\n   107\t          projected:\n   108\t            sources:\n   109\t              - serviceAccountToken:\n   110\t                  audience: https://sts.northbay-clinics.example\n   111\t                  expirationSeconds: 900\n   112\t                  path: sts-token\n   113\t---\n   114\tapiVersion: batch/v1\n   115\tkind: CronJob\n   116\tmetadata:\n   117\t  name: clinic-agent-reminders\n   118\t  namespace: clinic-agent\n   119\tspec:\n   120\t  schedule: \"0 17 * * *\"\n   121\t  timeZone: America/Los_Angeles\n   122\t  concurrencyPolicy: Forbid\n   123\t  jobTemplate:\n   124\t    spec:\n   125\t      backoffLimit: 0\n   126\t      activeDeadlineSeconds: 1800\n   127\t      template:\n   128\t        metadata:\n   129\t          labels: { app: clinic-agent-reminders }\n   130\t        spec:\n   131\t          serviceAccountName: clinic-agent-reminders\n   132\t          automountServiceAccountToken: false\n   133\t          restartPolicy: Never\n   134\t          hostUsers: false\n   135\t          securityContext:\n   136\t            runAsNonRoot: true\n   137\t            runAsUser: 65532\n   138\t            runAsGroup: 65532\n   139\t            seccompProfile:\n   140\t              type: RuntimeDefault\n   141\t          containers:\n   142\t            - name: reminders\n   143\t              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   144\t              args: [\"dist/workers/reminders.js\"]\n   145\t              envFrom:\n   146\t                - configMapRef: { name: clinic-agent }\n   147\t              env:\n   148\t                - name: IMAGE_DIGEST\n   149\t                  value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   150\t                - name: GIT_SHA\n   151\t                  value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n   152\t              securityContext:\n   153\t                allowPrivilegeEscalation: false\n   154\t                privileged: false\n   155\t                readOnlyRootFilesystem: true\n   156\t                capabilities:\n   157\t                  drop: [\"ALL\"]\n   158\t---\n   159\t# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n   160\t# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,\n   161\t# the group STS and auth service, and AWS service endpoints.\n   162\tapiVersion: networking.k8s.io/v1\n   163\tkind: NetworkPolicy\n   164\tmetadata:\n   165\t  name: clinic-agent-egress\n   166\t  namespace: clinic-agent\n   167\tspec:\n   168\t  podSelector: {}\n   169\t  policyTypes: [\"Egress\", \"Ingress\"]\n   170\t  ingress:\n   171\t    - from:\n   172\t        - namespaceSelector:\n   173\t            matchLabels: { kubernetes.io/metadata.name: ingress }\n   174\t      ports:\n   175\t        - { port: 8080, protocol: TCP }\n   176\t  egress:\n   177\t    - to:\n   178\t        - namespaceSelector:\n   179\t            matchLabels: { kubernetes.io/metadata.name: kube-system }\n   180\t          podSelector:\n   181\t            matchLabels: { k8s-app: kube-dns }\n   182\t      ports:\n   183\t        - { port: 53, protocol: UDP }\n   184\t        - { port: 53, protocol: TCP }\n   185\t    - to:\n   186\t        - namespaceSelector:\n   187\t            matchLabels: { kubernetes.io/metadata.name: platform }\n   188\t          podSelector:\n   189\t            matchLabels: { app: egress-proxy }\n   190\t      ports:\n   191\t        - { port: 3128, protocol: TCP }\n   192\t    - to:\n   193\t        - ipBlock: { cidr: 10.60.12.0/28 }\n   194\t      ports:\n   195\t        - { port: 443, protocol: TCP }\n     1\t# Security-relevant paths need a review from the platform leads in addition to the two\n     2\t# approvals required by branch protection (infra/terraform/github.tf).\n     3\t*                    @northbay-clinics/clinic-agent-devs\n     4\t/prompts/            @northbay-clinics/agent-platform-leads\n     5\t/config/             @northbay-clinics/agent-platform-leads\n     6\t/release/            @northbay-clinics/agent-platform-leads\n     7\t/infra/              @northbay-clinics/agent-platform-leads @northbay-clinics/cloud-security\n     8\t/k8s/                @northbay-clinics/agent-platform-leads @northbay-clinics/cloud-security\n     9\t/.github/            @northbay-clinics/agent-platform-leads @northbay-clinics/cloud-security\n    10\t/src/tools/          @northbay-clinics/agent-platform-leads\n    11\t/src/control/        @northbay-clinics/agent-platform-leads\n    12\t/src/audit/          @northbay-clinics/agent-platform-leads\n     1\tname: deploy\n     2\t\n     3\t# Deploys the image digest named in release/manifest.json. The digest reaches the manifest through\n     4\t# a reviewed release PR, so what runs is always a reviewed commit.\n     5\ton:\n     6\t  workflow_dispatch:\n     7\t    inputs:\n     8\t      emergency:\n     9\t        description: Emergency change (hotfix/* branch, production-emergency environment)\n    10\t        type: boolean\n    11\t        default: false\n    12\t      owner:\n    13\t        description: Emergency only - person accountable for this change\n    14\t        type: string\n    15\t        default: \"\"\n    16\t      reason:\n    17\t        description: Emergency only - why this cannot wait for a normal release\n    18\t        type: string\n    19\t        default: \"\"\n    20\t      expires_on:\n    21\t        description: Emergency only - date (YYYY-MM-DD) by which it is replaced by a normal release\n    22\t        type: string\n    23\t        default: \"\"\n    24\t\n    25\tpermissions:\n    26\t  contents: read\n    27\t  id-token: write\n    28\t  issues: write\n    29\t\n    30\tconcurrency:\n    31\t  group: deploy-production\n    32\t  cancel-in-progress: false\n    33\t\n    34\tjobs:\n    35\t  deploy:\n    36\t    runs-on: ubuntu-24.04\n    37\t    environment: ${{ inputs.emergency && 'production-emergency' || 'production' }}\n    38\t    steps:\n    39\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    40\t\n    41\t      - name: Emergency change record is complete\n    42\t        if: inputs.emergency\n    43\t        env:\n    44\t          OWNER: ${{ inputs.owner }}\n    45\t          REASON: ${{ inputs.reason }}\n    46\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    47\t        run: |\n    48\t          test -n \"$OWNER\" || { echo \"owner is required\"; exit 1; }\n    49\t          test -n \"$REASON\" || { echo \"reason is required\"; exit 1; }\n    50\t          date -d \"$EXPIRES_ON\" +%F >/dev/null || { echo \"expires_on must be a date\"; exit 1; }\n    51\t          [[ \"$GITHUB_REF_NAME\" == hotfix/* ]] || { echo \"emergency deploys come from hotfix/* branches\"; exit 1; }\n    52\t\n    53\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    54\t        with:\n    55\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-deploy\n    56\t          aws-region: us-west-2\n    57\t\n    58\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    59\t        with:\n    60\t          cosign-release: v2.6.2\n    61\t\n    62\t      - name: Verify image signature\n    63\t        run: |\n    64\t          DIGEST=$(jq -r .image.digest release/manifest.json)\n    65\t          REPO=$(jq -r .image.repository release/manifest.json)\n    66\t          cosign verify \"$REPO@$DIGEST\" \\\n    67\t            --certificate-identity \"https://github.com/northbay-clinics/clinic-agent/.github/workflows/ci.yml@refs/heads/main\" \\\n    68\t            --certificate-oidc-issuer https://token.actions.githubusercontent.com\n    69\t          grep -q \"$DIGEST\" k8s/deployment.yaml || { echo \"k8s/deployment.yaml does not use the manifest digest\"; exit 1; }\n    70\t\n    71\t      - name: Apply\n    72\t        run: |\n    73\t          aws eks update-kubeconfig --name clinic-agent-prod\n    74\t          kubectl apply -f k8s/deployment.yaml\n    75\t          kubectl -n clinic-agent annotate deployment/clinic-agent --overwrite \\\n    76\t            northbay.example/git-sha=\"$GITHUB_SHA\" \\\n    77\t            northbay.example/release=\"$(jq -r .release release/manifest.json)\" \\\n    78\t            northbay.example/deployed-by=\"$GITHUB_ACTOR\" \\\n    79\t            northbay.example/run=\"$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID\"\n    80\t          kubectl -n clinic-agent rollout status deployment/clinic-agent --timeout=5m\n    81\t\n    82\t      - name: Open follow-up review for emergency change\n    83\t        if: inputs.emergency\n    84\t        env:\n    85\t          GH_TOKEN: ${{ github.token }}\n    86\t          OWNER: ${{ inputs.owner }}\n    87\t          REASON: ${{ inputs.reason }}\n    88\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    89\t        run: |\n    90\t          gh issue create \\\n    91\t            --title \"Follow-up review: emergency deploy ${GITHUB_SHA::8}\" \\\n    92\t            --label emergency-change,needs-review \\\n    93\t            --assignee \"$OWNER\" \\\n    94\t            --body \"Owner: $OWNER\n    95\t          Reason: $REASON\n    96\t          Ends: $EXPIRES_ON\n    97\t          Commit: $GITHUB_SHA\n    98\t          Approved in environment production-emergency by a required reviewer (see run $GITHUB_RUN_ID).\n    99\t          Review and merge to main via normal PR before the end date.\"\n     1\t# Who can change production: only the deploy workflow running in the \"production\" or\n     2\t# \"production-emergency\" GitHub environment can assume the deploy role, and both environments\n     3\t# require a named reviewer from agent-platform-leads. Nobody else has write access to the\n     4\t# clinic-agent namespace (see access_entries in main.tf), and the cluster API is private.\n     5\t\n     6\tprovider \"github\" {\n     7\t  owner = \"northbay-clinics\"\n     8\t}\n     9\t\n    10\tdata \"github_team\" \"leads\" {\n    11\t  slug = \"agent-platform-leads\"\n    12\t}\n    13\t\n    14\tresource \"github_branch_protection\" \"main\" {\n    15\t  repository_id = \"clinic-agent\"\n    16\t  pattern       = \"main\"\n    17\t\n    18\t  enforce_admins                  = true\n    19\t  allows_force_pushes             = false\n    20\t  allows_deletions                = false\n    21\t  required_linear_history         = true\n    22\t  require_signed_commits          = true\n    23\t  require_conversation_resolution = true\n    24\t\n    25\t  required_pull_request_reviews {\n    26\t    required_approving_review_count = 2\n    27\t    require_code_owner_reviews      = true\n    28\t    dismiss_stale_reviews           = true\n    29\t    require_last_push_approval      = true\n    30\t  }\n    31\t\n    32\t  required_status_checks {\n    33\t    strict   = true\n    34\t    contexts = [\"ci / test\", \"ci / manifest-check\"]\n    35\t  }\n    36\t}\n    37\t\n    38\tresource \"github_repository_environment\" \"production\" {\n    39\t  repository  = \"clinic-agent\"\n    40\t  environment = \"production\"\n    41\t  reviewers {\n    42\t    teams = [data.github_team.leads.id]\n    43\t  }\n    44\t  prevent_self_review = true\n    45\t  deployment_branch_policy {\n    46\t    protected_branches     = true\n    47\t    custom_branch_policies = false\n    48\t  }\n    49\t}\n    50\t\n    51\tresource \"github_repository_environment\" \"production_emergency\" {\n    52\t  repository  = \"clinic-agent\"\n    53\t  environment = \"production-emergency\"\n    54\t  reviewers {\n    55\t    teams = [data.github_team.leads.id]\n    56\t  }\n    57\t  prevent_self_review = true\n    58\t  deployment_branch_policy {\n    59\t    protected_branches     = false\n    60\t    custom_branch_policies = true\n    61\t  }\n    62\t}\n    63\t\n    64\tresource \"github_repository_environment_deployment_policy\" \"emergency_branches\" {\n    65\t  repository     = \"clinic-agent\"\n    66\t  environment    = github_repository_environment.production_emergency.environment\n    67\t  branch_pattern = \"hotfix/*\"\n    68\t}\n    69\t\n    70\tresource \"aws_iam_role\" \"deploy\" {\n    71\t  name = \"clinic-agent-deploy\"\n    72\t  assume_role_policy = jsonencode({\n    73\t    Version = \"2012-10-17\"\n    74\t    Statement = [{\n    75\t      Effect    = \"Allow\"\n    76\t      Principal = { Federated = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/token.actions.githubusercontent.com\" }\n    77\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n    78\t      Condition = {\n    79\t        StringEquals = {\n    80\t          \"token.actions.githubusercontent.com:aud\" = \"sts.amazonaws.com\"\n    81\t          \"token.actions.githubusercontent.com:sub\" = [\n    82\t            \"repo:northbay-clinics/clinic-agent:environment:production\",\n    83\t            \"repo:northbay-clinics/clinic-agent:environment:production-emergency\",\n    84\t          ]\n    85\t        }\n    86\t      }\n    87\t    }]\n    88\t  })\n    89\t}\n    90\t\n    91\tresource \"aws_iam_role_policy\" \"deploy\" {\n    92\t  name = \"clinic-agent-deploy\"\n    93\t  role = aws_iam_role.deploy.id\n    94\t  policy = jsonencode({\n    95\t    Version = \"2012-10-17\"\n    96\t    Statement = [\n    97\t      {\n    98\t        Effect   = \"Allow\"\n    99\t        Action   = [\"ecr:GetAuthorizationToken\"]\n   100\t        Resource = \"*\"\n   101\t      },\n   102\t      {\n   103\t        Effect   = \"Allow\"\n   104\t        Action   = [\"ecr:BatchCheckLayerAvailability\", \"ecr:PutImage\", \"ecr:InitiateLayerUpload\", \"ecr:UploadLayerPart\", \"ecr:CompleteLayerUpload\", \"ecr:BatchGetImage\"]\n   105\t        Resource = aws_ecr_repository.agent.arn\n   106\t      },\n   107\t      {\n   108\t        Effect   = \"Allow\"\n   109\t        Action   = [\"eks:DescribeCluster\"]\n   110\t        Resource = module.eks.cluster_arn\n   111\t      },\n   112\t    ]\n   113\t  })\n   114\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_011bF1W9hXVvaieDBgiL7ouJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
