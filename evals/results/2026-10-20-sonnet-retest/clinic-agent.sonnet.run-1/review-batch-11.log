...active.values()].map((a) => a.tenantId))].map((t) => ({ pk: `tenant#${t}` }))],\n          ConsistentRead: true,\n        },\n      },\n    }),\n  );\n  const next = new Set<string>();\n  for (const item of res.Responses?.[env.controlTable] ?? []) {\n    if (item.halted === true) next.add(String(item.pk));\n  }\n  halted = next;\n  lastRead = Date.now();\n}\n\nexport const killSwitch = {\n  register(runId: string, tenantId: string, abort: AbortController): () => void {\n    active.set(runId, { tenantId, abort });\n    return () => active.delete(runId);\n  },\n\n  async assertRunning(tenantId: string): Promise<void> {\n    if (Date.now() - lastRead > POLL_MS) {\n      try {\n        await refresh();\n      } catch {\n        // If the control table cannot be read, treat the agent as halted.\n        throw new Halted(\"control-unreadable\");\n      }\n    }\n    if (halted.has(\"global\")) throw new Halted(\"global\");\n    if (halted.has(`tenant#${tenantId}`)) throw new Halted(`tenant#${tenantId}`);\n  },\n\n{\n  \"release\": \"clinic-agent-3.4.1\",\n  \"agentTypeId\": \"sha256:7c2e91f04ab35d6e8f1029c4b7a6d3e5f8091a2b3c4d5e6f708192a3b4c5d6e7\",\n  \"image\": {\n    \"repository\": \"418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent\",\n    \"digest\": \"sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\"\n  },\n  \"harness\": {\n    \"version\": \"3.4.1\",\n    \"gitSha\": \"e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\"\n  },\n  \"prompts\": [\n    { \"path\": \"prompts/system.md\", \"sha256\": \"5d1e0c9b8a7f6e5d4c3b2a1908f7e6d5c4b3a291807f6e5d4c3b2a19087f6e5d\" },\n    { \"path\": \"prompts/intent-classifier.txt\", \"sha256\": \"a3f9e1d7c5b3a1f9e7d5c3b1a9f7e5d3c1b9a7f5e3d1c9b7a5f3e1d9c7b5a3f1\" }\n  ],\n  \"models\": [\n    {\n      \"role\": \"agent\",\n      \"provider\": \"anthropic\",\n      \"requestedId\": \"claude-sonnet-4-5-20250929\",\n      \"kind\": \"pinned_snapshot\",\n      \"versionDoc\": { \"url\": \"https://docs.anthrop