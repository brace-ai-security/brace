sn't silently pass.\"\n    },\n    {\n      \"id\": \"H011\",\n      \"pattern\": \"P50\",\n      \"item\": \"E03\",\n      \"title\": \"Tool list loaded from server\",\n      \"file\": \"src/integrations/ehr-mcp.ts\",\n      \"line\": 78,\n      \"text\": \"c.listTools(),\",\n      \"ask\": \"After loading, are each tool's description and schema compared against an approved fingerprint, so a changed tool is blocked rather than passed to the model?\"\n    }\n  ]\n}\n{\n  \"sites\": [\n    {\n      \"id\": \"If7878f59fe\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/agent/budget.ts:165\",\n      \"quote\": \"const r = await this.store.add(key, amount, max, ttl);\"\n    },\n    {\n      \"id\": \"I11c134ddd9\",\n      \"kind\": \"model_call\",\n      \"evidence\": \"src/agent/classifier.ts:45\",\n      \"quote\": \"res = await client.messages.create(\"\n    },\n    {\n      \"id\": \"I1ae2dd3bba\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/agent/loop.ts:107\",\n      \"quote\": \"await audit.record({ ...ident(), event: \\\"run.stopped\\\", reason });\"\n    },\n    {\n      \"id\": \"If45cb9d300\",\n      \"kind\": \"handoff\",\n      \"evidence\": \"src/agent/loop.ts:111\",\n      \"quote\": \"return { text: \\\"Sorry, we couldn't finish that here. Our front desk will follow up.\\\", handoff: { reason } };\"\n    },\n    {\n      \"id\": \"If194378c0f\",\n      \"kind\": \"handoff\",\n      \"evidence\": \"src/agent/loop.ts:20\",\n      \"quote\": \"handoff: null | { reason: string };\"\n    },\n    {\n      \"id\": \"Iff7ceb0cf2\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/agent/loop.ts:36\",\n      \"quote\": \"await audit.record({ ...ident(), event: \\\"run.started\\\", detail: { channel: ctx.channel } });\"\n    },\n    {\n      \"id\": \"I6635d73291\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/agent/loop.ts:42\",\n      \"quote\": \"await audit.record({ ...ident(), event: \\\"intent.