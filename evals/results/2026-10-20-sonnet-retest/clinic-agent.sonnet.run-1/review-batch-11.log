e\": \"src/server.ts:49\",\n      \"quote\": \"registry.registerMcp(\\\"ehr\\\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\"\n    },\n    {\n      \"id\": \"I8fa6be25eb\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/tools/executor.ts:51\",\n      \"quote\": \"await audit.record({ ...base, event: \\\"tool.denied\\\", reason });\"\n    },\n    {\n      \"id\": \"Ia3450fc0b4\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/tools/executor.ts:77\",\n      \"quote\": \"await audit.record({ ...base, event: \\\"tool.approval_requested\\\", approvalId: rec.id });\"\n    },\n    {\n      \"id\": \"I5b433eb517\",\n      \"kind\": \"tool_call\",\n      \"evidence\": \"src/tools/executor.ts:86\",\n      \"quote\": \"const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\"\n    },\n    {\n      \"id\": \"Ifd82e31a71\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/tools/executor.ts:89\",\n      \"quote\": \"await audit.record({ ...base, event: \\\"tool.executed\\\", approvalId, detail: { clinicId } });\"\n    },\n    {\n      \"id\": \"I077346bcfe\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/tools/executor.ts:93\",\n      \"quote\": \"await audit.record({ ...base, event: \\\"tool.failed\\\", approvalId, reason: (err as Error).message.slice(0, 300) });\"\n    },\n    {\n      \"id\": \"I140bd2f97f\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/tools/registry.ts:101\",\n      \"quote\": \"registerMcp(\"\n    },\n    {\n      \"id\": \"I131c91d8de\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/tools/registry.ts:127\",\n      \"quote\": \"this.add({\"\n    },\n    {\n      \"id\": \"I18aec0bd94\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/tools/registry.ts:94\",\n      \"quote\": \"for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\"\n    },\n    {\n      \"id\": \"I3a7e594185\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/workers/reminders.ts:36\",","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0191WHzQuZk6sopx9NymMY8Q","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDXSZuVdK5a9hxfiwBbv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QWqMxCwm9okSUBhG4t5nSk","name":"Bash","input":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-ot33r5j4/agent && cat -n src/audit/recorder.ts src/agent/identity.ts infra/terraform/iam.tf; cat -n src/integrations/*.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4810,"cache_read_input_tokens":20512,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4810},"output_tokens":17,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8c561077-96df-4d9c-ad99-669be22cb1e5","uuid":"3408b164-85cc-4da2-905d-3f8f0faf9ae6","timestamp":"2026-10-20T12:56:16.898Z","request_id":"req_011CgDXSZZfUPRPvDdBAY54Q","wire_tool_inputs":{"toolu_01QWqMxCwm9okSUBhG4t5nSk":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-ot33r5j4/agent && cat -n src/audit/recorder.ts src/agent/identity.ts infra/terraform/iam.tf; cat -n src/integrations/*.ts"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QWqMxCwm9okSUBhG4t5nSk","type":"tool_result","content":"     1\timport { FirehoseClient, PutRecordCommand } from \"@aws-sdk/client-firehose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Every audit record carries the six identity fields. Values come from RunContext, which is built\n     7\t// by the HTTP layer and the worker, never from model output.\n     8\texport const IdentityFields = z.object({\n     9\t  accountableParty: z.string().min(1),\n    10\t  operationalOwner: z.string().min(1),\n    11\t  tenantId: z.string().min(1),\n    12\t  agentTypeId: z.string().startsWith(\"sha256:\"),\n    13\t  agentInstanceId: z.string().uuid(),\n    14\t  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),\n    15\t});\n    16\t\n    17\texport const AuditEvent = IdentityFields.extend({\n    18\t  eventId: z.string().uuid(),\n    19\t  ts: z.string().datetime(),\n    20\t  runId: z.string().uuid(),\n    21\t  event: z.enum([\n    22\t    \"run.started\",\n    23\t    \"run.stopped\",\n    24\t    \"run.completed\",\n    25\t    \"intent.classified\",\n    26\t    \"model.decision\",\n    27\t    \"tool.denied\",\n    28\t    \"tool.approval_requested\",\n    29\t    \"tool.executed\",\n    30\t    \"tool.failed\",\n    31\t    \"payment.refund\",\n    32\t    \"peer.call\",\n    33\t    \"reminder.sent\",\n    34\t  ]),\n    35\t  subject: z.object({ kind: z.enum([\"patient\", \"staff\", \"system\"]), id: z.string() }),\n    36\t  tool: z.string().optional(),\n    37\t  toolUseId: z.string().optional(),\n    38\t  policyVersion: z.string().optional(),\n    39\t  approvalId: z.string().optional(),\n    40\t  reason: z.string().optional(),\n    41\t  context: z\n    42\t    .object({\n    43\t      tokens: z.number().int().nonnegative().nullable(),\n    44\t      status: z.enum([\"measured\", \"estimated\", \"unavailable\"]),\n    45\t      method: z.string(),\n    46\t      cachedInputTokens: z.number().int().nonnegative().nullable(),\n    47\t      compacted: z.boolean(),\n    48\t    })\n    49\t    .optional(),\n    50\t  detail: z.record(z.unknown()).optional(),\n    51\t});\n    52\texport type AuditEvent = z.infer<typeof AuditEvent>;\n    53\t\n    54\tconst firehose = new FirehoseClient({ region: env.region });\n    55\t\n    56\texport class AuditUnavailable extends Error {}\n    57\t\n    58\texport const audit = {\n    59\t  async record(e: Omit<AuditEvent, \"eventId\" | \"ts\">): Promise<void> {\n    60\t    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });\n    61\t    try {\n    62\t      await firehose.send(\n    63\t        new PutRecordCommand({\n    64\t          DeliveryStreamName: env.auditStream,\n    65\t          Record: { Data: Buffer.from(JSON.stringify(full) + \"\\n\") },\n    66\t        }),\n    67\t      );\n    68\t    } catch (err) {\n    69\t      // Callers treat this as a hard failure: an action that cannot be audited does not run.\n    70\t      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);\n    71\t    }\n    72\t  },\n    73\t};\n    74\t\n    75\t// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.\n    76\tconst DROP_KEYS = new Set([\"ssn\", \"dateOfBirth\", \"dob\", \"memberId\", \"subscriberId\", \"cardNumber\", \"cardLast4\", \"address\"]);\n    77\tconst PATTERNS: Array<[RegExp, string]> = [\n    78\t  [/\\b\\d{3}-\\d{2}-\\d{4}\\b/g, \"[ssn]\"],\n    79\t  [/\\b(?:\\d[ -]?){13,19}\\b/g, \"[card]\"],\n    80\t  [/\\b[A-Z]{3}\\d{9}\\b/g, \"[member-id]\"],\n    81\t];\n    82\t\n    83\texport function redactPhi(value: unknown): unknown {\n    84\t  if (typeof value === \"string\") {\n    85\t    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);\n    86\t  }\n    87\t  if (Array.isArray(value)) return value.map(redactPhi);\n    88\t  if (value && typeof value === \"object\") {\n    89\t    const out: Record<string, unknown> = {};\n    90\t    for (const [k, v] of Object.entries(value)) {\n    91\t      if (DROP_KEYS.has(k)) continue;\n    92\t      out[k] = redactPhi(v);\n    93\t    }\n    94\t    return out;\n    95\t  }\n    96\t  return value;\n    97\t}\n     1\timport { createHash, randomUUID } from \"node:crypto\";\n     2\timport { readdirSync, readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n     5\t\n     6\t// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n     7\t// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\n     8\tconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n     9\t\n    10\texport interface TypeIdInputs {\n    11\t  imageDigest: string;\n    12\t  harnessVersion: string;\n    13\t  harnessGitSha: string;\n    14\t}\n    15\t\n    16\texport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n    17\t  const parts: Array<[string, Buffer]> = [\n    18\t    [\"image\", Buffer.from(inputs.imageDigest)],\n    19\t    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    20\t    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n    21\t  ];\n    22\t  const promptDir = join(ROOT, \"prompts\");\n    23\t  const promptFiles = readdirSync(promptDir)\n    24\t    .filter((f) => f.endsWith(\".txt\"))\n    25\t    .sort();\n    26\t  for (const f of promptFiles) {\n    27\t    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n    28\t  }\n    29\t  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n    30\t  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n    31\t  for (const f of CONFIG_FILES) {\n    32\t    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n    33\t  }\n    34\t  return parts;\n    35\t}\n    36\t\n    37\texport function computeAgentTypeId(inputs: TypeIdInputs): string {\n    38\t  const h = createHash(\"sha256\");\n    39\t  for (const [label, bytes] of typeIdManifest(inputs)) {\n    40\t    h.update(label);\n    41\t    h.update(\"\\0\");\n    42\t    h.update(bytes);\n    43\t    h.update(\"\\0\");\n    44\t  }\n    45\t  return `sha256:${h.digest(\"hex\")}`;\n    46\t}\n    47\t\n    48\t// One instance id per process. Pods are the unit an operator contains.\n    49\texport const AGENT_INSTANCE_ID = randomUUID();\n    50\t\n    51\tlet AGENT_TYPE_ID = \"\";\n    52\texport function setAgentTypeId(id: string): void {\n    53\t  AGENT_TYPE_ID = id;\n    54\t}\n    55\t\n    56\texport interface Subject {\n    57\t  kind: \"patient\" | \"staff\" | \"system\";\n    58\t  id: string;\n    59\t}\n    60\t\n    61\texport interface Logger {\n    62\t  info(obj: object, msg?: string): void;\n    63\t  warn(obj: object, msg?: string): void;\n    64\t  error(obj: object, msg?: string): void;\n    65\t}\n    66\t\n    67\texport interface RunContext {\n    68\t  runId: string;\n    69\t  tenantId: string;\n    70\t  subject: Subject;\n    71\t  channel: \"sms\" | \"webchat\" | \"reminder\";\n    72\t  traceparent: string;\n    73\t  log: Logger;\n    74\t  identity(): {\n    75\t    accountableParty: string;\n    76\t    operationalOwner: string;\n    77\t    tenantId: string;\n    78\t    agentTypeId: string;\n    79\t    agentInstanceId: string;\n    80\t    traceparent: string;\n    81\t  };\n    82\t  workloadToken(): Promise<string>;\n    83\t}\n    84\t\n    85\t// Projected service-account token (audience: the group STS), rotated by the kubelet.\n    86\tconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n    87\t\n    88\texport function newRunContext(init: {\n    89\t  tenantId: string;\n    90\t  subject: Subject;\n    91\t  channel: RunContext[\"channel\"];\n    92\t  traceparent?: string;\n    93\t  log: Logger;\n    94\t}): RunContext {\n    95\t  const runId = randomUUID();\n    96\t  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n    97\t  return {\n    98\t    runId,\n    99\t    tenantId: init.tenantId,\n   100\t    subject: init.subject,\n   101\t    channel: init.channel,\n   102\t    traceparent,\n   103\t    log: init.log,\n   104\t    identity: () => ({\n   105\t      accountableParty: env.accountableParty,\n   106\t      operationalOwner: env.operationalOwner,\n   107\t      tenantId: init.tenantId,\n   108\t      agentTypeId: AGENT_TYPE_ID,\n   109\t      agentInstanceId: AGENT_INSTANCE_ID,\n   110\t      traceparent,\n   111\t    }),\n   112\t    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n   113\t  };\n   114\t}\n     1\t# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:\n     2\t# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.\n     3\tresource \"aws_iam_role\" \"runtime\" {\n     4\t  name                 = \"clinic-agent-runtime\"\n     5\t  max_session_duration = 3600\n     6\t  assume_role_policy = jsonencode({\n     7\t    Version = \"2012-10-17\"\n     8\t    Statement = [{\n     9\t      Effect    = \"Allow\"\n    10\t      Principal = { Federated = module.eks.oidc_provider_arn }\n    11\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n    12\t      Condition = {\n    13\t        StringEquals = {\n    14\t          \"${module.eks.oidc_provider}:sub\" = [\n    15\t            \"system:serviceaccount:clinic-agent:clinic-agent\",\n    16\t            \"system:serviceaccount:clinic-agent:clinic-agent-reminders\",\n    17\t          ]\n    18\t          \"${module.eks.oidc_provider}:aud\" = \"sts.amazonaws.com\"\n    19\t        }\n    20\t      }\n    21\t    }]\n    22\t  })\n    23\t}\n    24\t\n    25\tresource \"aws_iam_role_policy\" \"runtime\" {\n    26\t  name = \"clinic-agent-runtime\"\n    27\t  role = aws_iam_role.runtime.id\n    28\t  policy = jsonencode({\n    29\t    Version = \"2012-10-17\"\n    30\t    Statement = [\n    31\t      {\n    32\t        Sid      = \"ReadClinicSecrets\"\n    33\t        Effect   = \"Allow\"\n    34\t        Action   = [\"secretsmanager:GetSecretValue\"]\n    35\t        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\n    36\t      },\n    37\t      {\n    38\t        Sid    = \"AgentState\"\n    39\t        Effect = \"Allow\"\n    40\t        Action = [\n    41\t          \"dynamodb:GetItem\",\n    42\t          \"dynamodb:BatchGetItem\",\n    43\t          \"dynamodb:PutItem\",\n    44\t          \"dynamodb:UpdateItem\",\n    45\t          \"dynamodb:Query\",\n    46\t        ]\n    47\t        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*\"\n    48\t      },\n    49\t      {\n    50\t        Sid      = \"Audit\"\n    51\t        Effect   = \"Allow\"\n    52\t        Action   = [\"firehose:PutRecord\", \"firehose:PutRecordBatch\"]\n    53\t        Resource = aws_kinesis_firehose_delivery_stream.audit.arn\n    54\t      },\n    55\t    ]\n    56\t  })\n    57\t}\n    58\t\n    59\t# Operators who may stop the agent. Assumable only through SSO by the on-call group.\n    60\tresource \"aws_iam_role\" \"ops_killswitch\" {\n    61\t  name = \"clinic-agent-ops\"\n    62\t  assume_role_policy = jsonencode({\n    63\t    Version = \"2012-10-17\"\n    64\t    Statement = [{\n    65\t      Effect    = \"Allow\"\n    66\t      Principal = { AWS = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\" }\n    67\t      Action    = \"sts:AssumeRole\"\n    68\t      Condition = {\n    69\t        StringLike = { \"aws:PrincipalArn\" = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*\" }\n    70\t      }\n    71\t    }]\n    72\t  })\n    73\t}\n    74\t\n    75\tresource \"aws_iam_role_policy\" \"ops_killswitch\" {\n    76\t  name = \"clinic-agent-ops\"\n    77\t  role = aws_iam_role.ops_killswitch.id\n    78\t  policy = jsonencode({\n    79\t    Version = \"2012-10-17\"\n    80\t    Statement = [{\n    81\t      Effect   = \"Allow\"\n    82\t      Action   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:GetItem\"]\n    83\t      Resource = aws_dynamodb_table.control.arn\n    84\t    }]\n    85\t  })\n    86\t}\n    87\t\n    88\tresource \"aws_iam_role\" \"firehose\" {\n    89\t  name = \"clinic-agent-audit-firehose\"\n    90\t  assume_role_policy = jsonencode({\n    91\t    Version   = \"2012-10-17\"\n    92\t    Statement = [{ Effect = \"Allow\", Principal = { Service = \"firehose.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n    93\t  })\n    94\t}\n    95\t\n    96\tresource \"aws_iam_role_policy\" \"firehose\" {\n    97\t  name = \"write-audit-bucket\"\n    98\t  role = aws_iam_role.firehose.id\n    99\t  policy = jsonencode({\n   100\t    Version = \"2012-10-17\"\n   101\t    Statement = [{\n   102\t      Effect   = \"Allow\"\n   103\t      Action   = [\"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:GetBucketLocation\"]\n   104\t      Resource = [aws_s3_bucket.audit.arn, \"${aws_s3_bucket.audit.arn}/*\"]\n   105\t    }]\n   106\t  })\n   107\t}\n     1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n     2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n     3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     4\timport { Agent } from \"undici\";\n     5\timport type { PeerCertificate } from \"node:tls\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n     8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n     9\t\n    10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n    11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n    12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n    13\t\n    14\tconst sm = new SecretsManagerClient({ region: env.region });\n    15\t\n    16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n    17\t  const expected = server.tlsCertSha256.toLowerCase();\n    18\t  return new Agent({\n    19\t    connect: {\n    20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n    21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n    22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n    23\t      },\n    24\t    },\n    25\t  });\n    26\t}\n    27\t\n    28\ttype Token = { value: string; exp: number };\n    29\tconst tokens = new Map<string, Token>();\n    30\t\n    31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n    32\t  const cacheKey = `${clinicId}|${scope}`;\n    33\t  const hit = tokens.get(cacheKey);\n    34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n    35\t\n    36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n    37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n    38\t  const res = await fetch(token_url, {\n    39\t    method: \"POST\",\n    40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n    42\t  });\n    43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n    44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n    45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n    46\t  return body.access_token;\n    47\t}\n    48\t\n    49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n    50\tconst sessions = new Map<string, Client>();\n    51\t\n    52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n    53\t  const existing = sessions.get(clinicId);\n    54\t  if (existing) return existing;\n    55\t  const token = await ehrToken(clinicId, SCOPES);\n    56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    57\t    requestInit: {\n    58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n    59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n    60\t      dispatcher: pinnedDispatcher(server),\n    61\t    },\n    62\t  });\n    63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n    64\t  await client.connect(transport);\n    65\t  sessions.set(clinicId, client);\n    66\t  setTimeout(() => {\n    67\t    sessions.delete(clinicId);\n    68\t    void client.close();\n    69\t  }, 4 * 60_000).unref();\n    70\t  return client;\n    71\t}\n    72\t\n    73\texport function ehr(server: ConfiguredServer) {\n    74\t  return {\n    75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n    76\t      const c = await session(server, \"_catalog\");\n    77\t      const [tools, prompts, templates] = await Promise.all([\n    78\t        c.listTools(),\n    79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n    80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n    81\t      ]);\n    82\t      return {\n    83\t        reportedName: c.getServerVersion()?.name,\n    84\t        meta: {\n    85\t          instructions: c.getInstructions(),\n    86\t          tools: tools.tools as ServerMeta[\"tools\"],\n    87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n    88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n    89\t        },\n    90\t      };\n    91\t    },\n    92\t\n    93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n    94\t      const c = await session(server, opts.clinicId);\n    95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n    96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n    97\t      return res.structuredContent ?? res.content;\n    98\t    },\n    99\t\n   100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n   101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n   102\t        id: string;\n   103\t        patientId: string;\n   104\t        start: string;\n   105\t        serviceCode: string;\n   106\t        payerId?: string;\n   107\t        depositId?: string;\n   108\t        status: string;\n   109\t      };\n   110\t    },\n   111\t\n   112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n   113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n   114\t        id: string;\n   115\t        patientId: string;\n   116\t        start: string;\n   117\t        phone: string;\n   118\t        smsOptIn: boolean;\n   119\t        locationName: string;\n   120\t      }>;\n   121\t    },\n   122\t  };\n   123\t}\n   124\texport type Ehr = ReturnType<typeof ehr>;\n     1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n     7\t//\n     8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n     9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n    10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n    11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n    12\t//\n    13\t// Answers come back as a signed attestation (JWS) inside a data part.\n    14\t\n    15\tconst Eligibility = z\n    16\t  .object({\n    17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    18\t    planName: z.string().max(120).optional(),\n    19\t    copayCents: z.number().int().nonnegative().optional(),\n    20\t    depositWaived: z.boolean().default(false),\n    21\t    checkedAt: z.string().datetime(),\n    22\t  })\n    23\t  .strict();\n    24\texport type Eligibility = z.infer<typeof Eligibility>;\n    25\t\n    26\tconst Rpc = z.object({\n    27\t  jsonrpc: z.literal(\"2.0\"),\n    28\t  id: z.string(),\n    29\t  result: z.object({\n    30\t    kind: z.literal(\"message\"),\n    31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n    32\t  }),\n    33\t});\n    34\t\n    35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n    36\t  const res = await fetch(env.tokenExchangeUrl, {\n    37\t    method: \"POST\",\n    38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    39\t    body: new URLSearchParams({\n    40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    41\t      subject_token: workloadToken,\n    42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n    43\t      audience: \"eligibility-agent\",\n    44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n    45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    46\t    }),\n    47\t  });\n    48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n    49\t  return ((await res.json()) as { access_token: string }).access_token;\n    50\t}\n    51\t\n    52\texport async function checkEligibility(\n    53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n    54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n    55\t): Promise<Eligibility> {\n    56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n    57\t  const requestId = randomUUID();\n    58\t  const res = await fetch(env.eligibilityUrl, {\n    59\t    method: \"POST\",\n    60\t    signal: opts.signal,\n    61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    62\t    body: JSON.stringify({\n    63\t      jsonrpc: \"2.0\",\n    64\t      id: requestId,\n    65\t      method: \"message/send\",\n    66\t      params: {\n    67\t        message: {\n    68\t          role: \"user\",\n    69\t          messageId: requestId,\n    70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n    71\t        },\n    72\t      },\n    73\t    }),\n    74\t  });\n    75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n    76\t  const text = await res.text();\n    77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n    78\t  const rpc = Rpc.parse(JSON.parse(text));\n    79\t\n    80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n    81\t  const header = decodeProtectedHeader(attestation);\n    82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n    83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n    84\t  const { payload } = await jwtVerify(attestation, keys, {\n    85\t    issuer: env.eligibilityIssuer,\n    86\t    audience: \"clinic-agent\",\n    87\t    maxTokenAge: \"5m\",\n    88\t    algorithms: [\"ES256\"],\n    89\t  });\n    90\t  return Eligibility.parse(payload.eligibility);\n    91\t}\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n     5\t// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n     6\t// The provider enforces Idempotency-Key for 24 hours.\n     7\t\n     8\tconst sm = new SecretsManagerClient({ region: env.region });\n     9\tconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n    10\t\n    11\tasync function key(clinicId: string): Promise<string> {\n    12\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n    13\t  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n    14\t}\n    15\t\n    16\texport interface Refund {\n    17\t  id: string;\n    18\t  depositId: string;\n    19\t  amountCents: number;\n    20\t  status: \"pending\" | \"succeeded\" | \"failed\";\n    21\t}\n    22\t\n    23\texport const payments = {\n    24\t  async refundDeposit(\n    25\t    clinicId: string,\n    26\t    req: { depositId: string; reason: string; idempotencyKey: string },\n    27\t    signal?: AbortSignal,\n    28\t  ): Promise<Refund> {\n    29\t    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n    30\t      method: \"POST\",\n    31\t      signal,\n    32\t      headers: {\n    33\t        authorization: `Bearer ${await key(clinicId)}`,\n    34\t        \"content-type\": \"application/json\",\n    35\t        \"idempotency-key\": req.idempotencyKey,\n    36\t      },\n    37\t      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    38\t    });\n    39\t    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    40\t    return (await res.json()) as Refund;\n    41\t  },\n    42\t};\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n     5\t// can send; free-form text goes through sms__send_freeform, which needs approval.\n     6\t\n     7\tconst sm = new SecretsManagerClient({ region: env.region });\n     8\tconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n     9\t\n    10\texport const TEMPLATES = {\n    11\t  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n    12\t  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n    13\t  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n    14\t  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n    15\t} as const;\n    16\texport type TemplateId = keyof typeof TEMPLATES;\n    17\t\n    18\texport function render(id: TemplateId, vars: Record<string, string>): string {\n    19\t  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n    20\t}\n    21\t\n    22\tasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n    23\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n    24\t  const v = JSON.parse(s.SecretString ?? \"{}\");\n    25\t  return { token: v.api_token, from: v.from_number };\n    26\t}\n    27\t\n    28\texport const sms = {\n    29\t  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n    30\t    const c = await creds(clinicId);\n    31\t    const res = await fetch(`${BASE}/messages`, {\n    32\t      method: \"POST\",\n    33\t      signal,\n    34\t      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n    35\t      body: JSON.stringify({ from: c.from, to, body }),\n    36\t    });\n    37\t    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n    38\t    return (await res.json()) as { messageId: string };\n    39\t  },\n    40\t};","is_error":false}]},"parent_tool_use_id":null,"session_id":"8c561077-96df-4d9c-ad99-669be22cb1e5","uuid":"7db7922f-6ac7-4bf1-80c1-b7f29015ff1d","timestamp":"2026-10-20T12:56:16.942Z","tool_use_result":{"stdout":"     1\timport { FirehoseClient, PutRecordCommand } from \"@aws-sdk/client-firehose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Every audit record carries the six identity fields. Values come from RunContext, which is built\n     7\t// by the HTTP layer and the worker, never from model output.\n     8\texport const IdentityFields = z.object({\n     9\t  accountableParty: z.string().min(1),\n    10\t  operationalOwner: z.string().min(1),\n    11\t  tenantId: z.string().min(1),\n    12\t  agentTypeId: z.string().startsWith(\"sha256:\"),\n    13\t  agentInstanceId: z.string().uuid(),\n    14\t  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),\n    15\t});\n    16\t\n    17\texport const AuditEvent = IdentityFields.extend({\n    18\t  eventId: z.string().uuid(),\n    19\t  ts: z.string().datetime(),\n    20\t  runId: z.string().uuid(),\n    21\t  event: z.enum([\n    22\t    \"run.started\",\n    23\t    \"run.stopped\",\n    24\t    \"run.completed\",\n    25\t    \"intent.classified\",\n    26\t    \"model.decision\",\n    27\t    \"tool.denied\",\n    28\t    \"tool.approval_requested\",\n    29\t    \"tool.executed\",\n    30\t    \"tool.failed\",\n    31\t    \"payment.refund\",\n    32\t    \"peer.call\",\n    33\t    \"reminder.sent\",\n    34\t  ]),\n    35\t  subject: z.object({ kind: z.enum([\"patient\", \"staff\", \"system\"]), id: z.string() }),\n    36\t  tool: z.string().optional(),\n    37\t  toolUseId: z.string().optional(),\n    38\t  policyVersion: z.string().optional(),\n    39\t  approvalId: z.string().optional(),\n    40\t  reason: z.string().optional(),\n    41\t  context: z\n    42\t    .object({\n    43\t      tokens: z.number().int().nonnegative().nullable(),\n    44\t      status: z.enum([\"measured\", \"estimated\", \"unavailable\"]),\n    45\t      method: z.string(),\n    46\t      cachedInputTokens: z.number().int().nonnegative().nullable(),\n    47\t      compacted: z.boolean(),\n    48\t    })\n    49\t    .optional(),\n    50\t  detail: z.record(z.unknown()).optional(),\n    51\t});\n    52\texport type AuditEvent = z.infer<typeof AuditEvent>;\n    53\t\n    54\tconst firehose = new FirehoseClient({ region: env.region });\n    55\t\n    56\texport class AuditUnavailable extends Error {}\n    57\t\n    58\texport const audit = {\n    59\t  async record(e: Omit<AuditEvent, \"eventId\" | \"ts\">): Promise<void> {\n    60\t    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });\n    61\t    try {\n    62\t      await firehose.send(\n    63\t        new PutRecordCommand({\n    64\t          DeliveryStreamName: env.auditStream,\n    65\t          Record: { Data: Buffer.from(JSON.stringify(full) + \"\\n\") },\n    66\t        }),\n    67\t      );\n    68\t    } catch (err) {\n    69\t      // Callers treat this as a hard failure: an action that cannot be audited does not run.\n    70\t      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);\n    71\t    }\n    72\t  },\n    73\t};\n    74\t\n    75\t// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.\n    76\tconst DROP_KEYS = new Set([\"ssn\", \"dateOfBirth\", \"dob\", \"memberId\", \"subscriberId\", \"cardNumber\", \"cardLast4\", \"address\"]);\n    77\tconst PATTERNS: Array<[RegExp, string]> = [\n    78\t  [/\\b\\d{3}-\\d{2}-\\d{4}\\b/g, \"[ssn]\"],\n    79\t  [/\\b(?:\\d[ -]?){13,19}\\b/g, \"[card]\"],\n    80\t  [/\\b[A-Z]{3}\\d{9}\\b/g, \"[member-id]\"],\n    81\t];\n    82\t\n    83\texport function redactPhi(value: unknown): unknown {\n    84\t  if (typeof value === \"string\") {\n    85\t    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);\n    86\t  }\n    87\t  if (Array.isArray(value)) return value.map(redactPhi);\n    88\t  if (value && typeof value === \"object\") {\n    89\t    const out: Record<string, unknown> = {};\n    90\t    for (const [k, v] of Object.entries(value)) {\n    91\t      if (DROP_KEYS.has(k)) continue;\n    92\t      out[k] = redactPhi(v);\n    93\t    }\n    94\t    return out;\n    95\t  }\n    96\t  return value;\n    97\t}\n     1\timport { createHash, randomUUID } from \"node:crypto\";\n     2\timport { readdirSync, readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n     5\t\n     6\t// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n     7\t// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\n     8\tconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n     9\t\n    10\texport interface TypeIdInputs {\n    11\t  imageDigest: string;\n    12\t  harnessVersion: string;\n    13\t  harnessGitSha: string;\n    14\t}\n    15\t\n    16\texport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n    17\t  const parts: Array<[string, Buffer]> = [\n    18\t    [\"image\", Buffer.from(inputs.imageDigest)],\n    19\t    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    20\t    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n    21\t  ];\n    22\t  const promptDir = join(ROOT, \"prompts\");\n    23\t  const promptFiles = readdirSync(promptDir)\n    24\t    .filter((f) => f.endsWith(\".txt\"))\n    25\t    .sort();\n    26\t  for (const f of promptFiles) {\n    27\t    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n    28\t  }\n    29\t  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n    30\t  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n    31\t  for (const f of CONFIG_FILES) {\n    32\t    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n    33\t  }\n    34\t  return parts;\n    35\t}\n    36\t\n    37\texport function computeAgentTypeId(inputs: TypeIdInputs): string {\n    38\t  const h = createHash(\"sha256\");\n    39\t  for (const [label, bytes] of typeIdManifest(inputs)) {\n    40\t    h.update(label);\n    41\t    h.update(\"\\0\");\n    42\t    h.update(bytes);\n    43\t    h.update(\"\\0\");\n    44\t  }\n    45\t  return `sha256:${h.digest(\"hex\")}`;\n    46\t}\n    47\t\n    48\t// One instance id per process. Pods are the unit an operator contains.\n    49\texport const AGENT_INSTANCE_ID = randomUUID();\n    50\t\n    51\tlet AGENT_TYPE_ID = \"\";\n    52\texport function setAgentTypeId(id: string): void {\n    53\t  AGENT_TYPE_ID = id;\n    54\t}\n    55\t\n    56\texport interface Subject {\n    57\t  kind: \"patient\" | \"staff\" | \"system\";\n    58\t  id: string;\n    59\t}\n    60\t\n    61\texport interface Logger {\n    62\t  info(obj: object, msg?: string): void;\n    63\t  warn(obj: object, msg?: string): void;\n    64\t  error(obj: object, msg?: string): void;\n    65\t}\n    66\t\n    67\texport interface RunContext {\n    68\t  runId: string;\n    69\t  tenantId: string;\n    70\t  subject: Subject;\n    71\t  channel: \"sms\" | \"webchat\" | \"reminder\";\n    72\t  traceparent: string;\n    73\t  log: Logger;\n    74\t  identity(): {\n    75\t    accountableParty: string;\n    76\t    operationalOwner: string;\n    77\t    tenantId: string;\n    78\t    agentTypeId: string;\n    79\t    agentInstanceId: string;\n    80\t    traceparent: string;\n    81\t  };\n    82\t  workloadToken(): Promise<string>;\n    83\t}\n    84\t\n    85\t// Projected service-account token (audience: the group STS), rotated by the kubelet.\n    86\tconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n    87\t\n    88\texport function newRunContext(init: {\n    89\t  tenantId: string;\n    90\t  subject: Subject;\n    91\t  channel: RunContext[\"channel\"];\n    92\t  traceparent?: string;\n    93\t  log: Logger;\n    94\t}): RunContext {\n    95\t  const runId = randomUUID();\n    96\t  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n    97\t  return {\n    98\t    runId,\n    99\t    tenantId: init.tenantId,\n   100\t    subject: init.subject,\n   101\t    channel: init.channel,\n   102\t    traceparent,\n   103\t    log: init.log,\n   104\t    identity: () => ({\n   105\t      accountableParty: env.accountableParty,\n   106\t      operationalOwner: env.operationalOwner,\n   107\t      tenantId: init.tenantId,\n   108\t      agentTypeId: AGENT_TYPE_ID,\n   109\t      agentInstanceId: AGENT_INSTANCE_ID,\n   110\t      traceparent,\n   111\t    }),\n   112\t    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n   113\t  };\n   114\t}\n     1\t# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:\n     2\t# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.\n     3\tresource \"aws_iam_role\" \"runtime\" {\n     4\t  name                 = \"clinic-agent-runtime\"\n     5\t  max_session_duration = 3600\n     6\t  assume_role_policy = jsonencode({\n     7\t    Version = \"2012-10-17\"\n     8\t    Statement = [{\n     9\t      Effect    = \"Allow\"\n    10\t      Principal = { Federated = module.eks.oidc_provider_arn }\n    11\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n    12\t      Condition = {\n    13\t        StringEquals = {\n    14\t          \"${module.eks.oidc_provider}:sub\" = [\n    15\t            \"system:serviceaccount:clinic-agent:clinic-agent\",\n    16\t            \"system:serviceaccount:clinic-agent:clinic-agent-reminders\",\n    17\t          ]\n    18\t          \"${module.eks.oidc_provider}:aud\" = \"sts.amazonaws.com\"\n    19\t        }\n    20\t      }\n    21\t    }]\n    22\t  })\n    23\t}\n    24\t\n    25\tresource \"aws_iam_role_policy\" \"runtime\" {\n    26\t  name = \"clinic-agent-runtime\"\n    27\t  role = aws_iam_role.runtime.id\n    28\t  policy = jsonencode({\n    29\t    Version = \"2012-10-17\"\n    30\t    Statement = [\n    31\t      {\n    32\t        Sid      = \"ReadClinicSecrets\"\n    33\t        Effect   = \"Allow\"\n    34\t        Action   = [\"secretsmanager:GetSecretValue\"]\n    35\t        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\n    36\t      },\n    37\t      {\n    38\t        Sid    = \"AgentState\"\n    39\t        Effect = \"Allow\"\n    40\t        Action = [\n    41\t          \"dynamodb:GetItem\",\n    42\t          \"dynamodb:BatchGetItem\",\n    43\t          \"dynamodb:PutItem\",\n    44\t          \"dynamodb:UpdateItem\",\n    45\t          \"dynamodb:Query\",\n    46\t        ]\n    47\t        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*\"\n    48\t      },\n    49\t      {\n    50\t        Sid      = \"Audit\"\n    51\t        Effect   = \"Allow\"\n    52\t        Action   = [\"firehose:PutRecord\", \"firehose:PutRecordBatch\"]\n    53\t        Resource = aws_kinesis_firehose_delivery_stream.audit.arn\n    54\t      },\n    55\t    ]\n    56\t  })\n    57\t}\n    58\t\n    59\t# Operators who may stop the agent. Assumable only through SSO by the on-call group.\n    60\tresource \"aws_iam_role\" \"ops_killswitch\" {\n    61\t  name = \"clinic-agent-ops\"\n    62\t  assume_role_policy = jsonencode({\n    63\t    Version = \"2012-10-17\"\n    64\t    Statement = [{\n    65\t      Effect    = \"Allow\"\n    66\t      Principal = { AWS = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\" }\n    67\t      Action    = \"sts:AssumeRole\"\n    68\t      Condition = {\n    69\t        StringLike = { \"aws:PrincipalArn\" = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*\" }\n    70\t      }\n    71\t    }]\n    72\t  })\n    73\t}\n    74\t\n    75\tresource \"aws_iam_role_policy\" \"ops_killswitch\" {\n    76\t  name = \"clinic-agent-ops\"\n    77\t  role = aws_iam_role.ops_killswitch.id\n    78\t  policy = jsonencode({\n    79\t    Version = \"2012-10-17\"\n    80\t    Statement = [{\n    81\t      Effect   = \"Allow\"\n    82\t      Action   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:GetItem\"]\n    83\t      Resource = aws_dynamodb_table.control.arn\n    84\t    }]\n    85\t  })\n    86\t}\n    87\t\n    88\tresource \"aws_iam_role\" \"firehose\" {\n    89\t  name = \"clinic-agent-audit-firehose\"\n    90\t  assume_role_policy = jsonencode({\n    91\t    Version   = \"2012-10-17\"\n    92\t    Statement = [{ Effect = \"Allow\", Principal = { Service = \"firehose.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n    93\t  })\n    94\t}\n    95\t\n    96\tresource \"aws_iam_role_policy\" \"firehose\" {\n    97\t  name = \"write-audit-bucket\"\n    98\t  role = aws_iam_role.firehose.id\n    99\t  policy = jsonencode({\n   100\t    Version = \"2012-10-17\"\n   101\t    Statement = [{\n   102\t      Effect   = \"Allow\"\n   103\t      Action   = [\"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:GetBucketLocation\"]\n   104\t      Resource = [aws_s3_bucket.audit.arn, \"${aws_s3_bucket.audit.arn}/*\"]\n   105\t    }]\n   106\t  })\n   107\t}\n     1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n     2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n     3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     4\timport { Agent } from \"undici\";\n     5\timport type { PeerCertificate } from \"node:tls\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n     8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n     9\t\n    10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n    11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n    12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n    13\t\n    14\tconst sm = new SecretsManagerClient({ region: env.region });\n    15\t\n    16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n    17\t  const expected = server.tlsCertSha256.toLowerCase();\n    18\t  return new Agent({\n    19\t    connect: {\n    20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n    21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n    22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n    23\t      },\n    24\t    },\n    25\t  });\n    26\t}\n    27\t\n    28\ttype Token = { value: string; exp: number };\n    29\tconst tokens = new Map<string, Token>();\n    30\t\n    31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n    32\t  const cacheKey = `${clinicId}|${scope}`;\n    33\t  const hit = tokens.get(cacheKey);\n    34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n    35\t\n    36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n    37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n    38\t  const res = await fetch(token_url, {\n    39\t    method: \"POST\",\n    40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n    42\t  });\n    43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n    44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n    45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n    46\t  return body.access_token;\n    47\t}\n    48\t\n    49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n    50\tconst sessions = new Map<string, Client>();\n    51\t\n    52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n    53\t  const existing = sessions.get(clinicId);\n    54\t  if (existing) return existing;\n    55\t  const token = await ehrToken(clinicId, SCOPES);\n    56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    57\t    requestInit: {\n    58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n    59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n    60\t      dispatcher: pinnedDispatcher(server),\n    61\t    },\n    62\t  });\n    63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n    64\t  await client.connect(transport);\n    65\t  sessions.set(clinicId, client);\n    66\t  setTimeout(() => {\n    67\t    sessions.delete(clinicId);\n    68\t    void client.close();\n    69\t  }, 4 * 60_000).unref();\n    70\t  return client;\n    71\t}\n    72\t\n    73\texport function ehr(server: ConfiguredServer) {\n    74\t  return {\n    75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n    76\t      const c = await session(server, \"_catalog\");\n    77\t      const [tools, prompts, templates] = await Promise.all([\n    78\t        c.listTools(),\n    79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n    80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n    81\t      ]);\n    82\t      return {\n    83\t        reportedName: c.getServerVersion()?.name,\n    84\t        meta: {\n    85\t          instructions: c.getInstructions(),\n    86\t          tools: tools.tools as ServerMeta[\"tools\"],\n    87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n    88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n    89\t        },\n    90\t      };\n    91\t    },\n    92\t\n    93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n    94\t      const c = await session(server, opts.clinicId);\n    95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n    96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n    97\t      return res.structuredContent ?? res.content;\n    98\t    },\n    99\t\n   100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n   101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n   102\t        id: string;\n   103\t        patientId: string;\n   104\t        start: string;\n   105\t        serviceCode: string;\n   106\t        payerId?: string;\n   107\t        depositId?: string;\n   108\t        status: string;\n   109\t      };\n   110\t    },\n   111\t\n   112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n   113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n   114\t        id: string;\n   115\t        patientId: string;\n   116\t        start: string;\n   117\t        phone: string;\n   118\t        smsOptIn: boolean;\n   119\t        locationName: string;\n   120\t      }>;\n   121\t    },\n   122\t  };\n   123\t}\n   124\texport type Ehr = ReturnType<typeof ehr>;\n     1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n     7\t//\n     8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n     9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n    10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n    11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n    12\t//\n    13\t// Answers come back as a signed attestation (JWS) inside a data part.\n    14\t\n    15\tconst Eligibility = z\n    16\t  .object({\n    17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    18\t    planName: z.string().max(120).optional(),\n    19\t    copayCents: z.number().int().nonnegative().optional(),\n    20\t    depositWaived: z.boolean().default(false),\n    21\t    checkedAt: z.string().datetime(),\n    22\t  })\n    23\t  .strict();\n    24\texport type Eligibility = z.infer<typeof Eligibility>;\n    25\t\n    26\tconst Rpc = z.object({\n    27\t  jsonrpc: z.literal(\"2.0\"),\n    28\t  id: z.string(),\n    29\t  result: z.object({\n    30\t    kind: z.literal(\"message\"),\n    31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n    32\t  }),\n    33\t});\n    34\t\n    35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n    36\t  const res = await fetch(env.tokenExchangeUrl, {\n    37\t    method: \"POST\",\n    38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    39\t    body: new URLSearchParams({\n    40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    41\t      subject_token: workloadToken,\n    42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n    43\t      audience: \"eligibility-agent\",\n    44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n    45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    46\t    }),\n    47\t  });\n    48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n    49\t  return ((await res.json()) as { access_token: string }).access_token;\n    50\t}\n    51\t\n    52\texport async function checkEligibility(\n    53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n    54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n    55\t): Promise<Eligibility> {\n    56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n    57\t  const requestId = randomUUID();\n    58\t  const res = await fetch(env.eligibilityUrl, {\n    59\t    method: \"POST\",\n    60\t    signal: opts.signal,\n    61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    62\t    body: JSON.stringify({\n    63\t      jsonrpc: \"2.0\",\n    64\t      id: requestId,\n    65\t      method: \"message/send\",\n    66\t      params: {\n    67\t        message: {\n    68\t          role: \"user\",\n    69\t          messageId: requestId,\n    70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n    71\t        },\n    72\t      },\n    73\t    }),\n    74\t  });\n    75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n    76\t  const text = await res.text();\n    77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n    78\t  const rpc = Rpc.parse(JSON.parse(text));\n    79\t\n    80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n    81\t  const header = decodeProtectedHeader(attestation);\n    82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n    83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n    84\t  const { payload } = await jwtVerify(attestation, keys, {\n    85\t    issuer: env.eligibilityIssuer,\n    86\t    audience: \"clinic-agent\",\n    87\t    maxTokenAge: \"5m\",\n    88\t    algorithms: [\"ES256\"],\n    89\t  });\n    90\t  return Eligibility.parse(payload.eligibility);\n    91\t}\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n     5\t// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n     6\t// The provider enforces Idempotency-Key for 24 hours.\n     7\t\n     8\tconst sm = new SecretsManagerClient({ region: env.region });\n     9\tconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n    10\t\n    11\tasync function key(clinicId: string): Promise<string> {\n    12\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n    13\t  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n    14\t}\n    15\t\n    16\texport interface Refund {\n    17\t  id: string;\n    18\t  depositId: string;\n    19\t  amountCents: number;\n    20\t  status: \"pending\" | \"succeeded\" | \"failed\";\n    21\t}\n    22\t\n    23\texport const payments = {\n    24\t  async refundDeposit(\n    25\t    clinicId: string,\n    26\t    req: { depositId: string; reason: string; idempotencyKey: string },\n    27\t    signal?: AbortSignal,\n    28\t  ): Promise<Refund> {\n    29\t    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n    30\t      method: \"POST\",\n    31\t      signal,\n    32\t      headers: {\n    33\t        authorization: `Bearer ${await key(clinicId)}`,\n    34\t        \"content-type\": \"application/json\",\n    35\t        \"idempotency-key\": req.idempotencyKey,\n    36\t      },\n    37\t      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    38\t    });\n    39\t    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    40\t    return (await res.json()) as Refund;\n    41\t  },\n    42\t};\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n     5\t// can send; free-form text goes through sms__send_freeform, which needs approval.\n     6\t\n     7\tconst sm = new SecretsManagerClient({ region: env.region });\n     8\tconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n     9\t\n    10\texport const TEMPLATES = {\n    11\t  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n    12\t  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n    13\t  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n    14\t  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n    15\t} as const;\n    16\texport type TemplateId = keyof typeof TEMPLATES;\n    17\t\n    18\texport function render(id: TemplateId, vars: Record<string, string>): string {\n    19\t  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n    20\t}\n    21\t\n    22\tasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n    23\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n    24\t  const v = JSON.parse(s.SecretString ?? \"{}\");\n    25\t  return { token: v.api_token, from: v.from_number };\n    26\t}\n    27\t\n    28\texport const sms = {\n    29\t  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n    30\t    const c = await creds(clinicId);\n    31\t    const res = await fetch(`${BASE}/messages`, {\n    32\t      method: \"POST\",\n    33\t      signal,\n    34\t      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n    35\t      body: JSON.stringify({ from: c.from, to, body }),\n    36\t    });\n    37\t    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n    38\t    return (await res.json()) as { messageId: string };\n    39\t  },\n    40\t};","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01QWqMxCwm9okSUBhG4t5nSk","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
