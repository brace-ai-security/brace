{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDWhb4khziq3Qyw1gCVD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019d4UtVupN5TViPDCGdgrQg","name":"Bash","input":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-7phmkyo6/agent; cat src/tools/metadata-scan.ts src/tools/registry.ts src/integrations/ehr-mcp.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1298,"cache_read_input_tokens":21560,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1298},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1e76c266-d617-4acf-a7f9-3d444c9798c3","uuid":"7f53d241-ffd9-4372-a4e2-e713710bcbcc","timestamp":"2026-10-20T12:46:35.013Z","request_id":"req_011CgDWhaZjtanGc57CZ4yyv","wire_tool_inputs":{"toolu_019d4UtVupN5TViPDCGdgrQg":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-7phmkyo6/agent; cat src/tools/metadata-scan.ts src/tools/registry.ts src/integrations/ehr-mcp.ts"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019d4UtVupN5TViPDCGdgrQg","type":"tool_result","content":"// Scans MCP server metadata before any of it reaches the model.\n//\n// Covered fields: server instructions, tool name, title, description, every string inside the\n// input and output schemas (titles, descriptions, enum values, defaults, examples), annotations,\n// prompt names/descriptions/argument descriptions, and resource template names/descriptions/URIs.\n//\n// A finding on a tool rejects that tool. A finding on the server instructions or a prompt or\n// resource template rejects the whole server. If the scanner itself throws, the caller treats the\n// server as unavailable; nothing unscanned is passed on.\n\nexport interface ToolMeta {\n  name: string;\n  title?: string;\n  description?: string;\n  inputSchema?: unknown;\n  outputSchema?: unknown;\n  annotations?: Record<string, unknown>;\n}\n\nexport interface ServerMeta {\n  instructions?: string;\n  tools: ToolMeta[];\n  prompts?: Array<{ name: string; description?: string; arguments?: Array<{ name: string; description?: string }> }>;\n  resourceTemplates?: Array<{ name: string; uriTemplate: string; description?: string }>;\n}\n\nexport interface Finding {\n  where: string;\n  rule: string;\n  sample: string;\n}\n\nexport const LIMITS = {\n  name: 64,\n  title: 120,\n  description: 1024,\n  schemaString: 512,\n  instructions: 2048,\n} as const;\n\nconst RULES: Array<{ rule: string; re: RegExp }> = [\n  // Invisible, bidi, and control characters (tab and newline allowed).\n  { rule: \"control_or_invisible_char\", re: /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F­​-‏‪-‮⁠-⁤⁦-⁩﻿\\u{E0000}-\\u{E007F}]/u },\n  // Role and instruction overrides.\n  { rule: \"role_override\", re: /\\b(ignore|disregard|override|forget)\\b.{0,40}\\b(previous|prior|above|system|instructions?|rules?)\\b/i },\n  { rule: \"role_override\", re: /\\b(you are now|act as|new instructions|system prompt|developer message)\\b/i },\n  { rule: \"role_marker\", re: /<\\/?(system|assistant|user|instructions?)>|\\[\\/?INST\\]|^\\s*(system|assistant)\\s*:/im },\n  // Directing the model to hide things or to act before or instead of the user.\n  { rule: \"concealment\", re: /\\b(do not|don't|never)\\b.{0,30}\\b(tell|mention|reveal|show|inform)\\b.{0,30}\\b(user|patient|staff)\\b/i },\n  { rule: \"precondition_injection\", re: /\\b(before|after|instead of)\\b.{0,30}\\b(calling|using|running)\\b.{0,40}\\b(always|must|first)\\b/i },\n  // Encoded payloads.\n  { rule: \"base64_blob\", re: /\\b[A-Za-z0-9+/]{48,}={0,2}(?![A-Za-z0-9+/])/ },\n  { rule: \"hex_blob\", re: /\\b(?:[0-9a-f]{2}){32,}\\b/i },\n  { rule: \"escaped_unicode\", re: /(\\\\u[0-9a-f]{4}){4,}|(&#x?[0-9a-f]+;){4,}/i },\n  // Places data could be sent.\n  { rule: \"url\", re: /\\b(?:https?|ftp|wss?|file|data):\\/?\\/?[^\\s\"'<>]+/i },\n  { rule: \"email\", re: /\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/i },\n  { rule: \"phone_number\", re: /\\+?\\d[\\d ().-]{9,}\\d/ },\n];\n\nfunction scanString(where: string, s: string, max: number, otherServerTools: Set<string>, out: Finding[]): void {\n  if (s.length > max) out.push({ where, rule: \"too_long\", sample: `${s.length} > ${max}` });\n  for (const { rule, re } of RULES) {\n    const m = re.exec(s);\n    if (m) out.push({ where, rule, sample: m[0].slice(0, 40) });\n  }\n  const lower = s.toLowerCase();\n  for (const t of otherServerTools) {\n    if (lower.includes(t.toLowerCase())) out.push({ where, rule: \"references_other_server_tool\", sample: t });\n  }\n}\n\nfunction walkSchema(where: string, node: unknown, otherServerTools: Set<string>, out: Finding[], depth = 0): void {\n  if (depth > 12) {\n    out.push({ where, rule: \"schema_too_deep\", sample: String(depth) });\n    return;\n  }\n  if (typeof node === \"string\") {\n    scanString(where, node, LIMITS.schemaString, otherServerTools, out);\n  } else if (Array.isArray(node)) {\n    node.forEach((v, i) => walkSchema(`${where}[${i}]`, v, otherServerTools, out, depth + 1));\n  } else if (node && typeof node === \"object\") {\n    for (const [k, v] of Object.entries(node)) {\n      scanString(`${where}.<key>`, k, LIMITS.name, otherServerTools, out);\n      walkSchema(`${where}.${k}`, v, otherServerTools, out, depth + 1);\n    }\n  }\n}\n\nexport interface ScanResult {\n  serverRejected: boolean;\n  serverFindings: Finding[];\n  rejectedTools: Map<string, Finding[]>;\n  acceptedTools: ToolMeta[];\n}\n\n/** otherServerTools: bare tool names exposed by every other configured server and native tool set. */\nexport function scanServer(meta: ServerMeta, otherServerTools: Set<string>): ScanResult {\n  const serverFindings: Finding[] = [];\n  if (meta.instructions !== undefined) {\n    scanString(\"instructions\", meta.instructions, LIMITS.instructions, otherServerTools, serverFindings);\n  }\n  for (const p of meta.prompts ?? []) {\n    scanString(`prompt:${p.name}.name`, p.name, LIMITS.name, otherServerTools, serverFindings);\n    if (p.description) scanString(`prompt:${p.name}.description`, p.description, LIMITS.description, otherServerTools, serverFindings);\n    for (const a of p.arguments ?? []) {\n      if (a.description) scanString(`prompt:${p.name}.arg:${a.name}`, a.description, LIMITS.schemaString, otherServerTools, serverFindings);\n    }\n  }\n  for (const r of meta.resourceTemplates ?? []) {\n    scanString(`resource:${r.name}.name`, r.name, LIMITS.name, otherServerTools, serverFindings);\n    if (r.description) scanString(`resource:${r.name}.description`, r.description, LIMITS.description, otherServerTools, serverFindings);\n    // Server-scoped schemes (ehr://...) pass; web, file, and data URLs are findings like anywhere else.\n    scanString(`resource:${r.name}.uriTemplate`, r.uriTemplate, LIMITS.schemaString, otherServerTools, serverFindings);\n  }\n\n  const rejectedTools = new Map<string, Finding[]>();\n  const acceptedTools: ToolMeta[] = [];\n  for (const t of meta.tools) {\n    const f: Finding[] = [];\n    if (!/^[a-z][a-z0-9_]{0,63}$/.test(t.name)) f.push({ where: \"name\", rule: \"bad_tool_name\", sample: t.name.slice(0, 40) });\n    if (t.title) scanString(\"title\", t.title, LIMITS.title, otherServerTools, f);\n    if (t.description) scanString(\"description\", t.description, LIMITS.description, otherServerTools, f);\n    walkSchema(\"inputSchema\", t.inputSchema ?? {}, otherServerTools, f);\n    walkSchema(\"outputSchema\", t.outputSchema ?? {}, otherServerTools, f);\n    walkSchema(\"annotations\", t.annotations ?? {}, otherServerTools, f);\n    if (f.length) rejectedTools.set(t.name, f);\n    else acceptedTools.push(t);\n  }\n  return { serverRejected: serverFindings.length > 0, serverFindings, rejectedTools, acceptedTools };\n}\nimport type Anthropic from \"@anthropic-ai/sdk\";\nimport type { ContextSize } from \"../agent/context-size.js\";\nimport { scanServer, type ServerMeta, type ToolMeta } from \"./metadata-scan.js\";\n\n// Tool identity is \"<serverId>__<toolName>\", where serverId is the id this deployment assigned in\n// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about\n// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.\n// Only servers listed in the manifest can contribute tools.\n\nexport interface ConfiguredServer {\n  id: string;\n  url: string;\n  tlsCertSha256: string;\n}\n\nexport interface InvokeOptions {\n  clinicId: string;\n  signal: AbortSignal;\n  runCtx: unknown;\n  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */\n  context: ContextSize;\n}\n\nexport interface RegisteredTool {\n  key: string;\n  serverId: string;\n  name: string;\n  definition: Anthropic.Tool;\n  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;\n}\n\nexport interface Conflict {\n  key: string;\n  conflictsWith: string;\n  kind: \"duplicate\" | \"lookalike\";\n}\n\nconst CONFUSABLES: Record<string, string> = { \"0\": \"o\", \"1\": \"l\", \"3\": \"e\", \"5\": \"s\", \"7\": \"t\", \"@\": \"a\", \"$\": \"s\" };\n\nexport function canonical(name: string): string {\n  return name\n    .normalize(\"NFKC\")\n    .toLowerCase()\n    .replace(/rn/g, \"m\")\n    .replace(/vv/g, \"w\")\n    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)\n    .replace(/[^a-z]/g, \"\");\n}\n\nfunction editDistanceAtMostOne(a: string, b: string): boolean {\n  if (a === b) return true;\n  if (Math.abs(a.length - b.length) > 1) return false;\n  let i = 0;\n  let j = 0;\n  let edits = 0;\n  while (i < a.length && j < b.length) {\n    if (a[i] === b[j]) {\n      i++;\n      j++;\n      continue;\n    }\n    if (++edits > 1) return false;\n    if (a.length > b.length) i++;\n    else if (b.length > a.length) j++;\n    else {\n      i++;\n      j++;\n    }\n  }\n  return edits + (a.length - i) + (b.length - j) <= 1;\n}\n\nexport class ToolRegistry {\n  private tools = new Map<string, RegisteredTool>();\n  readonly conflicts: Conflict[] = [];\n  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];\n\n  constructor(private servers: ConfiguredServer[]) {}\n\n  get(key: string): RegisteredTool | undefined {\n    return this.tools.get(key);\n  }\n\n  definitions(): Anthropic.Tool[] {\n    return [...this.tools.values()].map((t) => t.definition);\n  }\n\n  bareNamesExcept(serverId: string): Set<string> {\n    return new Set([...this.tools.values()].filter((t) => t.serverId !== serverId).map((t) => t.name));\n  }\n\n  /** Native tools are registered first so MCP metadata that names them is caught by the scanner. */\n  registerNative(serverId: string, tools: Array<Omit<RegisteredTool, \"key\" | \"serverId\">>): void {\n    for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\n  }\n\n  /**\n   * serverId must be one of the configured servers, and the caller must have connected using that\n   * server's pinned URL and certificate. reportedName is informational only.\n   */\n  registerMcp(\n    serverId: string,\n    reportedName: string | undefined,\n    meta: ServerMeta,\n    invoke: (tool: string, input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>,\n  ): void {\n    const cfg = this.servers.find((s) => s.id === serverId);\n    if (!cfg) {\n      this.rejected.push({ serverId, reason: `server not in release manifest (reported name ${reportedName ?? \"none\"})` });\n      return;\n    }\n    let scan;\n    try {\n      scan = scanServer(meta, this.bareNamesExcept(serverId));\n    } catch (err) {\n      this.rejected.push({ serverId, reason: `metadata scan error: ${(err as Error).message}` });\n      return;\n    }\n    if (scan.serverRejected) {\n      this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });\n      return;\n    }\n    for (const [tool, findings] of scan.rejectedTools) {\n      this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });\n    }\n    for (const t of scan.acceptedTools) {\n      this.add({\n        key: `${serverId}__${t.name}`,\n        serverId,\n        name: t.name,\n        definition: toDefinition(`${serverId}__${t.name}`, t),\n        invoke: (input, opts) => invoke(t.name, input, opts),\n      });\n    }\n  }\n\n  private add(t: RegisteredTool): void {\n    if (this.tools.has(t.key)) {\n      this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: \"duplicate\" });\n      this.rejected.push({ serverId: t.serverId, tool: t.name, reason: \"duplicate tool key\" });\n      return;\n    }\n    const c = canonical(t.name);\n    for (const existing of this.tools.values()) {\n      if (existing.serverId === t.serverId) continue;\n      if (existing.name === t.name) {\n        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"duplicate\" });\n        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });\n        return;\n      }\n      if (editDistanceAtMostOne(canonical(existing.name), c)) {\n        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"lookalike\" });\n        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `looks like ${existing.key}` });\n        return;\n      }\n    }\n    this.tools.set(t.key, t);\n  }\n}\n\nfunction toDefinition(key: string, t: ToolMeta): Anthropic.Tool {\n  return {\n    name: key,\n    description: t.description ?? \"\",\n    input_schema: (t.inputSchema as Anthropic.Tool.InputSchema) ?? { type: \"object\", properties: {} },\n  };\n}\nimport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\nimport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\nimport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\nimport { Agent } from \"undici\";\nimport type { PeerCertificate } from \"node:tls\";\nimport { env } from \"../config.js\";\nimport type { ConfiguredServer } from \"../tools/registry.js\";\nimport type { ServerMeta } from \"../tools/metadata-scan.js\";\n\n// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n\nconst sm = new SecretsManagerClient({ region: env.region });\n\nfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n  const expected = server.tlsCertSha256.toLowerCase();\n  return new Agent({\n    connect: {\n      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n      },\n    },\n  });\n}\n\ntype Token = { value: string; exp: number };\nconst tokens = new Map<string, Token>();\n\nasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n  const cacheKey = `${clinicId}|${scope}`;\n  const hit = tokens.get(cacheKey);\n  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n\n  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n  const res = await fetch(token_url, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n  });\n  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n  const body = (await res.json()) as { access_token: string; expires_in: number };\n  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n  return body.access_token;\n}\n\nconst SCOPES = \"patient.read appointment.read appointment.write\";\nconst sessions = new Map<string, Client>();\n\nasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n  const existing = sessions.get(clinicId);\n  if (existing) return existing;\n  const token = await ehrToken(clinicId, SCOPES);\n  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    requestInit: {\n      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n      dispatcher: pinnedDispatcher(server),\n    },\n  });\n  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n  await client.connect(transport);\n  sessions.set(clinicId, client);\n  setTimeout(() => {\n    sessions.delete(clinicId);\n    void client.close();\n  }, 4 * 60_000).unref();\n  return client;\n}\n\nexport function ehr(server: ConfiguredServer) {\n  return {\n    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n      const c = await session(server, \"_catalog\");\n      const [tools, prompts, templates] = await Promise.all([\n        c.listTools(),\n        c.listPrompts().catch(() => ({ prompts: [] })),\n        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n      ]);\n      return {\n        reportedName: c.getServerVersion()?.name,\n        meta: {\n          instructions: c.getInstructions(),\n          tools: tools.tools as ServerMeta[\"tools\"],\n          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n        },\n      };\n    },\n\n    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n      const c = await session(server, opts.clinicId);\n      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n      return res.structuredContent ?? res.content;\n    },\n\n    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n        id: string;\n        patientId: string;\n        start: string;\n        serviceCode: string;\n        payerId?: string;\n        depositId?: string;\n        status: string;\n      };\n    },\n\n    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n        id: string;\n        patientId: string;\n        start: string;\n        phone: string;\n        smsOptIn: boolean;\n        locationName: string;\n      }>;\n    },\n  };\n}\nexport type Ehr = ReturnType<typeof ehr>;","is_error":false}]},"parent_tool_use_id":null,"session_id":"1e76c266-d617-4acf-a7f9-3d444c9798c3","uuid":"827910e6-936b-49dc-aa65-5e2be52b2b78","timestamp":"2026-10-20T12:46:35.038Z","tool_use_result":{"stdout":"// Scans MCP server metadata before any of it reaches the model.\n//\n// Covered fields: server instructions, tool name, title, description, every string inside the\n// input and output schemas (titles, descriptions, enum values, defaults, examples), annotations,\n// prompt names/descriptions/argument descriptions, and resource template names/descriptions/URIs.\n//\n// A finding on a tool rejects that tool. A finding on the server instructions or a prompt or\n// resource template rejects the whole server. If the scanner itself throws, the caller treats the\n// server as unavailable; nothing unscanned is passed on.\n\nexport interface ToolMeta {\n  name: string;\n  title?: string;\n  description?: string;\n  inputSchema?: unknown;\n  outputSchema?: unknown;\n  annotations?: Record<string, unknown>;\n}\n\nexport interface ServerMeta {\n  instructions?: string;\n  tools: ToolMeta[];\n  prompts?: Array<{ name: string; description?: string; arguments?: Array<{ name: string; description?: string }> }>;\n  resourceTemplates?: Array<{ name: string; uriTemplate: string; description?: string }>;\n}\n\nexport interface Finding {\n  where: string;\n  rule: string;\n  sample: string;\n}\n\nexport const LIMITS = {\n  name: 64,\n  title: 120,\n  description: 1024,\n  schemaString: 512,\n  instructions: 2048,\n} as const;\n\nconst RULES: Array<{ rule: string; re: RegExp }> = [\n  // Invisible, bidi, and control characters (tab and newline allowed).\n  { rule: \"control_or_invisible_char\", re: /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F­​-‏‪-‮⁠-⁤⁦-⁩﻿\\u{E0000}-\\u{E007F}]/u },\n  // Role and instruction overrides.\n  { rule: \"role_override\", re: /\\b(ignore|disregard|override|forget)\\b.{0,40}\\b(previous|prior|above|system|instructions?|rules?)\\b/i },\n  { rule: \"role_override\", re: /\\b(you are now|act as|new instructions|system prompt|developer message)\\b/i },\n  { rule: \"role_marker\", re: /<\\/?(system|assistant|user|instructions?)>|\\[\\/?INST\\]|^\\s*(system|assistant)\\s*:/im },\n  // Directing the model to hide things or to act before or instead of the user.\n  { rule: \"concealment\", re: /\\b(do not|don't|never)\\b.{0,30}\\b(tell|mention|reveal|show|inform)\\b.{0,30}\\b(user|patient|staff)\\b/i },\n  { rule: \"precondition_injection\", re: /\\b(before|after|instead of)\\b.{0,30}\\b(calling|using|running)\\b.{0,40}\\b(always|must|first)\\b/i },\n  // Encoded payloads.\n  { rule: \"base64_blob\", re: /\\b[A-Za-z0-9+/]{48,}={0,2}(?![A-Za-z0-9+/])/ },\n  { rule: \"hex_blob\", re: /\\b(?:[0-9a-f]{2}){32,}\\b/i },\n  { rule: \"escaped_unicode\", re: /(\\\\u[0-9a-f]{4}){4,}|(&#x?[0-9a-f]+;){4,}/i },\n  // Places data could be sent.\n  { rule: \"url\", re: /\\b(?:https?|ftp|wss?|file|data):\\/?\\/?[^\\s\"'<>]+/i },\n  { rule: \"email\", re: /\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/i },\n  { rule: \"phone_number\", re: /\\+?\\d[\\d ().-]{9,}\\d/ },\n];\n\nfunction scanString(where: string, s: string, max: number, otherServerTools: Set<string>, out: Finding[]): void {\n  if (s.length > max) out.push({ where, rule: \"too_long\", sample: `${s.length} > ${max}` });\n  for (const { rule, re } of RULES) {\n    const m = re.exec(s);\n    if (m) out.push({ where, rule, sample: m[0].slice(0, 40) });\n  }\n  const lower = s.toLowerCase();\n  for (const t of otherServerTools) {\n    if (lower.includes(t.toLowerCase())) out.push({ where, rule: \"references_other_server_tool\", sample: t });\n  }\n}\n\nfunction walkSchema(where: string, node: unknown, otherServerTools: Set<string>, out: Finding[], depth = 0): void {\n  if (depth > 12) {\n    out.push({ where, rule: \"schema_too_deep\", sample: String(depth) });\n    return;\n  }\n  if (typeof node === \"string\") {\n    scanString(where, node, LIMITS.schemaString, otherServerTools, out);\n  } else if (Array.isArray(node)) {\n    node.forEach((v, i) => walkSchema(`${where}[${i}]`, v, otherServerTools, out, depth + 1));\n  } else if (node && typeof node === \"object\") {\n    for (const [k, v] of Object.entries(node)) {\n      scanString(`${where}.<key>`, k, LIMITS.name, otherServerTools, out);\n      walkSchema(`${where}.${k}`, v, otherServerTools, out, depth + 1);\n    }\n  }\n}\n\nexport interface ScanResult {\n  serverRejected: boolean;\n  serverFindings: Finding[];\n  rejectedTools: Map<string, Finding[]>;\n  acceptedTools: ToolMeta[];\n}\n\n/** otherServerTools: bare tool names exposed by every other configured server and native tool set. */\nexport function scanServer(meta: ServerMeta, otherServerTools: Set<string>): ScanResult {\n  const serverFindings: Finding[] = [];\n  if (meta.instructions !== undefined) {\n    scanString(\"instructions\", meta.instructions, LIMITS.instructions, otherServerTools, serverFindings);\n  }\n  for (const p of meta.prompts ?? []) {\n    scanString(`prompt:${p.name}.name`, p.name, LIMITS.name, otherServerTools, serverFindings);\n    if (p.description) scanString(`prompt:${p.name}.description`, p.description, LIMITS.description, otherServerTools, serverFindings);\n    for (const a of p.arguments ?? []) {\n      if (a.description) scanString(`prompt:${p.name}.arg:${a.name}`, a.description, LIMITS.schemaString, otherServerTools, serverFindings);\n    }\n  }\n  for (const r of meta.resourceTemplates ?? []) {\n    scanString(`resource:${r.name}.name`, r.name, LIMITS.name, otherServerTools, serverFindings);\n    if (r.description) scanString(`resource:${r.name}.description`, r.description, LIMITS.description, otherServerTools, serverFindings);\n    // Server-scoped schemes (ehr://...) pass; web, file, and data URLs are findings like anywhere else.\n    scanString(`resource:${r.name}.uriTemplate`, r.uriTemplate, LIMITS.schemaString, otherServerTools, serverFindings);\n  }\n\n  const rejectedTools = new Map<string, Finding[]>();\n  const acceptedTools: ToolMeta[] = [];\n  for (const t of meta.tools) {\n    const f: Finding[] = [];\n    if (!/^[a-z][a-z0-9_]{0,63}$/.test(t.name)) f.push({ where: \"name\", rule: \"bad_tool_name\", sample: t.name.slice(0, 40) });\n    if (t.title) scanString(\"title\", t.title, LIMITS.title, otherServerTools, f);\n    if (t.description) scanString(\"description\", t.description, LIMITS.description, otherServerTools, f);\n    walkSchema(\"inputSchema\", t.inputSchema ?? {}, otherServerTools, f);\n    walkSchema(\"outputSchema\", t.outputSchema ?? {}, otherServerTools, f);\n    walkSchema(\"annotations\", t.annotations ?? {}, otherServerTools, f);\n    if (f.length) rejectedTools.set(t.name, f);\n    else acceptedTools.push(t);\n  }\n  return { serverRejected: serverFindings.length > 0, serverFindings, rejectedTools, acceptedTools };\n}\nimport type Anthropic from \"@anthropic-ai/sdk\";\nimport type { ContextSize } from \"../agent/context-size.js\";\nimport { scanServer, type ServerMeta, type ToolMeta } from \"./metadata-scan.js\";\n\n// Tool identity is \"<serverId>__<toolName>\", where serverId is the id this deployment assigned in\n// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about\n// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.\n// Only servers listed in the manifest can contribute tools.\n\nexport interface ConfiguredServer {\n  id: string;\n  url: string;\n  tlsCertSha256: string;\n}\n\nexport interface InvokeOptions {\n  clinicId: string;\n  signal: AbortSignal;\n  runCtx: unknown;\n  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */\n  context: ContextSize;\n}\n\nexport interface RegisteredTool {\n  key: string;\n  serverId: string;\n  name: string;\n  definition: Anthropic.Tool;\n  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;\n}\n\nexport interface Conflict {\n  key: string;\n  conflictsWith: string;\n  kind: \"duplicate\" | \"lookalike\";\n}\n\nconst CONFUSABLES: Record<string, string> = { \"0\": \"o\", \"1\": \"l\", \"3\": \"e\", \"5\": \"s\", \"7\": \"t\", \"@\": \"a\", \"$\": \"s\" };\n\nexport function canonical(name: string): string {\n  return name\n    .normalize(\"NFKC\")\n    .toLowerCase()\n    .replace(/rn/g, \"m\")\n    .replace(/vv/g, \"w\")\n    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)\n    .replace(/[^a-z]/g, \"\");\n}\n\nfunction editDistanceAtMostOne(a: string, b: string): boolean {\n  if (a === b) return true;\n  if (Math.abs(a.length - b.length) > 1) return false;\n  let i = 0;\n  let j = 0;\n  let edits = 0;\n  while (i < a.length && j < b.length) {\n    if (a[i] === b[j]) {\n      i++;\n      j++;\n      continue;\n    }\n    if (++edits > 1) return false;\n    if (a.length > b.length) i++;\n    else if (b.length > a.length) j++;\n    else {\n      i++;\n      j++;\n    }\n  }\n  return edits + (a.length - i) + (b.length - j) <= 1;\n}\n\nexport class ToolRegistry {\n  private tools = new Map<string, RegisteredTool>();\n  readonly conflicts: Conflict[] = [];\n  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];\n\n  constructor(private servers: ConfiguredServer[]) {}\n\n  get(key: string): RegisteredTool | undefined {\n    return this.tools.get(key);\n  }\n\n  definitions(): Anthropic.Tool[] {\n    return [...this.tools.values()].map((t) => t.definition);\n  }\n\n  bareNamesExcept(serverId: string): Set<string> {\n    return new Set([...this.tools.values()].filter((t) => t.serverId !== serverId).map((t) => t.name));\n  }\n\n  /** Native tools are registered first so MCP metadata that names them is caught by the scanner. */\n  registerNative(serverId: string, tools: Array<Omit<RegisteredTool, \"key\" | \"serverId\">>): void {\n    for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\n  }\n\n  /**\n   * serverId must be one of the configured servers, and the caller must have connected using that\n   * server's pinned URL and certificate. reportedName is informational only.\n   */\n  registerMcp(\n    serverId: string,\n    reportedName: string | undefined,\n    meta: ServerMeta,\n    invoke: (tool: string, input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>,\n  ): void {\n    const cfg = this.servers.find((s) => s.id === serverId);\n    if (!cfg) {\n      this.rejected.push({ serverId, reason: `server not in release manifest (reported name ${reportedName ?? \"none\"})` });\n      return;\n    }\n    let scan;\n    try {\n      scan = scanServer(meta, this.bareNamesExcept(serverId));\n    } catch (err) {\n      this.rejected.push({ serverId, reason: `metadata scan error: ${(err as Error).message}` });\n      return;\n    }\n    if (scan.serverRejected) {\n      this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });\n      return;\n    }\n    for (const [tool, findings] of scan.rejectedTools) {\n      this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });\n    }\n    for (const t of scan.acceptedTools) {\n      this.add({\n        key: `${serverId}__${t.name}`,\n        serverId,\n        name: t.name,\n        definition: toDefinition(`${serverId}__${t.name}`, t),\n        invoke: (input, opts) => invoke(t.name, input, opts),\n      });\n    }\n  }\n\n  private add(t: RegisteredTool): void {\n    if (this.tools.has(t.key)) {\n      this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: \"duplicate\" });\n      this.rejected.push({ serverId: t.serverId, tool: t.name, reason: \"duplicate tool key\" });\n      return;\n    }\n    const c = canonical(t.name);\n    for (const existing of this.tools.values()) {\n      if (existing.serverId === t.serverId) continue;\n      if (existing.name === t.name) {\n        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"duplicate\" });\n        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });\n        return;\n      }\n      if (editDistanceAtMostOne(canonical(existing.name), c)) {\n        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"lookalike\" });\n        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `looks like ${existing.key}` });\n        return;\n      }\n    }\n    this.tools.set(t.key, t);\n  }\n}\n\nfunction toDefinition(key: string, t: ToolMeta): Anthropic.Tool {\n  return {\n    name: key,\n    description: t.description ?? \"\",\n    input_schema: (t.inputSchema as Anthropic.Tool.InputSchema) ?? { type: \"object\", properties: {} },\n  };\n}\nimport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\nimport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\nimport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\nimport { Agent } from \"undici\";\nimport type { PeerCertificate } from \"node:tls\";\nimport { env } from \"../config.js\";\nimport type { ConfiguredServer } from \"../tools/registry.js\";\nimport type { ServerMeta } from \"../tools/metadata-scan.js\";\n\n// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n\nconst sm = new SecretsManagerClient({ region: env.region });\n\nfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n  const expected = server.tlsCertSha256.toLowerCase();\n  return new Agent({\n    connect: {\n      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n      },\n    },\n  });\n}\n\ntype Token = { value: string; exp: number };\nconst tokens = new Map<string, Token>();\n\nasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n  const cacheKey = `${clinicId}|${scope}`;\n  const hit = tokens.get(cacheKey);\n  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n\n  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n  const res = await fetch(token_url, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n  });\n  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n  const body = (await res.json()) as { access_token: string; expires_in: number };\n  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n  return body.access_token;\n}\n\nconst SCOPES = \"patient.read appointment.read appointment.write\";\nconst sessions = new Map<string, Client>();\n\nasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n  const existing = sessions.get(clinicId);\n  if (existing) return existing;\n  const token = await ehrToken(clinicId, SCOPES);\n  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    requestInit: {\n      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n      dispatcher: pinnedDispatcher(server),\n    },\n  });\n  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n  await client.connect(transport);\n  sessions.set(clinicId, client);\n  setTimeout(() => {\n    sessions.delete(clinicId);\n    void client.close();\n  }, 4 * 60_000).unref();\n  return client;\n}\n\nexport function ehr(server: ConfiguredServer) {\n  return {\n    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n      const c = await session(server, \"_catalog\");\n      const [tools, prompts, templates] = await Promise.all([\n        c.listTools(),\n        c.listPrompts().catch(() => ({ prompts: [] })),\n        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n      ]);\n      return {\n        reportedName: c.getServerVersion()?.name,\n        meta: {\n          instructions: c.getInstructions(),\n          tools: tools.tools as ServerMeta[\"tools\"],\n          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n        },\n      };\n    },\n\n    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n      const c = await session(server, opts.clinicId);\n      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n      return res.structuredContent ?? res.content;\n    },\n\n    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n        id: string;\n        patientId: string;\n        start: string;\n        serviceCode: string;\n        payerId?: string;\n        depositId?: string;\n        status: string;\n      };\n    },\n\n    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n        id: string;\n        patientId: string;\n        start: string;\n        phone: string;\n        smsOptIn: boolean;\n        locationName: string;\n      }>;\n    },\n  };\n}\nexport type Ehr = ReturnType<typeof ehr>;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_019d4UtVupN5TViPDCGdgrQg","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
