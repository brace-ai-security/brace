\n  tenantId: string;\n  args: Record<string, unknown>;\n}): Promise<ApprovalCheck> {\n  let rec: ApprovalRecord | undefined;\n  try {\n    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    rec = res.Item as ApprovalRecord | undefined;\n  } catch (err) {\n    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n  }\n  if (!rec) return { ok: false, reason: \"approval not found\" };\n  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different","is_error":true,"tool_use_id":"toolu_01SDFMz6FoTqapd66DBaE33i"}]},"parent_tool_use_id":null,"session_id":"a681a98f-3aae-4114-80b6-e645e51f39d2","uuid":"11f1a9b3-3e83-43c7-9856-2b41eb3c5eee","timestamp":"2026-10-20T12:15:07.626Z","tool_use_result":"Error: Exit code 1\n{\n  \"repo\": \"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-3urlck35/agent\",\n  \"patterns_file\": \"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-3urlck35/skill/prescan/patterns.yaml\",\n  \"files_scanned\": 36,\n  \"note\": \"Hits are places to read, not findings. Answer each hit's ask before citing it.\",\n  \"capped\": [],\n  \"hits\": [\n    {\n      \"id\": \"H001\",\n      \"pattern\": \"P27\",\n      \"item\": \"B11\",\n      \"title\": \"securityContext to check for missing hardening\",\n      \"file\": \"k8s/deployment.yaml\",\n      \"line\": 67,\n      \"text\": \"securityContext:\",\n      \"ask\": \"Does this securityContext set allowPrivilegeEscalation: false, runAsNonRoot: true, readOnlyRootFilesystem: true, and drop ALL capabilities? A missing field defaults to the permissive value.\"\n    },\n    {\n      \"id\": \"H002\",\n      \"pattern\": \"P27\",\n  