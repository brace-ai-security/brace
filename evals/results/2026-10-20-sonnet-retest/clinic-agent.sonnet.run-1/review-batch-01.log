{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019e5QzMk2wRjtp5QAb28euJ","type":"tool_result","content":"    70\t  } catch (err) {\n    71\t    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n    72\t  }\n    73\t  if (!rec) return { ok: false, reason: \"approval not found\" };\n    74\t  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n    75\t  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n    76\t  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n    77\t  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n    78\t  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    79\t    return { ok: false, reason: \"approver lacks authority\" };\n    80\t  }\n    81\t  return { ok: true, approval: rec };\n    82\t}\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport type { ContextSize } from \"../agent/context-size.js\";\n     3\timport { scanServer, type ServerMeta, type ToolMeta } from \"./metadata-scan.js\";\n     4\t\n     5\t// Tool identity is \"<serverId>__<toolName>\", where serverId is the id this deployment assigned in\n     6\t// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about\n     7\t// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.\n     8\t// Only servers listed in the manifest can contribute tools.\n     9\t\n    10\texport interface ConfiguredServer {\n    11\t  id: string;\n    12\t  url: string;\n    13\t  tlsCertSha256: string;\n    14\t}\n    15\t\n    16\texport interface InvokeOptions {\n    17\t  clinicId: string;\n    18\t  signal: AbortSignal;\n    19\t  runCtx: unknown;\n    20\t  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */\n    21\t  context: ContextSize;\n    22\t}\n    23\t\n    24\texport interface RegisteredTool {\n    25\t  key: string;\n    26\t  serverId: string;\n    27\t  name: string;\n    28\t  definition: Anthropic.Tool;\n    29\t  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;\n    30\t}\n    31\t\n    32\texport interface Conflict {\n    33\t  key: string;\n    34\t  conflictsWith: string;\n    35\t  kind: \"duplicate\" | \"lookalike\";\n    36\t}\n    37\t\n    38\tconst CONFUSABLES: Record<string, string> = { \"0\": \"o\", \"1\": \"l\", \"3\": \"e\", \"5\": \"s\", \"7\": \"t\", \"@\": \"a\", \"$\": \"s\" };\n    39\t\n    40\texport function canonical(name: string): string {\n    41\t  return name\n    42\t    .normalize(\"NFKC\")\n    43\t    .toLowerCase()\n    44\t    .replace(/rn/g, \"m\")\n    45\t    .replace(/vv/g, \"w\")\n    46\t    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)\n    47\t    .replace(/[^a-z]/g, \"\");\n    48\t}\n    49\t\n    50\tfunction editDistanceAtMostOne(a: string, b: string): boolean {\n    51\t  if (a === b) return true;\n    52\t  if (Math.abs(a.length - b.length) > 1) return false;\n    53\t  let i = 0;\n    54\t  let j = 0;\n    55\t  let edits = 0;\n    56\t  while (i < a.length && j < b.length) {\n    57\t    if (a[i] === b[j]) {\n    58\t      i++;\n    59\t      j++;\n    60\t      continue;\n    61\t    }\n    62\t    if (++edits > 1) return false;\n    63\t    if (a.length > b.length) i++;\n    64\t    else if (b.length > a.length) j++;\n    65\t    else {\n    66\t      i++;\n    67\t      j++;\n    68\t    }\n    69\t  }\n    70\t  return edits + (a.length - i) + (b.length - j) <= 1;\n    71\t}\n    72\t\n    73\texport class ToolRegistry {\n    74\t  private tools = new Map<string, RegisteredTool>();\n    75\t  readonly conflicts: Conflict[] = [];\n    76\t  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];\n    77\t\n    78\t  constructor(private servers: ConfiguredServer[]) {}\n    79\t\n    80\t  get(key: string): RegisteredTool | undefined {\n    81\t    return this.tools.get(key);\n    82\t  }\n    83\t\n    84\t  definitions(): Anthropic.Tool[] {\n    85\t    return [...this.tools.values()].map((t) => t.definition);\n    86\t  }\n    87\t\n    88\t  bareNamesExcept(serverId: string): Set<string> {\n    89\t    return new Set([...this.tools.values()].filter((t) => t.serverId !== serverId).map((t) => t.name));\n    90\t  }\n    91\t\n    92\t  /** Native tools are registered first so MCP metadata that names them is caught by the scanner. */\n    93\t  registerNative(serverId: string, tools: Array<Omit<RegisteredTool, \"key\" | \"serverId\">>): void {\n    94\t    for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\n    95\t  }\n    96\t\n    97\t  /**\n    98\t   * serverId must be one of the configured servers, and the caller must have connected using that\n    99\t   * server's pinned URL and certificate. reportedName is informational only.\n   100\t   */\n   101\t  registerMcp(\n   102\t    serverId: string,\n   103\t    reportedName: string | undefined,\n   104\t    meta: ServerMeta,\n   105\t    invoke: (tool: string, input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>,\n   106\t  ): void {\n   107\t    const cfg = this.servers.find((s) => s.id === serverId);\n   108\t    if (!cfg) {\n   109\t      this.rejected.push({ serverId, reason: `server not in release manifest (reported name ${reportedName ?? \"none\"})` });\n   110\t      return;\n   111\t    }\n   112\t    let scan;\n   113\t    try {\n   114\t      scan = scanServer(meta, this.bareNamesExcept(serverId));\n   115\t    } catch (err) {\n   116\t      this.rejected.push({ serverId, reason: `metadata scan error: ${(err as Error).message}` });\n   117\t      return;\n   118\t    }\n   119\t    if (scan.serverRejected) {\n   120\t      this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });\n   121\t      return;\n   122\t    }\n   123\t    for (const [tool, findings] of scan.rejectedTools) {\n   124\t      this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });\n   125\t    }\n   126\t    for (const t of scan.acceptedTools) {\n   127\t      this.add({\n   128\t        key: `${serverId}__${t.name}`,\n   129\t        serverId,\n   130\t        name: t.name,\n     1\timport { createHash, randomUUID } from \"node:crypto\";\n     2\timport { readdirSync, readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n     5\t\n     6\t// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n     7\t// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\n     8\tconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n     9\t\n    10\texport interface TypeIdInputs {\n    11\t  imageDigest: string;\n    12\t  harnessVersion: string;\n    13\t  harnessGitSha: string;\n    14\t}\n    15\t\n    16\texport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n    17\t  const parts: Array<[string, Buffer]> = [\n    18\t    [\"image\", Buffer.from(inputs.imageDigest)],\n    19\t    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    20\t    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n    21\t  ];\n    22\t  const promptDir = join(ROOT, \"prompts\");\n    23\t  const promptFiles = readdirSync(promptDir)\n    24\t    .filter((f) => f.endsWith(\".txt\"))\n    25\t    .sort();\n    26\t  for (const f of promptFiles) {\n    27\t    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n    28\t  }\n    29\t  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n    30\t  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n    31\t  for (const f of CONFIG_FILES) {\n    32\t    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n    33\t  }\n    34\t  return parts;\n    35\t}\n    36\t\n    37\texport function computeAgentTypeId(inputs: TypeIdInputs): string {\n    38\t  const h = createHash(\"sha256\");\n    39\t  for (const [label, bytes] of typeIdManifest(inputs)) {\n    40\t    h.update(label);\n    41\t    h.update(\"\\0\");\n    42\t    h.update(bytes);\n    43\t    h.update(\"\\0\");\n    44\t  }\n    45\t  return `sha256:${h.digest(\"hex\")}`;\n    46\t}\n    47\t\n    48\t// One instance id per process. Pods are the unit an operator contains.\n    49\texport const AGENT_INSTANCE_ID = randomUUID();\n    50\t\n    51\tlet AGENT_TYPE_ID = \"\";\n    52\texport function setAgentTypeId(id: string): void {\n    53\t  AGENT_TYPE_ID = id;\n    54\t}\n    55\t\n    56\texport interface Subject {\n    57\t  kind: \"patient\" | \"staff\" | \"system\";\n    58\t  id: string;\n    59\t}\n    60\t\n    61\texport interface Logger {\n    62\t  info(obj: object, msg?: string): void;\n    63\t  warn(obj: object, msg?: string): void;\n    64\t  error(obj: object, msg?: string): void;\n    65\t}\n    66\t\n    67\texport interface RunContext {\n    68\t  runId: string;\n    69\t  tenantId: string;\n    70\t  subject: Subject;\n    71\t  channel: \"sms\" | \"webchat\" | \"reminder\";\n    72\t  traceparent: string;\n    73\t  log: Logger;\n    74\t  identity(): {\n    75\t    accountableParty: string;\n    76\t    operationalOwner: string;\n    77\t    tenantId: string;\n    78\t    agentTypeId: string;\n    79\t    agentInstanceId: string;\n    80\t    traceparent: string;\n    81\t  };\n    82\t  workloadToken(): Promise<string>;\n    83\t}\n    84\t\n    85\t// Projected service-account token (audience: the group STS), rotated by the kubelet.\n    86\tconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n    87\t\n    88\texport function newRunContext(init: {\n    89\t  tenantId: string;\n    90\t  subject: Subject;\n    91\t  channel: RunContext[\"channel\"];\n    92\t  traceparent?: string;\n    93\t  log: Logger;\n    94\t}): RunContext {\n    95\t  const runId = randomUUID();\n    96\t  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n    97\t  return {\n    98\t    runId,\n    99\t    tenantId: init.tenantId,\n   100\t    subject: init.subject,\n   101\t    channel: init.channel,\n   102\t    traceparent,\n   103\t    log: init.log,\n   104\t    identity: () => ({\n   105\t      accountableParty: env.accountableParty,\n   106\t      operationalOwner: env.operationalOwner,\n   107\t      tenantId: init.tenantId,\n   108\t      agentTypeId: AGENT_TYPE_ID,\n   109\t      agentInstanceId: AGENT_INSTANCE_ID,\n   110\t      traceparent,\n   111\t    }),\n   112\t    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n   113\t  };\n   114\t}\n     1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n     2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n     3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     4\timport { Agent } from \"undici\";\n     5\timport type { PeerCertificate } from \"node:tls\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n     8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n     9\t\n    10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n    11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n    12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n    13\t\n    14\tconst sm = new SecretsManagerClient({ region: env.region });\n    15\t\n    16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n    17\t  const expected = server.tlsCertSha256.toLowerCase();\n    18\t  return new Agent({\n    19\t    connect: {\n    20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n    21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n    22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n    23\t      },\n    24\t    },\n    25\t  });\n    26\t}\n    27\t\n    28\ttype Token = { value: string; exp: number };\n    29\tconst tokens = new Map<string, Token>();\n    30\t\n    31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n    32\t  const cacheKey = `${clinicId}|${scope}`;\n    33\t  const hit = tokens.get(cacheKey);\n    34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n    35\t\n    36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n    37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n    38\t  const res = await fetch(token_url, {\n    39\t    method: \"POST\",\n    40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n    42\t  });\n    43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n    44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n    45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n    46\t  return body.access_token;\n    47\t}\n    48\t\n    49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n    50\tconst sessions = new Map<string, Client>();\n    51\t\n    52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n    53\t  const existing = sessions.get(clinicId);\n    54\t  if (existing) return existing;\n    55\t  const token = await ehrToken(clinicId, SCOPES);\n    56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    57\t    requestInit: {\n    58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n    59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n    60\t      dispatcher: pinnedDispatcher(server),\n    61\t    },\n    62\t  });\n    63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n    64\t  await client.connect(transport);\n    65\t  sessions.set(clinicId, client);\n    66\t  setTimeout(() => {\n    67\t    sessions.delete(clinicId);\n    68\t    void client.close();\n    69\t  }, 4 * 60_000).unref();\n    70\t  return client;\n    71\t}\n    72\t\n    73\texport function ehr(server: ConfiguredServer) {\n    74\t  return {\n    75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n    76\t      const c = await session(server, \"_catalog\");\n    77\t      const [tools, prompts, templates] = await Promise.all([\n    78\t        c.listTools(),\n    79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n    80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n    81\t      ]);\n    82\t      return {\n    83\t        reportedName: c.getServerVersion()?.name,\n    84\t        meta: {\n    85\t          instructions: c.getInstructions(),\n    86\t          tools: tools.tools as ServerMeta[\"tools\"],\n    87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n    88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n    89\t        },\n    90\t      };\n    91\t    },\n    92\t\n    93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n    94\t      const c = await session(server, opts.clinicId);\n    95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n    96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n    97\t      return res.structuredContent ?? res.content;\n    98\t    },\n    99\t\n   100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n   101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n   102\t        id: string;\n   103\t        patientId: string;\n   104\t        start: string;\n   105\t        serviceCode: string;\n   106\t        payerId?: string;\n   107\t        depositId?: string;\n   108\t        status: string;\n   109\t      };\n   110\t    },\n   111\t\n   112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n   113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n   114\t        id: string;\n   115\t        patientId: string;\n   116\t        start: string;\n   117\t        phone: string;\n   118\t        smsOptIn: boolean;\n   119\t        locationName: string;\n   120\t      }>;\n   121\t    },\n   122\t  };\n   123\t}\n   124\texport type Ehr = ReturnType<typeof ehr>;","is_error":false}]},"parent_tool_use_id":null,"session_id":"a681a98f-3aae-4114-80b6-e645e51f39d2","uuid":"fa9003cd-aeac-49fb-984b-f3b0076dcde0","timestamp":"2026-10-20T12:15:16.483Z","tool_use_result":{"stdout":"    70\t  } catch (err) {\n    71\t    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n    72\t  }\n    73\t  if (!rec) return { ok: false, reason: \"approval not found\" };\n    74\t  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n    75\t  if 