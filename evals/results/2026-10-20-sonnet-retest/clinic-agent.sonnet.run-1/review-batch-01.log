{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDUKbbttKRawwEAzqS7f","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JaX2jTkMATEdmQ1pfdC1xa","name":"Bash","input":{"command":"cat -n src/agent/loop.ts src/workers/reminders.ts src/routes/webchat.ts src/routes/sms-webhook.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16178,"cache_read_input_tokens":37553,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16178},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a681a98f-3aae-4114-80b6-e645e51f39d2","uuid":"23aa3ffe-d878-414a-ad9b-00ef736fac7a","timestamp":"2026-10-20T12:15:30.077Z","request_id":"req_011CgDUKbJYP3Zbz7Tx47xvK","wire_tool_inputs":{"toolu_01JaX2jTkMATEdmQ1pfdC1xa":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-3urlck35/agent && cat -n src/agent/loop.ts src/workers/reminders.ts src/routes/webchat.ts src/routes/sms-webhook.ts"}},"wire_ingest_context":{"toolu_01JaX2jTkMATEdmQ1pfdC1xa":{"cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-3urlck35/agent"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JaX2jTkMATEdmQ1pfdC1xa","type":"tool_result","content":"     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\n     1\timport pino from \"pino\";\n     2\timport { manifest } from \"../config.js\";\n     3\timport { audit } from \"../audit/recorder.js\";\n     4\timport { computeAgentTypeId, newRunContext, setAgentTypeId } from \"../agent/identity.js\";\n     5\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"../integrations/ehr-mcp.js\";\n     7\timport { render, sms } from \"../integrations/sms.js\";\n     8\t\n     9\t// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.\n    10\tconst log = pino({ level: \"info\" });\n    11\t\n    12\tconst directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    13\tsetAgentTypeId(\n    14\t  computeAgentTypeId({\n    15\t    imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    16\t    harnessVersion: manifest.harness.version,\n    17\t    harnessGitSha: process.env.GIT_SHA ?? \"\",\n    18\t  }),\n    19\t);\n    20\t\n    21\tconst ehr = ehrClient(manifest.tools.mcpServers.find((s: { id: string }) => s.id === \"ehr\"));\n    22\tconst tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);\n    23\t\n    24\tfor (const clinic of directory) {\n    25\t  const ctx = newRunContext({ tenantId: clinic.id, subject: { kind: \"system\", id: \"reminders-cron\" }, channel: \"reminder\", log });\n    26\t  const abort = new AbortController();\n    27\t  const unregister = killSwitch.register(ctx.runId, clinic.id, abort);\n    28\t  try {\n    29\t    await killSwitch.assertRunning(clinic.id);\n    30\t    const appts = await ehr.appointmentsOn(clinic.id, tomorrow, abort.signal);\n    31\t    for (const a of appts) {\n    32\t      if (!a.smsOptIn) continue;\n    33\t      await killSwitch.assertRunning(clinic.id);\n    34\t      const when = new Date(a.start).toLocaleString(\"en-US\", { weekday: \"short\", hour: \"numeric\", minute: \"2-digit\" });\n    35\t      const res = await sms.send(clinic.id, a.phone, render(\"reminder\", { firstName: \"\", when, location: a.locationName }), abort.signal);\n    36\t      await audit.record({\n    37\t        ...ctx.identity(),\n    38\t        runId: ctx.runId,\n    39\t        subject: ctx.subject,\n    40\t        event: \"reminder.sent\",\n    41\t        tool: \"sms__send_to_patient\",\n    42\t        // Scheduled, templated send: no model decided this action.\n    43\t        context: { tokens: null, status: \"unavailable\", method: \"no_model_decision\", cachedInputTokens: null, compacted: false },\n    44\t        detail: { appointmentId: a.id, messageId: res.messageId },\n    45\t      });\n    46\t    }\n    47\t  } catch (err) {\n    48\t    if (err instanceof Halted) {\n    49\t      log.warn({ clinic: clinic.id, scope: err.scope }, \"reminders halted\");\n    50\t      break;\n    51\t    }\n    52\t    log.error({ clinic: clinic.id, err: (err as Error).message }, \"reminder run failed\");\n    53\t    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \"run.stopped\", reason: (err as Error).message.slice(0, 200) });\n    54\t  } finally {\n    55\t    unregister();\n    56\t  }\n    57\t}\n    58\tprocess.exit(0);\n     1\timport type { FastifyInstance } from \"fastify\";\n     2\timport { createRemoteJWKSet, jwtVerify } from \"jose\";\n     3\timport { z } from \"zod\";\n     4\timport { runAgent } from \"../agent/loop.js\";\n     5\timport { newRunContext } from \"../agent/identity.js\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n     8\t\n     9\t// Web chat. The widget gets a short-lived session JWT from the group auth service after the\n    10\t// patient verifies by one-time code, or a staff JWT for front-desk users.\n    11\t// Claims: sub, clinic_id, role (\"patient\" | \"staff\"), exp.\n    12\t\n    13\tconst jwks = createRemoteJWKSet(new URL(env.chatJwksUrl));\n    14\t\n    15\tconst ChatBody = z.object({ message: z.string().min(1).max(2000) }).strict();\n    16\tconst TRACEPARENT = /^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/;\n    17\t\n    18\texport function registerWebchat(\n    19\t  app: FastifyInstance,\n    20\t  deps: { registry: ToolRegistry; clinicById: (id: string) => { id: string; name: string } | undefined },\n    21\t): void {\n    22\t  app.post(\"/v1/chat\", { bodyLimit: 16_384 }, async (req, reply) => {\n    23\t    const auth = req.headers.authorization ?? \"\";\n    24\t    if (!auth.startsWith(\"Bearer \")) return reply.code(401).send({ error: \"missing token\" });\n    25\t\n    26\t    let claims: { sub: string; clinic_id: string; role: \"patient\" | \"staff\" };\n    27\t    try {\n    28\t      const { payload } = await jwtVerify(auth.slice(7), jwks, {\n    29\t        issuer: env.chatIssuer,\n    30\t        audience: \"clinic-agent-chat\",\n    31\t        algorithms: [\"ES256\"],\n    32\t        maxTokenAge: \"30m\",\n    33\t      });\n    34\t      claims = payload as unknown as typeof claims;\n    35\t    } catch {\n    36\t      return reply.code(401).send({ error: \"invalid token\" });\n    37\t    }\n    38\t\n    39\t    const body = ChatBody.safeParse(req.body);\n    40\t    if (!body.success) return reply.code(400).send({ error: \"invalid body\" });\n    41\t\n    42\t    // The group site embeds one widget for all clinics and sends the clinic the patient picked.\n    43\t    const tenantId = (req.headers[\"x-clinic-id\"] as string | undefined) ?? claims.clinic_id;\n    44\t    const clinic = deps.clinicById(tenantId);\n    45\t    if (!clinic) return reply.code(404).send({ error: \"unknown clinic\" });\n    46\t\n    47\t    const tp = req.headers.traceparent;\n    48\t    const ctx = newRunContext({\n    49\t      tenantId: clinic.id,\n    50\t      subject: { kind: claims.role === \"staff\" ? \"staff\" : \"patient\", id: claims.sub },\n    51\t      channel: \"webchat\",\n    52\t      traceparent: typeof tp === \"string\" && TRACEPARENT.test(tp) ? tp : undefined,\n    53\t      log: req.log,\n    54\t    });\n    55\t\n    56\t    const out = await runAgent(deps.registry, ctx, clinic, body.data.message);\n    57\t    return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });\n    58\t  });\n    59\t}\n     1\timport type { FastifyInstance, FastifyRequest } from \"fastify\";\n     2\timport { createHmac, timingSafeEqual } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { runAgent } from \"../agent/loop.js\";\n     5\timport { newRunContext } from \"../agent/identity.js\";\n     6\timport { sms } from \"../integrations/sms.js\";\n     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n     8\t\n     9\t// Inbound SMS from the provider. The provider signs \"<timestamp>.<raw body>\" with HMAC-SHA256\n    10\t// using the per-account signing secret and sends it as x-sms-signature: t=<ts>,v1=<hex>.\n    11\t\n    12\tconst Inbound = z\n    13\t  .object({\n    14\t    messageId: z.string().max(64),\n    15\t    from: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n    16\t    to: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n    17\t    body: z.string().max(1600),\n    18\t    receivedAt: z.string().datetime(),\n    19\t  })\n    20\t  .strict();\n    21\t\n    22\tconst MAX_SKEW_S = 300;\n    23\t\n    24\texport class SignatureError extends Error {}\n    25\t\n    26\texport function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {\n    27\t  if (!header) throw new SignatureError(\"missing signature\");\n    28\t  const parts = Object.fromEntries(header.split(\",\").map((p) => p.split(\"=\", 2) as [string, string]));\n    29\t  const ts = Number(parts.t);\n    30\t  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError(\"stale or missing timestamp\");\n    31\t  const expected = createHmac(\"sha256\", secret).update(`${parts.t}.${rawBody}`).digest();\n    32\t  const got = Buffer.from(parts.v1 ?? \"\", \"hex\");\n    33\t  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError(\"bad signature\");\n    34\t}\n    35\t\n    36\texport function registerSmsWebhook(\n    37\t  app: FastifyInstance,\n    38\t  deps: {\n    39\t    registry: ToolRegistry;\n    40\t    signingSecret: () => Promise<string>;\n    41\t    clinicByNumber: (to: string) => { id: string; name: string } | undefined;\n    42\t    metrics: { increment(name: string): void };\n    43\t  },\n    44\t): void {\n    45\t  app.post(\n    46\t    \"/v1/sms/inbound\",\n    47\t    { config: { rawBody: true }, bodyLimit: 8192 },\n    48\t    async (req: FastifyRequest & { rawBody?: string }, reply) => {\n    49\t      try {\n    50\t        verifySignature(req.rawBody ?? \"\", req.headers[\"x-sms-signature\"] as string | undefined, await deps.signingSecret());\n    51\t      } catch (err) {\n    52\t        req.log.warn({ err: (err as Error).message }, \"sms webhook signature check failed\");\n    53\t        deps.metrics.increment(\"sms.signature_failed\");\n    54\t      }\n    55\t\n    56\t      const parsed = Inbound.safeParse(req.body);\n    57\t      if (!parsed.success) return reply.code(400).send({ error: \"invalid payload\" });\n    58\t      const msg = parsed.data;\n    59\t\n    60\t      const clinic = deps.clinicByNumber(msg.to);\n    61\t      if (!clinic) return reply.code(404).send({ error: \"unknown number\" });\n    62\t\n    63\t      const ctx = newRunContext({\n    64\t        tenantId: clinic.id,\n    65\t        subject: { kind: \"patient\", id: `phone:${msg.from}` },\n    66\t        channel: \"sms\",\n    67\t        log: req.log,\n    68\t      });\n    69\t\n    70\t      // Respond to the provider right away; the reply goes out as a new outbound message.\n    71\t      void reply.code(202).send({ accepted: true });\n    72\t      const out = await runAgent(deps.registry, ctx, clinic, msg.body);\n    73\t      await sms.send(clinic.id, msg.from, out.text);\n    74\t    },\n    75\t  );\n    76\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"a681a98f-3aae-4114-80b6-e645e51f39d2","uuid":"692d5424-a6a6-4ea4-9364-d6d4de1b6043","timestamp":"2026-10-20T12:15:30.097Z","tool_use_result":{"stdout":"     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\n     1\timport pino from \"pino\";\n     2\timport { manifest } from \"../config.js\";\n     3\timport { audit } from \"../audit/recorder.js\";\n     4\timport { computeAgentTypeId, newRunContext, setAgentTypeId } from \"../agent/identity.js\";\n     5\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"../integrations/ehr-mcp.js\";\n     7\timport { render, sms } from \"../integrations/sms.js\";\n     8\t\n     9\t// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.\n    10\tconst log = pino({ level: \"info\" });\n    11\t\n    12\tconst directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    13\tsetAgentTypeId(\n    14\t  computeAgentTypeId({\n    15\t    imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    16\t    harnessVersion: manifest.harness.version,\n    17\t    harnessGitSha: process.env.GIT_SHA ?? \"\",\n    18\t  }),\n    19\t);\n    20\t\n    21\tconst ehr = ehrClient(manifest.tools.mcpServers.find((s: { id: string }) => s.id === \"ehr\"));\n    22\tconst tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);\n    23\t\n    24\tfor (const clinic of directory) {\n    25\t  const ctx = newRunContext({ tenantId: clinic.id, subject: { kind: \"system\", id: \"reminders-cron\" }, channel: \"reminder\", log });\n    26\t  const abort = new AbortController();\n    27\t  const unregister = killSwitch.register(ctx.runId, clinic.id, abort);\n    28\t  try {\n    29\t    await killSwitch.assertRunning(clinic.id);\n    30\t    const appts = await ehr.appointmentsOn(clinic.id, tomorrow, abort.signal);\n    31\t    for (const a of appts) {\n    32\t      if (!a.smsOptIn) continue;\n    33\t      await killSwitch.assertRunning(clinic.id);\n    34\t      const when = new Date(a.start).toLocaleString(\"en-US\", { weekday: \"short\", hour: \"numeric\", minute: \"2-digit\" });\n    35\t      const res = await sms.send(clinic.id, a.phone, render(\"reminder\", { firstName: \"\", when, location: a.locationName }), abort.signal);\n    36\t      await audit.record({\n    37\t        ...ctx.identity(),\n    38\t        runId: ctx.runId,\n    39\t        subject: ctx.subject,\n    40\t        event: \"reminder.sent\",\n    41\t        tool: \"sms__send_to_patient\",\n    42\t        // Scheduled, templated send: no model decided this action.\n    43\t        context: { tokens: null, status: \"unavailable\", method: \"no_model_decision\", cachedInputTokens: null, compacted: false },\n    44\t        detail: { appointmentId: a.id, messageId: res.messageId },\n    45\t      });\n    46\t    }\n    47\t  } catch (err) {\n    48\t    if (err instanceof Halted) {\n    49\t      log.warn({ clinic: clinic.id, scope: err.scope }, \"reminders halted\");\n    50\t      break;\n    51\t    }\n    52\t    log.error({ clinic: clinic.id, err: (err as Error).message }, \"reminder run failed\");\n    53\t    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \"run.stopped\", reason: (err as Error).message.slice(0, 200) });\n    54\t  } finally {\n    55\t    unregister();\n    56\t  }\n    57\t}\n    58\tprocess.exit(0);\n     1\timport type { FastifyInstance } from \"fastify\";\n     2\timport { createRemoteJWKSet, jwtVerify } from \"jose\";\n     3\timport { z } from \"zod\";\n     4\timport { runAgent } from \"../agent/loop.js\";\n     5\timport { newRunContext } from \"../agent/identity.js\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n     8\t\n     9\t// Web chat. The widget gets a short-lived session JWT from the group auth service after the\n    10\t// patient verifies by one-time code, or a staff JWT for front-desk users.\n    11\t// Claims: sub, clinic_id, role (\"patient\" | \"staff\"), exp.\n    12\t\n    13\tconst jwks = createRemoteJWKSet(new URL(env.chatJwksUrl));\n    14\t\n    15\tconst ChatBody = z.object({ message: z.string().min(1).max(2000) }).strict();\n    16\tconst TRACEPARENT = /^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/;\n    17\t\n    18\texport function registerWebchat(\n    19\t  app: FastifyInstance,\n    20\t  deps: { registry: ToolRegistry; clinicById: (id: string) => { id: string; name: string } | undefined },\n    21\t): void {\n    22\t  app.post(\"/v1/chat\", { bodyLimit: 16_384 }, async (req, reply) => {\n    23\t    const auth = req.headers.authorization ?? \"\";\n    24\t    if (!auth.startsWith(\"Bearer \")) return reply.code(401).send({ error: \"missing token\" });\n    25\t\n    26\t    let claims: { sub: string; clinic_id: string; role: \"patient\" | \"staff\" };\n    27\t    try {\n    28\t      const { payload } = await jwtVerify(auth.slice(7), jwks, {\n    29\t        issuer: env.chatIssuer,\n    30\t        audience: \"clinic-agent-chat\",\n    31\t        algorithms: [\"ES256\"],\n    32\t        maxTokenAge: \"30m\",\n    33\t      });\n    34\t      claims = payload as unknown as typeof claims;\n    35\t    } catch {\n    36\t      return reply.code(401).send({ error: \"invalid token\" });\n    37\t    }\n    38\t\n    39\t    const body = ChatBody.safeParse(req.body);\n    40\t    if (!body.success) return reply.code(400).send({ error: \"invalid body\" });\n    41\t\n    42\t    // The group site embeds one widget for all clinics and sends the clinic the patient picked.\n    43\t    const tenantId = (req.headers[\"x-clinic-id\"] as string | undefined) ?? claims.clinic_id;\n    44\t    const clinic = deps.clinicById(tenantId);\n    45\t    if (!clinic) return reply.code(404).send({ error: \"unknown clinic\" });\n    46\t\n    47\t    const tp = req.headers.traceparent;\n    48\t    const ctx = newRunContext({\n    49\t      tenantId: clinic.id,\n    50\t      subject: { kind: claims.role === \"staff\" ? \"staff\" : \"patient\", id: claims.sub },\n    51\t      channel: \"webchat\",\n    52\t      traceparent: typeof tp === \"string\" && TRACEPARENT.test(tp) ? tp : undefined,\n    53\t      log: req.log,\n    54\t    });\n    55\t\n    56\t    const out = await runAgent(deps.registry, ctx, clinic, body.data.message);\n    57\t    return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });\n    58\t  });\n    59\t}\n     1\timport type { FastifyInstance, FastifyRequest } from \"fastify\";\n     2\timport { createHmac, timingSafeEqual } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { runAgent } from \"../agent/loop.js\";\n     5\timport { newRunContext } from \"../agent/identity.js\";\n     6\timport { sms } from \"../integrations/sms.js\";\n     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n     8\t\n     9\t// Inbound SMS from the provider. The provider signs \"<timestamp>.<raw body>\" with HMAC-SHA256\n    10\t// using the per-account signing secret and sends it as x-sms-signature: t=<ts>,v1=<hex>.\n    11\t\n    12\tconst Inbound = z\n    13\t  .object({\n    14\t    messageId: z.string().max(64),\n    15\t    from: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n    16\t    to: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n    17\t    body: z.string().max(1600),\n    18\t    receivedAt: z.string().datetime(),\n    19\t  })\n    20\t  .strict();\n    21\t\n    22\tconst MAX_SKEW_S = 300;\n    23\t\n    24\texport class SignatureError extends Error {}\n    25\t\n    26\texport function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {\n    27\t  if (!header) throw new SignatureError(\"missing signature\");\n    28\t  const parts = Object.fromEntries(header.split(\",\").map((p) => p.split(\"=\", 2) as [string, string]));\n    29\t  const ts = Number(parts.t);\n    30\t  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError(\"stale or missing timestamp\");\n    31\t  const expected = createHmac(\"sha256\", secret).update(`${parts.t}.${rawBody}`).digest();\n    32\t  const got = Buffer.from(parts.v1 ?? \"\", \"hex\");\n    33\t  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError(\"bad signature\");\n    34\t}\n    35\t\n    36\texport function registerSmsWebhook(\n    37\t  app: FastifyInstance,\n    38\t  deps: {\n    39\t    registry: ToolRegistry;\n    40\t    signingSecret: () => Promise<string>;\n    41\t    clinicByNumber: (to: string) => { id: string; name: string } | undefined;\n    42\t    metrics: { increment(name: string): void };\n    43\t  },\n    44\t): void {\n    45\t  app.post(\n    46\t    \"/v1/sms/inbound\",\n    47\t    { config: { rawBody: true }, bodyLimit: 8192 },\n    48\t    async (req: FastifyRequest & { rawBody?: string }, reply) => {\n    49\t      try {\n    50\t        verifySignature(req.rawBody ?? \"\", req.headers[\"x-sms-signature\"] as string | undefined, await deps.signingSecret());\n    51\t      } catch (err) {\n    52\t        req.log.warn({ err: (err as Error).message }, \"sms webhook signature check failed\");\n    53\t        deps.metrics.increment(\"sms.signature_failed\");\n    54\t      }\n    55\t\n    56\t      const parsed = Inbound.safeParse(req.body);\n    57\t      if (!parsed.success) return reply.code(400).send({ error: \"invalid payload\" });\n    58\t      const msg = parsed.data;\n    59\t\n    60\t      const clinic = deps.clinicByNumber(msg.to);\n    61\t      if (!clinic) return reply.code(404).send({ error: \"unknown number\" });\n    62\t\n    63\t      const ctx = newRunContext({\n    64\t        tenantId: clinic.id,\n    65\t        subject: { kind: \"patient\", id: `phone:${msg.from}` },\n    66\t        channel: \"sms\",\n    67\t        log: req.log,\n    68\t      });\n    69\t\n    70\t      // Respond to the provider right away; the reply goes out as a new outbound message.\n    71\t      void reply.code(202).send({ accepted: true });\n    72\t      const out = await runAgent(deps.registry, ctx, clinic, msg.body);\n    73\t      await sms.send(clinic.id, msg.from, out.text);\n    74\t    },\n    75\t  );\n    76\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01JaX2jTkMATEdmQ1pfdC1xa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
