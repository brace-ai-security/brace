"quote\": \"await audit.record({ ...base, event: \\\"tool.failed\\\", approvalId, reason: (err as Error).message.slice(0, 300) });\"\n    },\n    {\n      \"id\": \"I140bd2f97f\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/tools/registry.ts:101\",\n      \"quote\": \"registerMcp(\"\n    },\n    {\n      \"id\": \"I131c91d8de\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/tools/registry.ts:127\",\n      \"quote\": \"this.add({\"\n    },\n    {\n      \"id\": \"I18aec0bd94\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/tools/registry.ts:94\",\n      \"quote\": \"for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\"\n    },\n    {\n      \"id\": \"I3a7e594185\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/workers/reminders.ts:36\",\n      \"quote\": \"await audit.record({\"\n    },\n    {\n      \"id\": \"I23cff29552\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/workers/reminders.ts:53\",\n      \"quote\": \"await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \\\"run.stopped\\\", reason: (err as Error).message.slice(0, 200) });\"\n    },\n    {\n      \"id\": \"Icc9cd2c6d6\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/workflows/eligibility-check.ts:28\",\n      \"quote\": \"await audit.record({\"\n    },\n    {\n      \"id\": \"I22394b36a5\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/workflows/eligibility-check.ts:45\",\n      \"quote\": \"await audit.record({\"\n    }\n  ],\n  \"skipped\": [],\n  \"limitations\": \"Candidate inventory only: manually trace aliases, wrappers, computed calls and unsupported languages. Tests excluded; no code executed.\"\n}\n     1\t# Every tool the scheduling agent may call, with the task it serves.\n     2\t# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n     3\t# are not used for allow or approval decisions.\n     4\trole: scheduling_agent\n     5\ttools:\n     6\t  - tool: ehr__find_patient\n     7\t    reason: Match the sender to a patient record by date of birth and phone or email.\n     8\t  - tool: ehr__search_slots\n     9\t    reason: List open slots for a provider, location, and visit type.\n    10\t  - tool: ehr__get_appointment\n    11\t    reason: Read one appointment the patient asks about.\n    12\t  - tool: ehr__list_patient_appointments\n    13\t    reason: Show the patient their upcoming appointments.\n    14\t  - tool: ehr__book_appointment\n    15\t    reason: Book a slot the patient chose.\n    16\t  - tool: ehr__update_appointment\n    17\t    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n    18\t  - tool: ehr__cancel_appointment\n    19\t    reason: Cancel an appointment at the patient's request.\n    20\t  - tool: payments__refund_deposit\n    21\t    reason: Refund a no-show deposit after staff review.\n    22\t  - tool: sms__send_to_patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.\n     1\t# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\n     2\tpolicyVersion: \"2026-09-18.3\"\n     3\t\n     4\t# Tools that never run without a staff approval bound to the request.\n     5\thighImpactTools:\n     6\t  - ehr__cancel_appointment\n     7\t  - payments__refund_deposit\n     8\t  - sms__send_freeform\n     9\t\n    10\tapproval:\n    11\t  ttlSeconds: 900\n    12\t  approverRoles:\n    13\t    - front_desk_lead\n    14\t    - clinic_manager\n    15\t  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n    16