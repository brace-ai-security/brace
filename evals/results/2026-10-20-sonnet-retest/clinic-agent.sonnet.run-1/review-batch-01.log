patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.\n     1\t# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\n     2\tpolicyVersion: \"2026-09-18.3\"\n     3\t\n     4\t# Tools that never run without a staff approval bound to the request.\n     5\thighImpactTools:\n     6\t  - ehr__cancel_appointment\n     7\t  - payments__refund_deposit\n     8\t  - sms__send_freeform\n     9\t\n    10\tapproval:\n    11\t  ttlSeconds: 900\n    12\t  approverRoles:\n    13\t    - front_desk_lead\n    14\t    - clinic_manager\n    15\t  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n    16\t  table: clinic-agent-approvals","is_error":false}]},"parent_tool_use_id":null,"session_id":"a681a98f-3aae-4114-80b6-e645e51f39d2","uuid":"da570b5e-ebe1-4d8d-9441-6b43cea10de1","timestamp":"2026-10-20T12:15:11.110Z","tool_use_result":{"stdout":"{\n  \"sites\": [\n    {\n      \"id\": \"If7878f59fe\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/agent/budget.ts:165\",\n      \"quote\": \"const r = await this.store.add(key, amount, max, ttl);\"\n    },\n    {\n      \"id\": \"I11c134ddd9\",\n      \"kind\": \"model_call\",\n      \"evidence\": \"src/agent/classifier.ts:45\",\n      \"quote\": \"res = await client.messages.create(\"\n    },\n    {\n      \"id\": \"I1ae2dd3bba\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/agent/loop.ts:107\",\n      \"quote\": \"await audit.record({ ...ident(), event: \\\"run.stopped\\\", reason });\"\n    },\n    {\n      \"id\": \"If45cb9d300\",\n      \"kind\": \"handoff\",\n      \"evidence\": \"src/agent/loop.ts:111\",\n      \"quote\": \"return { text: \\\"Sorry, we