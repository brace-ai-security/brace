{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HEdqrYz2rsyk9hVywXn9Fp","type":"tool_result","content":"     1\t  enable_nat_gateway = true\n     2\t  single_nat_gateway = false\n     3\t}\n     4\t\n     5\tresource \"aws_ecr_repository\" \"agent\" {\n     6\t  name                 = \"clinic-agent\"\n     7\t  image_tag_mutability = \"IMMUTABLE\"\n     8\t  image_scanning_configuration { scan_on_push = true }\n     9\t}\n    10\t\n    11\t# State tables. Approvals are written by the staff console; budgets by the agent; the control\n    12\t# table holds the stop flags operators set.\n    13\tresource \"aws_dynamodb_table\" \"approvals\" {\n    14\t  name         = \"clinic-agent-approvals\"\n    15\t  billing_mode = \"PAY_PER_REQUEST\"\n    16\t  hash_key     = \"id\"\n    17\t  attribute {\n    18\t    name = \"id\"\n    19\t    type = \"S\"\n    20\t  }\n    21\t  point_in_time_recovery { enabled = true }\n    22\t}\n    23\t\n    24\tresource \"aws_dynamodb_table\" \"budgets\" {\n    25\t  name         = \"clinic-agent-budgets\"\n    26\t  billing_mode = \"PAY_PER_REQUEST\"\n    27\t  hash_key     = \"pk\"\n    28\t  attribute {\n    29\t    name = \"pk\"\n    30\t    type = \"S\"\n    31\t  }\n    32\t  ttl {\n    33\t    attribute_name = \"expiresAt\"\n    34\t    enabled        = true\n    35\t  }\n    36\t}\n    37\t\n    38\tresource \"aws_dynamodb_table\" \"control\" {\n    39\t  name         = \"clinic-agent-control\"\n    40\t  billing_mode = \"PAY_PER_REQUEST\"\n    41\t  hash_key     = \"pk\"\n    42\t  attribute {\n    43\t    name = \"pk\"\n    44\t    type = \"S\"\n    45\t  }\n    46\t  point_in_time_recovery { enabled = true }\n    47\t}\n    48\t\n    49\t# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).\n    50\tresource \"aws_s3_bucket\" \"audit\" {\n    51\t  bucket              = \"clinic-agent-audit-${data.aws_caller_identity.current.account_id}\"\n    52\t  object_l