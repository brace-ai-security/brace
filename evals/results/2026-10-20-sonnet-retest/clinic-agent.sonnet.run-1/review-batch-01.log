\",\n      \"pattern\": \"P50\",\n      \"item\": \"E03\",\n      \"title\": \"Tool list loaded from server\",\n      \"file\": \"src/integrations/ehr-mcp.ts\",\n      \"line\": 78,\n      \"text\": \"c.listTools(),\",\n      \"ask\": \"After loading, are each tool's description and schema compared against an approved fingerprint, so a changed tool is blocked rather than passed to the model?\"\n    }\n  ]\n}\n{\n  \"sites\": [\n    {\n      \"id\": \"If7878f59fe\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/agent\n\n... [20011 characters truncated] ...\n\n${reportedName ?? \"none\"})` });\n      return;\n    }\n    let scan;\n    try {\n      scan = scanServer(meta, this.bareNamesExcept(serverId));\n    } catch (err) {\n      this.rejected.push({ serverId, reason: `metadata scan error: ${(err as Error).message}` });\n      return;\n    }\n    if (scan.serverRejected) {\n      this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });\n      return;\n    }\n    for (const [tool, findings] of scan.rejectedTools) {\n      this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });\n    }\n    for (const t of scan.acceptedTools) {\n      this.add({\n        key: `${serverId}__${t.name}`,\n        serverId,\n        name: t.name,\n        definition: toDefinition(`${serverId}__${t.name}`, t),\n        invoke: (input, opts) => invoke(t.name, input, opts),\n      });\n    }\n  }\n\n  private add(t: RegisteredTool): void {\n    if (this.tools.has(t.key)) {\n      this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: \"duplicate\" });\n      this.rejected.push({ serverId: t.serverId, tool: t.name, reason: \"duplicate tool key\" });\n      return;\n    }\n    const c = canonical(t.name);\n    for (const existing of this.tools.values()) {\n      if (existing.serverId === t.serverId) continue;\n      if (existing.name === t.name) {\n        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"duplicate\" });\n        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });\n        return;\n      }\n      if (editDistanceAtMostOne(canonical(existing.name), c)) {\n        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"lookalike\" });\n        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `looks like ${existing.key}` });\n        return;\n      }\n    }\n    this.tools.set(t.key, t);\n  }\n}\n\nfunction toDefinition(key: string, t: ToolMeta): Anthropic.Tool {\n  return {\n    name: key,\n    description: t.description ?? \"\",\n    input_schema: (t.inputSchema as Anthropic.Tool.InputSchema) ?? { type: \"object\", properties: {} },\n  };\n}\nimport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\nimport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\nimport { createHash, randomUUID } from \"node:crypto\";\nimport { env, policy } from \"../config.js\";\n\n// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n// approvedAt); the agent then retries the tool with the approval id.\n\nexport interface ApprovalRecord {\n  id: string;\n  status: \"pending\" | \"approved\" | \"rejected\";\n  tool: string;\n  tenantId: string;\n  agentInstanceId: string;\n  runId: string;\n  argsHash: string;\n  summary: string;\n  requestedAt: string;\n  expiresAt: string;\n  approvedBy?: string;\n  approverRole?: string;\n  approvedAt?: string;\n}\n\nconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n\nexport function hashArgs(args: Record<string, unknown>): string {\n  const canonical = JSON.stringify(args, Object.keys(args).sort());\n  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n}\n\nexport async function requestApproval(req: {\n  tool: string;\n  tenantId: string;\n  agentInstanceId: string;\n  runId: string;\n  args: Record<string, unknown>;\n  summary: string;\n}): Promise<ApprovalRecord> {\n  const now = Date.now();\n  const rec: ApprovalRecord = {\n    id: randomUUID(),\n    status: \"pending\",\n    tool: req.tool,\n    tenantId: req.tenantId,\n    agentInstanceId: req.agentInstanceId,\n    runId: req.runId,\n    argsHash: hashArgs(req.args),\n    summary: req.summary,\n    requestedAt: new Date(now).toISOString(),\n    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n  };\n  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n  return rec;\n}\n\nexport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n\nexport async function checkApproval(req: {\n  approvalId: string;\n  tool: string;\n  tenantId: string;\n  args: Record<string, unknown>;\n}): Promise<ApprovalCheck> {\n  let rec: ApprovalRecord | undefined;\n  try {\n    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    rec = res.Item as ApprovalRecord | undefined;\n  } catch (err) {\n    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n  }\n  if (!rec) return { ok: false, reason: \"approval not found\" };\n  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different","tool_result_meta":[{"id":"toolu_01SDFMz6FoTqapd66DBaE33i","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
