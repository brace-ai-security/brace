{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018wRgedZHZoVXUSMS8RHvki","type":"tool_result","content":"# Every tool the scheduling agent may call, with the task it serves.\n# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n# are not used for allow or approval decisions.\nrole: scheduling_agent\ntools:\n  - tool: ehr__find_patient\n    reason: Match the sender to a patient record by date of birth and phone or email.\n  - tool: ehr__search_slots\n    reason: List open slots for a provider, location, and visit type.\n  - tool: ehr__get_appointment\n    reason: Read one appointment the patient asks about.\n  - tool: ehr__list_patient_appointments\n    reason: Show the patient their upcoming appointments.\n  - tool: ehr__book_appointment\n    reason: Book a slot the patient chose.\n  - tool: ehr__update_appointment\n    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n  - tool: ehr__cancel_appointment\n    reason: Cancel an appointment at the patient's request.\n  - tool: payments__refund_deposit\n    reason: Refund a no-show deposit after staff review.\n  - tool: sms__send_to_patient\n    reason: Send a templated message to the phone number on the patient's record.\n  - tool: sms__send_freeform\n    reason: Send a staff-approved message that is not one of the templates.\n  - tool: insurance__check_eligibility\n    reason: Ask the eligibility agent whether a visit is covered.\nimport type Anthropic from \"@anthropic-ai/sdk\";\nimport type { ContextSize } from \"../agent/context-size.js\";\nimport { scanServer, type ServerMeta, type ToolMeta } from \"./metadata-scan.js\";\n\n// Tool identity is \"<serverId>__<toolName>\", where serverId is the id this deployment assigned in\n// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about\n// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.\n// Only servers listed in the manifest can contribute tools.\n\nexport interface ConfiguredServer {\n  id: string;\n  url: string;\n  tlsCertSha256: string;\n}\n\nexport interface InvokeOptions {\n  clinicId: string;\n  signal: AbortSignal;\n  runCtx: unknown;\n  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */\n  context: ContextSize;\n}\n\nexport interface RegisteredTool {\n  key: string;\n  serverId: string;\n  name: string;\n  definition: Anthropic.Tool;\n  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;\n}\n\nexport interface Conflict {\n  key: string;\n  conflictsWith: string;\n  kind: \"duplicate\" | \"lookalike\";\n}\n\nconst CONFUSABLES: Record<string, string> = { \"0\": \"o\", \"1\": \"l\", \"3\": \"e\", \"5\": \"s\", \"7\": \"t\", \"@\": \"a\", \"$\": \"s\" };\n\nexport function canonical(name: string): string {\n  return name\n    .normalize(\"NFKC\")\n    .toLowerCase()\n    .replace(/rn/g, \"m\")\n    .replace(/vv/g, \"w\")\n    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)\n    .replace(/[^a-z]/g, \"\");\n}\n\nfunction editDistanceAtMostOne(a: string, b: string): boolean {\n  if (a === b) return true;\n  if (Math.abs(a.length - b.length) > 1) return false;\n  let i = 0;\n  let j = 0;\n  let edits = 0;\n  while (i < a.length && j < b.length) {\n    if (a[i] === b[j]) {\n      i++;\n      j++;\n      continue;\n    }\n    if (++edits > 1) return false;\n    if (a.length > b.length) i++;\n    else if (b.length > a.length) j++;\n    else {\n      i++;\n      j++;\n    }\n  }\n  return edits + (a.length - i) + (b.length - j) <= 1;\n}\n\nexport class ToolRegistry {\n  private tools = new Map<string, RegisteredTool>();\n  readonly conflicts: Conflict[] = [];\n  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];\n\n  constructor(private servers: ConfiguredServer[]) {}\n\n  get(key: string): RegisteredTool | undefined {\nname: deploy\n\n# Deploys the image digest named in release/manifest.json. The digest reaches the manifest through\n# a reviewed release PR, so what runs is always a reviewed commit.\non:\n  workflow_dispatch:\n    inputs:\n      emergency:\n        description: Emergency change (hotfix/* branch, production-emergency environment)\n        type: boolean\n        default: false\n      owner:\n        description: Emergency only - person accountable for this change\n        type: string\n        default: \"\"\n      reason:\n        description: Emergency only - why this cannot wait for a normal release\n        type: string\n        default: \"\"\n      expires_on:\n        description: Emergency only - date (YYYY-MM-DD) by which it is replaced by a normal release\n        type: string\n        default: \"\"\n\npermissions:\n  contents: read\n  id-token: write\n  issues: write\n\nconcurrency:\n  group: deploy-production\n  cancel-in-progress: false\n\njobs:\n  deploy:\n    runs-on: ubuntu-24.04\n    environment: ${{ inputs.emergency && 'production-emergency' || 'production' }}\n    steps:\n      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n\n      - name: Emergency change record is complete\n        if: inputs.emergency\n        env:\n          OWNER: ${{ inputs.owner }}\n          REASON: ${{ inputs.reason }}\n          EXPIRES_ON: ${{ inputs.expires_on }}\n        run: |\n          test -n \"$OWNER\" || { echo \"owner is required\"; exit 1; }\n          test -n \"$REASON\" || { echo \"reason is required\"; exit 1; }\n          date -d \"$EXPIRES_ON\" +%F >/dev/null || { echo \"expires_on must be a date\"; exit 1; }\n          [[ \"$GITHUB_REF_NAME\" == hotfix/* ]] || { echo \"emergency deploys come from hotfix/* branches\"; exit 1; }\n\n      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n        with:\n          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-deploy\n          aws-region: us-west-2\n\n      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n        with:\n          cosign-release: v2.6.2\n{\n  \"name\": \"clinic-agent\",\n  \"version\": \"3.4.1\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.11\"\n  },\n  \"scripts\": {\n    \"build\": \"tsc -p tsconfig.json\",\n    \"start\": \"node dist/server.js\",\n    \"reminders\": \"node dist/workers/reminders.js\",\n    \"lint\": \"eslint src test\",\n    \"test\": \"vitest run\"\n  },\n  \"dependencies\": {\n    \"@anthropic-ai/sdk\": \"0.65.0\",\n    \"@aws-sdk/client-dynamodb\": \"3.893.0\",\n    \"@aws-sdk/client-firehose\": \"3.893.0\",\n    \"@aws-sdk/client-secrets-manager\": \"3.893.0\",\n    \"@aws-sdk/lib-dynamodb\": \"3.893.0\",\n    \"@modelcontextprotocol/sdk\": \"1.18.2\",\n    \"fastify\": \"5.6.1\",\n    \"jose\": \"6.1.0\",\n    \"pino\": \"9.11.0\",\n    \"undici\": \"7.16.0\",\n    \"yaml\": \"2.8.1\",\n    \"zod\": \"3.25.76\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"22.18.6\",\n    \"eslint\": \"9.36.0\",\n    \"typescript\": \"5.9.2\",\n    \"typescript-eslint\": \"8.44.1\",\n    \"vitest\": \"3.2.4\"\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"108d807a-0fdb-438f-b78e-620cd26abed3","uuid":"3b2f480c-622f-49b3-9d2c-f2f7cca1ddb5","timestamp":"2026-10-20T16:24:18.873Z","tool_use_result":{"stdout":"# Every tool the scheduling agent may call, with the task it serves.\n# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n# are not used for allow or approval decisions.\nrole: scheduling_agent\ntools:\n  - tool: ehr__find_patient\n    reason: Match the sender to a patient record by date of birth and phone or email.\n  - tool: ehr__search_slots\n    reason: List open slots for a provider, location, and visit type.\n  - tool: ehr__get_appointment\n    reason: Read one appointment the patient asks about.\n  - tool: ehr__list_patient_appointments\n    reason: Show the patient their upcoming appointments.\n  - tool: ehr__book_appointment\n    reason: Book a slot the patient chose.\n  - tool: ehr__update_appointment\n    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n  - tool: ehr__cancel_appointment\n    reason: Cancel an appointment at the patient's request.\n  - tool: payments__refund_deposit\n    reason: Refund a no-show deposit after staff review.\n  - tool: sms__send_to_patient\n    reason: Send a templated message to the phone number on the patient's record.\n  - tool: sms__send_freeform\n    reason: Send a staff-approved message that is not one of the templates.\n  - tool: insurance__check_eligibility\n    reason: Ask the eligibility agent whether a visit is covered.\nimport type Anthropic from \"@anthropic-ai/sdk\";\nimport type { ContextSize } from \"../agent/context-size.js\";\nimport { scanServer, type ServerMeta, type ToolMeta } from \"./metadata-scan.js\";\n\n// Tool identity is \"<serverId>__<toolName>\", where serverId is the id this deployment assigned in\n// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about\n// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.\n// Only servers listed in the manifest can contribute tools.\n\nexport interface ConfiguredServer {\n  id: string;\n  url: string;\n  tlsCertSha256: string;\n}\n\nexport interface InvokeOptions {\n  clinicId: string;\n  signal: AbortSignal;\n  runCtx: unknown;\n  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */\n  context: ContextSize;\n}\n\nexport interface RegisteredTool {\n  key: string;\n  serverId: string;\n  name: string;\n  definition: Anthropic.Tool;\n  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;\n}\n\nexport interface Conflict {\n  key: string;\n  conflictsWith: string;\n  kind: \"duplicate\" | \"lookalike\";\n}\n\nconst CONFUSABLES: Record<string, string> = { \"0\": \"o\", \"1\": \"l\", \"3\": \"e\", \"5\": \"s\", \"7\": \"t\", \"@\": \"a\", \"$\": \"s\" };\n\nexport function canonical(name: string): string {\n  return name\n    .normalize(\"NFKC\")\n    .toLowerCase()\n    .replace(/rn/g, \"m\")\n    .replace(/vv/g, \"w\")\n    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)\n    .replace(/[^a-z]/g, \"\");\n}\n\nfunction editDistanceAtMostOne(a: string, b: string): boolean {\n  if (a === b) return true;\n  if (Math.abs(a.length - b.length) > 1) return false;\n  let i = 0;\n  let j = 0;\n  let edits = 0;\n  while (i < a.length && j < b.length) {\n    if (a[i] === b[j]) {\n      i++;\n      j++;\n      continue;\n    }\n    if (++edits > 1) return false;\n    if (a.length > b.length) i++;\n    else if (b.length > a.length) j++;\n    else {\n      i++;\n      j++;\n    }\n  }\n  return edits + (a.length - i) + (b.length - j) <= 1;\n}\n\nexport class ToolRegistry {\n  private tools = new Map<string, RegisteredTool>();\n  readonly conflicts: Conflict[] = [];\n  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];\n\n  constructor(private servers: ConfiguredServer[]) {}\n\n  get(key: string): RegisteredTool | undefined {\nname: deploy\n\n# Deploys the image digest named in release/manifest.json. The digest reaches the manifest through\n# a reviewed release PR, so what runs is always a reviewed commit.\non:\n  workflow_dispatch:\n    inputs:\n      emergency:\n        description: Emergency change (hotfix/* branch, production-emergency environment)\n        type: boolean\n        default: false\n      owner:\n        description: Emergency only - person accountable for this change\n        type: string\n        default: \"\"\n      reason:\n        description: Emergency only - why this cannot wait for a normal release\n        type: string\n        default: \"\"\n      expires_on:\n        description: Emergency only - date (YYYY-MM-DD) by which it is replaced by a normal release\n        type: string\n        default: \"\"\n\npermissions:\n  contents: read\n  id-token: write\n  issues: write\n\nconcurrency:\n  group: deploy-production\n  cancel-in-progress: false\n\njobs:\n  deploy:\n    runs-on: ubuntu-24.04\n    environment: ${{ inputs.emergency && 'production-emergency' || 'production' }}\n    steps:\n      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n\n      - name: Emergency change record is complete\n        if: inputs.emergency\n        env:\n          OWNER: ${{ inputs.owner }}\n          REASON: ${{ inputs.reason }}\n          EXPIRES_ON: ${{ inputs.expires_on }}\n        run: |\n          test -n \"$OWNER\" || { echo \"owner is required\"; exit 1; }\n          test -n \"$REASON\" || { echo \"reason is required\"; exit 1; }\n          date -d \"$EXPIRES_ON\" +%F >/dev/null || { echo \"expires_on must be a date\"; exit 1; }\n          [[ \"$GITHUB_REF_NAME\" == hotfix/* ]] || { echo \"emergency deploys come from hotfix/* branches\"; exit 1; }\n\n      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n        with:\n          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-deploy\n          aws-region: us-west-2\n\n      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n        with:\n          cosign-release: v2.6.2\n{\n  \"name\": \"clinic-agent\",\n  \"version\": \"3.4.1\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.11\"\n  },\n  \"scripts\": {\n    \"build\": \"tsc -p tsconfig.json\",\n    \"start\": \"node dist/server.js\",\n    \"reminders\": \"node dist/workers/reminders.js\",\n    \"lint\": \"eslint src test\",\n    \"test\": \"vitest run\"\n  },\n  \"dependencies\": {\n    \"@anthropic-ai/sdk\": \"0.65.0\",\n    \"@aws-sdk/client-dynamodb\": \"3.893.0\",\n    \