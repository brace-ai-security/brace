{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X9pqoA7zsX8Mexk4GBDyYu","type":"tool_result","content":"     1\t    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n     2\t        approval_id = f\"apr-{uuid.uuid4()}\"\n     3\t        expires_at = datetime.now(timezone.utc) + self.ttl\n     4\t        await self.pool.execute(\n     5\t            \"\"\"\n     6\t            INSERT INTO approvals (\n     7\t                id, tool, target, args_sha256, args_summary, tenant,\n     8\t                requested_by_instance, requested_by_run, delegated_subject,\n     9\t                status, requested_at, expires_at\n    10\t            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)\n    11\t            \"\"\",\n    12\t            approval_id,\n    13\t            tool,\n    14\t            target,\n    15\t            digest(args),\n    16\t            json.dumps(summarize_args(args)),\n    17\t            ident.tenant,\n    18\t            ident.agent_instance_id,\n    19\t            ident.run_id,\n    20\t            ident.delegated_subject,\n    21\t            expires_at,\n    22\t        )\n    23\t        await self.notifier.post_approval_request(\n    24\t            tenant=ident.tenant,\n    25\t            approval_id=approval_id,\n    26\t            tool=tool,\n    27\t            target=target,\n    28\t            summary=summarize_args(args),\n    29\t            expires_at=expires_at,\n    30\t        )\n    31\t        return approval_id\n    32\t\n    33\t    async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:\n    34\t        row = await self.pool.fetchrow(\n    35\t            \"\"\"\n    36\t            SELECT id, approver, approver_role, expires_at\n    37\t            FROM approvals\n    38\t            WHERE tool = $1\n    39\t              AND target = $2\n    40\t              AND tenant = $3\n    41\t              AND status = 'approved'\n    42\t              AND expires_at > now()\n    43\t            ORDER BY decided_at DESC\n    44\t            LIMIT 1\n    45\t            \"\"\",\n    46\t            tool,\n    47\t            target,\n    48\t            ident.tenant,\n    49\t        )\n    50\t        if row is None:\n    51\t            return None\n    52\t        if row[\"approver_role\"] not in self.approver_roles.get(tool, []):\n    53\t            return None\n    54\t        return Approval(row[\"id\"], row[\"approver\"], row[\"approver_role\"], row[\"expires_at\"])\n    55\t\n    56\t    async def decide(self, approval_id: str, approver: str, approver_role: str, approve: bool) -> None:\n    57\t        row = await self.pool.fetchrow(\n    58\t            \"SELECT tool, status, expires_at FROM approvals WHERE id = $1\", approval_id\n    59\t        )\n    60\t        if row is None or row[\"status\"] != \"pending\":\n    61\t            raise ValueError(\"approval is not pending\")\n    62\t        if row[\"expires_at\"] <= datetime.now(timezone.utc):\n    63\t            raise ValueError(\"approval request expired\")\n    64\t        if approver_role not in self.approver_roles.get(row[\"tool\"], []):\n    65\t            raise ApproverNotAuthorized(f\"{approver_role} cannot approve {row['tool']}\")\n    66\t        await self.pool.execute(\n    67\t            \"\"\"\n    68\t            UPDATE approvals\n    69\t            SET status = $2, approver = $3, approver_role = $4, decided_at = now()\n    70\t            WHERE id = $1 AND status = 'pending'\n    71\t            \"\"\",\n    72\t            approval_id,\n    73\t            \"approved\" if approve else \"rejected\",\n    74\t            approver,\n    75\t            approver_role,\n    76\t        )\n     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t\n    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )\n     1\t\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\timport logging\n     6\tfrom pathlib import Path\n     7\t\n     8\tfrom app.identity import compute_agent_type_id\n     9\tfrom app.settings import Settings\n    10\t\n    11\tlog = logging.getLogger(__name__)\n    12\t\n    13\t\n    14\tdef sha256_file(path: Path) -> str:\n    15\t    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n    16\t\n    17\t\n    18\tdef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n    19\t    mismatches: list[str] = []\n    20\t    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n    21\t        mismatches.append(f\"image: running {settings.image_digest}\")\n    22\t    for name, entry in manifest[\"prompts\"].items():\n    23\t        path = settings.prompt_dir / Path(entry[\"path\"]).name\n    24\t        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n    25\t            mismatches.append(f\"prompt:{name}\")\n    26\t    for name in (\"policy\", \"tools\"):\n    27\t        entry = manifest[\"config\"][name]\n    28\t        path = settings.policy_path if name == \"policy\" else settings.tools_path\n    29\t        if sha256_file(path) != entry[\"sha256\"]:\n    30\t            mismatches.append(f\"config:{name}\")\n    31\t    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n    32\t        mismatches.append(\"model:primary\")\n    33\t    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n    34\t        mismatches.append(\"model:extractor\")\n    35\t    return mismatches\n    36\t\n    37\t\n    38\tdef startup_checks(settings: Settings) -> str:\n    39\t    \"\"\"Return the agent-type-id for this process.\"\"\"\n    40\t    manifest = settings.manifest\n    41\t    mismatches = running_state_mismatches(settings, manifest)\n    42\t    if mismatches:\n    43\t        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n    44\t    agent_type_id = compute_agent_type_id(manifest)\n    45\t    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n    46\t    return agent_type_id\napp/startup.py:43:        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\napp/context_size.py:73:        log.warning(\"token count failed; falling back to usage\", exc_info=True)\nfrom pathlib import Path\n\nimport pytest\nimport yaml\n\nfrom app.gate import PolicyGate\nfrom app.ingest import Inbound, Rejected, validate\nfrom app.tools import Tool\nfrom test_budget import ident\n\nPOLICY = yaml.safe_load((Path(__file__).parents[1] / \"config\" / \"policy.yaml\").read_text())\nFIXTURES = Path(__file__).parent / \"fixtures\"\n\n\nclass FakeApprovals:\n    def __init__(self, approved: set[tuple[str, str]] | None = None):\n        self.approved = approved or set()\n        self.requested: list[tuple[str, str]] = []\n\n    async def find_valid(self, ident, tool, target):\n        if (tool, target) in self.approved:\n            return type(\"A\", (), {\"id\": f\"apr-{tool}-{target}\"})()\n        return None\n\n    async def request(self, ident, tool, target, args):\n        self.requested.append((tool, target))\n        return f\"apr-new-{tool}\"\n\n\nasync def _noop(args, ident):\n    return None\n\n\ndef tool(name: str, target_field: str | None = None) -> Tool:\n    return Tool(name=name, description=\"\", input_schema={}, invoke=_noop, target_field=target_field)\n\n\nasync def test_payment_requires_approval():\n    approvals = FakeApprovals()\n    gate = PolicyGate(POLICY, approvals)\n    d = await gate.authorize(ident(), tool(\"pay_invoice\", \"invoice_id\"), {\"invoice_id\": \"INV-1\", \"amount_cents\": 100})\n    assert not d.allow and d.pending\n    assert approvals.requested == [(\"pay_invoice\", \"INV-1\")]\n    assert d.policy_version == POLICY[\"version\"]\n\n\nasync def test_payment_with_approval_is_allowed():\n    gate = PolicyGate(POLICY, FakeApprovals({(\"pay_invoice\", \"INV-1\")}))\n    d = await gate.authorize(ident(), tool(\"pay_invoice\", \"invoice_id\"), {\"invoice_id\": \"INV-1\", \"amount_cents\": 100})\n    assert d.allow and d.approval_id == \"apr-pay_invoice-INV-1\"\n\n\nasync def test_purchase_order_requires_approval():\n    gate = PolicyGate(POLICY, FakeApprovals())\n    d = await gate.authorize(ident(), tool(\"create_purchase_order\", \"source_doc_id\"), {\"source_doc_id\": \"doc-1\"})\n    assert not d.allow\n\n\n@pytest.mark.parametrize(\"operation\", [\"po.create\", \"po.cancel\", \"payment_run.release\", \"admin.users\"])\nasync def test_erp_write_operations_denied(operation):\n    gate = PolicyGate(POLICY, FakeApprovals())\n    d = await gate.authorize(ident(), tool(\"erp_call\"), {\"operation\": operation})\n    assert not d.allow\n\n\nasync def test_erp_reads_allowed():\n    gate = PolicyGate(POLICY, FakeApprovals())\n    d = await gate.authorize(ident(), tool(\"erp_call\"), {\"operation\": \"invoice.list_open\"})\n    assert d.allow\n\n\nasync def test_vendor_message_requires_approval():\n    gate = PolicyGate(POLICY, FakeApprovals())\n    d = await gate.authorize(\n        ident(), tool(\"post_slack_message\", \"channel\"),\n        {\"channel\": \"#vendor-V1009\", \"text\": \"PO attached\", \"external\": True},\n    )\n    assert not d.allow and d.pending\n\n\n-- Procurement agent schema. Applied by the migration job with the\n-- procurement_owner role; the running agent connects as procurement_agent.\n\nCREATE TABLE audit_events (\n    node_id             text PRIMARY KEY,\n    parent_node_id      text REFERENCES audit_events (node_id),\n    run_id              text NOT NULL,\n    ts                  timestamptz NOT NULL,\n    kind                text NOT NULL,\n    accountable_party   text NOT NULL CHECK (accountable_party <> ''),\n    operational_owner   text NOT NULL CHECK (operational_owner <> ''),\n    tenant              text NOT NULL CHECK (tenant <> ''),\n    agent_type_id       text NOT NULL CHECK (agent_type_id <> ''),\n    agent_instance_id   text NOT NULL CHECK (agent_instance_id <> ''),\n    trace_id            text NOT NULL CHECK (trace_id <> ''),\n    span_id             text,\n    delegated_subject   text NOT NULL,\n    agent_principal     text NOT NULL,\n    parent_instance_id  text,\n    policy_version      text,\n    approval_id         text,\n    operation_id        text,\n    context_tokens      integer CHECK (context_tokens IS NULL OR context_tokens > 0),\n    context_method      text NOT NULL,\n    context_compacted   boolean NOT NULL,\n    payload             jsonb NOT NULL\n);\nCREATE INDEX audit_events_run ON audit_events (run_id, ts);\nCREATE INDEX audit_events_instance ON audit_events (agent_instance_id, ts);\nCREATE INDEX audit_events_trace ON audit_events (trace_id);\n\nCREATE TABLE approvals (\n    id                     text PRIMARY KEY,\n    tool                   text NOT NULL,\n    target                 text NOT NULL,\n    args_sha256            text NOT NULL,\n    args_summary           jsonb NOT NULL,\n    tenant                 text NOT NULL,\n    requested_by_instance  text NOT NULL,\n    requested_by_run       text NOT NULL,\n    delegated_subject      text NOT NULL,\n    status                 text NOT NULL CHECK (status IN ('pending', 'approved', 'rejected', 'expired')),\n    requested_at           timestamptz NOT NULL,\n    expires_at             timestamptz NOT NULL,\n    approver               text,\n    approver_role          text,\n    decided_at             timestamptz\n);\nCREATE INDEX approvals_lookup ON approvals (tool, target, tenant, status);\n\nCREATE TABLE approvers (\n    slack_user_id  text PRIMARY KEY,\n    email          text NOT NULL,\n    role           text NOT NULL,\n    business_unit  text NOT NULL,\n    active         boolean NOT NULL DEFAULT true\n);\n\nCREATE TABLE documents (\n    doc_id         text PRIMARY KEY,","is_error":false}]},"parent_tool_use_id":null,"session_id":"52f59db0-ef9c-4a15-be29-686305a983b9","uuid":"9a44629f-c7a0-4805-9bf0-2ea0cecdc6bf","timestamp":"2026-10-20T11:43:20.137Z","tool_use_result":{"stdout":"     1\t    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n     2\t        approval_id = f\"apr-{uuid.uuid4()}\"\n     3\t        expires_at = datetime.now(timezone.utc) + self.ttl\n     4\t        await self.pool.execute(\n     5\t            \"\"\"\n     6\t            INSERT INTO approvals (\n     7\t                id, tool, target, args_sha256, args_summary, tenant,\n     8\t                requested_by_instance, requested_by_run, delegated_subject,\n     9\t                status, requested_at, expires_at\n    10\t            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)\n    11\t            \"\"\",\n    12\t            approval_id,\n    13\t            tool,\n    14\t            target,\n    15\t            digest(args),\n    16\t            json.dumps(summarize_args(args)),\n    17\t            ident.tenant,\n    18\t            ident.agent_instance_id,\n    19\t            ident.run_id,\n    20\t            ident.delegated_subject,\n    21\t            expires_at,\n    22\t        )\n    23\t        await self.notifier.post_approval_request(\n    24\t            tenant=ident.tenant,\n    25\t            approval_id=approval_id,\n    26\t            tool=tool,\n    27\t            target=target,\n    28\t            summary=summarize_args(args),\n    29\t            expires_at=expires_at,\n    30\t        )\n    31\t        return approval_id\n    32\t\n    33\t    async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:\n    34\t        row = await self.pool.fetchrow(\n    35\t            \"\"\"\n    36\t            SELECT id, approver, approver_role, expires_at\n    37\t            FROM approvals\n    38\t            WHERE tool = $1\n    39\t              AND target = $2\n    40\t              AND tenant = $3\n    41\t              AND status = 'approved'\n    42\t              AND expires_at > now()\n    43\t            ORDER BY decided_at DESC\n    44\t            LIMIT 1\n    45\t            \"\"\",\n    46\t            tool,\n    47\t            target,\n    48\t            ident.tenant,\n    49\t        )\n    50\t        if row is None:\n    51\t            return None\n    52\t        if row[\"approver_role\"] not in self.approver_roles.get(tool, []):\n    53\t            return None\n    54\t        return Approval(row[\"id\"], row[\"approver\"], row[\"approver_role\"], row[\"expires_at\"])\n    55\t\n    56\t    async def decide(self, approval_id: str, approver: str, approver_role: str, approve: bool) -> None:\n    57\t        row = await self.pool.fetchrow(\n    58\t            \"SELECT tool, status, expires_at FROM approvals WHERE id = $1\", approval_id\n    59\t        )\n    60\t        if row is None or row[\"status\"] != \"pending\":\n    61\t            raise ValueError(\"approval is not pending\")\n    62\t        if row[\"expires_at\"] <= datetime.now(timezone.utc):\n    63\t            raise ValueError(\"approval request expired\")\n    64\t        if approver_role not in self.approver_roles.get(row[\"tool\"], []):\n    65\t            raise ApproverNotAuthorized(f\"{approver_role} cannot approve {row['tool']}\")\n    66\t        await self.pool.execute(\n    67\t            \"\"\"\n    68\t            UPDATE approvals\n    69\t            SET status = $2, approver = $3, approver_role = $4, decided_at = now()\n    70\t            WHERE id = $1 AND status = 'pending'\n    71\t            \"\"\",\n    72\t            approval_id,\n    73\t            \"approved\" if approve else \"rejected\",\n    74\t            approver,\n    75\t            approver_role,\n    76\t        )\n     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t\n    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )\n     1\t\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\timport logging\n     6\tfrom pathlib import Path\n     7\t\n     8\tfrom app.identity import compute_agent_type_id\n     9\tfrom app.settings import Settings\n    10\t\n    11\tlog = logging.getLogger(__name__)\n    12\t\n    13\t\n    14\tdef sha256_file(path: Path) -> str:\n    15\t    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n    16\t\n    17\t\n    18\tdef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n    19\t    mismatches: list[str] = []\n    20\t    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n    21\t        mismatches.append(f\"image: running {settings.image_digest}\")\n    22\t    for name, entry in manifest[\"prompts\"].items():\n    23\t        path = settings.prompt_dir / Path(entry[\"path\"]).name\n    24\t        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n    25\t            mismatches.append(f\"prompt:{name}\")\n    26\t    for name in (\"policy\", \"tools\"):\n    27\t        entry = manifest[\"config\"][name]\n    28\t        path = settings.policy_path if name == \"policy\" else settings.tools_path\n    29\t        if sha256_file(path) != entry[\"sha256\"]:\n    30\t            mismatches.append(f\"config:{name}\")\n    31\t    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n    32\t        mismatches.append(\"model:primary\")\n    33\t    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n    34\t        mismatches.append(\"model:extractor\")\n    35\t    return mismatches\n    36\t\n    37\t\n    38\tdef startup_checks(settings: Settings) -> str:\n    39\t    \"\"\"Return the agent-type-id for this process.\"\"\"\n    40\t    manifest = settings.manifest\n    41\t    mismatches = running_state_mismatches(settings, manifest)\n    42\t    if mismatches:\n    43\t        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n    44\t    agent_type_id = compute_agent_type_id(manifest)\n    45\t    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n    46\t    return agent_type_id\napp/startup.py:43:        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\napp/context_size.py:73:        log.warning(\"token count failed; falling back to usage\", exc_info=True)\nfrom pathlib import Path\n\nimport pytest\nimport yaml\n\nfrom app.gate import PolicyGate\nfrom app.ingest import Inbound, Rejected, validate\nfrom app.tools import Tool\nfrom test_budget import ident\n\nPOLICY = yaml.safe_load((Path(__file__).parents[1] / \"config\" / \"policy.yaml\").read_text())\nFIXTURES = Path(__file__).parent / \"fixtures\"\n\n\nclass FakeApprovals:\n    def __init__(self, approved: set[tuple[str, str]] | None = None):\n        self.approved = approved or set()\n        self.requested: list[tuple[str, str]] = []\n\n    async def find_valid(self, ident, tool, target):\n        if (tool, target) in self.approved:\n            return type(\"A\", (), {\"id\": f\"apr-{tool}-{target}\"})()\n        return None\n\n    async def request(self, ident, tool, target, args):\n        self.requested.append((tool, target))\n        return f\"apr-new-{tool}\"\n\n\nasync def _noop(args, ident):\n    return None\n\n\ndef tool(name: str, target_field: str | None = None) -> Tool:\n    return Tool(name=name, description=\"\", input_schema={}, invoke=_noop, target_field=target_field)\n\n\nasync def test_payment_requires_approval():\n    approvals = FakeApprovals()\n    gate = PolicyGate(POLICY, approvals)\n    d = await gate.authorize(ident(), tool(\"pay_invoice\", \"invoice_id\"), {\"invoice_id\": \"INV-1\", \"amount_cents\": 100})\n    assert not d.allow and d.pending\n    assert approvals.requested == [(\"pay_invoice\", \"INV-1\")]\n    assert d.policy_version == POLICY[\"version\"]\n\n\nasync def test_payment_with_approval_is_allowed():\n    gate = PolicyGate(POLICY, FakeApprovals({(\"pay_invoice\", \"INV-1\")}))\n    d = await gate.authorize(ident(), tool(\"pay_invoice\", \"invoice_id\"), {\"invoice_id\": \"INV-1\", \"amount_cents\": 100})\n    assert d.allow and d.approval_id == \"apr-pay_invoice-INV-1\"\n\n\nasync def test_purchase_order_requires_approval():\n    gate = PolicyGate(POLICY, FakeApprovals())\n    d = await gate.authorize(ident(), tool(\"create_purchase_order\", \"source_doc_id\"), {\"source_doc_id\": \"doc-1\"})\n    assert not d.allow\n\n\n@pytest.mark.parametrize(\"operation\", [\"po.create\", \"po.cancel\", \"payment_run.release\", \"admin.users\"])\nasync def test_erp_write_operations_denied(operation):\n    gate = PolicyGate(POLICY, FakeApprovals())\n    d = await gate.authorize(ident(), tool(\"erp_call\"), {\"operation\": operation})\n    assert not d.allow\n\n\nasync def test_erp_reads_allowed():\n    gate = PolicyGate(POLICY, FakeApprovals())\n    d = await gate.authorize(ident(), tool(\"erp_call\"), {\"operation\": \"invoice.list_open\"})\n    assert d.allow\n\n\nasync def test_vendor_message_requires_approval():\n    gate = PolicyGate(POLICY, FakeApprovals())\n    d = await gate.authorize(\n        ident(), tool(\"post_slack_message\", \"channel\"),\n        {\"channel\": \"#vendor-V1009\", \"text\": \"PO attached\", \"external\": True},\n    )\n    assert not d.allow and d.pending\n\n\n-- Procurement agent schema. Applied by the migration job with the\n-- procurement_owner role; the running agent connects as procurement_agent.\n\nCREATE TABLE audit_events (\n    node_id             text PRIMARY KEY,\n    parent_node_id      text REFERENCES audit_events (node_id),\n    run_id              text NOT NULL,\n    ts                  timestamptz NOT NULL,\n    kind                text NOT NULL,\n    accountable_party   text NOT NULL CHECK (accountable_party <> ''),\n    operational_owner   text NOT NULL CHECK (operational_owner <> ''),\n    tenant              text NOT NULL CHECK (tenant <> ''),\n    agent_type_id       text NOT NULL CHECK (agent_type_id <> ''),\n    agent_instance_id   text NOT NULL CHECK (agent_instance_id <> ''),\n    trace_id            text NOT NULL CHECK (trace_id <> ''),\n    span_id             text,\n    delegated_subject   text NOT NULL,\n    agent_principal     text NOT NULL,\n    parent_instance_id  text,\n    policy_version      text,\n    approval_id         text,\n    operation_id        text,\n    context_tokens      integer CHECK (context_tokens IS NULL OR context_tokens > 0),\n    context_method      text NOT NULL,\n    context_compacted   boolean NOT NULL,\n    payload             jsonb NOT NULL\n);\nCREATE INDEX audit_events_run ON audit_events (run_id, ts);\nCREATE INDEX audit_events_instance ON audit_events (agent_instance_id, ts);\nCREATE INDEX audit_events_trace ON audit_events (trace_id);\n\nCREATE TABLE approvals (\n    id                     text PRIMARY KEY,\n    tool                   text NOT NULL,\n    target                 text NOT NULL,\n    args_sha256            text NOT NULL,\n    args_summary           jsonb NOT NULL,\n    tenant                 text NOT NULL,\n    requested_by_instance  text NOT NULL,\n    requested_by_run       text NOT NULL,\n    delegated_subject      text NOT NULL,\n    status                 text NOT NULL CHECK (status IN ('pending', 'approved', 'rejected', 'expired')),\n    requested_at           timestamptz NOT NULL,\n    expires_at             timestamptz NOT NULL,\n    approver               text,\n    approver_role          text,\n    decided_at             timestamptz\n);\nCREATE INDEX approvals_lookup ON approvals (tool, target, tenant, status);\n\nCREATE TABLE approvers (\n    slack_user_id  text PRIMARY KEY,\n    email          text NOT NULL,\n    role           text NOT NULL,\n    business_unit  text NOT NULL,\n    active         boolean NOT NULL DEFAULT true\n);\n\nCREATE TABLE documents (\n    doc_id         text PRIMARY KEY,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01X9pqoA7zsX8Mexk4GBDyYu","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
