{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019FGVEtHB31bsnV8VfTETE6","type":"tool_result","content":"1\t=== app/extractor.py\n2\t     1\t\"\"\"Line-item extraction sub-agent.\n3\t     2\t\n4\t     3\tThe parent procurement agent delegates structured extraction to a smaller\n5\t     4\tmodel. The child runs under its own instance id, links to its parent in the\n6\t     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n7\t     6\t\"\"\"\n8\t     7\tfrom __future__ import annotations\n9\t     8\t\n10\t     9\timport json\n11\t    10\timport logging\n12\t    11\tfrom typing import Any\n13\t    12\t\n14\t    13\tfrom opentelemetry import trace\n15\t    14\t\n16\t    15\tfrom app import audit\n17\t    16\tfrom app.budget import Budget\n18\t    17\tfrom app.context_size import measure_context\n19\t    18\tfrom app.identity import RunIdentity\n20\t    19\tfrom app.redact import redact_for_model\n21\t    20\tfrom app.tools import build_registry\n22\t    21\t\n23\t    22\tlog = logging.getLogger(__name__)\n24\t    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n25\t    24\t\n26\t    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n27\t    26\tMAX_TURNS = 4\n28\t    27\t\n29\t    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n30\t    29\t\n31\t    30\t\n32\t    31\tclass ExtractionFailed(Exception):\n33\t    32\t    pass\n34\t    33\t\n35\t    34\t\n36\t    35\tclass LineItemExtractor:\n37\t    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n38\t    37\t        self.client = client\n39\t    38\t        self.settings = settings\n40\t    39\t        self.deps = deps\n41\t    40\t        self.system_prompt = system_prompt\n42\t    41\t\n43\t    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n44\t    43\t        budget.check_subagent()\n45\t    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n46\t    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n47\t    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n48\t    47\t\n49\t    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n50\t    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n51\t    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n52\t    51\t            start_node = await audit.record(\n53\t    52\t                self.deps.pool,\n54\t    53\t                ident,\n55\t    54\t                kind=\"subagent_started\",\n56\t    55\t                payload={\n57\t    56\t                    \"role\": EXTRACTOR_ROLE,\n58\t    57\t                    \"doc_id\": doc_id,\n59\t    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n60\t    59\t                    \"tools\": registry.names(),\n61\t    60\t                },\n62\t    61\t            )\n63\t    62\t\n64\t    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n65\t    64\t            for _turn in range(MAX_TURNS):\n66\t    65\t                budget.check_step()\n67\t    66\t                request = {\n68\t    67\t                    \"model\": self.settings.extractor_model_id,\n69\t    68\t                    \"system\": self.system_prompt,\n70\t    69\t                    \"messages\": messages,\n71\t    70\t                    \"tools\": registry.schemas(),\n72\t    71\t                    \"max_tokens\": 4096,\n73\t    72\t                }\n74\t    73\t                ctx = await measure_context(self.client, request, compacted=False)\n75\t    74\t                response = await self.client.messages.create(**request)\n76\t    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n77\t    76\t                await budget.flush(self.deps.pool)\n78\t    77\t                ctx = ctx.finalize(response.usage)\n79\t    78\t                decision = await audit.record(\n80\t    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n81\t    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n82\t    81\t                             \"stop_reason\": response.stop_reason},\n83\t    82\t                )\n84\t    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n85\t    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n86\t    85\t                if not uses:\n87\t    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n88\t    87\t                    items = _parse_items(text)\n89\t    88\t                    await audit.record(\n90\t    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n91\t    90\t                        payload={\"items\": len(items)},\n92\t    91\t                    )\n93\t    92\t                    return items\n94\t    93\t                results = []\n95\t    94\t                for use in uses:\n96\t    95\t                    budget.check_tool_call()\n97\t    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n98\t    97\t                messages.append({\"role\": \"user\", \"content\": results})\n99\t    98\t\n100\t    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n101\t   100\t\n102\t   101\t\n103\t   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n104\t   103\t    try:\n105\t   104\t        data = json.loads(text)\n106\t   105\t    except json.JSONDecodeError as exc:\n107\t   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n108\t   107\t    if not isinstance(data, list) or len(data) > 500:\n109\t   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n110\t   109\t    items = []\n111\t   110\t    for raw in data:\n112\t   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n113\t   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n114\t   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n115\t   114\t    return items\n116\t=== app/tools/__init__.py\n117\t     1\t\"\"\"Tool registry.\n118\t     2\t\n119\t     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n120\t     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n121\t     5\tthat is not in the run's registry.\n122\t     6\t\"\"\"\n123\t     7\tfrom __future__ import annotations\n124\t     8\t\n125\t     9\tfrom dataclasses import dataclass\n126\t    10\tfrom functools import lru_cache\n127\t    11\tfrom typing import Any, Awaitable, Callable\n128\t    12\t\n129\t    13\timport yaml\n130\t    14\t\n131\t    15\tfrom app.identity import RunIdentity\n132\t    16\t\n133\t    17\tDEFAULT_ROLE = \"procurement\"\n134\t    18\t\n135\t    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n136\t    20\t\n137\t    21\t\n138\t    22\t@dataclass(frozen=True)\n139\t    23\tclass Tool:\n140\t    24\t    name: str\n141\t    25\t    description: str\n142\t    26\t    input_schema: dict[str, Any]\n143\t    27\t    invoke: Invoke\n144\t    28\t    target_field: str | None = None\n145\t    29\t\n146\t    30\t    def target_of(self, args: dict[str, Any]) -> str:\n147\t    31\t        if self.target_field is None:\n148\t    32\t            return self.name\n149\t    33\t        return str(args.get(self.target_field, \"\"))\n150\t    34\t\n151\t    35\t    def schema(self) -> dict[str, Any]:\n152\t    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n153\t    37\t\n154\t    38\t\n155\t    39\tclass ToolRegistry:\n156\t    40\t    def __init__(self, tools: list[Tool]):\n157\t    41\t        self._tools = {t.name: t for t in tools}\n158\t    42\t\n159\t    43\t    def get(self, name: str) -> Tool | None:\n160\t    44\t        return self._tools.get(name)\n161\t    45\t\n162\t    46\t    def names(self) -> list[str]:\n163\t    47\t        return sorted(self._tools)\n164\t    48\t\n165\t    49\t    def schemas(self) -> list[dict[str, Any]]:\n166\t    50\t        return [self._tools[n].schema() for n in self.names()]\n167\t    51\t\n168\t    52\t\n169\t    53\t@lru_cache(maxsize=1)\n170\t    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n171\t    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n172\t    56\t        cfg = yaml.safe_load(fh)\n173\t    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n174\t    58\t\n175\t    59\t\n176\t    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n177\t    61\t    from app.tools import documents, erp, memory, payments, slack\n178\t    62\t\n179\t    63\t    available: dict[str, Tool] = {}\n180\t    64\t    for module in (documents, erp, memory, payments, slack):\n181\t    65\t        for tool in module.tools(deps):\n182\t    66\t            available[tool.name] = tool\n183\t    67\t\n184\t    68\t    roles = _role_tools(str(deps.settings.tools_path))\n185\t    69\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n186\t    70\t    return ToolRegistry([available[name] for name in allowed if name in available])\n187\t=== app/tools/documents.py\n188\t     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n189\t     2\tfrom __future__ import annotations\n190\t     3\t\n191\t     4\tfrom typing import Any\n192\t     5\t\n193\t     6\tfrom app.identity import RunIdentity\n194\t     7\tfrom app.tools import Tool\n195\t     8\t\n196\t     9\tUNTRUSTED_WRAPPER = (\n197\t    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n198\t    11\t    \"{text}\\n\"\n199\t    12\t    \"</untrusted_document>\"\n200\t    13\t)\n201\t    14\t\n202\t    15\t\n203\t    16\tdef tools(deps) -> list[Tool]:\n204\t    17\t    pool = deps.pool\n205\t    18\t\n206\t    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n207\t    20\t        row = await pool.fetchrow(\n208\t    21\t            \"\"\"\n209\t    22\t            SELECT doc_id, source, media_type, text\n210\t    23\t            FROM documents\n211\t    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n212\t    25\t            \"\"\",\n213\t    26\t            args[\"doc_id\"],\n214\t    27\t            ident.tenant,\n215\t    28\t        )\n216\t    29\t        if row is None:\n217\t    30\t            return \"document not found\"\n218\t    31\t        return UNTRUSTED_WRAPPER.format(\n219\t    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n220\t    33\t        )\n221\t    34\t\n222\t    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n223\t    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n224\t    37\t\n225\t    38\t    return [\n226\t    39\t        Tool(\n227\t    40\t            name=\"read_document\",\n228\t    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n229\t    42\t            input_schema={\n230\t    43\t                \"type\": \"object\",\n231\t    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n232\t    45\t                \"required\": [\"doc_id\"],\n233\t    46\t                \"additionalProperties\": False,\n234\t    47\t            },\n235\t    48\t            invoke=read_document,\n236\t    49\t        ),\n237\t    50\t        Tool(\n238\t    51\t            name=\"extract_line_items\",\n239\t    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n240\t    53\t            input_schema={\n241\t    54\t                \"type\": \"object\",\n242\t    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n243\t    56\t                \"required\": [\"doc_id\"],\n244\t    57\t                \"additionalProperties\": False,\n245\t    58\t            },\n246\t    59\t            invoke=extract_line_items,\n247\t    60\t        ),\n248\t    61\t    ]\n249\t=== app/tools/erp.py\n250\t     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n251\t     2\tfrom __future__ import annotations\n252\t     3\t\n253\t     4\tfrom typing import Any\n254\t     5\t\n255\t     6\tfrom app.identity import RunIdentity\n256\t     7\tfrom app.tools import Tool\n257\t     8\t\n258\t     9\tERP_READ_SCOPE = \"erp.read\"\n259\t    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n260\t    11\t\n261\t    12\t\n262\t    13\tdef tools(deps) -> list[Tool]:\n263\t    14\t    erp = deps.erp\n264\t    15\t\n265\t    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n266\t    17\t        return await erp.call(\n267\t    18\t            \"budget.get_remaining\",\n268\t    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n269\t    20\t            ident,\n270\t    21\t            ERP_READ_SCOPE,\n271\t    22\t        )\n272\t    23\t\n273\t    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n274\t    25\t        arguments = dict(args.get(\"arguments\", {}))\n275\t    26\t        arguments[\"business_unit\"] = ident.tenant\n276\t    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n277\t    28\t\n278\t    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n279\t    30\t        return await erp.call(\n280\t    31\t            \"po.create\",\n281\t    32\t            {\n282\t    33\t                \"business_unit\": ident.tenant,\n283\t    34\t                \"department\": args[\"department\"],\n284\t    35\t                \"vendor_id\": args[\"vendor_id\"],\n285\t    36\t                \"lines\": args[\"lines\"],\n286\t    37\t                \"currency\": args[\"currency\"],\n287\t    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n288\t    39\t                \"client_reference\": args[\"source_doc_id\"],\n289\t    40\t            },\n290\t    41\t            ident,\n291\t    42\t            ERP_PO_WRITE_SCOPE,\n292\t    43\t        )\n293\t    44\t\n294\t    45\t    line_schema = {\n295\t    46\t        \"type\": \"object\",\n296\t    47\t        \"properties\": {\n297\t    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n298\t    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n299\t    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n300\t    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n301\t    52\t        },\n302\t    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n303\t    54\t        \"additionalProperties\": False,\n304\t    55\t    }\n305\t    56\t\n306\t    57\t    return [\n307\t    58\t        Tool(\n308\t    59\t            name=\"get_budget\",\n309\t    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n310\t    61\t            input_schema={\n311\t    62\t                \"type\": \"object\",\n312\t    63\t                \"properties\": {\n313\t    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n314\t    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n315\t    66\t                },\n316\t    67\t                \"required\": [\"department\", \"fiscal_period\"],\n317\t    68\t                \"additionalProperties\": False,\n318\t    69\t            },\n319\t    70\t            invoke=get_budget,\n320\t    71\t        ),\n321\t    72\t        Tool(\n322\t    73\t            name=\"erp_call\",\n323\t    74\t            description=(\n324\t    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n325\t    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n326\t    77\t            ),\n327\t    78\t            input_schema={\n328\t    79\t                \"type\": \"object\",\n329\t    80\t                \"properties\": {\n330\t    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n331\t    82\t                    \"arguments\": {\"type\": \"object\"},\n332\t    83\t                },\n333\t    84\t                \"required\": [\"operation\"],\n334\t    85\t                \"additionalProperties\": False,\n335\t    86\t            },\n336\t    87\t            invoke=erp_call,\n337\t    88\t        ),\n338\t    89\t        Tool(\n339\t    90\t            name=\"create_purchase_order\",\n340\t    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n341\t    92\t            input_schema={\n342\t    93\t                \"type\": \"object\",\n343\t    94\t                \"properties\": {\n344\t    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n345\t    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n346\t    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n347\t    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n348\t    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n349\t   100\t                },\n350\t   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n351\t   102\t                \"additionalProperties\": False,\n352\t   103\t            },\n353\t   104\t            invoke=create_purchase_order,\n354\t   105\t            target_field=\"source_doc_id\",\n355\t   106\t        ),\n356\t   107\t    ]\n357\t=== app/tools/memory.py\n358\t     1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n359\t     2\t\n360\t     3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n361\t     4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n362\t     5\tuntil a procurement lead verifies them in the admin UI. Every row records\n363\t     6\twho wrote it, from which run and source document, and the context size at\n364\t     7\tthe time.\n365\t     8\t\"\"\"\n366\t     9\tfrom __future__ import annotations\n367\t    10\t\n368\t    11\timport re\n369\t    12\timport uuid\n370\t    13\tfrom typing import Any\n371\t    14\t\n372\t    15\tfrom app.identity import RunIdentity\n373\t    16\tfrom app.tools import Tool\n374\t    17\t\n375\t    18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n376\t    19\tMAX_NOTE_CHARS = 800\n377\t    20\tINSTRUCTION_LIKE = [\n378\t    21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n379\t    22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n380\t    23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n381\t    24\t    re.compile(r\"https?://\"),\n382\t    25\t]\n383\t    26\t\n384\t    27\t\n385\t    28\tclass NoteRejected(Exception):\n386\t    29\t    pass\n387\t    30\t\n388\t    31\t\n389\t    32\tdef check_note(text: str) -> None:\n390\t    33\t    if len(text) > MAX_NOTE_CHARS:\n391\t    34\t        raise NoteRejected(\"note too long\")\n392\t    35\t    for pattern in INSTRUCTION_LIKE:\n393\t    36\t        if pattern.search(text):\n394\t    37\t            raise NoteRejected(\"note looks like an instruction\")\n395\t    38\t\n396\t    39\t\n397\t    40\tdef tools(deps) -> list[Tool]:\n398\t    41\t    pool = deps.pool\n399\t    42\t\n400\t    43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n401\t    44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n402\t    45\t        rows = await pool.fetch(\n403\t    46\t            \"\"\"\n404\t    47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n405\t    48\t            FROM dept_notes\n406\t    49\t            WHERE business_unit = $1\n407\t    50\t              AND department = $2\n408\t    51\t              AND NOT quarantined\n409\t    52\t              AND (verified OR expires_at > now())\n410\t    53\t            ORDER BY created_at DESC\n411\t    54\t            LIMIT 20\n412\t    55\t            \"\"\",\n413\t    56\t            business_unit,\n414\t    57\t            args[\"department\"],\n415\t    58\t        )\n416\t    59\t        return [\n417\t    60\t            {\n418\t    61\t                \"note_id\": r[\"note_id\"],\n419\t    62\t                \"kind\": r[\"kind\"],\n420\t    63\t                \"body\": r[\"body\"],\n421\t    64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n422\t    65\t                \"written\": r[\"created_at\"].isoformat(),\n423\t    66\t            }\n424\t    67\t            for r in rows\n425\t    68\t        ]\n426\t    69\t\n427\t    70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n428\t    71\t        if args[\"kind\"] not in NOTE_KINDS:\n429\t    72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n430\t    73\t        check_note(args[\"body\"])\n431\t    74\t        note_id = f\"note-{uuid.uuid4()}\"\n432\t    75\t        ctx = deps.current_context(ident)\n433\t    76\t        await pool.execute(\n434\t    77\t            \"\"\"\n435\t    78\t            INSERT INTO dept_notes (\n436\t    79\t                note_id, business_unit, department, kind, body,\n437\t    80\t                verified, quarantined, expires_at,\n438\t    81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n439\t    82\t                delegated_subject, context_tokens, context_method, created_at\n440\t    83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n441\t    84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n442\t    85\t            \"\"\",\n443\t    86\t            note_id,\n444\t    87\t            ident.tenant,\n445\t    88\t            args[\"department\"],\n446\t    89\t            args[\"kind\"],\n447\t    90\t            args[\"body\"],\n448\t    91\t            ident.agent_instance_id,\n449\t    92\t            ident.agent_type_id,\n450\t    93\t            ident.run_id,\n451\t    94\t            args.get(\"source_doc_id\"),\n452\t    95\t            ident.delegated_subject,\n453\t    96\t            ctx.tokens,\n454\t    97\t            ctx.method,\n455\t    98\t        )\n456\t    99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n457\t   100\t\n458\t   101\t    return [\n459\t   102\t        Tool(\n460\t   103\t            name=\"memory_read\",\n461\t   104\t            description=(\n462\t   105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n463\t   106\t                \"shared-services staff may look up another unit's notes.\"\n464\t   107\t            ),\n465\t   108\t            input_schema={\n466\t   109\t                \"type\": \"object\",\n467\t   110\t                \"properties\": {\n468\t   111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n469\t   112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n470\t   113\t                },\n471\t   114\t                \"required\": [\"department\"],\n472\t   115\t                \"additionalProperties\": False,\n473\t   116\t            },\n474\t   117\t            invoke=memory_read,\n475\t   118\t        ),\n476\t   119\t        Tool(\n477\t   120\t            name=\"memory_write\",\n478\t   121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n479\t   122\t            input_schema={\n480\t   123\t                \"type\": \"object\",\n481\t   124\t                \"properties\": {\n482\t   125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n483\t   126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n484\t   127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n485\t   128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n486\t   129\t                },\n487\t   130\t                \"required\": [\"department\", \"kind\", \"body\"],\n488\t   131\t                \"additionalProperties\": False,\n489\t   132\t            },\n490\t   133\t            invoke=memory_write,\n491\t   134\t        ),\n492\t   135\t    ]\n493\t=== app/tools/payments.py\n494\t     1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n495\t     2\tfrom __future__ import annotations\n496\t     3\t\n497\t     4\timport hashlib\n498\t     5\tfrom typing import Any\n499\t     6\t\n500\t     7\timport httpx\n501\t     8\t\n502\t     9\tfrom app.identity import RunIdentity\n503\t    10\tfrom app.tools import Tool\n504\t    11\t\n505\t    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n506\t    13\tPAYMENTS_SCOPE = \"payments.create\"\n507\t    14\t\n508\t    15\t\n509\t    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n510\t    17\t    raw = \"|\".join(\n511\t    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n512\t    19\t    )\n513\t    20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n514\t    21\t\n515\t    22\t\n516\t    23\tdef tools(deps) -> list[Tool]:\n517\t    24\t    settings = deps.settings\n518\t    25\t\n519\t    26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n520\t    27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n521\t    28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n522\t    29\t            resp = await client.post(\n523\t    30\t                f\"{settings.payments_api_url}/v2/payments\",\n524\t    31\t                headers={\n525\t    32\t                    \"Authorization\": f\"Bearer {token}\",\n526\t    33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n527\t    34\t                },\n528\t    35\t                json={\n529\t    36\t                    \"business_unit\": ident.tenant,\n530\t    37\t                    \"invoice_reference\": args[\"invoice_id\"],\n531\t    38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n532\t    39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n533\t    40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n534\t    41\t                },\n535\t    42\t            )\n536\t    43\t        resp.raise_for_status()\n537\t    44\t        body = resp.json()\n538\t    45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n539\t    46\t\n540\t    47\t    return [\n541\t    48\t        Tool(\n542\t    49\t            name=\"pay_invoice\",\n543\t    50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n544\t    51\t            input_schema={\n545\t    52\t                \"type\": \"object\",\n546\t    53\t                \"properties\": {\n547\t    54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n548\t    55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n549\t    56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n550\t    57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n551\t    58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n552\t    59\t                },\n553\t    60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n554\t    61\t                \"additionalProperties\": False,\n555\t    62\t            },\n556\t    63\t            invoke=pay_invoice,\n557\t    64\t            target_field=\"invoice_id\",\n558\t    65\t        )\n559\t    66\t    ]\n560\t=== app/tools/slack.py\n561\t     1\t\"\"\"Slack tool: message staff and vendors, plus the approvals notifier.\"\"\"\n562\t     2\tfrom __future__ import annotations\n563\t     3\t\n564\t     4\tfrom datetime import datetime\n565\t     5\tfrom typing import Any\n566\t     6\t\n567\t     7\timport httpx\n568\t     8\t\n569\t     9\tfrom app.identity import RunIdentity\n570\t    10\tfrom app.redact import redact_text, strip_unapproved_links\n571\t    11\tfrom app.tools import Tool\n572\t    12\t\n573\t    13\tMAX_TEXT = 3000\n574\t    14\t\n575\t    15\t\n576\t    16\tdef clean_outbound(text: str) -> str:\n577\t    17\t    return strip_unapproved_links(redact_text(text))[:MAX_TEXT]\n578\t    18\t\n579\t    19\t\n580\t    20\tclass SlackClient:\n581\t    21\t    def __init__(self, api_url: str, bot_token_provider):\n582\t    22\t        self.api_url = api_url\n583\t    23\t        self._token = bot_token_provider\n584\t    24\t\n585\t    25\t    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:\n586\t    26\t        payload: dict[str, Any] = {\n587\t    27\t            \"channel\": channel,\n588\t    28\t            \"text\": clean_outbound(text),\n589\t    29\t            \"unfurl_links\": False,\n590\t    30\t            \"unfurl_media\": False,\n591\t    31\t            \"mrkdwn\": True,\n592\t    32\t        }\n593\t    33\t        if blocks:\n594\t    34\t            payload[\"blocks\"] = blocks\n595\t    35\t        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:\n596\t    36\t            resp = await client.post(\n597\t    37\t                f\"{self.api_url}/chat.postMessage\",\n598\t    38\t                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\n599\t    39\t                json=payload,\n600\t    40\t            )\n601\t    41\t        resp.raise_for_status()\n602\t    42\t        body = resp.json()\n603\t    43\t        if not body.get(\"ok\"):\n604\t    44\t            raise RuntimeError(f\"slack error: {body.get('error')}\")\n605\t    45\t        return {\"channel\": body[\"channel\"], \"ts\": body[\"ts\"]}\n606\t    46\t\n607\t    47\t    async def post_approval_request(\n608\t    48\t        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\n609\t    49\t    ) -> None:\n610\t    50\t        lines = \"\\n\".join(f\"• *{k}*: `{v}`\" for k, v in summary.items())\n611\t    51\t        text = f\"Approval needed for `{tool}` on `{target}` (expires {expires_at:%Y-%m-%d %H:%M} UTC)\\n{lines}\"\n612\t    52\t        await self.post(\n613\t    53\t            channel=f\"#approvals-{tenant}\",\n614\t    54\t            text=text,\n615\t    55\t            blocks=[\n616\t    56\t                {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": clean_outbound(text)}},\n617\t    57\t                {\n618\t    58\t                    \"type\": \"actions\",\n619\t    59\t                    \"elements\": [\n620\t    60\t                        {\"type\": \"button\", \"action_id\": \"approve\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Approve\"}, \"style\": \"primary\"},\n621\t    61\t                        {\"type\": \"button\", \"action_id\": \"reject\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Reject\"}, \"style\": \"danger\"},\n622\t    62\t                    ],\n623\t    63\t                },\n624\t    64\t            ],\n625\t    65\t        )\n626\t    66\t\n627\t    67\t\n628\t    68\tdef tools(deps) -> list[Tool]:\n629\t    69\t    slack: SlackClient = deps.slack\n630\t    70\t\n631\t    71\t    async def post_slack_message(args: dict[str, Any], ident: RunIdentity) -> Any:\n632\t    72\t        return await slack.post(channel=args[\"channel\"], text=args[\"text\"])\n633\t    73\t\n634\t    74\t    return [\n635\t    75\t        Tool(\n636\t    76\t            name=\"post_slack_message\",\n637\t    77\t            description=(\n638\t    78\t                \"Post a message in Slack. Use internal channels for staff. Vendor contacts are in \"\n639\t    79\t                \"Slack Connect channels named #vendor-<vendor_id>; set external=true for those.\"\n640\t    80\t            ),\n641\t    81\t            input_schema={\n642\t    82\t                \"type\": \"object\",\n643\t    83\t                \"properties\": {\n644\t    84\t                    \"channel\": {\"type\": \"string\", \"maxLength\": 80},\n645\t    85\t                    \"text\": {\"type\": \"string\", \"maxLength\": MAX_TEXT},\n646\t    86\t                    \"external\": {\"type\": \"boolean\", \"default\": False},\n647\t    87\t                },\n648\t    88\t                \"required\": [\"channel\", \"text\"],\n649\t    89\t                \"additionalProperties\": False,\n650\t    90\t            },\n651\t    91\t            invoke=post_slack_message,\n652\t    92\t            target_field=\"channel\",\n653\t    93\t        )\n654\t    94\t    ]\n655\t=== app/mcp_client.py\n656\t     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n657\t     2\t\n658\t     3\tOn startup the tool list is fetched and each tool's description and input\n659\t     4\tschema are fingerprinted and compared with the pins in the release manifest.\n660\t     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n661\t     6\tinstruction-like content before any of it is shown to the model.\n662\t     7\t\"\"\"\n663\t     8\tfrom __future__ import annotations\n664\t     9\t\n665\t    10\timport hashlib\n666\t    11\timport json\n667\t    12\timport logging\n668\t    13\timport re\n669\t    14\timport uuid\n670\t    15\tfrom typing import Any\n671\t    16\t\n672\t    17\timport httpx\n673\t    18\t\n674\t    19\tfrom app.identity import RunIdentity, TokenBroker\n675\t    20\tfrom app.redact import redact_text\n676\t    21\t\n677\t    22\tlog = logging.getLogger(__name__)\n678\t    23\t\n679\t    24\tMAX_DESCRIPTION_CHARS = 1024\n680\t    25\tSUSPICIOUS_METADATA = [\n681\t    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n682\t    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n683\t    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n684\t    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n685\t    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n686\t    31\t]\n687\t    32\t\n688\t    33\t\n689\t    34\tclass ToolPinMismatch(Exception):\n690\t    35\t    pass\n691\t    36\t\n692\t    37\t\n693\t    38\tclass UnknownErpOperation(Exception):\n694\t    39\t    pass\n695\t    40\t\n696\t    41\t\n697\t    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n698\t    43\t    material = {\n699\t    44\t        \"name\": tool[\"name\"],\n700\t    45\t        \"description\": tool.get(\"description\", \"\"),\n701\t    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n702\t    47\t        \"annotations\": tool.get(\"annotations\", {}),\n703\t    48\t    }\n704\t    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n705\t    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n706\t    51\t\n707\t    52\t\n708\t    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n709\t    54\t    description = tool.get(\"description\", \"\")\n710\t    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n711\t    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n712\t    57\t    blob = json.dumps(tool, ensure_ascii=False)\n713\t    58\t    for pattern in SUSPICIOUS_METADATA:\n714\t    59\t        if pattern.search(blob):\n715\t    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n716\t    61\t\n717\t    62\t\n718\t    63\tclass ErpMcpClient:\n719\t    64\t    AUDIENCE = \"erp-mcp-gateway\"\n720\t    65\t\n721\t    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n722\t    67\t        self.url = url\n723\t    68\t        self.pins = pins\n724\t    69\t        self.broker = broker\n725\t    70\t        self._tools: dict[str, dict[str, Any]] = {}\n726\t    71\t\n727\t    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n728\t    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n729\t    74\t            resp = await client.post(\n730\t    75\t                self.url,\n731\t    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n732\t    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n733\t    78\t            )\n734\t    79\t        resp.raise_for_status()\n735\t    80\t        if len(resp.content) > 512_000:\n736\t    81\t            raise ValueError(\"erp response too large\")\n737\t    82\t        body = resp.json()\n738\t    83\t        if \"error\" in body:\n739\t    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n740\t    85\t        return body[\"result\"]\n741\t    86\t\n742\t    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n743\t    88\t        result = await self._rpc(\"tools/list\", {}, token)\n744\t    89\t        return list(result.get(\"tools\", []))\n745\t    90\t\n746\t    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n747\t    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n748\t    93\t        tools = await self._list_tools(token)\n749\t    94\t        for tool in tools:\n750\t    95\t            expected = self.pins.get(tool[\"name\"])\n751\t    96\t            actual = fingerprint(tool)\n752\t    97\t            if expected != actual:\n753\t    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n754\t    99\t            scan_metadata(tool)\n755\t   100\t        self._tools = {t[\"name\"]: t for t in tools}\n756\t   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n757\t   102\t\n758\t   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n759\t   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n760\t   105\t            await self.refresh_tools(service_ident)\n761\t   106\t\n762\t   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n763\t   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n764\t   109\t        tools = await self._list_tools(token)\n765\t   110\t        self._tools = {t[\"name\"]: t for t in tools}\n766\t   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n767\t   112\t\n768\t   113\t    def operations(self) -> list[str]:\n769\t   114\t        return sorted(self._tools)\n770\t   115\t\n771\t   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n772\t   117\t        if operation not in self._tools:\n773\t   118\t            raise UnknownErpOperation(operation)\n774\t   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n775\t   120\t        result = await self._rpc(\n776\t   121\t            \"tools/call\",\n777\t   122\t            {\n778\t   123\t                \"name\": operation,\n779\t   124\t                \"arguments\": arguments,\n780\t   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n781\t   126\t            },\n782\t   127\t            token,\n783\t   128\t        )\n784\t   129\t        if result.get(\"isError\"):\n785\t   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n786\t   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n787\t=== app/audit.py\n788\t     1\t\"\"\"Execution audit graph.\n789\t     2\t\n790\t     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n791\t     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n792\t     5\ttool call -> authorization decision -> result or error. Writes are\n793\t     6\tsynchronous and are made before the action they describe; if the write\n794\t     7\tfails, the caller raises and the action does not run.\n795\t     8\t\"\"\"\n796\t     9\tfrom __future__ import annotations\n797\t    10\t\n798\t    11\timport hashlib\n799\t    12\timport json\n800\t    13\timport uuid\n801\t    14\tfrom datetime import datetime, timezone\n802\t    15\tfrom typing import Any\n803\t    16\t\n804\t    17\tfrom opentelemetry import trace\n805\t    18\t\n806\t    19\tfrom app.context_size import ContextMeasure\n807\t    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n808\t    21\tfrom app.redact import redact_value\n809\t    22\t\n810\t    23\tEVENT_KINDS = {\n811\t    24\t    \"run_started\",\n812\t    25\t    \"run_finished\",\n813\t    26\t    \"run_halted\",\n814\t    27\t    \"model_decision\",\n815\t    28\t    \"tool_proposed\",\n816\t    29\t    \"authz_decision\",\n817\t    30\t    \"approval_requested\",\n818\t    31\t    \"approval_decided\",\n819\t    32\t    \"tool_result\",\n820\t    33\t    \"tool_error\",\n821\t    34\t    \"tool_denied\",\n822\t    35\t    \"budget_exceeded\",\n823\t    36\t    \"subagent_started\",\n824\t    37\t    \"subagent_finished\",\n825\t    38\t    \"background_job\",\n826\t    39\t}\n827\t    40\t\n828\t    41\t_INSERT = \"\"\"\n829\t    42\tINSERT INTO audit_events (\n830\t    43\t    node_id, parent_node_id, run_id, ts, kind,\n831\t    44\t    accountable_party, operational_owner, tenant,\n832\t    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n833\t    46\t    delegated_subject, agent_principal, parent_instance_id,\n834\t    47\t    policy_version, approval_id, operation_id,\n835\t    48\t    context_tokens, context_method, context_compacted,\n836\t    49\t    payload\n837\t    50\t) VALUES (\n838\t    51\t    $1, $2, $3, $4, $5,\n839\t    52\t    $6, $7, $8,\n840\t    53\t    $9, $10, $11, $12,\n841\t    54\t    $13, $14, $15,\n842\t    55\t    $16, $17, $18,\n843\t    56\t    $19, $20, $21,\n844\t    57\t    $22::jsonb\n845\t    58\t)\n846\t    59\t\"\"\"\n847\t    60\t\n848\t    61\t\n849\t    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n850\t    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n851\t    64\t    return {k: redact_value(v) for k, v in args.items()}\n852\t    65\t\n853\t    66\t\n854\t    67\tdef digest(value: Any) -> str:\n855\t    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n856\t    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n857\t    70\t\n858\t    71\t\n859\t    72\tasync def record(\n860\t    73\t    pool,\n861\t    74\t    ident: RunIdentity,\n862\t    75\t    *,\n863\t    76\t    kind: str,\n864\t    77\t    payload: dict[str, Any] | None = None,\n865\t    78\t    parent: str | None = None,\n866\t    79\t    context: ContextMeasure | None = None,\n867\t    80\t    policy_version: str | None = None,\n868\t    81\t    approval_id: str | None = None,\n869\t    82\t    operation_id: str | None = None,\n870\t    83\t) -> str:\n871\t    84\t    if kind not in EVENT_KINDS:\n872\t    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n873\t    86\t    for name in IDENTITY_FIELDS:\n874\t    87\t        if not getattr(ident, name):\n875\t    88\t            raise ValueError(f\"audit record missing {name}\")\n876\t    89\t    span_ctx = trace.get_current_span().get_span_context()\n877\t    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n878\t    91\t    node_id = f\"node-{uuid.uuid4()}\"\n879\t    92\t    measure = context or ContextMeasure.unavailable()\n880\t    93\t    await pool.execute(\n881\t    94\t        _INSERT,\n882\t    95\t        node_id,\n883\t    96\t        parent,\n884\t    97\t        ident.run_id,\n885\t    98\t        datetime.now(timezone.utc),\n886\t    99\t        kind,\n887\t   100\t        ident.accountable_party,\n888\t   101\t        ident.operational_owner,\n889\t   102\t        ident.tenant,\n890\t   103\t        ident.agent_type_id,\n891\t   104\t        ident.agent_instance_id,\n892\t   105\t        ident.trace_id,\n893\t   106\t        span_id,\n894\t   107\t        ident.delegated_subject,\n895\t   108\t        ident.agent_principal,\n896\t   109\t        ident.parent_instance_id,\n897\t   110\t        policy_version,\n898\t   111\t        approval_id,\n899\t   112\t        operation_id,\n900\t   113\t        measure.tokens,\n901\t   114\t        measure.method,\n902\t   115\t        measure.compacted,\n903\t   116\t        json.dumps(redact_value(payload or {}), default=str),\n904\t   117\t    )\n905\t   118\t    return node_id\n906\t=== app/gate.py\n907\t     1\t\"\"\"Policy gate for tool calls.\n908\t     2\t\n909\t     3\tRuns in the harness between the model's proposed call and the integration.\n910\t     4\tHigh-impact operations are denied unless a valid approval exists; when none\n911\t     5\texists an approval request is opened and the call returns as pending.\n912\t     6\t\"\"\"\n913\t     7\tfrom __future__ import annotations\n914\t     8\t\n915\t     9\tfrom dataclasses import dataclass\n916\t    10\tfrom typing import Any\n917\t    11\t\n918\t    12\tfrom app.approvals import ApprovalStore\n919\t    13\tfrom app.identity import RunIdentity\n920\t    14\t\n921\t    15\t\n922\t    16\t@dataclass(frozen=True)\n923\t    17\tclass Decision:\n924\t    18\t    allow: bool\n925\t    19\t    reason: str\n926\t    20\t    policy_version: str\n927\t    21\t    approval_id: str | None = None\n928\t    22\t    pending: bool = False\n929\t    23\t\n930\t    24\t\n931\t    25\tclass PolicyGate:\n932\t    26\t    def __init__(self, policy: dict, approvals: ApprovalStore):\n933\t    27\t        self.version: str = policy[\"version\"]\n934\t    28\t        self.high_impact: frozenset[str] = frozenset(policy[\"high_impact_tools\"])\n935\t    29\t        self.erp_read_prefixes: tuple[str, ...] = tuple(policy[\"erp\"][\"read_prefixes\"])\n936\t    30\t        self.approvals = approvals\n937\t    31\t\n938\t    32\t    async def authorize(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n939\t    33\t        if tool.name == \"erp_call\":\n940\t    34\t            operation = str(args.get(\"operation\", \"\"))\n941\t    35\t            if not operation.startswith(self.erp_read_prefixes):\n942\t    36\t                return Decision(False, f\"erp operation not permitted: {operation}\", self.version)\n943\t    37\t            return Decision(True, \"erp read operation\", self.version)\n944\t    38\t\n945\t    39\t        if tool.name == \"post_slack_message\":\n946\t    40\t            if args.get(\"external\", False):\n947\t    41\t                return await self._require_approval(ident, tool, args)\n948\t    42\t            return Decision(True, \"internal staff message\", self.version)\n949\t    43\t\n950\t    44\t        if tool.name in self.high_impact:\n951\t    45\t            return await self._require_approval(ident, tool, args)\n952\t    46\t\n953\t    47\t        return Decision(True, \"low-impact tool\", self.version)\n954\t    48\t\n955\t    49\t    async def _require_approval(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n956\t    50\t        target = tool.target_of(args)\n957\t    51\t        approval = await self.approvals.find_valid(ident, tool.name, target)\n958\t    52\t        if approval is not None:\n959\t    53\t            return Decision(True, \"approved\", self.version, approval_id=approval.id)\n960\t    54\t        approval_id = await self.approvals.request(ident, tool.name, target, args)\n961\t    55\t        return Decision(\n962\t    56\t            False,\n963\t    57\t            \"approval required; request opened\",\n964\t    58\t            self.version,\n965\t    59\t            approval_id=approval_id,\n966\t    60\t            pending=True,\n967\t    61\t        )\n968\t"}]},"parent_tool_use_id":null,"session_id":"52f59db0-ef9c-4a15-be29-686305a983b9","uuid":"7e3a1d8b-4ae1-468c-a4a8-1c6c6e056942","timestamp":"2026-10-20T11:42:16.038Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-1pogsbzp/52f59db0-ef9c-4a15-be29-686305a983b9/tool-results/b2q3l96xp.txt","content":"=== app/extractor.py\n     1\t\"\"\"Line-item extraction sub-agent.\n     2\t\n     3\tThe parent procurement agent delegates structured extraction to a smaller\n     4\tmodel. The child runs under its own instance id, links to its parent in the\n     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport json\n    10\timport logging\n    11\tfrom typing import Any\n    12\t\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom app import audit\n    16\tfrom app.budget import Budget\n    17\tfrom app.context_size import measure_context\n    18\tfrom app.identity import RunIdentity\n    19\tfrom app.redact import redact_for_model\n    20\tfrom app.tools import build_registry\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n    24\t\n    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n    26\tMAX_TURNS = 4\n    27\t\n    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n    29\t\n    30\t\n    31\tclass ExtractionFailed(Exception):\n    32\t    pass\n    33\t\n    34\t\n    35\tclass LineItemExtractor:\n    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n    37\t        self.client = client\n    38\t        self.settings = settings\n    39\t        self.deps = deps\n    40\t        self.system_prompt = system_prompt\n    41\t\n    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n    43\t        budget.check_subagent()\n    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n    47\t\n    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n    51\t            start_node = await audit.record(\n    52\t                self.deps.pool,\n    53\t                ident,\n    54\t                kind=\"subagent_started\",\n    55\t                payload={\n    56\t                    \"role\": EXTRACTOR_ROLE,\n    57\t                    \"doc_id\": doc_id,\n    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n    59\t                    \"tools\": registry.names(),\n    60\t                },\n    61\t            )\n    62\t\n    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n    64\t            for _turn in range(MAX_TURNS):\n    65\t                budget.check_step()\n    66\t                request = {\n    67\t                    \"model\": self.settings.extractor_model_id,\n    68\t                    \"system\": self.system_prompt,\n    69\t                    \"messages\": messages,\n    70\t                    \"tools\": registry.schemas(),\n    71\t                    \"max_tokens\": 4096,\n    72\t                }\n    73\t                ctx = await measure_context(self.client, request, compacted=False)\n    74\t                response = await self.client.messages.create(**request)\n    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n    76\t                await budget.flush(self.deps.pool)\n    77\t                ctx = ctx.finalize(response.usage)\n    78\t                decision = await audit.record(\n    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n    81\t                             \"stop_reason\": response.stop_reason},\n    82\t                )\n    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n    85\t                if not uses:\n    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n    87\t                    items = _parse_items(text)\n    88\t                    await audit.record(\n    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n    90\t                        payload={\"items\": len(items)},\n    91\t                    )\n    92\t                    return items\n    93\t                results = []\n    94\t                for use in uses:\n    95\t                    budget.check_tool_call()\n    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n    97\t                messages.append({\"role\": \"user\", \"content\": results})\n    98\t\n    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n   100\t\n   101\t\n   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n   103\t    try:\n   104\t        data = json.loads(text)\n   105\t    except json.JSONDecodeError as exc:\n   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n   107\t    if not isinstance(data, list) or len(data) > 500:\n   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n   109\t    items = []\n   110\t    for raw in data:\n   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n   114\t    return items\n=== app/tools/__init__.py\n     1\t\"\"\"Tool registry.\n     2\t\n     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n     5\tthat is not in the run's registry.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom functools import lru_cache\n    11\tfrom typing import Any, Awaitable, Callable\n    12\t\n    13\timport yaml\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\t\n    17\tDEFAULT_ROLE = \"procurement\"\n    18\t\n    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Tool:\n    24\t    name: str\n    25\t    description: str\n    26\t    input_schema: dict[str, Any]\n    27\t    invoke: Invoke\n    28\t    target_field: str | None = None\n    29\t\n    30\t    def target_of(self, args: dict[str, Any]) -> str:\n    31\t        if self.target_field is None:\n    32\t            return self.name\n    33\t        return str(args.get(self.target_field, \"\"))\n    34\t\n    35\t    def schema(self) -> dict[str, Any]:\n    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n    37\t\n    38\t\n    39\tclass ToolRegistry:\n    40\t    def __init__(self, tools: list[Tool]):\n    41\t        self._tools = {t.name: t for t in tools}\n    42\t\n    43\t    def get(self, name: str) -> Tool | None:\n    44\t        return self._tools.get(name)\n    45\t\n    46\t    def names(self) -> list[str]:\n    47\t        return sorted(self._tools)\n    48\t\n    49\t    def schemas(self) -> list[dict[str, Any]]:\n    50\t        return [self._tools[n].schema() for n in self.names()]\n    51\t\n    52\t\n    53\t@lru_cache(maxsize=1)\n    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        cfg = yaml.safe_load(fh)\n    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n    58\t\n    59\t\n    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n    61\t    from app.tools import documents, erp, memory, payments, slack\n    62\t\n    63\t    available: dict[str, Tool] = {}\n    64\t    for module in (documents, erp, memory, payments, slack):\n    65\t        for tool in module.tools(deps):\n    66\t            available[tool.name] = tool\n    67\t\n    68\t    roles = _role_tools(str(deps.settings.tools_path))\n    69\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n    70\t    return ToolRegistry([available[name] for name in allowed if name in available])\n=== app/tools/documents.py\n     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tUNTRUSTED_WRAPPER = (\n    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n    11\t    \"{text}\\n\"\n    12\t    \"</untrusted_document>\"\n    13\t)\n    14\t\n    15\t\n    16\tdef tools(deps) -> list[Tool]:\n    17\t    pool = deps.pool\n    18\t\n    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n    20\t        row = await pool.fetchrow(\n    21\t            \"\"\"\n    22\t            SELECT doc_id, source, media_type, text\n    23\t            FROM documents\n    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n    25\t            \"\"\",\n    26\t            args[\"doc_id\"],\n    27\t            ident.tenant,\n    28\t        )\n    29\t        if row is None:\n    30\t            return \"document not found\"\n    31\t        return UNTRUSTED_WRAPPER.format(\n    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n    33\t        )\n    34\t\n    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n    37\t\n    38\t    return [\n    39\t        Tool(\n    40\t            name=\"read_document\",\n    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n    42\t            input_schema={\n    43\t                \"type\": \"object\",\n    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    45\t                \"required\": [\"doc_id\"],\n    46\t                \"additionalProperties\": False,\n    47\t            },\n    48\t            invoke=read_document,\n    49\t        ),\n    50\t        Tool(\n    51\t            name=\"extract_line_items\",\n    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n    53\t            input_schema={\n    54\t                \"type\": \"object\",\n    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    56\t                \"required\": [\"doc_id\"],\n    57\t                \"additionalProperties\": False,\n    58\t            },\n    59\t            invoke=extract_line_items,\n    60\t        ),\n    61\t    ]\n=== app/tools/erp.py\n     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tERP_READ_SCOPE = \"erp.read\"\n    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n    11\t\n    12\t\n    13\tdef tools(deps) -> list[Tool]:\n    14\t    erp = deps.erp\n    15\t\n    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n    17\t        return await erp.call(\n    18\t            \"budget.get_remaining\",\n    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n    20\t            ident,\n    21\t            ERP_READ_SCOPE,\n    22\t        )\n    23\t\n    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n    25\t        arguments = dict(args.get(\"arguments\", {}))\n    26\t        arguments[\"business_unit\"] = ident.tenant\n    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n    28\t\n    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n    30\t        return await erp.call(\n    31\t            \"po.create\",\n    32\t            {\n    33\t                \"business_unit\": ident.tenant,\n    34\t                \"department\": args[\"department\"],\n    35\t                \"vendor_id\": args[\"vendor_id\"],\n    36\t                \"lines\": args[\"lines\"],\n    37\t                \"currency\": args[\"currency\"],\n    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n    39\t                \"client_reference\": args[\"source_doc_id\"],\n    40\t            },\n    41\t            ident,\n    42\t            ERP_PO_WRITE_SCOPE,\n    43\t        )\n    44\t\n    45\t    line_schema = {\n    46\t        \"type\": \"object\",\n    47\t        \"properties\": {\n    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n    52\t        },\n    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n    54\t        \"additionalProperties\": False,\n    55\t    }\n    56\t\n    57\t    return [\n    58\t        Tool(\n    59\t            name=\"get_budget\",\n    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n    61\t            input_schema={\n    62\t                \"type\": \"object\",\n    63\t                \"properties\": {\n    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n    66\t                },\n    67\t                \"required\": [\"department\", \"fiscal_period\"],\n    68\t                \"additionalProperties\": False,\n    69\t            },\n    70\t            invoke=get_budget,\n    71\t        ),\n    72\t        Tool(\n    73\t            name=\"erp_call\",\n    74\t            description=(\n    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n    77\t            ),\n    78\t            input_schema={\n    79\t                \"type\": \"object\",\n    80\t                \"properties\": {\n    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n    82\t                    \"arguments\": {\"type\": \"object\"},\n    83\t                },\n    84\t                \"required\": [\"operation\"],\n    85\t                \"additionalProperties\": False,\n    86\t            },\n    87\t            invoke=erp_call,\n    88\t        ),\n    89\t        Tool(\n    90\t            name=\"create_purchase_order\",\n    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n    92\t            input_schema={\n    93\t                \"type\": \"object\",\n    94\t                \"properties\": {\n    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n   100\t                },\n   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n   102\t                \"additionalProperties\": False,\n   103\t            },\n   104\t            invoke=create_purchase_order,\n   105\t            target_field=\"source_doc_id\",\n   106\t        ),\n   107\t    ]\n=== app/tools/memory.py\n     1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n     2\t\n     3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n     4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n     5\tuntil a procurement lead verifies them in the admin UI. Every row records\n     6\twho wrote it, from which run and source document, and the context size at\n     7\tthe time.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport re\n    12\timport uuid\n    13\tfrom typing import Any\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\tfrom app.tools import Tool\n    17\t\n    18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n    19\tMAX_NOTE_CHARS = 800\n    20\tINSTRUCTION_LIKE = [\n    21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n    22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n    23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n    24\t    re.compile(r\"https?://\"),\n    25\t]\n    26\t\n    27\t\n    28\tclass NoteRejected(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tdef check_note(text: str) -> None:\n    33\t    if len(text) > MAX_NOTE_CHARS:\n    34\t        raise NoteRejected(\"note too long\")\n    35\t    for pattern in INSTRUCTION_LIKE:\n    36\t        if pattern.search(text):\n    37\t            raise NoteRejected(\"note looks like an instruction\")\n    38\t\n    39\t\n    40\tdef tools(deps) -> list[Tool]:\n    41\t    pool = deps.pool\n    42\t\n    43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n    44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n    45\t        rows = await pool.fetch(\n    46\t            \"\"\"\n    47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n    48\t            FROM dept_notes\n    49\t            WHERE business_unit = $1\n    50\t              AND department = $2\n    51\t              AND NOT quarantined\n    52\t              AND (verified OR expires_at > now())\n    53\t            ORDER BY created_at DESC\n    54\t            LIMIT 20\n    55\t            \"\"\",\n    56\t            business_unit,\n    57\t            args[\"department\"],\n    58\t        )\n    59\t        return [\n    60\t            {\n    61\t                \"note_id\": r[\"note_id\"],\n    62\t                \"kind\": r[\"kind\"],\n    63\t                \"body\": r[\"body\"],\n    64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n    65\t                \"written\": r[\"created_at\"].isoformat(),\n    66\t            }\n    67\t            for r in rows\n    68\t        ]\n    69\t\n    70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n    71\t        if args[\"kind\"] not in NOTE_KINDS:\n    72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n    73\t        check_note(args[\"body\"])\n    74\t        note_id = f\"note-{uuid.uuid4()}\"\n    75\t        ctx = deps.current_context(ident)\n    76\t        await pool.execute(\n    77\t            \"\"\"\n    78\t            INSERT INTO dept_notes (\n    79\t                note_id, business_unit, department, kind, body,\n    80\t                verified, quarantined, expires_at,\n    81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n    82\t                delegated_subject, context_tokens, context_method, created_at\n    83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n    84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n    85\t            \"\"\",\n    86\t            note_id,\n    87\t            ident.tenant,\n    88\t            args[\"department\"],\n    89\t            args[\"kind\"],\n    90\t            args[\"body\"],\n    91\t            ident.agent_instance_id,\n    92\t            ident.agent_type_id,\n    93\t            ident.run_id,\n    94\t            args.get(\"source_doc_id\"),\n    95\t            ident.delegated_subject,\n    96\t            ctx.tokens,\n    97\t            ctx.method,\n    98\t        )\n    99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n   100\t\n   101\t    return [\n   102\t        Tool(\n   103\t            name=\"memory_read\",\n   104\t            description=(\n   105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n   106\t                \"shared-services staff may look up another unit's notes.\"\n   107\t            ),\n   108\t            input_schema={\n   109\t                \"type\": \"object\",\n   110\t                \"properties\": {\n   111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n   113\t                },\n   114\t                \"required\": [\"department\"],\n   115\t                \"additionalProperties\": False,\n   116\t            },\n   117\t            invoke=memory_read,\n   118\t        ),\n   119\t        Tool(\n   120\t            name=\"memory_write\",\n   121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n   122\t            input_schema={\n   123\t                \"type\": \"object\",\n   124\t                \"properties\": {\n   125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n   127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n   128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n   129\t                },\n   130\t                \"required\": [\"department\", \"kind\", \"body\"],\n   131\t                \"additionalProperties\": False,\n   132\t            },\n   133\t            invoke=memory_write,\n   134\t        ),\n   135\t    ]\n=== app/tools/payments.py\n     1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.tools import Tool\n    11\t\n    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n    13\tPAYMENTS_SCOPE = \"payments.create\"\n    14\t\n    15\t\n    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n    17\t    raw = \"|\".join(\n    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n    19\t    )\n    20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n    21\t\n    22\t\n    23\tdef tools(deps) -> list[Tool]:\n    24\t    settings = deps.settings\n    25\t\n    26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n    27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n    28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n    29\t            resp = await client.post(\n    30\t                f\"{settings.payments_api_url}/v2/payments\",\n    31\t                headers={\n    32\t                    \"Authorization\": f\"Bearer {token}\",\n    33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n    34\t                },\n    35\t                json={\n    36\t                    \"business_unit\": ident.tenant,\n    37\t                    \"invoice_reference\": args[\"invoice_id\"],\n    38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n    39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n    40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n    41\t                },\n    42\t            )\n    43\t        resp.raise_for_status()\n    44\t        body = resp.json()\n    45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n    46\t\n    47\t    return [\n    48\t        Tool(\n    49\t            name=\"pay_invoice\",\n    50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n    51\t            input_schema={\n    52\t                \"type\": \"object\",\n    53\t                \"properties\": {\n    54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n    55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n    56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n    57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n    59\t                },\n    60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n    61\t                \"additionalProperties\": False,\n    62\t            },\n    63\t            invoke=pay_invoice,\n    64\t            target_field=\"invoice_id\",\n    65\t        )\n    66\t    ]\n=== app/tools/slack.py\n     1\t\"\"\"Slack tool: message staff and vendors, plus the approvals notifier.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom datetime import datetime\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.redact import redact_text, strip_unapproved_links\n    11\tfrom app.tools import Tool\n    12\t\n    13\tMAX_TEXT = 3000\n    14\t\n    15\t\n    16\tdef clean_outbound(text: str) -> str:\n    17\t    return strip_unapproved_links(redact_text(text))[:MAX_TEXT]\n    18\t\n    19\t\n    20\tclass SlackClient:\n    21\t    def __init__(self, api_url: str, bot_token_provider):\n    22\t        self.api_url = api_url\n    23\t        self._token = bot_token_provider\n    24\t\n    25\t    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:\n    26\t        payload: dict[str, Any] = {\n    27\t            \"channel\": channel,\n    28\t            \"text\": clean_outbound(text),\n    29\t            \"unfurl_links\": False,\n    30\t            \"unfurl_media\": False,\n    31\t            \"mrkdwn\": True,\n    32\t        }\n    33\t        if blocks:\n    34\t            payload[\"blocks\"] = blocks\n    35\t        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:\n    36\t            resp = await client.post(\n    37\t                f\"{self.api_url}/chat.postMessage\",\n    38\t                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\n    39\t                json=payload,\n    40\t            )\n    41\t        resp.raise_for_status()\n    42\t        body = resp.json()\n    43\t        if not body.get(\"ok\"):\n    44\t            raise RuntimeError(f\"slack error: {body.get('error')}\")\n    45\t        return {\"channel\": body[\"channel\"], \"ts\": body[\"ts\"]}\n    46\t\n    47\t    async def post_approval_request(\n    48\t        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\n    49\t    ) -> None:\n    50\t        lines = \"\\n\".join(f\"• *{k}*: `{v}`\" for k, v in summary.items())\n    51\t        text = f\"Approval needed for `{tool}` on `{target}` (expires {expires_at:%Y-%m-%d %H:%M} UTC)\\n{lines}\"\n    52\t        await self.post(\n    53\t            channel=f\"#approvals-{tenant}\",\n    54\t            text=text,\n    55\t            blocks=[\n    56\t                {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": clean_outbound(text)}},\n    57\t                {\n    58\t                    \"type\": \"actions\",\n    59\t                    \"elements\": [\n    60\t                        {\"type\": \"button\", \"action_id\": \"approve\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Approve\"}, \"style\": \"primary\"},\n    61\t                        {\"type\": \"button\", \"action_id\": \"reject\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Reject\"}, \"style\": \"danger\"},\n    62\t                    ],\n    63\t                },\n    64\t            ],\n    65\t        )\n    66\t\n    67\t\n    68\tdef tools(deps) -> list[Tool]:\n    69\t    slack: SlackClient = deps.slack\n    70\t\n    71\t    async def post_slack_message(args: dict[str, Any], ident: RunIdentity) -> Any:\n    72\t        return await slack.post(channel=args[\"channel\"], text=args[\"text\"])\n    73\t\n    74\t    return [\n    75\t        Tool(\n    76\t            name=\"post_slack_message\",\n    77\t            description=(\n    78\t                \"Post a message in Slack. Use internal channels for staff. Vendor contacts are in \"\n    79\t                \"Slack Connect channels named #vendor-<vendor_id>; set external=true for those.\"\n    80\t            ),\n    81\t            input_schema={\n    82\t                \"type\": \"object\",\n    83\t                \"properties\": {\n    84\t                    \"channel\": {\"type\": \"string\", \"maxLength\": 80},\n    85\t                    \"text\": {\"type\": \"string\", \"maxLength\": MAX_TEXT},\n    86\t                    \"external\": {\"type\": \"boolean\", \"default\": False},\n    87\t                },\n    88\t                \"required\": [\"channel\", \"text\"],\n    89\t                \"additionalProperties\": False,\n    90\t            },\n    91\t            invoke=post_slack_message,\n    92\t            target_field=\"channel\",\n    93\t        )\n    94\t    ]\n=== app/mcp_client.py\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n=== app/audit.py\n     1\t\"\"\"Execution audit graph.\n     2\t\n     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n     5\ttool call -> authorization decision -> result or error. Writes are\n     6\tsynchronous and are made before the action they describe; if the write\n     7\tfails, the caller raises and the action does not run.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport hashlib\n    12\timport json\n    13\timport uuid\n    14\tfrom datetime import datetime, timezone\n    15\tfrom typing import Any\n    16\t\n    17\tfrom opentelemetry import trace\n    18\t\n    19\tfrom app.context_size import ContextMeasure\n    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n    21\tfrom app.redact import redact_value\n    22\t\n    23\tEVENT_KINDS = {\n    24\t    \"run_started\",\n    25\t    \"run_finished\",\n    26\t    \"run_halted\",\n    27\t    \"model_decision\",\n    28\t    \"tool_proposed\",\n    29\t    \"authz_decision\",\n    30\t    \"approval_requested\",\n    31\t    \"approval_decided\",\n    32\t    \"tool_result\",\n    33\t    \"tool_error\",\n    34\t    \"tool_denied\",\n    35\t    \"budget_exceeded\",\n    36\t    \"subagent_started\",\n    37\t    \"subagent_finished\",\n    38\t    \"background_job\",\n    39\t}\n    40\t\n    41\t_INSERT = \"\"\"\n    42\tINSERT INTO audit_events (\n    43\t    node_id, parent_node_id, run_id, ts, kind,\n    44\t    accountable_party, operational_owner, tenant,\n    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n    46\t    delegated_subject, agent_principal, parent_instance_id,\n    47\t    policy_version, approval_id, operation_id,\n    48\t    context_tokens, context_method, context_compacted,\n    49\t    payload\n    50\t) VALUES (\n    51\t    $1, $2, $3, $4, $5,\n    52\t    $6, $7, $8,\n    53\t    $9, $10, $11, $12,\n    54\t    $13, $14, $15,\n    55\t    $16, $17, $18,\n    56\t    $19, $20, $21,\n    57\t    $22::jsonb\n    58\t)\n    59\t\"\"\"\n    60\t\n    61\t\n    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n    64\t    return {k: redact_value(v) for k, v in args.items()}\n    65\t\n    66\t\n    67\tdef digest(value: Any) -> str:\n    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    70\t\n    71\t\n    72\tasync def record(\n    73\t    pool,\n    74\t    ident: RunIdentity,\n    75\t    *,\n    76\t    kind: str,\n    77\t    payload: dict[str, Any] | None = None,\n    78\t    parent: str | None = None,\n    79\t    context: ContextMeasure | None = None,\n    80\t    policy_version: str | None = None,\n    81\t    approval_id: str | None = None,\n    82\t    operation_id: str | None = None,\n    83\t) -> str:\n    84\t    if kind not in EVENT_KINDS:\n    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n    86\t    for name in IDENTITY_FIELDS:\n    87\t        if not getattr(ident, name):\n    88\t            raise ValueError(f\"audit record missing {name}\")\n    89\t    span_ctx = trace.get_current_span().get_span_context()\n    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n    91\t    node_id = f\"node-{uuid.uuid4()}\"\n    92\t    measure = context or ContextMeasure.unavailable()\n    93\t    await pool.execute(\n    94\t        _INSERT,\n    95\t        node_id,\n    96\t        parent,\n    97\t        ident.run_id,\n    98\t        datetime.now(timezone.utc),\n    99\t        kind,\n   100\t        ident.accountable_party,\n   101\t        ident.operational_owner,\n   102\t        ident.tenant,\n   103\t        ident.agent_type_id,\n   104\t        ident.agent_instance_id,\n   105\t        ident.trace_id,\n   106\t        span_id,\n   107\t        ident.delegated_subject,\n   108\t        ident.agent_principal,\n   109\t        ident.parent_instance_id,\n   110\t        policy_version,\n   111\t        approval_id,\n   112\t        operation_id,\n   113\t        measure.tokens,\n   114\t        measure.method,\n   115\t        measure.compacted,\n   116\t        json.dumps(redact_value(payload or {}), default=str),\n   117\t    )\n   118\t    return node_id\n=== app/gate.py\n     1\t\"\"\"Policy gate for tool calls.\n     2\t\n     3\tRuns in the harness between the model's proposed call and the integration.\n     4\tHigh-impact operations are denied unless a valid approval exists; when none\n     5\texists an approval request is opened and the call returns as pending.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom typing import Any\n    11\t\n    12\tfrom app.approvals import ApprovalStore\n    13\tfrom app.identity import RunIdentity\n    14\t\n    15\t\n    16\t@dataclass(frozen=True)\n    17\tclass Decision:\n    18\t    allow: bool\n    19\t    reason: str\n    20\t    policy_version: str\n    21\t    approval_id: str | None = None\n    22\t    pending: bool = False\n    23\t\n    24\t\n    25\tclass PolicyGate:\n    26\t    def __init__(self, policy: dict, approvals: ApprovalStore):\n    27\t        self.version: str = policy[\"version\"]\n    28\t        self.high_impact: frozenset[str] = frozenset(policy[\"high_impact_tools\"])\n    29\t        self.erp_read_prefixes: tuple[str, ...] = tuple(policy[\"erp\"][\"read_prefixes\"])\n    30\t        self.approvals = approvals\n    31\t\n    32\t    async def authorize(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n    33\t        if tool.name == \"erp_call\":\n    34\t            operation = str(args.get(\"operation\", \"\"))\n    35\t            if not operation.startswith(self.erp_read_prefixes):\n    36\t                return Decision(False, f\"erp operation not permitted: {operation}\", self.version)\n    37\t            return Decision(True, \"erp read operation\", self.version)\n    38\t\n    39\t        if tool.name == \"post_slack_message\":\n    40\t            if args.get(\"external\", False):\n    41\t                return await self._require_approval(ident, tool, args)\n    42\t            return Decision(True, \"internal staff message\", self.version)\n    43\t\n    44\t        if tool.name in self.high_impact:\n    45\t            return await self._require_approval(ident, tool, args)\n    46\t\n    47\t        return Decision(True, \"low-impact tool\", self.version)\n    48\t\n    49\t    async def _require_approval(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n    50\t        target = tool.target_of(args)\n    51\t        approval = await self.approvals.find_valid(ident, tool.name, target)\n    52\t        if approval is not None:\n    53\t            return Decision(True, \"approved\", self.version, approval_id=approval.id)\n    54\t        approval_id = await self.approvals.request(ident, tool.name, target, args)\n    55\t        return Decision(\n    56\t            False,\n    57\t            \"approval required; request opened\",\n    58\t            self.version,\n    59\t            approval_id=approval_id,\n    60\t            pending=True,\n    61\t        )\n","numLines":968,"startLine":1,"totalLines":968}},"tool_result_meta":[{"id":"toolu_019FGVEtHB31bsnV8VfTETE6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
