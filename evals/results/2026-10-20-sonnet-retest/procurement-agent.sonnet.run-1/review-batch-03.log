"id\": \"I65e59182e1\",\n      \"kind\": \"tool_call\",\n      \"evidence\": \"app/loop.py:173\",\n      \"quote\": \"results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\"\n    },\n    {\n      \"id\": \"I6e9f9a2638\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:176\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"Icbe3633cb6\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:55\",\n      \"quote\": \"proposed = await audit.record(\"\n    },\n    {\n      \"id\": \"I4db5797679\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:61\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"Ia389c28cba\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:68\",\n      \"quote\": \"authz = await audit.record(\"\n    },\n    {\n      \"id\": \"I8165b2309f\",\n      \"kind\": \"tool_call\",\n      \"evidence\": \"app/loop.py:83\",\n      \"quote\": \"output = await tool.invoke(use.input, ident)\"\n    },\n    {\n      \"id\": \"I588419ff8b\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:87\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"I12a6ffed84\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:95\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"Iffaa43b340\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/main.py:76\",\n      \"quote\": \"await audit.record(app.state.pool, ident, kind=\\\"background_job\\\",\"\n    }\n  ],\n  \"skipped\": [],\n  \"limitations\": \"Candidate inventory only: manually trace aliases, wrappers, computed calls and unsupported languages. Tests excluded; no code executed.\"\n}\n# syntax=docker/dockerfile:1.10\nFROM python:3.11.10-slim-bookworm@sha256:2a6386ad2db20e7f55073f69a98d6da2cf9f168e05e7487d2670c22e4ad2a1bd AS build\nWORKDIR /src\nENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\nCOPY pyproject.toml ./\nCOPY app ./app\nRUN pip install --target /opt/site .\nRUN python -m compileall -q app\n\nFROM gcr.io/distroless/python3-debian12:nonroot@sha256:8f3c1a6e2b9d4f7a0c5e8b1d3f6a9c2e5b8d1f4a7c0e3b6d9f2a5c8e1b4d7f0a\nWORKDIR /app\nENV PYTHONPATH=/opt/site:/app \\\n    PYTHONDONTWRITEBYTECODE=1 \\\n    APP_ROOT=/app\nCOPY --from=build /opt/site /opt/site\nCOPY --from=build /src/app /app/app\nCOPY prompts /app/prompts\nCOPY config /app/config\nCOPY release/manifest.yaml /app/release/manifest.yaml\nUSER 65532:65532\nEXPOSE 8080\nENTRYPOINT [\"python\", \"-m\", \"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\", \"--no-server-header\"]\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: procurement-agent\n  namespace: procurement-prod\n  labels:\n    app: procurement-agent\n    owner: team-procurement-platform\nspec:\n  replicas: 3\n  selector:\n    matchLabels:\n      app: procurement-agent\n  template:\n    metadata:\n      labels:\n        app: procurement-agent\n    spec:\n      serviceAccountName: procurement-agent\n      automountServiceAccountToken: false\n      hostUsers: false\n      enableServiceLinks: false\n      securityContext:\n        runAsNonRoot: true\n        runAsUser: 65532\n        runAsGroup: 65532\n        fsGroup: 65532\n        seccompProfile:\n          type: RuntimeDefault\n      containers:\n        - name: agent\n          image: registry.example-corp.test/procurement/agent@sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\n          imagePullPolicy: IfNotPresent\n          ports:\n            - containerPort: 8080\n              name: http\n          env:\n            - name: IMAGE_DIGEST\n              value: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n            - name: MODEL_ID\n              value: \"claude-sonnet-4-5-20250929\"\n            - name: EXTRACTOR_MODEL_ID\n              value: \"claude-haiku-4-5