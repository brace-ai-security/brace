next \"Key the registry and approvals by verified endpoint/registry namespace plus tool name, raise a conflict on duplicate or confusable names, and apply pin checks on refresh.\" --violates \"Flag lookalike and duplicate names across servers\"\na check E06.1 --met unknown --note \"Only MCP path is ErpMcpClient (mcp_client.py:72-85) to the in-cluster gateway URL; no code-mode or local-process tool exists. But networkpolicy.yaml:58-63 allows the whole erp-mcp-gateway namespace (no podSelector), and gateway enforcement and backend isolation are outside this repo.\"\na check E06.2 --met no --evidence app/identity.py:95 --quote 'key = (audience, scope, ident.tenant)' --note \"Backend token cache is keyed by audience/scope/tenant only, so a token minted for one delegated subject's run is reused for other users' runs in the tenant. The delegated subject is sent as a bare unverified string actor_token (identity.py:109). Gateway-side audience/issuer validation is outside this repo.\"\na check E06.3 --met no --evidence app/gate.py:35 --quote 'if not operation.startswith(self.erp_read_prefixes):' --note \"erp_call authorizes by string prefix of the operation name. Prefixes 'vendor.' and 'invoice.' (policy.yaml:12-14) admit vendor.update_remit_to, invoice.mark_paid and invoice.void, which operation_scopes treat as write operations (policy.yaml:22-26), with no approval. Arguments are an unvalidated object schema. Per-operation resource authorization relies on the ERP.\"\na flag E06 --evidence app/gate.py:35 --note \"Prefix match lets erp_call reach write operations (vendor.update_remit_to, invoice.mark_paid, invoice.void) as 'read' ops without approval\"\na check E06.4 --met unknown --note \"Gate/approval DB errors propagate out of execute_tool (loop.py:67) and stop the call; scan_metadata raises at startup. No fail-open branch found in the call path (loop.py:84-93 wraps only tool.invoke). Gateway token/policy check outage handling is outside this repo. Note startup.py:41-43 logs a manifest mismatch and continues.\"\na check E06.5 --met no --evidence app/identity.py:95 --quote 'key = (audience, scope, ident.tenant)' --note \"Client sends Mcp-Protocol-Version 2025-06-18 (mcp_client.py:77), so 2026-07-28 header rules are not exercised. The private token cache is not isolated by verified subject/authorization context or policy version, only tenant.\"\na check E06.6 --met unknown --note \"No OAuth discovery or metadata URL fetching in the repo; STS_URL is fixed config (settings.py). Whether the gateway is itself an OAuth client is outside this repo.\"\na check E06.7 --met unknown --note \"No tasks/apps/extension calls in mcp_client.py (only tools/list and tools/call), but the manifest records no protocol or extension versions (release/manifest.yaml mcp_servers) and host behaviour is not visible.\"\na item E06 --rating gap --confidence medium --summary \"The generic erp_call path authorizes by operation-name prefix, and the token cache ignores the delegated subject.\" --next \"Authorize erp operations by exact allowlist with argument checks, key token caches by delegated subject and policy version, and send a per-subject verified actor token.\" --violates \"authorize each action's tool, operation, resource, tenant, and arguments\" --also-affects E08"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6557,"cache_read_input_tokens":73195,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6557},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"440aace4-3591-46d8-9721-cf8df38e93d3","uuid":"a3c9c17b-bb6a-4057-a307-ec90e51b608c","timestamp":"2026-10-20T12:10:38.758Z","request_id":"req_011CgDTx8WPsUe82MgryZSNh","wire_tool_inputs":{"toolu_01KgRUV8LGHHgZLcKY3s88dZ":{"