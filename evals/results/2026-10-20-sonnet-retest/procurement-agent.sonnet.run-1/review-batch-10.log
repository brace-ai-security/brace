t:\n            secretName: procurement-mail-gateway-hmac\n        - name: tmp\n          emptyDir:\n            medium: Memory\n            sizeLimit: 64Mi\n\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom dataclasses import dataclass\nfrom functools import lru_cache\nfrom pathlib import Path\n\nimport yaml\n\n\ndef _env(name: str, default: str | None = None) -> str:\n    value = os.environ.get(name, default)\n    if value is None:\n        raise RuntimeError(f\"missing required setting {name}\")\n    return value\n\n\n@dataclass(frozen=True)\nclass Settings:\n    database_url: str\n    erp_mcp_url: str\n    payments_api_url: str\n    slack_api_url: str\n    sts_url: str\n    oidc_issuer: str\n    oidc_audience: str\n    oidc_jwks_url: str\n    workload_token_path: str\n    slack_signing_secret_path: str\n    mail_gateway_hmac_path: str\n    model_id: str\n    extractor_model_id: str\n    manifest_path: Path\n    prompt_dir: Path\n    policy_path: Path\n    tools_path: Path\n    operational_owner: str\n    image_digest: str\n\n    @property\n    def policy(self) -> dict:\n        return _load_yaml(self.policy_path)\n\n    @property\n    def manifest(self) -> dict:\n        return _load_yaml(self.manifest_path)\n\n    @property\n    def budgets(self) -> dict:\n        return self.policy[\"budgets\"]\n\n\ndef _load_yaml(path: Path) -> dict:\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\n        return yaml.safe_load(fh)\n\n\n@lru_cache(maxsize=1)\ndef get_settings() -> Settings:\n    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    return Settings(\n        database_url=_env(\"DATABASE_URL\"),\n        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n        sts_url=_env(\"STS_URL\"),\n        oidc_issuer=_env(\"OIDC_ISSUER\"),\n        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n        workload_token_path=_env(\n            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n        ),\n        slack_signing_secret_path=_env(\n            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n        ),\n        mail_gateway_hmac_path=_env(\n            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n        ),\n        model_id=_env(\"MODEL_ID\"),\n        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n        manifest_path=root / \"release\" / \"manifest.yaml\",\n        prompt_dir=root / \"prompts\",\n        policy_path=root / \"config\" / \"policy.yaml\",\n        tools_path=root / \"config\" / \"tools.yaml\",\n        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n        image_digest=_env(\"IMAGE_DIGEST\"),\n    )\n# syntax=docker/dockerfile:1.10\nFROM python:3.11.10-slim-bookworm@sha256:2a6386ad2db20e7f55073f69a98d6da2cf9f168e05e7487d2670c22e4ad2a1bd AS build\nWORKDIR /src\nENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\nCOPY pyproject.toml ./\nCOPY app ./app\nRUN pip install --target /opt/site .\nRUN python -m compileall -q app\n\nFROM gcr.io/distroless/python3-debian12:nonroot@sha256:8f3c1a6e2b9d4f7a0c5e8b1d3f6a9c2e5b8d1f4a7c0e3b6d9f2a5c8e1b4d7f0a\nWORKDIR /app\nENV PYTHONPATH=/opt/site:/app \\\n    PYTHONDONTWRITEBYTECODE=1 \\\n    APP_ROOT=/app\nCOPY --from=build /opt/site /opt/site\nCOPY --from=build /src/app /app/app\nCOPY prompts /app/prompts\nCOPY config /app/config\nCOPY release/manifest.yaml /app/release/manifest.yaml\nUSER 65532:65532\nEXPOSE 8080\nENTRYPOINT [\"python\", \"-m\", \"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\", \"--no-server-header\"]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01ExppnNAQcAYxLbDZwKegsU","permission_decision":{"decisi