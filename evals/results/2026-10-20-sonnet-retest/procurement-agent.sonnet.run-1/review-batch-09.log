{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015Eng5UHPoZa45TDCEkAQRw","type":"tool_result","content":"     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    16\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    17\t        with:\n    18\t          python-version: \"3.11\"\n    19\t      - run: pip install -e '.[test]'\n    20\t      - run: pytest -q\n    21\t      - name: Secret scan\n    22\t        uses: gitleaks/gitleaks-action@83373cf2f8c4db6e24b41c1a9b086bb9619e9cd3 # v2.3.7\n    23\t      - name: Manifest hashes match files\n    24\t        run: |\n    25\t          python - <<'PY'\n    26\t          import hashlib, yaml, sys\n    27\t          m = yaml.safe_load(open(\"release/manifest.yaml\"))\n    28\t          bad = []\n    29\t          for group in (\"prompts\", \"config\"):\n    30\t              for name, e in m[group].items():\n    31\t                  if isinstance(e, dict) and \"sha256\" in e:\n    32\t                      got = \"sha256:\" + hashlib.sha256(open(e[\"path\"], \"rb\").read()).hexdigest()\n    33\t                      if got != e[\"sha256\"]:\n    34\t                          bad.append(e[\"path\"])\n    35\t          if bad:\n    36\t              sys.exit(\"manifest out of date: \" + \", \".join(bad))\n    37\t          PY\n    38\t\n    39\t  release:\n    40\t    if: github.ref == 'refs/heads/main'\n    41\t    needs: test\n    42\t    runs-on: ubuntu-24.04\n    43\t    permissions:\n    44\t      contents: read\n    45\t      id-token: write\n    46\t      packages: write\n    47\t      attestations: write\n    48\t    steps:\n    49\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    50\t      - uses: sigstore/cosign-installer@dc72c7d5c4d10cd6bcb8cf6e3fd625a9e5e537da # v3.7.0\n    51\t        with:\n    52\t          cosign-release: \"v2.6.2\"\n    53\t      - uses: docker/setup-buildx-action@c47758b77c9736f4b2ef4073d4d51994fabfe349 # v3.7.1\n    54\t      - uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0\n    55\t        with:\n    56\t          registry: registry.example-corp.test\n    57\t          username: ${{ github.actor }}\n    58\t          password: ${{ secrets.GITHUB_TOKEN }}\n    59\t      - id: build\n    60\t        uses: docker/build-push-action@4f58ea79222b3b9dc2c8bbdd6debcef730109a75 # v6.9.0\n    61\t        with:\n    62\t          context: .\n    63\t          push: true\n    64\t          tags: registry.example-corp.test/procurement/agent:${{ github.sha }}\n    65\t          provenance: false\n    66\t          sbom: false\n    67\t      - name: SBOM\n    68\t        uses: anchore/sbom-action@251a468eed47e5082b105c3ba6ee500c0e65a764 # v0.17.6\n    69\t        with:\n    70\t          image: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    71\t          format: cyclonedx-json\n    72\t          output-file: sbom.cdx.json\n    73\t      - name: Sign and attest\n    74\t        env:\n    75\t          IMAGE: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    76\t        run: |\n    77\t          cosign sign --yes \"$IMAGE\"\n    78\t          cosign attest --yes --type cyclonedx --predicate sbom.cdx.json \"$IMAGE\"\n    79\t      - uses: actions/attest-build-provenance@1c608d11d69870c2092266b3f9a6f3abbf17002c # v1.4.3\n    80\t        with:\n    81\t          subject-name: registry.example-corp.test/procurement/agent\n    82\t          subject-digest: ${{ steps.build.outputs.digest }}\n    83\t          push-to-registry: true\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.11.10-slim-bookworm@sha256:2a6386ad2db20e7f55073f69a98d6da2cf9f168e05e7487d2670c22e4ad2a1bd AS build\n     3\tWORKDIR /src\n     4\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     5\tCOPY pyproject.toml ./\n     6\tCOPY app ./app\n     7\tRUN pip install --target /opt/site .\n     8\tRUN python -m compileall -q app\n     9\t\n    10\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:8f3c1a6e2b9d4f7a0c5e8b1d3f6a9c2e5b8d1f4a7c0e3b6d9f2a5c8e1b4d7f0a\n    11\tWORKDIR /app\n    12\tENV PYTHONPATH=/opt/site:/app \\\n    13\t    PYTHONDONTWRITEBYTECODE=1 \\\n    14\t    APP_ROOT=/app\n    15\tCOPY --from=build /opt/site /opt/site\n    16\tCOPY --from=build /src/app /app/app\n    17\tCOPY prompts /app/prompts\n    18\tCOPY config /app/config\n    19\tCOPY release/manifest.yaml /app/release/manifest.yaml\n    20\tUSER 65532:65532\n    21\tEXPOSE 8080\n    22\tENTRYPOINT [\"python\", \"-m\", \"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\", \"--no-server-header\"]\n     1\t[project]\n     2\tname = \"procurement-agent\"\n     3\tversion = \"2026.9.4\"\n     4\tdescription = \"Procurement agent: quotes, purchase orders, invoice payment.\"\n     5\trequires-python = \">=3.11\"\n     6\tdependencies = [\n     7\t  \"fastapi==0.115.6\",\n     8\t  \"uvicorn==0.32.1\",\n     9\t  \"asyncpg==0.30.0\",\n    10\t  \"httpx==0.28.1\",\n    11\t  \"pydantic==2.10.4\",\n    12\t  \"pyyaml==6.0.2\",\n    13\t  \"pyjwt[crypto]==2.10.1\",\n    14\t  \"pypdf==5.1.0\",\n    15\t  \"anthropic==0.75.0\",\n    16\t  \"opentelemetry-sdk==1.29.0\",\n    17\t  \"opentelemetry-exporter-otlp==1.29.0\",\n    18\t]\n    19\t\n    20\t[project.optional-dependencies]\n    21\ttest = [\"pytest==8.3.4\", \"pytest-asyncio==0.25.0\"]\n    22\t\n    23\t[tool.pytest.ini_options]\n    24\tasyncio_mode = \"auto\"\n    25\ttestpaths = [\"tests\"]\n     1\t-- Procurement agent schema. Applied by the migration job with the\n     2\t-- procurement_owner role; the running agent connects as procurement_agent.\n     3\t\n     4\tCREATE TABLE audit_events (\n     5\t    node_id             text PRIMARY KEY,\n     6\t    parent_node_id      text REFERENCES audit_events (node_id),\n     7\t    run_id              text NOT NULL,\n     8\t    ts                  timestamptz NOT NULL,\n     9\t    kind                text NOT NULL,\n    10\t    accountable_party   text NOT NULL CHECK (accountable_party <> ''),\n    11\t    operational_owner   text NOT NULL CHECK (operational_owner <> ''),\n    12\t    tenant              text NOT NULL CHECK (tenant <> ''),\n    13\t    agent_type_id       text NOT NULL CHECK (agent_type_id <> ''),\n    14\t    agent_instance_id   text NOT NULL CHECK (agent_instance_id <> ''),\n    15\t    trace_id            text NOT NULL CHECK (trace_id <> ''),\n    16\t    span_id             text,\n    17\t    delegated_subject   text NOT NULL,\n    18\t    agent_principal     text NOT NULL,\n    19\t    parent_instance_id  text,\n    20\t    policy_version      text,\n    21\t    approval_id         text,\n    22\t    operation_id        text,\n    23\t    context_tokens      integer CHECK (context_tokens IS NULL OR context_tokens > 0),\n    24\t    context_method      text NOT NULL,\n    25\t    context_compacted   boolean NOT NULL,\n    26\t    payload             jsonb NOT NULL\n    27\t);\n    28\tCREATE INDEX audit_events_run ON audit_events (run_id, ts);\n    29\tCREATE INDEX audit_events_instance ON audit_events (agent_instance_id, ts);\n    30\tCREATE INDEX audit_events_trace ON audit_events (trace_id);\n    31\t\n    32\tCREATE TABLE approvals (\n    33\t    id                     text PRIMARY KEY,\n    34\t    tool                   text NOT NULL,\n    35\t    target                 text NOT NULL,\n    36\t    args_sha256            text NOT NULL,\n    37\t    args_summary           jsonb NOT NULL,\n    38\t    tenant                 text NOT NULL,\n    39\t    requested_by_instance  text NOT NULL,\n    40\t    requested_by_run       text NOT NULL,\n    41\t    delegated_subject      text NOT NULL,\n    42\t    status                 text NOT NULL CHECK (status IN ('pending', 'approved', 'rejected', 'expired')),\n    43\t    requested_at           timestamptz NOT NULL,\n    44\t    expires_at             timestamptz NOT NULL,\n    45\t    approver               text,\n    46\t    approver_role          text,\n    47\t    decided_at             timestamptz\n    48\t);\n    49\tCREATE INDEX approvals_lookup ON approvals (tool, target, tenant, status);\n    50\t\n    51\tCREATE TABLE approvers (\n    52\t    slack_user_id  text PRIMARY KEY,\n    53\t    email          text NOT NULL,\n    54\t    role           text NOT NULL,\n    55\t    business_unit  text NOT NULL,\n    56\t    active         boolean NOT NULL DEFAULT true\n    57\t);\n    58\t\n    59\tCREATE TABLE documents (\n    60\t    doc_id         text PRIMARY KEY,\n    61\t    business_unit  text NOT NULL,\n    62\t    source         text NOT NULL,\n    63\t    media_type     text NOT NULL,\n    64\t    sha256         text NOT NULL,\n    65\t    status         text NOT NULL CHECK (status IN ('accepted', 'quarantined')),\n    66\t    reject_reason  text,\n    67\t    text           text,\n    68\t    received_at    timestamptz NOT NULL\n    69\t);\n    70\tCREATE INDEX documents_bu ON documents (business_unit, doc_id);\n    71\t\n    72\tCREATE TABLE dept_notes (\n    73\t    note_id            text PRIMARY KEY,\n    74\t    business_unit      text NOT NULL,\n    75\t    department         text NOT NULL,\n    76\t    kind               text NOT NULL,\n    77\t    body               text NOT NULL,\n    78\t    verified           boolean NOT NULL DEFAULT false,\n    79\t    verified_by        text,\n    80\t    quarantined        boolean NOT NULL DEFAULT false,\n    81\t    expires_at         timestamptz,\n    82\t    writer_instance    text NOT NULL,\n    83\t    writer_type_id     text NOT NULL,\n    84\t    run_id             text NOT NULL,\n    85\t    source_doc_id      text,\n    86\t    delegated_subject  text NOT NULL,\n    87\t    context_tokens     integer,\n    88\t    context_method     text NOT NULL,\n    89\t    created_at         timestamptz NOT NULL\n    90\t);\n    91\tCREATE INDEX dept_notes_lookup ON dept_notes (business_unit, department, created_at DESC);\n    92\tCREATE INDEX dept_notes_source ON dept_notes (source_doc_id);\n    93\tCREATE INDEX dept_notes_writer ON dept_notes (writer_instance);\n    94\t\n    95\tCREATE TABLE control_flags (\n    96\t    scope    text PRIMARY KEY,           -- 'fleet' or 'tenant:<business_unit>'\n    97\t    halted   boolean NOT NULL,\n    98\t    reason   text NOT NULL,\n    99\t    set_by   text NOT NULL,\n   100\t    set_at   timestamptz NOT NULL DEFAULT now()\n   101\t);\n   102\t\n   103\tCREATE TABLE spend_quota (\n   104\t    scope      text NOT NULL,\n   105\t    key        text NOT NULL,\n   106\t    day        date NOT NULL,\n   107\t    spent_usd  numeric(12, 4) NOT NULL,\n   108\t    PRIMARY KEY (scope, key, day)\n   109\t);\n   110\t\n   111\tCREATE TABLE run_start_window (\n   112\t    scope   text NOT NULL,\n   113\t    key     text NOT NULL,\n   114\t    minute  timestamptz NOT NULL,\n   115\t    starts  integer NOT NULL,\n   116\t    PRIMARY KEY (scope, key, minute)\n   117\t);\n   118\t\n   119\t-- Runtime role: append-only audit, no access to control flags beyond reading.\n   120\tREVOKE ALL ON ALL TABLES IN SCHEMA public FROM procurement_agent;\n   121\tGRANT SELECT, INSERT ON audit_events TO procurement_agent;\n   122\tGRANT SELECT, INSERT, UPDATE ON approvals TO procurement_agent;\n   123\tGRANT SELECT ON approvers TO procurement_agent;\n   124\tGRANT SELECT, INSERT ON documents TO procurement_agent;\n   125\tGRANT SELECT, INSERT ON dept_notes TO procurement_agent;\n   126\tGRANT SELECT ON control_flags TO procurement_agent;\n   127\tGRANT SELECT, INSERT, UPDATE ON spend_quota TO procurement_agent;\n   128\tGRANT SELECT, INSERT, UPDATE ON run_start_window TO procurement_agent;\n   129\t\n   130\t-- Operators: halt and resume.\n   131\tGRANT SELECT, INSERT, UPDATE ON control_flags TO procurement_ops;\n   132\tGRANT SELECT ON audit_events TO procurement_ops;\n   133\tGRANT SELECT, UPDATE (verified, verified_by, quarantined) ON dept_notes TO procurement_ops;\n     1\tapiVersion: kyverno.io/v1\n     2\tkind: ClusterPolicy\n     3\tmetadata:\n     4\t  name: procurement-verify-images\n     5\t  annotations:\n     6\t    policies.kyverno.io/title: Verify procurement agent images\n     7\t    kyverno.io/kyverno-version: \"1.15.2\"\n     8\tspec:\n     9\t  validationFailureAction: Enforce\n    10\t  background: false\n    11\t  webhookTimeoutSeconds: 15\n    12\t  failurePolicy: Fail\n    13\t  rules:\n    14\t    - name: only-approved-registry\n    15\t      match:\n    16\t        any:\n    17\t          - resources:\n    18\t              kinds: [Pod]\n    19\t              namespaces: [procurement-prod]\n    20\t      validate:\n    21\t        message: \"Images in procurement-prod must come from registry.example-corp.test/procurement and be pinned by digest.\"\n    22\t        pattern:\n    23\t          spec:\n    24\t            =(initContainers):\n    25\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n    26\t            containers:\n    27\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n    28\t    - name: verify-signature-and-provenance\n    29\t      match:\n    30\t        any:\n    31\t          - resources:\n    32\t              kinds: [Pod]\n    33\t              namespaces: [procurement-prod]\n    34\t      verifyImages:\n    35\t        - imageReferences:\n    36\t            - \"registry.example-corp.test/procurement/*\"\n    37\t          mutateDigest: false\n    38\t          verifyDigest: true\n    39\t          required: true\n    40\t          attestors:\n    41\t            - entries:\n    42\t                - keyless:\n    43\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    44\t                    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    45\t                    rekor:\n    46\t                      url: https://rekor.sigstore.dev\n    47\t          attestations:\n    48\t            - type: https://slsa.dev/provenance/v1\n    49\t              attestors:\n    50\t                - entries:\n    51\t                    - keyless:\n    52\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    53\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    54\t              conditions:\n    55\t                - all:\n    56\t                    - key: \"{{ buildDefinition.buildType }}\"\n    57\t                      operator: Equals\n    58\t                      value: \"https://actions.github.io/buildtypes/workflow/v1\"\n    59\t                    - key: \"{{ buildDefinition.externalParameters.workflow.repository }}\"\n    60\t                      operator: Equals\n    61\t                      value: \"https://github.com/example-corp/procurement-agent\"\n    62\t                    - key: \"{{ buildDefinition.externalParameters.workflow.ref }}\"\n    63\t                      operator: Equals\n    64\t                      value: \"refs/heads/main\"\n    65\t                    - key: \"{{ buildDefinition.externalParameters.workflow.path }}\"\n    66\t                      operator: Equals\n    67\t                      value: \".github/workflows/ci.yaml\"\n    68\t                    - key: \"{{ runDetails.builder.id }}\"\n    69\t                      operator: Equals\n    70\t                      value: \"https://github.com/actions/runner/github-hosted\"\n    71\t            - type: https://cyclonedx.org/bom\n    72\t              attestors:\n    73\t                - entries:\n    74\t                    - keyless:\n    75\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    76\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tERP_READ_SCOPE = \"erp.read\"\n    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n    11\t\n    12\t\n    13\tdef tools(deps) -> list[Tool]:\n    14\t    erp = deps.erp\n    15\t\n    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n    17\t        return await erp.call(\n    18\t            \"budget.get_remaining\",\n    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n    20\t            ident,\n    21\t            ERP_READ_SCOPE,\n    22\t        )\n    23\t\n    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n    25\t        arguments = dict(args.get(\"arguments\", {}))\n    26\t        arguments[\"business_unit\"] = ident.tenant\n    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n    28\t\n    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n    30\t        return await erp.call(\n    31\t            \"po.create\",\n    32\t            {\n    33\t                \"business_unit\": ident.tenant,\n    34\t                \"department\": args[\"department\"],\n    35\t                \"vendor_id\": args[\"vendor_id\"],\n    36\t                \"lines\": args[\"lines\"],\n    37\t                \"currency\": args[\"currency\"],\n    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n    39\t                \"client_reference\": args[\"source_doc_id\"],\n    40\t            },\n    41\t            ident,\n    42\t            ERP_PO_WRITE_SCOPE,\n    43\t        )\n    44\t\n    45\t    line_schema = {\n    46\t        \"type\": \"object\",\n    47\t        \"properties\": {\n    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n    52\t        },\n    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n    54\t        \"additionalProperties\": False,\n    55\t    }\n    56\t\n    57\t    return [\n    58\t        Tool(\n    59\t            name=\"get_budget\",\n    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n    61\t            input_schema={\n    62\t                \"type\": \"object\",\n    63\t                \"properties\": {\n    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n    66\t                },\n    67\t                \"required\": [\"department\", \"fiscal_period\"],\n    68\t                \"additionalProperties\": False,\n    69\t            },\n    70\t            invoke=get_budget,\n    71\t        ),\n    72\t        Tool(\n    73\t            name=\"erp_call\",\n    74\t            description=(\n    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n    77\t            ),\n    78\t            input_schema={\n    79\t                \"type\": \"object\",\n    80\t                \"properties\": {\n    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n    82\t                    \"arguments\": {\"type\": \"object\"},\n    83\t                },\n    84\t                \"required\": [\"operation\"],\n    85\t                \"additionalProperties\": False,\n    86\t            },\n    87\t            invoke=erp_call,\n    88\t        ),\n    89\t        Tool(\n    90\t            name=\"create_purchase_order\",\n    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n    92\t            input_schema={\n    93\t                \"type\": \"object\",\n    94\t                \"properties\": {\n    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n   100\t                },\n   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n   102\t                \"additionalProperties\": False,\n   103\t            },\n   104\t            invoke=create_purchase_order,\n   105\t            target_field=\"source_doc_id\",\n   106\t        ),\n   107\t    ]\n     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t\n    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )","is_error":false}]},"parent_tool_use_id":null,"session_id":"5372d401-ba62-4ea7-9e5e-2be571c7ee7d","uuid":"17f4d1a9-b408-4efc-a504-1347a46338a7","timestamp":"2026-10-20T12:05:25.364Z","tool_use_result":{"stdout":"     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    16\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    17\t        with:\n    18\t          python-version: \"3.11\"\n    19\t      - run: pip install -e '.[test]'\n    20\t      - run: pytest -q\n    21\t      - name: Secret scan\n    22\t        uses: gitleaks/gitleaks-action@83373cf2f8c4db6e24b41c1a9b086bb9619e9cd3 # v2.3.7\n    23\t      - name: Manifest hashes match files\n    24\t        run: |\n    25\t          python - <<'PY'\n    26\t          import hashlib, yaml, sys\n    27\t          m = yaml.safe_load(open(\"release/manifest.yaml\"))\n    28\t          bad = []\n    29\t          for group in (\"prompts\", \"config\"):\n    30\t              for name, e in m[group].items():\n    31\t                  if isinstance(e, dict) and \"sha256\" in e:\n    32\t                      got = \"sha256:\" + hashlib.sha256(open(e[\"path\"], \"rb\").read()).hexdigest()\n    33\t                      if got != e[\"sha256\"]:\n    34\t                          bad.append(e[\"path\"])\n    35\t          if bad:\n    36\t              sys.exit(\"manifest out of date: \" + \", \".join(bad))\n    37\t          PY\n    38\t\n    39\t  release:\n    40\t    if: github.ref == 'refs/heads/main'\n    41\t    needs: test\n    42\t    runs-on: ubuntu-24.04\n    43\t    permissions:\n    44\t      contents: read\n    45\t      id-token: write\n    46\t      packages: write\n    47\t      attestations: write\n    48\t    steps:\n    49\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    50\t      - uses: sigstore/cosign-installer@dc72c7d5c4d10cd6bcb8cf6e3fd625a9e5e537da # v3.7.0\n    51\t        with:\n    52\t          cosign-release: \"v2.6.2\"\n    53\t      - uses: docker/setup-buildx-action@c47758b77c9736f4b2ef4073d4d51994fabfe349 # v3.7.1\n    54\t      - uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0\n    55\t        with:\n    56\t          registry: registry.example-corp.test\n    57\t          username: ${{ github.actor }}\n    58\t          password: ${{ secrets.GITHUB_TOKEN }}\n    59\t      - id: build\n    60\t        uses: docker/build-push-action@4f58ea79222b3b9dc2c8bbdd6debcef730109a75 # v6.9.0\n    61\t        with:\n    62\t          context: .\n    63\t          push: true\n    64\t          tags: registry.example-corp.test/procurement/agent:${{ github.sha }}\n    65\t          provenance: false\n    66\t          sbom: false\n    67\t      - name: SBOM\n    68\t        uses: anchore/sbom-action@251a468eed47e5082b105c3ba6ee500c0e65a764 # v0.17.6\n    69\t        with:\n    70\t          image: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    71\t          format: cyclonedx-json\n    72\t          output-file: sbom.cdx.json\n    73\t      - name: Sign and attest\n    74\t        env:\n    75\t          IMAGE: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    76\t        run: |\n    77\t          cosign sign --yes \"$IMAGE\"\n    78\t          cosign attest --yes --type cyclonedx --predicate sbom.cdx.json \"$IMAGE\"\n    79\t      - uses: actions/attest-build-provenance@1c608d11d69870c2092266b3f9a6f3abbf17002c # v1.4.3\n    80\t        with:\n    81\t          subject-name: registry.example-corp.test/procurement/agent\n    82\t          subject-digest: ${{ steps.build.outputs.digest }}\n    83\t          push-to-registry: true\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.11.10-slim-bookworm@sha256:2a6386ad2db20e7f55073f69a98d6da2cf9f168e05e7487d2670c22e4ad2a1bd AS build\n     3\tWORKDIR /src\n     4\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     5\tCOPY pyproject.toml ./\n     6\tCOPY app ./app\n     7\tRUN pip install --target /opt/site .\n     8\tRUN python -m compileall -q app\n     9\t\n    10\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:8f3c1a6e2b9d4f7a0c5e8b1d3f6a9c2e5b8d1f4a7c0e3b6d9f2a5c8e1b4d7f0a\n    11\tWORKDIR /app\n    12\tENV PYTHONPATH=/opt/site:/app \\\n    13\t    PYTHONDONTWRITEBYTECODE=1 \\\n    14\t    APP_ROOT=/app\n    15\tCOPY --from=build /opt/site /opt/site\n    16\tCOPY --from=build /src/app /app/app\n    17\tCOPY prompts /app/prompts\n    18\tCOPY config /app/config\n    19\tCOPY release/manifest.yaml /app/release/manifest.yaml\n    20\tUSER 65532:65532\n    21\tEXPOSE 8080\n    22\tENTRYPOINT [\"python\", \"-m\", \"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\", \"--no-server-header\"]\n     1\t[project]\n     2\tname = \"procurement-agent\"\n     3\tversion = \"2026.9.4\"\n     4\tdescription = \"Procurement agent: quotes, purchase orders, invoice payment.\"\n     5\trequires-python = \">=3.11\"\n     6\tdependencies = [\n     7\t  \"fastapi==0.115.6\",\n     8\t  \"uvicorn==0.32.1\",\n     9\t  \"asyncpg==0.30.0\",\n    10\t  \"httpx==0.28.1\",\n    11\t  \"pydantic==2.10.4\",\n    12\t  \"pyyaml==6.0.2\",\n    13\t  \"pyjwt[crypto]==2.10.1\",\n    14\t  \"pypdf==5.1.0\",\n    15\t  \"anthropic==0.75.0\",\n    16\t  \"opentelemetry-sdk==1.29.0\",\n    17\t  \"opentelemetry-exporter-otlp==1.29.0\",\n    18\t]\n    19\t\n    20\t[project.optional-dependencies]\n    21\ttest = [\"pytest==8.3.4\", \"pytest-asyncio==0.25.0\"]\n    22\t\n    23\t[tool.pytest.ini_options]\n    24\tasyncio_mode = \"auto\"\n    25\ttestpaths = [\"tests\"]\n     1\t-- Procurement agent schema. Applied by the migration job with the\n     2\t-- procurement_owner role; the running agent connects as procurement_agent.\n     3\t\n     4\tCREATE TABLE audit_events (\n     5\t    node_id             text PRIMARY KEY,\n     6\t    parent_node_id      text REFERENCES audit_events (node_id),\n     7\t    run_id              text NOT NULL,\n     8\t    ts                  timestamptz NOT NULL,\n     9\t    kind                text NOT NULL,\n    10\t    accountable_party   text NOT NULL CHECK (accountable_party <> ''),\n    11\t    operational_owner   text NOT NULL CHECK (operational_owner <> ''),\n    12\t    tenant              text NOT NULL CHECK (tenant <> ''),\n    13\t    agent_type_id       text NOT NULL CHECK (agent_type_id <> ''),\n    14\t    agent_instance_id   text NOT NULL CHECK (agent_instance_id <> ''),\n    15\t    trace_id            text NOT NULL CHECK (trace_id <> ''),\n    16\t    span_id             text,\n    17\t    delegated_subject   text NOT NULL,\n    18\t    agent_principal     text NOT NULL,\n    19\t    parent_instance_id  text,\n    20\t    policy_version      text,\n    21\t    approval_id         text,\n    22\t    operation_id        text,\n    23\t    context_tokens      integer CHECK (context_tokens IS NULL OR context_tokens > 0),\n    24\t    context_method      text NOT NULL,\n    25\t    context_compacted   boolean NOT NULL,\n    26\t    payload             jsonb NOT NULL\n    27\t);\n    28\tCREATE INDEX audit_events_run ON audit_events (run_id, ts);\n    29\tCREATE INDEX audit_events_instance ON audit_events (agent_instance_id, ts);\n    30\tCREATE INDEX audit_events_trace ON audit_events (trace_id);\n    31\t\n    32\tCREATE TABLE approvals (\n    33\t    id                     text PRIMARY KEY,\n    34\t    tool                   text NOT NULL,\n    35\t    target                 text NOT NULL,\n    36\t    args_sha256            text NOT NULL,\n    37\t    args_summary           jsonb NOT NULL,\n    38\t    tenant                 text NOT NULL,\n    39\t    requested_by_instance  text NOT NULL,\n    40\t    requested_by_run       text NOT NULL,\n    41\t    delegated_subject      text NOT NULL,\n    42\t    status                 text NOT NULL CHECK (status IN ('pending', 'approved', 'rejected', 'expired')),\n    43\t    requested_at           timestamptz NOT NULL,\n    44\t    expires_at             timestamptz NOT NULL,\n    45\t    approver               text,\n    46\t    approver_role          text,\n    47\t    decided_at             timestamptz\n    48\t);\n    49\tCREATE INDEX approvals_lookup ON approvals (tool, target, tenant, status);\n    50\t\n    51\tCREATE TABLE approvers (\n    52\t    slack_user_id  text PRIMARY KEY,\n    53\t    email          text NOT NULL,\n    54\t    role           text NOT NULL,\n    55\t    business_unit  text NOT NULL,\n    56\t    active         boolean NOT NULL DEFAULT true\n    57\t);\n    58\t\n    59\tCREATE TABLE documents (\n    60\t    doc_id         text PRIMARY KEY,\n    61\t    business_unit  text NOT NULL,\n    62\t    source         text NOT NULL,\n    63\t    media_type     text NOT NULL,\n    64\t    sha256         text NOT NULL,\n    65\t    status         text NOT NULL CHECK (status IN ('accepted', 'quarantined')),\n    66\t    reject_reason  text,\n    67\t    text           text,\n    68\t    received_at    timestamptz NOT NULL\n    69\t);\n    70\tCREATE INDEX documents_bu ON documents (business_unit, doc_id);\n    71\t\n    72\tCREATE TABLE dept_notes (\n    73\t    note_id            text PRIMARY KEY,\n    74\t    business_unit      text NOT NULL,\n    75\t    department         text NOT NULL,\n    76\t    kind               text NOT NULL,\n    77\t    body               text NOT NULL,\n    78\t    verified           boolean NOT NULL DEFAULT false,\n    79\t    verified_by        text,\n    80\t    quarantined        boolean NOT NULL DEFAULT false,\n    81\t    expires_at         timestamptz,\n    82\t    writer_instance    text NOT NULL,\n    83\t    writer_type_id     text NOT NULL,\n    84\t    run_id             text NOT NULL,\n    85\t    source_doc_id      text,\n    86\t    delegated_subject  text NOT NULL,\n    87\t    context_tokens     integer,\n    88\t    context_method     text NOT NULL,\n    89\t    created_at         timestamptz NOT NULL\n    90\t);\n    91\tCREATE INDEX dept_notes_lookup ON dept_notes (business_unit, department, created_at DESC);\n    92\tCREATE INDEX dept_notes_source ON dept_notes (source_doc_id);\n    93\tCREATE INDEX dept_notes_writer ON dept_notes (writer_instance);\n    94\t\n    95\tCREATE TABLE control_flags (\n    96\t    scope    text PRIMARY KEY,           -- 'fleet' or 'tenant:<business_unit>'\n    97\t    halted   boolean NOT NULL,\n    98\t    reason   text NOT NULL,\n    99\t    set_by   text NOT NULL,\n   100\t    set_at   timestamptz NOT NULL DEFAULT now()\n   101\t);\n   102\t\n   103\tCREATE TABLE spend_quota (\n   104\t    scope      text NOT NULL,\n   105\t    key        text NOT NULL,\n   106\t    day        date NOT NULL,\n   107\t    spent_usd  numeric(12, 4) NOT NULL,\n   108\t    PRIMARY KEY (scope, key, day)\n   109\t);\n   110\t\n   111\tCREATE TABLE run_start_window (\n   112\t    scope   text NOT NULL,\n   113\t    key     text NOT NULL,\n   114\t    minute  timestamptz NOT NULL,\n   115\t    starts  integer NOT NULL,\n   116\t    PRIMARY KEY (scope, key, minute)\n   117\t);\n   118\t\n   119\t-- Runtime role: append-only audit, no access to control flags beyond reading.\n   120\tREVOKE ALL ON ALL TABLES IN SCHEMA public FROM procurement_agent;\n   121\tGRANT SELECT, INSERT ON audit_events TO procurement_agent;\n   122\tGRANT SELECT, INSERT, UPDATE ON approvals TO procurement_agent;\n   123\tGRANT SELECT ON approvers TO procurement_agent;\n   124\tGRANT SELECT, INSERT ON documents TO procurement_agent;\n   125\tGRANT SELECT, INSERT ON dept_notes TO procurement_agent;\n   126\tGRANT SELECT ON control_flags TO procurement_agent;\n   127\tGRANT SELECT, INSERT, UPDATE ON spend_quota TO procurement_agent;\n   128\tGRANT SELECT, INSERT, UPDATE ON run_start_window TO procurement_agent;\n   129\t\n   130\t-- Operators: halt and resume.\n   131\tGRANT SELECT, INSERT, UPDATE ON control_flags TO procurement_ops;\n   132\tGRANT SELECT ON audit_events TO procurement_ops;\n   133\tGRANT SELECT, UPDATE (verified, verified_by, quarantined) ON dept_notes TO procurement_ops;\n     1\tapiVersion: kyverno.io/v1\n     2\tkind: ClusterPolicy\n     3\tmetadata:\n     4\t  name: procurement-verify-images\n     5\t  annotations:\n     6\t    policies.kyverno.io/title: Verify procurement agent images\n     7\t    kyverno.io/kyverno-version: \"1.15.2\"\n     8\tspec:\n     9\t  validationFailureAction: Enforce\n    10\t  background: false\n    11\t  webhookTimeoutSeconds: 15\n    12\t  failurePolicy: Fail\n    13\t  rules:\n    14\t    - name: only-approved-registry\n    15\t      match:\n    16\t        any:\n    17\t          - resources:\n    18\t              kinds: [Pod]\n    19\t              namespaces: [procurement-prod]\n    20\t      validate:\n    21\t        message: \"Images in procurement-prod must come from registry.example-corp.test/procurement and be pinned by digest.\"\n    22\t        pattern:\n    23\t          spec:\n    24\t            =(initContainers):\n    25\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n    26\t            containers:\n    27\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n    28\t    - name: verify-signature-and-provenance\n    29\t      match:\n    30\t        any:\n    31\t          - resources:\n    32\t              kinds: [Pod]\n    33\t              namespaces: [procurement-prod]\n    34\t      verifyImages:\n    35\t        - imageReferences:\n    36\t            - \"registry.example-corp.test/procurement/*\"\n    37\t          mutateDigest: false\n    38\t          verifyDigest: true\n    39\t          required: true\n    40\t          attestors:\n    41\t            - entries:\n    42\t                - keyless:\n    43\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    44\t                    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    45\t                    rekor:\n    46\t                      url: https://rekor.sigstore.dev\n    47\t          attestations:\n    48\t            - type: https://slsa.dev/provenance/v1\n    49\t              attestors:\n    50\t                - entries:\n    51\t                    - keyless:\n    52\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    53\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    54\t              conditions:\n    55\t                - all:\n    56\t                    - key: \"{{ buildDefinition.buildType }}\"\n    57\t                      operator: Equals\n    58\t                      value: \"https://actions.github.io/buildtypes/workflow/v1\"\n    59\t                    - key: \"{{ buildDefinition.externalParameters.workflow.repository }}\"\n    60\t                      operator: Equals\n    61\t                      value: \"https://github.com/example-corp/procurement-agent\"\n    62\t                    - key: \"{{ buildDefinition.externalParameters.workflow.ref }}\"\n    63\t                      operator: Equals\n    64\t                      value: \"refs/heads/main\"\n    65\t                    - key: \"{{ buildDefinition.externalParameters.workflow.path }}\"\n    66\t                      operator: Equals\n    67\t                      value: \".github/workflows/ci.yaml\"\n    68\t                    - key: \"{{ runDetails.builder.id }}\"\n    69\t                      operator: Equals\n    70\t                      value: \"https://github.com/actions/runner/github-hosted\"\n    71\t            - type: https://cyclonedx.org/bom\n    72\t              attestors:\n    73\t                - entries:\n    74\t                    - keyless:\n    75\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    76\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tERP_READ_SCOPE = \"erp.read\"\n    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n    11\t\n    12\t\n    13\tdef tools(deps) -> list[Tool]:\n    14\t    erp = deps.erp\n    15\t\n    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n    17\t        return await erp.call(\n    18\t            \"budget.get_remaining\",\n    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n    20\t            ident,\n    21\t            ERP_READ_SCOPE,\n    22\t        )\n    23\t\n    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n    25\t        arguments = dict(args.get(\"arguments\", {}))\n    26\t        arguments[\"business_unit\"] = ident.tenant\n    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n    28\t\n    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n    30\t        return await erp.call(\n    31\t            \"po.create\",\n    32\t            {\n    33\t                \"business_unit\": ident.tenant,\n    34\t                \"department\": args[\"department\"],\n    35\t                \"vendor_id\": args[\"vendor_id\"],\n    36\t                \"lines\": args[\"lines\"],\n    37\t                \"currency\": args[\"currency\"],\n    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n    39\t                \"client_reference\": args[\"source_doc_id\"],\n    40\t            },\n    41\t            ident,\n    42\t            ERP_PO_WRITE_SCOPE,\n    43\t        )\n    44\t\n    45\t    line_schema = {\n    46\t        \"type\": \"object\",\n    47\t        \"properties\": {\n    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n    52\t        },\n    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n    54\t        \"additionalProperties\": False,\n    55\t    }\n    56\t\n    57\t    return [\n    58\t        Tool(\n    59\t            name=\"get_budget\",\n    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n    61\t            input_schema={\n    62\t                \"type\": \"object\",\n    63\t                \"properties\": {\n    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n    66\t                },\n    67\t                \"required\": [\"department\", \"fiscal_period\"],\n    68\t                \"additionalProperties\": False,\n    69\t            },\n    70\t            invoke=get_budget,\n    71\t        ),\n    72\t        Tool(\n    73\t            name=\"erp_call\",\n    74\t            description=(\n    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n    77\t            ),\n    78\t            input_schema={\n    79\t                \"type\": \"object\",\n    80\t                \"properties\": {\n    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n    82\t                    \"arguments\": {\"type\": \"object\"},\n    83\t                },\n    84\t                \"required\": [\"operation\"],\n    85\t                \"additionalProperties\": False,\n    86\t            },\n    87\t            invoke=erp_call,\n    88\t        ),\n    89\t        Tool(\n    90\t            name=\"create_purchase_order\",\n    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n    92\t            input_schema={\n    93\t                \"type\": \"object\",\n    94\t                \"properties\": {\n    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n   100\t                },\n   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n   102\t                \"additionalProperties\": False,\n   103\t            },\n   104\t            invoke=create_purchase_order,\n   105\t            target_field=\"source_doc_id\",\n   106\t        ),\n   107\t    ]\n     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t\n    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_015Eng5UHPoZa45TDCEkAQRw","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
