NDINGS.json (set --repo to change it).\n\"\"\"\nimport argparse\nimport json\nimport sys\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nfrom validate_findings import quote_found, norm, refs  # noqa: E402\n\nCHECKS_FILE = Path(__file__).resolve().parent.parent / \"references\" / \"checks.json\"\n\n\ndef load(path):\n    return json.loads(Path(path).read_text())\n\n\ndef save(path, doc):\n    Path(path).write_text(json.dumps(doc, indent=2) + \"\\n\")\n\n\ndef find_item(doc, item):\n    for f in doc[\"findings\"]:\n        if f[\"item\"] == item:\n            return f\n    sys.exit(f\"{item} isn't in this findings file.\")\n\n\ndef next_open(doc):\n    for f in doc[\"findings\"]:\n        for c in f.get(\"checks\", []):\n            if c.get(\"met\") == \"unknown\" and not norm(c.get(\"note\", \"\")):\n                return f\"Next: {c['id']} — {c.get('check', '')}\\n  How to verify: {c.get('verify', '')}\"\n        if str(f.get(\"summary\", \"\")).startswith(\"TODO\"):\n            return f\"Next: finish item {f['item']} with `answer.py ... item {f['item']} --rating ...`\"\n(eval):1: permission denied: ../skill/scripts/answer.py","is_error":false}]},"parent_tool_use_id":null,"session_id":"5372d401-ba62-4ea7-9e5e-2be571c7ee7d","uuid":"27d45dc3-8ced-489c-9bbf-33cf88c29843","timestamp":"2026-10-20T12:06:35.263Z","tool_use_result":{"stdout":"24:MAX_DESCRIPTION_CHARS = 1024\n25:SUSPICIOUS_METADATA = [\n42:def fingerprint(tool: dict[str, Any]) -> str:\n47:        \"annotations\": tool.get(\"annotations\", {}),\n55:    if len(description) > MAX_DESCRIPTION_CHARS:\n57:    blob = json.dumps(tool, ensure_ascii=False)\n58:    for pattern in SUSPICIOUS_METADATA:\n97:            if expected != actual:\n99:            scan_metadata(tool)\n100:        self._tools = {t[\"name\"]: t for t in tools}\n107:    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n110:        self._tools = {t[\"name\"]: t for t in tools}\n63:mcp_serve