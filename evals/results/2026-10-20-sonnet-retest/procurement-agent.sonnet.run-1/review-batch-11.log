:\n  name: procurement-agent-ingress\n  namespace: procurement-prod\nspec:\n  podSelector:\n    matchLabels:\n      app: procurement-agent\n  policyTypes: [\"Ingress\"]\n  ingress:\n    - from:\n        - namespaceSelector:\n            matchLabels:\n              kubernetes.io/metadata.name: ingress\n      ports:\n        - { protocol: TCP, port: 8080 }\n---\n# Egress proxy allowlist (applied in the egress namespace by the platform team).\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: egress-proxy-allowlist-procurement\n  namespace: egress\ndata:\n  allowlist.txt: |\n    api.anthropic.com\n    api.payments.example-pay.test\n    login.example-corp.test\napiVersion: v1\nkind: Namespace\nmetadata:\n  name: procurement-prod\n  labels:\n    pod-security.kubernetes.io/enforce: restricted\n    pod-security.kubernetes.io/enforce-version: latest\n    pod-security.kubernetes.io/audit: restricted\n    pod-security.kubernetes.io/warn: restricted\n---\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: procurement-agent\n  namespace: procurement-prod\n  labels:\n    app: procurement-agent\nautomountServiceAccountToken: false\n(eval):1: no matches found: --include=*","stderr":"","interrupted":false,"isImage":false,"returnCodeInterpretation":"No matches found","noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WsvEAXDLrSUEPjenk7aGpP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
