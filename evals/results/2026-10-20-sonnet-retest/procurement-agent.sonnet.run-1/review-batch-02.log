{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015wLFgw5BsWPUu4Wk5jWFCV","type":"tool_result","content":"    20\t\n    21\tIDENTITY_FIELDS = (\n    22\t    \"accountable_party\",\n    23\t    \"operational_owner\",\n    24\t    \"tenant\",\n    25\t    \"agent_type_id\",\n    26\t    \"agent_instance_id\",\n    27\t    \"trace_id\",\n    28\t)\n    29\t\n    30\t\n    31\t@dataclass(frozen=True)\n    32\tclass RunIdentity:\n    33\t    accountable_party: str\n    34\t    operational_owner: str\n    35\t    tenant: str\n    36\t    agent_type_id: str\n    37\t    agent_instance_id: str\n    38\t    trace_id: str\n    39\t    run_id: str\n    40\t    delegated_subject: str\n    41\t    agent_principal: str\n    42\t    parent_instance_id: str | None = None\n    43\t    role: str = \"procurement\"\n    44\t\n    45\t    def __post_init__(self) -> None:\n    46\t        for name in IDENTITY_FIELDS:\n    47\t            if not getattr(self, name):\n    48\t                raise ValueError(f\"identity field {name} is empty\")\n    49\t\n    50\t    def child(self, role: str) -> \"RunIdentity\":\n    51\t        return replace(\n    52\t            self,\n    53\t            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n    54\t            parent_instance_id=self.agent_instance_id,\n    55\t            role=role,\n    56\t        )\n    57\t\n    58\t\n    59\tdef new_instance_id() -> str:\n    60\t    return f\"inst-{uuid.uuid4()}\"\n    61\t\n    62\t\n    63\tdef compute_agent_type_id(manifest: dict) -> str:\n    64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    65\t    material = {\n    66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n    67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n    68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n    69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n    70\t        \"models\": manifest[\"models\"],\n    71\t        \"config\": manifest[\"config\"],\n    72\t        \"tools\": manifest[\"tool_pins\"],\n    73\t    }\n    74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n    76\t\n    77\t\n    78\t@dataclass\n    79\tclass _CachedToken:\n    80\t    value: str\n    81\t    expires_at: float\n    82\t\n    83\t\n    84\t@dataclass\n    85\tclass TokenBroker:\n    86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n    87\t\n    88\t    settings: Settings\n    89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n    90\t\n    91\t    def _workload_token(self) -> str:\n    92\t        return Path(self.settings.workload_token_path).read_text().strip()\n    93\t\n    94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n    95\t        key = (audience, scope, ident.tenant)\n    96\t        cached = self._cache.get(key)\n    97\t        if cached and cached.expires_at - 30 > time.time():\n    98\t            return cached.value\n    99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n   100\t            resp = await client.post(\n   101\t                self.settings.sts_url,\n   102\t                data={\n   103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n   104\t                    \"subject_token\": self._workload_token(),\n   105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n   106\t                    \"audience\": audience,\n   107\t                    \"scope\": scope,\n   108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n   109\t                    \"actor_token\": ident.delegated_subject,\n   110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n   111\t                },\n   112\t            )\n   113\t            resp.raise_for_status()\n   114\t            body = resp.json()\n   115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n   116\t        self._cache[key] = token\n   117\t        return token.value\n    return RunIdentity(\n        accountable_party=\"system:procurement-agent\",\n        operational_owner=settings.operational_owner,\n        tenant=tenant,\n        agent_type_id=agent_type_id,\n        agent_instance_id=new_instance_id(),\n        trace_id=uuid.uuid4().hex,\n        run_id=f\"bg-{uuid.uuid4()}\",\n        delegated_subject=\"system:procurement-agent\",\n        agent_principal=AGENT_PRINCIPAL,\n    )\n\n\nasync def expire_approvals_forever(app: FastAPI) -> None:\n    while True:\n        await asyncio.sleep(60)\n        ident = service_identity(app.state.settings, app.state.agent_type_id)\n        count = await app.state.pool.fetchval(\n            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n        )\n        await audit.record(app.state.pool, ident, kind=\"background_job\",\n                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n\n\n@asynccontextmanager\nasync def lifespan(app: FastAPI):\n    settings = get_settings()\n    agent_type_id = startup_checks(settings)\n    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    broker = TokenBroker(settings)\n\n    async def slack_token() -> str:\n        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n\n    slack = SlackClient(settings.slack_api_url, slack_token)\n    approvals = ApprovalStore(pool, settings.policy, slack)\n    gate = PolicyGate(settings.policy, approvals)\n    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    await erp.initialize(service_identity(settings, agent_type_id))\n\n    client = AsyncAnthropic()\n    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    deps.extractor = LineItemExtractor(\n        client=client, settings=settings, deps=deps,\n        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n    )\n    app.state.settings = settings\n    app.state.pool = pool\n    app.state.agent_type_id = agent_type_id\n    app.state.approvals = approvals\n    app.state.agent = ProcurementAgent(\n        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n    )\n    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n    sweeper = asyncio.create_task(expire_approvals_forever(app))\n    try:\n        yield\n    finally:\n        sweeper.cancel()\n        await pool.close()\n\n\napp = FastAPI(lifespan=lifespan)\napp.include_router(ingest.router)\n\n\ndef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n    settings = request.app.state.settings\n    try:\n        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n        claims = jwt.decode(\n            creds.credentials,\n            key.key,\n            algorithms=[\"RS256\", \"ES256\"],\n            audience=settings.oidc_audience,\n        tenant=principal.business_unit,\n        agent_type_id=request.app.state.agent_type_id,\n        agent_instance_id=new_instance_id(),\n        trace_id=trace_id,\n        run_id=f\"run-{uuid.uuid4()}\",\n        delegated_subject=principal.subject,\n        agent_principal=AGENT_PRINCIPAL,\n    )\n    task = f\"Department: {req.department}\\n\\n{req.task}\"\n    asyncio.create_task(request.app.state.agent.run(ident, task))\n    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n\n\n@app.post(\"/slack/interactions\")\nasync def slack_interactions(request: Request) -> dict:\n    body = await request.body()\n    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n    if abs(time.time() - int(timestamp)) > 300:\n        raise HTTPException(401, \"stale request\")\n    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n        raise HTTPException(401, \"bad signature\")\n\n    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n    action = payload[\"actions\"][0]\n    slack_user = payload[\"user\"][\"id\"]\n    row = await request.app.state.pool.fetchrow(\n        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n    )\n    if row is None:\n        raise HTTPException(403, \"not an approver\")\n    try:\n        await request.app.state.approvals.decide(\n            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n            approve=action[\"action_id\"] == \"approve\",\n        )\n    except ApproverNotAuthorized as exc:\n        raise HTTPException(403, str(exc)) from exc\n    except ValueError as exc:\n        raise HTTPException(409, str(exc)) from exc\n    return {\"ok\": True}\n\n\n@app.get(\"/healthz\")\nasync def healthz() -> dict:\n    return {\"ok\": True}\n{\n  \"id\": \"B06.1\",\n  \"check\": \"Each approval record is bound to the requesting agent instance and to the exact operation, target, arguments, and scope, and records the approver and an expiry time.\",\n  \"coverage_required\": true,\n  \"verify\": \"1) Find the approval data model (schema, class, table, `approval`). 2) List its fields. 3) Answer no if it lacks any of agent instance ID, operation, target, exact arguments or hash, scope, approver, and expiry, or if approval is a boolean like `approved=True`.\",\n  \"candidate_sites\": []\n}\n{\n  \"id\": \"B06.2\",\n  \"check\": \"When the action runs, the gate rejects it if the instance, operation, target, or arguments differ from the approval, or if the approval has expired.\",\n  \"coverage_required\": true,\n  \"verify\": \"1) Find where an approved action executes. 2) Check the code compares instance, operation, target, and arguments (or hash) against the stored approval and checks expiry at that moment. 3) Answer no if approval is checked only when requested, any field is not compared, arguments are re-read from the model after the check, or expiry is never checked.\",\n  \"candidate_sites\": []\n}\n{\n  \"id\": \"B06.3\",\n  \"check\": \"Each use of an approval is recorded in one atomic step (single-use or a bounded counter), so replays and parallel calls cannot go past the grant.\",\n  \"coverage_required\": true,\n  \"verify\": \"1) Find where an approval is used or marked consumed. 2) Check it is one atomic step: transaction with lock, compare-and-set, unique constraint, or atomic decrement. 3) Answer no if it reads then writes separately, never marks use, or keeps the count in process memory that parallel workers do not share.\",\n  \"candidate_sites\": []\n}\n{\n  \"id\": \"B06.4\",\n  \"check\": \"The gate checks that the approver has authority for this action, and rechecks permissions and the relevant resource state when the action runs.\",\n  \"coverage_required\": true,\n  \"verify\": \"1) Find approver checks (role list, `can_approve`, authority mapping). 2) Find rechecks of permissions and resource state at execution. 3) Answer no if any logged-in user can approve, the approver is not checked against the action, or permissions and resource state are not rechecked when the action runs.\",\n  \"candidate_sites\": []\n}\n{\n  \"id\": \"B06.5\",\n  \"check\": \"If the approval service errors or cannot be reached, the action is denied.\",\n  \"coverage_required\": true,\n  \"verify\": \"1) Find calls to the approval service. 2) Read their error, timeout, and exception handling. 3) Answer no if a `try`/`except` or `catch` logs and proceeds, the default on error or timeout is allow, or a missing response is treated as approved.\",\n  \"candidate_sites\": []\n}\n{\n  \"id\": \"B07.2\",\n  \"check\": \"The harness or a gateway outside the model enforces each limit and stops or escalates the run when it is hit; the model cannot raise, reset, or skip them.\",\n  \"coverage_required\": true,\n  \"inventory_kinds\": [\n    \"model_call\",\n    \"tool_call\"\n  ],\n  \"attempt_categories\": [\n    \"unmetered_call\",\n    \"limit_boundary\"\n  ],\n  \"verify\": \"1) Inventory every main/helper model invocation, tool call and retry. 2) For each, locate token/cost/rate enforcement and the stop/escalation branch. 3) Trace a boundary case: enforcement/reservation before work, or a documented finite overshoot bound with enforcement. 4) Answer no for unmetered helpers, uncounted retries, unbounded overshoot, model-controlled limits or catches that continue. Small max_tokens and timeouts do not substitute for shared token/cost accounting.\",\n  \"candidate_sites\": [\n    {\n      \"id\": \"I1bba76f5cb\",\n      \"kind\": \"model_call\",\n      \"evidence\": \"app/extractor.py:74\",\n      \"quote\": \"response = await self.client.messages.create(**request)\"\n    },\n    {\n      \"id\": \"I4721ae44be\",\n      \"kind\": \"tool_call\",\n      \"evidence\": \"app/extractor.py:96\",\n      \"quote\": \"results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\"\n    },\n    {\n      \"id\": \"I11d074af40\",\n      \"kind\": \"model_call\",\n      \"evidence\": \"app/loop.py:150\",\n      \"quote\": \"response = await self.client.messages.create(**request)\"\n    },\n    {\n      \"id\": \"I65e59182e1\",\n      \"kind\": \"tool_call\",\n      \"evidence\": \"app/loop.py:173\",\n      \"quote\": \"results.append(await self.deps.execute_tool(ident, registry,