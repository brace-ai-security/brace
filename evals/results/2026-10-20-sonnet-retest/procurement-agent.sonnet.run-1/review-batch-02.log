ol not in role allowlist\"},\n            )\n            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n\n        decision = await self.gate.authorize(ident, tool, use.input)\n        authz = await audit.record(\n            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n            policy_version=decision.policy_version, approval_id=decision.approval_id,\n            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n        )\n        if not decision.allow:\n            if decision.pending:\n                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n            return _error(use.id, f\"denied: {decision.reason}\")\n\n        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n        try:\n            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n                for k, v in ctx.otel_attributes().items():\n                    span.set_attribute(k, v)\n                output = await tool.invoke(use.input, ident)\n        except BudgetExceeded:\n            raise\n        except Exception as exc:\n            await audit.record(\n                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n                policy_version=decision.policy_version, approval_id=decision.approval_id,\n                operation_id=operation_id,\n                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n            )\n            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n\n        await audit.record(\n            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n            policy_version=decision.policy_version, approval_id=decision.approval_id,\n            operation_id=operation_id,\n            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n        )\n        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n\n\ndef _error(tool_use_id: str, message: str) -> dict:\n    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n\n\ndef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n    if len(messages) <= COMPACT_AFTER_MESSAGES:\n        return messages, False\n    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n    while tail and tail[0][\"role\"] != \"assistant\":\n        tail = tail[1:]\n    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n    return head + [note] + tail, True\n\n\nclass ProcurementAgent:\n    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n        self.client = client\n        self.deps = deps\n        self.system_prompt = system_prompt\n        self.role = role\n\n    async def run(self, ident: RunIdentity, task: str) -> str | None:\n        pool = self.deps.pool\n        await killswitch.assert_running(pool, ident.tenant)\n        budget = Budget.for_run(self.deps.settings.budgets, ident)\n        await budget.reserve_run_start(pool)\n        self.deps._budgets[ident.run_id] = budget\n        registry = build_registry(self.role, ident, self.deps)\n\n        run_node = await audit.record(\n            pool, ident, kind=\"run_started\",\n            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n        )\n        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n        try:\n            while True:\n                budget.check_step()\n                messages, compacted = _compact(messages)\n                request = {\n                    \"model\": self.deps.settings.model_id,\n                    \"system\": self.system_prompt,\n                    \"messages\": messages,\n                    \"tools\": registry.schemas(),\n                    \"max_tokens\": 4096,\n                }\n                ctx = await measure_context(self.client, request, compacted)\n                response = await self.client.messages.create(**request)\n                budget.charge_model(self.deps.settings.model_id, response.usage)\n                await budget.flush(pool)\n                ctx = ctx.finalize(response.usage)\n                decision = await audit.record(\n                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n                    payload={\n                        \"requested_model\": request[\"model\"],\n                        \"served_model\": response.model,\n                        \"stop_reason\": response.stop_reason,\n                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n                    },\n                )\n                messages.append({\"role\": \"assistant\", \"content\": response.content})\n                uses = [b for b in response.content if b.type == \"tool_use\"]\n                if not uses:\n                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n                                       payload={\"final_sha256\": audit.digest(final)})\n                    return final\n                results = []\n                for use in uses:\n                    budget.check_tool_call()\n                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n                messages.append({\"role\": \"user\", \"content\": results})\n        except BudgetExceeded as exc:\n            await audit.record(\n                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n            )\n            await self.deps.slack.post(\n                channel=\"#procurement-agent-ops\",\n                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n            )\n            return None\n        finally:\n            self.deps._budgets.pop(ident.run_id, None)\n\"\"\"Tool registry.\n\nEach agent role gets the tools listed for it in config/tools.yaml. The model\nonly sees schemas for those tools, and the loop rejects any call to a name\nthat is not in the run's registry.\n\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom functools import lru_cache\nfrom typing import Any, Awaitable, Callable\n\nimport yaml\n\nfrom app.identity import RunIdentity\n\nDEFAULT_ROLE = \"procurement\"\n\nInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n\n\n@dataclass(frozen=True)\nclass Tool:\n    name: str\n    description: str\n    input_schema: dict[str, Any]\n    invoke: Invoke\n    target_field: str | None = None\n\n    def target_of(self, args: dict[str, Any]) -> str:\n        if self.target_field is None:\n            return self.name\n        return str(args.get(self.target_field, \"\"))\n\n    def schema(self) -> dict[str, Any]:\n        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n\n\nclass ToolRegistry:\n    def __init__(self, tools: list[Tool]):\n        self._tools = {t.name: t for t in tools}\n\n    def get(self, name: str) -> Tool | None:\n        return self._tools.get(name)\n\n    def names(self) -> list[str]:\n        return sorted(self._tools)\n\n    def schemas(self) -> list[dict[str, Any]]:\n        return [self._tools[n].schema() for n in self.names()]\n\n\n@lru_cache(maxsize=1)\ndef _role_tools(path: str) -> dict[str, list[str]]:\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\n        cfg = yaml.safe_load(fh)\n    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n\n\ndef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n    from app.tools import documents, erp, memory, payments, slack\n\n    available: dict[str, Tool] = {}\n    for module in (documents, erp, memory, payments, slack):\n        for tool in module.tools(deps):\n            available[tool.name] = tool\n\n    roles = _role_tools(str(deps.settings.tools_path))\n    allowed = roles.get(role, roles[DEFAULT_ROLE])\n    return ToolRegistry([available[name] for name in allowed if name in available])\nversion: \"proc-policy-2026.09.3\"\n\n# Operations that change money, vendor records, or purchase commitments.\n# Denied unless a valid approval exists for the operation and its target.\nhigh_impact_tools:\n  - create_purchase_order\n  - pay_invoice\n\nerp:\n  # Namespaces the agent may reach through the generic erp_call tool.\n  read_prefixes:\n    - \"budget.\"\n    - \"vendor.\"\n    - \"invoice.\"\n    - \"po.get\"\n    - \"po.list\"\n  # Scope requested from the STS for each ERP operation; the ERP enforces it.\n  operation_scopes:\n    budget.get_remaining: \"erp.read\"\n    vendor.get: \"erp.read\"\n    vendor.search: \"erp.read\"\n    vendor.update_remit_to: \"erp.read erp.vendor.write\"\n    invoice.get: \"erp.read\"\n    invoice.list_open: \"erp.read\"\n    invoice.mark_paid: \"erp.read erp.invoice.write\"\n    invoice.void: \"erp.read erp.invoice.write\"\n    po.get: \"erp.read\"\n    po.list_open: \"erp.read\"\n    po.create: \"erp.read erp.po.create\"\n\napprovals:\n  ttl_minutes: 60\n  approver_roles:\n    pay_invoice: [ap_manager, finance_controller]\n    create_purchase_order: [budget_owner, finance_controller]\n    post_slack_message: [procurement_lead]\n\nbudgets:\n  per_run:\n    max_steps: 25\n    max_wall_seconds: 300\n    max_tokens: 400000\n    max_cost_usd: 4.00\n    max_tool_calls_per_minute: 30\n    max_subagents: 3\n  quotas_daily_usd:\n    user: 25\n    tenant: 250\n    fleet: 1500\n  run_starts_per_minute:\n    user: 5\n    tenant: 40\n    fleet: 200\n# Tools per agent role, each with the task reason it is granted.\nroles:\n  procurement:\n    tools:\n      read_document: \"Read vendor quotes, invoices and emails that arrived through the mail gateway.\"\n      extract_line_items: \"Delegate line-item extraction from long documents to the extractor.\"\n      get_budget: \"Check remaining department budget before raising a purchase order.\"\n      erp_call: \"Look up vendors, open invoices and purchase orders for matching.\"\n      create_purchase_order: \"Raise a purchase order once a quote is within budget and approved.\"\n      pay_invoice: \"Pay an invoice that is matched to a purchase order and approved.\"\n      post_slack_message: \"Ask staff for missing details and confirm orders with vendors.\"\n      memory_read: \"Recall department preferences and contract terms from earlier runs.\"\n      memory_write: \"Save new department preferences and contract terms.\"\n  extractor:\n    tools:\n      read_document: \"Read the document whose line items are being extracted.\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Tkmo2RNnYXTtFmR3feNWjR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
