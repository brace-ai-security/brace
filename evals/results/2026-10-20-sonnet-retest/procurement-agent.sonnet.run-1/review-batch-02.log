idence\": \"app/loop.py:167\",\n      \"quote\": \"await audit.record(pool, ident, kind=\\\"run_finished\\\", parent=run_node, context=ctx,\"\n    },\n    {\n      \"id\": \"I65e59182e1\",\n      \"kind\": \"tool_call\",\n      \"evidence\": \"app/loop.py:173\",\n      \"quote\": \"results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\"\n    },\n    {\n      \"id\": \"I6e9f9a2638\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:176\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"Icbe3633cb6\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:55\",\n      \"quote\": \"proposed = await audit.record(\"\n    },\n    {\n      \"id\": \"I4db5797679\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:61\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"Ia389c28cba\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:68\",\n      \"quote\": \"authz = await audit.record(\"\n    },\n    {\n      \"id\": \"I8165b2309f\",\n      \"kind\": \"tool_call\",\n      \"evidence\": \"app/loop.py:83\",\n      \"quote\": \"output = await tool.invoke(use.input, ident)\"\n    },\n    {\n      \"id\": \"I588419ff8b\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:87\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"I12a6ffed84\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/loop.py:95\",\n      \"quote\": \"await audit.record(\"\n    },\n    {\n      \"id\": \"Iffaa43b340\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"app/main.py:76\",\n      \"quote\": \"await audit.record(app.state.pool, ident, kind=\\\"background_job\\\",\"\n    }\n  ],\n  \"skipped\": [],\n  \"limitations\": \"Candidate inventory only: manually trace aliases, wrappers, computed calls and unsupported languages. Tests excluded; no code executed.\"\n}\n\"\"\"Approval requests and decisions for high-impact operations.\n\nRequests are posted to the business unit's approvals channel in Slack with\nthe full argument summary. Approvers decide with the Slack buttons; the\ninteractive callback is signature-checked in main.py and then calls\n``decide``. Approver authority is checked against the role map in policy.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport uuid\nfrom dataclasses import dataclass\nfrom datetime import datetime, timedelta, timezone\nfrom typing import Any\n\nfrom app.audit import digest, summarize_args\nfrom app.identity import RunIdentity\n\n\n@dataclass(frozen=True)\nclass Approval:\n    id: str\n    approver: str\n    approver_role: str\n    expires_at: datetime\n\n\nclass ApproverNotAuthorized(Exception):\n    pass\n\n\nclass ApprovalStore:\n    def __init__(self, pool, policy: dict, notifier):\n        self.pool = pool\n        self.ttl = timedelta(minutes=int(policy[\"approvals\"][\"ttl_minutes\"]))\n        self.approver_roles: dict[str, list[str]] = policy[\"approvals\"][\"approver_roles\"]\n        self.notifier = notifier\n\n    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n        approval_id = f\"apr-{uuid.uuid4()}\"\n        expires_at = datetime.now(timezone.utc) + self.ttl\n        await self.pool.execute(\n            \"\"\"\n            INSERT INTO approvals (\n                id, tool, target, args_sha256, args_summary, tenant,\n                requested_by_instance, requested_by_run, delegated_subject,\n                status, requested_at, expires_at\n            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)\n            \"\"\",\n            approval_id,\n            tool,\n            target,\n            digest(args),\n            json.dumps(summarize_args(args)),\n            ident.tenant,\n            ident.agent_instance_id,\n            ident.run_id,\n            ident.delegated_subject,\n            expires_at,\n        )\n        await self.notifier.post_approval_request(\n            tenant=ident.tenant,\n            approval_id=approval_id,\n            tool=tool,\n            target=target,\n            summary=summarize_args(args),\n            expires_at=expires_at,\n        )\n        return approval_id\n\n    async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:\n        row = await self.pool.fetchrow(\n            \"\"\"\n            SELECT id, approver, approver_role, expires_at\n            FROM approvals\n            WHERE tool = $1\n              AND target = $2\n              AND tenant = $3\n              AND status = 'approved'\n              AND expires_at > now()\n            ORDER BY decided_at DESC\n            LIMIT 1\n            \"\"\",\n            tool,\n            target,\n            ident.tenant,\n        )\n        if row is None:\n            return None\n        if row[\"approver_role\"] not in self.approver_roles.get(tool, []):\n            return None\n        return Approval(row[\"id\"], row[\"approver\"], row[\"approver_role\"], row[\"expires_at\"])\n\n    async def decide(self, approval_id: str, approver: str, approver_role: str, approve: bool) -> None:\n        row = await self.pool.fetchrow(\n            \"SELECT tool, status, expires_at FROM approvals WHERE id = $1\", approval_id\n        )\n        if row is None or row[\"status\"] != \"pending\":\n            raise ValueError(\"approval is not pending\")\n        if row[\"expires_at\"] <= datetime.now(timezone.utc):\n            raise ValueError(\"approval request expired\")\n        if approver_role not in self.approver_roles.get(row[\"tool\"], []):\n            raise ApproverNotAuthorized(f\"{approver_role} cannot approve {row['tool']}\")\n        await self.pool.execute(\n            \"\"\"\n            UPDATE approvals\n            SET status = $2, approver = $3, approver_role = $4, decided_at = now()\n            WHERE id = $1 AND status = 'pending'\n            \"\"\",\n            approval_id,\n            \"approved\" if approve else \"rejected\",\n            approver,\n            approver_role,\n        )\n\"\"\"Policy gate for tool calls.\n\nRuns in the harness between the model's proposed call and the integration.\nHigh-impact operations are denied unless a valid approval exists; when none\nexists an approval request is opened and the call returns as pending.\n\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import Any\n\nfrom app.approvals import ApprovalStore\nfrom app.identity import RunIdentity\n\n\n@dataclass(frozen=True)\nclass Decision:\n    allow: bool\n    reason: str\n    policy_version: str\n    approval_id: str | None = None\n    pending: bool = False\n\n\nclass PolicyGate:\n    def __init__(self, policy: dict, approvals: ApprovalStore):\n        self.version: str = policy[\"version\"]\n        self.high_impact: frozenset[str] = frozenset(policy[\"high_impact_tools\"])\n        self.erp_read_prefixes: tuple[str, ...] = tuple(policy[\"erp\"][\"read_prefixes\"])\n        self.approvals = approvals\n\n    async def authorize(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n        if tool.name == \"erp_call\":\n            operation = str(args.get(\"operation\", \"\"))\n            if not operation.startswith(self.erp_read_prefixes):\n                return Decision(False, f\"erp operation not permitted: {operation}\", self.version)\n            return Decision(True, \"erp read operation\", self.version)\n\n        if tool.name == \"post_slack_message\":\n            if args.get(\"external\", False):\n                return await self._require_approval(ident, tool, args)\n            return Decision(True, \"internal staff message\", self.version)\n\n        if tool.name in self.high_impact:\n            return await self._require_approval(ident, tool, args)\n\n        return Decision(True, \"low-impact tool\", self.version)\n\n    async def _require_approval(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n        target = tool.target_of(args)\n        approval = await self.approvals.find_valid(ident, tool.name, target)\n        if approval is not None:\n            return Decision(True, \"approved\", self.version, approval_id=approval.id)\n        approval_id = await self.approvals.request(ident, tool.name, target, args)\n        return Decision(\n            False,\n            \"approval required; request opened\",\n            self.version,\n            approval_id=approval_id,\n            pending=True,\n        )\n\"\"\"Hard execution budgets, enforced by the harness and not by the model.\n\nPer run: step count, wall-clock time, tokens, cost, tool-call rate, and\nnumber of sub-agents. Sub-agents charge the parent's budget, so a child\ncannot widen what the parent was given.\n\nAcross runs: daily spend and per-minute run starts per user, per tenant\n(business unit), and for the whole fleet. Quotas are reserved in Postgres\ninside one transaction, so concurrent runs cannot overshoot them.\n\"\"\"\nfrom __future__ import annotations\n\nimport time\nfrom collections import deque\nfrom dataclasses import dataclass, field\nfrom decimal import Decimal\n\nfrom app.identity import RunIdentity\n\n\nclass BudgetExceeded(Exception):\n    def __init__(self, limit: str, used, allowed):\n        super().__init__(f\"{limit} exceeded: used={used} allowed={allowed}\")\n        self.limit = limit\n        self.used = used\n        self.allowed = allowed\n\n\n# USD per million tokens, from the provider price sheet referenced in the manifest.\nPRICES = {\n    \"claude-sonnet-4-5-20250929\": (Decimal(\"3.00\"), Decimal(\"15.00\")),\n    \"claude-haiku-4-5-20251001\": (Decimal(\"1.00\"), Decimal(\"5.00\")),\n}\n\n\n@dataclass\nclass Budget:\n    ident: RunIdentity\n    max_steps: int\n    max_wall_seconds: float\n    max_tokens: int\n    max_cost_usd: Decimal\n    max_tool_calls_per_minute: int\n    max_subagents: int\n    quotas_daily_usd: dict[str, Decimal]\n    run_starts_per_minute: dict[str, int]\n    started_at: float = field(default_factory=time.monotonic)\n    steps: int = 0\n    tokens: int = 0\n    cost_usd: Decimal = Decimal(\"0\")\n    unflushed_cost_usd: Decimal = Decimal(\"0\")\n    subagents: int = 0\n    _tool_calls: deque = field(default_factory=deque)\n\n    @classmethod\n    def for_run(cls, cfg: dict, ident: RunIdentity) -> \"Budget\":\n        run = cfg[\"per_run\"]\n        return cls(\n            ident=ident,\n            max_steps=int(run[\"max_steps\"]),\n            max_wall_seconds=float(run[\"max_wall_seconds\"]),\n            max_tokens=int(run[\"max_tokens\"]),\n            max_cost_usd=Decimal(str(run[\"max_cost_usd\"])),\n            max_tool_calls_per_minute=int(run[\"max_tool_calls_per_minute\"]),\n            max_subagents=int(run[\"max_subagents\"]),\n            quotas_daily_usd={k: Decimal(str(v)) for k, v in cfg[\"quotas_daily_usd\"].items()},\n            run_starts_per_minute={k: int(v) for k, v in cfg[\"run_starts_per_minute\"].items()},\n        )\n\n    def _scopes(self) -> list[tuple[str, str]]:\n        return [\n            (\"user\", self.ident.accountable_party),\n            (\"tenant\", self.ident.tenant),\n            (\"fleet\", \"all\"),\n        ]\n\n    # --- per-run limits -------------------------------------------------\n\n    def check_step(self) -> None:\n        self.steps += 1\n        if self.steps > self.max_steps:\n            raise BudgetExceeded(\"max_steps\", self.steps, self.max_steps)\n        elapsed = time.monotonic() - self.started_at\n        if elapsed > self.max_wall_seconds:\n            raise BudgetExceeded(\"max_wall_seconds\", round(elapsed, 1), self.max_wall_seconds)\n\n    def charge_model(self, model: str, usage) -> None:\n        price_in, price_out = PRICES[model]\n        tokens_in = (\n            int(usage.input_tokens or 0)\n            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n        )\n        tokens_out = int(usage.output_tokens or 0)\n        self.tokens += tokens_in + tokens_out\n        cost = (price_in * tokens_in + price_out * tokens_out) / Decimal(1_000_000)\n        self.cost_usd += cost\n        self.unflushed_cost_usd += cost\n        if self.tokens > self.max_tokens:\n            raise BudgetExceeded(\"max_tokens\", self.tokens, self.max_tokens)\n        if self.cost_usd > self.max_cost_usd:\n            raise BudgetExceeded(\"max_cost_usd\", self.cost_usd, self.max_cost_usd)\n\n    def check_tool_call(self, now: float | None = None) -> None:\n        now = time.monotonic() if now is None else now\n        while self._tool_calls and now - self._tool_calls[0] > 60:\n            self._tool_calls.popleft()\n        if len(self._tool_calls) >= self.max_tool_calls_per_minute:\n            raise BudgetExceeded(\n                \"max_tool_calls_per_minute\", len(self._tool_calls) + 1, self.max_tool_calls_per_minute\n            )\n        self._tool_calls.append(now)\n\n    def check_subagent(self) -> None:\n        if self.subagents >= self.max_subagents:\n            raise BudgetExceeded(\"max_subagents\", self.subagents + 1, self.max_subagents)\n        self.subagents += 1\n\n    # --- cross-run quotas -----------------------------------------------\n\n    async def reserve_run_start(self, pool) -> None:\n        async with pool.acquire() as conn:\n            async with conn.transaction():\n                for scope, key in self._scopes():\n                    limit = self.run_starts_per_minute[scope]\n                    count = await conn.fetchval(\n                        \"\"\"\n                        INSERT INTO run_start_window (scope, key, minute, starts)\n                        VALUES ($1, $2, date_trunc('minute', now()), 1)\n                        ON CONFLICT (scope, key, minute)\n                        DO UPDATE SET starts = run_start_window.starts + 1\n                        RETURNING starts\n                        \"\"\",\n                        scope,\n                        key,\n                    )\n                    if count > limit:\n                        raise BudgetExceeded(f\"run_starts_per_minute.{scope}\", count, limit)\n\n    async def flush(self, pool) -> None:\n        \"\"\"Add this run's unflushed spend to the daily quotas, or stop the run.\"\"\"\n        if self.unflushed_cost_usd <= 0:\n            return\n        amount = self.unflushed_cost_usd\n        async with pool.acquire() as conn:\n            async with conn.transaction():\n                for scope, key in self._scopes():\n                    limit = self.quotas_daily_usd[scope]\n                    spent = await conn.fetchval(\n                        \"\"\"\n                        INSERT INTO spend_quota (scope, key, day, spent_usd)\n                        VALUES ($1, $2, current_date, $3)\n                        ON CONFLICT (scope, key, day)\n                        DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd\n                        RETURNING spent_usd\n                        \"\"\",\n                        scope,\n                        key,\n                        amount,\n                    )\n                    if spent > limit:\n                        raise BudgetExceeded(f\"quota_daily_usd.{scope}\", spent, limit)\n        self.unflushed_cost_usd = Decimal(\"0\")","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_019sueGqxvkXoPXkkQ9c87h4","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDRPRyy5anicUaohCSmx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Tkmo2RNnYXTtFmR3feNWjR","name":"Bash","input":{"command":"cd ../agent; cat app/loop.py app/tools/__init__.py config/policy.yaml config/tools.yaml"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10132,"cache_read_input_tokens":21349,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10132},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4593343d-a812-4a3d-a637-47d1e000547b","uuid":"82707673-b2d5-47e0-8e19-20d47b41d536","timestamp":"2026-10-20T11:36:52.417Z","request_id":"req_011CgDRPRiLZKpdAeyUn9GLr","wire_tool_inputs":{"toolu_01Tkmo2RNnYXTtFmR3feNWjR":{"command":"cd ../agent; cat app/loop.py app/tools/__init__.py config/policy.yaml config/tools.yaml"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tkmo2RNnYXTtFmR3feNWjR","type":"tool_result","content":"\"\"\"Procurement agent run loop.\n\nGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\nEvery edge writes an audit node before the next step runs. Budgets are\nchecked before each model turn and each tool call.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport logging\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nfrom opentelemetry import trace\n\nfrom app import audit, killswitch\nfrom app.budget import Budget, BudgetExceeded\nfrom app.context_size import ContextMeasure, measure_context\nfrom app.gate import PolicyGate\nfrom app.identity import RunIdentity\nfrom app.redact import redact_for_model\nfrom app.tools import ToolRegistry, build_registry\n\nlog = logging.getLogger(__name__)\ntracer = trace.get_tracer(\"procurement.loop\")\n\nCOMPACT_AFTER_MESSAGES = 40\nKEEP_RECENT_MESSAGES = 12\n\n\n@dataclass\nclass AgentDeps:\n    settings: Any\n    pool: Any\n    gate: PolicyGate\n    erp: Any\n    slack: Any\n    broker: Any\n    extractor: Any = None\n    _budgets: dict[str, Budget] = field(default_factory=dict)\n    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n\n    def current_budget(self, ident: RunIdentity) -> Budget:\n        return self._budgets[ident.run_id]\n\n    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n\n    def erp_scope_for(self, operation: str) -> str:\n        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n        return scopes.get(operation, \"erp.read\")\n\n    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n        self._contexts[ident.agent_instance_id] = ctx\n        proposed = await audit.record(\n            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n        )\n        tool = registry.get(use.name)\n        if tool is None:\n            await audit.record(\n                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n            )\n            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n\n        decision = await self.gate.authorize(ident, tool, use.input)\n        authz = await audit.record(\n            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n            policy_version=decision.policy_version, approval_id=decision.approval_id,\n            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n        )\n        if not decision.allow:\n            if decision.pending:\n                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n            return _error(use.id, f\"denied: {decision.reason}\")\n\n        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n        try:\n            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n                for k, v in ctx.otel_attributes().items():\n                    span.set_attribute(k, v)\n                output = await tool.invoke(use.input, ident)\n        except BudgetExceeded:\n            raise\n        except Exception as exc:\n            await audit.record(\n                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n                policy_version=decision.policy_version, approval_id=decision.approval_id,\n                operation_id=operation_id,\n                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n            )\n            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n\n        await audit.record(\n            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n            policy_version=decision.policy_version, approval_id=decision.approval_id,\n            operation_id=operation_id,\n            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n        )\n        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n\n\ndef _error(tool_use_id: str, message: str) -> dict:\n    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n\n\ndef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n    if len(messages) <= COMPACT_AFTER_MESSAGES:\n        return messages, False\n    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n    while tail and tail[0][\"role\"] != \"assistant\":\n        tail = tail[1:]\n    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n    return head + [note] + tail, True\n\n\nclass ProcurementAgent:\n    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n        self.client = client\n        self.deps = deps\n        self.system_prompt = system_prompt\n        self.role = role\n\n    async def run(self, ident: RunIdentity, task: str) -> str | None:\n        pool = self.deps.pool\n        await killswitch.assert_running(pool, ident.tenant)\n        budget = Budget.for_run(self.deps.settings.budgets, ident)\n        await budget.reserve_run_start(pool)\n        self.deps._budgets[ident.run_id] = budget\n        registry = build_registry(self.role, ident, self.deps)\n\n        run_node = await audit.record(\n            pool, ident, kind=\"run_started\",\n            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n        )\n        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n        try:\n            while True:\n                budget.check_step()\n                messages, compacted = _compact(messages)\n                request = {\n                    \"model\": self.deps.settings.model_id,\n                    \"system\": self.system_prompt,\n                    \"messages\": messages,\n                    \"tools\": registry.schemas(),\n                    \"max_tokens\": 4096,\n                }\n                ctx = await measure_context(self.client, request, compacted)\n                response = await self.client.messages.create(**request)\n                budget.charge_model(self.deps.settings.model_id, response.usage)\n                await budget.flush(pool)\n                ctx = ctx.finalize(response.usage)\n                decision = await audit.record(\n                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n                    payload={\n                        \"requested_model\": request[\"model\"],\n                        \"served_model\": response.model,\n                        \"stop_reason\": response.stop_reason,\n                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n                    },\n                )\n                messages.append({\"role\": \"assistant\", \"content\": response.content})\n                uses = [b for b in response.content if b.type == \"tool_use\"]\n                if not uses:\n                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n                                       payload={\"final_sha256\": audit.digest(final)})\n                    return final\n                results = []\n                for use in uses:\n                    budget.check_tool_call()\n                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n                messages.append({\"role\": \"user\", \"content\": results})\n        except BudgetExceeded as exc:\n            await audit.record(\n                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n            )\n            await self.deps.slack.post(\n                channel=\"#procurement-agent-ops\",\n                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n            )\n            return None\n        finally:\n            self.deps._budgets.pop(ident.run_id, None)\n\"\"\"Tool registry.\n\nEach agent role gets the tools listed for it in config/tools.yaml. The model\nonly sees schemas for those tools, and the loop rejects any call to a name\nthat is not in the run's registry.\n\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom functools import lru_cache\nfrom typing import Any, Awaitable, Callable\n\nimport yaml\n\nfrom app.identity import RunIdentity\n\nDEFAULT_ROLE = \"procurement\"\n\nInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n\n\n@dataclass(frozen=True)\nclass Tool:\n    name: str\n    description: str\n    input_schema: dict[str, Any]\n    invoke: Invoke\n    target_field: str | None = None\n\n    def target_of(self, args: dict[str, Any]) -> str:\n        if self.target_field is None:\n            return self.name\n        return str(args.get(self.target_field, \"\"))\n\n    def schema(self) -> dict[str, Any]:\n        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n\n\nclass ToolRegistry:\n    def __init__(self, tools: list[Tool]):\n        self._tools = {t.name: t for t in tools}\n\n    def get(self, name: str) -> Tool | None:\n        return self._tools.get(name)\n\n    def names(self) -> list[str]:\n        return sorted(self._tools)\n\n    def schemas(self) -> list[dict[str, Any]]:\n        return [self._tools[n].schema() for n in self.names()]\n\n\n@lru_cache(maxsize=1)\ndef _role_tools(path: str) -> dict[str, list[str]]:\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\n        cfg = yaml.safe_load(fh)\n    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n\n\ndef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n    from app.tools import documents, erp, memory, payments, slack\n\n    available: dict[str, Tool] = {}\n    for module in (documents, erp, memory, payments, slack):\n        for tool in module.tools(deps):\n            available[tool.name] = tool\n\n    roles = _role_tools(str(deps.settings.tools_path))\n    allowed = roles.get(role, roles[DEFAULT_ROLE])\n    return ToolRegistry([available[name] for name in allowed if name in available])\nversion: \"proc-policy-2026.09.3\"\n\n# Operations that change money, vendor records, or purchase commitments.\n# Denied unless a valid approval exists for the operation and its target.\nhigh_impact_tools:\n  - create_purchase_order\n  - pay_invoice\n\nerp:\n  # Namespaces the agent may reach through the generic erp_call tool.\n  read_prefixes:\n    - \"budget.\"\n    - \"vendor.\"\n    - \"invoice.\"\n    - \"po.get\"\n    - \"po.list\"\n  # Scope requested from the STS for each ERP operation; the ERP enforces it.\n  operation_scopes:\n    budget.get_remaining: \"erp.read\"\n    vendor.get: \"erp.read\"\n    vendor.search: \"erp.read\"\n    vendor.update_remit_to: \"erp.read erp.vendor.write\"\n    invoice.get: \"erp.read\"\n    invoice.list_open: \"erp.read\"\n    invoice.mark_paid: \"erp.read erp.invoice.write\"\n    invoice.void: \"erp.read erp.invoice.write\"\n    po.get: \"erp.read\"\n    po.list_open: \"erp.read\"\n    po.create: \"erp.read erp.po.create\"\n\napprovals:\n  ttl_minutes: 60\n  approver_roles:\n    pay_invoice: [ap_manager, finance_controller]\n    create_purchase_order: [budget_owner, finance_controller]\n    post_slack_message: [procurement_lead]\n\nbudgets:\n  per_run:\n    max_steps: 25\n    max_wall_seconds: 300\n    max_tokens: 400000\n    max_cost_usd: 4.00\n    max_tool_calls_per_minute: 30\n    max_subagents: 3\n  quotas_daily_usd:\n    user: 25\n    tenant: 250\n    fleet: 1500\n  run_starts_per_minute:\n    user: 5\n    tenant: 40\n    fleet: 200\n# Tools per agent role, each with the task reason it is granted.\nroles:\n  procurement:\n    tools:\n      read_document: \"Read vendor quotes, invoices and emails that arrived through the mail gateway.\"\n      extract_line_items: \"Delegate line-item extraction from long documents to the extractor.\"\n      get_budget: \"Check remaining department budget before raising a purchase order.\"\n      erp_call: \"Look up vendors, open invoices and purchase orders for matching.\"\n      create_purchase_order: \"Raise a purchase order once a quote is within budget and approved.\"\n      pay_invoice: \"Pay an invoice that is matched to a purchase order and approved.\"\n      post_slack_message: \"Ask staff for missing details and confirm orders with vendors.\"\n      memory_read: \"Recall department preferences and contract terms from earlier runs.\"\n      memory_write: \"Save new department preferences and contract terms.\"\n  extractor:\n    tools:\n      read_document: \"Read the document whose line items are being extracted.\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"4593343d-a812-4a3d-a637-47d1e000547b","uuid":"9840aef7-8c07-4b56-abdf-d974784cdda1","timestamp":"2026-10-20T11:36:52.446Z","tool_use_result":{"stdout":"\"\"\"Procurement agent run loop.\n\nGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\nEvery edge writes an audit node before the next step runs. Budgets are\nchecked before each model turn and each tool call.\n\"\"\"\nfrom __future__ import annotations\n\nimport 