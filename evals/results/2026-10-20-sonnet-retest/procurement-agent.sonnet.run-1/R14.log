s = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n    sweeper = asyncio.create_task(expire_approvals_forever(app))\n    try:\n        yield\n    finally:\n        sweeper.cancel()\n        await pool.close()\n\n\napp = FastAPI(lifespan=lifespan)\napp.include_router(ingest.router)\n\n\ndef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n    settings = request.app.state.settings\n    try:","numLines":70,"startLine":55,"totalLines":197}},"tool_result_meta":[{"id":"toolu_014B1evqyKTjqdEDFnM6D68d","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
