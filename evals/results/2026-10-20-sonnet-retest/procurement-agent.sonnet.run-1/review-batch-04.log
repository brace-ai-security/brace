{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDSASrJR5bikMx8mtSp3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ujn6nPAmd49nRqHMCnj86K","name":"Bash","input":{"command":"cat app/loop.py app/tools/__init__.py app/extractor.py app/mcp_client.py | cat -n | head -900"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12614,"cache_read_input_tokens":29028,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12614},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"76cb02c2-698f-4ad1-ba7d-40467e25828c","uuid":"3f3c2aea-3850-4510-b2fc-35091a8e9de7","timestamp":"2026-10-20T11:47:05.132Z","request_id":"req_011CgDSASbRuFmi3s8yR884R","wire_tool_inputs":{"toolu_01Ujn6nPAmd49nRqHMCnj86K":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-6fibty9i/agent && cat app/loop.py app/tools/__init__.py app/extractor.py app/mcp_client.py | cat -n | head -900"}},"wire_ingest_context":{"toolu_01Ujn6nPAmd49nRqHMCnj86K":{"cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-6fibty9i/agent"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ujn6nPAmd49nRqHMCnj86K","type":"tool_result","content":"     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n   187\t\"\"\"Tool registry.\n   188\t\n   189\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n   190\tonly sees schemas for those tools, and the loop rejects any call to a name\n   191\tthat is not in the run's registry.\n   192\t\"\"\"\n   193\tfrom __future__ import annotations\n   194\t\n   195\tfrom dataclasses import dataclass\n   196\tfrom functools import lru_cache\n   197\tfrom typing import Any, Awaitable, Callable\n   198\t\n   199\timport yaml\n   200\t\n   201\tfrom app.identity import RunIdentity\n   202\t\n   203\tDEFAULT_ROLE = \"procurement\"\n   204\t\n   205\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n   206\t\n   207\t\n   208\t@dataclass(frozen=True)\n   209\tclass Tool:\n   210\t    name: str\n   211\t    description: str\n   212\t    input_schema: dict[str, Any]\n   213\t    invoke: Invoke\n   214\t    target_field: str | None = None\n   215\t\n   216\t    def target_of(self, args: dict[str, Any]) -> str:\n   217\t        if self.target_field is None:\n   218\t            return self.name\n   219\t        return str(args.get(self.target_field, \"\"))\n   220\t\n   221\t    def schema(self) -> dict[str, Any]:\n   222\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n   223\t\n   224\t\n   225\tclass ToolRegistry:\n   226\t    def __init__(self, tools: list[Tool]):\n   227\t        self._tools = {t.name: t for t in tools}\n   228\t\n   229\t    def get(self, name: str) -> Tool | None:\n   230\t        return self._tools.get(name)\n   231\t\n   232\t    def names(self) -> list[str]:\n   233\t        return sorted(self._tools)\n   234\t\n   235\t    def schemas(self) -> list[dict[str, Any]]:\n   236\t        return [self._tools[n].schema() for n in self.names()]\n   237\t\n   238\t\n   239\t@lru_cache(maxsize=1)\n   240\tdef _role_tools(path: str) -> dict[str, list[str]]:\n   241\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n   242\t        cfg = yaml.safe_load(fh)\n   243\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n   244\t\n   245\t\n   246\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n   247\t    from app.tools import documents, erp, memory, payments, slack\n   248\t\n   249\t    available: dict[str, Tool] = {}\n   250\t    for module in (documents, erp, memory, payments, slack):\n   251\t        for tool in module.tools(deps):\n   252\t            available[tool.name] = tool\n   253\t\n   254\t    roles = _role_tools(str(deps.settings.tools_path))\n   255\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n   256\t    return ToolRegistry([available[name] for name in allowed if name in available])\n   257\t\"\"\"Line-item extraction sub-agent.\n   258\t\n   259\tThe parent procurement agent delegates structured extraction to a smaller\n   260\tmodel. The child runs under its own instance id, links to its parent in the\n   261\taudit graph, charges the parent's budget, and gets the extractor tool role.\n   262\t\"\"\"\n   263\tfrom __future__ import annotations\n   264\t\n   265\timport json\n   266\timport logging\n   267\tfrom typing import Any\n   268\t\n   269\tfrom opentelemetry import trace\n   270\t\n   271\tfrom app import audit\n   272\tfrom app.budget import Budget\n   273\tfrom app.context_size import measure_context\n   274\tfrom app.identity import RunIdentity\n   275\tfrom app.redact import redact_for_model\n   276\tfrom app.tools import build_registry\n   277\t\n   278\tlog = logging.getLogger(__name__)\n   279\ttracer = trace.get_tracer(\"procurement.extractor\")\n   280\t\n   281\tEXTRACTOR_ROLE = \"line_item_extractor\"\n   282\tMAX_TURNS = 4\n   283\t\n   284\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n   285\t\n   286\t\n   287\tclass ExtractionFailed(Exception):\n   288\t    pass\n   289\t\n   290\t\n   291\tclass LineItemExtractor:\n   292\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n   293\t        self.client = client\n   294\t        self.settings = settings\n   295\t        self.deps = deps\n   296\t        self.system_prompt = system_prompt\n   297\t\n   298\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n   299\t        budget.check_subagent()\n   300\t        ident = parent.child(role=EXTRACTOR_ROLE)\n   301\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n   302\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n   303\t\n   304\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n   305\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n   306\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n   307\t            start_node = await audit.record(\n   308\t                self.deps.pool,\n   309\t                ident,\n   310\t                kind=\"subagent_started\",\n   311\t                payload={\n   312\t                    \"role\": EXTRACTOR_ROLE,\n   313\t                    \"doc_id\": doc_id,\n   314\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n   315\t                    \"tools\": registry.names(),\n   316\t                },\n   317\t            )\n   318\t\n   319\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   320\t            for _turn in range(MAX_TURNS):\n   321\t                budget.check_step()\n   322\t                request = {\n   323\t                    \"model\": self.settings.extractor_model_id,\n   324\t                    \"system\": self.system_prompt,\n   325\t                    \"messages\": messages,\n   326\t                    \"tools\": registry.schemas(),\n   327\t                    \"max_tokens\": 4096,\n   328\t                }\n   329\t                ctx = await measure_context(self.client, request, compacted=False)\n   330\t                response = await self.client.messages.create(**request)\n   331\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n   332\t                await budget.flush(self.deps.pool)\n   333\t                ctx = ctx.finalize(response.usage)\n   334\t                decision = await audit.record(\n   335\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n   336\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n   337\t                             \"stop_reason\": response.stop_reason},\n   338\t                )\n   339\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   340\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   341\t                if not uses:\n   342\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n   343\t                    items = _parse_items(text)\n   344\t                    await audit.record(\n   345\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n   346\t                        payload={\"items\": len(items)},\n   347\t                    )\n   348\t                    return items\n   349\t                results = []\n   350\t                for use in uses:\n   351\t                    budget.check_tool_call()\n   352\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   353\t                messages.append({\"role\": \"user\", \"content\": results})\n   354\t\n   355\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n   356\t\n   357\t\n   358\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n   359\t    try:\n   360\t        data = json.loads(text)\n   361\t    except json.JSONDecodeError as exc:\n   362\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n   363\t    if not isinstance(data, list) or len(data) > 500:\n   364\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n   365\t    items = []\n   366\t    for raw in data:\n   367\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n   368\t            raise ExtractionFailed(\"unexpected line-item fields\")\n   369\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n   370\t    return items\n   371\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n   372\t\n   373\tOn startup the tool list is fetched and each tool's description and input\n   374\tschema are fingerprinted and compared with the pins in the release manifest.\n   375\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n   376\tinstruction-like content before any of it is shown to the model.\n   377\t\"\"\"\n   378\tfrom __future__ import annotations\n   379\t\n   380\timport hashlib\n   381\timport json\n   382\timport logging\n   383\timport re\n   384\timport uuid\n   385\tfrom typing import Any\n   386\t\n   387\timport httpx\n   388\t\n   389\tfrom app.identity import RunIdentity, TokenBroker\n   390\tfrom app.redact import redact_text\n   391\t\n   392\tlog = logging.getLogger(__name__)\n   393\t\n   394\tMAX_DESCRIPTION_CHARS = 1024\n   395\tSUSPICIOUS_METADATA = [\n   396\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n   397\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n   398\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n   399\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n   400\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n   401\t]\n   402\t\n   403\t\n   404\tclass ToolPinMismatch(Exception):\n   405\t    pass\n   406\t\n   407\t\n   408\tclass UnknownErpOperation(Exception):\n   409\t    pass\n   410\t\n   411\t\n   412\tdef fingerprint(tool: dict[str, Any]) -> str:\n   413\t    material = {\n   414\t        \"name\": tool[\"name\"],\n   415\t        \"description\": tool.get(\"description\", \"\"),\n   416\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n   417\t        \"annotations\": tool.get(\"annotations\", {}),\n   418\t    }\n   419\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n   420\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n   421\t\n   422\t\n   423\tdef scan_metadata(tool: dict[str, Any]) -> None:\n   424\t    description = tool.get(\"description\", \"\")\n   425\t    if len(description) > MAX_DESCRIPTION_CHARS:\n   426\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n   427\t    blob = json.dumps(tool, ensure_ascii=False)\n   428\t    for pattern in SUSPICIOUS_METADATA:\n   429\t        if pattern.search(blob):\n   430\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n   431\t\n   432\t\n   433\tclass ErpMcpClient:\n   434\t    AUDIENCE = \"erp-mcp-gateway\"\n   435\t\n   436\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n   437\t        self.url = url\n   438\t        self.pins = pins\n   439\t        self.broker = broker\n   440\t        self._tools: dict[str, dict[str, Any]] = {}\n   441\t\n   442\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n   443\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n   444\t            resp = await client.post(\n   445\t                self.url,\n   446\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n   447\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n   448\t            )\n   449\t        resp.raise_for_status()\n   450\t        if len(resp.content) > 512_000:\n   451\t            raise ValueError(\"erp response too large\")\n   452\t        body = resp.json()\n   453\t        if \"error\" in body:\n   454\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n   455\t        return body[\"result\"]\n   456\t\n   457\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n   458\t        result = await self._rpc(\"tools/list\", {}, token)\n   459\t        return list(result.get(\"tools\", []))\n   460\t\n   461\t    async def initialize(self, service_ident: RunIdentity) -> None:\n   462\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   463\t        tools = await self._list_tools(token)\n   464\t        for tool in tools:\n   465\t            expected = self.pins.get(tool[\"name\"])\n   466\t            actual = fingerprint(tool)\n   467\t            if expected != actual:\n   468\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n   469\t            scan_metadata(tool)\n   470\t        self._tools = {t[\"name\"]: t for t in tools}\n   471\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   472\t\n   473\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   474\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   475\t            await self.refresh_tools(service_ident)\n   476\t\n   477\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   478\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   479\t        tools = await self._list_tools(token)\n   480\t        self._tools = {t[\"name\"]: t for t in tools}\n   481\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   482\t\n   483\t    def operations(self) -> list[str]:\n   484\t        return sorted(self._tools)\n   485\t\n   486\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   487\t        if operation not in self._tools:\n   488\t            raise UnknownErpOperation(operation)\n   489\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   490\t        result = await self._rpc(\n   491\t            \"tools/call\",\n   492\t            {\n   493\t                \"name\": operation,\n   494\t                \"arguments\": arguments,\n   495\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   496\t            },\n   497\t            token,\n   498\t        )\n   499\t        if result.get(\"isError\"):\n   500\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   501\t        return result.get(\"structuredContent\") or result.get(\"content\")","is_error":false}]},"parent_tool_use_id":null,"session_id":"76cb02c2-698f-4ad1-ba7d-40467e25828c","uuid":"61a15f18-b7de-4686-9b3a-885e016d1a1c","timestamp":"2026-10-20T11:47:05.158Z","tool_use_result":{"stdout":"     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n   187\t\"\"\"Tool registry.\n   188\t\n   189\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n   190\tonly sees schemas for those tools, and the loop rejects any call to a name\n   191\tthat is not in the run's registry.\n   192\t\"\"\"\n   193\tfrom __future__ import annotations\n   194\t\n   195\tfrom dataclasses import dataclass\n   196\tfrom functools import lru_cache\n   197\tfrom typing import Any, Awaitable, Callable\n   198\t\n   199\timport yaml\n   200\t\n   201\tfrom app.identity import RunIdentity\n   202\t\n   203\tDEFAULT_ROLE = \"procurement\"\n   204\t\n   205\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n   206\t\n   207\t\n   208\t@dataclass(frozen=True)\n   209\tclass Tool:\n   210\t    name: str\n   211\t    description: str\n   212\t    input_schema: dict[str, Any]\n   213\t    invoke: Invoke\n   214\t    target_field: str | None = None\n   215\t\n   216\t    def target_of(self, args: dict[str, Any]) -> str:\n   217\t        if self.target_field is None:\n   218\t            return self.name\n   219\t        return str(args.get(self.target_field, \"\"))\n   220\t\n   221\t    def schema(self) -> dict[str, Any]:\n   222\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n   223\t\n   224\t\n   225\tclass ToolRegistry:\n   226\t    def __init__(self, tools: list[Tool]):\n   227\t        self._tools = {t.name: t for t in tools}\n   228\t\n   229\t    def get(self, name: str) -> Tool | None:\n   230\t        return self._tools.get(name)\n   231\t\n   232\t    def names(self) -> list[str]:\n   233\t        return sorted(self._tools)\n   234\t\n   235\t    def schemas(self) -> list[dict[str, Any]]:\n   236\t        return [self._tools[n].schema() for n in self.names()]\n   237\t\n   238\t\n   239\t@lru_cache(maxsize=1)\n   240\tdef _role_tools(path: str) -> dict[str, list[str]]:\n   241\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n   242\t        cfg = yaml.safe_load(fh)\n   243\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n   244\t\n   245\t\n   246\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n   247\t    from app.tools import documents, erp, memory, payments, slack\n   248\t\n   249\t    available: dict[str, Tool] = {}\n   250\t    for module in (documents, erp, memory, payments, slack):\n   251\t        for tool in module.tools(deps):\n   252\t            available[tool.name] = tool\n   253\t\n   254\t    roles = _role_tools(str(deps.settings.tools_path))\n   255\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n   256\t    return ToolRegistry([available[name] for name in allowed if name in available])\n   257\t\"\"\"Line-item extraction sub-agent.\n   258\t\n   259\tThe parent procurement agent delegates structured extraction to a smaller\n   260\tmodel. The child runs under its own instance id, links to its parent in the\n   261\taudit graph, charges the parent's budget, and gets the extractor tool role.\n   262\t\"\"\"\n   263\tfrom __future__ import annotations\n   264\t\n   265\timport json\n   266\timport logging\n   267\tfrom typing import Any\n   268\t\n   269\tfrom opentelemetry import trace\n   270\t\n   271\tfrom app import audit\n   272\tfrom app.budget import Budget\n   273\tfrom app.context_size import measure_context\n   274\tfrom app.identity import RunIdentity\n   275\tfrom app.redact import redact_for_model\n   276\tfrom app.tools import build_registry\n   277\t\n   278\tlog = logging.getLogger(__name__)\n   279\ttracer = trace.get_tracer(\"procurement.extractor\")\n   280\t\n   281\tEXTRACTOR_ROLE = \"line_item_extractor\"\n   282\tMAX_TURNS = 4\n   283\t\n   284\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n   285\t\n   286\t\n   287\tclass ExtractionFailed(Exception):\n   288\t    pass\n   289\t\n   290\t\n   291\tclass LineItemExtractor:\n   292\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n   293\t        self.client = client\n   294\t        self.settings = settings\n   295\t        self.deps = deps\n   296\t        self.system_prompt = system_prompt\n   297\t\n   298\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n   299\t        budget.check_subagent()\n   300\t        ident = parent.child(role=EXTRACTOR_ROLE)\n   301\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n   302\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n   303\t\n   304\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n   305\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n   306\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n   307\t            start_node = await audit.record(\n   308\t                self.deps.pool,\n   309\t                ident,\n   310\t                kind=\"subagent_started\",\n   311\t                payload={\n   312\t                    \"role\": EXTRACTOR_ROLE,\n   313\t                    \"doc_id\": doc_id,\n   314\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n   315\t                    \"tools\": registry.names(),\n   316\t                },\n   317\t            )\n   318\t\n   319\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   320\t            for _turn in range(MAX_TURNS):\n   321\t                budget.check_step()\n   322\t                request = {\n   323\t                    \"model\": self.settings.extractor_model_id,\n   324\t                    \"system\": self.system_prompt,\n   325\t                    \"messages\": messages,\n   326\t                    \"tools\": registry.schemas(),\n   327\t                    \"max_tokens\": 4096,\n   328\t                }\n   329\t                ctx = await measure_context(self.client, request, compacted=False)\n   330\t                response = await self.client.messages.create(**request)\n   331\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n   332\t                await budget.flush(self.deps.pool)\n   333\t                ctx = ctx.finalize(response.usage)\n   334\t                decision = await audit.record(\n   335\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n   336\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n   337\t                             \"stop_reason\": response.stop_reason},\n   338\t                )\n   339\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   340\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   341\t                if not uses:\n   342\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n   343\t                    items = _parse_items(text)\n   344\t                    await audit.record(\n   345\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n   346\t                        payload={\"items\": len(items)},\n   347\t                    )\n   348\t                    return items\n   349\t                results = []\n   350\t                for use in uses:\n   351\t                    budget.check_tool_call()\n   352\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   353\t                messages.append({\"role\": \"user\", \"content\": results})\n   354\t\n   355\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n   356\t\n   357\t\n   358\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n   359\t    try:\n   360\t        data = json.loads(text)\n   361\t    except json.JSONDecodeError as exc:\n   362\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n   363\t    if not isinstance(data, list) or len(data) > 500:\n   364\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n   365\t    items = []\n   366\t    for raw in data:\n   367\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n   368\t            raise ExtractionFailed(\"unexpected line-item fields\")\n   369\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n   370\t    return items\n   371\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n   372\t\n   373\tOn startup the tool list is fetched and each tool's description and input\n   374\tschema are fingerprinted and compared with the pins in the release manifest.\n   375\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n   376\tinstruction-like content before any of it is shown to the model.\n   377\t\"\"\"\n   378\tfrom __future__ import annotations\n   379\t\n   380\timport hashlib\n   381\timport json\n   382\timport logging\n   383\timport re\n   384\timport uuid\n   385\tfrom typing import Any\n   386\t\n   387\timport httpx\n   388\t\n   389\tfrom app.identity import RunIdentity, TokenBroker\n   390\tfrom app.redact import redact_text\n   391\t\n   392\tlog = logging.getLogger(__name__)\n   393\t\n   394\tMAX_DESCRIPTION_CHARS = 1024\n   395\tSUSPICIOUS_METADATA = [\n   396\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n   397\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n   398\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n   399\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n   400\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n   401\t]\n   402\t\n   403\t\n   404\tclass ToolPinMismatch(Exception):\n   405\t    pass\n   406\t\n   407\t\n   408\tclass UnknownErpOperation(Exception):\n   409\t    pass\n   410\t\n   411\t\n   412\tdef fingerprint(tool: dict[str, Any]) -> str:\n   413\t    material = {\n   414\t        \"name\": tool[\"name\"],\n   415\t        \"description\": tool.get(\"description\", \"\"),\n   416\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n   417\t        \"annotations\": tool.get(\"annotations\", {}),\n   418\t    }\n   419\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n   420\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n   421\t\n   422\t\n   423\tdef scan_metadata(tool: dict[str, Any]) -> None:\n   424\t    description = tool.get(\"description\", \"\")\n   425\t    if len(description) > MAX_DESCRIPTION_CHARS:\n   426\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n   427\t    blob = json.dumps(tool, ensure_ascii=False)\n   428\t    for pattern in SUSPICIOUS_METADATA:\n   429\t        if pattern.search(blob):\n   430\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n   431\t\n   432\t\n   433\tclass ErpMcpClient:\n   434\t    AUDIENCE = \"erp-mcp-gateway\"\n   435\t\n   436\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n   437\t        self.url = url\n   438\t        self.pins = pins\n   439\t        self.broker = broker\n   440\t        self._tools: dict[str, dict[str, Any]] = {}\n   441\t\n   442\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n   443\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n   444\t            resp = await client.post(\n   445\t                self.url,\n   446\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n   447\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n   448\t            )\n   449\t        resp.raise_for_status()\n   450\t        if len(resp.content) > 512_000:\n   451\t            raise ValueError(\"erp response too large\")\n   452\t        body = resp.json()\n   453\t        if \"error\" in body:\n   454\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n   455\t        return body[\"result\"]\n   456\t\n   457\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n   458\t        result = await self._rpc(\"tools/list\", {}, token)\n   459\t        return list(result.get(\"tools\", []))\n   460\t\n   461\t    async def initialize(self, service_ident: RunIdentity) -> None:\n   462\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   463\t        tools = await self._list_tools(token)\n   464\t        for tool in tools:\n   465\t            expected = self.pins.get(tool[\"name\"])\n   466\t            actual = fingerprint(tool)\n   467\t            if expected != actual:\n   468\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n   469\t            scan_metadata(tool)\n   470\t        self._tools = {t[\"name\"]: t for t in tools}\n   471\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   472\t\n   473\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   474\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   475\t            await self.refresh_tools(service_ident)\n   476\t\n   477\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   478\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   479\t        tools = await self._list_tools(token)\n   480\t        self._tools = {t[\"name\"]: t for t in tools}\n   481\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   482\t\n   483\t    def operations(self) -> list[str]:\n   484\t        return sorted(self._tools)\n   485\t\n   486\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   487\t        if operation not in self._tools:\n   488\t            raise UnknownErpOperation(operation)\n   489\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   490\t        result = await self._rpc(\n   491\t            \"tools/call\",\n   492\t            {\n   493\t                \"name\": operation,\n   494\t                \"arguments\": arguments,\n   495\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   496\t            },\n   497\t            token,\n   498\t        )\n   499\t        if result.get(\"isError\"):\n   500\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   501\t        return result.get(\"structuredContent\") or result.get(\"content\")","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Ujn6nPAmd49nRqHMCnj86K","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
