 88\t          volumeMounts:\n    89\t            - name: workload-token\n    90\t              mountPath: /var/run/secrets/tokens\n    91\t              readOnly: true\n    92\t            - name: slack-signing\n    93\t              mountPath: /var/run/secrets/slack\n    94\t              readOnly: true\n    95\t            - name: mail-hmac\n    96\t              mountPath: /var/run/secrets/mail\n    97\t              readOnly: true\n    98\t            - name: tmp\n    99\t              mountPath: /tmp\n   100\t      volumes:\n   101\t        - name: workload-token\n   102\t          projected:\n   103\t            sources:\n   104\t              - serviceAccountToken:\n   105\t                  path: procurement-agent\n   106\t                  audience: sts.identity.example-corp.test\n   107\t                  expirationSeconds: 600\n   108\t        - name: slack-signing\n   109\t          secret:\n   110\t            secretName: procurement-slack-signing\n   111\t        - name: mail-hmac\n   112\t          secret:\n   113\t            secretName: procurement-mail-gateway-hmac\n   114\t        - name: tmp\n   115\t          emptyDir:\n   116\t            medium: Memory\n   117\t            sizeLimit: 64Mi\n     1\tapiVersion: networking.k8s.io/v1\n     2\tkind: NetworkPolicy\n     3\tmetadata:\n     4\t  name: procurement-agent-default-deny\n     5\t  namespace: procurement-prod\n     6\tspec:\n     7\t  podSelector: {}\n     8\t  policyTypes: [\"Ingress\", \"Egress\"]\n     9\t---\n    10\tapiVersion: networking.k8s.io/v1\n    11\tkind: NetworkPolicy\n    12\tmetadata:\n    13\t  name: procurement-agent-egress\n    14\t  namespace: procurement-prod\n    15\tspec:\n    16\t  podSelector:\n    17\t    matchLabels:\n    18\t      app: procurement-agent\n    19\t  policyTypes: [\"Egress\"]\n    20\t  egress:\n    21\t    - to:\n    22\t        - namespaceSelector:\n    23\t            matchLabels:\n    24\t              kubernetes.io/metadata.name: kube-system\n    25\t          podSelector:\n    26\t            matchLabels:\n    27\t              k8s-app: kube-dns\n    28\t      ports:\n    29\t        - { protocol: UDP, port: 53 }\n    30\t        - { protocol: TCP, port: 53 }\n    31\t    - to:\n    32\t        - namespaceSelector:\n    33\t            matchLabels:\n    34\t              kubernetes.io/metadata.name: egress\n    35\t          podSelector:\n    36\t            matchLabels:\n    37\t              app: egress-proxy\n    38\t      ports:\n    39\t        - { protocol: TCP, port: 3128 }\n    40\t    - to:\n    41\t        - namespaceSelector:\n    42\t            matchLabels:\n    43\t              kubernetes.io/metadata.name: egress\n    44\t          podSelector:\n    45\t            matchLabels:\n    46\t              app: slack-proxy\n    47\t      ports:\n    48\t        - { protocol: TCP, port: 8443 }\n    49\t    - to:\n    50\t        - namespaceSelector:\n    51\t            matchLabels:\n    52\t              kubernetes.io/metadata.name: procurement-data\n    53\t          podSelector:\n    54\t            matchLabels:\n    55\t              app: procurement-db\n    56\t      ports:\n    57\t        - { protocol: TCP, port: 5432 }\n    58\t    - to:\n    59\t        - namespaceSelector:\n    60\t            matchLabels:\n    61\t              kubernetes.io/metadata.name: erp-mcp-gateway\n    62\t      ports:\n    63\t        - { protocol: TCP, port: 8443 }\n    64\t    - to:\n    65\t        - namespaceSelector:\n    66\t            matchLabels:\n    67\t              kubernetes.io/metadata.name: identity\n    68\t          podSelector:\n    69\t            matchLabels:\n    70\t              app: sts\n    71\t      ports:\n    72\t        - { protocol: TCP, port: 443 }\n    73\t    - to:\n    74\t        - ipBlock:\n    75\t            cidr: 0.0.0.0/0\n    76\t            except:\n    77\t              - 10.0.0.0/8\n    78\t              - 172.16.0.0/12\n    79\t              - 192.168.0.0/16\n    80\t              - 169.254.0.0/16\n    81\t      ports:\n    82\t        - { protocol: TCP, port: 443 }\n    83\t---\n    84\tapiVersion: networking.k8s.io/v1\n    85\tkind: NetworkPolicy\n    86\tmetadata:\n    87\t  name: procurement-agent-ingress\n    88\t  namespace: procurement-prod\n    89\tspec:\n    90\t  podSelector:\n    91\t    matchLabels:\n    92\t      app: procurement-agent\n    93\t  policyTypes: [\"Ingress\"]\n    94\t  ingress:\n    95\t    - from:\n    96\t        - namespaceSelector:\n    97\t            matchLabels:\n    98\t              kubernetes.io/metadata.name: ingress\n    99\t      ports:\n   100\t        - { protocol: TCP, port: 8080 }\n   101\t---\n   102\t# Egress proxy allowlist (applied in the egress namespace by the platform team).\n   103\tapiVersion: v1\n   104\tkind: ConfigMap\n   105\tmetadata:\n   106\t  name: egress-proxy-allowlist-procurement\n   107\t  namespace: egress\n   108\tdata:\n   109\t  allowlist.txt: |\n   110\t    api.anthropic.com\n   111\t    api.payments.example-pay.test\n   112\t    login.example-corp.test\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.11.10-slim-bookworm@sha256:2a6386ad2db20e7f55073f69a98d6da2cf9f168e05e7487d2670c22e4ad2a1bd AS build\n     3\tWORKDIR /src\n     4\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     5\tCOPY pyproject.toml ./\n     6\tCOPY app ./app\n     7\tRUN pip install --target /opt/site .\n     8\tRUN python -m compileall -q app\n     9\t\n    10\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:8f3c1a6e2b9d4f7a0c5e8b1d3f6a9c2e5b8d1f4a7c0e3b6d9f2a5c8e1b4d7f0a\n    11\tWORKDIR /app\n    12\tENV PYTHONPATH=/opt/site:/app \\\n    13\t    PYTHONDONTWRITEBYTECODE=1 \\\n    14\t    APP_ROOT=/app\n    15\tCOPY --from=build /opt/site /opt/site\n    16\tCOPY --from=build /src/app /app/app\n    17\tCOPY prompts /app/prompts\n    18\tCOPY config /app/config\n    19\tCOPY release/manifest.yaml /app/release/manifest.yaml\n    20\tUSER 65532:65532\n    21\tEXPOSE 8080\n    22\tENTRYPOINT [\"python\", \"-m\", \"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\", \"--no-server-header\"]\n     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t\n    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )\n     1\t\"\"\"Operator stop control.\n     2\t\n     3\tOperators halt the fleet or one business unit by setting a row in\n     4\t``control_flags`` with the ``procurement_ops`` database role (see\n     5\tops/README in the platform runbook). The agent's own database role has\n     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\t\n    11\tclass AgentHalted(Exception):\n    12\t    pass\n    13\t\n    14\t\n    15\t_QUERY = \"\"\"\n    16\tSELECT scope, reason, set_by, set_at\n    17\tFROM control_flags\n    18\tWHERE halted\n    19\t  AND (scope = 'fleet' OR scope = $1)\n    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n    21\tLIMIT 1\n    22\t\"\"\"\n    23\t\n    24\t\n    25\tasync def assert_running(pool, tenant: str) -> None:\n    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n    27\t    if row is not None:\n    28\t        raise AgentHalted(\n    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n    31\t        )\n# procurement-agent\n\nProcurement agent for Example Corp business units. It reads vendor quotes and\ninvoices that arrive by email, checks them against department budgets, raises\npurchase orders in the ERP, pays matched invoices, and talks to staff and\nvendors in Slack. It keeps short per-department notes between runs.\n\n## Architecture\n\n```\nmail gateway --HMAC--> /ingest/mail --> documents (Postgres, per business unit)\nstaff (OIDC JWT) ----> /runs --> ProcurementAgent loop (app/loop.py)\n                                   |-- PolicyGate (app/gate.py) + approvals (Slack buttons)\n                                   |-- Budget (app/budget.py)\n                                   |-- audit graph (app/audit.py -> audit_events)\n                                   |-- tools:\n                                   |     read_document, extract_line_items -> LineItemExtractor sub-agent\n                                   |     get_budget, erp_call, create_purchase_order -> ERP MCP via gateway\n                                   |     pay_invoice -> payments API\n                                   |     post_slack_message -> Slack (via slack-proxy)\n                                   |     memory_read, memory_write -> dept_notes\n```\n\n* **Tenancy.** Each run belongs to one business unit, taken from the `bu`\n  claim of the caller's verified OIDC token. Documents, notes, approvals and\n  quotas are keyed by business unit.\n* **Identity.** The agent runs as the `procurement-agent` service account.\n  Its projected token (10-minute lifetime) is exchanged at the internal STS\n  for audience-bound tokens for the ERP gateway, payments API and Slack\n  proxy. User tokens are never forwarded.\n* **Approvals.** `create_purchase_order`, `pay_invoice` and vendor messages\n  require an approval from a role listed in `config/policy.yaml`. Approval\n  requests are posted to `#approvals-<bu>` with the argument summary.\n* **Budgets.** Per-run step, time, token, cost, tool-rate and sub-agent\n  limits, plus per-user, per-business-unit and fleet quotas for daily spend\n  and run starts. See `config/policy.yaml`.\n* **Audit.** Every run step is a row in `audit_events` linked to its parent\n  step, with the six identity fields, policy version, approval id and\n  decision-time context size. The agent's database role can insert audit\n  rows but not update or delete them.\n\n## Context size\n\nLogged on every audit row as `context_tokens` and `context_method`:\n\n| method | meaning |\n|---|---|\n| `count_tokens_api` | exact request counted with the provider's token-count endpoint before the call (includes cached prefix) |\n| `usage_sum_estimate` | counting failed; `input_tokens + cache_read + cache_creation` from the response |\n| `unavailable` | neither available; `context_tokens` is NULL, never 0 |\n\n`context_compacted` is true when the harness dropped earlier turns before the\ncall (`app/loop.py:_compact`). Provider-side truncation is not visible.\n\n## Operating\n\n* **Halt.** Insert or update a row in `control_flags` (`scope = 'fleet'` or\n  `'tenant:<bu>'`, `halted = true`) as `procurement_ops`. New runs refuse to\n  start while a halt is set.\n* **Release.** Merges to `main` build, sign (keyless cosign), and attest the\n  image (SLSA provenance and CycloneDX SBOM). Kyverno rejects unsigned or\n  unattested images in `procurement-prod`.\n* **Network.** Default-deny egress with explicit rules for DNS, the egress\n  proxy, the Slack proxy, the database, the ERP gateway and the STS.\n\n## Tests\n\n```bash\npip install -e '.[test]'\npytest -q\n```\n# Release manifest for the procurement agent. Regenerated by CI on every\n# release build (see .github/workflows/ci.yaml, job \"release\").\nrelease: \"procurement-agent 2026.09.4\"\nowner: team-procurement-platform\n\nimage:\n  repository: registry.example-corp.test/procurement/agent\n  digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n  sbom: \"registry.example-corp.test/procurement/agent:sha256-7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0.sbom\"\n  signer:\n    issuer: \"https://token.actions.githubusercontent.com\"\n    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n\nharness:\n  source_commit: \"3f9a1c7e2b8d4f6a0c5e9b1d7f3a8c2e6b4d0f91\"\n  digest: \"sha256:5b2d8f1a9c3e7b0d4f6a2c8e1b5d9f3a7c0e4b8d2f6a1c5e9b3d7f0a4c8e2b6d\"\n\nprompts:\n  system:\n    path: prompts/system.md\n    sha256: \"sha256:dcf69216667e65a0be3711d99aac81b707ba843296e7ce26d6fcbdb50c5bcc50\"\n  extractor:\n    path: prompts/extractor.md\n    sha256: \"sha256:6ef6527b77ffcca8851e7a8760e6373f3daede15d5b343b878737f0deec28de3\"\n\nconfig:\n  policy:\n    path: config/policy.yaml\n    version: \"proc-policy-2026.09.3\"\n    sha256: \"sha256:d6a55f1e170bdd457958243ddd9aa938f4ca707a3e1e9d1e7bca2a54df33ad32\"\n  tools:\n    path: config/tools.yaml\n    sha256: \"sha256:86dccc3d7d166bf8e131c3b2afbe5f2b846a57eaaf087b55f9e308844eda9400\"\n  network_policy: deploy/k8s/networkpolicy.yaml\n  image_policy: deploy/k8s/kyverno-verify-images.yaml\n\nmodels:\n  primary:\n    role: \"main agent\"\n    owner: team-procurement-platform\n    provider: anthropic\n    model_id: \"claude-sonnet-4-5-20250929\"\n    id_kind: \"pinned snapshot\"\n    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    adapter: none\n    fine_tune: none\n    training_run: \"not applicable\"\n    served_version: \"recorded per call from response.model\"\n    provider_undisclosed: [weights digest, pretraining data version]\n  extractor:\n    role: \"line-item extraction sub-agent\"\n    owner: team-procurement-platform\n    provider: anthropic\n    model_id: \"claude-haiku-4-5-20251001\"\n    id_kind: \"pinned snapshot\"\n    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    adapter: none\n    fine_tune: none\n    training_run: \"not applicable\"\n    served_version: \"recorded per call from response.model\"\n    provider_undisclosed: [weights digest, pretraining data version]\n\nmcp_servers:\n  erp:\n    endpoint: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    owner: team-erp-integrations\n\n# Fingerprints of the approved ERP MCP tools (name, description, inputSchema,\n# annotations), computed by app.mcp_client.fingerprint.\ntool_pins:\n  budget.get_remaining: \"sha256:bc96af69ba1cfd67b5428269dc74aa3e754f4dfe2d5dfa81deb0af68819379ca\"\n  vendor.get: \"sha256:7db5e65fb6d482d06985b19b7f1fce7422398b117bc7482f0380108cd6a6a1fe\"\n  vendor.search: \"sha256:3bd5aa0908885e967ce8ee1aa22e37b4f4fba867c8eac2b4127bca626731092c\"\n  vendor.update_remit_to: \"sha256:d3d3916ee6d742311c92f4972a1ffeb0f24782e729351f3e375f13eb05b94c1b\"\n  invoice.get: \"sha256:848ece38456338a085cb7091a2bbf1024e07946d62beb32a9ee94d2fa2fa8876\"\n  invoice.list_open: \"sha256:12bb2318f3876da6421183032cdd36727e545275e8eaf6fff66451d09371f12b\"\n  invoice.mark_paid: \"sha256:3a208eb55ee3a39962316b5d25fe6ba23457380c01aa39a5469ce3691130b05a\"\n  invoice.void: \"sha256:9645bec805f2ffdfa44f698f49e8701a6487afa3cb3e3c5c44e721cb21633d4c\"\n  po.get: \"sha256:121df83a279fc2ae3764c83faeb34f3037026586991c9192144ad7b727d18d7b\"\n  po.list_open: \"sha256:203c57fd158a8edf11b8dc02be534bc805d8caaf0959db8280f59ea0e5beb70a\"\n  po.create: \"sha256:fb15c157f7d79321972b310d74ee6c88a0fc76fd8edbbe4e821dcaa95a0852c6\"\n\nbudgets: config/policy.yaml#budgets\nidentity:\n  service_account: procurement-agent\n  spiffe_id: \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n  sts_audiences: [erp-mcp-gateway, payments-api, slack-proxy]\nmemory:\n  store: \"postgres procurement.dept_notes\"\n  expiry_unverified_days: 30\nretrieval: none","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_018MNK4Z3G2h4m616HLqZsUT","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
