{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Af96rPGNzYgid33wmr7HJC","type":"tool_result","content":"1+50\t    unflushed_cost_usd: Decimal = Decimal(\"0\")\n2+50\t    subagents: int = 0\n3+50\t    _tool_calls: deque = field(default_factory=deque)\n4+50\t\n5+50\t    @classmethod\n6+50\t    def for_run(cls, cfg: dict, ident: RunIdentity) -> \"Budget\":\n7+50\t        run = cfg[\"per_run\"]\n8+50\t        return cls(\n9+50\t            ident=ident,\n10+50\t            max_steps=int(run[\"max_steps\"]),\n11+50\t            max_wall_seconds=float(run[\"max_wall_seconds\"]),\n12+50\t            max_tokens=int(run[\"max_tokens\"]),\n13+50\t            max_cost_usd=Decimal(str(run[\"max_cost_usd\"])),\n14+50\t            max_tool_calls_per_minute=int(run[\"max_tool_calls_per_minute\"]),\n15+50\t            max_subagents=int(run[\"max_subagents\"]),\n16+50\t            quotas_daily_usd={k: Decimal(str(v)) for k, v in cfg[\"quotas_daily_usd\"].items()},\n17+50\t            run_starts_per_minute={k: int(v) for k, v in cfg[\"run_starts_per_minute\"].items()},\n18+50\t        )\n19+50\t\n20+50\t    def _scopes(self) -> list[tuple[str, str]]:\n21+50\t        return [\n22+50\t            (\"user\", self.ident.accountable_party),\n23+50\t            (\"tenant\", self.ident.tenant),\n24+50\t            (\"fleet\", \"all\"),\n25+50\t        ]\n26+50\t\n27+50\t    # --- per-run limits -------------------------------------------------\n28+50\t\n29+50\t    def check_step(self) -> None:\n30+50\t        self.steps += 1\n31+50\t        if self.steps > self.max_steps:\n32+50\t            raise BudgetExceeded(\"max_steps\", self.steps, self.max_steps)\n33+50\t        elapsed = time.monotonic() - self.started_at\n34+50\t        if elapsed > self.max_wall_seconds:\n35+50\t            raise BudgetExceeded(\"max_wall_seconds\", round(elapsed, 1), self.max_wall_seconds)\n36+50\t\n37+50\t    def charge_model(self, model: str, usage) -> None:\n38+50\t        price_in, price_out = PRICES[model]\n39+50\t        tokens_in = (\n40+50\t            int(usage.input_tokens or 0)\n41+50\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n42+50\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n43+50\t        )\n44+50\t        tokens_out = int(usage.output_tokens or 0)\n45+50\t        self.tokens += tokens_in + tokens_out\n46+50\t        cost = (price_in * tokens_in + price_out * tokens_out) / Decimal(1_000_000)\n47+50\t        self.cost_usd += cost\n48+50\t        self.unflushed_cost_usd += cost\n49+50\t        if self.tokens > self.max_tokens:\n50+50\t            raise BudgetExceeded(\"max_tokens\", self.tokens, self.max_tokens)\n51+50\t        if self.cost_usd > self.max_cost_usd:\n52+50\t            raise BudgetExceeded(\"max_cost_usd\", self.cost_usd, self.max_cost_usd)\n53+50\t\n54+50\t    def check_tool_call(self, now: float | None = None) -> None:\n55+50\t        now = time.monotonic() if now is None else now\n56+50\t        while self._tool_calls and now - self._tool_calls[0] > 60:\n57+50\t            self._tool_calls.popleft()\n58+50\t        if len(self._tool_calls) >= self.max_tool_calls_per_minute:\n59+50\t            raise BudgetExceeded(\n60+50\t                \"max_tool_calls_per_minute\", len(self._tool_calls) + 1, self.max_tool_calls_per_minute\n61+50\t            )\n62+50\t        self._tool_calls.append(now)\n63+50\t\n64+50\t    def check_subagent(self) -> None:\n65+50\t        if self.subagents >= self.max_subagents:\n66+50\t            raise BudgetExceeded(\"max_subagents\", self.subagents + 1, self.max_subagents)\n67+50\t        self.subagents += 1\n68+50\t\n69+50\t    # --- cross-run quotas -----------------------------------------------\n70+50\t\n71+50\t    async def reserve_run_start(self, pool) -> None:\n72+50\t        async with pool.acquire() as conn:\n73+50\t            async with conn.transaction():\n74+50\t                for scope, key in self._scopes():\n75+50\t                    limit = self.run_starts_per_minute[scope]\n76+50\t                    count = await conn.fetchval(\n77+50\t                        \"\"\"\n78+50\t                        INSERT INTO run_start_window (scope, key, minute, starts)\n79+50\t                        VALUES ($1, $2, date_trunc('minute', now()), 1)\n80+50\t                        ON CONFLICT (scope, key, minute)\n81+50\t                        DO UPDATE SET starts = run_start_window.starts + 1\n82+50\t                        RETURNING starts\n83+50\t                        \"\"\",\n84+50\t                        scope,\n85+50\t                        key,\n86+50\t                    )\n87+50\t                    if count > limit:\n88+50\t                        raise BudgetExceeded(f\"run_starts_per_minute.{scope}\", count, limit)\n89+50\t\n90+50\t    async def flush(self, pool) -> None:\n91+50\t        \"\"\"Add this run's unflushed spend to the daily quotas, or stop the run.\"\"\"\n92+50\t        if self.unflushed_cost_usd <= 0:\n93+50\t            return\n94+50\t        amount = self.unflushed_cost_usd\n95+50\t        async with pool.acquire() as conn:\n96+50\t            async with conn.transaction():\n97+50\t                for scope, key in self._scopes():\n98+50\t                    limit = self.quotas_daily_usd[scope]\n99+50\t                    spent = await conn.fetchval(\n100+50\t                        \"\"\"\n101+50\t                        INSERT INTO spend_quota (scope, key, day, spent_usd)\n102+50\t                        VALUES ($1, $2, current_date, $3)\n103+50\t                        ON CONFLICT (scope, key, day)\n104+50\t                        DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd\n105+50\t                        RETURNING spent_usd\n106+50\t                        \"\"\",\n107+50\t                        scope,\n108+50\t                        key,\n109+50\t                        amount,\n110+50\t                    )\n111+50\t                    if spent > limit:\n112+50\t                        raise BudgetExceeded(f\"quota_daily_usd.{scope}\", spent, limit)\n113+50\t        self.unflushed_cost_usd = Decimal(\"0\")\n     1\t\"\"\"Tool registry.\n     2\t\n     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n     5\tthat is not in the run's registry.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom functools import lru_cache\n    11\tfrom typing import Any, Awaitable, Callable\n    12\t\n    13\timport yaml\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\t\n    17\tDEFAULT_ROLE = \"procurement\"\n    18\t\n    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Tool:\n    24\t    name: str\n    25\t    description: str\n    26\t    input_schema: dict[str, Any]\n    27\t    invoke: Invoke\n    28\t    target_field: str | None = None\n    29\t\n    30\t    def target_of(self, args: dict[str, Any]) -> str:\n    31\t        if self.target_field is None:\n    32\t            return self.name\n    33\t        return str(args.get(self.target_field, \"\"))\n    34\t\n    35\t    def schema(self) -> dict[str, Any]:\n    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n    37\t\n    38\t\n    39\tclass ToolRegistry:\n    40\t    def __init__(self, tools: list[Tool]):\n    41\t        self._tools = {t.name: t for t in tools}\n    42\t\n    43\t    def get(self, name: str) -> Tool | None:\n    44\t        return self._tools.get(name)\n    45\t\n    46\t    def names(self) -> list[str]:\n    47\t        return sorted(self._tools)\n    48\t\n    49\t    def schemas(self) -> list[dict[str, Any]]:\n    50\t        return [self._tools[n].schema() for n i