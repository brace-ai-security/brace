false\n    70\t            privileged: false\n    71\t            readOnlyRootFilesystem: true\n    72\t            runAsNonRoot: true\n    73\t            capabilities:\n    74\t              drop: [\"ALL\"]\n    75\t            seccompProfile:\n    76\t              type: RuntimeDefault\n    77\t          resources:\n    78\t            requests:\n    79\t              cpu: 250m\n    80\t              memory: 512Mi\n    81\t            limits:\n    82\t              cpu: \"1\"\n    83\t              memory: 1Gi\n    84\t          readinessProbe:\n    85\t            httpGet:\n    86\t              path: /healthz\n    87\t              port: http\n    88\t          volumeMounts:\n    89\t            - name: workload-token\n    90\t              mountPath: /var/run/secrets/tokens\n    91\t              readOnly: true\n    92\t            - name: slack-signing\n    93\t              mountPath: /var/run/secrets/slack\n    94\t              readOnly: true\n    95\t            - name: mail-hmac\n    96\t              mountPath: /var/run/secrets/mail\n    97\t              readOnly: true\n    98\t            - name: tmp\n    99\t              mountPath: /tmp\n   100\t      volumes:\n   101\t        - name: workload-token\n   102\t          projected:\n   103\t            sources:\n   104\t              - serviceAccountToken:\n   105\t                  path: procurement-agent\n   106\t                  audience: sts.identity.example-corp.test\n   107\t                  expirationSeconds: 600\n   108\t        - name: slack-signing\n   109\t          secret:\n   110\t            secretName: procurement-slack-signing\n   111\t        - name: mail-hmac\n   112\t          secret:\n   113\t            secretName: procurement-mail-gateway-hmac\n   114\t        - name: tmp\n   115\t          emptyDir:\n   116\t            medium: Memory\n   117\t            sizeLimit: 64Mi\n     1\t\"\"\"Inbound documents: vendor quotes and invoices from the mail gateway.\n     2\t\n     3\tThe mail gateway posts each received message to ``/ingest/mail`` signed with\n     4\tan HMAC over the timestamp and body. Accepted documents are stored per\n     5\tbusiness unit and are only ever shown to the model inside an\n     6\t``untrusted_document`` wrapper (tools/documents.py).\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport base64\n    11\timport email\n    12\timport email.policy\n    13\timport hashlib\n    14\timport hmac\n    15\timport io\n    16\timport re\n    17\timport time\n    18\timport uuid\n    19\tfrom dataclasses import dataclass\n    20\tfrom pathlib import Path\n    21\t\n    22\tfrom fastapi import APIRouter, HTTPException, Request\n    23\tfrom pypdf import PdfReader\n    24\t\n    25\trouter = APIRouter()\n    26\t\n    27\tMAX_BODY_BYTES = 10 * 1024 * 1024\n    28\tMAX_TEXT_CHARS = 200_000\n    29\tMAX_SKEW_SECONDS = 300\n    30\tALLOWED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\", \"message/rfc822\"}\n    31\tSCANNED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\"}\n    32\t\n    33\tINJECTION_PATTERNS = [\n    34\t    re.compile(r\"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)\"),\n    35\t    re.compile(r\"(?i)\\b(system|developer) (prompt|message)\\b\"),\n    36\t    re.compile(r\"(?i)\\byou are (now )?(an?|the) \\w+ (agent|assistant)\\b\"),\n    37\t    re.compile(r\"(?i)\\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\\b\"),\n    38\t    re.compile(r\"(?i)\\b(update|change) (our|the) (bank|remit|payee)\\b\"),\n    39\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    40\t]\n    41\t\n    42\t\n    43\tclass Rejected(Exception):\n    44\t    pass\n    45\t\n    46\t\n    47\t@dataclass\n    48\tclass Inbound:\n    49\t    business_unit: str\n    50\t    sender: str\n    51\t    media_type: str\n    52\t    raw: bytes\n    53\t\n    54\t\n    55\tdef verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:\n    56\t    try:\n    57\t        ts = int(timestamp)\n    58\t    except ValueError as exc:\n    59\t        raise Rejected(\"bad timestamp\") from exc\n    60\t    if abs(time.time() - ts) > MAX_SKEW_SECONDS:\n    61\t        raise Rejected(\"stale request\")\n    62\t    expected = hmac.new(key, f\"{timestamp}.\".encode() + body, hashlib.sha256).hexdigest()\n    63\t    if not hmac.compare_digest(expected, signature):\n    64\t        raise Rejected(\"bad signature\")\n    65\t\n    66\t\n    67\tdef extract_text(doc: Inbound) -> str:\n    68\t    if doc.media_type == \"application/pdf\":\n    69\t        reader = PdfReader(io.BytesIO(doc.raw))\n    70\t        if len(reader.pages) > 50:\n    71\t            raise Rejected(\"too many pages\")\n    72\t        return \"\\n\".join(page.extract_text() or \"\" for page in reader.pages)\n    73\t    if doc.media_type == \"message/rfc822\":\n    74\t        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)\n    75\t        body = msg.get_body(preferencelist=(\"plain\", \"html\"))\n    76\t        return body.get_content() if body is not None else \"\"\n    77\t    return doc.raw.decode(\"utf-8\", errors=\"strict\")\n    78\t\n    79\t\n    80\tdef scan_for_injection(text: str) -> list[str]:\n    81\t    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]\n    82\t\n    83\t\n    84\tdef validate(doc: Inbound) -> str:\n    85\t    if doc.media_type not in ALLOWED_MEDIA_TYPES:\n    86\t        raise Rejected(f\"media type {doc.media_type} not accepted\")\n    87\t    if len(doc.raw) > MAX_BODY_BYTES:\n    88\t        raise Rejected(\"document too large\")\n    89\t    try:\n    90\t        text = extract_text(doc)\n    91\t    except Rejected:\n    92\t        raise\n    93\t    except Exception as exc:\n    94\t        raise Rejected(f\"unreadable document: {type(exc).__name__}\") from exc\n    95\t    if len(text) > MAX_TEXT_CHARS:\n    96\t        raise Rejected(\"extracted text too long\")\n    97\t    if doc.media_type in SCANNED_MEDIA_TYPES:\n    98\t        findings = scan_for_injection(text)\n    99\t        if findings:\n   100\t            raise Rejected(\"possible prompt injection: \" + \"; \".join(findings))\n   101\t    return text\n   102\t\n   103\t\n   104\t@router.post(\"/ingest/mail\")\n   105\tasync def ingest_mail(request: Request) -> dict:\n   106\t    body = await request.body()\n   107\t    if len(body) > MAX_BODY_BYTES * 2:\n   108\t        raise HTTPException(413, \"payload too large\")\n   109\t    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()\n   110\t    try:\n   111\t        verify_signature(\n   112\t            key,\n   113\t            request.headers.get(\"X-Gateway-Timestamp\", \"\"),\n   114\t            body,\n   115\t            request.headers.get(\"X-Gateway-Signature\", \"\"),\n   116\t        )\n   117\t    except Rejected as exc:\n   118\t        raise HTTPException(401, str(exc)) from exc\n   119\t\n   120\t    payload = await request.json()\n   121\t    doc = Inbound(\n   122\t        business_unit=payload[\"business_unit\"],\n   123\t        sender=payload[\"from\"],\n   124\t        media_type=payload[\"media_type\"],\n   125\t        raw=base64.b64decode(payload[\"content_b64\"], validate=True),\n   126\t    )\n   127\t    doc_id = f\"doc-{uuid.uuid4().hex[:20]}\"\n   128\t    pool = request.app.state.pool\n   129\t    try:\n   130\t        text = validate(doc)\n   131\t    except Rejected as exc:\n   132\t        await pool.execute(\n   133\t            \"\"\"\n   134\t            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)\n   135\t            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())\n   136\t            \"\"\",\n   137\t            doc_id, doc.business_unit, doc.sender, doc.media_type,\n   138\t            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],\n   139\t        )\n   140\t        return {\"doc_id\": doc_id, \"status\": \"quarantined\"}\n   141\t\n   142\t    await pool.execute(\n   143\t        \"\"\"\n   144\t        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)\n   145\t        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())\n   146\t        \"\"\",\n   147\t        doc_id, doc.business_unit, doc.sender, doc.media_type,\n   148\t        hashlib.sha256(doc.raw).hexdigest(), text,\n   149\t    )\n   150\t    return {\"doc_id\": doc_id, \"status\": \"accepted\"}\n     1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n     2\t\n     3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n     4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n     5\tuntil a procurement lead verifies them in the admin UI. Every row records\n     6\twho wrote it, from which run and source document, and the context size at\n     7\tthe time.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport re\n    12\timport uuid\n    13\tfrom typing import Any\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\tfrom app.tools import Tool\n    17\t\n    18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n    19\tMAX_NOTE_CHARS = 800\n    20\tINSTRUCTION_LIKE = [\n    21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n    22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n    23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n    24\t    re.compile(r\"https?://\"),\n    25\t]\n    26\t\n    27\t\n    28\tclass NoteRejected(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tdef check_note(text: str) -> None:\n    33\t    if len(text) > MAX_NOTE_CHARS:\n    34\t        raise NoteRejected(\"note too long\")\n    35\t    for pattern in INSTRUCTION_LIKE:\n    36\t        if pattern.search(text):\n    37\t            raise NoteRejected(\"note looks like an instruction\")\n    38\t\n    39\t\n    40\tdef tools(deps) -> list[Tool]:\n    41\t    pool = deps.pool\n    42\t\n    43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n    44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n    45\t        rows = await pool.fetch(\n    46\t            \"\"\"\n    47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n    48\t            FROM dept_notes\n    49\t            WHERE business_unit = $1\n    50\t              AND department = $2\n    51\t              AND NOT quarantined\n    52\t              AND (verified OR expires_at > now())\n    53\t            ORDER BY created_at DESC\n    54\t            LIMIT 20\n    55\t            \"\"\",\n    56\t            business_unit,\n    57\t            args[\"department\"],\n    58\t        )\n    59\t        return [\n    60\t            {\n    61\t                \"note_id\": r[\"note_id\"],\n    62\t                \"kind\": r[\"kind\"],\n    63\t                \"body\": r[\"body\"],\n    64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n    65\t                \"written\": r[\"created_at\"].isoformat(),\n    66\t            }\n    67\t            for r in rows\n    68\t        ]\n    69\t\n    70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n    71\t        if args[\"kind\"] not in NOTE_KINDS:\n    72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n    73\t        check_note(args[\"body\"])\n    74\t        note_id = f\"note-{uuid.uuid4()}\"\n    75\t        ctx = deps.current_context(ident)\n    76\t        await pool.execute(\n    77\t            \"\"\"\n    78\t            INSERT INTO dept_notes (\n    79\t                note_id, business_unit, department, kind, body,\n    80\t                verified, quarantined, expires_at,\n    81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n    82\t                delegated_subject, context_tokens, context_method, created_at\n    83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n    84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n    85\t            \"\"\",\n    86\t            note_id,\n    87\t            ident.tenant,\n    88\t            args[\"department\"],\n    89\t            args[\"kind\"],\n    90\t            args[\"body\"],\n    91\t            ident.agent_instance_id,\n    92\t            ident.agent_type_id,\n    93\t            ident.run_id,\n    94\t            args.get(\"source_doc_id\"),\n    95\t            ident.delegated_subject,\n    96\t            ctx.tokens,\n    97\t            ctx.method,\n    98\t        )\n    99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n   100\t\n   101\t    return [\n   102\t        Tool(\n   103\t            name=\"memory_read\",\n   104\t            description=(\n   105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n   106\t                \"shared-services staff may look up another unit's notes.\"\n   107\t            ),\n   108\t            input_schema={\n   109\t                \"type\": \"object\",\n   110\t                \"properties\": {\n   111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n   113\t                },\n   114\t                \"required\": [\"department\"],\n   115\t                \"additionalProperties\": False,\n   116\t            },\n   117\t            invoke=memory_read,\n   118\t        ),\n   119\t        Tool(\n   120\t            name=\"memory_write\",\n   121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n   122\t            input_schema={\n   123\t                \"type\": \"object\",\n   124\t                \"properties\": {\n   125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n   127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n   128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n   129\t                },\n   130\t                \"required\": [\"department\", \"kind\", \"body\"],\n   131\t                \"additionalProperties\": False,\n   132\t            },\n   133\t            invoke=memory_write,\n   134\t        ),\n   135\t    ]\n     1\t\"\"\"Slack tool: message staff and vendors, plus the approvals notifier.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom datetime import datetime\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.redact import redact_text, strip_unapproved_links\n    11\tfrom app.tools import Tool\n    12\t\n    13\tMAX_TEXT = 3000\n    14\t\n    15\t\n    16\tdef clean_outbound(text: str) -> str:\n    17\t    return strip_unapproved_links(redact_text(text))[:MAX_TEXT]\n    18\t\n    19\t\n    20\tclass SlackClient:\n    21\t    def __init__(self, api_url: str, bot_token_provider):\n    22\t        self.api_url = api_url\n    23\t        self._token = bot_token_provider\n    24\t\n    25\t    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:\n    26\t        payload: dict[str, Any] = {\n    27\t            \"channel\": channel,\n    28\t            \"text\": clean_outbound(text),\n    29\t            \"unfurl_links\": False,\n    30\t            \"unfurl_media\": False,\n    31\t            \"mrkdwn\": True,\n    32\t        }\n    33\t        if blocks:\n    34\t            payload[\"blocks\"] = blocks\n    35\t        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:\n    36\t            resp = await client.post(\n    37\t                f\"{self.api_url}/chat.postMessage\",\n    38\t                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\n    39\t                json=payload,\n    40\t            )\n    41\t        resp.raise_for_status()\n    42\t        body = resp.json()\n    43\t        if not body.get(\"ok\"):\n    44\t            raise RuntimeError(f\"slack error: {body.get('error')}\")\n    45\t        return {\"channel\": body[\"channel\"], \"ts\": body[\"ts\"]}\n    46\t\n    47\t    async def post_approval_request(\n    48\t        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\n    49\t    ) -> None:\n    50\t        lines = \"\\n\".join(f\"• *{k}*: `{v}`\" for k, v in summary.items())\n    51\t        text = f\"Approval needed for `{tool}` on `{target}` (expires {expires_at:%Y-%m-%d %H:%M} UTC)\\n{lines}\"\n    52\t        await self.post(\n    53\t            channel=f\"#approvals-{tenant}\",\n    54\t            text=text,\n    55\t            blocks=[\n    56\t                {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": clean_outbound(text)}},\n    57\t                {\n    58\t                    \"type\": \"actions\",\n    59\t                    \"elements\": [\n    60\t                        {\"type\": \"button\", \"action_id\": \"approve\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Approve\"}, \"style\": \"primary\"},\n    61\t                        {\"type\": \"button\", \"action_id\": \"reject\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Reject\"}, \"style\": \"danger\"},\n    62\t                    ],\n    63\t                },\n    64\t            ],\n    65\t        )\n    66\t\n    67\t\n    68\tdef tools(deps) -> list[Tool]:\n    69\t    slack: SlackClient = deps.slack\n    70\t\n    71\t    async def post_slack_message(args: dict[str, Any], ident: RunIdentity) -> Any:\n    72\t        return await slack.post(channel=args[\"channel\"], text=args[\"text\"])\n    73\t\n    74\t    return [\n    75\t        Tool(\n    76\t            name=\"post_slack_message\",\n    77\t            description=(\n    78\t                \"Post a message in Slack. Use internal channels for staff. Vendor contacts are in \"\n    79\t                \"Slack Connect channels named #vendor-<vendor_id>; set external=true for those.\"\n    80\t            ),\n    81\t            input_schema={\n    82\t                \"type\": \"object\",\n    83\t                \"properties\": {\n    84\t                    \"channel\": {\"type\": \"string\", \"maxLength\": 80},\n    85\t                    \"text\": {\"type\": \"string\", \"maxLength\": MAX_TEXT},\n    86\t                    \"external\": {\"type\": \"boolean\", \"default\": False},\n    87\t                },\n    88\t                \"required\": [\"channel\", \"text\"],\n    89\t                \"additionalProperties\": False,\n    90\t            },\n    91\t            invoke=post_slack_message,\n    92\t            target_field=\"channel\",\n    93\t        )\n    94\t    ]\n     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tUNTRUSTED_WRAPPER = (\n    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n    11\t    \"{text}\\n\"\n    12\t    \"</untrusted_document>\"\n    13\t)\n    14\t\n    15\t\n    16\tdef tools(deps) -> list[Tool]:\n    17\t    pool = deps.pool\n    18\t\n    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n    20\t        row = await pool.fetchrow(\n    21\t            \"\"\"\n    22\t            SELECT doc_id, source, media_type, text\n    23\t            FROM documents\n    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n    25\t            \"\"\",\n    26\t            args[\"doc_id\"],\n    27\t            ident.tenant,\n    28\t        )\n    29\t        if row is None:\n    30\t            return \"document not found\"\n    31\t        return UNTRUSTED_WRAPPER.format(\n    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n    33\t        )\n    34\t\n    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n    37\t\n    38\t    return [\n    39\t        Tool(\n    40\t            name=\"read_document\",\n    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n    42\t            input_schema={\n    43\t                \"type\": \"object\",\n    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    45\t                \"required\": [\"doc_id\"],\n    46\t                \"additionalProperties\": False,\n    47\t            },\n    48\t            invoke=read_document,\n    49\t        ),\n    50\t        Tool(\n    51\t            name=\"extract_line_items\",\n    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n    53\t            input_schema={\n    54\t                \"type\": \"object\",\n    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    56\t                \"required\": [\"doc_id\"],\n    57\t                \"additionalProperties\": False,\n    58\t            },\n    59\t            invoke=extract_line_items,\n    60\t        ),\n    61\t    ]\n     1\t\"\"\"Approval requests and decisions for high-impact operations.\n     2\t\n     3\tRequests are posted to the business unit's approvals channel in Slack with\n     4\tthe full argument summary. Approvers decide with the Slack buttons; the\n     5\tinteractive callback is signature-checked in main.py and then calls\n     6\t``decide``. Approver authority is checked against the role map in policy.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport json\n    11\timport uuid\n    12\tfrom dataclasses import dataclass\n    13\tfrom datetime import datetime, timedelta, timezone\n    14\tfrom typing import Any\n    15\t\n    16\tfrom app.audit import digest, summarize_args\n    17\tfrom app.identity import RunIdentity\n    18\t\n    19\t\n    20\t@dataclass(frozen=True)\n    21\tclass Approval:\n    22\t    id: str\n    23\t    approver: str\n    24\t    approver_role: str\n    25\t    expires_at: datetime\n    26\t\n    27\t\n    28\tclass ApproverNotAuthorized(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tclass ApprovalStore:\n    33\t    def __init__(self, pool, policy: dict, notifier):\n    34\t        self.pool = pool\n    35\t        self.ttl = timedelta(minutes=int(policy[\"approvals\"][\"ttl_minutes\"]))\n    36\t        self.approver_roles: dict[str, list[str]] = policy[\"approvals\"][\"approver_roles\"]\n    37\t        self.notifier = notifier\n    38\t\n    39\t    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n    40\t        approval_id = f\"apr-{uuid.uuid4()}\"\n    41\t        expires_at = datetime.now(timezone.utc) + self.ttl\n    42\t        await self.pool.execute(\n    43\t            \"\"\"\n    44\t            INSERT INTO approvals (\n    45\t                id, tool, target, args_sha256, args_summary, tenant,\n    46\t                requested_by_instance, requested_by_run, delegated_subject,\n    47\t                status, requested_at, expires_at\n    48\t            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)\n    49\t            \"\"\",\n    50\t            approval_id,\n    51\t            tool,\n    52\t            target,\n    53\t            digest(args),\n    54\t            json.dumps(summarize_args(args)),\n    55\t            ident.tenant,\n    56\t            ident.agent_instance_id,\n    57\t            ident.run_id,\n    58\t            ident.delegated_subject,\n    59\t            expires_at,\n    60\t        )\n    61\t        await self.notifier.post_approval_request(\n    62\t            tenant=ident.tenant,\n    63\t            approval_id=approval_id,\n    64\t            tool=tool,\n    65\t            target=target,\n    66\t            summary=summarize_args(args),\n    67\t            expires_at=expires_at,\n    68\t        )\n    69\t        return approval_id\n    70\t\n    71\t    async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:\n    72\t        row = await self.pool.fetchrow(\n    73\t            \"\"\"\n    74\t            SELECT id, approver, approver_role, expires_at\n    75\t            FROM approvals\n    76\t            WHERE tool = $1\n    77\t              AND target = $2\n    78\t              AND tenant = $3\n    79\t              AND status = 'approved'\n    80\t              AND expires_at > now()\n    81\t            ORDER BY decided_at DESC\n    82\t            LIMIT 1\n    83\t            \"\"\",\n    84\t            tool,\n    85\t            target,\n    86\t            ident.tenant,\n    87\t        )\n    88\t        if row is None:\n    89\t            return None\n    90\t        if row[\"approver_role\"] not in self.approver_roles.get(tool, []):\n    91\t            return None\n    92\t        return Approval(row[\"id\"], row[\"approver\"], row[\"approver_role\"], row[\"expires_at\"])\n    93\t\n    94\t    async def decide(self, approval_id: str, approver: str, approver_role: str, approve: bool) -> None:\n    95\t        row = await self.pool.fetchrow(\n    96\t            \"SELECT tool, status, expires_at FROM approvals WHERE id = $1\", approval_id\n    97\t        )\n    98\t        if row is None or row[\"status\"] != \"pending\":\n    99\t            raise ValueError(\"approval is not pending\")\n   100\t        if row[\"expires_at\"] <= datetime.now(timezone.utc):\n   101\t            raise ValueError(\"approval request expired\")\n   102\t        if approver_role not in self.approver_roles.get(row[\"tool\"], []):\n   103\t            raise ApproverNotAuthorized(f\"{approver_role} cannot approve {row['tool']}\")\n   104\t        await self.pool.execute(\n   105\t            \"\"\"\n   106\t            UPDATE approvals\n   107\t            SET status = $2, approver = $3, approver_role = $4, decided_at = now()\n   108\t            WHERE id = $1 AND status = 'pending'\n   109\t            \"\"\",\n   110\t            approval_id,\n   111\t            \"approved\" if approve else \"rejected\",\n   112\t            approver,\n   113\t            approver_role,\n   114\t        )\n     1\tversion: \"proc-policy-2026.09.3\"\n     2\t\n     3\t# Operations that change money, vendor records, or purchase commitments.\n     4\t# Denied unless a valid approval exists for the operation and its target.\n     5\thigh_impact_tools:\n     6\t  - create_purchase_order\n     7\t  - pay_invoice\n     8\t\n     9\terp:\n    10\t  # Namespaces the agent may reach through the generic erp_call tool.\n    11\t  read_prefixes:\n    12\t    - \"budget.\"\n    13\t    - \"vendor.\"\n    14\t    - \"invoice.\"\n    15\t    - \"po.get\"\n    16\t    - \"po.list\"\n    17\t  # Scope requested from the STS for each ERP operation; the ERP enforces it.\n    18\t  operation_scopes:\n    19\t    budget.get_remaining: \"erp.read\"\n    20\t    vendor.get: \"erp.read\"\n    21\t    vendor.search: \"erp.read\"\n    22\t    vendor.update_remit_to: \"erp.read erp.vendor.write\"\n    23\t    invoice.get: \"erp.read\"\n    24\t    invoice.list_open: \"erp.read\"\n    25\t    invoice.mark_paid: \"erp.read erp.invoice.write\"\n    26\t    invoice.void: \"erp.read erp.invoice.write\"\n    27\t    po.get: \"erp.read\"\n    28\t    po.list_open: \"erp.read\"\n    29\t    po.create: \"erp.read erp.po.create\"\n    30\t\n    31\tapprovals:\n    32\t  ttl_minutes: 60\n    33\t  approver_roles:\n    34\t    pay_invoice: [ap_manager, finance_controller]\n    35\t    create_purchase_order: [budget_owner, finance_controller]\n    36\t    post_slack_message: [procurement_lead]\n    37\t\n    38\tbudgets:\n    39\t  per_run:\n    40\t    max_steps: 25\n    41\t    max_w","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-ysk57i1d/b3a9985e-4bd1-424d-aebf-bec24cea55b1/tool-results/bizvqmzzw.txt","persistedOutputSize":32133},"tool_result_meta":[{"id":"toolu_01GtavNBkQ4rra69pBkYuLiW","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
