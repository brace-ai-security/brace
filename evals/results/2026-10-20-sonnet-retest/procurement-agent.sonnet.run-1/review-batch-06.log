oc, item):\n    for f in doc[\"findings\"]:\n        if f[\"item\"] == item:\n            return f\n    sys.exit(f\"{item} isn't in this findings file.\")\n\n\ndef next_open(doc):\n    for f in doc[\"findings\"]:\n        for c in f.get(\"checks\", []):\n            if c.get(\"met\") == \"unknown\" and not norm(c.get(\"note\", \"\")):\n                return f\"Next: {c['id']} — {c.get('check', '')}\\n  How to verify: {c.get('verify', '')}\"\n        if str(f.get(\"summary\", \"\")).startswith(\"TODO\"):\n            return f\"Next: finish item {f['item']} with `answer.py ... item {f['item']} --rating ...`\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"b3a9985e-4bd1-424d-aebf-bec24cea55b1","uuid":"29584802-b806-4a54-a12b-4f97277b3f68","timestamp":"2026-10-20T11:55:49.763Z","tool_use_result":{"stdout":"<class 'dict'> ['A01', 'A02', 'A03', 'A04', 'A05']\n{\n \"id\": \"A01.1\",\n \"coverage_required\": true\n}\n{\n \"id\": \"A02.4\",\n \"coverage_required\": true\n}\n{\n \"id\": \"A03.3\",\n \"coverage_required\": true\n}\n{\n \"id\": \"A03.4\",\n \"coverage_required\": true,\n \"doc_ok\": true\n}\n{\n \"id\": \"A04.3\",\n \"coverage_required\": true\n}\n{\n \"id\": \"A04.5\",\n \"coverage_required\": true\n}\n{\n \"id\": \"R14.1\",\n \"coverage_required\": true\n}\n5:python review_coverage.py ledger FINDINGS.json CHECK --rows rows.json --attempts attempts.json\n79:        result['attempt_categories'] = ATTEMPTS[cid]\n84:    \"\"\"Validate a positive claim, including candidate coverage and bypass attempts.\"\"\"\n122:    attempts = c.get('attempts', [])\n123:    if not isinstance(attempts, list):\n124:        return errors + ['attempts must be a list']\n125:    categories = set()\n126:    for attempt in attempts:\n127:        if not isinstance(attempt, dict):\n128:            errors.append('attempts must be objects')\n130:        if isinstance(attempt.get('category'), str):\n131:            categories.add(attempt['category'])\n132:        if (attempt.ge