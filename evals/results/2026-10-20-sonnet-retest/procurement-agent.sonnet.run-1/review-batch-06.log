{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C9HjBL9rkKCsAQv13yXJ4h","type":"tool_result","content":"     1\t\"\"\"Policy gate for tool calls.\n     2\t\n     3\tRuns in the harness between the model's proposed call and the integration.\n     4\tHigh-impact operations are denied unless a valid approval exists; when none\n     5\texists an approval request is opened and the call returns as pending.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom typing import Any\n    11\t\n    12\tfrom app.approvals import ApprovalStore\n    13\tfrom app.identity import RunIdentity\n    14\t\n    15\t\n    16\t@dataclass(frozen=True)\n    17\tclass Decision:\n    18\t    allow: bool\n    19\t    reason: str\n    20\t    policy_version: str\n    21\t    approval_id: str | None = None\n    22\t    pending: bool = False\n    23\t\n    24\t\n    25\tclass PolicyGate:\n    26\t    def __init__(self, policy: dict, approvals: ApprovalStore):\n    27\t        self.version: str = policy[\"version\"]\n    28\t        self.high_impact: frozenset[str] = frozenset(policy[\"high_impact_tools\"])\n    29\t        self.erp_read_prefixes: tuple[str, ...] = tuple(policy[\"erp\"][\"read_prefixes\"])\n    30\t        self.approvals = approvals\n    31\t\n    32\t    async def authorize(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n    33\t        if tool.name == \"erp_call\":\n    34\t            operation = str(args.get(\"operation\", \"\"))\n    35\t            if not operation.startswith(self.erp_read_prefixes):\n    36\t                return Decision(False, f\"erp operation not permitted: {operation}\", self.version)\n    37\t            return Decision(True, \"erp read operation\", self.version)\n    38\t\n    39\t        if tool.name == \"post_slack_message\":\n    40\t            if args.get(\"external\", False):\n    41\t                return await self._require_approval(ident, tool, args)\n    42\t            return Decision(True, \"internal staff message\", self.version)\n    43\t\n    44\t        if tool.name in self.high_impact:\n    45\t            return await self._require_approval(ident, tool, args)\n    46\t\n    47\t        return Decision(True, \"low-impact tool\", self.version)\n    48\t\n    49\t    async def _require_approval(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n    50\t        target = tool.target_of(args)\n    51\t        approval = await self.approvals.find_valid(ident, tool.name, target)\n    52\t        if approval is not None:\n    53\t            return Decision(True, \"approved\", self.version, approval_id=approval.id)\n    54\t        approval_id = await self.approvals.request(ident, tool.name, target, args)\n    55\t        return Decision(\n    56\t            False,\n    57\t            \"approval required; request opened\",\n    58\t            self.version,\n    59\t            approval_id=approval_id,\n    60\t            pending=True,\n    61\t        )\n     1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.tools import Tool\n    11\t\n    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n    13\tPAYMENTS_SCOPE = \"payments.create\"\n    14\t\n    15\t\n    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n    17\t    raw = \"|\".join(\n    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n    19\t    )\n    20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n    21\t\n    22\t\n    23\tdef tools(deps) -> list[Tool]:\n    24\t    settings = deps.settings\n    25\t\n    26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n    27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n    28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n    29\t            resp = await client.post(\n    30\t                f\"{settings.payments_api_url}/v2/payments\",\n    31\t                headers={\n    32\t                    \"Authorization\": f\"Bearer {token}\",\n    33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n    34\t                },\n    35\t                json={\n    36\t                    \"business_unit\": ident.tenant,\n    37\t                    \"invoice_reference\": args[\"invoice_id\"],\n    38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n    39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n    40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n    41\t                },\n    42\t            )\n    43\t        resp.raise_for_status()\n    44\t        body = resp.json()\n    45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n    46\t\n    47\t    return [\n    48\t        Tool(\n    49\t            name=\"pay_invoice\",\n    50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n    51\t            input_schema={\n    52\t                \"type\": \"object\",\n    53\t                \"properties\": {\n    54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n    55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n    56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n    57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n    59\t                },\n    60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n    61\t                \"additionalProperties\": False,\n    62\t            },\n    63\t            invoke=pay_invoice,\n    64\t            target_field=\"invoice_id\",\n    65\t        )\n    66\t    ]\n     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tERP_READ_SCOPE = \"erp.read\"\n    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n    11\t\n    12\t\n    13\tdef tools(deps) -> list[Tool]:\n    14\t    erp = deps.erp\n    15\t\n    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n    17\t        return await erp.call(\n    18\t            \"budget.get_remaining\",\n    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n    20\t            ident,\n    21\t            ERP_READ_SCOPE,\n    22\t        )\n    23\t\n    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n    25\t        arguments = dict(args.get(\"arguments\", {}))\n    26\t        arguments[\"business_unit\"] = ident.tenant\n    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n    28\t\n    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n    30\t        return await erp.call(\n    31\t            \"po.create\",\n    32\t            {\n    33\t                \"business_unit\": ident.tenant,\n    34\t                \"department\": args[\"department\"],\n    35\t                \"vendor_id\": args[\"vendor_id\"],\n    36\t                \"lines\": args[\"lines\"],\n    37\t                \"currency\": args[\"currency\"],\n    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n    39\t                \"client_reference\": args[\"source_doc_id\"],\n    40\t            },\n    41\t            ident,\n    42\t            ERP_PO_WRITE_SCOPE,\n    43\t        )\n    44\t\n    45\t    line_schema = {\n    46\t        \"type\": \"object\",\n    47\t        \"properties\": {\n    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n    52\t        },\n    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n    54\t        \"additionalProperties\": False,\n    55\t    }\n    56\t\n    57\t    return [\n    58\t        Tool(\n    59\t            name=\"get_budget\",\n    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n    61\t            input_schema={\n    62\t                \"type\": \"object\",\n    63\t                \"properties\": {\n    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n    66\t                },\n    67\t                \"required\": [\"department\", \"fiscal_period\"],\n    68\t                \"additionalProperties\": False,\n    69\t            },\n    70\t            invoke=get_budget,\n    71\t        ),\n    72\t        Tool(\n    73\t            name=\"erp_call\",\n    74\t            description=(\n    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n    77\t            ),\n    78\t            input_schema={\n    79\t                \"type\": \"object\",\n    80\t                \"properties\": {\n    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n    82\t                    \"arguments\": {\"type\": \"object\"},\n    83\t                },\n    84\t                \"required\": [\"operation\"],\n    85\t                \"additionalProperties\": False,\n    86\t            },\n    87\t            invoke=erp_call,\n    88\t        ),\n    89\t        Tool(\n    90\t            name=\"create_purchase_order\",\n    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n    92\t            input_schema={\n    93\t                \"type\": \"object\",\n    94\t                \"properties\": {\n    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n   100\t                },\n   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n   102\t                \"additionalProperties\": False,\n   103\t            },\n   104\t            invoke=create_purchase_order,\n   105\t            target_field=\"source_doc_id\",\n   106\t        ),\n   107\t    ]\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n     1\t# Tools per agent role, each with the task reason it is granted.\n     2\troles:\n     3\t  procurement:\n     4\t    tools:\n     5\t      read_document: \"Read vendor quotes, invoices and emails that arrived through the mail gateway.\"\n     6\t      extract_line_items: \"Delegate line-item extraction from long documents to the extractor.\"\n     7\t      get_budget: \"Check remaining department budget before raising a purchase order.\"\n     8\t      erp_call: \"Look up vendors, open invoices and purchase orders for matching.\"\n     9\t      create_purchase_order: \"Raise a purchase order once a quote is within budget and approved.\"\n    10\t      pay_invoice: \"Pay an invoice that is matched to a purchase order and approved.\"\n    11\t      post_slack_message: \"Ask staff for missing details and confirm orders with vendors.\"\n    12\t      memory_read: \"Recall department preferences and contract terms from earlier runs.\"\n    13\t      memory_write: \"Save new department preferences and contract terms.\"\n    14\t  extractor:\n    15\t    tools:\n    16\t      read_document: \"Read the document whose line items are being extracted.\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"b3a9985e-4bd1-424d-aebf-bec24cea55b1","uuid":"8081d890-007b-45cc-9fbc-aa4bc75daf2f","timestamp":"2026-10-20T11:55:02.501Z","tool_use_result":{"stdout":"     1\t\"\"\"Policy gate for tool calls.\n     2\t\n     3\tRuns in the harness between the model's proposed call and the integration.\n     4\tHigh-impact operations are denied unless a valid approval exists; when none\n     5\texists an approval request is opened and the call returns as pending.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom typing import Any\n    11\t\n    12\tfrom app.approvals import ApprovalStore\n    13\tfrom app.identity import RunIdentity\n    14\t\n    15\t\n    16\t@dataclass(frozen=True)\n    17\tclass Decision:\n    18\t    allow: bool\n    19\t    reason: str\n    20\t    policy_version: str\n    21\t    approval_id: str | None = None\n    22\t    pending: bool = False\n    23\t\n    24\t\n    25\tclass PolicyGate:\n    26\t    def __init__(self, policy: dict, approvals: ApprovalStore):\n    27\t        self.version: str = policy[\"version\"]\n    28\t        self.high_impact: frozenset[str] = frozenset(policy[\"high_impact_tools\"])\n    29\t        self.erp_read_prefixes: tuple[str, ...] = tuple(policy[\"erp\"][\"read_prefixes\"])\n    30\t        self.approvals = approvals\n    31\t\n    32\t    async def authorize(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n    33\t        if tool.name == \"erp_call\":\n    34\t            operation = str(args.get(\"operation\", \"\"))\n    35\t            if not operation.startswith(self.erp_read_prefixes):\n    36\t                return Decision(False, f\"erp operation not permitted: {operation}\", self.version)\n    37\t            return Decision(True, \"erp read operation\", self.version)\n    38\t\n    39\t        if tool.name == \"post_slack_message\":\n    40\t            if args.get(\"external\", False):\n    41\t                return await self._require_approval(ident, tool, args)\n    42\t            return Decision(True, \"internal staff message\", self.version)\n    43\t\n    44\t        if tool.name in self.high_impact:\n    45\t            return await self._require_approval(ident, tool, args)\n    46\t\n    47\t        return Decision(True, \"low-impact tool\", self.version)\n    48\t\n    49\t    async def _require_approval(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n    50\t        target = tool.target_of(args)\n    51\t        approval = await self.approvals.find_valid(ident, tool.name, target)\n    52\t        if approval is not None:\n    53\t            return Decision(True, \"approved\", self.version, approval_id=approval.id)\n    54\t        approval_id = await self.approvals.request(ident, tool.name, target, args)\n    55\t        return Decision(\n    56\t            False,\n    57\t            \"approval required; request opened\",\n    58\t            self.version,\n    59\t            approval_id=approval_id,\n    60\t            pending=True,\n    61\t        )\n     1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.tools import Tool\n    11\t\n    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n    13\tPAYMENTS_SCOPE = \"payments.create\"\n    14\t\n    15\t\n    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n    17\t    raw = \"|\".join(\n    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n    19\t    )\n    20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n    21\t\n    22\t\n    23\tdef tools(deps) -> list[Tool]:\n    24\t    settings = deps.settings\n    25\t\n    26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n    27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n    28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n    29\t            resp = await client.post(\n    30\t                f\"{settings.payments_api_url}/v2/payments\",\n    31\t                headers={\n    32\t                    \"Authorization\": f\"Bearer {token}\",\n    33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n    34\t                },\n    35\t                json={\n    36\t                    \"business_unit\": ident.tenant,\n    37\t                    \"invoice_reference\": args[\"invoice_id\"],\n    38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n    39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n    40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n    41\t                },\n    42\t            )\n    43\t        resp.raise_for_status()\n    44\t        body = resp.json()\n    45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n    46\t\n    47\t    return [\n    48\t        Tool(\n    49\t            name=\"pay_invoice\",\n    50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n    51\t            input_schema={\n    52\t                \"type\": \"object\",\n    53\t                \"properties\": {\n    54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n    55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n    56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n    57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n    59\t                },\n    60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n    61\t                \"additionalProperties\": False,\n    62\t            },\n    63\t            invoke=pay_invoice,\n    64\t            target_field=\"invoice_id\",\n    65\t        )\n    66\t    ]\n     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tERP_READ_SCOPE = \"erp.read\"\n    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n    11\t\n    12\t\n    13\tdef tools(deps) -> list[Tool]:\n    14\t    erp = deps.erp\n    15\t\n    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n    17\t        return await erp.call(\n    18\t            \"budget.get_remaining\",\n    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n    20\t            ident,\n    21\t            ERP_READ_SCOPE,\n    22\t        )\n    23\t\n    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n    25\t        arguments = dict(args.get(\"arguments\", {}))\n    26\t        arguments[\"business_unit\"] = ident.tenant\n    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n    28\t\n    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n    30\t        return await erp.call(\n    31\t            \"po.create\",\n    32\t            {\n    33\t                \"business_unit\": ident.tenant,\n    34\t                \"department\": args[\"department\"],\n    35\t                \"vendor_id\": args[\"vendor_id\"],\n    36\t                \"lines\": args[\"lines\"],\n    37\t                \"currency\": args[\"currency\"],\n    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n    39\t                \"client_reference\": args[\"source_doc_id\"],\n    40\t            },\n    41\t            ident,\n    42\t            ERP_PO_WRITE_SCOPE,\n    43\t        )\n    44\t\n    45\t    line_schema = {\n    46\t        \"type\": \"object\",\n    47\t        \"properties\": {\n    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n    52\t        },\n    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n    54\t        \"additionalProperties\": False,\n    55\t    }\n    56\t\n    57\t    return [\n    58\t        Tool(\n    59\t            name=\"get_budget\",\n    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n    61\t            input_schema={\n    62\t                \"type\": \"object\",\n    63\t                \"properties\": {\n    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n    66\t                },\n    67\t                \"required\": [\"department\", \"fiscal_period\"],\n    68\t                \"additionalProperties\": False,\n    69\t            },\n    70\t            invoke=get_budget,\n    71\t        ),\n    72\t        Tool(\n    73\t            name=\"erp_call\",\n    74\t            description=(\n    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n    77\t            ),\n    78\t            input_schema={\n    79\t                \"type\": \"object\",\n    80\t                \"properties\": {\n    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n    82\t                    \"arguments\": {\"type\": \"object\"},\n    83\t                },\n    84\t                \"required\": [\"operation\"],\n    85\t                \"additionalProperties\": False,\n    86\t            },\n    87\t            invoke=erp_call,\n    88\t        ),\n    89\t        Tool(\n    90\t            name=\"create_purchase_order\",\n    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n    92\t            input_schema={\n    93\t                \"type\": \"object\",\n    94\t                \"properties\": {\n    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n   100\t                },\n   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n   102\t                \"additionalProperties\": False,\n   103\t            },\n   104\t            invoke=create_purchase_order,\n   105\t            target_field=\"source_doc_id\",\n   106\t        ),\n   107\t    ]\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n     1\t# Tools per agent role, each with the task reason it is granted.\n     2\troles:\n     3\t  procurement:\n     4\t    tools:\n     5\t      read_document: \"Read vendor quotes, invoices and emails that arrived through the mail gateway.\"\n     6\t      extract_line_items: \"Delegate line-item extraction from long documents to the extractor.\"\n     7\t      get_budget: \"Check remaining department budget before raising a purchase order.\"\n     8\t      erp_call: \"Look up vendors, open invoices and purchase orders for matching.\"\n     9\t      create_purchase_order: \"Raise a purchase order once a quote is within budget and approved.\"\n    10\t      pay_invoice: \"Pay an invoice that is matched to a purchase order and approved.\"\n    11\t      post_slack_message: \"Ask staff for missing details and confirm orders with vendors.\"\n    12\t      memory_read: \"Recall department preferences and contract terms from earlier runs.\"\n    13\t      memory_write: \"Save new department preferences and contract terms.\"\n    14\t  extractor:\n    15\t    tools:\n    16\t      read_document: \"Read the document whose line items are being extracted.\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01C9HjBL9rkKCsAQv13yXJ4h","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
