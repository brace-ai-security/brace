.py:58\",\"tenant=tenant,\",\"Background identity uses a fixed system tenant and settings owner.\"),\n  row(\"sub-agent identity\",\"app/identity.py:51\",\"return replace(\",\"Child identity inherits tenant and owner from the parent identity.\")])\nitem(\"A02\",\"gap\",\"The six fields are in the record schema, but denied-at-start and approval paths write no audit record.\",\n \"Record run_halted, quota refusals, approval decisions, ingest and auth rejections through audit.record with full identity.\",\n \"every action records the accountable party\",\"high\")\n\n# ---- A03\ncheck(\"A03.1\",\"no\",\"app/identity.py:68\",'\"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],',\n \"Only the prompt file path is hashed, not its content hash, so editing prompts/system.md does not change the agent-type-id. The extractor prompt has the same flaw (identity.py:69).\")\ncheck(\"A03.2\",\"no\",\"app/identity.py:69\",'\"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],',\n \"Prompt file contents are not in the hash. Startup only logs when running files differ from the manifest (startup.py:43), so the ID can describe files that are not the running ones.\")\nflag(\"A03\",\"app/startup.py:43\",'Mismatch between running state and manifest is logged, not refused; the type id is computed from the manifest anyway.')\ncheck(\"A03.3\",\"yes\",\"release/manifest.yaml:42\",'model_id: \"claude-sonnet-4-5-20250929\"',\n \"Both models are dated snapshots in the hashed manifest; adapter and fine_tune are none; MODEL_ID has no default.\",\n \"Searched settings.py and deployment.yaml for aliases and fallbacks: _env('MODEL_ID') has no default and deployment pins the same snapshot.\",\n [row(\"primary model\",\"release/manifest.yaml:42\",'model_id: \"claude-sonnet-4-5-20250929\"',\"Primary model is a dated snapshot in the hashed manifest.\"),\n  row(\"extractor model\",\"release/manifest.yaml:54\",'model_id: \"claude-haiku-4-5-20251001\"',\"Extractor model is a dated snapshot in the hashed manifest.\"),\n  row(\"runtime model env\",\"app/settings.py:80\",'model_id=_env(\"MODEL_ID\"),',\"No default value, so no alias fallback when unset.\"),\n  row(\"adapters\",\"release/manifest.yaml:45\",\"adapter: none\",\"No adapter or checkpoint is used so none is omitted.\",\"not_applicable\")])\ncheck(\"A03.4\",\"yes\",\"app/identity.py:74\",'canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))',\n \"Manifest material is serialized with sorted keys, fixed separators and utf-8 encoding before sha256.\",\n \"Searched for file listings or unsorted iteration reaching the hash; the input is a dict built from YAML values only.\",\n [row(\"serialization\",\"app/identity.py:74\",'canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))',\"Sorted keys and fixed separators give a deterministic string.\"),\n  row(\"encoding\",\"app/identity.py:75\",'return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]',\"Fixed utf-8 encoding is used before hashing.\")])\ncheck(\"A03.5\",\"yes\",\"app/identity.py:65\",\"material = {\",\n \"Hashed inputs are digests, paths, model ids, config hashes and tool pins; no credentials or environment dump.\",\n \"Read release/manifest.yaml and compute_agent_type_id inputs for tokens, keys and passwords; none present.\",\n [row(\"hash material\",\"app/identity.py:65\",\"material = {\",\"Material is built from named manifest entries, not os.environ.\"),\n  row(\"manifest content\",\"release/manifest.yaml:8\",'digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"',\"Manifest holds public digests and ids, no secret values.\")])\nitem(\"A03\",\"gap\",\"The type id hashes prompt file paths, not their contents, and a manifest mismatch is only logged.\",\n \"Hash the prompt sha256 values and every tool and config file digest. Refuse to start when running files differ from the manifest.\",\n \"system prompt\",\"high\")\n\n# ---- A04\ncheck(\"A04.1\",\"no\",\"app/tools/memory.py:44\",'business_unit = args.get(\"business_unit\") or ident.tenant',\n \"memory_read uses the model-supplied business_unit as the tenant to read from. The tool schema offers the field (memory.py:113). Other tools use ident.tenant.\")\ncheck(\"A04.2\",\"no\",\"app/tools/memory.py:44\",'business_unit = args.get(\"business_unit\") or ident.tenant',\n \"The supplied tenant label is used in the query rather than rejected or overwritten with ident.tenant. erp_call does overwrite it (erp.py:26).\")\nflag(\"A04\",\"app/tools/memory.py:44\",\"memory_read takes the tenant from model-controlled arguments and reads another business unit's notes.\")\ncheck(\"A04.3\",\"yes\",\"app/audit.py:107\",\"ident.delegated_subject,\",\n \"delegated_subject and agent_principal are separate columns, filled from the verified JWT sub and the SPIFFE id.\",\n \"Searched for paths where delegated_subject is empty or replaces agent_principal; main.py:155-156 sets both, service_identity sets a system subject.\",\n [row(\"delegated subject column\",\"app/audit.py:107\",\"ident.delegated_subject,\",\"Delegated subject written as its own column.\"),\n  row(\"agent principal column\",\"app/audit.py:108\",\"ident.agent_principal,\",\"Agent principal stored separately from the subject.\"),\n  row(\"run start\",\"app/main.py:155\",\"delegated_subject=principal.subject,\",\"Subject taken from verified token sub claim.\"),\n  row(\"agent principal at start\",\"app/main.py:156\",\"agent_principal=AGENT_PRINCIPAL,\",\"Agent principal is a constant, not the user.\"),\n  row(\"background run\",\"app/main.py:63\",'delegated_subject=\"system:procurement-agent\",',\"System subject is recorded for background jobs.\")])\ncheck(\"A04.4\",\"yes\",\"app/main.py:159\",\"asyncio.create_task(request.app.state.agent.run(ident, task))\",\n \"The only handoff is an in-process task started with the harness-built identity, which carries tenant and trace_id; sub-agents inherit via child().\",\n \"Searched for celery, sqs, kafka, pubsub, queue and cron producers; none exist. The approval sweeper (main.py:110) starts a fresh system identity with no inbound context to propagate.\",\n [row(\"run task handoff\",\"app/main.py:159\",\"asyncio.create_task(request.app.state.agent.run(ident, task))\",\"Task receives the verified identity object, not agent-written data.\"),\n  row(\"sub-agent handoff\",\"app/identity.py:51\",\"return replace(\",\"Child identity keeps tenant and trace_id and records the parent instance.\"),\n  row(\"approval sweeper\",\"app/main.py:110\",\"sweeper = asyncio.create_task(expire_approvals_forever(app))\",\"Fresh system identity for a timer job; there is no inbound request context.\",\"not_applicable\")])\ncheck(\"A04.5\",\"no\",\"app/tools/memory.py:49\",\"WHERE business_unit = $1\",\n \"memory_read looks up which tenant's notes are returned from a caller-supplied business_unit label, with no permission check. The tool description says shared-services staff may do this, but nothing verifies that.\")\nitem(\"A04\",\"gap\",\"memory_read accepts a model-supplied tenant label and uses it to choose whose notes to return.\",\n \"Remove business_unit from the memory_read schema and always use ident.tenant. If cross-unit reads are needed, add a verified entitlement check.\",\n \"Don't accept labels the model supplies\",\"high\",also=None)\n\n# ---- R14\nfor c,n in ((\"R14.1\",\"audit_events is insert-only here; no code reads audit rows or checkpoints to drive recovery (grep for checkpoint, replay, resume, recover found nothing).\"),\n (\"R14.2\",\"No recovery path loads logs or checkpoints, so there is nothing to verify.\"),\n (\"R14.3\",\"No recovery path loads logs or checkpoints, so there is nothing to verify.\"),\n (\"R14.4\",\"No automatic replay exists. pay_invoice sends an Idempotency-Key (payments.py:33) only on the model's own call.\"),\n (\"R14.5\",\"No automatic replay exists. Runs are in-memory asyncio tasks (main.py:159) and are not resumed after restart.\")):\n    unk(c,n)\nitem(\"R14\",\"na_candidate\",\"No logs or checkpoints drive recovery and nothing replays automatically.\",\n \"Governance to confirm. Re-open if run resume or replay from audit_events is added.\",None,\"medium\")\nE\ncd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/work 2>/dev/null; /Users/brenn/.cache/uv/builds-v0/.tmpR1cD4H/bin/python -I /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-ysk57i1d/work/drive.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1004,"cache_read_input_tokens":89390,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1004},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b3a9985e-4bd1-424d-aebf-bec24cea55b1","uuid":"21a86e83-35fb-45d4-8ab5-add8c2e65814","timestamp":"2026-10-20T11:57:34.461Z","request_id":"req_011CgDSuqyZUw3D8ruWaxDpt","wire_tool_inputs":{"toolu_01QL77oF3cy2f532zYi9UTWu":{"command":"mkdir -p /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-ysk57i1d/work && cat > /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-ysk57i1d/work/drive.py <<'E'\nimport json, subprocess, sys\nR=\"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-ysk57i1d\"\nS=R+\"/skill/scripts\"; F=R+\"/agent/brace-findings.json\"; W=R+\"/work\"\nPY=\"/Users/brenn/.cache/uv/builds-v0/.tmpR1cD4H/bin/python\"\ndef run(*a):\n    r=subprocess.run([PY,\"-I\",*a],capture_output=True,text=True)\n    print(\" \".join(a[1:4]),\"->\",(r.stdout+r.stderr).strip()[:600])\ndef row(subject,ev,quote,note,status=\"enforced\"):\n    return dict(subject=subject,status=status,evidence=ev,quote=quote,note=note)\ndef check(cid,met,ev,quote,note,counter=\"\",rows=None):\n    args=[S+\"/answer.py\",F,\"check\",cid,\"--met\",met,\"--evidence\",ev,\"--quote\",quote,\"--note\",note]\n    if counter: args+=[\"--counter\",counter]\n    run(*args)\n    if rows is not None:\n        for k,v in ((\"rows\",rows),(\"dev\",[]),(\"att\",[])):\n            json.dump(v,open(f\"{W}/{cid}.{k}.json\",\"w\"))\n        run(S+\"/review_coverage.py\",\"ledger\",F,cid,\"--rows\",f\"{W}/{cid}.rows.json\",\"--deviations\",f\"{W}/{cid}.dev.json\",\"--attempts\",f\"{W}/{cid}.att.json\")\ndef unk(cid,note):\n    run(S+\"/answer.py\",F,\"check\",cid,\"--met\",\"unknown\",\"--note\",note)\ndef flag(item,ev,note): run(S+\"/answer.py\",F,\"flag\",item,\"--evidence\",ev,\"--note\",note)\ndef item(i,rating,summary,nxt,violates=None,conf=\"medium\",role=\"agent_team\",also=None):\n    a=[S+\"/answer.py\",F,\"item\",i,\"--rating\",rating,\"--confidence\",conf,\"--summary\",summary,\"--next\",nxt]\n    if violates: a+=[\"--violates\",violates]\n    if also: a+=[\"--also-affects\",also]\n    run(*a)\n\n# ---- A01\ncheck(\"A01.1\",\"yes\",\"deploy/k8s/deployment.yaml:19\",\"serviceAccountName: procurement-agent\",\n \"Pod runs under its own service account; token is projected and exchanged at the STS.\",\n \"Searched deploy/k8s, release/manifest.yaml and app/ for other serviceAccountName values, default SA use and other workloads sharing procurement-agent; only this one Deployment exists.\",\n [row(\"procurement-agent pod identity\",\"deploy/k8s/deployment.yaml:19\",\"serviceAccountName: procurement-agent\",\"Deployment uses a dedicated named service account, not default.\"),\n  row(\"service account object\",\"deploy/k8s/serviceaccount.yaml:14\",\"name: procurement-agent\",\"Dedicated ServiceAccount defined for this agent only.\"),\n  row(\"agent principal string\",\"app/main.py:40\",'AGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"',\"Audit rows carry the same SPIFFE principal as the service account.\"),\n  row(\"extractor sub-agent\",\"app/identity.py:51\",\"return replace(\",\"Child identity copies the parent principal; it is the same agent, not an unrelated one.\",\"not_applicable\")])\ncheck(\"A01.2\",\"no\",\"app/identity.py:95\",\"key = (audience, scope, ident.tenant)\",\n \"Exchanged-token cache is keyed by audience, scope and tenant only. A token minted for one user's delegation is reused for other users in the tenant, so the delegated subject does not survive per call.\")\nunk_note=None\ncheck(\"A01.3\",\"no\",\"app/identity.py:109\",'\"actor_token\": ident.delegated_subject,',\n \"The user is sent to the STS as a bare subject-id string typed urn:example:params:subject-id, not as a verified user token. The STS cannot verify the user from this request; the user's JWT is verified only at /runs (app/main.py:126).\")\nunk(\"A01.4\",\"No IAM policy, RoleBinding or STS grant mapping is defined in this repo. Only a ServiceAccount (deploy/k8s/serviceaccount.yaml) and DB grants to role procurement_agent (migrations/001_init.sql:119-128) exist. STS authorization for the SPIFFE ID lives outside the repo.\")\nitem(\"A01\",\"gap\",\"Token exchange drops per-user delegation (shared cache) and sends the user only as an unverified label.\",\n \"Key the token cache on the delegated subject, and send a verified user token or signed delegation to the STS. Show the STS grants for the agent principal.\",\n \"Preserve any explicitly delegated user/system subject separately and bound the authority used\",\"high\")\n\n# ---- A02\nFIELDS=\"accountable_party, operational_owner, tenant,\"\ncheck(\"A02.1\",\"yes\",\"app/audit.py:44\",\"accountable_party, operational_owner, tenant,\",\n \"INSERT writes accountable party, owner, tenant, agent_type_id, agent_instance_id, trace_id and span_id; migration makes each NOT NULL and non-empty.\",\n \"Searched for other INSERT INTO audit_events or alternate writers; only audit.record writes the table.\",\n [row(\"accountable_party / operational_owner / tenant\",\"app/audit.py:44\",\"accountable_party, operational_owner, tenant,\",\"All three are columns in the single audit INSERT.\"),\n  row(\"agent_type_id / agent_instance_id\",\"app/audit.py:45\",\"agent_type_id, agent_instance_id, trace_id, span_id,\",\"Type and instance ids are columns in the same INSERT.\"),\n  row(\"trace context\",\"app/audit.py:105\",\"ident.trace_id,\",\"trace_id is passed into the INSERT for every record.\"),\n  row(\"empty value guard\",\"app/audit.py:87\",\"if not getattr(ident, name):\",\"record() raises if any identity field is empty before writing.\"),\n  row(\"schema constraints\",\"migrations/001_init.sql:10\",\"accountable_party   text NOT NULL CHECK (accountable_party <> ''),\",\"DB rejects empty values for the identity columns.\")])\ncheck(\"A02.2\",\"no\",\"app/loop.py:127\",\"await killswitch.assert_running(pool, ident.tenant)\",\n \"A halted run raises AgentHalted before any audit record is written. run_halted is defined (audit.py:27) but never recorded. reserve_run_start (loop.py:129) raising BudgetExceeded is outside the try block, so quota refusals write nothing. The Slack approval decision (main.py:183) and /ingest/mail also write no audit record, and auth failures return 401/403 unlogged.\")\nflag(\"A02\",\"app/loop.py:127\",\"Pre-run refusals (kill switch, run-start quota) and approval decisions write no audit record.\")\ncheck(\"A02.3\",\"yes\",\"app/audit.py:105\",\"ident.trace_id,\",\n \"trace_id and span_id are stored as columns of audit_events; trace_id is NOT NULL.\",\n \"Searched for paths where trace_id is unset: RunIdentity.__post_init__ rejects an empty trace_id (identity.py:47). span_id is nullable when no span is active (audit.py:90).\",\n [row(\"trace_id column\",\"app/audit.py:105\",\"ident.trace_id,\",\"trace_id from the identity is written into the record itself.\"),\n  row(\"span_id column\",\"app/audit.py:106\",\"span_id,\",\"span_id from the active span is written into the record.\"),\n  row(\"trace_id never empty\",\"app/identity.py:47\",\"if not getattr(self, name):\",\"Identity creation fails if trace_id is empty.\")])\ncheck(\"A02.4\",\"yes\",\"app/main.py:150\",\"tenant=principal.business_unit,\",\n \"Tenant comes from the 'bu' claim of a verified RS256/ES256 JWT; owner comes from deployment settings; background jobs use fixed values.\",\n \"Searched audit writers and RunIdentity constructors for X-Tenant, baggage, tracestate, request body and tool-argument sources; none feed tenant or owner.\",\n [row(\"run tenant\",\"app/main.py:150\",\"tenant=principal.business_unit,\",\"Tenant taken from verified token claim bu.\"),\n  row(\"token verification\",\"app/main.py:126\",\"claims = jwt.decode(\",\"Claims are only read after signature, audience and issuer checks.\"),\n  row(\"run owner\",\"app/main.py:149\",\"operational_owner=settings.operational_owner,\",\"Owner comes from environment settings, not the request.\"),\n  row(\"background tenant/owner\",\"app/main.py:58\",\"tenant=tenant,\",\"Background identity uses a fixed system tenant and settings owner.\"),\n  row(\"sub-agent identity\",\"app/identity.py:51\",\"return replace(\",\"Child identity inherits tenant and owner from the parent identity.\")])\nitem(\"A02\",\"gap\",\"The six fields are in the record schema, but denied-at-start and approval paths write no audit record.\",\n \"Record run_halted, quota refusals, approval decisions, ingest and auth rejections through audit.record with full identity.\",\n \"every action records the accountable party\",\"high\")\n\n# ---- A03\ncheck(\"A03.1\",\"no\",\"app/identity.py:68\",'\"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],',\n \"Only the prompt file path is hashed, not its content hash, so editing prompts/system.md does not change the agent-type-id. The extractor prompt has the same flaw (identity.py:69).\")\ncheck(\"A03.2\",\"no\",\"app/identity.py:69\",'\"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],',\n \"Prompt file contents are not in the hash. Startup only logs when running files differ from the manifest (startup.py:43), so the ID can describe files that are not the running ones.\")\nflag(\"A03\",\"app/startup.py:43\",'Mismatch between running state and manifest is logged, not refused; the type id is computed from the manifest anyway.')\ncheck(\"A03.3\",\"yes\",\"release/manifest.yaml:42\",'model_id: \"claude-sonnet-4-5-20250929\"',\n \"Both models are dated snapshots in the hashed manifest; adapter and fine_tune are none; MODEL_ID has no default.\",\n \"Searched settings.py and deployment.yaml for aliases and fallbacks: _env('MODEL_ID') has no default and deployment pins the same snapshot.\",\n [row(\"primary model\",\"release/manifest.yaml:42\",'model_id: \"claude-sonnet-4-5-20250929\"',\"Primary model is a dated snapshot in the hashed manifest.\"),\n  row(\"extractor model\",\"release/manifest.yaml:54\",'model_id: \"claude-haiku-4-5-20251001\"',\"Extractor model is a dated snapshot in the hashed manifest.\"),\n  row(\"runtime model env\",\"app/settings.py:80\",'model_id=_env(\"MODEL_ID\"),',\"No default value, so no alias fallback when unset.\"),\n  row(\"adapters\",\"release/manifest.yaml:45\",\"adapter: none\",\"No adapter or checkpoint is used so none is omitted.\",\"not_applicable\")])\ncheck(\"A03.4\",\"yes\",\"app/identity.py:74\",'canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))',\n \"Manifest material is serialized with sorted keys, fixed separators and utf-8 encoding before sha256.\",\n \"Searched for file listings or unsorted iteration reaching the hash; the input is a dict built from YAML values only.\",\n [row(\"serialization\",\"app/identity.py:74\",'canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))',\"Sorted keys and fixed separators give a deterministic string.\"),\n  row(\"encoding\",\"app/identity.py:75\",'return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]',\"Fixed utf-8 encoding is used before hashing.\")])\ncheck(\"A03.5\",\"yes\",\"app/identity.py:65\",\"material = {\",\n \"Hashed inputs are digests, paths, model ids, config hashes and tool pins; no credentials or environment dump.\",\n \"Read release/manifest.yaml and compute_agent_type_id inputs for tokens, keys and passwords; none present.\",\n [row(\"hash material\",\"app/identity.py:65\",\"material = {\",\"Material is built from named manifest entries, not os.environ.\"),\n  row(\"manifest content\",\"release/manifest.yaml:8\",'digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"',\"Manifest holds public digests and ids, no secret values.\")])\nitem(\"A03\",\"gap\",\"The type id hashes prompt file paths, not their contents, and a manifest mismatch is only logged.\",\n \"Hash the prompt sha256 values and every tool and config file digest. Refuse to start when running files differ from the manifest.\",\n \"system prompt\",\"high\")\n\n# ---- A04\ncheck(\"A04.1\",\"no\",\"app/tools/memory.py:44\",'business_unit = args.get(\"business_unit\") or ident.tenant',\n \"memory_read uses the model-supplied business_unit as the tenant to read from. The tool schema offers the field (memory.py:113). Other tools use ident.tenant.\")\ncheck(\"A04.2\",\"no\",\"app/tools/memory.py:44\",'business_unit = args.get(\"business_unit\") or ident.tenant',\n \"The supplied tenant label is used in the query rather than rejected or overwritten with ident.tenant. erp_call does overwrite it (erp.py:26).\")\nflag(\"A04\",\"app/tools/memory.py:44\",\"memory_read takes the tenant from model-controlled arguments and reads another business unit's notes.\")\ncheck(\"A04.3\",\"yes\",\"app/audit.py:107\",\"ident.delegated_subject,\",\n \"delegated_subject and agent_principal are separate columns, filled from the verified JWT sub and the SPIFFE id.\",\n \"Searched for paths where delegated_subject is empty or replaces agent_principal; main.py:155-156 sets both, service_identity sets a system subject.\",\n [row(\"delegated subject column\",\"app/audit.py:107\",\"ident.delegated_subject,\",\"Delegated subject written as its own column.\"),\n  row(\"agent principal column\",\"app/audit.py:108\",\"ident.agent_principal,\",\"Agent principal stored separately from the subject.\"),\n  row(\"run start\",\"app/main.py:155\",\"delegated_subject=principal.subject,\",\"Subject taken from verified token sub claim.\"),\n  row(\"agent principal at start\",\"app/main.py:156\",\"agent_principal=AGENT_PRINCIPAL,\",\"Agent principal is a constant, not the user.\"),\n  row(\"background run\",\"app/main.py:63\",'delegated_subject=\"system:procurement-agent\",',\"System subject is recorded for background jobs.\")])\ncheck(\"A04.4\",\"yes\",\"app/main.py:159\",\"asyncio.create_task(request.app.state.agent.run(ident, task))\",\n \"The only handoff is an in-process task started with the harness-built identity, which carries tenant and trace_id; sub-agents inherit via child().\",\n \"Searched for celery, sqs, kafka, pubsub, queue and cron producers; none exist. The approval sweeper (main.py:110) starts a fresh system identity with no inbound context to propagate.\",\n [row(\"run task handoff\",\"app/main.py:159\",\"asyncio.create_task(request.app.state.agent.run(ident, task))\",\"Task receives the verified identity object, not agent-written data.\"),\n  row(\"sub-agent handoff\",\"app/identity.py:51\",\"return replace(\",\"Child identity keeps tenant and trace_id and records the parent instance.\"),\n  row(\"approval sweeper\",\"app/main.py:110\",\"sweeper = asyncio.create_task(expire_approvals_forever(app))\",\"Fresh system identity for a timer job; there is no inbound request context.\",\"not_applicable\")])\ncheck(\"A04.5\",\"no\",\"app/tools/memory.py:49\",\"WHERE business_unit = $1\",\n \"memory_read looks up which tenant's notes are returned from a caller-supplied business_unit label, with no permission check. The tool description says shared-services staff may do this, but nothing verifies that.\")\nitem(\"A04\",\"gap\",\"memory_read accepts a model-supplied tenant label and uses it to choose whose notes to return.\",\n \"Remove business_unit from the memory_read schema and always use ident.tenant. If cross-unit reads are needed, add a verified entitlement check.\",\n \"Don't accept labels the model supplies\",\"high\",also=None)\n\n# ---- R14\nfor c,n in ((\"R14.1\",\"audit_events is insert-only here; no code reads audit rows or checkpoints to drive recovery (grep for checkpoint, replay, resume, recover found nothing).\"),\n (\"R14.2\",\"No recovery path loads logs or checkpoints, so there is nothing to verify.\"),\n (\"R14.3\",\"No recovery path loads logs or checkpoints, so there is nothing to verify.\"),\n (\"R14.4\",\"No automatic replay exists. pay_invoice sends an Idempotency-Key (payments.py:33) only on the model's own call.\"),\n (\"R14.5\",\"No automatic replay exists. Runs are in-memory asyncio tasks (main.py:159) and are not resumed after restart.\")):\n    unk(c,n)\nitem(\"R14\",\"na_candidate\",\"No logs or checkpoints drive recovery and nothing replays automatically.\",\n \"Governance to confirm. Re-open if run resume or replay from audit_events is added.\",None,\"medium\")\nE\ncd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/work 2>/dev/null; /Users/brenn/.cache/uv/builds-v0/.tmpR1cD4H/bin/python -I /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-ysk57i1d/work/drive.py"}}}
