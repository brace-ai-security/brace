dence\":\"agent/release/manifest.json:27\",\"quote\":\"      \\\"role\\\": \\\"intent_classifier\\\",\",\"note\":\"Listed in manifest.models.\"},\n    {\"subject\":\"main agent model (loop.ts)\",\"status\":\"enforced\",\"evidence\":\"agent/release/manifest.json:18\",\"quote\":\"      \\\"role\\\": \\\"agent\\\",\",\"note\":\"Listed in manifest.models. It is the primary model, not a helper.\"},\n    {\"subject\":\"count_tokens pre-call estimate (context-size.ts)\",\"status\":\"not_applicable\",\"evidence\":\"agent/src/agent/context-size.ts:35\",\"quote\":\"    const r = await client.messages.countTokens(req, { signal });\",\"note\":\"Token counting endpoint only. Makes no model decision.\"},\n    {\"subject\":\"embedding / reranker / moderation / judge / world model\",\"status\":\"not_applicable\",\"evidence\":\"agent/release/manifest.json:62\",\"quote\":\"  \\\"retrieval\\\": \\\"none\\\",\",\"note\":\"No such calls found in the code. Retrieval is none and memory is none.\"},\n    {\"subject\":\"eligibility peer agent (A2A)\",\"status\":\"not_applicable\",\"evidence\":\"agent/src/integrations/eligibility-a2a.ts:58\",\"quote\":\"  const res = await fetch(env.eligibilityUrl, {\",\"note\":\"External peer service listed under manifest peers. Not a helper model controlled by this agent.\"}\n   ],\n   \"deviations\":[],\n   \"attempts\":[\n    {\"category\":\"missed model call path\",\"input\":\"grep for embed|rerank|moderat|judge|openai and for fetch( to model endpoints\",\"trace\":\"Only fetch calls go to the SMS, payments, EHR token and eligibility URLs. The only Anthropic client is created in loop.ts and passed to classifyIntent.\",\"outcome\":\"blocked\",\"evidence\":\"agent/src/agent/loop.ts:15\",\"quote\":\"const anthropic = new Anthropic({ maxRetries: 1 });\"}\n   ]},\n  {\"id\":\"A07.2\",\"result\":\"holds\",\"evidence\":\"agent/src/agent/classifier.ts:16\",\"quote\":\"export const CLASSIFIER_ID = `sha256:${createHash(\\\"sha256\\\")\",\n   \"note\":\"The model I