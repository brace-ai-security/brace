   \"kind\": \"tool_registration\",\n      \"evidence\": \"src/tools/registry.ts:94\",\n      \"quote\": \"for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\"\n    },\n    {\n      \"id\": \"I3a7e594185\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/workers/reminders.ts:36\",\n      \"quote\": \"await audit.record({\"\n    },\n    {\n      \"id\": \"I23cff29552\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/workers/reminders.ts:53\",\n      \"quote\": \"await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \\\"run.stopped\\\", reason: (err as Error).message.slice(0, 200) });\"\n    },\n    {\n      \"id\": \"Icc9cd2c6d6\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/workflows/eligibility-check.ts:28\",\n      \"quote\": \"await audit.record({\"\n    },\n    {\n      \"id\": \"I22394b36a5\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/workflows/eligibility-check.ts:45\",\n      \"quote\": \"await audit.record({\"\n    }\n  ],\n  \"skipped\": [],\n  \"limitations\": \"Candidate inventory only: manually trace aliases, wrappers, computed calls and unsupported languages. Tests excluded; no code executed.\"\n}\nimport { FirehoseClient, PutRecordCommand } from \"@aws-sdk/client-firehose\";\nimport { randomUUID } from \"node:crypto\";\nimport { z } from \"zod\";\nimport { env } from \"../config.js\";\n\n// Every audit record carries the six identity fields. Values come from RunContext, which is built\n// by the HTTP layer and the worker, never from model output.\nexport const IdentityFields = z.object({\n  accountableParty: z.string().min(1),\n  operationalOwner: z.string().min(1),\n  tenantId: z.string().min(1),\n  agentTypeId: z.string().startsWith(\"sha256:\"),\n  agentInstanceId: z.string().uuid(),\n  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),\n});\n\nexport const AuditEvent = IdentityFields.extend({\n  eventId: z.string().uuid(),\n  ts: z.string().datetime(),\n  runId: z.string().uuid(),\n  event: z.enum([\n    \"run.started\",\n    \"run.stopped\",\n    \"run.completed\",\n    \"intent.classified\",\n    \"model.decision\",\n    \"tool.denied\",\n    \"tool.approval_requested\",\n    \"tool.executed\",\n    \"tool.failed\",\n    \"payment.refund\",\n    \"peer.call\",\n    \"reminder.sent\",\n  ]),\n  subject: z.object({ kind: z.enum([\"patient\", \"staff\", \"system\"]), id: z.string() }),\n  tool: z.string().optional(),\n  toolUseId: z.string().optional(),\n  policyVersion: z.string().optional(),\n  approvalId: z.string().optional(),\n  reason: z.string().optional(),\n  context: z\n    .object({\n      tokens: z.number().int().nonnegative().nullable(),\n      status: z.enum([\"measured\", \"estimated\", \"unavailable\"]),\n      method: z.string(),\n      cachedInputTokens: z.number().int().nonnegative().nullable(),\n      compacted: z.boolean(),\n    })\n    .optional(),\n  detail: z.record(z.unknown()).optional(),\n});\nexport type AuditEvent = z.infer<typeof AuditEvent>;\n\nconst firehose = new FirehoseClient({ region: env.region });\n\nexport class AuditUnavailable extends Error {}\n\nexport const audit = {\n  async record(e: Omit<AuditEvent, \"eventId\" | \"ts\">): Promise<void> {\n    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });\n    try {\n      await firehose.send(\n        new PutRecordCommand({\n          DeliveryStreamName: env.auditStream,\n          Record: { Data: Buffer.from(JSON.stringify(full) + \"\\n\") },\n        }),\n      );\n    } catch (err) {\n      // Callers treat this as a hard failure: an action that cannot be audited does not run.\n      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);\n    }\n  },\n};\n\n// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.\nconst DROP_KEYS = new Set([\"ssn\", \"dateOfBirth\", \"dob\", \"memberId\", \"subscriberId\", \"cardNumber\", \"cardLast4\", \"address\"]);\nconst PATTERNS: Array<[RegExp, string]> = [\n  [/\\b\\d{3}-\\d{2}-\\d{4}\\b/g, \"[ssn]\"],\n  [/\\b(?:\\d[ -]?){13,19}\\b/g, \"[card]\"],\n  [/\\b[A-Z]{3}\\d{9}\\b/g, \"[member-id]\"],\n];\n\nexport function redactPhi(value: unknown): unknown {\n  if (typeof value === \"string\") {\n    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);\n  }\n  if (Array.isArray(value)) return value.map(redactPhi);\n  if (value && typeof value === \"object\") {\n    const out: Record<string, unknown> = {};\n    for (const [k, v] of Object.entries(value)) {\n      if (DROP_KEYS.has(k)) continue;\n      out[k] = redactPhi(v);\n    }\n    return out;\n  }\n  return value;\n}\n# Who can change production: only the deploy workflow running in the \"production\" or\n# \"production-emergency\" GitHub environment can assume the deploy role, and both environments\n# require a named reviewer from agent-platform-leads. Nobody else has write access to the\n# clinic-agent namespace (see access_entries in main.tf), and the cluster API is private.\n\nprovider \"github\" {\n  owner = \"northbay-clinics\"\n}\n\ndata \"github_team\" \"leads\" {\n  slug = \"agent-platform-leads\"\n}\n\nresource \"github_branch_protection\" \"main\" {\n  repository_id = \"clinic-agent\"\n  pattern       = \"main\"\n\n  enforce_admins                  = true\n  allows_force_pushes             = false\n  allows_deletions                = false\n  required_linear_history         = true\n  require_signed_commits          = true\n  require_conversation_resolution = true\n\n  required_pull_request_reviews {\n    required_approving_review_count = 2\n    require_code_owner_reviews      = true\n    dismiss_stale_reviews           = true\n    require_last_push_approval      = true\n  }\n\n  required_status_checks {\n    strict   = true\n    contexts = [\"ci / test\", \"ci / manifest-check\"]\n  }\n}\n\nresource \"github_repository_environment\" \"production\" {\n  repository  = \"clinic-agent\"\n  environment = \"production\"\n  reviewers {\n    teams = [data.github_team.leads.id]\n  }\n  prevent_self_review = true\n  deployment_branch_policy {\n    protected_branches     = true\n    custom_branch_policies = false\n  }\n}\n\nresource \"github_repository_environment\" \"production_emergency\" {\n  repository  = \"clinic-agent\"\n  environment = \"production-emergency\"\n  reviewers {\n    teams = [data.github_team.leads.id]\n  }\n  prevent_self_review = true\n  deployment_branch_policy {\n    protected_branches     = false\n    custom_branch_policies = true\n  }\n}\n\nresource \"github_repository_environment_deployment_policy\" \"emergency_branches\" {\n  repository     = \"clinic-agent\"\n  environment    = github_repository_environment.production_emergency.environment\n  branch_pattern = \"hotfix/*\"\n}\n\nresource \"aws_iam_role\" \"deploy\" {\n  name = \"clinic-agent-deploy\"\n  assume_role_policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect    = \"Allow\"\n      Principal = { Federated = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/token.actions.githubusercontent.com\" }\n      Action    = \"sts:AssumeRoleWithWebIdentity\"\n      Condition = {\n        StringEquals = {\n          \"token.actions.githubusercontent.com:aud\" = \"sts.amazonaws.com\"\n          \"token.actions.githubusercontent.com:sub\" = [\n            \"repo:northbay-clinics/clinic-agent:environment:production\",\n            \"repo:northbay-clinics/clinic-agent:environment:production-emergency\",\n          ]\n        }\n      }\n    }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"deploy\" {\n  name = \"clinic-agent-deploy\"\n  role = aws_iam_role.deploy.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [\n      {\n        Effect   = \"Allow\"\n        Action   = [\"ecr:GetAuthorizationToken\"]\n        Resource = \"*\"\n      },\n      {\n        Effect   = \"Allow\"\n        Action   = [\"ecr:BatchCheckLayerAvailability\", \"ecr:PutImage\", \"ecr:InitiateLayerUpload\", \"ecr:UploadLayerPart\", \"ecr:CompleteLayerUpload\", \"ecr:BatchGetImage\"]\n        Resource = aws_ecr_repository.agent.arn\n      },\n      {\n        Effect   = \"Allow\"\n        Action   = [\"eks:DescribeCluster\"]\n        Resource = module.eks.cluster_arn\n      },\n    ]\n  })\n}\n# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:\n# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.\nresource \"aws_iam_role\" \"runtime\" {\n  name                 = \"clinic-agent-runtime\"\n  max_session_duration = 3600\n  assume_role_policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect    = \"Allow\"\n      Principal = { Federated = module.eks.oidc_provider_arn }\n      Action    = \"sts:AssumeRoleWithWebIdentity\"\n      Condition = {\n        StringEquals = {\n          \"${module.eks.oidc_provider}:sub\" = [\n            \"system:serviceaccount:clinic-agent:clinic-agent\",\n            \"system:serviceaccount:clinic-agent:clinic-agent-reminders\",\n          ]\n          \"${module.eks.oidc_provider}:aud\" = \"sts.amazonaws.com\"\n        }\n      }\n    }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"runtime\" {\n  name = \"clinic-agent-runtime\"\n  role = aws_iam_role.runtime.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [\n      {\n        Sid      = \"ReadClinicSecrets\"\n        Effect   = \"Allow\"\n        Action   = [\"secretsmanager:GetSecretValue\"]\n        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\n      },\n      {\n        Sid    = \"AgentState\"\n        Effect = \"Allow\"\n        Action = [\n          \"dynamodb:GetItem\",\n          \"dynamodb:BatchGetItem\",\n          \"dynamodb:PutItem\",\n          \"dynamodb:UpdateItem\",\n          \"dynamodb:Query\",\n        ]\n        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*\"\n      },\n      {\n        Sid      = \"Audit\"\n        Effect   = \"Allow\"\n        Action   = [\"firehose:PutRecord\", \"firehose:PutRecordBatch\"]\n        Resource = aws_kinesis_firehose_delivery_stream.audit.arn\n      },\n    ]\n  })\n}\n\n# Operators who may stop the agent. Assumable only through SSO by the on-call group.\nresource \"aws_iam_role\" \"ops_killswitch\" {\n  name = \"clinic-agent-ops\"\n  assume_role_policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect    = \"Allow\"\n      Principal = { AWS = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\" }\n      Action    = \"sts:AssumeRole\"\n      Condition = {\n        StringLike = { \"aws:PrincipalArn\" = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*\" }\n      }\n    }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"ops_killswitch\" {\n  name = \"clinic-agent-ops\"\n  role = aws_iam_role.ops_killswitch.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect   = \"Allow\"\n      Action   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:GetItem\"]\n      Resource = aws_dynamodb_table.control.arn\n    }]\n  })\n}\n\nresource \"aws_iam_role\" \"firehose\" {\n  name = \"clinic-agent-audit-firehose\"\n  assume_role_policy = jsonencode({\n    Version   = \"2012-10-17\"\n    Statement = [{ Effect = \"Allow\", Principal = { Service = \"firehose.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"firehose\" {\n  name = \"write-audit-bucket\"\n  role = aws_iam_role.firehose.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect   = \"Allow\"\n      Action   = [\"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:GetBucketLocation\"]\n      Resource = [aws_s3_bucket.audit.arn, \"${aws_s3_bucket.audit.arn}/*\"]\n    }]\n  })\n}\nterraform {\n  required_version = \">= 1.9.0\"\n  required_providers {\n    aws    = { source = \"hashicorp/aws\", version = \"~> 6.14\" }\n    github = { source = \"integrations/github\", version = \"~> 6.6\" }\n  }\n  backend \"s3\" {\n    bucket         = \"northbay-tfstate-418295730611\"\n    key            = \"clinic-agent/prod.tfstate\"\n    region         = \"us-west-2\"\n    dynamodb_table = \"northbay-tf-locks\"\n    encrypt        = true\n  }\n}\n\nprovider \"aws\" {\n  region = var.region\n  default_tags {\n    tags = { app = \"clinic-agent\", owner = \"agent-platform\", data = \"phi\" }\n  }\n}\n\nvariable \"region\" {\n  type    = string\n  default = \"us-west-2\"\n}\n\nvariable \"clinic_ids\" {\n  type    = list(string)\n  default = [\"nb-castro\", \"nb-fremont\", \"nb-oakland\", \"nb-sanmateo\", \"nb-walnutcreek\"]\n}\n\ndata \"aws_caller_identity\" \"current\" {}\n\nmodule \"eks\" {\n  source  = \"terraform-aws-modules/eks/aws\"\n  version = \"21.3.1\"\n\n  name               = \"clinic-agent-prod\"\n  kubernetes_version = \"1.33\"\n  vpc_id             = module.vpc.vpc_id\n  subnet_ids         = module.vpc.private_subnets\n\n  endpoint_public_access = false\n  enable_irsa            = true\n\n  authentication_mode = \"API\"\n  access_entries = {\n    deploy = {\n      principal_arn = aws_iam_role.deploy.arn\n      policy_associations = {\n        ns = {\n          policy_arn   = \"arn:aws:eks::aws:cluster-access-policy/AmazonEKSEditPolicy\"\n          access_scope = { type = \"namespace\", namespaces = [\"clinic-agent\"] }\n        }\n      }\n    }\n  }\n\n  eks_managed_node_groups = {\n    agents = {\n      instance_types = [\"m7g.large\"]\n      ami_type       = \"BOTTLEROCKET_ARM_64\"\n      min_size       = 2\n      max_size       = 6\n      desired_size   = 3\n      metadata_options = {\n        http_tokens                 = \"required\"\n        http_put_response_hop_limit = 1\n      }\n    }\n  }\n}\n\nmodule \"vpc\" {\n  source  = \"terraform-aws-modules/vpc/aws\"\n  version = \"6.4.0\"\n\n  name            = \"clinic-agent-prod\"\n  cidr            = \"10.42.0.0/16\"\n  azs             = [\"us-west-2a\", \"us-west-2b\", \"us-west-2c\"]\n  private_subnets = [\"10.42.1.0/24\", \"10.42.2.0/24\", \"10.42.3.0/24\"]\n  public_subnets  = [\"10.42.101.0/24\", \"10.42.102.0/24\", \"10.42.103.0/24\"]\n\n  enable_nat_gateway = true\n  single_nat_gateway = false\n}\n\nresource \"aws_ecr_repository\" \"agent\" {\n  name                 = \"clinic-agent\"\n  image_tag_mutability = \"IMMUTABLE\"\n  image_scanning_configuration { scan_on_push = true }\n}\n\n# State tables. Approvals are written by the staff console; budgets by the agent; the control\n# table holds the stop flags operators set.\nresource \"aws_dynamodb_table\" \"approvals\" {\n  name         = \"clinic-agent-approvals\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"id\"\n  attribute {\n    name = \"id\"\n    type = \"S\"\n  }\n  point_in_time_recovery { enabled = true }\n}\n\nresource \"aws_dynamodb_table\" \"budgets\" {\n  name         = \"clinic-agent-budgets\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n  ttl {\n    attribute_name = \"expiresAt\"\n    enabled        = true\n  }\n}\n\nresource \"aws_dynamodb_table\" \"control\" {\n  name         = \"clinic-agent-control\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n  point_in_time_recovery { enabled = true }\n}\n\n# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).\nresource \"aws_s3_bucket\" \"audit\" {\n  bucket              = \"clinic-agent-audit-${data.aws_caller_identity.current.account_id}\"\n  object_lock_enabled = true\n}\n\nresource \"aws_s3_bucket_object_lock_configuration\" \"audit\" {\n  bucket = aws_s3_bucket.audit.id\n  rule {\n    default_retention {\n      mode  = \"COMPLIANCE\"\n      years = 7\n    }\n  }\n}\n\nresource \"aws_kinesis_firehose_delivery_stream\" \"audit\" {\n  name        = \"clinic-agent-audit\"\n  destination = \"extended_s3\"\n  extended_s3_configuration {\n    role_arn            = aws_iam_role.firehose.arn\n    bucket_arn          = aws_s3_bucket.audit.arn\n    prefix              = \"audit/dt=!{timestamp:yyyy-MM-dd}/\"\n    error_output_prefix = \"audit-errors/!{firehose:error-output-type}/\"\n    buffering_interval  = 60\n  }\n}\n\nresource \"aws_secretsmanager_secret\" \"ehr\" {\n  for_each = toset(concat(var.clinic_ids, [\"_catalog\"]))\n  name     = \"clinic-agent/ehr/${each.key}\"\n}\n\nresource \"aws_secretsmanager_secret\" \"payments\" {\n  for_each = toset(var.clinic_ids)\n  name     = \"clinic-agent/payments/${each.key}\"\n}\n\nresource \"aws_secretsmanager_secret\" \"sms\" {\n  for_each = toset(var.clinic_ids)\n  name     = \"clinic-agent/sms/${each.key}\"\n}\n\nresource \"aws_secretsmanager_secret\" \"sms_signing\" {\n  name = \"clinic-agent/sms-signing\"\n}\n# Hard limits enforced by src/agent/budget.ts, outside the model.\nrun:\n  maxTurns: 8                 # model calls per run\n  maxWallMs: 45000            # whole run, including tool calls\n  maxInputTokens: 120000      # summed across model calls in the run\n  maxOutputTokens: 6000\n  maxCostUsd: 0.40\n  maxToolCalls: 16\n  maxToolCallsPerMinute: 12\n  maxPeerCalls: 2             # calls to the eligibility agent; this agent starts no sub-agents\n\nquotas:\n  # Daily spend and per-minute tool-call ceilings across many runs.\n  perSubjectDailyUsd: 2.00    # one patient or staff user\n  perTenantDailyUsd: 60.00    # one clinic\n  fleetDailyUsd: 900.00       # all clinics\n  perTenantToolCallsPerMinute: 240\n  fleetToolCallsPerMinute: 2400\n\npricingUsdPerMTok:\n  claude-sonnet-4-5-20250929: { input: 3.00, output: 15.00, cacheRead: 0.30, cacheWrite: 3.75 }\n  claude-haiku-4-5-20251001: { input: 1.00, output: 5.00, cacheRead: 0.10, cacheWrite: 1.25 }\n\n# When a limit is hit the run stops, the stop is audited with the limit name, and the\n# conversation is handed to the clinic's front-desk queue.\nonExceed: handoff_to_staff\n# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\npolicyVersion: \"2026-09-18.3\"\n\n# Tools that never run without a staff approval bound to the request.\nhighImpactTools:\n  - ehr__cancel_appointment\n  - payments__refund_deposit\n  - sms__send_freeform\n\napproval:\n  ttlSeconds: 900\n  approverRoles:\n    - front_desk_lead\n    - clinic_manager\n  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n  table: clinic-agent-approvals\n# Every tool the scheduling agent may call, with the task it serves.\n# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n# are not used for allow or approval decisions.\nrole: scheduling_agent\ntools:\n  - tool: ehr__find_patient\n    reason: Match the sender to a patient record by date of birth and phone or email.\n  - tool: ehr__search_slots\n    reason: List open slots for a provider, location, and visit type.\n  - tool: ehr__get_appointment\n    reason: Read one appointment the patient asks about.\n  - tool: ehr__list_patient_appointments\n    reason: Show the patient their upcoming appointments.\n  - tool: ehr__book_appointment\n    reason: Book a slot the patient chose.\n  - tool: ehr__update_appointment\n    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n  - tool: ehr__cancel_appointment\n    reason: Cancel an appointment at the patient's request.\n  - tool: payments__refund_deposit\n    reason: Refund a no-show deposit after staff review.\n  - tool: sms__send_to_patient\n    reason: Send a templated message to the phone number on the patient's record.\n  - tool: sms__send_freeform\n    reason: Send a staff-approved message that is not one of the templates.\n  - tool: insurance__check_eligibility\n    reason: Ask the eligibility agent whether a visit is covered.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01RR6uogQSpfGW7jPcYs3bZa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
