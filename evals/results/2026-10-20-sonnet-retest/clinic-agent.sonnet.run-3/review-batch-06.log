{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012ToJcGde14xxaq5U9Kmufk","type":"tool_result","content":"     1\t# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:\n     2\t# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.\n     3\tresource \"aws_iam_role\" \"runtime\" {\n     4\t  name                 = \"clinic-agent-runtime\"\n     5\t  max_session_duration = 3600\n     6\t  assume_role_policy = jsonencode({\n     7\t    Version = \"2012-10-17\"\n     8\t    Statement = [{\n     9\t      Effect    = \"Allow\"\n    10\t      Principal = { Federated = module.eks.oidc_provider_arn }\n    11\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n    12\t      Condition = {\n    13\t        StringEquals = {\n    14\t          \"${module.eks.oidc_provider}:sub\" = [\n    15\t            \"system:serviceaccount:clinic-agent:clinic-agent\",\n    16\t            \"system:serviceaccount:clinic-agent:clinic-agent-reminders\",\n    17\t          ]\n    18\t          \"${module.eks.oidc_provider}:aud\" = \"sts.amazonaws.com\"\n    19\t        }\n    20\t      }\n    21\t    }]\n    22\t  })\n    23\t}\n    24\t\n    25\tresource \"aws_iam_role_policy\" \"runtime\" {\n    26\t  name = \"clinic-agent-runtime\"\n    27\t  role = aws_iam_role.runtime.id\n    28\t  policy = jsonencode({\n    29\t    Version = \"2012-10-17\"\n    30\t    Statement = [\n    31\t      {\n    32\t        Sid      = \"ReadClinicSecrets\"\n    33\t        Effect   = \"Allow\"\n    34\t        Action   = [\"secretsmanager:GetSecretValue\"]\n    35\t        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\n    36\t      },\n    37\t      {\n    38\t        Sid    = \"AgentState\"\n    39\t        Effect = \"Allow\"\n    40\t        Action = [\n    41\t          \"dynamodb:GetItem\",\n    42\t          \"dynamodb:BatchGetItem\",\n    43\t          \"dynamodb:PutItem\",\n    44\t          \"dynamodb:UpdateItem\",\n    45\t          \"dynamodb:Query\",\n    46\t        ]\n    47\t        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*\"\n    48\t      },\n    49\t      {\n    50\t        Sid      = \"Audit\"\n    51\t        Effect   = \"Allow\"\n    52\t        Action   = [\"firehose:PutRecord\", \"firehose:PutRecordBatch\"]\n    53\t        Resource = aws_kinesis_firehose_delivery_stream.audit.arn\n    54\t      },\n    55\t    ]\n    56\t  })\n    57\t}\n    58\t\n    59\t# Operators who may stop the agent. Assumable only through SSO by the on-call group.\n    60\tresource \"aws_iam_role\" \"ops_killswitch\" {\n    61\t  name = \"clinic-agent-ops\"\n    62\t  assume_role_policy = jsonencode({\n    63\t    Version = \"2012-10-17\"\n    64\t    Statement = [{\n    65\t      Effect    = \"Allow\"\n    66\t      Principal = { AWS = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\" }\n    67\t      Action    = \"sts:AssumeRole\"\n    68\t      Condition = {\n    69\t        StringLike = { \"aws:PrincipalArn\" = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*\" }\n    70\t      }\n    71\t    }]\n    72\t  })\n    73\t}\n    74\t\n    75\tresource \"aws_iam_role_policy\" \"ops_killswitch\" {\n    76\t  name = \"clinic-agent-ops\"\n    77\t  role = aws_iam_role.ops_killswitch.id\n    78\t  policy = jsonencode({\n    79\t    Version = \"2012-10-17\"\n    80\t    Statement = [{\n    81\t      Effect   = \"Allow\"\n    82\t      Action   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:GetItem\"]\n    83\t      Resource = aws_dynamodb_table.control.arn\n    84\t    }]\n    85\t  })\n    86\t}\n    87\t\n    88\tresource \"aws_iam_role\" \"firehose\" {\n    89\t  name = \"clinic-agent-audit-firehose\"\n    90\t  assume_role_policy = jsonencode({\n    91\t    Version   = \"2012-10-17\"\n    92\t    Statement = [{ Effect = \"Allow\", Principal = { Service = \"firehose.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n    93\t  })\n    94\t}\n    95\t\n    96\tresource \"aws_iam_role_policy\" \"firehose\" {\n    97\t  name = \"write-audit-bucket\"\n    98\t  role = aws_iam_role.firehose.id\n    99\t  policy = jsonencode({\n   100\t    Version = \"2012-10-17\"\n   101\t    Statement = [{\n   102\t      Effect   = \"Allow\"\n   103\t      Action   = [\"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:GetBucketLocation\"]\n   104\t      Resource = [aws_s3_bucket.audit.arn, \"${aws_s3_bucket.audit.arn}/*\"]\n   105\t    }]\n   106\t  })\n   107\t}\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: clinic-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.33\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: clinic-agent\n    15\t  namespace: clinic-agent\n    16\t  annotations:\n    17\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    18\t    eks.amazonaws.com/token-expiration: \"3600\"\n    19\tautomountServiceAccountToken: false\n    20\t---\n    21\tapiVersion: v1\n    22\tkind: ServiceAccount\n    23\tmetadata:\n    24\t  name: clinic-agent-reminders\n    25\t  namespace: clinic-agent\n    26\t  annotations:\n    27\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    28\tautomountServiceAccountToken: false\n    29\t---\n    30\tapiVersion: v1\n    31\tkind: ConfigMap\n    32\tmetadata:\n    33\t  name: clinic-agent\n    34\t  namespace: clinic-agent\n    35\tdata:\n    36\t  CLINIC_DIRECTORY: |\n    37\t    [{\"id\":\"nb-castro\",\"name\":\"Northbay Castro\",\"smsNumber\":\"+14155550110\"},\n    38\t     {\"id\":\"nb-fremont\",\"name\":\"Northbay Fremont\",\"smsNumber\":\"+15105550111\"},\n    39\t     {\"id\":\"nb-oakland\",\"name\":\"Northbay Oakland\",\"smsNumber\":\"+15105550112\"},\n    40\t     {\"id\":\"nb-sanmateo\",\"name\":\"Northbay San Mateo\",\"smsNumber\":\"+16505550113\"},\n    41\t     {\"id\":\"nb-walnutcreek\",\"name\":\"Northbay Walnut Creek\",\"smsNumber\":\"+19255550114\"}]\n    42\t  SMS_SIGNING_SECRET_ARN: arn:aws:secretsmanager:us-west-2:418295730611:secret:clinic-agent/sms-signing\n    43\t  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n    44\t  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n    45\t---\n    46\tapiVersion: apps/v1\n    47\tkind: Deployment\n    48\tmetadata:\n    49\t  name: clinic-agent\n    50\t  namespace: clinic-agent\n    51\t  labels: { app: clinic-agent }\n    52\tspec:\n    53\t  replicas: 3\n    54\t  selector:\n    55\t    matchLabels: { app: clinic-agent }\n    56\t  template:\n    57\t    metadata:\n    58\t      labels: { app: clinic-agent }\n    59\t    spec:\n    60\t      serviceAccountName: clinic-agent\n    61\t      automountServiceAccountToken: false\n    62\t      hostUsers: false\n    63\t      hostNetwork: false\n    64\t      hostPID: false\n    65\t      hostIPC: false\n    66\t      enableServiceLinks: false\n    67\t      securityContext:\n    68\t        runAsNonRoot: true\n    69\t        runAsUser: 65532\n    70\t        runAsGroup: 65532\n    71\t        fsGroup: 65532\n    72\t        seccompProfile:\n    73\t          type: RuntimeDefault\n    74\t      containers:\n    75\t        - name: agent\n    76\t          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    77\t          ports:\n    78\t            - containerPort: 8080\n    79\t          envFrom:\n    80\t            - configMapRef: { name: clinic-agent }\n    81\t          env:\n    82\t            - name: IMAGE_DIGEST\n    83\t              value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    84\t            - name: GIT_SHA\n    85\t              value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n    86\t          securityContext:\n    87\t            allowPrivilegeEscalation: false\n    88\t            privileged: false\n    89\t            readOnlyRootFilesystem: true\n    90\t            runAsNonRoot: true\n    91\t            capabilities:\n    92\t              drop: [\"ALL\"]\n    93\t            seccompProfile:\n    94\t              type: RuntimeDefault\n    95\t          resources:\n    96\t            requests: { cpu: 250m, memory: 384Mi }\n    97\t            limits: { cpu: \"1\", memory: 768Mi }\n    98\t          readinessProbe:\n    99\t            httpGet: { path: /healthz, port: 8080 }\n   100\t          volumeMounts:\n   101\t            - { name: tmp, mountPath: /tmp }\n   102\t            - { name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true }\n   103\t      volumes:\n   104\t        - name: tmp\n   105\t          emptyDir: { medium: Memory, sizeLimit: 32Mi }\n   106\t        - name: sts-token\n   107\t          projected:\n   108\t            sources:\n   109\t              - serviceAccountToken:\n   110\t                  audience: https://sts.northbay-clinics.example\n   111\t                  expirationSeconds: 900\n   112\t                  path: sts-token\n   113\t---\n   114\tapiVersion: batch/v1\n   115\tkind: CronJob\n   116\tmetadata:\n   117\t  name: clinic-agent-reminders\n   118\t  namespace: clinic-agent\n   119\tspec:\n   120\t  schedule: \"0 17 * * *\"\n   121\t  timeZone: America/Los_Angeles\n   122\t  concurrencyPolicy: Forbid\n   123\t  jobTemplate:\n   124\t    spec:\n   125\t      backoffLimit: 0\n   126\t      activeDeadlineSeconds: 1800\n   127\t      template:\n   128\t        metadata:\n   129\t          labels: { app: clinic-agent-reminders }\n   130\t        spec:\n   131\t          serviceAccountName: clinic-agent-reminders\n   132\t          automountServiceAccountToken: false\n   133\t          restartPolicy: Never\n   134\t          hostUsers: false\n   135\t          securityContext:\n   136\t            runAsNonRoot: true\n   137\t            runAsUser: 65532\n   138\t            runAsGroup: 65532\n   139\t            seccompProfile:\n   140\t              type: RuntimeDefault\n   141\t          containers:\n   142\t            - name: reminders\n   143\t              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   144\t              args: [\"dist/workers/reminders.js\"]\n   145\t              envFrom:\n   146\t                - configMapRef: { name: clinic-agent }\n   147\t              env:\n   148\t                - name: IMAGE_DIGEST\n   149\t                  value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   150\t                - name: GIT_SHA\n   151\t                  value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n   152\t              securityContext:\n   153\t                allowPrivilegeEscalation: false\n   154\t                privileged: false\n   155\t                readOnlyRootFilesystem: true\n   156\t                capabilities:\n   157\t                  drop: [\"ALL\"]\n   158\t---\n   159\t# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n   160\t# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,\n   161\t# the group STS and auth service, and AWS service endpoints.\n   162\tapiVersion: networking.k8s.io/v1\n   163\tkind: NetworkPolicy\n   164\tmetadata:\n   165\t  name: clinic-agent-egress\n   166\t  namespace: clinic-agent\n   167\tspec:\n   168\t  podSelector: {}\n   169\t  policyTypes: [\"Egress\", \"Ingress\"]\n   170\t  ingress:\n   171\t    - from:\n   172\t        - namespaceSelector:\n   173\t            matchLabels: { kubernetes.io/metadata.name: ingress }\n   174\t      ports:\n   175\t        - { port: 8080, protocol: TCP }\n   176\t  egress:\n   177\t    - to:\n   178\t        - namespaceSelector:\n   179\t            matchLabels: { kubernetes.io/metadata.name: kube-system }\n   180\t          podSelector:\n   181\t            matchLabels: { k8s-app: kube-dns }\n   182\t      ports:\n   183\t        - { port: 53, protocol: UDP }\n   184\t        - { port: 53, protocol: TCP }\n   185\t    - to:\n   186\t        - namespaceSelector:\n   187\t            matchLabels: { kubernetes.io/metadata.name: platform }\n   188\t          podSelector:\n   189\t            matchLabels: { app: egress-proxy }\n   190\t      ports:\n   191\t        - { port: 3128, protocol: TCP }\n   192\t    - to:\n   193\t        - ipBlock: { cidr: 10.60.12.0/28 }\n   194\t      ports:\n   195\t        - { port: 443, protocol: TCP }\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n     5\t// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n     6\t// The provider enforces Idempotency-Key for 24 hours.\n     7\t\n     8\tconst sm = new SecretsManagerClient({ region: env.region });\n     9\tconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n    10\t\n    11\tasync function key(clinicId: string): Promise<string> {\n    12\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n    13\t  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n    14\t}\n    15\t\n    16\texport interface Refund {\n    17\t  id: string;\n    18\t  depositId: string;\n    19\t  amountCents: number;\n    20\t  status: \"pending\" | \"succeeded\" | \"failed\";\n    21\t}\n    22\t\n    23\texport const payments = {\n    24\t  async refundDeposit(\n    25\t    clinicId: string,\n    26\t    req: { depositId: string; reason: string; idempotencyKey: string },\n    27\t    signal?: AbortSignal,\n    28\t  ): Promise<Refund> {\n    29\t    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n    30\t      method: \"POST\",\n    31\t      signal,\n    32\t      headers: {\n    33\t        authorization: `Bearer ${await key(clinicId)}`,\n    34\t        \"content-type\": \"application/json\",\n    35\t        \"idempotency-key\": req.idempotencyKey,\n    36\t      },\n    37\t      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    38\t    });\n    39\t    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    40\t    return (await res.json()) as Refund;\n    41\t  },\n    42\t};\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n     5\t// can send; free-form text goes through sms__send_freeform, which needs approval.\n     6\t\n     7\tconst sm = new SecretsManagerClient({ region: env.region });\n     8\tconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n     9\t\n    10\texport const TEMPLATES = {\n    11\t  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n    12\t  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n    13\t  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n    14\t  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n    15\t} as const;\n    16\texport type TemplateId = keyof typeof TEMPLATES;\n    17\t\n    18\texport function render(id: TemplateId, vars: Record<string, string>): string {\n    19\t  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n    20\t}\n    21\t\n    22\tasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n    23\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n    24\t  const v = JSON.parse(s.SecretString ?? \"{}\");\n    25\t  return { token: v.api_token, from: v.from_number };\n    26\t}\n    27\t\n    28\texport const sms = {\n    29\t  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n    30\t    const c = await creds(clinicId);\n    31\t    const res = await fetch(`${BASE}/messages`, {\n    32\t      method: \"POST\",\n    33\t      signal,\n    34\t      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n    35\t      body: JSON.stringify({ from: c.from, to, body }),\n    36\t    });\n    37\t    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n    38\t    return (await res.json()) as { messageId: string };\n    39\t  },\n    40\t};","is_error":false}]},"parent_tool_use_id":null,"session_id":"f7a3da56-dd90-4bb0-a187-5c09c45dabd2","uuid":"e362986e-2690-4109-9444-153df2b51659","timestamp":"2026-10-20T15:32:32.365Z","tool_use_result":{"stdout":"     1\t# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:\n     2\t# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.\n     3\tresource \"aws_iam_role\" \"runtime\" {\n     4\t  name                 = \"clinic-agent-runtime\"\n     5\t  max_session_duration = 3600\n     6\t  assume_role_policy = jsonencode({\n     7\t    Version = \"2012-10-17\"\n     8\t    Statement = [{\n     9\t      Effect    = \"Allow\"\n    10\t      Principal = { Federated = module.eks.oidc_provider_arn }\n    11\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n    12\t      Condition = {\n    13\t        StringEquals = {\n    14\t          \"${module.eks.oidc_provider}:sub\" = [\n    15\t            \"system:serviceaccount:clinic-agent:clinic-agent\",\n    16\t            \"system:serviceaccount:clinic-agent:clinic-agent-reminders\",\n    17\t          ]\n    18\t          \"${module.eks.oidc_provider}:aud\" = \"sts.amazonaws.com\"\n    19\t        }\n    20\t      }\n    21\t    }]\n    22\t  })\n    23\t}\n    24\t\n    25\tresource \"aws_iam_role_policy\" \"runtime\" {\n    26\t  name = \"clinic-agent-runtime\"\n    27\t  role = aws_iam_role.runtime.id\n    28\t  policy = jsonencode({\n    29\t    Version = \"2012-10-17\"\n    30\t    Statement = [\n    31\t      {\n    32\t        Sid      = \"ReadClinicSecrets\"\n    33\t        Effect   = \"Allow\"\n    34\t        Action   = [\"secretsmanager:GetSecretValue\"]\n    35\t        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\n    36\t      },\n    37\t      {\n    38\t        Sid    = \"AgentState\"\n    39\t        Effect = \"Allow\"\n    40\t        Action = [\n    41\t          \"dynamodb:GetItem\",\n    42\t          \"dynamodb:BatchGetItem\",\n    43\t          \"dynamodb:PutItem\",\n    44\t          \"dynamodb:UpdateItem\",\n    45\t          \"dynamodb:Query\",\n    46\t        ]\n    47\t        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*\"\n    48\t      },\n    49\t      {\n    50\t        Sid      = \"Audit\"\n    51\t        Effect   = \"Allow\"\n    52\t        Action   = [\"firehose:PutRecord\", \"firehose:PutRecordBatch\"]\n    53\t        Resource = aws_kinesis_firehose_delivery_stream.audit.arn\n    54\t      },\n    55\t    ]\n    56\t  })\n    57\t}\n    58\t\n    59\t# Operators who may stop the agent. Assumable only through SSO by the on-call group.\n    60\tresource \"aws_iam_role\" \"ops_killswitch\" {\n    61\t  name = \"clinic-agent-ops\"\n    62\t  assume_role_policy = jsonencode({\n    63\t    Version = \"2012-10-17\"\n    64\t    Statement = [{\n    65\t      Effect    = \"Allow\"\n    66\t      Principal = { AWS = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\" }\n    67\t      Action    = \"sts:AssumeRole\"\n    68\t      Condition = {\n    69\t        StringLike = { \"aws:PrincipalArn\" = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*\" }\n    70\t      }\n    71\t    }]\n    72\t  })\n    73\t}\n    74\t\n    75\tresource \"aws_iam_role_policy\" \"ops_killswitch\" {\n    76\t  name = \"clinic-agent-ops\"\n    77\t  role = aws_iam_role.ops_killswitch.id\n    78\t  policy = jsonencode({\n    79\t    Version = \"2012-10-17\"\n    80\t    Statement = [{\n    81\t      Effect   = \"Allow\"\n    82\t      Action   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:GetItem\"]\n    83\t      Resource = aws_dynamodb_table.control.arn\n    84\t    }]\n    85\t  })\n    86\t}\n    87\t\n    88\tresource \"aws_iam_role\" \"firehose\" {\n    89\t  name = \"clinic-agent-audit-firehose\"\n    90\t  assume_role_policy = jsonencode({\n    91\t    Version   = \"2012-10-17\"\n    92\t    Statement = [{ Effect = \"Allow\", Principal = { Service = \"firehose.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n    93\t  })\n    94\t}\n    95\t\n    96\tresource \"aws_iam_role_policy\" \"firehose\" {\n    97\t  name = \"write-audit-bucket\"\n    98\t  role = aws_iam_role.firehose.id\n    99\t  policy = jsonencode({\n   100\t    Version = \"2012-10-17\"\n   101\t    Statement = [{\n   102\t      Effect   = \"Allow\"\n   103\t      Action   = [\"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:GetBucketLocation\"]\n   104\t      Resource = [aws_s3_bucket.audit.arn, \"${aws_s3_bucket.audit.arn}/*\"]\n   105\t    }]\n   106\t  })\n   107\t}\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: clinic-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.33\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: clinic-agent\n    15\t  namespace: clinic-agent\n    16\t  annotations:\n    17\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    18\t    eks.amazonaws.com/token-expiration: \"3600\"\n    19\tautomountServiceAccountToken: false\n    20\t---\n    21\tapiVersion: v1\n    22\tkind: ServiceAccount\n    23\tmetadata:\n    24\t  name: clinic-agent-reminders\n    25\t  namespace: clinic-agent\n    26\t  annotations:\n    27\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    28\tautomountServiceAccountToken: false\n    29\t---\n    30\tapiVersion: v1\n    31\tkind: ConfigMap\n    32\tmetadata:\n    33\t  name: clinic-agent\n    34\t  namespace: clinic-agent\n    35\tdata:\n    36\t  CLINIC_DIRECTORY: |\n    37\t    [{\"id\":\"nb-castro\",\"name\":\"Northbay Castro\",\"smsNumber\":\"+14155550110\"},\n    38\t     {\"id\":\"nb-fremont\",\"name\":\"Northbay Fremont\",\"smsNumber\":\"+15105550111\"},\n    39\t     {\"id\":\"nb-oakland\",\"name\":\"Northbay Oakland\",\"smsNumber\":\"+15105550112\"},\n    40\t     {\"id\":\"nb-sanmateo\",\"name\":\"Northbay San Mateo\",\"smsNumber\":\"+16505550113\"},\n    41\t     {\"id\":\"nb-walnutcreek\",\"name\":\"Northbay Walnut Creek\",\"smsNumber\":\"+19255550114\"}]\n    42\t  SMS_SIGNING_SECRET_ARN: arn:aws:secretsmanager:us-west-2:418295730611:secret:clinic-agent/sms-signing\n    43\t  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n    44\t  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n    45\t---\n    46\tapiVersion: apps/v1\n    47\tkind: Deployment\n    48\tmetadata:\n    49\t  name: clinic-agent\n    50\t  namespace: clinic-agent\n    51\t  labels: { app: clinic-agent }\n    52\tspec:\n    53\t  replicas: 3\n    54\t  selector:\n    55\t    matchLabels: { app: clinic-agent }\n    56\t  template:\n    57\t    metadata:\n    58\t      labels: { app: clinic-agent }\n    59\t    spec:\n    60\t      serviceAccountName: clinic-agent\n    61\t      automountServiceAccountToken: false\n    62\t      hostUsers: false\n    63\t      hostNetwork: false\n    64\t      hostPID: false\n    65\t      hostIPC: false\n    66\t      enableServiceLinks: false\n    67\t      securityContext:\n    68\t        runAsNonRoot: true\n    69\t        runAsUser: 65532\n    70\t        runAsGroup: 65532\n    71\t        fsGroup: 65532\n    72\t        seccompProfile:\n    73\t          type: RuntimeDefault\n    74\t      containers:\n    75\t        - name: agent\n    76\t          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    77\t          ports:\n    78\t            - containerPort: 8080\n    79\t          envFrom:\n    80\t            - configMapRef: { name: clinic-agent }\n    81\t          env:\n    82\t            - name: IMAGE_DIGEST\n    83\t              value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    84\t            - name: GIT_SHA\n    85\t              value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n    86\t          securityContext:\n    87\t            allowPrivilegeEscalation: false\n    88\t            privileged: false\n    89\t            readOnlyRootFilesystem: true\n    90\t            runAsNonRoot: true\n    91\t            capabilities:\n    92\t              drop: [\"ALL\"]\n    93\t            seccompProfile:\n    94\t              type: RuntimeDefault\n    95\t          resources:\n    96\t            requests: { cpu: 250m, memory: 384Mi }\n    97\t            limits: { cpu: \"1\", memory: 768Mi }\n    98\t          readinessProbe:\n    99\t            httpGet: { path: /healthz, port: 8080 }\n   100\t          volumeMounts:\n   101\t            - { name: tmp, mountPath: /tmp }\n   102\t            - { name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true }\n   103\t      volumes:\n   104\t        - name: tmp\n   105\t          emptyDir: { medium: Memory, sizeLimit: 32Mi }\n   106\t        - name: sts-token\n   107\t          projected:\n   108\t            sources:\n   109\t              - serviceAccountToken:\n   110\t                  audience: https://sts.northbay-clinics.example\n   111\t                  expirationSeconds: 900\n   112\t                  path: sts-token\n   113\t---\n   114\tapiVersion: batch/v1\n   115\tkind: CronJob\n   116\tmetadata:\n   117\t  name: clinic-agent-reminders\n   118\t  namespace: clinic-agent\n   119\tspec:\n   120\t  schedule: \"0 17 * * *\"\n   121\t  timeZone: America/Los_Angeles\n   122\t  concurrencyPolicy: Forbid\n   123\t  jobTemplate:\n   124\t    spec:\n   125\t      backoffLimit: 0\n   126\t      activeDeadlineSeconds: 1800\n   127\t      template:\n   128\t        metadata:\n   129\t          labels: { app: clinic-agent-reminders }\n   130\t        spec:\n   131\t          serviceAccountName: clinic-agent-reminders\n   132\t          automountServiceAccountToken: false\n   133\t          restartPolicy: Never\n   134\t          hostUsers: false\n   135\t          securityContext:\n   136\t            runAsNonRoot: true\n   137\t            runAsUser: 65532\n   138\t            runAsGroup: 65532\n   139\t            seccompProfile:\n   140\t              type: RuntimeDefault\n   141\t          containers:\n   142\t            - name: reminders\n   143\t              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   144\t              args: [\"dist/workers/reminders.js\"]\n   145\t              envFrom:\n   146\t                - configMapRef: { name: clinic-agent }\n   147\t              env:\n   148\t                - name: IMAGE_DIGEST\n   149\t                  value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   150\t                - name: GIT_SHA\n   151\t                  value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n   152\t              securityContext:\n   153\t                allowPrivilegeEscalation: false\n   154\t                privileged: false\n   155\t                readOnlyRootFilesystem: true\n   156\t                capabilities:\n   157\t                  drop: [\"ALL\"]\n   158\t---\n   159\t# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n   160\t# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,\n   161\t# the group STS and auth service, and AWS service endpoints.\n   162\tapiVersion: networking.k8s.io/v1\n   163\tkind: NetworkPolicy\n   164\tmetadata:\n   165\t  name: clinic-agent-egress\n   166\t  namespace: clinic-agent\n   167\tspec:\n   168\t  podSelector: {}\n   169\t  policyTypes: [\"Egress\", \"Ingress\"]\n   170\t  ingress:\n   171\t    - from:\n   172\t        - namespaceSelector:\n   173\t            matchLabels: { kubernetes.io/metadata.name: ingress }\n   174\t      ports:\n   175\t        - { port: 8080, protocol: TCP }\n   176\t  egress:\n   177\t    - to:\n   178\t        - namespaceSelector:\n   179\t            matchLabels: { kubernetes.io/metadata.name: kube-system }\n   180\t          podSelector:\n   181\t            matchLabels: { k8s-app: kube-dns }\n   182\t      ports:\n   183\t        - { port: 53, protocol: UDP }\n   184\t        - { port: 53, protocol: TCP }\n   185\t    - to:\n   186\t        - namespaceSelector:\n   187\t            matchLabels: { kubernetes.io/metadata.name: platform }\n   188\t          podSelector:\n   189\t            matchLabels: { app: egress-proxy }\n   190\t      ports:\n   191\t        - { port: 3128, protocol: TCP }\n   192\t    - to:\n   193\t        - ipBlock: { cidr: 10.60.12.0/28 }\n   194\t      ports:\n   195\t        - { port: 443, protocol: TCP }\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n     5\t// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n     6\t// The provider enforces Idempotency-Key for 24 hours.\n     7\t\n     8\tconst sm = new SecretsManagerClient({ region: env.region });\n     9\tconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n    10\t\n    11\tasync function key(clinicId: string): Promise<string> {\n    12\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n    13\t  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n    14\t}\n    15\t\n    16\texport interface Refund {\n    17\t  id: string;\n    18\t  depositId: string;\n    19\t  amountCents: number;\n    20\t  status: \"pending\" | \"succeeded\" | \"failed\";\n    21\t}\n    22\t\n    23\texport const payments = {\n    24\t  async refundDeposit(\n    25\t    clinicId: string,\n    26\t    req: { depositId: string; reason: string; idempotencyKey: string },\n    27\t    signal?: AbortSignal,\n    28\t  ): Promise<Refund> {\n    29\t    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n    30\t      method: \"POST\",\n    31\t      signal,\n    32\t      headers: {\n    33\t        authorization: `Bearer ${await key(clinicId)}`,\n    34\t        \"content-type\": \"application/json\",\n    35\t        \"idempotency-key\": req.idempotencyKey,\n    36\t      },\n    37\t      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    38\t    });\n    39\t    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    40\t    return (await res.json()) as Refund;\n    41\t  },\n    42\t};\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n     5\t// can send; free-form text goes through sms__send_freeform, which needs approval.\n     6\t\n     7\tconst sm = new SecretsManagerClient({ region: env.region });\n     8\tconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n     9\t\n    10\texport const TEMPLATES = {\n    11\t  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n    12\t  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n    13\t  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n    14\t  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n    15\t} as const;\n    16\texport type TemplateId = keyof typeof TEMPLATES;\n    17\t\n    18\texport function render(id: TemplateId, vars: Record<string, string>): string {\n    19\t  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n    20\t}\n    21\t\n    22\tasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n    23\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n    24\t  const v = JSON.parse(s.SecretString ?? \"{}\");\n    25\t  return { token: v.api_token, from: v.from_number };\n    26\t}\n    27\t\n    28\texport const sms = {\n    29\t  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n    30\t    const c = await creds(clinicId);\n    31\t    const res = await fetch(`${BASE}/messages`, {\n    32\t      method: \"POST\",\n    33\t      signal,\n    34\t      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n    35\t      body: JSON.stringify({ from: c.from, to, body }),\n    36\t    });\n    37\t    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n    38\t    return (await res.json()) as { messageId: string };\n    39\t  },\n    40\t};","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_012ToJcGde14xxaq5U9Kmufk","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
