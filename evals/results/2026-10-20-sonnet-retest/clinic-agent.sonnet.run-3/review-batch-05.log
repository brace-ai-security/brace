{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDj5LZdZT4ZNsuQryqQN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HDBWRJ2dzYNzPuEeUs3yoj","name":"Bash","input":{"command":"cat -n config/*.yaml src/integrations/eligibility-a2a.ts src/workflows/eligibility-check.ts src/integrations/ehr-mcp.ts; cat -n infra/terraform/iam.tf; grep -n -i \"control\\|restart\\|backoff\\|Job\\|kind:\\|serviceAccount\\|activeDeadline\\|terminationGrace\\|automount\" k8s/deployment.yaml infra/terraform/main.tf"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10119,"cache_read_input_tokens":29598,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10119},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b74c3fae-7886-433c-bc86-7215f2b07e8b","uuid":"24f3dc6b-7e9b-4e74-a210-764dba5bf496","timestamp":"2026-10-20T15:28:52.713Z","request_id":"req_011CgDj5LJFNvZhpUERx1RTb","wire_tool_inputs":{"toolu_01HDBWRJ2dzYNzPuEeUs3yoj":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-62ds8r2b/agent && cat -n config/*.yaml src/integrations/eligibility-a2a.ts src/workflows/eligibility-check.ts src/integrations/ehr-mcp.ts; cat -n infra/terraform/iam.tf; grep -n -i \"control\\|restart\\|backoff\\|Job\\|kind:\\|serviceAccount\\|activeDeadline\\|terminationGrace\\|automount\" k8s/deployment.yaml infra/terraform/main.tf"}},"wire_ingest_context":{"toolu_01HDBWRJ2dzYNzPuEeUs3yoj":{"cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-62ds8r2b/agent"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HDBWRJ2dzYNzPuEeUs3yoj","type":"tool_result","content":"     1\t# Hard limits enforced by src/agent/budget.ts, outside the model.\n     2\trun:\n     3\t  maxTurns: 8                 # model calls per run\n     4\t  maxWallMs: 45000            # whole run, including tool calls\n     5\t  maxInputTokens: 120000      # summed across model calls in the run\n     6\t  maxOutputTokens: 6000\n     7\t  maxCostUsd: 0.40\n     8\t  maxToolCalls: 16\n     9\t  maxToolCallsPerMinute: 12\n    10\t  maxPeerCalls: 2             # calls to the eligibility agent; this agent starts no sub-agents\n    11\t\n    12\tquotas:\n    13\t  # Daily spend and per-minute tool-call ceilings across many runs.\n    14\t  perSubjectDailyUsd: 2.00    # one patient or staff user\n    15\t  perTenantDailyUsd: 60.00    # one clinic\n    16\t  fleetDailyUsd: 900.00       # all clinics\n    17\t  perTenantToolCallsPerMinute: 240\n    18\t  fleetToolCallsPerMinute: 2400\n    19\t\n    20\tpricingUsdPerMTok:\n    21\t  claude-sonnet-4-5-20250929: { input: 3.00, output: 15.00, cacheRead: 0.30, cacheWrite: 3.75 }\n    22\t  claude-haiku-4-5-20251001: { input: 1.00, output: 5.00, cacheRead: 0.10, cacheWrite: 1.25 }\n    23\t\n    24\t# When a limit is hit the run stops, the stop is audited with the limit name, and the\n    25\t# conversation is handed to the clinic's front-desk queue.\n    26\tonExceed: handoff_to_staff\n     1\t# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\n     2\tpolicyVersion: \"2026-09-18.3\"\n     3\t\n     4\t# Tools that never run without a staff approval bound to the request.\n     5\thighImpactTools:\n     6\t  - ehr__cancel_appointment\n     7\t  - payments__refund_deposit\n     8\t  - sms__send_freeform\n     9\t\n    10\tapproval:\n    11\t  ttlSeconds: 900\n    12\t  approverRoles:\n    13\t    - front_desk_lead\n    14\t    - clinic_manager\n    15\t  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n    16\t  table: clinic-agent-approvals\n     1\t# Every tool the scheduling agent may call, with the task it serves.\n     2\t# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n     3\t# are not used for allow or approval decisions.\n     4\trole: scheduling_agent\n     5\ttools:\n     6\t  - tool: ehr__find_patient\n     7\t    reason: Match the sender to a patient record by date of birth and phone or email.\n     8\t  - tool: ehr__search_slots\n     9\t    reason: List open slots for a provider, location, and visit type.\n    10\t  - tool: ehr__get_appointment\n    11\t    reason: Read one appointment the patient asks about.\n    12\t  - tool: ehr__list_patient_appointments\n    13\t    reason: Show the patient their upcoming appointments.\n    14\t  - tool: ehr__book_appointment\n    15\t    reason: Book a slot the patient chose.\n    16\t  - tool: ehr__update_appointment\n    17\t    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n    18\t  - tool: ehr__cancel_appointment\n    19\t    reason: Cancel an appointment at the patient's request.\n    20\t  - tool: payments__refund_deposit\n    21\t    reason: Refund a no-show deposit after staff review.\n    22\t  - tool: sms__send_to_patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.\n     1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n     7\t//\n     8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n     9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n    10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n    11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n    12\t//\n    13\t// Answers come back as a signed attestation (JWS) inside a data part.\n    14\t\n    15\tconst Eligibility = z\n    16\t  .object({\n    17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    18\t    planName: z.string().max(120).optional(),\n    19\t    copayCents: z.number().int().nonnegative().optional(),\n    20\t    depositWaived: z.boolean().default(false),\n    21\t    checkedAt: z.string().datetime(),\n    22\t  })\n    23\t  .strict();\n    24\texport type Eligibility = z.infer<typeof Eligibility>;\n    25\t\n    26\tconst Rpc = z.object({\n    27\t  jsonrpc: z.literal(\"2.0\"),\n    28\t  id: z.string(),\n    29\t  result: z.object({\n    30\t    kind: z.literal(\"message\"),\n    31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n    32\t  }),\n    33\t});\n    34\t\n    35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n    36\t  const res = await fetch(env.tokenExchangeUrl, {\n    37\t    method: \"POST\",\n    38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    39\t    body: new URLSearchParams({\n    40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    41\t      subject_token: workloadToken,\n    42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n    43\t      audience: \"eligibility-agent\",\n    44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n    45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    46\t    }),\n    47\t  });\n    48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n    49\t  return ((await res.json()) as { access_token: string }).access_token;\n    50\t}\n    51\t\n    52\texport async function checkEligibility(\n    53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n    54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n    55\t): Promise<Eligibility> {\n    56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n    57\t  const requestId = randomUUID();\n    58\t  const res = await fetch(env.eligibilityUrl, {\n    59\t    method: \"POST\",\n    60\t    signal: opts.signal,\n    61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    62\t    body: JSON.stringify({\n    63\t      jsonrpc: \"2.0\",\n    64\t      id: requestId,\n    65\t      method: \"message/send\",\n    66\t      params: {\n    67\t        message: {\n    68\t          role: \"user\",\n    69\t          messageId: requestId,\n    70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n    71\t        },\n    72\t      },\n    73\t    }),\n    74\t  });\n    75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n    76\t  const text = await res.text();\n    77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n    78\t  const rpc = Rpc.parse(JSON.parse(text));\n    79\t\n    80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n    81\t  const header = decodeProtectedHeader(attestation);\n    82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n    83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n    84\t  const { payload } = await jwtVerify(attestation, keys, {\n    85\t    issuer: env.eligibilityIssuer,\n    86\t    audience: \"clinic-agent\",\n    87\t    maxTokenAge: \"5m\",\n    88\t    algorithms: [\"ES256\"],\n    89\t  });\n    90\t  return Eligibility.parse(payload.eligibility);\n    91\t}\n     1\timport { audit } from \"../audit/recorder.js\";\n     2\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     3\timport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\n     4\timport { payments } from \"../integrations/payments.js\";\n     5\timport type { RunContext } from \"../agent/identity.js\";\n     6\timport type { ContextSize } from \"../agent/context-size.js\";\n     7\t\n     8\t// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n     9\t// agent, and settles the visit deposit when the plan covers the visit.\n    10\t\n    11\texport async function checkEligibilityForAppointment(\n    12\t  ehr: Ehr,\n    13\t  input: { appointmentId: string },\n    14\t  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n    15\t): Promise<Eligibility & { depositRefundId?: string }> {\n    16\t  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n    17\t\n    18\t  const result = await checkEligibility(\n    19\t    {\n    20\t      clinicId: opts.clinicId,\n    21\t      patientId: appt.patientId,\n    22\t      payerId: appt.payerId,\n    23\t      serviceCode: appt.serviceCode,\n    24\t      dateOfService: appt.start.slice(0, 10),\n    25\t    },\n    26\t    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n    27\t  );\n    28\t  await audit.record({\n    29\t    ...opts.ctx.identity(),\n    30\t    runId: opts.ctx.runId,\n    31\t    subject: opts.ctx.subject,\n    32\t    event: \"peer.call\",\n    33\t    tool: \"insurance__check_eligibility\",\n    34\t    context: opts.context,\n    35\t    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n    36\t  });\n    37\t\n    38\t  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n    39\t  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n    40\t    const refund = await payments.refundDeposit(\n    41\t      opts.clinicId,\n    42\t      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n    43\t      opts.signal,\n    44\t    );\n    45\t    await audit.record({\n    46\t      ...opts.ctx.identity(),\n    47\t      runId: opts.ctx.runId,\n    48\t      subject: opts.ctx.subject,\n    49\t      event: \"payment.refund\",\n    50\t      tool: \"insurance__check_eligibility\",\n    51\t      context: opts.context,\n    52\t      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n    53\t    });\n    54\t    return { ...result, depositRefundId: refund.id };\n    55\t  }\n    56\t  return result;\n    57\t}\n     1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n     2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n     3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     4\timport { Agent } from \"undici\";\n     5\timport type { PeerCertificate } from \"node:tls\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n     8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n     9\t\n    10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n    11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n    12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n    13\t\n    14\tconst sm = new SecretsManagerClient({ region: env.region });\n    15\t\n    16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n    17\t  const expected = server.tlsCertSha256.toLowerCase();\n    18\t  return new Agent({\n    19\t    connect: {\n    20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n    21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n    22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n    23\t      },\n    24\t    },\n    25\t  });\n    26\t}\n    27\t\n    28\ttype Token = { value: string; exp: number };\n    29\tconst tokens = new Map<string, Token>();\n    30\t\n    31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n    32\t  const cacheKey = `${clinicId}|${scope}`;\n    33\t  const hit = tokens.get(cacheKey);\n    34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n    35\t\n    36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n    37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n    38\t  const res = await fetch(token_url, {\n    39\t    method: \"POST\",\n    40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n    42\t  });\n    43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n    44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n    45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n    46\t  return body.access_token;\n    47\t}\n    48\t\n    49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n    50\tconst sessions = new Map<string, Client>();\n    51\t\n    52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n    53\t  const existing = sessions.get(clinicId);\n    54\t  if (existing) return existing;\n    55\t  const token = await ehrToken(clinicId, SCOPES);\n    56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    57\t    requestInit: {\n    58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n    59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n    60\t      dispatcher: pinnedDispatcher(server),\n    61\t    },\n    62\t  });\n    63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n    64\t  await client.connect(transport);\n    65\t  sessions.set(clinicId, client);\n    66\t  setTimeout(() => {\n    67\t    sessions.delete(clinicId);\n    68\t    void client.close();\n    69\t  }, 4 * 60_000).unref();\n    70\t  return client;\n    71\t}\n    72\t\n    73\texport function ehr(server: ConfiguredServer) {\n    74\t  return {\n    75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n    76\t      const c = await session(server, \"_catalog\");\n    77\t      const [tools, prompts, templates] = await Promise.all([\n    78\t        c.listTools(),\n    79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n    80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n    81\t      ]);\n    82\t      return {\n    83\t        reportedName: c.getServerVersion()?.name,\n    84\t        meta: {\n    85\t          instructions: c.getInstructions(),\n    86\t          tools: tools.tools as ServerMeta[\"tools\"],\n    87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n    88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n    89\t        },\n    90\t      };\n    91\t    },\n    92\t\n    93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n    94\t      const c = await session(server, opts.clinicId);\n    95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n    96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n    97\t      return res.structuredContent ?? res.content;\n    98\t    },\n    99\t\n   100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n   101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n   102\t        id: string;\n   103\t        patientId: string;\n   104\t        start: string;\n   105\t        serviceCode: string;\n   106\t        payerId?: string;\n   107\t        depositId?: string;\n   108\t        status: string;\n   109\t      };\n   110\t    },\n   111\t\n   112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n   113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n   114\t        id: string;\n   115\t        patientId: string;\n   116\t        start: string;\n   117\t        phone: string;\n   118\t        smsOptIn: boolean;\n   119\t        locationName: string;\n   120\t      }>;\n   121\t    },\n   122\t  };\n   123\t}\n   124\texport type Ehr = ReturnType<typeof ehr>;\n     1\t# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:\n     2\t# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.\n     3\tresource \"aws_iam_role\" \"runtime\" {\n     4\t  name                 = \"clinic-agent-runtime\"\n     5\t  max_session_duration = 3600\n     6\t  assume_role_policy = jsonencode({\n     7\t    Version = \"2012-10-17\"\n     8\t    Statement = [{\n     9\t      Effect    = \"Allow\"\n    10\t      Principal = { Federated = module.eks.oidc_provider_arn }\n    11\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n    12\t      Condition = {\n    13\t        StringEquals = {\n    14\t          \"${module.eks.oidc_provider}:sub\" = [\n    15\t            \"system:serviceaccount:clinic-agent:clinic-agent\",\n    16\t            \"system:serviceaccount:clinic-agent:clinic-agent-reminders\",\n    17\t          ]\n    18\t          \"${module.eks.oidc_provider}:aud\" = \"sts.amazonaws.com\"\n    19\t        }\n    20\t      }\n    21\t    }]\n    22\t  })\n    23\t}\n    24\t\n    25\tresource \"aws_iam_role_policy\" \"runtime\" {\n    26\t  name = \"clinic-agent-runtime\"\n    27\t  role = aws_iam_role.runtime.id\n    28\t  policy = jsonencode({\n    29\t    Version = \"2012-10-17\"\n    30\t    Statement = [\n    31\t      {\n    32\t        Sid      = \"ReadClinicSecrets\"\n    33\t        Effect   = \"Allow\"\n    34\t        Action   = [\"secretsmanager:GetSecretValue\"]\n    35\t        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\n    36\t      },\n    37\t      {\n    38\t        Sid    = \"AgentState\"\n    39\t        Effect = \"Allow\"\n    40\t        Action = [\n    41\t          \"dynamodb:GetItem\",\n    42\t          \"dynamodb:BatchGetItem\",\n    43\t          \"dynamodb:PutItem\",\n    44\t          \"dynamodb:UpdateItem\",\n    45\t          \"dynamodb:Query\",\n    46\t        ]\n    47\t        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*\"\n    48\t      },\n    49\t      {\n    50\t        Sid      = \"Audit\"\n    51\t        Effect   = \"Allow\"\n    52\t        Action   = [\"firehose:PutRecord\", \"firehose:PutRecordBatch\"]\n    53\t        Resource = aws_kinesis_firehose_delivery_stream.audit.arn\n    54\t      },\n    55\t    ]\n    56\t  })\n    57\t}\n    58\t\n    59\t# Operators who may stop the agent. Assumable only through SSO by the on-call group.\n    60\tresource \"aws_iam_role\" \"ops_killswitch\" {\n    61\t  name = \"clinic-agent-ops\"\n    62\t  assume_role_policy = jsonencode({\n    63\t    Version = \"2012-10-17\"\n    64\t    Statement = [{\n    65\t      Effect    = \"Allow\"\n    66\t      Principal = { AWS = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\" }\n    67\t      Action    = \"sts:AssumeRole\"\n    68\t      Condition = {\n    69\t        StringLike = { \"aws:PrincipalArn\" = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*\" }\n    70\t      }\n    71\t    }]\n    72\t  })\n    73\t}\n    74\t\n    75\tresource \"aws_iam_role_policy\" \"ops_killswitch\" {\n    76\t  name = \"clinic-agent-ops\"\n    77\t  role = aws_iam_role.ops_killswitch.id\n    78\t  policy = jsonencode({\n    79\t    Version = \"2012-10-17\"\n    80\t    Statement = [{\n    81\t      Effect   = \"Allow\"\n    82\t      Action   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:GetItem\"]\n    83\t      Resource = aws_dynamodb_table.control.arn\n    84\t    }]\n    85\t  })\n    86\t}\n    87\t\n    88\tresource \"aws_iam_role\" \"firehose\" {\n    89\t  name = \"clinic-agent-audit-firehose\"\n    90\t  assume_role_policy = jsonencode({\n    91\t    Version   = \"2012-10-17\"\n    92\t    Statement = [{ Effect = \"Allow\", Principal = { Service = \"firehose.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n    93\t  })\n    94\t}\n    95\t\n    96\tresource \"aws_iam_role_policy\" \"firehose\" {\n    97\t  name = \"write-audit-bucket\"\n    98\t  role = aws_iam_role.firehose.id\n    99\t  policy = jsonencode({\n   100\t    Version = \"2012-10-17\"\n   101\t    Statement = [{\n   102\t      Effect   = \"Allow\"\n   103\t      Action   = [\"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:GetBucketLocation\"]\n   104\t      Resource = [aws_s3_bucket.audit.arn, \"${aws_s3_bucket.audit.arn}/*\"]\n   105\t    }]\n   106\t  })\n   107\t}\nk8s/deployment.yaml:2:kind: Namespace\nk8s/deployment.yaml:12:kind: ServiceAccount\nk8s/deployment.yaml:19:automountServiceAccountToken: false\nk8s/deployment.yaml:22:kind: ServiceAccount\nk8s/deployment.yaml:28:automountServiceAccountToken: false\nk8s/deployment.yaml:31:kind: ConfigMap\nk8s/deployment.yaml:47:kind: Deployment\nk8s/deployment.yaml:60:      serviceAccountName: clinic-agent\nk8s/deployment.yaml:61:      automountServiceAccountToken: false\nk8s/deployment.yaml:109:              - serviceAccountToken:\nk8s/deployment.yaml:115:kind: CronJob\nk8s/deployment.yaml:123:  jobTemplate:\nk8s/deployment.yaml:125:      backoffLimit: 0\nk8s/deployment.yaml:126:      activeDeadlineSeconds: 1800\nk8s/deployment.yaml:131:          serviceAccountName: clinic-agent-reminders\nk8s/deployment.yaml:132:          automountServiceAccountToken: false\nk8s/deployment.yaml:133:          restartPolicy: Never\nk8s/deployment.yaml:163:kind: NetworkPolicy\ninfra/terraform/main.tf:95:# State tables. Approvals are written by the staff console; budgets by the agent; the control\ninfra/terraform/main.tf:122:resource \"aws_dynamodb_table\" \"control\" {\ninfra/terraform/main.tf:123:  name         = \"clinic-agent-control\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"b74c3fae-7886-433c-bc86-7215f2b07e8b","uuid":"6e424260-a6d0-40df-a310-5b5b63433579","timestamp":"2026-10-20T15:28:52.811Z","tool_use_result":{"stdout":"     1\t# Hard limits enforced by src/agent/budget.ts, outside the model.\n     2\trun:\n     3\t  maxTurns: 8                 # model calls per run\n     4\t  maxWallMs: 45000            # whole run, including tool calls\n     5\t  maxInputTokens: 120000      # summed across model calls in the run\n     6\t  maxOutputTokens: 6000\n     7\t  maxCostUsd: 0.40\n     8\t  maxToolCalls: 16\n     9\t  maxToolCallsPerMinute: 12\n    10\t  maxPeerCalls: 2             # calls to the eligibility agent; this agent starts no sub-agents\n    11\t\n    12\tquotas:\n    13\t  # Daily spend and per-minute tool-call ceilings across many runs.\n    14\t  perSubjectDailyUsd: 2.00    # one patient or staff user\n    15\t  perTenantDailyUsd: 60.00    # one clinic\n    16\t  fleetDailyUsd: 900.00       # all clinics\n    17\t  perTenantToolCallsPerMinute: 240\n    18\t  fleetToolCallsPerMinute: 2400\n    19\t\n    20\tpricingUsdPerMTok:\n    21\t  claude-sonnet-4-5-20250929: { input: 3.00, output: 15.00, cacheRead: 0.30, cacheWrite: 3.75 }\n    22\t  claude-haiku-4-5-20251001: { input: 1.00, output: 5.00, cacheRead: 0.10, cacheWrite: 1.25 }\n    23\t\n    24\t# When a limit is hit the run stops, the stop is audited with the limit name, and the\n    25\t# conversation is handed to the clinic's front-desk queue.\n    26\tonExceed: handoff_to_staff\n     1\t# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\n     2\tpolicyVersion: \"2026-09-18.3\"\n     3\t\n     4\t# Tools that never run without a staff approval bound to the request.\n     5\thighImpactTools:\n     6\t  - ehr__cancel_appointment\n     7\t  - payments__refund_deposit\n     8\t  - sms__send_freeform\n     9\t\n    10\tapproval:\n    11\t  ttlSeconds: 900\n    12\t  approverRoles:\n    13\t    - front_desk_lead\n    14\t    - clinic_manager\n    15\t  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n    16\t  table: clinic-agent-approvals\n     1\t# Every tool the scheduling agent may call, with the task it serves.\n     2\t# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n     3\t# are not used for allow or approval decisions.\n     4\trole: scheduling_agent\n     5\ttools:\n     6\t  - tool: ehr__find_patient\n     7\t    reason: Match the sender to a patient record by date of birth and phone or email.\n     8\t  - tool: ehr__search_slots\n     9\t    reason: List open slots for a provider, location, and visit type.\n    10\t  - tool: ehr__get_appointment\n    11\t    reason: Read one appointment the patient asks about.\n    12\t  - tool: ehr__list_patient_appointments\n    13\t    reason: Show the patient their upcoming appointments.\n    14\t  - tool: ehr__book_appointment\n    15\t    reason: Book a slot the patient chose.\n    16\t  - tool: ehr__update_appointment\n    17\t    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n    18\t  - tool: ehr__cancel_appointment\n    19\t    reason: Cancel an appointment at the patient's request.\n    20\t  - tool: payments__refund_deposit\n    21\t    reason: Refund a no-show deposit after staff review.\n    22\t  - tool: sms__send_to_patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.\n     1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n     7\t//\n     8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n     9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n    10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n    11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n    12\t//\n    13\t// Answers come back as a signed attestation (JWS) inside a data part.\n    14\t\n    15\tconst Eligibility = z\n    16\t  .object({\n    17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    18\t    planName: z.string().max(120).optional(),\n    19\t    copayCents: z.number().int().nonnegative().optional(),\n    20\t    depositWaived: z.boolean().default(false),\n    21\t    checkedAt: z.string().datetime(),\n    22\t  })\n    23\t  .strict();\n    24\texport type Eligibility = z.infer<typeof Eligibility>;\n    25\t\n    26\tconst Rpc = z.object({\n    27\t  jsonrpc: z.literal(\"2.0\"),\n    28\t  id: z.string(),\n    29\t  result: z.object({\n    30\t    kind: z.literal(\"message\"),\n    31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n    32\t  }),\n    33\t});\n    34\t\n    35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n    36\t  const res = await fetch(env.tokenExchangeUrl, {\n    37\t    method: \"POST\",\n    38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    39\t    body: new URLSearchParams({\n    40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    41\t      subject_token: workloadToken,\n    42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n    43\t      audience: \"eligibility-agent\",\n    44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n    45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    46\t    }),\n    47\t  });\n    48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n    49\t  return ((await res.json()) as { access_token: string }).access_token;\n    50\t}\n    51\t\n    52\texport async function checkEligibility(\n    53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n    54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n    55\t): Promise<Eligibility> {\n    56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n    57\t  const requestId = randomUUID();\n    58\t  const res = await fetch(env.eligibilityUrl, {\n    59\t    method: \"POST\",\n    60\t    signal: opts.signal,\n    61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    62\t    body: JSON.stringify({\n    63\t      jsonrpc: \"2.0\",\n    64\t      id: requestId,\n    65\t      method: \"message/send\",\n    66\t      params: {\n    67\t        message: {\n    68\t          role: \"user\",\n    69\t          messageId: requestId,\n    70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n    71\t        },\n    72\t      },\n    73\t    }),\n    74\t  });\n    75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n    76\t  const text = await res.text();\n    77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n    78\t  const rpc = Rpc.parse(JSON.parse(text));\n    79\t\n    80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n    81\t  const header = decodeProtectedHeader(attestation);\n    82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n    83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n    84\t  const { payload } = await jwtVerify(attestation, keys, {\n    85\t    issuer: env.eligibilityIssuer,\n    86\t    audience: \"clinic-agent\",\n    87\t    maxTokenAge: \"5m\",\n    88\t    algorithms: [\"ES256\"],\n    89\t  });\n    90\t  return Eligibility.parse(payload.eligibility);\n    91\t}\n     1\timport { audit } from \"../audit/recorder.js\";\n     2\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     3\timport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\n     4\timport { payments } from \"../integrations/payments.js\";\n     5\timport type { RunContext } from \"../agent/identity.js\";\n     6\timport type { ContextSize } from \"../agent/context-size.js\";\n     7\t\n     8\t// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n     9\t// agent, and settles the visit deposit when the plan covers the visit.\n    10\t\n    11\texport async function checkEligibilityForAppointment(\n    12\t  ehr: Ehr,\n    13\t  input: { appointmentId: string },\n    14\t  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n    15\t): Promise<Eligibility & { depositRefundId?: string }> {\n    16\t  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n    17\t\n    18\t  const result = await checkEligibility(\n    19\t    {\n    20\t      clinicId: opts.clinicId,\n    21\t      patientId: appt.patientId,\n    22\t      payerId: appt.payerId,\n    23\t      serviceCode: appt.serviceCode,\n    24\t      dateOfService: appt.start.slice(0, 10),\n    25\t    },\n    26\t    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n    27\t  );\n    28\t  await audit.record({\n    29\t    ...opts.ctx.identity(),\n    30\t    runId: opts.ctx.runId,\n    31\t    subject: opts.ctx.subject,\n    32\t    event: \"peer.call\",\n    33\t    tool: \"insurance__check_eligibility\",\n    34\t    context: opts.context,\n    35\t    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n    36\t  });\n    37\t\n    38\t  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n    39\t  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n    40\t    const refund = await payments.refundDeposit(\n    41\t      opts.clinicId,\n    42\t      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n    43\t      opts.signal,\n    44\t    );\n    45\t    await audit.record({\n    46\t      ...opts.ctx.identity(),\n    47\t      runId: opts.ctx.runId,\n    48\t      subject: opts.ctx.subject,\n    49\t      event: \"payment.refund\",\n    50\t      tool: \"insurance__check_eligibility\",\n    51\t      context: opts.context,\n    52\t      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n    53\t    });\n    54\t    return { ...result, depositRefundId: refund.id };\n    55\t  }\n    56\t  return result;\n    57\t}\n     1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n     2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n     3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     4\timport { Agent } from \"undici\";\n     5\timport type { PeerCertificate } from \"node:tls\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n     8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n     9\t\n    10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n    11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n    12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n    13\t\n    14\tconst sm = new SecretsManagerClient({ region: env.region });\n    15\t\n    16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n    17\t  const expected = server.tlsCertSha256.toLowerCase();\n    18\t  return new Agent({\n    19\t    connect: {\n    20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n    21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n    22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n    23\t      },\n    24\t    },\n    25\t  });\n    26\t}\n    27\t\n    28\ttype Token = { value: string; exp: number };\n    29\tconst tokens = new Map<string, Token>();\n    30\t\n    31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n    32\t  const cacheKey = `${clinicId}|${scope}`;\n    33\t  const hit = tokens.get(cacheKey);\n    34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n    35\t\n    36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n    37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n    38\t  const res = await fetch(token_url, {\n    39\t    method: \"POST\",\n    40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n    42\t  });\n    43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n    44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n    45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n    46\t  return body.access_token;\n    47\t}\n    48\t\n    49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n    50\tconst sessions = new Map<string, Client>();\n    51\t\n    52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n    53\t  const existing = sessions.get(clinicId);\n    54\t  if (existing) return existing;\n    55\t  const token = await ehrToken(clinicId, SCOPES);\n    56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    57\t    requestInit: {\n    58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n    59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n    60\t      dispatcher: pinnedDispatcher(server),\n    61\t    },\n    62\t  });\n    63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n    64\t  await client.connect(transport);\n    65\t  sessions.set(clinicId, client);\n    66\t  setTimeout(() => {\n    67\t    sessions.delete(clinicId);\n    68\t    void client.close();\n    69\t  }, 4 * 60_000).unref();\n    70\t  return client;\n    71\t}\n    72\t\n    73\texport function ehr(server: ConfiguredServer) {\n    74\t  return {\n    75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n    76\t      const c = await session(server, \"_catalog\");\n    77\t      const [tools, prompts, templates] = await Promise.all([\n    78\t        c.listTools(),\n    79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n    80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n    81\t      ]);\n    82\t      return {\n    83\t        reportedName: c.getServerVersion()?.name,\n    84\t        meta: {\n    85\t          instructions: c.getInstructions(),\n    86\t          tools: tools.tools as ServerMeta[\"tools\"],\n    87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n    88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n    89\t        },\n    90\t      };\n    91\t    },\n    92\t\n    93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n    94\t      const c = await session(server, opts.clinicId);\n    95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n    96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n    97\t      return res.structuredContent ?? res.content;\n    98\t    },\n    99\t\n   100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n   101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n   102\t        id: string;\n   103\t        patientId: string;\n   104\t        start: string;\n   105\t        serviceCode: string;\n   106\t        payerId?: string;\n   107\t        depositId?: string;\n   108\t        status: string;\n   109\t      };\n   110\t    },\n   111\t\n   112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n   113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n   114\t        id: string;\n   115\t        patientId: string;\n   116\t        start: string;\n   117\t        phone: string;\n   118\t        smsOptIn: boolean;\n   119\t        locationName: string;\n   120\t      }>;\n   121\t    },\n   122\t  };\n   123\t}\n   124\texport type Ehr = ReturnType<typeof ehr>;\n     1\t# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:\n     2\t# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.\n     3\tresource \"aws_iam_role\" \"runtime\" {\n     4\t  name                 = \"clinic-agent-runtime\"\n     5\t  max_session_duration = 3600\n     6\t  assume_role_policy = jsonencode({\n     7\t    Version = \"2012-10-17\"\n     8\t    Statement = [{\n     9\t      Effect    = \"Allow\"\n    10\t      Principal = { Federated = module.eks.oidc_provider_arn }\n    11\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n    12\t      Condition = {\n    13\t        StringEquals = {\n    14\t          \"${module.eks.oidc_provider}:sub\" = [\n    15\t            \"system:serviceaccount:clinic-agent:clinic-agent\",\n    16\t            \"system:serviceaccount:clinic-agent:clinic-agent-reminders\",\n    17\t          ]\n    18\t          \"${module.eks.oidc_provider}:aud\" = \"sts.amazonaws.com\"\n    19\t        }\n    20\t      }\n    21\t    }]\n    22\t  })\n    23\t}\n    24\t\n    25\tresource \"aws_iam_role_policy\" \"runtime\" {\n    26\t  name = \"clinic-agent-runtime\"\n    27\t  role = aws_iam_role.runtime.id\n    28\t  policy = jsonencode({\n    29\t    Version = \"2012-10-17\"\n    30\t    Statement = [\n    31\t      {\n    32\t        Sid      = \"ReadClinicSecrets\"\n    33\t        Effect   = \"Allow\"\n    34\t        Action   = [\"secretsmanager:GetSecretValue\"]\n    35\t        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\n    36\t      },\n    37\t      {\n    38\t        Sid    = \"AgentState\"\n    39\t        Effect = \"Allow\"\n    40\t        Action = [\n    41\t          \"dynamodb:GetItem\",\n    42\t          \"dynamodb:BatchGetItem\",\n    43\t          \"dynamodb:PutItem\",\n    44\t          \"dynamodb:UpdateItem\",\n    45\t          \"dynamodb:Query\",\n    46\t        ]\n    47\t        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*\"\n    48\t      },\n    49\t      {\n    50\t        Sid      = \"Audit\"\n    51\t        Effect   = \"Allow\"\n    52\t        Action   = [\"firehose:PutRecord\", \"firehose:PutRecordBatch\"]\n    53\t        Resource = aws_kinesis_firehose_delivery_stream.audit.arn\n    54\t      },\n    55\t    ]\n    56\t  })\n    57\t}\n    58\t\n    59\t# Operators who may stop the agent. Assumable only through SSO by the on-call group.\n    60\tresource \"aws_iam_role\" \"ops_killswitch\" {\n    61\t  name = \"clinic-agent-ops\"\n    62\t  assume_role_policy = jsonencode({\n    63\t    Version = \"2012-10-17\"\n    64\t    Statement = [{\n    65\t      Effect    = \"Allow\"\n    66\t      Principal = { AWS = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\" }\n    67\t      Action    = \"sts:AssumeRole\"\n    68\t      Condition = {\n    69\t        StringLike = { \"aws:PrincipalArn\" = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*\" }\n    70\t      }\n    71\t    }]\n    72\t  })\n    73\t}\n    74\t\n    75\tresource \"aws_iam_role_policy\" \"ops_killswitch\" {\n    76\t  name = \"clinic-agent-ops\"\n    77\t  role = aws_iam_role.ops_killswitch.id\n    78\t  policy = jsonencode({\n    79\t    Version = \"2012-10-17\"\n    80\t    Statement = [{\n    81\t      Effect   = \"Allow\"\n    82\t      Action   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:GetItem\"]\n    83\t      Resource = aws_dynamodb_table.control.arn\n    84\t    }]\n    85\t  })\n    86\t}\n    87\t\n    88\tresource \"aws_iam_role\" \"firehose\" {\n    89\t  name = \"clinic-agent-audit-firehose\"\n    90\t  assume_role_policy = jsonencode({\n    91\t    Version   = \"2012-10-17\"\n    92\t    Statement = [{ Effect = \"Allow\", Principal = { Service = \"firehose.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n    93\t  })\n    94\t}\n    95\t\n    96\tresource \"aws_iam_role_policy\" \"firehose\" {\n    97\t  name = \"write-audit-bucket\"\n    98\t  role = aws_iam_role.firehose.id\n    99\t  policy = jsonencode({\n   100\t    Version = \"2012-10-17\"\n   101\t    Statement = [{\n   102\t      Effect   = \"Allow\"\n   103\t      Action   = [\"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:GetBucketLocation\"]\n   104\t      Resource = [aws_s3_bucket.audit.arn, \"${aws_s3_bucket.audit.arn}/*\"]\n   105\t    }]\n   106\t  })\n   107\t}\nk8s/deployment.yaml:2:kind: Namespace\nk8s/deployment.yaml:12:kind: ServiceAccount\nk8s/deployment.yaml:19:automountServiceAccountToken: false\nk8s/deployment.yaml:22:kind: ServiceAccount\nk8s/deployment.yaml:28:automountServiceAccountToken: false\nk8s/deployment.yaml:31:kind: ConfigMap\nk8s/deployment.yaml:47:kind: Deployment\nk8s/deployment.yaml:60:      serviceAccountName: clinic-agent\nk8s/deployment.yaml:61:      automountServiceAccountToken: false\nk8s/deployment.yaml:109:              - serviceAccountToken:\nk8s/deployment.yaml:115:kind: CronJob\nk8s/deployment.yaml:123:  jobTemplate:\nk8s/deployment.yaml:125:      backoffLimit: 0\nk8s/deployment.yaml:126:      activeDeadlineSeconds: 1800\nk8s/deployment.yaml:131:          serviceAccountName: clinic-agent-reminders\nk8s/deployment.yaml:132:          automountServiceAccountToken: false\nk8s/deployment.yaml:133:          restartPolicy: Never\nk8s/deployment.yaml:163:kind: NetworkPolicy\ninfra/terraform/main.tf:95:# State tables. Approvals are written by the staff console; budgets by the agent; the control\ninfra/terraform/main.tf:122:resource \"aws_dynamodb_table\" \"control\" {\ninfra/terraform/main.tf:123:  name         = \"clinic-agent-control\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HDBWRJ2dzYNzPuEeUs3yoj","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
