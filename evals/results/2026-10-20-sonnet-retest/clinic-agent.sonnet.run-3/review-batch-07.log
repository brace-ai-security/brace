cord({ ...ident(), event: \\\"run.completed\\\" });\"\n    },\n    {\n      \"id\": \"Id7d90196c6\",\n      \"kind\": \"handoff\",\n      \"evidence\": \"src/agent/loop.ts:85\",\n      \"quote\": \"return { text, handoff: null };\"\n    },\n    {\n      \"id\": \"I8e59418069\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/control/kill-switch.ts:36\",\n      \"quote\": \"if (item.halted === true) next.add(String(item.pk));\"\n    },\n    {\n      \"id\": \"I302e6a1980\",\n      \"kind\": \"handoff\",\n      \"evidence\": \"src/routes/webchat.ts:57\",\n      \"quote\": \"return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });\"\n    },\n    {\n      \"id\": \"I1861b59462\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/server.ts:49\",\n      \"quote\": \"registry.registerMcp(\\\"ehr\\\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\"\n    },\n    {\n      \"id\": \"I8fa6be25eb\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/tools/executor.ts:51\",\n      \"quote\": \"await audit.record({ ...base, event: \\\"tool.denied\\\", reason });\"\n    },\n    {\n      \"id\": \"Ia3450fc0b4\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/tools/executor.ts:77\",\n      \"quote\": \"await audit.record({ ...base, event: \\\"tool.approval_requested\\\", approvalId: rec.id });\"\n    },\n    {\n      \"id\": \"I5b433eb517\",\n      \"kind\": \"tool_call\",\n      \"evidence\": \"src/tools/executor.ts:86\",\n      \"quote\": \"const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\"\n    },\n    {\n      \"id\": \"Ifd82e31a71\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/tools/executor.ts:89\",\n      \"quote\": \"await audit.record({ ...base, event: \\\"tool.executed\\\", approvalId, detail: { clinicId } });\"\n    },\n    {\n      \"id\": \"I077346bcfe\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/tools/executor.ts:93\",\n      \"quote\": \"await audit.record({ ...base, event: \\\"tool.failed\\\", approvalId, reason: (err as Error).message.slice(0, 300) });\"\n    },\n    {\n      \"id\": \"I140bd2f97f\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/tools/registry.ts:101\",\n      \"quote\": \"registerMcp(\"\n    },\n    {\n      \"id\": \"I131c91d8de\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/tools/registry.ts:127\",\n      \"quote\": \"this.add({\"\n    },\n    {\n      \"id\": \"I18aec0bd94\",\n      \"kind\": \"tool_registration\",\n      \"evidence\": \"src/tools/registry.ts:94\",\n      \"quote\": \"for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\"\n    },\n    {\n      \"id\": \"I3a7e594185\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/workers/reminders.ts:36\",\n      \"quote\": \"await audit.record({\"\n    },\n    {\n      \"id\": \"I23cff29552\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/workers/reminders.ts:53\",\n      \"quote\": \"await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \\\"run.stopped\\\", reason: (err as Error).message.slice(0, 200) });\"\n    },\n    {\n      \"id\": \"Icc9cd2c6d6\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/workflows/eligibility-check.ts:28\",\n      \"quote\": \"await audit.record({\"\n    },\n    {\n      \"id\": \"I22394b36a5\",\n      \"kind\": \"audit_write\",\n      \"evidence\": \"src/workflows/eligibility-check.ts:45\",\n      \"quote\": \"await audit.record({\"\n    }\n  ],\n  \"skipped\": [],\n  \"limitations\": \"Candidate inventory only: manually trace aliases, wrappers, computed calls and unsupported languages. Tests excluded; no code executed.\"\n}\n{\n  \"brace_checklist\": \"2026-10-01\",\n  \"repo\": \"\",\n  \"commit\": null,\n  \"reviewed_at\": \"2026-10-20T15:36:27Z\",\n  \"scope\": \"TODO: what was reviewed and what wasn't.\",\n  \"review_protocol\": \"coverage-first-v1\",\n  \"findings\": [\n    {\n      \"item\": \"A05\",\n      \"gate\": \"G1\",\n      \"title\": \"Operational lookup\",\n      \"requirement\": \"Start from one suspicious action. Find the team responsible, the current operator, the deployment manifest, and the live instance. Show that you can contain the right instance or agent type without cutting off the launching user's other access.\",\n      \"not_covered\": [\n        {\n          \"problem\": \"Stop doesn't halt running work or open tool streams within a set time\",\n          \"owner\": \"R11\"\n        },\n        {\n          \"problem\": \"No drill for a compromised shared tool or agent type\",\n          \"owner\": \"E12\"\n        },\n        {\n          \"problem\": \"Action records missing any of the six identity fields\",\n          \"owner\": \"A02\"\n        }\n      ],\n      \"rating\": \"needs_evidence\",\n      \"confidence\": \"low\",\n      \"evidence\": [],\n      \"checks\": [\n        {\n          \"id\": \"A05.1\",\n          \"check\": \"Each audit record carries the agent-type-id and agent-instance-id, which resolve to a stored deployment manifest and a live instance.\",\n          \"verify\": \"1) Open the audit record writer. 2) Check `agent.type.id` and `agent.instance.id` are written on every record. 3) Check the type ID can be looked up to a stored manifest (registry, manifest sto","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014vvns8Upj7XUZEa1aA7Fgo","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDjg2CoRFGss3JNsaga4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UmgyU8WqEsW5bonFFC71h7","name":"Bash","input":{"command":"cat -n src/audit/recorder.ts src/agent/identity.ts src/agent/classifier.ts src/agent/loop.ts src/control/kill-switch.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1068,"cache_read_input_tokens":21449,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1068},"output_tokens":20,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"45ab43c4-ecdd-452d-b4e1-a84e9bc45d3f","uuid":"706c89c6-d193-4007-9393-1268b97e24a9","timestamp":"2026-10-20T15:36:39.534Z","request_id":"req_011CgDjg1thEtZr2NvQ8URJH","wire_tool_inputs":{"toolu_01UmgyU8WqEsW5bonFFC71h7":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-58vpsv_z/agent && cat -n src/audit/recorder.ts src/agent/identity.ts src/agent/classifier.ts src/agent/loop.ts src/control/kill-switch.ts"}},"wire_ingest_context":{"toolu_01UmgyU8WqEsW5bonFFC71h7":{"cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-58vpsv_z/agent"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UmgyU8WqEsW5bonFFC71h7","type":"tool_result","content":"     1\timport { FirehoseClient, PutRecordCommand } from \"@aws-sdk/client-firehose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Every audit record carries the six identity fields. Values come from RunContext, which is built\n     7\t// by the HTTP layer and the worker, never from model output.\n     8\texport const IdentityFields = z.object({\n     9\t  accountableParty: z.string().min(1),\n    10\t  operationalOwner: z.string().min(1),\n    11\t  tenantId: z.string().min(1),\n    12\t  agentTypeId: z.string().startsWith(\"sha256:\"),\n    13\t  agentInstanceId: z.string().uuid(),\n    14\t  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),\n    15\t});\n    16\t\n    17\texport const AuditEvent = IdentityFields.extend({\n    18\t  eventId: z.string().uuid(),\n    19\t  ts: z.string().datetime(),\n    20\t  runId: z.string().uuid(),\n    21\t  event: z.enum([\n    22\t    \"run.started\",\n    23\t    \"run.stopped\",\n    24\t    \"run.completed\",\n    25\t    \"intent.classified\",\n    26\t    \"model.decision\",\n    27\t    \"tool.denied\",\n    28\t    \"tool.approval_requested\",\n    29\t    \"tool.executed\",\n    30\t    \"tool.failed\",\n    31\t    \"payment.refund\",\n    32\t    \"peer.call\",\n    33\t    \"reminder.sent\",\n    34\t  ]),\n    35\t  subject: z.object({ kind: z.enum([\"patient\", \"staff\", \"system\"]), id: z.string() }),\n    36\t  tool: z.string().optional(),\n    37\t  toolUseId: z.string().optional(),\n    38\t  policyVersion: z.string().optional(),\n    39\t  approvalId: z.string().optional(),\n    40\t  reason: z.string().optional(),\n    41\t  context: z\n    42\t    .object({\n    43\t      tokens: z.number().int().nonnegative().nullable(),\n    44\t      status: z.enum([\"measured\", \"estimated\", \"unavailable\"]),\n    45\t      method: z.string(),\n    46\t      cachedInputTokens: z.number().int().nonnegative().nullable(),\n    47\t      compacted: z.boolean(),\n    48\t    })\n    49\t    .optional(),\n    50\t  detail: z.record(z.unknown()).optional(),\n    51\t});\n    52\texport type AuditEvent = z.infer<typeof AuditEvent>;\n    53\t\n    54\tconst firehose = new FirehoseClient({ region: env.region });\n    55\t\n    56\texport class AuditUnavailable extends Error {}\n    57\t\n    58\texport const audit = {\n    59\t  async record(e: Omit<AuditEvent, \"eventId\" | \"ts\">): Promise<void> {\n    60\t    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });\n    61\t    try {\n    62\t      await firehose.send(\n    63\t        new PutRecordCommand({\n    64\t          DeliveryStreamName: env.auditStream,\n    65\t          Record: { Data: Buffer.from(JSON.stringify(full) + \"\\n\") },\n    66\t        }),\n    67\t      );\n    68\t    } catch (err) {\n    69\t      // Callers treat this as a hard failure: an action that cannot be audited does not run.\n    70\t      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);\n    71\t    }\n    72\t  },\n    73\t};\n    74\t\n    75\t// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.\n    76\tconst DROP_KEYS = new Set([\"ssn\", \"dateOfBirth\", \"dob\", \"memberId\", \"subscriberId\", \"cardNumber\", \"cardLast4\", \"address\"]);\n    77\tconst PATTERNS: Array<[RegExp, string]> = [\n    78\t  [/\\b\\d{3}-\\d{2}-\\d{4}\\b/g, \"[ssn]\"],\n    79\t  [/\\b(?:\\d[ -]?){13,19}\\b/g, \"[card]\"],\n    80\t  [/\\b[A-Z]{3}\\d{9}\\b/g, \"[member-id]\"],\n    81\t];\n    82\t\n    83\texport function redactPhi(value: unknown): unknown {\n    84\t  if (typeof value === \"string\") {\n    85\t    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);\n    86\t  }\n    87\t  if (Array.isArray(value)) return value.map(redactPhi);\n    88\t  if (value && typeof value === \"object\") {\n    89\t    const out: Record<string, unknown> = {};\n    90\t    for (const [k, v] of Object.entries(value)) {\n    91\t      if (DROP_KEYS.has(k)) continue;\n    92\t      out[k] = redactPhi(v);\n    93\t    }\n    94\t    return out;\n    95\t  }\n    96\t  return value;\n    97\t}\n     1\timport { createHash, randomUUID } from \"node:crypto\";\n     2\timport { readdirSync, readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n     5\t\n     6\t// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n     7\t// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\n     8\tconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n     9\t\n    10\texport interface TypeIdInputs {\n    11\t  imageDigest: string;\n    12\t  harnessVersion: string;\n    13\t  harnessGitSha: string;\n    14\t}\n    15\t\n    16\texport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n    17\t  const parts: Array<[string, Buffer]> = [\n    18\t    [\"image\", Buffer.from(inputs.imageDigest)],\n    19\t    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    20\t    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n    21\t  ];\n    22\t  const promptDir = join(ROOT, \"prompts\");\n    23\t  const promptFiles = readdirSync(promptDir)\n    24\t    .filter((f) => f.endsWith(\".txt\"))\n    25\t    .sort();\n    26\t  for (const f of promptFiles) {\n    27\t    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n    28\t  }\n    29\t  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n    30\t  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n    31\t  for (const f of CONFIG_FILES) {\n    32\t    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n    33\t  }\n    34\t  return parts;\n    35\t}\n    36\t\n    37\texport function computeAgentTypeId(inputs: TypeIdInputs): string {\n    38\t  const h = createHash(\"sha256\");\n    39\t  for (const [label, bytes] of typeIdManifest(inputs)) {\n    40\t    h.update(label);\n    41\t    h.update(\"\\0\");\n    42\t    h.update(bytes);\n    43\t    h.update(\"\\0\");\n    44\t  }\n    45\t  return `sha256:${h.digest(\"hex\")}`;\n    46\t}\n    47\t\n    48\t// One instance id per process. Pods are the unit an operator contains.\n    49\texport const AGENT_INSTANCE_ID = randomUUID();\n    50\t\n    51\tlet AGENT_TYPE_ID = \"\";\n    52\texport function setAgentTypeId(id: string): void {\n    53\t  AGENT_TYPE_ID = id;\n    54\t}\n    55\t\n    56\texport interface Subject {\n    57\t  kind: \"patient\" | \"staff\" | \"system\";\n    58\t  id: string;\n    59\t}\n    60\t\n    61\texport interface Logger {\n    62\t  info(obj: object, msg?: string): void;\n    63\t  warn(obj: object, msg?: string): void;\n    64\t  error(obj: object, msg?: string): void;\n    65\t}\n    66\t\n    67\texport interface RunContext {\n    68\t  runId: string;\n    69\t  tenantId: string;\n    70\t  subject: Subject;\n    71\t  channel: \"sms\" | \"webchat\" | \"reminder\";\n    72\t  traceparent: string;\n    73\t  log: Logger;\n    74\t  identity(): {\n    75\t    accountableParty: string;\n    76\t    operationalOwner: string;\n    77\t    tenantId: string;\n    78\t    agentTypeId: string;\n    79\t    agentInstanceId: string;\n    80\t    traceparent: string;\n    81\t  };\n    82\t  workloadToken(): Promise<string>;\n    83\t}\n    84\t\n    85\t// Projected service-account token (audience: the group STS), rotated by the kubelet.\n    86\tconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n    87\t\n    88\texport function newRunContext(init: {\n    89\t  tenantId: string;\n    90\t  subject: Subject;\n    91\t  channel: RunContext[\"channel\"];\n    92\t  traceparent?: string;\n    93\t  log: Logger;\n    94\t}): RunContext {\n    95\t  const runId = randomUUID();\n    96\t  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n    97\t  return {\n    98\t    runId,\n    99\t    tenantId: init.tenantId,\n   100\t    subject: init.subject,\n   101\t    channel: init.channel,\n   102\t    traceparent,\n   103\t    log: init.log,\n   104\t    identity: () => ({\n   105\t      accountableParty: env.accountableParty,\n   106\t      operationalOwner: env.operationalOwner,\n   107\t      tenantId: init.tenantId,\n   108\t      agentTypeId: AGENT_TYPE_ID,\n   109\t      agentInstanceId: AGENT_INSTANCE_ID,\n   110\t      traceparent,\n   111\t    }),\n   112\t    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n   113\t  };\n   114\t}\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { createHash } from \"node:crypto\";\n     3\timport { readFileSync } from \"node:fs\";\n     4\timport { join } from \"node:path\";\n     5\timport { z } from \"zod\";\n     6\timport { CLASSIFIER_MODEL, ROOT } from \"../config.js\";\n     7\t\n     8\t// Helper model that routes messages before the agent sees them. Urgent and complaint messages go\n     9\t// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\n    10\t// malformed output, unknown label, or a served model other than the pinned snapshot) routes the\n    11\t// message to staff. A failed classifier never defaults to \"send it to the agent\".\n    12\t\n    13\texport const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");\n    14\texport const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\n    15\t\n    16\texport const CLASSIFIER_ID = `sha256:${createHash(\"sha256\")\n    17\t  .update(CLASSIFIER_MODEL)\n    18\t  .update(\"\\0\")\n    19\t  .update(CLASSIFIER_PROMPT)\n    20\t  .update(\"\\0\")\n    21\t  .update(JSON.stringify(CLASSIFIER_CONFIG))\n    22\t  .digest(\"hex\")}`;\n    23\t\n    24\tconst Intent = z.enum([\"book\", \"reschedule\", \"cancel\", \"confirm\", \"coverage\", \"info\", \"urgent\", \"complaint\", \"other\"]);\n    25\tconst Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();\n    26\t\n    27\texport type Route = \"agent\" | \"staff\";\n    28\t\n    29\texport interface ClassifierDecision {\n    30\t  classifierId: string;\n    31\t  requestedModel: string;\n    32\t  servedModel: string | null;\n    33\t  intent: z.infer<typeof Intent> | null;\n    34\t  confidence: number | null;\n    35\t  route: Route;\n    36\t  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n    37\t}\n    38\t\n    39\tconst MIN_CONFIDENCE = 0.6;\n    40\t\n    41\texport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n    42\t  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n    43\t  let res: Anthropic.Message;\n    44\t  try {\n    45\t    res = await client.messages.create(\n    46\t      {\n    47\t        model: CLASSIFIER_MODEL,\n    48\t        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n    49\t        temperature: CLASSIFIER_CONFIG.temperature,\n    50\t        system: CLASSIFIER_PROMPT,\n    51\t        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n    52\t      },\n    53\t      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n    54\t    );\n    55\t  } catch (err) {\n    56\t    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n    57\t    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n    58\t  }\n    59\t\n    60\t  if (res.model !== CLASSIFIER_MODEL) {\n    61\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n    62\t  }\n    63\t\n    64\t  const textOut = res.content.find((b) => b.type === \"text\");\n    65\t  let parsed: z.infer<typeof Output>;\n    66\t  try {\n    67\t    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n    68\t  } catch {\n    69\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n    70\t  }\n    71\t\n    72\t  if (parsed.confidence < MIN_CONFIDENCE) {\n    73\t    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n    74\t  }\n    75\t  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n    76\t  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n    77\t}\n     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\n     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, BatchGetCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport { env } from \"../config.js\";\n     4\t\n     5\t// Stop control. Operators write halted=true on \"global\" or \"tenant#<clinicId>\" in the control table.\n     6\t// The agent only reads this table; every model turn and every tool call checks it, and a watcher\n     7\t// aborts in-flight work for halted scopes.\n     8\texport class Halted extends Error {\n     9\t  constructor(public scope: string) {\n    10\t    super(`agent halted (${scope})`);\n    11\t  }\n    12\t}\n    13\t\n    14\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    15\tconst POLL_MS = 2000;\n    16\t\n    17\ttype Active = { tenantId: string; abort: AbortController };\n    18\tconst active = new Map<string, Active>();\n    19\t\n    20\tlet lastRead = 0;\n    21\tlet halted = new Set<string>();\n    22\t\n    23\tasync function refresh(): Promise<void> {\n    24\t  const res = await ddb.send(\n    25\t    new BatchGetCommand({\n    26\t      RequestItems: {\n    27\t        [env.controlTable]: {\n    28\t          Keys: [{ pk: \"global\" }, ...[...new Set([...active.values()].map((a) => a.tenantId))].map((t) => ({ pk: `tenant#${t}` }))],\n    29\t          ConsistentRead: true,\n    30\t        },\n    31\t      },\n    32\t    }),\n    33\t  );\n    34\t  const next = new Set<string>();\n    35\t  for (const item of res.Responses?.[env.controlTable] ?? []) {\n    36\t    if (item.halted === true) next.add(String(item.pk));\n    37\t  }\n    38\t  halted = next;\n    39\t  lastRead = Date.now();\n    40\t}\n    41\t\n    42\texport const killSwitch = {\n    43\t  register(runId: string, tenantId: string, abort: AbortController): () => void {\n    44\t    active.set(runId, { tenantId, abort });\n    45\t    return () => active.delete(runId);\n    46\t  },\n    47\t\n    48\t  async assertRunning(tenantId: string): Promise<void> {\n    49\t    if (Date.now() - lastRead > POLL_MS) {\n    50\t      try {\n    51\t        await refresh();\n    52\t      } catch {\n    53\t        // If the control table cannot be read, treat the agent as halted.\n    54\t        throw new Halted(\"control-unreadable\");\n    55\t      }\n    56\t    }\n    57\t    if (halted.has(\"global\")) throw new Halted(\"global\");\n    58\t    if (halted.has(`tenant#${tenantId}`)) throw new Halted(`tenant#${tenantId}`);\n    59\t  },\n    60\t\n    61\t  startWatcher(): NodeJS.Timeout {\n    62\t    return setInterval(async () => {\n    63\t      try {\n    64\t        await refresh();\n    65\t      } catch {\n    66\t        halted = new Set([\"global\"]);\n    67\t      }\n    68\t      for (const [runId, a] of active) {\n    69\t        if (halted.has(\"global\") || halted.has(`tenant#${a.tenantId}`)) {\n    70\t          a.abort.abort(new Halted(halted.has(\"global\") ? \"global\" : `tenant#${a.tenantId}`));\n    71\t          active.delete(runId);\n    72\t        }\n    73\t      }\n    74\t    }, POLL_MS);\n    75\t  },\n    76\t};","is_error":false}]},"parent_tool_use_id":null,"session_id":"45ab43c4-ecdd-452d-b4e1-a84e9bc45d3f","uuid":"8467113b-5b93-4899-9a75-3168beb46909","timestamp":"2026-10-20T15:36:39.554Z","tool_use_result":{"stdout":"     1\timport { FirehoseClient, PutRecordCommand } from \"@aws-sdk/client-firehose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Every audit record carries the six identity fields. Values come from RunContext, which is built\n     7\t// by the HTTP layer and the worker, never from model output.\n     8\texport const IdentityFields = z.object({\n     9\t  accountableParty: z.string().min(1),\n    10\t  operationalOwner: z.string().min(1),\n    11\t  tenantId: z.string().min(1),\n    12\t  agentTypeId: z.string().startsWith(\"sha256:\"),\n    13\t  agentInstanceId: z.string().uuid(),\n    14\t  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),\n    15\t});\n    16\t\n    17\texport const AuditEvent = IdentityFields.extend({\n    18\t  eventId: z.string().uuid(),\n    19\t  ts: z.string().datetime(),\n    20\t  runId: z.string().uuid(),\n    21\t  event: z.enum([\n    22\t    \"run.started\",\n    23\t    \"run.stopped\",\n    24\t    \"run.completed\",\n    25\t    \"intent.classified\",\n    26\t    \"model.decision\",\n    27\t    \"tool.denied\",\n    28\t    \"tool.approval_requested\",\n    29\t    \"tool.executed\",\n    30\t    \"tool.failed\",\n    31\t    \"payment.refund\",\n    32\t    \"peer.call\",\n    33\t    \"reminder.sent\",\n    34\t  ]),\n    35\t  subject: z.object({ kind: z.enum([\"patient\", \"staff\", \"system\"]), id: z.string() }),\n    36\t  tool: z.string().optional(),\n    37\t  toolUseId: z.string().optional(),\n    38\t  policyVersion: z.string().optional(),\n    39\t  approvalId: z.string().optional(),\n    40\t  reason: z.string().optional(),\n    41\t  context: z\n    42\t    .object({\n    43\t      tokens: z.number().int().nonnegative().nullable(),\n    44\t      status: z.enum([\"measured\", \"estimated\", \"unavailable\"]),\n    45\t      method: z.string(),\n    46\t      cachedInputTokens: z.number().int().nonnegative().nullable(),\n    47\t      compacted: z.boolean(),\n    48\t    })\n    49\t    .optional(),\n    50\t  detail: z.record(z.unknown()).optional(),\n    51\t});\n    52\texport type AuditEvent = z.infer<typeof AuditEvent>;\n    53\t\n    54\tconst firehose = new FirehoseClient({ region: env.region });\n    55\t\n    56\texport class AuditUnavailable extends Error {}\n    57\t\n    58\texport const audit = {\n    59\t  async record(e: Omit<AuditEvent, \"eventId\" | \"ts\">): Promise<void> {\n    60\t    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });\n    61\t    try {\n    62\t      await firehose.send(\n    63\t        new PutRecordCommand({\n    64\t          DeliveryStreamName: env.auditStream,\n    65\t          Record: { Data: Buffer.from(JSON.stringify(full) + \"\\n\") },\n    66\t        }),\n    67\t      );\n    68\t    } catch (err) {\n    69\t      // Callers treat this as a hard failure: an action that cannot be audited does not run.\n    70\t      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);\n    71\t    }\n    72\t  },\n    73\t};\n    74\t\n    75\t// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.\n    76\tconst DROP_KEYS = new Set([\"ssn\", \"dateOfBirth\", \"dob\", \"memberId\", \"subscriberId\", \"cardNumber\", \"cardLast4\", \"address\"]);\n    77\tconst PATTERNS: Array<[RegExp, string]> = [\n    78\t  [/\\b\\d{3}-\\d{2}-\\d{4}\\b/g, \"[ssn]\"],\n    79\t  [/\\b(?:\\d[ -]?){13,19}\\b/g, \"[card]\"],\n    80\t  [/\\b[A-Z]{3}\\d{9}\\b/g, \"[member-id]\"],\n    81\t];\n    82\t\n    83\texport function redactPhi(value: unknown): unknown {\n    84\t  if (typeof value === \"string\") {\n    85\t    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);\n    86\t  }\n    87\t  if (Array.isArray(value)) return value.map(redactPhi);\n    88\t  if (value && typeof value === \"object\") {\n    89\t    const out: Record<string, unknown> = {};\n    90\t    for (const [k, v] of Object.entries(value)) {\n    91\t      if (DROP_KEYS.has(k)) continue;\n    92\t      out[k] = redactPhi(v);\n    93\t    }\n    94\t    return out;\n    95\t  }\n    96\t  return value;\n    97\t}\n     1\timport { createHash, randomUUID } from \"node:crypto\";\n     2\timport { readdirSync, readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n     5\t\n     6\t// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n     7\t// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\n     8\tconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n     9\t\n    10\texport interface TypeIdInputs {\n    11\t  imageDigest: string;\n    12\t  harnessVersion: string;\n    13\t  harnessGitSha: string;\n    14\t}\n    15\t\n    16\texport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n    17\t  const parts: Array<[string, Buffer]> = [\n    18\t    [\"image\", Buffer.from(inputs.imageDigest)],\n    19\t    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    20\t    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n    21\t  ];\n    22\t  const promptDir = join(ROOT, \"prompts\");\n    23\t  const promptFiles = readdirSync(promptDir)\n    24\t    .filter((f) => f.endsWith(\".txt\"))\n    25\t    .sort();\n    26\t  for (const f of promptFiles) {\n    27\t    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n    28\t  }\n    29\t  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n    30\t  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n    31\t  for (const f of CONFIG_FILES) {\n    32\t    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n    33\t  }\n    34\t  return parts;\n    35\t}\n    36\t\n    37\texport function computeAgentTypeId(inputs: TypeIdInputs): string {\n    38\t  const h = createHash(\"sha256\");\n    39\t  for (const [label, bytes] of typeIdManifest(inputs)) {\n    40\t    h.update(label);\n    41\t    h.update(\"\\0\");\n    42\t    h.update(bytes);\n    43\t    h.update(\"\\0\");\n    44\t  }\n    45\t  return `sha256:${h.digest(\"hex\")}`;\n    46\t}\n    47\t\n    48\t// One instance id per process. Pods are the unit an operator contains.\n    49\texport const AGENT_INSTANCE_ID = randomUUID();\n    50\t\n    51\tlet AGENT_TYPE_ID = \"\";\n    52\texport function setAgentTypeId(id: string): void {\n    53\t  AGENT_TYPE_ID = id;\n    54\t}\n    55\t\n    56\texport interface Subject {\n    57\t  kind: \"patient\" | \"staff\" | \"system\";\n    58\t  id: string;\n    59\t}\n    60\t\n    61\texport interface Logger {\n    62\t  info(obj: object, msg?: string): void;\n    63\t  warn(obj: object, msg?: string): void;\n    64\t  error(obj: object, msg?: string): void;\n    65\t}\n    66\t\n    67\texport interface RunContext {\n    68\t  runId: string;\n    69\t  tenantId: string;\n    70\t  subject: Subject;\n    71\t  channel: \"sms\" | \"webchat\" | \"reminder\";\n    72\t  traceparent: string;\n    73\t  log: Logger;\n    74\t  identity(): {\n    75\t    accountableParty: string;\n    76\t    operationalOwner: string;\n    77\t    tenantId: string;\n    78\t    agentTypeId: string;\n    79\t    agentInstanceId: string;\n    80\t    traceparent: string;\n    81\t  };\n    82\t  workloadToken(): Promise<string>;\n    83\t}\n    84\t\n    85\t// Projected service-account token (audience: the group STS), rotated by the kubelet.\n    86\tconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n    87\t\n    88\texport function newRunContext(init: {\n    89\t  tenantId: string;\n    90\t  subject: Subject;\n    91\t  channel: RunContext[\"channel\"];\n    92\t  traceparent?: string;\n    93\t  log: Logger;\n    94\t}): RunContext {\n    95\t  const runId = randomUUID();\n    96\t  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n    97\t  return {\n    98\t    runId,\n    99\t    tenantId: init.tenantId,\n   100\t    subject: init.subject,\n   101\t    channel: init.channel,\n   102\t    traceparent,\n   103\t    log: init.log,\n   104\t    identity: () => ({\n   105\t      accountableParty: env.accountableParty,\n   106\t      operationalOwner: env.operationalOwner,\n   107\t      tenantId: init.tenantId,\n   108\t      agentTypeId: AGENT_TYPE_ID,\n   109\t      agentInstanceId: AGENT_INSTANCE_ID,\n   110\t      traceparent,\n   111\t    }),\n   112\t    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n   113\t  };\n   114\t}\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { createHash } from \"node:crypto\";\n     3\timport { readFileSync } from \"node:fs\";\n     4\timport { join } from \"node:path\";\n     5\timport { z } from \"zod\";\n     6\timport { CLASSIFIER_MODEL, ROOT } from \"../config.js\";\n     7\t\n     8\t// Helper model that routes messages before the agent sees them. Urgent and complaint messages go\n     9\t// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\n    10\t// malformed output, unknown label, or a served model other than the pinned snapshot) routes the\n    11\t// message to staff. A failed classifier never defaults to \"send it to the agent\".\n    12\t\n    13\texport const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");\n    14\texport const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\n    15\t\n    16\texport const CLASSIFIER_ID = `sha256:${createHash(\"sha256\")\n    17\t  .update(CLASSIFIER_MODEL)\n    18\t  .update(\"\\0\")\n    19\t  .update(CLASSIFIER_PROMPT)\n    20\t  .update(\"\\0\")\n    21\t  .update(JSON.stringify(CLASSIFIER_CONFIG))\n    22\t  .digest(\"hex\")}`;\n    23\t\n    24\tconst Intent = z.enum([\"book\", \"reschedule\", \"cancel\", \"confirm\", \"coverage\", \"info\", \"urgent\", \"complaint\", \"other\"]);\n    25\tconst Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();\n    26\t\n    27\texport type Route = \"agent\" | \"staff\";\n    28\t\n    29\texport interface ClassifierDecision {\n    30\t  classifierId: string;\n    31\t  requestedModel: string;\n    32\t  servedModel: string | null;\n    33\t  intent: z.infer<typeof Intent> | null;\n    34\t  confidence: number | null;\n    35\t  route: Route;\n    36\t  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n    37\t}\n    38\t\n    39\tconst MIN_CONFIDENCE = 0.6;\n    40\t\n    41\texport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n    42\t  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n    43\t  let res: Anthropic.Message;\n    44\t  try {\n    45\t    res = await client.messages.create(\n    46\t      {\n    47\t        model: CLASSIFIER_MODEL,\n    48\t        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n    49\t        temperature: CLASSIFIER_CONFIG.temperature,\n    50\t        system: CLASSIFIER_PROMPT,\n    51\t        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n    52\t      },\n    53\t      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n    54\t    );\n    55\t  } catch (err) {\n    56\t    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n    57\t    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n    58\t  }\n    59\t\n    60\t  if (res.model !== CLASSIFIER_MODEL) {\n    61\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n    62\t  }\n    63\t\n    64\t  const textOut = res.content.find((b) => b.type === \"text\");\n    65\t  let parsed: z.infer<typeof Output>;\n    66\t  try {\n    67\t    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n    68\t  } catch {\n    69\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n    70\t  }\n    71\t\n    72\t  if (parsed.confidence < MIN_CONFIDENCE) {\n    73\t    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n    74\t  }\n    75\t  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n    76\t  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n    77\t}\n     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\n     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, BatchGetCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport { env } from \"../config.js\";\n     4\t\n     5\t// Stop control. Operators write halted=true on \"global\" or \"tenant#<clinicId>\" in the control table.\n     6\t// The agent only reads this table; every model turn and every tool call checks it, and a watcher\n     7\t// aborts in-flight work for halted scopes.\n     8\texport class Halted extends Error {\n     9\t  constructor(public scope: string) {\n    10\t    super(`agent halted (${scope})`);\n    11\t  }\n    12\t}\n    13\t\n    14\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    15\tconst POLL_MS = 2000;\n    16\t\n    17\ttype Active = { tenantId: string; abort: AbortController };\n    18\tconst active = new Map<string, Active>();\n    19\t\n    20\tlet lastRead = 0;\n    21\tlet halted = new Set<string>();\n    22\t\n    23\tasync function refresh(): Promise<void> {\n    24\t  const res = await ddb.send(\n    25\t    new BatchGetCommand({\n    26\t      RequestItems: {\n    27\t        [env.controlTable]: {\n    28\t          Keys: [{ pk: \"global\" }, ...[...new Set([...active.values()].map((a) => a.tenantId))].map((t) => ({ pk: `tenant#${t}` }))],\n    29\t          ConsistentRead: true,\n    30\t        },\n    31\t      },\n    32\t    }),\n    33\t  );\n    34\t  const next = new Set<string>();\n    35\t  for (const item of res.Responses?.[env.controlTable] ?? []) {\n    36\t    if (item.halted === true) next.add(String(item.pk));\n    37\t  }\n    38\t  halted = next;\n    39\t  lastRead = Date.now();\n    40\t}\n    41\t\n    42\texport const killSwitch = {\n    43\t  register(runId: string, tenantId: string, abort: AbortController): () => void {\n    44\t    active.set(runId, { tenantId, abort });\n    45\t    return () => active.delete(runId);\n    46\t  },\n    47\t\n    48\t  async assertRunning(tenantId: string): Promise<void> {\n    49\t    if (Date.now() - lastRead > POLL_MS) {\n    50\t      try {\n    51\t        await refresh();\n    52\t      } catch {\n    53\t        // If the control table cannot be read, treat the agent as halted.\n    54\t        throw new Halted(\"control-unreadable\");\n    55\t      }\n    56\t    }\n    57\t    if (halted.has(\"global\")) throw new Halted(\"global\");\n    58\t    if (halted.has(`tenant#${tenantId}`)) throw new Halted(`tenant#${tenantId}`);\n    59\t  },\n    60\t\n    61\t  startWatcher(): NodeJS.Timeout {\n    62\t    return setInterval(async () => {\n    63\t      try {\n    64\t        await refresh();\n    65\t      } catch {\n    66\t        halted = new Set([\"global\"]);\n    67\t      }\n    68\t      for (const [runId, a] of active) {\n    69\t        if (halted.has(\"global\") || halted.has(`tenant#${a.tenantId}`)) {\n    70\t          a.abort.abort(new Halted(halted.has(\"global\") ? \"global\" : `tenant#${a.tenantId}`));\n    71\t          active.delete(runId);\n    72\t        }\n    73\t      }\n    74\t    }, POLL_MS);\n    75\t  },\n    76\t};","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01UmgyU8WqEsW5bonFFC71h7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
