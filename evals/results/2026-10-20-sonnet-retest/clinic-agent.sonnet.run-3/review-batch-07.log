 ],\n    36\t  \"tools\": {\n    37\t    \"allowlist\": \"config/tools.allowlist.yaml\",\n    38\t    \"mcpServers\": [\n    39\t      {\n    40\t        \"id\": \"ehr\",\n    41\t        \"url\": \"https://ehr-mcp.internal.northbay-clinics.example/mcp\",\n    42\t        \"tlsCertSha256\": \"1f6a9c3e5b7d9f1a3c5e7b9d1f3a5c7e9b1d3f5a7c9e1b3d5f7a9c1e3b5d7f9a\",\n    43\t        \"owner\": \"ehr-integrations@northbay-clinics.example\"\n    44\t      }\n    45\t    ],\n    46\t    \"native\": [\"payments\", \"sms\", \"insurance\"]\n    47\t  },\n    48\t  \"peers\": [\n    49\t    {\n    50\t      \"id\": \"eligibility-agent\",\n    51\t      \"url\": \"https://eligibility.partners.northbay-clinics.example/a2a\",\n    52\t      \"owner\": \"revenue-cycle@northbay-clinics.example\"\n    53\t    }\n    54\t  ],\n    55\t  \"permissions\": {\n    56\t    \"awsRole\": \"arn:aws:iam::418295730611:role/clinic-agent-runtime\",\n    57\t    \"ehrScopes\": [\"patient.read\", \"appointment.read\", \"appointment.write\"],\n    58\t    \"paymentsScopes\": [\"deposits.refund\"],\n    59\t    \"eligibilityScopes\": [\"eligibility:read\"]\n    60\t  },\n    61\t  \"memory\": \"none\",\n    62\t  \"retrieval\": \"none\",\n    63\t  \"network\": { \"policy\": \"k8s/deployment.yaml#clinic-agent-egress\", \"egressProxy\": \"egress-proxy.platform.svc:3128\" },\n    64\t  \"budgets\": \"config/budgets.yaml\",\n    65\t  \"policies\": { \"action\": \"config/policy.yaml\", \"actionPolicyVersion\": \"2026-09-18.3\" }\n    66\t}\n     1\t# Security-relevant paths need a review from the platform leads in addition to the two\n     2\t# approvals required by branch protection (infra/terraform/github.tf).\n     3\t*                    @northbay-clinics/clinic-agent-devs\n     4\t/prompts/            @northbay-clinics/agent-platform-leads\n     5\t/config/             @northbay-clinics/agent-platform-leads\n     6\t/release/            @northbay-clinics/agent-platform-leads\n     7\t/infra/              @northbay-clinics/agent-platform-leads @northbay-clinics/cloud-security\n     8\t/k8s/                @northbay-clinics/agent-platform-leads @northbay-clinics/cloud-security\n     9\t/.github/            @northbay-clinics/agent-platform-leads @northbay-clinics/cloud-security\n    10\t/src/tools/          @northbay-clinics/agent-platform-leads\n    11\t/src/control/        @northbay-clinics/agent-platform-leads\n    12\t/src/audit/          @northbay-clinics/agent-platform-leads\n     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    16\t      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5.0.0\n    17\t        with:\n    18\t          node-version: \"22.11\"\n    19\t          cache: npm\n    20\t      - run: npm ci --ignore-scripts\n    21\t      - run: npm run lint\n    22\t      - run: npm test\n    23\t      - run: npm run build\n    24\t\n    25\t  manifest-check:\n    26\t    runs-on: ubuntu-24.04\n    27\t    steps:\n    28\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    29\t      - name: Prompt digests match the release manifest\n    30\t        run: |\n    31\t          node -e '\n    32\t            const fs = require(\"fs\"), crypto = require(\"crypto\");\n    33\t            const m = JSON.parse(fs.readFileSync(\"release/manifest.json\", \"utf8\"));\n    34\t            let bad = 0;\n    35\t            for (const p of m.prompts) {\n    36\t              const got = crypto.createHash(\"sha256\").update(fs.readFileSync(p.path)).digest(\"hex\");\n    37\t              if (got !== p.sha256) { console.error(`${p.path}: manifest ${p.sha256} != file ${got}`); bad++; }\n    38\t            }\n    39\t            const ver = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\")).version;\n    40\t            if (m.harness.version !== ver) { console.error(`harness version ${m.harness.version} != package ${ver}`); bad++; }\n    41\t            process.exit(bad ? 1 : 0);\n    42\t          '\n    43\t\n    44\t  image:\n    45\t    if: github.ref == 'refs/heads/main'\n    46\t    needs: [test, manifest-check]\n    47\t    runs-on: ubuntu-24.04\n    48\t    permissions:\n    49\t      contents: read\n    50\t      id-token: write\n    51\t      attestations: write\n    52\t      packages: write\n    53\t    steps:\n    54\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    55\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    56\t        with:\n    57\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-image-build\n    58\t          aws-region: us-west-2\n    59\t      - uses: aws-actions/amazon-ecr-login@062b18b96a7aff071d4dc91bc00c4c1a7945b076 # v2.0.1\n    60\t        id: ecr\n    61\t      - uses: docker/setup-buildx-action@e468171a9de216ec08956ac3ada2f0791b6bd435 # v3.11.1\n    62\t      - uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    63\t        id: build\n    64\t        with:\n    65\t          push: true\n    66\t          tags: ${{ steps.ecr.outputs.registry }}/clinic-agent:${{ github.sha }}\n    67\t          provenance: mode=max\n    68\t          sbom: true\n    69\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    70\t        with:\n    71\t          cosign-release: v2.6.2\n    72\t      - name: Sign image\n    73\t        run: cosign sign --yes ${{ steps.ecr.outputs.registry }}/clinic-agent@${{ steps.build.outputs.digest }}\n    74\t      - uses: actions/attest-build-provenance@977bb373ede98d70efdf65b84cb5f73e068dcc2a # v3.0.0\n    75\t        with:\n    76\t          subject-name: ${{ steps.ecr.outputs.registry }}/clinic-agent\n    77\t          subject-digest: ${{ steps.build.outputs.digest }}\n    78\t          push-to-registry: true\n     1\tname: deploy\n     2\t\n     3\t# Deploys the image digest named in release/manifest.json. The digest reaches the manifest through\n     4\t# a reviewed release PR, so what runs is always a reviewed commit.\n     5\ton:\n     6\t  workflow_dispatch:\n     7\t    inputs:\n     8\t      emergency:\n     9\t        description: Emergency change (hotfix/* branch, production-emergency environment)\n    10\t        type: boolean\n    11\t        default: false\n    12\t      owner:\n    13\t        description: Emergency only - person accountable for this change\n    14\t        type: string\n    15\t        default: \"\"\n    16\t      reason:\n    17\t        description: Emergency only - why this cannot wait for a normal release\n    18\t        type: string\n    19\t        default: \"\"\n    20\t      expires_on:\n    21\t        description: Emergency only - date (YYYY-MM-DD) by which it is replaced by a normal release\n    22\t        type: string\n    23\t        default: \"\"\n    24\t\n    25\tpermissions:\n    26\t  contents: read\n    27\t  id-token: write\n    28\t  issues: write\n    29\t\n    30\tconcurrency:\n    31\t  group: deploy-production\n    32\t  cancel-in-progress: false\n    33\t\n    34\tjobs:\n    35\t  deploy:\n    36\t    runs-on: ubuntu-24.04\n    37\t    environment: ${{ inputs.emergency && 'production-emergency' || 'production' }}\n    38\t    steps:\n    39\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    40\t\n    41\t      - name: Emergency change record is complete\n    42\t        if: inputs.emergency\n    43\t        env:\n    44\t          OWNER: ${{ inputs.owner }}\n    45\t          REASON: ${{ inputs.reason }}\n    46\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    47\t        run: |\n    48\t          test -n \"$OWNER\" || { echo \"owner is required\"; exit 1; }\n    49\t          test -n \"$REASON\" || { echo \"reason is required\"; exit 1; }\n    50\t          date -d \"$EXPIRES_ON\" +%F >/dev/null || { echo \"expires_on must be a date\"; exit 1; }\n    51\t          [[ \"$GITHUB_REF_NAME\" == hotfix/* ]] || { echo \"emergency deploys come from hotfix/* branches\"; exit 1; }\n    52\t\n    53\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    54\t        with:\n    55\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-deploy\n    56\t          aws-region: us-west-2\n    57\t\n    58\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    59\t        with:\n    60\t          cosign-release: v2.6.2\n    61\t\n    62\t      - name: Verify image signature\n    63\t        run: |\n    64\t          DIGEST=$(jq -r .image.digest release/manifest.json)\n    65\t          REPO=$(jq -r .image.repository release/manifest.json)\n    66\t          cosign verify \"$REPO@$DIGEST\" \\\n    67\t            --certificate-identity \"https://github.com/northbay-clinics/clinic-agent/.github/workflows/ci.yml@refs/heads/main\" \\\n    68\t            --certificate-oidc-issuer https://token.actions.githubusercontent.com\n    69\t          grep -q \"$DIGEST\" k8s/deployment.yaml || { echo \"k8s/deployment.yaml does not use the manifest digest\"; exit 1; }\n    70\t\n    71\t      - name: Apply\n    72\t        run: |\n    73\t          aws eks update-kubeconfig --name clinic-agent-prod\n    74\t          kubectl apply -f k8s/deployment.yaml\n    75\t          kubectl -n clinic-agent annotate deployment/clinic-agent --overwrite \\\n    76\t            northbay.example/git-sha=\"$GITHUB_SHA\" \\\n    77\t            northbay.example/release=\"$(jq -r .release release/manifest.json)\" \\\n    78\t            northbay.example/deployed-by=\"$GITHUB_ACTOR\" \\\n    79\t            northbay.example/run=\"$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID\"\n    80\t          kubectl -n clinic-agent rollout status deployment/clinic-agent --timeout=5m\n    81\t\n    82\t      - name: Open follow-up review for emergency change\n    83\t        if: inputs.emergency\n    84\t        env:\n    85\t          GH_TOKEN: ${{ github.token }}\n    86\t          OWNER: ${{ inputs.owner }}\n    87\t          REASON: ${{ inputs.reason }}\n    88\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    89\t        run: |\n    90\t          gh issue create \\\n    91\t            --title \"Follow-up review: emergency deploy ${GITHUB_SHA::8}\" \\\n    92\t            --label emergency-change,needs-review \\\n    93\t            --assignee \"$OWNER\" \\\n    94\t            --body \"Owner: $OWNER\n    95\t          Reason: $REASON\n    96\t          Ends: $EXPIRES_ON\n    97\t          Commit: $GITHUB_SHA\n    98\t          Approved in environment production-emergency by a required reviewer (see run $GITHUB_RUN_ID).\n    99\t          Review and merge to main via normal PR before the end date.\"\n     1\timport { readFileSync } from \"node:fs\";\n     2\timport { join } from \"node:path\";\n     3\timport { parse } from \"yaml\";\n     4\t\n     5\texport const ROOT = process.env.CLINIC_AGENT_ROOT ?? process.cwd();\n     6\t\n     7\texport interface Policy {\n     8\t  version: string;\n     9\t  highImpactTools: string[];\n    10\t  approval: { ttlSeconds: number; approverRoles: string[]; table: string };\n    11\t}\n    12\t\n    13\texport interface AllowlistEntry {\n    14\t  tool: string;\n    15\t  reason: string;\n    16\t}\n    17\t\n    18\texport interface Budgets {\n    19\t  run: {\n    20\t    maxTurns: number;\n    21\t    maxWallMs: number;\n    22\t    maxInputTokens: number;\n    23\t    maxOutputTokens: number;\n    24\t    maxCostUsd: number;\n    25\t    maxToolCalls: number;\n    26\t    maxToolCallsPerMinute: number;\n    27\t    maxPeerCalls: number;\n    28\t  };\n    29\t  quotas: {\n    30\t    perSubjectDailyUsd: number;\n    31\t    perTenantDailyUsd: number;\n    32\t    fleetDailyUsd: number;\n    33\t    perTenantToolCallsPerMinute: number;\n    34\t    fleetToolCallsPerMinute: number;\n    35\t  };\n    36\t  pricingUsdPerMTok: Record<string, { input: number; output: number; cacheRead: number; cacheWrite: number }>;\n    37\t  onExceed: \"handoff_to_staff\";\n    38\t}\n    39\t\n    40\tfunction loadYaml<T>(rel: string): T {\n    41\t  return parse(readFileSync(join(ROOT, rel), \"utf8\")) as T;\n    42\t}\n    43\t\n    44\texport const policy = loadYaml<Policy>(\"config/policy.yaml\");\n    45\texport const allowlist = loadYaml<{ role: string; tools: AllowlistEntry[] }>(\"config/tools.allowlist.yaml\");\n    46\texport const budgets = loadYaml<Budgets>(\"config/budgets.yaml\");\n    47\texport const manifest = JSON.parse(readFileSync(join(ROOT, \"release/manifest.json\"), \"utf8\"));\n    48\t\n    49\texport const AGENT_MODEL = \"claude-sonnet-4-5-20250929\";\n    50\texport const CLASSIFIER_MODEL = \"claude-haiku-4-5-20251001\";\n    51\t\n    52\texport const env = {\n    53\t  region: process.env.AWS_REGION ?? \"us-west-2\",\n    54\t  controlTable: process.env.CONTROL_TABLE ?? \"clinic-agent-control\",\n    55\t  budgetTable: process.env.BUDGET_TABLE ?? \"clinic-agent-budgets\",\n    56\t  auditStream: process.env.AUDIT_STREAM ?? \"clinic-agent-audit\",\n    57\t  smsSigningSecretArn: process.env.SMS_SIGNING_SECRET_ARN ?? \"\",\n    58\t  chatJwksUrl: process.env.CHAT_JWKS_URL ?? \"https://auth.northbay-clinics.example/.well-known/jwks.json\",\n    59\t  chatIssuer: process.env.CHAT_ISSUER ?? \"https://auth.northbay-clinics.example/\",\n    60\t  eligibilityUrl: process.env.ELIGIBILITY_URL ?? \"https://eligibility.partners.northbay-clinics.example/a2a\",\n    61\t  eligibilityIssuer: process.env.ELIGIBILITY_ISSUER ?? \"https://eligibility.partners.northbay-clinics.example\",\n    62\t  tokenExchangeUrl: process.env.TOKEN_EXCHANGE_URL ?? \"https://sts.northbay-clinics.example/oauth2/token\",\n    63\t  accountableParty: \"northbay-clinic-group:patient-access\",\n    64\t  operationalOwner: \"team:agent-platform\",\n    65\t};\n     1\timport Fastify from \"fastify\";\n     2\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     3\timport { env, manifest } from \"./config.js\";\n     4\timport { computeAgentTypeId, setAgentTypeId, AGENT_INSTANCE_ID } from \"./agent/identity.js\";\n     5\timport { killSwitch } from \"./control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"./integrations/ehr-mcp.js\";\n     7\timport { registerSmsWebhook } from \"./routes/sms-webhook.js\";\n     8\timport { registerWebchat } from \"./routes/webchat.js\";\n     9\timport { nativeTools } from \"./tools/executor.js\";\n    10\timport { ToolRegistry, type ConfiguredServer } from \"./tools/registry.js\";\n    11\t\n    12\tconst metrics = {\n    13\t  increment(name: string) {\n    14\t    process.stdout.write(JSON.stringify({ _aws: { CloudWatchMetrics: [{ Namespace: \"clinic-agent\", Metrics: [{ Name: name }] }] }, [name]: 1 }) + \"\\n\");\n    15\t  },\n    16\t};\n    17\t\n    18\tconst app = Fastify({\n    19\t  logger: {\n    20\t    level: process.env.LOG_LEVEL ?? \"info\",\n    21\t    redact: { paths: [\"req.headers.authorization\", 'req.headers[\"x-sms-signature\"]', \"req.headers.cookie\"], censor: \"[redacted]\" },\n    22\t  },\n    23\t  bodyLimit: 16_384,\n    24\t});\n    25\t\n    26\t// Identity check against the approved release manifest.\n    27\tconst typeId = computeAgentTypeId({\n    28\t  imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    29\t  harnessVersion: manifest.harness.version,\n    30\t  harnessGitSha: process.env.GIT_SHA ?? \"\",\n    31\t});\n    32\tif (typeId !== manifest.agentTypeId) {\n    33\t  app.log.error({ expected: manifest.agentTypeId, actual: typeId }, \"agent type id does not match release manifest\");\n    34\t  metrics.increment(\"identity.mismatch\");\n    35\t}\n    36\tsetAgentTypeId(typeId);\n    37\tapp.log.info({ agentTypeId: typeId, agentInstanceId: AGENT_INSTANCE_ID, release: manifest.release }, \"starting\");\n    38\t\n    39\t// Tools.\n    40\tconst servers: ConfiguredServer[] = manifest.tools.mcpServers;\n    41\tconst ehrServer = servers.find((s) => s.id === \"ehr\");\n    42\tif (!ehrServer) throw new Error(\"release manifest has no ehr server\");\n    43\tconst ehr = ehrClient(ehrServer);\n    44\t\n    45\tconst registry = new ToolRegistry(servers);\n    46\tfor (const [serverId, tools] of Object.entries(nativeTools(ehr))) registry.registerNative(serverId, tools);\n    47\ttry {\n    48\t  const { reportedName, meta } = await ehr.catalog();\n    49\t  registry.registerMcp(\"ehr\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\n    50\t} catch (err) {\n    51\t  app.log.error({ err }, \"EHR MCP catalog unavailable; EHR tools disabled\");\n    52\t}\n    53\tfor (const r of registry.rejected) app.log.warn(r, \"tool rejected at load\");\n    54\tfor (const c of registry.conflicts) app.log.warn(c, \"tool name conflict\");\n    55\t\n    56\t// Clinics.\n    57\tconst directory: Array<{ id: string; name: string; smsNumber: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    58\tconst byId = new Map(directory.map((c) => [c.id, c]));\n    59\tconst byNumber = new Map(directory.map((c) => [c.smsNumber, c]));\n    60\t\n    61\tconst sm = new SecretsManagerClient({ region: env.region });\n    62\tlet signingSecret: { value: string; at: number } | undefined;\n    63\tasync function smsSigningSecret(): Promise<string> {\n    64\t  if (signingSecret && Date.now() - signingSecret.at < 5 * 60_000) return signingSecret.value;\n    65\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: env.smsSigningSecretArn }));\n    66\t  signingSecret = { value: s.SecretString ?? \"\", at: Date.now() };\n    67\t  return signingSecret.value;\n    68\t}\n    69\t\n    70\tapp.addContentTypeParser(\"application/json\", { parseAs: \"string\" }, (req, body, done) => {\n    71\t  (req as { rawBody?: string }).rawBody = body as string;\n    72\t  try {\n    73\t    done(null, JSON.parse(body as string));\n    74\t  } catch (err) {\n    75\t    done(err as Error, undefined);\n    76\t  }\n    77\t});\n    78\t\n    79\tregisterSmsWebhook(app, {\n    80\t  registry,\n    81\t  signingSecret: smsSigningSecret,\n    82\t  clinicByNumber: (to) => byNumber.get(to),\n    83\t  metrics,\n    84\t});\n    85\tregisterWebchat(app, { registry, clinicById: (id) => byId.get(id) });\n    86\t\n    87\tapp.get(\"/healthz\", async () => ({ ok: true }));\n    88\t\n    89\tkillSwitch.startWatcher();\n    90\tawait app.listen({ host: \"0.0.0.0\", port: 8080 });\n     1\t# Hard limits enforced by src/agent/budget.ts, outside the model.\n     2\trun:\n     3\t  maxTurns: 8                 # model calls per run\n     4\t  maxWallMs: 45000            # whole run, including tool calls\n     5\t  maxInputTokens: 120000      # summed across model calls in the run\n     6\t  maxOutputTokens: 6000\n     7\t  maxCostUsd: 0.40\n     8\t  maxToolCalls: 16\n     9\t  maxToolCallsPerMinute: 12\n    10\t  maxPeerCalls: 2             # calls to the eligibility agent; this agent starts no sub-agents\n    11\t\n    12\tquotas:\n    13\t  # Daily spend and per-minute tool-call ceilings across many runs.\n    14\t  perSubjectDailyUsd: 2.00    # one patient or staff user\n    15\t  perTenantDailyUsd: 60.00    # one clinic\n    16\t  fleetDailyUsd: 900.00       # all clinics\n    17\t  perTenantToolCallsPerMinute: 240\n    18\t  fleetToolCallsPerMinute: 2400\n    19\t\n    20\tpricingUsdPerMTok:\n    21\t  claude-sonnet-4-5-20250929: { input: 3.00, output: 15.00, cacheRead: 0.30, cacheWrite: 3.75 }\n    22\t  claude-haiku-4-5-20251001: { input: 1.00, output: 5.00, cacheRead: 0.10, cacheWrite: 1.25 }\n    23\t\n    24\t# When a limit is hit the run stops, the stop is audited with the limit name, and the\n    25\t# conversation is handed to the clinic's front-desk queue.\n    26\tonExceed: handoff_to_staff\n     1\t# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\n     2\tpolicyVersion: \"2026-09-18.3\"\n     3\t\n     4\t# Tools that never run without a staff approval bound to the request.\n     5\thighImpactTools:\n     6\t  - ehr__cancel_appointment\n     7\t  - payments__refund_deposit\n     8\t  - sms__send_freeform\n     9\t\n    10\tapproval:\n    11\t  ttlSeconds: 900\n    12\t  approverRoles:\n    13\t    - front_desk_lead\n    14\t    - clinic_manager\n    15\t  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n    16\t  table: clinic-agent-approvals\n     1\t# Every tool the scheduling agent may call, with the task it serves.\n     2\t# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n     3\t# are not used for allow or approval decisions.\n     4\trole: scheduling_agent\n     5\ttools:\n     6\t  - tool: ehr__find_patient\n     7\t    reason: Match the sender to a patient record by date of birth and phone or email.\n     8\t  - tool: ehr__search_slots\n     9\t    reason: List open slots for a provider, location, and visit type.\n    10\t  - tool: ehr__get_appointment\n    11\t    reason: Read one appointment the patient asks about.\n    12\t  - tool: ehr__list_patient_appointments\n    13\t    reason: Show the patient their upcoming appointments.\n    14\t  - tool: ehr__book_appointment\n    15\t    reason: Book a slot the patient chose.\n    16\t  - tool: ehr__update_appointment\n    17\t    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n    18\t  - tool: ehr__cancel_appointment\n    19\t    reason: Cancel an appointment at the patient's request.\n    20\t  - tool: payments__refund_deposit\n    21\t    reason: Refund a no-show deposit after staff review.\n    22\t  - tool: sms__send_to_patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.","is_error":false}]},"parent_tool_use_id":null,"session_id":"45ab43c4-ecdd-452d-b4e1-a84e9bc45d3f","uuid":"c6e901f4-c1e8-425d-be27-c1f8967f4cac","timestamp":"2026-10-20T15:36:42.412Z","tool_use_result":{"stdout":"     1\t{\n     2\t  \"release\": \"clinic-agent-3.4.1\",\n     3\t  \"agentTypeId\": \"sha256:7c2e91f04ab35d6e8f1029c4b7a6d3e5f8091a2b3c4d5e6f708192a3b4c5d6e7\",\n     4\t  \"image\": {\n     5\t    \"repository\": \"418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent\",\n     6\t    \"digest\": \"sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\"\n     7\t  },\n     8\t  \"harness\": {\n     9\t    \"version\": \"3.4.1\",\n    10\t    \"gitSha\": \"e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\"\n    11\t  },\n    12\t  \"prompts\": [\n    13\t    { \"path\": \"prompts/system.md\", \"sha256\": \"5d1e0c9b8a7f6e5d4c3b2a1908f7e6d5c4b3a291807f6e5d4c3b2a19087f6e5d\" },\n    14\t    { \"path\": \"prompts/intent-classifier.txt\", \"sha256\": \"a3f9e1d7c5b3a1f9e7d5c3b1a9f7e5d3c1b9a7f5e3d1c9b7a5f3e1d9c7b5a3f1\" }\n    15\t  ],\n    16\t  \"models\": [\n    17\t    {\n    18\t      \"role\": \"agent\",\n    19\t      \"provider\": \"anthropic\",\n    20\t      \"requestedId\": \"claude-sonnet-4-5-20250929\",\n    21\t      \"kind\": \"pinned_snapshot\",\n    22\t      \"versionDoc\": { \"url\": \"https://docs.anthropic.com/en/docs/about-claude/models/overview\", \"checked\": \"2026-09-15\" },\n    23\t      \"adapter\": null,\n    24\t      \"providerHidden\": [\"weights\", \"training_data\", \"serving_stack\"]\n    25\t    },\n    26\t    {\n    27\t      \"role\": \"intent_classifier\",\n    28\t      \"provider\": \"anthropic\",\n    29\t      \"requestedId\": \"claude-haiku-4-5-20251001\",\n    30\t      \"kind\": \"pinned_snapshot\",\n    31\t      \"versionDoc\": { \"url\": \"https://docs.anthropic.com/en/docs/about-claude/models/overview\", \"checked\": \"2026-09-15\" },\n    32\t      \"adapter\": null,\n    33\t      \"providerHidden\": [\"weights\", \"training_data\", \"serving_stack\"]\n    34\t    }\n    35\t  ],\n    36\t  \"tools\": {\n    37\t    \"allowlist\": \"config/tools.allowlist.yaml\",\n    38\t    \"mcpServers\": [\n    39\t      {\n    40\t        \"id\": \"ehr\",\n    41\t        \"url\": \"https://ehr-mcp.internal.northbay-clinics.example/mcp\",\n    42\t        \"tlsCertSha256\": \"1f6a9c3e5b7d9f1a3c5e7b9d1f3a5c7e9b1d3f5a7c9e1b3d5f7a9c1e3b5d7f9a\",\n    43\t        \"owner\": \"ehr-integrations@northbay-clinics.example\"\n    44\t      }\n    45\t    ],\n    46\t    \"native\": [\"payments\", \"sms\", \"insurance\"]\n    47\t  },\n    48\t  \"peers\": [\n    49\t    {\n    50\t      \"id\": \"eligibility-agent\",\n    51\t      \"url\": \"https://eligibility.partners.northbay-clinics.example/a2a\",\n    52\t      \"owner\": \"revenue-cycle@northbay-clinics.example\"\n    53\t    }\n    54\t  ],\n    55\t  \"permissions\": {\n    56\t    \"awsRole\": \"arn:aws:iam::418295730611:role/clinic-agent-runtime\",\n    57\t    \"ehrScopes\": [\"patient.read\", \"appointment.read\", \"appointment.write\"],\n    58\t    \"paymentsScopes\": [\"deposits.refund\"],\n    59\t    \"eligibilityScopes\": [\"eligibility:read\"]\n    60\t  },\n    61\t  \"memory\": \"none\",\n    62\t  \"retrieval\": \"none\",\n    63\t  \"network\": { \"policy\": \"k8s/deployment.yaml#clinic-agent-egress\", \"egressProxy\": \"egress-proxy.platform.svc:3128\" },\n    64\t  \"budgets\": \"config/budgets.yaml\",\n    65\t  \"policies\": { \"action\": \"config/policy.yaml\", \"actionPolicyVersion\": \"2026-09-18.3\" }\n    66\t}\n     1\t# Security-relevant paths need a review from the platform leads in addition to the two\n     2\t# approvals required by branch protection (infra/terraform/github.tf).\n     3\t*                    @northbay-clinics/clinic-agent-devs\n     4\t/prompts/            @northbay-clinics/agent-platform-leads\n     5\t/config/             @northbay-clinics/agent-platform-leads\n     6\t/release/            @northbay-clinics/agent-platform-leads\n     7\t/infra/              @northbay-clinics/agent-platform-leads @northbay-clinics/cloud-security\n     8\t/k8s/                @northbay-clinics/agent-platform-leads @northbay-clinics/cloud-security\n     9\t/.github/            @northbay-clinics/agent-platform-leads @northbay-clinics/cloud-security\n    10\t/src/tools/          @northbay-clinics/agent-platform-leads\n    11\t/src/control/        @northbay-clinics/agent-platform-leads\n    12\t/src/audit/          @northbay-clinics/agent-platform-leads\n     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    16\t      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5.0.0\n    17\t        with:\n    18\t          node-version: \"22.11\"\n    19\t          cache: npm\n    20\t      - run: npm ci --ignore-scripts\n    21\t      - run: npm run lint\n    22\t      - run: npm test\n    23\t      - run: npm run build\n    24\t\n    25\t  manifest-check:\n    26\t    runs-on: ubuntu-24.04\n    27\t    steps:\n    28\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    29\t      - name: Prompt digests match the release manifest\n    30\t        run: |\n    31\t          node -e '\n    32\t            const fs = require(\"fs\"), crypto = require(\"crypto\");\n    33\t            const m = JSON.parse(fs.readFileSync(\"release/manifest.json\", \"utf8\"));\n    34\t            let bad = 0;\n    35\t            for (const p of m.prompts) {\n    36\t              const got = crypto.createHash(\"sha256\").update(fs.readFileSync(p.path)).digest(\"hex\");\n    37\t              if (got !== p.sha256) { console.error(`${p.path}: manifest ${p.sha256} != file ${got}`); bad++; }\n    38\t            }\n    39\t            const ver = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\")).version;\n    40\t            if (m.harness.version !== ver) { console.error(`harness version ${m.harness.version} != package ${ver}`); bad++; }\n    41\t            process.exit(bad ? 1 : 0);\n    42\t          '\n    43\t\n    44\t  image:\n    45\t    if: github.ref == 'refs/heads/main'\n    46\t    needs: [test, manifest-check]\n    47\t    runs-on: ubuntu-24.04\n    48\t    permissions:\n    49\t      contents: read\n    50\t      id-token: write\n    51\t      attestations: write\n    52\t      packages: write\n    53\t    steps:\n    54\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    55\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    56\t        with:\n    57\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-image-build\n    58\t          aws-region: us-west-2\n    59\t      - uses: aws-actions/amazon-ecr-login@062b18b96a7aff071d4dc91bc00c4c1a7945b076 # v2.0.1\n    60\t        id: ecr\n    61\t      - uses: docker/setup-buildx-action@e468171a9de216ec08956ac3ada2f0791b6bd435 # v3.11.1\n    62\t      - uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    63\t        id: build\n    64\t        with:\n    65\t          push: true\n    66\t          tags: ${{ steps.ecr.outputs.registry }}/clinic-agent:${{ github.sha }}\n    67\t          provenance: mode=max\n    68\t          sbom: true\n    69\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    70\t        with:\n    71\t          cosign-release: v2.6.2\n    72\t      - name: Sign image\n    73\t        run: cosign sign --yes ${{ steps.ecr.outputs.registry }}/clinic-agent@${{ steps.build.outputs.digest }}\n    74\t      - uses: actions/attest-build-provenance@977bb373ede98d70efdf65b84cb5f73e068dcc2a # v3.0.0\n    75\t        with:\n    76\t          subject-name: ${{ steps.ecr.outputs.registry }}/clinic-agent\n    77\t          subject-digest: ${{ steps.build.outputs.digest }}\n    78\t          push-to-registry: true\n     1\tname: deploy\n     2\t\n     3\t# Deploys the image digest named in release/manifest.json. The digest reaches the manifest through\n     4\t# a reviewed release PR, so what runs is always a reviewed commit.\n     5\ton:\n     6\t  workflow_dispatch:\n     7\t    inputs:\n     8\t      emergency:\n     9\t        description: Emergency change (hotfix/* branch, production-emergency environment)\n    10\t        type: boolean\n    11\t        default: false\n    12\t      owner:\n    13\t        description: Emergency only - person accountable for this change\n    14\t        type: string\n    15\t        default: \"\"\n    16\t      reason:\n    17\t        description: Emergency only - why this cannot wait for a normal release\n    18\t        type: string\n    19\t        default: \"\"\n    20\t      expires_on:\n    21\t        description: Emergency only - date (YYYY-MM-DD) by which it is replaced by a normal release\n    22\t        type: string\n    23\t        default: \"\"\n    24\t\n    25\tpermissions:\n    26\t  contents: read\n    27\t  id-token: write\n    28\t  issues: write\n    29\t\n    30\tconcurrency:\n    31\t  group: deploy-production\n    32\t  cancel-in-progress: false\n    33\t\n    34\tjobs:\n    35\t  deploy:\n    36\t    runs-on: ubuntu-24.04\n    37\t    environment: ${{ inputs.emergency && 'production-emergency' || 'production' }}\n    38\t    steps:\n    39\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    40\t\n    41\t      - name: Emergency change record is complete\n    42\t        if: inputs.emergency\n    43\t        env:\n    44\t          OWNER: ${{ inputs.owner }}\n    45\t          REASON: ${{ inputs.reason }}\n    46\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    47\t        run: |\n    48\t          test -n \"$OWNER\" || { echo \"owner is required\"; exit 1; }\n    49\t          test -n \"$REASON\" || { echo \"reason is required\"; exit 1; }\n    50\t          date -d \"$EXPIRES_ON\" +%F >/dev/null || { echo \"expires_on must be a date\"; exit 1; }\n    51\t          [[ \"$GITHUB_REF_NAME\" == hotfix/* ]] || { echo \"emergency deploys come from hotfix/* branches\"; exit 1; }\n    52\t\n    53\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    54\t        with:\n    55\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-deploy\n    56\t          aws-region: us-west-2\n    57\t\n    58\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    59\t        with:\n    60\t          cosign-release: v2.6.2\n    61\t\n    62\t      - name: Verify image signature\n    63\t        run: |\n    64\t          DIGEST=$(jq -r .image.digest release/manifest.json)\n    65\t          REPO=$(jq -r .image.repository release/manifest.json)\n    66\t          cosign verify \"$REPO@$DIGEST\" \\\n    67\t            --certificate-identity \"https://github.com/northbay-clinics/clinic-agent/.github/workflows/ci.yml@refs/heads/main\" \\\n    68\t            --certificate-oidc-issuer https://token.actions.githubusercontent.com\n    69\t          grep -q \"$DIGEST\" k8s/deployment.yaml || { echo \"k8s/deployment.yaml does not use the manifest digest\"; exit 1; }\n    70\t\n    71\t      - name: Apply\n    72\t        run: |\n    73\t          aws eks update-kubeconfig --name clinic-agent-prod\n    74\t          kubectl apply -f k8s/deployment.yaml\n    75\t          kubectl -n clinic-agent annotate deployment/clinic-agent --overwrite \\\n    76\t            northbay.example/git-sha=\"$GITHUB_SHA\" \\\n    77\t            northbay.example/release=\"$(jq -r .release release/manifest.json)\" \\\n    78\t            northbay.example/deployed-by=\"$GITHUB_ACTOR\" \\\n    79\t            northbay.example/run=\"$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID\"\n    80\t          kubectl -n clinic-agent rollout status deployment/clinic-agent --timeout=5m\n    81\t\n    82\t      - name: Open follow-up review for emergency change\n    83\t        if: inputs.emergency\n    84\t        env:\n    85\t          GH_TOKEN: ${{ github.token }}\n    86\t          OWNER: ${{ inputs.owner }}\n    87\t          REASON: ${{ inputs.reason }}\n    88\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    89\t        run: |\n    90\t          gh issue create \\\n    91\t            --title \"Follow-up review: emergency deploy ${GITHUB_SHA::8}\" \\\n    92\t            --label emergency-change,needs-review \\\n    93\t            --assignee \"$OWNER\" \\\n    94\t            --body \"Owner: $OWNER\n    95\t          Reason: $REASON\n    96\t          Ends: $EXPIRES_ON\n    97\t          Commit: $GITHUB_SHA\n    98\t          Approved in environment production-emergency by a required reviewer (see run $GITHUB_RUN_ID).\n    99\t          Review and merge to main via normal PR before the end date.\"\n     1\timport { readFileSync } from \"node:fs\";\n     2\timport { join } from \"node:path\";\n     3\timport { parse } from \"yaml\";\n     4\t\n     5\texport const ROOT = process.env.CLINIC_AGENT_ROOT ?? process.cwd();\n     6\t\n     7\texport interface Policy {\n     8\t  version: string;\n     9\t  highImpactTools: string[];\n    10\t  approval: { ttlSeconds: number; approverRoles: string[]; table: string };\n    11\t}\n    12\t\n    13\texport interface AllowlistEntry {\n    14\t  tool: string;\n    15\t  reason: string;\n    16\t}\n    17\t\n    18\texport interface Budgets {\n    19\t  run: {\n    20\t    maxTurns: number;\n    21\t    maxWallMs: number;\n    22\t    maxInputTokens: number;\n    23\t    maxOutputTokens: number;\n    24\t    maxCostUsd: number;\n    25\t    maxToolCalls: number;\n    26\t    maxToolCallsPerMinute: number;\n    27\t    maxPeerCalls: number;\n    28\t  };\n    29\t  quotas: {\n    30\t    perSubjectDailyUsd: number;\n    31\t    perTenantDailyUsd: number;\n    32\t    fleetDailyUsd: number;\n    33\t    perTenantToolCallsPerMinute: number;\n    34\t    fleetToolCallsPerMinute: number;\n    35\t  };\n    36\t  pricingUsdPerMTok: Record<string, { input: number; output: number; cacheRead: number; cacheWrite: number }>;\n    37\t  onExceed: \"handoff_to_staff\";\n    38\t}\n    39\t\n    40\tfunction loadYaml<T>(rel: string): T {\n    41\t  return parse(readFileSync(join(ROOT, rel), \"utf8\")) as T;\n    42\t}\n    43\t\n    44\texport const policy = loadYaml<Policy>(\"config/policy.yaml\");\n    45\texport const allowlist = loadYaml<{ role: string; tools: AllowlistEntry[] }>(\"config/tools.allowlist.yaml\");\n    46\texport const budgets = loadYaml<Budgets>(\"config/budgets.yaml\");\n    47\texport const manifest = JSON.parse(readFileSync(join(ROOT, \"release/manifest.json\"), \"utf8\"));\n    48\t\n    49\texport const AGENT_MODEL = \"claude-sonnet-4-5-20250929\";\n    50\texport const CLASSIFIER_MODEL = \"claude-haiku-4-5-20251001\";\n    51\t\n    52\texport const env = {\n    53\t  region: process.env.AWS_REGION ?? \"us-west-2\",\n    54\t  controlTable: process.env.CONTROL_TABLE ?? \"clinic-agent-control\",\n    55\t  budgetTable: process.env.BUDGET_TABLE ?? \"clinic-agent-budgets\",\n    56\t  auditStream: process.env.AUDIT_STREAM ?? \"clinic-agent-audit\",\n    57\t  smsSigningSecretArn: process.env.SMS_SIGNING_SECRET_ARN ?? \"\",\n    58\t  chatJwksUrl: process.env.CHAT_JWKS_URL ?? \"https://auth.northbay-clinics.example/.well-known/jwks.json\",\n    59\t  chatIssuer: process.env.CHAT_ISSUER ?? \"https://auth.northbay-clinics.example/\",\n    60\t  eligibilityUrl: process.env.ELIGIBILITY_URL ?? \"https://eligibility.partners.northbay-clinics.example/a2a\",\n    61\t  eligibilityIssuer: process.env.ELIGIBILITY_ISSUER ?? \"https://eligibility.partners.northbay-clinics.example\",\n    62\t  tokenExchangeUrl: process.env.TOKEN_EXCHANGE_URL ?? \"https://sts.northbay-clinics.example/oauth2/token\",\n    63\t  accountableParty: \"northbay-clinic-group:patient-access\",\n    64\t  operationalOwner: \"team:agent-platform\",\n    65\t};\n     1\timport Fastify from \"fastify\";\n     2\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     3\timport { env, manifest } from \"./config.js\";\n     4\timport { computeAgentTypeId, setAgentTypeId, AGENT_INSTANCE_ID } from \"./agent/identity.js\";\n     5\timport { killSwitch } from \"./control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"./integrations/ehr-mcp.js\";\n     7\timport { registerSmsWebhook } from \"./routes/sms-webhook.js\";\n     8\timport { registerWebchat } from \"./routes/webchat.js\";\n     9\timport { nativeTools } from \"./tools/executor.js\";\n    10\timport { ToolRegistry, type ConfiguredServer } from \"./tools/registry.js\";\n    11\t\n    12\tconst metrics = {\n    13\t  increment(name: string) {\n    14\t    process.stdout.write(JSON.stringify({ _aws: { CloudWatchMetrics: [{ Namespace: \"clinic-agent\", Metrics: [{ Name: name }] }] }, [name]: 1 }) + \"\\n\");\n    15\t  },\n    16\t};\n    17\t\n    18\tconst app = Fastify({\n    19\t  logger: {\n    20\t    level: process.env.LOG_LEVEL ?? \"info\",\n    21\t    redact: { paths: [\"req.headers.authorization\", 'req.headers[\"x-sms-signature\"]', \"req.headers.cookie\"], censor: \"[redacted]\" },\n    22\t  },\n    23\t  bodyLimit: 16_384,\n    24\t});\n    25\t\n    26\t// Identity check against the approved release manifest.\n    27\tconst typeId = computeAgentTypeId({\n    28\t  imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    29\t  harnessVersion: manifest.harness.version,\n    30\t  harnessGitSha: process.env.GIT_SHA ?? \"\",\n    31\t});\n    32\tif (typeId !== manifest.agentTypeId) {\n    33\t  app.log.error({ expected: manifest.agentTypeId, actual: typeId }, \"agent type id does not match release manifest\");\n    34\t  metrics.increment(\"identity.mismatch\");\n    35\t}\n    36\tsetAgentTypeId(typeId);\n    37\tapp.log.info({ agentTypeId: typeId, agentInstanceId: AGENT_INSTANCE_ID, release: manifest.release }, \"starting\");\n    38\t\n    39\t// Tools.\n    40\tconst servers: ConfiguredServer[] = manifest.tools.mcpServers;\n    41\tconst ehrServer = servers.find((s) => s.id === \"ehr\");\n    42\tif (!ehrServer) throw new Error(\"release manifest has no ehr server\");\n    43\tconst ehr = ehrClient(ehrServer);\n    44\t\n    45\tconst registry = new ToolRegistry(servers);\n    46\tfor (const [serverId, tools] of Object.entries(nativeTools(ehr))) registry.registerNative(serverId, tools);\n    47\ttry {\n    48\t  const { reportedName, meta } = await ehr.catalog();\n    49\t  registry.registerMcp(\"ehr\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\n    50\t} catch (err) {\n    51\t  app.log.error({ err }, \"EHR MCP catalog unavailable; EHR tools disabled\");\n    52\t}\n    53\tfor (const r of registry.rejected) app.log.warn(r, \"tool rejected at load\");\n    54\tfor (const c of registry.conflicts) app.log.warn(c, \"tool name conflict\");\n    55\t\n    56\t// Clinics.\n    57\tconst directory: Array<{ id: string; name: string; smsNumber: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    58\tconst byId = new Map(directory.map((c) => [c.id, c]));\n    59\tconst byNumber = new Map(directory.map((c) => [c.smsNumber, c]));\n    60\t\n    61\tconst sm = new SecretsManagerClient({ region: env.region });\n    62\tlet signingSecret: { value: string; at: number } | undefined;\n    63\tasync function smsSigningSecret(): Promise<string> {\n    64\t  if (signingSecret && Date.now() - signingSecret.at < 5 * 60_000) return signingSecret.value;\n    65\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: env.smsSigningSecretArn }));\n    66\t  signingSecret = { value: s.SecretString ?? \"\", at: Date.now() };\n    67\t  return signingSecret.value;\n    68\t}\n    69\t\n    70\tapp.addContentTypeParser(\"application/json\", { parseAs: \"string\" }, (req, body, done) => {\n    71\t  (req as { rawBody?: string }).rawBody = body as string;\n    72\t  try {\n    73\t    done(null, JSON.parse(body as string));\n    74\t  } catch (err) {\n    75\t    done(err as Error, undefined);\n    76\t  }\n    77\t});\n    78\t\n    79\tregisterSmsWebhook(app, {\n    80\t  registry,\n    81\t  signingSecret: smsSigningSecret,\n    82\t  clinicByNumber: (to) => byNumber.get(to),\n    83\t  metrics,\n    84\t});\n    85\tregisterWebchat(app, { registry, clinicById: (id) => byId.get(id) });\n    86\t\n    87\tapp.get(\"/healthz\", async () => ({ ok: true }));\n    88\t\n    89\tkillSwitch.startWatcher();\n    90\tawait app.listen({ host: \"0.0.0.0\", port: 8080 });\n     1\t# Hard limits enforced by src/agent/budget.ts, outside the model.\n     2\trun:\n     3\t  maxTurns: 8                 # model calls per run\n     4\t  maxWallMs: 45000            # whole run, including tool calls\n     5\t  maxInputTokens: 120000      # summed across model calls in the run\n     6\t  maxOutputTokens: 6000\n     7\t  maxCostUsd: 0.40\n     8\t  maxToolCalls: 16\n     9\t  maxToolCallsPerMinute: 12\n    10\t  maxPeerCalls: 2             # calls to the eligibility agent; this agent starts no sub-agents\n    11\t\n    12\tquotas:\n    13\t  # Daily spend and per-minute tool-call ceilings across many runs.\n    14\t  perSubjectDailyUsd: 2.00    # one patient or staff user\n    15\t  perTenantDailyUsd: 60.00    # one clinic\n    16\t  fleetDailyUsd: 900.00       # all clinics\n    17\t  perTenantToolCallsPerMinute: 240\n    18\t  fleetToolCallsPerMinute: 2400\n    19\t\n    20\tpricingUsdPerMTok:\n    21\t  claude-sonnet-4-5-20250929: { input: 3.00, output: 15.00, cacheRead: 0.30, cacheWrite: 3.75 }\n    22\t  claude-haiku-4-5-20251001: { input: 1.00, output: 5.00, cacheRead: 0.10, cacheWrite: 1.25 }\n    23\t\n    24\t# When a limit is hit the run stops, the stop is audited with the limit name, and the\n    25\t# conversation is handed to the clinic's front-desk queue.\n    26\tonExceed: handoff_to_staff\n     1\t# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\n     2\tpolicyVersion: \"2026-09-18.3\"\n     3\t\n     4\t# Tools that never run without a staff approval bound to the request.\n     5\thighImpactTools:\n     6\t  - ehr__cancel_appointment\n     7\t  - payments__refund_deposit\n     8\t  - sms__send_freeform\n     9\t\n    10\tapproval:\n    11\t  ttlSeconds: 900\n    12\t  approverRoles:\n    13\t    - front_desk_lead\n    14\t    - clinic_manager\n    15\t  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n    16\t  table: clinic-agent-approvals\n     1\t# Every tool the scheduling agent may call, with the task it serves.\n     2\t# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n     3\t# are not used for allow or approval decisions.\n     4\trole: scheduling_agent\n     5\ttools:\n     6\t  - tool: ehr__find_patient\n     7\t    reason: Match the sender to a patient record by date of birth and phone or email.\n     8\t  - tool: ehr__search_slots\n     9\t    reason: List open slots for a provider, location, and visit type.\n    10\t  - tool: ehr__get_appointment\n    11\t    reason: Read one appointment the patient asks about.\n    12\t  - tool: ehr__list_patient_appointments\n    13\t    reason: Show the patient their upcoming appointments.\n    14\t  - tool: ehr__book_appointment\n    15\t    reason: Book a slot the patient chose.\n    16\t  - tool: ehr__update_appointment\n    17\t    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n    18\t  - tool: ehr__cancel_appointment\n    19\t    reason: Cancel an appointment at the patient's request.\n    20\t  - tool: payments__refund_deposit\n    21\t    reason: Refund a no-show deposit after staff review.\n    22\t  - tool: sms__send_to_patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01GAdjATJDq7DJbkVvxDtKYM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
