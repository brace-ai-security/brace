{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XayypRXiGt7N5pjBt5GTFx","type":"tool_result","content":"=== src/audit/recorder.ts\n     1\timport { FirehoseClient, PutRecordCommand } from \"@aws-sdk/client-firehose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Every audit record carries the six identity fields. Values come from RunContext, which is built\n     7\t// by the HTTP layer and the worker, never from model output.\n     8\texport const IdentityFields = z.object({\n     9\t  accountableParty: z.string().min(1),\n    10\t  operationalOwner: z.string().min(1),\n    11\t  tenantId: z.string().min(1),\n    12\t  agentTypeId: z.string().startsWith(\"sha256:\"),\n    13\t  agentInstanceId: z.string().uuid(),\n    14\t  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),\n    15\t});\n    16\t\n    17\texport const AuditEvent = IdentityFields.extend({\n    18\t  eventId: z.string().uuid(),\n    19\t  ts: z.string().datetime(),\n    20\t  runId: z.string().uuid(),\n    21\t  event: z.enum([\n    22\t    \"run.started\",\n    23\t    \"run.stopped\",\n    24\t    \"run.completed\",\n    25\t    \"intent.classified\",\n    26\t    \"model.decision\",\n    27\t    \"tool.denied\",\n    28\t    \"tool.approval_requested\",\n    29\t    \"tool.executed\",\n    30\t    \"tool.failed\",\n    31\t    \"payment.refund\",\n    32\t    \"peer.call\",\n    33\t    \"reminder.sent\",\n    34\t  ]),\n    35\t  subject: z.object({ kind: z.enum([\"patient\", \"staff\", \"system\"]), id: z.string() }),\n    36\t  tool: z.string().optional(),\n    37\t  toolUseId: z.string().optional(),\n    38\t  policyVersion: z.string().optional(),\n    39\t  approvalId: z.string().optional(),\n    40\t  reason: z.string().optional(),\n    41\t  context: z\n    42\t    .object({\n    43\t      tokens: z.number().int().nonnegative().nullable(),\n    44\t      status: z.enum([\"measured\", \"estimated\", \"unavailable\"]),\n    45\t      method: z.string(),\n    46\t      cachedInputTokens: z.number().int().nonnegative().nullable(),\n    47\t      compacted: z.boolean(),\n    48\t    })\n    49\t    .optional(),\n    50\t  detail: z.record(z.unknown()).optional(),\n    51\t});\n    52\texport type AuditEvent = z.infer<typeof AuditEvent>;\n    53\t\n    54\tconst firehose = new FirehoseClient({ region: env.region });\n    55\t\n    56\texport class AuditUnavailable extends Error {}\n    57\t\n    58\texport const audit = {\n    59\t  async record(e: Omit<AuditEvent, \"eventId\" | \"ts\">): Promise<void> {\n    60\t    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });\n    61\t    try {\n    62\t      await firehose.send(\n    63\t        new PutRecordCommand({\n    64\t          DeliveryStreamName: env.auditStream,\n    65\t          Record: { Data: Buffer.from(JSON.stringify(full) + \"\\n\") },\n    66\t        }),\n    67\t      );\n    68\t    } catch (err) {\n    69\t      // Callers treat this as a hard failure: an action that cannot be audited does not run.\n    70\t      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);\n    71\t    }\n    72\t  },\n    73\t};\n    74\t\n    75\t// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.\n    76\tconst DROP_KEYS = new Set([\"ssn\", \"dateOfBirth\", \"dob\", \"memberId\", \"subscriberId\", \"cardNumber\", \"cardLast4\", \"address\"]);\n    77\tconst PATTERNS: Array<[RegExp, string]> = [\n    78\t  [/\\b\\d{3}-\\d{2}-\\d{4}\\b/g, \"[ssn]\"],\n    79\t  [/\\b(?:\\d[ -]?){13,19}\\b/g, \"[card]\"],\n    80\t  [/\\b[A-Z]{3}\\d{9}\\b/g, \"[member-id]\"],\n    81\t];\n    82\t\n    83\texport function redactPhi(value: unknown): unknown {\n    84\t  if (typeof value === \"string\") {\n    85\t    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);\n    86\t  }\n    87\t  if (Array.isArray(value)) return value.map(redactPhi);\n    88\t  if (value && typeof value === \"object\") {\n    89\t    const out: Record<string, unknown> = {};\n    90\t    for (const [k, v] of Object.entries(value)) {\n    91\t      if (DROP_KEYS.has(k)) continue;\n    92\t      out[k] = redactPhi(v);\n    93\t    }\n    94\t    return out;\n    95\t  }\n    96\t  return value;\n    97\t}\n=== src/agent/identity.ts\n     1\timport { createHash, randomUUID } from \"node:crypto\";\n     2\timport { readdirSync, readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n     5\t\n     6\t// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n     7\t// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\n     8\tconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n     9\t\n    10\texport interface TypeIdInputs {\n    11\t  imageDigest: string;\n    12\t  harnessVersion: string;\n    13\t  harnessGitSha: string;\n    14\t}\n    15\t\n    16\texport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n    17\t  const parts: Array<[string, Buffer]> = [\n    18\t    [\"image\", Buffer.from(inputs.imageDigest)],\n    19\t    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    20\t    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n    21\t  ];\n    22\t  const promptDir = join(ROOT, \"prompts\");\n    23\t  const promptFiles = readdirSync(promptDir)\n    24\t    .filter((f) => f.endsWith(\".txt\"))\n    25\t    .sort();\n    26\t  for (const f of promptFiles) {\n    27\t    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n    28\t  }\n    29\t  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n    30\t  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n    31\t  for (const f of CONFIG_FILES) {\n    32\t    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n    33\t  }\n    34\t  return parts;\n    35\t}\n    36\t\n    37\texport function computeAgentTypeId(inputs: TypeIdInputs): string {\n    38\t  const h = createHash(\"sha256\");\n    39\t  for (const [label, bytes] of typeIdManifest(inputs)) {\n    40\t    h.update(label);\n    41\t    h.update(\"\\0\");\n    42\t    h.update(bytes);\n    43\t    h.update(\"\\0\");\n    44\t  }\n    45\t  return `sha256:${h.digest(\"hex\")}`;\n    46\t}\n    47\t\n    48\t// One instance id per process. Pods are the unit an operator contains.\n    49\texport const AGENT_INSTANCE_ID = randomUUID();\n    50\t\n    51\tlet AGENT_TYPE_ID = \"\";\n    52\texport function setAgentTypeId(id: string): void {\n    53\t  AGENT_TYPE_ID = id;\n    54\t}\n    55\t\n    56\texport interface Subject {\n    57\t  kind: \"patient\" | \"staff\" | \"system\";\n    58\t  id: string;\n    59\t}\n    60\t\n    61\texport interface Logger {\n    62\t  info(obj: object, msg?: string): void;\n    63\t  warn(obj: object, msg?: string): void;\n    64\t  error(obj: object, msg?: string): void;\n    65\t}\n    66\t\n    67\texport interface RunContext {\n    68\t  runId: string;\n    69\t  tenantId: string;\n    70\t  subject: Subject;\n    71\t  channel: \"sms\" | \"webchat\" | \"reminder\";\n    72\t  traceparent: string;\n    73\t  log: Logger;\n    74\t  identity(): {\n    75\t    accountableParty: string;\n    76\t    operationalOwner: string;\n    77\t    tenantId: string;\n    78\t    agentTypeId: string;\n    79\t    agentInstanceId: string;\n    80\t    traceparent: string;\n    81\t  };\n    82\t  workloadToken(): Promise<string>;\n    83\t}\n    84\t\n    85\t// Projected service-account token (audience: the group STS), rotated by the kubelet.\n    86\tconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n    87\t\n    88\texport function newRunContext(init: {\n    89\t  tenantId: string;\n    90\t  subject: Subject;\n    91\t  channel: RunContext[\"channel\"];\n    92\t  traceparent?: string;\n    93\t  log: Logger;\n    94\t}): RunContext {\n    95\t  const runId = randomUUID();\n    96\t  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n    97\t  return {\n    98\t    runId,\n    99\t    tenantId: init.tenantId,\n   100\t    subject: init.subject,\n   101\t    channel: init.channel,\n   102\t    traceparent,\n   103\t    log: init.log,\n   104\t    identity: () => ({\n   105\t      accountableParty: env.accountableParty,\n   106\t      operationalOwner: env.operationalOwner,\n   107\t      tenantId: init.tenantId,\n   108\t      agentTypeId: AGENT_TYPE_ID,\n   109\t      agentInstanceId: AGENT_INSTANCE_ID,\n   110\t      traceparent,\n   111\t    }),\n   112\t    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n   113\t  };\n   114\t}\n=== src/agent/context-size.ts\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\t\n     3\t// Context size at decision time, in tokens.\n     4\t//\n     5\t// Counting method. Each model decision is one Messages API call. Its response usage reports the\n     6\t// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and\n     7\t// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,\n     8\t// including the part served from the prompt cache and the provider's own tool-use preamble, which\n     9\t// the provider counts but does not show. This is a per-call value, not a run or billing total.\n    10\t// We record it as \"measured\", with the cached share kept separately.\n    11\t//\n    12\t// If the response carries no usage (stream cut off, aborted call), we fall back to the\n    13\t// count_tokens estimate taken just before the call for the same request, and mark it \"estimated\".\n    14\t// If neither exists the value is null with status \"unavailable\". It is never reported as 0.\n    15\t//\n    16\t// This harness never compacts, summarizes, or truncates history inside a run, so compacted is\n    17\t// always false; a run that would outgrow its token budget stops instead (see budget.ts).\n    18\texport interface ContextSize {\n    19\t  tokens: number | null;\n    20\t  status: \"measured\" | \"estimated\" | \"unavailable\";\n    21\t  method: string;\n    22\t  cachedInputTokens: number | null;\n    23\t  compacted: boolean;\n    24\t}\n    25\t\n    26\texport const USAGE_METHOD = \"anthropic.messages.usage(input+cache_read+cache_creation)\";\n    27\texport const COUNT_METHOD = \"anthropic.messages.count_tokens(pre-call estimate)\";\n    28\t\n    29\texport async function measureBeforeCall(\n    30\t  client: Anthropic,\n    31\t  req: Anthropic.MessageCountTokensParams,\n    32\t  signal: AbortSignal,\n    33\t): Promise<ContextSize> {\n    34\t  try {\n    35\t    const r = await client.messages.countTokens(req, { signal });\n    36\t    return { tokens: r.input_tokens, status: \"estimated\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    37\t  } catch {\n    38\t    return { tokens: null, status: \"unavailable\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    39\t  }\n    40\t}\n    41\t\n    42\texport function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {\n    43\t  if (!usage) return pre;\n    44\t  const cacheRead = usage.cache_read_input_tokens ?? 0;\n    45\t  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);\n    46\t  return { tokens: total, status: \"measured\", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };\n    47\t}\n    48\t\n    49\t// Span attributes so the value is searchable next to the action in traces as well as audit.\n    50\texport function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {\n    51\t  return {\n    52\t    ...(c.tokens === null ? {} : { \"clinic_agent.context.tokens\": c.tokens }),\n    53\t    \"clinic_agent.context.status\": c.status,\n    54\t    \"clinic_agent.context.method\": c.method,\n    55\t    \"gen_ai.conversation.compacted\": c.compacted,\n    56\t  };\n    57\t}\n=== config/tools.allowlist.yaml\n     1\t# Every tool the scheduling agent may call, with the task it serves.\n     2\t# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n     3\t# are not used for allow or approval decisions.\n     4\trole: scheduling_agent\n     5\ttools:\n     6\t  - tool: ehr__find_patient\n     7\t    reason: Match the sender to a patient record by date of birth and phone or email.\n     8\t  - tool: ehr__search_slots\n     9\t    reason: List open slots for a provider, location, and visit type.\n    10\t  - tool: ehr__get_appointment\n    11\t    reason: Read one appointment the patient asks about.\n    12\t  - tool: ehr__list_patient_appointments\n    13\t    reason: Show the patient their upcoming appointments.\n    14\t  - tool: ehr__book_appointment\n    15\t    reason: Book a slot the patient chose.\n    16\t  - tool: ehr__update_appointment\n    17\t    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n    18\t  - tool: ehr__cancel_appointment\n    19\t    reason: Cancel an appointment at the patient's request.\n    20\t  - tool: payments__refund_deposit\n    21\t    reason: Refund a no-show deposit after staff review.\n    22\t  - tool: sms__send_to_patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.\nmanifest.json","is_error":false}]},"parent_tool_use_id":null,"session_id":"1c47466d-bfd6-40de-bbcb-cacca7df0826","uuid":"4fd8ee7b-001c-4902-8796-d9bb727311f5","timestamp":"2026-10-20T15:47:53.438Z","tool_use_result":{"stdout":"=== src/audit/recorder.ts\n     1\timport { FirehoseClient, PutRecordCommand } from \"@aws-sdk/client-firehose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Every audit record carries the six identity fields. Values come from RunContext, which is built\n     7\t// by the HTTP layer and the worker, never from model output.\n     8\texport const IdentityFields = z.object({\n     9\t  accountableParty: z.string().min(1),\n    10\t  operationalOwner: z.string().min(1),\n    11\t  tenantId: z.string().min(1),\n    12\t  agentTypeId: z.string().startsWith(\"sha256:\"),\n    13\t  agentInstanceId: z.string().uuid(),\n    14\t  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),\n    15\t});\n    16\t\n    17\texport const AuditEvent = IdentityFields.extend({\n    18\t  eventId: z.string().uuid(),\n    19\t  ts: z.string().datetime(),\n    20\t  runId: z.string().uuid(),\n    21\t  event: z.enum([\n    22\t    \"run.started\",\n    23\t    \"run.stopped\",\n    24\t    \"run.completed\",\n    25\t    \"intent.classified\",\n    26\t    \"model.decision\",\n    27\t    \"tool.denied\",\n    28\t    \"tool.approval_requested\",\n    29\t    \"tool.executed\",\n    30\t    \"tool.failed\",\n    31\t    \"payment.refund\",\n    32\t    \"peer.call\",\n    33\t    \"reminder.sent\",\n    34\t  ]),\n    35\t  subject: z.object({ kind: z.enum([\"patient\", \"staff\", \"system\"]), id: z.string() }),\n    36\t  tool: z.string().optional(),\n    37\t  toolUseId: z.string().optional(),\n    38\t  policyVersion: z.string().optional(),\n    39\t  approvalId: z.string().optional(),\n    40\t  reason: z.string().optional(),\n    41\t  context: z\n    42\t    .object({\n    43\t      tokens: z.number().int().nonnegative().nullable(),\n    44\t      status: z.enum([\"measured\", \"estimated\", \"unavailable\"]),\n    45\t      method: z.string(),\n    46\t      cachedInputTokens: z.number().int().nonnegative().nullable(),\n    47\t      compacted: z.boolean(),\n    48\t    })\n    49\t    .optional(),\n    50\t  detail: z.record(z.unknown()).optional(),\n    51\t});\n    52\texport type AuditEvent = z.infer<typeof AuditEvent>;\n    53\t\n    54\tconst firehose = new FirehoseClient({ region: env.region });\n    55\t\n    56\texport class AuditUnavailable extends Error {}\n    57\t\n    58\texport const audit = {\n    59\t  async record(e: Omit<AuditEvent, \"eventId\" | \"ts\">): Promise<void> {\n    60\t    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });\n    61\t    try {\n    62\t      await firehose.send(\n    63\t        new PutRecordCommand({\n    64\t          DeliveryStreamName: env.auditStream,\n    65\t          Record: { Data: Buffer.from(JSON.stringify(full) + \"\\n\") },\n    66\t        }),\n    67\t      );\n    68\t    } catch (err) {\n    69\t      // Callers treat this as a hard failure: an action that cannot be audited does not run.\n    70\t      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);\n    71\t    }\n    72\t  },\n    73\t};\n    74\t\n    75\t// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.\n    76\tconst DROP_KEYS = new Set([\"ssn\", \"dateOfBirth\", \"dob\", \"memberId\", \"subscriberId\", \"cardNumber\", \"cardLast4\", \"address\"]);\n    77\tconst PATTERNS: Array<[RegExp, string]> = [\n    78\t  [/\\b\\d{3}-\\d{2}-\\d{4}\\b/g, \"[ssn]\"],\n    79\t  [/\\b(?:\\d[ -]?){13,19}\\b/g, \"[card]\"],\n    80\t  [/\\b[A-Z]{3}\\d{9}\\b/g, \"[member-id]\"],\n    81\t];\n    82\t\n    83\texport function redactPhi(value: unknown): unknown {\n    84\t  if (typeof value === \"string\") {\n    85\t    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);\n    86\t  }\n    87\t  if (Array.isArray(value)) return value.map(redactPhi);\n    88\t  if (value && typeof value === \"object\") {\n    89\t    const out: Record<string, unknown> = {};\n    90\t    for (const [k, v] of Object.entries(value)) {\n    91\t      if (DROP_KEYS.has(k)) continue;\n    92\t      out[k] = redactPhi(v);\n    93\t    }\n    94\t    return out;\n    95\t  }\n    96\t  return value;\n    97\t}\n=== src/agent/identity.ts\n     1\timport { createHash, randomUUID } from \"node:crypto\";\n     2\timport { readdirSync, readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n     5\t\n     6\t// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n     7\t// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\n     8\tconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n     9\t\n    10\texport interface TypeIdInputs {\n    11\t  imageDigest: string;\n    12\t  harnessVersion: string;\n    13\t  harnessGitSha: string;\n    14\t}\n    15\t\n    16\texport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n    17\t  const parts: Array<[string, Buffer]> = [\n    18\t    [\"image\", Buffer.from(inputs.imageDigest)],\n    19\t    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    20\t    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n    21\t  ];\n    22\t  const promptDir = join(ROOT, \"prompts\");\n    23\t  const promptFiles = readdirSync(promptDir)\n    24\t    .filter((f) => f.endsWith(\".txt\"))\n    25\t    .sort();\n    26\t  for (const f of promptFiles) {\n    27\t    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n    28\t  }\n    29\t  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n    30\t  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n    31\t  for (const f of CONFIG_FILES) {\n    32\t    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n    33\t  }\n    34\t  return parts;\n    35\t}\n    36\t\n    37\texport function computeAgentTypeId(inputs: TypeIdInputs): string {\n    38\t  const h = createHash(\"sha256\");\n    39\t  for (const [label, bytes] of typeIdManifest(inputs)) {\n    40\t    h.update(label);\n    41\t    h.update(\"\\0\");\n    42\t    h.update(bytes);\n    43\t    h.update(\"\\0\");\n    44\t  }\n    45\t  return `sha256:${h.digest(\"hex\")}`;\n    46\t}\n    47\t\n    48\t// One instance id per process. Pods are the unit an operator contains.\n    49\texport const AGENT_INSTANCE_ID = randomUUID();\n    50\t\n    51\tlet AGENT_TYPE_ID = \"\";\n    52\texport function setAgentTypeId(id: string): void {\n    53\t  AGENT_TYPE_ID = id;\n    54\t}\n    55\t\n    56\texport interface Subject {\n    57\t  kind: \"patient\" | \"staff\" | \"system\";\n    58\t  id: string;\n    59\t}\n    60\t\n    61\texport interface Logger {\n    62\t  info(obj: object, msg?: string): void;\n    63\t  warn(obj: object, msg?: string): void;\n    64\t  error(obj: object, msg?: string): void;\n    65\t}\n    66\t\n    67\texport interface RunContext {\n    68\t  runId: string;\n    69\t  tenantId: string;\n    70\t  subject: Subject;\n    71\t  channel: \"sms\" | \"webchat\" | \"reminder\";\n    72\t  traceparent: string;\n    73\t  log: Logger;\n    74\t  identity(): {\n    75\t    accountableParty: string;\n    76\t    operationalOwner: string;\n    77\t    tenantId: string;\n    78\t    agentTypeId: string;\n    79\t    agentInstanceId: string;\n    80\t    traceparent: string;\n    81\t  };\n    82\t  workloadToken(): Promise<string>;\n    83\t}\n    84\t\n    85\t// Projected service-account token (audience: the group STS), rotated by the kubelet.\n    86\tconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n    87\t\n    88\texport function newRunContext(init: {\n    89\t  tenantId: string;\n    90\t  subject: Subject;\n    91\t  channel: RunContext[\"channel\"];\n    92\t  traceparent?: string;\n    93\t  log: Logger;\n    94\t}): RunContext {\n    95\t  const runId = randomUUID();\n    96\t  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n    97\t  return {\n    98\t    runId,\n    99\t    tenantId: init.tenantId,\n   100\t    subject: init.subject,\n   101\t    channel: init.channel,\n   102\t    traceparent,\n   103\t    log: init.log,\n   104\t    identity: () => ({\n   105\t      accountableParty: env.accountableParty,\n   106\t      operationalOwner: env.operationalOwner,\n   107\t      tenantId: init.tenantId,\n   108\t      agentTypeId: AGENT_TYPE_ID,\n   109\t      agentInstanceId: AGENT_INSTANCE_ID,\n   110\t      traceparent,\n   111\t    }),\n   112\t    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n   113\t  };\n   114\t}\n=== src/agent/context-size.ts\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\t\n     3\t// Context size at decision time, in tokens.\n     4\t//\n     5\t// Counting method. Each model decision is one Messages API call. Its response usage reports the\n     6\t// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and\n     7\t// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,\n     8\t// including the part served from the prompt cache and the provider's own tool-use preamble, which\n     9\t// the provider counts but does not show. This is a per-call value, not a run or billing total.\n    10\t// We record it as \"measured\", with the cached share kept separately.\n    11\t//\n    12\t// If the response carries no usage (stream cut off, aborted call), we fall back to the\n    13\t// count_tokens estimate taken just before the call for the same request, and mark it \"estimated\".\n    14\t// If neither exists the value is null with status \"unavailable\". It is never reported as 0.\n    15\t//\n    16\t// This harness never compacts, summarizes, or truncates history inside a run, so compacted is\n    17\t// always false; a run that would outgrow its token budget stops instead (see budget.ts).\n    18\texport interface ContextSize {\n    19\t  tokens: number | null;\n    20\t  status: \"measured\" | \"estimated\" | \"unavailable\";\n    21\t  method: string;\n    22\t  cachedInputTokens: number | null;\n    23\t  compacted: boolean;\n    24\t}\n    25\t\n    26\texport const USAGE_METHOD = \"anthropic.messages.usage(input+cache_read+cache_creation)\";\n    27\texport const COUNT_METHOD = \"anthropic.messages.count_tokens(pre-call estimate)\";\n    28\t\n    29\texport async function measureBeforeCall(\n    30\t  client: Anthropic,\n    31\t  req: Anthropic.MessageCountTokensParams,\n    32\t  signal: AbortSignal,\n    33\t): Promise<ContextSize> {\n    34\t  try {\n    35\t    const r = await client.messages.countTokens(req, { signal });\n    36\t    return { tokens: r.input_tokens, status: \"estimated\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    37\t  } catch {\n    38\t    return { tokens: null, status: \"unavailable\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    39\t  }\n    40\t}\n    41\t\n    42\texport function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {\n    43\t  if (!usage) return pre;\n    44\t  const cacheRead = usage.cache_read_input_tokens ?? 0;\n    45\t  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);\n    46\t  return { tokens: total, status: \"measured\", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };\n    47\t}\n    48\t\n    49\t// Span attributes so the value is searchable next to the action in traces as well as audit.\n    50\texport function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {\n    51\t  return {\n    52\t    ...(c.tokens === null ? {} : { \"clinic_agent.context.tokens\": c.tokens }),\n    53\t    \"clinic_agent.context.status\": c.status,\n    54\t    \"clinic_agent.context.method\": c.method,\n    55\t    \"gen_ai.conversation.compacted\": c.compacted,\n    56\t  };\n    57\t}\n=== config/tools.allowlist.yaml\n     1\t# Every tool the scheduling agent may call, with the task it serves.\n     2\t# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n     3\t# are not used for allow or approval decisions.\n     4\trole: scheduling_agent\n     5\ttools:\n     6\t  - tool: ehr__find_patient\n     7\t    reason: Match the sender to a patient record by date of birth and phone or email.\n     8\t  - tool: ehr__search_slots\n     9\t    reason: List open slots for a provider, location, and visit type.\n    10\t  - tool: ehr__get_appointment\n    11\t    reason: Read one appointment the patient asks about.\n    12\t  - tool: ehr__list_patient_appointments\n    13\t    reason: Show the patient their upcoming appointments.\n    14\t  - tool: ehr__book_appointment\n    15\t    reason: Book a slot the patient chose.\n    16\t  - tool: ehr__update_appointment\n    17\t    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n    18\t  - tool: ehr__cancel_appointment\n    19\t    reason: Cancel an appointment at the patient's request.\n    20\t  - tool: payments__refund_deposit\n    21\t    reason: Refund a no-show deposit after staff review.\n    22\t  - tool: sms__send_to_patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.\nmanifest.json","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01XayypRXiGt7N5pjBt5GTFx","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
