3\t  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n    44\t  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n    45\t---\n    46\tapiVersion: apps/v1\n    47\tkind: Deployment\n    48\tmetadata:\n    49\t  name: clinic-agent\n    50\t  namespace: clinic-agent\n    51\t  labels: { app: clinic-agent }\n    52\tspec:\n    53\t  replicas: 3\n    54\t  selector:\n    55\t    matchLabels: { app: clinic-agent }\n    56\t  template:\n    57\t    metadata:\n    58\t      labels: { app: clinic-agent }\n    59\t    spec:\n    60\t      serviceAccountName: clinic-agent\n    61\t      automountServiceAccountToken: false\n    62\t      hostUsers: false\n    63\t      hostNetwork: false\n    64\t      hostPID: false\n    65\t      hostIPC: false\n    66\t      enableServiceLinks: false\n    67\t      securityContext:\n    68\t        runAsNonRoot: true\n    69\t        runAsUser: 65532\n    70\t        runAsGroup: 65532\n    71\t        fsGroup: 65532\n    72\t        seccompProfile:\n    73\t          type: RuntimeDefault\n    74\t      containers:\n    75\t        - name: agent\n    76\t          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    77\t          ports:\n    78\t            - containerPort: 8080\n    79\t          envFrom:\n    80\t            - configMapRef: { name: clinic-agent }\n    81\t          env:\n    82\t            - name: IMAGE_DIGEST\n    83\t              value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    84\t            - name: GIT_SHA\n    85\t              value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n    86\t          securityContext:\n    87\t            allowPrivilegeEscalation: false\n    88\t            privileged: false\n    89\t            readOnlyRootFilesystem: true\n    90\t            runAsNonRoot: true\n    91\t            capabilities:\n    92\t              drop: [\"ALL\"]\n    93\t            seccompProfile:\n    94\t              type: RuntimeDefault\n    95\t          resources:\n    96\t            requests: { cpu: 250m, memory: 384Mi }\n    97\t            limits: { cpu: \"1\", memory: 768Mi }\n    98\t          readinessProbe:\n    99\t            httpGet: { path: /healthz, port: 8080 }\n   100\t          volumeMounts:\n   101\t            - { name: tmp, mountPath: /tmp }\n   102\t            - { name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true }\n   103\t      volumes:\n   104\t        - name: tmp\n   105\t          emptyDir: { medium: Memory, sizeLimit: 32Mi }\n   106\t        - name: sts-token\n   107\t          projected:\n   108\t            sources:\n   109\t              - serviceAccountToken:\n   110\t                  audience: https://sts.northbay-clinics.example\n   111\t                  expirationSeconds: 900\n   112\t                  path: sts-token\n   113\t---\n   114\tapiVersion: batch/v1\n   115\tkind: CronJob\n   116\tmetadata:\n   117\t  name: clinic-agent-reminders\n   118\t  namespace: clinic-agent\n   119\tspec:\n   120\t  schedule: \"0 17 * * *\"\n   121\t  timeZone: America/Los_Angeles\n   122\t  concurrencyPolicy: Forbid\n   123\t  jobTemplate:\n   124\t    spec:\n   125\t      backoffLimit: 0\n   126\t      activeDeadlineSeconds: 1800\n   127\t      template:\n   128\t        metadata:\n   129\t          labels: { app: clinic-agent-reminders }\n   130\t        spec:\n   131\t          serviceAccountName: clinic-agent-reminders\n   132\t          automountServiceAccountToken: false\n   133\t          restartPolicy: Never\n   134\t          hostUsers: false\n   135\t          securityContext:\n   136\t            runAsNonRoot: true\n   137\t            runAsUser: 65532\n   138\t            runAsGroup: 65532\n   139\t            seccompProfile:\n   140\t              type: RuntimeDefault\n   141\t          containers:\n   142\t            - name: reminders\n   143\t              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   144\t              args: [\"dist/workers/reminders.js\"]\n   145\t              envFrom:\n   146\t                - configMapRef: { name: clinic-agent }\n   147\t              env:\n   148\t                - name: IMAGE_DIGEST\n   149\t                  value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   150\t                - name: GIT_SHA\n   151\t                  value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n   152\t              securityContext:\n   153\t                allowPrivilegeEscalation: false\n   154\t                privileged: false\n   155\t                readOnlyRootFilesystem: true\n   156\t                capabilities:\n   157\t                  drop: [\"ALL\"]\n   158\t---\n   159\t# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n   160\t# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,\n   161\t# the group STS and auth service, and AWS service endpoints.\n   162\tapiVersion: networking.k8s.io/v1\n   163\tkind: NetworkPolicy\n   164\tmetadata:\n   165\t  name: clinic-agent-egress\n   166\t  namespace: clinic-agent\n   167\tspec:\n   168\t  podSelector: {}\n   169\t  policyTypes: [\"Egress\", \"Ingress\"]\n   170\t  ingress:\n   171\t    - from:\n   172\t        - namespaceSelector:\n   173\t            matchLabels: { kubernetes.io/metadata.name: ingress }\n   174\t      ports:\n   175\t        - { port: 8080, protocol: TCP }\n   176\t  egress:\n   177\t    - to:\n   178\t        - namespaceSelector:\n   179\t            matchLabels: { kubernetes.io/metadata.name: kube-system }\n   180\t          podSelector:\n   181\t            matchLabels: { k8s-app: kube-dns }\n   182\t      ports:\n   183\t        - { port: 53, protocol: UDP }\n   184\t        - { port: 53, protocol: TCP }\n   185\t    - to:\n   186\t        - namespaceSelector:\n   187\t            matchLabels: { kubernetes.io/metadata.name: platform }\n   188\t          podSelector:\n   189\t            matchLabels: { app: egress-proxy }\n   190\t      ports:\n   191\t        - { port: 3128, protocol: TCP }\n   192\t    - to:\n   193\t        - ipBlock: { cidr: 10.60.12.0/28 }\n   194\t      ports:\n   195\t        - { port: 443, protocol: TCP }\n     1\tterraform {\n     2\t  required_version = \">= 1.9.0\"\n     3\t  required_providers {\n     4\t    aws    = { source = \"hashicorp/aws\", version = \"~> 6.14\" }\n     5\t    github = { source = \"integrations/github\", version = \"~> 6.6\" }\n     6\t  }\n     7\t  backend \"s3\" {\n     8\t    bucket         = \"northbay-tfstate-418295730611\"\n     9\t    key            = \"clinic-agent/prod.tfstate\"\n    10\t    region         = \"us-west-2\"\n    11\t    dynamodb_table = \"northbay-tf-locks\"\n    12\t    encrypt        = true\n    13\t  }\n    14\t}\n    15\t\n    16\tprovider \"aws\" {\n    17\t  region = var.region\n    18\t  default_tags {\n    19\t    tags = { app = \"clinic-agent\", owner = \"agent-platform\", data = \"phi\" }\n    20\t  }\n    21\t}\n    22\t\n    23\tvariable \"region\" {\n    24\t  type    = string\n    25\t  default = \"us-west-2\"\n    26\t}\n    27\t\n    28\tvariable \"clinic_ids\" {\n    29\t  type    = list(string)\n    30\t  default = [\"nb-castro\", \"nb-fremont\", \"nb-oakland\", \"nb-sanmateo\", \"nb-walnutcreek\"]\n    31\t}\n    32\t\n    33\tdata \"aws_caller_identity\" \"current\" {}\n    34\t\n    35\tmodule \"eks\" {\n    36\t  source  = \"terraform-aws-modules/eks/aws\"\n    37\t  version = \"21.3.1\"\n    38\t\n    39\t  name               = \"clinic-agent-prod\"\n    40\t  kubernetes_version = \"1.33\"\n    41\t  vpc_id             = module.vpc.vpc_id\n    42\t  subnet_ids         = module.vpc.private_subnets\n    43\t\n    44\t  endpoint_public_access = false\n    45\t  enable_irsa            = true\n    46\t\n    47\t  authentication_mode = \"API\"\n    48\t  access_entries = {\n    49\t    deploy = {\n    50\t      principal_arn = aws_iam_role.deploy.arn\n    51\t      policy_associations = {\n    52\t        ns = {\n    53\t          policy_arn   = \"arn:aws:eks::aws:cluster-access-policy/AmazonEKSEditPolicy\"\n    54\t          access_scope = { type = \"namespace\", namespaces = [\"clinic-agent\"] }\n    55\t        }\n    56\t      }\n    57\t    }\n    58\t  }\n    59\t\n    60\t  eks_managed_node_groups = {\n    61\t    agents = {\n    62\t      instance_types = [\"m7g.large\"]\n    63\t      ami_type       = \"BOTTLEROCKET_ARM_64\"\n    64\t      min_size       = 2\n    65\t      max_size       = 6\n    66\t      desired_size   = 3\n    67\t      metadata_options = {\n    68\t        http_tokens                 = \"required\"\n    69\t        http_put_response_hop_limit = 1\n    70\t      }\n    71\t    }\n    72\t  }\n    73\t}\n    74\t\n    75\tmodule \"vpc\" {\n    76\t  source  = \"terraform-aws-modules/vpc/aws\"\n    77\t  version = \"6.4.0\"\n    78\t\n    79\t  name            = \"clinic-agent-prod\"\n    80\t  cidr            = \"10.42.0.0/16\"\n    81\t  azs             = [\"us-west-2a\", \"us-west-2b\", \"us-west-2c\"]\n    82\t  private_subnets = [\"10.42.1.0/24\", \"10.42.2.0/24\", \"10.42.3.0/24\"]\n    83\t  public_subnets  = [\"10.42.101.0/24\", \"10.42.102.0/24\", \"10.42.103.0/24\"]\n    84\t\n    85\t  enable_nat_gateway = true\n    86\t  single_nat_gateway = false\n    87\t}\n    88\t\n    89\tresource \"aws_ecr_repository\" \"agent\" {\n    90\t  name                 = \"clinic-agent\"\n    91\t  image_tag_mutability = \"IMMUTABLE\"\n    92\t  image_scanning_configuration { scan_on_push = true }\n    93\t}\n    94\t\n    95\t# State tables. Approvals are written by the staff console; budgets by the agent; the control\n    96\t# table holds the stop flags operators set.\n    97\tresource \"aws_dynamodb_table\" \"approvals\" {\n    98\t  name         = \"clinic-agent-approvals\"\n    99\t  billing_mode = \"PAY_PER_REQUEST\"\n   100\t  hash_key     = \"id\"\n   101\t  attribute {\n   102\t    name = \"id\"\n   103\t    type = \"S\"\n   104\t  }\n   105\t  point_in_time_recovery { enabled = true }\n   106\t}\n   107\t\n   108\tresource \"aws_dynamodb_table\" \"budgets\" {\n   109\t  name         = \"clinic-agent-budgets\"\n   110\t  billing_mode = \"PAY_PER_REQUEST\"\n   111\t  hash_key     = \"pk\"\n   112\t  attribute {\n   113\t    name = \"pk\"\n   114\t    type = \"S\"\n   115\t  }\n   116\t  ttl {\n   117\t    attribute_name = \"expiresAt\"\n   118\t    enabled        = true\n   119\t  }\n   120\t}\n   121\t\n   122\tresource \"aws_dynamodb_table\" \"control\" {\n   123\t  name         = \"clinic-agent-control\"\n   124\t  billing_mode = \"PAY_PER_REQUEST\"\n   125\t  hash_key     = \"pk\"\n   126\t  attribute {\n   127\t    name = \"pk\"\n   128\t    type = \"S\"\n   129\t  }\n   130\t  point_in_time_recovery { enabled = true }\n   131\t}\n   132\t\n   133\t# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).\n   134\tresource \"aws_s3_bucket\" \"audit\" {\n   135\t  bucket              = \"clinic-agent-audit-${data.aws_caller_identity.current.account_id}\"\n   136\t  object_lock_enabled = true\n   137\t}\n   138\t\n   139\tresource \"aws_s3_bucket_object_lock_configuration\" \"audit\" {\n   140\t  bucket = aws_s3_bucket.audit.id\n   141\t  rule {\n   142\t    default_retention {\n   143\t      mode  = \"COMPLIANCE\"\n   144\t      years = 7\n   145\t    }\n   146\t  }\n   147\t}\n   148\t\n   149\tresource \"aws_kinesis_firehose_delivery_stream\" \"audit\" {\n   150\t  name        = \"clinic-agent-audit\"\n   151\t  destination = \"extended_s3\"\n   152\t  extended_s3_configuration {\n   153\t    role_arn            = aws_iam_role.firehose.arn\n   154\t    bucket_arn          = aws_s3_bucket.audit.arn\n   155\t    prefix              = \"audit/dt=!{timestamp:yyyy-MM-dd}/\"\n   156\t    error_output_prefix = \"audit-errors/!{firehose:error-output-type}/\"\n   157\t    buffering_interval  = 60\n   158\t  }\n   159\t}\n   160\t\n   161\tresource \"aws_secretsmanager_secret\" \"ehr\" {\n   162\t  for_each = toset(concat(var.clinic_ids, [\"_catalog\"]))\n   163\t  name     = \"clinic-agent/ehr/${each.key}\"\n   164\t}\n   165\t\n   166\tresource \"aws_secretsmanager_secret\" \"payments\" {\n   167\t  for_each = toset(var.clinic_ids)\n   168\t  name     = \"clinic-agent/payments/${each.key}\"\n   169\t}\n   170\t\n   171\tresource \"aws_secretsmanager_secret\" \"sms\" {\n   172\t  for_each = toset(var.clinic_ids)\n   173\t  name     = \"clinic-agent/sms/${each.key}\"\n   174\t}\n   175\t\n   176\tresource \"aws_secretsmanager_secret\" \"sms_signing\" {\n   177\t  name = \"clinic-agent/sms-signing\"\n   178\t}\n     1\timport { readFileSync } from \"node:fs\";\n     2\timport { join } from \"node:path\";\n     3\timport { parse } from \"yaml\";\n     4\t\n     5\texport const ROOT = process.env.CLINIC_AGENT_ROOT ?? process.cwd();\n     6\t\n     7\texport interface Policy {\n     8\t  version: string;\n     9\t  highImpactTools: string[];\n    10\t  approval: { ttlSeconds: number; approverRoles: string[]; table: string };\n    11\t}\n    12\t\n    13\texport interface AllowlistEntry {\n    14\t  tool: string;\n    15\t  reason: string;\n    16\t}\n    17\t\n    18\texport interface Budgets {\n    19\t  run: {\n    20\t    maxTurns: number;\n    21\t    maxWallMs: number;\n    22\t    maxInputTokens: number;\n    23\t    maxOutputTokens: number;\n    24\t    maxCostUsd: number;\n    25\t    maxToolCalls: number;\n    26\t    maxToolCallsPerMinute: number;\n    27\t    maxPeerCalls: number;\n    28\t  };\n    29\t  quotas: {\n    30\t    perSubjectDailyUsd: number;\n    31\t    perTenantDailyUsd: number;\n    32\t    fleetDailyUsd: number;\n    33\t    perTenantToolCallsPerMinute: number;\n    34\t    fleetToolCallsPerMinute: number;\n    35\t  };\n    36\t  pricingUsdPerMTok: Record<string, { input: number; output: number; cacheRead: number; cacheWrite: number }>;\n    37\t  onExceed: \"handoff_to_staff\";\n    38\t}\n    39\t\n    40\tfunction loadYaml<T>(rel: string): T {\n    41\t  return parse(readFileSync(join(ROOT, rel), \"utf8\")) as T;\n    42\t}\n    43\t\n    44\texport const policy = loadYaml<Policy>(\"config/policy.yaml\");\n    45\texport const allowlist = loadYaml<{ role: string; tools: AllowlistEntry[] }>(\"config/tools.allowlist.yaml\");\n    46\texport const budgets = loadYaml<Budgets>(\"config/budgets.yaml\");\n    47\texport const manifest = JSON.parse(readFileSync(join(ROOT, \"release/manifest.json\"), \"utf8\"));\n    48\t\n    49\texport const AGENT_MODEL = \"claude-sonnet-4-5-20250929\";\n    50\texport const CLASSIFIER_MODEL = \"claude-haiku-4-5-20251001\";\n    51\t\n    52\texport const env = {\n    53\t  region: process.env.AWS_REGION ?? \"us-west-2\",\n    54\t  controlTable: process.env.CONTROL_TABLE ?? \"clinic-agent-control\",\n    55\t  budgetTable: process.env.BUDGET_TABLE ?? \"clinic-agent-budgets\",\n    56\t  auditStream: process.env.AUDIT_STREAM ?? \"clinic-agent-audit\",\n    57\t  smsSigningSecretArn: process.env.SMS_SIGNING_SECRET_ARN ?? \"\",\n    58\t  chatJwksUrl: process.env.CHAT_JWKS_URL ?? \"https://auth.northbay-clinics.example/.well-known/jwks.json\",\n    59\t  chatIssuer: process.env.CHAT_ISSUER ?? \"https://auth.northbay-clinics.example/\",\n    60\t  eligibilityUrl: process.env.ELIGIBILITY_URL ?? \"https://eligibility.partners.northbay-clinics.example/a2a\",\n    61\t  eligibilityIssuer: process.env.ELIGIBILITY_ISSUER ?? \"https://eligibility.partners.northbay-clinics.example\",\n    62\t  tokenExchangeUrl: process.env.TOKEN_EXCHANGE_URL ?? \"https://sts.northbay-clinics.example/oauth2/token\",\n    63\t  accountableParty: \"northbay-clinic-group:patient-access\",\n    64\t  operationalOwner: \"team:agent-platform\",\n    65\t};\n     1\timport { createHash, randomUUID } from \"node:crypto\";\n     2\timport { readdirSync, readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n     5\t\n     6\t// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n     7\t// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\n     8\tconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n     9\t\n    10\texport interface TypeIdInputs {\n    11\t  imageDigest: string;\n    12\t  harnessVersion: string;\n    13\t  harnessGitSha: string;\n    14\t}\n    15\t\n    16\texport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n    17\t  const parts: Array<[string, Buffer]> = [\n    18\t    [\"image\", Buffer.from(inputs.imageDigest)],\n    19\t    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    20\t    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n    21\t  ];\n    22\t  const promptDir = join(ROOT, \"prompts\");\n    23\t  const promptFiles = readdirSync(promptDir)\n    24\t    .filter((f) => f.endsWith(\".txt\"))\n    25\t    .sort();\n    26\t  for (const f of promptFiles) {\n    27\t    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n    28\t  }\n    29\t  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n    30\t  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n    31\t  for (const f of CONFIG_FILES) {\n    32\t    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n    33\t  }\n    34\t  return parts;\n    35\t}\n    36\t\n    37\texport function computeAgentTypeId(inputs: TypeIdInputs): string {\n    38\t  const h = createHash(\"sha256\");\n    39\t  for (const [label, bytes] of typeIdManifest(inputs)) {\n    40\t    h.update(label);\n    41\t    h.update(\"\\0\");\n    42\t    h.update(bytes);\n    43\t    h.update(\"\\0\");\n    44\t  }\n    45\t  return `sha256:${h.digest(\"hex\")}`;\n    46\t}\n    47\t\n    48\t// One instance id per process. Pods are the unit an operator contains.\n    49\texport const AGENT_INSTANCE_ID = randomUUID();\n    50\t\n    51\tlet AGENT_TYPE_ID = \"\";\n    52\texport function setAgentTypeId(id: string): void {\n    53\t  AGENT_TYPE_ID = id;\n    54\t}\n    55\t\n    56\texport interface Subject {\n    57\t  kind: \"patient\" | \"staff\" | \"system\";\n    58\t  id: string;\n    59\t}\n    60\t\n    61\texport interface Logger {\n    62\t  info(obj: object, msg?: string): void;\n    63\t  warn(obj: object, msg?: string): void;\n    64\t  error(obj: object, msg?: string): void;\n    65\t}\n    66\t\n    67\texport interface RunContext {\n    68\t  runId: string;\n    69\t  tenantId: string;\n    70\t  subject: Subject;\n    71\t  channel: \"sms\" | \"webchat\" | \"reminder\";\n    72\t  traceparent: string;\n    73\t  log: Logger;\n    74\t  identity(): {\n    75\t    accountableParty: string;\n    76\t    operationalOwner: string;\n    77\t    tenantId: string;\n    78\t    agentTypeId: string;\n    79\t    agentInstanceId: string;\n    80\t    traceparent: string;\n    81\t  };\n    82\t  workloadToken(): Promise<string>;\n    83\t}\n    84\t\n    85\t// Projected service-account token (audience: the group STS), rotated by the kubelet.\n    86\tconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n    87\t\n    88\texport function newRunContext(init: {\n    89\t  tenantId: string;\n    90\t  subject: Subject;\n    91\t  channel: RunContext[\"channel\"];\n    92\t  traceparent?: string;\n    93\t  log: Logger;\n    94\t}): RunContext {\n    95\t  const runId = randomUUID();\n    96\t  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n    97\t  return {\n    98\t    runId,\n    99\t    tenantId: init.tenantId,\n   100\t    subject: init.subject,\n   101\t    channel: init.channel,\n   102\t    traceparent,\n   103\t    log: init.log,\n   104\t    identity: () => ({\n   105\t      accountableParty: env.accountableParty,\n   106\t      operationalOwner: env.operationalOwner,\n   107\t      tenantId: init.tenantId,\n   108\t      agentTypeId: AGENT_TYPE_ID,\n   109\t      agentInstanceId: AGENT_INSTANCE_ID,\n   110\t      traceparent,\n   111\t    }),\n   112\t    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n   113\t  };\n   114\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"4b4cc063-651f-4244-b0d2-960a8fb3326c","uuid":"8507c5ea-c85c-45da-b08d-69ef257bd1a5","timestamp":"2026-10-20T15:43:56.154Z","tool_use_result":{"stdout":"     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: clinic-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.33\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: clinic-agent\n    15\t  namespace: clinic-agent\n    16\t  annotations:\n    17\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    18\t    eks.amazonaws.com/token-expiration: \"3600\"\n    19\tautomountServiceAccountToken: false\n    20\t---\n    21\tapiVersion: v1\n    22\tkind: ServiceAccount\n    23\tmetadata:\n    24\t  name: clinic-agent-reminders\n    25\t  namespace: clinic-agent\n    26\t  annotations:\n    27\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    28\tautomountServiceAccountToken: false\n    29\t---\n    30\tapiVersion: v1\n    31\tkind: ConfigMap\n    32\tmetadata:\n    33\t  name: clinic-agent\n    34\t  namespac