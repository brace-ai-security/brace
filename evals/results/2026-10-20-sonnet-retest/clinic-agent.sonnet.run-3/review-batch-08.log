">=22.11\"\n  },\n  \"scripts\": {\n    \"build\": \"tsc -p tsconfig.json\",\n    \"start\": \"node dist/server.js\",\n    \"reminders\": \"node dist/workers/reminders.js\",\n    \"lint\": \"eslint src test\",\n    \"test\": \"vitest run\"\n  },\n  \"dependencies\": {\n    \"@anthropic-ai/sdk\": \"0.65.0\",\n    \"@aws-sdk/client-dynamodb\": \"3.893.0\",\n    \"@aws-sdk/client-firehose\": \"3.893.0\",\n    \"@aws-sdk/client-secrets-manager\": \"3.893.0\",\n    \"@aws-sdk/lib-dynamodb\": \"3.893.0\",\n    \"@modelcontextprotocol/sdk\": \"1.18.2\",\n    \"fastify\": \"5.6.1\",\n    \"jose\": \"6.1.0\",\n    \"pino\": \"9.11.0\",\n    \"undici\": \"7.16.0\",\n    \"yaml\": \"2.8.1\",\n    \"zod\": \"3.25.76\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"22.18.6\",\n    \"eslint\": \"9.36.0\",\n    \"typescript\": \"5.9.2\",\n    \"typescript-eslint\": \"8.44.1\",\n    \"vitest\": \"3.2.4\"\n  }\n}\n# Hard limits enforced by src/agent/budget.ts, outside the model.\nrun:\n  maxTurns: 8                 # model calls per run\n  maxWallMs: 45000            # whole run, including tool calls\n  maxInputTokens: 120000      # summed across model calls in the run\n  maxOutputTokens: 6000\n  maxCostUsd: 0.40\n  maxToolCalls: 16\n  maxToolCallsPerMinute: 12\n  maxPeerCalls: 2             # calls to the eligibility agent; this agent starts no sub-agents\n\nquotas:\n  # Daily spend and per-minute tool-call ceilings across many runs.\n  perSubjectDailyUsd: 2.00    # one patient or staff user\n  perTenantDailyUsd: 60.00    # one clinic\n  fleetDailyUsd: 900.00       # all clinics\n  perTenantToolCallsPerMinute: 240\n  fleetToolCallsPerMinute: 2400\n\npricingUsdPerMTok:\n  claude-sonnet-4-5-20250929: { input: 3.00, output: 15.00, cacheRead: 0.30, cacheWrite: 3.75 }\n  claude-haiku-4-5-20251001: { input: 1.00, output: 5.00, cacheRead: 0.10, cacheWrite: 1.25 }\n\n# When a limit is hit the run stops, the stop is audited with the limit name, and the\n# conversation is handed to the clinic's front-desk queue.\nonExceed: handoff_to_staff\n# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\npolicyVersion: \"2026-09-18.3\"\n\n# Tools that never run without a staff approval bound to the request.\nhighImpactTools:\n  - ehr__cancel_appointment\n  - payments__refund_deposit\n  - sms__send_freeform\n\napproval:\n  ttlSeconds: 900\n  approverRoles:\n    - front_desk_lead\n    - clinic_manager\n  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n  table: clinic-agent-approvals\n# Every tool the scheduling agent may call, with the task it serves.\n# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n# are not used for allow or approval decisions.\nrole: scheduling_agent\ntools:\n  - tool: ehr__find_patient\n    reason: Match the sender to a patient record by date of birth and phone or email.\n  - tool: ehr__search_slots\n    reason: List open slots for a provider, location, and visit type.\n  - tool: ehr__get_appointment\n    reason: Read one appointment the patient asks about.\n  - tool: ehr__list_patient_appointments\n    reason: Show the patient their upcoming appointments.\n  - tool: ehr__book_appointment\n    reason: Book a slot the patient chose.\n  - tool: ehr__update_appointment\n    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n  - tool: ehr__cancel_appointment\n    reason: Cancel an appointment at the patient's request.\n  - tool: payments__refund_deposit\n    reason: Refund a no-show deposit after staff review.\n  - tool: sms__send_to_patient\n    reason: Send a templated message to the phone number on the patient's record.\n  - tool: sms__send_freeform\n    reason: Send a staff-approved message that is not one of the templates.\n  - tool: insurance__check_eligibility\n    reason: Ask the eligibility agent whether a visit is covered.\n.:\n.\n..\n.github\nbrace-findings.js