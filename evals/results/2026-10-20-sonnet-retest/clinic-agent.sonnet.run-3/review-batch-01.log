{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D7C1nSbDTA3GRA7qSXTLAj","type":"tool_result","content":"(eval):1: no matches found: --include=*\n----\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n     5\t// can send; free-form text goes through sms__send_freeform, which needs approval.\n     6\t\n     7\tconst sm = new SecretsManagerClient({ region: env.region });\n     8\tconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n     9\t\n    10\texport const TEMPLATES = {\n    11\t  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n    12\t  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n    13\t  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n    14\t  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n    15\t} as const;\n    16\texport type TemplateId = keyof typeof TEMPLATES;\n    17\t\n    18\texport function render(id: TemplateId, vars: Record<string, string>): string {\n    19\t  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n    20\t}\n    21\t\n    22\tasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n    23\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n    24\t  const v = JSON.parse(s.SecretString ?? \"{}\");\n    25\t  return { token: v.api_token, from: v.from_number };\n    26\t}\n    27\t\n    28\texport const sms = {\n    29\t  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n    30\t    const c = await creds(clinicId);\n    31\t    const res = await fetch(`${BASE}/messages`, {\n    32\t      method: \"POST\",\n    33\t      signal,\n    34\t      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n    35\t      body: JSON.stringify({ from: c.from, to, body }),\n    36\t    });\n    37\t    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n    38\t    return (await res.json()) as { messageId: string };\n    39\t  },\n    40\t};\n3:// Covered fields: server instructions, tool name, title, description, every string inside the\n4:// input and output schemas (titles, descriptions, enum values, defaults, examples), annotations,\n5:// prompt names/descriptions/argument descriptions, and resource template names/descriptions/URIs.\n14:  description?: string;\n23:  prompts?: Array<{ name: string; description?: string; arguments?: Array<{ name: string; description?: string }> }>;\n24:  resourceTemplates?: Array<{ name: string; uriTemplate: string; description?: string }>;\n36:  description: 1024,\n42:  // Invisible, bidi, and control characters (tab and newline allowed).\n105:    if (p.description) scanString(`prompt:${p.name}.description`, p.description, LIMITS.description, otherServerTools, serverFindings);\n107:      if (a.description) scanString(`prompt:${p.name}.arg:${a.name}`, a.description, LIMITS.schemaString, otherServerTools, serverFindings);\n112:    if (r.description) scanString(`resource:${r.name}.description`, r.description, LIMITS.description, otherServerTools, serverFindings);\n123:    if (t.description) scanString(\"description\", t.description, LIMITS.description, otherServerTools, f);\n     1\tname: deploy\n     2\t\n     3\t# Deploys the image digest named in release/manifest.json. The digest reaches the manifest through\n     4\t# a reviewed release PR, so what runs is always a reviewed commit.\n     5\ton:\n     6\t  workflow_dispatch:\n     7\t    inputs:\n     8\t      emergency:\n     9\t        description: Emergency change (hotfix/* branch, production-emergency environment)\n    10\t        type: boolean\n    11\t        default: false\n    12\t      owner:\n    13\t        description: Emergency only - person accountable for this change\n    14\t        type: string\n    15\t        default: \"\"\n    16\t      reason:\n    17\t        description: Emergency only - why this cannot wait for a normal release\n    18\t        type: string\n    19\t        default: \"\"\n    20\t      expires_on:\n    21\t        description: Emergency only - date (YYYY-MM-DD) by which it is replaced by a normal release\n    22\t        type: string\n    23\t        default: \"\"\n    24\t\n    25\tpermissions:\n    26\t  contents: read\n    27\t  id-token: write\n    28\t  issues: write\n    29\t\n    30\tconcurrency:\n    31\t  group: deploy-production\n    32\t  cancel-in-progress: false\n    33\t\n    34\tjobs:\n    35\t  deploy:\n    36\t    runs-on: ubuntu-24.04\n    37\t    environment: ${{ inputs.emergency && 'production-emergency' || 'production' }}\n    38\t    steps:\n    39\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    40\t\n    41\t      - name: Emergency change record is complete\n    42\t        if: inputs.emergency\n    43\t        env:\n    44\t          OWNER: ${{ inputs.owner }}\n    45\t          REASON: ${{ inputs.reason }}\n    46\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    47\t        run: |\n    48\t          test -n \"$OWNER\" || { echo \"owner is required\"; exit 1; }\n    49\t          test -n \"$REASON\" || { echo \"reason is required\"; exit 1; }\n    50\t          date -d \"$EXPIRES_ON\" +%F >/dev/null || { echo \"expires_on must be a date\"; exit 1; }\n    51\t          [[ \"$GITHUB_REF_NAME\" == hotfix/* ]] || { echo \"emergency deploys come from hotfix/* branches\"; exit 1; }\n    52\t\n    53\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    54\t        with:\n    55\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-deploy\n    56\t          aws-region: us-west-2\n    57\t\n    58\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    59\t        with:\n    60\t          cosign-release: v2.6.2\n    61\t\n    62\t      - name: Verify image signature\n    63\t        run: |\n    64\t          DIGEST=$(jq -r .image.digest release/manifest.json)\n    65\t          REPO=$(jq -r .image.repository release/manifest.json)\n    66\t          cosign verify \"$REPO@$DIGEST\" \\\n    67\t            --certificate-identity \"https://github.com/northbay-clinics/clinic-agent/.github/workflows/ci.yml@refs/heads/main\" \\\n    68\t            --certificate-oidc-issuer https://token.actions.githubusercontent.com\n    69\t          grep -q \"$DIGEST\" k8s/deployment.yaml || { echo \"k8s/deployment.yaml does not use the manifest digest\"; exit 1; }\n    70\t\n    71\t      - name: Apply\n    72\t        run: |\n    73\t          aws eks update-kubeconfig --name clinic-agent-prod\n    74\t          kubectl apply -f k8s/deployment.yaml\n    75\t          kubectl -n clinic-agent annotate deployment/clinic-agent --overwrite \\\n    76\t            northbay.example/git-sha=\"$GITHUB_SHA\" \\\n    77\t            northbay.example/release=\"$(jq -r .release release/manifest.json)\" \\\n    78\t            northbay.example/deployed-by=\"$GITHUB_ACTOR\" \\\n    79\t            northbay.example/run=\"$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID\"\n    80\t          kubectl -n clinic-agent rollout status deployment/clinic-agent --timeout=5m","is_error":false}]},"parent_tool_use_id":null,"session_id":"4172dc03-dd8f-4eaf-8eb3-7cefb8efb090","uuid":"78c3a875-ad96-4a74-b956-76ec7b61f175","timestamp":"2026-10-20T15:14:09.393Z","tool_use_result":{"stdout":"(eval):1: no matches found: --include=*\n----\n     1\timport { GetSecretValueCommand, SecretsManagerCl