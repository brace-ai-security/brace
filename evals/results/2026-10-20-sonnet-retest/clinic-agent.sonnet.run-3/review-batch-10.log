{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HCR9EfaDKtghjy3J7dwL3c","type":"tool_result","content":"=== src/agent/loop.ts\n     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\n=== src/agent/identity.ts\n     1\timport { createHash, randomUUID } from \"node:crypto\";\n     2\timport { readdirSync, readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n     5\t\n     6\t// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n     7\t// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\n     8\tconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n     9\t\n    10\texport interface TypeIdInputs {\n    11\t  imageDigest: string;\n    12\t  harnessVersion: string;\n    13\t  harnessGitSha: string;\n    14\t}\n    15\t\n    16\texport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n    17\t  const parts: Array<[string, Buffer]> = [\n    18\t    [\"image\", Buffer.from(inputs.imageDigest)],\n    19\t    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    20\t    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n    21\t  ];\n    22\t  const promptDir = join(ROOT, \"prompts\");\n    23\t  const promptFiles = readdirSync(promptDir)\n    24\t    .filter((f) => f.endsWith(\".txt\"))\n    25\t    .sort();\n    26\t  for (const f of promptFiles) {\n    27\t    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n    28\t  }\n    29\t  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n    30\t  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n    31\t  for (const f of CONFIG_FILES) {\n    32\t    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n    33\t  }\n    34\t  return parts;\n    35\t}\n    36\t\n    37\texport function computeAgentTypeId(inputs: TypeIdInputs): string {\n    38\t  const h = createHash(\"sha256\");\n    39\t  for (const [label, bytes] of typeIdManifest(inputs)) {\n    40\t    h.update(label);\n    41\t    h.update(\"\\0\");\n    42\t    h.update(bytes);\n    43\t    h.update(\"\\0\");\n    44\t  }\n    45\t  return `sha256:${h.digest(\"hex\")}`;\n    46\t}\n    47\t\n    48\t// One instance id per process. Pods are the unit an operator contains.\n    49\texport const AGENT_INSTANCE_ID = randomUUID();\n    50\t\n    51\tlet AGENT_TYPE_ID = \"\";\n    52\texport function setAgentTypeId(id: string): void {\n    53\t  AGENT_TYPE_ID = id;\n    54\t}\n    55\t\n    56\texport interface Subject {\n    57\t  kind: \"patient\" | \"staff\" | \"system\";\n    58\t  id: string;\n    59\t}\n    60\t\n    61\texport interface Logger {\n    62\t  info(obj: object, msg?: string): void;\n    63\t  warn(obj: object, msg?: string): void;\n    64\t  error(obj: object, msg?: string): void;\n    65\t}\n    66\t\n    67\texport interface RunContext {\n    68\t  runId: string;\n    69\t  tenantId: string;\n    70\t  subject: Subject;\n    71\t  channel: \"sms\" | \"webchat\" | \"reminder\";\n    72\t  traceparent: string;\n    73\t  log: Logger;\n    74\t  identity(): {\n    75\t    accountableParty: string;\n    76\t    operationalOwner: string;\n    77\t    tenantId: string;\n    78\t    agentTypeId: string;\n    79\t    agentInstanceId: string;\n    80\t    traceparent: string;\n    81\t  };\n    82\t  workloadToken(): Promise<string>;\n    83\t}\n    84\t\n    85\t// Projected service-account token (audience: the group STS), rotated by the kubelet.\n    86\tconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n    87\t\n    88\texport function newRunContext(init: {\n    89\t  tenantId: string;\n    90\t  subject: Subject;\n    91\t  channel: RunContext[\"channel\"];\n    92\t  traceparent?: string;\n    93\t  log: Logger;\n    94\t}): RunContext {\n    95\t  const runId = randomUUID();\n    96\t  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n    97\t  return {\n    98\t    runId,\n    99\t    tenantId: init.tenantId,\n   100\t    subject: init.subject,\n   101\t    channel: init.channel,\n   102\t    traceparent,\n   103\t    log: init.log,\n   104\t    identity: () => ({\n   105\t      accountableParty: env.accountableParty,\n   106\t      operationalOwner: env.operationalOwner,\n   107\t      tenantId: init.tenantId,\n   108\t      agentTypeId: AGENT_TYPE_ID,\n   109\t      agentInstanceId: AGENT_INSTANCE_ID,\n   110\t      traceparent,\n   111\t    }),\n   112\t    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n   113\t  };\n   114\t}\n=== src/audit/recorder.ts\n     1\timport { FirehoseClient, PutRecordCommand } from \"@aws-sdk/client-firehose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Every audit record carries the six identity fields. Values come from RunContext, which is built\n     7\t// by the HTTP layer and the worker, never from model output.\n     8\texport const IdentityFields = z.object({\n     9\t  accountableParty: z.string().min(1),\n    10\t  operationalOwner: z.string().min(1),\n    11\t  tenantId: z.string().min(1),\n    12\t  agentTypeId: z.string().startsWith(\"sha256:\"),\n    13\t  agentInstanceId: z.string().uuid(),\n    14\t  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),\n    15\t});\n    16\t\n    17\texport const AuditEvent = IdentityFields.extend({\n    18\t  eventId: z.string().uuid(),\n    19\t  ts: z.string().datetime(),\n    20\t  runId: z.string().uuid(),\n    21\t  event: z.enum([\n    22\t    \"run.started\",\n    23\t    \"run.stopped\",\n    24\t    \"run.completed\",\n    25\t    \"intent.classified\",\n    26\t    \"model.decision\",\n    27\t    \"tool.denied\",\n    28\t    \"tool.approval_requested\",\n    29\t    \"tool.executed\",\n    30\t    \"tool.failed\",\n    31\t    \"payment.refund\",\n    32\t    \"peer.call\",\n    33\t    \"reminder.sent\",\n    34\t  ]),\n    35\t  subject: z.object({ kind: z.enum([\"patient\", \"staff\", \"system\"]), id: z.string() }),\n    36\t  tool: z.string().optional(),\n    37\t  toolUseId: z.string().optional(),\n    38\t  policyVersion: z.string().optional(),\n    39\t  approvalId: z.string().optional(),\n    40\t  reason: z.string().optional(),\n    41\t  context: z\n    42\t    .object({\n    43\t      tokens: z.number().int().nonnegative().nullable(),\n    44\t      status: z.enum([\"measured\", \"estimated\", \"unavailable\"]),\n    45\t      method: z.string(),\n    46\t      cachedInputTokens: z.number().int().nonnegative().nullable(),\n    47\t      compacted: z.boolean(),\n    48\t    })\n    49\t    .optional(),\n    50\t  detail: z.record(z.unknown()).optional(),\n    51\t});\n    52\texport type AuditEvent = z.infer<typeof AuditEvent>;\n    53\t\n    54\tconst firehose = new FirehoseClient({ region: env.region });\n    55\t\n    56\texport class AuditUnavailable extends Error {}\n    57\t\n    58\texport const audit = {\n    59\t  async record(e: Omit<AuditEvent, \"eventId\" | \"ts\">): Promise<void> {\n    60\t    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });\n    61\t    try {\n    62\t      await firehose.send(\n    63\t        new PutRecordCommand({\n    64\t          DeliveryStreamName: env.auditStream,\n    65\t          Record: { Data: Buffer.from(JSON.stringify(full) + \"\\n\") },\n    66\t        }),\n    67\t      );\n    68\t    } catch (err) {\n    69\t      // Callers treat this as a hard failure: an action that cannot be audited does not run.\n    70\t      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);\n    71\t    }\n    72\t  },\n    73\t};\n    74\t\n    75\t// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.\n    76\tconst DROP_KEYS = new Set([\"ssn\", \"dateOfBirth\", \"dob\", \"memberId\", \"subscriberId\", \"cardNumber\", \"cardLast4\", \"address\"]);\n    77\tconst PATTERNS: Array<[RegExp, string]> = [\n    78\t  [/\\b\\d{3}-\\d{2}-\\d{4}\\b/g, \"[ssn]\"],\n    79\t  [/\\b(?:\\d[ -]?){13,19}\\b/g, \"[card]\"],\n    80\t  [/\\b[A-Z]{3}\\d{9}\\b/g, \"[member-id]\"],\n    81\t];\n    82\t\n    83\texport function redactPhi(value: unknown): unknown {\n    84\t  if (typeof value === \"string\") {\n    85\t    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);\n    86\t  }\n    87\t  if (Array.isArray(value)) return value.map(redactPhi);\n    88\t  if (value && typeof value === \"object\") {\n    89\t    const out: Record<string, unknown> = {};\n    90\t    for (const [k, v] of Object.entries(value)) {\n    91\t      if (DROP_KEYS.has(k)) continue;\n    92\t      out[k] = redactPhi(v);\n    93\t    }\n    94\t    return out;\n    95\t  }\n    96\t  return value;\n    97\t}\n=== src/routes/webchat.ts\n     1\timport type { FastifyInstance } from \"fastify\";\n     2\timport { createRemoteJWKSet, jwtVerify } from \"jose\";\n     3\timport { z } from \"zod\";\n     4\timport { runAgent } from \"../agent/loop.js\";\n     5\timport { newRunContext } from \"../agent/identity.js\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n     8\t\n     9\t// Web chat. The widget gets a short-lived session JWT from the group auth service after the\n    10\t// patient verifies by one-time code, or a staff JWT for front-desk users.\n    11\t// Claims: sub, clinic_id, role (\"patient\" | \"staff\"), exp.\n    12\t\n    13\tconst jwks = createRemoteJWKSet(new URL(env.chatJwksUrl));\n    14\t\n    15\tconst ChatBody = z.object({ message: z.string().min(1).max(2000) }).strict();\n    16\tconst TRACEPARENT = /^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/;\n    17\t\n    18\texport function registerWebchat(\n    19\t  app: FastifyInstance,\n    20\t  deps: { registry: ToolRegistry; clinicById: (id: string) => { id: string; name: string } | undefined },\n    21\t): void {\n    22\t  app.post(\"/v1/chat\", { bodyLimit: 16_384 }, async (req, reply) => {\n    23\t    const auth = req.headers.authorization ?? \"\";\n    24\t    if (!auth.startsWith(\"Bearer \")) return reply.code(401).send({ error: \"missing token\" });\n    25\t\n    26\t    let claims: { sub: string; clinic_id: string; role: \"patient\" | \"staff\" };\n    27\t    try {\n    28\t      const { payload } = await jwtVerify(auth.slice(7), jwks, {\n    29\t        issuer: env.chatIssuer,\n    30\t        audience: \"clinic-agent-chat\",\n    31\t        algorithms: [\"ES256\"],\n    32\t        maxTokenAge: \"30m\",\n    33\t      });\n    34\t      claims = payload as unknown as typeof claims;\n    35\t    } catch {\n    36\t      return reply.code(401).send({ error: \"invalid token\" });\n    37\t    }\n    38\t\n    39\t    const body = ChatBody.safeParse(req.body);\n    40\t    if (!body.success) return reply.code(400).send({ error: \"invalid body\" });\n    41\t\n    42\t    // The group site embeds one widget for all clinics and sends the clinic the patient picked.\n    43\t    const tenantId = (req.headers[\"x-clinic-id\"] as string | undefined) ?? claims.clinic_id;\n    44\t    const clinic = deps.clinicById(tenantId);\n    45\t    if (!clinic) return reply.code(404).send({ error: \"unknown clinic\" });\n    46\t\n    47\t    const tp = req.headers.traceparent;\n    48\t    const ctx = newRunContext({\n    49\t      tenantId: clinic.id,\n    50\t      subject: { kind: claims.role === \"staff\" ? \"staff\" : \"patient\", id: claims.sub },\n    51\t      channel: \"webchat\",\n    52\t      traceparent: typeof tp === \"string\" && TRACEPARENT.test(tp) ? tp : undefined,\n    53\t      log: req.log,\n    54\t    });\n    55\t\n    56\t    const out = await runAgent(deps.registry, ctx, clinic, body.data.message);\n    57\t    return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });\n    58\t  });\n    59\t}\n=== src/integrations/payments.ts\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n     5\t// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n     6\t// The provider enforces Idempotency-Key for 24 hours.\n     7\t\n     8\tconst sm = new SecretsManagerClient({ region: env.region });\n     9\tconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n    10\t\n    11\tasync function key(clinicId: string): Promise<string> {\n    12\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n    13\t  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n    14\t}\n    15\t\n    16\texport interface Refund {\n    17\t  id: string;\n    18\t  depositId: string;\n    19\t  amountCents: number;\n    20\t  status: \"pending\" | \"succeeded\" | \"failed\";\n    21\t}\n    22\t\n    23\texport const payments = {\n    24\t  async refundDeposit(\n    25\t    clinicId: string,\n    26\t    req: { depositId: string; reason: string; idempotencyKey: string },\n    27\t    signal?: AbortSignal,\n    28\t  ): Promise<Refund> {\n    29\t    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n    30\t      method: \"POST\",\n    31\t      signal,\n    32\t      headers: {\n    33\t        authorization: `Bearer ${await key(clinicId)}`,\n    34\t        \"content-type\": \"application/json\",\n    35\t        \"idempotency-key\": req.idempotencyKey,\n    36\t      },\n    37\t      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    38\t    });\n    39\t    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    40\t    return (await res.json()) as Refund;\n    41\t  },\n    42\t};\n=== README.md\n     1\t# clinic-agent\n     2\t\n     3\tPatient-scheduling agent for the Northbay Clinic Group. Patients reach it by SMS or by the web chat\n     4\twidget on each clinic's site. It looks up, books, reschedules, and cancels appointments in the EHR,\n     5\tsends SMS reminders, refunds no-show deposits, and asks the insurance-eligibility agent whether a\n     6\tvisit is covered.\n     7\t\n     8\tEach clinic is a tenant. A clinic's patients, appointments, deposits, and EHR credentials are kept\n     9\tseparate from every other clinic's.\n    10\t\n    11\t## Components\n    12\t\n    13\t| Piece | Where | Notes |\n    14\t|---|---|---|\n    15\t| HTTP service (Fastify) | `src/server.ts` | `/v1/sms/inbound` webhook, `/v1/chat` web chat |\n    16\t| Agent loop | `src/agent/loop.ts` | Claude Sonnet 4.5 snapshot, tool use |\n    17\t| Intent classifier | `src/agent/classifier.ts` | Claude Haiku 4.5 snapshot, routes emergencies and complaints to staff |\n    18\t| Tool registry | `src/tools/registry.ts` | EHR MCP server plus native tools, scanned on load |\n    19\t| Tool executor | `src/tools/executor.ts` | allowlist, kill switch, budgets, approvals, audit |\n    20\t| EHR | `src/integrations/ehr-mcp.ts` | MCP over streamable HTTP with mTLS, per-clinic OAuth client |\n    21\t| Payments | `src/integrations/payments.ts` | deposit refunds, provider idempotency keys |\n    22\t| SMS | `src/integrations/sms.ts` | outbound reminders and replies |\n    23\t| Eligibility peer | `src/integrations/eligibility-a2a.ts` | A2A `message/send`, token exchange per call |\n    24\t| Reminder job | `src/workers/reminders.ts` | Kubernetes CronJob, 17:00 local each day |\n    25\t\n    26\tThere is no vector store and no conversation memory. Every run starts from the patient's message and\n    27\tthe EHR. Conversation transcripts are not stored by this service.\n    28\t\n    29\t## High-impact actions\n    30\t\n    31\t`config/policy.yaml` lists the tools that need a staff approval before they run. The agent asks for\n    32\tthe approval, a front-desk lead or clinic manager approves it in the staff console, and the agent\n    33\tretries with the approval ID. Approvals expire after 15 minutes.\n    34\t\n    35\t## Stopping the agent\n    36\t\n    37\tOperators with the `clinic-agent-ops` role set `halted = true` on the `global` item (all clinics) or a\n    38\t`tenant#<clinicId>` item in the `clinic-agent-control` DynamoDB table:\n    39\t\n    40\t```bash\n    41\taws dynamodb put-item --table-name clinic-agent-control \\\n    42\t  --item '{\"pk\":{\"S\":\"global\"},\"halted\":{\"BOOL\":true},\"by\":{\"S\":\"<you>\"}}'\n    43\t```\n    44\t\n    45\tRunning work checks the flag before each model turn and each tool call, and a watcher aborts in-flight\n    46\trequests within 2 seconds.\n    47\t\n    48\t## Identity\n    49\t\n    50\t`src/agent/identity.ts` computes the agent-type-id from the image digest, harness version, prompts,\n    51\tmodel IDs, and config. Each pod also gets a random agent-instance-id at start. Both are on every\n    52\taudit record together with the accountable party, operational owner, tenant, and trace context.\n    53\t\n    54\t## Build and test\n    55\t\n    56\t```bash\n    57\tnpm ci\n    58\tnpm run lint\n    59\tnpm test\n    60\tnpm run build\n    61\t```\n    62\t\n    63\t## Release\n    64\t\n    65\tMerges to `main` need two reviews and a code owner review for prompts, config, infra, and manifests.\n    66\t`deploy.yml` builds, signs, and deploys by digest to the `production` environment, which has required\n    67\treviewers. Emergency deploys use the same workflow with `emergency: true` and must name an owner,\n    68\ta reason, and an end date; the workflow opens a follow-up review issue.\n    69\t\n    70\t## Owners\n    71\t\n    72\t- Accountable party: Northbay Clinic Group, Patient Access (VP Patient Access)\n    73\t- Operational owner: agent-platform team, `#agent-platform-oncall`\n69:  readonly abort = new AbortController();\n88:      () => this.abort.abort(new BudgetExceeded(\"wall_time\", this.b.run.maxWallMs, this.b.run.maxWallMs)),\n93:  get signal(): AbortSignal {\n94:    return this.abort.signal;\n104:      this.abort.abort(e);\n168:      this.abort.abort(e);","is_error":false}]},"parent_tool_use_id":null,"session_id":"0de488e7-937f-49f5-af13-02cd18e903c1","uuid":"e25650d2-f5c1-46bb-96ba-80b97be1bc99","timestamp":"2026-10-20T15:52:02.526Z","tool_use_result":{"stdout":"=== src/agent/loop.ts\n     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\n=== src/agent/identity.ts\n     1\timport { createHash, randomUUID } from \"node:crypto\";\n     2\timport { readdirSync, readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n     5\t\n     6\t// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n     7\t// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\n     8\tconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n     9\t\n    10\texport interface TypeIdInputs {\n    11\t  imageDigest: string;\n    12\t  harnessVersion: string;\n    13\t  harnessGitSha: string;\n    14\t}\n    15\t\n    16\texport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n    17\t  const parts: Array<[string, Buffer]> = [\n    18\t    [\"image\", Buffer.from(inputs.imageDigest)],\n    19\t    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    20\t    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n    21\t  ];\n    22\t  const promptDir = join(ROOT, \"prompts\");\n    23\t  const promptFiles = readdirSync(promptDir)\n    24\t    .filter((f) => f.endsWith(\".txt\"))\n    25\t    .sort();\n    26\t  for (const f of promptFiles) {\n    27\t    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n    28\t  }\n    29\t  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n    30\t  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n    31\t  for (const f of CONFIG_FILES) {\n    32\t    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n    33\t  }\n    34\t  return parts;\n    35\t}\n    36\t\n    37\texport function computeAgentTypeId(inputs: TypeIdInputs): string {\n    38\t  const h = createHash(\"sha256\");\n    39\t  for (const [label, bytes] of typeIdManifest(inputs)) {\n    40\t    h.update(label);\n    41\t    h.update(\"\\0\");\n    42\t    h.update(bytes);\n    43\t    h.update(\"\\0\");\n    44\t  }\n    45\t  return `sha256:${h.digest(\"hex\")}`;\n    46\t}\n    47\t\n    48\t// One instance id per process. Pods are the unit an operator contains.\n    49\texport const AGENT_INSTANCE_ID = randomUUID();\n    50\t\n    51\tlet AGENT_TYPE_ID = \"\";\n    52\texport function setAgentTypeId(id: string): void {\n    53\t  AGENT_TYPE_ID = id;\n    54\t}\n    55\t\n    56\texport interface Subject {\n    57\t  kind: \"patient\" | \"staff\" | \"system\";\n    58\t  id: string;\n    59\t}\n    60\t\n    61\texport interface Logger {\n    62\t  info(obj: object, msg?: string): void;\n    63\t  warn(obj: object, msg?: string): void;\n    64\t  error(obj: object, msg?: string): void;\n    65\t}\n    66\t\n    67\texport interface RunContext {\n    68\t  runId: string;\n    69\t  tenantId: string;\n    70\t  subject: Subject;\n    71\t  channel: \"sms\" | \"webchat\" | \"reminder\";\n    72\t  traceparent: string;\n    73\t  log: Logger;\n    74\t  identity(): {\n    75\t    accountableParty: string;\n    76\t    operationalOwner: string;\n    77\t    tenantId: string;\n    78\t    agentTypeId: string;\n    79\t    agentInstanceId: string;\n    80\t    traceparent: string;\n    81\t  };\n    82\t  workloadToken(): Promise<string>;\n    83\t}\n    84\t\n    85\t// Projected service-account token (audience: the group STS), rotated by the kubelet.\n    86\tconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n    87\t\n    88\texport function newRunContext(init: {\n    89\t  tenantId: string;\n    90\t  subject: Subject;\n    91\t  channel: RunContext[\"channel\"];\n    92\t  traceparent?: string;\n    93\t  log: Logger;\n    94\t}): RunContext {\n    95\t  const runId = randomUUID();\n    96\t  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n    97\t  return {\n    98\t    runId,\n    99\t    tenantId: init.tenantId,\n   100\t    subject: init.subject,\n   101\t    channel: init.channel,\n   102\t    traceparent,\n   103\t    log: init.log,\n   104\t    identity: () => ({\n   105\t      accountableParty: env.accountableParty,\n   106\t      operationalOwner: env.operationalOwner,\n   107\t      tenantId: init.tenantId,\n   108\t      agentTypeId: AGENT_TYPE_ID,\n   109\t      agentInstanceId: AGENT_INSTANCE_ID,\n   110\t      traceparent,\n   111\t    }),\n   112\t    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n   113\t  };\n   114\t}\n=== src/audit/recorder.ts\n     1\timport { FirehoseClient, PutRecordCommand } from \"@aws-sdk/client-firehose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Every audit record carries the six identity fields. Values come from RunContext, which is built\n     7\t// by the HTTP layer and the worker, never from model output.\n     8\texport const IdentityFields = z.object({\n     9\t  accountableParty: z.string().min(1),\n    10\t  operationalOwner: z.string().min(1),\n    11\t  tenantId: z.string().min(1),\n    12\t  agentTypeId: z.string().startsWith(\"sha256:\"),\n    13\t  agentInstanceId: z.string().uuid(),\n    14\t  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),\n    15\t});\n    16\t\n    17\texport const AuditEvent = IdentityFields.extend({\n    18\t  eventId: z.string().uuid(),\n    19\t  ts: z.string().datetime(),\n    20\t  runId: z.string().uuid(),\n    21\t  event: z.enum([\n    22\t    \"run.started\",\n    23\t    \"run.stopped\",\n    24\t    \"run.completed\",\n    25\t    \"intent.classified\",\n    26\t    \"model.decision\",\n    27\t    \"tool.denied\",\n    28\t    \"tool.approval_requested\",\n    29\t    \"tool.executed\",\n    30\t    \"tool.failed\",\n    31\t    \"payment.refund\",\n    32\t    \"peer.call\",\n    33\t    \"reminder.sent\",\n    34\t  ]),\n    35\t  subject: z.object({ kind: z.enum([\"patient\", \"staff\", \"system\"]), id: z.string() }),\n    36\t  tool: z.string().optional(),\n    37\t  toolUseId: z.string().optional(),\n    38\t  policyVersion: z.string().optional(),\n    39\t  approvalId: z.string().optional(),\n    40\t  reason: z.string().optional(),\n    41\t  context: z\n    42\t    .object({\n    43\t      tokens: z.number().int().nonnegative().nullable(),\n    44\t      status: z.enum([\"measured\", \"estimated\", \"unavailable\"]),\n    45\t      method: z.string(),\n    46\t      cachedInputTokens: z.number().int().nonnegative().nullable(),\n    47\t      compacted: z.boolean(),\n    48\t    })\n    49\t    .optional(),\n    50\t  detail: z.record(z.unknown()).optional(),\n    51\t});\n    52\texport type AuditEvent = z.infer<typeof AuditEvent>;\n    53\t\n    54\tconst firehose = new FirehoseClient({ region: env.region });\n    55\t\n    56\texport class AuditUnavailable extends Error {}\n    57\t\n    58\texport const audit = {\n    59\t  async record(e: Omit<AuditEvent, \"eventId\" | \"ts\">): Promise<void> {\n    60\t    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });\n    61\t    try {\n    62\t      await firehose.send(\n    63\t        new PutRecordCommand({\n    64\t          DeliveryStreamName: env.auditStream,\n    65\t          Record: { Data: Buffer.from(JSON.stringify(full) + \"\\n\") },\n    66\t        }),\n    67\t      );\n    68\t    } catch (err) {\n    69\t      // Callers treat this as a hard failure: an action that cannot be audited does not run.\n    70\t      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);\n    71\t    }\n    72\t  },\n    73\t};\n    74\t\n    75\t// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.\n    76\tconst DROP_KEYS = new Set([\"ssn\", \"dateOfBirth\", \"dob\", \"memberId\", \"subscriberId\", \"cardNumber\", \"cardLast4\", \"address\"]);\n    77\tconst PATTERNS: Array<[RegExp, string]> = [\n    78\t  [/\\b\\d{3}-\\d{2}-\\d{4}\\b/g, \"[ssn]\"],\n    79\t  [/\\b(?:\\d[ -]?){13,19}\\b/g, \"[card]\"],\n    80\t  [/\\b[A-Z]{3}\\d{9}\\b/g, \"[member-id]\"],\n    81\t];\n    82\t\n    83\texport function redactPhi(value: unknown): unknown {\n    84\t  if (typeof value === \"string\") {\n    85\t    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);\n    86\t  }\n    87\t  if (Array.isArray(value)) return value.map(redactPhi);\n    88\t  if (value && typeof value === \"object\") {\n    89\t    const out: Record<string, unknown> = {};\n    90\t    for (const [k, v] of Object.entries(value)) {\n    91\t      if (DROP_KEYS.has(k)) continue;\n    92\t      out[k] = redactPhi(v);\n    93\t    }\n    94\t    return out;\n    95\t  }\n    96\t  return value;\n    97\t}\n=== src/routes/webchat.ts\n     1\timport type { FastifyInstance } from \"fastify\";\n     2\timport { createRemoteJWKSet, jwtVerify } from \"jose\";\n     3\timport { z } from \"zod\";\n     4\timport { runAgent } from \"../agent/loop.js\";\n     5\timport { newRunContext } from \"../agent/identity.js\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n     8\t\n     9\t// Web chat. The widget gets a short-lived session JWT from the group auth service after the\n    10\t// patient verifies by one-time code, or a staff JWT for front-desk users.\n    11\t// Claims: sub, clinic_id, role (\"patient\" | \"staff\"), exp.\n    12\t\n    13\tconst jwks = createRemoteJWKSet(new URL(env.chatJwksUrl));\n    14\t\n    15\tconst ChatBody = z.object({ message: z.string().min(1).max(2000) }).strict();\n    16\tconst TRACEPARENT = /^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/;\n    17\t\n    18\texport function registerWebchat(\n    19\t  app: FastifyInstance,\n    20\t  deps: { registry: ToolRegistry; clinicById: (id: string) => { id: string; name: string } | undefined },\n    21\t): void {\n    22\t  app.post(\"/v1/chat\", { bodyLimit: 16_384 }, async (req, reply) => {\n    23\t    const auth = req.headers.authorization ?? \"\";\n    24\t    if (!auth.startsWith(\"Bearer \")) return reply.code(401).send({ error: \"missing token\" });\n    25\t\n    26\t    let claims: { sub: string; clinic_id: string; role: \"patient\" | \"staff\" };\n    27\t    try {\n    28\t      const { payload } = await jwtVerify(auth.slice(7), jwks, {\n    29\t        issuer: env.chatIssuer,\n    30\t        audience: \"clinic-agent-chat\",\n    31\t        algorithms: [\"ES256\"],\n    32\t        maxTokenAge: \"30m\",\n    33\t      });\n    34\t      claims = payload as unknown as typeof claims;\n    35\t    } catch {\n    36\t      return reply.code(401).send({ error: \"invalid token\" });\n    37\t    }\n    38\t\n    39\t    const body = ChatBody.safeParse(req.body);\n    40\t    if (!body.success) return reply.code(400).send({ error: \"invalid body\" });\n    41\t\n    42\t    // The group site embeds one widget for all clinics and sends the clinic the patient picked.\n    43\t    const tenantId = (req.headers[\"x-clinic-id\"] as string | undefined) ?? claims.clinic_id;\n    44\t    const clinic = deps.clinicById(tenantId);\n    45\t    if (!clinic) return reply.code(404).send({ error: \"unknown clinic\" });\n    46\t\n    47\t    const tp = req.headers.traceparent;\n    48\t    const ctx = newRunContext({\n    49\t      tenantId: clinic.id,\n    50\t      subject: { kind: claims.role === \"staff\" ? \"staff\" : \"patient\", id: claims.sub },\n    51\t      channel: \"webchat\",\n    52\t      traceparent: typeof tp === \"string\" && TRACEPARENT.test(tp) ? tp : undefined,\n    53\t      log: req.log,\n    54\t    });\n    55\t\n    56\t    const out = await runAgent(deps.registry, ctx, clinic, body.data.message);\n    57\t    return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });\n    58\t  });\n    59\t}\n=== src/integrations/payments.ts\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n     5\t// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n     6\t// The provider enforces Idempotency-Key for 24 hours.\n     7\t\n     8\tconst sm = new SecretsManagerClient({ region: env.region });\n     9\tconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n    10\t\n    11\tasync function key(clinicId: string): Promise<string> {\n    12\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n    13\t  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n    14\t}\n    15\t\n    16\texport interface Refund {\n    17\t  id: string;\n    18\t  depositId: string;\n    19\t  amountCents: number;\n    20\t  status: \"pending\" | \"succeeded\" | \"failed\";\n    21\t}\n    22\t\n    23\texport const payments = {\n    24\t  async refundDeposit(\n    25\t    clinicId: string,\n    26\t    req: { depositId: string; reason: string; idempotencyKey: string },\n    27\t    signal?: AbortSignal,\n    28\t  ): Promise<Refund> {\n    29\t    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n    30\t      method: \"POST\",\n    31\t      signal,\n    32\t      headers: {\n    33\t        authorization: `Bearer ${await key(clinicId)}`,\n    34\t        \"content-type\": \"application/json\",\n    35\t        \"idempotency-key\": req.idempotencyKey,\n    36\t      },\n    37\t      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    38\t    });\n    39\t    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    40\t    return (await res.json()) as Refund;\n    41\t  },\n    42\t};\n=== README.md\n     1\t# clinic-agent\n     2\t\n     3\tPatient-scheduling agent for the Northbay Clinic Group. Patients reach it by SMS or by the web chat\n     4\twidget on each clinic's site. It looks up, books, reschedules, and cancels appointments in the EHR,\n     5\tsends SMS reminders, refunds no-show deposits, and asks the insurance-eligibility agent whether a\n     6\tvisit is covered.\n     7\t\n     8\tEach clinic is a tenant. A clinic's patients, appointments, deposits, and EHR credentials are kept\n     9\tseparate from every other clinic's.\n    10\t\n    11\t## Components\n    12\t\n    13\t| Piece | Where | Notes |\n    14\t|---|---|---|\n    15\t| HTTP service (Fastify) | `src/server.ts` | `/v1/sms/inbound` webhook, `/v1/chat` web chat |\n    16\t| Agent loop | `src/agent/loop.ts` | Claude Sonnet 4.5 snapshot, tool use |\n    17\t| Intent classifier | `src/agent/classifier.ts` | Claude Haiku 4.5 snapshot, routes emergencies and complaints to staff |\n    18\t| Tool registry | `src/tools/registry.ts` | EHR MCP server plus native tools, scanned on load |\n    19\t| Tool executor | `src/tools/executor.ts` | allowlist, kill switch, budgets, approvals, audit |\n    20\t| EHR | `src/integrations/ehr-mcp.ts` | MCP over streamable HTTP with mTLS, per-clinic OAuth client |\n    21\t| Payments | `src/integrations/payments.ts` | deposit refunds, provider idempotency keys |\n    22\t| SMS | `src/integrations/sms.ts` | outbound reminders and replies |\n    23\t| Eligibility peer | `src/integrations/eligibility-a2a.ts` | A2A `message/send`, token exchange per call |\n    24\t| Reminder job | `src/workers/reminders.ts` | Kubernetes CronJob, 17:00 local each day |\n    25\t\n    26\tThere is no vector store and no conversation memory. Every run starts from the patient's message and\n    27\tthe EHR. Conversation transcripts are not stored by this service.\n    28\t\n    29\t## High-impact actions\n    30\t\n    31\t`config/policy.yaml` lists the tools that need a staff approval before they run. The agent asks for\n    32\tthe approval, a front-desk lead or clinic manager approves it in the staff console, and the agent\n    33\tretries with the approval ID. Approvals expire after 15 minutes.\n    34\t\n    35\t## Stopping the agent\n    36\t\n    37\tOperators with the `clinic-agent-ops` role set `halted = true` on the `global` item (all clinics) or a\n    38\t`tenant#<clinicId>` item in the `clinic-agent-control` DynamoDB table:\n    39\t\n    40\t```bash\n    41\taws dynamodb put-item --table-name clinic-agent-control \\\n    42\t  --item '{\"pk\":{\"S\":\"global\"},\"halted\":{\"BOOL\":true},\"by\":{\"S\":\"<you>\"}}'\n    43\t```\n    44\t\n    45\tRunning work checks the flag before each model turn and each tool call, and a watcher aborts in-flight\n    46\trequests within 2 seconds.\n    47\t\n    48\t## Identity\n    49\t\n    50\t`src/agent/identity.ts` computes the agent-type-id from the image digest, harness version, prompts,\n    51\tmodel IDs, and config. Each pod also gets a random agent-instance-id at start. Both are on every\n    52\taudit record together with the accountable party, operational owner, tenant, and trace context.\n    53\t\n    54\t## Build and test\n    55\t\n    56\t```bash\n    57\tnpm ci\n    58\tnpm run lint\n    59\tnpm test\n    60\tnpm run build\n    61\t```\n    62\t\n    63\t## Release\n    64\t\n    65\tMerges to `main` need two reviews and a code owner review for prompts, config, infra, and manifests.\n    66\t`deploy.yml` builds, signs, and deploys by digest to the `production` environment, which has required\n    67\treviewers. Emergency deploys use the same workflow with `emergency: true` and must name an owner,\n    68\ta reason, and an end date; the workflow opens a follow-up review issue.\n    69\t\n    70\t## Owners\n    71\t\n    72\t- Accountable party: Northbay Clinic Group, Patient Access (VP Patient Access)\n    73\t- Operational owner: agent-platform team, `#agent-platform-oncall`\n69:  readonly abort = new AbortController();\n88:      () => this.abort.abort(new BudgetExceeded(\"wall_time\", this.b.run.maxWallMs, this.b.run.maxWallMs)),\n93:  get signal(): AbortSignal {\n94:    return this.abort.signal;\n104:      this.abort.abort(e);\n168:      this.abort.abort(e);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HCR9EfaDKtghjy3J7dwL3c","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
