{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H62r96k4fQDpk2ppyWa2iB","type":"tool_result","content":"=== src/tools/registry.ts\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport type { ContextSize } from \"../agent/context-size.js\";\n     3\timport { scanServer, type ServerMeta, type ToolMeta } from \"./metadata-scan.js\";\n     4\t\n     5\t// Tool identity is \"<serverId>__<toolName>\", where serverId is the id this deployment assigned in\n     6\t// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about\n     7\t// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.\n     8\t// Only servers listed in the manifest can contribute tools.\n     9\t\n    10\texport interface ConfiguredServer {\n    11\t  id: string;\n    12\t  url: string;\n    13\t  tlsCertSha256: string;\n    14\t}\n    15\t\n    16\texport interface InvokeOptions {\n    17\t  clinicId: string;\n    18\t  signal: AbortSignal;\n    19\t  runCtx: unknown;\n    20\t  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */\n    21\t  context: ContextSize;\n    22\t}\n    23\t\n    24\texport interface RegisteredTool {\n    25\t  key: string;\n    26\t  serverId: string;\n    27\t  name: string;\n    28\t  definition: Anthropic.Tool;\n    29\t  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;\n    30\t}\n    31\t\n    32\texport interface Conflict {\n    33\t  key: string;\n    34\t  conflictsWith: string;\n    35\t  kind: \"duplicate\" | \"lookalike\";\n    36\t}\n    37\t\n    38\tconst CONFUSABLES: Record<string, string> = { \"0\": \"o\", \"1\": \"l\", \"3\": \"e\", \"5\": \"s\", \"7\": \"t\", \"@\": \"a\", \"$\": \"s\" };\n    39\t\n    40\texport function canonical(name: string): string {\n    41\t  return name\n    42\t    .normalize(\"NFKC\")\n    43\t    .toLowerCase()\n    44\t    .replace(/rn/g, \"m\")\n    45\t    .replace(/vv/g, \"w\")\n    46\t    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)\n    47\t    .replace(/[^a-z]/g, \"\");\n    48\t}\n    49\t\n    50\tfunction editDistanceAtMostOne(a: string, b: string): boolean {\n    51\t  if (a === b) return true;\n    52\t  if (Math.abs(a.length - b.length) > 1) return false;\n    53\t  let i = 0;\n    54\t  let j = 0;\n    55\t  let edits = 0;\n    56\t  while (i < a.length && j < b.length) {\n    57\t    if (a[i] === b[j]) {\n    58\t      i++;\n    59\t      j++;\n    60\t      continue;\n    61\t    }\n    62\t    if (++edits > 1) return false;\n    63\t    if (a.length > b.length) i++;\n    64\t    else if (b.length > a.length) j++;\n    65\t    else {\n    66\t      i++;\n    67\t      j++;\n    68\t    }\n    69\t  }\n    70\t  return edits + (a.length - i) + (b.length - j) <= 1;\n    71\t}\n    72\t\n    73\texport class ToolRegistry {\n    74\t  private tools = new Map<string, RegisteredTool>();\n    75\t  readonly conflicts: Conflict[] = [];\n    76\t  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];\n    77\t\n    78\t  constructor(private servers: ConfiguredServer[]) {}\n    79\t\n    80\t  get(key: string): RegisteredTool | undefined {\n    81\t    return this.tools.get(key);\n    82\t  }\n    83\t\n    84\t  definitions(): Anthropic.Tool[] {\n    85\t    return [...this.tools.values()].map((t) => t.definition);\n    86\t  }\n    87\t\n    88\t  bareNamesExcept(serverId: string): Set<string> {\n    89\t    return new Set([...this.tools.values()].filter((t) => t.serverId !== serverId).map((t) => t.name));\n    90\t  }\n    91\t\n    92\t  /** Native tools are registered first so MCP metadata that names them is caught by the scanner. */\n    93\t  registerNative(serverId: string, tools: Array<Omit<RegisteredTool, \"key\" | \"serverId\">>): void {\n    94\t    for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\n    95\t  }\n    96\t\n    97\t  /**\n    98\t   * serverId must be one of the configured servers, and the caller must have connected using that\n    99\t   * server's pinned URL and certificate. reportedName is informational only.\n   100\t   */\n   101\t  registerMcp(\n   102\t    serverId: string,\n   103\t    reportedName: string | undefined,\n   104\t    meta: ServerMeta,\n   105\t    invoke: (tool: string, input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>,\n   106\t  ): void {\n   107\t    const cfg = this.servers.find((s) => s.id === serverId);\n   108\t    if (!cfg) {\n   109\t      this.rejected.push({ serverId, reason: `server not in release manifest (reported name ${reportedName ?? \"none\"})` });\n   110\t      return;\n   111\t    }\n   112\t    let scan;\n   113\t    try {\n   114\t      scan = scanServer(meta, this.bareNamesExcept(serverId));\n   115\t    } catch (err) {\n   116\t      this.rejected.push({ serverId, reason: `metadata scan error: ${(err as Error).message}` });\n   117\t      return;\n   118\t    }\n   119\t    if (scan.serverRejected) {\n   120\t      this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });\n   121\t      return;\n   122\t    }\n   123\t    for (const [tool, findings] of scan.rejectedTools) {\n   124\t      this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });\n   125\t    }\n   126\t    for (const t of scan.acceptedTools) {\n   127\t      this.add({\n   128\t        key: `${serverId}__${t.name}`,\n   129\t        serverId,\n   130\t        name: t.name,\n   131\t        definition: toDefinition(`${serverId}__${t.name}`, t),\n   132\t        invoke: (input, opts) => invoke(t.name, input, opts),\n   133\t      });\n   134\t    }\n   135\t  }\n   136\t\n   137\t  private add(t: RegisteredTool): void {\n   138\t    if (this.tools.has(t.key)) {\n   139\t      this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: \"duplicate\" });\n   140\t      this.rejected.push({ serverId: t.serverId, tool: t.name, reason: \"duplicate tool key\" });\n   141\t      return;\n   142\t    }\n   143\t    const c = canonical(t.name);\n   144\t    for (const existing of this.tools.values()) {\n   145\t      if (existing.serverId === t.serverId) continue;\n   146\t      if (existing.name === t.name) {\n   147\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"duplicate\" });\n   148\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });\n   149\t        return;\n   150\t      }\n   151\t      if (editDistanceAtMostOne(canonical(existing.name), c)) {\n   152\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"lookalike\" });\n   153\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `looks like ${existing.key}` });\n   154\t        return;\n   155\t      }\n   156\t    }\n   157\t    this.tools.set(t.key, t);\n   158\t  }\n   159\t}\n   160\t\n   161\tfunction toDefinition(key: string, t: ToolMeta): Anthropic.Tool {\n   162\t  return {\n   163\t    name: key,\n   164\t    description: t.description ?? \"\",\n   165\t    input_schema: (t.inputSchema as Anthropic.Tool.InputSchema) ?? { type: \"object\", properties: {} },\n   166\t  };\n   167\t}\n=== src/integrations/ehr-mcp.ts\n     1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n     2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n     3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     4\timport { Agent } from \"undici\";\n     5\timport type { PeerCertificate } from \"node:tls\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n     8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n     9\t\n    10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n    11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n    12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n    13\t\n    14\tconst sm = new SecretsManagerClient({ region: env.region });\n    15\t\n    16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n    17\t  const expected = server.tlsCertSha256.toLowerCase();\n    18\t  return new Agent({\n    19\t    connect: {\n    20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n    21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n    22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n    23\t      },\n    24\t    },\n    25\t  });\n    26\t}\n    27\t\n    28\ttype Token = { value: string; exp: number };\n    29\tconst tokens = new Map<string, Token>();\n    30\t\n    31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n    32\t  const cacheKey = `${clinicId}|${scope}`;\n    33\t  const hit = tokens.get(cacheKey);\n    34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n    35\t\n    36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n    37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n    38\t  const res = await fetch(token_url, {\n    39\t    method: \"POST\",\n    40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n    42\t  });\n    43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n    44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n    45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n    46\t  return body.access_token;\n    47\t}\n    48\t\n    49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n    50\tconst sessions = new Map<string, Client>();\n    51\t\n    52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n    53\t  const existing = sessions.get(clinicId);\n    54\t  if (existing) return existing;\n    55\t  const token = await ehrToken(clinicId, SCOPES);\n    56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    57\t    requestInit: {\n    58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n    59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n    60\t      dispatcher: pinnedDispatcher(server),\n    61\t    },\n    62\t  });\n    63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n    64\t  await client.connect(transport);\n    65\t  sessions.set(clinicId, client);\n    66\t  setTimeout(() => {\n    67\t    sessions.delete(clinicId);\n    68\t    void client.close();\n    69\t  }, 4 * 60_000).unref();\n    70\t  return client;\n    71\t}\n    72\t\n    73\texport function ehr(server: ConfiguredServer) {\n    74\t  return {\n    75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n    76\t      const c = await session(server, \"_catalog\");\n    77\t      const [tools, prompts, templates] = await Promise.all([\n    78\t        c.listTools(),\n    79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n    80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n    81\t      ]);\n    82\t      return {\n    83\t        reportedName: c.getServerVersion()?.name,\n    84\t        meta: {\n    85\t          instructions: c.getInstructions(),\n    86\t          tools: tools.tools as ServerMeta[\"tools\"],\n    87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n    88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n    89\t        },\n    90\t      };\n    91\t    },\n    92\t\n    93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n    94\t      const c = await session(server, opts.clinicId);\n    95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n    96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n    97\t      return res.structuredContent ?? res.content;\n    98\t    },\n    99\t\n   100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n   101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n   102\t        id: string;\n   103\t        patientId: string;\n   104\t        start: string;\n   105\t        serviceCode: string;\n   106\t        payerId?: string;\n   107\t        depositId?: string;\n   108\t        status: string;\n   109\t      };\n   110\t    },\n   111\t\n   112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n   113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n   114\t        id: string;\n   115\t        patientId: string;\n   116\t        start: string;\n   117\t        phone: string;\n   118\t        smsOptIn: boolean;\n   119\t        locationName: string;\n   120\t      }>;\n   121\t    },\n   122\t  };\n   123\t}\n   124\texport type Ehr = ReturnType<typeof ehr>;\n=== src/server.ts\n     1\timport Fastify from \"fastify\";\n     2\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     3\timport { env, manifest } from \"./config.js\";\n     4\timport { computeAgentTypeId, setAgentTypeId, AGENT_INSTANCE_ID } from \"./agent/identity.js\";\n     5\timport { killSwitch } from \"./control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"./integrations/ehr-mcp.js\";\n     7\timport { registerSmsWebhook } from \"./routes/sms-webhook.js\";\n     8\timport { registerWebchat } from \"./routes/webchat.js\";\n     9\timport { nativeTools } from \"./tools/executor.js\";\n    10\timport { ToolRegistry, type ConfiguredServer } from \"./tools/registry.js\";\n    11\t\n    12\tconst metrics = {\n    13\t  increment(name: string) {\n    14\t    process.stdout.write(JSON.stringify({ _aws: { CloudWatchMetrics: [{ Namespace: \"clinic-agent\", Metrics: [{ Name: name }] }] }, [name]: 1 }) + \"\\n\");\n    15\t  },\n    16\t};\n    17\t\n    18\tconst app = Fastify({\n    19\t  logger: {\n    20\t    level: process.env.LOG_LEVEL ?? \"info\",\n    21\t    redact: { paths: [\"req.headers.authorization\", 'req.headers[\"x-sms-signature\"]', \"req.headers.cookie\"], censor: \"[redacted]\" },\n    22\t  },\n    23\t  bodyLimit: 16_384,\n    24\t});\n    25\t\n    26\t// Identity check against the approved release manifest.\n    27\tconst typeId = computeAgentTypeId({\n    28\t  imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    29\t  harnessVersion: manifest.harness.version,\n    30\t  harnessGitSha: process.env.GIT_SHA ?? \"\",\n    31\t});\n    32\tif (typeId !== manifest.agentTypeId) {\n    33\t  app.log.error({ expected: manifest.agentTypeId, actual: typeId }, \"agent type id does not match release manifest\");\n    34\t  metrics.increment(\"identity.mismatch\");\n    35\t}\n    36\tsetAgentTypeId(typeId);\n    37\tapp.log.info({ agentTypeId: typeId, agentInstanceId: AGENT_INSTANCE_ID, release: manifest.release }, \"starting\");\n    38\t\n    39\t// Tools.\n    40\tconst servers: ConfiguredServer[] = manifest.tools.mcpServers;\n    41\tconst ehrServer = servers.find((s) => s.id === \"ehr\");\n    42\tif (!ehrServer) throw new Error(\"release manifest has no ehr server\");\n    43\tconst ehr = ehrClient(ehrServer);\n    44\t\n    45\tconst registry = new ToolRegistry(servers);\n    46\tfor (const [serverId, tools] of Object.entries(nativeTools(ehr))) registry.registerNative(serverId, tools);\n    47\ttry {\n    48\t  const { reportedName, meta } = await ehr.catalog();\n    49\t  registry.registerMcp(\"ehr\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\n    50\t} catch (err) {\n    51\t  app.log.error({ err }, \"EHR MCP catalog unavailable; EHR tools disabled\");\n    52\t}\n    53\tfor (const r of registry.rejected) app.log.warn(r, \"tool rejected at load\");\n    54\tfor (const c of registry.conflicts) app.log.warn(c, \"tool name conflict\");\n    55\t\n    56\t// Clinics.\n    57\tconst directory: Array<{ id: string; name: string; smsNumber: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    58\tconst byId = new Map(directory.map((c) => [c.id, c]));\n    59\tconst byNumber = new Map(directory.map((c) => [c.smsNumber, c]));\n    60\t\n    61\tconst sm = new SecretsManagerClient({ region: env.region });\n    62\tlet signingSecret: { value: string; at: number } | undefined;\n    63\tasync function smsSigningSecret(): Promise<string> {\n    64\t  if (signingSecret && Date.now() - signingSecret.at < 5 * 60_000) return signingSecret.value;\n    65\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: env.smsSigningSecretArn }));\n    66\t  signingSecret = { value: s.SecretString ?? \"\", at: Date.now() };\n    67\t  return signingSecret.value;\n    68\t}\n    69\t\n    70\tapp.addContentTypeParser(\"application/json\", { parseAs: \"string\" }, (req, body, done) => {\n    71\t  (req as { rawBody?: string }).rawBody = body as string;\n    72\t  try {\n    73\t    done(null, JSON.parse(body as string));\n    74\t  } catch (err) {\n    75\t    done(err as Error, undefined);\n    76\t  }\n    77\t});\n    78\t\n    79\tregisterSmsWebhook(app, {\n    80\t  registry,\n    81\t  signingSecret: smsSigningSecret,\n    82\t  clinicByNumber: (to) => byNumber.get(to),\n    83\t  metrics,\n    84\t});\n    85\tregisterWebchat(app, { registry, clinicById: (id) => byId.get(id) });\n    86\t\n    87\tapp.get(\"/healthz\", async () => ({ ok: true }));\n    88\t\n    89\tkillSwitch.startWatcher();\n    90\tawait app.listen({ host: \"0.0.0.0\", port: 8080 });\n=== src/tools/approvals.ts\n     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport { createHash, randomUUID } from \"node:crypto\";\n     4\timport { env, policy } from \"../config.js\";\n     5\t\n     6\t// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n     7\t// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n     8\t// approvedAt); the agent then retries the tool with the approval id.\n     9\t\n    10\texport interface ApprovalRecord {\n    11\t  id: string;\n    12\t  status: \"pending\" | \"approved\" | \"rejected\";\n    13\t  tool: string;\n    14\t  tenantId: string;\n    15\t  agentInstanceId: string;\n    16\t  runId: string;\n    17\t  argsHash: string;\n    18\t  summary: string;\n    19\t  requestedAt: string;\n    20\t  expiresAt: string;\n    21\t  approvedBy?: string;\n    22\t  approverRole?: string;\n    23\t  approvedAt?: string;\n    24\t}\n    25\t\n    26\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    27\t\n    28\texport function hashArgs(args: Record<string, unknown>): string {\n    29\t  const canonical = JSON.stringify(args, Object.keys(args).sort());\n    30\t  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n    31\t}\n    32\t\n    33\texport async function requestApproval(req: {\n    34\t  tool: string;\n    35\t  tenantId: string;\n    36\t  agentInstanceId: string;\n    37\t  runId: string;\n    38\t  args: Record<string, unknown>;\n    39\t  summary: string;\n    40\t}): Promise<ApprovalRecord> {\n    41\t  const now = Date.now();\n    42\t  const rec: ApprovalRecord = {\n    43\t    id: randomUUID(),\n    44\t    status: \"pending\",\n    45\t    tool: req.tool,\n    46\t    tenantId: req.tenantId,\n    47\t    agentInstanceId: req.agentInstanceId,\n    48\t    runId: req.runId,\n    49\t    argsHash: hashArgs(req.args),\n    50\t    summary: req.summary,\n    51\t    requestedAt: new Date(now).toISOString(),\n    52\t    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n    53\t  };\n    54\t  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n    55\t  return rec;\n    56\t}\n    57\t\n    58\texport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n    59\t\n    60\texport async function checkApproval(req: {\n    61\t  approvalId: string;\n    62\t  tool: string;\n    63\t  tenantId: string;\n    64\t  args: Record<string, unknown>;\n    65\t}): Promise<ApprovalCheck> {\n    66\t  let rec: ApprovalRecord | undefined;\n    67\t  try {\n    68\t    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    69\t    rec = res.Item as ApprovalRecord | undefined;\n    70\t  } catch (err) {\n    71\t    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n    72\t  }\n    73\t  if (!rec) return { ok: false, reason: \"approval not found\" };\n    74\t  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n    75\t  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n    76\t  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n    77\t  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n    78\t  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    79\t    return { ok: false, reason: \"approver lacks authority\" };\n    80\t  }\n    81\t  return { ok: true, approval: rec };\n    82\t}\n=== config/tools.allowlist.yaml\n     1\t# Every tool the scheduling agent may call, with the task it serves.\n     2\t# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n     3\t# are not used for allow or approval decisions.\n     4\trole: scheduling_agent\n     5\ttools:\n     6\t  - tool: ehr__find_patient\n     7\t    reason: Match the sender to a patient record by date of birth and phone or email.\n     8\t  - tool: ehr__search_slots\n     9\t    reason: List open slots for a provider, location, and visit type.\n    10\t  - tool: ehr__get_appointment\n    11\t    reason: Read one appointment the patient asks about.\n    12\t  - tool: ehr__list_patient_appointments\n    13\t    reason: Show the patient their upcoming appointments.\n    14\t  - tool: ehr__book_appointment\n    15\t    reason: Book a slot the patient chose.\n    16\t  - tool: ehr__update_appointment\n    17\t    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n    18\t  - tool: ehr__cancel_appointment\n    19\t    reason: Cancel an appointment at the patient's request.\n    20\t  - tool: payments__refund_deposit\n    21\t    reason: Refund a no-show deposit after staff review.\n    22\t  - tool: sms__send_to_patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.","is_error":false}]},"parent_tool_use_id":null,"session_id":"0de488e7-937f-49f5-af13-02cd18e903c1","uuid":"c51ceb33-248a-4bad-968e-6efb44a20d01","timestamp":"2026-10-20T15:51:18.578Z","tool_use_result":{"stdout":"=== src/tools/registry.ts\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport type { ContextSize } from \"../agent/context-size.js\";\n     3\timport { scanServer, type ServerMeta, type ToolMeta } from \"./metadata-scan.js\";\n     4\t\n     5\t// Tool identity is \"<serverId>__<toolName>\", where serverId is the id this deployment assigned in\n     6\t// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about\n     7\t// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.\n     8\t// Only servers listed in the manifest can contribute tools.\n     9\t\n    10\texport interface ConfiguredServer {\n    11\t  id: string;\n    12\t  url: string;\n    13\t  tlsCertSha256: string;\n    14\t}\n    15\t\n    16\texport interface InvokeOptions {\n    17\t  clinicId: string;\n    18\t  signal: AbortSignal;\n    19\t  runCtx: unknown;\n    20\t  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */\n    21\t  context: ContextSize;\n    22\t}\n    23\t\n    24\texport interface RegisteredTool {\n    25\t  key: string;\n    26\t  serverId: string;\n    27\t  name: string;\n    28\t  definition: Anthropic.Tool;\n    29\t  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;\n    30\t}\n    31\t\n    32\texport interface Conflict {\n    33\t  key: string;\n    34\t  conflictsWith: string;\n    35\t  kind: \"duplicate\" | \"lookalike\";\n    36\t}\n    37\t\n    38\tconst CONFUSABLES: Record<string, string> = { \"0\": \"o\", \"1\": \"l\", \"3\": \"e\", \"5\": \"s\", \"7\": \"t\", \"@\": \"a\", \"$\": \"s\" };\n    39\t\n    40\texport function canonical(name: string): string {\n    41\t  return name\n    42\t    .normalize(\"NFKC\")\n    43\t    .toLowerCase()\n    44\t    .replace(/rn/g, \"m\")\n    45\t    .replace(/vv/g, \"w\")\n    46\t    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)\n    47\t    .replace(/[^a-z]/g, \"\");\n    48\t}\n    49\t\n    50\tfunction editDistanceAtMostOne(a: string, b: string): boolean {\n    51\t  if (a === b) return true;\n    52\t  if (Math.abs(a.length - b.length) > 1) return false;\n    53\t  let i = 0;\n    54\t  let j = 0;\n    55\t  let edits = 0;\n    56\t  while (i < a.length && j < b.length) {\n    57\t    if (a[i] === b[j]) {\n    58\t      i++;\n    59\t      j++;\n    60\t      continue;\n    61\t    }\n    62\t    if (++edits > 1) return false;\n    63\t    if (a.length > b.length) i++;\n    64\t    else if (b.length > a.length) j++;\n    65\t    else {\n    66\t      i++;\n    67\t      j++;\n    68\t    }\n    69\t  }\n    70\t  return edits + (a.length - i) + (b.length - j) <= 1;\n    71\t}\n    72\t\n    73\texport class ToolRegistry {\n    74\t  private tools = new Map<string, RegisteredTool>();\n    75\t  readonly conflicts: Conflict[] = [];\n    76\t  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];\n    77\t\n    78\t  constructor(private servers: ConfiguredServer[]) {}\n    79\t\n    80\t  get(key: string): RegisteredTool | undefined {\n    81\t    return this.tools.get(key);\n    82\t  }\n    83\t\n    84\t  definitions(): Anthropic.Tool[] {\n    85\t    return [...this.tools.values()].map((t) => t.definition);\n    86\t  }\n    87\t\n    88\t  bareNamesExcept(serverId: string): Set<string> {\n    89\t    return new Set([...this.tools.values()].filter((t) => t.serverId !== serverId).map((t) => t.name));\n    90\t  }\n    91\t\n    92\t  /** Native tools are registered first so MCP metadata that names them is caught by the scanner. */\n    93\t  registerNative(serverId: string, tools: Array<Omit<RegisteredTool, \"key\" | \"serverId\">>): void {\n    94\t    for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\n    95\t  }\n    96\t\n    97\t  /**\n    98\t   * serverId must be one of the configured servers, and the caller must have connected using that\n    99\t   * server's pinned URL and certificate. reportedName is informational only.\n   100\t   */\n   101\t  registerMcp(\n   102\t    serverId: string,\n   103\t    reportedName: string | undefined,\n   104\t    meta: ServerMeta,\n   105\t    invoke: (tool: string, input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>,\n   106\t  ): void {\n   107\t    const cfg = this.servers.find((s) => s.id === serverId);\n   108\t    if (!cfg) {\n   109\t      this.rejected.push({ serverId, reason: `server not in release manifest (reported name ${reportedName ?? \"none\"})` });\n   110\t      return;\n   111\t    }\n   112\t    let scan;\n   113\t    try {\n   114\t      scan = scanServer(meta, this.bareNamesExcept(serverId));\n   115\t    } catch (err) {\n   116\t      this.rejected.push({ serverId, reason: `metadata scan error: ${(err as Error).message}` });\n   117\t      return;\n   118\t    }\n   119\t    if (scan.serverRejected) {\n   120\t      this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });\n   121\t      return;\n   122\t    }\n   123\t    for (const [tool, findings] of scan.rejectedTools) {\n   124\t      this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });\n   125\t    }\n   126\t    for (const t of scan.acceptedTools) {\n   127\t      this.add({\n   128\t        key: `${serverId}__${t.name}`,\n   129\t        serverId,\n   130\t        name: t.name,\n   131\t        definition: toDefinition(`${serverId}__${t.name}`, t),\n   132\t        invoke: (input, opts) => invoke(t.name, input, opts),\n   133\t      });\n   134\t    }\n   135\t  }\n   136\t\n   137\t  private add(t: RegisteredTool): void {\n   138\t    if (this.tools.has(t.key)) {\n   139\t      this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: \"duplicate\" });\n   140\t      this.rejected.push({ serverId: t.serverId, tool: t.name, reason: \"duplicate tool key\" });\n   141\t      return;\n   142\t    }\n   143\t    const c = canonical(t.name);\n   144\t    for (const existing of this.tools.values()) {\n   145\t      if (existing.serverId === t.serverId) continue;\n   146\t      if (existing.name === t.name) {\n   147\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"duplicate\" });\n   148\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });\n   149\t        return;\n   150\t      }\n   151\t      if (editDistanceAtMostOne(canonical(existing.name), c)) {\n   152\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"lookalike\" });\n   153\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `looks like ${existing.key}` });\n   154\t        return;\n   155\t      }\n   156\t    }\n   157\t    this.tools.set(t.key, t);\n   158\t  }\n   159\t}\n   160\t\n   161\tfunction toDefinition(key: string, t: ToolMeta): Anthropic.Tool {\n   162\t  return {\n   163\t    name: key,\n   164\t    description: t.description ?? \"\",\n   165\t    input_schema: (t.inputSchema as Anthropic.Tool.InputSchema) ?? { type: \"object\", properties: {} },\n   166\t  };\n   167\t}\n=== src/integrations/ehr-mcp.ts\n     1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n     2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n     3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     4\timport { Agent } from \"undici\";\n     5\timport type { PeerCertificate } from \"node:tls\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n     8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n     9\t\n    10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n    11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n    12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n    13\t\n    14\tconst sm = new SecretsManagerClient({ region: env.region });\n    15\t\n    16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n    17\t  const expected = server.tlsCertSha256.toLowerCase();\n    18\t  return new Agent({\n    19\t    connect: {\n    20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n    21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n    22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n    23\t      },\n    24\t    },\n    25\t  });\n    26\t}\n    27\t\n    28\ttype Token = { value: string; exp: number };\n    29\tconst tokens = new Map<string, Token>();\n    30\t\n    31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n    32\t  const cacheKey = `${clinicId}|${scope}`;\n    33\t  const hit = tokens.get(cacheKey);\n    34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n    35\t\n    36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n    37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n    38\t  const res = await fetch(token_url, {\n    39\t    method: \"POST\",\n    40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n    42\t  });\n    43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n    44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n    45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n    46\t  return body.access_token;\n    47\t}\n    48\t\n    49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n    50\tconst sessions = new Map<string, Client>();\n    51\t\n    52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n    53\t  const existing = sessions.get(clinicId);\n    54\t  if (existing) return existing;\n    55\t  const token = await ehrToken(clinicId, SCOPES);\n    56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    57\t    requestInit: {\n    58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n    59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n    60\t      dispatcher: pinnedDispatcher(server),\n    61\t    },\n    62\t  });\n    63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n    64\t  await client.connect(transport);\n    65\t  sessions.set(clinicId, client);\n    66\t  setTimeout(() => {\n    67\t    sessions.delete(clinicId);\n    68\t    void client.close();\n    69\t  }, 4 * 60_000).unref();\n    70\t  return client;\n    71\t}\n    72\t\n    73\texport function ehr(server: ConfiguredServer) {\n    74\t  return {\n    75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n    76\t      const c = await session(server, \"_catalog\");\n    77\t      const [tools, prompts, templates] = await Promise.all([\n    78\t        c.listTools(),\n    79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n    80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n    81\t      ]);\n    82\t      return {\n    83\t        reportedName: c.getServerVersion()?.name,\n    84\t        meta: {\n    85\t          instructions: c.getInstructions(),\n    86\t          tools: tools.tools as ServerMeta[\"tools\"],\n    87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n    88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n    89\t        },\n    90\t      };\n    91\t    },\n    92\t\n    93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n    94\t      const c = await session(server, opts.clinicId);\n    95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n    96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n    97\t      return res.structuredContent ?? res.content;\n    98\t    },\n    99\t\n   100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n   101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n   102\t        id: string;\n   103\t        patientId: string;\n   104\t        start: string;\n   105\t        serviceCode: string;\n   106\t        payerId?: string;\n   107\t        depositId?: string;\n   108\t        status: string;\n   109\t      };\n   110\t    },\n   111\t\n   112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n   113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n   114\t        id: string;\n   115\t        patientId: string;\n   116\t        start: string;\n   117\t        phone: string;\n   118\t        smsOptIn: boolean;\n   119\t        locationName: string;\n   120\t      }>;\n   121\t    },\n   122\t  };\n   123\t}\n   124\texport type Ehr = ReturnType<typeof ehr>;\n=== src/server.ts\n     1\timport Fastify from \"fastify\";\n     2\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     3\timport { env, manifest } from \"./config.js\";\n     4\timport { computeAgentTypeId, setAgentTypeId, AGENT_INSTANCE_ID } from \"./agent/identity.js\";\n     5\timport { killSwitch } from \"./control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"./integrations/ehr-mcp.js\";\n     7\timport { registerSmsWebhook } from \"./routes/sms-webhook.js\";\n     8\timport { registerWebchat } from \"./routes/webchat.js\";\n     9\timport { nativeTools } from \"./tools/executor.js\";\n    10\timport { ToolRegistry, type ConfiguredServer } from \"./tools/registry.js\";\n    11\t\n    12\tconst metrics = {\n    13\t  increment(name: string) {\n    14\t    process.stdout.write(JSON.stringify({ _aws: { CloudWatchMetrics: [{ Namespace: \"clinic-agent\", Metrics: [{ Name: name }] }] }, [name]: 1 }) + \"\\n\");\n    15\t  },\n    16\t};\n    17\t\n    18\tconst app = Fastify({\n    19\t  logger: {\n    20\t    level: process.env.LOG_LEVEL ?? \"info\",\n    21\t    redact: { paths: [\"req.headers.authorization\", 'req.headers[\"x-sms-signature\"]', \"req.headers.cookie\"], censor: \"[redacted]\" },\n    22\t  },\n    23\t  bodyLimit: 16_384,\n    24\t});\n    25\t\n    26\t// Identity check against the approved release manifest.\n    27\tconst typeId = computeAgentTypeId({\n    28\t  imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    29\t  harnessVersion: manifest.harness.version,\n    30\t  harnessGitSha: process.env.GIT_SHA ?? \"\",\n    31\t});\n    32\tif (typeId !== manifest.agentTypeId) {\n    33\t  app.log.error({ expected: manifest.agentTypeId, actual: typeId }, \"agent type id does not match release manifest\");\n    34\t  metrics.increment(\"identity.mismatch\");\n    35\t}\n    36\tsetAgentTypeId(typeId);\n    37\tapp.log.info({ agentTypeId: typeId, agentInstanceId: AGENT_INSTANCE_ID, release: manifest.release }, \"starting\");\n    38\t\n    39\t// Tools.\n    40\tconst servers: ConfiguredServer[] = manifest.tools.mcpServers;\n    41\tconst ehrServer = servers.find((s) => s.id === \"ehr\");\n    42\tif (!ehrServer) throw new Error(\"release manifest has no ehr server\");\n    43\tconst ehr = ehrClient(ehrServer);\n    44\t\n    45\tconst registry = new ToolRegistry(servers);\n    46\tfor (const [serverId, tools] of Object.entries(nativeTools(ehr))) registry.registerNative(serverId, tools);\n    47\ttry {\n    48\t  const { reportedName, meta } = await ehr.catalog();\n    49\t  registry.registerMcp(\"ehr\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\n    50\t} catch (err) {\n    51\t  app.log.error({ err }, \"EHR MCP catalog unavailable; EHR tools disabled\");\n    52\t}\n    53\tfor (const r of registry.rejected) app.log.warn(r, \"tool rejected at load\");\n    54\tfor (const c of registry.conflicts) app.log.warn(c, \"tool name conflict\");\n    55\t\n    56\t// Clinics.\n    57\tconst directory: Array<{ id: string; name: string; smsNumber: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    58\tconst byId = new Map(directory.map((c) => [c.id, c]));\n    59\tconst byNumber = new Map(directory.map((c) => [c.smsNumber, c]));\n    60\t\n    61\tconst sm = new SecretsManagerClient({ region: env.region });\n    62\tlet signingSecret: { value: string; at: number } | undefined;\n    63\tasync function smsSigningSecret(): Promise<string> {\n    64\t  if (signingSecret && Date.now() - signingSecret.at < 5 * 60_000) return signingSecret.value;\n    65\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: env.smsSigningSecretArn }));\n    66\t  signingSecret = { value: s.SecretString ?? \"\", at: Date.now() };\n    67\t  return signingSecret.value;\n    68\t}\n    69\t\n    70\tapp.addContentTypeParser(\"application/json\", { parseAs: \"string\" }, (req, body, done) => {\n    71\t  (req as { rawBody?: string }).rawBody = body as string;\n    72\t  try {\n    73\t    done(null, JSON.parse(body as string));\n    74\t  } catch (err) {\n    75\t    done(err as Error, undefined);\n    76\t  }\n    77\t});\n    78\t\n    79\tregisterSmsWebhook(app, {\n    80\t  registry,\n    81\t  signingSecret: smsSigningSecret,\n    82\t  clinicByNumber: (to) => byNumber.get(to),\n    83\t  metrics,\n    84\t});\n    85\tregisterWebchat(app, { registry, clinicById: (id) => byId.get(id) });\n    86\t\n    87\tapp.get(\"/healthz\", async () => ({ ok: true }));\n    88\t\n    89\tkillSwitch.startWatcher();\n    90\tawait app.listen({ host: \"0.0.0.0\", port: 8080 });\n=== src/tools/approvals.ts\n     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport { createHash, randomUUID } from \"node:crypto\";\n     4\timport { env, policy } from \"../config.js\";\n     5\t\n     6\t// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n     7\t// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n     8\t// approvedAt); the agent then retries the tool with the approval id.\n     9\t\n    10\texport interface ApprovalRecord {\n    11\t  id: string;\n    12\t  status: \"pending\" | \"approved\" | \"rejected\";\n    13\t  tool: string;\n    14\t  tenantId: string;\n    15\t  agentInstanceId: string;\n    16\t  runId: string;\n    17\t  argsHash: string;\n    18\t  summary: string;\n    19\t  requestedAt: string;\n    20\t  expiresAt: string;\n    21\t  approvedBy?: string;\n    22\t  approverRole?: string;\n    23\t  approvedAt?: string;\n    24\t}\n    25\t\n    26\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    27\t\n    28\texport function hashArgs(args: Record<string, unknown>): string {\n    29\t  const canonical = JSON.stringify(args, Object.keys(args).sort());\n    30\t  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n    31\t}\n    32\t\n    33\texport async function requestApproval(req: {\n    34\t  tool: string;\n    35\t  tenantId: string;\n    36\t  agentInstanceId: string;\n    37\t  runId: string;\n    38\t  args: Record<string, unknown>;\n    39\t  summary: string;\n    40\t}): Promise<ApprovalRecord> {\n    41\t  const now = Date.now();\n    42\t  const rec: ApprovalRecord = {\n    43\t    id: randomUUID(),\n    44\t    status: \"pending\",\n    45\t    tool: req.tool,\n    46\t    tenantId: req.tenantId,\n    47\t    agentInstanceId: req.agentInstanceId,\n    48\t    runId: req.runId,\n    49\t    argsHash: hashArgs(req.args),\n    50\t    summary: req.summary,\n    51\t    requestedAt: new Date(now).toISOString(),\n    52\t    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n    53\t  };\n    54\t  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n    55\t  return rec;\n    56\t}\n    57\t\n    58\texport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n    59\t\n    60\texport async function checkApproval(req: {\n    61\t  approvalId: string;\n    62\t  tool: string;\n    63\t  tenantId: string;\n    64\t  args: Record<string, unknown>;\n    65\t}): Promise<ApprovalCheck> {\n    66\t  let rec: ApprovalRecord | undefined;\n    67\t  try {\n    68\t    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    69\t    rec = res.Item as ApprovalRecord | undefined;\n    70\t  } catch (err) {\n    71\t    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n    72\t  }\n    73\t  if (!rec) return { ok: false, reason: \"approval not found\" };\n    74\t  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n    75\t  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n    76\t  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n    77\t  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n    78\t  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    79\t    return { ok: false, reason: \"approver lacks authority\" };\n    80\t  }\n    81\t  return { ok: true, approval: rec };\n    82\t}\n=== config/tools.allowlist.yaml\n     1\t# Every tool the scheduling agent may call, with the task it serves.\n     2\t# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n     3\t# are not used for allow or approval decisions.\n     4\trole: scheduling_agent\n     5\ttools:\n     6\t  - tool: ehr__find_patient\n     7\t    reason: Match the sender to a patient record by date of birth and phone or email.\n     8\t  - tool: ehr__search_slots\n     9\t    reason: List open slots for a provider, location, and visit type.\n    10\t  - tool: ehr__get_appointment\n    11\t    reason: Read one appointment the patient asks about.\n    12\t  - tool: ehr__list_patient_appointments\n    13\t    reason: Show the patient their upcoming appointments.\n    14\t  - tool: ehr__book_appointment\n    15\t    reason: Book a slot the patient chose.\n    16\t  - tool: ehr__update_appointment\n    17\t    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n    18\t  - tool: ehr__cancel_appointment\n    19\t    reason: Cancel an appointment at the patient's request.\n    20\t  - tool: payments__refund_deposit\n    21\t    reason: Refund a no-show deposit after staff review.\n    22\t  - tool: sms__send_to_patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01H62r96k4fQDpk2ppyWa2iB","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
