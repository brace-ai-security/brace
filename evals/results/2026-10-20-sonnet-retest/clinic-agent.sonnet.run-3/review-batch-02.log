{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TBepprHdJyriGV6NrQXgtU","type":"tool_result","content":"     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport { createHash, randomUUID } from \"node:crypto\";\n     4\timport { env, policy } from \"../config.js\";\n     5\t\n     6\t// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n     7\t// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n     8\t// approvedAt); the agent then retries the tool with the approval id.\n     9\t\n    10\texport interface ApprovalRecord {\n    11\t  id: string;\n    12\t  status: \"pending\" | \"approved\" | \"rejected\";\n    13\t  tool: string;\n    14\t  tenantId: string;\n    15\t  agentInstanceId: string;\n    16\t  runId: string;\n    17\t  argsHash: string;\n    18\t  summary: string;\n    19\t  requestedAt: string;\n    20\t  expiresAt: string;\n    21\t  approvedBy?: string;\n    22\t  approverRole?: string;\n    23\t  approvedAt?: string;\n    24\t}\n    25\t\n    26\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    27\t\n    28\texport function hashArgs(args: Record<string, unknown>): string {\n    29\t  const canonical = JSON.stringify(args, Object.keys(args).sort());\n    30\t  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n    31\t}\n    32\t\n    33\texport async function requestApproval(req: {\n    34\t  tool: string;\n    35\t  tenantId: string;\n    36\t  agentInstanceId: string;\n    37\t  runId: string;\n    38\t  args: Record<string, unknown>;\n    39\t  summary: string;\n    40\t}): Promise<ApprovalRecord> {\n    41\t  const now = Date.now();\n    42\t  const rec: ApprovalRecord = {\n    43\t    id: randomUUID(),\n    44\t    status: \"pending\",\n    45\t    tool: req.tool,\n    46\t    tenantId: req.tenantId,\n    47\t    agentInstanceId: req.agentInstanceId,\n    48\t    runId: req.runId,\n    49\t    argsHash: hashArgs(req.args),\n    50\t    summary: req.summary,\n    51\t    requestedAt: new Date(now).toISOString(),\n    52\t    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n    53\t  };\n    54\t  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n    55\t  return rec;\n    56\t}\n    57\t\n    58\texport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n    59\t\n    60\texport async function checkApproval(req: {\n    61\t  approvalId: string;\n    62\t  tool: string;\n    63\t  tenantId: string;\n    64\t  args: Record<string, unknown>;\n    65\t}): Promise<ApprovalCheck> {\n    66\t  let rec: ApprovalRecord | undefined;\n    67\t  try {\n    68\t    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    69\t    rec = res.Item as ApprovalRecord | undefined;\n    70\t  } catch (err) {\n    71\t    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n    72\t  }\n    73\t  if (!rec) return { ok: false, reason: \"approval not found\" };\n    74\t  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n    75\t  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n    76\t  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n    77\t  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n    78\t  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    79\t    return { ok: false, reason: \"approver lacks authority\" };\n    80\t  }\n    81\t  return { ok: true, approval: rec };\n    82\t}\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: clinic-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.33\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: clinic-agent\n    15\t  namespace: clinic-agent\n    16\t  annotations:\n    17\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    18\t    eks.amazonaws.com/token-expiration: \"3600\"\n    19\tautomountServiceAccountToken: false\n    20\t---\n    21\tapiVersion: v1\n    22\tkind: ServiceAccount\n    23\tmetadata:\n    24\t  name: clinic-agent-reminders\n    25\t  namespace: clinic-agent\n    26\t  annotations:\n    27\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    28\tautomountServiceAccountToken: false\n    29\t---\n    30\tapiVersion: v1\n    31\tkind: ConfigMap\n    32\tmetadata:\n    33\t  name: clinic-agent\n    34\t  namespace: clinic-agent\n    35\tdata:\n    36\t  CLINIC_DIRECTORY: |\n    37\t    [{\"id\":\"nb-castro\",\"name\":\"Northbay Castro\",\"smsNumber\":\"+14155550110\"},\n    38\t     {\"id\":\"nb-fremont\",\"name\":\"Northbay Fremont\",\"smsNumber\":\"+15105550111\"},\n    39\t     {\"id\":\"nb-oakland\",\"name\":\"Northbay Oakland\",\"smsNumber\":\"+15105550112\"},\n    40\t     {\"id\":\"nb-sanmateo\",\"name\":\"Northbay San Mateo\",\"smsNumber\":\"+16505550113\"},\n    41\t     {\"id\":\"nb-walnutcreek\",\"name\":\"Northbay Walnut Creek\",\"smsNumber\":\"+19255550114\"}]\n    42\t  SMS_SIGNING_SECRET_ARN: arn:aws:secretsmanager:us-west-2:418295730611:secret:clinic-agent/sms-signing\n    43\t  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n    44\t  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n    45\t---\n    46\tapiVersion: apps/v1\n    47\tkind: Deployment\n    48\tmetadata:\n    49\t  name: clinic-agent\n    50\t  namespace: clinic-agent\n    51\t  labels: { app: clinic-agent }\n    52\tspec:\n    53\t  replicas: 3\n    54\t  selector:\n    55\t    matchLabels: { app: clinic-agent }\n    56\t  template:\n    57\t    metadata:\n    58\t      labels: { app: clinic-agent }\n    59\t    spec:\n    60\t      serviceAccountName: clinic-agent\n    61\t      automountServiceAccountToken: false\n    62\t      hostUsers: false\n    63\t      hostNetwork: false\n    64\t      hostPID: false\n    65\t      hostIPC: false\n    66\t      enableServiceLinks: false\n    67\t      securityContext:\n    68\t        runAsNonRoot: true\n    69\t        runAsUser: 65532\n    70\t        runAsGroup: 65532\n    71\t        fsGroup: 65532\n    72\t        seccompProfile:\n    73\t          type: RuntimeDefault\n    74\t      containers:\n    75\t        - name: agent\n    76\t          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    77\t          ports:\n    78\t            - containerPort: 8080\n    79\t          envFrom:\n    80\t            - configMapRef: { name: clinic-agent }\n    81\t          env:\n    82\t            - name: IMAGE_DIGEST\n    83\t              value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    84\t            - name: GIT_SHA\n    85\t              value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n    86\t          securityContext:\n    87\t            allowPrivilegeEscalation: false\n    88\t            privileged: false\n    89\t            readOnlyRootFilesystem: true\n    90\t            runAsNonRoot: true\n    91\t            capabilities:\n    92\t              drop: [\"ALL\"]\n    93\t            seccompProfile:\n    94\t              type: RuntimeDefault\n    95\t          resources:\n    96\t            requests: { cpu: 250m, memory: 384Mi }\n    97\t            limits: { cpu: \"1\", memory: 768Mi }\n    98\t          readinessProbe:\n    99\t            httpGet: { path: /healthz, port: 8080 }\n   100\t          volumeMounts:\n   101\t            - { name: tmp, mountPath: /tmp }\n   102\t            - { name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true }\n   103\t      volumes:\n   104\t        - name: tmp\n   105\t          emptyDir: { medium: Memory, sizeLimit: 32Mi }\n   106\t        - name: sts-token\n   107\t          projected:\n   108\t            sources:\n   109\t              - serviceAccountToken:\n   110\t                  audience: https://sts.northbay-clinics.example\n   111\t                  expirationSeconds: 900\n   112\t                  path: sts-token\n   113\t---\n   114\tapiVersion: batch/v1\n   115\tkind: CronJob\n   116\tmetadata:\n   117\t  name: clinic-agent-reminders\n   118\t  namespace: clinic-agent\n   119\tspec:\n   120\t  schedule: \"0 17 * * *\"\n   121\t  timeZone: America/Los_Angeles\n   122\t  concurrencyPolicy: Forbid\n   123\t  jobTemplate:\n   124\t    spec:\n   125\t      backoffLimit: 0\n   126\t      activeDeadlineSeconds: 1800\n   127\t      template:\n   128\t        metadata:\n   129\t          labels: { app: clinic-agent-reminders }\n   130\t        spec:\n   131\t          serviceAccountName: clinic-agent-reminders\n   132\t          automountServiceAccountToken: false\n   133\t          restartPolicy: Never\n   134\t          hostUsers: false\n   135\t          securityContext:\n   136\t            runAsNonRoot: true\n   137\t            runAsUser: 65532\n   138\t            runAsGroup: 65532\n   139\t            seccompProfile:\n   140\t              type: RuntimeDefault\n   141\t          containers:\n   142\t            - name: reminders\n   143\t              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   144\t              args: [\"dist/workers/reminders.js\"]\n   145\t              envFrom:\n   146\t                - configMapRef: { name: clinic-agent }\n   147\t              env:\n   148\t                - name: IMAGE_DIGEST\n   149\t                  value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   150\t                - name: GIT_SHA\n   151\t                  value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n   152\t              securityContext:\n   153\t                allowPrivilegeEscalation: false\n   154\t                privileged: false\n   155\t                readOnlyRootFilesystem: true\n   156\t                capabilities:\n   157\t                  drop: [\"ALL\"]\n   158\t---\n   159\t# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n   160\t# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,\n   161\t# the group STS and auth service, and AWS service endpoints.\n   162\tapiVersion: networking.k8s.io/v1\n   163\tkind: NetworkPolicy\n   164\tmetadata:\n   165\t  name: clinic-agent-egress\n   166\t  namespace: clinic-agent\n   167\tspec:\n   168\t  podSelector: {}\n   169\t  policyTypes: [\"Egress\", \"Ingress\"]\n   170\t  ingress:\n   171\t    - from:\n   172\t        - namespaceSelector:\n   173\t            matchLabels: { kubernetes.io/metadata.name: ingress }\n   174\t      ports:\n   175\t        - { port: 8080, protocol: TCP }\n   176\t  egress:\n   177\t    - to:\n   178\t        - namespaceSelector:\n   179\t            matchLabels: { kubernetes.io/metadata.name: kube-system }\n   180\t          podSelector:\n   181\t            matchLabels: { k8s-app: kube-dns }\n   182\t      ports:\n   183\t        - { port: 53, protocol: UDP }\n   184\t        - { port: 53, protocol: TCP }\n   185\t    - to:\n   186\t        - namespaceSelector:\n   187\t            matchLabels: { kubernetes.io/metadata.name: platform }\n   188\t          podSelector:\n   189\t            matchLabels: { app: egress-proxy }\n   190\t      ports:\n   191\t        - { port: 3128, protocol: TCP }\n   192\t    - to:\n   193\t        - ipBlock: { cidr: 10.60.12.0/28 }\n   194\t      ports:\n   195\t        - { port: 443, protocol: TCP }\n     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    16\t      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5.0.0\n    17\t        with:\n    18\t          node-version: \"22.11\"\n    19\t          cache: npm\n    20\t      - run: npm ci --ignore-scripts\n    21\t      - run: npm run lint\n    22\t      - run: npm test\n    23\t      - run: npm run build\n    24\t\n    25\t  manifest-check:\n    26\t    runs-on: ubuntu-24.04\n    27\t    steps:\n    28\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    29\t      - name: Prompt digests match the release manifest\n    30\t        run: |\n    31\t          node -e '\n    32\t            const fs = require(\"fs\"), crypto = require(\"crypto\");\n    33\t            const m = JSON.parse(fs.readFileSync(\"release/manifest.json\", \"utf8\"));\n    34\t            let bad = 0;\n    35\t            for (const p of m.prompts) {\n    36\t              const got = crypto.createHash(\"sha256\").update(fs.readFileSync(p.path)).digest(\"hex\");\n    37\t              if (got !== p.sha256) { console.error(`${p.path}: manifest ${p.sha256} != file ${got}`); bad++; }\n    38\t            }\n    39\t            const ver = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\")).version;\n    40\t            if (m.harness.version !== ver) { console.error(`harness version ${m.harness.version} != package ${ver}`); bad++; }\n    41\t            process.exit(bad ? 1 : 0);\n    42\t          '\n    43\t\n    44\t  image:\n    45\t    if: github.ref == 'refs/heads/main'\n    46\t    needs: [test, manifest-check]\n    47\t    runs-on: ubuntu-24.04\n    48\t    permissions:\n    49\t      contents: read\n    50\t      id-token: write\n    51\t      attestations: write\n    52\t      packages: write\n    53\t    steps:\n    54\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    55\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    56\t        with:\n    57\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-image-build\n    58\t          aws-region: us-west-2\n    59\t      - uses: aws-actions/amazon-ecr-login@062b18b96a7aff071d4dc91bc00c4c1a7945b076 # v2.0.1\n    60\t        id: ecr\n    61\t      - uses: docker/setup-buildx-action@e468171a9de216ec08956ac3ada2f0791b6bd435 # v3.11.1\n    62\t      - uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    63\t        id: build\n    64\t        with:\n    65\t          push: true\n    66\t          tags: ${{ steps.ecr.outputs.registry }}/clinic-agent:${{ github.sha }}\n    67\t          provenance: mode=max\n    68\t          sbom: true\n    69\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    70\t        with:\n    71\t          cosign-release: v2.6.2\n    72\t      - name: Sign image\n    73\t        run: cosign sign --yes ${{ steps.ecr.outputs.registry }}/clinic-agent@${{ steps.build.outputs.digest }}\n    74\t      - uses: actions/attest-build-provenance@977bb373ede98d70efdf65b84cb5f73e068dcc2a # v3.0.0\n    75\t        with:\n    76\t          subject-name: ${{ steps.ecr.outputs.registry }}/clinic-agent\n    77\t          subject-digest: ${{ steps.build.outputs.digest }}\n    78\t          push-to-registry: true\n     1\tname: deploy\n     2\t\n     3\t# Deploys the image digest named in release/manifest.json. The digest reaches the manifest through\n     4\t# a reviewed release PR, so what runs is always a reviewed commit.\n     5\ton:\n     6\t  workflow_dispatch:\n     7\t    inputs:\n     8\t      emergency:\n     9\t        description: Emergency change (hotfix/* branch, production-emergency environment)\n    10\t        type: boolean\n    11\t        default: false\n    12\t      owner:\n    13\t        description: Emergency only - person accountable for this change\n    14\t        type: string\n    15\t        default: \"\"\n    16\t      reason:\n    17\t        description: Emergency only - why this cannot wait for a normal release\n    18\t        type: string\n    19\t        default: \"\"\n    20\t      expires_on:\n    21\t        description: Emergency only - date (YYYY-MM-DD) by which it is replaced by a normal release\n    22\t        type: string\n    23\t        default: \"\"\n    24\t\n    25\tpermissions:\n    26\t  contents: read\n    27\t  id-token: write\n    28\t  issues: write\n    29\t\n    30\tconcurrency:\n    31\t  group: deploy-production\n    32\t  cancel-in-progress: false\n    33\t\n    34\tjobs:\n    35\t  deploy:\n    36\t    runs-on: ubuntu-24.04\n    37\t    environment: ${{ inputs.emergency && 'production-emergency' || 'production' }}\n    38\t    steps:\n    39\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    40\t\n    41\t      - name: Emergency change record is complete\n    42\t        if: inputs.emergency\n    43\t        env:\n    44\t          OWNER: ${{ inputs.owner }}\n    45\t          REASON: ${{ inputs.reason }}\n    46\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    47\t        run: |\n    48\t          test -n \"$OWNER\" || { echo \"owner is required\"; exit 1; }\n    49\t          test -n \"$REASON\" || { echo \"reason is required\"; exit 1; }\n    50\t          date -d \"$EXPIRES_ON\" +%F >/dev/null || { echo \"expires_on must be a date\"; exit 1; }\n    51\t          [[ \"$GITHUB_REF_NAME\" == hotfix/* ]] || { echo \"emergency deploys come from hotfix/* branches\"; exit 1; }\n    52\t\n    53\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    54\t        with:\n    55\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-deploy\n    56\t          aws-region: us-west-2\n    57\t\n    58\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    59\t        with:\n    60\t          cosign-release: v2.6.2\n    61\t\n    62\t      - name: Verify image signature\n    63\t        run: |\n    64\t          DIGEST=$(jq -r .image.digest release/manifest.json)\n    65\t          REPO=$(jq -r .image.repository release/manifest.json)\n    66\t          cosign verify \"$REPO@$DIGEST\" \\\n    67\t            --certificate-identity \"https://github.com/northbay-clinics/clinic-agent/.github/workflows/ci.yml@refs/heads/main\" \\\n    68\t            --certificate-oidc-issuer https://token.actions.githubusercontent.com\n    69\t          grep -q \"$DIGEST\" k8s/deployment.yaml || { echo \"k8s/deployment.yaml does not use the manifest digest\"; exit 1; }\n    70\t\n    71\t      - name: Apply\n    72\t        run: |\n    73\t          aws eks update-kubeconfig --name clinic-agent-prod\n    74\t          kubectl apply -f k8s/deployment.yaml\n    75\t          kubectl -n clinic-agent annotate deployment/clinic-agent --overwrite \\\n    76\t            northbay.example/git-sha=\"$GITHUB_SHA\" \\\n    77\t            northbay.example/release=\"$(jq -r .release release/manifest.json)\" \\\n    78\t            northbay.example/deployed-by=\"$GITHUB_ACTOR\" \\\n    79\t            northbay.example/run=\"$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID\"\n    80\t          kubectl -n clinic-agent rollout status deployment/clinic-agent --timeout=5m\n    81\t\n    82\t      - name: Open follow-up review for emergency change\n    83\t        if: inputs.emergency\n    84\t        env:\n    85\t          GH_TOKEN: ${{ github.token }}\n    86\t          OWNER: ${{ inputs.owner }}\n    87\t          REASON: ${{ inputs.reason }}\n    88\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    89\t        run: |\n    90\t          gh issue create \\\n    91\t            --title \"Follow-up review: emergency deploy ${GITHUB_SHA::8}\" \\\n    92\t            --label emergency-change,needs-review \\\n    93\t            --assignee \"$OWNER\" \\\n    94\t            --body \"Owner: $OWNER\n    95\t          Reason: $REASON\n    96\t          Ends: $EXPIRES_ON\n    97\t          Commit: $GITHUB_SHA\n    98\t          Approved in environment production-emergency by a required reviewer (see run $GITHUB_RUN_ID).\n    99\t          Review and merge to main via normal PR before the end date.\"\n     1\t# syntax=docker/dockerfile:1.7\n     2\tFROM node:22.11-bookworm-slim@sha256:3f1a8d2c9b7e4f6a5d0c8b1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a AS build\n     3\tWORKDIR /app\n     4\tCOPY package.json package-lock.json ./\n     5\tRUN npm ci --ignore-scripts\n     6\tCOPY tsconfig.json ./\n     7\tCOPY src ./src\n     8\tRUN npm run build && npm prune --omit=dev\n     9\t\n    10\tFROM gcr.io/distroless/nodejs22-debian12:nonroot@sha256:9b2e4c6a8d0f1e3c5a7b9d1f3e5c7a9b1d3f5e7c9a1b3d5f7e9c1a3b5d7f9e1c\n    11\tWORKDIR /app\n    12\tENV NODE_ENV=production \\\n    13\t    CLINIC_AGENT_ROOT=/app\n    14\tCOPY --from=build --chown=65532:65532 /app/node_modules ./node_modules\n    15\tCOPY --from=build --chown=65532:65532 /app/dist ./dist\n    16\tCOPY --chown=65532:65532 package.json ./\n    17\tCOPY --chown=65532:65532 prompts ./prompts\n    18\tCOPY --chown=65532:65532 config ./config\n    19\tCOPY --chown=65532:65532 release ./release\n    20\tUSER 65532:65532\n    21\tEXPOSE 8080\n    22\tCMD [\"dist/server.js\"]\n     1\t{\n     2\t  \"release\": \"clinic-agent-3.4.1\",\n     3\t  \"agentTypeId\": \"sha256:7c2e91f04ab35d6e8f1029c4b7a6d3e5f8091a2b3c4d5e6f708192a3b4c5d6e7\",\n     4\t  \"image\": {\n     5\t    \"repository\": \"418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent\",\n     6\t    \"digest\": \"sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\"\n     7\t  },\n     8\t  \"harness\": {\n     9\t    \"version\": \"3.4.1\",\n    10\t    \"gitSha\": \"e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\"\n    11\t  },\n    12\t  \"prompts\": [\n    13\t    { \"path\": \"prompts/system.md\", \"sha256\": \"5d1e0c9b8a7f6e5d4c3b2a1908f7e6d5c4b3a291807f6e5d4c3b2a19087f6e5d\" },\n    14\t    { \"path\": \"prompts/intent-classifier.txt\", \"sha256\": \"a3f9e1d7c5b3a1f9e7d5c3b1a9f7e5d3c1b9a7f5e3d1c9b7a5f3e1d9c7b5a3f1\" }\n    15\t  ],\n    16\t  \"models\": [\n    17\t    {\n    18\t      \"role\": \"agent\",\n    19\t      \"provider\": \"anthropic\",\n    20\t      \"requestedId\": \"claude-sonnet-4-5-20250929\",\n    21\t      \"kind\": \"pinned_snapshot\",\n    22\t      \"versionDoc\": { \"url\": \"https://docs.anthropic.com/en/docs/about-claude/models/overview\", \"checked\": \"2026-09-15\" },\n    23\t      \"adapter\": null,\n    24\t      \"providerHidden\": [\"weights\", \"training_data\", \"serving_stack\"]\n    25\t    },\n    26\t    {\n    27\t      \"role\": \"intent_classifier\",\n    28\t      \"provider\": \"anthropic\",\n    29\t      \"requestedId\": \"claude-haiku-4-5-20251001\",\n    30\t      \"kind\": \"pinned_snapshot\",\n    31\t      \"versionDoc\": { \"url\": \"https://docs.anthropic.com/en/docs/about-claude/models/overview\", \"checked\": \"2026-09-15\" },\n    32\t      \"adapter\": null,\n    33\t      \"providerHidden\": [\"weights\", \"training_data\", \"serving_stack\"]\n    34\t    }\n    35\t  ],\n    36\t  \"tools\": {\n    37\t    \"allowlist\": \"config/tools.allowlist.yaml\",\n    38\t    \"mcpServers\": [\n    39\t      {\n    40\t        \"id\": \"ehr\",\n    41\t        \"url\": \"https://ehr-mcp.internal.northbay-clinics.example/mcp\",\n    42\t        \"tlsCertSha256\": \"1f6a9c3e5b7d9f1a3c5e7b9d1f3a5c7e9b1d3f5a7c9e1b3d5f7a9c1e3b5d7f9a\",\n    43\t        \"owner\": \"ehr-integrations@northbay-clinics.example\"\n    44\t      }\n    45\t    ],\n    46\t    \"native\": [\"payments\", \"sms\", \"insurance\"]\n    47\t  },\n    48\t  \"peers\": [\n    49\t    {\n    50\t      \"id\": \"eligibility-agent\",\n    51\t      \"url\": \"https://eligibility.partners.northbay-clinics.example/a2a\",\n    52\t      \"owner\": \"revenue-cycle@northbay-clinics.example\"\n    53\t    }\n    54\t  ],\n    55\t  \"permissions\": {\n    56\t    \"awsRole\": \"arn:aws:iam::418295730611:role/clinic-agent-runtime\",\n    57\t    \"ehrScopes\": [\"patient.read\", \"appointment.read\", \"appointment.write\"],\n    58\t    \"paymentsScopes\": [\"deposits.refund\"],\n    59\t    \"eligibilityScopes\": [\"eligibility:read\"]\n    60\t  },\n    61\t  \"memory\": \"none\",\n    62\t  \"retrieval\": \"none\",\n    63\t  \"network\": { \"policy\": \"k8s/deployment.yaml#clinic-agent-egress\", \"egressProxy\": \"egress-proxy.platform.svc:3128\" },\n    64\t  \"budgets\": \"config/budgets.yaml\",\n    65\t  \"policies\": { \"action\": \"config/policy.yaml\", \"actionPolicyVersion\": \"2026-09-18.3\" }\n    66\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"5a39ff47-763c-4c5c-8724-fd0556092096","uuid":"31c257de-4359-4f88-b533-11a4aecbc501","timestamp":"2026-10-20T15:18:04.622Z","tool_use_result":{"stdout":"     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport { createHash, randomUUID } from \"node:crypto\";\n     4\timport { env, policy } from \"../config.js\";\n     5\t\n     6\t// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n     7\t// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n     8\t// approvedAt); the agent then retries the tool with the approval id.\n     9\t\n    10\texport interface ApprovalRecord {\n    11\t  id: string;\n    12\t  status: \"pending\" | \"approved\" | \"rejected\";\n    13\t  tool: string;\n    14\t  tenantId: string;\n    15\t  agentInstanceId: string;\n    16\t  runId: string;\n    17\t  argsHash: string;\n    18\t  summary: string;\n    19\t  requestedAt: string;\n    20\t  expiresAt: string;\n    21\t  approvedBy?: string;\n    22\t  approverRole?: string;\n    23\t  approvedAt?: string;\n    24\t}\n    25\t\n    26\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    27\t\n    28\texport function hashArgs(args: Record<string, unknown>): string {\n    29\t  const canonical = JSON.stringify(args, Object.keys(args).sort());\n    30\t  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n    31\t}\n    32\t\n    33\texport async function requestApproval(req: {\n    34\t  tool: string;\n    35\t  tenantId: string;\n    36\t  agentInstanceId: string;\n    37\t  runId: string;\n    38\t  args: Record<string, unknown>;\n    39\t  summary: string;\n    40\t}): Promise<ApprovalRecord> {\n    41\t  const now = Date.now();\n    42\t  const rec: ApprovalRecord = {\n    43\t    id: randomUUID(),\n    44\t    status: \"pending\",\n    45\t    tool: req.tool,\n    46\t    tenantId: req.tenantId,\n    47\t    agentInstanceId: req.agentInstanceId,\n    48\t    runId: req.runId,\n    49\t    argsHash: hashArgs(req.args),\n    50\t    summary: req.summary,\n    51\t    requestedAt: new Date(now).toISOString(),\n    52\t    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n    53\t  };\n    54\t  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n    55\t  return rec;\n    56\t}\n    57\t\n    58\texport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n    59\t\n    60\texport async function checkApproval(req: {\n    61\t  approvalId: string;\n    62\t  tool: string;\n    63\t  tenantId: string;\n    64\t  args: Record<string, unknown>;\n    65\t}): Promise<ApprovalCheck> {\n    66\t  let rec: ApprovalRecord | undefined;\n    67\t  try {\n    68\t    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    69\t    rec = res.Item as ApprovalRecord | undefined;\n    70\t  } catch (err) {\n    71\t    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n    72\t  }\n    73\t  if (!rec) return { ok: false, reason: \"approval not found\" };\n    74\t  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n    75\t  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n    76\t  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n    77\t  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n    78\t  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    79\t    return { ok: false, reason: \"approver lacks authority\" };\n    80\t  }\n    81\t  return { ok: true, approval: rec };\n    82\t}\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: clinic-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.33\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: clinic-agent\n    15\t  namespace: clinic-agent\n    16\t  annotations:\n    17\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    18\t    eks.amazonaws.com/token-expiration: \"3600\"\n    19\tautomountServiceAccountToken: false\n    20\t---\n    21\tapiVersion: v1\n    22\tkind: ServiceAccount\n    23\tmetadata:\n    24\t  name: clinic-agent-reminders\n    25\t  namespace: clinic-agent\n    26\t  annotations:\n    27\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    28\tautomountServiceAccountToken: false\n    29\t---\n    30\tapiVersion: v1\n    31\tkind: ConfigMap\n    32\tmetadata:\n    33\t  name: clinic-agent\n    34\t  namespace: clinic-agent\n    35\tdata:\n    36\t  CLINIC_DIRECTORY: |\n    37\t    [{\"id\":\"nb-castro\",\"name\":\"Northbay Castro\",\"smsNumber\":\"+14155550110\"},\n    38\t     {\"id\":\"nb-fremont\",\"name\":\"Northbay Fremont\",\"smsNumber\":\"+15105550111\"},\n    39\t     {\"id\":\"nb-oakland\",\"name\":\"Northbay Oakland\",\"smsNumber\":\"+15105550112\"},\n    40\t     {\"id\":\"nb-sanmateo\",\"name\":\"Northbay San Mateo\",\"smsNumber\":\"+16505550113\"},\n    41\t     {\"id\":\"nb-walnutcreek\",\"name\":\"Northbay Walnut Creek\",\"smsNumber\":\"+19255550114\"}]\n    42\t  SMS_SIGNING_SECRET_ARN: arn:aws:secretsmanager:us-west-2:418295730611:secret:clinic-agent/sms-signing\n    43\t  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n    44\t  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n    45\t---\n    46\tapiVersion: apps/v1\n    47\tkind: Deployment\n    48\tmetadata:\n    49\t  name: clinic-agent\n    50\t  namespace: clinic-agent\n    51\t  labels: { app: clinic-agent }\n    52\tspec:\n    53\t  replicas: 3\n    54\t  selector:\n    55\t    matchLabels: { app: clinic-agent }\n    56\t  template:\n    57\t    metadata:\n    58\t      labels: { app: clinic-agent }\n    59\t    spec:\n    60\t      serviceAccountName: clinic-agent\n    61\t      automountServiceAccountToken: false\n    62\t      hostUsers: false\n    63\t      hostNetwork: false\n    64\t      hostPID: false\n    65\t      hostIPC: false\n    66\t      enableServiceLinks: false\n    67\t      securityContext:\n    68\t        runAsNonRoot: true\n    69\t        runAsUser: 65532\n    70\t        runAsGroup: 65532\n    71\t        fsGroup: 65532\n    72\t        seccompProfile:\n    73\t          type: RuntimeDefault\n    74\t      containers:\n    75\t        - name: agent\n    76\t          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    77\t          ports:\n    78\t            - containerPort: 8080\n    79\t          envFrom:\n    80\t            - configMapRef: { name: clinic-agent }\n    81\t          env:\n    82\t            - name: IMAGE_DIGEST\n    83\t              value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    84\t            - name: GIT_SHA\n    85\t              value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n    86\t          securityContext:\n    87\t            allowPrivilegeEscalation: false\n    88\t            privileged: false\n    89\t            readOnlyRootFilesystem: true\n    90\t            runAsNonRoot: true\n    91\t            capabilities:\n    92\t              drop: [\"ALL\"]\n    93\t            seccompProfile:\n    94\t              type: RuntimeDefault\n    95\t          resources:\n    96\t            requests: { cpu: 250m, memory: 384Mi }\n    97\t            limits: { cpu: \"1\", memory: 768Mi }\n    98\t          readinessProbe:\n    99\t            httpGet: { path: /healthz, port: 8080 }\n   100\t          volumeMounts:\n   101\t            - { name: tmp, mountPath: /tmp }\n   102\t            - { name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true }\n   103\t      volumes:\n   104\t        - name: tmp\n   105\t          emptyDir: { medium: Memory, sizeLimit: 32Mi }\n   106\t        - name: sts-token\n   107\t          projected:\n   108\t            sources:\n   109\t              - serviceAccountToken:\n   110\t                  audience: https://sts.northbay-clinics.example\n   111\t                  expirationSeconds: 900\n   112\t                  path: sts-token\n   113\t---\n   114\tapiVersion: batch/v1\n   115\tkind: CronJob\n   116\tmetadata:\n   117\t  name: clinic-agent-reminders\n   118\t  namespace: clinic-agent\n   119\tspec:\n   120\t  schedule: \"0 17 * * *\"\n   121\t  timeZone: America/Los_Angeles\n   122\t  concurrencyPolicy: Forbid\n   123\t  jobTemplate:\n   124\t    spec:\n   125\t      backoffLimit: 0\n   126\t      activeDeadlineSeconds: 1800\n   127\t      template:\n   128\t        metadata:\n   129\t          labels: { app: clinic-agent-reminders }\n   130\t        spec:\n   131\t          serviceAccountName: clinic-agent-reminders\n   132\t          automountServiceAccountToken: false\n   133\t          restartPolicy: Never\n   134\t          hostUsers: false\n   135\t          securityContext:\n   136\t            runAsNonRoot: true\n   137\t            runAsUser: 65532\n   138\t            runAsGroup: 65532\n   139\t            seccompProfile:\n   140\t              type: RuntimeDefault\n   141\t          containers:\n   142\t            - name: reminders\n   143\t              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   144\t              args: [\"dist/workers/reminders.js\"]\n   145\t              envFrom:\n   146\t                - configMapRef: { name: clinic-agent }\n   147\t              env:\n   148\t                - name: IMAGE_DIGEST\n   149\t                  value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   150\t                - name: GIT_SHA\n   151\t                  value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n   152\t              securityContext:\n   153\t                allowPrivilegeEscalation: false\n   154\t                privileged: false\n   155\t                readOnlyRootFilesystem: true\n   156\t                capabilities:\n   157\t                  drop: [\"ALL\"]\n   158\t---\n   159\t# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n   160\t# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,\n   161\t# the group STS and auth service, and AWS service endpoints.\n   162\tapiVersion: networking.k8s.io/v1\n   163\tkind: NetworkPolicy\n   164\tmetadata:\n   165\t  name: clinic-agent-egress\n   166\t  namespace: clinic-agent\n   167\tspec:\n   168\t  podSelector: {}\n   169\t  policyTypes: [\"Egress\", \"Ingress\"]\n   170\t  ingress:\n   171\t    - from:\n   172\t        - namespaceSelector:\n   173\t            matchLabels: { kubernetes.io/metadata.name: ingress }\n   174\t      ports:\n   175\t        - { port: 8080, protocol: TCP }\n   176\t  egress:\n   177\t    - to:\n   178\t        - namespaceSelector:\n   179\t            matchLabels: { kubernetes.io/metadata.name: kube-system }\n   180\t          podSelector:\n   181\t            matchLabels: { k8s-app: kube-dns }\n   182\t      ports:\n   183\t        - { port: 53, protocol: UDP }\n   184\t        - { port: 53, protocol: TCP }\n   185\t    - to:\n   186\t        - namespaceSelector:\n   187\t            matchLabels: { kubernetes.io/metadata.name: platform }\n   188\t          podSelector:\n   189\t            matchLabels: { app: egress-proxy }\n   190\t      ports:\n   191\t        - { port: 3128, protocol: TCP }\n   192\t    - to:\n   193\t        - ipBlock: { cidr: 10.60.12.0/28 }\n   194\t      ports:\n   195\t        - { port: 443, protocol: TCP }\n     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    16\t      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5.0.0\n    17\t        with:\n    18\t          node-version: \"22.11\"\n    19\t          cache: npm\n    20\t      - run: npm ci --ignore-scripts\n    21\t      - run: npm run lint\n    22\t      - run: npm test\n    23\t      - run: npm run build\n    24\t\n    25\t  manifest-check:\n    26\t    runs-on: ubuntu-24.04\n    27\t    steps:\n    28\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    29\t      - name: Prompt digests match the release manifest\n    30\t        run: |\n    31\t          node -e '\n    32\t            const fs = require(\"fs\"), crypto = require(\"crypto\");\n    33\t            const m = JSON.parse(fs.readFileSync(\"release/manifest.json\", \"utf8\"));\n    34\t            let bad = 0;\n    35\t            for (const p of m.prompts) {\n    36\t              const got = crypto.createHash(\"sha256\").update(fs.readFileSync(p.path)).digest(\"hex\");\n    37\t              if (got !== p.sha256) { console.error(`${p.path}: manifest ${p.sha256} != file ${got}`); bad++; }\n    38\t            }\n    39\t            const ver = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\")).version;\n    40\t            if (m.harness.version !== ver) { console.error(`harness version ${m.harness.version} != package ${ver}`); bad++; }\n    41\t            process.exit(bad ? 1 : 0);\n    42\t          '\n    43\t\n    44\t  image:\n    45\t    if: github.ref == 'refs/heads/main'\n    46\t    needs: [test, manifest-check]\n    47\t    runs-on: ubuntu-24.04\n    48\t    permissions:\n    49\t      contents: read\n    50\t      id-token: write\n    51\t      attestations: write\n    52\t      packages: write\n    53\t    steps:\n    54\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    55\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    56\t        with:\n    57\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-image-build\n    58\t          aws-region: us-west-2\n    59\t      - uses: aws-actions/amazon-ecr-login@062b18b96a7aff071d4dc91bc00c4c1a7945b076 # v2.0.1\n    60\t        id: ecr\n    61\t      - uses: docker/setup-buildx-action@e468171a9de216ec08956ac3ada2f0791b6bd435 # v3.11.1\n    62\t      - uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    63\t        id: build\n    64\t        with:\n    65\t          push: true\n    66\t          tags: ${{ steps.ecr.outputs.registry }}/clinic-agent:${{ github.sha }}\n    67\t          provenance: mode=max\n    68\t          sbom: true\n    69\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    70\t        with:\n    71\t          cosign-release: v2.6.2\n    72\t      - name: Sign image\n    73\t        run: cosign sign --yes ${{ steps.ecr.outputs.registry }}/clinic-agent@${{ steps.build.outputs.digest }}\n    74\t      - uses: actions/attest-build-provenance@977bb373ede98d70efdf65b84cb5f73e068dcc2a # v3.0.0\n    75\t        with:\n    76\t          subject-name: ${{ steps.ecr.outputs.registry }}/clinic-agent\n    77\t          subject-digest: ${{ steps.build.outputs.digest }}\n    78\t          push-to-registry: true\n     1\tname: deploy\n     2\t\n     3\t# Deploys the image digest named in release/manifest.json. The digest reaches the manifest through\n     4\t# a reviewed release PR, so what runs is always a reviewed commit.\n     5\ton:\n     6\t  workflow_dispatch:\n     7\t    inputs:\n     8\t      emergency:\n     9\t        description: Emergency change (hotfix/* branch, production-emergency environment)\n    10\t        type: boolean\n    11\t        default: false\n    12\t      owner:\n    13\t        description: Emergency only - person accountable for this change\n    14\t        type: string\n    15\t        default: \"\"\n    16\t      reason:\n    17\t        description: Emergency only - why this cannot wait for a normal release\n    18\t        type: string\n    19\t        default: \"\"\n    20\t      expires_on:\n    21\t        description: Emergency only - date (YYYY-MM-DD) by which it is replaced by a normal release\n    22\t        type: string\n    23\t        default: \"\"\n    24\t\n    25\tpermissions:\n    26\t  contents: read\n    27\t  id-token: write\n    28\t  issues: write\n    29\t\n    30\tconcurrency:\n    31\t  group: deploy-production\n    32\t  cancel-in-progress: false\n    33\t\n    34\tjobs:\n    35\t  deploy:\n    36\t    runs-on: ubuntu-24.04\n    37\t    environment: ${{ inputs.emergency && 'production-emergency' || 'production' }}\n    38\t    steps:\n    39\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    40\t\n    41\t      - name: Emergency change record is complete\n    42\t        if: inputs.emergency\n    43\t        env:\n    44\t          OWNER: ${{ inputs.owner }}\n    45\t          REASON: ${{ inputs.reason }}\n    46\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    47\t        run: |\n    48\t          test -n \"$OWNER\" || { echo \"owner is required\"; exit 1; }\n    49\t          test -n \"$REASON\" || { echo \"reason is required\"; exit 1; }\n    50\t          date -d \"$EXPIRES_ON\" +%F >/dev/null || { echo \"expires_on must be a date\"; exit 1; }\n    51\t          [[ \"$GITHUB_REF_NAME\" == hotfix/* ]] || { echo \"emergency deploys come from hotfix/* branches\"; exit 1; }\n    52\t\n    53\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    54\t        with:\n    55\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-deploy\n    56\t          aws-region: us-west-2\n    57\t\n    58\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    59\t        with:\n    60\t          cosign-release: v2.6.2\n    61\t\n    62\t      - name: Verify image signature\n    63\t        run: |\n    64\t          DIGEST=$(jq -r .image.digest release/manifest.json)\n    65\t          REPO=$(jq -r .image.repository release/manifest.json)\n    66\t          cosign verify \"$REPO@$DIGEST\" \\\n    67\t            --certificate-identity \"https://github.com/northbay-clinics/clinic-agent/.github/workflows/ci.yml@refs/heads/main\" \\\n    68\t            --certificate-oidc-issuer https://token.actions.githubusercontent.com\n    69\t          grep -q \"$DIGEST\" k8s/deployment.yaml || { echo \"k8s/deployment.yaml does not use the manifest digest\"; exit 1; }\n    70\t\n    71\t      - name: Apply\n    72\t        run: |\n    73\t          aws eks update-kubeconfig --name clinic-agent-prod\n    74\t          kubectl apply -f k8s/deployment.yaml\n    75\t          kubectl -n clinic-agent annotate deployment/clinic-agent --overwrite \\\n    76\t            northbay.example/git-sha=\"$GITHUB_SHA\" \\\n    77\t            northbay.example/release=\"$(jq -r .release release/manifest.json)\" \\\n    78\t            northbay.example/deployed-by=\"$GITHUB_ACTOR\" \\\n    79\t            northbay.example/run=\"$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID\"\n    80\t          kubectl -n clinic-agent rollout status deployment/clinic-agent --timeout=5m\n    81\t\n    82\t      - name: Open follow-up review for emergency change\n    83\t        if: inputs.emergency\n    84\t        env:\n    85\t          GH_TOKEN: ${{ github.token }}\n    86\t          OWNER: ${{ inputs.owner }}\n    87\t          REASON: ${{ inputs.reason }}\n    88\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    89\t        run: |\n    90\t          gh issue create \\\n    91\t            --title \"Follow-up review: emergency deploy ${GITHUB_SHA::8}\" \\\n    92\t            --label emergency-change,needs-review \\\n    93\t            --assignee \"$OWNER\" \\\n    94\t            --body \"Owner: $OWNER\n    95\t          Reason: $REASON\n    96\t          Ends: $EXPIRES_ON\n    97\t          Commit: $GITHUB_SHA\n    98\t          Approved in environment production-emergency by a required reviewer (see run $GITHUB_RUN_ID).\n    99\t          Review and merge to main via normal PR before the end date.\"\n     1\t# syntax=docker/dockerfile:1.7\n     2\tFROM node:22.11-bookworm-slim@sha256:3f1a8d2c9b7e4f6a5d0c8b1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a AS build\n     3\tWORKDIR /app\n     4\tCOPY package.json package-lock.json ./\n     5\tRUN npm ci --ignore-scripts\n     6\tCOPY tsconfig.json ./\n     7\tCOPY src ./src\n     8\tRUN npm run build && npm prune --omit=dev\n     9\t\n    10\tFROM gcr.io/distroless/nodejs22-debian12:nonroot@sha256:9b2e4c6a8d0f1e3c5a7b9d1f3e5c7a9b1d3f5e7c9a1b3d5f7e9c1a3b5d7f9e1c\n    11\tWORKDIR /app\n    12\tENV NODE_ENV=production \\\n    13\t    CLINIC_AGENT_ROOT=/app\n    14\tCOPY --from=build --chown=65532:65532 /app/node_modules ./node_modules\n    15\tCOPY --from=build --chown=65532:65532 /app/dist ./dist\n    16\tCOPY --chown=65532:65532 package.json ./\n    17\tCOPY --chown=65532:65532 prompts ./prompts\n    18\tCOPY --chown=65532:65532 config ./config\n    19\tCOPY --chown=65532:65532 release ./release\n    20\tUSER 65532:65532\n    21\tEXPOSE 8080\n    22\tCMD [\"dist/server.js\"]\n     1\t{\n     2\t  \"release\": \"clinic-agent-3.4.1\",\n     3\t  \"agentTypeId\": \"sha256:7c2e91f04ab35d6e8f1029c4b7a6d3e5f8091a2b3c4d5e6f708192a3b4c5d6e7\",\n     4\t  \"image\": {\n     5\t    \"repository\": \"418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent\",\n     6\t    \"digest\": \"sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\"\n     7\t  },\n     8\t  \"harness\": {\n     9\t    \"version\": \"3.4.1\",\n    10\t    \"gitSha\": \"e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\"\n    11\t  },\n    12\t  \"prompts\": [\n    13\t    { \"path\": \"prompts/system.md\", \"sha256\": \"5d1e0c9b8a7f6e5d4c3b2a1908f7e6d5c4b3a291807f6e5d4c3b2a19087f6e5d\" },\n    14\t    { \"path\": \"prompts/intent-classifier.txt\", \"sha256\": \"a3f9e1d7c5b3a1f9e7d5c3b1a9f7e5d3c1b9a7f5e3d1c9b7a5f3e1d9c7b5a3f1\" }\n    15\t  ],\n    16\t  \"models\": [\n    17\t    {\n    18\t      \"role\": \"agent\",\n    19\t      \"provider\": \"anthropic\",\n    20\t      \"requestedId\": \"claude-sonnet-4-5-20250929\",\n    21\t      \"kind\": \"pinned_snapshot\",\n    22\t      \"versionDoc\": { \"url\": \"https://docs.anthropic.com/en/docs/about-claude/models/overview\", \"checked\": \"2026-09-15\" },\n    23\t      \"adapter\": null,\n    24\t      \"providerHidden\": [\"weights\", \"training_data\", \"serving_stack\"]\n    25\t    },\n    26\t    {\n    27\t      \"role\": \"intent_classifier\",\n    28\t      \"provider\": \"anthropic\",\n    29\t      \"requestedId\": \"claude-haiku-4-5-20251001\",\n    30\t      \"kind\": \"pinned_snapshot\",\n    31\t      \"versionDoc\": { \"url\": \"https://docs.anthropic.com/en/docs/about-claude/models/overview\", \"checked\": \"2026-09-15\" },\n    32\t      \"adapter\": null,\n    33\t      \"providerHidden\": [\"weights\", \"training_data\", \"serving_stack\"]\n    34\t    }\n    35\t  ],\n    36\t  \"tools\": {\n    37\t    \"allowlist\": \"config/tools.allowlist.yaml\",\n    38\t    \"mcpServers\": [\n    39\t      {\n    40\t        \"id\": \"ehr\",\n    41\t        \"url\": \"https://ehr-mcp.internal.northbay-clinics.example/mcp\",\n    42\t        \"tlsCertSha256\": \"1f6a9c3e5b7d9f1a3c5e7b9d1f3a5c7e9b1d3f5a7c9e1b3d5f7a9c1e3b5d7f9a\",\n    43\t        \"owner\": \"ehr-integrations@northbay-clinics.example\"\n    44\t      }\n    45\t    ],\n    46\t    \"native\": [\"payments\", \"sms\", \"insurance\"]\n    47\t  },\n    48\t  \"peers\": [\n    49\t    {\n    50\t      \"id\": \"eligibility-agent\",\n    51\t      \"url\": \"https://eligibility.partners.northbay-clinics.example/a2a\",\n    52\t      \"owner\": \"revenue-cycle@northbay-clinics.example\"\n    53\t    }\n    54\t  ],\n    55\t  \"permissions\": {\n    56\t    \"awsRole\": \"arn:aws:iam::418295730611:role/clinic-agent-runtime\",\n    57\t    \"ehrScopes\": [\"patient.read\", \"appointment.read\", \"appointment.write\"],\n    58\t    \"paymentsScopes\": [\"deposits.refund\"],\n    59\t    \"eligibilityScopes\": [\"eligibility:read\"]\n    60\t  },\n    61\t  \"memory\": \"none\",\n    62\t  \"retrieval\": \"none\",\n    63\t  \"network\": { \"policy\": \"k8s/deployment.yaml#clinic-agent-egress\", \"egressProxy\": \"egress-proxy.platform.svc:3128\" },\n    64\t  \"budgets\": \"config/budgets.yaml\",\n    65\t  \"policies\": { \"action\": \"config/policy.yaml\", \"actionPolicyVersion\": \"2026-09-18.3\" }\n    66\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01TBepprHdJyriGV6NrQXgtU","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDiFWCy2kdTkeHDNSLpJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QyRZMz56jKHPbDhVPisKy3","name":"Bash","input":{"command":"cat -n src/tools/executor.ts src/agent/budget.ts src/agent/loop.ts config/*.yaml"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2366,"cache_read_input_tokens":24080,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2366},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5a39ff47-763c-4c5c-8724-fd0556092096","uuid":"e5093b1d-b489-4c87-a051-9b738942aa1c","timestamp":"2026-10-20T15:18:05.266Z","request_id":"req_011CgDiFVwLxAjvDwzLYfK3s","wire_tool_inputs":{"toolu_01QyRZMz56jKHPbDhVPisKy3":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-wmrh39zk/agent && cat -n src/tools/executor.ts src/agent/budget.ts src/agent/loop.ts config/*.yaml"}},"wire_ingest_context":{"toolu_01QyRZMz56jKHPbDhVPisKy3":{"cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-wmrh39zk/agent"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QyRZMz56jKHPbDhVPisKy3","type":"tool_result","content":"     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { allowlist, policy } from \"../config.js\";\n     3\timport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\n     4\timport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\n     5\timport type { ContextSize } from \"../agent/context-size.js\";\n     6\timport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\n     7\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     8\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     9\timport { payments } from \"../integrations/payments.js\";\n    10\timport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\n    11\timport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\n    12\timport { checkApproval, requestApproval } from \"./approvals.js\";\n    13\timport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n    14\t\n    15\texport interface Decision {\n    16\t  contextSize: ContextSize;\n    17\t  budget: RunBudget;\n    18\t}\n    19\t\n    20\tconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n    21\t// Arguments the harness consumes itself; they are never forwarded to a tool.\n    22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n    23\t\n    24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n    25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n    26\t}\n    27\t\n    28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n    29\t  return `${tool}(${Object.entries(args)\n    30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    31\t    .join(\", \")})`.slice(0, 500);\n    32\t}\n    33\t\n    34\texport async function executeTool(\n    35\t  registry: ToolRegistry,\n    36\t  ctx: RunContext,\n    37\t  call: Anthropic.ToolUseBlock,\n    38\t  d: Decision,\n    39\t): Promise<Anthropic.ToolResultBlockParam> {\n    40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n    41\t  const base = {\n    42\t    ...ctx.identity(),\n    43\t    runId: ctx.runId,\n    44\t    subject: ctx.subject,\n    45\t    tool: call.name,\n    46\t    toolUseId: call.id,\n    47\t    policyVersion: policy.version,\n    48\t    context: d.contextSize,\n    49\t  };\n    50\t  const deny = async (reason: string) => {\n    51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n    52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n    53\t  };\n    54\t\n    55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n    56\t  const tool = registry.get(call.name);\n    57\t  if (!tool) return deny(\"not_registered\");\n    58\t\n    59\t  await killSwitch.assertRunning(ctx.tenantId);\n    60\t  await d.budget.toolCall(call.name);\n    61\t\n    62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n    63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n    64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n    65\t\n    66\t  let approvalId: string | undefined;\n    67\t  if (policy.highImpactTools.includes(call.name)) {\n    68\t    if (typeof input.approvalId !== \"string\") {\n    69\t      const rec = await requestApproval({\n    70\t        tool: call.name,\n    71\t        tenantId: clinicId,\n    72\t        agentInstanceId: AGENT_INSTANCE_ID,\n    73\t        runId: ctx.runId,\n    74\t        args,\n    75\t        summary: summarize(call.name, args),\n    76\t      });\n    77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n    78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    79\t    }\n    80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    81\t    if (!check.ok) return deny(check.reason);\n    82\t    approvalId = check.approval.id;\n    83\t  }\n    84\t\n    85\t  try {\n    86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    88\t    const safe = redactPhi(raw);\n    89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    90\t    return toolResult(call.id, safe);\n    91\t  } catch (err) {\n    92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n    95\t  }\n    96\t}\n    97\t\n    98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n    99\t\n   100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n   101\t  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n   102\t    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n   103\t\n   104\t  return {\n   105\t    payments: [\n   106\t      {\n   107\t        name: \"refund_deposit\",\n   108\t        definition: {\n   109\t          name: \"payments__refund_deposit\",\n   110\t          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n   111\t          input_schema: {\n   112\t            type: \"object\",\n   113\t            properties: {\n   114\t              depositId: { type: \"string\" },\n   115\t              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n   116\t              approvalId: { type: \"string\" },\n   117\t            },\n   118\t            required: [\"depositId\", \"reason\"],\n   119\t          },\n   120\t        },\n   121\t        invoke: async (a, o) =>\n   122\t          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n   123\t      },\n   124\t    ],\n   125\t    sms: [\n   126\t      {\n   127\t        name: \"send_to_patient\",\n   128\t        definition: {\n   129\t          name: \"sms__send_to_patient\",\n   130\t          description: \"Send a templated SMS to the phone number on the patient's record.\",\n   131\t          input_schema: {\n   132\t            type: \"object\",\n   133\t            properties: {\n   134\t              patientId: { type: \"string\" },\n   135\t              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n   136\t              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n   137\t            },\n   138\t            required: [\"patientId\", \"template\"],\n   139\t          },\n   140\t        },\n   141\t        invoke: async (a, o) => {\n   142\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   143\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   144\t          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n   145\t          return sms.send(o.clinicId, c.phone, body, o.signal);\n   146\t        },\n   147\t      },\n   148\t      {\n   149\t        name: \"send_freeform\",\n   150\t        definition: {\n   151\t          name: \"sms__send_freeform\",\n   152\t          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n   153\t          input_schema: {\n   154\t            type: \"object\",\n   155\t            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n   156\t            required: [\"patientId\", \"body\"],\n   157\t          },\n   158\t        },\n   159\t        invoke: async (a, o) => {\n   160\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   161\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   162\t          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n   163\t        },\n   164\t      },\n   165\t    ],\n   166\t    insurance: [\n   167\t      {\n   168\t        name: \"check_eligibility\",\n   169\t        definition: {\n   170\t          name: \"insurance__check_eligibility\",\n   171\t          description: \"Check whether the patient's insurance covers an appointment.\",\n   172\t          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n   173\t        },\n   174\t        invoke: async (a, o) =>\n   175\t          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n   176\t            clinicId: o.clinicId,\n   177\t            ctx: o.runCtx as RunContext,\n   178\t            signal: o.signal,\n   179\t            context: o.context,\n   180\t          }),\n   181\t      },\n   182\t    ],\n   183\t  };\n   184\t}\n     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, UpdateCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport type { Budgets } from \"../config.js\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\texport type LimitName =\n     7\t  | \"turns\"\n     8\t  | \"wall_time\"\n     9\t  | \"input_tokens\"\n    10\t  | \"output_tokens\"\n    11\t  | \"run_cost\"\n    12\t  | \"tool_calls\"\n    13\t  | \"tool_call_rate\"\n    14\t  | \"peer_calls\"\n    15\t  | \"subject_daily_cost\"\n    16\t  | \"tenant_daily_cost\"\n    17\t  | \"fleet_daily_cost\"\n    18\t  | \"tenant_tool_rate\"\n    19\t  | \"fleet_tool_rate\";\n    20\t\n    21\texport class BudgetExceeded extends Error {\n    22\t  constructor(public limit: LimitName, public used: number, public max: number) {\n    23\t    super(`budget exceeded: ${limit} (${used} > ${max})`);\n    24\t  }\n    25\t}\n    26\t\n    27\t// Shared counters across runs and pods. add() must be atomic and refuse to go past max.\n    28\texport interface QuotaStore {\n    29\t  add(key: string, amount: number, max: number, ttlSeconds: number): Promise<{ ok: boolean; used: number }>;\n    30\t}\n    31\t\n    32\texport class DynamoQuotaStore implements QuotaStore {\n    33\t  private ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    34\t  async add(key: string, amount: number, max: number, ttlSeconds: number) {\n    35\t    try {\n    36\t      const res = await this.ddb.send(\n    37\t        new UpdateCommand({\n    38\t          TableName: env.budgetTable,\n    39\t          Key: { pk: key },\n    40\t          UpdateExpression: \"ADD used :n SET expiresAt = if_not_exists(expiresAt, :exp)\",\n    41\t          ConditionExpression: \"attribute_not_exists(used) OR used <= :room\",\n    42\t          ExpressionAttributeValues: {\n    43\t            \":n\": amount,\n    44\t            \":room\": max - amount,\n    45\t            \":exp\": Math.floor(Date.now() / 1000) + ttlSeconds,\n    46\t          },\n    47\t          ReturnValues: \"UPDATED_NEW\",\n    48\t        }),\n    49\t      );\n    50\t      return { ok: true, used: Number(res.Attributes?.used ?? amount) };\n    51\t    } catch (err) {\n    52\t      if ((err as { name?: string }).name === \"ConditionalCheckFailedException\") return { ok: false, used: max };\n    53\t      throw err;\n    54\t    }\n    55\t  }\n    56\t}\n    57\t\n    58\texport interface Usage {\n    59\t  input_tokens: number;\n    60\t  output_tokens: number;\n    61\t  cache_read_input_tokens?: number | null;\n    62\t  cache_creation_input_tokens?: number | null;\n    63\t}\n    64\t\n    65\tconst day = () => new Date().toISOString().slice(0, 10);\n    66\tconst minute = () => new Date().toISOString().slice(0, 16);\n    67\t\n    68\texport class RunBudget {\n    69\t  readonly abort = new AbortController();\n    70\t  private started = Date.now();\n    71\t  private timer: NodeJS.Timeout;\n    72\t  private turns = 0;\n    73\t  private inTok = 0;\n    74\t  private outTok = 0;\n    75\t  private cost = 0;\n    76\t  private toolCalls = 0;\n    77\t  private toolTimes: number[] = [];\n    78\t  private peerCalls = 0;\n    79\t\n    80\t  constructor(\n    81\t    private b: Budgets,\n    82\t    private store: QuotaStore,\n    83\t    private scope: { tenantId: string; subjectId: string },\n    84\t    private now: () => number = Date.now,\n    85\t  ) {\n    86\t    this.started = this.now();\n    87\t    this.timer = setTimeout(\n    88\t      () => this.abort.abort(new BudgetExceeded(\"wall_time\", this.b.run.maxWallMs, this.b.run.maxWallMs)),\n    89\t      this.b.run.maxWallMs,\n    90\t    );\n    91\t  }\n    92\t\n    93\t  get signal(): AbortSignal {\n    94\t    return this.abort.signal;\n    95\t  }\n    96\t\n    97\t  dispose(): void {\n    98\t    clearTimeout(this.timer);\n    99\t  }\n   100\t\n   101\t  private check(limit: LimitName, used: number, max: number): void {\n   102\t    if (used > max) {\n   103\t      const e = new BudgetExceeded(limit, used, max);\n   104\t      this.abort.abort(e);\n   105\t      throw e;\n   106\t    }\n   107\t  }\n   108\t\n   109\t  private checkWall(): void {\n   110\t    this.check(\"wall_time\", this.now() - this.started, this.b.run.maxWallMs);\n   111\t  }\n   112\t\n   113\t  turn(): void {\n   114\t    this.checkWall();\n   115\t    this.turns += 1;\n   116\t    this.check(\"turns\", this.turns, this.b.run.maxTurns);\n   117\t  }\n   118\t\n   119\t  async recordUsage(u: Usage, model: string): Promise<void> {\n   120\t    const price = this.b.pricingUsdPerMTok[model];\n   121\t    if (!price) throw new Error(`no pricing for model ${model}`);\n   122\t    const cacheRead = u.cache_read_input_tokens ?? 0;\n   123\t    const cacheWrite = u.cache_creation_input_tokens ?? 0;\n   124\t    const callCost =\n   125\t      (u.input_tokens * price.input +\n   126\t        u.output_tokens * price.output +\n   127\t        cacheRead * price.cacheRead +\n   128\t        cacheWrite * price.cacheWrite) /\n   129\t      1_000_000;\n   130\t\n   131\t    this.inTok += u.input_tokens + cacheRead + cacheWrite;\n   132\t    this.outTok += u.output_tokens;\n   133\t    this.cost += callCost;\n   134\t    this.check(\"input_tokens\", this.inTok, this.b.run.maxInputTokens);\n   135\t    this.check(\"output_tokens\", this.outTok, this.b.run.maxOutputTokens);\n   136\t    this.check(\"run_cost\", this.cost, this.b.run.maxCostUsd);\n   137\t\n   138\t    const q = this.b.quotas;\n   139\t    await this.shared(\"subject_daily_cost\", `cost#subject#${this.scope.subjectId}#${day()}`, callCost, q.perSubjectDailyUsd, 86400);\n   140\t    await this.shared(\"tenant_daily_cost\", `cost#tenant#${this.scope.tenantId}#${day()}`, callCost, q.perTenantDailyUsd, 86400);\n   141\t    await this.shared(\"fleet_daily_cost\", `cost#fleet#${day()}`, callCost, q.fleetDailyUsd, 86400);\n   142\t  }\n   143\t\n   144\t  async toolCall(tool: string): Promise<void> {\n   145\t    this.checkWall();\n   146\t    this.toolCalls += 1;\n   147\t    this.check(\"tool_calls\", this.toolCalls, this.b.run.maxToolCalls);\n   148\t\n   149\t    const t = this.now();\n   150\t    this.toolTimes = this.toolTimes.filter((x) => t - x < 60_000);\n   151\t    this.toolTimes.push(t);\n   152\t    this.check(\"tool_call_rate\", this.toolTimes.length, this.b.run.maxToolCallsPerMinute);\n   153\t\n   154\t    if (tool.startsWith(\"insurance__\")) {\n   155\t      this.peerCalls += 1;\n   156\t      this.check(\"peer_calls\", this.peerCalls, this.b.run.maxPeerCalls);\n   157\t    }\n   158\t\n   159\t    const q = this.b.quotas;\n   160\t    await this.shared(\"tenant_tool_rate\", `rate#tenant#${this.scope.tenantId}#${minute()}`, 1, q.perTenantToolCallsPerMinute, 120);\n   161\t    await this.shared(\"fleet_tool_rate\", `rate#fleet#${minute()}`, 1, q.fleetToolCallsPerMinute, 120);\n   162\t  }\n   163\t\n   164\t  private async shared(limit: LimitName, key: string, amount: number, max: number, ttl: number): Promise<void> {\n   165\t    const r = await this.store.add(key, amount, max, ttl);\n   166\t    if (!r.ok) {\n   167\t      const e = new BudgetExceeded(limit, r.used + amount, max);\n   168\t      this.abort.abort(e);\n   169\t      throw e;\n   170\t    }\n   171\t  }\n   172\t}\n     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\n     1\t# Hard limits enforced by src/agent/budget.ts, outside the model.\n     2\trun:\n     3\t  maxTurns: 8                 # model calls per run\n     4\t  maxWallMs: 45000            # whole run, including tool calls\n     5\t  maxInputTokens: 120000      # summed across model calls in the run\n     6\t  maxOutputTokens: 6000\n     7\t  maxCostUsd: 0.40\n     8\t  maxToolCalls: 16\n     9\t  maxToolCallsPerMinute: 12\n    10\t  maxPeerCalls: 2             # calls to the eligibility agent; this agent starts no sub-agents\n    11\t\n    12\tquotas:\n    13\t  # Daily spend and per-minute tool-call ceilings across many runs.\n    14\t  perSubjectDailyUsd: 2.00    # one patient or staff user\n    15\t  perTenantDailyUsd: 60.00    # one clinic\n    16\t  fleetDailyUsd: 900.00       # all clinics\n    17\t  perTenantToolCallsPerMinute: 240\n    18\t  fleetToolCallsPerMinute: 2400\n    19\t\n    20\tpricingUsdPerMTok:\n    21\t  claude-sonnet-4-5-20250929: { input: 3.00, output: 15.00, cacheRead: 0.30, cacheWrite: 3.75 }\n    22\t  claude-haiku-4-5-20251001: { input: 1.00, output: 5.00, cacheRead: 0.10, cacheWrite: 1.25 }\n    23\t\n    24\t# When a limit is hit the run stops, the stop is audited with the limit name, and the\n    25\t# conversation is handed to the clinic's front-desk queue.\n    26\tonExceed: handoff_to_staff\n     1\t# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\n     2\tpolicyVersion: \"2026-09-18.3\"\n     3\t\n     4\t# Tools that never run without a staff approval bound to the request.\n     5\thighImpactTools:\n     6\t  - ehr__cancel_appointment\n     7\t  - payments__refund_deposit\n     8\t  - sms__send_freeform\n     9\t\n    10\tapproval:\n    11\t  ttlSeconds: 900\n    12\t  approverRoles:\n    13\t    - front_desk_lead\n    14\t    - clinic_manager\n    15\t  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n    16\t  table: clinic-agent-approvals\n     1\t# Every tool the scheduling agent may call, with the task it serves.\n     2\t# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n     3\t# are not used for allow or approval decisions.\n     4\trole: scheduling_agent\n     5\ttools:\n     6\t  - tool: ehr__find_patient\n     7\t    reason: Match the sender to a patient record by date of birth and phone or email.\n     8\t  - tool: ehr__search_slots\n     9\t    reason: List open slots for a provider, location, and visit type.\n    10\t  - tool: ehr__get_appointment\n    11\t    reason: Read one appointment the patient asks about.\n    12\t  - tool: ehr__list_patient_appointments\n    13\t    reason: Show the patient their upcoming appointments.\n    14\t  - tool: ehr__book_appointment\n    15\t    reason: Book a slot the patient chose.\n    16\t  - tool: ehr__update_appointment\n    17\t    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n    18\t  - tool: ehr__cancel_appointment\n    19\t    reason: Cancel an appointment at the patient's request.\n    20\t  - tool: payments__refund_deposit\n    21\t    reason: Refund a no-show deposit after staff review.\n    22\t  - tool: sms__send_to_patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.","is_error":false}]},"parent_tool_use_id":null,"session_id":"5a39ff47-763c-4c5c-8724-fd0556092096","uuid":"e0fed6dc-cd3d-48b0-9023-f2d1a9b3fc4e","timestamp":"2026-10-20T15:18:05.311Z","tool_use_result":{"stdout":"     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { allowlist, policy } from \"../config.js\";\n     3\timport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\n     4\timport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\n     5\timport type { ContextSize } from \"../agent/context-size.js\";\n     6\timport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\n     7\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     8\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     9\timport { payments } from \"../integrations/payments.js\";\n    10\timport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\n    11\timport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\n    12\timport { checkApproval, requestApproval } from \"./approvals.js\";\n    13\timport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n    14\t\n    15\texport interface Decision {\n    16\t  contextSize: ContextSize;\n    17\t  budget: RunBudget;\n    18\t}\n    19\t\n    20\tconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n    21\t// Arguments the harness consumes itself; they are never forwarded to a tool.\n    22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n    23\t\n    24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n    25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n    26\t}\n    27\t\n    28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n    29\t  return `${tool}(${Object.entries(args)\n    30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    31\t    .join(\", \")})`.slice(0, 500);\n    32\t}\n    33\t\n    34\texport async function executeTool(\n    35\t  registry: ToolRegistry,\n    36\t  ctx: RunContext,\n    37\t  call: Anthropic.ToolUseBlock,\n    38\t  d: Decision,\n    39\t): Promise<Anthropic.ToolResultBlockParam> {\n    40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n    41\t  const base = {\n    42\t    ...ctx.identity(),\n    43\t    runId: ctx.runId,\n    44\t    subject: ctx.subject,\n    45\t    tool: call.name,\n    46\t    toolUseId: call.id,\n    47\t    policyVersion: policy.version,\n    48\t    context: d.contextSize,\n    49\t  };\n    50\t  const deny = async (reason: string) => {\n    51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n    52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n    53\t  };\n    54\t\n    55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n    56\t  const tool = registry.get(call.name);\n    57\t  if (!tool) return deny(\"not_registered\");\n    58\t\n    59\t  await killSwitch.assertRunning(ctx.tenantId);\n    60\t  await d.budget.toolCall(call.name);\n    61\t\n    62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n    63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n    64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n    65\t\n    66\t  let approvalId: string | undefined;\n    67\t  if (policy.highImpactTools.includes(call.name)) {\n    68\t    if (typeof input.approvalId !== \"string\") {\n    69\t      const rec = await requestApproval({\n    70\t        tool: call.name,\n    71\t        tenantId: clinicId,\n    72\t        agentInstanceId: AGENT_INSTANCE_ID,\n    73\t        runId: ctx.runId,\n    74\t        args,\n    75\t        summary: summarize(call.name, args),\n    76\t      });\n    77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n    78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    79\t    }\n    80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    81\t    if (!check.ok) return deny(check.reason);\n    82\t    approvalId = check.approval.id;\n    83\t  }\n    84\t\n    85\t  try {\n    86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    88\t    const safe = redactPhi(raw);\n    89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    90\t    return toolResult(call.id, safe);\n    91\t  } catch (err) {\n    92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n    95\t  }\n    96\t}\n    97\t\n    98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n    99\t\n   100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n   101\t  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n   102\t    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n   103\t\n   104\t  return {\n   105\t    payments: [\n   106\t      {\n   107\t        name: \"refund_deposit\",\n   108\t        definition: {\n   109\t          name: \"payments__refund_deposit\",\n   110\t          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n   111\t          input_schema: {\n   112\t            type: \"object\",\n   113\t            properties: {\n   114\t              depositId: { type: \"string\" },\n   115\t              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n   116\t              approvalId: { type: \"string\" },\n   117\t            },\n   118\t            required: [\"depositId\", \"reason\"],\n   119\t          },\n   120\t        },\n   121\t        invoke: async (a, o) =>\n   122\t          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n   123\t      },\n   124\t    ],\n   125\t    sms: [\n   126\t      {\n   127\t        name: \"send_to_patient\",\n   128\t        definition: {\n   129\t          name: \"sms__send_to_patient\",\n   130\t          description: \"Send a templated SMS to the phone number on the patient's record.\",\n   131\t          input_schema: {\n   132\t            type: \"object\",\n   133\t            properties: {\n   134\t              patientId: { type: \"string\" },\n   135\t              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n   136\t              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n   137\t            },\n   138\t            required: [\"patientId\", \"template\"],\n   139\t          },\n   140\t        },\n   141\t        invoke: async (a, o) => {\n   142\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   143\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   144\t          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n   145\t          return sms.send(o.clinicId, c.phone, body, o.signal);\n   146\t        },\n   147\t      },\n   148\t      {\n   149\t        name: \"send_freeform\",\n   150\t        definition: {\n   151\t          name: \"sms__send_freeform\",\n   152\t          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n   153\t          input_schema: {\n   154\t            type: \"object\",\n   155\t            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n   156\t            required: [\"patientId\", \"body\"],\n   157\t          },\n   158\t        },\n   159\t        invoke: async (a, o) => {\n   160\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   161\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   162\t          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n   163\t        },\n   164\t      },\n   165\t    ],\n   166\t    insurance: [\n   167\t      {\n   168\t        name: \"check_eligibility\",\n   169\t        definition: {\n   170\t          name: \"insurance__check_eligibility\",\n   171\t          description: \"Check whether the patient's insurance covers an appointment.\",\n   172\t          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n   173\t        },\n   174\t        invoke: async (a, o) =>\n   175\t          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n   176\t            clinicId: o.clinicId,\n   177\t            ctx: o.runCtx as RunContext,\n   178\t            signal: o.signal,\n   179\t            context: o.context,\n   180\t          }),\n   181\t      },\n   182\t    ],\n   183\t  };\n   184\t}\n     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, UpdateCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport type { Budgets } from \"../config.js\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\texport type LimitName =\n     7\t  | \"turns\"\n     8\t  | \"wall_time\"\n     9\t  | \"input_tokens\"\n    10\t  | \"output_tokens\"\n    11\t  | \"run_cost\"\n    12\t  | \"tool_calls\"\n    13\t  | \"tool_call_rate\"\n    14\t  | \"peer_calls\"\n    15\t  | \"subject_daily_cost\"\n    16\t  | \"tenant_daily_cost\"\n    17\t  | \"fleet_daily_cost\"\n    18\t  | \"tenant_tool_rate\"\n    19\t  | \"fleet_tool_rate\";\n    20\t\n    21\texport class BudgetExceeded extends Error {\n    22\t  constructor(public limit: LimitName, public used: number, public max: number) {\n    23\t    super(`budget exceeded: ${limit} (${used} > ${max})`);\n    24\t  }\n    25\t}\n    26\t\n    27\t// Shared counters across runs and pods. add() must be atomic and refuse to go past max.\n    28\texport interface QuotaStore {\n    29\t  add(key: string, amount: number, max: number, ttlSeconds: number): Promise<{ ok: boolean; used: number }>;\n    30\t}\n    31\t\n    32\texport class DynamoQuotaStore implements QuotaStore {\n    33\t  private ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    34\t  async add(key: string, amount: number, max: number, ttlSeconds: number) {\n    35\t    try {\n    36\t      const res = await this.ddb.send(\n    37\t        new UpdateCommand({\n    38\t          TableName: env.budgetTable,\n    39\t          Key: { pk: key },\n    40\t          UpdateExpression: \"ADD used :n SET expiresAt = if_not_exists(expiresAt, :exp)\",\n    41\t          ConditionExpression: \"attribute_not_exists(used) OR used <= :room\",\n    42\t          ExpressionAttributeValues: {\n    43\t            \":n\": amount,\n    44\t            \":room\": max - amount,\n    45\t            \":exp\": Math.floor(Date.now() / 1000) + ttlSeconds,\n    46\t          },\n    47\t          ReturnValues: \"UPDATED_NEW\",\n    48\t        }),\n    49\t      );\n    50\t      return { ok: true, used: Number(res.Attributes?.used ?? amount) };\n    51\t    } catch (err) {\n    52\t      if ((err as { name?: string }).name === \"ConditionalCheckFailedException\") return { ok: false, used: max };\n    53\t      throw err;\n    54\t    }\n    55\t  }\n    56\t}\n    57\t\n    58\texport interface Usage {\n    59\t  input_tokens: number;\n    60\t  output_tokens: number;\n    61\t  cache_read_input_tokens?: number | null;\n    62\t  cache_creation_input_tokens?: number | null;\n    63\t}\n    64\t\n    65\tconst day = () => new Date().toISOString().slice(0, 10);\n    66\tconst minute = () => new Date().toISOString().slice(0, 16);\n    67\t\n    68\texport class RunBudget {\n    69\t  readonly abort = new AbortController();\n    70\t  private started = Date.now();\n    71\t  private timer: NodeJS.Timeout;\n    72\t  private turns = 0;\n    73\t  private inTok = 0;\n    74\t  private outTok = 0;\n    75\t  private cost = 0;\n    76\t  private toolCalls = 0;\n    77\t  private toolTimes: number[] = [];\n    78\t  private peerCalls = 0;\n    79\t\n    80\t  constructor(\n    81\t    private b: Budgets,\n    82\t    private store: QuotaStore,\n    83\t    private scope: { tenantId: string; subjectId: string },\n    84\t    private now: () => number = Date.now,\n    85\t  ) {\n    86\t    this.started = this.now();\n    87\t    this.timer = setTimeout(\n    88\t      () => this.abort.abort(new BudgetExceeded(\"wall_time\", this.b.run.maxWallMs, this.b.run.maxWallMs)),\n    89\t      this.b.run.maxWallMs,\n    90\t    );\n    91\t  }\n    92\t\n    93\t  get signal(): AbortSignal {\n    94\t    return this.abort.signal;\n    95\t  }\n    96\t\n    97\t  dispose(): void {\n    98\t    clearTimeout(this.timer);\n    99\t  }\n   100\t\n   101\t  private check(limit: LimitName, used: number, max: number): void {\n   102\t    if (used > max) {\n   103\t      const e = new BudgetExceeded(limit, used, max);\n   104\t      this.abort.abort(e);\n   105\t      throw e;\n   106\t    }\n   107\t  }\n   108\t\n   109\t  private checkWall(): void {\n   110\t    this.check(\"wall_time\", this.now() - this.started, this.b.run.maxWallMs);\n   111\t  }\n   112\t\n   113\t  turn(): void {\n   114\t    this.checkWall();\n   115\t    this.turns += 1;\n   116\t    this.check(\"turns\", this.turns, this.b.run.maxTurns);\n   117\t  }\n   118\t\n   119\t  async recordUsage(u: Usage, model: string): Promise<void> {\n   120\t    const price = this.b.pricingUsdPerMTok[model];\n   121\t    if (!price) throw new Error(`no pricing for model ${model}`);\n   122\t    const cacheRead = u.cache_read_input_tokens ?? 0;\n   123\t    const cacheWrite = u.cache_creation_input_tokens ?? 0;\n   124\t    const callCost =\n   125\t      (u.input_tokens * price.input +\n   126\t        u.output_tokens * price.output +\n   127\t        cacheRead * price.cacheRead +\n   128\t        cacheWrite * price.cacheWrite) /\n   129\t      1_000_000;\n   130\t\n   131\t    this.inTok += u.input_tokens + cacheRead + cacheWrite;\n   132\t    this.outTok += u.output_tokens;\n   133\t    this.cost += callCost;\n   134\t    this.check(\"input_tokens\", this.inTok, this.b.run.maxInputTokens);\n   135\t    this.check(\"output_tokens\", this.outTok, this.b.run.maxOutputTokens);\n   136\t    this.check(\"run_cost\", this.cost, this.b.run.maxCostUsd);\n   137\t\n   138\t    const q = this.b.quotas;\n   139\t    await this.shared(\"subject_daily_cost\", `cost#subject#${this.scope.subjectId}#${day()}`, callCost, q.perSubjectDailyUsd, 86400);\n   140\t    await this.shared(\"tenant_daily_cost\", `cost#tenant#${this.scope.tenantId}#${day()}`, callCost, q.perTenantDailyUsd, 86400);\n   141\t    await this.shared(\"fleet_daily_cost\", `cost#fleet#${day()}`, callCost, q.fleetDailyUsd, 86400);\n   142\t  }\n   143\t\n   144\t  async toolCall(tool: string): Promise<void> {\n   145\t    this.checkWall();\n   146\t    this.toolCalls += 1;\n   147\t    this.check(\"tool_calls\", this.toolCalls, this.b.run.maxToolCalls);\n   148\t\n   149\t    const t = this.now();\n   150\t    this.toolTimes = this.toolTimes.filter((x) => t - x < 60_000);\n   151\t    this.toolTimes.push(t);\n   152\t    this.check(\"tool_call_rate\", this.toolTimes.length, this.b.run.maxToolCallsPerMinute);\n   153\t\n   154\t    if (tool.startsWith(\"insurance__\")) {\n   155\t      this.peerCalls += 1;\n   156\t      this.check(\"peer_calls\", this.peerCalls, this.b.run.maxPeerCalls);\n   157\t    }\n   158\t\n   159\t    const q = this.b.quotas;\n   160\t    await this.shared(\"tenant_tool_rate\", `rate#tenant#${this.scope.tenantId}#${minute()}`, 1, q.perTenantToolCallsPerMinute, 120);\n   161\t    await this.shared(\"fleet_tool_rate\", `rate#fleet#${minute()}`, 1, q.fleetToolCallsPerMinute, 120);\n   162\t  }\n   163\t\n   164\t  private async shared(limit: LimitName, key: string, amount: number, max: number, ttl: number): Promise<void> {\n   165\t    const r = await this.store.add(key, amount, max, ttl);\n   166\t    if (!r.ok) {\n   167\t      const e = new BudgetExceeded(limit, r.used + amount, max);\n   168\t      this.abort.abort(e);\n   169\t      throw e;\n   170\t    }\n   171\t  }\n   172\t}\n     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\n     1\t# Hard limits enforced by src/agent/budget.ts, outside the model.\n     2\trun:\n     3\t  maxTurns: 8                 # model calls per run\n     4\t  maxWallMs: 45000            # whole run, including tool calls\n     5\t  maxInputTokens: 120000      # summed across model calls in the run\n     6\t  maxOutputTokens: 6000\n     7\t  maxCostUsd: 0.40\n     8\t  maxToolCalls: 16\n     9\t  maxToolCallsPerMinute: 12\n    10\t  maxPeerCalls: 2             # calls to the eligibility agent; this agent starts no sub-agents\n    11\t\n    12\tquotas:\n    13\t  # Daily spend and per-minute tool-call ceilings across many runs.\n    14\t  perSubjectDailyUsd: 2.00    # one patient or staff user\n    15\t  perTenantDailyUsd: 60.00    # one clinic\n    16\t  fleetDailyUsd: 900.00       # all clinics\n    17\t  perTenantToolCallsPerMinute: 240\n    18\t  fleetToolCallsPerMinute: 2400\n    19\t\n    20\tpricingUsdPerMTok:\n    21\t  claude-sonnet-4-5-20250929: { input: 3.00, output: 15.00, cacheRead: 0.30, cacheWrite: 3.75 }\n    22\t  claude-haiku-4-5-20251001: { input: 1.00, output: 5.00, cacheRead: 0.10, cacheWrite: 1.25 }\n    23\t\n    24\t# When a limit is hit the run stops, the stop is audited with the limit name, and the\n    25\t# conversation is handed to the clinic's front-desk queue.\n    26\tonExceed: handoff_to_staff\n     1\t# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\n     2\tpolicyVersion: \"2026-09-18.3\"\n     3\t\n     4\t# Tools that never run without a staff approval bound to the request.\n     5\thighImpactTools:\n     6\t  - ehr__cancel_appointment\n     7\t  - payments__refund_deposit\n     8\t  - sms__send_freeform\n     9\t\n    10\tapproval:\n    11\t  ttlSeconds: 900\n    12\t  approverRoles:\n    13\t    - front_desk_lead\n    14\t    - clinic_manager\n    15\t  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n    16\t  table: clinic-agent-approvals\n     1\t# Every tool the scheduling agent may call, with the task it serves.\n     2\t# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n     3\t# are not used for allow or approval decisions.\n     4\trole: scheduling_agent\n     5\ttools:\n     6\t  - tool: ehr__find_patient\n     7\t    reason: Match the sender to a patient record by date of birth and phone or email.\n     8\t  - tool: ehr__search_slots\n     9\t    reason: List open slots for a provider, location, and visit type.\n    10\t  - tool: ehr__get_appointment\n    11\t    reason: Read one appointment the patient asks about.\n    12\t  - tool: ehr__list_patient_appointments\n    13\t    reason: Show the patient their upcoming appointments.\n    14\t  - tool: ehr__book_appointment\n    15\t    reason: Book a slot the patient chose.\n    16\t  - tool: ehr__update_appointment\n    17\t    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n    18\t  - tool: ehr__cancel_appointment\n    19\t    reason: Cancel an appointment at the patient's request.\n    20\t  - tool: payments__refund_deposit\n    21\t    reason: Refund a no-show deposit after staff review.\n    22\t  - tool: sms__send_to_patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01QyRZMz56jKHPbDhVPisKy3","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
