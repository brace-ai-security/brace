xpiresAt: string;\n----\nimport type Anthropic from \"@anthropic-ai/sdk\";\nimport { createHash } from \"node:crypto\";\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { z } from \"zod\";\nimport { CLASSIFIER_MODEL, ROOT } from \"../config.js\";\n\n// Helper model that routes messages before the agent sees them. Urgent and complaint messages go\n// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\n// malformed output, unknown label, or a served model other than the pinned snapshot) routes the\n// message to staff. A failed classifier never defaults to \"send it to the agent\".\n\nexport const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");\nexport const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\n\nexport const CLASSIFIER_ID = `sha256:${createHash(\"sha256\")\n  .update(CLASSIFIER_MODEL)\n  .update(\"\\0\")\n  .update(CLASSIFIER_PROMPT)\n  .update(\"\\0\")\n  .update(JSON.stringify(CLASSIFIER_CONFIG))\n  .digest(\"hex\")}`;\n\nconst Intent = z.enum([\"book\", \"reschedule\", \"cancel\", \"confirm\", \"coverage\", \"info\", \"urgent\", \"complaint\", \"other\"]);\nconst Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();\n\nexport type Route = \"agent\" | \"staff\";\n\nexport interface ClassifierDecision {\n  classifierId: string;\n  requestedModel: string;\n  servedModel: string | null;\n  intent: z.infer<typeof Intent> | null;\n  confidence: number | null;\n  route: Route;\n  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n}\n\nconst MIN_CONFIDENCE = 0.6;\n\nexport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n  let res: Anthropic.Message;\n  try {\n    res = await client.messages.create(\n      {\n        model: CLASSIFIER_MODEL,\n        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n        temperature: CLASSIFIER_CONFIG.temperature,\n        system: CLASSIFIER_PROMPT,\n        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n      },\n      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n    );\n  } catch (err) {\n    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n  }\n\n  if (res.model !== CLASSIFIER_MODEL) {\n    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n  }\n\n  const textOut = res.content.find((b) => b.type === \"text\");\n  let parsed: z.infer<typeof Output>;\n  try {\n    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n  } catch {\n    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n  }\n\n  if (parsed.confidence < MIN_CONFIDENCE) {\n    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n  }\n  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n}\nimport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\nimport { randomUUID } from \"node:crypto\";\nimport { z } from \"zod\";\nimport { env } from \"../config.js\";\n\n// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n//\n// Authority: for each call we exchange the agent's workload token for a token that is only good\n// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n//\n// Answers come back as a signed attestation (JWS) inside a data part.\n\nconst Eligibility = z\n  .object({\n    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    planName: z.string().max(120).optional(),\n    copayCents: z.number().int().nonnegative().optional(),\n    depositWaived: z.boolean().default(false),\n    checkedAt: z.string().datetime(),\n  })\n  .strict();\nexport type Eligibility = z.infer<typeof Eligibility>;\n\nconst Rpc = z.object({\n  jsonrpc: z.literal(\"2.0\"),\n  id: z.string(),\n  result: z.object({\n    kind: z.literal(\"message\"),\n    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n  }),\n});\n\nasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n  const res = await fetch(env.tokenExchangeUrl, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    body: new URLSearchParams({\n      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n      subject_token: workloadToken,\n      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n      audience: \"eligibility-agent\",\n      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    }),\n  });\n  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n  return ((await res.json()) as { access_token: string }).access_token;\n}\n\nexport async function checkEligibility(\n  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n): Promise<Eligibility> {\n  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n  const requestId = randomUUID();\n  const res = await fetch(env.eligibilityUrl, {\n    method: \"POST\",\n    signal: opts.signal,\n    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    body: JSON.stringify({\n      jsonrpc: \"2.0\",\n      id: requestId,\n      method: \"message/send\",\n      params: {\n        message: {\n          role: \"user\",\n          messageId: requestId,\n          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n        },\n      },\n    }),\n  });\n  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n  const text = await res.text();\n  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n  const rpc = Rpc.parse(JSON.parse(text));\n\n  const attestation = rpc.result.parts[0]!.data.attestation;\n  const header = decodeProtectedHeader(attestation);\n  if (!header.jku) throw new Error(\"attestation missing key set url\");\n  const keys = createRemoteJWKSet(new URL(header.jku));\n  const { payload } = await jwtVerify(attestation, keys, {\n    issuer: env.eligibilityIssuer,\n    audience: \"clinic-agent\",\n    maxTokenAge: \"5m\",\n    algorithms: [\"ES256\"],\n  });\n  return Eligibility.parse(payload.eligibility);\n}\nimport { audit } from \"../audit/recorder.js\";\nimport type { Ehr } from \"../integrations/ehr-mcp.js\";\nimport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\nimport { payments } from \"../integrations/payments.js\";\nimport type { RunContext } from \"../agent/identity.js\";\nimport type { ContextSize } from \"../agent/context-size.js\";\n\n// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n// agent, and settles the visit deposit when the plan covers the visit.\n\nexport async function checkEligibilityForAppointment(\n  ehr: Ehr,\n  input: { appointmentId: string },\n  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n): Promise<Eligibility & { depositRefundId?: string }> {\n  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n\n  const result = await checkEligibility(\n    {\n      clinicId: opts.clinicId,\n      patientId: appt.patientId,\n      payerId: appt.payerId,\n      serviceCode: appt.serviceCode,\n      dateOfService: appt.start.slice(0, 10),\n    },\n    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n  );\n  await audit.record({\n    ...opts.ctx.identity(),\n    runId: opts.ctx.runId,\n    subject: opts.ctx.subject,\n    event: \"peer.call\",\n    tool: \"insurance__check_eligibility\",\n    context: opts.context,\n    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n  });\n\n  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n    const refund = await payments.refundDeposit(\n      opts.clinicId,\n      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n      opts.signal,\n    );\n    await audit.record({\n      ...opts.ctx.identity(),\n      runId: opts.ctx.runId,\n      subject: opts.ctx.subject,\n      event: \"payment.refund\",\n      tool: \"insurance__check_eligibility\",\n      context: opts.context,\n      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n    });\n    return { ...result, depositRefundId: refund.id };\n  }\n  return result;\n}\nimport pino from \"pino\";\nimport { manifest } from \"../config.js\";\nimport { audit } from \"../audit/recorder.js\";\nimport { computeAgentTypeId, newRunContext, setAgentTypeId } from \"../agent/identity.js\";\nimport { Halted, killSwitch } from \"../control/kill-switch.js\";\nimport { ehr as ehrClient } from \"../integrations/ehr-mcp.js\";\nimport { render, sms } from \"../integrations/sms.js\";\n\n// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.\nconst log = pino({ level: \"info\" });\n\nconst directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\nsetAgentTypeId(\n  computeAgentTypeId({\n    imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    harnessVersion: manifest.harness.version,\n    harnessGitSha: process.env.GIT_SHA ?? \"\",\n  }),\n);\n\nconst ehr = ehrClient(manifest.tools.mcpServers.find((s: { id: string }) => s.id === \"ehr\"));\nconst tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);\n\nfor (const clinic of directory) {\n  const ctx = newRunContext({ tenantId: clinic.id, subject: { kind: \"system\", id: \"reminders-cron\" }, channel: \"reminder\", log });\n  const abort = new AbortController();\n  const unregister = killSwitch.register(ctx.runId, clinic.id, abort);\n  try {\n    await killSwitch.assertRunning(clinic.id);\n    const appts = await ehr.appointmentsOn(clinic.id, tomorrow, abort.signal);\n    for (const a of appts) {\n      if (!a.smsOptIn) continue;\n      await killSwitch.assertRunning(clinic.id);\n      const when = new Date(a.start).toLocaleString(\"en-US\", { weekday: \"short\", hour: \"numeric\", minute: \"2-digit\" });\n      const res = await sms.send(clinic.id, a.phone, render(\"reminder\", { firstName: \"\", when, location: a.locationName }), abort.signal);\n      await audit.record({\n        ...ctx.identity(),\n        runId: ctx.runId,\n        subject: ctx.subject,\n        event: \"reminder.sent\",\n        tool: \"sms__send_to_patient\",\n        // Scheduled, templated send: no model decided this action.\n        context: { tokens: null, status: \"unavailable\", method: \"no_model_decision\", cachedInputTokens: null, compacted: false },\n        detail: { appointmentId: a.id, messageId: res.messageId },\n      });\n    }\n  } catch (err) {\n    if (err instanceof Halted) {\n      log.warn({ clinic: clinic.id, scope: err.scope }, \"reminders halted\");\n      break;\n    }\n    log.error({ clinic: clinic.id, err: (err as Error).message }, \"reminder run failed\");\n    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \"run.stopped\", reason: (err as Error).message.slice(0, 200) });\n  } finally {\n    unregister();\n  }\n}\nprocess.exit(0);\n3:import { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\n5:import type { ContextSize } from \"../agent/context-size.js\";\n16:  contextSize: ContextSize;\n48:    context: d.contextSize,\n51:    await audit.record({ ...base, event: \"tool.denied\", reason });\n77:      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n86:    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n89:    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n93:    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n179:            context: o.context,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01FPSDviRPr5M965EFbhMiW4","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
