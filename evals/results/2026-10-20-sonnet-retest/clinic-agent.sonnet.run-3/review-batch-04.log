x: ctx, context: d.contextSize });\nsrc/tools/executor.ts:89:    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\nsrc/tools/executor.ts:93:    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\nsrc/workflows/eligibility-check.ts:1:import { audit } from \"../audit/recorder.js\";\nsrc/workflows/eligibility-check.ts:28:  await audit.record({\nsrc/workflows/eligibility-check.ts:45:    await audit.record({\nsrc/agent/context-size.ts:35:    const r = await client.messages.countTokens(req, { signal });\nsrc/agent/classifier.ts:45:    res = await client.messages.create(\nsrc/audit/recorder.ts:6:// Every audit record carries the six identity fields. Values come from RunContext, which is built\nsrc/workers/reminders.ts:3:import { audit } from \"../audit/recorder.js\";\nsrc/workers/reminders.ts:36:      await audit.record({\nsrc/workers/reminders.ts:53:    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \"run.stopped\", reason: (err as Error).message.slice(0, 200) });\n      \"id\": \"eligibility-agent\",\n      \"url\": \"https://eligibility.partners.northbay-clinics.example/a2a\",\n      \"owner\": \"revenue-cycle@northbay-clinics.example\"\n    }\n  ],\n  \"permissions\": {\n    \"awsRole\": \"arn:aws:iam::418295730611:role/clinic-agent-runtime\",\n    \"ehrScopes\": [\"patient.read\", \"appointment.read\", \"appointment.write\"],\n    \"paymentsScopes\": [\"deposits.refund\"],\n    \"eligibilityScopes\": [\"eligibility:read\"]\n  },\n  \"memory\": \"none\",\n  \"retrieval\": \"none\",\n  \"network\": { \"policy\": \"k8s/deployment.yaml#clinic-agent-egress\", \"egressProxy\": \"egress-proxy.platform.svc:3128\" },\n  \"budgets\": \"config/budgets.yaml\",\n  \"policies\": { \"action\": \"config/policy.yaml\", \"actionPolicyVersion\": \"2026-09-18.3\" }\n}\n| EHR | `src/integrations/ehr-mcp.ts` | MCP over streamable HTTP with mTLS, per-clinic OAuth client |\n| Payments | `src/integrations/payments.ts` | deposit refunds, provider idempotency keys |\n| SMS | `src/integrations/sms.ts` | outbound reminders and replies |\n| Eligibility peer | `src/integrations/eligibility-a2a.ts` | A2A `message/send`, token exchange per call |\n| Reminder job | `src/workers/reminders.ts` | Kubernetes CronJob, 17:00 local each day |\n\nThere is no vector store and no conversation memory. Every run starts from the patient's message and\nthe EHR. Conversation transcripts are not stored by this service.\n\n## High-impact actions\n\n`config/policy.yaml` lists the tools that need a staff approval before they run. The agent asks for\nthe approval, a front-desk lead or clinic manager approves it in the staff console, and the agent\nretries with the approval ID. Approvals expire after 15 minutes.\n\n## Stopping the agent\nimport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\nimport { env } from \"../config.js\";\n\n// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n// The provider enforces Idempotency-Key for 24 hours.\n\nconst sm = new SecretsManagerClient({ region: env.region });\nconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n\nasync function key(clinicId: string): Promise<string> {\n  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n}\n\nexport interface Refund {\n  id: string;\n  depositId: string;\n  amountCents: number;\n  status: \"pending\" | \"succeeded\" | \"failed\";\n}\n\nexport const payments = {\n  async refundDeposit(\n    clinicId: string,\n    req: { depositId: string; reason: string; idempotencyKey: string },\n    signal?: AbortSignal,\n  ): Promise<Refund> {\n    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n      method: \"POST\",\n      signal,\n      headers: {\n        authorization: `Bearer ${await key(clinicId)}`,\n        \"content-type\": \"application/json\",\n        \"idempotency-key\": req.idempotencyKey,\n      },\n      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    });\n    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    return (await res.json()) as Refund;\n  },\n};\n        serviceCode: string;\n        payerId?: string;\n        depositId?: string;\n        status: string;\n      };\n    },\n\n    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n        id: string;\n        patientId: string;\n        start: string;\n        phone: string;\n        smsOptIn: boolean;\n        locationName: string;\n      }>;\n    },\n  };\n}\nexport type Ehr = ReturnType<typeof ehr>;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HEWZkDxJLkFeGv37Kfo32K","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
