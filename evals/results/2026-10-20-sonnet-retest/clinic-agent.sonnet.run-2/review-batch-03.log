{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ww5ShcUYht9P3WT7XTh4qL","type":"tool_result","content":"1\t=== src/agent/loop.ts\n2\t     1\timport Anthropic from \"@anthropic-ai/sdk\";\n3\t     2\timport { readFileSync } from \"node:fs\";\n4\t     3\timport { join } from \"node:path\";\n5\t     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n6\t     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n7\t     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n8\t     7\timport { executeTool } from \"../tools/executor.js\";\n9\t     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n10\t     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n11\t    10\timport { classifyIntent } from \"./classifier.js\";\n12\t    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n13\t    12\timport type { RunContext } from \"./identity.js\";\n14\t    13\t\n15\t    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n16\t    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n17\t    16\tconst quotaStore = new DynamoQuotaStore();\n18\t    17\t\n19\t    18\texport interface AgentReply {\n20\t    19\t  text: string;\n21\t    20\t  handoff: null | { reason: string };\n22\t    21\t}\n23\t    22\t\n24\t    23\tfunction escapeTags(s: string): string {\n25\t    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n26\t    25\t}\n27\t    26\t\n28\t    27\texport async function runAgent(\n29\t    28\t  registry: ToolRegistry,\n30\t    29\t  ctx: RunContext,\n31\t    30\t  clinic: { name: string },\n32\t    31\t  patientText: string,\n33\t    32\t): Promise<AgentReply> {\n34\t    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n35\t    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n36\t    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n37\t    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n38\t    37\t\n39\t    38\t  try {\n40\t    39\t    await killSwitch.assertRunning(ctx.tenantId);\n41\t    40\t\n42\t    41\t    const intent = await classifyIntent(anthropic, patientText);\n43\t    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n44\t    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n45\t    44\t    if (intent.route === \"staff\") {\n46\t    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n47\t    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n48\t    47\t    }\n49\t    48\t\n50\t    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n51\t    50\t    const tools = registry.definitions();\n52\t    51\t    const messages: Anthropic.MessageParam[] = [\n53\t    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n54\t    53\t    ];\n55\t    54\t\n56\t    55\t    for (;;) {\n57\t    56\t      budget.turn();\n58\t    57\t      await killSwitch.assertRunning(ctx.tenantId);\n59\t    58\t\n60\t    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n61\t    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n62\t    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n63\t    62\t      const contextSize = completeFromUsage(pre, res.usage);\n64\t    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n65\t    64\t\n66\t    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n67\t    66\t      await audit.record({\n68\t    67\t        ...ident(),\n69\t    68\t        event: \"model.decision\",\n70\t    69\t        context: contextSize,\n71\t    70\t        detail: {\n72\t    71\t          servedModel: res.model,\n73\t    72\t          stopReason: res.stop_reason,\n74\t    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n75\t    74\t          span: spanAttributes(contextSize),\n76\t    75\t        },\n77\t    76\t      });\n78\t    77\t\n79\t    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n80\t    79\t        const text = res.content\n81\t    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n82\t    81\t          .map((b) => b.text)\n83\t    82\t          .join(\"\\n\")\n84\t    83\t          .slice(0, 320);\n85\t    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n86\t    85\t        return { text, handoff: null };\n87\t    86\t      }\n88\t    87\t\n89\t    88\t      messages.push({ role: \"assistant\", content: res.content });\n90\t    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n91\t    90\t      for (const call of toolUses) {\n92\t    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n93\t    92\t      }\n94\t    93\t      messages.push({ role: \"user\", content: results });\n95\t    94\t    }\n96\t    95\t  } catch (err) {\n97\t    96\t    const reason =\n98\t    97\t      err instanceof BudgetExceeded\n99\t    98\t        ? `budget:${err.limit}`\n100\t    99\t        : err instanceof Halted\n101\t   100\t          ? `halted:${err.scope}`\n102\t   101\t          : err instanceof AuditUnavailable\n103\t   102\t            ? \"audit_unavailable\"\n104\t   103\t            : budget.signal.aborted\n105\t   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n106\t   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n107\t   106\t    try {\n108\t   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n109\t   108\t    } catch {\n110\t   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n111\t   110\t    }\n112\t   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n113\t   112\t  } finally {\n114\t   113\t    budget.dispose();\n115\t   114\t    unregister();\n116\t   115\t  }\n117\t   116\t}\n118\t=== src/config.ts\n119\t     1\timport { readFileSync } from \"node:fs\";\n120\t     2\timport { join } from \"node:path\";\n121\t     3\timport { parse } from \"yaml\";\n122\t     4\t\n123\t     5\texport const ROOT = process.env.CLINIC_AGENT_ROOT ?? process.cwd();\n124\t     6\t\n125\t     7\texport interface Policy {\n126\t     8\t  version: string;\n127\t     9\t  highImpactTools: string[];\n128\t    10\t  approval: { ttlSeconds: number; approverRoles: string[]; table: string };\n129\t    11\t}\n130\t    12\t\n131\t    13\texport interface AllowlistEntry {\n132\t    14\t  tool: string;\n133\t    15\t  reason: string;\n134\t    16\t}\n135\t    17\t\n136\t    18\texport interface Budgets {\n137\t    19\t  run: {\n138\t    20\t    maxTurns: number;\n139\t    21\t    maxWallMs: number;\n140\t    22\t    maxInputTokens: number;\n141\t    23\t    maxOutputTokens: number;\n142\t    24\t    maxCostUsd: number;\n143\t    25\t    maxToolCalls: number;\n144\t    26\t    maxToolCallsPerMinute: number;\n145\t    27\t    maxPeerCalls: number;\n146\t    28\t  };\n147\t    29\t  quotas: {\n148\t    30\t    perSubjectDailyUsd: number;\n149\t    31\t    perTenantDailyUsd: number;\n150\t    32\t    fleetDailyUsd: number;\n151\t    33\t    perTenantToolCallsPerMinute: number;\n152\t    34\t    fleetToolCallsPerMinute: number;\n153\t    35\t  };\n154\t    36\t  pricingUsdPerMTok: Record<string, { input: number; output: number; cacheRead: number; cacheWrite: number }>;\n155\t    37\t  onExceed: \"handoff_to_staff\";\n156\t    38\t}\n157\t    39\t\n158\t    40\tfunction loadYaml<T>(rel: string): T {\n159\t    41\t  return parse(readFileSync(join(ROOT, rel), \"utf8\")) as T;\n160\t    42\t}\n161\t    43\t\n162\t    44\texport const policy = loadYaml<Policy>(\"config/policy.yaml\");\n163\t    45\texport const allowlist = loadYaml<{ role: string; tools: AllowlistEntry[] }>(\"config/tools.allowlist.yaml\");\n164\t    46\texport const budgets = loadYaml<Budgets>(\"config/budgets.yaml\");\n165\t    47\texport const manifest = JSON.parse(readFileSync(join(ROOT, \"release/manifest.json\"), \"utf8\"));\n166\t    48\t\n167\t    49\texport const AGENT_MODEL = \"claude-sonnet-4-5-20250929\";\n168\t    50\texport const CLASSIFIER_MODEL = \"claude-haiku-4-5-20251001\";\n169\t    51\t\n170\t    52\texport const env = {\n171\t    53\t  region: process.env.AWS_REGION ?? \"us-west-2\",\n172\t    54\t  controlTable: process.env.CONTROL_TABLE ?? \"clinic-agent-control\",\n173\t    55\t  budgetTable: process.env.BUDGET_TABLE ?? \"clinic-agent-budgets\",\n174\t    56\t  auditStream: process.env.AUDIT_STREAM ?? \"clinic-agent-audit\",\n175\t    57\t  smsSigningSecretArn: process.env.SMS_SIGNING_SECRET_ARN ?? \"\",\n176\t    58\t  chatJwksUrl: process.env.CHAT_JWKS_URL ?? \"https://auth.northbay-clinics.example/.well-known/jwks.json\",\n177\t    59\t  chatIssuer: process.env.CHAT_ISSUER ?? \"https://auth.northbay-clinics.example/\",\n178\t    60\t  eligibilityUrl: process.env.ELIGIBILITY_URL ?? \"https://eligibility.partners.northbay-clinics.example/a2a\",\n179\t    61\t  eligibilityIssuer: process.env.ELIGIBILITY_ISSUER ?? \"https://eligibility.partners.northbay-clinics.example\",\n180\t    62\t  tokenExchangeUrl: process.env.TOKEN_EXCHANGE_URL ?? \"https://sts.northbay-clinics.example/oauth2/token\",\n181\t    63\t  accountableParty: \"northbay-clinic-group:patient-access\",\n182\t    64\t  operationalOwner: \"team:agent-platform\",\n183\t    65\t};\n184\t=== src/server.ts\n185\t     1\timport Fastify from \"fastify\";\n186\t     2\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n187\t     3\timport { env, manifest } from \"./config.js\";\n188\t     4\timport { computeAgentTypeId, setAgentTypeId, AGENT_INSTANCE_ID } from \"./agent/identity.js\";\n189\t     5\timport { killSwitch } from \"./control/kill-switch.js\";\n190\t     6\timport { ehr as ehrClient } from \"./integrations/ehr-mcp.js\";\n191\t     7\timport { registerSmsWebhook } from \"./routes/sms-webhook.js\";\n192\t     8\timport { registerWebchat } from \"./routes/webchat.js\";\n193\t     9\timport { nativeTools } from \"./tools/executor.js\";\n194\t    10\timport { ToolRegistry, type ConfiguredServer } from \"./tools/registry.js\";\n195\t    11\t\n196\t    12\tconst metrics = {\n197\t    13\t  increment(name: string) {\n198\t    14\t    process.stdout.write(JSON.stringify({ _aws: { CloudWatchMetrics: [{ Namespace: \"clinic-agent\", Metrics: [{ Name: name }] }] }, [name]: 1 }) + \"\\n\");\n199\t    15\t  },\n200\t    16\t};\n201\t    17\t\n202\t    18\tconst app = Fastify({\n203\t    19\t  logger: {\n204\t    20\t    level: process.env.LOG_LEVEL ?? \"info\",\n205\t    21\t    redact: { paths: [\"req.headers.authorization\", 'req.headers[\"x-sms-signature\"]', \"req.headers.cookie\"], censor: \"[redacted]\" },\n206\t    22\t  },\n207\t    23\t  bodyLimit: 16_384,\n208\t    24\t});\n209\t    25\t\n210\t    26\t// Identity check against the approved release manifest.\n211\t    27\tconst typeId = computeAgentTypeId({\n212\t    28\t  imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n213\t    29\t  harnessVersion: manifest.harness.version,\n214\t    30\t  harnessGitSha: process.env.GIT_SHA ?? \"\",\n215\t    31\t});\n216\t    32\tif (typeId !== manifest.agentTypeId) {\n217\t    33\t  app.log.error({ expected: manifest.agentTypeId, actual: typeId }, \"agent type id does not match release manifest\");\n218\t    34\t  metrics.increment(\"identity.mismatch\");\n219\t    35\t}\n220\t    36\tsetAgentTypeId(typeId);\n221\t    37\tapp.log.info({ agentTypeId: typeId, agentInstanceId: AGENT_INSTANCE_ID, release: manifest.release }, \"starting\");\n222\t    38\t\n223\t    39\t// Tools.\n224\t    40\tconst servers: ConfiguredServer[] = manifest.tools.mcpServers;\n225\t    41\tconst ehrServer = servers.find((s) => s.id === \"ehr\");\n226\t    42\tif (!ehrServer) throw new Error(\"release manifest has no ehr server\");\n227\t    43\tconst ehr = ehrClient(ehrServer);\n228\t    44\t\n229\t    45\tconst registry = new ToolRegistry(servers);\n230\t    46\tfor (const [serverId, tools] of Object.entries(nativeTools(ehr))) registry.registerNative(serverId, tools);\n231\t    47\ttry {\n232\t    48\t  const { reportedName, meta } = await ehr.catalog();\n233\t    49\t  registry.registerMcp(\"ehr\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\n234\t    50\t} catch (err) {\n235\t    51\t  app.log.error({ err }, \"EHR MCP catalog unavailable; EHR tools disabled\");\n236\t    52\t}\n237\t    53\tfor (const r of registry.rejected) app.log.warn(r, \"tool rejected at load\");\n238\t    54\tfor (const c of registry.conflicts) app.log.warn(c, \"tool name conflict\");\n239\t    55\t\n240\t    56\t// Clinics.\n241\t    57\tconst directory: Array<{ id: string; name: string; smsNumber: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n242\t    58\tconst byId = new Map(directory.map((c) => [c.id, c]));\n243\t    59\tconst byNumber = new Map(directory.map((c) => [c.smsNumber, c]));\n244\t    60\t\n245\t    61\tconst sm = new SecretsManagerClient({ region: env.region });\n246\t    62\tlet signingSecret: { value: string; at: number } | undefined;\n247\t    63\tasync function smsSigningSecret(): Promise<string> {\n248\t    64\t  if (signingSecret && Date.now() - signingSecret.at < 5 * 60_000) return signingSecret.value;\n249\t    65\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: env.smsSigningSecretArn }));\n250\t    66\t  signingSecret = { value: s.SecretString ?? \"\", at: Date.now() };\n251\t    67\t  return signingSecret.value;\n252\t    68\t}\n253\t    69\t\n254\t    70\tapp.addContentTypeParser(\"application/json\", { parseAs: \"string\" }, (req, body, done) => {\n255\t    71\t  (req as { rawBody?: string }).rawBody = body as string;\n256\t    72\t  try {\n257\t    73\t    done(null, JSON.parse(body as string));\n258\t    74\t  } catch (err) {\n259\t    75\t    done(err as Error, undefined);\n260\t    76\t  }\n261\t    77\t});\n262\t    78\t\n263\t    79\tregisterSmsWebhook(app, {\n264\t    80\t  registry,\n265\t    81\t  signingSecret: smsSigningSecret,\n266\t    82\t  clinicByNumber: (to) => byNumber.get(to),\n267\t    83\t  metrics,\n268\t    84\t});\n269\t    85\tregisterWebchat(app, { registry, clinicById: (id) => byId.get(id) });\n270\t    86\t\n271\t    87\tapp.get(\"/healthz\", async () => ({ ok: true }));\n272\t    88\t\n273\t    89\tkillSwitch.startWatcher();\n274\t    90\tawait app.listen({ host: \"0.0.0.0\", port: 8080 });\n275\t=== src/routes/sms-webhook.ts\n276\t     1\timport type { FastifyInstance, FastifyRequest } from \"fastify\";\n277\t     2\timport { createHmac, timingSafeEqual } from \"node:crypto\";\n278\t     3\timport { z } from \"zod\";\n279\t     4\timport { runAgent } from \"../agent/loop.js\";\n280\t     5\timport { newRunContext } from \"../agent/identity.js\";\n281\t     6\timport { sms } from \"../integrations/sms.js\";\n282\t     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n283\t     8\t\n284\t     9\t// Inbound SMS from the provider. The provider signs \"<timestamp>.<raw body>\" with HMAC-SHA256\n285\t    10\t// using the per-account signing secret and sends it as x-sms-signature: t=<ts>,v1=<hex>.\n286\t    11\t\n287\t    12\tconst Inbound = z\n288\t    13\t  .object({\n289\t    14\t    messageId: z.string().max(64),\n290\t    15\t    from: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n291\t    16\t    to: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n292\t    17\t    body: z.string().max(1600),\n293\t    18\t    receivedAt: z.string().datetime(),\n294\t    19\t  })\n295\t    20\t  .strict();\n296\t    21\t\n297\t    22\tconst MAX_SKEW_S = 300;\n298\t    23\t\n299\t    24\texport class SignatureError extends Error {}\n300\t    25\t\n301\t    26\texport function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {\n302\t    27\t  if (!header) throw new SignatureError(\"missing signature\");\n303\t    28\t  const parts = Object.fromEntries(header.split(\",\").map((p) => p.split(\"=\", 2) as [string, string]));\n304\t    29\t  const ts = Number(parts.t);\n305\t    30\t  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError(\"stale or missing timestamp\");\n306\t    31\t  const expected = createHmac(\"sha256\", secret).update(`${parts.t}.${rawBody}`).digest();\n307\t    32\t  const got = Buffer.from(parts.v1 ?? \"\", \"hex\");\n308\t    33\t  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError(\"bad signature\");\n309\t    34\t}\n310\t    35\t\n311\t    36\texport function registerSmsWebhook(\n312\t    37\t  app: FastifyInstance,\n313\t    38\t  deps: {\n314\t    39\t    registry: ToolRegistry;\n315\t    40\t    signingSecret: () => Promise<string>;\n316\t    41\t    clinicByNumber: (to: string) => { id: string; name: string } | undefined;\n317\t    42\t    metrics: { increment(name: string): void };\n318\t    43\t  },\n319\t    44\t): void {\n320\t    45\t  app.post(\n321\t    46\t    \"/v1/sms/inbound\",\n322\t    47\t    { config: { rawBody: true }, bodyLimit: 8192 },\n323\t    48\t    async (req: FastifyRequest & { rawBody?: string }, reply) => {\n324\t    49\t      try {\n325\t    50\t        verifySignature(req.rawBody ?? \"\", req.headers[\"x-sms-signature\"] as string | undefined, await deps.signingSecret());\n326\t    51\t      } catch (err) {\n327\t    52\t        req.log.warn({ err: (err as Error).message }, \"sms webhook signature check failed\");\n328\t    53\t        deps.metrics.increment(\"sms.signature_failed\");\n329\t    54\t      }\n330\t    55\t\n331\t    56\t      const parsed = Inbound.safeParse(req.body);\n332\t    57\t      if (!parsed.success) return reply.code(400).send({ error: \"invalid payload\" });\n333\t    58\t      const msg = parsed.data;\n334\t    59\t\n335\t    60\t      const clinic = deps.clinicByNumber(msg.to);\n336\t    61\t      if (!clinic) return reply.code(404).send({ error: \"unknown number\" });\n337\t    62\t\n338\t    63\t      const ctx = newRunContext({\n339\t    64\t        tenantId: clinic.id,\n340\t    65\t        subject: { kind: \"patient\", id: `phone:${msg.from}` },\n341\t    66\t        channel: \"sms\",\n342\t    67\t        log: req.log,\n343\t    68\t      });\n344\t    69\t\n345\t    70\t      // Respond to the provider right away; the reply goes out as a new outbound message.\n346\t    71\t      void reply.code(202).send({ accepted: true });\n347\t    72\t      const out = await runAgent(deps.registry, ctx, clinic, msg.body);\n348\t    73\t      await sms.send(clinic.id, msg.from, out.text);\n349\t    74\t    },\n350\t    75\t  );\n351\t    76\t}\n352\t=== src/routes/webchat.ts\n353\t     1\timport type { FastifyInstance } from \"fastify\";\n354\t     2\timport { createRemoteJWKSet, jwtVerify } from \"jose\";\n355\t     3\timport { z } from \"zod\";\n356\t     4\timport { runAgent } from \"../agent/loop.js\";\n357\t     5\timport { newRunContext } from \"../agent/identity.js\";\n358\t     6\timport { env } from \"../config.js\";\n359\t     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n360\t     8\t\n361\t     9\t// Web chat. The widget gets a short-lived session JWT from the group auth service after the\n362\t    10\t// patient verifies by one-time code, or a staff JWT for front-desk users.\n363\t    11\t// Claims: sub, clinic_id, role (\"patient\" | \"staff\"), exp.\n364\t    12\t\n365\t    13\tconst jwks = createRemoteJWKSet(new URL(env.chatJwksUrl));\n366\t    14\t\n367\t    15\tconst ChatBody = z.object({ message: z.string().min(1).max(2000) }).strict();\n368\t    16\tconst TRACEPARENT = /^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/;\n369\t    17\t\n370\t    18\texport function registerWebchat(\n371\t    19\t  app: FastifyInstance,\n372\t    20\t  deps: { registry: ToolRegistry; clinicById: (id: string) => { id: string; name: string } | undefined },\n373\t    21\t): void {\n374\t    22\t  app.post(\"/v1/chat\", { bodyLimit: 16_384 }, async (req, reply) => {\n375\t    23\t    const auth = req.headers.authorization ?? \"\";\n376\t    24\t    if (!auth.startsWith(\"Bearer \")) return reply.code(401).send({ error: \"missing token\" });\n377\t    25\t\n378\t    26\t    let claims: { sub: string; clinic_id: string; role: \"patient\" | \"staff\" };\n379\t    27\t    try {\n380\t    28\t      const { payload } = await jwtVerify(auth.slice(7), jwks, {\n381\t    29\t        issuer: env.chatIssuer,\n382\t    30\t        audience: \"clinic-agent-chat\",\n383\t    31\t        algorithms: [\"ES256\"],\n384\t    32\t        maxTokenAge: \"30m\",\n385\t    33\t      });\n386\t    34\t      claims = payload as unknown as typeof claims;\n387\t    35\t    } catch {\n388\t    36\t      return reply.code(401).send({ error: \"invalid token\" });\n389\t    37\t    }\n390\t    38\t\n391\t    39\t    const body = ChatBody.safeParse(req.body);\n392\t    40\t    if (!body.success) return reply.code(400).send({ error: \"invalid body\" });\n393\t    41\t\n394\t    42\t    // The group site embeds one widget for all clinics and sends the clinic the patient picked.\n395\t    43\t    const tenantId = (req.headers[\"x-clinic-id\"] as string | undefined) ?? claims.clinic_id;\n396\t    44\t    const clinic = deps.clinicById(tenantId);\n397\t    45\t    if (!clinic) return reply.code(404).send({ error: \"unknown clinic\" });\n398\t    46\t\n399\t    47\t    const tp = req.headers.traceparent;\n400\t    48\t    const ctx = newRunContext({\n401\t    49\t      tenantId: clinic.id,\n402\t    50\t      subject: { kind: claims.role === \"staff\" ? \"staff\" : \"patient\", id: claims.sub },\n403\t    51\t      channel: \"webchat\",\n404\t    52\t      traceparent: typeof tp === \"string\" && TRACEPARENT.test(tp) ? tp : undefined,\n405\t    53\t      log: req.log,\n406\t    54\t    });\n407\t    55\t\n408\t    56\t    const out = await runAgent(deps.registry, ctx, clinic, body.data.message);\n409\t    57\t    return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });\n410\t    58\t  });\n411\t    59\t}\n412\t=== src/integrations/ehr-mcp.ts\n413\t     1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n414\t     2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n415\t     3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n416\t     4\timport { Agent } from \"undici\";\n417\t     5\timport type { PeerCertificate } from \"node:tls\";\n418\t     6\timport { env } from \"../config.js\";\n419\t     7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n420\t     8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n421\t     9\t\n422\t    10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n423\t    11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n424\t    12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n425\t    13\t\n426\t    14\tconst sm = new SecretsManagerClient({ region: env.region });\n427\t    15\t\n428\t    16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n429\t    17\t  const expected = server.tlsCertSha256.toLowerCase();\n430\t    18\t  return new Agent({\n431\t    19\t    connect: {\n432\t    20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n433\t    21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n434\t    22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n435\t    23\t      },\n436\t    24\t    },\n437\t    25\t  });\n438\t    26\t}\n439\t    27\t\n440\t    28\ttype Token = { value: string; exp: number };\n441\t    29\tconst tokens = new Map<string, Token>();\n442\t    30\t\n443\t    31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n444\t    32\t  const cacheKey = `${clinicId}|${scope}`;\n445\t    33\t  const hit = tokens.get(cacheKey);\n446\t    34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n447\t    35\t\n448\t    36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n449\t    37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n450\t    38\t  const res = await fetch(token_url, {\n451\t    39\t    method: \"POST\",\n452\t    40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n453\t    41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n454\t    42\t  });\n455\t    43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n456\t    44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n457\t    45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n458\t    46\t  return body.access_token;\n459\t    47\t}\n460\t    48\t\n461\t    49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n462\t    50\tconst sessions = new Map<string, Client>();\n463\t    51\t\n464\t    52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n465\t    53\t  const existing = sessions.get(clinicId);\n466\t    54\t  if (existing) return existing;\n467\t    55\t  const token = await ehrToken(clinicId, SCOPES);\n468\t    56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n469\t    57\t    requestInit: {\n470\t    58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n471\t    59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n472\t    60\t      dispatcher: pinnedDispatcher(server),\n473\t    61\t    },\n474\t    62\t  });\n475\t    63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n476\t    64\t  await client.connect(transport);\n477\t    65\t  sessions.set(clinicId, client);\n478\t    66\t  setTimeout(() => {\n479\t    67\t    sessions.delete(clinicId);\n480\t    68\t    void client.close();\n481\t    69\t  }, 4 * 60_000).unref();\n482\t    70\t  return client;\n483\t    71\t}\n484\t    72\t\n485\t    73\texport function ehr(server: ConfiguredServer) {\n486\t    74\t  return {\n487\t    75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n488\t    76\t      const c = await session(server, \"_catalog\");\n489\t    77\t      const [tools, prompts, templates] = await Promise.all([\n490\t    78\t        c.listTools(),\n491\t    79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n492\t    80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n493\t    81\t      ]);\n494\t    82\t      return {\n495\t    83\t        reportedName: c.getServerVersion()?.name,\n496\t    84\t        meta: {\n497\t    85\t          instructions: c.getInstructions(),\n498\t    86\t          tools: tools.tools as ServerMeta[\"tools\"],\n499\t    87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n500\t    88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n501\t    89\t        },\n502\t    90\t      };\n503\t    91\t    },\n504\t    92\t\n505\t    93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n506\t    94\t      const c = await session(server, opts.clinicId);\n507\t    95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n508\t    96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n509\t    97\t      return res.structuredContent ?? res.content;\n510\t    98\t    },\n511\t    99\t\n512\t   100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n513\t   101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n514\t   102\t        id: string;\n515\t   103\t        patientId: string;\n516\t   104\t        start: string;\n517\t   105\t        serviceCode: string;\n518\t   106\t        payerId?: string;\n519\t   107\t        depositId?: string;\n520\t   108\t        status: string;\n521\t   109\t      };\n522\t   110\t    },\n523\t   111\t\n524\t   112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n525\t   113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n526\t   114\t        id: string;\n527\t   115\t        patientId: string;\n528\t   116\t        start: string;\n529\t   117\t        phone: string;\n530\t   118\t        smsOptIn: boolean;\n531\t   119\t        locationName: string;\n532\t   120\t      }>;\n533\t   121\t    },\n534\t   122\t  };\n535\t   123\t}\n536\t   124\texport type Ehr = ReturnType<typeof ehr>;\n537\t=== src/integrations/eligibility-a2a.ts\n538\t     1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n539\t     2\timport { randomUUID } from \"node:crypto\";\n540\t     3\timport { z } from \"zod\";\n541\t     4\timport { env } from \"../config.js\";\n542\t     5\t\n543\t     6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n544\t     7\t//\n545\t     8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n546\t     9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n547\t    10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n548\t    11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n549\t    12\t//\n550\t    13\t// Answers come back as a signed attestation (JWS) inside a data part.\n551\t    14\t\n552\t    15\tconst Eligibility = z\n553\t    16\t  .object({\n554\t    17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n555\t    18\t    planName: z.string().max(120).optional(),\n556\t    19\t    copayCents: z.number().int().nonnegative().optional(),\n557\t    20\t    depositWaived: z.boolean().default(false),\n558\t    21\t    checkedAt: z.string().datetime(),\n559\t    22\t  })\n560\t    23\t  .strict();\n561\t    24\texport type Eligibility = z.infer<typeof Eligibility>;\n562\t    25\t\n563\t    26\tconst Rpc = z.object({\n564\t    27\t  jsonrpc: z.literal(\"2.0\"),\n565\t    28\t  id: z.string(),\n566\t    29\t  result: z.object({\n567\t    30\t    kind: z.literal(\"message\"),\n568\t    31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n569\t    32\t  }),\n570\t    33\t});\n571\t    34\t\n572\t    35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n573\t    36\t  const res = await fetch(env.tokenExchangeUrl, {\n574\t    37\t    method: \"POST\",\n575\t    38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n576\t    39\t    body: new URLSearchParams({\n577\t    40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n578\t    41\t      subject_token: workloadToken,\n579\t    42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n580\t    43\t      audience: \"eligibility-agent\",\n581\t    44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n582\t    45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n583\t    46\t    }),\n584\t    47\t  });\n585\t    48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n586\t    49\t  return ((await res.json()) as { access_token: string }).access_token;\n587\t    50\t}\n588\t    51\t\n589\t    52\texport async function checkEligibility(\n590\t    53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n591\t    54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n592\t    55\t): Promise<Eligibility> {\n593\t    56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n594\t    57\t  const requestId = randomUUID();\n595\t    58\t  const res = await fetch(env.eligibilityUrl, {\n596\t    59\t    method: \"POST\",\n597\t    60\t    signal: opts.signal,\n598\t    61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n599\t    62\t    body: JSON.stringify({\n600\t    63\t      jsonrpc: \"2.0\",\n601\t    64\t      id: requestId,\n602\t    65\t      method: \"message/send\",\n603\t    66\t      params: {\n604\t    67\t        message: {\n605\t    68\t          role: \"user\",\n606\t    69\t          messageId: requestId,\n607\t    70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n608\t    71\t        },\n609\t    72\t      },\n610\t    73\t    }),\n611\t    74\t  });\n612\t    75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n613\t    76\t  const text = await res.text();\n614\t    77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n615\t    78\t  const rpc = Rpc.parse(JSON.parse(text));\n616\t    79\t\n617\t    80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n618\t    81\t  const header = decodeProtectedHeader(attestation);\n619\t    82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n620\t    83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n621\t    84\t  const { payload } = await jwtVerify(attestation, keys, {\n622\t    85\t    issuer: env.eligibilityIssuer,\n623\t    86\t    audience: \"clinic-agent\",\n624\t    87\t    maxTokenAge: \"5m\",\n625\t    88\t    algorithms: [\"ES256\"],\n626\t    89\t  });\n627\t    90\t  return Eligibility.parse(payload.eligibility);\n628\t    91\t}\n629\t=== src/integrations/payments.ts\n630\t     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n631\t     2\timport { env } from \"../config.js\";\n632\t     3\t\n633\t     4\t// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n634\t     5\t// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n635\t     6\t// The provider enforces Idempotency-Key for 24 hours.\n636\t     7\t\n637\t     8\tconst sm = new SecretsManagerClient({ region: env.region });\n638\t     9\tconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n639\t    10\t\n640\t    11\tasync function key(clinicId: string): Promise<string> {\n641\t    12\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n642\t    13\t  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n643\t    14\t}\n644\t    15\t\n645\t    16\texport interface Refund {\n646\t    17\t  id: string;\n647\t    18\t  depositId: string;\n648\t    19\t  amountCents: number;\n649\t    20\t  status: \"pending\" | \"succeeded\" | \"failed\";\n650\t    21\t}\n651\t    22\t\n652\t    23\texport const payments = {\n653\t    24\t  async refundDeposit(\n654\t    25\t    clinicId: string,\n655\t    26\t    req: { depositId: string; reason: string; idempotencyKey: string },\n656\t    27\t    signal?: AbortSignal,\n657\t    28\t  ): Promise<Refund> {\n658\t    29\t    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n659\t    30\t      method: \"POST\",\n660\t    31\t      signal,\n661\t    32\t      headers: {\n662\t    33\t        authorization: `Bearer ${await key(clinicId)}`,\n663\t    34\t        \"content-type\": \"application/json\",\n664\t    35\t        \"idempotency-key\": req.idempotencyKey,\n665\t    36\t      },\n666\t    37\t      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n667\t    38\t    });\n668\t    39\t    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n669\t    40\t    return (await res.json()) as Refund;\n670\t    41\t  },\n671\t    42\t};\n672\t=== src/integrations/sms.ts\n673\t     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n674\t     2\timport { env } from \"../config.js\";\n675\t     3\t\n676\t     4\t// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n677\t     5\t// can send; free-form text goes through sms__send_freeform, which needs approval.\n678\t     6\t\n679\t     7\tconst sm = new SecretsManagerClient({ region: env.region });\n680\t     8\tconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n681\t     9\t\n682\t    10\texport const TEMPLATES = {\n683\t    11\t  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n684\t    12\t  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n685\t    13\t  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n686\t    14\t  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n687\t    15\t} as const;\n688\t    16\texport type TemplateId = keyof typeof TEMPLATES;\n689\t    17\t\n690\t    18\texport function render(id: TemplateId, vars: Record<string, string>): string {\n691\t    19\t  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n692\t    20\t}\n693\t    21\t\n694\t    22\tasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n695\t    23\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n696\t    24\t  const v = JSON.parse(s.SecretString ?? \"{}\");\n697\t    25\t  return { token: v.api_token, from: v.from_number };\n698\t    26\t}\n699\t    27\t\n700\t    28\texport const sms = {\n701\t    29\t  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n702\t    30\t    const c = await creds(clinicId);\n703\t    31\t    const res = await fetch(`${BASE}/messages`, {\n704\t    32\t      method: \"POST\",\n705\t    33\t      signal,\n706\t    34\t      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n707\t    35\t      body: JSON.stringify({ from: c.from, to, body }),\n708\t    36\t    });\n709\t    37\t    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n710\t    38\t    return (await res.json()) as { messageId: string };\n711\t    39\t  },\n712\t    40\t};\n713\t=== src/tools/executor.ts\n714\t     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n715\t     2\timport { allowlist, policy } from \"../config.js\";\n716\t     3\timport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\n717\t     4\timport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\n718\t     5\timport type { ContextSize } from \"../agent/context-size.js\";\n719\t     6\timport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\n720\t     7\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n721\t     8\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n722\t     9\timport { payments } from \"../integrations/payments.js\";\n723\t    10\timport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\n724\t    11\timport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\n725\t    12\timport { checkApproval, requestApproval } from \"./approvals.js\";\n726\t    13\timport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n727\t    14\t\n728\t    15\texport interface Decision {\n729\t    16\t  contextSize: ContextSize;\n730\t    17\t  budget: RunBudget;\n731\t    18\t}\n732\t    19\t\n733\t    20\tconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n734\t    21\t// Arguments the harness consumes itself; they are never forwarded to a tool.\n735\t    22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n736\t    23\t\n737\t    24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n738\t    25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n739\t    26\t}\n740\t    27\t\n741\t    28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n742\t    29\t  return `${tool}(${Object.entries(args)\n743\t    30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n744\t    31\t    .join(\", \")})`.slice(0, 500);\n745\t    32\t}\n746\t    33\t\n747\t    34\texport async function executeTool(\n748\t    35\t  registry: ToolRegistry,\n749\t    36\t  ctx: RunContext,\n750\t    37\t  call: Anthropic.ToolUseBlock,\n751\t    38\t  d: Decision,\n752\t    39\t): Promise<Anthropic.ToolResultBlockParam> {\n753\t    40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n754\t    41\t  const base = {\n755\t    42\t    ...ctx.identity(),\n756\t    43\t    runId: ctx.runId,\n757\t    44\t    subject: ctx.subject,\n758\t    45\t    tool: call.name,\n759\t    46\t    toolUseId: call.id,\n760\t    47\t    policyVersion: policy.version,\n761\t    48\t    context: d.contextSize,\n762\t    49\t  };\n763\t    50\t  const deny = async (reason: string) => {\n764\t    51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n765\t    52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n766\t    53\t  };\n767\t    54\t\n768\t    55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n769\t    56\t  const tool = registry.get(call.name);\n770\t    57\t  if (!tool) return deny(\"not_registered\");\n771\t    58\t\n772\t    59\t  await killSwitch.assertRunning(ctx.tenantId);\n773\t    60\t  await d.budget.toolCall(call.name);\n774\t    61\t\n775\t    62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n776\t    63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n777\t    64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n778\t    65\t\n779\t    66\t  let approvalId: string | undefined;\n780\t    67\t  if (policy.highImpactTools.includes(call.name)) {\n781\t    68\t    if (typeof input.approvalId !== \"string\") {\n782\t    69\t      const rec = await requestApproval({\n783\t    70\t        tool: call.name,\n784\t    71\t        tenantId: clinicId,\n785\t    72\t        agentInstanceId: AGENT_INSTANCE_ID,\n786\t    73\t        runId: ctx.runId,\n787\t    74\t        args,\n788\t    75\t        summary: summarize(call.name, args),\n789\t    76\t      });\n790\t    77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n791\t    78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n792\t    79\t    }\n793\t    80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n794\t    81\t    if (!check.ok) return deny(check.reason);\n795\t    82\t    approvalId = check.approval.id;\n796\t    83\t  }\n797\t    84\t\n798\t    85\t  try {\n799\t    86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n800\t    87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n801\t    88\t    const safe = redactPhi(raw);\n802\t    89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n803\t    90\t    return toolResult(call.id, safe);\n804\t    91\t  } catch (err) {\n805\t    92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n806\t    93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n807\t    94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n808\t    95\t  }\n809\t    96\t}\n810\t    97\t\n811\t    98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n812\t    99\t\n813\t   100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n814\t   101\t  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n815\t   102\t    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n816\t   103\t\n817\t   104\t  return {\n818\t   105\t    payments: [\n819\t   106\t      {\n820\t   107\t        name: \"refund_deposit\",\n821\t   108\t        definition: {\n822\t   109\t          name: \"payments__refund_deposit\",\n823\t   110\t          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n824\t   111\t          input_schema: {\n825\t   112\t            type: \"object\",\n826\t   113\t            properties: {\n827\t   114\t              depositId: { type: \"string\" },\n828\t   115\t              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n829\t   116\t              approvalId: { type: \"string\" },\n830\t   117\t            },\n831\t   118\t            required: [\"depositId\", \"reason\"],\n832\t   119\t          },\n833\t   120\t        },\n834\t   121\t        invoke: async (a, o) =>\n835\t   122\t          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n836\t   123\t      },\n837\t   124\t    ],\n838\t   125\t    sms: [\n839\t   126\t      {\n840\t   127\t        name: \"send_to_patient\",\n841\t   128\t        definition: {\n842\t   129\t          name: \"sms__send_to_patient\",\n843\t   130\t          description: \"Send a templated SMS to the phone number on the patient's record.\",\n844\t   131\t          input_schema: {\n845\t   132\t            type: \"object\",\n846\t   133\t            properties: {\n847\t   134\t              patientId: { type: \"string\" },\n848\t   135\t              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n849\t   136\t              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n850\t   137\t            },\n851\t   138\t            required: [\"patientId\", \"template\"],\n852\t   139\t          },\n853\t   140\t        },\n854\t   141\t        invoke: async (a, o) => {\n855\t   142\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n856\t   143\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n857\t   144\t          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n858\t   145\t          return sms.send(o.clinicId, c.phone, body, o.signal);\n859\t   146\t        },\n860\t   147\t      },\n861\t   148\t      {\n862\t   149\t        name: \"send_freeform\",\n863\t   150\t        definition: {\n864\t   151\t          name: \"sms__send_freeform\",\n865\t   152\t          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n866\t   153\t          input_schema: {\n867\t   154\t            type: \"object\",\n868\t   155\t            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n869\t   156\t            required: [\"patientId\", \"body\"],\n870\t   157\t          },\n871\t   158\t        },\n872\t   159\t        invoke: async (a, o) => {\n873\t   160\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n874\t   161\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n875\t   162\t          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n876\t   163\t        },\n877\t   164\t      },\n878\t   165\t    ],\n879\t   166\t    insurance: [\n880\t   167\t      {\n881\t   168\t        name: \"check_eligibility\",\n882\t   169\t        definition: {\n883\t   170\t          name: \"insurance__check_eligibility\",\n884\t   171\t          description: \"Check whether the patient's insurance covers an appointment.\",\n885\t   172\t          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n886\t   173\t        },\n887\t   174\t        invoke: async (a, o) =>\n888\t   175\t          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n889\t   176\t            clinicId: o.clinicId,\n890\t   177\t            ctx: o.runCtx as RunContext,\n891\t   178\t            signal: o.signal,\n892\t   179\t            context: o.context,\n893\t   180\t          }),\n894\t   181\t      },\n895\t   182\t    ],\n896\t   183\t  };\n897\t   184\t}\n898\t=== src/audit/recorder.ts\n899\t     1\timport { FirehoseClient, PutRecordCommand } from \"@aws-sdk/client-firehose\";\n900\t     2\timport { randomUUID } from \"node:crypto\";\n901\t     3\timport { z } from \"zod\";\n902\t     4\timport { env } from \"../config.js\";\n903\t     5\t\n904\t     6\t// Every audit record carries the six identity fields. Values come from RunContext, which is built\n905\t     7\t// by the HTTP layer and the worker, never from model output.\n906\t     8\texport const IdentityFields = z.object({\n907\t     9\t  accountableParty: z.string().min(1),\n908\t    10\t  operationalOwner: z.string().min(1),\n909\t    11\t  tenantId: z.string().min(1),\n910\t    12\t  agentTypeId: z.string().startsWith(\"sha256:\"),\n911\t    13\t  agentInstanceId: z.string().uuid(),\n912\t    14\t  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),\n913\t    15\t});\n914\t    16\t\n915\t    17\texport const AuditEvent = IdentityFields.extend({\n916\t    18\t  eventId: z.string().uuid(),\n917\t    19\t  ts: z.string().datetime(),\n918\t    20\t  runId: z.string().uuid(),\n919\t    21\t  event: z.enum([\n920\t    22\t    \"run.started\",\n921\t    23\t    \"run.stopped\",\n922\t    24\t    \"run.completed\",\n923\t    25\t    \"intent.classified\",\n924\t    26\t    \"model.decision\",\n925\t    27\t    \"tool.denied\",\n926\t    28\t    \"tool.approval_requested\",\n927\t    29\t    \"tool.executed\",\n928\t    30\t    \"tool.failed\",\n929\t    31\t    \"payment.refund\",\n930\t    32\t    \"peer.call\",\n931\t    33\t    \"reminder.sent\",\n932\t    34\t  ]),\n933\t    35\t  subject: z.object({ kind: z.enum([\"patient\", \"staff\", \"system\"]), id: z.string() }),\n934\t    36\t  tool: z.string().optional(),\n935\t    37\t  toolUseId: z.string().optional(),\n936\t    38\t  policyVersion: z.string().optional(),\n937\t    39\t  approvalId: z.string().optional(),\n938\t    40\t  reason: z.string().optional(),\n939\t    41\t  context: z\n940\t    42\t    .object({\n941\t    43\t      tokens: z.number().int().nonnegative().nullable(),\n942\t    44\t      status: z.enum([\"measured\", \"estimated\", \"unavailable\"]),\n943\t    45\t      method: z.string(),\n944\t    46\t      cachedInputTokens: z.number().int().nonnegative().nullable(),\n945\t    47\t      compacted: z.boolean(),\n946\t    48\t    })\n947\t    49\t    .optional(),\n948\t    50\t  detail: z.record(z.unknown()).optional(),\n949\t    51\t});\n950\t    52\texport type AuditEvent = z.infer<typeof AuditEvent>;\n951\t    53\t\n952\t    54\tconst firehose = new FirehoseClient({ region: env.region });\n953\t    55\t\n954\t    56\texport class AuditUnavailable extends Error {}\n955\t    57\t\n956\t    58\texport const audit = {\n957\t    59\t  async record(e: Omit<AuditEvent, \"eventId\" | \"ts\">): Promise<void> {\n958\t    60\t    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });\n959\t    61\t    try {\n960\t    62\t      await firehose.send(\n961\t    63\t        new PutRecordCommand({\n962\t    64\t          DeliveryStreamName: env.auditStream,\n963\t    65\t          Record: { Data: Buffer.from(JSON.stringify(full) + \"\\n\") },\n964\t    66\t        }),\n965\t    67\t      );\n966\t    68\t    } catch (err) {\n967\t    69\t      // Callers treat this as a hard failure: an action that cannot be audited does not run.\n968\t    70\t      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);\n969\t    71\t    }\n970\t    72\t  },\n971\t    73\t};\n972\t    74\t\n973\t    75\t// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.\n974\t    76\tconst DROP_KEYS = new Set([\"ssn\", \"dateOfBirth\", \"dob\", \"memberId\", \"subscriberId\", \"cardNumber\", \"cardLast4\", \"address\"]);\n975\t    77\tconst PATTERNS: Array<[RegExp, string]> = [\n976\t    78\t  [/\\b\\d{3}-\\d{2}-\\d{4}\\b/g, \"[ssn]\"],\n977\t    79\t  [/\\b(?:\\d[ -]?){13,19}\\b/g, \"[card]\"],\n978\t    80\t  [/\\b[A-Z]{3}\\d{9}\\b/g, \"[member-id]\"],\n979\t    81\t];\n980\t    82\t\n981\t    83\texport function redactPhi(value: unknown): unknown {\n982\t    84\t  if (typeof value === \"string\") {\n983\t    85\t    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);\n984\t    86\t  }\n985\t    87\t  if (Array.isArray(value)) return value.map(redactPhi);\n986\t    88\t  if (value && typeof value === \"object\") {\n987\t    89\t    const out: Record<string, unknown> = {};\n988\t    90\t    for (const [k, v] of Object.entries(value)) {\n989\t    91\t      if (DROP_KEYS.has(k)) continue;\n990\t    92\t      out[k] = redactPhi(v);\n991\t    93\t    }\n992\t    94\t    return out;\n993\t    95\t  }\n994\t    96\t  return value;\n995\t    97\t}\n996\t=== src/agent/classifier.ts\n997\t     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n998\t     2\timport { createHash } from \"node:crypto\";\n999\t     3\timport { readFileSync } from \"node:fs\";\n1000\t     4\timport { join } from \"node:path\";\n1001\t     5\timport { z } from \"zod\";\n1002\t     6\timport { CLASSIFIER_MODEL, ROOT } from \"../config.js\";\n1003\t     7\t\n1004\t     8\t// Helper model that routes messages before the agent sees them. Urgent and complaint messages go\n1005\t     9\t// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\n1006\t    10\t// malformed output, unknown label, or a served model other than the pinned snapshot) routes the\n1007\t    11\t// message to staff. A failed classifier never defaults to \"send it to the agent\".\n1008\t    12\t\n1009\t    13\texport const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");\n1010\t    14\texport const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\n1011\t    15\t\n1012\t    16\texport const CLASSIFIER_ID = `sha256:${createHash(\"sha256\")\n1013\t    17\t  .update(CLASSIFIER_MODEL)\n1014\t    18\t  .update(\"\\0\")\n1015\t    19\t  .update(CLASSIFIER_PROMPT)\n1016\t    20\t  .update(\"\\0\")\n1017\t    21\t  .update(JSON.stringify(CLASSIFIER_CONFIG))\n1018\t    22\t  .digest(\"hex\")}`;\n1019\t    23\t\n1020\t    24\tconst Intent = z.enum([\"book\", \"reschedule\", \"cancel\", \"confirm\", \"coverage\", \"info\", \"urgent\", \"complaint\", \"other\"]);\n1021\t    25\tconst Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();\n1022\t    26\t\n1023\t    27\texport type Route = \"agent\" | \"staff\";\n1024\t    28\t\n1025\t    29\texport interface ClassifierDecision {\n1026\t    30\t  classifierId: string;\n1027\t    31\t  requestedModel: string;\n1028\t    32\t  servedModel: string | null;\n1029\t    33\t  intent: z.infer<typeof Intent> | null;\n1030\t    34\t  confidence: number | null;\n1031\t    35\t  route: Route;\n1032\t    36\t  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n1033\t    37\t}\n1034\t    38\t\n1035\t    39\tconst MIN_CONFIDENCE = 0.6;\n1036\t    40\t\n1037\t    41\texport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n1038\t    42\t  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n1039\t    43\t  let res: Anthropic.Message;\n1040\t    44\t  try {\n1041\t    45\t    res = await client.messages.create(\n1042\t    46\t      {\n1043\t    47\t        model: CLASSIFIER_MODEL,\n1044\t    48\t        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n1045\t    49\t        temperature: CLASSIFIER_CONFIG.temperature,\n1046\t    50\t        system: CLASSIFIER_PROMPT,\n1047\t    51\t        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n1048\t    52\t      },\n1049\t    53\t      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n1050\t    54\t    );\n1051\t    55\t  } catch (err) {\n1052\t    56\t    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n1053\t    57\t    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n1054\t    58\t  }\n1055\t    59\t\n1056\t    60\t  if (res.model !== CLASSIFIER_MODEL) {\n1057\t    61\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n1058\t    62\t  }\n1059\t    63\t\n1060\t    64\t  const textOut = res.content.find((b) => b.type === \"text\");\n1061\t    65\t  let parsed: z.infer<typeof Output>;\n1062\t    66\t  try {\n1063\t    67\t    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n1064\t    68\t  } catch {\n1065\t    69\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n1066\t    70\t  }\n1067\t    71\t\n1068\t    72\t  if (parsed.confidence < MIN_CONFIDENCE) {\n1069\t    73\t    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n1070\t    74\t  }\n1071\t    75\t  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n1072\t    76\t  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n1073\t    77\t}\n1074\t=== src/agent/context-size.ts\n1075\t     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n1076\t     2\t\n1077\t     3\t// Context size at decision time, in tokens.\n1078\t     4\t//\n1079\t     5\t// Counting method. Each model decision is one Messages API call. Its response usage reports the\n1080\t     6\t// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and\n1081\t     7\t// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,\n1082\t     8\t// including the part served from the prompt cache and the provider's own tool-use preamble, which\n1083\t     9\t// the provider counts but does not show. This is a per-call value, not a run or billing total.\n1084\t    10\t// We record it as \"measured\", with the cached share kept separately.\n1085\t    11\t//\n1086\t    12\t// If the response carries no usage (stream cut off, aborted call), we fall back to the\n1087\t    13\t// count_tokens estimate taken just before the call for the same request, and mark it \"estimated\".\n1088\t    14\t// If neither exists the value is null with status \"unavailable\". It is never reported as 0.\n1089\t    15\t//\n1090\t    16\t// This harness never compacts, summarizes, or truncates history inside a run, so compacted is\n1091\t    17\t// always false; a run that would outgrow its token budget stops instead (see budget.ts).\n1092\t    18\texport interface ContextSize {\n1093\t    19\t  tokens: number | null;\n1094\t    20\t  status: \"measured\" | \"estimated\" | \"unavailable\";\n1095\t    21\t  method: string;\n1096\t    22\t  cachedInputTokens: number | null;\n1097\t    23\t  compacted: boolean;\n1098\t    24\t}\n1099\t    25\t\n1100\t    26\texport const USAGE_METHOD = \"anthropic.messages.usage(input+cache_read+cache_creation)\";\n1101\t    27\texport const COUNT_METHOD = \"anthropic.messages.count_tokens(pre-call estimate)\";\n1102\t    28\t\n1103\t    29\texport async function measureBeforeCall(\n1104\t    30\t  client: Anthropic,\n1105\t    31\t  req: Anthropic.MessageCountTokensParams,\n1106\t    32\t  signal: AbortSignal,\n1107\t    33\t): Promise<ContextSize> {\n1108\t    34\t  try {\n1109\t    35\t    const r = await client.messages.countTokens(req, { signal });\n1110\t    36\t    return { tokens: r.input_tokens, status: \"estimated\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n1111\t    37\t  } catch {\n1112\t    38\t    return { tokens: null, status: \"unavailable\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n1113\t    39\t  }\n1114\t    40\t}\n1115\t    41\t\n1116\t    42\texport function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {\n1117\t    43\t  if (!usage) return pre;\n1118\t    44\t  const cacheRead = usage.cache_read_input_tokens ?? 0;\n1119\t    45\t  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);\n1120\t    46\t  return { tokens: total, status: \"measured\", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };\n1121\t    47\t}\n1122\t    48\t\n1123\t    49\t// Span attributes so the value is searchable next to the action in traces as well as audit.\n1124\t    50\texport function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {\n1125\t    51\t  return {\n1126\t    52\t    ...(c.tokens === null ? {} : { \"clinic_agent.context.tokens\": c.tokens }),\n1127\t    53\t    \"clinic_agent.context.status\": c.status,\n1128\t    54\t    \"clinic_agent.context.method\": c.method,\n1129\t    55\t    \"gen_ai.conversation.compacted\": c.compacted,\n1130\t    56\t  };\n1131\t    57\t}\n1132\t"}]},"parent_tool_use_id":null,"session_id":"926ab8a7-f29e-44d0-9f30-8a17705f627e","uuid":"b8a8d85a-7362-4de0-b5df-a2920c27831c","timestamp":"2026-10-20T13:45:57.888Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-8j7evpsh/926ab8a7-f29e-44d0-9f30-8a17705f627e/tool-results/bt1qwcngl.txt","content":"=== src/agent/loop.ts\n     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\n=== src/config.ts\n     1\timport { readFileSync } from \"node:fs\";\n     2\timport { join } from \"node:path\";\n     3\timport { parse } from \"yaml\";\n     4\t\n     5\texport const ROOT = process.env.CLINIC_AGENT_ROOT ?? process.cwd();\n     6\t\n     7\texport interface Policy {\n     8\t  version: string;\n     9\t  highImpactTools: string[];\n    10\t  approval: { ttlSeconds: number; approverRoles: string[]; table: string };\n    11\t}\n    12\t\n    13\texport interface AllowlistEntry {\n    14\t  tool: string;\n    15\t  reason: string;\n    16\t}\n    17\t\n    18\texport interface Budgets {\n    19\t  run: {\n    20\t    maxTurns: number;\n    21\t    maxWallMs: number;\n    22\t    maxInputTokens: number;\n    23\t    maxOutputTokens: number;\n    24\t    maxCostUsd: number;\n    25\t    maxToolCalls: number;\n    26\t    maxToolCallsPerMinute: number;\n    27\t    maxPeerCalls: number;\n    28\t  };\n    29\t  quotas: {\n    30\t    perSubjectDailyUsd: number;\n    31\t    perTenantDailyUsd: number;\n    32\t    fleetDailyUsd: number;\n    33\t    perTenantToolCallsPerMinute: number;\n    34\t    fleetToolCallsPerMinute: number;\n    35\t  };\n    36\t  pricingUsdPerMTok: Record<string, { input: number; output: number; cacheRead: number; cacheWrite: number }>;\n    37\t  onExceed: \"handoff_to_staff\";\n    38\t}\n    39\t\n    40\tfunction loadYaml<T>(rel: string): T {\n    41\t  return parse(readFileSync(join(ROOT, rel), \"utf8\")) as T;\n    42\t}\n    43\t\n    44\texport const policy = loadYaml<Policy>(\"config/policy.yaml\");\n    45\texport const allowlist = loadYaml<{ role: string; tools: AllowlistEntry[] }>(\"config/tools.allowlist.yaml\");\n    46\texport const budgets = loadYaml<Budgets>(\"config/budgets.yaml\");\n    47\texport const manifest = JSON.parse(readFileSync(join(ROOT, \"release/manifest.json\"), \"utf8\"));\n    48\t\n    49\texport const AGENT_MODEL = \"claude-sonnet-4-5-20250929\";\n    50\texport const CLASSIFIER_MODEL = \"claude-haiku-4-5-20251001\";\n    51\t\n    52\texport const env = {\n    53\t  region: process.env.AWS_REGION ?? \"us-west-2\",\n    54\t  controlTable: process.env.CONTROL_TABLE ?? \"clinic-agent-control\",\n    55\t  budgetTable: process.env.BUDGET_TABLE ?? \"clinic-agent-budgets\",\n    56\t  auditStream: process.env.AUDIT_STREAM ?? \"clinic-agent-audit\",\n    57\t  smsSigningSecretArn: process.env.SMS_SIGNING_SECRET_ARN ?? \"\",\n    58\t  chatJwksUrl: process.env.CHAT_JWKS_URL ?? \"https://auth.northbay-clinics.example/.well-known/jwks.json\",\n    59\t  chatIssuer: process.env.CHAT_ISSUER ?? \"https://auth.northbay-clinics.example/\",\n    60\t  eligibilityUrl: process.env.ELIGIBILITY_URL ?? \"https://eligibility.partners.northbay-clinics.example/a2a\",\n    61\t  eligibilityIssuer: process.env.ELIGIBILITY_ISSUER ?? \"https://eligibility.partners.northbay-clinics.example\",\n    62\t  tokenExchangeUrl: process.env.TOKEN_EXCHANGE_URL ?? \"https://sts.northbay-clinics.example/oauth2/token\",\n    63\t  accountableParty: \"northbay-clinic-group:patient-access\",\n    64\t  operationalOwner: \"team:agent-platform\",\n    65\t};\n=== src/server.ts\n     1\timport Fastify from \"fastify\";\n     2\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     3\timport { env, manifest } from \"./config.js\";\n     4\timport { computeAgentTypeId, setAgentTypeId, AGENT_INSTANCE_ID } from \"./agent/identity.js\";\n     5\timport { killSwitch } from \"./control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"./integrations/ehr-mcp.js\";\n     7\timport { registerSmsWebhook } from \"./routes/sms-webhook.js\";\n     8\timport { registerWebchat } from \"./routes/webchat.js\";\n     9\timport { nativeTools } from \"./tools/executor.js\";\n    10\timport { ToolRegistry, type ConfiguredServer } from \"./tools/registry.js\";\n    11\t\n    12\tconst metrics = {\n    13\t  increment(name: string) {\n    14\t    process.stdout.write(JSON.stringify({ _aws: { CloudWatchMetrics: [{ Namespace: \"clinic-agent\", Metrics: [{ Name: name }] }] }, [name]: 1 }) + \"\\n\");\n    15\t  },\n    16\t};\n    17\t\n    18\tconst app = Fastify({\n    19\t  logger: {\n    20\t    level: process.env.LOG_LEVEL ?? \"info\",\n    21\t    redact: { paths: [\"req.headers.authorization\", 'req.headers[\"x-sms-signature\"]', \"req.headers.cookie\"], censor: \"[redacted]\" },\n    22\t  },\n    23\t  bodyLimit: 16_384,\n    24\t});\n    25\t\n    26\t// Identity check against the approved release manifest.\n    27\tconst typeId = computeAgentTypeId({\n    28\t  imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    29\t  harnessVersion: manifest.harness.version,\n    30\t  harnessGitSha: process.env.GIT_SHA ?? \"\",\n    31\t});\n    32\tif (typeId !== manifest.agentTypeId) {\n    33\t  app.log.error({ expected: manifest.agentTypeId, actual: typeId }, \"agent type id does not match release manifest\");\n    34\t  metrics.increment(\"identity.mismatch\");\n    35\t}\n    36\tsetAgentTypeId(typeId);\n    37\tapp.log.info({ agentTypeId: typeId, agentInstanceId: AGENT_INSTANCE_ID, release: manifest.release }, \"starting\");\n    38\t\n    39\t// Tools.\n    40\tconst servers: ConfiguredServer[] = manifest.tools.mcpServers;\n    41\tconst ehrServer = servers.find((s) => s.id === \"ehr\");\n    42\tif (!ehrServer) throw new Error(\"release manifest has no ehr server\");\n    43\tconst ehr = ehrClient(ehrServer);\n    44\t\n    45\tconst registry = new ToolRegistry(servers);\n    46\tfor (const [serverId, tools] of Object.entries(nativeTools(ehr))) registry.registerNative(serverId, tools);\n    47\ttry {\n    48\t  const { reportedName, meta } = await ehr.catalog();\n    49\t  registry.registerMcp(\"ehr\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\n    50\t} catch (err) {\n    51\t  app.log.error({ err }, \"EHR MCP catalog unavailable; EHR tools disabled\");\n    52\t}\n    53\tfor (const r of registry.rejected) app.log.warn(r, \"tool rejected at load\");\n    54\tfor (const c of registry.conflicts) app.log.warn(c, \"tool name conflict\");\n    55\t\n    56\t// Clinics.\n    57\tconst directory: Array<{ id: string; name: string; smsNumber: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    58\tconst byId = new Map(directory.map((c) => [c.id, c]));\n    59\tconst byNumber = new Map(directory.map((c) => [c.smsNumber, c]));\n    60\t\n    61\tconst sm = new SecretsManagerClient({ region: env.region });\n    62\tlet signingSecret: { value: string; at: number } | undefined;\n    63\tasync function smsSigningSecret(): Promise<string> {\n    64\t  if (signingSecret && Date.now() - signingSecret.at < 5 * 60_000) return signingSecret.value;\n    65\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: env.smsSigningSecretArn }));\n    66\t  signingSecret = { value: s.SecretString ?? \"\", at: Date.now() };\n    67\t  return signingSecret.value;\n    68\t}\n    69\t\n    70\tapp.addContentTypeParser(\"application/json\", { parseAs: \"string\" }, (req, body, done) => {\n    71\t  (req as { rawBody?: string }).rawBody = body as string;\n    72\t  try {\n    73\t    done(null, JSON.parse(body as string));\n    74\t  } catch (err) {\n    75\t    done(err as Error, undefined);\n    76\t  }\n    77\t});\n    78\t\n    79\tregisterSmsWebhook(app, {\n    80\t  registry,\n    81\t  signingSecret: smsSigningSecret,\n    82\t  clinicByNumber: (to) => byNumber.get(to),\n    83\t  metrics,\n    84\t});\n    85\tregisterWebchat(app, { registry, clinicById: (id) => byId.get(id) });\n    86\t\n    87\tapp.get(\"/healthz\", async () => ({ ok: true }));\n    88\t\n    89\tkillSwitch.startWatcher();\n    90\tawait app.listen({ host: \"0.0.0.0\", port: 8080 });\n=== src/routes/sms-webhook.ts\n     1\timport type { FastifyInstance, FastifyRequest } from \"fastify\";\n     2\timport { createHmac, timingSafeEqual } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { runAgent } from \"../agent/loop.js\";\n     5\timport { newRunContext } from \"../agent/identity.js\";\n     6\timport { sms } from \"../integrations/sms.js\";\n     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n     8\t\n     9\t// Inbound SMS from the provider. The provider signs \"<timestamp>.<raw body>\" with HMAC-SHA256\n    10\t// using the per-account signing secret and sends it as x-sms-signature: t=<ts>,v1=<hex>.\n    11\t\n    12\tconst Inbound = z\n    13\t  .object({\n    14\t    messageId: z.string().max(64),\n    15\t    from: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n    16\t    to: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n    17\t    body: z.string().max(1600),\n    18\t    receivedAt: z.string().datetime(),\n    19\t  })\n    20\t  .strict();\n    21\t\n    22\tconst MAX_SKEW_S = 300;\n    23\t\n    24\texport class SignatureError extends Error {}\n    25\t\n    26\texport function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {\n    27\t  if (!header) throw new SignatureError(\"missing signature\");\n    28\t  const parts = Object.fromEntries(header.split(\",\").map((p) => p.split(\"=\", 2) as [string, string]));\n    29\t  const ts = Number(parts.t);\n    30\t  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError(\"stale or missing timestamp\");\n    31\t  const expected = createHmac(\"sha256\", secret).update(`${parts.t}.${rawBody}`).digest();\n    32\t  const got = Buffer.from(parts.v1 ?? \"\", \"hex\");\n    33\t  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError(\"bad signature\");\n    34\t}\n    35\t\n    36\texport function registerSmsWebhook(\n    37\t  app: FastifyInstance,\n    38\t  deps: {\n    39\t    registry: ToolRegistry;\n    40\t    signingSecret: () => Promise<string>;\n    41\t    clinicByNumber: (to: string) => { id: string; name: string } | undefined;\n    42\t    metrics: { increment(name: string): void };\n    43\t  },\n    44\t): void {\n    45\t  app.post(\n    46\t    \"/v1/sms/inbound\",\n    47\t    { config: { rawBody: true }, bodyLimit: 8192 },\n    48\t    async (req: FastifyRequest & { rawBody?: string }, reply) => {\n    49\t      try {\n    50\t        verifySignature(req.rawBody ?? \"\", req.headers[\"x-sms-signature\"] as string | undefined, await deps.signingSecret());\n    51\t      } catch (err) {\n    52\t        req.log.warn({ err: (err as Error).message }, \"sms webhook signature check failed\");\n    53\t        deps.metrics.increment(\"sms.signature_failed\");\n    54\t      }\n    55\t\n    56\t      const parsed = Inbound.safeParse(req.body);\n    57\t      if (!parsed.success) return reply.code(400).send({ error: \"invalid payload\" });\n    58\t      const msg = parsed.data;\n    59\t\n    60\t      const clinic = deps.clinicByNumber(msg.to);\n    61\t      if (!clinic) return reply.code(404).send({ error: \"unknown number\" });\n    62\t\n    63\t      const ctx = newRunContext({\n    64\t        tenantId: clinic.id,\n    65\t        subject: { kind: \"patient\", id: `phone:${msg.from}` },\n    66\t        channel: \"sms\",\n    67\t        log: req.log,\n    68\t      });\n    69\t\n    70\t      // Respond to the provider right away; the reply goes out as a new outbound message.\n    71\t      void reply.code(202).send({ accepted: true });\n    72\t      const out = await runAgent(deps.registry, ctx, clinic, msg.body);\n    73\t      await sms.send(clinic.id, msg.from, out.text);\n    74\t    },\n    75\t  );\n    76\t}\n=== src/routes/webchat.ts\n     1\timport type { FastifyInstance } from \"fastify\";\n     2\timport { createRemoteJWKSet, jwtVerify } from \"jose\";\n     3\timport { z } from \"zod\";\n     4\timport { runAgent } from \"../agent/loop.js\";\n     5\timport { newRunContext } from \"../agent/identity.js\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n     8\t\n     9\t// Web chat. The widget gets a short-lived session JWT from the group auth service after the\n    10\t// patient verifies by one-time code, or a staff JWT for front-desk users.\n    11\t// Claims: sub, clinic_id, role (\"patient\" | \"staff\"), exp.\n    12\t\n    13\tconst jwks = createRemoteJWKSet(new URL(env.chatJwksUrl));\n    14\t\n    15\tconst ChatBody = z.object({ message: z.string().min(1).max(2000) }).strict();\n    16\tconst TRACEPARENT = /^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/;\n    17\t\n    18\texport function registerWebchat(\n    19\t  app: FastifyInstance,\n    20\t  deps: { registry: ToolRegistry; clinicById: (id: string) => { id: string; name: string } | undefined },\n    21\t): void {\n    22\t  app.post(\"/v1/chat\", { bodyLimit: 16_384 }, async (req, reply) => {\n    23\t    const auth = req.headers.authorization ?? \"\";\n    24\t    if (!auth.startsWith(\"Bearer \")) return reply.code(401).send({ error: \"missing token\" });\n    25\t\n    26\t    let claims: { sub: string; clinic_id: string; role: \"patient\" | \"staff\" };\n    27\t    try {\n    28\t      const { payload } = await jwtVerify(auth.slice(7), jwks, {\n    29\t        issuer: env.chatIssuer,\n    30\t        audience: \"clinic-agent-chat\",\n    31\t        algorithms: [\"ES256\"],\n    32\t        maxTokenAge: \"30m\",\n    33\t      });\n    34\t      claims = payload as unknown as typeof claims;\n    35\t    } catch {\n    36\t      return reply.code(401).send({ error: \"invalid token\" });\n    37\t    }\n    38\t\n    39\t    const body = ChatBody.safeParse(req.body);\n    40\t    if (!body.success) return reply.code(400).send({ error: \"invalid body\" });\n    41\t\n    42\t    // The group site embeds one widget for all clinics and sends the clinic the patient picked.\n    43\t    const tenantId = (req.headers[\"x-clinic-id\"] as string | undefined) ?? claims.clinic_id;\n    44\t    const clinic = deps.clinicById(tenantId);\n    45\t    if (!clinic) return reply.code(404).send({ error: \"unknown clinic\" });\n    46\t\n    47\t    const tp = req.headers.traceparent;\n    48\t    const ctx = newRunContext({\n    49\t      tenantId: clinic.id,\n    50\t      subject: { kind: claims.role === \"staff\" ? \"staff\" : \"patient\", id: claims.sub },\n    51\t      channel: \"webchat\",\n    52\t      traceparent: typeof tp === \"string\" && TRACEPARENT.test(tp) ? tp : undefined,\n    53\t      log: req.log,\n    54\t    });\n    55\t\n    56\t    const out = await runAgent(deps.registry, ctx, clinic, body.data.message);\n    57\t    return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });\n    58\t  });\n    59\t}\n=== src/integrations/ehr-mcp.ts\n     1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n     2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n     3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     4\timport { Agent } from \"undici\";\n     5\timport type { PeerCertificate } from \"node:tls\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n     8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n     9\t\n    10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n    11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n    12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n    13\t\n    14\tconst sm = new SecretsManagerClient({ region: env.region });\n    15\t\n    16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n    17\t  const expected = server.tlsCertSha256.toLowerCase();\n    18\t  return new Agent({\n    19\t    connect: {\n    20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n    21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n    22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n    23\t      },\n    24\t    },\n    25\t  });\n    26\t}\n    27\t\n    28\ttype Token = { value: string; exp: number };\n    29\tconst tokens = new Map<string, Token>();\n    30\t\n    31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n    32\t  const cacheKey = `${clinicId}|${scope}`;\n    33\t  const hit = tokens.get(cacheKey);\n    34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n    35\t\n    36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n    37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n    38\t  const res = await fetch(token_url, {\n    39\t    method: \"POST\",\n    40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n    42\t  });\n    43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n    44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n    45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n    46\t  return body.access_token;\n    47\t}\n    48\t\n    49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n    50\tconst sessions = new Map<string, Client>();\n    51\t\n    52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n    53\t  const existing = sessions.get(clinicId);\n    54\t  if (existing) return existing;\n    55\t  const token = await ehrToken(clinicId, SCOPES);\n    56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    57\t    requestInit: {\n    58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n    59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n    60\t      dispatcher: pinnedDispatcher(server),\n    61\t    },\n    62\t  });\n    63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n    64\t  await client.connect(transport);\n    65\t  sessions.set(clinicId, client);\n    66\t  setTimeout(() => {\n    67\t    sessions.delete(clinicId);\n    68\t    void client.close();\n    69\t  }, 4 * 60_000).unref();\n    70\t  return client;\n    71\t}\n    72\t\n    73\texport function ehr(server: ConfiguredServer) {\n    74\t  return {\n    75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n    76\t      const c = await session(server, \"_catalog\");\n    77\t      const [tools, prompts, templates] = await Promise.all([\n    78\t        c.listTools(),\n    79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n    80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n    81\t      ]);\n    82\t      return {\n    83\t        reportedName: c.getServerVersion()?.name,\n    84\t        meta: {\n    85\t          instructions: c.getInstructions(),\n    86\t          tools: tools.tools as ServerMeta[\"tools\"],\n    87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n    88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n    89\t        },\n    90\t      };\n    91\t    },\n    92\t\n    93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n    94\t      const c = await session(server, opts.clinicId);\n    95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n    96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n    97\t      return res.structuredContent ?? res.content;\n    98\t    },\n    99\t\n   100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n   101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n   102\t        id: string;\n   103\t        patientId: string;\n   104\t        start: string;\n   105\t        serviceCode: string;\n   106\t        payerId?: string;\n   107\t        depositId?: string;\n   108\t        status: string;\n   109\t      };\n   110\t    },\n   111\t\n   112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n   113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n   114\t        id: string;\n   115\t        patientId: string;\n   116\t        start: string;\n   117\t        phone: string;\n   118\t        smsOptIn: boolean;\n   119\t        locationName: string;\n   120\t      }>;\n   121\t    },\n   122\t  };\n   123\t}\n   124\texport type Ehr = ReturnType<typeof ehr>;\n=== src/integrations/eligibility-a2a.ts\n     1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n     7\t//\n     8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n     9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n    10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n    11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n    12\t//\n    13\t// Answers come back as a signed attestation (JWS) inside a data part.\n    14\t\n    15\tconst Eligibility = z\n    16\t  .object({\n    17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    18\t    planName: z.string().max(120).optional(),\n    19\t    copayCents: z.number().int().nonnegative().optional(),\n    20\t    depositWaived: z.boolean().default(false),\n    21\t    checkedAt: z.string().datetime(),\n    22\t  })\n    23\t  .strict();\n    24\texport type Eligibility = z.infer<typeof Eligibility>;\n    25\t\n    26\tconst Rpc = z.object({\n    27\t  jsonrpc: z.literal(\"2.0\"),\n    28\t  id: z.string(),\n    29\t  result: z.object({\n    30\t    kind: z.literal(\"message\"),\n    31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n    32\t  }),\n    33\t});\n    34\t\n    35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n    36\t  const res = await fetch(env.tokenExchangeUrl, {\n    37\t    method: \"POST\",\n    38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    39\t    body: new URLSearchParams({\n    40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    41\t      subject_token: workloadToken,\n    42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n    43\t      audience: \"eligibility-agent\",\n    44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n    45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    46\t    }),\n    47\t  });\n    48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n    49\t  return ((await res.json()) as { access_token: string }).access_token;\n    50\t}\n    51\t\n    52\texport async function checkEligibility(\n    53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n    54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n    55\t): Promise<Eligibility> {\n    56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n    57\t  const requestId = randomUUID();\n    58\t  const res = await fetch(env.eligibilityUrl, {\n    59\t    method: \"POST\",\n    60\t    signal: opts.signal,\n    61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    62\t    body: JSON.stringify({\n    63\t      jsonrpc: \"2.0\",\n    64\t      id: requestId,\n    65\t      method: \"message/send\",\n    66\t      params: {\n    67\t        message: {\n    68\t          role: \"user\",\n    69\t          messageId: requestId,\n    70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n    71\t        },\n    72\t      },\n    73\t    }),\n    74\t  });\n    75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n    76\t  const text = await res.text();\n    77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n    78\t  const rpc = Rpc.parse(JSON.parse(text));\n    79\t\n    80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n    81\t  const header = decodeProtectedHeader(attestation);\n    82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n    83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n    84\t  const { payload } = await jwtVerify(attestation, keys, {\n    85\t    issuer: env.eligibilityIssuer,\n    86\t    audience: \"clinic-agent\",\n    87\t    maxTokenAge: \"5m\",\n    88\t    algorithms: [\"ES256\"],\n    89\t  });\n    90\t  return Eligibility.parse(payload.eligibility);\n    91\t}\n=== src/integrations/payments.ts\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n     5\t// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n     6\t// The provider enforces Idempotency-Key for 24 hours.\n     7\t\n     8\tconst sm = new SecretsManagerClient({ region: env.region });\n     9\tconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n    10\t\n    11\tasync function key(clinicId: string): Promise<string> {\n    12\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n    13\t  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n    14\t}\n    15\t\n    16\texport interface Refund {\n    17\t  id: string;\n    18\t  depositId: string;\n    19\t  amountCents: number;\n    20\t  status: \"pending\" | \"succeeded\" | \"failed\";\n    21\t}\n    22\t\n    23\texport const payments = {\n    24\t  async refundDeposit(\n    25\t    clinicId: string,\n    26\t    req: { depositId: string; reason: string; idempotencyKey: string },\n    27\t    signal?: AbortSignal,\n    28\t  ): Promise<Refund> {\n    29\t    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n    30\t      method: \"POST\",\n    31\t      signal,\n    32\t      headers: {\n    33\t        authorization: `Bearer ${await key(clinicId)}`,\n    34\t        \"content-type\": \"application/json\",\n    35\t        \"idempotency-key\": req.idempotencyKey,\n    36\t      },\n    37\t      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    38\t    });\n    39\t    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    40\t    return (await res.json()) as Refund;\n    41\t  },\n    42\t};\n=== src/integrations/sms.ts\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n     5\t// can send; free-form text goes through sms__send_freeform, which needs approval.\n     6\t\n     7\tconst sm = new SecretsManagerClient({ region: env.region });\n     8\tconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n     9\t\n    10\texport const TEMPLATES = {\n    11\t  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n    12\t  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n    13\t  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n    14\t  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n    15\t} as const;\n    16\texport type TemplateId = keyof typeof TEMPLATES;\n    17\t\n    18\texport function render(id: TemplateId, vars: Record<string, string>): string {\n    19\t  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n    20\t}\n    21\t\n    22\tasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n    23\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n    24\t  const v = JSON.parse(s.SecretString ?? \"{}\");\n    25\t  return { token: v.api_token, from: v.from_number };\n    26\t}\n    27\t\n    28\texport const sms = {\n    29\t  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n    30\t    const c = await creds(clinicId);\n    31\t    const res = await fetch(`${BASE}/messages`, {\n    32\t      method: \"POST\",\n    33\t      signal,\n    34\t      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n    35\t      body: JSON.stringify({ from: c.from, to, body }),\n    36\t    });\n    37\t    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n    38\t    return (await res.json()) as { messageId: string };\n    39\t  },\n    40\t};\n=== src/tools/executor.ts\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { allowlist, policy } from \"../config.js\";\n     3\timport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\n     4\timport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\n     5\timport type { ContextSize } from \"../agent/context-size.js\";\n     6\timport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\n     7\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     8\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     9\timport { payments } from \"../integrations/payments.js\";\n    10\timport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\n    11\timport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\n    12\timport { checkApproval, requestApproval } from \"./approvals.js\";\n    13\timport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n    14\t\n    15\texport interface Decision {\n    16\t  contextSize: ContextSize;\n    17\t  budget: RunBudget;\n    18\t}\n    19\t\n    20\tconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n    21\t// Arguments the harness consumes itself; they are never forwarded to a tool.\n    22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n    23\t\n    24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n    25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n    26\t}\n    27\t\n    28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n    29\t  return `${tool}(${Object.entries(args)\n    30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    31\t    .join(\", \")})`.slice(0, 500);\n    32\t}\n    33\t\n    34\texport async function executeTool(\n    35\t  registry: ToolRegistry,\n    36\t  ctx: RunContext,\n    37\t  call: Anthropic.ToolUseBlock,\n    38\t  d: Decision,\n    39\t): Promise<Anthropic.ToolResultBlockParam> {\n    40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n    41\t  const base = {\n    42\t    ...ctx.identity(),\n    43\t    runId: ctx.runId,\n    44\t    subject: ctx.subject,\n    45\t    tool: call.name,\n    46\t    toolUseId: call.id,\n    47\t    policyVersion: policy.version,\n    48\t    context: d.contextSize,\n    49\t  };\n    50\t  const deny = async (reason: string) => {\n    51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n    52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n    53\t  };\n    54\t\n    55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n    56\t  const tool = registry.get(call.name);\n    57\t  if (!tool) return deny(\"not_registered\");\n    58\t\n    59\t  await killSwitch.assertRunning(ctx.tenantId);\n    60\t  await d.budget.toolCall(call.name);\n    61\t\n    62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n    63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n    64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n    65\t\n    66\t  let approvalId: string | undefined;\n    67\t  if (policy.highImpactTools.includes(call.name)) {\n    68\t    if (typeof input.approvalId !== \"string\") {\n    69\t      const rec = await requestApproval({\n    70\t        tool: call.name,\n    71\t        tenantId: clinicId,\n    72\t        agentInstanceId: AGENT_INSTANCE_ID,\n    73\t        runId: ctx.runId,\n    74\t        args,\n    75\t        summary: summarize(call.name, args),\n    76\t      });\n    77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n    78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    79\t    }\n    80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    81\t    if (!check.ok) return deny(check.reason);\n    82\t    approvalId = check.approval.id;\n    83\t  }\n    84\t\n    85\t  try {\n    86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    88\t    const safe = redactPhi(raw);\n    89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    90\t    return toolResult(call.id, safe);\n    91\t  } catch (err) {\n    92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n    95\t  }\n    96\t}\n    97\t\n    98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n    99\t\n   100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n   101\t  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n   102\t    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n   103\t\n   104\t  return {\n   105\t    payments: [\n   106\t      {\n   107\t        name: \"refund_deposit\",\n   108\t        definition: {\n   109\t          name: \"payments__refund_deposit\",\n   110\t          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n   111\t          input_schema: {\n   112\t            type: \"object\",\n   113\t            properties: {\n   114\t              depositId: { type: \"string\" },\n   115\t              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n   116\t              approvalId: { type: \"string\" },\n   117\t            },\n   118\t            required: [\"depositId\", \"reason\"],\n   119\t          },\n   120\t        },\n   121\t        invoke: async (a, o) =>\n   122\t          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n   123\t      },\n   124\t    ],\n   125\t    sms: [\n   126\t      {\n   127\t        name: \"send_to_patient\",\n   128\t        definition: {\n   129\t          name: \"sms__send_to_patient\",\n   130\t          description: \"Send a templated SMS to the phone number on the patient's record.\",\n   131\t          input_schema: {\n   132\t            type: \"object\",\n   133\t            properties: {\n   134\t              patientId: { type: \"string\" },\n   135\t              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n   136\t              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n   137\t            },\n   138\t            required: [\"patientId\", \"template\"],\n   139\t          },\n   140\t        },\n   141\t        invoke: async (a, o) => {\n   142\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   143\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   144\t          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n   145\t          return sms.send(o.clinicId, c.phone, body, o.signal);\n   146\t        },\n   147\t      },\n   148\t      {\n   149\t        name: \"send_freeform\",\n   150\t        definition: {\n   151\t          name: \"sms__send_freeform\",\n   152\t          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n   153\t          input_schema: {\n   154\t            type: \"object\",\n   155\t            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n   156\t            required: [\"patientId\", \"body\"],\n   157\t          },\n   158\t        },\n   159\t        invoke: async (a, o) => {\n   160\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   161\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   162\t          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n   163\t        },\n   164\t      },\n   165\t    ],\n   166\t    insurance: [\n   167\t      {\n   168\t        name: \"check_eligibility\",\n   169\t        definition: {\n   170\t          name: \"insurance__check_eligibility\",\n   171\t          description: \"Check whether the patient's insurance covers an appointment.\",\n   172\t          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n   173\t        },\n   174\t        invoke: async (a, o) =>\n   175\t          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n   176\t            clinicId: o.clinicId,\n   177\t            ctx: o.runCtx as RunContext,\n   178\t            signal: o.signal,\n   179\t            context: o.context,\n   180\t          }),\n   181\t      },\n   182\t    ],\n   183\t  };\n   184\t}\n=== src/audit/recorder.ts\n     1\timport { FirehoseClient, PutRecordCommand } from \"@aws-sdk/client-firehose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Every audit record carries the six identity fields. Values come from RunContext, which is built\n     7\t// by the HTTP layer and the worker, never from model output.\n     8\texport const IdentityFields = z.object({\n     9\t  accountableParty: z.string().min(1),\n    10\t  operationalOwner: z.string().min(1),\n    11\t  tenantId: z.string().min(1),\n    12\t  agentTypeId: z.string().startsWith(\"sha256:\"),\n    13\t  agentInstanceId: z.string().uuid(),\n    14\t  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),\n    15\t});\n    16\t\n    17\texport const AuditEvent = IdentityFields.extend({\n    18\t  eventId: z.string().uuid(),\n    19\t  ts: z.string().datetime(),\n    20\t  runId: z.string().uuid(),\n    21\t  event: z.enum([\n    22\t    \"run.started\",\n    23\t    \"run.stopped\",\n    24\t    \"run.completed\",\n    25\t    \"intent.classified\",\n    26\t    \"model.decision\",\n    27\t    \"tool.denied\",\n    28\t    \"tool.approval_requested\",\n    29\t    \"tool.executed\",\n    30\t    \"tool.failed\",\n    31\t    \"payment.refund\",\n    32\t    \"peer.call\",\n    33\t    \"reminder.sent\",\n    34\t  ]),\n    35\t  subject: z.object({ kind: z.enum([\"patient\", \"staff\", \"system\"]), id: z.string() }),\n    36\t  tool: z.string().optional(),\n    37\t  toolUseId: z.string().optional(),\n    38\t  policyVersion: z.string().optional(),\n    39\t  approvalId: z.string().optional(),\n    40\t  reason: z.string().optional(),\n    41\t  context: z\n    42\t    .object({\n    43\t      tokens: z.number().int().nonnegative().nullable(),\n    44\t      status: z.enum([\"measured\", \"estimated\", \"unavailable\"]),\n    45\t      method: z.string(),\n    46\t      cachedInputTokens: z.number().int().nonnegative().nullable(),\n    47\t      compacted: z.boolean(),\n    48\t    })\n    49\t    .optional(),\n    50\t  detail: z.record(z.unknown()).optional(),\n    51\t});\n    52\texport type AuditEvent = z.infer<typeof AuditEvent>;\n    53\t\n    54\tconst firehose = new FirehoseClient({ region: env.region });\n    55\t\n    56\texport class AuditUnavailable extends Error {}\n    57\t\n    58\texport const audit = {\n    59\t  async record(e: Omit<AuditEvent, \"eventId\" | \"ts\">): Promise<void> {\n    60\t    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });\n    61\t    try {\n    62\t      await firehose.send(\n    63\t        new PutRecordCommand({\n    64\t          DeliveryStreamName: env.auditStream,\n    65\t          Record: { Data: Buffer.from(JSON.stringify(full) + \"\\n\") },\n    66\t        }),\n    67\t      );\n    68\t    } catch (err) {\n    69\t      // Callers treat this as a hard failure: an action that cannot be audited does not run.\n    70\t      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);\n    71\t    }\n    72\t  },\n    73\t};\n    74\t\n    75\t// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.\n    76\tconst DROP_KEYS = new Set([\"ssn\", \"dateOfBirth\", \"dob\", \"memberId\", \"subscriberId\", \"cardNumber\", \"cardLast4\", \"address\"]);\n    77\tconst PATTERNS: Array<[RegExp, string]> = [\n    78\t  [/\\b\\d{3}-\\d{2}-\\d{4}\\b/g, \"[ssn]\"],\n    79\t  [/\\b(?:\\d[ -]?){13,19}\\b/g, \"[card]\"],\n    80\t  [/\\b[A-Z]{3}\\d{9}\\b/g, \"[member-id]\"],\n    81\t];\n    82\t\n    83\texport function redactPhi(value: unknown): unknown {\n    84\t  if (typeof value === \"string\") {\n    85\t    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);\n    86\t  }\n    87\t  if (Array.isArray(value)) return value.map(redactPhi);\n    88\t  if (value && typeof value === \"object\") {\n    89\t    const out: Record<string, unknown> = {};\n    90\t    for (const [k, v] of Object.entries(value)) {\n    91\t      if (DROP_KEYS.has(k)) continue;\n    92\t      out[k] = redactPhi(v);\n    93\t    }\n    94\t    return out;\n    95\t  }\n    96\t  return value;\n    97\t}\n=== src/agent/classifier.ts\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { createHash } from \"node:crypto\";\n     3\timport { readFileSync } from \"node:fs\";\n     4\timport { join } from \"node:path\";\n     5\timport { z } from \"zod\";\n     6\timport { CLASSIFIER_MODEL, ROOT } from \"../config.js\";\n     7\t\n     8\t// Helper model that routes messages before the agent sees them. Urgent and complaint messages go\n     9\t// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\n    10\t// malformed output, unknown label, or a served model other than the pinned snapshot) routes the\n    11\t// message to staff. A failed classifier never defaults to \"send it to the agent\".\n    12\t\n    13\texport const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");\n    14\texport const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\n    15\t\n    16\texport const CLASSIFIER_ID = `sha256:${createHash(\"sha256\")\n    17\t  .update(CLASSIFIER_MODEL)\n    18\t  .update(\"\\0\")\n    19\t  .update(CLASSIFIER_PROMPT)\n    20\t  .update(\"\\0\")\n    21\t  .update(JSON.stringify(CLASSIFIER_CONFIG))\n    22\t  .digest(\"hex\")}`;\n    23\t\n    24\tconst Intent = z.enum([\"book\", \"reschedule\", \"cancel\", \"confirm\", \"coverage\", \"info\", \"urgent\", \"complaint\", \"other\"]);\n    25\tconst Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();\n    26\t\n    27\texport type Route = \"agent\" | \"staff\";\n    28\t\n    29\texport interface ClassifierDecision {\n    30\t  classifierId: string;\n    31\t  requestedModel: string;\n    32\t  servedModel: string | null;\n    33\t  intent: z.infer<typeof Intent> | null;\n    34\t  confidence: number | null;\n    35\t  route: Route;\n    36\t  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n    37\t}\n    38\t\n    39\tconst MIN_CONFIDENCE = 0.6;\n    40\t\n    41\texport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n    42\t  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n    43\t  let res: Anthropic.Message;\n    44\t  try {\n    45\t    res = await client.messages.create(\n    46\t      {\n    47\t        model: CLASSIFIER_MODEL,\n    48\t        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n    49\t        temperature: CLASSIFIER_CONFIG.temperature,\n    50\t        system: CLASSIFIER_PROMPT,\n    51\t        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n    52\t      },\n    53\t      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n    54\t    );\n    55\t  } catch (err) {\n    56\t    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n    57\t    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n    58\t  }\n    59\t\n    60\t  if (res.model !== CLASSIFIER_MODEL) {\n    61\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n    62\t  }\n    63\t\n    64\t  const textOut = res.content.find((b) => b.type === \"text\");\n    65\t  let parsed: z.infer<typeof Output>;\n    66\t  try {\n    67\t    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n    68\t  } catch {\n    69\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n    70\t  }\n    71\t\n    72\t  if (parsed.confidence < MIN_CONFIDENCE) {\n    73\t    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n    74\t  }\n    75\t  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n    76\t  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n    77\t}\n=== src/agent/context-size.ts\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\t\n     3\t// Context size at decision time, in tokens.\n     4\t//\n     5\t// Counting method. Each model decision is one Messages API call. Its response usage reports the\n     6\t// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and\n     7\t// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,\n     8\t// including the part served from the prompt cache and the provider's own tool-use preamble, which\n     9\t// the provider counts but does not show. This is a per-call value, not a run or billing total.\n    10\t// We record it as \"measured\", with the cached share kept separately.\n    11\t//\n    12\t// If the response carries no usage (stream cut off, aborted call), we fall back to the\n    13\t// count_tokens estimate taken just before the call for the same request, and mark it \"estimated\".\n    14\t// If neither exists the value is null with status \"unavailable\". It is never reported as 0.\n    15\t//\n    16\t// This harness never compacts, summarizes, or truncates history inside a run, so compacted is\n    17\t// always false; a run that would outgrow its token budget stops instead (see budget.ts).\n    18\texport interface ContextSize {\n    19\t  tokens: number | null;\n    20\t  status: \"measured\" | \"estimated\" | \"unavailable\";\n    21\t  method: string;\n    22\t  cachedInputTokens: number | null;\n    23\t  compacted: boolean;\n    24\t}\n    25\t\n    26\texport const USAGE_METHOD = \"anthropic.messages.usage(input+cache_read+cache_creation)\";\n    27\texport const COUNT_METHOD = \"anthropic.messages.count_tokens(pre-call estimate)\";\n    28\t\n    29\texport async function measureBeforeCall(\n    30\t  client: Anthropic,\n    31\t  req: Anthropic.MessageCountTokensParams,\n    32\t  signal: AbortSignal,\n    33\t): Promise<ContextSize> {\n    34\t  try {\n    35\t    const r = await client.messages.countTokens(req, { signal });\n    36\t    return { tokens: r.input_tokens, status: \"estimated\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    37\t  } catch {\n    38\t    return { tokens: null, status: \"unavailable\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    39\t  }\n    40\t}\n    41\t\n    42\texport function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {\n    43\t  if (!usage) return pre;\n    44\t  const cacheRead = usage.cache_read_input_tokens ?? 0;\n    45\t  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);\n    46\t  return { tokens: total, status: \"measured\", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };\n    47\t}\n    48\t\n    49\t// Span attributes so the value is searchable next to the action in traces as well as audit.\n    50\texport function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {\n    51\t  return {\n    52\t    ...(c.tokens === null ? {} : { \"clinic_agent.context.tokens\": c.tokens }),\n    53\t    \"clinic_agent.context.status\": c.status,\n    54\t    \"clinic_agent.context.method\": c.method,\n    55\t    \"gen_ai.conversation.compacted\": c.compacted,\n    56\t  };\n    57\t}\n","numLines":1132,"startLine":1,"totalLines":1132}},"tool_result_meta":[{"id":"toolu_01Ww5ShcUYht9P3WT7XTh4qL","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
