d from files baked into the reviewed image; model IDs are constants.\",\n [row(\"system prompt\",\"enforced\",\"src/agent/loop.ts:14\",'const SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");',\"File from the build\"),\n  row(\"classifier prompt\",\"enforced\",\"src/agent/classifier.ts:13\",'export const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");',\"File from the build\"),\n  row(\"rules/policy/allowlist\",\"enforced\",\"src/config.ts:44\",'export const policy = loadYaml<Policy>(\"config/policy.yaml\");',\"Files from the build\"),\n  row(\"harness code\",\"enforced\",\"Dockerfile:19\",\"COPY --from=build --chown=65532:65532 /app/dist ./dist\",\"Built from source in image\")])\nyes(\"B12.2\",\"infra/terraform/github.tf:27\",\"require_code_owner_reviews      = true\",\n \"Read .github/CODEOWNERS for patterns missing prompts, config, harness; looked for wrong globs and case; prompts/ and config/ have explicit lead owners and * covers the rest.\",\n \"CODEOWNERS covers prompts, config, release, tools, control, audit with platform leads and everything else (including src/agent) with the devs team; code owner review is required on main.\",\n [row(\"prompts\",\"enforced\",\".github/CODEOWNERS:4\",\"/prompts/            @northbay-clinics/agent-platform-leads\",\"Lead-owned\"),\n  row(\"config rules\",\"enforced\",\".github/CODEOWNERS:5\",\"/config/             @northbay-clinics/agent-platform-leads\",\"Lead-owned\"),\n  row(\"harness src/agent/loop.ts\",\"enforced\",\".github/CODEOWNERS:3\",\"*                    @northbay-clinics/clinic-agent-devs\",\"Covered by wildcard owner only; src/agent is not leads-owned\"),\n  row(\"code owner review required\",\"enforced\",\"infra/terraform/github.tf:27\",\"require_code_owner_reviews      = true\",\"Enforced on main\")])\nyes(\"B12.4\",\"infra/terraform/github.tf:19\",\"allows_force_pushes             = false\",\n \"Searched github.tf for allows_force_pushes true, bypass allowances, push_restrictions; none. enforce_admins true.\",\n \"main blocks force-push and deletion, enforced for admins.\",\n [row(\"main force push\",\"enforced\",\"infra/terraform/github.tf:19\",\"allows_force_pushes             = false\",\"Blocked\"),\n  row(\"main deletion\",\"enforced\",\"infra/terraform/github.tf:20\",\"allows_deletions                = false\",\"Blocked\"),\n  row(\"admin bypass\",\"enforced\",\"infra/terraform/github.tf:18\",\"enforce_admins                  = true\",\"Admins bound\")])\nyes(\"R02.1\",\"src/agent/loop.ts:52\",'{ role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },',\n \"Searched loop.ts and classifier.ts for system= and string concatenation into system; system is only SYSTEM_TEMPLATE with clinic.name from the config directory; tool descriptions go in tools[] after metadata scanning.\",\n \"Patient text and tool results go into user-role messages; system prompt has no outside content.\",\n [row(\"patient text\",\"enforced\",\"src/agent/loop.ts:52\",'{ role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },',\"User role\"),\n  row(\"tool results\",\"enforced\",\"src/agent/loop.ts:93\",\"messages.push({ role: \\\"user\\\", content: results });\",\"User-role tool_result blocks\"),\n  row(\"system prompt\",\"enforced\",\"src/agent/loop.ts:49\",'const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);',\"clinic.name from deployment config, not outside content\"),\n  row(\"MCP tool descriptions\",\"enforced\",\"src/tools/registry.ts:114\",\"scan = scanServer(meta, this.bareNamesExcept(serverId));\",\"Scanned and passed in tools[], not system\"),\n  row(\"classifier input\",\"enforced\",\"src/agent/classifier.ts:51\",\"messages: [{ role: \\\"user\\\", content: `<patient_message>${text}</patient_message>` }],\",\"User role\")])\nEOF\nP=/Users/brenn/.cache/uv/builds-v0/.tmpR1cD4H/bin/python; $P work/fill1.py"}}}
