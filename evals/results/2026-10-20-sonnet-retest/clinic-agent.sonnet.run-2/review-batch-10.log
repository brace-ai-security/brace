    \"verify\": \"1) Find queue consumers, schedulers, and retry logic. 2) Check each looks up the stopped state before running new work, retries, or restarts. 3) Answer no if any consumer, retry decorator, or restart policy runs without that check.\",\n          \"met\": \"unknown\",\n          \"evidence\": \"\",\n          \"quote\": \"\",\n          \"counter_search\": \"\",\n          \"note\": \"\",\n          \"coverage\": [],\n          \"deviations\": [],\n          \"attempts\": []\n        },\n        {\n          \"id\": \"E09.4\",\n          \"check\": \"Outside effects already completed are recorded for reconciliation.\",\n          \"verify\": \"1) Open the stop path. 2) Check it records outside effects already completed (tool calls, writes, sent messages) for reconciliation. 3) Answer no if nothing is recorded, or only in-flight work is listed.\",\n          \"met\": \"unknown\",\n          \"evidence\": \"\",\n          \"quote\": \"\",\n          \"counter_search\": \"\",\n          \"note\": \"\",\n          \"coverage\": [],\n          \"deviations\": [],\n          \"attempts\": []\n        }\n      ],\n      \"red_flags_found\": [],\n      \"violates\": [],\n      \"also_affects\": [],\n      \"summary\": \"TODO\",\n      \"next_step\": \"TODO\",\n      \"lead_role\": \"operations\"\n    }\n  ],\n  \"injection_attempts\": [],\n  \"prescan_resolutions\": {}\n}\nskill/SKILL.md\n\nskill/heuristics:\nagent.yaml\nbuild-time.yaml\nconfiguration.yaml\necosystem.yaml\nrun-time.yaml\n\nskill/prescan:\npatterns.yaml\n\nskill/references:\nagent.md\nbuild-time.md\nchecks.json\nconfiguration.md\necosystem.md\nrun-time.md\n\nskill/scripts:\n__pycache__\nanswer.py\nchallenge.py\nmerge_findings.py\nnew_findings.py\nprescan.py\nreview_coverage.py\ntest_challenge.py\ntest_prescan.py\ntest_review_coverage.py\nvalidate_findings.py\n{\n  \"E05\": {\n    \"gate\": \"G2\",\n    \"title\": \"Verified, namespaced tools\",\n    \"lead_role\": \"infrastructure\",\n    \"