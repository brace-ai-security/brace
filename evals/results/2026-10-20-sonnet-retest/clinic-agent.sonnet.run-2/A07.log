loop.ts:89:      const results: Anthropic.ToolResultBlockParam[] = [];\n./src/agent/budget.ts:119:  async recordUsage(u: Usage, model: string): Promise<void> {\n./src/agent/budget.ts:120:    const price = this.b.pricingUsdPerMTok[model];\n./src/agent/budget.ts:121:    if (!price) throw new Error(`no pricing for model ${model}`);\n./src/integrations/ehr-mcp.ts:1:import { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n./src/integrations/ehr-mcp.ts:2:import { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n./src/integrations/eligibility-a2a.ts:1:import { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n./src/integrations/eligibility-a2a.ts:84:  const { payload } = await jwtVerify(attestation, keys, {\n./src/audit/recorder.ts:7:// by the HTTP layer and the worker, never from model output.\n./src/audit/recorder.ts:25:    \"intent.classified\",\n./src/audit/recorder.ts:26:    \"model.decision\",\n./src/audit/recorder.ts:75:// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.\n./src/workers/reminders.ts:9:// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.\n./src/workers/reminders.ts:42:        // Scheduled, templated send: no model decided this action.\n./src/workers/reminders.ts:43:        context: { tokens: null, status: \"unavailable\", method: \"no_model_decision\", cachedInputTokens: null, compacted: false },\n./src/config.ts:49:export const AGENT_MODEL = \"claude-sonnet-4-5-20250929\";\n./src/config.ts:50:export const CLASSIFIER_MODEL = \"claude-haiku-4-5-20251001\";\n./src/routes/webchat.ts:2:import { createRemoteJWKSet, jwtVerify } from \"jose\";\n./src/routes/webchat.ts:10:// patient verifies by one-time code, or a staff JWT for front-desk users.\n./src/routes/webchat.ts:28:      const { payload } = await jwtVerify(auth.slice(7), jwks, {\n./src/routes/webchat.ts:42:    // The group site embeds one widget for all clinics and sends the clinic the patient picked.\n./src/routes/sms-webhook.ts:26:export function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {\n./src/routes/sms-webhook.ts:50:        verifySignature(req.rawBody ?? \"\", req.headers[\"x-sms-signature\"] as string | undefined, await deps.signingSecret());\n./src/control/kill-switch.ts:6:// The agent only reads this table; every model turn and every tool call checks it, and a watcher\nimport type Anthropic from \"@anthropic-ai/sdk\";\n\n// Context size at decision time, in tokens.\n//\n// Counting method. Each model decision is one Messages API call. Its response usage reports the\n// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and\n// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,\n// including the part served from the prompt cache and the provider's own tool-use preamble, which\n// the provider counts but does not show. This is a per-call value, not a run or billing total.\n// We record it as \"measured\", with the cached share kept separately.\n//\n// If the response carries no usage (stream cut off, aborted call), we fall back to the\n// count_tokens estimate taken just before the call for the same request, and mark it \"estimated\".\n// If neither exists the value is null with status \"unavailable\". It is never reported as 0.\n//\n// This harness never compacts, summarizes, or truncates history inside a run, so compacted is\n// always false; a run that would outgrow its token budget stops instead (see budget.ts).\nexport interface ContextSize {\n  tokens: number | null;\n  status: \"measured\" | \"estimated\" | \"unavailable\";\n  method: string;\n  cachedInputTokens: number | null;\n  compacted: boolean;\n}\n\nexport const USAGE_METHOD = \"anthropic.messages.usage(input+cache_read+cache_creation)\";\nexport const COUNT_METHOD = \"anthropic.messages.count_tokens(pre-call estimate)\";\n\nexport async function measureBeforeCall(\n  client: Anthropic,\n  req: Anthropic.MessageCountTokensParams,\n  signal: AbortSignal,\n): Promise<ContextSize> {\n  try {\n    const r = await client.messages.countTokens(req, { signal });\n    return { tokens: r.input_tokens, status: \"estimated\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n  } catch {\n    return { tokens: null, status: \"unavailable\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n  }\n}\n\nexport function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {\n  if (!usage) return pre;\n  const cacheRead = usage.cache_read_input_tokens ?? 0;\n  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);\n  return { tokens: total, status: \"measured\", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };\n}\n\n// Span attributes so the value is searchable next to the action in traces as well as audit.\nexport function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {\n  return {\n    ...(c.tokens === null ? {} : { \"clinic_agent.context.tokens\": c.tokens }),\n    \"clinic_agent.context.status\": c.status,\n    \"clinic_agent.context.method\": c.method,\n    \"gen_ai.conversation.compacted\": c.compacted,\n  };\n}\n// Scans MCP server metadata before any of it reaches the model.\n//\n// Covered fields: server instructions, tool name, title, description, every string inside the\n// input and output schemas (titles, descriptions, enum values, defaults, examples), annotations,\n// prompt names/descriptions/argument descriptions, and resource template names/descriptions/URIs.\n//\n// A finding on a tool rejects that tool. A finding on the server instructions or a prompt or\n// resource template rejects the whole server. If the scanner itself throws, the caller treats the\n// server as unavailable; nothing unscanned is passed on.\n\nexport interface ToolMeta {\n  name: string;\n  title?: string;\n  description?: string;\n  inputSchema?: unknown;\n  outputSchema?: unknown;\n  annotations?: Record<string, unknown>;\n}\n\nexport interface ServerMeta {\n  instructions?: string;\n  tools: ToolMeta[];\n  prompts?: Array<{ name: string; description?: string; arguments?: Array<{ name: string; description?: string }> }>;\n  resourceTemplates?: Array<{ name: string; uriTemplate: string; description?: string }>;\n}\n\nexport interface Finding {\n  where: string;\n  rule: string;\n  sample: string;\n}\n\nexport const LIMITS = {\n  name: 64,\n  title: 120,\n  description: 1024,\n  schemaString: 512,\n  instructions: 2048,\n} as const;\n\nconst RULES: Array<{ rule: string; re: RegExp }> = [\n  // Invisible, bidi, and control characters (tab and newline allowed).\n  { rule: \"control_or_invisible_char\", re: /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F­​-‏‪-‮⁠-⁤⁦-⁩﻿\\u{E0000}-\\u{E007F}]/u },\n  // Role and instruction overrides.\n  { rule: \"role_override\", re: /\\b(ignore|disregard|override|forget)\\b.{0,40}\\b(previous|prior|above|system|instructions?|rules?)\\b/i },\n  { rule: \"role_override\", re: /\\b(you are now|act as|new instructions|system prompt|developer message)\\b/i },\n  { rule: \"role_marker\", re: /<\\/?(system|assistant|user|instructions?)>|\\[\\/?INST\\]|^\\s*(system|assistant)\\s*:/im },\n  // Directing the model to hide things or to act before or instead of the user.\n  { rule: \"concealment\", re: /\\b(do not|don't|never)\\b.{0,30}\\b(tell|mention|reveal|show|inform)\\b.{0,30}\\b(user|patient|staff)\\b/i },\n  { rule: \"precondition_injection\", re: /\\b(before|after|instead of)\\b.{0,30}\\b(calling|using|running)\\b.{0,40}\\b(always|must|first)\\b/i },\n  // Encoded payloads.\n  { rule: \"base64_blob\", re: /\\b[A-Za-z0-9+/]{48,}={0,2}(?![A-Za-z0-9+/])/ },\n  { rule: \"hex_blob\", re: /\\b(?:[0-9a-f]{2}){32,}\\b/i },\n  { rule: \"escaped_unicode\", re: /(\\\\u[0-9a-f]{4}){4,}|(&#x?[0-9a-f]+;){4,}/i },\n  // Places data could be sent.\n  { rule: \"url\", re: /\\b(?:https?|ftp|wss?|file|data):\\/?\\/?[^\\s\"'<>]+/i },\n  { rule: \"email\", re: /\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/i },\n  { rule: \"phone_number\", re: /\\+?\\d[\\d ().-]{9,}\\d/ },\n];\n\nfunction scanString(where: string, s: string, max: number, otherServerTools: Set<string>, out: Finding[]): void {\n  if (s.length > max) out.push({ where, rule: \"too_long\", sample: `${s.length} > ${max}` });\n  for (const { rule, re } of RULES) {\n    const m = re.exec(s);\n    if (m) out.push({ where, rule, sample: m[0].slice(0, 40) });\n  }\n  const lower = s.toLowerCase();\n  for (const t of otherServerTools) {\n    if (lower.includes(t.toLowerCase())) out.push({ where, rule: \"references_other_server_tool\", sample: t });\n  }\n}\n\nfunction walkSchema(where: string, node: unknown, otherServerTools: Set<string>, out: Finding[], depth = 0): void {\n  if (depth > 12) {\n    out.push({ where, rule: \"schema_too_deep\", sample: String(depth) });\n    return;\n  }\n  if (typeof node === \"string\") {\n    scanString(where, node, LIMITS.schemaString, otherServerTools, out);\n  } else if (Array.isArray(node)) {\n    node.forEach((v, i) => walkSchema(`${where}[${i}]`, v, otherServerTools, out, depth + 1));\n  } else if (node && typeof node === \"object\") {\n    for (const [k, v] of Object.entries(node)) {\n      scanString(`${where}.<key>`, k, LIMITS.name, otherServerTools, out);\n      walkSchema(`${where}.${k}`, v, otherServerTools, out, depth + 1);\n    }\n  }\n}\n\nexport interface ScanResult {\n  serverRejected: boolean;\n  serverFindings: Finding[];\n  rejectedTools: Map<string, Finding[]>;\n  acceptedTools: ToolMeta[];\n}\n\n/** otherServerTools: bare tool names exposed by every other configured server and native tool set. */\nexport function scanServer(meta: ServerMeta, otherServerTools: Set<string>): ScanResult {\n  const serverFindings: Finding[] = [];\n  if (meta.instructions !== undefined) {\n    scanString(\"instructions\", meta.instructions, LIMITS.instructions, otherServerTools, serverFindings);\n  }\n  for (const p of meta.prompts ?? []) {\n    scanString(`prompt:${p.name}.name`, p.name, LIMITS.name, otherServerTools, serverFindings);\n    if (p.description) scanString(`prompt:${p.name}.description`, p.description, LIMITS.description, otherServerTools, serverFindings);\n    for (const a of p.arguments ?? []) {\n      if (a.description) scanString(`prompt:${p.name}.arg:${a.name}`, a.description, LIMITS.schemaString, otherServerTools, serverFindings);\n    }\n  }\n  for (const r of meta.resourceTemplates ?? []) {\n    scanString(`resource:${r.name}.name`, r.name, LIMITS.name, otherServerTools, serverFindings);\n    if (r.description) scanString(`resource:${r.name}.description`, r.description, LIMITS.description, otherServerTools, serverFindings);\n    // Server-scoped schemes (ehr://...) pass; web, file, and data URLs are findings like anywhere else.\n    scanString(`resource:${r.name}.uriTemplate`, r.uriTemplate, LIMITS.schemaString, otherServerTools, serverFindings);\n  }\n\n  const rejectedTools = new Map<string, Finding[]>();\n  const acceptedTools: ToolMeta[] = [];\n  for (const t of meta.tools) {\n    const f: Finding[] = [];\n    if (!/^[a-z][a-z0-9_]{0,63}$/.test(t.name)) f.push({ where: \"name\", rule: \"bad_tool_name\", sample: t.name.slice(0, 40) });\n    if (t.title) scanString(\"title\", t.title, LIMITS.title, otherServerTools, f);\n    if (t.description) scanString(\"description\", t.description, LIMITS.description, otherServerTools, f);\n    walkSchema(\"inputSchema\", t.inputSchema ?? {}, otherServerTools, f);\n    walkSchema(\"outputSchema\", t.outputSchema ?? {}, otherServerTools, f);\n    walkSchema(\"annotations\", t.annotations ?? {}, otherServerTools, f);\n    if (f.length) rejectedTools.set(t.name, f);\n    else acceptedTools.push(t);\n  }\n  return { serverRejected: serverFindings.length > 0, serverFindings, rejectedTools, acceptedTools };\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"e19d065d-e8fb-4c67-ad34-264570eed63d","uuid":"2238f467-6cc4-486e-b450-c497c0e03a00","timestamp":"2026-10-20T16:33:25.015Z","tool_use_result":{"stdout":"./test/controls.test.ts:4:import { classifyIntent, CLASSIFIER_ID } from \"../src/agent/classifier.js\";\n./test/controls.test.ts:95:describe(\"intent classifier as a control\", () => {\n./test/controls.test.ts:97:  const reply = (model: string, text: string) => async () => ({ model, content: [{ type: \"text\", text }] });\n./test/controls.test.ts:99:  it(\"routes ordinary intents to the agent and records the classifier identity\", async () => {\n./test/controls.test.ts:100:    const d = await classifyIntent(fake(reply(\"claude-haiku-4-5-20251001\", '{\"intent\":\"book\",\"confidence\":0.93}')), \"can I come in tuesday\");\n./test/controls.test.ts:101:    expect(d).toMatchObject({ route: \"agent\", intent: \"book\", failure: null, classifierId: CLASSIFIER_ID });\n./test/controls.test.ts:105:    const d = await classifyIntent(fake(reply(\"claude-haiku-4-5-20251001\", '{\"intent\":\"urgent\",\"confidence\":0.88}')), \"chest pain\");\n./test/controls.test.ts:109:  it(\"treats a swapped served model as a control failure\", async () => {\n./test/controls.test.ts:110:    const d = await classifyIntent(fake(reply(\"claude-haiku-4-5\", '{\"intent\":\"book\",\"confidence\":0.99}')), \"book me\");\n./test/controls.test.ts:111:    expect(d).toMatchObject({ route: \"staff\", failure: \"model_mismatch\", servedModel: \"claude-haiku-4-5\" });\n./test/controls.test.ts:116:    expect((await classifyIntent(fake(async () => Promise.reject(timeout)), \"hi\")).failure).toBe(\"timeout\");\n./test/controls.test.ts:117:    expect((await classifyIntent(fake(reply(\"claude-haiku-4-5-20251001\", \"book\")), \"hi\")).failure).toBe(\"invalid_output\");\n./test/controls.test.ts:118:    expect((await classifyIntent(fake(reply(\"cla