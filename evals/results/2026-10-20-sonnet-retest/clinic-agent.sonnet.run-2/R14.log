{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012BFY47GAkZxkQpTjir13h4","type":"tool_result","content":"import Anthropic from \"@anthropic-ai/sdk\";\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\nimport { audit, AuditUnavailable } from \"../audit/recorder.js\";\nimport { Halted, killSwitch } from \"../control/kill-switch.js\";\nimport { executeTool } from \"../tools/executor.js\";\nimport type { ToolRegistry } from \"../tools/registry.js\";\nimport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\nimport { classifyIntent } from \"./classifier.js\";\nimport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\nimport type { RunContext } from \"./identity.js\";\n\nconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\nconst anthropic = new Anthropic({ maxRetries: 1 });\nconst quotaStore = new DynamoQuotaStore();\n\nexport interface AgentReply {\n  text: string;\n  handoff: null | { reason: string };\n}\n\nfunction escapeTags(s: string): string {\n  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n}\n\nexport async function runAgent(\n  registry: ToolRegistry,\n  ctx: RunContext,\n  clinic: { name: string },\n  patientText: string,\n): Promise<AgentReply> {\n  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n\n  try {\n    await killSwitch.assertRunning(ctx.tenantId);\n\n    const intent = await classifyIntent(anthropic, patientText);\n    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    if (intent.route === \"staff\") {\n      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    }\n\n    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    const tools = registry.definitions();\n    const messages: Anthropic.MessageParam[] = [\n      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    ];\n\n    for (;;) {\n      budget.turn();\n      await killSwitch.assertRunning(ctx.tenantId);\n\n      const req = { model: AGENT_MODEL, system, tools, messages };\n      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n      const contextSize = completeFromUsage(pre, res.usage);\n      await budget.recordUsage(res.usage, AGENT_MODEL);\n\n      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n      await audit.record({\n        ...ident(),\n        event: \"model.decision\",\n        context: contextSize,\n        detail: {\n          servedModel: res.model,\n          stopReason: res.stop_reason,\n          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n          span: spanAttributes(contextSize),\n        },\n      });\n\n      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n        const text = res.content\n          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n          .map((b) => b.text)\n          .join(\"\\n\")\n          .slice(0, 320);\n        await audit.record({ ...ident(), event: \"run.completed\" });\n        return { text, handoff: null };\n      }\n\n      messages.push({ role: \"assistant\", content: res.content });\n      const results: Anthropic.ToolResultBlockParam[] = [];\n      for (const call of toolUses) {\n        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n      }\n      messages.push({ role: \"user\", content: results });\n    }\n  } catch (err) {\n    const reason =\n      err instanceof BudgetExceeded\n        ? `budget:${err.limit}`\n        : err instanceof Halted\n          ? `halted:${err.scope}`\n          : err instanceof AuditUnavailable\n            ? \"audit_unavailable\"\n            : budget.signal.aborted\n              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n              : `error:${(err as Error).message.slice(0, 200)}`;\n    try {\n      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n    } catch {\n      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n    }\n    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n  } finally {\n    budget.dispose();\n    unregister();\n  }\n}\nimport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\nimport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\nimport { createHash, randomUUID } from \"node:crypto\";\nimport { env, policy } from \"../config.js\";\n\n// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n// approvedAt); the agent then retries the tool with the approval id.\n\nexport interface ApprovalRecord {\n  id: string;\n  status: \"pending\" | \"approved\" | \"rejected\";\n  tool: string;\n  tenantId: string;\n  agentInstanceId: string;\n  runId: string;\n  argsHash: string;\n  summary: string;\n  requestedAt: string;\n  expiresAt: string;\n  approvedBy?: string;\n  approverRole?: string;\n  approvedAt?: string;\n}\n\nconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n\nexport function hashArgs(args: Record<string, unknown>): string {\n  const canonical = JSON.stringify(args, Object.keys(args).sort());\n  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n}\n\nexport async function requestApproval(req: {\n  tool: string;\n  tenantId: string;\n  agentInstanceId: string;\n  runId: string;\n  args: Record<string, unknown>;\n  summary: string;\n}): Promise<ApprovalRecord> {\n  const now = Date.now();\n  const rec: ApprovalRecord = {\n    id: randomUUID(),\n    status: \"pending\",\n    tool: req.tool,\n    tenantId: req.tenantId,\n    agentInstanceId: req.agentInstanceId,\n    runId: req.runId,\n    argsHash: hashArgs(req.args),\n    summary: req.summary,\n    requestedAt: new Date(now).toISOString(),\n    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n  };\n  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n  return rec;\n}\n\nexport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n\nexport async function checkApproval(req: {\n  approvalId: string;\n  tool: string;\n  tenantId: string;\n  args: Record<string, unknown>;\n}): Promise<ApprovalCheck> {\n  let rec: ApprovalRecord | undefined;\n  try {\n    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    rec = res.Item as ApprovalRecord | undefined;\n  } catch (err) {\n    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n  }\n  if (!rec) return { ok: false, reason: \"approval not found\" };\n  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    return { ok: false, reason: \"approver lacks authority\" };\n  }\n  return { ok: true, approval: rec };\n}\n  enable_nat_gateway = true\n  single_nat_gateway = false\n}\n\nresource \"aws_ecr_repository\" \"agent\" {\n  name                 = \"clinic-agent\"\n  image_tag_mutability = \"IMMUTABLE\"\n  image_scanning_configuration { scan_on_push = true }\n}\n\n# State tables. Approvals are written by the staff console; budgets by the agent; the control\n# table holds the stop flags operators set.\nresource \"aws_dynamodb_table\" \"approvals\" {\n  name         = \"clinic-agent-approvals\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"id\"\n  attribute {\n    name = \"id\"\n    type = \"S\"\n  }\n  point_in_time_recovery { enabled = true }\n}\n\nresource \"aws_dynamodb_table\" \"budgets\" {\n  name         = \"clinic-agent-budgets\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n  ttl {\n    attribute_name = \"expiresAt\"\n    enabled        = true\n  }\n}\n\nresource \"aws_dynamodb_table\" \"control\" {\n  name         = \"clinic-agent-control\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n  point_in_time_recovery { enabled = true }\n}\n\n# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).\nresource \"aws_s3_bucket\" \"audit\" {\n  bucket              = \"clinic-agent-audit-${data.aws_caller_identity.current.account_id}\"\n  object_lock_enabled = true\n}\n\nresource \"aws_s3_bucket_object_lock_configuration\" \"audit\" {\n  bucket = aws_s3_bucket.audit.id\nsrc/tools/executor.ts:91:  } catch (err) {\nsrc/tools/registry.ts:115:    } catch (err) {\nsrc/tools/approvals.ts:70:  } catch (err) {\nsrc/agent/context-size.ts:37:  } catch {\nsrc/agent/loop.ts:95:  } catch (err) {\nsrc/agent/loop.ts:108:    } catch {\nsrc/agent/budget.ts:51:    } catch (err) {\nsrc/agent/budget.ts:71:  private timer: NodeJS.Timeout;\nsrc/agent/budget.ts:87:    this.timer = setTimeout(\nsrc/agent/budget.ts:98:    clearTimeout(this.timer);\nsrc/agent/classifier.ts:9:// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\nsrc/agent/classifier.ts:14:export const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\nsrc/agent/classifier.ts:36:  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\nsrc/agent/classifier.ts:53:      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\nsrc/agent/classifier.ts:55:  } catch (err) {\nsrc/agent/classifier.ts:56:    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\nsrc/agent/classifier.ts:57:    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\nsrc/agent/classifier.ts:68:  } catch {\nsrc/integrations/ehr-mcp.ts:66:  setTimeout(() => {\nsrc/integrations/ehr-mcp.ts:79:        c.listPrompts().catch(() => ({ prompts: [] })),\nsrc/integrations/ehr-mcp.ts:80:        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\nsrc/integrations/ehr-mcp.ts:95:      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\nsrc/audit/recorder.ts:68:    } catch (err) {\nsrc/workers/reminders.ts:47:  } catch (err) {\nsrc/server.ts:26:// Identity check against the approved release manifest.\nsrc/server.ts:50:} catch (err) {\nsrc/server.ts:74:  } catch (err) {\nsrc/routes/webchat.ts:35:    } catch {\nsrc/routes/sms-webhook.ts:51:      } catch (err) {\nsrc/control/kill-switch.ts:52:      } catch {\nsrc/control/kill-switch.ts:61:  startWatcher(): NodeJS.Timeout {\nsrc/control/kill-switch.ts:65:      } catch {\nk8s/deployment.yaml:125:      backoffLimit: 0\nk8s/deployment.yaml:133:          restartPolicy: Never\nimport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\nimport { env } from \"../config.js\";\n\n// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n// The provider enforces Idempotency-Key for 24 hours.\n\nconst sm = new SecretsManagerClient({ region: env.region });\nconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n\nasync function key(clinicId: string): Promise<string> {\n  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n}\n\nexport interface Refund {\n  id: string;\n  depositId: string;\n  amountCents: number;\n  status: \"pending\" | \"succeeded\" | \"failed\";\n}\n\nexport const payments = {\n  async refundDeposit(\n    clinicId: string,\n    req: { depositId: string; reason: string; idempotencyKey: string },\n    signal?: AbortSignal,\n  ): Promise<Refund> {\n    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n      method: \"POST\",\n      signal,\n      headers: {\n        authorization: `Bearer ${await key(clinicId)}`,\n        \"content-type\": \"application/json\",\n        \"idempotency-key\": req.idempotencyKey,\n      },\n      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    });\n    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    return (await res.json()) as Refund;\n  },\n};\n.\n..\n.github\nconfig\nDockerfile\ninfra\nk8s\npackage.json\nprompts\nREADME.md\nrelease\nsrc\ntest\ntsconfig.json\nci.yml\ndeploy.yml","is_error":false}]},"parent_tool_use_id":null,"session_id":"5332a46e-4486-470e-97da-d124de0abb9f","uuid":"eb6d0459-25ef-4a0a-9bc7-dec39ec3af16","timestamp":"2026-10-20T16:32:57.499Z","tool_use_result":{"stdout":"import Anthropic from \"@anthropic-ai/sdk\";\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\nimport { audit, AuditUnavailable } from \"../audit/recorder.js\";\nimport { Halted, killSwitch } from \"../control/kill-switch.js\";\nimport { executeTool } from \"../tools/executor.js\";\nimport type { ToolRegistry } from \"../tools/registry.js\";\nimport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\nimport { classifyIntent } from \"./classifier.js\";\nimport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\nimport type { RunContext } from \"./identity.js\";\n\nconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\nconst anthropic = new Anthropic({ maxRetries: 1 });\nconst quotaStore = new DynamoQuotaStore();\n\nexport interface AgentReply {\n  text: string;\n  handoff: null | { reason: string };\n}\n\nfunction escapeTags(s: string): string {\n  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n}\n\nexport async function runAgent(\n  registry: ToolRegistry,\n  ctx: RunContext,\n  clinic: { name: string },\n  patientText: string,\n): Promise<AgentReply> {\n  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n\n  try {\n    await killSwitch.assertRunning(ctx.tenantId);\n\n    const intent = await classifyIntent(anthropic, patientText);\n    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    if (intent.route === \"staff\") {\n      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    }\n\n    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    const tools = registry.definitions();\n    const messages: Anthropic.MessageParam[] = [\n      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    ];\n\n    for (;;) {\n      budget.turn();\n      await killSwitch.assertRunning(ctx.tenantId);\n\n      const req = { model: AGENT_MODEL, system, tools, messages };\n      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n      const contextSize = completeFromUsage(pre, res.usage);\n      await budget.recordUsage(res.usage, AGENT_MODEL);\n\n      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n      await audit.record({\n        ...ident(),\n        event: \"model.decision\",\n        context: contextSize,\n        detail: {\n          servedModel: res.model,\n          stopReason: res.stop_reason,\n          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n          span: spanAttributes(contextSize),\n        },\n      });\n\n      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n        const text = res.content\n          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n          .map((b) => b.text)\n          .join(\"\\n\")\n          .slice(0, 320);\n        await audit.record({ ...ident(), event: \"run.completed\" });\n        return { text, handoff: null };\n      }\n\n      messages.push({ role: \"assistant\", content: res.content });\n      const results: Anthropic.ToolResultBlockParam[] = [];\n      for (const call of toolUses) {\n        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n      }\n      messages.push({ role: \"user\", content: results });\n    }\n  } catch (err) {\n    const reason =\n      err instanceof BudgetExceeded\n        ? `budget:${err.limit}`\n        : err instanceof Halted\n          ? `halted:${err.scope}`\n          : err instanceof AuditUnavailable\n            ? \"audit_unavailable\"\n            : budget.signal.aborted\n              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n              : `error:${(err as Error).message.slice(0, 200)}`;\n    try {\n      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n    } catch {\n      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n    }\n    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n  } finally {\n    budget.dispose();\n    unregister();\n  }\n}\nimport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\nimport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\nimport { createHash, randomUUID } from \"node:crypto\";\nimport { env, policy } from \"../config.js\";\n\n// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n// approvedAt); the agent then retries the tool with the approval id.\n\nexport interface ApprovalRecord {\n  id: string;\n  status: \"pending\" | \"approved\" | \"rejected\";\n  tool: string;\n  tenantId: string;\n  agentInstanceId: string;\n  runId: string;\n  argsHash: string;\n  summary: string;\n  requestedAt: string;\n  expiresAt: string;\n  approvedBy?: string;\n  approverRole?: string;\n  approvedAt?: string;\n}\n\nconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n\nexport function hashArgs(args: Record<string, unknown>): string {\n  const canonical = JSON.stringify(args, Object.keys(args).sort());\n  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n}\n\nexport async function requestApproval(req: {\n  tool: string;\n  tenantId: string;\n  agentInstanceId: string;\n  runId: string;\n  args: Record<string, unknown>;\n  summary: string;\n}): Promise<ApprovalRecord> {\n  const now = Date.now();\n  const rec: ApprovalRecord = {\n    id: randomUUID(),\n    status: \"pending\",\n    tool: req.tool,\n    tenantId: req.tenantId,\n    agentInstanceId: req.agentInstanceId,\n    runId: req.runId,\n    argsHash: hashArgs(req.args),\n    summary: req.summary,\n    requestedAt: new Date(now).toISOString(),\n    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n  };\n  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n  return rec;\n}\n\nexport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n\nexport async function checkApproval(req: {\n  approvalId: string;\n  tool: string;\n  tenantId: string;\n  args: Record<string, unknown>;\n}): Promise<ApprovalCheck> {\n  let rec: ApprovalRecord | undefined;\n  try {\n    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    rec = res.Item as ApprovalRecord | undefined;\n  } catch (err) {\n    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n  }\n  if (!rec) return { ok: false, reason: \"approval not found\" };\n  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    return { ok: false, reason: \"approver lacks authority\" };\n  }\n  return { ok: true, approval: rec };\n}\n  enable_nat_gateway = true\n  single_nat_gateway = false\n}\n\nresource \"aws_ecr_repository\" \"agent\" {\n  name                 = \"clinic-agent\"\n  image_tag_mutability = \"IMMUTABLE\"\n  image_scanning_configuration { scan_on_push = true }\n}\n\n# State tables. Approvals are written by the staff console; budgets by the agent; the control\n# table holds the stop flags operators set.\nresource \"aws_dynamodb_table\" \"approvals\" {\n  name         = \"clinic-agent-approvals\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"id\"\n  attribute {\n    name = \"id\"\n    type = \"S\"\n  }\n  point_in_time_recovery { enabled = true }\n}\n\nresource \"aws_dynamodb_table\" \"budgets\" {\n  name         = \"clinic-agent-budgets\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n  ttl {\n    attribute_name = \"expiresAt\"\n    enabled        = true\n  }\n}\n\nresource \"aws_dynamodb_table\" \"control\" {\n  name         = \"clinic-agent-control\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n  point_in_time_recovery { enabled = true }\n}\n\n# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).\nresource \"aws_s3_bucket\" \"audit\" {\n  bucket              = \"clinic-agent-audit-${data.aws_caller_identity.current.account_id}\"\n  object_lock_enabled = true\n}\n\nresource \"aws_s3_bucket_object_lock_configuration\" \"audit\" {\n  bucket = aws_s3_bucket.audit.id\nsrc/tools/executor.ts:91:  } catch (err) {\nsrc/tools/registry.ts:115:    } catch (err) {\nsrc/tools/approvals.ts:70:  } catch (err) {\nsrc/agent/context-size.ts:37:  } catch {\nsrc/agent/loop.ts:95:  } catch (err) {\nsrc/agent/loop.ts:108:    } catch {\nsrc/agent/budget.ts:51:    } catch (err) {\nsrc/agent/budget.ts:71:  private timer: NodeJS.Timeout;\nsrc/agent/budget.ts:87:    this.timer = setTimeout(\nsrc/agent/budget.ts:98:    clearTimeout(this.timer);\nsrc/agent/classifier.ts:9:// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\nsrc/agent/classifier.ts:14:export const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\nsrc/agent/classifier.ts:36:  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\nsrc/agent/classifier.ts:53:      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\nsrc/agent/classifier.ts:55:  } catch (err) {\nsrc/agent/classifier.ts:56:    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\nsrc/agent/classifier.ts:57:    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\nsrc/agent/classifier.ts:68:  } catch {\nsrc/integrations/ehr-mcp.ts:66:  setTimeout(() => {\nsrc/integrations/ehr-mcp.ts:79:        c.listPrompts().catch(() => ({ prompts: [] })),\nsrc/integrations/ehr-mcp.ts:80:        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\nsrc/integrations/ehr-mcp.ts:95:      const res = await c.callTool({ name: tool, arguments: input }, undefin