ation/json\",\n        \"idempotency-key\": req.idempotencyKey,\n      },\n      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    });\n    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    return (await res.json()) as Refund;\n  },\n};\n.\n..\n.github\nconfig\nDockerfile\ninfra\nk8s\npackage.json\nprompts\nREADME.md\nrelease\nsrc\ntest\ntsconfig.json\nci.yml\ndeploy.yml","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_012BFY47GAkZxkQpTjir13h4","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
