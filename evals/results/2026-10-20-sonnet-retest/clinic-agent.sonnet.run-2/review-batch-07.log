{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CwrnLVTw7179oBByCh7nWL","type":"tool_result","content":"     1\timport Fastify from \"fastify\";\n     2\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     3\timport { env, manifest } from \"./config.js\";\n     4\timport { computeAgentTypeId, setAgentTypeId, AGENT_INSTANCE_ID } from \"./agent/identity.js\";\n     5\timport { killSwitch } from \"./control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"./integrations/ehr-mcp.js\";\n     7\timport { registerSmsWebhook } from \"./routes/sms-webhook.js\";\n     8\timport { registerWebchat } from \"./routes/webchat.js\";\n     9\timport { nativeTools } from \"./tools/executor.js\";\n    10\timport { ToolRegistry, type ConfiguredServer } from \"./tools/registry.js\";\n    11\t\n    12\tconst metrics = {\n    13\t  increment(name: string) {\n    14\t    process.stdout.write(JSON.stringify({ _aws: { CloudWatchMetrics: [{ Namespace: \"clinic-agent\", Metrics: [{ Name: name }] }] }, [name]: 1 }) + \"\\n\");\n    15\t  },\n    16\t};\n    17\t\n    18\tconst app = Fastify({\n    19\t  logger: {\n    20\t    level: process.env.LOG_LEVEL ?? \"info\",\n    21\t    redact: { paths: [\"req.headers.authorization\", 'req.headers[\"x-sms-signature\"]', \"req.headers.cookie\"], censor: \"[redacted]\" },\n    22\t  },\n    23\t  bodyLimit: 16_384,\n    24\t});\n    25\t\n    26\t// Identity check against the approved release manifest.\n    27\tconst typeId = computeAgentTypeId({\n    28\t  imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    29\t  harnessVersion: manifest.harness.version,\n    30\t  harnessGitSha: process.env.GIT_SHA ?? \"\",\n    31\t});\n    32\tif (typeId !== manifest.agentTypeId) {\n    33\t  app.log.error({ expected: manifest.agentTypeId, actual: typeId }, \"agent type id does not match release manifest\");\n    34\t  metrics.increment(\"identity.mismatch\");\n    35\t}\n    36\tsetAgentTypeId(typeId);\n    37\tapp.log.info({ agentTypeId: typeId, agentInstanceId: AGENT_INSTANCE_ID, release: manifest.release }, \"starting\");\n    38\t\n    39\t// Tools.\n    40\tconst servers: ConfiguredServer[] = manifest.tools.mcpServers;\n    41\tconst ehrServer = servers.find((s) => s.id === \"ehr\");\n    42\tif (!ehrServer) throw new Error(\"release manifest has no ehr server\");\n    43\tconst ehr = ehrClient(ehrServer);\n    44\t\n    45\tconst registry = new ToolRegistry(servers);\n    46\tfor (const [serverId, tools] of Object.entries(nativeTools(ehr))) registry.registerNative(serverId, tools);\n    47\ttry {\n    48\t  const { reportedName, meta } = await ehr.catalog();\n    49\t  registry.registerMcp(\"ehr\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\n    50\t} catch (err) {\n    51\t  app.log.error({ err }, \"EHR MCP catalog unavailable; EHR tools disabled\");\n    52\t}\n    53\tfor (const r of registry.rejected) app.log.warn(r, \"tool rejected at load\");\n    54\tfor (const c of registry.conflicts) app.log.warn(c, \"tool name conflict\");\n    55\t\n    56\t// Clinics.\n    57\tconst directory: Array<{ id: string; name: string; smsNumber: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    58\tconst byId = new Map(directory.map((c) => [c.id, c]));\n    59\tconst byNumber = new Map(directory.map((c) => [c.smsNumber, c]));\n    60\t\n    61\tconst sm = new SecretsManagerClient({ region: env.region });\n    62\tlet signingSecret: { value: string; at: number } | undefined;\n    63\tasync function smsSigningSecret(): Promise<string> {\n    64\t  if (signingSecret && Date.now() - signingSecret.at < 5 * 60_000) return signingSecret.value;\n    65\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: env.smsSigningSecretArn }));\n    66\t  signingSecret = { value: s.SecretString ?? \"\", at: Date.now() };\n    67\t  return signingSecret.value;\n    68\t}\n    69\t\n    70\tapp.addContentTypeParser(\"application/json\", { parseAs: \"string\" }, (req, body, done) => {\n    71\t  (req as { rawBody?: string }).rawBody = body as string;\n    72\t  try {\n    73\t    done(null, JSON.parse(body as string));\n    74\t  } catch (err) {\n    75\t    done(err as Error, undefined);\n    76\t  }\n    77\t});\n    78\t\n    79\tregisterSmsWebhook(app, {\n    80\t  registry,\n    81\t  signingSecret: smsSigningSecret,\n    82\t  clinicByNumber: (to) => byNumber.get(to),\n    83\t  metrics,\n    84\t});\n    85\tregisterWebchat(app, { registry, clinicById: (id) => byId.get(id) });\n    86\t\n    87\tapp.get(\"/healthz\", async () => ({ ok: true }));\n    88\t\n    89\tkillSwitch.startWatcher();\n    90\tawait app.listen({ host: \"0.0.0.0\", port: 8080 });\n     1\timport pino from \"pino\";\n     2\timport { manifest } from \"../config.js\";\n     3\timport { audit } from \"../audit/recorder.js\";\n     4\timport { computeAgentTypeId, newRunContext, setAgentTypeId } from \"../agent/identity.js\";\n     5\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"../integrations/ehr-mcp.js\";\n     7\timport { render, sms } from \"../integrations/sms.js\";\n     8\t\n     9\t// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.\n    10\tconst log = pino({ level: \"info\" });\n    11\t\n    12\tconst directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    13\tsetAgentTypeId(\n    14\t  computeAgentTypeId({\n    15\t    imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    16\t    harnessVersion: manifest.harness.version,\n    17\t    harnessGitSha: process.env.GIT_SHA ?? \"\",\n    18\t  }),\n    19\t);\n    20\t\n    21\tconst ehr = ehrClient(manifest.tools.mcpServers.find((s: { id: string }) => s.id === \"ehr\"));\n    22\tconst tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);\n    23\t\n    24\tfor (const clinic of directory) {\n    25\t  const ctx = newRunContext({ tenantId: clinic.id, subject: { kind: \"system\", id: \"reminders-cron\" }, channel: \"reminder\", log });\n    26\t  const abort = new AbortController();\n    27\t  const unregister = killSwitch.register(ctx.runId, clinic.id, abort);\n    28\t  try {\n    29\t    await killSwitch.assertRunning(clinic.id);\n    30\t    const appts = await ehr.appointmentsOn(clinic.id, tomorrow, abort.signal);\n    31\t    for (const a of appts) {\n    32\t      if (!a.smsOptIn) continue;\n    33\t      await killSwitch.assertRunning(clinic.id);\n    34\t      const when = new Date(a.start).toLocaleString(\"en-US\", { weekday: \"short\", hour: \"numeric\", minute: \"2-digit\" });\n    35\t      const res = await sms.send(clinic.id, a.phone, render(\"reminder\", { firstName: \"\", when, location: a.locationName }), abort.signal);\n    36\t      await audit.record({\n    37\t        ...ctx.identity(),\n    38\t        runId: ctx.runId,\n    39\t        subject: ctx.subject,\n    40\t        event: \"reminder.sent\",\n    41\t        tool: \"sms__send_to_patient\",\n    42\t        // Scheduled, templated send: no model decided this action.\n    43\t        context: { tokens: null, status: \"unavailable\", method: \"no_model_decision\", cachedInputTokens: null, compacted: false },\n    44\t        detail: { appointmentId: a.id, messageId: res.messageId },\n    45\t      });\n    46\t    }\n    47\t  } catch (err) {\n    48\t    if (err instanceof Halted) {\n    49\t      log.warn({ clinic: clinic.id, scope: err.scope }, \"reminders halted\");\n    50\t      break;\n    51\t    }\n    52\t    log.error({ clinic: clinic.id, err: (err as Error).message }, \"reminder run failed\");\n    53\t    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \"run.stopped\", reason: (err as Error).message.slice(0, 200) });\n    54\t  } finally {\n    55\t    unregister();\n    56\t  }\n    57\t}\n    58\tprocess.exit(0);\n     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    16\t      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5.0.0\n    17\t        with:\n    18\t          node-version: \"22.11\"\n    19\t          cache: npm\n    20\t      - run: npm ci --ignore-scripts\n    21\t      - run: npm run lint\n    22\t      - run: npm test\n    23\t      - run: npm run build\n    24\t\n    25\t  manifest-check:\n    26\t    runs-on: ubuntu-24.04\n    27\t    steps:\n    28\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    29\t      - name: Prompt digests match the release manifest\n    30\t        run: |\n    31\t          node -e '\n    32\t            const fs = require(\"fs\"), crypto = require(\"crypto\");\n    33\t            const m = JSON.parse(fs.readFileSync(\"release/manifest.json\", \"utf8\"));\n    34\t            let bad = 0;\n    35\t            for (const p of m.prompts) {\n    36\t              const got = crypto.createHash(\"sha256\").update(fs.readFileSync(p.path)).digest(\"hex\");\n    37\t              if (got !== p.sha256) { console.error(`${p.path}: manifest ${p.sha256} != file ${got}`); bad++; }\n    38\t            }\n    39\t            const ver = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\")).version;\n    40\t            if (m.harness.version !== ver) { console.error(`harness version ${m.harness.version} != package ${ver}`); bad++; }\n    41\t            process.exit(bad ? 1 : 0);\n    42\t          '\n    43\t\n    44\t  image:\n    45\t    if: github.ref == 'refs/heads/main'\n    46\t    needs: [test, manifest-check]\n    47\t    runs-on: ubuntu-24.04\n    48\t    permissions:\n    49\t      contents: read\n    50\t      id-token: write\n    51\t      attestations: write\n    52\t      packages: write\n    53\t    steps:\n    54\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    55\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    56\t        with:\n    57\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-image-build\n    58\t          aws-region: us-west-2\n    59\t      - uses: aws-actions/amazon-ecr-login@062b18b96a7aff071d4dc91bc00c4c1a7945b076 # v2.0.1\n    60\t        id: ecr\n    61\t      - uses: docker/setup-buildx-action@e468171a9de216ec08956ac3ada2f0791b6bd435 # v3.11.1\n    62\t      - uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    63\t        id: build\n    64\t        with:\n    65\t          push: true\n    66\t          tags: ${{ steps.ecr.outputs.registry }}/clinic-agent:${{ github.sha }}\n    67\t          provenance: mode=max\n    68\t          sbom: true\n    69\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    70\t        with:\n    71\t          cosign-release: v2.6.2\n    72\t      - name: Sign image\n    73\t        run: cosign sign --yes ${{ steps.ecr.outputs.registry }}/clinic-agent@${{ steps.build.outputs.digest }}\n    74\t      - uses: actions/attest-build-provenance@977bb373ede98d70efdf65b84cb5f73e068dcc2a # v3.0.0\n    75\t        with:\n    76\t          subject-name: ${{ steps.ecr.outputs.registry }}/clinic-agent\n    77\t          subject-digest: ${{ steps.build.outputs.digest }}\n    78\t          push-to-registry: true\napiVersion: v1\nkind: Namespace\nmetadata:\n  name: clinic-agent\n  labels:\n    pod-security.kubernetes.io/enforce: restricted\n    pod-security.kubernetes.io/enforce-version: v1.33\n    pod-security.kubernetes.io/audit: restricted\n    pod-security.kubernetes.io/warn: restricted\n---\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: clinic-agent\n  namespace: clinic-agent\n  annotations:\n    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    eks.amazonaws.com/token-expiration: \"3600\"\nautomountServiceAccountToken: false\n---\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: clinic-agent-reminders\n  namespace: clinic-agent\n  annotations:\n    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\nautomountServiceAccountToken: false\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: clinic-agent\n  namespace: clinic-agent\ndata:\n  CLINIC_DIRECTORY: |\n    [{\"id\":\"nb-castro\",\"name\":\"Northbay Castro\",\"smsNumber\":\"+14155550110\"},\n     {\"id\":\"nb-fremont\",\"name\":\"Northbay Fremont\",\"smsNumber\":\"+15105550111\"},\n     {\"id\":\"nb-oakland\",\"name\":\"Northbay Oakland\",\"smsNumber\":\"+15105550112\"},\n     {\"id\":\"nb-sanmateo\",\"name\":\"Northbay San Mateo\",\"smsNumber\":\"+16505550113\"},\n     {\"id\":\"nb-walnutcreek\",\"name\":\"Northbay Walnut Creek\",\"smsNumber\":\"+19255550114\"}]\n  SMS_SIGNING_SECRET_ARN: arn:aws:secretsmanager:us-west-2:418295730611:secret:clinic-agent/sms-signing\n  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: clinic-agent\n  namespace: clinic-agent\n  labels: { app: clinic-agent }\nspec:\n  replicas: 3\n  selector:\n    matchLabels: { app: clinic-agent }\n  template:\n    metadata:\n      labels: { app: clinic-agent }\n    spec:\n      serviceAccountName: clinic-agent\n      automountServiceAccountToken: false\n      hostUsers: false\n      hostNetwork: false\n      hostPID: false\n      hostIPC: false\n      enableServiceLinks: false\n  schedule: \"0 17 * * *\"\n  timeZone: America/Los_Angeles\n  concurrencyPolicy: Forbid\n  jobTemplate:\n    spec:\n      backoffLimit: 0\n      activeDeadlineSeconds: 1800\n      template:\n        metadata:\n          labels: { app: clinic-agent-reminders }\n        spec:\n          serviceAccountName: clinic-agent-reminders\n          automountServiceAccountToken: false\n          restartPolicy: Never\n          hostUsers: false\n          securityContext:\n            runAsNonRoot: true\n            runAsUser: 65532\n            runAsGroup: 65532\n            seccompProfile:\n              type: RuntimeDefault\n          containers:\n            - name: reminders\n              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n              args: [\"dist/workers/reminders.js\"]\n              envFrom:\n                - configMapRef: { name: clinic-agent }\n              env:\n                - name: IMAGE_DIGEST\n                  value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n                - name: GIT_SHA\n                  value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n              securityContext:\n                allowPrivilegeEscalation: false\n                privileged: false\n                readOnlyRootFilesystem: true\n                capabilities:\n                  drop: [\"ALL\"]\n---\n# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,\n    20\tconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n    21\t// Arguments the harness consumes itself; they are never forwarded to a tool.\n    22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n    23\t\n    24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n    25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n    26\t}\n    27\t\n    28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n    29\t  return `${tool}(${Object.entries(args)\n    30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    31\t    .join(\", \")})`.slice(0, 500);\n    32\t}\n    33\t\n    34\texport async function executeTool(\n    35\t  registry: ToolRegistry,\n    36\t  ctx: RunContext,\n    37\t  call: Anthropic.ToolUseBlock,\n    38\t  d: Decision,\n    39\t): Promise<Anthropic.ToolResultBlockParam> {\n    40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n    41\t  const base = {\n    42\t    ...ctx.identity(),\n    43\t    runId: ctx.runId,\n    44\t    subject: ctx.subject,\n    45\t    tool: call.name,\n    46\t    toolUseId: call.id,\n    47\t    policyVersion: policy.version,\n    48\t    context: d.contextSize,\n    49\t  };\n    50\t  const deny = async (reason: string) => {\n    51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n    52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n    53\t  };\n    54\t\n    55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n    56\t  const tool = registry.get(call.name);\n    57\t  if (!tool) return deny(\"not_registered\");\n    58\t\n    59\t  await killSwitch.assertRunning(ctx.tenantId);\n    60\t  await d.budget.toolCall(call.name);\n    61\t\n    62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n    63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n    64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n    65\t\n    66\t  let approvalId: string | undefined;\n    67\t  if (policy.highImpactTools.includes(call.name)) {\n    68\t    if (typeof input.approvalId !== \"string\") {\n    69\t      const rec = await requestApproval({\n    70\t        tool: call.name,\n    71\t        tenantId: clinicId,\n    72\t        agentInstanceId: AGENT_INSTANCE_ID,\n    73\t        runId: ctx.runId,\n    74\t        args,\n    75\t        summary: summarize(call.name, args),\n    76\t      });\n    77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n    78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    79\t    }\n    80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    81\t    if (!check.ok) return deny(check.reason);\n    82\t    approvalId = check.approval.id;\n    83\t  }\n    84\t\n    85\t  try {\n    86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    88\t    const safe = redactPhi(raw);\n    89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    90\t    return toolResult(call.id, safe);\n    91\t  } catch (err) {\n    92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n    95\t  }\n    96\t}\n    97\t\n    98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n    99\t\n   100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {","is_error":false}]},"parent_tool_use_id":null,"session_id":"d7a6e11a-0cdc-487a-a909-76d22aa8270a","uuid":"de03abc0-1e69-476f-8c53-6e7f76c56e9f","timestamp":"2026-10-20T13:58:44.956Z","tool_use_result":{"stdout":"     1\timport Fastify from \"fastify\";\n     2\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     3\timport { env, manifest } from \"./config.js\";\n     4\timport { computeAgentTypeId, setAgentTypeId, AGENT_INSTANCE_ID } from \"./agent/identity.js\";\n     5\timport { killSwitch } from \"./control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"./integrations/ehr-mcp.js\";\n     7\timport { registerSmsWebhook } from \"./routes/sms-webhook.js\";\n     8\timport { registerWebchat } from \"./routes/webchat.js\";\n     9\timport { nativeTools } from \"./tools/executor.js\";\n    10\timport { ToolRegistry, type ConfiguredServer } from \"./tools/registry.js\";\n    11\t\n    12\tconst metrics = {\n    13\t  increment(name: string) {\n    14\t    process.stdout.write(JSON.stringify({ _aws: { CloudWatchMetrics: [{ Namespace: \"clinic-agent\", Metrics: [{ Name: name }] }] }, [name]: 1 }) + \"\\n\");\n    15\t  },\n    16\t};\n    17\t\n    18\tconst app = Fastify({\n    19\t  logger: {\n    20\t    level: process.env.LOG_LEVEL ?? \"info\",\n    21\t    redact: { paths: [\"req.headers.authorization\", 'req.headers[\"x-sms-signature\"]', \"req.headers.cookie\"], censor: \"[redacted]\" },\n    22\t  },\n    23\t  bodyLimit: 16_384,\n    24\t});\n    25\t\n    26\t// Identity check against the approved release manifest.\n    27\tconst typeId = computeAgentTypeId({\n    28\t  imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    29\t  harnessVersion: manifest.harness.version,\n    30\t  harnessGitSha: process.env.GIT_SHA ?? \"\",\n    31\t});\n    32\tif (typeId !== manifest.agentTypeId) {\n    33\t  app.log.error({ expected: manifest.agentTypeId, actual: typeId }, \"agent type id does not match release manifest\");\n    34\t  metrics.increment(\"identity.mismatch\");\n    35\t}\n    36\tsetAgentTypeId(typeId);\n    37\tapp.log.info({ agentTypeId: typeId, agentInstanceId: AGENT_INSTANCE_ID, release: manifest.release }, \"starting\");\n    38\t\n    39\t// Tools.\n    40\tconst servers: ConfiguredServer[] = manifest.tools.mcpServers;\n    41\tconst ehrServer = servers.find((s) => s.id === \"ehr\");\n    42\tif (!ehrServer) throw new Error(\"release manifest has no ehr server\");\n    43\tconst ehr = ehrClient(ehrServer);\n    44\t\n    45\tconst registry = new ToolRegistry(servers);\n    46\tfor (const [serverId, tools] of Object.entries(nativeTools(ehr))) registry.registerNative(serverId, tools);\n    47\ttry {\n    48\t  const { reportedName, meta } = await ehr.catalog();\n    49\t  registry.registerMcp(\"ehr\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\n    50\t} catch (err) {\n    51\t  app.log.error({ err }, \"EHR MCP catalog unavailable; EHR tools disabled\");\n    52\t}\n    53\tfor (const r of registry.rejected) app.log.warn(r, \"tool rejected at load\");\n    54\tfor (const c of registry.conflicts) app.log.warn(c, \"tool name conflict\");\n    55\t\n    56\t// Clinics.\n    57\tconst directory: Array<{ id: string; name: string; smsNumber: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    58\tconst byId = new Map(directory.map((c) => [c.id, c]));\n    59\tconst byNumber = new Map(directory.map((c) => [c.smsNumber, c]));\n    60\t\n    61\tconst sm = new SecretsManagerClient({ region: env.region });\n    62\tlet signingSecret: { value: string; at: number } | undefined;\n    63\tasync function smsSigningSecret(): Promise<string> {\n    64\t  if (signingSecret && Date.now() - signingSecret.at < 5 * 60_000) return signingSecret.value;\n    65\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: env.smsSigningSecretArn }));\n    66\t  signingSecret = { value: s.SecretString ?? \"\", at: Date.now() };\n    67\t  return signingSecret.value;\n    68\t}\n    69\t\n    70\tapp.addContentTypeParser(\"application/json\", { parseAs: \"string\" }, (req, body, done) => {\n    71\t  (req as { rawBody?: string }).rawBody = body as string;\n    72\t  try {\n    73\t    done(null, JSON.parse(body as string));\n    74\t  } catch (err) {\n    75\t    done(err as Error, undefined);\n    76\t  }\n    77\t});\n    78\t\n    79\tregisterSmsWebhook(app, {\n    80\t  registry,\n    81\t  signingSecret: smsSigningSecret,\n    82\t  clinicByNumber: (to) => byNumber.get(to),\n    83\t  metrics,\n    84\t});\n    85\tregisterWebchat(app, { registry, clinicById: (id) => byId.get(id) });\n    86\t\n    87\tapp.get(\"/healthz\", async () => ({ ok: true }));\n    88\t\n    89\tkillSwitch.startWatcher();\n    90\tawait app.listen({ host: \"0.0.0.0\", port: 8080 });\n     1\timport pino from \"pino\";\n     2\timport { manifest } from \"../config.js\";\n     3\timport { audit } from \"../audit/recorder.js\";\n     4\timport { computeAgentTypeId, newRunContext, setAgentTypeId } from \"../agent/identity.js\";\n     5\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"../integrations/ehr-mcp.js\";\n     7\timport { render, sms } from \"../integrations/sms.js\";\n     8\t\n     9\t// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.\n    10\tconst log = pino({ level: \"info\" });\n    11\t\n    12\tconst directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    13\tsetAgentTypeId(\n    14\t  computeAgentTypeId({\n    15\t    imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    16\t    harnessVersion: manifest.harness.version,\n    17\t    harnessGitSha: process.env.GIT_SHA ?? \"\",\n    18\t  }),\n    19\t);\n    20\t\n    21\tconst ehr = ehrClient(manifest.tools.mcpServers.find((s: { id: string }) => s.id === \"ehr\"));\n    22\tconst tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);\n    23\t\n    24\tfor (const clinic of directory) {\n    25\t  const ctx = newRunContext({ tenantId: clinic.id, subject: { kind: \"system\", id: \"reminders-cron\" }, channel: \"reminder\", log });\n    26\t  const abort = new AbortController();\n    27\t  const unregister = killSwitch.register(ctx.runId, clinic.id, abort);\n    28\t  try {\n    29\t    await killSwitch.assertRunning(clinic.id);\n    30\t    const appts = await ehr.appointmentsOn(clinic.id, tomorrow, abort.signal);\n    31\t    for (const a of appts) {\n    32\t      if (!a.smsOptIn) continue;\n    33\t      await killSwitch.assertRunning(clinic.id);\n    34\t      const when = new Date(a.start).toLocaleString(\"en-US\", { weekday: \"short\", hour: \"numeric\", minute: \"2-digit\" });\n    35\t      const res = await sms.send(clinic.id, a.phone, render(\"reminder\", { firstName: \"\", when, location: a.locationName }), abort.signal);\n    36\t      await audit.record({\n    37\t        ...ctx.identity(),\n    38\t        runId: ctx.runId,\n    39\t        subject: ctx.subject,\n    40\t        event: \"reminder.sent\",\n    41\t        tool: \"sms__send_to_patient\",\n    42\t        // Scheduled, templated send: no model decided this action.\n    43\t        context: { tokens: null, status: \"unavailable\", method: \"no_model_decision\", cachedInputTokens: null, compacted: false },\n    44\t        detail: { appointmentId: a.id, messageId: res.messageId },\n    45\t      });\n    46\t    }\n    47\t  } catch (err) {\n    48\t    if (err instanceof Halted) {\n    49\t      log.warn({ clinic: clinic.id, scope: err.scope }, \"reminders halted\");\n    50\t      break;\n    51\t    }\n    52\t    log.error({ clinic: clinic.id, err: (err as Error).message }, \"reminder run failed\");\n    53\t    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \"run.stopped\", reason: (err as Error).message.slice(0, 200) });\n    54\t  } finally {\n    55\t    unregister();\n    56\t  }\n    57\t}\n    58\tprocess.exit(0);\n     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    16\t      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5.0.0\n    17\t        with:\n    18\t          node-version: \"22.11\"\n    19\t          cache: npm\n    20\t      - run: npm ci --ignore-scripts\n    21\t      - run: npm run lint\n    22\t      - run: npm test\n    23\t      - run: npm run build\n    24\t\n    25\t  manifest-check:\n    26\t    runs-on: ubuntu-24.04\n    27\t    steps:\n    28\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    29\t      - name: Prompt digests match the release manifest\n    30\t        run: |\n    31\t          node -e '\n    32\t            const fs = require(\"fs\"), crypto = require(\"crypto\");\n    33\t            const m = JSON.parse(fs.readFileSync(\"release/manifest.json\", \"utf8\"));\n    34\t            let bad = 0;\n    35\t            for (const p of m.prompts) {\n    36\t              const got = crypto.createHash(\"sha256\").update(fs.readFileSync(p.path)).digest(\"hex\");\n    37\t              if (got !== p.sha256) { console.error(`${p.path}: manifest ${p.sha256} != file ${got}`); bad++; }\n    38\t            }\n    39\t            const ver = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\")).version;\n    40\t            if (m.harness.version !== ver) { console.error(`harness version ${m.harness.version} != package ${ver}`); bad++; }\n    41\t            process.exit(bad ? 1 : 0);\n    42\t          '\n    43\t\n    44\t  image:\n    45\t    if: github.ref == 'refs/heads/main'\n    46\t    needs: [test, manifest-check]\n    47\t    runs-on: ubuntu-24.04\n    48\t    permissions:\n    49\t      contents: read\n    50\t      id-token: write\n    51\t      attestations: write\n    52\t      packages: write\n    53\t    steps:\n    54\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    55\t      - us