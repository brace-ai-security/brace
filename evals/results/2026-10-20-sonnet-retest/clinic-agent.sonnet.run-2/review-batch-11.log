t });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n...\n</persisted-output>","is_error":false}]},"parent_tool_use_id":null,"session_id":"be07f175-8066-4c39-92f7-e712df5d0616","uuid":"013a595d-3a72-424f-8f92-e55fb705d1b2","timestamp":"2026-10-20T14:14:34.571Z","tool_use_result":{"stdout":"     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { allowlist, policy } from \"../config.js\";\n     3\timport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\n     4\timport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\n     5\timport type { ContextSize } from \"../agent/context-size.js\";\n     6\timport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\n     7\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     8\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     9\timport { payments } from \"../integrations/payments.js\";\n    10\timport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\n    11\timport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\n    12\timport { checkApproval, requestApproval } from \"./approvals.js\";\n    13\timport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n    14\t\n    15\texport interface Decision {\n    16\t  contextSize: ContextSize;\n    17\t  budget: RunBudget;\n    18\t}\n    19\t\n    20\tconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n    21\t// Arguments the harness consumes itself; they are never forwarded to a tool.\n    22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n    23\t\n    24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n    25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n    26\t}\n    27\t\n    28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n    29\t  return `${tool}(${Object.entries(args)\n    30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    31\t    .join(\", \")})`.slice(0, 500);\n    32\t}\n    33\t\n    34\texport async function executeTool(\n    35\t  registry: ToolRegistry,\n    36\t  ctx: RunContext,\n    37\t  call: Anthropic.ToolUseBlock,\n    38\t  d: Decision,\n    39\t): Promise<Anthropic.ToolResultBlockParam> {\n    40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n    41\t  const base = {\n    42\t    ...ctx.identity(),\n    43\t    runId: ctx.runId,\n    44\t    subject: ctx.subject,\n    45\t    tool: call.name,\n    46\t    toolUseId: call.id,\n    47\t    policyVersion: policy.version,\n    48\t    context: d.contextSize,\n    49\t  };\n    50\t  const deny = async (reason: string) => {\n    51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n    52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n    53\t  };\n    54\t\n    55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n    56\t  const tool = registry.get(call.name);\n    57\t  if (!tool) return deny(\"not_registered\");\n    58\t\n    59\t  await killSwitch.assertRunning(ctx.tenantId);\n    60\t  await d.budget.toolCall(call.name);\n    61\t\n    62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n    63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n    64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n    65\t\n    66\t  let approvalId: string | undefined;\n    67\t  if (policy.highImpactTools.includes(call.name)) {\n    68\t    if (typeof input.approvalId !== \"string\") {\n    69\t      const rec = await requestApproval({\n    70\t        tool: call.name,\n    71\t        tenantId: clinicId,\n    72\t        agentInstanceId: AGENT_INSTANCE_ID,\n    73\t        runId: ctx.runId,\n    74\t        args,\n    75\t        summary: summarize(call.name, args),\n    76\t      });\n    77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n    78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    79\t    }\n    80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    81\t    if (!check.ok) return deny(check.reason);\n    82\t    approvalId = check.approval.id;\n    83\t  }\n    84\t\n    85\t  try {\n    86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    88\t    const safe = redactPhi(raw);\n    89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    90\t    return toolResult(call.id, safe);\n    91\t  } catch (err) {\n    92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n    95\t  }\n    96\t}\n    97\t\n    98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n    99\t\n   100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n   101\t  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n   102\t    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n   103\t\n   104\t  return {\n   105\t    payments: [\n   106\t      {\n   107\t        name: \"refund_deposit\",\n   108\t        definition: {\n   109\t          name: \"payments__refund_deposit\",\n   110\t          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n   111\t          input_schema: {\n   112\t            type: \"object\",\n   113\t            properties: {\n   114\t              depositId: { type: \"string\" },\n   115\t              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n   116\t              approvalId: { type: \"string\" },\n   117\t            },\n   118\t            required: [\"depositId\", \"reason\"],\n   119\t          },\n   120\t        },\n   121\t        invoke: async (a, o) =>\n   122\t          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n   123\t      },\n   124\t    ],\n   125\t    sms: [\n   126\t      {\n   127\t        name: \"send_to_patient\",\n   128\t        definition: {\n   129\t          name: \"sms__send_to_patient\",\n   130\t          description: \"Send a templated SMS to the phone number on the patient's record.\",\n   131\t          input_schema: {\n   132\t            type: \"object\",\n   133\t            properties: {\n   134\t              patientId: { type: \"string\" },\n   135\t              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n   136\t              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n   137\t            },\n   138\t            required: [\"patientId\", \"template\"],\n   139\t          },\n   140\t        },\n   141\t        invoke: async (a, o) => {\n   142\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   143\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   144\t          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n   145\t          return sms.send(o.clinicId, c.phone, body, o.signal);\n   146\t        },\n   147\t      },\n   148\t      {\n   149\t        name: \"send_freeform\",\n   150\t        definition: {\n   151\t          name: \"sms__send_freeform\",\n   152\t          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n   153\t          input_schema: {\n   154\t            type: \"object\",\n   155\t            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n   156\t            required: [\"patientId\", \"body\"],\n   157\t          },\n   158\t        },\n   159\t        invoke: async (a, o) => {\n   160\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   161\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   162\t          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n   163\t        },\n   164\t      },\n   165\t    ],\n   166\t    insurance: [\n   167\t      {\n   168\t        name: \"check_eligibility\",\n   169\t        definition: {\n   170\t          name: \"insurance__check_eligibility\",\n   171\t          description: \"Check whether the patient's insurance covers an appointment.\",\n   172\t          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n   173\t        },\n   174\t        invoke: async (a, o) =>\n   175\t          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n   176\t            clinicId: o.clinicId,\n   177\t            ctx: o.runCtx as RunContext,\n   178\t            signal: o.signal,\n   179\t            context: o.context,\n   180\t          }),\n   181\t      },\n   182\t    ],\n   183\t  };\n   184\t}\n     1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n     2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n     3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     4\timport { Agent } from \"undici\";\n     5\timport type { PeerCertificate } from \"node:tls\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n     8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n     9\t\n    10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n    11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n    12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n    13\t\n    14\tconst sm = new SecretsManagerClient({ region: env.region });\n    15\t\n    16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n    17\t  const expected = server.tlsCertSha256.toLowerCase();\n    18\t  return new Agent({\n    19\t    connect: {\n    20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n    21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n    22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n    23\t      },\n    24\t    },\n    25\t  });\n    26\t}\n    27\t\n    28\ttype Token = { value: string; exp: number };\n    29\tconst tokens = new Map<string, Token>();\n    30\t\n    31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n    32\t  const cacheKey = `${clinicId}|${scope}`;\n    33\t  const hit = tokens.get(cacheKey);\n    34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n    35\t\n    36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n    37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n    38\t  const res = await fetch(token_url, {\n    39\t    method: \"POST\",\n    40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n    42\t  });\n    43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n    44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n    45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n    46\t  return body.access_token;\n    47\t}\n    48\t\n    49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n    50\tconst sessions = new Map<string, Client>();\n    51\t\n    52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n    53\t  const existing = sessions.get(clinicId);\n    54\t  if (existing) return existing;\n    55\t  const token = await ehrToken(clinicId, SCOPES);\n    56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    57\t    requestInit: {\n    58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n    59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n    60\t      dispatcher: pinnedDispatcher(server),\n    61\t    },\n    62\t  });\n    63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n    64\t  await client.connect(transport);\n    65\t  sessions.set(clinicId, client);\n    66\t  setTimeout(() => {\n    67\t    sessions.delete(clinicId);\n    68\t    void client.close();\n    69\t  }, 4 * 60_000).unref();\n    70\t  return client;\n    71\t}\n    72\t\n    73\texport function ehr(server: ConfiguredServer) {\n    74\t  return {\n    75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n    76\t      const c = await session(server, \"_catalog\");\n    77\t      const [tools, prompts, templates] = await Promise.all([\n    78\t        c.listTools(),\n    79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n    80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n    81\t      ]);\n    82\t      return {\n    83\t        reportedName: c.getServerVersion()?.name,\n    84\t        meta: {\n    85\t          instructions: c.getInstructions(),\n    86\t          tools: tools.tools as ServerMeta[\"tools\"],\n    87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n    88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n    89\t        },\n    90\t      };\n    91\t    },\n    92\t\n    93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n    94\t      const c = await session(server, opts.clinicId);\n    95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n    96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n    97\t      return res.structuredContent ?? res.content;\n    98\t    },\n    99\t\n   100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n   101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n   102\t        id: string;\n   103\t        patientId: string;\n   104\t        start: string;\n   105\t        serviceCode: string;\n   106\t        payerId?: string;\n   107\t        depositId?: string;\n   108\t        status: string;\n   109\t      };\n   110\t    },\n   111\t\n   112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n   113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n   114\t        id: string;\n   115\t        patientId: string;\n   116\t        start: string;\n   117\t        phone: string;\n   118\t        smsOptIn: boolean;\n   119\t        locationName: string;\n   120\t      }>;\n   121\t    },\n   122\t  };\n   123\t}\n   124\texport type Ehr = ReturnType<typeof ehr>;\n     1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n     7\t//\n     8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n     9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n    10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n    11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n    12\t//\n    13\t// Answers come back as a signed attestation (JWS) inside a data part.\n    14\t\n    15\tconst Eligibility = z\n    16\t  .object({\n    17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    18\t    planName: z.string().max(120).optional(),\n    19\t    copayCents: z.number().int().nonnegative().optional(),\n    20\t    depositWaived: z.boolean().default(false),\n    21\t    checkedAt: z.string().datetime(),\n    22\t  })\n    23\t  .strict();\n    24\texport type Eligibility = z.infer<typeof Eligibility>;\n    25\t\n    26\tconst Rpc = z.object({\n    27\t  jsonrpc: z.literal(\"2.0\"),\n    28\t  id: z.string(),\n    29\t  result: z.object({\n    30\t    kind: z.literal(\"message\"),\n    31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n    32\t  }),\n    33\t});\n    34\t\n    35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n    36\t  const res = await fetch(env.tokenExchangeUrl, {\n    37\t    method: \"POST\",\n    38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    39\t    body: new URLSearchParams({\n    40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    41\t      subject_token: workloadToken,\n    42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n    43\t      audience: \"eligibility-agent\",\n    44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n    45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    46\t    }),\n    47\t  });\n    48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n    49\t  return ((await res.json()) as { access_token: string }).access_token;\n    50\t}\n    51\t\n    52\texport async function checkEligibility(\n    53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n    54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n    55\t): Promise<Eligibility> {\n    56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n    57\t  const requestId = randomUUID();\n    58\t  const res = await fetch(env.eligibilityUrl, {\n    59\t    method: \"POST\",\n    60\t    signal: opts.signal,\n    61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    62\t    body: JSON.stringify({\n    63\t      jsonrpc: \"2.0\",\n    64\t      id: requestId,\n    65\t      method: \"message/send\",\n    66\t      params: {\n    67\t        message: {\n    68\t          role: \"user\",\n    69\t          messageId: requestId,\n    70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n    71\t        },\n    72\t      },\n    73\t    }),\n    74\t  });\n    75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n    76\t  const text = await res.text();\n    77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n    78\t  const rpc = Rpc.parse(JSON.parse(text));\n    79\t\n    80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n    81\t  const header = decodeProtectedHeader(attestation);\n    82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n    83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n    84\t  const { payload } = await jwtVerify(attestation, keys, {\n    85\t    issuer: env.eligibilityIssuer,\n    86\t    audience: \"clinic-agent\",\n    87\t    maxTokenAge: \"5m\",\n    88\t    algorithms: [\"ES256\"],\n    89\t  });\n    90\t  return Eligibility.parse(payload.eligibility);\n    91\t}\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n     5\t// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n     6\t// The provider enforces Idempotency-Key for 24 hours.\n     7\t\n     8\tconst sm = new SecretsManagerClient({ region: env.region });\n     9\tconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n    10\t\n    11\tasync function key(clinicId: string): Promise<string> {\n    12\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n    13\t  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n    14\t}\n    15\t\n    16\texport interface Refund {\n    17\t  id: string;\n    18\t  depositId: string;\n    19\t  amountCents: number;\n    20\t  status: \"pending\" | \"succeeded\" | \"failed\";\n    21\t}\n    22\t\n    23\texport const payments = {\n    24\t  async refundDeposit(\n    25\t    clinicId: string,\n    26\t    req: { depositId: string; reason: string; idempotencyKey: string },\n    27\t    signal?: AbortSignal,\n    28\t  ): Promise<Refund> {\n    29\t    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n    30\t      method: \"POST\",\n    31\t      signal,\n    32\t      headers: {\n    33\t        authorization: `Bearer ${await key(clinicId)}`,\n    34\t        \"content-type\": \"application/json\",\n    35\t        \"idempotency-key\": req.idempotencyKey,\n    36\t      },\n    37\t      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    38\t    });\n    39\t    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    40\t    return (await res.json()) as Refund;\n    41\t  },\n    42\t};\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n     5\t// can send; free-form text goes through sms__send_freeform, which needs approval.\n     6\t\n     7\tconst sm = new SecretsManagerClient({ region: env.region });\n     8\tconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n     9\t\n    10\texport const TEMPLATES = {\n    11\t  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n    12\t  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n    13\t  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n    14\t  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n    15\t} as const;\n    16\texport type TemplateId = keyof typeof TEMPLATES;\n    17\t\n    18\texport function render(id: TemplateId, vars: Record<string, string>): string {\n    19\t  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n    20\t}\n    21\t\n    22\tasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n    23\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n    24\t  const v = JSON.parse(s.SecretString ?? \"{}\");\n    25\t  return { token: v.api_token, from: v.from_number };\n    26\t}\n    27\t\n    28\texport const sms = {\n    29\t  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n    30\t    const c = await creds(clinicId);\n    31\t    const res = await fetch(`${BASE}/messages`, {\n    32\t      method: \"POST\",\n    33\t      signal,\n    34\t      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n    35\t      body: JSON.stringify({ from: c.from, to, body }),\n    36\t    });\n    37\t    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n    38\t    return (await res.json()) as { messageId: string };\n    39\t  },\n    40\t};\n     1\timport pino from \"pino\";\n     2\timport { manifest } from \"../config.js\";\n     3\timport { audit } from \"../audit/recorder.js\";\n     4\timport { computeAgentTypeId, newRunContext, setAgentTypeId } from \"../agent/identity.js\";\n     5\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"../integrations/ehr-mcp.js\";\n     7\timport { render, sms } from \"../integrations/sms.js\";\n     8\t\n     9\t// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.\n    10\tconst log = pino({ level: \"info\" });\n    11\t\n    12\tconst directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    13\tsetAgentTypeId(\n    14\t  computeAgentTypeId({\n    15\t    imageDiges","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-rbt3823l/be07f175-8066-4c39-92f7-e712df5d0616/tool-results/bjxlindfc.txt","persistedOutputSize":32299},"tool_result_meta":[{"id":"toolu_01UzRAGQB75TosRZ9s51Yozy","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDdQs1nBBJHwhyvuh4cw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ax12fHGD5pSwH1YSw1QQ2M","name":"Bash","input":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-rbt3823l/agent; cat README.md config/tools.allowlist.yaml config/budgets.yaml; cat -n infra/terraform/github.tf | sed -n 60,140p; cat src/config.ts src/control/kill-switch.ts; grep -rn -i \"alert\\|pager\\|incident\\|quarantine\\|responder\\|alarm\\|retention\\|integrity\\|sequence\\|digest\" --include=* . -l | grep -v brace-"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10285,"cache_read_input_tokens":25161,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10285},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"be07f175-8066-4c39-92f7-e712df5d0616","uuid":"672fe495-cc61-4763-a231-4db449ae8575","timestamp":"2026-10-20T14:14:35.961Z","request_id":"req_011CgDdQrciea1y3xH2dHxz7","wire_tool_inputs":{"toolu_01Ax12fHGD5pSwH1YSw1QQ2M":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-rbt3823l/agent; cat README.md config/tools.allowlist.yaml config/budgets.yaml; cat -n infra/terraform/github.tf | sed -n 60,140p; cat src/config.ts src/control/kill-switch.ts; grep -rn -i \"alert\\|pager\\|incident\\|quarantine\\|responder\\|alarm\\|retention\\|integrity\\|sequence\\|digest\" --include=* . -l | grep -v brace-"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ax12fHGD5pSwH1YSw1QQ2M","type":"tool_result","content":"# clinic-agent\n\nPatient-scheduling agent for the Northbay Clinic Group. Patients reach it by SMS or by the web chat\nwidget on each clinic's site. It looks up, books, reschedules, and cancels appointments in the EHR,\nsends SMS reminders, refunds no-show deposits, and asks the insurance-eligibility agent whether a\nvisit is covered.\n\nEach clinic is a tenant. A clinic's patients, appointments, deposits, and EHR credentials are kept\nseparate from every other clinic's.\n\n## Components\n\n| Piece | Where | Notes |\n|---|---|---|\n| HTTP service (Fastify) | `src/server.ts` | `/v1/sms/inbound` webhook, `/v1/chat` web chat |\n| Agent loop | `src/agent/loop.ts` | Claude Sonnet 4.5 snapshot, tool use |\n| Intent classifier | `src/agent/classifier.ts` | Claude Haiku 4.5 snapshot, routes emergencies and complaints to staff |\n| Tool registry | `src/tools/registry.ts` | EHR MCP server plus native tools, scanned on load |\n| Tool executor | `src/tools/executor.ts` | allowlist, kill switch, budgets, approvals, audit |\n| EHR | `src/integrations/ehr-mcp.ts` | MCP over streamable HTTP with mTLS, per-clinic OAuth client |\n| Payments | `src/integrations/payments.ts` | deposit refunds, provider idempotency keys |\n| SMS | `src/integrations/sms.ts` | outbound reminders and replies |\n| Eligibility peer | `src/integrations/eligibility-a2a.ts` | A2A `message/send`, token exchange per call |\n| Reminder job | `src/workers/reminders.ts` | Kubernetes CronJob, 17:00 local each day |\n\nThere is no vector store and no conversation memory. Every run starts from the patient's message and\nthe EHR. Conversation transcripts are not stored by this service.\n\n## High-impact actions\n\n`config/policy.yaml` lists the tools that need a staff approval before they run. The agent asks for\nthe approval, a front-desk lead or clinic manager approves it in the staff console, and the agent\nretries with the approval ID. Approvals expire after 15 minutes.\n\n## Stopping the agent\n\nOperators with the `clinic-agent-ops` role set `halted = true` on the `global` item (all clinics) or a\n`tenant#<clinicId>` item in the `clinic-agent-control` DynamoDB table:\n\n```bash\naws dynamodb put-item --table-name clinic-agent-control \\\n  --item '{\"pk\":{\"S\":\"global\"},\"halted\":{\"BOOL\":true},\"by\":{\"S\":\"<you>\"}}'\n```\n\nRunning work checks the flag before each model turn and each tool call, and a watcher aborts in-flight\nrequests within 2 seconds.\n\n## Identity\n\n`src/agent/identity.ts` computes the agent-type-id from the image digest, harness version, prompts,\nmodel IDs, and config. Each pod also gets a random agent-instance-id at start. Both are on every\naudit record together with the accountable party, operational owner, tenant, and trace context.\n\n## Build and test\n\n```bash\nnpm ci\nnpm run lint\nnpm test\nnpm run build\n```\n\n## Release\n\nMerges to `main` need two reviews and a code owner review for prompts, config, infra, and manifests.\n`deploy.yml` builds, signs, and deploys by digest to the `production` environment, which has required\nreviewers. Emergency deploys use the same workflow with `emergency: true` and must name an owner,\na reason, and an end date; the workflow opens a follow-up review issue.\n\n## Owners\n\n- Accountable party: Northbay Clinic Group, Patient Access (VP Patient Access)\n- Operational owner: agent-platform team, `#agent-platform-oncall`\n# Every tool the scheduling agent may call, with the task it serves.\n# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n# are not used for allow or approval decisions.\nrole: scheduling_agent\ntools:\n  - tool: ehr__find_patient\n    reason: Match the sender to a patient record by date of birth and phone or email.\n  - tool: ehr__search_slots\n    reason: List open slots for a provider, location, and visit type.\n  - tool: ehr__get_appointment\n    reason: Read one appointment the patient asks about.\n  - tool: ehr__list_patient_appointments\n    reason: Show the patient their upcoming appointments.\n  - tool: ehr__book_appointment\n    reason: Book a slot the patient chose.\n  - tool: ehr__update_appointment\n    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n  - tool: ehr__cancel_appointment\n    reason: Cancel an appointment at the patient's request.\n  - tool: payments__refund_deposit\n    reason: Refund a no-show deposit after staff review.\n  - tool: sms__send_to_patient\n    reason: Send a templated message to the phone number on the patient's record.\n  - tool: sms__send_freeform\n    reason: Send a staff-approved message that is not one of the templates.\n  - tool: insurance__check_eligibility\n    reason: Ask the eligibility agent whether a visit is covered.\n# Hard limits enforced by src/agent/budget.ts, outside the model.\nrun:\n  maxTurns: 8                 # model calls per run\n  maxWallMs: 45000            # whole run, including tool calls\n  maxInputTokens: 120000      # summed across model calls in the run\n  maxOutputTokens: 6000\n  maxCostUsd: 0.40\n  maxToolCalls: 16\n  maxToolCallsPerMinute: 12\n  maxPeerCalls: 2             # calls to the eligibility agent; this agent starts no sub-agents\n\nquotas:\n  # Daily spend and per-minute tool-call ceilings across many runs.\n  perSubjectDailyUsd: 2.00    # one patient or staff user\n  perTenantDailyUsd: 60.00    # one clinic\n  fleetDailyUsd: 900.00       # all clinics\n  perTenantToolCallsPerMinute: 240\n  fleetToolCallsPerMinute: 2400\n\npricingUsdPerMTok:\n  claude-sonnet-4-5-20250929: { input: 3.00, output: 15.00, cacheRead: 0.30, cacheWrite: 3.75 }\n  claude-haiku-4-5-20251001: { input: 1.00, output: 5.00, cacheRead: 0.10, cacheWrite: 1.25 }\n\n# When a limit is hit the run stops, the stop is audited with the limit name, and the\n# conversation is handed to the clinic's front-desk queue.\nonExceed: handoff_to_staff\n    60\t    custom_branch_policies = true\n    61\t  }\n    62\t}\n    63\t\n    64\tresource \"github_repository_environment_deployment_policy\" \"emergency_branches\" {\n    65\t  repository     = \"clinic-agent\"\n    66\t  environment    = github_repository_environment.production_emergency.environment\n    67\t  branch_pattern = \"hotfix/*\"\n    68\t}\n    69\t\n    70\tresource \"aws_iam_role\" \"deploy\" {\n    71\t  name = \"clinic-agent-deploy\"\n    72\t  assume_role_policy = jsonencode({\n    73\t    Version = \"2012-10-17\"\n    74\t    Statement = [{\n    75\t      Effect    = \"Allow\"\n    76\t      Principal = { Federated = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/token.actions.githubusercontent.com\" }\n    77\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n    78\t      Condition = {\n    79\t        StringEquals = {\n    80\t          \"token.actions.githubusercontent.com:aud\" = \"sts.amazonaws.com\"\n    81\t          \"token.actions.githubusercontent.com:sub\" = [\n    82\t            \"repo:northbay-clinics/clinic-agent:environment:production\",\n    83\t            \"repo:northbay-clinics/clinic-agent:environment:production-emergency\",\n    84\t          ]\n    85\t        }\n    86\t      }\n    87\t    }]\n    88\t  })\n    89\t}\n    90\t\n    91\tresource \"aws_iam_role_policy\" \"deploy\" {\n    92\t  name = \"clinic-agent-deploy\"\n    93\t  role = aws_iam_role.deploy.id\n    94\t  policy = jsonencode({\n    95\t    Version = \"2012-10-17\"\n    96\t    Statement = [\n    97\t      {\n    98\t        Effect   = \"Allow\"\n    99\t        Action   = [\"ecr:GetAuthorizationToken\"]\n   100\t        Resource = \"*\"\n   101\t      },\n   102\t      {\n   103\t        Effect   = \"Allow\"\n   104\t        Action   = [\"ecr:BatchCheckLayerAvailability\", \"ecr:PutImage\", \"ecr:InitiateLayerUpload\", \"ecr:UploadLayerPart\", \"ecr:CompleteLayerUpload\", \"ecr:BatchGetImage\"]\n   105\t        Resource = aws_ecr_repository.agent.arn\n   106\t      },\n   107\t      {\n   108\t        Effect   = \"Allow\"\n   109\t        Action   = [\"eks:DescribeCluster\"]\n   110\t        Resource = module.eks.cluster_arn\n   111\t      },\n   112\t    ]\n   113\t  })\n   114\t}\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { parse } from \"yaml\";\n\nexport const ROOT = process.env.CLINIC_AGENT_ROOT ?? process.cwd();\n\nexport interface Policy {\n  version: string;\n  highImpactTools: string[];\n  approval: { ttlSeconds: number; approverRoles: string[]; table: string };\n}\n\nexport interface AllowlistEntry {\n  tool: string;\n  reason: string;\n}\n\nexport interface Budgets {\n  run: {\n    maxTurns: number;\n    maxWallMs: number;\n    maxInputTokens: number;\n    maxOutputTokens: number;\n    maxCostUsd: number;\n    maxToolCalls: number;\n    maxToolCallsPerMinute: number;\n    maxPeerCalls: number;\n  };\n  quotas: {\n    perSubjectDailyUsd: number;\n    perTenantDailyUsd: number;\n    fleetDailyUsd: number;\n    perTenantToolCallsPerMinute: number;\n    fleetToolCallsPerMinute: number;\n  };\n  pricingUsdPerMTok: Record<string, { input: number; output: number; cacheRead: number; cacheWrite: number }>;\n  onExceed: \"handoff_to_staff\";\n}\n\nfunction loadYaml<T>(rel: string): T {\n  return parse(readFileSync(join(ROOT, rel), \"utf8\")) as T;\n}\n\nexport const policy = loadYaml<Policy>(\"config/policy.yaml\");\nexport const allowlist = loadYaml<{ role: string; tools: AllowlistEntry[] }>(\"config/tools.allowlist.yaml\");\nexport const budgets = loadYaml<Budgets>(\"config/budgets.yaml\");\nexport const manifest = JSON.parse(readFileSync(join(ROOT, \"release/manifest.json\"), \"utf8\"));\n\nexport const AGENT_MODEL = \"claude-sonnet-4-5-20250929\";\nexport const CLASSIFIER_MODEL = \"claude-haiku-4-5-20251001\";\n\nexport const env = {\n  region: process.env.AWS_REGION ?? \"us-west-2\",\n  controlTable: process.env.CONTROL_TABLE ?? \"clinic-agent-control\",\n  budgetTable: process.env.BUDGET_TABLE ?? \"clinic-agent-budgets\",\n  auditStream: process.env.AUDIT_STREAM ?? \"clinic-agent-audit\",\n  smsSigningSecretArn: process.env.SMS_SIGNING_SECRET_ARN ?? \"\",\n  chatJwksUrl: process.env.CHAT_JWKS_URL ?? \"https://auth.northbay-clinics.example/.well-known/jwks.json\",\n  chatIssuer: process.env.CHAT_ISSUER ?? \"https://auth.northbay-clinics.example/\",\n  eligibilityUrl: process.env.ELIGIBILITY_URL ?? \"https://eligibility.partners.northbay-clinics.example/a2a\",\n  eligibilityIssuer: process.env.ELIGIBILITY_ISSUER ?? \"https://eligibility.partners.northbay-clinics.example\",\n  tokenExchangeUrl: process.env.TOKEN_EXCHANGE_URL ?? \"https://sts.northbay-clinics.example/oauth2/token\",\n  accountableParty: \"northbay-clinic-group:patient-access\",\n  operationalOwner: \"team:agent-platform\",\n};\nimport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\nimport { DynamoDBDocumentClient, BatchGetCommand } from \"@aws-sdk/lib-dynamodb\";\nimport { env } from \"../config.js\";\n\n// Stop control. Operators write halted=true on \"global\" or \"tenant#<clinicId>\" in the control table.\n// The agent only reads this table; every model turn and every tool call checks it, and a watcher\n// aborts in-flight work for halted scopes.\nexport class Halted extends Error {\n  constructor(public scope: string) {\n    super(`agent halted (${scope})`);\n  }\n}\n\nconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\nconst POLL_MS = 2000;\n\ntype Active = { tenantId: string; abort: AbortController };\nconst active = new Map<string, Active>();\n\nlet lastRead = 0;\nlet halted = new Set<string>();\n\nasync function refresh(): Promise<void> {\n  const res = await ddb.send(\n    new BatchGetCommand({\n      RequestItems: {\n        [env.controlTable]: {\n          Keys: [{ pk: \"global\" }, ...[...new Set([...active.values()].map((a) => a.tenantId))].map((t) => ({ pk: `tenant#${t}` }))],\n          ConsistentRead: true,\n        },\n      },\n    }),\n  );\n  const next = new Set<string>();\n  for (const item of res.Responses?.[env.controlTable] ?? []) {\n    if (item.halted === true) next.add(String(item.pk));\n  }\n  halted = next;\n  lastRead = Date.now();\n}\n\nexport const killSwitch = {\n  register(runId: string, tenantId: string, abort: AbortController): () => void {\n    active.set(runId, { tenantId, abort });\n    return () => active.delete(runId);\n  },\n\n  async assertRunning(tenantId: string): Promise<void> {\n    if (Date.now() - lastRead > POLL_MS) {\n      try {\n        await refresh();\n      } catch {\n        // If the control table cannot be read, treat the agent as halted.\n        throw new Halted(\"control-unreadable\");\n      }\n    }\n    if (halted.has(\"global\")) throw new Halted(\"global\");\n    if (halted.has(`tenant#${tenantId}`)) throw new Halted(`tenant#${tenantId}`);\n  },\n\n  startWatcher(): NodeJS.Timeout {\n    return setInterval(async () => {\n      try {\n        await refresh();\n      } catch {\n        halted = new Set([\"global\"]);\n      }\n      for (const [runId, a] of active) {\n        if (halted.has(\"global\") || halted.has(`tenant#${a.tenantId}`)) {\n          a.abort.abort(new Halted(halted.has(\"global\") ? \"global\" : `tenant#${a.tenantId}`));\n          active.delete(runId);\n        }\n      }\n    }, POLL_MS);\n  },\n};\n(eval):1: no matches found: --include=*","is_error":false}]},"parent_tool_use_id":null,"session_id":"be07f175-8066-4c39-92f7-e712df5d0616","uuid":"c4108382-6f08-4074-bef0-6fd1f1008d82","timestamp":"2026-10-20T14:14:36.131Z","tool_use_result":{"stdout":"# clinic-agent\n\nPatient-scheduling agent for the Northbay Clinic Group. Patients reach it by SMS or by the web chat\nwidget on each clinic's site. It looks up, books, reschedules, and cancels appointments in the EHR,\nsends SMS reminders, refunds no-show deposits, and asks the insurance-eligibility agent whether a\nvisit is covered.\n\nEach clinic is a tenant. A clinic's patients, appointments, deposits, and EHR credentials are kept\nseparate from every other clinic's.\n\n## Components\n\n| Piece | Where | Notes |\n|---|---|---|\n| HTTP service (Fastify) | `src/server.ts` | `/v1/sms/inbound` webhook, `/v1/chat` web chat |\n| Agent loop | `src/agent/loop.ts` | Claude Sonnet 4.5 snapshot, tool use |\n| Intent classifier | `src/agent/classifier.ts` | Claude Haiku 4.5 snapshot, routes emergencies and complaints to staff |\n| Tool registry | `src/tools/registry.ts` | EHR MCP server plus native tools, scanned on load |\n| Tool executor | `src/tools/executor.ts` | allowlist, kill switch, budgets, approvals, audit |\n| EHR | `src/integrations/ehr-mcp.ts` | MCP over streamable HTTP with mTLS, per-clinic OAuth client |\n| Payments | `src/integrations/payments.ts` | deposit refunds, provider idempotency keys |\n| SMS | `src/integrations/sms.ts` | outbound reminders and replies |\n| Eligibility peer | `src/integrations/eligibility-a2a.ts` | A2A `message/send`, token exchange per call |\n| Reminder job | `src/workers/reminders.ts` | Kubernetes CronJob, 17:00 local each day |\n\nThere is no vector store and no conversation memory. Every run starts from the patient's message and\nthe EHR. Conversation transcripts are not stored by this service.\n\n## High-impact actions\n\n`config/policy.yaml` lists the tools that need a staff approval before they run. The agent asks for\nthe approval, a front-desk lead or clinic manager approves it in the staff console, and the agent\nretries with the approval ID. Approvals expire after 15 minutes.\n\n## Stopping the agent\n\nOperators with the `clinic-agent-ops` role set `halted = true` on the `global` item (all clinics) or a\n`tenant#<clinicId>` item in the `clinic-agent-control` DynamoDB table:\n\n```bash\naws dynamodb put-item --table-name clinic-agent-control \\\n  --item '{\"pk\":{\"S\":\"global\"},\"halted\":{\"BOOL\":true},\"by\":{\"S\":\"<you>\"}}'\n```\n\nRunning work checks the flag before each model turn and each tool call, and a watcher aborts in-flight\nrequests within 2 seconds.\n\n## Identity\n\n`src/agent/identity.ts` computes the agent-type-id from the image digest, harness version, prompts,\nmodel IDs, and config. Each pod also gets a random agent-instance-id at start. Both are on every\naudit record together with the accountable party, operational owner, tenant, and trace context.\n\n## Build and test\n\n```bash\nnpm ci\nnpm run lint\nnpm test\nnpm run build\n```\n\n## Release\n\nMerges to `main` need two reviews and a code owner review for prompts, config, infra, and manifests.\n`deploy.yml` builds, signs, and deploys by digest to the `production` environment, which has required\nreviewers. Emergency deploys use the same workflow with `emergency: true` and must name an owner,\na reason, and an end date; the workflow opens a follow-up review issue.\n\n## Owners\n\n- Accountable party: Northbay Clinic Group, Patient Access (VP Patient Access)\n- Operational owner: agent-platform team, `#agent-platform-oncall`\n# Every tool the scheduling agent may call, with the task it serves.\n# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n# are not used for allow or approval decisions.\nrole: scheduling_agent\ntools:\n  - tool: ehr__find_patient\n    reason: Match the sender to a patient record by date of birth and phone or email.\n  - tool: ehr__search_slots\n    reason: List open slots for a provider, location, and visit type.\n  - tool: ehr__get_appointment\n    reason: Read one appointment the patient asks about.\n  - tool: ehr__list_patient_appointments\n    reason: Show the patient their upcoming appointments.\n  - tool: ehr__book_appointment\n    reason: Book a slot the patient chose.\n  - tool: ehr__update_appointment\n    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n  - tool: ehr__cancel_appointment\n    reason: Cancel an appointment at the patient's request.\n  - tool: payments__refund_deposit\n    reason: Refund a no-show deposit after staff review.\n  - tool: sms__send_to_patient\n    reason: Send a templated message to the phone number on the patient's record.\n  - tool: sms__send_freeform\n    reason: Send a staff-approved message that is not one of the templates.\n  - tool: insurance__check_eligibility\n    reason: Ask the eligibility agent whether a visit is covered.\n# Hard limits enforced by src/agent/budget.ts, outside the model.\nrun:\n  maxTurns: 8                 # model calls per run\n  maxWallMs: 45000            # whole run, including tool calls\n  maxInputTokens: 120000      # summed across model calls in the run\n  maxOutputTokens: 6000\n  maxCostUsd: 0.40\n  maxToolCalls: 16\n  maxToolCallsPerMinute: 12\n  maxPeerCalls: 2             # calls to the eligibility agent; this agent starts no sub-agents\n\nquotas:\n  # Daily spend and per-minute tool-call ceilings across many runs.\n  perSubjectDailyUsd: 2.00    # one patient or staff user\n  perTenantDailyUsd: 60.00    # one clinic\n  fleetDailyUsd: 900.00       # all clinics\n  perTenantToolCallsPerMinute: 240\n  fleetToolCallsPerMinute: 2400\n\npricingUsdPerMTok:\n  claude-sonnet-4-5-20250929: { input: 3.00, output: 15.00, cacheRead: 0.30, cacheWrite: 3.75 }\n  claude-haiku-4-5-20251001: { input: 1.00, output: 5.00, cacheRead: 0.10, cacheWrite: 1.25 }\n\n# When a limit is hit the run stops, the stop is audited with the limit name, and the\n# conversation is handed to the clinic's front-desk queue.\nonExceed: handoff_to_staff\n    60\t    custom_branch_policies = true\n    61\t  }\n    62\t}\n    63\t\n    64\tresource \"github_repository_environment_deployment_policy\" \"emergency_branches\" {\n    65\t  repository     = \"clinic-agent\"\n    66\t  environment    = github_repository_environment.production_emergency.environment\n    67\t  branch_pattern = \"hotfix/*\"\n    68\t}\n    69\t\n    70\tresource \"aws_iam_role\" \"deploy\" {\n    71\t  name = \"clinic-agent-deploy\"\n    72\t  assume_role_policy = jsonencode({\n    73\t    Version = \"2012-10-17\"\n    74\t    Statement = [{\n    75\t      Effect    = \"Allow\"\n    76\t      Principal = { Federated = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/token.actions.githubusercontent.com\" }\n    77\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n    78\t      Condition = {\n    79\t        StringEquals = {\n    80\t          \"token.actions.githubusercontent.com:aud\" = \"sts.amazonaws.com\"\n    81\t          \"token.actions.githubusercontent.com:sub\" = [\n    82\t            \"repo:northbay-clinics/clinic-agent:environment:production\",\n    83\t            \"repo:northbay-clinics/clinic-agent:environment:production-emergency\",\n    84\t          ]\n    85\t        }\n    86\t      }\n    87\t    }]\n    88\t  })\n    89\t}\n    90\t\n    91\tresource \"aws_iam_role_policy\" \"deploy\" {\n    92\t  name = \"clinic-agent-deploy\"\n    93\t  role = aws_iam_role.deploy.id\n    94\t  policy = jsonencode({\n    95\t    Version = \"2012-10-17\"\n    96\t    Statement = [\n    97\t      {\n    98\t        Effect   = \"Allow\"\n    99\t        Action   = [\"ecr:GetAuthorizationToken\"]\n   100\t        Resource = \"*\"\n   101\t      },\n   102\t      {\n   103\t        Effect   = \"Allow\"\n   104\t        Action   = [\"ecr:BatchCheckLayerAvailability\", \"ecr:PutImage\", \"ecr:InitiateLayerUpload\", \"ecr:UploadLayerPart\", \"ecr:CompleteLayerUpload\", \"ecr:BatchGetImage\"]\n   105\t        Resource = aws_ecr_repository.agent.arn\n   106\t      },\n   107\t      {\n   108\t        Effect   = \"Allow\"\n   109\t        Action   = [\"eks:DescribeCluster\"]\n   110\t        Resource = module.eks.cluster_arn\n   111\t      },\n   112\t    ]\n   113\t  })\n   114\t}\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { parse } from \"yaml\";\n\nexport const ROOT = process.env.CLINIC_AGENT_ROOT ?? process.cwd();\n\nexport interface Policy {\n  version: string;\n  highImpactTools: string[];\n  approval: { ttlSeconds: number; approverRoles: string[]; table: string };\n}\n\nexport interface AllowlistEntry {\n  tool: string;\n  reason: string;\n}\n\nexport interface Budgets {\n  run: {\n    maxTurns: number;\n    maxWallMs: number;\n    maxInputTokens: number;\n    maxOutputTokens: number;\n    maxCostUsd: number;\n    maxToolCalls: number;\n    maxToolCallsPerMinute: number;\n    maxPeerCalls: number;\n  };\n  quotas: {\n    perSubjectDailyUsd: number;\n    perTenantDailyUsd: number;\n    fleetDailyUsd: number;\n    perTenantToolCallsPerMinute: number;\n    fleetToolCallsPerMinute: number;\n  };\n  pricingUsdPerMTok: Record<string, { input: number; output: number; cacheRead: number; cacheWrite: number }>;\n  onExceed: \"handoff_to_staff\";\n}\n\nfunction loadYaml<T>(rel: string): T {\n  return parse(readFileSync(join(ROOT, rel), \"utf8\")) as T;\n}\n\nexport const policy = loadYaml<Policy>(\"config/policy.yaml\");\nexport const allowlist = loadYaml<{ role: string; tools: AllowlistEntry[] }>(\"config/tools.allowlist.yaml\");\nexport const budgets = loadYaml<Budgets>(\"config/budgets.yaml\");\nexport const manifest = JSON.parse(readFileSync(join(ROOT, \"release/manifest.json\"), \"utf8\"));\n\nexport const AGENT_MODEL = \"claude-sonnet-4-5-20250929\";\nexport const CLASSIFIER_MODEL = \"claude-haiku-4-5-20251001\";\n\nexport const env = {\n  region: process.env.AWS_REGION ?? \"us-west-2\",\n  controlTable: process.env.CONTROL_TABLE ?? \"clinic-agent-control\",\n  budgetTable: process.env.BUDGET_TABLE ?? \"clinic-agent-budgets\",\n  auditStream: process.env.AUDIT_STREAM ?? \"clinic-agent-audit\",\n  smsSigningSecretArn: process.env.SMS_SIGNING_SECRET_ARN ?? \"\",\n  chatJwksUrl: process.env.CHAT_JWKS_URL ?? \"https://auth.northbay-clinics.example/.well-known/jwks.json\",\n  chatIssuer: process.env.CHAT_ISSUER ?? \"https://auth.northbay-clinics.example/\",\n  eligibilityUrl: process.env.ELIGIBILITY_URL ?? \"https://eligibility.partners.northbay-clinics.example/a2a\",\n  eligibilityIssuer: process.env.ELIGIBILITY_ISSUER ?? \"https://eligibility.partners.northbay-clinics.example\",\n  tokenExchangeUrl: process.env.TOKEN_EXCHANGE_URL ?? \"https://sts.northbay-clinics.example/oauth2/token\",\n  accountableParty: \"northbay-clinic-group:patient-access\",\n  operationalOwner: \"team:agent-platform\",\n};\nimport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\nimport { DynamoDBDocumentClient, BatchGetCommand } from \"@aws-sdk/lib-dynamodb\";\nimport { env } from \"../config.js\";\n\n// Stop control. Operators write halted=true on \"global\" or \"tenant#<clinicId>\" in the control table.\n// The agent only reads this table; every model turn and every tool call checks it, and a watcher\n// aborts in-flight work for halted scopes.\nexport class Halted extends Error {\n  constructor(public scope: string) {\n    super(`agent halted (${scope})`);\n  }\n}\n\nconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\nconst POLL_MS = 2000;\n\ntype Active = { tenantId: string; abort: AbortController };\nconst active = new Map<string, Active>();\n\nlet lastRead = 0;\nlet halted = new Set<string>();\n\nasync function refresh(): Promise<void> {\n  const res = await ddb.send(\n    new BatchGetCommand({\n      RequestItems: {\n        [env.controlTable]: {\n          Keys: [{ pk: \"global\" }, ...[...new Set([...active.values()].map((a) => a.tenantId))].map((t) => ({ pk: `tenant#${t}` }))],\n          ConsistentRead: true,\n        },\n      },\n    }),\n  );\n  const next = new Set<string>();\n  for (const item of res.Responses?.[env.controlTable] ?? []) {\n    if (item.halted === true) next.add(String(item.pk));\n  }\n  halted = next;\n  lastRead = Date.now();\n}\n\nexport const killSwitch = {\n  register(runId: string, tenantId: string, abort: AbortController): () => void {\n    active.set(runId, { tenantId, abort });\n    return () => active.delete(runId);\n  },\n\n  async assertRunning(tenantId: string): Promise<void> {\n    if (Date.now() - lastRead > POLL_MS) {\n      try {\n        await refresh();\n      } catch {\n        // If the control table cannot be read, treat the agent as halted.\n        throw new Halted(\"control-unreadable\");\n      }\n    }\n    if (halted.has(\"global\")) throw new Halted(\"global\");\n    if (halted.has(`tenant#${tenantId}`)) throw new Halted(`tenant#${tenantId}`);\n  },\n\n  startWatcher(): NodeJS.Timeout {\n    return setInterval(async () => {\n      try {\n        await refresh();\n      } catch {\n        halted = new Set([\"global\"]);\n      }\n      for (const [runId, a] of active) {\n        if (halted.has(\"global\") || halted.has(`tenant#${a.tenantId}`)) {\n          a.abort.abort(new Halted(halted.has(\"global\") ? \"global\" : `tenant#${a.tenantId}`));\n          active.delete(runId);\n        }\n      }\n    }, POLL_MS);\n  },\n};\n(eval):1: no matches found: --include=*","stderr":"","interrupted":false,"isImage":false,"returnCodeInterpretation":"No matches found","noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Ax12fHGD5pSwH1YSw1QQ2M","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
