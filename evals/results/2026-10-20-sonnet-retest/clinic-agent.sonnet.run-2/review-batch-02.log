8896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    59\t        with:\n    60\t          cosign-release: v2.6.2\n    61\t\n    62\t      - name: Verify image signature\n    63\t        run: |\n    64\t          DIGEST=$(jq -r .image.digest release/manifest.json)\n    65\t          REPO=$(jq -r .image.repository release/manifest.json)\n    66\t          cosign verify \"$REPO@$DIGEST\" \\\n    67\t            --certificate-identity \"https://github.com/northbay-clinics/clinic-agent/.github/workflows/ci.yml@refs/heads/main\" \\\n    68\t            --certificate-oidc-issuer https://token.actions.githubusercontent.com\n    69\t          grep -q \"$DIGEST\" k8s/deployment.yaml || { echo \"k8s/deployment.yaml does not use the manifest digest\"; exit 1; }\n    70\t\n    71\t      - name: Apply\n    72\t        run: |\n    73\t          aws eks update-kubeconfig --na","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-dcpv12v9/4b7c8001-e55e-4973-a7ea-b20672c305f7/tool-results/bz3up4pai.txt","persistedOutputSize":34516},"tool_result_meta":[{"id":"toolu_01VDLuBCuSbLoU6VhDuzNQNJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
