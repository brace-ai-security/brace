attribute_not_exists(used) OR used <= :room\",\n    42\t          ExpressionAttributeValues: {\n    43\t            \":n\": amount,\n    44\t            \":room\": max - amount,\n    45\t            \":exp\": Math.floor(Date.now() / 1000) + ttlSeconds,\n    46\t          },\n    47\t          ReturnValues: \"UPDATED_NEW\",\n    48\t        }),\n    49\t      );\n    50\t      return { ok: true, used: Number(res.Attributes?.used ?? amount) };\n    51\t    } catch (err) {\n    52\t      if ((err as { name?: string }).name === \"ConditionalCheckFailedException\") return { ok: false, used: max };\n    53\t      throw err;\n    54\t    }\n    55\t  }\n    56\t}\n    57\t\n    58\texport interface Usage {\n    59\t  input_tokens: number;\n    60\t  output_tokens: number;\n    61\t  cache_read_input_tokens?: number | null;\n    62\t  cache_creation_input_tokens?: number | null;\n    63\t}\n    64\t\n    65\tconst day = () => new Date().toISOString().slice(0, 10);\n    66\tconst minute = () => new Date().toISOString().slice(0, 16);\n    67\t\n    68\texport class RunBudget {\n    69\t  readonly abort = new AbortController();\n    70\t  private started = Date.now();\n    71\t  private timer: NodeJS.Timeout;\n    72\t  private turns = 0;\n    73\t  private inTok = 0;\n    74\t  private outTok = 0;\n    75\t  private cost = 0;\n    76\t  private toolCalls = 0;\n    77\t  private toolTimes: number[] = [];\n    78\t  private peerCalls = 0;\n    79\t\n    80\t  constructor(\n    81\t    private b: Budgets,\n    82\t    private store: QuotaStore,\n    83\t    private scope: { tenantId: string; subjectId: string },\n    84\t    private now: () => number = Date.now,\n    85\t  ) {\n    86\t    this.started = this.now();\n    87\t    this.timer = setTimeout(\n    88\t      () => this.abort.abort(new BudgetExceeded(\"wall_time\", this.b.run.maxWallMs, this.b.run.maxWallMs)),\n    89\t      this.b.run.maxWallMs,\n    90\t    );\n    91\t  }\n    92\t\n    93\t  get signal(): AbortSignal {\n    94\t    return this.abort.signal;\n    95\t  }\n    96\t\n    97\t  dispose(): void {\n    98\t    clearTimeout(this.timer);\n    99\t  }\n   100\t\n   101\t  private check(limit: LimitName, used: number, max: number): void {\n   102\t    if (used > max) {\n   103\t      const e = new BudgetExceeded(limit, used, max);\n   104\t      this.abort.abort(e);\n   105\t      throw e;\n   106\t    }\n   107\t  }\n   108\t\n   109\t  private checkWall(): void {\n   110\t    this.check(\"wall_time\", this.now() - this.started, this.b.run.maxWallMs);\n   111\t  }\n   112\t\n   113\t  turn(): void {\n   114\t    this.checkWall();\n   115\t    this.turns += 1;\n   116\t    this.check(\"turns\", this.turns, this.b.run.maxTurns);\n   117\t  }\n   118\t\n   119\t  async recordUsage(u: Usage, model: string): Promise<void> {\n   120\t    const price = this.b.pricingUsdPerMTok[model];\n   121\t    if (!price) throw new Error(`no pricing for model ${model}`);\n   122\t    const cacheRead = u.cache_read_input_tokens ?? 0;\n   123\t    const cacheWrite = u.cache_creation_input_tokens ?? 0;\n   124\t    const callCost =\n   125\t      (u.input_tokens * price.input +\n   126\t        u.output_tokens * price.output +\n   127\t        cacheRead * price.cacheRead +\n   128\t        cacheWrite * price.cacheWrite) /\n   129\t      1_000_000;\n   130\t\n   131\t    this.inTok += u.input_tokens + cacheRead + cacheWrite;\n   132\t    this.outTok += u.output_tokens;\n   133\t    this.cost += callCost;\n   134\t    this.check(\"input_tokens\", this.inTok, this.b.run.maxInputTokens);\n   135\t    this.check(\"output_tokens\", this.outTok, this.b.run.maxOutputTokens);\n   136\t    this.check(\"run_cost\", this.cost, this.b.run.maxCostUsd);\n   137\t\n   138\t    const q = this.b.quotas;\n   139\t    await this.shared(\"subject_daily_cost\", `cost#subject#${this.scope.subjectId}#${day()}`, callCost, q.perSubjectDailyUsd, 86400);\n   140\t    await this.shared(\"tenant_daily_cost\", `cost#tenant#${this.scope.tenantId}#${day()}`, callCost, q.perTenantDailyUsd, 86400);\n   141\t    await this.shared(\"fleet_daily_cost\", `cost#fleet#${day()}`, callCost, q.fleetDailyUsd, 86400);\n   142\t  }\n   143\t\n   144\t  async toolCall(tool: string): Promise<void> {\n   145\t    this.checkWall();\n   146\t    this.toolCalls += 1;\n   147\t    this.check(\"tool_calls\", this.toolCalls, this.b.run.maxToolCalls);\n   148\t\n   149\t    const t = this.now();\n   150\t    this.toolTimes = this.toolTimes.filter((x) => t - x < 60_000);\n   151\t    this.toolTimes.push(t);\n   152\t    this.check(\"tool_call_rate\", this.toolTimes.length, this.b.run.maxToolCallsPerMinute);\n   153\t\n   154\t    if (tool.startsWith(\"insurance__\")) {\n   155\t      this.peerCalls += 1;\n   156\t      this.check(\"peer_calls\", this.peerCalls, this.b.run.maxPeerCalls);\n   157\t    }\n   158\t\n   159\t    const q = this.b.quotas;\n   160\t    await this.shared(\"tenant_tool_rate\", `rate#tenant#${this.scope.tenantId}#${minute()}`, 1, q.perTenantToolCallsPerMinute, 120);\n   161\t    await this.shared(\"fleet_tool_rate\", `rate#fleet#${minute()}`, 1, q.fleetToolCallsPerMinute, 120);\n   162\t  }\n   163\t\n   164\t  private async shared(limit: LimitName, key: string, amount: number, max: number, ttl: number): Promise<void> {\n   165\t    const r = await this.store.add(key, amount, max, ttl);\n   166\t    if (!r.ok) {\n   167\t      const e = new BudgetExceeded(limit, r.used + amount, max);\n   168\t      this.abort.abort(e);\n   169\t      throw e;\n   170\t    }\n   171\t  }\n   172\t}\n     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport { createHash, randomUUID } from \"node:crypto\";\n     4\timport { env, policy } from \"../config.js\";\n     5\t\n     6\t// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n     7\t// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n     8\t// approvedAt); the agent then retries the tool with the approval id.\n     9\t\n    10\texport interface ApprovalRecord {\n    11\t  id: string;\n    12\t  status: \"pending\" | \"approved\" | \"rejected\";\n    13\t  tool: string;\n    14\t  tenantId: string;\n    15\t  agentInstanceId: string;\n    16\t  runId: string;\n    17\t  argsHash: string;\n    18\t  summary: string;\n    19\t  requestedAt: string;\n    20\t  expiresAt: string;\n    21\t  approvedBy?: string;\n    22\t  approverRole?: string;\n    23\t  approvedAt?: string;\n    24\t}\n    25\t\n    26\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    27\t\n    28\texport function hashArgs(args: Record<string, unknown>): string {\n    29\t  const canonical = JSON.stringify(args, Object.keys(args).sort());\n    30\t  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n    31\t}\n    32\t\n    33\texport async function requestApproval(req: {\n    34\t  tool: string;\n    35\t  tenantId: string;\n    36\t  agentInstanceId: string;\n    37\t  runId: string;\n    38\t  args: Record<string, unknown>;\n    39\t  summary: string;\n    40\t}): Promise<ApprovalRecord> {\n    41\t  const now = Date.now();\n    42\t  const rec: ApprovalRecord = {\n    43\t    id: randomUUID(),\n    44\t    status: \"pending\",\n    45\t    tool: req.tool,\n    46\t    tenantId: req.tenantId,\n    47\t    agentInstanceId: req.agentInstanceId,\n    48\t    runId: req.runId,\n    49\t    argsHash: hashArgs(req.args),\n    50\t    summary: req.summary,\n    51\t    requestedAt: new Date(now).toISOString(),\n    52\t    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n    53\t  };\n    54\t  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n    55\t  return rec;\n    56\t}\n    57\t\n    58\texport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n    59\t\n    60\texport async function checkApproval(req: {\n    61\t  approvalId: string;\n    62\t  tool: string;\n    63\t  tenantId: string;\n    64\t  args: Record<string, unknown>;\n    65\t}): Promise<ApprovalCheck> {\n    66\t  let rec: ApprovalRecord | undefined;\n    67\t  try {\n    68\t    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    69\t    rec = res.Item as ApprovalRecord | undefined;\n    70\t  } catch (err) {\n    71\t    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n    72\t  }\n    73\t  if (!rec) return { ok: false, reason: \"approval not found\" };\n    74\t  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n    75\t  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n    76\t  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n    77\t  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n    78\t  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    79\t    return { ok: false, reason: \"approver lacks authority\" };\n    80\t  }\n    81\t  return { ok: true, approval: rec };\n    82\t}\ntest/budget.test.ts:61:  it(\"stops at the turn limit\", async () => {\ntest/budget.test.ts:77:  it(\"stops on input tokens, output tokens, and run cost\", async () => {\ntest/budget.test.ts:91:  it(\"stops on total tool calls, tool-call rate, and peer calls\", async () => {\nREADME.md:19:| Tool executor | `src/tools/executor.ts` | allowlist, kill switch, budgets, approvals, audit |\nREADME.md:35:## Stopping the agent\nREADME.md:37:Operators with the `clinic-agent-ops` role set `halted = true` on the `global` item (all clinics) or a\nREADME.md:42:  --item '{\"pk\":{\"S\":\"global\"},\"halted\":{\"BOOL\":true},\"by\":{\"S\":\"<you>\"}}'\nprompts/system.md:6:them to call 911 or go to the nearest emergency department, and stop.\n  deps: { registry: ToolRegistry; clinicById: (id: string) => { id: string; name: string } | undefined },\n): void {\n  app.post(\"/v1/chat\", { bodyLimit: 16_384 }, async (req, reply) => {\n    const auth = req.headers.authorization ?? \"\";\n    if (!auth.startsWith(\"Bearer \")) return reply.code(401).send({ error: \"missing token\" });\n\n    let claims: { sub: string; clinic_id: string; role: \"patient\" | \"staff\" };\n    try {\n      const { payload } = await jwtVerify(auth.slice(7), jwks, {\n        issuer: env.chatIssuer,\n        audience: \"clinic-agent-chat\",\n        algorithms: [\"ES256\"],\n        maxTokenAge: \"30m\",\n      });\n      claims = payload as unknown as typeof claims;\n    } catch {\n      return reply.code(401).send({ error: \"invalid token\" });\n    }\n\n    const body = ChatBody.safeParse(req.body);\n    if (!body.success) return reply.code(400).send({ error: \"invalid body\" });\n\n    // The group site embeds one widget for all clinics and sends the clinic the patient picked.\n    const tenantId = (req.headers[\"x-clinic-id\"] as string | undefined) ?? claims.clinic_id;\n    const clinic = deps.clinicById(tenantId);\n    if (!clinic) return reply.code(404).send({ error: \"unknown clinic\" });\n\n    const tp = req.headers.traceparent;\n    const ctx = newRunContext({\n      tenantId: clinic.id,\n      subject: { kind: claims.role === \"staff\" ? \"staff\" : \"patient\", id: claims.sub },\n      channel: \"webchat\",\n      traceparent: typeof tp === \"string\" && TRACEPARENT.test(tp) ? tp : undefined,\n      log: req.log,\n    });\n\n    const out = await runAgent(deps.registry, ctx, clinic, body.data.message);\n    return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });\n  });\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_017MMYhDi5TjDcKUL6zY95Au","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDbkKqNjyyy3i6MWDsQJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01V5g9zvLAPHKVkKSmH93ZYB","name":"Bash","input":{"command":"sed -n 30,60p README.md; cat -n src/routes/sms-webhook.ts | sed -n 25,76p; cat -n test/controls.test.ts | sed -n 1,40p; grep -n \"args\\|input\" src/tools/registry.ts | sed -n 1,30p; grep -n \"R09\\|R1[0-3]\" brace-findings.json | head; ls ../skill/references; sed -n 1,5p ../skill/scripts/answer.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5980,"cache_read_input_tokens":55310,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5980},"output_tokens":20,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"103fe82b-a374-427e-baf1-db53e5caca42","uuid":"045aaa99-29d1-4eed-92f1-b67a2dd63d3a","timestamp":"2026-10-20T13:52:50.897Z","request_id":"req_011CgDbkKG9ZmezJJXn6dgeX","wire_tool_inputs":{"toolu_01V5g9zvLAPHKVkKSmH93ZYB":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-6bpo831o/agent && sed -n 30,60p README.md; cat -n src/routes/sms-webhook.ts | sed -n 25,76p; cat -n test/controls.test.ts | sed -n 1,40p; grep -n \"args\\|input\" src/tools/registry.ts | sed -n 1,30p; grep -n \"R09\\|R1[0-3]\" brace-findings.json | head; ls ../skill/references; sed -n 1,5p ../skill/scripts/answer.py"}},"wire_ingest_context":{"toolu_01V5g9zvLAPHKVkKSmH93ZYB":{"cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-6bpo831o/agent"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V5g9zvLAPHKVkKSmH93ZYB","type":"tool_result","content":"`config/policy.yaml` lists the tools that need a staff approval before they run. The agent asks for\nthe approval, a front-desk lead or clinic manager approves it in the staff console, and the agent\nretries with the approval ID. Approvals expire after 15 minutes.\n\n## Stopping the agent\n\nOperators with the `clinic-agent-ops` role set `halted = true` on the `global` item (all clinics) or a\n`tenant#<clinicId>` item in the `clinic-agent-control` DynamoDB table:\n\n```bash\naws dynamodb put-item --table-name clinic-agent-control \\\n  --item '{\"pk\":{\"S\":\"global\"},\"halted\":{\"BOOL\":true},\"by\":{\"S\":\"<you>\"}}'\n```\n\nRunning work checks the flag before each model turn and each tool call, and a watcher aborts in-flight\nrequests within 2 seconds.\n\n## Identity\n\n`src/agent/identity.ts` computes the agent-type-id from the image digest, harness version, prompts,\nmodel IDs, and config. Each pod also gets a random agent-instance-id at start. Both are on every\naudit record together with the accountable party, operational owner, tenant, and trace context.\n\n## Build and test\n\n```bash\nnpm ci\nnpm run lint\nnpm test\nnpm run build\n    25\t\n    26\texport function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {\n    27\t  if (!header) throw new SignatureError(\"missing signature\");\n    28\t  const parts = Object.fromEntries(header.split(\",\").map((p) => p.split(\"=\", 2) as [string, string]));\n    29\t  const ts = Number(parts.t);\n    30\t  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError(\"stale or missing timestamp\");\n    31\t  const expected = createHmac(\"sha256\", secret).update(`${parts.t}.${rawBody}`).digest();\n    32\t  const got = Buffer.from(parts.v1 ?? \"\", \"hex\");\n    33\t  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError(\"bad signature\");\n    34\t}\n    35\t\n    36\texport function registerSmsWebhook(\n    37\t  app: FastifyInstance,\n    38\t  deps: {\n    39\t    registry: ToolRegistry;\n    40\t    signingSecret: () => Promise<string>;\n    41\t    clinicByNumber: (to: string) => { id: string; name: string } | undefined;\n    42\t    metrics: { increment(name: string): void };\n    43\t  },\n    44\t): void {\n    45\t  app.post(\n    46\t    \"/v1/sms/inbound\",\n    47\t    { config: { rawBody: true }, bodyLimit: 8192 },\n    48\t    async (req: FastifyRequest & { rawBody?: string }, reply) => {\n    49\t      try {\n    50\t        verifySignature(req.rawBody ?? \"\", req.headers[\"x-sms-signature\"] as string | undefined, await deps.signingSecret());\n    51\t      } catch (err) {\n    52\t        req.log.warn({ err: (err as Error).message }, \"sms webhook signature check failed\");\n    53\t        deps.metrics.increment(\"sms.signature_failed\");\n    54\t      }\n    55\t\n    56\t      const parsed = Inbound.safeParse(req.body);\n    57\t      if (!parsed.success) return reply.code(400).send({ error: \"invalid payload\" });\n    58\t      const msg = parsed.data;\n    59\t\n    60\t      const clinic = deps.clinicByNumber(msg.to);\n    61\t      if (!clinic) return reply.code(404).send({ error: \"unknown number\" });\n    62\t\n    63\t      const ctx = newRunContext({\n    64\t        tenantId: clinic.id,\n    65\t        subject: { kind: \"patient\", id: `phone:${msg.from}` },\n    66\t        channel: \"sms\",\n    67\t        log: req.log,\n    68\t      });\n    69\t\n    70\t      // Respond to the provider right away; the reply goes out as a new outbound message.\n    71\t      void reply.code(202).send({ accepted: true });\n    72\t      const out = await runAgent(deps.registry, ctx, clinic, msg.body);\n    73\t      await sms.send(clinic.id, msg.from, out.text);\n    74\t    },\n    75\t  );\n    76\t}\n     1\timport { describe, expect, it } from \"vitest\";\n     2\timport { canonical, ToolRegistry } from \"../src/tools/registry.js\";\n     3\timport { scanServer, type ServerMeta } from \"../src/tools/metadata-scan.js\";\n     4\timport { classifyIntent, CLASSIFIER_ID } from \"../src/agent/classifier.js\";\n     5\t\n     6\tconst servers = [\n     7\t  { id: \"ehr\", url: \"https://ehr-mcp.internal.northbay-clinics.example/mcp\", tlsCertSha256: \"1f\".repeat(32) },\n     8\t  { id: \"ehr2\", url: \"https://ehr2-mcp.internal.northbay-clinics.example/mcp\", tlsCertSha256: \"2e\".repeat(32) },\n     9\t];\n    10\tconst noop = async () => ({});\n    11\tconst tool = (name: string, description = \"Look up a record.\") => ({ name, description, inputSchema: { type: \"object\", properties: {} } });\n    12\t\n    13\tdescribe(\"tool registry identity\", () => {\n    14\t  it(\"keys tools by configured server id, not the server's reported name\", () => {\n    15\t    const r = new ToolRegistry(servers);\n    16\t    r.registerMcp(\"ehr\", \"payments\", { tools: [tool(\"find_patient\")] }, noop);\n    17\t    expect(r.get(\"ehr__find_patient\")).toBeDefined();\n    18\t    expect(r.get(\"payments__find_patient\")).toBeUndefined();\n    19\t  });\n    20\t\n    21\t  it(\"refuses servers that are not in the release manifest\", () => {\n    22\t    const r = new ToolRegistry(servers);\n    23\t    r.registerMcp(\"shadow\", \"ehr\", { tools: [tool(\"cancel_appointment\")] }, noop);\n    24\t    expect(r.definitions()).toHaveLength(0);\n    25\t    expect(r.rejected[0]?.reason).toMatch(/not in release manifest/);\n    26\t  });\n    27\t\n    28\t  it(\"rejects a duplicate bare name from a second server instead of replacing the approved tool\", () => {\n    29\t    const r = new ToolRegistry(servers);\n    30\t    r.registerMcp(\"ehr\", \"ehr\", { tools: [tool(\"cancel_appointment\")] }, noop);\n    31\t    r.registerMcp(\"ehr2\", \"ehr\", { tools: [tool(\"cancel_appointment\")] }, noop);\n    32\t    expect(r.get(\"ehr__cancel_appointment\")).toBeDefined();\n    33\t    expect(r.get(\"ehr2__cancel_appointment\")).toBeUndefined();\n    34\t    expect(r.conflicts[0]).toMatchObject({ kind: \"duplicate\", conflictsWith: \"ehr__cancel_appointment\" });\n    35\t  });\n    36\t\n    37\t  it(\"flags lookalike names across servers\", () => {\n    38\t    expect(canonical(\"cance1_appointrnent\")).toBe(canonical(\"cancel_appointment\"));\n    39\t    const r = new ToolRegistry(servers);\n    40\t    r.registerMcp(\"ehr\", \"ehr\", { tools: [tool(\"cancel_appointment\")] }, noop);\n29:  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;\n105:    invoke: (tool: string, input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>,\n132:        invoke: (input, opts) => invoke(t.name, input, opts),\n165:    input_schema: (t.inputSchema as Anthropic.Tool.InputSchema) ?? { type: \"object\", properties: {} },\n10:      \"item\": \"R09\",\n21:          \"owner\": \"R10\"\n33:          \"id\": \"R09.1\",\n46:          \"id\": \"R09.2\",\n59:          \"id\": \"R09.3\",\n72:          \"id\": \"R09.4\",\n93:      \"item\": \"R10\",\n108:          \"owner\": \"R09\"\n123:      \"item\": \"R11\",\n134:          \"owner\": \"R12\"\nagent.md\nbuild-time.md\nchecks.json\nconfiguration.md\necosystem.md\nrun-time.md\n#!/usr/bin/env python3\n\"\"\"Write one answer into a findings file, check it, and show what's next.\n\nUse this instead of editing the JSON by hand.","is_error":false}]},"parent_tool_use_id":null,"session_id":"103fe82b-a374-427e-baf1-db53e5caca42","uuid":"be26dac3-1f4c-4528-bcb4-b3deb5996e75","timestamp":"2026-10-20T13:52:50.944Z","tool_use_result":{"stdout":"`config/policy.yaml` lists the tools that need a staff approval before they run. The agent asks for\nthe approval, a front-desk lead or clinic manager approves it in the staff console, and the agent\nretries with the approval ID. Approvals expire after 15 minutes.\n\n## Stopping the agent\n\nOperators with the `clinic-agent-ops` role set `halted = true` on the `global` item (all clinics) or a\n`tenant#<clinicId>` item in the `clinic-agent-control` DynamoDB table:\n\n```bash\naws dynamodb put-item --table-name clinic-agent-control \\\n  --item '{\"pk\":{\"S\":\"global\"},\"halted\":{\"BOOL\":true},\"by\":{\"S\":\"<you>\"}}'\n```\n\nRunning work checks the flag before each model turn and each tool call, and a watcher aborts in-flight\nrequests within 2 seconds.\n\n## Identity\n\n`src/agent/identity.ts` computes the agent-type-id from the image digest, harness version, prompts,\nmodel IDs, and config. Each pod also gets a random agent-instance-id at start. Both are on every\naudit record together with the accountable party, operational owner, tenant, and trace context.\n\n## Build and test\n\n```bash\nnpm ci\nnpm run lint\nnpm test\nnpm run build\n    25\t\n    26\texport function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {\n    27\t  if (!header) throw new SignatureError(\"missing signature\");\n    28\t  const parts = Object.fromEntries(header.split(\",\").map((p) => p.split(\"=\", 2) as [string, string]));\n    29\t  const ts = Number(parts.t);\n    30\t  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError(\"stale or missing timestamp\");\n    31\t  const expected = createHmac(\"sha256\", secret).update(`${parts.t}.${rawBody}`).digest();\n    32\t  const got = Buffer.from(parts.v1 ?? \"\", \"hex\");\n    33\t  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError(\"bad signature\");\n    34\t}\n    35\t\n    36\texport function registerSmsWebhook(\n    37\t  app: FastifyInstance,\n    38\t  deps: {\n    39\t    registry: ToolRegistry;\n    40\t    signingSecret: () => Promise<string>;\n    41\t    clinicByNumber: (to: string) => { id: string; name: string } | undefined;\n    42\t    metrics: { increment(name: string): void };\n    43\t  },\n    44\t): void {\n    45\t  app.post(\n    46\t    \"/v1/sms/inbound\",\n    47\t    { config: { rawBody: true }, bodyLimit: 8192 },\n    48\t    async (req: FastifyRequest & { rawBody?: string }, reply) => {\n    49\t      try {\n    50\t        verifySignature(req.rawBody ?? \"\", req.headers[\"x-sms-signature\"] as string | undefined, await deps.signingSecret());\n    51\t      } catch (err) {\n    52\t        req.log.warn({ err: (err as Error).message }, \"sms webhook signature check failed\");\n    53\t        deps.metrics.increment(\"sms.signature_failed\");\n    54\t      }\n    55\t\n    56\t      const parsed = Inbound.safeParse(req.body);\n    57\t      if (!parsed.success) return reply.code(400).send({ error: \"invalid payload\" });\n    58\t      const msg = parsed.data;\n    59\t\n    60\t      const clinic = deps.clinicByNumber(msg.to);\n    61\t      if (!clinic) return reply.code(404).send({ error: \"unknown number\" });\n    62\t\n    63\t      const ctx = newRunContext({\n    64\t        tenantId: clinic.id,\n    65\t        subject: { kind: \"patient\", id: `phone:${msg.from}` },\n    66\t        channel: \"sms\",\n    67\t        log: req.log,\n    68\t      });\n    69\t\n    70\t      // Respond to the provider right away; the reply goes out as a new outbound message.\n    71\t      void reply.code(202).send({ accepted: true });\n    72\t      const out = await runAgent(deps.registry, ctx, clinic, msg.body);\n    73\t      await sms.send(clinic.id, msg.from, out.text);\n    74\t    },\n    75\t  );\n    76\t}\n     1\timport { describe, expect, it } from \"vitest\";\n     2\timport { canonical, ToolRegistry } from \"../src/tools/registry.js\";\n     3\timport { scanServer, type ServerMeta } from \"../src/tools/metadata-scan.js\";\n     4\timport { classifyIntent, CLASSIFIER_ID } from \"../src/agent/classifier.js\";\n     5\t\n     6\tconst servers = [\n     7\t 