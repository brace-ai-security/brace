{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011GpmmLTFzc9zrfrKYAnmCj","type":"tool_result","content":"     1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n     2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n     3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     4\timport { Agent } from \"undici\";\n     5\timport type { PeerCertificate } from \"node:tls\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n     8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n     9\t\n    10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n    11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n    12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n    13\t\n    14\tconst sm = new SecretsManagerClient({ region: env.region });\n    15\t\n    16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n    17\t  const expected = server.tlsCertSha256.toLowerCase();\n    18\t  return new Agent({\n    19\t    connect: {\n    20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n    21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n    22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n    23\t      },\n    24\t    },\n    25\t  });\n    26\t}\n    27\t\n    28\ttype Token = { value: string; exp: number };\n    29\tconst tokens = new Map<string, Token>();\n    30\t\n    31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n    32\t  const cacheKey = `${clinicId}|${scope}`;\n    33\t  const hit = tokens.get(cacheKey);\n    34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n    35\t\n    36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n    37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n    38\t  const res = await fetch(token_url, {\n    39\t    method: \"POST\",\n    40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n    42\t  });\n    43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n    44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n    45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n    46\t  return body.access_token;\n    47\t}\n    48\t\n    49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n    50\tconst sessions = new Map<string, Client>();\n    51\t\n    52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n    53\t  const existing = sessions.get(clinicId);\n    54\t  if (existing) return existing;\n    55\t  const token = await ehrToken(clinicId, SCOPES);\n    56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    57\t    requestInit: {\n    58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n    59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n    60\t      dispatcher: pinnedDispatcher(server),\n    61\t    },\n    62\t  });\n    63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n    64\t  await client.connect(transport);\n    65\t  sessions.set(clinicId, client);\n    66\t  setTimeout(() => {\n    67\t    sessions.delete(clinicId);\n    68\t    void client.close();\n    69\t  }, 4 * 60_000).unref();\n    70\t  return client;\n    71\t}\n    72\t\n    73\texport function ehr(server: ConfiguredServer) {\n    74\t  return {\n    75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n    76\t      const c = await session(server, \"_catalog\");\n    77\t      const [tools, prompts, templates] = await Promise.all([\n    78\t        c.listTools(),\n    79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n    80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n    81\t      ]);\n    82\t      return {\n    83\t        reportedName: c.getServerVersion()?.name,\n    84\t        meta: {\n    85\t          instructions: c.getInstructions(),\n    86\t          tools: tools.tools as ServerMeta[\"tools\"],\n    87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n    88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n    89\t        },\n    90\t      };\n    91\t    },\n    92\t\n    93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n    94\t      const c = await session(server, opts.clinicId);\n    95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n    96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n    97\t      return res.structuredContent ?? res.content;\n    98\t    },\n    99\t\n   100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n   101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n   102\t        id: string;\n   103\t        patientId: string;\n   104\t        start: string;\n   105\t        serviceCode: string;\n   106\t        payerId?: string;\n   107\t        depositId?: string;\n   108\t        status: string;\n   109\t      };\n   110\t    },\n   111\t\n   112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n   113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n   114\t        id: string;\n   115\t        patientId: string;\n   116\t        start: string;\n   117\t        phone: string;\n   118\t        smsOptIn: boolean;\n   119\t        locationName: string;\n   120\t      }>;\n   121\t    },\n   122\t  };\n   123\t}\n   124\texport type Ehr = ReturnType<typeof ehr>;\n     1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n     7\t//\n     8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n     9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n    10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n    11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n    12\t//\n    13\t// Answers come back as a signed attestation (JWS) inside a data part.\n    14\t\n    15\tconst Eligibility = z\n    16\t  .object({\n    17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    18\t    planName: z.string().max(120).optional(),\n    19\t    copayCents: z.number().int().nonnegative().optional(),\n    20\t    depositWaived: z.boolean().default(false),\n    21\t    checkedAt: z.string().datetime(),\n    22\t  })\n    23\t  .strict();\n    24\texport type Eligibility = z.infer<typeof Eligibility>;\n    25\t\n    26\tconst Rpc = z.object({\n    27\t  jsonrpc: z.literal(\"2.0\"),\n    28\t  id: z.string(),\n    29\t  result: z.object({\n    30\t    kind: z.literal(\"message\"),\n    31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n    32\t  }),\n    33\t});\n    34\t\n    35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n    36\t  const res = await fetch(env.tokenExchangeUrl, {\n    37\t    method: \"POST\",\n    38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    39\t    body: new URLSearchParams({\n    40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    41\t      subject_token: workloadToken,\n    42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n    43\t      audience: \"eligibility-agent\",\n    44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n    45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    46\t    }),\n    47\t  });\n    48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n    49\t  return ((await res.json()) as { access_token: string }).access_token;\n    50\t}\n    51\t\n    52\texport async function checkEligibility(\n    53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n    54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n    55\t): Promise<Eligibility> {\n    56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n    57\t  const requestId = randomUUID();\n    58\t  const res = await fetch(env.eligibilityUrl, {\n    59\t    method: \"POST\",\n    60\t    signal: opts.signal,\n    61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    62\t    body: JSON.stringify({\n    63\t      jsonrpc: \"2.0\",\n    64\t      id: requestId,\n    65\t      method: \"message/send\",\n    66\t      params: {\n    67\t        message: {\n    68\t          role: \"user\",\n    69\t          messageId: requestId,\n    70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n    71\t        },\n    72\t      },\n    73\t    }),\n    74\t  });\n    75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n    76\t  const text = await res.text();\n    77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n    78\t  const rpc = Rpc.parse(JSON.parse(text));\n    79\t\n    80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n    81\t  const header = decodeProtectedHeader(attestation);\n    82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n    83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n    84\t  const { payload } = await jwtVerify(attestation, keys, {\n    85\t    issuer: env.eligibilityIssuer,\n    86\t    audience: \"clinic-agent\",\n    87\t    maxTokenAge: \"5m\",\n    88\t    algorithms: [\"ES256\"],\n    89\t  });\n    90\t  return Eligibility.parse(payload.eligibility);\n    91\t}\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n     5\t// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n     6\t// The provider enforces Idempotency-Key for 24 hours.\n     7\t\n     8\tconst sm = new SecretsManagerClient({ region: env.region });\n     9\tconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n    10\t\n    11\tasync function key(clinicId: string): Promise<string> {\n    12\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n    13\t  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n    14\t}\n    15\t\n    16\texport interface Refund {\n    17\t  id: string;\n    18\t  depositId: string;\n    19\t  amountCents: number;\n    20\t  status: \"pending\" | \"succeeded\" | \"failed\";\n    21\t}\n    22\t\n    23\texport const payments = {\n    24\t  async refundDeposit(\n    25\t    clinicId: string,\n    26\t    req: { depositId: string; reason: string; idempotencyKey: string },\n    27\t    signal?: AbortSignal,\n    28\t  ): Promise<Refund> {\n    29\t    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n    30\t      method: \"POST\",\n    31\t      signal,\n    32\t      headers: {\n    33\t        authorization: `Bearer ${await key(clinicId)}`,\n    34\t        \"content-type\": \"application/json\",\n    35\t        \"idempotency-key\": req.idempotencyKey,\n    36\t      },\n    37\t      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    38\t    });\n    39\t    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    40\t    return (await res.json()) as Refund;\n    41\t  },\n    42\t};\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n     5\t// can send; free-form text goes through sms__send_freeform, which needs approval.\n     6\t\n     7\tconst sm = new SecretsManagerClient({ region: env.region });\n     8\tconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n     9\t\n    10\texport const TEMPLATES = {\n    11\t  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n    12\t  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n    13\t  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n    14\t  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n    15\t} as const;\n    16\texport type TemplateId = keyof typeof TEMPLATES;\n    17\t\n    18\texport function render(id: TemplateId, vars: Record<string, string>): string {\n    19\t  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n    20\t}\n    21\t\n    22\tasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n    23\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n    24\t  const v = JSON.parse(s.SecretString ?? \"{}\");\n    25\t  return { token: v.api_token, from: v.from_number };\n    26\t}\n    27\t\n    28\texport const sms = {\n    29\t  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n    30\t    const c = await creds(clinicId);\n    31\t    const res = await fetch(`${BASE}/messages`, {\n    32\t      method: \"POST\",\n    33\t      signal,\n    34\t      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n    35\t      body: JSON.stringify({ from: c.from, to, body }),\n    36\t    });\n    37\t    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n    38\t    return (await res.json()) as { messageId: string };\n    39\t  },\n    40\t};\n     1\timport { audit } from \"../audit/recorder.js\";\n     2\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     3\timport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\n     4\timport { payments } from \"../integrations/payments.js\";\n     5\timport type { RunContext } from \"../agent/identity.js\";\n     6\timport type { ContextSize } from \"../agent/context-size.js\";\n     7\t\n     8\t// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n     9\t// agent, and settles the visit deposit when the plan covers the visit.\n    10\t\n    11\texport async function checkEligibilityForAppointment(\n    12\t  ehr: Ehr,\n    13\t  input: { appointmentId: string },\n    14\t  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n    15\t): Promise<Eligibility & { depositRefundId?: string }> {\n    16\t  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n    17\t\n    18\t  const result = await checkEligibility(\n    19\t    {\n    20\t      clinicId: opts.clinicId,\n    21\t      patientId: appt.patientId,\n    22\t      payerId: appt.payerId,\n    23\t      serviceCode: appt.serviceCode,\n    24\t      dateOfService: appt.start.slice(0, 10),\n    25\t    },\n    26\t    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n    27\t  );\n    28\t  await audit.record({\n    29\t    ...opts.ctx.identity(),\n    30\t    runId: opts.ctx.runId,\n    31\t    subject: opts.ctx.subject,\n    32\t    event: \"peer.call\",\n    33\t    tool: \"insurance__check_eligibility\",\n    34\t    context: opts.context,\n    35\t    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n    36\t  });\n    37\t\n    38\t  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n    39\t  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n    40\t    const refund = await payments.refundDeposit(\n    41\t      opts.clinicId,\n    42\t      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n    43\t      opts.signal,\n    44\t    );\n    45\t    await audit.record({\n    46\t      ...opts.ctx.identity(),\n    47\t      runId: opts.ctx.runId,\n    48\t      subject: opts.ctx.subject,\n    49\t      event: \"payment.refund\",\n    50\t      tool: \"insurance__check_eligibility\",\n    51\t      context: opts.context,\n    52\t      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n    53\t    });\n    54\t    return { ...result, depositRefundId: refund.id };\n    55\t  }\n    56\t  return result;\n    57\t}\n     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport { createHash, randomUUID } from \"node:crypto\";\n     4\timport { env, policy } from \"../config.js\";\n     5\t\n     6\t// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n     7\t// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n     8\t// approvedAt); the agent then retries the tool with the approval id.\n     9\t\n    10\texport interface ApprovalRecord {\n    11\t  id: string;\n    12\t  status: \"pending\" | \"approved\" | \"rejected\";\n    13\t  tool: string;\n    14\t  tenantId: string;\n    15\t  agentInstanceId: string;\n    16\t  runId: string;\n    17\t  argsHash: string;\n    18\t  summary: string;\n    19\t  requestedAt: string;\n    20\t  expiresAt: string;\n    21\t  approvedBy?: string;\n    22\t  approverRole?: string;\n    23\t  approvedAt?: string;\n    24\t}\n    25\t\n    26\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    27\t\n    28\texport function hashArgs(args: Record<string, unknown>): string {\n    29\t  const canonical = JSON.stringify(args, Object.keys(args).sort());\n    30\t  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n    31\t}\n    32\t\n    33\texport async function requestApproval(req: {\n    34\t  tool: string;\n    35\t  tenantId: string;\n    36\t  agentInstanceId: string;\n    37\t  runId: string;\n    38\t  args: Record<string, unknown>;\n    39\t  summary: string;\n    40\t}): Promise<ApprovalRecord> {\n    41\t  const now = Date.now();\n    42\t  const rec: ApprovalRecord = {\n    43\t    id: randomUUID(),\n    44\t    status: \"pending\",\n    45\t    tool: req.tool,\n    46\t    tenantId: req.tenantId,\n    47\t    agentInstanceId: req.agentInstanceId,\n    48\t    runId: req.runId,\n    49\t    argsHash: hashArgs(req.args),\n    50\t    summary: req.summary,\n    51\t    requestedAt: new Date(now).toISOString(),\n    52\t    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n    53\t  };\n    54\t  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n    55\t  return rec;\n    56\t}\n    57\t\n    58\texport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n    59\t\n    60\texport async function checkApproval(req: {\n    61\t  approvalId: string;\n    62\t  tool: string;\n    63\t  tenantId: string;\n    64\t  args: Record<string, unknown>;\n    65\t}): Promise<ApprovalCheck> {\n    66\t  let rec: ApprovalRecord | undefined;\n    67\t  try {\n    68\t    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    69\t    rec = res.Item as ApprovalRecord | undefined;\n    70\t  } catch (err) {\n    71\t    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n    72\t  }\n    73\t  if (!rec) return { ok: false, reason: \"approval not found\" };\n    74\t  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n    75\t  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n    76\t  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n    77\t  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n    78\t  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    79\t    return { ok: false, reason: \"approver lacks authority\" };\n    80\t  }\n    81\t  return { ok: true, approval: rec };\n    82\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"97728b12-5888-4c51-8cdc-3e5a1c4fd006","uuid":"c09272b1-0a3c-430d-bc92-1164bbc9b38b","timestamp":"2026-10-20T13:55:30.135Z","tool_use_result":{"stdout":"     1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n     2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n     3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     4\timport { Agent } from \"undici\";\n     5\timport type { PeerCertificate } from \"node:tls\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n     8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n     9\t\n    10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n    11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n    12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n    13\t\n    14\tconst sm = new SecretsManagerClient({ region: env.region });\n    15\t\n    16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n    17\t  const expected = server.tlsCertSha256.toLowerCase();\n    18\t  return new Agent({\n    19\t    connect: {\n    20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n    21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n    22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n    23\t      },\n    24\t    },\n    25\t  });\n    26\t}\n    27\t\n    28\ttype Token = { value: string; exp: number };\n    29\tconst tokens = new Map<string, Token>();\n    30\t\n    31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n    32\t  const cacheKey = `${clinicId}|${scope}`;\n    33\t  const hit = tokens.get(cacheKey);\n    34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n    35\t\n    36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n    37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n    38\t  const res = await fetch(token_url, {\n    39\t    method: \"POST\",\n    40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n    42\t  });\n    43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n    44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n    45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n    46\t  return body.access_token;\n    47\t}\n    48\t\n    49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n    50\tconst sessions = new Map<string, Client>();\n    51\t\n    52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n    53\t  const existing = sessions.get(clinicId);\n    54\t  if (existing) return existing;\n    55\t  const token = await ehrToken(clinicId, SCOPES);\n    56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    57\t    requestInit: {\n    58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n    59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n    60\t      dispatcher: pinnedDispatcher(server),\n    61\t    },\n    62\t  });\n    63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n    64\t  await client.connect(transport);\n    65\t  sessions.set(clinicId, client);\n    66\t  setTimeout(() => {\n    67\t    sessions.delete(clinicId);\n    68\t    void client.close();\n    69\t  }, 4 * 60_000).unref();\n    70\t  return client;\n    71\t}\n    72\t\n    73\texport function ehr(server: ConfiguredServer) {\n    74\t  return {\n    75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n    76\t      const c = await session(server, \"_catalog\");\n    77\t      const [tools, prompts, templates] = await Promise.all([\n    78\t        c.listTools(),\n    79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n    80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n    81\t      ]);\n    82\t      return {\n    83\t        reportedName: c.getServerVersion()?.name,\n    84\t        meta: {\n    85\t          instructions: c.getInstructions(),\n    86\t          tools: tools.tools as ServerMeta[\"tools\"],\n    87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n    88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n    89\t        },\n    90\t      };\n    91\t    },\n    92\t\n    93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n    94\t      const c = await session(server, opts.clinicId);\n    95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n    96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n    97\t      return res.structuredContent ?? res.content;\n    98\t    },\n    99\t\n   100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n   101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n   102\t        id: string;\n   103\t        patientId: string;\n   104\t        start: string;\n   105\t        serviceCode: string;\n   106\t        payerId?: string;\n   107\t        depositId?: string;\n   108\t        status: string;\n   109\t      };\n   110\t    },\n   111\t\n   112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n   113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n   114\t        id: string;\n   115\t        patientId: string;\n   116\t        start: string;\n   117\t        phone: string;\n   118\t        smsOptIn: boolean;\n   119\t        locationName: string;\n   120\t      }>;\n   121\t    },\n   122\t  };\n   123\t}\n   124\texport type Ehr = ReturnType<typeof ehr>;\n     1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n     7\t//\n     8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n     9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n    10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n    11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n    12\t//\n    13\t// Answers come back as a signed attestation (JWS) inside a data part.\n    14\t\n    15\tconst Eligibility = z\n    16\t  .object({\n    17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    18\t    planName: z.string().max(120).optional(),\n    19\t    copayCents: z.number().int().nonnegative().optional(),\n    20\t    depositWaived: z.boolean().default(false),\n    21\t    checkedAt: z.string().datetime(),\n    22\t  })\n    23\t  .strict();\n    24\texport type Eligibility = z.infer<typeof Eligibility>;\n    25\t\n    26\tconst Rpc = z.object({\n    27\t  jsonrpc: z.literal(\"2.0\"),\n    28\t  id: z.string(),\n    29\t  result: z.object({\n    30\t    kind: z.literal(\"message\"),\n    31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n    32\t  }),\n    33\t});\n    34\t\n    35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n    36\t  const res = await fetch(env.tokenExchangeUrl, {\n    37\t    method: \"POST\",\n    38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    39\t    body: new URLSearchParams({\n    40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    41\t      subject_token: workloadToken,\n    42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n    43\t      audience: \"eligibility-agent\",\n    44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n    45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    46\t    }),\n    47\t  });\n    48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n    49\t  return ((await res.json()) as { access_token: string }).access_token;\n    50\t}\n    51\t\n    52\texport async function checkEligibility(\n    53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n    54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n    55\t): Promise<Eligibility> {\n    56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n    57\t  const requestId = randomUUID();\n    58\t  const res = await fetch(env.eligibilityUrl, {\n    59\t    method: \"POST\",\n    60\t    signal: opts.signal,\n    61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    62\t    body: JSON.stringify({\n    63\t      jsonrpc: \"2.0\",\n    64\t      id: requestId,\n    65\t      method: \"message/send\",\n    66\t      params: {\n    67\t        message: {\n    68\t          role: \"user\",\n    69\t          messageId: requestId,\n    70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n    71\t        },\n    72\t      },\n    73\t    }),\n    74\t  });\n    75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n    76\t  const text = await res.text();\n    77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n    78\t  const rpc = Rpc.parse(JSON.parse(text));\n    79\t\n    80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n    81\t  const header = decodeProtectedHeader(attestation);\n    82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n    83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n    84\t  const { payload } = await jwtVerify(attestation, keys, {\n    85\t    issuer: env.eligibilityIssuer,\n    86\t    audience: \"clinic-agent\",\n    87\t    maxTokenAge: \"5m\",\n    88\t    algorithms: [\"ES256\"],\n    89\t  });\n    90\t  return Eligibility.parse(payload.eligibility);\n    91\t}\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n     5\t// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n     6\t// The provider enforces Idempotency-Key for 24 hours.\n     7\t\n     8\tconst sm = new SecretsManagerClient({ region: env.region });\n     9\tconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n    10\t\n    11\tasync function key(clinicId: string): Promise<string> {\n    12\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n    13\t  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n    14\t}\n    15\t\n    16\texport interface Refund {\n    17\t  id: string;\n    18\t  depositId: string;\n    19\t  amountCents: number;\n    20\t  status: \"pending\" | \"succeeded\" | \"failed\";\n    21\t}\n    22\t\n    23\texport const payments = {\n    24\t  async refundDeposit(\n    25\t    clinicId: string,\n    26\t    req: { depositId: string; reason: string; idempotencyKey: string },\n    27\t    signal?: AbortSignal,\n    28\t  ): Promise<Refund> {\n    29\t    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n    30\t      method: \"POST\",\n    31\t      signal,\n    32\t      headers: {\n    33\t        authorization: `Bearer ${await key(clinicId)}`,\n    34\t        \"content-type\": \"application/json\",\n    35\t        \"idempotency-key\": req.idempotencyKey,\n    36\t      },\n    37\t      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    38\t    });\n    39\t    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    40\t    return (await res.json()) as Refund;\n    41\t  },\n    42\t};\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n     5\t// can send; free-form text goes through sms__send_freeform, which needs approval.\n     6\t\n     7\tconst sm = new SecretsManagerClient({ region: env.region });\n     8\tconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n     9\t\n    10\texport const TEMPLATES = {\n    11\t  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n    12\t  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n    13\t  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n    14\t  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n    15\t} as const;\n    16\texport type TemplateId = keyof typeof TEMPLATES;\n    17\t\n    18\texport function render(id: TemplateId, vars: Record<string, string>): string {\n    19\t  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n    20\t}\n    21\t\n    22\tasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n    23\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n    24\t  const v = JSON.parse(s.SecretString ?? \"{}\");\n    25\t  return { token: v.api_token, from: v.from_number };\n    26\t}\n    27\t\n    28\texport const sms = {\n    29\t  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n    30\t    const c = await creds(clinicId);\n    31\t    const res = await fetch(`${BASE}/messages`, {\n    32\t      method: \"POST\",\n    33\t      signal,\n    34\t      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n    35\t      body: JSON.stringify({ from: c.from, to, body }),\n    36\t    });\n    37\t    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n    38\t    return (await res.json()) as { messageId: string };\n    39\t  },\n    40\t};\n     1\timport { audit } from \"../audit/recorder.js\";\n     2\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     3\timport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\n     4\timport { payments } from \"../integrations/payments.js\";\n     5\timport type { RunContext } from \"../agent/identity.js\";\n     6\timport type { ContextSize } from \"../agent/context-size.js\";\n     7\t\n     8\t// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n     9\t// agent, and settles the visit deposit when the plan covers the visit.\n    10\t\n    11\texport async function checkEligibilityForAppointment(\n    12\t  ehr: Ehr,\n    13\t  input: { appointmentId: string },\n    14\t  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n    15\t): Promise<Eligibility & { depositRefundId?: string }> {\n    16\t  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n    17\t\n    18\t  const result = await checkEligibility(\n    19\t    {\n    20\t      clinicId: opts.clinicId,\n    21\t      patientId: appt.patientId,\n    22\t      payerId: appt.payerId,\n    23\t      serviceCode: appt.serviceCode,\n    24\t      dateOfService: appt.start.slice(0, 10),\n    25\t    },\n    26\t    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n    27\t  );\n    28\t  await audit.record({\n    29\t    ...opts.ctx.identity(),\n    30\t    runId: opts.ctx.runId,\n    31\t    subject: opts.ctx.subject,\n    32\t    event: \"peer.call\",\n    33\t    tool: \"insurance__check_eligibility\",\n    34\t    context: opts.context,\n    35\t    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n    36\t  });\n    37\t\n    38\t  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n    39\t  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n    40\t    const refund = await payments.refundDeposit(\n    41\t      opts.clinicId,\n    42\t      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n    43\t      opts.signal,\n    44\t    );\n    45\t    await audit.record({\n    46\t      ...opts.ctx.identity(),\n    47\t      runId: opts.ctx.runId,\n    48\t      subject: opts.ctx.subject,\n    49\t      event: \"payment.refund\",\n    50\t      tool: \"insurance__check_eligibility\",\n    51\t      context: opts.context,\n    52\t      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n    53\t    });\n    54\t    return { ...result, depositRefundId: refund.id };\n    55\t  }\n    56\t  return result;\n    57\t}\n     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport { createHash, randomUUID } from \"node:crypto\";\n     4\timport { env, policy } from \"../config.js\";\n     5\t\n     6\t// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n     7\t// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n     8\t// approvedAt); the agent then retries the tool with the approval id.\n     9\t\n    10\texport interface ApprovalRecord {\n    11\t  id: string;\n    12\t  status: \"pending\" | \"approved\" | \"rejected\";\n    13\t  tool: string;\n    14\t  tenantId: string;\n    15\t  agentInstanceId: string;\n    16\t  runId: string;\n    17\t  argsHash: string;\n    18\t  summary: string;\n    19\t  requestedAt: string;\n    20\t  expiresAt: string;\n    21\t  approvedBy?: string;\n    22\t  approverRole?: string;\n    23\t  approvedAt?: string;\n    24\t}\n    25\t\n    26\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    27\t\n    28\texport function hashArgs(args: Record<string, unknown>): string {\n    29\t  const canonical = JSON.stringify(args, Object.keys(args).sort());\n    30\t  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n    31\t}\n    32\t\n    33\texport async function requestApproval(req: {\n    34\t  tool: string;\n    35\t  tenantId: string;\n    36\t  agentInstanceId: string;\n    37\t  runId: string;\n    38\t  args: Record<string, unknown>;\n    39\t  summary: string;\n    40\t}): Promise<ApprovalRecord> {\n    41\t  const now = Date.now();\n    42\t  const rec: ApprovalRecord = {\n    43\t    id: randomUUID(),\n    44\t    status: \"pending\",\n    45\t    tool: req.tool,\n    46\t    tenantId: req.tenantId,\n    47\t    agentInstanceId: req.agentInstanceId,\n    48\t    runId: req.runId,\n    49\t    argsHash: hashArgs(req.args),\n    50\t    summary: req.summary,\n    51\t    requestedAt: new Date(now).toISOString(),\n    52\t    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n    53\t  };\n    54\t  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n    55\t  return rec;\n    56\t}\n    57\t\n    58\texport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n    59\t\n    60\texport async function checkApproval(req: {\n    61\t  approvalId: string;\n    62\t  tool: string;\n    63\t  tenantId: string;\n    64\t  args: Record<string, unknown>;\n    65\t}): Promise<ApprovalCheck> {\n    66\t  let rec: ApprovalRecord | undefined;\n    67\t  try {\n    68\t    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    69\t    rec = res.Item as ApprovalRecord | undefined;\n    70\t  } catch (err) {\n    71\t    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n    72\t  }\n    73\t  if (!rec) return { ok: false, reason: \"approval not found\" };\n    74\t  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n    75\t  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n    76\t  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n    77\t  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n    78\t  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    79\t    return { ok: false, reason: \"approver lacks authority\" };\n    80\t  }\n    81\t  return { ok: true, approval: rec };\n    82\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_011GpmmLTFzc9zrfrKYAnmCj","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
