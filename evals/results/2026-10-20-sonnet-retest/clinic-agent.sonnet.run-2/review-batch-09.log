{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CrHyNeVPsM6dxykgpvYexH","type":"tool_result","content":"     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { allowlist, policy } from \"../config.js\";\n     3\timport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\n     4\timport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\n     5\timport type { ContextSize } from \"../agent/context-size.js\";\n     6\timport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\n     7\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     8\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     9\timport { payments } from \"../integrations/payments.js\";\n    10\timport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\n    11\timport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\n    12\timport { checkApproval, requestApproval } from \"./approvals.js\";\n    13\timport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n    14\t\n    15\texport interface Decision {\n    16\t  contextSize: ContextSize;\n    17\t  budget: RunBudget;\n    18\t}\n    19\t\n    20\tconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n    21\t// Arguments the harness consumes itself; they are never forwarded to a tool.\n    22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n    23\t\n    24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n    25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n    26\t}\n    27\t\n    28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n    29\t  return `${tool}(${Object.entries(args)\n    30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    31\t    .join(\", \")})`.slice(0, 500);\n    32\t}\n    33\t\n    34\texport async function executeTool(\n    35\t  registry: ToolRegistry,\n    36\t  ctx: RunContext,\n    37\t  call: Anthropic.ToolUseBlock,\n    38\t  d: Decision,\n    39\t): Promise<Anthropic.ToolResultBlockParam> {\n    40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n    41\t  const base = {\n    42\t    ...ctx.identity(),\n    43\t    runId: ctx.runId,\n    44\t    subject: ctx.subject,\n    45\t    tool: call.name,\n    46\t    toolUseId: call.id,\n    47\t    policyVersion: policy.version,\n    48\t    context: d.contextSize,\n    49\t  };\n    50\t  const deny = async (reason: string) => {\n    51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n    52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n    53\t  };\n    54\t\n    55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n    56\t  const tool = registry.get(call.name);\n    57\t  if (!tool) return deny(\"not_registered\");\n    58\t\n    59\t  await killSwitch.assertRunning(ctx.tenantId);\n    60\t  await d.budget.toolCall(call.name);\n    61\t\n    62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n    63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n    64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n    65\t\n    66\t  let approvalId: string | undefined;\n    67\t  if (policy.highImpactTools.includes(call.name)) {\n    68\t    if (typeof input.approvalId !== \"string\") {\n    69\t      const rec = await requestApproval({\n    70\t        tool: call.name,\n    71\t        tenantId: clinicId,\n    72\t        agentInstanceId: AGENT_INSTANCE_ID,\n    73\t        runId: ctx.runId,\n    74\t        args,\n    75\t        summary: summarize(call.name, args),\n    76\t      });\n    77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n    78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    79\t    }\n    80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    81\t    if (!check.ok) return deny(check.reason);\n    82\t    approvalId = check.approval.id;\n    83\t  }\n    84\t\n    85\t  try {\n    86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    88\t    const safe = redactPhi(raw);\n    89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    90\t    return toolResult(call.id, safe);\n    91\t  } catch (err) {\n    92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n    95\t  }\n    96\t}\n    97\t\n    98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n    99\t\n   100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n   101\t  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n   102\t    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n   103\t\n   104\t  return {\n   105\t    payments: [\n   106\t      {\n   107\t        name: \"refund_deposit\",\n   108\t        definition: {\n   109\t          name: \"payments__refund_deposit\",\n   110\t          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n   111\t          input_schema: {\n   112\t            type: \"object\",\n   113\t            properties: {\n   114\t              depositId: { type: \"string\" },\n   115\t              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n   116\t              approvalId: { type: \"string\" },\n   117\t            },\n   118\t            required: [\"depositId\", \"reason\"],\n   119\t          },\n   120\t        },\n   121\t        invoke: async (a, o) =>\n   122\t          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n   123\t      },\n   124\t    ],\n   125\t    sms: [\n   126\t      {\n   127\t        name: \"send_to_patient\",\n   128\t        definition: {\n   129\t          name: \"sms__send_to_patient\",\n   130\t          description: \"Send a templated SMS to the phone number on the patient's record.\",\n   131\t          input_schema: {\n   132\t            type: \"object\",\n   133\t            properties: {\n   134\t              patientId: { type: \"string\" },\n   135\t              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n   136\t              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n   137\t            },\n   138\t            required: [\"patientId\", \"template\"],\n   139\t          },\n   140\t        },\n   141\t        invoke: async (a, o) => {\n   142\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   143\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   144\t          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n   145\t          return sms.send(o.clinicId, c.phone, body, o.signal);\n   146\t        },\n   147\t      },\n   148\t      {\n   149\t        name: \"send_freeform\",\n   150\t        definition: {\n   151\t          name: \"sms__send_freeform\",\n   152\t          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n   153\t          input_schema: {\n   154\t            type: \"object\",\n   155\t            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n   156\t            required: [\"patientId\", \"body\"],\n   157\t          },\n   158\t        },\n   159\t        invoke: async (a, o) => {\n   160\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   161\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   162\t          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n   163\t        },\n   164\t      },\n   165\t    ],\n   166\t    insurance: [\n   167\t      {\n   168\t        name: \"check_eligibility\",\n   169\t        definition: {\n   170\t          name: \"insurance__check_eligibility\",\n   171\t          description: \"Check whether the patient's insurance covers an appointment.\",\n   172\t          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n   173\t        },\n   174\t        invoke: async (a, o) =>\n   175\t          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n   176\t            clinicId: o.clinicId,\n   177\t            ctx: o.runCtx as RunContext,\n   178\t            signal: o.signal,\n   179\t            context: o.context,\n   180\t          }),\n   181\t      },\n   182\t    ],\n   183\t  };\n   184\t}\n     1\t# syntax=docker/dockerfile:1.7\n     2\tFROM node:22.11-bookworm-slim@sha256:3f1a8d2c9b7e4f6a5d0c8b1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a AS build\n     3\tWORKDIR /app\n     4\tCOPY package.json package-lock.json ./\n     5\tRUN npm ci --ignore-scripts\n     6\tCOPY tsconfig.json ./\n     7\tCOPY src ./src\n     8\tRUN npm run build && npm prune --omit=dev\n     9\t\n    10\tFROM gcr.io/distroless/nodejs22-debian12:nonroot@sha256:9b2e4c6a8d0f1e3c5a7b9d1f3e5c7a9b1d3f5e7c9a1b3d5f7e9c1a3b5d7f9e1c\n    11\tWORKDIR /app\n    12\tENV NODE_ENV=production \\\n    13\t    CLINIC_AGENT_ROOT=/app\n    14\tCOPY --from=build --chown=65532:65532 /app/node_modules ./node_modules\n    15\tCOPY --from=build --chown=65532:65532 /app/dist ./dist\n    16\tCOPY --chown=65532:65532 package.json ./\n    17\tCOPY --chown=65532:65532 prompts ./prompts\n    18\tCOPY --chown=65532:65532 config ./config\n    19\tCOPY --chown=65532:65532 release ./release\n    20\tUSER 65532:65532\n    21\tEXPOSE 8080\n    22\tCMD [\"dist/server.js\"]\n     1\t{\n     2\t  \"name\": \"clinic-agent\",\n     3\t  \"version\": \"3.4.1\",\n     4\t  \"private\": true,\n     5\t  \"type\": \"module\",\n     6\t  \"engines\": {\n     7\t    \"node\": \">=22.11\"\n     8\t  },\n     9\t  \"scripts\": {\n    10\t    \"build\": \"tsc -p tsconfig.json\",\n    11\t    \"start\": \"node dist/server.js\",\n    12\t    \"reminders\": \"node dist/workers/reminders.js\",\n    13\t    \"lint\": \"eslint src test\",\n    14\t    \"test\": \"vitest run\"\n    15\t  },\n    16\t  \"dependencies\": {\n    17\t    \"@anthropic-ai/sdk\": \"0.65.0\",\n    18\t    \"@aws-sdk/client-dynamodb\": \"3.893.0\",\n    19\t    \"@aws-sdk/client-firehose\": \"3.893.0\",\n    20\t    \"@aws-sdk/client-secrets-manager\": \"3.893.0\",\n    21\t    \"@aws-sdk/lib-dynamodb\": \"3.893.0\",\n    22\t    \"@modelcontextprotocol/sdk\": \"1.18.2\",\n    23\t    \"fastify\": \"5.6.1\",\n    24\t    \"jose\": \"6.1.0\",\n    25\t    \"pino\": \"9.11.0\",\n    26\t    \"undici\": \"7.16.0\",\n    27\t    \"yaml\": \"2.8.1\",\n    28\t    \"zod\": \"3.25.76\"\n    29\t  },\n    30\t  \"devDependencies\": {\n    31\t    \"@types/node\": \"22.18.6\",\n    32\t    \"eslint\": \"9.36.0\",\n    33\t    \"typescript\": \"5.9.2\",\n    34\t    \"typescript-eslint\": \"8.44.1\",\n    35\t    \"vitest\": \"3.2.4\"\n    36\t  }\n    37\t}\n     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    16\t      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5.0.0\n    17\t        with:\n    18\t          node-version: \"22.11\"\n    19\t          cache: npm\n    20\t      - run: npm ci --ignore-scripts\n    21\t      - run: npm run lint\n    22\t      - run: npm test\n    23\t      - run: npm run build\n    24\t\n    25\t  manifest-check:\n    26\t    runs-on: ubuntu-24.04\n    27\t    steps:\n    28\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    29\t      - name: Prompt digests match the release manifest\n    30\t        run: |\n    31\t          node -e '\n    32\t            const fs = require(\"fs\"), crypto = require(\"crypto\");\n    33\t            const m = JSON.parse(fs.readFileSync(\"release/manifest.json\", \"utf8\"));\n    34\t            let bad = 0;\n    35\t            for (const p of m.prompts) {\n    36\t              const got = crypto.createHash(\"sha256\").update(fs.readFileSync(p.path)).digest(\"hex\");\n    37\t              if (got !== p.sha256) { console.error(`${p.path}: manifest ${p.sha256} != file ${got}`); bad++; }\n    38\t            }\n    39\t            const ver = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\")).version;\n    40\t            if (m.harness.version !== ver) { console.error(`harness version ${m.harness.version} != package ${ver}`); bad++; }\n    41\t            process.exit(bad ? 1 : 0);\n    42\t          '\n    43\t\n    44\t  image:\n    45\t    if: github.ref == 'refs/heads/main'\n    46\t    needs: [test, manifest-check]\n    47\t    runs-on: ubuntu-24.04\n    48\t    permissions:\n    49\t      contents: read\n    50\t      id-token: write\n    51\t      attestations: write\n    52\t      packages: write\n    53\t    steps:\n    54\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    55\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    56\t        with:\n    57\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-image-build\n    58\t          aws-region: us-west-2\n    59\t      - uses: aws-actions/amazon-ecr-login@062b18b96a7aff071d4dc91bc00c4c1a7945b076 # v2.0.1\n    60\t        id: ecr\n    61\t      - uses: docker/setup-buildx-action@e468171a9de216ec08956ac3ada2f0791b6bd435 # v3.11.1\n    62\t      - uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    63\t        id: build\n    64\t        with:\n    65\t          push: true\n    66\t          tags: ${{ steps.ecr.outputs.registry }}/clinic-agent:${{ github.sha }}\n    67\t          provenance: mode=max\n    68\t          sbom: true\n    69\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    70\t        with:\n    71\t          cosign-release: v2.6.2\n    72\t      - name: Sign image\n    73\t        run: cosign sign --yes ${{ steps.ecr.outputs.registry }}/clinic-agent@${{ steps.build.outputs.digest }}\n    74\t      - uses: actions/attest-build-provenance@977bb373ede98d70efdf65b84cb5f73e068dcc2a # v3.0.0\n    75\t        with:\n    76\t          subject-name: ${{ steps.ecr.outputs.registry }}/clinic-agent\n    77\t          subject-digest: ${{ steps.build.outputs.digest }}\n    78\t          push-to-registry: true\n     1\t# Hard limits enforced by src/agent/budget.ts, outside the model.\n     2\trun:\n     3\t  maxTurns: 8                 # model calls per run\n     4\t  maxWallMs: 45000            # whole run, including tool calls\n     5\t  maxInputTokens: 120000      # summed across model calls in the run\n     6\t  maxOutputTokens: 6000\n     7\t  maxCostUsd: 0.40\n     8\t  maxToolCalls: 16\n     9\t  maxToolCallsPerMinute: 12\n    10\t  maxPeerCalls: 2             # calls to the eligibility agent; this agent starts no sub-agents\n    11\t\n    12\tquotas:\n    13\t  # Daily spend and per-minute tool-call ceilings across many runs.\n    14\t  perSubjectDailyUsd: 2.00    # one patient or staff user\n    15\t  perTenantDailyUsd: 60.00    # one clinic\n    16\t  fleetDailyUsd: 900.00       # all clinics\n    17\t  perTenantToolCallsPerMinute: 240\n    18\t  fleetToolCallsPerMinute: 2400\n    19\t\n    20\tpricingUsdPerMTok:\n    21\t  claude-sonnet-4-5-20250929: { input: 3.00, output: 15.00, cacheRead: 0.30, cacheWrite: 3.75 }\n    22\t  claude-haiku-4-5-20251001: { input: 1.00, output: 5.00, cacheRead: 0.10, cacheWrite: 1.25 }\n    23\t\n    24\t# When a limit is hit the run stops, the stop is audited with the limit name, and the\n    25\t# conversation is handed to the clinic's front-desk queue.\n    26\tonExceed: handoff_to_staff\n     1\t# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\n     2\tpolicyVersion: \"2026-09-18.3\"\n     3\t\n     4\t# Tools that never run without a staff approval bound to the request.\n     5\thighImpactTools:\n     6\t  - ehr__cancel_appointment\n     7\t  - payments__refund_deposit\n     8\t  - sms__send_freeform\n     9\t\n    10\tapproval:\n    11\t  ttlSeconds: 900\n    12\t  approverRoles:\n    13\t    - front_desk_lead\n    14\t    - clinic_manager\n    15\t  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n    16\t  table: clinic-agent-approvals\n     1\t# Every tool the scheduling agent may call, with the task it serves.\n     2\t# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n     3\t# are not used for allow or approval decisions.\n     4\trole: scheduling_agent\n     5\ttools:\n     6\t  - tool: ehr__find_patient\n     7\t    reason: Match the sender to a patient record by date of birth and phone or email.\n     8\t  - tool: ehr__search_slots\n     9\t    reason: List open slots for a provider, location, and visit type.\n    10\t  - tool: ehr__get_appointment\n    11\t    reason: Read one appointment the patient asks about.\n    12\t  - tool: ehr__list_patient_appointments\n    13\t    reason: Show the patient their upcoming appointments.\n    14\t  - tool: ehr__book_appointment\n    15\t    reason: Book a slot the patient chose.\n    16\t  - tool: ehr__update_appointment\n    17\t    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n    18\t  - tool: ehr__cancel_appointment\n    19\t    reason: Cancel an appointment at the patient's request.\n    20\t  - tool: payments__refund_deposit\n    21\t    reason: Refund a no-show deposit after staff review.\n    22\t  - tool: sms__send_to_patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.\n     1\t# clinic-agent\n     2\t\n     3\tPatient-scheduling agent for the Northbay Clinic Group. Patients reach it by SMS or by the web chat\n     4\twidget on each clinic's site. It looks up, books, reschedules, and cancels appointments in the EHR,\n     5\tsends SMS reminders, refunds no-show deposits, and asks the insurance-eligibility agent whether a\n     6\tvisit is covered.\n     7\t\n     8\tEach clinic is a tenant. A clinic's patients, appointments, deposits, and EHR credentials are kept\n     9\tseparate from every other clinic's.\n    10\t\n    11\t## Components\n    12\t\n    13\t| Piece | Where | Notes |\n    14\t|---|---|---|\n    15\t| HTTP service (Fastify) | `src/server.ts` | `/v1/sms/inbound` webhook, `/v1/chat` web chat |\n    16\t| Agent loop | `src/agent/loop.ts` | Claude Sonnet 4.5 snapshot, tool use |\n    17\t| Intent classifier | `src/agent/classifier.ts` | Claude Haiku 4.5 snapshot, routes emergencies and complaints to staff |\n    18\t| Tool registry | `src/tools/registry.ts` | EHR MCP server plus native tools, scanned on load |\n    19\t| Tool executor | `src/tools/executor.ts` | allowlist, kill switch, budgets, approvals, audit |\n    20\t| EHR | `src/integrations/ehr-mcp.ts` | MCP over streamable HTTP with mTLS, per-clinic OAuth client |\n    21\t| Payments | `src/integrations/payments.ts` | deposit refunds, provider idempotency keys |\n    22\t| SMS | `src/integrations/sms.ts` | outbound reminders and replies |\n    23\t| Eligibility peer | `src/integrations/eligibility-a2a.ts` | A2A `message/send`, token exchange per call |\n    24\t| Reminder job | `src/workers/reminders.ts` | Kubernetes CronJob, 17:00 local each day |\n    25\t\n    26\tThere is no vector store and no conversation memory. Every run starts from the patient's message and\n    27\tthe EHR. Conversation transcripts are not stored by this service.\n    28\t\n    29\t## High-impact actions\n    30\t\n    31\t`config/policy.yaml` lists the tools that need a staff approval before they run. The agent asks for\n    32\tthe approval, a front-desk lead or clinic manager approves it in the staff console, and the agent\n    33\tretries with the approval ID. Approvals expire after 15 minutes.\n    34\t\n    35\t## Stopping the agent\n    36\t\n    37\tOperators with the `clinic-agent-ops` role set `halted = true` on the `global` item (all clinics) or a\n    38\t`tenant#<clinicId>` item in the `clinic-agent-control` DynamoDB table:\n    39\t\n    40\t```bash\n    41\taws dynamodb put-item --table-name clinic-agent-control \\\n    42\t  --item '{\"pk\":{\"S\":\"global\"},\"halted\":{\"BOOL\":true},\"by\":{\"S\":\"<you>\"}}'\n    43\t```\n    44\t\n    45\tRunning work checks the flag before each model turn and each tool call, and a watcher aborts in-flight\n    46\trequests within 2 seconds.\n    47\t\n    48\t## Identity\n    49\t\n    50\t`src/agent/identity.ts` computes the agent-type-id from the image digest, harness version, prompts,\n    51\tmodel IDs, and config. Each pod also gets a random agent-instance-id at start. Both are on every\n    52\taudit record together with the accountable party, operational owner, tenant, and trace context.\n    53\t\n    54\t## Build and test\n    55\t\n    56\t```bash\n    57\tnpm ci\n    58\tnpm run lint\n    59\tnpm test\n    60\tnpm run build\n    61\t```\n    62\t\n    63\t## Release\n    64\t\n    65\tMerges to `main` need two reviews and a code owner review for prompts, config, infra, and manifests.\n    66\t`deploy.yml` builds, signs, and deploys by digest to the `production` environment, which has required\n    67\treviewers. Emergency deploys use the same workflow with `emergency: true` and must name an owner,\n    68\ta reason, and an end date; the workflow opens a follow-up review issue.\n    69\t\n    70\t## Owners\n    71\t\n    72\t- Accountable party: Northbay Clinic Group, Patient Access (VP Patient Access)\n    73\t- Operational owner: agent-platform team, `#agent-platform-oncall`","is_error":false}]},"parent_tool_use_id":null,"session_id":"5b66f2e4-48ab-4c3d-8d4a-2cb61810e167","uuid":"a97889c1-9c09-4f9d-94d0-16ba9b7fcc43","timestamp":"2026-10-20T14:05:42.399Z","tool_use_result":{"stdout":"     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { allowlist, policy } from \"../config.js\";\n     3\timport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\n     4\timport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\n     5\timport type { ContextSize } from \"../agent/context-size.js\";\n     6\timport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\n     7\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     8\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     9\timport { payments } from \"../integrations/payments.js\";\n    10\timport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\n    11\timport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\n    12\timport { checkApproval, requestApproval } from \"./approvals.js\";\n    13\timport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n    14\t\n    15\texport interface Decision {\n    16\t  contextSize: ContextSize;\n    17\t  budget: RunBudget;\n    18\t}\n    19\t\n    20\tconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n    21\t// Arguments the harness consumes itself; they are never forwarded to a tool.\n    22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n    23\t\n    24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n    25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n    26\t}\n    27\t\n    28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n    29\t  return `${tool}(${Object.entries(args)\n    30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    31\t    .join(\", \")})`.slice(0, 500);\n    32\t}\n    33\t\n    34\texport async function executeTool(\n    35\t  registry: ToolRegistry,\n    36\t  ctx: RunContext,\n    37\t  call: Anthropic.ToolUseBlock,\n    38\t  d: Decision,\n    39\t): Promise<Anthropic.ToolResultBlockParam> {\n    40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n    41\t  const base = {\n    42\t    ...ctx.identity(),\n    43\t    runId: ctx.runId,\n    44\t    subject: ctx.subject,\n    45\t    tool: call.name,\n    46\t    toolUseId: call.id,\n    47\t    policyVersion: policy.version,\n    48\t    context: d.contextSize,\n    49\t  };\n    50\t  const deny = async (reason: string) => {\n    51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n    52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n    53\t  };\n    54\t\n    55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n    56\t  const tool = registry.get(call.name);\n    57\t  if (!tool) return deny(\"not_registered\");\n    58\t\n    59\t  await killSwitch.assertRunning(ctx.tenantId);\n    60\t  await d.budget.toolCall(call.name);\n    61\t\n    62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n    63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n    64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n    65\t\n    66\t  let approvalId: string | undefined;\n    67\t  if (policy.highImpactTools.includes(call.name)) {\n    68\t    if (typeof input.approvalId !== \"string\") {\n    69\t      const rec = await requestApproval({\n    70\t        tool: call.name,\n    71\t        tenantId: clinicId,\n    72\t        agentInstanceId: AGENT_INSTANCE_ID,\n    73\t        runId: ctx.runId,\n    74\t        args,\n    75\t        summary: summarize(call.name, args),\n    76\t      });\n    77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n    78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    79\t    }\n    80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    81\t    if (!check.ok) return deny(check.reason);\n    82\t    approvalId = check.approval.id;\n    83\t  }\n    84\t\n    85\t  try {\n    86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    88\t    const safe = redactPhi(raw);\n    89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    90\t    return toolResult(call.id, safe);\n    91\t  } catch (err) {\n    92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n    95\t  }\n    96\t}\n    97\t\n    98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n    99\t\n   100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n   101\t  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n   102\t    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n   103\t\n   104\t  return {\n   105\t    payments: [\n   106\t      {\n   107\t        name: \"refund_deposit\",\n   108\t        definition: {\n   109\t          name: \"payments__refund_deposit\",\n   110\t          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n   111\t          input_schema: {\n   112\t            type: \"object\",\n   113\t            properties: {\n   114\t              depositId: { type: \"string\" },\n   115\t              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n   116\t              approvalId: { type: \"string\" },\n   117\t            },\n   118\t            required: [\"depositId\", \"reason\"],\n   119\t          },\n   120\t        },\n   121\t        invoke: async (a, o) =>\n   122\t          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n   123\t      },\n   124\t    ],\n   125\t    sms: [\n   126\t      {\n   127\t        name: \"send_to_patient\",\n   128\t        definition: {\n   129\t          name: \"sms__send_to_patient\",\n   130\t          description: \"Send a templated SMS to the phone number on the patient's record.\",\n   131\t          input_schema: {\n   132\t            type: \"object\",\n   133\t            properties: {\n   134\t              patientId: { type: \"string\" },\n   135\t              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n   136\t              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n   137\t            },\n   138\t            required: [\"patientId\", \"template\"],\n   139\t          },\n   140\t        },\n   141\t        invoke: async (a, o) => {\n   142\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   143\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   144\t          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n   145\t          return sms.send(o.clinicId, c.phone, body, o.signal);\n   146\t        },\n   147\t      },\n   148\t      {\n   149\t        name: \"send_freeform\",\n   150\t        definition: {\n   151\t          name: \"sms__send_freeform\",\n   152\t          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n   153\t          input_schema: {\n   154\t            type: \"object\",\n   155\t            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n   156\t            required: [\"patientId\", \"body\"],\n   157\t          },\n   158\t        },\n   159\t        invoke: async (a, o) => {\n   160\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   161\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   162\t          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n   163\t        },\n   164\t      },\n   165\t    ],\n   166\t    insurance: [\n   167\t      {\n   168\t        name: \"check_eligibility\",\n   169\t        definition: {\n   170\t          name: \"insurance__check_eligibility\",\n   171\t          description: \"Check whether the patient's insurance covers an appointment.\",\n   172\t          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n   173\t        },\n   174\t        invoke: async (a, o) =>\n   175\t          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n   176\t            clinicId: o.clinicId,\n   177\t            ctx: o.runCtx as RunContext,\n   178\t            signal: o.signal,\n   179\t            context: o.context,\n   180\t          }),\n   181\t      },\n   182\t    ],\n   183\t  };\n   184\t}\n     1\t# syntax=docker/dockerfile:1.7\n     2\tFROM node:22.11-bookworm-slim@sha256:3f1a8d2c9b7e4f6a5d0c8b1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a AS build\n     3\tWORKDIR /app\n     4\tCOPY package.json package-lock.json ./\n     5\tRUN npm ci --ignore-scripts\n     6\tCOPY tsconfig.json ./\n     7\tCOPY src ./src\n     8\tRUN npm run build && npm prune --omit=dev\n     9\t\n    10\tFROM gcr.io/distroless/nodejs22-debian12:nonroot@sha256:9b2e4c6a8d0f1e3c5a7b9d1f3e5c7a9b1d3f5e7c9a1b3d5f7e9c1a3b5d7f9e1c\n    11\tWORKDIR /app\n    12\tENV NODE_ENV=production \\\n    13\t    CLINIC_AGENT_ROOT=/app\n    14\tCOPY --from=build --chown=65532:65532 /app/node_modules ./node_modules\n    15\tCOPY --from=build --chown=65532:65532 /app/dist ./dist\n    16\tCOPY --chown=65532:65532 package.json ./\n    17\tCOPY --chown=65532:65532 prompts ./prompts\n    18\tCOPY --chown=65532:65532 config ./config\n    19\tCOPY --chown=65532:65532 release ./release\n    20\tUSER 65532:65532\n    21\tEXPOSE 8080\n    22\tCMD [\"dist/server.js\"]\n     1\t{\n     2\t  \"name\": \"clinic-agent\",\n     3\t  \"version\": \"3.4.1\",\n     4\t  \"private\": true,\n     5\t  \"type\": \"module\",\n     6\t  \"engines\": {\n     7\t    \"node\": \">=22.11\"\n     8\t  },\n     9\t  \"scripts\": {\n    10\t    \"build\": \"tsc -p tsconfig.json\",\n    11\t    \"start\": \"node dist/server.js\",\n    12\t    \"reminders\": \"node dist/workers/reminders.js\",\n    13\t    \"lint\": \"eslint src test\",\n    14\t    \"test\": \"vitest run\"\n    15\t  },\n    16\t  \"dependencies\": {\n    17\t    \"@anthropic-ai/sdk\": \"0.65.0\",\n    18\t    \"@aws-sdk/client-dynamodb\": \"3.893.0\",\n    19\t    \"@aws-sdk/client-firehose\": \"3.893.0\",\n    20\t    \"@aws-sdk/client-secrets-manager\": \"3.893.0\",\n    21\t    \"@aws-sdk/lib-dynamodb\": \"3.893.0\",\n    22\t    \"@modelcontextprotocol/sdk\": \"1.18.2\",\n    23\t    \"fastify\": \"5.6.1\",\n    24\t    \"jose\": \"6.1.0\",\n    25\t    \"pino\": \"9.11.0\",\n    26\t    \"undici\": \"7.16.0\",\n    27\t    \"yaml\": \"2.8.1\",\n    28\t    \"zod\": \"3.25.76\"\n    29\t  },\n    30\t  \"devDependencies\": {\n    31\t    \"@types/node\": \"22.18.6\",\n    32\t    \"eslint\": \"9.36.0\",\n    33\t    \"typescript\": \"5.9.2\",\n    34\t    \"typescript-eslint\": \"8.44.1\",\n    35\t    \"vitest\": \"3.2.4\"\n    36\t  }\n    37\t}\n     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    16\t      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5.0.0\n    17\t        with:\n    18\t          node-version: \"22.11\"\n    19\t          cache: npm\n    20\t      - run: npm ci --ignore-scripts\n    21\t      - run: npm run lint\n    22\t      - run: npm test\n    23\t      - run: npm run build\n    24\t\n    25\t  manifest-check:\n    26\t    runs-on: ubuntu-24.04\n    27\t    steps:\n    28\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    29\t      - name: Prompt digests match the release manifest\n    30\t        run: |\n    31\t          node -e '\n    32\t            const fs = require(\"fs\"), crypto = require(\"crypto\");\n    33\t            const m = JSON.parse(fs.readFileSync(\"release/manifest.json\", \"utf8\"));\n    34\t            let bad = 0;\n    35\t            for (const p of m.prompts) {\n    36\t              const got = crypto.createHash(\"sha256\").update(fs.readFileSync(p.path)).digest(\"hex\");\n    37\t              if (got !== p.sha256) { console.error(`${p.path}: manifest ${p.sha256} != file ${got}`); bad++; }\n    38\t            }\n    39\t            const ver = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\")).version;\n    40\t            if (m.harness.version !== ver) { console.error(`harness version ${m.harness.version} != package ${ver}`); bad++; }\n    41\t            process.exit(bad ? 1 : 0);\n    42\t          '\n    43\t\n    44\t  image:\n    45\t    if: github.ref == 'refs/heads/main'\n    46\t    needs: [test, manifest-check]\n    47\t    runs-on: ubuntu-24.04\n    48\t    permissions:\n    49\t      contents: read\n    50\t      id-token: write\n    51\t      attestations: write\n    52\t      packages: write\n    53\t    steps:\n    54\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    55\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    56\t        with:\n    57\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-image-build\n    58\t          aws-region: us-west-2\n    59\t      - uses: aws-actions/amazon-ecr-login@062b18b96a7aff071d4dc91bc00c4c1a7945b076 # v2.0.1\n    60\t        id: ecr\n    61\t      - uses: docker/setup-buildx-action@e468171a9de216ec08956ac3ada2f0791b6bd435 # v3.11.1\n    62\t      - uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    63\t        id: build\n    64\t        with:\n    65\t          push: true\n    66\t          tags: ${{ steps.ecr.outputs.registry }}/clinic-agent:${{ github.sha }}\n    67\t          provenance: mode=max\n    68\t          sbom: true\n    69\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    70\t        with:\n    71\t          cosign-release: v2.6.2\n    72\t      - name: Sign image\n    73\t        run: cosign sign --yes ${{ steps.ecr.outputs.registry }}/clinic-agent@${{ steps.build.outputs.digest }}\n    74\t      - uses: actions/attest-build-provenance@977bb373ede98d70efdf65b84cb5f73e068dcc2a # v3.0.0\n    75\t        with:\n    76\t          subject-name: ${{ steps.ecr.outputs.registry }}/clinic-agent\n    77\t          subject-digest: ${{ steps.build.outputs.digest }}\n    78\t          push-to-registry: true\n     1\t# Hard limits enforced by src/agent/budget.ts, outside the model.\n     2\trun:\n     3\t  maxTurns: 8                 # model calls per run\n     4\t  maxWallMs: 45000            # whole run, including tool calls\n     5\t  maxInputTokens: 120000      # summed across model calls in the run\n     6\t  maxOutputTokens: 6000\n     7\t  maxCostUsd: 0.40\n     8\t  maxToolCalls: 16\n     9\t  maxToolCallsPerMinute: 12\n    10\t  maxPeerCalls: 2             # calls to the eligibility agent; this agent starts no sub-agents\n    11\t\n    12\tquotas:\n    13\t  # Daily spend and per-minute tool-call ceilings across many runs.\n    14\t  perSubjectDailyUsd: 2.00    # one patient or staff user\n    15\t  perTenantDailyUsd: 60.00    # one clinic\n    16\t  fleetDailyUsd: 900.00       # all clinics\n    17\t  perTenantToolCallsPerMinute: 240\n    18\t  fleetToolCallsPerMinute: 2400\n    19\t\n    20\tpricingUsdPerMTok:\n    21\t  claude-sonnet-4-5-20250929: { input: 3.00, output: 15.00, cacheRead: 0.30, cacheWrite: 3.75 }\n    22\t  claude-haiku-4-5-20251001: { input: 1.00, output: 5.00, cacheRead: 0.10, cacheWrite: 1.25 }\n    23\t\n    24\t# When a limit is hit the run stops, the stop is audited with the limit name, and the\n    25\t# conversation is handed to the clinic's front-desk queue.\n    26\tonExceed: handoff_to_staff\n     1\t# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\n     2\tpolicyVersion: \"2026-09-18.3\"\n     3\t\n     4\t# Tools that never run without a staff approval bound to the request.\n     5\thighImpactTools:\n     6\t  - ehr__cancel_appointment\n     7\t  - payments__refund_deposit\n     8\t  - sms__send_freeform\n     9\t\n    10\tapproval:\n    11\t  ttlSeconds: 900\n    12\t  approverRoles:\n    13\t    - front_desk_lead\n    14\t    - clinic_manager\n    15\t  # Approvals are recorded in DynamoDB table clinic-agent-approvals.\n    16\t  table: clinic-agent-approvals\n     1\t# Every tool the scheduling agent may call, with the task it serves.\n     2\t# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)\n     3\t# are not used for allow or approval decisions.\n     4\trole: scheduling_agent\n     5\ttools:\n     6\t  - tool: ehr__find_patient\n     7\t    reason: Match the sender to a patient record by date of birth and phone or email.\n     8\t  - tool: ehr__search_slots\n     9\t    reason: List open slots for a provider, location, and visit type.\n    10\t  - tool: ehr__get_appointment\n    11\t    reason: Read one appointment the patient asks about.\n    12\t  - tool: ehr__list_patient_appointments\n    13\t    reason: Show the patient their upcoming appointments.\n    14\t  - tool: ehr__book_appointment\n    15\t    reason: Book a slot the patient chose.\n    16\t  - tool: ehr__update_appointment\n    17\t    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.\n    18\t  - tool: ehr__cancel_appointment\n    19\t    reason: Cancel an appointment at the patient's request.\n    20\t  - tool: payments__refund_deposit\n    21\t    reason: Refund a no-show deposit after staff review.\n    22\t  - tool: sms__send_to_patient\n    23\t    reason: Send a templated message to the phone number on the patient's record.\n    24\t  - tool: sms__send_freeform\n    25\t    reason: Send a staff-approved message that is not one of the templates.\n    26\t  - tool: insurance__check_eligibility\n    27\t    reason: Ask the eligibility agent whether a visit is covered.\n     1\t# clinic-agent\n     2\t\n     3\tPatient-scheduling agent for the Northbay Clinic Group. Patients reach it by SMS or by the web chat\n     4\twidget on each clinic's site. It looks up, books, reschedules, and cancels appointments in the EHR,\n     5\tsends SMS reminders, refunds no-show deposits, and asks the insurance-eligibility agent whether a\n     6\tvisit is covered.\n     7\t\n     8\tEach clinic is a tenant. A clinic's patients, appointments, deposits, and EHR credentials are kept\n     9\tseparate from every other clinic's.\n    10\t\n    11\t## Components\n    12\t\n    13\t| Piece | Where | Notes |\n    14\t|---|---|---|\n    15\t| HTTP service (Fastify) | `src/server.ts` | `/v1/sms/inbound` webhook, `/v1/chat` web chat |\n    16\t| Agent loop | `src/agent/loop.ts` | Claude Sonnet 4.5 snapshot, tool use |\n    17\t| Intent classifier | `src/agent/classifier.ts` | Claude Haiku 4.5 snapshot, routes emergencies and complaints to staff |\n    18\t| Tool registry | `src/tools/registry.ts` | EHR MCP server plus native tools, scanned on load |\n    19\t| Tool executor | `src/tools/executor.ts` | allowlist, kill switch, budgets, approvals, audit |\n    20\t| EHR | `src/integrations/ehr-mcp.ts` | MCP over streamable HTTP with mTLS, per-clinic OAuth client |\n    21\t| Payments | `src/integrations/payments.ts` | deposit refunds, provider idempotency keys |\n    22\t| SMS | `src/integrations/sms.ts` | outbound reminders and replies |\n    23\t| Eligibility peer | `src/integrations/eligibility-a2a.ts` | A2A `message/send`, token exchange per call |\n    24\t| Reminder job | `src/workers/reminders.ts` | Kubernetes CronJob, 17:00 local each day |\n    25\t\n    26\tThere is no vector store and no conversation memory. Every run starts from the patient's message and\n    27\tthe EHR. Conversation transcripts are not stored by this service.\n    28\t\n    29\t## High-impact actions\n    30\t\n    31\t`config/policy.yaml` lists the tools that need a staff approval before they run. The agent asks for\n    32\tthe approval, a front-desk lead or clinic manager approves it in the staff console, and the agent\n    33\tretries with the approval ID. Approvals expire after 15 minutes.\n    34\t\n    35\t## Stopping the agent\n    36\t\n    37\tOperators with the `clinic-agent-ops` role set `halted = true` on the `global` item (all clinics) or a\n    38\t`tenant#<clinicId>` item in the `clinic-agent-control` DynamoDB table:\n    39\t\n    40\t```bash\n    41\taws dynamodb put-item --table-name clinic-agent-control \\\n    42\t  --item '{\"pk\":{\"S\":\"global\"},\"halted\":{\"BOOL\":true},\"by\":{\"S\":\"<you>\"}}'\n    43\t```\n    44\t\n    45\tRunning work checks the flag before each model turn and each tool call, and a watcher aborts in-flight\n    46\trequests within 2 seconds.\n    47\t\n    48\t## Identity\n    49\t\n    50\t`src/agent/identity.ts` computes the agent-type-id from the image digest, harness version, prompts,\n    51\tmodel IDs, and config. Each pod also gets a random agent-instance-id at start. Both are on every\n    52\taudit record together with the accountable party, operational owner, tenant, and trace context.\n    53\t\n    54\t## Build and test\n    55\t\n    56\t```bash\n    57\tnpm ci\n    58\tnpm run lint\n    59\tnpm test\n    60\tnpm run build\n    61\t```\n    62\t\n    63\t## Release\n    64\t\n    65\tMerges to `main` need two reviews and a code owner review for prompts, config, infra, and manifests.\n    66\t`deploy.yml` builds, signs, and deploys by digest to the `production` environment, which has required\n    67\treviewers. Emergency deploys use the same workflow with `emergency: true` and must name an owner,\n    68\ta reason, and an end date; the workflow opens a follow-up review issue.\n    69\t\n    70\t## Owners\n    71\t\n    72\t- Accountable party: Northbay Clinic Group, Patient Access (VP Patient Access)\n    73\t- Operational owner: agent-platform team, `#agent-platform-oncall`","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01CrHyNeVPsM6dxykgpvYexH","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
