{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H3BT2VTNG35Ucz84DYye4B","type":"tool_result","content":"     1\tname: deploy\n     2\t\n     3\t# Deploys the image digest named in release/manifest.json. The digest reaches the manifest through\n     4\t# a reviewed release PR, so what runs is always a reviewed commit.\n     5\ton:\n     6\t  workflow_dispatch:\n     7\t    inputs:\n     8\t      emergency:\n     9\t        description: Emergency change (hotfix/* branch, production-emergency environment)\n    10\t        type: boolean\n    11\t        default: false\n    12\t      owner:\n    13\t        description: Emergency only - person accountable for this change\n    14\t        type: string\n    15\t        default: \"\"\n    16\t      reason:\n    17\t        description: Emergency only - why this cannot wait for a normal release\n    18\t        type: string\n    19\t        default: \"\"\n    20\t      expires_on:\n    21\t        description: Emergency only - date (YYYY-MM-DD) by which it is replaced by a normal release\n    22\t        type: string\n    23\t        default: \"\"\n    24\t\n    25\tpermissions:\n    26\t  contents: read\n    27\t  id-token: write\n    28\t  issues: write\n    29\t\n    30\tconcurrency:\n    31\t  group: deploy-production\n    32\t  cancel-in-progress: false\n    33\t\n    34\tjobs:\n    35\t  deploy:\n    36\t    runs-on: ubuntu-24.04\n    37\t    environment: ${{ inputs.emergency && 'production-emergency' || 'production' }}\n    38\t    steps:\n    39\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    40\t\n    41\t      - name: Emergency change record is complete\n    42\t        if: inputs.emergency\n    43\t        env:\n    44\t          OWNER: ${{ inputs.owner }}\n    45\t          REASON: ${{ inputs.reason }}\n    46\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    47\t        run: |\n    48\t          test -n \"$OWNER\" || { echo \"owner is required\"; exit 1; }\n    49\t          test -n \"$REASON\" || { echo \"reason is required\"; exit 1; }\n    50\t          date -d \"$EXPIRES_ON\" +%F >/dev/null || { echo \"expires_on must be a date\"; exit 1; }\n    51\t          [[ \"$GITHUB_REF_NAME\" == hotfix/* ]] || { echo \"emergency deploys come from hotfix/* branches\"; exit 1; }\n    52\t\n    53\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    54\t        with:\n    55\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-deploy\n    56\t          aws-region: us-west-2\n    57\t\n    58\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    59\t        with:\n    60\t          cosign-release: v2.6.2\n    61\t\n    62\t      - name: Verify image signature\n    63\t        run: |\n    64\t          DIGEST=$(jq -r .image.digest release/manifest.json)\n    65\t          REPO=$(jq -r .image.repository release/manifest.json)\n    66\t          cosign verify \"$REPO@$DIGEST\" \\\n    67\t            --certificate-identity \"https://github.com/northbay-clinics/clinic-agent/.github/workflows/ci.yml@refs/heads/main\" \\\n    68\t            --certificate-oidc-issuer https://token.actions.githubusercontent.com\n    69\t          grep -q \"$DIGEST\" k8s/deployment.yaml || { echo \"k8s/deployment.yaml does not use the manifest digest\"; exit 1; }\n    70\t\n    71\t      - name: Apply\n    72\t        run: |\n    73\t          aws eks update-kubeconfig --name clinic-agent-prod\n    74\t          kubectl apply -f k8s/deployment.yaml\n    75\t          kubectl -n clinic-agent annotate deployment/clinic-agent --overwrite \\\n    76\t            northbay.example/git-sha=\"$GITHUB_SHA\" \\\n    77\t            northbay.example/release=\"$(jq -r .release release/manifest.json)\" \\\n    78\t            northbay.example/deployed-by=\"$GITHUB_ACTOR\" \\\n    79\t            northbay.example/run=\"$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID\"\n    80\t          kubectl -n clinic-agent rollout status deployment/clinic-agent --timeout=5m\n    81\t\n    82\t      - name: Open follow-up review for emergency change\n    83\t        if: inputs.emergency\n    84\t        env:\n    85\t          GH_TOKEN: ${{ github.token }}\n    86\t          OWNER: ${{ inputs.owner }}\n    87\t          REASON: ${{ inputs.reason }}\n    88\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    89\t        run: |\n    90\t          gh issue create \\\n    91\t            --title \"Follow-up review: emergency deploy ${GITHUB_SHA::8}\" \\\n    92\t            --label emergency-change,needs-review \\\n    93\t            --assignee \"$OWNER\" \\\n    94\t            --body \"Owner: $OWNER\n    95\t          Reason: $REASON\n    96\t          Ends: $EXPIRES_ON\n    97\t          Commit: $GITHUB_SHA\n    98\t          Approved in environment production-emergency by a required reviewer (see run $GITHUB_RUN_ID).\n    99\t          Review and merge to main via normal PR before the end date.\"\n     1\timport { createHash, randomUUID } from \"node:crypto\";\n     2\timport { readdirSync, readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n     5\t\n     6\t// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n     7\t// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\n     8\tconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n     9\t\n    10\texport interface TypeIdInputs {\n    11\t  imageDigest: string;\n    12\t  harnessVersion: string;\n    13\t  harnessGitSha: string;\n    14\t}\n    15\t\n    16\texport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n    17\t  const parts: Array<[string, Buffer]> = [\n    18\t    [\"image\", Buffer.from(inputs.imageDigest)],\n    19\t    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    20\t    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n    21\t  ];\n    22\t  const promptDir = join(ROOT, \"prompts\");\n    23\t  const promptFiles = readdirSync(promptDir)\n    24\t    .filter((f) => f.endsWith(\".txt\"))\n    25\t    .sort();\n    26\t  for (const f of promptFiles) {\n    27\t    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n    28\t  }\n    29\t  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n    30\t  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n    31\t  for (const f of CONFIG_FILES) {\n    32\t    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n    33\t  }\n    34\t  return parts;\n    35\t}\n    36\t\n    37\texport function computeAgentTypeId(inputs: TypeIdInputs): string {\n    38\t  const h = createHash(\"sha256\");\n    39\t  for (const [label, bytes] of typeIdManifest(inputs)) {\n    40\t    h.update(label);\n    41\t    h.update(\"\\0\");\n    42\t    h.update(bytes);\n    43\t    h.update(\"\\0\");\n    44\t  }\n    45\t  return `sha256:${h.digest(\"hex\")}`;\n    46\t}\n    47\t\n    48\t// One instance id per process. Pods are the unit an operator contains.\n    49\texport const AGENT_INSTANCE_ID = randomUUID();\n    50\t\n    51\tlet AGENT_TYPE_ID = \"\";\n    52\texport function setAgentTypeId(id: string): void {\n    53\t  AGENT_TYPE_ID = id;\n    54\t}\n    55\t\n    56\texport interface Subject {\n    57\t  kind: \"patient\" | \"staff\" | \"system\";\n    58\t  id: string;\n    59\t}\n    60\t\n    61\texport interface Logger {\n    62\t  info(obj: object, msg?: string): void;\n    63\t  warn(obj: object, msg?: string): void;\n    64\t  error(obj: object, msg?: string): void;\n    65\t}\n    66\t\n    67\texport interface RunContext {\n    68\t  runId: string;\n    69\t  tenantId: string;\n    70\t  subject: Subject;\n    71\t  channel: \"sms\" | \"webchat\" | \"reminder\";\n    72\t  traceparent: string;\n    73\t  log: Logger;\n    74\t  identity(): {\n    75\t    accountableParty: string;\n    76\t    operationalOwner: string;\n    77\t    tenantId: string;\n    78\t    agentTypeId: string;\n    79\t    agentInstanceId: string;\n    80\t    traceparent: string;\n    81\t  };\n    82\t  workloadToken(): Promise<string>;\n    83\t}\n    84\t\n    85\t// Projected service-account token (audience: the group STS), rotated by the kubelet.\n    86\tconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n    87\t\n    88\texport function newRunContext(init: {\n    89\t  tenantId: string;\n    90\t  subject: Subject;\n    91\t  channel: RunContext[\"channel\"];\n    92\t  traceparent?: string;\n    93\t  log: Logger;\n    94\t}): RunContext {\n    95\t  const runId = randomUUID();\n    96\t  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n    97\t  return {\n    98\t    runId,\n    99\t    tenantId: init.tenantId,\n   100\t    subject: init.subject,\n   101\t    channel: init.channel,\n   102\t    traceparent,\n   103\t    log: init.log,\n   104\t    identity: () => ({\n   105\t      accountableParty: env.accountableParty,\n   106\t      operationalOwner: env.operationalOwner,\n   107\t      tenantId: init.tenantId,\n   108\t      agentTypeId: AGENT_TYPE_ID,\n   109\t      agentInstanceId: AGENT_INSTANCE_ID,\n   110\t      traceparent,\n   111\t    }),\n   112\t    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n   113\t  };\n   114\t}\n     1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n     7\t//\n     8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n     9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n    10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n    11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n    12\t//\n    13\t// Answers come back as a signed attestation (JWS) inside a data part.\n    14\t\n    15\tconst Eligibility = z\n    16\t  .object({\n    17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    18\t    planName: z.string().max(120).optional(),\n    19\t    copayCents: z.number().int().nonnegative().optional(),\n    20\t    depositWaived: z.boolean().default(false),\n    21\t    checkedAt: z.string().datetime(),\n    22\t  })\n    23\t  .strict();\n    24\texport type Eligibility = z.infer<typeof Eligibility>;\n    25\t\n    26\tconst Rpc = z.object({\n    27\t  jsonrpc: z.literal(\"2.0\"),\n    28\t  id: z.string(),\n    29\t  result: z.object({\n    30\t    kind: z.literal(\"message\"),\n    31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n    32\t  }),\n    33\t});\n    34\t\n    35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n    36\t  const res = await fetch(env.tokenExchangeUrl, {\n    37\t    method: \"POST\",\n    38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    39\t    body: new URLSearchParams({\n    40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    41\t      subject_token: workloadToken,\n    42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n    43\t      audience: \"eligibility-agent\",\n    44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n    45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    46\t    }),\n    47\t  });\n    48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n    49\t  return ((await res.json()) as { access_token: string }).access_token;\n    50\t}\n    51\t\n    52\texport async function checkEligibility(\n    53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n    54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n    55\t): Promise<Eligibility> {\n    56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n    57\t  const requestId = randomUUID();\n    58\t  const res = await fetch(env.eligibilityUrl, {\n    59\t    method: \"POST\",\n    60\t    signal: opts.signal,\n    61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    62\t    body: JSON.stringify({\n    63\t      jsonrpc: \"2.0\",\n    64\t      id: requestId,\n    65\t      method: \"message/send\",\n    66\t      params: {\n    67\t        message: {\n    68\t          role: \"user\",\n    69\t          messageId: requestId,\n    70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n    71\t        },\n    72\t      },\n    73\t    }),\n    74\t  });\n    75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n    76\t  const text = await res.text();\n    77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n    78\t  const rpc = Rpc.parse(JSON.parse(text));\n    79\t\n    80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n    81\t  const header = decodeProtectedHeader(attestation);\n    82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n    83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n    84\t  const { payload } = await jwtVerify(attestation, keys, {\n    85\t    issuer: env.eligibilityIssuer,\n    86\t    audience: \"clinic-agent\",\n    87\t    maxTokenAge: \"5m\",\n    88\t    algorithms: [\"ES256\"],\n    89\t  });\n    90\t  return Eligibility.parse(payload.eligibility);\n    91\t}\n     1\timport { audit } from \"../audit/recorder.js\";\n     2\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     3\timport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\n     4\timport { payments } from \"../integrations/payments.js\";\n     5\timport type { RunContext } from \"../agent/identity.js\";\n     6\timport type { ContextSize } from \"../agent/context-size.js\";\n     7\t\n     8\t// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n     9\t// agent, and settles the visit deposit when the plan covers the visit.\n    10\t\n    11\texport async function checkEligibilityForAppointment(\n    12\t  ehr: Ehr,\n    13\t  input: { appointmentId: string },\n    14\t  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n    15\t): Promise<Eligibility & { depositRefundId?: string }> {\n    16\t  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n    17\t\n    18\t  const result = await checkEligibility(\n    19\t    {\n    20\t      clinicId: opts.clinicId,\n    21\t      patientId: appt.patientId,\n    22\t      payerId: appt.payerId,\n    23\t      serviceCode: appt.serviceCode,\n    24\t      dateOfService: appt.start.slice(0, 10),\n    25\t    },\n    26\t    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n    27\t  );\n    28\t  await audit.record({\n    29\t    ...opts.ctx.identity(),\n    30\t    runId: opts.ctx.runId,\n    31\t    subject: opts.ctx.subject,\n    32\t    event: \"peer.call\",\n    33\t    tool: \"insurance__check_eligibility\",\n    34\t    context: opts.context,\n    35\t    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n    36\t  });\n    37\t\n    38\t  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n    39\t  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n    40\t    const refund = await payments.refundDeposit(\n    41\t      opts.clinicId,\n    42\t      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n    43\t      opts.signal,\n    44\t    );\n    45\t    await audit.record({\n    46\t      ...opts.ctx.identity(),\n    47\t      runId: opts.ctx.runId,\n    48\t      subject: opts.ctx.subject,\n    49\t      event: \"payment.refund\",\n    50\t      tool: \"insurance__check_eligibility\",\n    51\t      context: opts.context,\n    52\t      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n    53\t    });\n    54\t    return { ...result, depositRefundId: refund.id };\n    55\t  }\n    56\t  return result;\n    57\t}\ninfra/terraform/github.tf:14:resource \"github_branch_protection\" \"main\" {\ninfra/terraform/github.tf:38:resource \"github_repository_environment\" \"production\" {\ninfra/terraform/github.tf:51:resource \"github_repository_environment\" \"production_emergency\" {\ninfra/terraform/github.tf:64:resource \"github_repository_environment_deployment_policy\" \"emergency_branches\" {\ninfra/terraform/github.tf:70:resource \"aws_iam_role\" \"deploy\" {\ninfra/terraform/github.tf:76:      Principal = { Federated = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/token.actions.githubusercontent.com\" }\ninfra/terraform/github.tf:77:      Action    = \"sts:AssumeRoleWithWebIdentity\"\ninfra/terraform/github.tf:80:          \"token.actions.githubusercontent.com:aud\" = \"sts.amazonaws.com\"\ninfra/terraform/github.tf:81:          \"token.actions.githubusercontent.com:sub\" = [\ninfra/terraform/github.tf:91:resource \"aws_iam_role_policy\" \"deploy\" {\ninfra/terraform/github.tf:99:        Action   = [\"ecr:GetAuthorizationToken\"]\ninfra/terraform/github.tf:100:        Resource = \"*\"\ninfra/terraform/github.tf:104:        Action   = [\"ecr:BatchCheckLayerAvailability\", \"ecr:PutImage\", \"ecr:InitiateLayerUpload\", \"ecr:UploadLayerPart\", \"ecr:CompleteLayerUpload\", \"ecr:BatchGetImage\"]\ninfra/terraform/github.tf:105:        Resource = aws_ecr_repository.agent.arn\ninfra/terraform/github.tf:109:        Action   = [\"eks:DescribeCluster\"]\ninfra/terraform/github.tf:110:        Resource = module.eks.cluster_arn\ninfra/terraform/iam.tf:3:resource \"aws_iam_role\" \"runtime\" {\ninfra/terraform/iam.tf:10:      Principal = { Federated = module.eks.oidc_provider_arn }\ninfra/terraform/iam.tf:11:      Action    = \"sts:AssumeRoleWithWebIdentity\"\ninfra/terraform/iam.tf:25:resource \"aws_iam_role_policy\" \"runtime\" {\ninfra/terraform/iam.tf:34:        Action   = [\"secretsmanager:GetSecretValue\"]\ninfra/terraform/iam.tf:35:        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\ninfra/terraform/iam.tf:40:        Action = [\ninfra/terraform/iam.tf:47:        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*\"\ninfra/terraform/iam.tf:52:        Action   = [\"firehose:PutRecord\", \"firehose:PutRecordBatch\"]\ninfra/terraform/iam.tf:53:        Resource = aws_kinesis_firehose_delivery_stream.audit.arn\ninfra/terraform/iam.tf:60:resource \"aws_iam_role\" \"ops_killswitch\" {\ninfra/terraform/iam.tf:66:      Principal = { AWS = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\" }\ninfra/terraform/iam.tf:67:      Action    = \"sts:AssumeRole\"\ninfra/terraform/iam.tf:69:        StringLike = { \"aws:PrincipalArn\" = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*\" }\ninfra/terraform/iam.tf:75:resource \"aws_iam_role_policy\" \"ops_killswitch\" {\ninfra/terraform/iam.tf:82:      Action   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:GetItem\"]\ninfra/terraform/iam.tf:83:      Resource = aws_dynamodb_table.control.arn\ninfra/terraform/iam.tf:88:resource \"aws_iam_role\" \"firehose\" {\ninfra/terraform/iam.tf:89:  name = \"clinic-agent-audit-firehose\"\ninfra/terraform/iam.tf:92:    Statement = [{ Effect = \"Allow\", Principal = { Service = \"firehose.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\ninfra/terraform/iam.tf:96:resource \"aws_iam_role_policy\" \"firehose\" {\ninfra/terraform/iam.tf:97:  name = \"write-audit-bucket\"\ninfra/terraform/iam.tf:98:  role = aws_iam_role.firehose.id\ninfra/terraform/iam.tf:103:      Action   = [\"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:GetBucketLocation\"]\ninfra/terraform/iam.tf:104:      Resource = [aws_s3_bucket.audit.arn, \"${aws_s3_bucket.audit.arn}/*\"]\ninfra/terraform/main.tf:8:    bucket         = \"northbay-tfstate-418295730611\"\ninfra/terraform/main.tf:50:      principal_arn = aws_iam_role.deploy.arn\ninfra/terraform/main.tf:63:      ami_type       = \"BOTTLEROCKET_ARM_64\"\ninfra/terraform/main.tf:89:resource \"aws_ecr_repository\" \"agent\" {\ninfra/terraform/main.tf:97:resource \"aws_dynamodb_table\" \"approvals\" {\ninfra/terraform/main.tf:108:resource \"aws_dynamodb_table\" \"budgets\" {\ninfra/terraform/main.tf:116:  ttl {\ninfra/terraform/main.tf:117:    attribute_name = \"expiresAt\"\ninfra/terraform/main.tf:122:resource \"aws_dynamodb_table\" \"control\" {\ninfra/terraform/main.tf:133:# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).\ninfra/terraform/main.tf:134:resource \"aws_s3_bucket\" \"audit\" {\ninfra/terraform/main.tf:135:  bucket              = \"clinic-agent-audit-${data.aws_caller_identity.current.account_id}\"\ninfra/terraform/main.tf:139:resource \"aws_s3_bucket_object_lock_configuration\" \"audit\" {\ninfra/terraform/main.tf:140:  bucket = aws_s3_bucket.audit.id\ninfra/terraform/main.tf:142:    default_retention {\ninfra/terraform/main.tf:149:resource \"aws_kinesis_firehose_delivery_stream\" \"audit\" {\ninfra/terraform/main.tf:153:    role_arn            = aws_iam_role.firehose.arn\ninfra/terraform/main.tf:154:    bucket_arn          = aws_s3_bucket.audit.arn\ninfra/terraform/main.tf:156:    error_output_prefix = \"audit-errors/!{firehose:error-output-type}/\"\ninfra/terraform/main.tf:161:resource \"aws_secretsmanager_secret\" \"ehr\" {\ninfra/terraform/main.tf:166:resource \"aws_secretsmanager_secret\" \"payments\" {\ninfra/terraform/main.tf:171:resource \"aws_secretsmanager_secret\" \"sms\" {\ninfra/terraform/main.tf:176:resource \"aws_secretsmanager_secret\" \"sms_signing\" {\n43:  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n44:  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n62:      hostUsers: false\n63:      hostNetwork: false\n64:      hostPID: false\n65:      hostIPC: false\n76:          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n134:          hostUsers: false\n143:              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n159:# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n165:  name: clinic-agent-egress\n169:  policyTypes: [\"Egress\", \"Ingress\"]\n176:  egress:\n189:            matchLabels: { app: egress-proxy }\n191:        - { port: 3128, protocol: TCP }\n193:        - ipBlock: { cidr: 10.60.12.0/28 }\n195:        - { port: 443, protocol: TCP }\n# Security-relevant paths need a review from the platform leads in addition to the two\n# approvals required by branch protection (infra/terraform/github.tf).\n*                    @northbay-clinics/clinic-agent-devs\n/prompts/            @northbay-clinics/agent-platform-leads\n/config/             @northbay-clinics/agent-platform-leads\n/release/            @northbay-clinics/agent-platform-leads\n/infra/              @northbay-clinics/agent-platform-leads @northbay-clinics/cloud-security\n/k8s/                @northbay-clinics/agent-platform-leads @northbay-clinics/cloud-security\n/.github/            @northbay-clinics/agent-platform-leads @northbay-clinics/cloud-security\n/src/tools/          @northbay-clinics/agent-platform-leads\n/src/control/        @northbay-clinics/agent-platform-leads\n/src/audit/          @northbay-clinics/agent-platform-leads\n    30\t  classifierId: string;\n    31\t  requestedModel: string;\n    32\t  servedModel: string | null;\n    33\t  intent: z.infer<typeof Intent> | null;\n    34\t  confidence: number | null;\n    35\t  route: Route;\n    36\t  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n    37\t}\n    38\t\n    39\tconst MIN_CONFIDENCE = 0.6;\n    40\t\n    41\texport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n    42\t  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n    43\t  let res: Anthropic.Message;\n    44\t  try {\n    45\t    res = await client.messages.create(\n    46\t      {\n    47\t        model: CLASSIFIER_MODEL,\n    48\t        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n    49\t        temperature: CLASSIFIER_CONFIG.temperature,\n    50\t        system: CLASSIFIER_PROMPT,\n    51\t        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n    52\t      },\n    53\t      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n    54\t    );\n    55\t  } catch (err) {\n    56\t    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n    57\t    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n    58\t  }\n    59\t\n    60\t  if (res.model !== CLASSIFIER_MODEL) {\n    61\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n    62\t  }\n    63\t\n    64\t  const textOut = res.content.find((b) => b.type === \"text\");\n    65\t  let parsed: z.infer<typeof Output>;\n    66\t  try {\n    67\t    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n    68\t  } catch {\n    69\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n    70\t  }\n    71\t\n    72\t  if (parsed.confidence < MIN_CONFIDENCE) {\n    73\t    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n    74\t  }\n    75\t  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n    76\t  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n    77\t}\ninfra:\nterraform\n\ninfra/terraform:\ngithub.tf\niam.tf\nmain.tf\n\ntest:\nbudget.test.ts\ncontrols.test.ts","is_error":false}]},"parent_tool_use_id":null,"session_id":"5b66f2e4-48ab-4c3d-8d4a-2cb61810e167","uuid":"4802b596-80d7-4f78-a617-ca26286f16d1","timestamp":"2026-10-20T14:05:48.691Z","tool_use_result":{"stdout":"     1\tname: deploy\n     2\t\n     3\t# Deploys the image digest named in release/manifest.json. The digest reaches the manifest through\n     4\t# a reviewed release PR, so what runs is always a reviewed commit.\n     5\ton:\n     6\t  workflow_dispatch:\n     7\t    inputs:\n     8\t      emergency:\n     9\t        description: Emergency change (hotfix/* branch, production-emergency environment)\n    10\t        type: boolean\n    11\t        default: false\n    12\t      owner:\n    13\t        description: Emergency only - person accountable for this change\n    14\t        type: string\n    15\t        default: \"\"\n    16\t      reason:\n    17\t        description: Emergency only - why this cannot wait for a normal release\n    18\t        type: string\n    19\t        default: \"\"\n    20\t      expires_on:\n    21\t        description: Emergency only - date (YYYY-MM-DD) by which it is replaced by a normal release\n    22\t        type: string\n    23\t        default: \"\"\n    24\t\n    25\tpermissions:\n    26\t  contents: read\n    27\t  id-token: write\n    28\t  issues: write\n    29\t\n    30\tconcurrency:\n    31\t  group: deploy-production\n    32\t  cancel-in-progress: false\n    33\t\n    34\tjobs:\n    35\t  deploy:\n    36\t    runs-on: ubuntu-24.04\n    37\t    environment: ${{ inputs.emergency && 'production-emergency' || 'production' }}\n    38\t    steps:\n    39\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n    40\t\n    41\t      - name: Emergency change record is complete\n    42\t        if: inputs.emergency\n    43\t        env:\n    44\t          OWNER: ${{ inputs.owner }}\n    45\t          REASON: ${{ inputs.reason }}\n    46\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    47\t        run: |\n    48\t          test -n \"$OWNER\" || { echo \"owner is required\"; exit 1; }\n    49\t          test -n \"$REASON\" || { echo \"reason is required\"; exit 1; }\n    50\t          date -d \"$EXPIRES_ON\" +%F >/dev/null || { echo \"expires_on must be a date\"; exit 1; }\n    51\t          [[ \"$GITHUB_REF_NAME\" == hotfix/* ]] || { echo \"emergency deploys come from hotfix/* branches\"; exit 1; }\n    52\t\n    53\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    54\t        with:\n    55\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-deploy\n    56\t          aws-region: us-west-2\n    57\t\n    58\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    59\t        with:\n    60\t          cosign-release: v2.6.2\n    61\t\n    62\t      - name: Verify image signature\n    63\t        run: |\n    64\t          DIGEST=$(jq -r .image.digest release/manifest.json)\n    65\t          REPO=$(jq -r .image.repository release/manifest.json)\n    66\t          cosign verify \"$REPO@$DIGEST\" \\\n    67\t            --certificate-identity \"https://github.com/northbay-clinics/clinic-agent/.github/workflows/ci.yml@refs/heads/main\" \\\n    68\t            --certificate-oidc-issuer https://token.actions.githubusercontent.com\n    69\t          grep -q \"$DIGEST\" k8s/deployment.yaml || { echo \"k8s/deployment.yaml does not use the manifest digest\"; exit 1; }\n    70\t\n    71\t      - name: Apply\n    72\t        run: |\n    73\t          aws eks update-kubeconfig --name clinic-agent-prod\n    74\t          kubectl apply -f k8s/deployment.yaml\n    75\t          kubectl -n clinic-agent annotate deployment/clinic-agent --overwrite \\\n    76\t            northbay.example/git-sha=\"$GITHUB_SHA\" \\\n    77\t            northbay.example/release=\"$(jq -r .release release/manifest.json)\" \\\n    78\t            northbay.example/deployed-by=\"$GITHUB_ACTOR\" \\\n    79\t            northbay.example/run=\"$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID\"\n    80\t          kubectl -n clinic-agent rollout status deployment/clinic-agent --timeout=5m\n    81\t\n    82\t      - name: Open follow-up review for emergency change\n    83\t        if: inputs.emergency\n    84\t        env:\n    85\t          GH_TOKEN: ${{ github.token }}\n    86\t          OWNER: ${{ inputs.owner }}\n    87\t          REASON: ${{ inputs.reason }}\n    88\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    89\t        run: |\n    90\t          gh issue create \\\n    91\t            --title \"Follow-up review: emergency deploy ${GITHUB_SHA::8}\" \\\n    92\t            --label emergency-change,needs-review \\\n    93\t            --assignee \"$OWNER\" \\\n    94\t            --body \"Owner: $OWNER\n    95\t          Reason: $REASON\n    96\t          Ends: $EXPIRES_ON\n    97\t          Commit: $GITHUB_SHA\n    98\t          Approved in environment production-emergency by a required reviewer (see run $GITHUB_RUN_ID).\n    99\t          Review and merge to main via normal PR before the end date.\"\n     1\timport { createHash, randomUUID } from \"node:crypto\";\n     2\timport { readdirSync, readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n     5\t\n     6\t// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n     7\t// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\n     8\tconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n     9\t\n    10\texport interface TypeIdInputs {\n    11\t  imageDigest: string;\n    12\t  harnessVersion: string;\n    13\t  harnessGitSha: string;\n    14\t}\n    15\t\n    16\texport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n    17\t  const parts: Array<[string, Buffer]> = [\n    18\t    [\"image\", Buffer.from(inputs.imageDigest)],\n    19\t    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    20\t    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n    21\t  ];\n    22\t  const promptDir = join(ROOT, \"prompts\");\n    23\t  const promptFiles = readdirSync(promptDir)\n    24\t    .filter((f) => f.endsWith(\".txt\"))\n    25\t    .sort();\n    26\t  for (const f of promptFiles) {\n    27\t    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n    28\t  }\n    29\t  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n    30\t  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n    31\t  for (const f of CONFIG_FILES) {\n    32\t    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n    33\t  }\n    34\t  return parts;\n    35\t}\n    36\t\n    37\texport function computeAgentTypeId(inputs: TypeIdInputs): string {\n    38\t  const h = createHash(\"sha256\");\n    39\t  for (const [label, bytes] of typeIdManifest(inputs)) {\n    40\t    h.update(label);\n    41\t    h.update(\"\\0\");\n    42\t    h.update(bytes);\n    43\t    h.update(\"\\0\");\n    44\t  }\n    45\t  return `sha256:${h.digest(\"hex\")}`;\n    46\t}\n    47\t\n    48\t// One instance id per process. Pods are the unit an operator contains.\n    49\texport const AGENT_INSTANCE_ID = randomUUID();\n    50\t\n    51\tlet AGENT_TYPE_ID = \"\";\n    52\texport function setAgentTypeId(id: string): void {\n    53\t  AGENT_TYPE_ID = id;\n    54\t}\n    55\t\n    56\texport interface Subject {\n    57\t  kind: \"patient\" | \"staff\" | \"system\";\n    58\t  id: string;\n    59\t}\n    60\t\n    61\texport interface Logger {\n    62\t  info(obj: object, msg?: string): void;\n    63\t  warn(obj: object, msg?: string): void;\n    64\t  error(obj: object, msg?: string): void;\n    65\t}\n    66\t\n    67\texport interface RunContext {\n    68\t  runId: string;\n    69\t  tenantId: string;\n    70\t  subject: Subject;\n    71\t  channel: \"sms\" | \"webchat\" | \"reminder\";\n    72\t  traceparent: string;\n    73\t  log: Logger;\n    74\t  identity(): {\n    75\t    accountableParty: string;\n    76\t    operationalOwner: string;\n    77\t    tenantId: string;\n    78\t    agentTypeId: string;\n    79\t    agentInstanceId: string;\n    80\t    traceparent: string;\n    81\t  };\n    82\t  workloadToken(): Promise<string>;\n    83\t}\n    84\t\n    85\t// Projected service-account token (audience: the group STS), rotated by the kubelet.\n    86\tconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n    87\t\n    88\texport function newRunContext(init: {\n    89\t  tenantId: string;\n    90\t  subject: Subject;\n    91\t  channel: RunContext[\"channel\"];\n    92\t  traceparent?: string;\n    93\t  log: Logger;\n    94\t}): RunContext {\n    95\t  const runId = randomUUID();\n    96\t  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n    97\t  return {\n    98\t    runId,\n    99\t    tenantId: init.tenantId,\n   100\t    subject: init.subject,\n   101\t    channel: init.channel,\n   102\t    traceparent,\n   103\t    log: init.log,\n   104\t    identity: () => ({\n   105\t      accountableParty: env.accountableParty,\n   106\t      operationalOwner: env.operationalOwner,\n   107\t      tenantId: init.tenantId,\n   108\t      agentTypeId: AGENT_TYPE_ID,\n   109\t      agentInstanceId: AGENT_INSTANCE_ID,\n   110\t      traceparent,\n   111\t    }),\n   112\t    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n   113\t  };\n   114\t}\n     1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n     7\t//\n     8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n     9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n    10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n    11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n    12\t//\n    13\t// Answers come back as a signed attestation (JWS) inside a data part.\n    14\t\n    15\tconst Eligibility = z\n    16\t  .object({\n    17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    18\t    planName: z.string().max(120).optional(),\n    19\t    copayCents: z.number().int().nonnegative().optional(),\n    20\t    depositWaived: z.boolean().default(false),\n    21\t    checkedAt: z.string().datetime(),\n    22\t  })\n    23\t  .strict();\n    24\texport type Eligibility = z.infer<typeof Eligibility>;\n    25\t\n    26\tconst Rpc = z.object({\n    27\t  jsonrpc: z.literal(\"2.0\"),\n    28\t  id: z.string(),\n    29\t  result: z.object({\n    30\t    kind: z.literal(\"message\"),\n    31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n    32\t  }),\n    33\t});\n    34\t\n    35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n    36\t  const res = await fetch(env.tokenExchangeUrl, {\n    37\t    method: \"POST\",\n    38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    39\t    body: new URLSearchParams({\n    40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    41\t      subject_token: workloadToken,\n    42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n    43\t      audience: \"eligibility-agent\",\n    44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n    45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    46\t    }),\n    47\t  });\n    48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n    49\t  return ((await res.json()) as { access_token: string }).access_token;\n    50\t}\n    51\t\n    52\texport async function checkEligibility(\n    53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n    54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n    55\t): Promise<Eligibility> {\n    56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n    57\t  const requestId = randomUUID();\n    58\t  const res = await fetch(env.eligibilityUrl, {\n    59\t    method: \"POST\",\n    60\t    signal: opts.signal,\n    61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    62\t    body: JSON.stringify({\n    63\t      jsonrpc: \"2.0\",\n    64\t      id: requestId,\n    65\t      method: \"message/send\",\n    66\t      params: {\n    67\t        message: {\n    68\t          role: \"user\",\n    69\t          messageId: requestId,\n    70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n    71\t        },\n    72\t      },\n    73\t    }),\n    74\t  });\n    75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n    76\t  const text = await res.text();\n    77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n    78\t  const rpc = Rpc.parse(JSON.parse(text));\n    79\t\n    80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n    81\t  const header = decodeProtectedHeader(attestation);\n    82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n    83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n    84\t  const { payload } = await jwtVerify(attestation, keys, {\n    85\t    issuer: env.eligibilityIssuer,\n    86\t    audience: \"clinic-agent\",\n    87\t    maxTokenAge: \"5m\",\n    88\t    algorithms: [\"ES256\"],\n    89\t  });\n    90\t  return Eligibility.parse(payload.eligibility);\n    91\t}\n     1\timport { audit } from \"../audit/recorder.js\";\n     2\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     3\timport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\n     4\timport { payments } from \"../integrations/payments.js\";\n     5\timport type { RunContext } from \"../agent/identity.js\";\n     6\timport type { ContextSize } from \"../agent/context-size.js\";\n     7\t\n     8\t// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n     9\t// agent, and settles the visit deposit when the plan covers the visit.\n    10\t\n    11\texport async function checkEligibilityForAppointment(\n    12\t  ehr: Ehr,\n    13\t  input: { appointmentId: string },\n    14\t  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n    15\t): Promise<Eligibility & { depositRefundId?: string }> {\n    16\t  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n    17\t\n    18\t  const result = await checkEligibility(\n    19\t    {\n    20\t      clinicId: opts.clinicId,\n    21\t      patientId: appt.patientId,\n    22\t      payerId: appt.payerId,\n    23\t      serviceCode: appt.serviceCode,\n    24\t      dateOfService: appt.start.slice(0, 10),\n    25\t    },\n    26\t    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n    27\t  );\n    28\t  await audit.record({\n    29\t    ...opts.ctx.identity(),\n    30\t    runId: opts.ctx.runId,\n    31\t    subject: opts.ctx.subject,\n    32\t    event: \"peer.call\",\n    33\t    tool: \"insurance__check_eligibility\",\n    34\t    context: opts.context,\n    35\t    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n    36\t  });\n    37\t\n    38\t  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n    39\t  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n    40\t    const refund = await payments.refundDeposit(\n    41\t      opts.clinicId,\n    42\t      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n    43\t      opts.signal,\n    44\t    );\n    45\t    await audit.record({\n    46\t      ...opts.ctx.identity(),\n    47\t      runId: opts.ctx.runId,\n    48\t      subject: opts.ctx.subject,\n    49\t      event: \"payment.refund\",\n    50\t      tool: \"insurance__check_eligibility\",\n    51\t      context: opts.context,\n    52\t      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n    53\t    });\n    54\t    return { ...result, depositRefundId: refund.id };\n    55\t  }\n    56\t  return result;\n    57\t}\ninfra/terraform/github.tf:14:resource \"github_branch_protection\" \"main\" {\ninfra/terraform/github.tf:38:resource \"github_repository_environment\" \"production\" {\ninfra/terraform/github.tf:51:resource \"github_repository_environment\" \"production_emergency\" {\ninfra/terraform/github.tf:64:resource \"github_repository_environment_deployment_policy\" \"emergency_branches\" {\ninfra/terraform/github.tf:70:resource \"aws_iam_role\" \"deploy\" {\ninfra/terraform/github.tf:76:      Principal = { Federated = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/token.actions.githubusercontent.com\" }\ninfra/terraform/github.tf:77:      Action    = \"sts:AssumeRoleWithWebIdentity\"\ninfra/terraform/github.tf:80:          \"token.actions.githubusercontent.com:aud\" = \"sts.amazonaws.com\"\ninfra/terraform/github.tf:81:          \"token.actions.githubusercontent.com:sub\" = [\ninfra/terraform/github.tf:91:resource \"aws_iam_role_policy\" \"deploy\" {\ninfra/terraform/github.tf:99:        Action   = [\"ecr:GetAuthorizationToken\"]\ninfra/terraform/github.tf:100:        Resource = \"*\"\ninfra/terraform/github.tf:104:        Action   = [\"ecr:BatchCheckLayerAvailability\", \"ecr:PutImage\", \"ecr:InitiateLayerUpload\", \"ecr:UploadLayerPart\", \"ecr:CompleteLayerUpload\", \"ecr:BatchGetImage\"]\ninfra/terraform/gi