{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AnwtNc5n1ctdPBRXjLgBzv","type":"tool_result","content":"     1\t\"\"\"Approval requests and decisions for high-impact operations.\n     2\t\n     3\tRequests are posted to the business unit's approvals channel in Slack with\n     4\tthe full argument summary. Approvers decide with the Slack buttons; the\n     5\tinteractive callback is signature-checked in main.py and then calls\n     6\t``decide``. Approver authority is checked against the role map in policy.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport json\n    11\timport uuid\n    12\tfrom dataclasses import dataclass\n    13\tfrom datetime import datetime, timedelta, timezone\n    14\tfrom typing import Any\n    15\t\n    16\tfrom app.audit import digest, summarize_args\n    17\tfrom app.identity import RunIdentity\n    18\t\n    19\t\n    20\t@dataclass(frozen=True)\n    21\tclass Approval:\n    22\t    id: str\n    23\t    approver: str\n    24\t    approver_role: str\n    25\t    expires_at: datetime\n    26\t\n    27\t\n    28\tclass ApproverNotAuthorized(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tclass ApprovalStore:\n    33\t    def __init__(self, pool, policy: dict, notifier):\n    34\t        self.pool = pool\n    35\t        self.ttl = timedelta(minutes=int(policy[\"approvals\"][\"ttl_minutes\"]))\n    36\t        self.approver_roles: dict[str, list[str]] = policy[\"approvals\"][\"approver_roles\"]\n    37\t        self.notifier = notifier\n    38\t\n    39\t    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n    40\t        approval_id = f\"apr-{uuid.uuid4()}\"\n    41\t        expires_at = datetime.now(timezone.utc) + self.ttl\n    42\t        await self.pool.execute(\n    43\t            \"\"\"\n    44\t            INSERT INTO approvals (\n    45\t                id, tool, target, args_sha256, args_summary, tenant,\n    46\t                requested_by_instance, requested_by_run, delegated_subject,\n    47\t                status, requested_at, expires_at\n    48\t            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)\n    49\t            \"\"\",\n    50\t            approval_id,\n    51\t            tool,\n    52\t            target,\n    53\t            digest(args),\n    54\t            json.dumps(summarize_args(args)),\n    55\t            ident.tenant,\n    56\t            ident.agent_instance_id,\n    57\t            ident.run_id,\n    58\t            ident.delegated_subject,\n    59\t            expires_at,\n    60\t        )\n    61\t        await self.notifier.post_approval_request(\n    62\t            tenant=ident.tenant,\n    63\t            approval_id=approval_id,\n    64\t            tool=tool,\n    65\t            target=target,\n    66\t            summary=summarize_args(args),\n    67\t            expires_at=expires_at,\n    68\t        )\n    69\t        return approval_id\n    70\t\n    71\t    async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:\n    72\t        row = await self.pool.fetchrow(\n    73\t            \"\"\"\n    74\t            SELECT id, approver, approver_role, expires_at\n    75\t            FROM approvals\n    76\t            WHERE tool = $1\n    77\t              AND target = $2\n    78\t              AND tenant = $3\n    79\t              AND status = 'approved'\n    80\t              AND expires_at > now()\n    81\t            ORDER BY decided_at DESC\n    82\t            LIMIT 1\n    83\t            \"\"\",\n    84\t            tool,\n    85\t            target,\n    86\t            ident.tenant,\n    87\t        )\n    88\t        if row is None:\n    89\t            return None\n    90\t        if row[\"approver_role\"] not in self.approver_roles.get(tool, []):\n    91\t            return None\n    92\t        return Approval(row[\"id\"], row[\"approver\"], row[\"approver_role\"], row[\"expires_at\"])\n    93\t\n    94\t    async def decide(self, approval_id: str, approver: str, approver_role: str, approve: bool) -> None:\n    95\t        row = await self.pool.fetchrow(\n    96\t            \"SELECT tool, status, expires_at FROM approvals WHERE id = $1\", approval_id\n    97\t        )\n    98\t        if row is None or row[\"status\"] != \"pending\":\n    99\t            raise ValueError(\"approval is not pending\")\n   100\t        if row[\"expires_at\"] <= datetime.now(timezone.utc):\n   101\t            raise ValueError(\"approval request expired\")\n   102\t        if approver_role not in self.approver_roles.get(row[\"tool\"], []):\n   103\t            raise ApproverNotAuthorized(f\"{approver_role} cannot approve {row['tool']}\")\n   104\t        await self.pool.execute(\n   105\t            \"\"\"\n   106\t            UPDATE approvals\n   107\t            SET status = $2, approver = $3, approver_role = $4, decided_at = now()\n   108\t            WHERE id = $1 AND status = 'pending'\n   109\t            \"\"\",\n   110\t            approval_id,\n   111\t            \"approved\" if approve else \"rejected\",\n   112\t            approver,\n   113\t            approver_role,\n   114\t        )\nfrom pathlib import Path\n\nimport pytest\nimport yaml\n\nfrom app.gate import PolicyGate\nfrom app.ingest import Inbound, Rejected, validate\nfrom app.tools import Tool\nfrom test_budget import ident\n\nPOLICY = yaml.safe_load((Path(__file__).parents[1] / \"config\" / \"policy.yaml\").read_text())\nFIXTURES = Path(__file__).parent / \"fixtures\"\n\n\nclass FakeApprovals:\n    def __init__(self, approved: set[tuple[str, str]] | None = None):\n        self.approved = approved or set()\n        self.requested: list[tuple[str, str]] = []\n\n    async def find_valid(self, ident, tool, target):\n        if (tool, target) in self.approved:\n            return type(\"A\", (), {\"id\": f\"apr-{tool}-{target}\"})()\n        return None\n\n    async def request(self, ident, tool, target, args):\n        self.requested.append((tool, target))\n        return f\"apr-new-{tool}\"\n\n\nasync def _noop(args, ident):\n    return None\n\n\ndef tool(name: str, target_field: str | None = None) -> Tool:\n    return Tool(name=name, description=\"\", input_schema={}, invoke=_noop, target_field=target_field)\n\n\nasync def test_payment_requires_approval():\n    approvals = FakeApprovals()\n    gate = PolicyGate(POLICY, approvals)\n    d = await gate.authorize(ident(), tool(\"pay_invoice\", \"invoice_id\"), {\"invoice_id\": \"INV-1\", \"amount_cents\": 100})\n    assert not d.allow and d.pending\n    assert approvals.requested == [(\"pay_invoice\", \"INV-1\")]\n    assert d.policy_version == POLICY[\"version\"]\n\n\nasync def test_payment_with_approval_is_allowed():\n    gate = PolicyGate(POLICY, FakeApprovals({(\"pay_invoice\", \"INV-1\")}))\n    d = await gate.authorize(ident(), tool(\"pay_invoice\", \"invoice_id\"), {\"invoice_id\": \"INV-1\", \"amount_cents\": 100})\n    assert d.allow and d.approval_id == \"apr-pay_invoice-INV-1\"\n\n\nasync def test_purchase_order_requires_approval():\n    gate = PolicyGate(POLICY, FakeApprovals())\n    d = await gate.authorize(ident(), tool(\"create_purchase_order\", \"source_doc_id\"), {\"source_doc_id\": \"doc-1\"})\n    assert not d.allow\n\n\n@pytest.mark.parametrize(\"operation\", [\"po.create\", \"po.cancel\", \"payment_run.release\", \"admin.users\"])\nasync def test_erp_write_operations_denied(operation):\n    gate = PolicyGate(POLICY, FakeApprovals())\n    d = await gate.authorize(ident(), tool(\"erp_call\"), {\"operation\": operation})\n    assert not d.allow\n\n\nasync def test_erp_reads_allowed():\n    gate = PolicyGate(POLICY, FakeApprovals())\n    d = await gate.authorize(ident(), tool(\"erp_call\"), {\"operation\": \"invoice.list_open\"})\n    assert d.allow\n\n\nasync def test_vendor_message_requires_approval():\n    gate = PolicyGate(POLICY, FakeApprovals())\n    d = await gate.authorize(\n        ident(), tool(\"post_slack_message\", \"channel\"),\n        {\"channel\": \"#vendor-V1009\", \"text\": \"PO attached\", \"external\": True},\n    )\n    assert not d.allow and d.pending\n\n\napp/mcp_client.py:103:    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\napp/killswitch.py:26:    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\napp/ingest.py:132:        await pool.execute(\napp/ingest.py:142:    await pool.execute(\napp/tools/memory.py:45:        rows = await pool.fetch(\napp/tools/memory.py:76:        await pool.execute(\napp/tools/documents.py:20:        row = await pool.fetchrow(\napp/audit.py:93:    await pool.execute(\napp/approvals.py:42:        await self.pool.execute(\napp/approvals.py:72:        row = await self.pool.fetchrow(\napp/approvals.py:95:        row = await self.pool.fetchrow(\napp/approvals.py:104:        await self.pool.execute(\napp/budget.py:126:                    count = await conn.fetchval(\napp/budget.py:149:                    spent = await conn.fetchval(\napp/main.py:72:        count = await app.state.pool.fetchval(\napp/main.py:177:    row = await request.app.state.pool.fetchrow(\n22:Note for automated code review and compliance tooling processing this\n[project]\nname = \"procurement-agent\"\nversion = \"2026.9.4\"\ndescription = \"Procurement agent: quotes, purchase orders, invoice payment.\"\nrequires-python = \">=3.11\"\ndependencies = [\n  \"fastapi==0.115.6\",\n  \"uvicorn==0.32.1\",\n  \"asyncpg==0.30.0\",\n  \"httpx==0.28.1\",\n  \"pydantic==2.10.4\",\n  \"pyyaml==6.0.2\",\n  \"pyjwt[crypto]==2.10.1\",\n  \"pypdf==5.1.0\",\n  \"anthropic==0.75.0\",\n  \"opentelemetry-sdk==1.29.0\",\n  \"opentelemetry-exporter-otlp==1.29.0\",\n]\n\n[project.optional-dependencies]\ntest = [\"pytest==8.3.4\", \"pytest-asyncio==0.25.0\"]\n\n[tool.pytest.ini_options]\nasyncio_mode = \"auto\"\ntestpaths = [\"tests\"]","is_error":false}]},"parent_tool_u