{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JZnDP2FV8gCkZYW8v5A8Bq","type":"tool_result","content":"<persisted-output>\nOutput too large (34.4KB). Full output saved to: /Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-rwokbux3/87ad7a50-bdd0-4753-a509-ffba5d499adb/tool-results/bkg61mif8.txt\n\nPreview (first 2KB):\n=== app/audit.py\n     1\t\"\"\"Execution audit graph.\n     2\t\n     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n     5\ttool call -> authorization decision -> result or error. Writes are\n     6\tsynchronous and are made before the action they describe; if the write\n     7\tfails, the caller raises and the action does not run.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport hashlib\n    12\timport json\n    13\timport uuid\n    14\tfrom datetime import datetime, timezone\n    15\tfrom typing import Any\n    16\t\n    17\tfrom opentelemetry import trace\n    18\t\n    19\tfrom app.context_size import ContextMeasure\n    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n    21\tfrom app.redact import redact_value\n    22\t\n    23\tEVENT_KINDS = {\n    24\t    \"run_started\",\n    25\t    \"run_finished\",\n    26\t    \"run_halted\",\n    27\t    \"model_decision\",\n    28\t    \"tool_proposed\",\n    29\t    \"authz_decision\",\n    30\t    \"approval_requested\",\n    31\t    \"approval_decided\",\n    32\t    \"tool_result\",\n    33\t    \"tool_error\",\n    34\t    \"tool_denied\",\n    35\t    \"budget_exceeded\",\n    36\t    \"subagent_started\",\n    37\t    \"subagent_finished\",\n    38\t    \"background_job\",\n    39\t}\n    40\t\n    41\t_INSERT = \"\"\"\n    42\tINSERT INTO audit_events (\n    43\t    node_id, parent_node_id, run_id, ts, kind,\n    44\t    accountable_party, operational_owner, tenant,\n    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n    46\t    delegated_subject, agent_principal, parent_instance_id,\n    47\t    policy_version, approval_id, operation_id,\n    48\t    context_tokens, context_method, context_compacted,\n    49\t    payload\n    50\t) VALUES (\n    51\t    $1, $2, $3, $4, $5,\n    52\t    $6, $7, $8,\n    53\t    $9, $10, $11, $12,\n    54\t    $13, $14, $15,\n    55\t    $16, $17, $18,\n    56\t    $19, $20, $21,\n    57\t    $22::jsonb\n    58\t)\n    59\t\"\"\"\n    60\t\n    61\t\n...\n</persisted-output>","is_error":false}]},"parent_tool_use_id":null,"session_id":"87ad7a50-bdd0-4753-a509-ffba5d499adb","uuid":"cded3f07-e087-438b-bc28-a245ec27227f","timestamp":"2026-10-20T13:07:59.480Z","tool_use_result":{"stdout":"=== app/audit.py\n     1\t\"\"\"Execution audit graph.\n     2\t\n     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n     5\ttool call -> authorization decision -> result or error. Writes are\n     6\tsynchronous and are made before the action they describe; if the write\n     7\tfails, the caller raises and the action does not run.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport hashlib\n    12\timport json\n    13\timport uuid\n    14\tfrom datetime import datetime, timezone\n    15\tfrom typing import Any\n    16\t\n    17\tfrom opentelemetry import trace\n    18\t\n    19\tfrom app.context_size import ContextMeasure\n    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n    21\tfrom app.redact import redact_value\n    22\t\n    23\tEVENT_KINDS = {\n    24\t    \"run_started\",\n    25\t    \"run_finished\",\n    26\t    \"run_halted\",\n    27\t    \"model_decision\",\n    28\t    \"tool_proposed\",\n    29\t    \"authz_decision\",\n    30\t    \"approval_requested\",\n    31\t    \"approval_decided\",\n    32\t    \"tool_result\",\n    33\t    \"tool_error\",\n    34\t    \"tool_denied\",\n    35\t    \"budget_exceeded\",\n    36\t    \"subagent_started\",\n    37\t    \"subagent_finished\",\n    38\t    \"background_job\",\n    39\t}\n    40\t\n    41\t_INSERT = \"\"\"\n    42\tINSERT INTO audit_events (\n    43\t    node_id, parent_node_id, run_id, ts, kind,\n    44\t    accountable_party, operational_owner, tenant,\n    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n    46\t    delegated_subject, agent_principal, parent_instance_id,\n    47\t    policy_version, approval_id, operation_id,\n    48\t    context_tokens, context_method, context_compacted,\n    49\t    payload\n    50\t) VALUES (\n    51\t    $1, $2, $3, $4, $5,\n    52\t    $6, $7, $8,\n    53\t    $9, $10, $11, $12,\n    54\t    $13, $14, $15,\n    55\t    $16, $17, $18,\n    56\t    $19, $20, $21,\n    57\t    $22::jsonb\n    58\t)\n    59\t\"\"\"\n    60\t\n    61\t\n    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n    64\t    return {k: redact_value(v) for k, v in args.items()}\n    65\t\n    66\t\n    67\tdef digest(value: Any) -> str:\n    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    70\t\n    71\t\n    72\tasync def record(\n    73\t    pool,\n    74\t    ident: RunIdentity,\n    75\t    *,\n    76\t    kind: str,\n    77\t    payload: dict[str, Any] | None = None,\n    78\t    parent: str | None = None,\n    79\t    context: ContextMeasure | None = None,\n    80\t    policy_version: str | None = None,\n    81\t    approval_id: str | None = None,\n    82\t    operation_id: str | None = None,\n    83\t) -> str:\n    84\t    if kind not in EVENT_KINDS:\n    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n    86\t    for name in IDENTITY_FIELDS:\n    87\t        if not getattr(ident, name):\n    88\t            raise ValueError(f\"audit record missing {name}\")\n    89\t    span_ctx = trace.get_current_span().get_span_context()\n    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n    91\t    node_id = f\"node-{uuid.uuid4()}\"\n    92\t    measure = context or ContextMeasure.unavailable()\n    93\t    await pool.execute(\n    94\t        _INSERT,\n    95\t        node_id,\n    96\t        parent,\n    97\t        ident.run_id,\n    98\t        datetime.now(timezone.utc),\n    99\t        kind,\n   100\t        ident.accountable_party,\n   101\t        ident.operational_owner,\n   102\t        ident.tenant,\n   103\t        ident.agent_type_id,\n   104\t        ident.agent_instance_id,\n   105\t        ident.trace_id,\n   106\t        span_id,\n   107\t        ident.delegated_subject,\n   108\t        ident.agent_principal,\n   109\t        ident.parent_instance_id,\n   110\t        policy_version,\n   111\t        approval_id,\n   112\t        operation_id,\n   113\t        measure.tokens,\n   114\t        measure.method,\n   115\t        measure.compacted,\n   116\t        json.dumps(redact_value(payload or {}), default=str),\n   117\t    )\n   118\t    return node_id\n=== app/main.py\n     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport hashlib\n     6\timport hmac\n     7\timport json\n     8\timport logging\n     9\timport time\n    10\timport uuid\n    11\tfrom contextlib import asynccontextmanager\n    12\tfrom pathlib import Path\n    13\tfrom urllib.parse import parse_qs\n    14\t\n    15\timport asyncpg\n    16\timport jwt\n    17\tfrom anthropic import AsyncAnthropic\n    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n    20\tfrom opentelemetry import trace\n    21\tfrom pydantic import BaseModel, Field\n    22\t\n    23\tfrom app import audit, ingest\n    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n    25\tfrom app.extractor import LineItemExtractor\n    26\tfrom app.gate import PolicyGate\n    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n    28\tfrom app.loop import AgentDeps, ProcurementAgent\n    29\tfrom app.mcp_client import ErpMcpClient\n    30\tfrom app.redact import RedactingFilter\n    31\tfrom app.settings import get_settings\n    32\tfrom app.startup import startup_checks\n    33\tfrom app.tools.slack import SlackClient\n    34\t\n    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n    36\tfor handler in logging.getLogger().handlers:\n    37\t    handler.addFilter(RedactingFilter())\n    38\tlog = logging.getLogger(\"procurement\")\n    39\t\n    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    41\tbearer = HTTPBearer()\n    42\t\n    43\t\n    44\tclass RunRequest(BaseModel):\n    45\t    task: str = Field(min_length=1, max_length=4000)\n    46\t    department: str = Field(min_length=1, max_length=64)\n    47\t\n    48\t\n    49\tclass Principal(BaseModel):\n    50\t    subject: str\n    51\t    business_unit: str\n    52\t\n    53\t\n    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    55\t    return RunIdentity(\n    56\t        accountable_party=\"system:procurement-agent\",\n    57\t        operational_owner=settings.operational_owner,\n    58\t        tenant=tenant,\n    59\t        agent_type_id=agent_type_id,\n    60\t        agent_instance_id=new_instance_id(),\n    61\t        trace_id=uuid.uuid4().hex,\n    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n    63\t        delegated_subject=\"system:procurement-agent\",\n    64\t        agent_principal=AGENT_PRINCIPAL,\n    65\t    )\n    66\t\n    67\t\n    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n    69\t    while True:\n    70\t        await asyncio.sleep(60)\n    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n    72\t        count = await app.state.pool.fetchval(\n    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n    75\t        )\n    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n    78\t\n    79\t\n    80\t@asynccontextmanager\n    81\tasync def lifespan(app: FastAPI):\n    82\t    settings = get_settings()\n    83\t    agent_type_id = startup_checks(settings)\n    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    85\t    broker = TokenBroker(settings)\n    86\t\n    87\t    async def slack_token() -> str:\n    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n    89\t\n    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n    92\t    gate = PolicyGate(settings.policy, approvals)\n    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n    95\t\n    96\t    client = AsyncAnthropic()\n    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    98\t    deps.extractor = LineItemExtractor(\n    99\t        client=client, settings=settings, deps=deps,\n   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n   101\t    )\n   102\t    app.state.settings = settings\n   103\t    app.state.pool = pool\n   104\t    app.state.agent_type_id = agent_type_id\n   105\t    app.state.approvals = approvals\n   106\t    app.state.agent = ProcurementAgent(\n   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n   108\t    )\n   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n   111\t    try:\n   112\t        yield\n   113\t    finally:\n   114\t        sweeper.cancel()\n   115\t        await pool.close()\n   116\t\n   117\t\n   118\tapp = FastAPI(lifespan=lifespan)\n   119\tapp.include_router(ingest.router)\n   120\t\n   121\t\n   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n   123\t    settings = request.app.state.settings\n   124\t    try:\n   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n   126\t        claims = jwt.decode(\n   127\t            creds.credentials,\n   128\t            key.key,\n   129\t            algorithms=[\"RS256\", \"ES256\"],\n   130\t            audience=settings.oidc_audience,\n   131\t            issuer=settings.oidc_issuer,\n   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n   133\t        )\n   134\t    except jwt.PyJWTError as exc:\n   135\t        raise HTTPException(401, \"invalid token\") from exc\n   136\t    bu = claims.get(\"bu\")\n   137\t    if not bu:\n   138\t        raise HTTPException(403, \"token has no business unit\")\n   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n   140\t\n   141\t\n   142\t@app.post(\"/runs\")\n   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n   144\t    settings = request.app.state.settings\n   145\t    span_ctx = trace.get_current_span().get_span_context()\n   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n   147\t    ident = RunIdentity(\n   148\t        accountable_party=principal.subject,\n   149\t        operational_owner=settings.operational_owner,\n   150\t        tenant=principal.business_unit,\n   151\t        agent_type_id=request.app.state.agent_type_id,\n   152\t        agent_instance_id=new_instance_id(),\n   153\t        trace_id=trace_id,\n   154\t        run_id=f\"run-{uuid.uuid4()}\",\n   155\t        delegated_subject=principal.subject,\n   156\t        agent_principal=AGENT_PRINCIPAL,\n   157\t    )\n   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n   161\t\n   162\t\n   163\t@app.post(\"/slack/interactions\")\n   164\tasync def slack_interactions(request: Request) -> dict:\n   165\t    body = await request.body()\n   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n   167\t    if abs(time.time() - int(timestamp)) > 300:\n   168\t        raise HTTPException(401, \"stale request\")\n   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n   172\t        raise HTTPException(401, \"bad signature\")\n   173\t\n   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n   175\t    action = payload[\"actions\"][0]\n   176\t    slack_user = payload[\"user\"][\"id\"]\n   177\t    row = await request.app.state.pool.fetchrow(\n   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n   179\t    )\n   180\t    if row is None:\n   181\t        raise HTTPException(403, \"not an approver\")\n   182\t    try:\n   183\t        await request.app.state.approvals.decide(\n   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n   185\t            approve=action[\"action_id\"] == \"approve\",\n   186\t        )\n   187\t    except ApproverNotAuthorized as exc:\n   188\t        raise HTTPException(403, str(exc)) from exc\n   189\t    except ValueError as exc:\n   190\t        raise HTTPException(409, str(exc)) from exc\n   191\t    return {\"ok\": True}\n   192\t\n   193\t\n   194\t@app.get(\"/healthz\")\n   195\tasync def healthz() -> dict:\n   196\t    return {\"ok\": True}\n=== app/ingest.py\n     1\t\"\"\"Inbound documents: vendor quotes and invoices from the mail gateway.\n     2\t\n     3\tThe mail gateway posts each received message to ``/ingest/mail`` signed with\n     4\tan HMAC over the timestamp and body. Accepted documents are stored per\n     5\tbusiness unit and are only ever shown to the model inside an\n     6\t``untrusted_document`` wrapper (tools/documents.py).\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport base64\n    11\timport email\n    12\timport email.policy\n    13\timport hashlib\n    14\timport hmac\n    15\timport io\n    16\timport re\n    17\timport time\n    18\timport uuid\n    19\tfrom dataclasses import dataclass\n    20\tfrom pathlib import Path\n    21\t\n    22\tfrom fastapi import APIRouter, HTTPException, Request\n    23\tfrom pypdf import PdfReader\n    24\t\n    25\trouter = APIRouter()\n    26\t\n    27\tMAX_BODY_BYTES = 10 * 1024 * 1024\n    28\tMAX_TEXT_CHARS = 200_000\n    29\tMAX_SKEW_SECONDS = 300\n    30\tALLOWED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\", \"message/rfc822\"}\n    31\tSCANNED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\"}\n    32\t\n    33\tINJECTION_PATTERNS = [\n    34\t    re.compile(r\"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)\"),\n    35\t    re.compile(r\"(?i)\\b(system|developer) (prompt|message)\\b\"),\n    36\t    re.compile(r\"(?i)\\byou are (now )?(an?|the) \\w+ (agent|assistant)\\b\"),\n    37\t    re.compile(r\"(?i)\\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\\b\"),\n    38\t    re.compile(r\"(?i)\\b(update|change) (our|the) (bank|remit|payee)\\b\"),\n    39\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    40\t]\n    41\t\n    42\t\n    43\tclass Rejected(Exception):\n    44\t    pass\n    45\t\n    46\t\n    47\t@dataclass\n    48\tclass Inbound:\n    49\t    business_unit: str\n    50\t    sender: str\n    51\t    media_type: str\n    52\t    raw: bytes\n    53\t\n    54\t\n    55\tdef verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:\n    56\t    try:\n    57\t        ts = int(timestamp)\n    58\t    except ValueError as exc:\n    59\t        raise Rejected(\"bad timestamp\") from exc\n    60\t    if abs(time.time() - ts) > MAX_SKEW_SECONDS:\n    61\t        raise Rejected(\"stale request\")\n    62\t    expected = hmac.new(key, f\"{timestamp}.\".encode() + body, hashlib.sha256).hexdigest()\n    63\t    if not hmac.compare_digest(expected, signature):\n    64\t        raise Rejected(\"bad signature\")\n    65\t\n    66\t\n    67\tdef extract_text(doc: Inbound) -> str:\n    68\t    if doc.media_type == \"application/pdf\":\n    69\t        reader = PdfReader(io.BytesIO(doc.raw))\n    70\t        if len(reader.pages) > 50:\n    71\t            raise Rejected(\"too many pages\")\n    72\t        return \"\\n\".join(page.extract_text() or \"\" for page in reader.pages)\n    73\t    if doc.media_type == \"message/rfc822\":\n    74\t        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)\n    75\t        body = msg.get_body(preferencelist=(\"plain\", \"html\"))\n    76\t        return body.get_content() if body is not None else \"\"\n    77\t    return doc.raw.decode(\"utf-8\", errors=\"strict\")\n    78\t\n    79\t\n    80\tdef scan_for_injection(text: str) -> list[str]:\n    81\t    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]\n    82\t\n    83\t\n    84\tdef validate(doc: Inbound) -> str:\n    85\t    if doc.media_type not in ALLOWED_MEDIA_TYPES:\n    86\t        raise Rejected(f\"media type {doc.media_type} not accepted\")\n    87\t    if len(doc.raw) > MAX_BODY_BYTES:\n    88\t        raise Rejected(\"document too large\")\n    89\t    try:\n    90\t        text = extract_text(doc)\n    91\t    except Rejected:\n    92\t        raise\n    93\t    except Exception as exc:\n    94\t        raise Rejected(f\"unreadable document: {type(exc).__name__}\") from exc\n    95\t    if len(text) > MAX_TEXT_CHARS:\n    96\t        raise Rejected(\"extracted text too long\")\n    97\t    if doc.media_type in SCANNED_MEDIA_TYPES:\n    98\t        findings = scan_for_injection(text)\n    99\t        if findings:\n   100\t            raise Rejected(\"possible prompt injection: \" + \"; \".join(findings))\n   101\t    return text\n   102\t\n   103\t\n   104\t@router.post(\"/ingest/mail\")\n   105\tasync def ingest_mail(request: Request) -> dict:\n   106\t    body = await request.body()\n   107\t    if len(body) > MAX_BODY_BYTES * 2:\n   108\t        raise HTTPException(413, \"payload too large\")\n   109\t    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()\n   110\t    try:\n   111\t        verify_signature(\n   112\t            key,\n   113\t            request.headers.get(\"X-Gateway-Timestamp\", \"\"),\n   114\t            body,\n   115\t            request.headers.get(\"X-Gateway-Signature\", \"\"),\n   116\t        )\n   117\t    except Rejected as exc:\n   118\t        raise HTTPException(401, str(exc)) from exc\n   119\t\n   120\t    payload = await request.json()\n   121\t    doc = Inbound(\n   122\t        business_unit=payload[\"business_unit\"],\n   123\t        sender=payload[\"from\"],\n   124\t        media_type=payload[\"media_type\"],\n   125\t        raw=base64.b64decode(payload[\"content_b64\"], validate=True),\n   126\t    )\n   127\t    doc_id = f\"doc-{uuid.uuid4().hex[:20]}\"\n   128\t    pool = request.app.state.pool\n   129\t    try:\n   130\t        text = validate(doc)\n   131\t    except Rejected as exc:\n   132\t        await pool.execute(\n   133\t            \"\"\"\n   134\t            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)\n   135\t            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())\n   136\t            \"\"\",\n   137\t            doc_id, doc.business_unit, doc.sender, doc.media_type,\n   138\t            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],\n   139\t        )\n   140\t        return {\"doc_id\": doc_id, \"status\": \"quarantined\"}\n   141\t\n   142\t    await pool.execute(\n   143\t        \"\"\"\n   144\t        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)\n   145\t        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())\n   146\t        \"\"\",\n   147\t        doc_id, doc.business_unit, doc.sender, doc.media_type,\n   148\t        hashlib.sha256(doc.raw).hexdigest(), text,\n   149\t    )\n   150\t    return {\"doc_id\": doc_id, \"status\": \"accepted\"}\n=== app/tools/slack.py\n     1\t\"\"\"Slack tool: message staff and vendors, plus the approvals notifier.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom datetime import datetime\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.redact import redact_text, strip_unapproved_links\n    11\tfrom app.tools import Tool\n    12\t\n    13\tMAX_TEXT = 3000\n    14\t\n    15\t\n    16\tdef clean_outbound(text: str) -> str:\n    17\t    return strip_unapproved_links(redact_text(text))[:MAX_TEXT]\n    18\t\n    19\t\n    20\tclass SlackClient:\n    21\t    def __init__(self, api_url: str, bot_token_provider):\n    22\t        self.api_url = api_url\n    23\t        self._token = bot_token_provider\n    24\t\n    25\t    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:\n    26\t        payload: dict[str, Any] = {\n    27\t            \"channel\": channel,\n    28\t            \"text\": clean_outbound(text),\n    29\t            \"unfurl_links\": False,\n    30\t            \"unfurl_media\": False,\n    31\t            \"mrkdwn\": True,\n    32\t        }\n    33\t        if blocks:\n    34\t            payload[\"blocks\"] = blocks\n    35\t        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:\n    36\t            resp = await client.post(\n    37\t                f\"{self.api_url}/chat.postMessage\",\n    38\t                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\n    39\t                json=payload,\n    40\t            )\n    41\t        resp.raise_for_status()\n    42\t        body = resp.json()\n    43\t        if not body.get(\"ok\"):\n    44\t            raise RuntimeError(f\"slack error: {body.get('error')}\")\n    45\t        return {\"channel\": body[\"channel\"], \"ts\": body[\"ts\"]}\n    46\t\n    47\t    async def post_approval_request(\n    48\t        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\n    49\t    ) -> None:\n    50\t        lines = \"\\n\".join(f\"• *{k}*: `{v}`\" for k, v in summary.items())\n    51\t        text = f\"Approval needed for `{tool}` on `{target}` (expires {expires_at:%Y-%m-%d %H:%M} UTC)\\n{lines}\"\n    52\t        await self.post(\n    53\t            channel=f\"#approvals-{tenant}\",\n    54\t            text=text,\n    55\t            blocks=[\n    56\t                {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": clean_outbound(text)}},\n    57\t                {\n    58\t                    \"type\": \"actions\",\n    59\t                    \"elements\": [\n    60\t                        {\"type\": \"button\", \"action_id\": \"approve\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Approve\"}, \"style\": \"primary\"},\n    61\t                        {\"type\": \"button\", \"action_id\": \"reject\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Reject\"}, \"style\": \"danger\"},\n    62\t                    ],\n    63\t                },\n    64\t            ],\n    65\t        )\n    66\t\n    67\t\n    68\tdef tools(deps) -> list[Tool]:\n    69\t    slack: SlackClient = deps.slack\n    70\t\n    71\t    async def post_slack_message(args: dict[str, Any], ident: RunIdentity) -> Any:\n    72\t        return await slack.post(channel=args[\"channel\"], text=args[\"text\"])\n    73\t\n    74\t    return [\n    75\t        Tool(\n    76\t            name=\"post_slack_message\",\n    77\t            description=(\n    78\t                \"Post a message in Slack. Use internal channels for staff. Vendor contacts are in \"\n    79\t                \"Slack Connect channels named #vendor-<vendor_id>; set external=true for those.\"\n    80\t            ),\n    81\t            input_schema={\n    82\t                \"type\": \"object\",\n    83\t                \"properties\": {\n    84\t                    \"channel\": {\"type\": \"string\", \"maxLength\": 80},\n    85\t                    \"text\": {\"type\": \"string\", \"maxLength\": MAX_TEXT},\n    86\t                    \"external\": {\"type\": \"boolean\", \"default\": False},\n    87\t                },\n    88\t                \"required\": [\"channel\", \"text\"],\n    89\t                \"additionalProperties\": False,\n    90\t            },\n    91\t            invoke=post_slack_message,\n    92\t            target_field=\"channel\",\n    93\t        )\n    94\t    ]\n=== app/tools/memory.py\n     1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n     2\t\n     3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n     4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n     5\tuntil a procurement lead verifies them in the admin UI. Every row records\n     6\twho wrote it, from which run and source document, and the context size at\n     7\tthe time.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport re\n    12\timport uuid\n    13\tfrom typing import Any\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\tfrom app.tools import Tool\n    17\t\n    18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n    19\tMAX_NOTE_CHARS = 800\n    20\tINSTRUCTION_LIKE = [\n    21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n    22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n    23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n    24\t    re.compile(r\"https?://\"),\n    25\t]\n    26\t\n    27\t\n    28\tclass NoteRejected(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tdef check_note(text: str) -> None:\n    33\t    if len(text) > MAX_NOTE_CHARS:\n    34\t        raise NoteRejected(\"note too long\")\n    35\t    for pattern in INSTRUCTION_LIKE:\n    36\t        if pattern.search(text):\n    37\t            raise NoteRejected(\"note looks like an instruction\")\n    38\t\n    39\t\n    40\tdef tools(deps) -> list[Tool]:\n    41\t    pool = deps.pool\n    42\t\n    43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n    44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n    45\t        rows = await pool.fetch(\n    46\t            \"\"\"\n    47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n    48\t            FROM dept_notes\n    49\t            WHERE business_unit = $1\n    50\t              AND department = $2\n    51\t              AND NOT quarantined\n    52\t              AND (verified OR expires_at > now())\n    53\t            ORDER BY created_at DESC\n    54\t            LIMIT 20\n    55\t            \"\"\",\n    56\t            business_unit,\n    57\t            args[\"department\"],\n    58\t        )\n    59\t        return [\n    60\t            {\n    61\t                \"note_id\": r[\"note_id\"],\n    62\t                \"kind\": r[\"kind\"],\n    63\t                \"body\": r[\"body\"],\n    64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n    65\t                \"written\": r[\"created_at\"].isoformat(),\n    66\t            }\n    67\t            for r in rows\n    68\t        ]\n    69\t\n    70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n    71\t        if args[\"kind\"] not in NOTE_KINDS:\n    72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n    73\t        check_note(args[\"body\"])\n    74\t        note_id = f\"note-{uuid.uuid4()}\"\n    75\t        ctx = deps.current_context(ident)\n    76\t        await pool.execute(\n    77\t            \"\"\"\n    78\t            INSERT INTO dept_notes (\n    79\t                note_id, business_unit, department, kind, body,\n    80\t                verified, quarantined, expires_at,\n    81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n    82\t                delegated_subject, context_tokens, context_method, created_at\n    83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n    84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n    85\t            \"\"\",\n    86\t            note_id,\n    87\t            ident.tenant,\n    88\t            args[\"department\"],\n    89\t            args[\"kind\"],\n    90\t            args[\"body\"],\n    91\t            ident.agent_instance_id,\n    92\t            ident.agent_type_id,\n    93\t            ident.run_id,\n    94\t            args.get(\"source_doc_id\"),\n    95\t            ident.delegated_subject,\n    96\t            ctx.tokens,\n    97\t            ctx.method,\n    98\t        )\n    99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n   100\t\n   101\t    return [\n   102\t        Tool(\n   103\t            name=\"memory_read\",\n   104\t            description=(\n   105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n   106\t                \"shared-services staff may look up another unit's notes.\"\n   107\t            ),\n   108\t            input_schema={\n   109\t                \"type\": \"object\",\n   110\t                \"properties\": {\n   111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n   113\t                },\n   114\t                \"required\": [\"department\"],\n   115\t                \"additionalProperties\": False,\n   116\t            },\n   117\t            invoke=memory_read,\n   118\t        ),\n   119\t        Tool(\n   120\t            name=\"memory_write\",\n   121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n   122\t            input_schema={\n   123\t                \"type\": \"object\",\n   124\t                \"properties\": {\n   125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n   127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n   128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n   129\t                },\n   130\t                \"required\": [\"department\", \"kind\", \"body\"],\n   131\t                \"additionalProperties\": False,\n   132\t            },\n   133\t            invoke=memory_write,\n   134\t        ),\n   135\t    ]\n=== app/tools/payments.py\n     1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.tools import Tool\n    11\t\n    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n    13\tPAYMENTS_SCOPE = \"payments.create\"\n    14\t\n    15\t\n    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n    17\t    raw = \"|\".join(\n    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(arg","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-rwokbux3/87ad7a50-bdd0-4753-a509-ffba5d499adb/tool-results/bkg61mif8.txt","persistedOutputSize":35208},"tool_result_meta":[{"id":"toolu_01JZnDP2FV8gCkZYW8v5A8Bq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
