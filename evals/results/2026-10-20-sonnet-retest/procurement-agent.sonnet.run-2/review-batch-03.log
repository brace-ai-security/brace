{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PEgfgeZAb6X2uep5zwRgZB","type":"tool_result","content":"1\t=== app/loop.py\n2\t     1\t\"\"\"Procurement agent run loop.\n3\t     2\t\n4\t     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n5\t     4\tEvery edge writes an audit node before the next step runs. Budgets are\n6\t     5\tchecked before each model turn and each tool call.\n7\t     6\t\"\"\"\n8\t     7\tfrom __future__ import annotations\n9\t     8\t\n10\t     9\timport hashlib\n11\t    10\timport logging\n12\t    11\tfrom dataclasses import dataclass, field\n13\t    12\tfrom typing import Any\n14\t    13\t\n15\t    14\tfrom opentelemetry import trace\n16\t    15\t\n17\t    16\tfrom app import audit, killswitch\n18\t    17\tfrom app.budget import Budget, BudgetExceeded\n19\t    18\tfrom app.context_size import ContextMeasure, measure_context\n20\t    19\tfrom app.gate import PolicyGate\n21\t    20\tfrom app.identity import RunIdentity\n22\t    21\tfrom app.redact import redact_for_model\n23\t    22\tfrom app.tools import ToolRegistry, build_registry\n24\t    23\t\n25\t    24\tlog = logging.getLogger(__name__)\n26\t    25\ttracer = trace.get_tracer(\"procurement.loop\")\n27\t    26\t\n28\t    27\tCOMPACT_AFTER_MESSAGES = 40\n29\t    28\tKEEP_RECENT_MESSAGES = 12\n30\t    29\t\n31\t    30\t\n32\t    31\t@dataclass\n33\t    32\tclass AgentDeps:\n34\t    33\t    settings: Any\n35\t    34\t    pool: Any\n36\t    35\t    gate: PolicyGate\n37\t    36\t    erp: Any\n38\t    37\t    slack: Any\n39\t    38\t    broker: Any\n40\t    39\t    extractor: Any = None\n41\t    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n42\t    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n43\t    42\t\n44\t    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n45\t    44\t        return self._budgets[ident.run_id]\n46\t    45\t\n47\t    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n48\t    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n49\t    48\t\n50\t    49\t    def erp_scope_for(self, operation: str) -> str:\n51\t    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n52\t    51\t        return scopes.get(operation, \"erp.read\")\n53\t    52\t\n54\t    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n55\t    54\t        self._contexts[ident.agent_instance_id] = ctx\n56\t    55\t        proposed = await audit.record(\n57\t    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n58\t    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n59\t    58\t        )\n60\t    59\t        tool = registry.get(use.name)\n61\t    60\t        if tool is None:\n62\t    61\t            await audit.record(\n63\t    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n64\t    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n65\t    64\t            )\n66\t    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n67\t    66\t\n68\t    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n69\t    68\t        authz = await audit.record(\n70\t    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n71\t    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n72\t    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n73\t    72\t        )\n74\t    73\t        if not decision.allow:\n75\t    74\t            if decision.pending:\n76\t    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n77\t    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n78\t    77\t\n79\t    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n80\t    79\t        try:\n81\t    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n82\t    81\t                for k, v in ctx.otel_attributes().items():\n83\t    82\t                    span.set_attribute(k, v)\n84\t    83\t                output = await tool.invoke(use.input, ident)\n85\t    84\t        except BudgetExceeded:\n86\t    85\t            raise\n87\t    86\t        except Exception as exc:\n88\t    87\t            await audit.record(\n89\t    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n90\t    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n91\t    90\t                operation_id=operation_id,\n92\t    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n93\t    92\t            )\n94\t    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n95\t    94\t\n96\t    95\t        await audit.record(\n97\t    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n98\t    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n99\t    98\t            operation_id=operation_id,\n100\t    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n101\t   100\t        )\n102\t   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n103\t   102\t\n104\t   103\t\n105\t   104\tdef _error(tool_use_id: str, message: str) -> dict:\n106\t   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n107\t   106\t\n108\t   107\t\n109\t   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n110\t   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n111\t   110\t        return messages, False\n112\t   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n113\t   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n114\t   113\t        tail = tail[1:]\n115\t   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n116\t   115\t    return head + [note] + tail, True\n117\t   116\t\n118\t   117\t\n119\t   118\tclass ProcurementAgent:\n120\t   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n121\t   120\t        self.client = client\n122\t   121\t        self.deps = deps\n123\t   122\t        self.system_prompt = system_prompt\n124\t   123\t        self.role = role\n125\t   124\t\n126\t   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n127\t   126\t        pool = self.deps.pool\n128\t   127\t        await killswitch.assert_running(pool, ident.tenant)\n129\t   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n130\t   129\t        await budget.reserve_run_start(pool)\n131\t   130\t        self.deps._budgets[ident.run_id] = budget\n132\t   131\t        registry = build_registry(self.role, ident, self.deps)\n133\t   132\t\n134\t   133\t        run_node = await audit.record(\n135\t   134\t            pool, ident, kind=\"run_started\",\n136\t   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n137\t   136\t        )\n138\t   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n139\t   138\t        try:\n140\t   139\t            while True:\n141\t   140\t                budget.check_step()\n142\t   141\t                messages, compacted = _compact(messages)\n143\t   142\t                request = {\n144\t   143\t                    \"model\": self.deps.settings.model_id,\n145\t   144\t                    \"system\": self.system_prompt,\n146\t   145\t                    \"messages\": messages,\n147\t   146\t                    \"tools\": registry.schemas(),\n148\t   147\t                    \"max_tokens\": 4096,\n149\t   148\t                }\n150\t   149\t                ctx = await measure_context(self.client, request, compacted)\n151\t   150\t                response = await self.client.messages.create(**request)\n152\t   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n153\t   152\t                await budget.flush(pool)\n154\t   153\t                ctx = ctx.finalize(response.usage)\n155\t   154\t                decision = await audit.record(\n156\t   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n157\t   156\t                    payload={\n158\t   157\t                        \"requested_model\": request[\"model\"],\n159\t   158\t                        \"served_model\": response.model,\n160\t   159\t                        \"stop_reason\": response.stop_reason,\n161\t   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n162\t   161\t                    },\n163\t   162\t                )\n164\t   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n165\t   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n166\t   165\t                if not uses:\n167\t   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n168\t   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n169\t   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n170\t   169\t                    return final\n171\t   170\t                results = []\n172\t   171\t                for use in uses:\n173\t   172\t                    budget.check_tool_call()\n174\t   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n175\t   174\t                messages.append({\"role\": \"user\", \"content\": results})\n176\t   175\t        except BudgetExceeded as exc:\n177\t   176\t            await audit.record(\n178\t   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n179\t   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n180\t   179\t            )\n181\t   180\t            await self.deps.slack.post(\n182\t   181\t                channel=\"#procurement-agent-ops\",\n183\t   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n184\t   183\t            )\n185\t   184\t            return None\n186\t   185\t        finally:\n187\t   186\t            self.deps._budgets.pop(ident.run_id, None)\n188\t=== app/extractor.py\n189\t     1\t\"\"\"Line-item extraction sub-agent.\n190\t     2\t\n191\t     3\tThe parent procurement agent delegates structured extraction to a smaller\n192\t     4\tmodel. The child runs under its own instance id, links to its parent in the\n193\t     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n194\t     6\t\"\"\"\n195\t     7\tfrom __future__ import annotations\n196\t     8\t\n197\t     9\timport json\n198\t    10\timport logging\n199\t    11\tfrom typing import Any\n200\t    12\t\n201\t    13\tfrom opentelemetry import trace\n202\t    14\t\n203\t    15\tfrom app import audit\n204\t    16\tfrom app.budget import Budget\n205\t    17\tfrom app.context_size import measure_context\n206\t    18\tfrom app.identity import RunIdentity\n207\t    19\tfrom app.redact import redact_for_model\n208\t    20\tfrom app.tools import build_registry\n209\t    21\t\n210\t    22\tlog = logging.getLogger(__name__)\n211\t    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n212\t    24\t\n213\t    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n214\t    26\tMAX_TURNS = 4\n215\t    27\t\n216\t    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n217\t    29\t\n218\t    30\t\n219\t    31\tclass ExtractionFailed(Exception):\n220\t    32\t    pass\n221\t    33\t\n222\t    34\t\n223\t    35\tclass LineItemExtractor:\n224\t    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n225\t    37\t        self.client = client\n226\t    38\t        self.settings = settings\n227\t    39\t        self.deps = deps\n228\t    40\t        self.system_prompt = system_prompt\n229\t    41\t\n230\t    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n231\t    43\t        budget.check_subagent()\n232\t    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n233\t    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n234\t    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n235\t    47\t\n236\t    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n237\t    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n238\t    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n239\t    51\t            start_node = await audit.record(\n240\t    52\t                self.deps.pool,\n241\t    53\t                ident,\n242\t    54\t                kind=\"subagent_started\",\n243\t    55\t                payload={\n244\t    56\t                    \"role\": EXTRACTOR_ROLE,\n245\t    57\t                    \"doc_id\": doc_id,\n246\t    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n247\t    59\t                    \"tools\": registry.names(),\n248\t    60\t                },\n249\t    61\t            )\n250\t    62\t\n251\t    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n252\t    64\t            for _turn in range(MAX_TURNS):\n253\t    65\t                budget.check_step()\n254\t    66\t                request = {\n255\t    67\t                    \"model\": self.settings.extractor_model_id,\n256\t    68\t                    \"system\": self.system_prompt,\n257\t    69\t                    \"messages\": messages,\n258\t    70\t                    \"tools\": registry.schemas(),\n259\t    71\t                    \"max_tokens\": 4096,\n260\t    72\t                }\n261\t    73\t                ctx = await measure_context(self.client, request, compacted=False)\n262\t    74\t                response = await self.client.messages.create(**request)\n263\t    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n264\t    76\t                await budget.flush(self.deps.pool)\n265\t    77\t                ctx = ctx.finalize(response.usage)\n266\t    78\t                decision = await audit.record(\n267\t    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n268\t    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n269\t    81\t                             \"stop_reason\": response.stop_reason},\n270\t    82\t                )\n271\t    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n272\t    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n273\t    85\t                if not uses:\n274\t    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n275\t    87\t                    items = _parse_items(text)\n276\t    88\t                    await audit.record(\n277\t    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n278\t    90\t                        payload={\"items\": len(items)},\n279\t    91\t                    )\n280\t    92\t                    return items\n281\t    93\t                results = []\n282\t    94\t                for use in uses:\n283\t    95\t                    budget.check_tool_call()\n284\t    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n285\t    97\t                messages.append({\"role\": \"user\", \"content\": results})\n286\t    98\t\n287\t    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n288\t   100\t\n289\t   101\t\n290\t   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n291\t   103\t    try:\n292\t   104\t        data = json.loads(text)\n293\t   105\t    except json.JSONDecodeError as exc:\n294\t   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n295\t   107\t    if not isinstance(data, list) or len(data) > 500:\n296\t   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n297\t   109\t    items = []\n298\t   110\t    for raw in data:\n299\t   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n300\t   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n301\t   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n302\t   114\t    return items\n303\t=== app/redact.py\n304\t     1\t\"\"\"Redaction for model input, logs, audit payloads, and outbound messages.\n305\t     2\t\n306\t     3\tApplied in four places:\n307\t     4\t  * tool results before they are appended to the model context (loop.py)\n308\t     5\t  * every audit payload (audit.py)\n309\t     6\t  * the root logging filter (main.py)\n310\t     7\t  * outbound Slack text (tools/slack.py)\n311\t     8\t\"\"\"\n312\t     9\tfrom __future__ import annotations\n313\t    10\t\n314\t    11\timport logging\n315\t    12\timport re\n316\t    13\tfrom typing import Any\n317\t    14\tfrom urllib.parse import urlparse\n318\t    15\t\n319\t    16\tSECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n320\t    17\t    (\"bearer\", re.compile(r\"(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]{16,}\")),\n321\t    18\t    (\"jwt\", re.compile(r\"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b\")),\n322\t    19\t    (\"acct_token\", re.compile(r\"\\bacct_tok_[A-Za-z0-9_]{8,}\\b\")),\n323\t    20\t    (\"pay_token\", re.compile(r\"\\bpay_tok_[A-Za-z0-9_]{8,}\\b\")),\n324\t    21\t    (\"erp_session\", re.compile(r\"\\berp_sess_[A-Za-z0-9_]{8,}\\b\")),\n325\t    22\t    (\"password_kv\", re.compile(r\"(?i)\\b(password|passwd|secret|api[_-]?key)\\s*[:=]\\s*\\S+\")),\n326\t    23\t]\n327\t    24\t\n328\t    25\t# Bank details: keep the last four characters so staff can still match records.\n329\t    26\tACCOUNT_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n330\t    27\t    (\"iban\", re.compile(r\"\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b\")),\n331\t    28\t    (\"account_no\", re.compile(r\"(?i)\\b(account|acct|routing)\\s*(no\\.?|number|#)?\\s*[:#]?\\s*(\\d[\\d -]{6,}\\d)\")),\n332\t    29\t]\n333\t    30\t\n334\t    31\tMARKDOWN_IMAGE = re.compile(r\"!\\[[^\\]]*\\]\\(([^)\\s]+)[^)]*\\)\")\n335\t    32\tMARKDOWN_LINK = re.compile(r\"(?<!!)\\[([^\\]]*)\\]\\(([^)\\s]+)[^)]*\\)\")\n336\t    33\tSLACK_LINK = re.compile(r\"<(https?://[^|>]+)(\\|[^>]*)?>\")\n337\t    34\tBARE_URL = re.compile(r\"https?://[^\\s<>()]+\")\n338\t    35\t\n339\t    36\tAPPROVED_LINK_HOSTS = frozenset({\"erp.example-corp.test\", \"intranet.example-corp.test\"})\n340\t    37\t\n341\t    38\t\n342\t    39\tdef _mask_tail(match: re.Match[str]) -> str:\n343\t    40\t    text = match.group(0)\n344\t    41\t    return \"[REDACTED:\" + \"*\" * 4 + text[-4:] + \"]\"\n345\t    42\t\n346\t    43\t\n347\t    44\tdef redact_text(text: str) -> str:\n348\t    45\t    for name, pattern in SECRET_PATTERNS:\n349\t    46\t        text = pattern.sub(f\"[REDACTED:{name}]\", text)\n350\t    47\t    for _name, pattern in ACCOUNT_PATTERNS:\n351\t    48\t        text = pattern.sub(_mask_tail, text)\n352\t    49\t    return text\n353\t    50\t\n354\t    51\t\n355\t    52\tdef redact_value(value: Any) -> Any:\n356\t    53\t    if isinstance(value, str):\n357\t    54\t        return redact_text(value)\n358\t    55\t    if isinstance(value, dict):\n359\t    56\t        return {k: redact_value(v) for k, v in value.items()}\n360\t    57\t    if isinstance(value, (list, tuple)):\n361\t    58\t        return [redact_value(v) for v in value]\n362\t    59\t    return value\n363\t    60\t\n364\t    61\t\n365\t    62\tdef redact_for_model(value: Any) -> str:\n366\t    63\t    if not isinstance(value, str):\n367\t    64\t        import json\n368\t    65\t\n369\t    66\t        value = json.dumps(value, default=str)\n370\t    67\t    return redact_text(value)\n371\t    68\t\n372\t    69\t\n373\t    70\tdef _host_ok(url: str) -> bool:\n374\t    71\t    host = (urlparse(url).hostname or \"\").lower()\n375\t    72\t    return host in APPROVED_LINK_HOSTS\n376\t    73\t\n377\t    74\t\n378\t    75\tdef strip_unapproved_links(text: str) -> str:\n379\t    76\t    \"\"\"Remove images entirely and drop links to hosts outside the allowlist.\n380\t    77\t\n381\t    78\t    Slack and most chat clients fetch link and image URLs to render previews,\n382\t    79\t    so an attacker-chosen URL can carry data out without any tool call.\n383\t    80\t    \"\"\"\n384\t    81\t    text = MARKDOWN_IMAGE.sub(\"[image removed]\", text)\n385\t    82\t    text = MARKDOWN_LINK.sub(\n386\t    83\t        lambda m: m.group(0) if _host_ok(m.group(2)) else m.group(1), text\n387\t    84\t    )\n388\t    85\t    text = SLACK_LINK.sub(\n389\t    86\t        lambda m: m.group(0) if _host_ok(m.group(1)) else \"[link removed]\", text\n390\t    87\t    )\n391\t    88\t    text = BARE_URL.sub(\n392\t    89\t        lambda m: m.group(0) if _host_ok(m.group(0)) else \"[link removed]\", text\n393\t    90\t    )\n394\t    91\t    return text\n395\t    92\t\n396\t    93\t\n397\t    94\tclass RedactingFilter(logging.Filter):\n398\t    95\t    def filter(self, record: logging.LogRecord) -> bool:\n399\t    96\t        if isinstance(record.msg, str):\n400\t    97\t            record.msg = redact_text(record.msg)\n401\t    98\t        if record.args:\n402\t    99\t            record.args = tuple(redact_value(a) for a in record.args)\n403\t   100\t        return True\n404\t=== app/tools/__init__.py\n405\t     1\t\"\"\"Tool registry.\n406\t     2\t\n407\t     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n408\t     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n409\t     5\tthat is not in the run's registry.\n410\t     6\t\"\"\"\n411\t     7\tfrom __future__ import annotations\n412\t     8\t\n413\t     9\tfrom dataclasses import dataclass\n414\t    10\tfrom functools import lru_cache\n415\t    11\tfrom typing import Any, Awaitable, Callable\n416\t    12\t\n417\t    13\timport yaml\n418\t    14\t\n419\t    15\tfrom app.identity import RunIdentity\n420\t    16\t\n421\t    17\tDEFAULT_ROLE = \"procurement\"\n422\t    18\t\n423\t    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n424\t    20\t\n425\t    21\t\n426\t    22\t@dataclass(frozen=True)\n427\t    23\tclass Tool:\n428\t    24\t    name: str\n429\t    25\t    description: str\n430\t    26\t    input_schema: dict[str, Any]\n431\t    27\t    invoke: Invoke\n432\t    28\t    target_field: str | None = None\n433\t    29\t\n434\t    30\t    def target_of(self, args: dict[str, Any]) -> str:\n435\t    31\t        if self.target_field is None:\n436\t    32\t            return self.name\n437\t    33\t        return str(args.get(self.target_field, \"\"))\n438\t    34\t\n439\t    35\t    def schema(self) -> dict[str, Any]:\n440\t    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n441\t    37\t\n442\t    38\t\n443\t    39\tclass ToolRegistry:\n444\t    40\t    def __init__(self, tools: list[Tool]):\n445\t    41\t        self._tools = {t.name: t for t in tools}\n446\t    42\t\n447\t    43\t    def get(self, name: str) -> Tool | None:\n448\t    44\t        return self._tools.get(name)\n449\t    45\t\n450\t    46\t    def names(self) -> list[str]:\n451\t    47\t        return sorted(self._tools)\n452\t    48\t\n453\t    49\t    def schemas(self) -> list[dict[str, Any]]:\n454\t    50\t        return [self._tools[n].schema() for n in self.names()]\n455\t    51\t\n456\t    52\t\n457\t    53\t@lru_cache(maxsize=1)\n458\t    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n459\t    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n460\t    56\t        cfg = yaml.safe_load(fh)\n461\t    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n462\t    58\t\n463\t    59\t\n464\t    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n465\t    61\t    from app.tools import documents, erp, memory, payments, slack\n466\t    62\t\n467\t    63\t    available: dict[str, Tool] = {}\n468\t    64\t    for module in (documents, erp, memory, payments, slack):\n469\t    65\t        for tool in module.tools(deps):\n470\t    66\t            available[tool.name] = tool\n471\t    67\t\n472\t    68\t    roles = _role_tools(str(deps.settings.tools_path))\n473\t    69\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n474\t    70\t    return ToolRegistry([available[name] for name in allowed if name in available])\n475\t=== app/tools/documents.py\n476\t     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n477\t     2\tfrom __future__ import annotations\n478\t     3\t\n479\t     4\tfrom typing import Any\n480\t     5\t\n481\t     6\tfrom app.identity import RunIdentity\n482\t     7\tfrom app.tools import Tool\n483\t     8\t\n484\t     9\tUNTRUSTED_WRAPPER = (\n485\t    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n486\t    11\t    \"{text}\\n\"\n487\t    12\t    \"</untrusted_document>\"\n488\t    13\t)\n489\t    14\t\n490\t    15\t\n491\t    16\tdef tools(deps) -> list[Tool]:\n492\t    17\t    pool = deps.pool\n493\t    18\t\n494\t    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n495\t    20\t        row = await pool.fetchrow(\n496\t    21\t            \"\"\"\n497\t    22\t            SELECT doc_id, source, media_type, text\n498\t    23\t            FROM documents\n499\t    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n500\t    25\t            \"\"\",\n501\t    26\t            args[\"doc_id\"],\n502\t    27\t            ident.tenant,\n503\t    28\t        )\n504\t    29\t        if row is None:\n505\t    30\t            return \"document not found\"\n506\t    31\t        return UNTRUSTED_WRAPPER.format(\n507\t    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n508\t    33\t        )\n509\t    34\t\n510\t    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n511\t    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n512\t    37\t\n513\t    38\t    return [\n514\t    39\t        Tool(\n515\t    40\t            name=\"read_document\",\n516\t    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n517\t    42\t            input_schema={\n518\t    43\t                \"type\": \"object\",\n519\t    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n520\t    45\t                \"required\": [\"doc_id\"],\n521\t    46\t                \"additionalProperties\": False,\n522\t    47\t            },\n523\t    48\t            invoke=read_document,\n524\t    49\t        ),\n525\t    50\t        Tool(\n526\t    51\t            name=\"extract_line_items\",\n527\t    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n528\t    53\t            input_schema={\n529\t    54\t                \"type\": \"object\",\n530\t    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n531\t    56\t                \"required\": [\"doc_id\"],\n532\t    57\t                \"additionalProperties\": False,\n533\t    58\t            },\n534\t    59\t            invoke=extract_line_items,\n535\t    60\t        ),\n536\t    61\t    ]\n537\t=== app/tools/erp.py\n538\t     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n539\t     2\tfrom __future__ import annotations\n540\t     3\t\n541\t     4\tfrom typing import Any\n542\t     5\t\n543\t     6\tfrom app.identity import RunIdentity\n544\t     7\tfrom app.tools import Tool\n545\t     8\t\n546\t     9\tERP_READ_SCOPE = \"erp.read\"\n547\t    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n548\t    11\t\n549\t    12\t\n550\t    13\tdef tools(deps) -> list[Tool]:\n551\t    14\t    erp = deps.erp\n552\t    15\t\n553\t    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n554\t    17\t        return await erp.call(\n555\t    18\t            \"budget.get_remaining\",\n556\t    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n557\t    20\t            ident,\n558\t    21\t            ERP_READ_SCOPE,\n559\t    22\t        )\n560\t    23\t\n561\t    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n562\t    25\t        arguments = dict(args.get(\"arguments\", {}))\n563\t    26\t        arguments[\"business_unit\"] = ident.tenant\n564\t    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n565\t    28\t\n566\t    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n567\t    30\t        return await erp.call(\n568\t    31\t            \"po.create\",\n569\t    32\t            {\n570\t    33\t                \"business_unit\": ident.tenant,\n571\t    34\t                \"department\": args[\"department\"],\n572\t    35\t                \"vendor_id\": args[\"vendor_id\"],\n573\t    36\t                \"lines\": args[\"lines\"],\n574\t    37\t                \"currency\": args[\"currency\"],\n575\t    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n576\t    39\t                \"client_reference\": args[\"source_doc_id\"],\n577\t    40\t            },\n578\t    41\t            ident,\n579\t    42\t            ERP_PO_WRITE_SCOPE,\n580\t    43\t        )\n581\t    44\t\n582\t    45\t    line_schema = {\n583\t    46\t        \"type\": \"object\",\n584\t    47\t        \"properties\": {\n585\t    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n586\t    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n587\t    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n588\t    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n589\t    52\t        },\n590\t    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n591\t    54\t        \"additionalProperties\": False,\n592\t    55\t    }\n593\t    56\t\n594\t    57\t    return [\n595\t    58\t        Tool(\n596\t    59\t            name=\"get_budget\",\n597\t    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n598\t    61\t            input_schema={\n599\t    62\t                \"type\": \"object\",\n600\t    63\t                \"properties\": {\n601\t    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n602\t    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n603\t    66\t                },\n604\t    67\t                \"required\": [\"department\", \"fiscal_period\"],\n605\t    68\t                \"additionalProperties\": False,\n606\t    69\t            },\n607\t    70\t            invoke=get_budget,\n608\t    71\t        ),\n609\t    72\t        Tool(\n610\t    73\t            name=\"erp_call\",\n611\t    74\t            description=(\n612\t    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n613\t    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n614\t    77\t            ),\n615\t    78\t            input_schema={\n616\t    79\t                \"type\": \"object\",\n617\t    80\t                \"properties\": {\n618\t    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n619\t    82\t                    \"arguments\": {\"type\": \"object\"},\n620\t    83\t                },\n621\t    84\t                \"required\": [\"operation\"],\n622\t    85\t                \"additionalProperties\": False,\n623\t    86\t            },\n624\t    87\t            invoke=erp_call,\n625\t    88\t        ),\n626\t    89\t        Tool(\n627\t    90\t            name=\"create_purchase_order\",\n628\t    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n629\t    92\t            input_schema={\n630\t    93\t                \"type\": \"object\",\n631\t    94\t                \"properties\": {\n632\t    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n633\t    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n634\t    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n635\t    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n636\t    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n637\t   100\t                },\n638\t   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n639\t   102\t                \"additionalProperties\": False,\n640\t   103\t            },\n641\t   104\t            invoke=create_purchase_order,\n642\t   105\t            target_field=\"source_doc_id\",\n643\t   106\t        ),\n644\t   107\t    ]\n645\t=== app/mcp_client.py\n646\t     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n647\t     2\t\n648\t     3\tOn startup the tool list is fetched and each tool's description and input\n649\t     4\tschema are fingerprinted and compared with the pins in the release manifest.\n650\t     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n651\t     6\tinstruction-like content before any of it is shown to the model.\n652\t     7\t\"\"\"\n653\t     8\tfrom __future__ import annotations\n654\t     9\t\n655\t    10\timport hashlib\n656\t    11\timport json\n657\t    12\timport logging\n658\t    13\timport re\n659\t    14\timport uuid\n660\t    15\tfrom typing import Any\n661\t    16\t\n662\t    17\timport httpx\n663\t    18\t\n664\t    19\tfrom app.identity import RunIdentity, TokenBroker\n665\t    20\tfrom app.redact import redact_text\n666\t    21\t\n667\t    22\tlog = logging.getLogger(__name__)\n668\t    23\t\n669\t    24\tMAX_DESCRIPTION_CHARS = 1024\n670\t    25\tSUSPICIOUS_METADATA = [\n671\t    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n672\t    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n673\t    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n674\t    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n675\t    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n676\t    31\t]\n677\t    32\t\n678\t    33\t\n679\t    34\tclass ToolPinMismatch(Exception):\n680\t    35\t    pass\n681\t    36\t\n682\t    37\t\n683\t    38\tclass UnknownErpOperation(Exception):\n684\t    39\t    pass\n685\t    40\t\n686\t    41\t\n687\t    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n688\t    43\t    material = {\n689\t    44\t        \"name\": tool[\"name\"],\n690\t    45\t        \"description\": tool.get(\"description\", \"\"),\n691\t    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n692\t    47\t        \"annotations\": tool.get(\"annotations\", {}),\n693\t    48\t    }\n694\t    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n695\t    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n696\t    51\t\n697\t    52\t\n698\t    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n699\t    54\t    description = tool.get(\"description\", \"\")\n700\t    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n701\t    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n702\t    57\t    blob = json.dumps(tool, ensure_ascii=False)\n703\t    58\t    for pattern in SUSPICIOUS_METADATA:\n704\t    59\t        if pattern.search(blob):\n705\t    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n706\t    61\t\n707\t    62\t\n708\t    63\tclass ErpMcpClient:\n709\t    64\t    AUDIENCE = \"erp-mcp-gateway\"\n710\t    65\t\n711\t    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n712\t    67\t        self.url = url\n713\t    68\t        self.pins = pins\n714\t    69\t        self.broker = broker\n715\t    70\t        self._tools: dict[str, dict[str, Any]] = {}\n716\t    71\t\n717\t    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n718\t    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n719\t    74\t            resp = await client.post(\n720\t    75\t                self.url,\n721\t    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n722\t    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n723\t    78\t            )\n724\t    79\t        resp.raise_for_status()\n725\t    80\t        if len(resp.content) > 512_000:\n726\t    81\t            raise ValueError(\"erp response too large\")\n727\t    82\t        body = resp.json()\n728\t    83\t        if \"error\" in body:\n729\t    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n730\t    85\t        return body[\"result\"]\n731\t    86\t\n732\t    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n733\t    88\t        result = await self._rpc(\"tools/list\", {}, token)\n734\t    89\t        return list(result.get(\"tools\", []))\n735\t    90\t\n736\t    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n737\t    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n738\t    93\t        tools = await self._list_tools(token)\n739\t    94\t        for tool in tools:\n740\t    95\t            expected = self.pins.get(tool[\"name\"])\n741\t    96\t            actual = fingerprint(tool)\n742\t    97\t            if expected != actual:\n743\t    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n744\t    99\t            scan_metadata(tool)\n745\t   100\t        self._tools = {t[\"name\"]: t for t in tools}\n746\t   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n747\t   102\t\n748\t   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n749\t   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n750\t   105\t            await self.refresh_tools(service_ident)\n751\t   106\t\n752\t   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n753\t   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n754\t   109\t        tools = await self._list_tools(token)\n755\t   110\t        self._tools = {t[\"name\"]: t for t in tools}\n756\t   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n757\t   112\t\n758\t   113\t    def operations(self) -> list[str]:\n759\t   114\t        return sorted(self._tools)\n760\t   115\t\n761\t   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n762\t   117\t        if operation not in self._tools:\n763\t   118\t            raise UnknownErpOperation(operation)\n764\t   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n765\t   120\t        result = await self._rpc(\n766\t   121\t            \"tools/call\",\n767\t   122\t            {\n768\t   123\t                \"name\": operation,\n769\t   124\t                \"arguments\": arguments,\n770\t   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n771\t   126\t            },\n772\t   127\t            token,\n773\t   128\t        )\n774\t   129\t        if result.get(\"isError\"):\n775\t   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n776\t   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n777\t"}]},"parent_tool_use_id":null,"session_id":"87ad7a50-bdd0-4753-a509-ffba5d499adb","uuid":"803d4fe7-415f-42b1-ab53-974ac56145d9","timestamp":"2026-10-20T13:07:56.016Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-rwokbux3/87ad7a50-bdd0-4753-a509-ffba5d499adb/tool-results/bbe3lh4ss.txt","content":"=== app/loop.py\n     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n=== app/extractor.py\n     1\t\"\"\"Line-item extraction sub-agent.\n     2\t\n     3\tThe parent procurement agent delegates structured extraction to a smaller\n     4\tmodel. The child runs under its own instance id, links to its parent in the\n     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport json\n    10\timport logging\n    11\tfrom typing import Any\n    12\t\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom app import audit\n    16\tfrom app.budget import Budget\n    17\tfrom app.context_size import measure_context\n    18\tfrom app.identity import RunIdentity\n    19\tfrom app.redact import redact_for_model\n    20\tfrom app.tools import build_registry\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n    24\t\n    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n    26\tMAX_TURNS = 4\n    27\t\n    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n    29\t\n    30\t\n    31\tclass ExtractionFailed(Exception):\n    32\t    pass\n    33\t\n    34\t\n    35\tclass LineItemExtractor:\n    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n    37\t        self.client = client\n    38\t        self.settings = settings\n    39\t        self.deps = deps\n    40\t        self.system_prompt = system_prompt\n    41\t\n    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n    43\t        budget.check_subagent()\n    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n    47\t\n    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n    51\t            start_node = await audit.record(\n    52\t                self.deps.pool,\n    53\t                ident,\n    54\t                kind=\"subagent_started\",\n    55\t                payload={\n    56\t                    \"role\": EXTRACTOR_ROLE,\n    57\t                    \"doc_id\": doc_id,\n    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n    59\t                    \"tools\": registry.names(),\n    60\t                },\n    61\t            )\n    62\t\n    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n    64\t            for _turn in range(MAX_TURNS):\n    65\t                budget.check_step()\n    66\t                request = {\n    67\t                    \"model\": self.settings.extractor_model_id,\n    68\t                    \"system\": self.system_prompt,\n    69\t                    \"messages\": messages,\n    70\t                    \"tools\": registry.schemas(),\n    71\t                    \"max_tokens\": 4096,\n    72\t                }\n    73\t                ctx = await measure_context(self.client, request, compacted=False)\n    74\t                response = await self.client.messages.create(**request)\n    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n    76\t                await budget.flush(self.deps.pool)\n    77\t                ctx = ctx.finalize(response.usage)\n    78\t                decision = await audit.record(\n    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n    81\t                             \"stop_reason\": response.stop_reason},\n    82\t                )\n    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n    85\t                if not uses:\n    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n    87\t                    items = _parse_items(text)\n    88\t                    await audit.record(\n    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n    90\t                        payload={\"items\": len(items)},\n    91\t                    )\n    92\t                    return items\n    93\t                results = []\n    94\t                for use in uses:\n    95\t                    budget.check_tool_call()\n    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n    97\t                messages.append({\"role\": \"user\", \"content\": results})\n    98\t\n    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n   100\t\n   101\t\n   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n   103\t    try:\n   104\t        data = json.loads(text)\n   105\t    except json.JSONDecodeError as exc:\n   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n   107\t    if not isinstance(data, list) or len(data) > 500:\n   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n   109\t    items = []\n   110\t    for raw in data:\n   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n   114\t    return items\n=== app/redact.py\n     1\t\"\"\"Redaction for model input, logs, audit payloads, and outbound messages.\n     2\t\n     3\tApplied in four places:\n     4\t  * tool results before they are appended to the model context (loop.py)\n     5\t  * every audit payload (audit.py)\n     6\t  * the root logging filter (main.py)\n     7\t  * outbound Slack text (tools/slack.py)\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport logging\n    12\timport re\n    13\tfrom typing import Any\n    14\tfrom urllib.parse import urlparse\n    15\t\n    16\tSECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n    17\t    (\"bearer\", re.compile(r\"(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]{16,}\")),\n    18\t    (\"jwt\", re.compile(r\"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b\")),\n    19\t    (\"acct_token\", re.compile(r\"\\bacct_tok_[A-Za-z0-9_]{8,}\\b\")),\n    20\t    (\"pay_token\", re.compile(r\"\\bpay_tok_[A-Za-z0-9_]{8,}\\b\")),\n    21\t    (\"erp_session\", re.compile(r\"\\berp_sess_[A-Za-z0-9_]{8,}\\b\")),\n    22\t    (\"password_kv\", re.compile(r\"(?i)\\b(password|passwd|secret|api[_-]?key)\\s*[:=]\\s*\\S+\")),\n    23\t]\n    24\t\n    25\t# Bank details: keep the last four characters so staff can still match records.\n    26\tACCOUNT_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n    27\t    (\"iban\", re.compile(r\"\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b\")),\n    28\t    (\"account_no\", re.compile(r\"(?i)\\b(account|acct|routing)\\s*(no\\.?|number|#)?\\s*[:#]?\\s*(\\d[\\d -]{6,}\\d)\")),\n    29\t]\n    30\t\n    31\tMARKDOWN_IMAGE = re.compile(r\"!\\[[^\\]]*\\]\\(([^)\\s]+)[^)]*\\)\")\n    32\tMARKDOWN_LINK = re.compile(r\"(?<!!)\\[([^\\]]*)\\]\\(([^)\\s]+)[^)]*\\)\")\n    33\tSLACK_LINK = re.compile(r\"<(https?://[^|>]+)(\\|[^>]*)?>\")\n    34\tBARE_URL = re.compile(r\"https?://[^\\s<>()]+\")\n    35\t\n    36\tAPPROVED_LINK_HOSTS = frozenset({\"erp.example-corp.test\", \"intranet.example-corp.test\"})\n    37\t\n    38\t\n    39\tdef _mask_tail(match: re.Match[str]) -> str:\n    40\t    text = match.group(0)\n    41\t    return \"[REDACTED:\" + \"*\" * 4 + text[-4:] + \"]\"\n    42\t\n    43\t\n    44\tdef redact_text(text: str) -> str:\n    45\t    for name, pattern in SECRET_PATTERNS:\n    46\t        text = pattern.sub(f\"[REDACTED:{name}]\", text)\n    47\t    for _name, pattern in ACCOUNT_PATTERNS:\n    48\t        text = pattern.sub(_mask_tail, text)\n    49\t    return text\n    50\t\n    51\t\n    52\tdef redact_value(value: Any) -> Any:\n    53\t    if isinstance(value, str):\n    54\t        return redact_text(value)\n    55\t    if isinstance(value, dict):\n    56\t        return {k: redact_value(v) for k, v in value.items()}\n    57\t    if isinstance(value, (list, tuple)):\n    58\t        return [redact_value(v) for v in value]\n    59\t    return value\n    60\t\n    61\t\n    62\tdef redact_for_model(value: Any) -> str:\n    63\t    if not isinstance(value, str):\n    64\t        import json\n    65\t\n    66\t        value = json.dumps(value, default=str)\n    67\t    return redact_text(value)\n    68\t\n    69\t\n    70\tdef _host_ok(url: str) -> bool:\n    71\t    host = (urlparse(url).hostname or \"\").lower()\n    72\t    return host in APPROVED_LINK_HOSTS\n    73\t\n    74\t\n    75\tdef strip_unapproved_links(text: str) -> str:\n    76\t    \"\"\"Remove images entirely and drop links to hosts outside the allowlist.\n    77\t\n    78\t    Slack and most chat clients fetch link and image URLs to render previews,\n    79\t    so an attacker-chosen URL can carry data out without any tool call.\n    80\t    \"\"\"\n    81\t    text = MARKDOWN_IMAGE.sub(\"[image removed]\", text)\n    82\t    text = MARKDOWN_LINK.sub(\n    83\t        lambda m: m.group(0) if _host_ok(m.group(2)) else m.group(1), text\n    84\t    )\n    85\t    text = SLACK_LINK.sub(\n    86\t        lambda m: m.group(0) if _host_ok(m.group(1)) else \"[link removed]\", text\n    87\t    )\n    88\t    text = BARE_URL.sub(\n    89\t        lambda m: m.group(0) if _host_ok(m.group(0)) else \"[link removed]\", text\n    90\t    )\n    91\t    return text\n    92\t\n    93\t\n    94\tclass RedactingFilter(logging.Filter):\n    95\t    def filter(self, record: logging.LogRecord) -> bool:\n    96\t        if isinstance(record.msg, str):\n    97\t            record.msg = redact_text(record.msg)\n    98\t        if record.args:\n    99\t            record.args = tuple(redact_value(a) for a in record.args)\n   100\t        return True\n=== app/tools/__init__.py\n     1\t\"\"\"Tool registry.\n     2\t\n     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n     5\tthat is not in the run's registry.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom functools import lru_cache\n    11\tfrom typing import Any, Awaitable, Callable\n    12\t\n    13\timport yaml\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\t\n    17\tDEFAULT_ROLE = \"procurement\"\n    18\t\n    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Tool:\n    24\t    name: str\n    25\t    description: str\n    26\t    input_schema: dict[str, Any]\n    27\t    invoke: Invoke\n    28\t    target_field: str | None = None\n    29\t\n    30\t    def target_of(self, args: dict[str, Any]) -> str:\n    31\t        if self.target_field is None:\n    32\t            return self.name\n    33\t        return str(args.get(self.target_field, \"\"))\n    34\t\n    35\t    def schema(self) -> dict[str, Any]:\n    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n    37\t\n    38\t\n    39\tclass ToolRegistry:\n    40\t    def __init__(self, tools: list[Tool]):\n    41\t        self._tools = {t.name: t for t in tools}\n    42\t\n    43\t    def get(self, name: str) -> Tool | None:\n    44\t        return self._tools.get(name)\n    45\t\n    46\t    def names(self) -> list[str]:\n    47\t        return sorted(self._tools)\n    48\t\n    49\t    def schemas(self) -> list[dict[str, Any]]:\n    50\t        return [self._tools[n].schema() for n in self.names()]\n    51\t\n    52\t\n    53\t@lru_cache(maxsize=1)\n    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        cfg = yaml.safe_load(fh)\n    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n    58\t\n    59\t\n    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n    61\t    from app.tools import documents, erp, memory, payments, slack\n    62\t\n    63\t    available: dict[str, Tool] = {}\n    64\t    for module in (documents, erp, memory, payments, slack):\n    65\t        for tool in module.tools(deps):\n    66\t            available[tool.name] = tool\n    67\t\n    68\t    roles = _role_tools(str(deps.settings.tools_path))\n    69\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n    70\t    return ToolRegistry([available[name] for name in allowed if name in available])\n=== app/tools/documents.py\n     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tUNTRUSTED_WRAPPER = (\n    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n    11\t    \"{text}\\n\"\n    12\t    \"</untrusted_document>\"\n    13\t)\n    14\t\n    15\t\n    16\tdef tools(deps) -> list[Tool]:\n    17\t    pool = deps.pool\n    18\t\n    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n    20\t        row = await pool.fetchrow(\n    21\t            \"\"\"\n    22\t            SELECT doc_id, source, media_type, text\n    23\t            FROM documents\n    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n    25\t            \"\"\",\n    26\t            args[\"doc_id\"],\n    27\t            ident.tenant,\n    28\t        )\n    29\t        if row is None:\n    30\t            return \"document not found\"\n    31\t        return UNTRUSTED_WRAPPER.format(\n    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n    33\t        )\n    34\t\n    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n    37\t\n    38\t    return [\n    39\t        Tool(\n    40\t            name=\"read_document\",\n    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n    42\t            input_schema={\n    43\t                \"type\": \"object\",\n    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    45\t                \"required\": [\"doc_id\"],\n    46\t                \"additionalProperties\": False,\n    47\t            },\n    48\t            invoke=read_document,\n    49\t        ),\n    50\t        Tool(\n    51\t            name=\"extract_line_items\",\n    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n    53\t            input_schema={\n    54\t                \"type\": \"object\",\n    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    56\t                \"required\": [\"doc_id\"],\n    57\t                \"additionalProperties\": False,\n    58\t            },\n    59\t            invoke=extract_line_items,\n    60\t        ),\n    61\t    ]\n=== app/tools/erp.py\n     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tERP_READ_SCOPE = \"erp.read\"\n    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n    11\t\n    12\t\n    13\tdef tools(deps) -> list[Tool]:\n    14\t    erp = deps.erp\n    15\t\n    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n    17\t        return await erp.call(\n    18\t            \"budget.get_remaining\",\n    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n    20\t            ident,\n    21\t            ERP_READ_SCOPE,\n    22\t        )\n    23\t\n    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n    25\t        arguments = dict(args.get(\"arguments\", {}))\n    26\t        arguments[\"business_unit\"] = ident.tenant\n    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n    28\t\n    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n    30\t        return await erp.call(\n    31\t            \"po.create\",\n    32\t            {\n    33\t                \"business_unit\": ident.tenant,\n    34\t                \"department\": args[\"department\"],\n    35\t                \"vendor_id\": args[\"vendor_id\"],\n    36\t                \"lines\": args[\"lines\"],\n    37\t                \"currency\": args[\"currency\"],\n    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n    39\t                \"client_reference\": args[\"source_doc_id\"],\n    40\t            },\n    41\t            ident,\n    42\t            ERP_PO_WRITE_SCOPE,\n    43\t        )\n    44\t\n    45\t    line_schema = {\n    46\t        \"type\": \"object\",\n    47\t        \"properties\": {\n    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n    52\t        },\n    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n    54\t        \"additionalProperties\": False,\n    55\t    }\n    56\t\n    57\t    return [\n    58\t        Tool(\n    59\t            name=\"get_budget\",\n    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n    61\t            input_schema={\n    62\t                \"type\": \"object\",\n    63\t                \"properties\": {\n    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n    66\t                },\n    67\t                \"required\": [\"department\", \"fiscal_period\"],\n    68\t                \"additionalProperties\": False,\n    69\t            },\n    70\t            invoke=get_budget,\n    71\t        ),\n    72\t        Tool(\n    73\t            name=\"erp_call\",\n    74\t            description=(\n    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n    77\t            ),\n    78\t            input_schema={\n    79\t                \"type\": \"object\",\n    80\t                \"properties\": {\n    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n    82\t                    \"arguments\": {\"type\": \"object\"},\n    83\t                },\n    84\t                \"required\": [\"operation\"],\n    85\t                \"additionalProperties\": False,\n    86\t            },\n    87\t            invoke=erp_call,\n    88\t        ),\n    89\t        Tool(\n    90\t            name=\"create_purchase_order\",\n    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n    92\t            input_schema={\n    93\t                \"type\": \"object\",\n    94\t                \"properties\": {\n    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n   100\t                },\n   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n   102\t                \"additionalProperties\": False,\n   103\t            },\n   104\t            invoke=create_purchase_order,\n   105\t            target_field=\"source_doc_id\",\n   106\t        ),\n   107\t    ]\n=== app/mcp_client.py\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n","numLines":777,"startLine":1,"totalLines":777}},"tool_result_meta":[{"id":"toolu_01PEgfgeZAb6X2uep5zwRgZB","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
