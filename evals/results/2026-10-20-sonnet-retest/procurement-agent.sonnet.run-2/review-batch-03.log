ol) -> None:\n        \"\"\"Add this run's unflushed spend to the daily quotas, or stop the run.\"\"\"\n        if self.unflushed_cost_usd <= 0:\n            return\n        amount = self.unflushed_cost_usd\n        async with pool.acquire() as conn:\n            async with conn.transaction():\n                for scope, key in self._scopes():\n                    limit = self.quotas_daily_usd[scope]\n                    spent = await conn.fetchval(\n                        \"\"\"\n                        INSERT INTO spend_quota (scope, key, day, spent_usd)\n                        VALUES ($1, $2, current_date, $3)\n                        ON CONFLICT (scope, key, day)\n                        DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd\n                        RETURNING spent_usd\n                        \"\"\",\n                        scope,\n                        key,\n                        amount,\n                    )\n                    if spent > limit:\n                        raise BudgetExceeded(f\"quota_daily_usd.{scope}\", spent, limit)\n        self.unflushed_cost_usd = Decimal(\"0\")\nfrom __future__ import annotations\n\n\nclass AgentHalted(Exception):\n    pass\n\n\n_QUERY = \"\"\"\nSELECT scope, reason, set_by, set_at\nFROM control_flags\nWHERE halted\n  AND (scope = 'fleet' OR scope = $1)\nORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\nLIMIT 1\n\"\"\"\n\n\nasync def assert_running(pool, tenant: str) -> None:\n    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n    if row is not None:\n        raise AgentHalted(\n            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n            f\"(scope={row['scope']}): {row['reason']}\"\n        )","stderr":"","interrupted":false,"isImage":false,"returnCodeInterpretation":"No matches found","noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Dw2c5BTzkaEkqLLZUjWbqF","permission_decision":{"decision":"accept","source":"config","reason_typ