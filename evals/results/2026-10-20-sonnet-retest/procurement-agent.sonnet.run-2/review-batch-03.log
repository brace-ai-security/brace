rameters.\"),\n  row(\"app/tools/memory.py\",\"WHERE business_unit = $1\",\"memory_read SQL\",\"enforced\",\"Note lookup binds all inputs as parameters.\"),\n  row(\"app/tools/memory.py\",\"INSERT INTO dept_notes (\",\"memory_write SQL\",\"enforced\",\"Note insert binds all values as parameters.\"),\n  row(\"app/approvals.py\",\"WHERE tool = $1\",\"approval lookup SQL\",\"enforced\",\"Approval lookup binds tool, target and tenant.\"),\n  row(\"app/ingest.py\",\"INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)\",\"document insert SQL\",\"enforced\",\"Accepted document insert binds all values.\",nth=2),\n  row(\"app/audit.py\",\"$22::jsonb\",\"audit insert SQL\",\"enforced\",\"Audit insert binds every value including payload.\"),\n  row(\"app/budget.py\",\"VALUES ($1, $2, date_trunc('minute', now()), 1)\",\"run start quota SQL\",\"enforced\",\"Quota statements bind scope and key.\"),\n  row(\"app/killswitch.py\",\"AND (scope = 'fleet' OR scope = $1)\",\"kill switch SQL\",\"enforced\",\"Halt lookup binds the tenant scope.\"),\n  row(\"app/main.py\",\"WHERE slack_user_id = $1 AND active\",\"approver lookup SQL\",\"enforced\",\"Approver lookup binds the Slack user id.\"),\n  row(\"app/main.py\",\"UPDATE approvals SET status = 'expired'\",\"expiry sweep SQL\",\"enforced\",\"Sweep SQL is a constant string with no inputs.\"),\n  row(\"app/ingest.py\",\"hashlib.sha256(doc.raw).hexdigest(), text,\",\"no shell or HTML sinks\",\"not_applicable\",\"No subprocess, shell or HTML rendering exists in the app code.\"),\n ])\ncheck(\"R03.4\",\"yes\",\"app/audit.py\",\"json.dumps(redact_value(payload or {}), default=str),\",\n \"Audit rows store the redacted payload, including the tool result, rather than dropping the record.\",\n counter=\"Searched for redaction paths that drop records; redact_value returns a redacted copy and audit.record always inserts the row. loop.py also stores a result_sha256 of the original.\",\n rows=[\n  row(\"app/audit.py\",\"json.dumps(redact_value(payload or {}), default=str),\",\"audit payload redaction\",\"enforced\",\"Payload is redacted then inserted, so redacted evidence is kept.\"),\n  row(\"app/loop.py\",'payload={\"result_sha256\": audit.digest(output), \"result\": output},',\"tool result audit\",\"enforced\",\"Tool result is recorded with a digest and passes through audit redaction.\"),\n ])\nflag(\"R03\",\"app/redact.py\",\"if isinstance(record.msg, str):\",\"Log filter redacts msg and args but not exception tracebacks (exc_info), and uvicorn's own handlers bypass it.\")\nitem(\"R03\",\"gap\",\"Log redaction skips exception tracebacks and truncates error text before redaction.\",\n \"Redact exc_info and exc_text in the filter, attach it to uvicorn loggers, and redact before truncating errors.\",\n violates=\"Remove secrets and limit sensitive data before tool output, debug output, or responses reach the model, outside recipients, or normal logs\")\nE\nPYTHONPATH=. /Users/brenn/.cache/uv/builds-v0/.tmpR1cD4H/bin/python p3.py 2>&1 | grep -v \"^ *$\" | grep -iv \"How to verify\\|^Saved ledger\" | cut -c1-250"}},"wire_ingest_context":{"toolu_01EEeHWpeQ5XqeVYCrhYBASH":{"cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-rwokbux3/work"}}}
