put, not a deployed reference.\",\n      \"coverage\": [\n        {\"subject\": \"Deployment container agent\", \"status\": \"enforced\", \"evidence\": \"agent/deploy/k8s/deployment.yaml:32\", \"quote\": \"image: registry.example-corp.test/procurement/agent@sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\", \"note\": \"digest-pinned\"},\n        {\"subject\": \"Dockerfile build stage base image\", \"status\": \"enforced\", \"evidence\": \"agent/Dockerfile:2\", \"quote\": \"FROM python:3.11.10-slim-bookworm@sha256:2a6386ad2db20e7f55073f69a98d6da2cf9f168e05e7487d2670c22e4ad2a1bd AS build\", \"note\": \"digest-pinned\"},\n        {\"subject\": \"Dockerfile runtime base image\", \"status\": \"enforced\", \"evidence\": \"agent/Dockerfile:10\", \"quote\": \"FROM gcr.io/distroless/python3-debian12:nonroot@sha256:8f3c1a6e2b9d4f7a0c5e8b1d3f6a9c2e5b8d1f4a7c0e3b6d9f2a5c8e1b4d7f0a\", \"note\": \"digest-pinned\"},\n        {\"subject\": \"Admission rule only-approved-registry\", \"status\": \"enforced\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:25\", \"quote\": \"- image: \\\"registry.example-corp.test/procurement/*@sha256:*\\\"\", \"note\": \"rejects tag-only images in procurement-prod\"}\n      ],\n      \"deviations\": [],\n      \"attempts\": [\n        {\"category\": \"tag-only image\", \"input\": \"Pod in procurement-prod with image agent:latest\", \"trace\": \"Rule only-approved-registry pattern requires @sha256: in containers[].image and in optional initContainers\", \"outcome\": \"blocked\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:27\", \"quote\": \"- image: \\\"registry.example-corp.test/procurement/*@sha256:*\\\"\"}\n      ]\n    },\n    {\n      \"id\": \"B10.2\",\n      \"result\": \"holds\",\n      \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:43-44\",\n      \"quote\": \"issuer: \\\"https://token.actions.githubusercontent.com\\\"\\nsubject: \\\"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\\\"\",\n      \"note\": \"Keyless attestor uses an exact issuer and exact subject. There are no regex or wildcard identity fields. The same pair is used for the SLSA and CycloneDX attestors.\",\n      \"coverage\": [\n        {\"subject\": \"Image signature attestor\", \"status\": \"enforced\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:42-46\", \"quote\": \"subject: \\\"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\\\"\", \"note\": \"exact issuer and subject, rekor set\"},\n        {\"subject\": \"Attestation attestors (SLSA, CycloneDX)\", \"status\": \"enforced\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:52-53, 75-76\", \"quote\": \"subject: \\\"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\\\"\", \"note\": \"exact identity\"},\n        {\"subject\": \"Digest verification\", \"status\": \"enforced\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:38\", \"quote\": \"verifyDigest: true\", \"note\": \"digest checked\"}\n      ],\n      \"deviations\": [],\n      \"attempts\": [\n        {\"category\": \"wrong signer identity\", \"input\": \"Image signed by a different repo or workflow via the same GitHub OIDC issuer\", \"trace\": \"Subject is an exact string, so a different subject fails attestor matching\", \"outcome\": \"blocked\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:44\", \"quote\": \"subject: \\\"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\\\"\"}\n      ]\n    },\n    {\n      \"id\": \"B10.3\",\n      \"result\": \"holds\",\n      \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:56-70\",\n      \"quote\": \"- key: \\\"{{ buildDefinition.buildType }}\\\"\\n- key: \\\"{{ runDetails.builder.id }}\\\"\",\n      \"note\": \"The SLSA v1 attestation conditions use Equals on buildType, workflow reposito