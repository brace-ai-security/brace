": \"holds\",\n      \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:56-70\",\n      \"quote\": \"- key: \\\"{{ buildDefinition.buildType }}\\\"\\n- key: \\\"{{ runDetails.builder.id }}\\\"\",\n      \"note\": \"The SLSA v1 attestation conditions use Equals on buildType, workflow repository, ref, path and builder id. The workflow repository, ref and path are the externalParameters. Nothing uses a wildcard. CI emits the provenance with actions/attest-build-provenance. Residual: other externalParameters, such as workflow inputs, are not compared.\",\n      \"coverage\": [\n        {\"subject\": \"buildType\", \"status\": \"enforced\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:56-58\", \"quote\": \"value: \\\"https://actions.github.io/buildtypes/workflow/v1\\\"\", \"note\": \"Equals\"},\n        {\"subject\": \"source repository (externalParameters.workflow.repository)\", \"status\": \"enforced\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:59-61\", \"quote\": \"value: \\\"https://github.com/example-corp/procurement-agent\\\"\", \"note\": \"Equals\"},\n        {\"subject\": \"externalParameters ref and path\", \"status\": \"enforced\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:62-67\", \"quote\": \"value: \\\".github/workflows/ci.yaml\\\"\", \"note\": \"Equals\"},\n        {\"subject\": \"builder id\", \"status\": \"enforced\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:68-70\", \"quote\": \"value: \\\"https://github.com/actions/runner/github-hosted\\\"\", \"note\": \"Equals\"},\n        {\"subject\": \"CI provenance generation\", \"status\": \"enforced\", \"evidence\": \"agent/.github/workflows/ci.yaml:79\", \"quote\": \"- uses: actions/attest-build-provenance@1c608d11d69870c2092266b3f9a6f3abbf17002c # v1.4.3\", \"note\": \"provenance is produced and then verified at admission\"}\n      ],\n      \"deviations\": [],\n      \"attempts\": [\n        {\"category\": \"provenance from a different ref\", \"input\": \"Image built from a feature branch or a fork\", \"trace\": \"externalParameters.workflow.ref and repository are compared with Equals, and the signer subject is pinned to refs/heads/main\", \"outcome\": \"blocked\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:62-64\", \"quote\": \"value: \\\"refs/heads/main\\\"\"}\n      ]\n    },\n    {\n      \"id\": \"B10.4\",\n      \"result\": \"holds\",\n      \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:9-12\",\n      \"quote\": \"validationFailureAction: Enforce\\nfailurePolicy: Fail\",\n      \"note\": \"The policy is in Enforce mode with failurePolicy Fail. It matches Pods in procurement-prod, which is the only prod namespace in the repo, and has no exclusions. Any non-conforming image is denied by the registry and digest pattern rule. verifyImages sets required: true.\",\n      \"coverage\": [\n        {\"subject\": \"mode and failure policy\", \"status\": \"enforced\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:9, 12\", \"quote\": \"validationFailureAction: Enforce\", \"note\": \"Enforce and Fail\"},\n        {\"subject\": \"namespace scope\", \"status\": \"enforced\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:19\", \"quote\": \"namespaces: [procurement-prod]\", \"note\": \"matches the Deployment namespace procurement-prod; no exclude block\"},\n        {\"subject\": \"no-match deny\", \"status\": \"enforced\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:25, 39\", \"quote\": \"required: true\", \"note\": \"images from other registries fail the pattern rule; matching images must verify\"}\n      ],\n      \"deviations\": [],\n      \"attempts\": [\n        {\"category\": \"unapproved image\", \"input\": \"docker.io/evil/agent@sha256:... deployed into procurement-prod\", \"trace\": \"Fails the registry pattern in only-approved-registry, so the policy denies it\", \"outcome\": \"blocked\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:21\", \"quote\": \"message: \\\"Images in procurement-prod must come from registry.example-corp.test/procurement and be pinned by digest.\\\"\"}\n      ]\n    },\n    {\n      \"id\": \"B10.5\",\n      \"result\": \"unclear\",\n      \"evidence\": \"agent/.github/workflows/ci.yaml:52, agent/deploy/k8s/kyverno-verify-images.yaml:7\",\n      \"quote\": \"cosign-release: \\\"v2.6.2\\\"\\nkyverno.io/kyverno-version: \\\"1.15.2\\\"\",\n      \"note\": \"The CI signer pin of v2.6.2 meets the 2.6.2 minimum. The admission verifier is Kyverno 1.15.2, which embeds its own cosign library, and the repo does not show that embedded version. 1.15.2 is an annotation, not a deployment pin. The embedded cosign cannot be shown to be at or above 2.6.2 or 3.0.4 from the repo, so this is unresolved.\",\n      \"coverage\": [\n        {\"subject\": \"CI cosign-installer release\", \"status\": \"enforced\", \"evidence\": \"agent/.github/workflows/ci.yaml:52\", \"quote\": \"cosign-release: \\\"v2.6.2\\\"\", \"note\": \"equals the minimum for 2.x\"},\n        {\"subject\": \"Admission verifier (Kyverno embedded cosign)\", \"status\": \"unclear\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:7\", \"quote\": \"kyverno.io/kyverno-version: \\\"1.15.2\\\"\", \"note\": \"embedded cosign version is not stated in the repo; there is no Kyverno chart or install pin\"},\n        {\"subject\": \"Dockerfile verifier\", \"status\": \"not_applicable\", \"evidence\": \"agent/Dockerfile:1\", \"quote\": \"# syntax=docker/dockerfile:1.10\", \"note\": \"no cosign in the image\"}\n      ],\n      \"deviations\": [],\n      \"attempts\": [\n        {\"category\": \"vulnerable verifier at admission\", \"input\": \"A bundle whose transparency-log entry does not match the artifact\", \"trace\": \"Admission verification runs in Kyverno 1.15.2. Its embedded cosign version is not in the repo, so whether it has the fix cannot be determined.\", \"outcome\": \"unclear\", \"evidence\": \"agent/deploy/k8s/kyverno-verify-images.yaml:7\", \"quote\": \"kyverno.io/kyverno-version: \\\"1.15.2\\\"\"}\n      ]\n    }\n  ]\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01LmypjL9cjdAFjqhJo31NdF","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
