{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDZmxXJFRmC8pWvom9jC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JAiuvsj2n1wPLqtneSpPbe","name":"Bash","input":{"command":"for f in app/audit.py app/mcp_client.py app/loop.py app/context_size.py app/startup.py app/tools/__init__.py; do echo \"=== $f\"; cat -n $f; done"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1168,"cache_read_input_tokens":22529,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1168},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"30aafd76-3534-4666-ab29-0933a8953e34","uuid":"e4c6036d-65f7-4b68-92d4-386f1c8c7116","timestamp":"2026-10-20T13:26:52.797Z","request_id":"req_011CgDZmxFvXMyRNgUq5MfMU","wire_tool_inputs":{"toolu_01JAiuvsj2n1wPLqtneSpPbe":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-flvfok0r/agent && for f in app/audit.py app/mcp_client.py app/loop.py app/context_size.py app/startup.py app/tools/__init__.py; do echo \"=== $f\"; cat -n $f; done"}},"wire_ingest_context":{"toolu_01JAiuvsj2n1wPLqtneSpPbe":{"cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-flvfok0r/agent"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JAiuvsj2n1wPLqtneSpPbe","type":"tool_result","content":"=== app/audit.py\n     1\t\"\"\"Execution audit graph.\n     2\t\n     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n     5\ttool call -> authorization decision -> result or error. Writes are\n     6\tsynchronous and are made before the action they describe; if the write\n     7\tfails, the caller raises and the action does not run.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport hashlib\n    12\timport json\n    13\timport uuid\n    14\tfrom datetime import datetime, timezone\n    15\tfrom typing import Any\n    16\t\n    17\tfrom opentelemetry import trace\n    18\t\n    19\tfrom app.context_size import ContextMeasure\n    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n    21\tfrom app.redact import redact_value\n    22\t\n    23\tEVENT_KINDS = {\n    24\t    \"run_started\",\n    25\t    \"run_finished\",\n    26\t    \"run_halted\",\n    27\t    \"model_decision\",\n    28\t    \"tool_proposed\",\n    29\t    \"authz_decision\",\n    30\t    \"approval_requested\",\n    31\t    \"approval_decided\",\n    32\t    \"tool_result\",\n    33\t    \"tool_error\",\n    34\t    \"tool_denied\",\n    35\t    \"budget_exceeded\",\n    36\t    \"subagent_started\",\n    37\t    \"subagent_finished\",\n    38\t    \"background_job\",\n    39\t}\n    40\t\n    41\t_INSERT = \"\"\"\n    42\tINSERT INTO audit_events (\n    43\t    node_id, parent_node_id, run_id, ts, kind,\n    44\t    accountable_party, operational_owner, tenant,\n    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n    46\t    delegated_subject, agent_principal, parent_instance_id,\n    47\t    policy_version, approval_id, operation_id,\n    48\t    context_tokens, context_method, context_compacted,\n    49\t    payload\n    50\t) VALUES (\n    51\t    $1, $2, $3, $4, $5,\n    52\t    $6, $7, $8,\n    53\t    $9, $10, $11, $12,\n    54\t    $13, $14, $15,\n    55\t    $16, $17, $18,\n    56\t    $19, $20, $21,\n    57\t    $22::jsonb\n    58\t)\n    59\t\"\"\"\n    60\t\n    61\t\n    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n    64\t    return {k: redact_value(v) for k, v in args.items()}\n    65\t\n    66\t\n    67\tdef digest(value: Any) -> str:\n    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    70\t\n    71\t\n    72\tasync def record(\n    73\t    pool,\n    74\t    ident: RunIdentity,\n    75\t    *,\n    76\t    kind: str,\n    77\t    payload: dict[str, Any] | None = None,\n    78\t    parent: str | None = None,\n    79\t    context: ContextMeasure | None = None,\n    80\t    policy_version: str | None = None,\n    81\t    approval_id: str | None = None,\n    82\t    operation_id: str | None = None,\n    83\t) -> str:\n    84\t    if kind not in EVENT_KINDS:\n    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n    86\t    for name in IDENTITY_FIELDS:\n    87\t        if not getattr(ident, name):\n    88\t            raise ValueError(f\"audit record missing {name}\")\n    89\t    span_ctx = trace.get_current_span().get_span_context()\n    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n    91\t    node_id = f\"node-{uuid.uuid4()}\"\n    92\t    measure = context or ContextMeasure.unavailable()\n    93\t    await pool.execute(\n    94\t        _INSERT,\n    95\t        node_id,\n    96\t        parent,\n    97\t        ident.run_id,\n    98\t        datetime.now(timezone.utc),\n    99\t        kind,\n   100\t        ident.accountable_party,\n   101\t        ident.operational_owner,\n   102\t        ident.tenant,\n   103\t        ident.agent_type_id,\n   104\t        ident.agent_instance_id,\n   105\t        ident.trace_id,\n   106\t        span_id,\n   107\t        ident.delegated_subject,\n   108\t        ident.agent_principal,\n   109\t        ident.parent_instance_id,\n   110\t        policy_version,\n   111\t        approval_id,\n   112\t        operation_id,\n   113\t        measure.tokens,\n   114\t        measure.method,\n   115\t        measure.compacted,\n   116\t        json.dumps(redact_value(payload or {}), default=str),\n   117\t    )\n   118\t    return node_id\n=== app/mcp_client.py\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n=== app/loop.py\n     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n=== app/context_size.py\n     1\t\"\"\"Decision-time context size.\n     2\t\n     3\tCounting method (documented in README, \"Context size\"):\n     4\t\n     5\t1. Before each model call, the exact request (system prompt, messages and\n     6\t   tool schemas) is sent to the provider's token-counting endpoint. The\n     7\t   returned ``input_tokens`` is recorded with method ``count_tokens_api``.\n     8\t   This is the size of the context the model decides on, including any\n     9\t   prefix that will be served from the prompt cache.\n    10\t2. If counting fails, the value is taken after the call from the response\n    11\t   usage as ``input_tokens + cache_read_input_tokens +\n    12\t   cache_creation_input_tokens`` and recorded with method\n    13\t   ``usage_sum_estimate``.\n    14\t3. If neither is available the value is ``NULL`` with method\n    15\t   ``unavailable``. It is never recorded as zero.\n    16\t\n    17\t``compacted`` is true when the harness dropped or summarized earlier turns\n    18\tbefore this call. Provider-side truncation is not visible to the harness and\n    19\tis listed as a known limit.\n    20\t\"\"\"\n    21\tfrom __future__ import annotations\n    22\t\n    23\timport logging\n    24\tfrom dataclasses import dataclass, replace\n    25\t\n    26\tlog = logging.getLogger(__name__)\n    27\t\n    28\t\n    29\t@dataclass(frozen=True)\n    30\tclass ContextMeasure:\n    31\t    tokens: int | None\n    32\t    method: str\n    33\t    compacted: bool\n    34\t\n    35\t    @classmethod\n    36\t    def unavailable(cls, compacted: bool = False) -> \"ContextMeasure\":\n    37\t        return cls(tokens=None, method=\"unavailable\", compacted=compacted)\n    38\t\n    39\t    def finalize(self, usage) -> \"ContextMeasure\":\n    40\t        if self.tokens is not None:\n    41\t            return self\n    42\t        if usage is None:\n    43\t            return ContextMeasure.unavailable(self.compacted)\n    44\t        total = (\n    45\t            int(usage.input_tokens or 0)\n    46\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n    47\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n    48\t        )\n    49\t        if total <= 0:\n    50\t            return ContextMeasure.unavailable(self.compacted)\n    51\t        return replace(self, tokens=total, method=\"usage_sum_estimate\")\n    52\t\n    53\t    def otel_attributes(self) -> dict:\n    54\t        attrs = {\n    55\t            \"procurement.context.method\": self.method,\n    56\t            \"gen_ai.conversation.compacted\": self.compacted,\n    57\t        }\n    58\t        if self.tokens is not None:\n    59\t            attrs[\"procurement.context.tokens\"] = self.tokens\n    60\t        return attrs\n    61\t\n    62\t\n    63\tasync def measure_context(client, request: dict, compacted: bool) -> ContextMeasure:\n    64\t    try:\n    65\t        counted = await client.messages.count_tokens(\n    66\t            model=request[\"model\"],\n    67\t            system=request[\"system\"],\n    68\t            messages=request[\"messages\"],\n    69\t            tools=request[\"tools\"],\n    70\t        )\n    71\t        return ContextMeasure(int(counted.input_tokens), \"count_tokens_api\", compacted)\n    72\t    except Exception:  # counting is best effort; finalize() falls back to usage\n    73\t        log.warning(\"token count failed; falling back to usage\", exc_info=True)\n    74\t        return ContextMeasure(tokens=None, method=\"pending_usage\", compacted=compacted)\n=== app/startup.py\n     1\t\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\timport logging\n     6\tfrom pathlib import Path\n     7\t\n     8\tfrom app.identity import compute_agent_type_id\n     9\tfrom app.settings import Settings\n    10\t\n    11\tlog = logging.getLogger(__name__)\n    12\t\n    13\t\n    14\tdef sha256_file(path: Path) -> str:\n    15\t    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n    16\t\n    17\t\n    18\tdef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n    19\t    mismatches: list[str] = []\n    20\t    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n    21\t        mismatches.append(f\"image: running {settings.image_digest}\")\n    22\t    for name, entry in manifest[\"prompts\"].items():\n    23\t        path = settings.prompt_dir / Path(entry[\"path\"]).name\n    24\t        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n    25\t            mismatches.append(f\"prompt:{name}\")\n    26\t    for name in (\"policy\", \"tools\"):\n    27\t        entry = manifest[\"config\"][name]\n    28\t        path = settings.policy_path if name == \"policy\" else settings.tools_path\n    29\t        if sha256_file(path) != entry[\"sha256\"]:\n    30\t            mismatches.append(f\"config:{name}\")\n    31\t    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n    32\t        mismatches.append(\"model:primary\")\n    33\t    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n    34\t        mismatches.append(\"model:extractor\")\n    35\t    return mismatches\n    36\t\n    37\t\n    38\tdef startup_checks(settings: Settings) -> str:\n    39\t    \"\"\"Return the agent-type-id for this process.\"\"\"\n    40\t    manifest = settings.manifest\n    41\t    mismatches = running_state_mismatches(settings, manifest)\n    42\t    if mismatches:\n    43\t        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n    44\t    agent_type_id = compute_agent_type_id(manifest)\n    45\t    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n    46\t    return agent_type_id\n=== app/tools/__init__.py\n     1\t\"\"\"Tool registry.\n     2\t\n     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n     5\tthat is not in the run's registry.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom functools import lru_cache\n    11\tfrom typing import Any, Awaitable, Callable\n    12\t\n    13\timport yaml\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\t\n    17\tDEFAULT_ROLE = \"procurement\"\n    18\t\n    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Tool:\n    24\t    name: str\n    25\t    description: str\n    26\t    input_schema: dict[str, Any]\n    27\t    invoke: Invoke\n    28\t    target_field: str | None = None\n    29\t\n    30\t    def target_of(self, args: dict[str, Any]) -> str:\n    31\t        if self.target_field is None:\n    32\t            return self.name\n    33\t        return str(args.get(self.target_field, \"\"))\n    34\t\n    35\t    def schema(self) -> dict[str, Any]:\n    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n    37\t\n    38\t\n    39\tclass ToolRegistry:\n    40\t    def __init__(self, tools: list[Tool]):\n    41\t        self._tools = {t.name: t for t in tools}\n    42\t\n    43\t    def get(self, name: str) -> Tool | None:\n    44\t        return self._tools.get(name)\n    45\t\n    46\t    def names(self) -> list[str]:\n    47\t        return sorted(self._tools)\n    48\t\n    49\t    def schemas(self) -> list[dict[str, Any]]:\n    50\t        return [self._tools[n].schema() for n in self.names()]\n    51\t\n    52\t\n    53\t@lru_cache(maxsize=1)\n    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        cfg = yaml.safe_load(fh)\n    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n    58\t\n    59\t\n    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n    61\t    from app.tools import documents, erp, memory, payments, slack\n    62\t\n    63\t    available: dict[str, Tool] = {}\n    64\t    for module in (documents, erp, memory, payments, slack):\n    65\t        for tool in module.tools(deps):\n    66\t            available[tool.name] = tool\n    67\t\n    68\t    roles = _role_tools(str(deps.settings.tools_path))\n    69\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n    70\t    return ToolRegistry([available[name] for name in allowed if name in available])","is_error":false}]},"parent_tool_use_id":null,"session_id":"30aafd76-3534-4666-ab29-0933a8953e34","uuid":"c12430ec-c3fb-4c75-a111-d35800ea5d98","timestamp":"2026-10-20T13:26:52.846Z","tool_use_result":{"stdout":"=== app/audit.py\n     1\t\"\"\"Execution audit graph.\n     2\t\n     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n     5\ttool call -> authorization decision -> result or error. Writes are\n     6\tsynchronous and are made before the action they describe; if the write\n     7\tfails, the caller raises and the action does not run.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport hashlib\n    12\timport json\n    13\timport uuid\n    14\tfrom datetime import datetime, timezone\n    15\tfrom typing import Any\n    16\t\n    17\tfrom opentelemetry import trace\n    18\t\n    19\tfrom app.context_size import ContextMeasure\n    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n    21\tfrom app.redact import redact_value\n    22\t\n    23\tEVENT_KINDS = {\n    24\t    \"run_started\",\n    25\t    \"run_finished\",\n    26\t    \"run_halted\",\n    27\t    \"model_decision\",\n    28\t    \"tool_proposed\",\n    29\t    \"authz_decision\",\n    30\t    \"approval_requested\",\n    31\t    \"approval_decided\",\n    32\t    \"tool_result\",\n    33\t    \"tool_error\",\n    34\t    \"tool_denied\",\n    35\t    \"budget_exceeded\",\n    36\t    \"subagent_started\",\n    37\t    \"subagent_finished\",\n    38\t    \"background_job\",\n    39\t}\n    40\t\n    41\t_INSERT = \"\"\"\n    42\tINSERT INTO audit_events (\n    43\t    node_id, parent_node_id, run_id, ts, kind,\n    44\t    accountable_party, operational_owner, tenant,\n    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n    46\t    delegated_subject, agent_principal, parent_instance_id,\n    47\t    policy_version, approval_id, operation_id,\n    48\t    context_tokens, context_method, context_compacted,\n    49\t    payload\n    50\t) VALUES (\n    51\t    $1, $2, $3, $4, $5,\n    52\t    $6, $7, $8,\n    53\t    $9, $10, $11, $12,\n    54\t    $13, $14, $15,\n    55\t    $16, $17, $18,\n    56\t    $19, $20, $21,\n    57\t    $22::jsonb\n    58\t)\n    59\t\"\"\"\n    60\t\n    61\t\n    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n    64\t    return {k: redact_value(v) for k, v in args.items()}\n    65\t\n    66\t\n    67\tdef digest(value: Any) -> str:\n    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    70\t\n    71\t\n    72\tasync def record(\n    73\t    pool,\n    74\t    ident: RunIdentity,\n    75\t    *,\n    76\t    kind: str,\n    77\t    payload: dict[str, Any] | None = None,\n    78\t    parent: str | None = None,\n    79\t    context: ContextMeasure | None = None,\n    80\t    policy_version: str | None = None,\n    81\t    approval_id: str | None = None,\n    82\t    operation_id: str | None = None,\n    83\t) -> str:\n    84\t    if kind not in EVENT_KINDS:\n    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n    86\t    for name in IDENTITY_FIELDS:\n    87\t        if not getattr(ident, name):\n    88\t            raise ValueError(f\"audit record missing {name}\")\n    89\t    span_ctx = trace.get_current_span().get_span_context()\n    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n    91\t    node_id = f\"node-{uuid.uuid4()}\"\n    92\t    measure = context or ContextMeasure.unavailable()\n    93\t    await pool.execute(\n    94\t        _INSERT,\n    95\t        node_id,\n    96\t        parent,\n    97\t        ident.run_id,\n    98\t        datetime.now(timezone.utc),\n    99\t        kind,\n   100\t        ident.accountable_party,\n   101\t        ident.operational_owner,\n   102\t        ident.tenant,\n   103\t        ident.agent_type_id,\n   104\t        ident.agent_instance_id,\n   105\t        ident.trace_id,\n   106\t        span_id,\n   107\t        ident.delegated_subject,\n   108\t        ident.agent_principal,\n   109\t        ident.parent_instance_id,\n   110\t        policy_version,\n   111\t        approval_id,\n   112\t        operation_id,\n   113\t        measure.tokens,\n   114\t        measure.method,\n   115\t        measure.compacted,\n   116\t        json.dumps(redact_value(payload or {}), default=str),\n   117\t    )\n   118\t    return node_id\n=== app/mcp_client.py\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n=== app/loop.py\n     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n=== app/context_size.py\n     1\t\"\"\"Decision-time context size.\n     2\t\n     3\tCounting method (documented in README, \"Context size\"):\n     4\t\n     5\t1. Before each model call, the exact request (system prompt, messages and\n     6\t   tool schemas) is sent to the provider's token-counting endpoint. The\n     7\t   returned ``input_tokens`` is recorded with method ``count_tokens_api``.\n     8\t   This is the size of the context the model decides on, including any\n     9\t   prefix that will be served from the prompt cache.\n    10\t2. If counting fails, the value is taken after the call from the response\n    11\t   usage as ``input_tokens + cache_read_input_tokens +\n    12\t   cache_creation_input_tokens`` and recorded with method\n    13\t   ``usage_sum_estimate``.\n    14\t3. If neither is available the value is ``NULL`` with method\n    15\t   ``unavailable``. It is never recorded as zero.\n    16\t\n    17\t``compacted`` is true when the harness dropped or summarized earlier turns\n    18\tbefore this call. Provider-side truncation is not visible to the harness and\n    19\tis listed as a known limit.\n    20\t\"\"\"\n    21\tfrom __future__ import annotations\n    22\t\n    23\timport logging\n    24\tfrom dataclasses import dataclass, replace\n    25\t\n    26\tlog = logging.getLogger(__name__)\n    27\t\n    28\t\n    29\t@dataclass(frozen=True)\n    30\tclass ContextMeasure:\n    31\t    tokens: int | None\n    32\t    method: str\n    33\t    compacted: bool\n    34\t\n    35\t    @classmethod\n    36\t    def unavailable(cls, compacted: bool = False) -> \"ContextMeasure\":\n    37\t        return cls(tokens=None, method=\"unavailable\", compacted=compacted)\n    38\t\n    39\t    def finalize(self, usage) -> \"ContextMeasure\":\n    40\t        if self.tokens is not None:\n    41\t            return self\n    42\t        if usage is None:\n    43\t            return ContextMeasure.unavailable(self.compacted)\n    44\t        total = (\n    45\t            int(usage.input_tokens or 0)\n    46\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n    47\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n    48\t        )\n    49\t        if total <= 0:\n    50\t            return ContextMeasure.unavailable(self.compacted)\n    51\t        return replace(self, tokens=total, method=\"usage_sum_estimate\")\n    52\t\n    53\t    def otel_attributes(self) -> dict:\n    54\t        attrs = {\n    55\t            \"procurement.context.method\": self.method,\n    56\t            \"gen_ai.conversation.compacted\": self.compacted,\n    57\t        }\n    58\t        if self.tokens is not None:\n    59\t            attrs[\"procurement.context.tokens\"] = self.tokens\n    60\t        return attrs\n    61\t\n    62\t\n    63\tasync def measure_context(client, request: dict, compacted: bool) -> ContextMeasure:\n    64\t    try:\n    65\t        counted = await client.messages.count_tokens(\n    66\t            model=request[\"model\"],\n    67\t            system=request[\"system\"],\n    68\t            messages=request[\"messages\"],\n    69\t            tools=request[\"tools\"],\n    70\t        )\n    71\t        return ContextMeasure(int(counted.input_tokens), \"count_tokens_api\", compacted)\n    72\t    except Exception:  # counting is best effort; finalize() falls back to usage\n    73\t        log.warning(\"token count failed; falling back to usage\", exc_info=True)\n    74\t        return ContextMeasure(tokens=None, method=\"pending_usage\", compacted=compacted)\n=== app/startup.py\n     1\t\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\timport logging\n     6\tfrom pathlib import Path\n     7\t\n     8\tfrom app.identity import compute_agent_type_id\n     9\tfrom app.settings import Settings\n    10\t\n    11\tlog = logging.getLogger(__name__)\n    12\t\n    13\t\n    14\tdef sha256_file(path: Path) -> str:\n    15\t    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n    16\t\n    17\t\n    18\tdef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n    19\t    mismatches: list[str] = []\n    20\t    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n    21\t        mismatches.append(f\"image: running {settings.image_digest}\")\n    22\t    for name, entry in manifest[\"prompts\"].items():\n    23\t        path = settings.prompt_dir / Path(entry[\"path\"]).name\n    24\t        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n    25\t            mismatches.append(f\"prompt:{name}\")\n    26\t    for name in (\"policy\", \"tools\"):\n    27\t        entry = manifest[\"config\"][name]\n    28\t        path = settings.policy_path if name == \"policy\" else settings.tools_path\n    29\t        if sha256_file(path) != entry[\"sha256\"]:\n    30\t            mismatches.append(f\"config:{name}\")\n    31\t    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n    32\t        mismatches.append(\"model:primary\")\n    33\t    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n    34\t        mismatches.append(\"model:extractor\")\n    35\t    return mismatches\n    36\t\n    37\t\n    38\tdef startup_checks(settings: Settings) -> str:\n    39\t    \"\"\"Return the agent-type-id for this process.\"\"\"\n    40\t    manifest = settings.manifest\n    41\t    mismatches = running_state_mismatches(settings, manifest)\n    42\t    if mismatches:\n    43\t        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n    44\t    agent_type_id = compute_agent_type_id(manifest)\n    45\t    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n    46\t    return agent_type_id\n=== app/tools/__init__.py\n     1\t\"\"\"Tool registry.\n     2\t\n     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n     5\tthat is not in the run's registry.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom functools import lru_cache\n    11\tfrom typing import Any, Awaitable, Callable\n    12\t\n    13\timport yaml\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\t\n    17\tDEFAULT_ROLE = \"procurement\"\n    18\t\n    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Tool:\n    24\t    name: str\n    25\t    description: str\n    26\t    input_schema: dict[str, Any]\n    27\t    invoke: Invoke\n    28\t    target_field: str | None = None\n    29\t\n    30\t    def target_of(self, args: dict[str, Any]) -> str:\n    31\t        if self.target_field is None:\n    32\t            return self.name\n    33\t        return str(args.get(self.target_field, \"\"))\n    34\t\n    35\t    def schema(self) -> dict[str, Any]:\n    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n    37\t\n    38\t\n    39\tclass ToolRegistry:\n    40\t    def __init__(self, tools: list[Tool]):\n    41\t        self._tools = {t.name: t for t in tools}\n    42\t\n    43\t    def get(self, name: str) -> Tool | None:\n    44\t        return self._tools.get(name)\n    45\t\n    46\t    def names(self) -> list[str]:\n    47\t        return sorted(self._tools)\n    48\t\n    49\t    def schemas(self) -> list[dict[str, Any]]:\n    50\t        return [self._tools[n].schema() for n in self.names()]\n    51\t\n    52\t\n    53\t@lru_cache(maxsize=1)\n    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        cfg = yaml.safe_load(fh)\n    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n    58\t\n    59\t\n    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n    61\t    from app.tools import documents, erp, memory, payments, slack\n    62\t\n    63\t    available: dict[str, Tool] = {}\n    64\t    for module in (documents, erp, memory, payments, slack):\n    65\t        for tool in module.tools(deps):\n    66\t            available[tool.name] = tool\n    67\t\n    68\t    roles = _role_tools(str(deps.settings.tools_path))\n    69\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n    70\t    return ToolRegistry([available[name] for name in allowed if name in available])","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01JAiuvsj2n1wPLqtneSpPbe","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
