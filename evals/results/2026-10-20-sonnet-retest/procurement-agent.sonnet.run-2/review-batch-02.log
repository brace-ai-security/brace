\t            allowPrivilegeEscalation: false\n    70\t            privileged: false\n    71\t            readOnlyRootFilesystem: true\n    72\t            runAsNonRoot: true\n    73\t            capabilities:\n    74\t              drop: [\"ALL\"]\n    75\t            seccompProfile:\n    76\t              type: RuntimeDefault\n    77\t          resources:\n    78\t            requests:\n    79\t              cpu: 250m\n    80\t              memory: 512Mi\n    81\t            limits:\n    82\t              cpu: \"1\"\n    83\t              memory: 1Gi\n    84\t          readinessProbe:\n    85\t            httpGet:\n    86\t              path: /healthz\n    87\t              port: http\n    88\t          volumeMounts:\n    89\t            - name: workload-token\n    90\t              mountPath: /var/run/secrets/tokens\n    91\t              readOnly: true\n    92\t            - name: slack-signing\n    93\t              mountPath: /var/run/secrets/slack\n    94\t              readOnly: true\n    95\t            - name: mail-hmac\n    96\t              mountPath: /var/run/secrets/mail\n    97\t              readOnly: true\n    98\t            - name: tmp\n    99\t              mountPath: /tmp\n   100\t      volumes:\n   101\t        - name: workload-token\n   102\t          projected:\n   103\t            sources:\n   104\t              - serviceAccountToken:\n   105\t                  path: procurement-agent\n   106\t                  audience: sts.identity.example-corp.test\n   107\t                  expirationSeconds: 600\n   108\t        - name: slack-signing\n   109\t          secret:\n   110\t            secretName: procurement-slack-signing\n   111\t        - name: mail-hmac\n   112\t          secret:\n   113\t            secretName: procurement-mail-gateway-hmac\n   114\t        - name: tmp\n   115\t          emptyDir:\n   116\t            medium: Memory\n   117\t            sizeLimit: 64Mi\n=== deploy/k8s/kyverno-verify-images.yaml\n     1\tapiVersion: kyverno.io/v1\n     2\tkind: ClusterPolicy\n     3\tmetadata:\n     4\t  name: procurement-verify-images\n     5\t  annotations:\n     6\t    policies.kyverno.io/title: Verify procurement agent images\n     7\t    kyverno.io/kyverno-version: \"1.15.2\"\n     8\tspec:\n     9\t  validationFailureAction: Enforce\n    10\t  background: false\n    11\t  webhookTimeoutSeconds: 15\n    12\t  failurePolicy: Fail\n    13\t  rules:\n    14\t    - name: only-approved-registry\n    15\t      match:\n    16\t        any:\n    17\t          - resources:\n    18\t              kinds: [Pod]\n    19\t              namespaces: [procurement-prod]\n    20\t      validate:\n    21\t        message: \"Images in procurement-prod must come from registry.example-corp.test/procurement and be pinned by digest.\"\n    22\t        pattern:\n    23\t          spec:\n    24\t            =(initContainers):\n    25\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n    26\t            containers:\n    27\t              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n    28\t    - name: verify-signature-and-provenance\n    29\t      match:\n    30\t        any:\n    31\t          - resources:\n    32\t              kinds: [Pod]\n    33\t              namespaces: [procurement-prod]\n    34\t      verifyImages:\n    35\t        - imageReferences:\n    36\t            - \"registry.example-corp.test/procurement/*\"\n    37\t          mutateDigest: false\n    38\t          verifyDigest: true\n    39\t          required: true\n    40\t          attestors:\n    41\t            - entries:\n    42\t                - keyless:\n    43\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    44\t                    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    45\t                    rekor:\n    46\t                      url: https://rekor.sigstore.dev\n    47\t          attestations:\n    48\t            - type: https://slsa.dev/provenance/v1\n    49\t              attestors:\n    50\t                - entries:\n    51\t                    - keyless:\n    52\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    53\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    54\t              conditions:\n    55\t                - all:\n    56\t                    - key: \"{{ buildDefinition.buildType }}\"\n    57\t                      operator: Equals\n    58\t                      value: \"https://actions.github.io/buildtypes/workflow/v1\"\n    59\t                    - key: \"{{ buildDefinition.externalParameters.workflow.repository }}\"\n    60\t                      operator: Equals\n    61\t                      value: \"https://github.com/example-corp/procurement-agent\"\n    62\t                    - key: \"{{ buildDefinition.externalParameters.workflow.ref }}\"\n    63\t                      operator: Equals\n    64\t                      value: \"refs/heads/main\"\n    65\t                    - key: \"{{ buildDefinition.externalParameters.workflow.path }}\"\n    66\t                      operator: Equals\n    67\t                      value: \".github/workflows/ci.yaml\"\n    68\t                    - key: \"{{ runDetails.builder.id }}\"\n    69\t                      operator: Equals\n    70\t                      value: \"https://github.com/actions/runner/github-hosted\"\n    71\t            - type: https://cyclonedx.org/bom\n    72\t              attestors:\n    73\t                - entries:\n    74\t                    - keyless:\n    75\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    76\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n=== deploy/k8s/networkpolicy.yaml\n     1\tapiVersion: networking.k8s.io/v1\n     2\tkind: NetworkPolicy\n     3\tmetadata:\n     4\t  name: procurement-agent-default-deny\n     5\t  namespace: procurement-prod\n     6\tspec:\n     7\t  podSelector: {}\n     8\t  policyTypes: [\"Ingress\", \"Egress\"]\n     9\t---\n    10\tapiVersion: networking.k8s.io/v1\n    11\tkind: NetworkPolicy\n    12\tmetadata:\n    13\t  name: procurement-agent-egress\n    14\t  namespace: procurement-prod\n    15\tspec:\n    16\t  podSelector:\n    17\t    matchLabels:\n    18\t      app: procurement-agent\n    19\t  policyTypes: [\"Egress\"]\n    20\t  egress:\n    21\t    - to:\n    22\t        - namespaceSelector:\n    23\t            matchLabels:\n    24\t              kubernetes.io/metadata.name: kube-system\n    25\t          podSelector:\n    26\t            matchLabels:\n    27\t              k8s-app: kube-dns\n    28\t      ports:\n    29\t        - { protocol: UDP, port: 53 }\n    30\t        - { protocol: TCP, port: 53 }\n    31\t    - to:\n    32\t        - namespaceSelector:\n    33\t            matchLabels:\n    34\t              kubernetes.io/metadata.name: egress\n    35\t          podSelector:\n    36\t            matchLabels:\n    37\t              app: egress-proxy\n    38\t      ports:\n    39\t        - { protocol: TCP, port: 3128 }\n    40\t    - to:\n    41\t        - namespaceSelector:\n    42\t            matchLabels:\n    43\t              kubernetes.io/metadata.name: egress\n    44\t          podSelector:\n    45\t            matchLabels:\n    46\t              app: slack-proxy\n    47\t      ports:\n    48\t        - { protocol: TCP, port: 8443 }\n    49\t    - to:\n    50\t        - namespaceSelector:\n    51\t            matchLabels:\n    52\t              kubernetes.io/metadata.name: procurement-data\n    53\t          podSelector:\n    54\t            matchLabels:\n    55\t              app: procurement-db\n    56\t      ports:\n    57\t        - { protocol: TCP, port: 5432 }\n    58\t    - to:\n    59\t        - namespaceSelector:\n    60\t            matchLabels:\n    61\t              kubernetes.io/metadata.name: erp-mcp-gateway\n    62\t      ports:\n    63\t        - { protocol: TCP, port: 8443 }\n    64\t    - to:\n    65\t        - namespaceSelector:\n    66\t            matchLabels:\n    67\t              kubernetes.io/metadata.name: identity\n    68\t          podSelector:\n    69\t            matchLabels:\n    70\t              app: sts\n    71\t      ports:\n    72\t        - { protocol: TCP, port: 443 }\n    73\t    - to:\n    74\t        - ipBlock:\n    75\t            cidr: 0.0.0.0/0\n    76\t            except:\n    77\t              - 10.0.0.0/8\n    78\t              - 172.16.0.0/12\n    79\t              - 192.168.0.0/16\n    80\t              - 169.254.0.0/16\n    81\t      ports:\n    82\t        - { protocol: TCP, port: 443 }\n    83\t---\n    84\tapiVersion: networking.k8s.io/v1\n    85\tkind: NetworkPolicy\n    86\tmetadata:\n    87\t  name: procurement-agent-ingress\n    88\t  namespace: procurement-prod\n    89\tspec:\n    90\t  podSelector:\n    91\t    matchLabels:\n    92\t      app: procurement-agent\n    93\t  policyTypes: [\"Ingress\"]\n    94\t  ingress:\n    95\t    - from:\n    96\t        - namespaceSelector:\n    97\t            matchLabels:\n    98\t              kubernetes.io/metadata.name: ingress\n    99\t      ports:\n   100\t        - { protocol: TCP, port: 8080 }\n   101\t---\n   102\t# Egress proxy allowlist (applied in the egress namespace by the platform team).\n   103\tapiVersion: v1\n   104\tkind: ConfigMap\n   105\tmetadata:\n   106\t  name: egress-proxy-allowlist-procurement\n   107\t  namespace: egress\n   108\tdata:\n   109\t  allowlist.txt: |\n   110\t    api.anthropic.com\n   111\t    api.payments.example-pay.test\n   112\t    login.example-corp.test\n=== deploy/k8s/serviceaccount.yaml\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: procurement-prod\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: latest\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: procurement-agent\n    15\t  namespace: procurement-prod\n    16\t  labels:\n    17\t    app: procurement-agent\n    18\tautomountServiceAccountToken: false\n=== Dockerfile\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.11.10-slim-bookworm@sha256:2a6386ad2db20e7f55073f69a98d6da2cf9f168e05e7487d2670c22e4ad2a1bd AS build\n     3\tWORKDIR /src\n     4\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     5\tCOPY pyproject.toml ./\n     6\tCOPY app ./app\n     7\tRUN pip install --target /opt/site .\n     8\tRUN python -m compileall -q app\n     9\t\n    10\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:8f3c1a6e2b9d4f7a0c5e8b1d3f6a9c2e5b8d1f4a7c0e3b6d9f2a5c8e1b4d7f0a\n    11\tWORKDIR /app\n    12\tENV PYTHONPATH=/opt/site:/app \\\n    13\t    PYTHONDONTWRITEBYTECODE=1 \\\n    14\t    APP_ROOT=/app\n    15\tCOPY --from=build /opt/site /opt/site\n    16\tCOPY --from=build /src/app /app/app\n    17\tCOPY prompts /app/prompts\n    18\tCOPY config /app/config\n    19\tCOPY release/manifest.yaml /app/release/manifest.yaml\n    20\tUSER 65532:65532\n    21\tEXPOSE 8080\n    22\tENTRYPOINT [\"python\", \"-m\", \"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\", \"--no-server-header\"]\n=== release/manifest.yaml\n     1\t# Release manifest for the procurement agent. Regenerated by CI on every\n     2\t# release build (see .github/workflows/ci.yaml, job \"release\").\n     3\trelease: \"procurement-agent 2026.09.4\"\n     4\towner: team-procurement-platform\n     5\t\n     6\timage:\n     7\t  repository: registry.example-corp.test/procurement/agent\n     8\t  digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n     9\t  sbom: \"registry.example-corp.test/procurement/agent:sha256-7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0.sbom\"\n    10\t  signer:\n    11\t    issuer: \"https://token.actions.githubusercontent.com\"\n    12\t    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    13\t\n    14\tharness:\n    15\t  source_commit: \"3f9a1c7e2b8d4f6a0c5e9b1d7f3a8c2e6b4d0f91\"\n    16\t  digest: \"sha256:5b2d8f1a9c3e7b0d4f6a2c8e1b5d9f3a7c0e4b8d2f6a1c5e9b3d7f0a4c8e2b6d\"\n    17\t\n    18\tprompts:\n    19\t  system:\n    20\t    path: prompts/system.md\n    21\t    sha256: \"sha256:dcf69216667e65a0be3711d99aac81b707ba843296e7ce26d6fcbdb50c5bcc50\"\n    22\t  extractor:\n    23\t    path: prompts/extractor.md\n    24\t    sha256: \"sha256:6ef6527b77ffcca8851e7a8760e6373f3daede15d5b343b878737f0deec28de3\"\n    25\t\n    26\tconfig:\n    27\t  policy:\n    28\t    path: config/policy.yaml\n    29\t    version: \"proc-policy-2026.09.3\"\n    30\t    sha256: \"sha256:d6a55f1e170bdd457958243ddd9aa938f4ca707a3e1e9d1e7bca2a54df33ad32\"\n    31\t  tools:\n    32\t    path: config/tools.yaml\n    33\t    sha256: \"sha256:86dccc3d7d166bf8e131c3b2afbe5f2b846a57eaaf087b55f9e308844eda9400\"\n    34\t  network_policy: deploy/k8s/networkpolicy.yaml\n    35\t  image_policy: deploy/k8s/kyverno-verify-images.yaml\n    36\t\n    37\tmodels:\n    38\t  primary:\n    39\t    role: \"main agent\"\n    40\t    owner: team-procurement-platform\n    41\t    provider: anthropic\n    42\t    model_id: \"claude-sonnet-4-5-20250929\"\n    43\t    id_kind: \"pinned snapshot\"\n    44\t    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    45\t    adapter: none\n    46\t    fine_tune: none\n    47\t    training_run: \"not applicable\"\n    48\t    served_version: \"recorded per call from response.model\"\n    49\t    provider_undisclosed: [weights digest, pretraining data version]\n    50\t  extractor:\n    51\t    role: \"line-item extraction sub-agent\"\n    52\t    owner: team-procurement-platform\n    53\t    provider: anthropic\n    54\t    model_id: \"claude-haiku-4-5-20251001\"\n    55\t    id_kind: \"pinned snapshot\"\n    56\t    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    57\t    adapter: none\n    58\t    fine_tune: none\n    59\t    training_run: \"not applicable\"\n    60\t    served_version: \"recorded per call from response.model\"\n    61\t    provider_undisclosed: [weights digest, pretraining data version]\n    62\t\n    63\tmcp_servers:\n    64\t  erp:\n    65\t    endpoint: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    66\t    owner: team-erp-integrations\n    67\t\n    68\t# Fingerprints of the approved ERP MCP tools (name, description, inputSchema,\n    69\t# annotations), computed by app.mcp_client.fingerprint.\n    70\ttool_pins:\n    71\t  budget.get_remaining: \"sha256:bc96af69ba1cfd67b5428269dc74aa3e754f4dfe2d5dfa81deb0af68819379ca\"\n    72\t  vendor.get: \"sha256:7db5e65fb6d482d06985b19b7f1fce7422398b117bc7482f0380108cd6a6a1fe\"\n    73\t  vendor.search: \"sha256:3bd5aa0908885e967ce8ee1aa22e37b4f4fba867c8eac2b4127bca626731092c\"\n    74\t  vendor.update_remit_to: \"sha256:d3d3916ee6d742311c92f4972a1ffeb0f24782e729351f3e375f13eb05b94c1b\"\n    75\t  invoice.get: \"sha256:848ece38456338a085cb7091a2bbf1024e07946d62beb32a9ee94d2fa2fa8876\"\n    76\t  invoice.list_open: \"sha256:12bb2318f3876da6421183032cdd36727e545275e8eaf6fff66451d09371f12b\"\n    77\t  invoice.mark_paid: \"sha256:3a208eb55ee3a39962316b5d25fe6ba23457380c01aa39a5469ce3691130b05a\"\n    78\t  invoice.void: \"sha256:9645bec805f2ffdfa44f698f49e8701a6487afa3cb3e3c5c44e721cb21633d4c\"\n    79\t  po.get: \"sha256:121df83a279fc2ae3764c83faeb34f3037026586991c9192144ad7b727d18d7b\"\n    80\t  po.list_open: \"sha256:203c57fd158a8edf11b8dc02be534bc805d8caaf0959db8280f59ea0e5beb70a\"\n    81\t  po.create: \"sha256:fb15c157f7d79321972b310d74ee6c88a0fc76fd8edbbe4e821dcaa95a0852c6\"\n    82\t\n    83\tbudgets: config/policy.yaml#budgets\n    84\tidentity:\n    85\t  service_account: procurement-agent\n    86\t  spiffe_id: \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    87\t  sts_audiences: [erp-mcp-gateway, payments-api, slack-proxy]\n    88\tmemory:\n    89\t  store: \"postgres procurement.dept_notes\"\n    90\t  expiry_unverified_days: 30\n    91\tretrieval: none\n=== .github/workflows/ci.yaml\n     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    16\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    17\t        with:\n    18\t          python-version: \"3.11\"\n    19\t      - run: pip install -e '.[test]'\n    20\t      - run: pytest -q\n    21\t      - name: Secret scan\n    22\t        uses: gitleaks/gitleaks-action@83373cf2f8c4db6e24b41c1a9b086bb9619e9cd3 # v2.3.7\n    23\t      - name: Manifest hashes match files\n    24\t        run: |\n    25\t          python - <<'PY'\n    26\t          import hashlib, yaml, sys\n    27\t          m = yaml.safe_load(open(\"release/manifest.yaml\"))\n    28\t          bad = []\n    29\t          for group in (\"prompts\", \"config\"):\n    30\t              for name, e in m[group].items():\n    31\t                  if isinstance(e, dict) and \"sha256\" in e:\n    32\t                      got = \"sha256:\" + hashlib.sha256(open(e[\"path\"], \"rb\").read()).hexdigest()\n    33\t                      if got != e[\"sha256\"]:\n    34\t                          bad.append(e[\"path\"])\n    35\t          if bad:\n    36\t              sys.exit(\"manifest out of date: \" + \", \".join(bad))\n    37\t          PY\n    38\t\n    39\t  release:\n    40\t    if: github.ref == 'refs/heads/main'\n    41\t    needs: test\n    42\t    runs-on: ubuntu-24.04\n    43\t    permissions:\n    44\t      contents: read\n    45\t      id-token: write\n    46\t      packages: write\n    47\t      attestations: write\n    48\t    steps:\n    49\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    50\t      - uses: sigstore/cosign-installer@dc72c7d5c4d10cd6bcb8cf6e3fd625a9e5e537da # v3.7.0\n    51\t        with:\n    52\t          cosign-release: \"v2.6.2\"\n    53\t      - uses: docker/setup-buildx-action@c47758b77c9736f4b2ef4073d4d51994fabfe349 # v3.7.1\n    54\t      - uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0\n    55\t        with:\n    56\t          registry: registry.example-corp.test\n    57\t          username: ${{ github.actor }}\n    58\t          password: ${{ secrets.GITHUB_TOKEN }}\n    59\t      - id: build\n    60\t        uses: docker/build-push-action@4f58ea79222b3b9dc2c8bbdd6debcef730109a75 # v6.9.0\n    61\t        with:\n    62\t          context: .\n    63\t          push: true\n    64\t          tags: registry.example-corp.test/procurement/agent:${{ github.sha }}\n    65\t          provenance: false\n    66\t          sbom: false\n    67\t      - name: SBOM\n    68\t        uses: anchore/sbom-action@251a468eed47e5082b105c3ba6ee500c0e65a764 # v0.17.6\n    69\t        with:\n    70\t          image: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    71\t          format: cyclonedx-json\n    72\t          output-file: sbom.cdx.json\n    73\t      - name: Sign and attest\n    74\t        env:\n    75\t          IMAGE: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    76\t        run: |\n    77\t          cosign sign --yes \"$IMAGE\"\n    78\t          cosign attest --yes --type cyclonedx --predicate sbom.cdx.json \"$IMAGE\"\n    79\t      - uses: actions/attest-build-provenance@1c608d11d69870c2092266b3f9a6f3abbf17002c # v1.4.3\n    80\t        with:\n    81\t          subject-name: registry.example-corp.test/procurement/agent\n    82\t          subject-digest: ${{ steps.build.outputs.digest }}\n    83\t          push-to-registry: true\n=== app/settings.py\n     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t\n    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )\n=== app/extractor.py\n     1\t\"\"\"Line-item extraction sub-agent.\n     2\t\n     3\tThe parent procurement agent delegates structured extraction to a smaller\n     4\tmodel. The child runs under its own instance id, links to its parent in the\n     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport json\n    10\timport logging\n    11\tfrom typing import Any\n    12\t\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom app import audit\n    16\tfrom app.budget import Budget\n    17\tfrom app.context_size import measure_context\n    18\tfrom app.identity import RunIdentity\n    19\tfrom app.redact import redact_for_model\n    20\tfrom app.tools import build_registry\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n    24\t\n    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n    26\tMAX_TURNS = 4\n    27\t\n    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n    29\t\n    30\t\n    31\tclass ExtractionFailed(Exception):\n    32\t    pass\n    33\t\n    34\t\n    35\tclass LineItemExtractor:\n    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n    37\t        self.client = client\n    38\t        self.settings = settings\n    39\t        self.deps = deps\n    40\t        self.system_prompt = system_prompt\n    41\t\n    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n    43\t        budget.check_subagent()\n    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n    47\t\n    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n    51\t            start_node = await audit.record(\n    52\t                self.deps.pool,\n    53\t                ident,\n    54\t                kind=\"subagent_started\",\n    55\t                payload={\n    56\t                    \"role\": EXTRACTOR_ROLE,\n    57\t                    \"doc_id\": doc_id,\n    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n    59\t                    \"tools\": registry.names(),\n    60\t                },\n    61\t            )\n    62\t\n    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n    64\t            for _turn in range(MAX_TURNS):\n    65\t                budget.check_step()\n    66\t                request = {\n    67\t                    \"model\": self.settings.extractor_model_id,\n    68\t                    \"system\": self.system_prompt,\n    69\t                    \"messages\": messages,\n    70\t                    \"tools\": registry.schemas(),\n    71\t                    \"max_tokens\": 4096,\n    72\t                }\n    73\t                ctx = await measure_context(self.client, request, compacted=False)\n    74\t                response = await self.client.messages.create(**request)\n    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n    76\t                await budget.flush(self.deps.pool)\n    77\t                ctx = ctx.finalize(response.usage)\n    78\t                decision = await audit.record(\n    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n    81\t                             \"stop_reason\": response.stop_reason},\n    82\t                )\n    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n    85\t                if not uses:\n    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n    87\t                    items = _parse_items(text)\n    88\t                    await audit.record(\n    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n    90","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-02nxb08y/38505890-0b43-4ad6-bf58-5f43963f8ebc/tool-results/b2qyfjuc9.txt","persistedOutputSize":31273},"tool_result_meta":[{"id":"toolu_01U46qWcmWzkodCTex5shAQa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
