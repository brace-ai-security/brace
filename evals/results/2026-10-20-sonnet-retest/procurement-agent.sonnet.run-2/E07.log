{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WoUf4kJ371r22DCi71U7tx","type":"tool_result","content":"\"\"\"FastAPI entry point for the procurement agent.\"\"\"\nfrom __future__ import annotations\n\nimport asyncio\nimport hashlib\nimport hmac\nimport json\nimport logging\nimport time\nimport uuid\nfrom contextlib import asynccontextmanager\nfrom pathlib import Path\nfrom urllib.parse import parse_qs\n\nimport asyncpg\nimport jwt\nfrom anthropic import AsyncAnthropic\nfrom fastapi import Depends, FastAPI, HTTPException, Request\nfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\nfrom opentelemetry import trace\nfrom pydantic import BaseModel, Field\n\nfrom app import audit, ingest\nfrom app.approvals import ApprovalStore, ApproverNotAuthorized\nfrom app.extractor import LineItemExtractor\nfrom app.gate import PolicyGate\nfrom app.identity import RunIdentity, TokenBroker, new_instance_id\nfrom app.loop import AgentDeps, ProcurementAgent\nfrom app.mcp_client import ErpMcpClient\nfrom app.redact import RedactingFilter\nfrom app.settings import get_settings\nfrom app.startup import startup_checks\nfrom app.tools.slack import SlackClient\n\nlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\nfor handler in logging.getLogger().handlers:\n    handler.addFilter(RedactingFilter())\nlog = logging.getLogger(\"procurement\")\n\nAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\nbearer = HTTPBearer()\n\n\nclass RunRequest(BaseModel):\n    task: str = Field(min_length=1, max_length=4000)\n    department: str = Field(min_length=1, max_length=64)\n\n\nclass Principal(BaseModel):\n    subject: str\n    business_unit: str\n\n\ndef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    return RunIdentity(\n        accountable_party=\"system:procurement-agent\",\n        operational_owner=settings.operational_owner,\n        tenant=tenant,\n        agent_type_id=agent_type_id,\n        agent_instance_id=new_instance_id(),\n        trace_id=uuid.uuid4().hex,\n        run_id=f\"bg-{uuid.uuid4()}\",\n        delegated_subject=\"system:procurement-agent\",\n        agent_principal=AGENT_PRINCIPAL,\n    )\n\n\nasync def expire_approvals_forever(app: FastAPI) -> None:\n    while True:\n        await asyncio.sleep(60)\n        ident = service_identity(app.state.settings, app.state.agent_type_id)\n        count = await app.state.pool.fetchval(\n            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n        )\n        await audit.record(app.state.pool, ident, kind=\"background_job\",\n                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n\n\n@asynccontextmanager\nasync def lifespan(app: FastAPI):\n    settings = get_settings()\n    agent_type_id = startup_checks(settings)\n    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    broker = TokenBroker(settings)\n\n    async def slack_token() -> str:\n        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n\n    slack = SlackClient(settings.slack_api_url, slack_token)\n    approvals = ApprovalStore(pool, settings.policy, slack)\n    gate = PolicyGate(settings.policy, approvals)\n    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    await erp.initialize(service_identity(settings, agent_type_id))\n\n    client = AsyncAnthropic()\n    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    deps.extractor = LineItemExtractor(\n        client=client, settings=settings, deps=deps,\n        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n    )\n    app.state.settings = settings\n    app.state.pool = pool\n    app.state.agent_type_id = agent_type_id\n    app.state.approvals = approvals\n    app.state.agent = ProcurementAgent(\n        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n    )\n    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n    sweeper = asyncio.create_task(expire_approvals_forever(app))\n    try:\n        yield\n    finally:\n        sweeper.cancel()\n        await pool.close()\n\n\napp = FastAPI(lifespan=lifespan)\napp.include_router(ingest.router)\n\n\ndef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n    settings = request.app.state.settings\n    try:\n        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n        claims = jwt.decode(\n            creds.credentials,\n            key.key,\n            algorithms=[\"RS256\", \"ES256\"],\n            audience=settings.oidc_audience,\n            issuer=settings.oidc_issuer,\n            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n        )\n    except jwt.PyJWTError as exc:\n        raise HTTPException(401, \"invalid token\") from exc\n    bu = claims.get(\"bu\")\n    if not bu:\n        raise HTTPException(403, \"token has no business unit\")\n    return Principal(subject=claims[\"sub\"], business_unit=bu)\n\n\n@app.post(\"/runs\")\nasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n    settings = request.app.state.settings\n    span_ctx = trace.get_current_span().get_span_context()\n    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n    ident = RunIdentity(\n        accountable_party=principal.subject,\n        operational_owner=settings.operational_owner,\n        tenant=principal.business_unit,\n        agent_type_id=request.app.state.agent_type_id,\n        agent_instance_id=new_instance_id(),\n        trace_id=trace_id,\n        run_id=f\"run-{uuid.uuid4()}\",\n        delegated_subject=principal.subject,\n        agent_principal=AGENT_PRINCIPAL,\n    )\n    task = f\"Department: {req.department}\\n\\n{req.task}\"\n    asyncio.create_task(request.app.state.agent.run(ident, task))\n    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n\n\n@app.post(\"/slack/interactions\")\nasync def slack_interactions(request: Request) -> dict:\n    body = await request.body()\n    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n    if abs(time.time() - int(timestamp)) > 300:\n        raise HTTPException(401, \"stale request\")\n    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n        raise HTTPException(401, \"bad signature\")\n\n    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n    action = payload[\"actions\"][0]\n    slack_user = payload[\"user\"][\"id\"]\n    row = await request.app.state.pool.fetchrow(\n        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n    )\n    if row is None:\n        raise HTTPException(403, \"not an approver\")\n    try:\n        await request.app.state.approvals.decide(\n            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n            approve=action[\"action_id\"] == \"approve\",\n        )\n    except ApproverNotAuthorized as exc:\n        raise HTTPException(403, str(exc)) from exc\n    except ValueError as exc:\n        raise HTTPException(409, str(exc)) from exc\n    return {\"ok\": True}\n\n\n@app.get(\"/healthz\")\nasync def healthz() -> dict:\n    return {\"ok\": True}\n\"\"\"Inbound documents: vendor quotes and invoices from the mail gateway.\n\nThe mail gateway posts each received message to ``/ingest/mail`` signed with\nan HMAC over the timestamp and body. Accepted documents are stored per\nbusiness unit and are only ever shown to the model inside an\n``untrusted_document`` wrapper (tools/documents.py).\n\"\"\"\nfrom __future__ import annotations\n\nimport base64\nimport email\nimport email.policy\nimport hashlib\nimport hmac\nimport io\nimport re\nimport time\nimport uuid\nfrom dataclasses import dataclass\nfrom pathlib import Path\n\nfrom fastapi import APIRouter, HTTPException, Request\nfrom pypdf import PdfReader\n\nrouter = APIRouter()\n\nMAX_BODY_BYTES = 10 * 1024 * 1024\nMAX_TEXT_CHARS = 200_000\nMAX_SKEW_SECONDS = 300\nALLOWED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\", \"message/rfc822\"}\nSCANNED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\"}\n\nINJECTION_PATTERNS = [\n    re.compile(r\"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)\"),\n    re.compile(r\"(?i)\\b(system|developer) (prompt|message)\\b\"),\n    re.compile(r\"(?i)\\byou are (now )?(an?|the) \\w+ (agent|assistant)\\b\"),\n    re.compile(r\"(?i)\\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\\b\"),\n    re.compile(r\"(?i)\\b(update|change) (our|the) (bank|remit|payee)\\b\"),\n    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n]\n\n\nclass Rejected(Exception):\n    pass\n\n\n@dataclass\nclass Inbound:\n    business_unit: str\n    sender: str\n    media_type: str\n    raw: bytes\n\n\ndef verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:\n    try:\n        ts = int(timestamp)\n    except ValueError as exc:\n        raise Rejected(\"bad timestamp\") from exc\n    if abs(time.time() - ts) > MAX_SKEW_SECONDS:\n        raise Rejected(\"stale request\")\n    expected = hmac.new(key, f\"{timestamp}.\".encode() + body, hashlib.sha256).hexdigest()\n    if not hmac.compare_digest(expected, signature):\n        raise Rejected(\"bad signature\")\n\n\ndef extract_text(doc: Inbound) -> str:\n    if doc.media_type == \"application/pdf\":\n        reader = PdfReader(io.BytesIO(doc.raw))\n        if len(reader.pages) > 50:\n            raise Rejected(\"too many pages\")\n        return \"\\n\".join(page.extract_text() or \"\" for page in reader.pages)\n    if doc.media_type == \"message/rfc822\":\n        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)\n        body = msg.get_body(preferencelist=(\"plain\", \"html\"))\n        return body.get_content() if body is not None else \"\"\n    return doc.raw.decode(\"utf-8\", errors=\"strict\")\n\n\ndef scan_for_injection(text: str) -> list[str]:\n    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]\n\n\ndef validate(doc: Inbound) -> str:\n    if doc.media_type not in ALLOWED_MEDIA_TYPES:\n        raise Rejected(f\"media type {doc.media_type} not accepted\")\n    if len(doc.raw) > MAX_BODY_BYTES:\n        raise Rejected(\"document too large\")\n    try:\n        text = extract_text(doc)\n    except Rejected:\n        raise\n    except Exception as exc:\n        raise Rejected(f\"unreadable document: {type(exc).__name__}\") from exc\n    if len(text) > MAX_TEXT_CHARS:\n        raise Rejected(\"extracted text too long\")\n    if doc.media_type in SCANNED_MEDIA_TYPES:\n        findings = scan_for_injection(text)\n        if findings:\n            raise Rejected(\"possible prompt injection: \" + \"; \".join(findings))\n    return text\n\n\n@router.post(\"/ingest/mail\")\nasync def ingest_mail(request: Request) -> dict:\n    body = await request.body()\n    if len(body) > MAX_BODY_BYTES * 2:\n        raise HTTPException(413, \"payload too large\")\n    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()\n    try:\n        verify_signature(\n            key,\n            request.headers.get(\"X-Gateway-Timestamp\", \"\"),\n            body,\n            request.headers.get(\"X-Gateway-Signature\", \"\"),\n        )\n    except Rejected as exc:\n        raise HTTPException(401, str(exc)) from exc\n\n    payload = await request.json()\n    doc = Inbound(\n        business_unit=payload[\"business_unit\"],\n        sender=payload[\"from\"],\n        media_type=payload[\"media_type\"],\n        raw=base64.b64decode(payload[\"content_b64\"], validate=True),\n    )\n    doc_id = f\"doc-{uuid.uuid4().hex[:20]}\"\n    pool = request.app.state.pool\n    try:\n        text = validate(doc)\n    except Rejected as exc:\n        await pool.execute(\n            \"\"\"\n            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)\n            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())\n            \"\"\",\n            doc_id, doc.business_unit, doc.sender, doc.media_type,\n            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],\n        )\n        return {\"doc_id\": doc_id, \"status\": \"quarantined\"}\n\n    await pool.execute(\n        \"\"\"\n        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)\n        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())\n        \"\"\",\n        doc_id, doc.business_unit, doc.sender, doc.media_type,\n        hashlib.sha256(doc.raw).hexdigest(), text,\n    )\n    return {\"doc_id\": doc_id, \"status\": \"accepted\"}\n\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n\nThe agent runs under its own Kubernetes service account. Its projected\nservice-account token is exchanged at the internal STS for short-lived,\naudience-bound tokens. The launching user's token is never forwarded to an\nintegration; the user is carried as the delegated subject of the exchange.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport time\nimport uuid\nfrom dataclasses import dataclass, field, replace\nfrom pathlib import Path\n\nimport httpx\n\nfrom app.settings import Settings\n\nIDENTITY_FIELDS = (\n    \"accountable_party\",\n    \"operational_owner\",\n    \"tenant\",\n    \"agent_type_id\",\n    \"agent_instance_id\",\n    \"trace_id\",\n)\n\n\n@dataclass(frozen=True)\nclass RunIdentity:\n    accountable_party: str\n    operational_owner: str\n    tenant: str\n    agent_type_id: str\n    agent_instance_id: str\n    trace_id: str\n    run_id: str\n    delegated_subject: str\n    agent_principal: str\n    parent_instance_id: str | None = None\n    role: str = \"procurement\"\n\n    def __post_init__(self) -> None:\n        for name in IDENTITY_FIELDS:\n            if not getattr(self, name):\n                raise ValueError(f\"identity field {name} is empty\")\n\n    def child(self, role: str) -> \"RunIdentity\":\n        return replace(\n            self,\n            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n            parent_instance_id=self.agent_instance_id,\n            role=role,\n        )\n\n\ndef new_instance_id() -> str:\n    return f\"inst-{uuid.uuid4()}\"\n\n\ndef compute_agent_type_id(manifest: dict) -> str:\n    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    material = {\n        \"image_digest\": manifest[\"image\"][\"digest\"],\n        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n        \"models\": manifest[\"models\"],\n        \"config\": manifest[\"config\"],\n        \"tools\": manifest[\"tool_pins\"],\n    }\n    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n\n\n@dataclass\nclass _CachedToken:\n    value: str\n    expires_at: float\n\n\n@dataclass\nclass TokenBroker:\n    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n\n    settings: Settings\n    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n\n    def _workload_token(self) -> str:\n        return Path(self.settings.workload_token_path).read_text().strip()\n\n    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n        key = (audience, scope, ident.tenant)\n        cached = self._cache.get(key)\n        if cached and cached.expires_at - 30 > time.time():\n            return cached.value\n        async with httpx.AsyncClient(timeout=5.0) as client:\n            resp = await client.post(\n                self.settings.sts_url,\n                data={\n                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n                    \"subject_token\": self._workload_token(),\n                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n                    \"audience\": audience,\n                    \"scope\": scope,\n                    \"resource\": f\"urn:bu:{ident.tenant}\",\n                    \"actor_token\": ident.delegated_subject,\n                    \"actor_token_type\": \"urn:example:params:subject-id\",\n                },\n            )\n            resp.raise_for_status()\n            body = resp.json()\n        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n        self._cache[key] = token\n        return token.value\n\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n\nOn startup the tool list is fetched and each tool's description and input\nschema are fingerprinted and compared with the pins in the release manifest.\nAny unpinned or changed tool stops startup. Tool metadata is also scanned for\ninstruction-like content before any of it is shown to the model.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport logging\nimport re\nimport uuid\nfrom typing import Any\n\nimport httpx\n\nfrom app.identity import RunIdentity, TokenBroker\nfrom app.redact import redact_text\n\nlog = logging.getLogger(__name__)\n\nMAX_DESCRIPTION_CHARS = 1024\nSUSPICIOUS_METADATA = [\n    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n]\n\n\nclass ToolPinMismatch(Exception):\n    pass\n\n\nclass UnknownErpOperation(Exception):\n    pass\n\n\ndef fingerprint(tool: dict[str, Any]) -> str:\n    material = {\n        \"name\": tool[\"name\"],\n        \"description\": tool.get(\"description\", \"\"),\n        \"inputSchema\": tool.get(\"inputSchema\", {}),\n        \"annotations\": tool.get(\"annotations\", {}),\n    }\n    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n\n\ndef scan_metadata(tool: dict[str, Any]) -> None:\n    description = tool.get(\"description\", \"\")\n    if len(description) > MAX_DESCRIPTION_CHARS:\n        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    blob = json.dumps(tool, ensure_ascii=False)\n    for pattern in SUSPICIOUS_METADATA:\n        if pattern.search(blob):\n            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n\n\nclass ErpMcpClient:\n    AUDIENCE = \"erp-mcp-gateway\"\n\n    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n        self.url = url\n        self.pins = pins\n        self.broker = broker\n        self._tools: dict[str, dict[str, Any]] = {}\n\n    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n            resp = await client.post(\n                self.url,\n                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n            )\n        resp.raise_for_status()\n        if len(resp.content) > 512_000:\n            raise ValueError(\"erp response too large\")\n        body = resp.json()\n        if \"error\" in body:\n            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n        return body[\"result\"]\n\n    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n        result = await self._rpc(\"tools/list\", {}, token)\n        return list(result.get(\"tools\", []))\n\n    async def initialize(self, service_ident: RunIdentity) -> None:\n        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n        tools = await self._list_tools(token)\n        for tool in tools:\n            expected = self.pins.get(tool[\"name\"])\n            actual = fingerprint(tool)\n            if expected != actual:\n                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n            scan_metadata(tool)\n        self._tools = {t[\"name\"]: t for t in tools}\n        log.info(\"erp tools loaded: %d\", len(self._tools))\n\n    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n        if message.get(\"method\") == \"notifications/tools/list_changed\":\n            await self.refresh_tools(service_ident)\n\n    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n        tools = await self._list_tools(token)\n        self._tools = {t[\"name\"]: t for t in tools}\n        log.info(\"erp tools refreshed: %d\", len(self._tools))\n\n    def operations(self) -> list[str]:\n        return sorted(self._tools)\n\n    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n        if operation not in self._tools:\n            raise UnknownErpOperation(operation)\n        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n        result = await self._rpc(\n            \"tools/call\",\n            {\n                \"name\": operation,\n                \"arguments\": arguments,\n                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n            },\n            token,\n        )\n        if result.get(\"isError\"):\n            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n        return result.get(\"structuredContent\") or result.get(\"content\")\n./app/approvals.py:5:interactive callback is signature-checked in main.py and then calls\n./deploy/k8s/kyverno-verify-images.yaml:11:  webhookTimeoutSeconds: 15\n./release/manifest.yaml:30:    sha256: \"sha256:d6a55f1e170bdd457958243ddd9aa938f4ca707a3e1e9d1e7bca2a54df33ad32\"\n       0 app/__init__.py\n     114 app/approvals.py\n     118 app/audit.py\n     163 app/budget.py\n      74 app/context_size.py\n     114 app/extractor.py\n      61 app/gate.py\n     117 app/identity.py\n     150 app/ingest.py\n      31 app/killswitch.py\n     186 app/loop.py\n     196 app/main.py\n     131 app/mcp_client.py\n     100 app/redact.py\n      88 app/settings.py\n      46 app/startup.py\n      70 app/tools/__init__.py\n      61 app/tools/documents.py\n     107 app/tools/erp.py\n     135 app/tools/memory.py\n      66 app/tools/payments.py\n      94 app/tools/slack.py\n    2222 total","is_error":false}]},"parent_tool_use_id":null,"session_id":"e61d5d43-ca78-4022-b457-64cf2114bafa","uuid":"ff7ff305-d383-49b9-9481-e8af85caba65","timestamp":"2026-10-20T16:30:08.201Z","tool_use_result":{"stdout":"\"\"\"FastAPI entry point for the procurement agent.\"\"\"\nfrom __future__ import annotations\n\nimport asyncio\nimport hashlib\nimport hmac\nimport json\nimport logging\nimport time\nimport uuid\nfrom contextlib import asynccontextmanager\nfrom pathlib import Path\nfrom urllib.parse import parse_qs\n\nimport asyncpg\nimport jwt\nfrom anthropic import AsyncAnthropic\nfrom fastapi import Depends, FastAPI, HTTPException, Request\nfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\nfrom opentelemetry import trace\nfrom pydantic import BaseModel, Field\n\nfrom app import audit, ingest\nfrom app.approvals import ApprovalStore, ApproverNotAuthorized\nfrom app.extractor import LineItemExtractor\nfrom app.gate import PolicyGate\nfrom app.identity import RunIdentity, TokenBroker, new_instance_id\nfrom app.loop import AgentDeps, ProcurementAgent\nfrom app.mcp_client import ErpMcpClient\nfrom app.redact import RedactingFilter\nfrom app.settings import get_settings\nfrom app.startup import startup_checks\nfrom app.tools.slack import SlackClient\n\nlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\nfor handler in logging.getLogger().handlers:\n    handler.addFilter(RedactingFilter())\nlog = logging.getLogger(\"procurement\")\n\nAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\nbearer = HTTPBearer()\n\n\nclass RunRequest(BaseModel):\n    task: str = Field(min_length=1, max_length=4000)\n    department: str = Field(min_length=1, max_length=64)\n\n\nclass Principal(BaseModel):\n    subject: str\n    business_unit: str\n\n\ndef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    return RunIdentity(\n        accountable_party=\"system:procurement-agent\",\n        operational_owner=settings.operational_owner,\n        tenant=tenant,\n        agent_type_id=agent_type_id,\n        agent_instance_id=new_instance_id(),\n        trace_id=uuid.uuid4().hex,\n        run_id=f\"bg-{uuid.uuid4()}\",\n        delegated_subject=\"system:procurement-agent\",\n        agent_principal=AGENT_PRINCIPAL,\n    )\n\n\nasync def expire_approvals_forever(app: FastAPI) -> None:\n    while True:\n        await asyncio.sleep(60)\n        ident = service_identity(app.state.settings, app.state.agent_type_id)\n        count = await app.state.pool.fetchval(\n            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n        )\n        await audit.record(app.state.pool, ident, kind=\"background_job\",\n                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n\n\n@asynccontextmanager\nasync def lifespan(app: FastAPI):\n    settings = get_settings()\n    agent_type_id = startup_checks(settings)\n    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    broker = TokenBroker(settings)\n\n    async def slack_token() -> str:\n        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n\n    slack = SlackClient(settings.slack_api_url, slack_token)\n    approvals = ApprovalStore(pool, settings.policy, slack)\n    gate = PolicyGate(settings.policy, approvals)\n    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    await erp.initialize(service_identity(settings, agent_type_id))\n\n    client = AsyncAnthropic()\n    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    deps.extractor = LineItemExtractor(\n        client=client, settings=settings, deps=deps,\n        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n    )\n    app.state.settings = settings\n    app.state.pool = pool\n    app.state.agent_type_id = agent_type_id\n    app.state.approvals = approvals\n    app.state.agent = ProcurementAgent(\n        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n    )\n    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n    sweeper = asyncio.create_task(expire_approvals_forever(app))\n    try:\n        yield\n    finally:\n        sweeper.cancel()\n        await pool.close()\n\n\napp = FastAPI(lifespan=lifespan)\napp.include_router(ingest.router)\n\n\ndef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n    settings = request.app.state.settings\n    try:\n        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n        claims = jwt.decode(\n            creds.credentials,\n            key.key,\n            algorithms=[\"RS256\", \"ES256\"],\n            audience=settings.oidc_audience,\n            issuer=settings.oidc_issuer,\n            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n        )\n    except jwt.PyJWTError as exc:\n        raise HTTPException(401, \"invalid token\") from exc\n    bu = claims.get(\"bu\")\n    if not bu:\n        raise HTTPException(403, \"token has no business unit\")\n    return Principal(subject=claims[\"sub\"], business_unit=bu)\n\n\n@app.post(\"/runs\")\nasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n    settings = request.app.state.settings\n    span_ctx = trace.get_current_span().get_span_context()\n    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n    ident = RunIdentity(\n        accountable_party=principal.subject,\n        operational_owner=settings.operational_owner,\n        tenant=principal.business_unit,\n        agent_type_id=request.app.state.agent_type_id,\n        agent_instance_id=new_instance_id(),\n        trace_id=trace_id,\n        run_id=f\"run-{uuid.uuid4()}\",\n        delegated_subject=principal.subject,\n        agent_principal=AGENT_PRINCIPAL,\n    )\n    task = f\"Department: {req.department}\\n\\n{req.task}\"\n    asyncio.create_task(request.app.state.agent.run(ident, task))\n    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n\n\n@app.post(\"/slack/interactions\")\nasync def slack_interactions(request: Request) -> dict:\n    body = await request.body()\n    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n    if abs(time.time() - int(timestamp)) > 300:\n        raise HTTPException(401, \"stale request\")\n    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n        raise HTTPException(401, \"bad signature\")\n\n    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n    action = payload[\"actions\"][0]\n    slack_user = payload[\"user\"][\"id\"]\n    row = await request.app.state.pool.fetchrow(\n        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n    )\n    if row is None:\n        raise HTTPException(403, \"not an approver\")\n    try:\n        await request.app.state.approvals.decide(\n            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n            approve=action[\"action_id\"] == \"approve\",\n        )\n    except ApproverNotAuthorized as exc:\n        raise HTTPException(403, str(exc)) from exc\n    except ValueError as exc:\n        raise HTTPException(409, str(exc)) from exc\n    return {\"ok\": True}\n\n\n@app.get(\"/healthz\")\nasync def healthz() -> dict:\n    return {\"ok\": True}\n\"\"\"Inbound documents: vendor quotes and invoices from the mail gateway.\n\nThe mail gateway posts each received message to ``/ingest/mail`` signed with\nan HMAC over the timestamp and body. Accepted documents are stored per\nbusiness unit and are only ever shown to the model inside an\n``untrusted_document`` wrapper (tools/documents.py).\n\"\"\"\nfrom __future__ import annotations\n\nimport base64\nimport email\nimport email.policy\nimport hashlib\nimport hmac\nimport io\nimport re\nimport time\nimport uuid\nfrom dataclasses import dataclass\nfrom pathlib import Path\n\nfrom fastapi import APIRouter, HTTPException, Request\nfrom pypdf import PdfReader\n\nrouter = APIRouter()\n\nMAX_BODY_BYTES = 10 * 1024 * 1024\nMAX_TEXT_CHARS = 200_000\nMAX_SKEW_SECONDS = 300\nALLOWED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\", \"message/rfc822\"}\nSCANNED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\"}\n\nINJECTION_PATTERNS = [\n    re.compile(r\"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)\"),\n    re.compile(r\"(?i)\\b(system|developer) (prompt|message)\\b\"),\n    re.compile(r\"(?i)\\byou are (now )?(an?|the) \\w+ (agent|assistant)\\b\"),\n    re.compile(r\"(?i)\\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\\b\"),\n    re.compile(r\"(?i)\\b(update|change) (our|the) (bank|remit|payee)\\b\"),\n    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n]\n\n\nclass Rejected(Exception):\n    pass\n\n\n@dataclass\nclass Inbound:\n    business_unit: str\n    sender: str\n    media_type: str\n    raw: bytes\n\n\ndef verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:\n    try:\n        ts = int(timestamp)\n    except ValueError as exc:\n        raise Rejected(\"bad timestamp\") from exc\n    if abs(time.time() - ts) > MAX_SKEW_SECONDS:\n        raise Rejected(\"stale request\")\n    expected = hmac.new(key, f\"{timestamp}.\".encode() + body, hashlib.sha256).hexdigest()\n    if not hmac.compare_digest(expected, signature):\n        raise Rejected(\"bad signature\")\n\n\ndef extract_text(doc: Inbound) -> str:\n    if doc.media_type == \"application/pdf\":\n        reader = PdfReader(io.BytesIO(doc.raw))\n        if len(reader.pages) > 50:\n            raise Rejected(\"too many pages\")\n        return \"\\n\".join(page.extract_text() or \"\" for page in reader.pages)\n    if doc.media_type == \"message/rfc822\":\n        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)\n        body = msg.get_body(preferencelist=(\"plain\", \"html\"))\n        return body.get_content() if body is not None else \"\"\n    return doc.raw.decode(\"utf-8\", errors=\"strict\")\n\n\ndef scan_for_injection(text: str) -> list[str]:\n    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]\n\n\ndef validate(doc: Inbound) -> str:\n    if doc.media_type not in ALLOWED_MEDIA_TYPES:\n        raise Rejected(f\"media type {doc.media_type} not accepted\")\n    if len(doc.raw) > MAX_BODY_BYTES:\n        raise Rejected(\"document too large\")\n    try:\n        text = extract_text(doc)\n    except Rejected:\n        raise\n    except Exception as exc:\n        raise Rejected(f\"unreadable document: {type(exc).__name__}\") from exc\n    if len(text) > MAX_TEXT_CHARS:\n        raise Rejected(\"extracted text too long\")\n    if doc.media_type in SCANNED_MEDIA_TYPES:\n        findings = scan_for_injection(text)\n        if findings:\n            raise Rejected(\"possible prompt injection: \" + \"; \".join(findings))\n    return text\n\n\n@router.post(\"/ingest/mail\")\nasync def ingest_mail(request: Request) -> dict:\n    body = await request.body()\n    if len(body) > MAX_BODY_BYTES * 2:\n        raise HTTPException(413, \"payload too large\")\n    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()\n    try:\n        verify_signature(\n            key,\n            request.headers.get(\"X-Gateway-Timestamp\", \"\"),\n            body,\n            request.headers.get(\"X-Gateway-Signature\", \"\"),\n        )\n    except Rejected as exc:\n        raise HTTPException(401, str(exc)) from exc\n\n    payload = await request.json()\n    doc = Inbound(\n        business_unit=payload[\"business_unit\"],\n        sender=payload[\"from\"],\n        media_type=payload[\"media_type\"],\n        raw=base64.b64decode(payload[\"content_b64\"], validate=True),\n    )\n    doc_id = f\"doc-{uuid.uuid4().hex[:20]}\"\n    pool = request.app.state.pool\n    try:\n        text = validate(doc)\n    except Rejected as exc:\n        await pool.execute(\n            \"\"\"\n            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)\n            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())\n            \"\"\",\n            doc_id, doc.business_unit, doc.sender, doc.media_type,\n            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],\n        )\n        return {\"doc_id\": doc_id, \"status\": \"quarantined\"}\n\n    await pool.execute(\n        \"\"\"\n        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)\n        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())\n        \"\"\",\n        doc_id, doc.business_unit, doc.sender, doc.media_type,\n        hashlib.sha256(doc.raw).hexdigest(), text,\n    )\n    return {\"doc_id\": doc_id, \"status\": \"accepted\"}\n\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n\nThe agent runs under its own Kubernetes service account. Its projected\nservice-account token is exchanged at the internal STS for short-lived,\naudience-bound tokens. The launching user's token is never forwarded to an\nintegration; the user is carried as the delegated subject of the exchange.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport time\nimport uuid\nfrom dataclasses import dataclass, field, replace\nfrom pathlib import Path\n\nimport httpx\n\nfrom app.settings import Settings\n\nIDENTITY_FIELDS = (\n    \"accountable_party\",\n    \"operational_owner\",\n    \"tenant\",\n    \"agent_type_id\",\n    \"agent_instance_id\",\n    \"trace_id\",\n)\n\n\n@dataclass(frozen=True)\nclass RunIdentity:\n    accountable_party: str\n    operational_owner: str\n    tenant: str\n    agent_type_id: str\n    agent_instance_id: str\n    trace_id: str\n    run_id: str\n    delegated_subject: str\n    agent_principal: str\n    parent_instance_id: str | None = None\n    role: str = \"procurement\"\n\n    def __post_init__(self) -> None:\n        for name in IDENTITY_FIELDS:\n            if not getattr(self, name):\n                raise ValueError(f\"identity field {name} is empty\")\n\n    def child(self, role: str) -> \"RunIdentity\":\n        return replace(\n            self,\n            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n            parent_instance_id=self.agent_instance_id,\n            role=role,\n        )\n\n\ndef new_instance_id() -> str:\n    return f\"inst-{uuid.uuid4()}\"\n\n\ndef compute_agent_type_id(manifest: dict) -> str:\n    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    material = {\n        \"image_digest\": manifest[\"image\"][\"digest\"],\n        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n        \"models\": manifest[\"models\"],\n        \"config\": manifest[\"config\"],\n        \"tools\": manifest[\"tool_pins\"],\n    }\n    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n\n\n@dataclass\nclass _CachedToken:\n    value: str\n    expires_at: float\n\n\n@dataclass\nclass TokenBroker:\n    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n\n    settings: Settings\n    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n\n    def _workload_token(self) -> str:\n        return Path(self.settings.workload_token_path).read_text().strip()\n\n    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n        key = (audience, scope, ident.tenant)\n        cached = self._cache.get(key)\n        if cached and cached.expires_at - 30 > time.time():\n            return cached.value\n        async with httpx.AsyncClient(timeout=5.0) as client:\n            resp = await client.post(\n                self.settings.sts_url,\n                data={\n                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n                    \"subject_token\": self._workload_token(),\n                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n                    \"audience\": audience,\n                    \"scope\": scope,\n                    \"resource\": f\"urn:bu:{ident.tenant}\",\n                    \"actor_token\": ident.delegated_subject,\n                    \"actor_token_type\": \"urn:example:params:subject-id\",\n                },\n            )\n            resp.raise_for_status()\n            body = resp.json()\n        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n        self._cache[key] = token\n        return token.value\n\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n\nOn startup the tool list is fetched and each tool's description and input\nschema are fingerprinted and compared with the pins in the release manifest.\nAny unpinned or changed tool stops startup. Tool metadata is also scanned for\ninstruction-like content before any of it is shown to the model.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport logging\nimport re\nimport uuid\nfrom typing import Any\n\nimport httpx\n\nfrom app.identity import RunIdentity, TokenBroker\nfrom app.redact import redact_text\n\nlog = logging.getLogger(__name__)\n\nMAX_DESCRIPTION_CHARS = 1024\nSUSPICIOUS_METADATA = [\n    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n]\n\n\nclass ToolPinMismatch(Exception):\n    pass\n\n\nclass UnknownErpOperation(Exception):\n    pass\n\n\ndef fingerprint(tool: dict[str, Any]) -> str:\n    material = {\n        \"name\": tool[\"name\"],\n        \"description\": tool.get(\"description\", \"\"),\n        \"inputSchema\": tool.get(\"inputSchema\", {}),\n        \"annotations\": tool.get(\"annotations\", {}),\n    }\n    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n\n\ndef scan_metadata(tool: dict[str, Any]) -> None:\n    description = tool.get(\"description\", \"\")\n    if len(description) > MAX_DESCRIPTION_CHARS:\n        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    blob = json.dumps(tool, ensure_ascii=False)\n    for pattern in SUSPICIOUS_METADATA:\n        if pattern.search(blob):\n            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n\n\nclass ErpMcpClient:\n    AUDIENCE = \"erp-mcp-gateway\"\n\n    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n        self.url = url\n        self.pins = pins\n        self.broker = broker\n        self._tools: dict[str, dict[str, Any]] = {}\n\n    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n            resp = await client.post(\n                self.url,\n                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n            )\n        resp.raise_for_status()\n        if len(resp.content) > 512_000:\n            raise ValueError(\"erp response too large\")\n        body = resp.json()\n        if \"error\" in body:\n            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n        return body[\"result\"]\n\n    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n        result = await self._rpc(\"tools/list\", {}, token)\n        return list(result.get(\"tools\", []))\n\n    async def initialize(self, service_ident: RunIdentity) -> None:\n        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n        tools = await self._list_tools(token)\n        for tool in tools:\n            expected = self.pins.get(tool[\"name\"])\n            actual = fingerprint(tool)\n            if expected != actual:\n                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n            scan_metadata(tool)\n        self._tools = {t[\"name\"]: t for t in tools}\n        log.info(\"erp tools loaded: %d\", len(self._tools))\n\n    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n        if message.get(\"method\") == \"notifications/tools/list_changed\":\n            await self.refresh_tools(service_ident)\n\n    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n        tools = await self._list_tools(token)\n        self._tools = {t[\"name\"]: t for t in tools}\n        log.info(\"erp tools refreshed: %d\", len(self._tools))\n\n    def operations(self) -> list[str]:\n        return sorted(self._tools)\n\n    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n        if operation not in self._tools:\n            raise UnknownErpOperation(operation)\n        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n        result = await self._rpc(\n            \"tools/call\",\n            {\n                \"name\": operation,\n                \"arguments\": arguments,\n                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n            },\n            token,\n        )\n        if result.get(\"isError\"):\n            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n        return result.get(\"structuredContent\") or result.get(\"content\")\n./app/approvals.py:5:interactive callback is signature-checked in main.py and then calls\n./deploy/k8s/kyverno-verify-images.yaml:11:  webhookTimeoutSeconds: 15\n./release/manifest.yaml:30:    sha256: \"sha256:d6a55f1e170bdd457958243ddd9aa938f4ca707a3e1e9d1e7bca2a54df33ad32\"\n       0 app/__init__.py\n     114 app/approvals.py\n     118 app/audit.py\n     163 app/budget.py\n      74 app/context_size.py\n     114 app/extractor.py\n      61 app/gate.py\n     117 app/identity.py\n     150 app/ingest.py\n      31 app/killswitch.py\n     186 app/loop.py\n     196 app/main.py\n     131 app/mcp_client.py\n     100 app/redact.py\n      88 app/settings.py\n      46 app/startup.py\n      70 app/tools/__init__.py\n      61 app/tools/documents.py\n     107 app/tools/erp.py\n     135 app/tools/memory.py\n      66 app/tools/payments.py\n      94 app/tools/slack.py\n    2222 total","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WoUf4kJ371r22DCi71U7tx","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
