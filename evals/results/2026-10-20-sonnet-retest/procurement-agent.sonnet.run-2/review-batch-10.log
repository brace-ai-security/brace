{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014vCmY7qsmp3ZGCKorGBR7m","type":"tool_result","content":"     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t\n    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )\n     1\t\"\"\"Hard execution budgets, enforced by the harness and not by the model.\n     2\t\n     3\tPer run: step count, wall-clock time, tokens, cost, tool-call rate, and\n     4\tnumber of sub-agents. Sub-agents charge the parent's budget, so a child\n     5\tcannot widen what the parent was given.\n     6\t\n     7\tAcross runs: daily spend and per-minute run starts per user, per tenant\n     8\t(business unit), and for the whole fleet. Quotas are reserved in Postgres\n     9\tinside one transaction, so concurrent runs cannot overshoot them.\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport time\n    14\tfrom collections import deque\n    15\tfrom dataclasses import dataclass, field\n    16\tfrom decimal import Decimal\n    17\t\n    18\tfrom app.identity import RunIdentity\n    19\t\n    20\t\n    21\tclass BudgetExceeded(Exception):\n    22\t    def __init__(self, limit: str, used, allowed):\n    23\t        super().__init__(f\"{limit} exceeded: used={used} allowed={allowed}\")\n    24\t        self.limit = limit\n    25\t        self.used = used\n    26\t        self.allowed = allowed\n    27\t\n    28\t\n    29\t# USD per million tokens, from the provider price sheet referenced in the manifest.\n    30\tPRICES = {\n    31\t    \"claude-sonnet-4-5-20250929\": (Decimal(\"3.00\"), Decimal(\"15.00\")),\n    32\t    \"claude-haiku-4-5-20251001\": (Decimal(\"1.00\"), Decimal(\"5.00\")),\n    33\t}\n    34\t\n    35\t\n    36\t@dataclass\n    37\tclass Budget:\n    38\t    ident: RunIdentity\n    39\t    max_steps: int\n    40\t    max_wall_seconds: float\n    41\t    max_tokens: int\n    42\t    max_cost_usd: Decimal\n    43\t    max_tool_calls_per_minute: int\n    44\t    max_subagents: int\n    45\t    quotas_daily_usd: dict[str, Decimal]\n    46\t    run_starts_per_minute: dict[str, int]\n    47\t    started_at: float = field(default_factory=time.monotonic)\n    48\t    steps: int = 0\n    49\t    tokens: int = 0\n    50\t    cost_usd: Decimal = Decimal(\"0\")\n    51\t    unflushed_cost_usd: Decimal = Decimal(\"0\")\n    52\t    subagents: int = 0\n    53\t    _tool_calls: deque = field(default_factory=deque)\n    54\t\n    55\t    @classmethod\n    56\t    def for_run(cls, cfg: dict, ident: RunIdentity) -> \"Budget\":\n    57\t        run = cfg[\"per_run\"]\n    58\t        return cls(\n    59\t            ident=ident,\n    60\t            max_steps=int(run[\"max_steps\"]),\n    61\t            max_wall_seconds=float(run[\"max_wall_seconds\"]),\n    62\t            max_tokens=int(run[\"max_tokens\"]),\n    63\t            max_cost_usd=Decimal(str(run[\"max_cost_usd\"])),\n    64\t            max_tool_calls_per_minute=int(run[\"max_tool_calls_per_minute\"]),\n    65\t            max_subagents=int(run[\"max_subagents\"]),\n    66\t            quotas_daily_usd={k: Decimal(str(v)) for k, v in cfg[\"quotas_daily_usd\"].items()},\n    67\t            run_starts_per_minute={k: int(v) for k, v in cfg[\"run_starts_per_minute\"].items()},\n    68\t        )\n    69\t\n    70\t    def _scopes(self) -> list[tuple[str, str]]:\n    71\t        return [\n    72\t            (\"user\", self.ident.accountable_party),\n    73\t            (\"tenant\", self.ident.tenant),\n    74\t            (\"fleet\", \"all\"),\n    75\t        ]\n    76\t\n    77\t    # --- per-run limits -------------------------------------------------\n    78\t\n    79\t    def check_step(self) -> None:\n    80\t        self.steps += 1\n    81\t        if self.steps > self.max_steps:\n    82\t            raise BudgetExceeded(\"max_steps\", self.steps, self.max_steps)\n    83\t        elapsed = time.monotonic() - self.started_at\n    84\t        if elapsed > self.max_wall_seconds:\n    85\t            raise BudgetExceeded(\"max_wall_seconds\", round(elapsed, 1), self.max_wall_seconds)\n    86\t\n    87\t    def charge_model(self, model: str, usage) -> None:\n    88\t        price_in, price_out = PRICES[model]\n    89\t        tokens_in = (\n    90\t            int(usage.input_tokens or 0)\n    91\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n    92\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n    93\t        )\n    94\t        tokens_out = int(usage.output_tokens or 0)\n    95\t        self.tokens += tokens_in + tokens_out\n    96\t        cost = (price_in * tokens_in + price_out * tokens_out) / Decimal(1_000_000)\n    97\t        self.cost_usd += cost\n    98\t        self.unflushed_cost_usd += cost\n    99\t        if self.tokens > self.max_tokens:\n   100\t            raise BudgetExceeded(\"max_tokens\", self.tokens, self.max_tokens)\n   101\t        if self.cost_usd > self.max_cost_usd:\n   102\t            raise BudgetExceeded(\"max_cost_usd\", self.cost_usd, self.max_cost_usd)\n   103\t\n   104\t    def check_tool_call(self, now: float | None = None) -> None:\n   105\t        now = time.monotonic() if now is None else now\n   106\t        while self._tool_calls and now - self._tool_calls[0] > 60:\n   107\t            self._tool_calls.popleft()\n   108\t        if len(self._tool_calls) >= self.max_tool_calls_per_minute:\n   109\t            raise BudgetExceeded(\n   110\t                \"max_tool_calls_per_minute\", len(self._tool_calls) + 1, self.max_tool_calls_per_minute\n   111\t            )\n   112\t        self._tool_calls.append(now)\n   113\t\n   114\t    def check_subagent(self) -> None:\n   115\t        if self.subagents >= self.max_subagents:\n   116\t            raise BudgetExceeded(\"max_subagents\", self.subagents + 1, self.max_subagents)\n   117\t        self.subagents += 1\n   118\t\n   119\t    # --- cross-run quotas -----------------------------------------------\n   120\t\n   121\t    async def reserve_run_start(self, pool) -> None:\n   122\t        async with pool.acquire() as conn:\n   123\t            async with conn.transaction():\n   124\t                for scope, key in self._scopes():\n   125\t                    limit = self.run_starts_per_minute[scope]\n   126\t                    count = await conn.fetchval(\n   127\t                        \"\"\"\n   128\t                        INSERT INTO run_start_window (scope, key, minute, starts)\n   129\t                        VALUES ($1, $2, date_trunc('minute', now()), 1)\n   130\t                        ON CONFLICT (scope, key, minute)\n   131\t                        DO UPDATE SET starts = run_start_window.starts + 1\n   132\t                        RETURNING starts\n   133\t                        \"\"\",\n   134\t                        scope,\n   135\t                        key,\n   136\t                    )\n   137\t                    if count > limit:\n   138\t                        raise BudgetExceeded(f\"run_starts_per_minute.{scope}\", count, limit)\n   139\t\n   140\t    async def flush(self, pool) -> None:\n   141\t        \"\"\"Add this run's unflushed spend to the daily quotas, or stop the run.\"\"\"\n   142\t        if self.unflushed_cost_usd <= 0:\n   143\t            return\n   144\t        amount = self.unflushed_cost_usd\n   145\t        async with pool.acquire() as conn:\n   146\t            async with conn.transaction():\n   147\t                for scope, key in self._scopes():\n   148\t                    limit = self.quotas_daily_usd[scope]\n   149\t                    spent = await conn.fetchval(\n   150\t                        \"\"\"\n   151\t                        INSERT INTO spend_quota (scope, key, day, spent_usd)\n   152\t                        VALUES ($1, $2, current_date, $3)\n   153\t                        ON CONFLICT (scope, key, day)\n   154\t                        DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd\n   155\t                        RETURNING spent_usd\n   156\t                        \"\"\",\n   157\t                        scope,\n   158\t                        key,\n   159\t                        amount,\n   160\t                    )\n   161\t                    if spent > limit:\n   162\t                        raise BudgetExceeded(f\"quota_daily_usd.{scope}\", spent, limit)\n   163\t        self.unflushed_cost_usd = Decimal(\"0\")\n     1\t# Release manifest for the procurement agent. Regenerated by CI on every\n     2\t# release build (see .github/workflows/ci.yaml, job \"release\").\n     3\trelease: \"procurement-agent 2026.09.4\"\n     4\towner: team-procurement-platform\n     5\t\n     6\timage:\n     7\t  repository: registry.example-corp.test/procurement/agent\n     8\t  digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n     9\t  sbom: \"registry.example-corp.test/procurement/agent:sha256-7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0.sbom\"\n    10\t  signer:\n    11\t    issuer: \"https://token.actions.githubusercontent.com\"\n    12\t    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    13\t\n    14\tharness:\n    15\t  source_commit: \"3f9a1c7e2b8d4f6a0c5e9b1d7f3a8c2e6b4d0f91\"\n    16\t  digest: \"sha256:5b2d8f1a9c3e7b0d4f6a2c8e1b5d9f3a7c0e4b8d2f6a1c5e9b3d7f0a4c8e2b6d\"\n    17\t\n    18\tprompts:\n    19\t  system:\n    20\t    path: prompts/system.md\n    21\t    sha256: \"sha256:dcf69216667e65a0be3711d99aac81b707ba843296e7ce26d6fcbdb50c5bcc50\"\n    22\t  extractor:\n    23\t    path: prompts/extractor.md\n    24\t    sha256: \"sha256:6ef6527b77ffcca8851e7a8760e6373f3daede15d5b343b878737f0deec28de3\"\n    25\t\n    26\tconfig:\n    27\t  policy:\n    28\t    path: config/policy.yaml\n    29\t    version: \"proc-policy-2026.09.3\"\n    30\t    sha256: \"sha256:d6a55f1e170bdd457958243ddd9aa938f4ca707a3e1e9d1e7bca2a54df33ad32\"\n    31\t  tools:\n    32\t    path: config/tools.yaml\n    33\t    sha256: \"sha256:86dccc3d7d166bf8e131c3b2afbe5f2b846a57eaaf087b55f9e308844eda9400\"\n    34\t  network_policy: deploy/k8s/networkpolicy.yaml\n    35\t  image_policy: deploy/k8s/kyverno-verify-images.yaml\n    36\t\n    37\tmodels:\n    38\t  primary:\n    39\t    role: \"main agent\"\n    40\t    owner: team-procurement-platform\n    41\t    provider: anthropic\n    42\t    model_id: \"claude-sonnet-4-5-20250929\"\n    43\t    id_kind: \"pinned snapshot\"\n    44\t    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    45\t    adapter: none\n    46\t    fine_tune: none\n    47\t    training_run: \"not applicable\"\n    48\t    served_version: \"recorded per call from response.model\"\n    49\t    provider_undisclosed: [weights digest, pretraining data version]\n    50\t  extractor:\n    51\t    role: \"line-item extraction sub-agent\"\n    52\t    owner: team-procurement-platform\n    53\t    provider: anthropic\n    54\t    model_id: \"claude-haiku-4-5-20251001\"\n    55\t    id_kind: \"pinned snapshot\"\n    56\t    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    57\t    adapter: none\n    58\t    fine_tune: none\n    59\t    training_run: \"not applicable\"\n    60\t    served_version: \"recorded per call from response.model\"\n    61\t    provider_undisclosed: [weights digest, pretraining data version]\n    62\t\n    63\tmcp_servers:\n    64\t  erp:\n    65\t    endpoint: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    66\t    owner: team-erp-integrations\n    67\t\n    68\t# Fingerprints of the approved ERP MCP tools (name, description, inputSchema,\n    69\t# annotations), computed by app.mcp_client.fingerprint.\n    70\ttool_pins:\n    71\t  budget.get_remaining: \"sha256:bc96af69ba1cfd67b5428269dc74aa3e754f4dfe2d5dfa81deb0af68819379ca\"\n    72\t  vendor.get: \"sha256:7db5e65fb6d482d06985b19b7f1fce7422398b117bc7482f0380108cd6a6a1fe\"\n    73\t  vendor.search: \"sha256:3bd5aa0908885e967ce8ee1aa22e37b4f4fba867c8eac2b4127bca626731092c\"\n    74\t  vendor.update_remit_to: \"sha256:d3d3916ee6d742311c92f4972a1ffeb0f24782e729351f3e375f13eb05b94c1b\"\n    75\t  invoice.get: \"sha256:848ece38456338a085cb7091a2bbf1024e07946d62beb32a9ee94d2fa2fa8876\"\n    76\t  invoice.list_open: \"sha256:12bb2318f3876da6421183032cdd36727e545275e8eaf6fff66451d09371f12b\"\n    77\t  invoice.mark_paid: \"sha256:3a208eb55ee3a39962316b5d25fe6ba23457380c01aa39a5469ce3691130b05a\"\n    78\t  invoice.void: \"sha256:9645bec805f2ffdfa44f698f49e8701a6487afa3cb3e3c5c44e721cb21633d4c\"\n    79\t  po.get: \"sha256:121df83a279fc2ae3764c83faeb34f3037026586991c9192144ad7b727d18d7b\"\n    80\t  po.list_open: \"sha256:203c57fd158a8edf11b8dc02be534bc805d8caaf0959db8280f59ea0e5beb70a\"\n    81\t  po.create: \"sha256:fb15c157f7d79321972b310d74ee6c88a0fc76fd8edbbe4e821dcaa95a0852c6\"\n    82\t\n    83\tbudgets: config/policy.yaml#budgets\n    84\tidentity:\n    85\t  service_account: procurement-agent\n    86\t  spiffe_id: \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    87\t  sts_audiences: [erp-mcp-gateway, payments-api, slack-proxy]\n    88\tmemory:\n    89\t  store: \"postgres procurement.dept_notes\"\n    90\t  expiry_unverified_days: 30\n    91\tretrieval: none\n     1\tapiVersion: networking.k8s.io/v1\n     2\tkind: NetworkPolicy\n     3\tmetadata:\n     4\t  name: procurement-agent-default-deny\n     5\t  namespace: procurement-prod\n     6\tspec:\n     7\t  podSelector: {}\n     8\t  policyTypes: [\"Ingress\", \"Egress\"]\n     9\t---\n    10\tapiVersion: networking.k8s.io/v1\n    11\tkind: NetworkPolicy\n    12\tmetadata:\n    13\t  name: procurement-agent-egress\n    14\t  namespace: procurement-prod\n    15\tspec:\n    16\t  podSelector:\n    17\t    matchLabels:\n    18\t      app: procurement-agent\n    19\t  policyTypes: [\"Egress\"]\n    20\t  egress:\n    21\t    - to:\n    22\t        - namespaceSelector:\n    23\t            matchLabels:\n    24\t              kubernetes.io/metadata.name: kube-system\n    25\t          podSelector:\n    26\t            matchLabels:\n    27\t              k8s-app: kube-dns\n    28\t      ports:\n    29\t        - { protocol: UDP, port: 53 }\n    30\t        - { protocol: TCP, port: 53 }\n    31\t    - to:\n    32\t        - namespaceSelector:\n    33\t            matchLabels:\n    34\t              kubernetes.io/metadata.name: egress\n    35\t          podSelector:\n    36\t            matchLabels:\n    37\t              app: egress-proxy\n    38\t      ports:\n    39\t        - { protocol: TCP, port: 3128 }\n    40\t    - to:\n    41\t        - namespaceSelector:\n    42\t            matchLabels:\n    43\t              kubernetes.io/metadata.name: egress\n    44\t          podSelector:\n    45\t            matchLabels:\n    46\t              app: slack-proxy\n    47\t      ports:\n    48\t        - { protocol: TCP, port: 8443 }\n    49\t    - to:\n    50\t        - namespaceSelector:\n    51\t            matchLabels:\n    52\t              kubernetes.io/metadata.name: procurement-data\n    53\t          podSelector:\n    54\t            matchLabels:\n    55\t              app: procurement-db\n    56\t      ports:\n    57\t        - { protocol: TCP, port: 5432 }\n    58\t    - to:\n    59\t        - namespaceSelector:\n    60\t            matchLabels:\n    61\t              kubernetes.io/metadata.name: erp-mcp-gateway\n    62\t      ports:\n    63\t        - { protocol: TCP, port: 8443 }\n    64\t    - to:\n    65\t        - namespaceSelector:\n    66\t            matchLabels:\n    67\t              kubernetes.io/metadata.name: identity\n    68\t          podSelector:\n    69\t            matchLabels:\n    70\t              app: sts\n    71\t      ports:\n    72\t        - { protocol: TCP, port: 443 }\n    73\t    - to:\n    74\t        - ipBlock:\n    75\t            cidr: 0.0.0.0/0\n    76\t            except:\n    77\t              - 10.0.0.0/8\n    78\t              - 172.16.0.0/12\n    79\t              - 192.168.0.0/16\n    80\t              - 169.254.0.0/16\n    81\t      ports:\n    82\t        - { protocol: TCP, port: 443 }\n    83\t---\n    84\tapiVersion: networking.k8s.io/v1\n    85\tkind: NetworkPolicy\n    86\tmetadata:\n    87\t  name: procurement-agent-ingress\n    88\t  namespace: procurement-prod\n    89\tspec:\n    90\t  podSelector:\n    91\t    matchLabels:\n    92\t      app: procurement-agent\n    93\t  policyTypes: [\"Ingress\"]\n    94\t  ingress:\n    95\t    - from:\n    96\t        - namespaceSelector:\n    97\t            matchLabels:\n    98\t              kubernetes.io/metadata.name: ingress\n    99\t      ports:\n   100\t        - { protocol: TCP, port: 8080 }\n   101\t---\n   102\t# Egress proxy allowlist (applied in the egress namespace by the platform team).\n   103\tapiVersion: v1\n   104\tkind: ConfigMap\n   105\tmetadata:\n   106\t  name: egress-proxy-allowlist-procurement\n   107\t  namespace: egress\n   108\tdata:\n   109\t  allowlist.txt: |\n   110\t    api.anthropic.com\n   111\t    api.payments.example-pay.test\n   112\t    login.example-corp.test\n     1\t# procurement-agent\n     2\t\n     3\tProcurement agent for Example Corp business units. It reads vendor quotes and\n     4\tinvoices that arrive by email, checks them against department budgets, raises\n     5\tpurchase orders in the ERP, pays matched invoices, and talks to staff and\n     6\tvendors in Slack. It keeps short per-department notes between runs.\n     7\t\n     8\t## Architecture\n     9\t\n    10\t```\n    11\tmail gateway --HMAC--> /ingest/mail --> documents (Postgres, per business unit)\n    12\tstaff (OIDC JWT) ----> /runs --> ProcurementAgent loop (app/loop.py)\n    13\t                                   |-- PolicyGate (app/gate.py) + approvals (Slack buttons)\n    14\t                                   |-- Budget (app/budget.py)\n    15\t                                   |-- audit graph (app/audit.py -> audit_events)\n    16\t                                   |-- tools:\n    17\t                                   |     read_document, extract_line_items -> LineItemExtractor sub-agent\n    18\t                                   |     get_budget, erp_call, create_purchase_order -> ERP MCP via gateway\n    19\t                                   |     pay_invoice -> payments API\n    20\t                                   |     post_slack_message -> Slack (via slack-proxy)\n    21\t                                   |     memory_read, memory_write -> dept_notes\n    22\t```\n    23\t\n    24\t* **Tenancy.** Each run belongs to one business unit, taken from the `bu`\n    25\t  claim of the caller's verified OIDC token. Documents, notes, approvals and\n    26\t  quotas are keyed by business unit.\n    27\t* **Identity.** The agent runs as the `procurement-agent` service account.\n    28\t  Its projected token (10-minute lifetime) is exchanged at the internal STS\n    29\t  for audience-bound tokens for the ERP gateway, payments API and Slack\n    30\t  proxy. User tokens are never forwarded.\n    31\t* **Approvals.** `create_purchase_order`, `pay_invoice` and vendor messages\n    32\t  require an approval from a role listed in `config/policy.yaml`. Approval\n    33\t  requests are posted to `#approvals-<bu>` with the argument summary.\n    34\t* **Budgets.** Per-run step, time, token, cost, tool-rate and sub-agent\n    35\t  limits, plus per-user, per-business-unit and fleet quotas for daily spend\n    36\t  and run starts. See `config/policy.yaml`.\n    37\t* **Audit.** Every run step is a row in `audit_events` linked to its parent\n    38\t  step, with the six identity fields, policy version, approval id and\n    39\t  decision-time context size. The agent's database role can insert audit\n    40\t  rows but not update or delete them.\n    41\t\n    42\t## Context size\n    43\t\n    44\tLogged on every audit row as `context_tokens` and `context_method`:\n    45\t\n    46\t| method | meaning |\n    47\t|---|---|\n    48\t| `count_tokens_api` | exact request counted with the provider's token-count endpoint before the call (includes cached prefix) |\n    49\t| `usage_sum_estimate` | counting failed; `input_tokens + cache_read + cache_creation` from the response |\n    50\t| `unavailable` | neither available; `context_tokens` is NULL, never 0 |\n    51\t\n    52\t`context_compacted` is true when the harness dropped earlier turns before the\n    53\tcall (`app/loop.py:_compact`). Provider-side truncation is not visible.\n    54\t\n    55\t## Operating\n    56\t\n    57\t* **Halt.** Insert or update a row in `control_flags` (`scope = 'fleet'` or\n    58\t  `'tenant:<bu>'`, `halted = true`) as `procurement_ops`. New runs refuse to\n    59\t  start while a halt is set.\n    60\t* **Release.** Merges to `main` build, sign (keyless cosign), and attest the\n    61\t  image (SLSA provenance and CycloneDX SBOM). Kyverno rejects unsigned or\n    62\t  unattested images in `procurement-prod`.\n    63\t* **Network.** Default-deny egress with explicit rules for DNS, the egress\n    64\t  proxy, the Slack proxy, the database, the ERP gateway and the STS.\n    65\t\n    66\t## Tests\n    67\t\n    68\t```bash\n    69\tpip install -e '.[test]'\n    70\tpytest -q\n    71\t```\n     1\t\"\"\"Approval requests and decisions for high-impact operations.\n     2\t\n     3\tRequests are posted to the business unit's approvals channel in Slack with\n     4\tthe full argument summary. Approvers decide with the Slack buttons; the\n     5\tinteractive callback is signature-checked in main.py and then calls\n     6\t``decide``. Approver authority is checked against the role map in policy.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport json\n    11\timport uuid\n    12\tfrom dataclasses import dataclass\n    13\tfrom datetime import datetime, timedelta, timezone\n    14\tfrom typing import Any\n    15\t\n    16\tfrom app.audit import digest, summarize_args\n    17\tfrom app.identity import RunIdentity\n    18\t\n    19\t\n    20\t@dataclass(frozen=True)\n    21\tclass Approval:\n    22\t    id: str\n    23\t    approver: str\n    24\t    approver_role: str\n    25\t    expires_at: datetime\n    26\t\n    27\t\n    28\tclass ApproverNotAuthorized(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tclass ApprovalStore:\n    33\t    def __init__(self, pool, policy: dict, notifier):\n    34\t        self.pool = pool\n    35\t        self.ttl = timedelta(minutes=int(policy[\"approvals\"][\"ttl_minutes\"]))\n    36\t        self.approver_roles: dict[str, list[str]] = policy[\"approvals\"][\"approver_roles\"]\n    37\t        self.notifier = notifier\n    38\t\n    39\t    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n    40\t        approval_id = f\"apr-{uuid.uuid4()}\"\n    41\t        expires_at = datetime.now(timezone.utc) + self.ttl\n    42\t        await self.pool.execute(\n    43\t            \"\"\"\n    44\t            INSERT INTO approvals (\n    45\t                id, tool, target, args_sha256, args_summary, tenant,\n    46\t                requested_by_instance, requested_by_run, delegated_subject,\n    47\t                status, requested_at, expires_at\n    48\t            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)\n    49\t            \"\"\",\n    50\t            approval_id,\n    51\t            tool,\n    52\t            target,\n    53\t            digest(args),\n    54\t            json.dumps(summarize_args(args)),\n    55\t            ident.tenant,\n    56\t            ident.agent_instance_id,\n    57\t            ident.run_id,\n    58\t            ident.delegated_subject,\n    59\t            expires_at,\n    60\t        )\n    61\t        await self.notifier.post_approval_request(\n    62\t            tenant=ident.tenant,\n    63\t            approval_id=approval_id,\n    64\t            tool=tool,\n    65\t            target=target,\n    66\t            summary=summarize_args(args),\n    67\t            expires_at=expires_at,\n    68\t        )\n    69\t        return approval_id\n    70\t\n    71\t    async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:\n    72\t        row = await self.pool.fetchrow(\n    73\t            \"\"\"\n    74\t            SELECT id, approver, approver_role, expires_at\n    75\t            FROM approvals\napp/approvals.py:5:interactive callback is signature-checked in main.py and then calls\ndeploy/k8s/kyverno-verify-images.yaml:11:  webhookTimeoutSeconds: 15","is_error":false}]},"parent_tool_use_id":null,"session_id":"a5b5a778-e697-4bf4-b8d2-f31f98ce1ebe","uuid":"dba9bce9-1d89-4be8-8360-018d7c35ad51","timestamp":"2026-10-20T13:30:23.161Z","tool_use_result":{"stdout":"     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t\n    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )\n     1\t\"\"\"Hard execution budgets, enforced by the harness and not by the model.\n     2\t\n     3\tPer run: step count, wall-clock time, tokens, cost, tool-call rate, and\n     4\tnumber of sub-agents. Sub-agents charge the parent's budget, so a child\n     5\tcannot widen what the parent was given.\n     6\t\n     7\tAcross runs: daily spend and per-minute run starts per user, per tenant\n     8\t(business unit), and for the whole fleet. Quotas are reserved in Postgres\n     9\tinside one transaction, so concurrent runs cannot overshoot them.\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport time\n    14\tfrom collections import deque\n    15\tfrom dataclasses import dataclass, field\n    16\tfrom decimal import Decimal\n    17\t\n    18\tfrom app.identity import RunIdentity\n    19\t\n    20\t\n    21\tclass BudgetExceeded(Exception):\n    22\t    def __init__(self, limit: str, used, allowed):\n    23\t        super().__init__(f\"{limit} exceeded: used={used} allowed={allowed}\")\n    24\t        self.limit = limit\n    25\t        self.used = used\n    26\t        self.allowed = allowed\n    27\t\n    28\t\n    29\t# USD per million tokens, from the provider price sheet referenced in the manifest.\n    30\tPRICES = {\n    31\t    \"claude-sonnet-4-5-20250929\": (Decimal(\"3.00\"), Decimal(\"15.00\")),\n    32\t    \"claude-haiku-4-5-20251001\": (Decimal(\"1.00\"), Decimal(\"5.00\")),\n    33\t}\n    34\t\n    35\t\n    36\t@dataclass\n    37\tclass Budget:\n    38\t    ident: RunIdentity\n    39\t    max_steps: int\n    40\t    max_wall_seconds: float\n    41\t    max_tokens: int\n    42\t    max_cost_usd: Decimal\n    43\t    max_tool_calls_per_minute: int\n    44\t    max_subagents: int\n    45\t    quotas_daily_usd: dict[str, Decimal]\n    46\t    run_starts_per_minute: dict[str, int]\n    47\t    started_at: float = field(default_factory=time.monotonic)\n    48\t    steps: int = 0\n    49\t    tokens: int = 0\n    50\t    cost_usd: Decimal = Decimal(\"0\")\n    51\t    unflushed_cost_usd: Decimal = Decimal(\"0\")\n    52\t    subagents: int = 0\n    53\t    _tool_calls: deque = field(default_factory=deque)\n    54\t\n    55\t    @classmethod\n    56\t    def for_run(cls, cfg: dict, ident: RunIdentity) -> \"Budget\":\n    57\t        run = cfg[\"per_run\"]\n    58\t        return cls(\n    59\t            ident=ident,\n    60\t            max_steps=int(run[\"max_steps\"]),\n    61\t            max_wall_seconds=float(run[\"max_wall_seconds\"]),\n    62\t            max_tokens=int(run[\"max_tokens\"]),\n    63\t            max_cost_usd=Decimal(str(run[\"max_cost_usd\"])),\n    64\t            max_tool_calls_per_minute=int(run[\"max_tool_calls_per_minute\"]),\n    65\t            max_subagents=int(run[\"max_subagents\"]),\n    66\t            quotas_daily_usd={k: Decimal(str(v)) for k, v in cfg[\"quotas_daily_usd\"].items()},\n    67\t            run_starts_per_minute={k: int(v) for k, v in cfg[\"run_starts_per_minute\"].items()},\n    68\t        )\n    69\t\n    70\t    def _scopes(self) -> list[tuple[str, str]]:\n    71\t        return [\n    72\t            (\"user\", self.ident.accountable_party),\n    73\t            (\"tenant\", self.ident.tenant),\n    74\t            (\"fleet\", \"all\"),\n    75\t        ]\n    76\t\n    77\t    # --- per-run limits -------------------------------------------------\n    78\t\n    79\t    def check_step(self) -> None:\n    80\t        self.steps += 1\n    81\t        if self.steps > self.max_steps:\n    82\t            raise BudgetExceeded(\"max_steps\", self.steps, self.max_steps)\n    83\t        elapsed = time.monotonic() - self.started_at\n    84\t        if elapsed > self.max_wall_seconds:\n    85\t            raise BudgetExceeded(\"max_wall_seconds\", round(elapsed, 1), self.max_wall_seconds)\n    86\t\n    87\t    def charge_model(self, model: str, usage) -> None:\n    88\t        price_in, price_out = PRICES[model]\n    89\t        tokens_in = (\n    90\t            int(usage.input_tokens or 0)\n    91\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n    92\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n    93\t        )\n    94\t        tokens_out = int(usage.output_tokens or 0)\n    95\t        self.tokens += tokens_in + tokens_out\n    96\t        cost = (price_in * tokens_in + price_out * tokens_out) / Decimal(1_000_000)\n    97\t        self.cost_usd += cost\n    98\t        self.unflushed_cost_usd += cost\n    99\t        if self.tokens > self.max_tokens:\n   100\t            raise BudgetExceeded(\"max_tokens\", self.tokens, self.max_tokens)\n   101\t        if self.cost_usd > self.max_cost_usd:\n   102\t            raise BudgetExceeded(\"max_cost_usd\", self.cost_usd, self.max_cost_usd)\n   103\t\n   104\t    def check_tool_call(self, now: float | None = None) -> None:\n   105\t        now = time.monotonic() if now is None else now\n   106\t        while self._tool_calls and now - self._tool_calls[0] > 60:\n   107\t            self._tool_calls.popleft()\n   108\t        if len(self._tool_calls) >= self.max_tool_calls_per_minute:\n   109\t            raise BudgetExceeded(\n   110\t                \"max_tool_calls_per_minute\", len(self._tool_calls) + 1, self.max_tool_calls_per_minute\n   111\t            )\n   112\t        self._tool_calls.append(now)\n   113\t\n   114\t    def check_subagent(self) -> None:\n   115\t        if self.subagents >= self.max_subagents:\n   116\t            raise BudgetExceeded(\"max_subagents\", self.subagents + 1, self.max_subagents)\n   117\t        self.subagents += 1\n   118\t\n   119\t    # --- cross-run quotas -----------------------------------------------\n   120\t\n   121\t    async def reserve_run_start(self, pool) -> None:\n   122\t        async with pool.acquire() as conn:\n   123\t            async with conn.transaction():\n   124\t                for scope, key in self._scopes():\n   125\t                    limit = self.run_starts_per_minute[scope]\n   126\t                    count = await conn.fetchval(\n   127\t                        \"\"\"\n   128\t                        INSERT INTO run_start_window (scope, key, minute, starts)\n   129\t                        VALUES ($1, $2, date_trunc('minute', now()), 1)\n   130\t                        ON CONFLICT (scope, key, minute)\n   131\t                        DO UPDATE SET starts = run_start_window.starts + 1\n   132\t                        RETURNING starts\n   133\t                        \"\"\",\n   134\t                        scope,\n   135\t                        key,\n   136\t                    )\n   137\t                    if count > limit:\n   138\t                        raise BudgetExceeded(f\"run_starts_per_minute.{scope}\", count, limit)\n   139\t\n   140\t    async def flush(self, pool) -> None:\n   141\t        \"\"\"Add this run's unflushed spend to the daily quotas, or stop the run.\"\"\"\n   142\t        if self.unflushed_cost_usd <= 0:\n   143\t            return\n   144\t        amount = self.unflushed_cost_usd\n   145\t        async with pool.acquire() as conn:\n   146\t            async with conn.transaction():\n   147\t                for scope, key in self._scopes():\n   148\t                    limit = self.quotas_daily_usd[scope]\n   149\t                    spent = await conn.fetchval(\n   150\t                        \"\"\"\n   151\t                        INSERT INTO spend_quota (scope, key, day, spent_usd)\n   152\t                        VALUES ($1, $2, current_date, $3)\n   153\t                        ON CONFLICT (scope, key, day)\n   154\t                        DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd\n   155\t                        RETURNING spent_usd\n   156\t                        \"\"\",\n   157\t                        scope,\n   158\t                        key,\n   159\t                        amount,\n   160\t                    )\n   161\t                    if spent > limit:\n   162\t                        raise BudgetExceeded(f\"quota_daily_usd.{scope}\", spent, limit)\n   163\t        self.unflushed_cost_usd = Decimal(\"0\")\n     1\t# Release manifest for the procurement agent. Regenerated by CI on every\n     2\t# release build (see .github/workflows/ci.yaml, job \"release\").\n     3\trelease: \"procurement-agent 2026.09.4\"\n     4\towner: team-procurement-platform\n     5\t\n     6\timage:\n     7\t  repository: registry.example-corp.test/procurement/agent\n     8\t  digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n     9\t  sbom: \"registry.example-corp.test/procurement/agent:sha256-7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0.sbom\"\n    10\t  signer:\n    11\t    issuer: \"https://token.actions.githubusercontent.com\"\n    12\t    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    13\t\n    14\tharness:\n    15\t  source_commit: \"3f9a1c7e2b8d4f6a0c5e9b1d7f3a8c2e6b4d0f91\"\n    16\t  digest: \"sha256:5b2d8f1a9c3e7b0d4f6a2c8e1b5d9f3a7c0e4b8d2f6a1c5e9b3d7f0a4c8e2b6d\"\n    17\t\n    18\tprompts:\n    19\t  system:\n    20\t    path: prompts/system.md\n    21\t    sha256: \"sha256:dcf69216667e65a0be3711d99aac81b707ba843296e7ce26d6fcbdb50c5bcc50\"\n    22\t  extractor:\n    23\t    path: prompts/extractor.md\n    24\t    sha256: \"sha256:6ef6527b77ffcca8851e7a8760e6373f3daede15d5b343b878737f0deec28de3\"\n    25\t\n    26\tconfig:\n    27\t  policy:\n    28\t    path: config/policy.yaml\n    29\t    version: \"proc-policy-2026.09.3\"\n    30\t    sha256: \"sha256:d6a55f1e170bdd457958243ddd9aa938f4ca707a3e1e9d1e7bca2a54df33ad32\"\n    31\t  tools:\n    32\t    path: config/tools.yaml\n    33\t    sha256: \"sha256:86dccc3d7d166bf8e131c3b2afbe5f2b846a57eaaf087b55f9e308844eda9400\"\n    34\t  network_policy: deploy/k8s/networkpolicy.yaml\n    35\t  image_policy: deploy/k8s/kyverno-verify-images.yaml\n    36\t\n    37\tmodels:\n    38\t  primary:\n    39\t    role: \"main agent\"\n    40\t    owner: team-procurement-platform\n    41\t    provider: anthropic\n    42\t    model_id: \"claude-sonnet-4-5-