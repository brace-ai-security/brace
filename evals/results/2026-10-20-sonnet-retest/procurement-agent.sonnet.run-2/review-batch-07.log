{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017j3XVSaZZhTiVhHjSEA1tU","type":"tool_result","content":"1\t=== app/audit.py\n2\t     1\t\"\"\"Execution audit graph.\n3\t     2\t\n4\t     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n5\t     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n6\t     5\ttool call -> authorization decision -> result or error. Writes are\n7\t     6\tsynchronous and are made before the action they describe; if the write\n8\t     7\tfails, the caller raises and the action does not run.\n9\t     8\t\"\"\"\n10\t     9\tfrom __future__ import annotations\n11\t    10\t\n12\t    11\timport hashlib\n13\t    12\timport json\n14\t    13\timport uuid\n15\t    14\tfrom datetime import datetime, timezone\n16\t    15\tfrom typing import Any\n17\t    16\t\n18\t    17\tfrom opentelemetry import trace\n19\t    18\t\n20\t    19\tfrom app.context_size import ContextMeasure\n21\t    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n22\t    21\tfrom app.redact import redact_value\n23\t    22\t\n24\t    23\tEVENT_KINDS = {\n25\t    24\t    \"run_started\",\n26\t    25\t    \"run_finished\",\n27\t    26\t    \"run_halted\",\n28\t    27\t    \"model_decision\",\n29\t    28\t    \"tool_proposed\",\n30\t    29\t    \"authz_decision\",\n31\t    30\t    \"approval_requested\",\n32\t    31\t    \"approval_decided\",\n33\t    32\t    \"tool_result\",\n34\t    33\t    \"tool_error\",\n35\t    34\t    \"tool_denied\",\n36\t    35\t    \"budget_exceeded\",\n37\t    36\t    \"subagent_started\",\n38\t    37\t    \"subagent_finished\",\n39\t    38\t    \"background_job\",\n40\t    39\t}\n41\t    40\t\n42\t    41\t_INSERT = \"\"\"\n43\t    42\tINSERT INTO audit_events (\n44\t    43\t    node_id, parent_node_id, run_id, ts, kind,\n45\t    44\t    accountable_party, operational_owner, tenant,\n46\t    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n47\t    46\t    delegated_subject, agent_principal, parent_instance_id,\n48\t    47\t    policy_version, approval_id, operation_id,\n49\t    48\t    context_tokens, context_method, context_compacted,\n50\t    49\t    payload\n51\t    50\t) VALUES (\n52\t    51\t    $1, $2, $3, $4, $5,\n53\t    52\t    $6, $7, $8,\n54\t    53\t    $9, $10, $11, $12,\n55\t    54\t    $13, $14, $15,\n56\t    55\t    $16, $17, $18,\n57\t    56\t    $19, $20, $21,\n58\t    57\t    $22::jsonb\n59\t    58\t)\n60\t    59\t\"\"\"\n61\t    60\t\n62\t    61\t\n63\t    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n64\t    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n65\t    64\t    return {k: redact_value(v) for k, v in args.items()}\n66\t    65\t\n67\t    66\t\n68\t    67\tdef digest(value: Any) -> str:\n69\t    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n70\t    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n71\t    70\t\n72\t    71\t\n73\t    72\tasync def record(\n74\t    73\t    pool,\n75\t    74\t    ident: RunIdentity,\n76\t    75\t    *,\n77\t    76\t    kind: str,\n78\t    77\t    payload: dict[str, Any] | None = None,\n79\t    78\t    parent: str | None = None,\n80\t    79\t    context: ContextMeasure | None = None,\n81\t    80\t    policy_version: str | None = None,\n82\t    81\t    approval_id: str | None = None,\n83\t    82\t    operation_id: str | None = None,\n84\t    83\t) -> str:\n85\t    84\t    if kind not in EVENT_KINDS:\n86\t    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n87\t    86\t    for name in IDENTITY_FIELDS:\n88\t    87\t        if not getattr(ident, name):\n89\t    88\t            raise ValueError(f\"audit record missing {name}\")\n90\t    89\t    span_ctx = trace.get_current_span().get_span_context()\n91\t    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n92\t    91\t    node_id = f\"node-{uuid.uuid4()}\"\n93\t    92\t    measure = context or ContextMeasure.unavailable()\n94\t    93\t    await pool.execute(\n95\t    94\t        _INSERT,\n96\t    95\t        node_id,\n97\t    96\t        parent,\n98\t    97\t        ident.run_id,\n99\t    98\t        datetime.now(timezone.utc),\n100\t    99\t        kind,\n101\t   100\t        ident.accountable_party,\n102\t   101\t        ident.operational_owner,\n103\t   102\t        ident.tenant,\n104\t   103\t        ident.agent_type_id,\n105\t   104\t        ident.agent_instance_id,\n106\t   105\t        ident.trace_id,\n107\t   106\t        span_id,\n108\t   107\t        ident.delegated_subject,\n109\t   108\t        ident.agent_principal,\n110\t   109\t        ident.parent_instance_id,\n111\t   110\t        policy_version,\n112\t   111\t        approval_id,\n113\t   112\t        operation_id,\n114\t   113\t        measure.tokens,\n115\t   114\t        measure.method,\n116\t   115\t        measure.compacted,\n117\t   116\t        json.dumps(redact_value(payload or {}), default=str),\n118\t   117\t    )\n119\t   118\t    return node_id\n120\t=== app/identity.py\n121\t     1\t\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n122\t     2\t\n123\t     3\tThe agent runs under its own Kubernetes service account. Its projected\n124\t     4\tservice-account token is exchanged at the internal STS for short-lived,\n125\t     5\taudience-bound tokens. The launching user's token is never forwarded to an\n126\t     6\tintegration; the user is carried as the delegated subject of the exchange.\n127\t     7\t\"\"\"\n128\t     8\tfrom __future__ import annotations\n129\t     9\t\n130\t    10\timport hashlib\n131\t    11\timport json\n132\t    12\timport time\n133\t    13\timport uuid\n134\t    14\tfrom dataclasses import dataclass, field, replace\n135\t    15\tfrom pathlib import Path\n136\t    16\t\n137\t    17\timport httpx\n138\t    18\t\n139\t    19\tfrom app.settings import Settings\n140\t    20\t\n141\t    21\tIDENTITY_FIELDS = (\n142\t    22\t    \"accountable_party\",\n143\t    23\t    \"operational_owner\",\n144\t    24\t    \"tenant\",\n145\t    25\t    \"agent_type_id\",\n146\t    26\t    \"agent_instance_id\",\n147\t    27\t    \"trace_id\",\n148\t    28\t)\n149\t    29\t\n150\t    30\t\n151\t    31\t@dataclass(frozen=True)\n152\t    32\tclass RunIdentity:\n153\t    33\t    accountable_party: str\n154\t    34\t    operational_owner: str\n155\t    35\t    tenant: str\n156\t    36\t    agent_type_id: str\n157\t    37\t    agent_instance_id: str\n158\t    38\t    trace_id: str\n159\t    39\t    run_id: str\n160\t    40\t    delegated_subject: str\n161\t    41\t    agent_principal: str\n162\t    42\t    parent_instance_id: str | None = None\n163\t    43\t    role: str = \"procurement\"\n164\t    44\t\n165\t    45\t    def __post_init__(self) -> None:\n166\t    46\t        for name in IDENTITY_FIELDS:\n167\t    47\t            if not getattr(self, name):\n168\t    48\t                raise ValueError(f\"identity field {name} is empty\")\n169\t    49\t\n170\t    50\t    def child(self, role: str) -> \"RunIdentity\":\n171\t    51\t        return replace(\n172\t    52\t            self,\n173\t    53\t            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n174\t    54\t            parent_instance_id=self.agent_instance_id,\n175\t    55\t            role=role,\n176\t    56\t        )\n177\t    57\t\n178\t    58\t\n179\t    59\tdef new_instance_id() -> str:\n180\t    60\t    return f\"inst-{uuid.uuid4()}\"\n181\t    61\t\n182\t    62\t\n183\t    63\tdef compute_agent_type_id(manifest: dict) -> str:\n184\t    64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n185\t    65\t    material = {\n186\t    66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n187\t    67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n188\t    68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n189\t    69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n190\t    70\t        \"models\": manifest[\"models\"],\n191\t    71\t        \"config\": manifest[\"config\"],\n192\t    72\t        \"tools\": manifest[\"tool_pins\"],\n193\t    73\t    }\n194\t    74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n195\t    75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n196\t    76\t\n197\t    77\t\n198\t    78\t@dataclass\n199\t    79\tclass _CachedToken:\n200\t    80\t    value: str\n201\t    81\t    expires_at: float\n202\t    82\t\n203\t    83\t\n204\t    84\t@dataclass\n205\t    85\tclass TokenBroker:\n206\t    86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n207\t    87\t\n208\t    88\t    settings: Settings\n209\t    89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n210\t    90\t\n211\t    91\t    def _workload_token(self) -> str:\n212\t    92\t        return Path(self.settings.workload_token_path).read_text().strip()\n213\t    93\t\n214\t    94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n215\t    95\t        key = (audience, scope, ident.tenant)\n216\t    96\t        cached = self._cache.get(key)\n217\t    97\t        if cached and cached.expires_at - 30 > time.time():\n218\t    98\t            return cached.value\n219\t    99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n220\t   100\t            resp = await client.post(\n221\t   101\t                self.settings.sts_url,\n222\t   102\t                data={\n223\t   103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n224\t   104\t                    \"subject_token\": self._workload_token(),\n225\t   105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n226\t   106\t                    \"audience\": audience,\n227\t   107\t                    \"scope\": scope,\n228\t   108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n229\t   109\t                    \"actor_token\": ident.delegated_subject,\n230\t   110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n231\t   111\t                },\n232\t   112\t            )\n233\t   113\t            resp.raise_for_status()\n234\t   114\t            body = resp.json()\n235\t   115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n236\t   116\t        self._cache[key] = token\n237\t   117\t        return token.value\n238\t=== app/loop.py\n239\t     1\t\"\"\"Procurement agent run loop.\n240\t     2\t\n241\t     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n242\t     4\tEvery edge writes an audit node before the next step runs. Budgets are\n243\t     5\tchecked before each model turn and each tool call.\n244\t     6\t\"\"\"\n245\t     7\tfrom __future__ import annotations\n246\t     8\t\n247\t     9\timport hashlib\n248\t    10\timport logging\n249\t    11\tfrom dataclasses import dataclass, field\n250\t    12\tfrom typing import Any\n251\t    13\t\n252\t    14\tfrom opentelemetry import trace\n253\t    15\t\n254\t    16\tfrom app import audit, killswitch\n255\t    17\tfrom app.budget import Budget, BudgetExceeded\n256\t    18\tfrom app.context_size import ContextMeasure, measure_context\n257\t    19\tfrom app.gate import PolicyGate\n258\t    20\tfrom app.identity import RunIdentity\n259\t    21\tfrom app.redact import redact_for_model\n260\t    22\tfrom app.tools import ToolRegistry, build_registry\n261\t    23\t\n262\t    24\tlog = logging.getLogger(__name__)\n263\t    25\ttracer = trace.get_tracer(\"procurement.loop\")\n264\t    26\t\n265\t    27\tCOMPACT_AFTER_MESSAGES = 40\n266\t    28\tKEEP_RECENT_MESSAGES = 12\n267\t    29\t\n268\t    30\t\n269\t    31\t@dataclass\n270\t    32\tclass AgentDeps:\n271\t    33\t    settings: Any\n272\t    34\t    pool: Any\n273\t    35\t    gate: PolicyGate\n274\t    36\t    erp: Any\n275\t    37\t    slack: Any\n276\t    38\t    broker: Any\n277\t    39\t    extractor: Any = None\n278\t    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n279\t    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n280\t    42\t\n281\t    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n282\t    44\t        return self._budgets[ident.run_id]\n283\t    45\t\n284\t    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n285\t    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n286\t    48\t\n287\t    49\t    def erp_scope_for(self, operation: str) -> str:\n288\t    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n289\t    51\t        return scopes.get(operation, \"erp.read\")\n290\t    52\t\n291\t    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n292\t    54\t        self._contexts[ident.agent_instance_id] = ctx\n293\t    55\t        proposed = await audit.record(\n294\t    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n295\t    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n296\t    58\t        )\n297\t    59\t        tool = registry.get(use.name)\n298\t    60\t        if tool is None:\n299\t    61\t            await audit.record(\n300\t    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n301\t    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n302\t    64\t            )\n303\t    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n304\t    66\t\n305\t    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n306\t    68\t        authz = await audit.record(\n307\t    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n308\t    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n309\t    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n310\t    72\t        )\n311\t    73\t        if not decision.allow:\n312\t    74\t            if decision.pending:\n313\t    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n314\t    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n315\t    77\t\n316\t    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n317\t    79\t        try:\n318\t    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n319\t    81\t                for k, v in ctx.otel_attributes().items():\n320\t    82\t                    span.set_attribute(k, v)\n321\t    83\t                output = await tool.invoke(use.input, ident)\n322\t    84\t        except BudgetExceeded:\n323\t    85\t            raise\n324\t    86\t        except Exception as exc:\n325\t    87\t            await audit.record(\n326\t    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n327\t    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n328\t    90\t                operation_id=operation_id,\n329\t    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n330\t    92\t            )\n331\t    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n332\t    94\t\n333\t    95\t        await audit.record(\n334\t    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n335\t    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n336\t    98\t            operation_id=operation_id,\n337\t    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n338\t   100\t        )\n339\t   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n340\t   102\t\n341\t   103\t\n342\t   104\tdef _error(tool_use_id: str, message: str) -> dict:\n343\t   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n344\t   106\t\n345\t   107\t\n346\t   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n347\t   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n348\t   110\t        return messages, False\n349\t   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n350\t   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n351\t   113\t        tail = tail[1:]\n352\t   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n353\t   115\t    return head + [note] + tail, True\n354\t   116\t\n355\t   117\t\n356\t   118\tclass ProcurementAgent:\n357\t   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n358\t   120\t        self.client = client\n359\t   121\t        self.deps = deps\n360\t   122\t        self.system_prompt = system_prompt\n361\t   123\t        self.role = role\n362\t   124\t\n363\t   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n364\t   126\t        pool = self.deps.pool\n365\t   127\t        await killswitch.assert_running(pool, ident.tenant)\n366\t   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n367\t   129\t        await budget.reserve_run_start(pool)\n368\t   130\t        self.deps._budgets[ident.run_id] = budget\n369\t   131\t        registry = build_registry(self.role, ident, self.deps)\n370\t   132\t\n371\t   133\t        run_node = await audit.record(\n372\t   134\t            pool, ident, kind=\"run_started\",\n373\t   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n374\t   136\t        )\n375\t   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n376\t   138\t        try:\n377\t   139\t            while True:\n378\t   140\t                budget.check_step()\n379\t   141\t                messages, compacted = _compact(messages)\n380\t   142\t                request = {\n381\t   143\t                    \"model\": self.deps.settings.model_id,\n382\t   144\t                    \"system\": self.system_prompt,\n383\t   145\t                    \"messages\": messages,\n384\t   146\t                    \"tools\": registry.schemas(),\n385\t   147\t                    \"max_tokens\": 4096,\n386\t   148\t                }\n387\t   149\t                ctx = await measure_context(self.client, request, compacted)\n388\t   150\t                response = await self.client.messages.create(**request)\n389\t   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n390\t   152\t                await budget.flush(pool)\n391\t   153\t                ctx = ctx.finalize(response.usage)\n392\t   154\t                decision = await audit.record(\n393\t   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n394\t   156\t                    payload={\n395\t   157\t                        \"requested_model\": request[\"model\"],\n396\t   158\t                        \"served_model\": response.model,\n397\t   159\t                        \"stop_reason\": response.stop_reason,\n398\t   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n399\t   161\t                    },\n400\t   162\t                )\n401\t   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n402\t   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n403\t   165\t                if not uses:\n404\t   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n405\t   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n406\t   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n407\t   169\t                    return final\n408\t   170\t                results = []\n409\t   171\t                for use in uses:\n410\t   172\t                    budget.check_tool_call()\n411\t   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n412\t   174\t                messages.append({\"role\": \"user\", \"content\": results})\n413\t   175\t        except BudgetExceeded as exc:\n414\t   176\t            await audit.record(\n415\t   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n416\t   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n417\t   179\t            )\n418\t   180\t            await self.deps.slack.post(\n419\t   181\t                channel=\"#procurement-agent-ops\",\n420\t   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n421\t   183\t            )\n422\t   184\t            return None\n423\t   185\t        finally:\n424\t   186\t            self.deps._budgets.pop(ident.run_id, None)\n425\t=== app/extractor.py\n426\t     1\t\"\"\"Line-item extraction sub-agent.\n427\t     2\t\n428\t     3\tThe parent procurement agent delegates structured extraction to a smaller\n429\t     4\tmodel. The child runs under its own instance id, links to its parent in the\n430\t     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n431\t     6\t\"\"\"\n432\t     7\tfrom __future__ import annotations\n433\t     8\t\n434\t     9\timport json\n435\t    10\timport logging\n436\t    11\tfrom typing import Any\n437\t    12\t\n438\t    13\tfrom opentelemetry import trace\n439\t    14\t\n440\t    15\tfrom app import audit\n441\t    16\tfrom app.budget import Budget\n442\t    17\tfrom app.context_size import measure_context\n443\t    18\tfrom app.identity import RunIdentity\n444\t    19\tfrom app.redact import redact_for_model\n445\t    20\tfrom app.tools import build_registry\n446\t    21\t\n447\t    22\tlog = logging.getLogger(__name__)\n448\t    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n449\t    24\t\n450\t    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n451\t    26\tMAX_TURNS = 4\n452\t    27\t\n453\t    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n454\t    29\t\n455\t    30\t\n456\t    31\tclass ExtractionFailed(Exception):\n457\t    32\t    pass\n458\t    33\t\n459\t    34\t\n460\t    35\tclass LineItemExtractor:\n461\t    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n462\t    37\t        self.client = client\n463\t    38\t        self.settings = settings\n464\t    39\t        self.deps = deps\n465\t    40\t        self.system_prompt = system_prompt\n466\t    41\t\n467\t    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n468\t    43\t        budget.check_subagent()\n469\t    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n470\t    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n471\t    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n472\t    47\t\n473\t    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n474\t    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n475\t    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n476\t    51\t            start_node = await audit.record(\n477\t    52\t                self.deps.pool,\n478\t    53\t                ident,\n479\t    54\t                kind=\"subagent_started\",\n480\t    55\t                payload={\n481\t    56\t                    \"role\": EXTRACTOR_ROLE,\n482\t    57\t                    \"doc_id\": doc_id,\n483\t    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n484\t    59\t                    \"tools\": registry.names(),\n485\t    60\t                },\n486\t    61\t            )\n487\t    62\t\n488\t    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n489\t    64\t            for _turn in range(MAX_TURNS):\n490\t    65\t                budget.check_step()\n491\t    66\t                request = {\n492\t    67\t                    \"model\": self.settings.extractor_model_id,\n493\t    68\t                    \"system\": self.system_prompt,\n494\t    69\t                    \"messages\": messages,\n495\t    70\t                    \"tools\": registry.schemas(),\n496\t    71\t                    \"max_tokens\": 4096,\n497\t    72\t                }\n498\t    73\t                ctx = await measure_context(self.client, request, compacted=False)\n499\t    74\t                response = await self.client.messages.create(**request)\n500\t    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n501\t    76\t                await budget.flush(self.deps.pool)\n502\t    77\t                ctx = ctx.finalize(response.usage)\n503\t    78\t                decision = await audit.record(\n504\t    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n505\t    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n506\t    81\t                             \"stop_reason\": response.stop_reason},\n507\t    82\t                )\n508\t    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n509\t    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n510\t    85\t                if not uses:\n511\t    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n512\t    87\t                    items = _parse_items(text)\n513\t    88\t                    await audit.record(\n514\t    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n515\t    90\t                        payload={\"items\": len(items)},\n516\t    91\t                    )\n517\t    92\t                    return items\n518\t    93\t                results = []\n519\t    94\t                for use in uses:\n520\t    95\t                    budget.check_tool_call()\n521\t    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n522\t    97\t                messages.append({\"role\": \"user\", \"content\": results})\n523\t    98\t\n524\t    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n525\t   100\t\n526\t   101\t\n527\t   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n528\t   103\t    try:\n529\t   104\t        data = json.loads(text)\n530\t   105\t    except json.JSONDecodeError as exc:\n531\t   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n532\t   107\t    if not isinstance(data, list) or len(data) > 500:\n533\t   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n534\t   109\t    items = []\n535\t   110\t    for raw in data:\n536\t   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n537\t   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n538\t   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n539\t   114\t    return items\n540\t=== app/mcp_client.py\n541\t     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n542\t     2\t\n543\t     3\tOn startup the tool list is fetched and each tool's description and input\n544\t     4\tschema are fingerprinted and compared with the pins in the release manifest.\n545\t     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n546\t     6\tinstruction-like content before any of it is shown to the model.\n547\t     7\t\"\"\"\n548\t     8\tfrom __future__ import annotations\n549\t     9\t\n550\t    10\timport hashlib\n551\t    11\timport json\n552\t    12\timport logging\n553\t    13\timport re\n554\t    14\timport uuid\n555\t    15\tfrom typing import Any\n556\t    16\t\n557\t    17\timport httpx\n558\t    18\t\n559\t    19\tfrom app.identity import RunIdentity, TokenBroker\n560\t    20\tfrom app.redact import redact_text\n561\t    21\t\n562\t    22\tlog = logging.getLogger(__name__)\n563\t    23\t\n564\t    24\tMAX_DESCRIPTION_CHARS = 1024\n565\t    25\tSUSPICIOUS_METADATA = [\n566\t    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n567\t    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n568\t    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n569\t    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n570\t    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n571\t    31\t]\n572\t    32\t\n573\t    33\t\n574\t    34\tclass ToolPinMismatch(Exception):\n575\t    35\t    pass\n576\t    36\t\n577\t    37\t\n578\t    38\tclass UnknownErpOperation(Exception):\n579\t    39\t    pass\n580\t    40\t\n581\t    41\t\n582\t    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n583\t    43\t    material = {\n584\t    44\t        \"name\": tool[\"name\"],\n585\t    45\t        \"description\": tool.get(\"description\", \"\"),\n586\t    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n587\t    47\t        \"annotations\": tool.get(\"annotations\", {}),\n588\t    48\t    }\n589\t    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n590\t    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n591\t    51\t\n592\t    52\t\n593\t    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n594\t    54\t    description = tool.get(\"description\", \"\")\n595\t    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n596\t    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n597\t    57\t    blob = json.dumps(tool, ensure_ascii=False)\n598\t    58\t    for pattern in SUSPICIOUS_METADATA:\n599\t    59\t        if pattern.search(blob):\n600\t    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n601\t    61\t\n602\t    62\t\n603\t    63\tclass ErpMcpClient:\n604\t    64\t    AUDIENCE = \"erp-mcp-gateway\"\n605\t    65\t\n606\t    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n607\t    67\t        self.url = url\n608\t    68\t        self.pins = pins\n609\t    69\t        self.broker = broker\n610\t    70\t        self._tools: dict[str, dict[str, Any]] = {}\n611\t    71\t\n612\t    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n613\t    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n614\t    74\t            resp = await client.post(\n615\t    75\t                self.url,\n616\t    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n617\t    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n618\t    78\t            )\n619\t    79\t        resp.raise_for_status()\n620\t    80\t        if len(resp.content) > 512_000:\n621\t    81\t            raise ValueError(\"erp response too large\")\n622\t    82\t        body = resp.json()\n623\t    83\t        if \"error\" in body:\n624\t    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n625\t    85\t        return body[\"result\"]\n626\t    86\t\n627\t    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n628\t    88\t        result = await self._rpc(\"tools/list\", {}, token)\n629\t    89\t        return list(result.get(\"tools\", []))\n630\t    90\t\n631\t    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n632\t    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n633\t    93\t        tools = await self._list_tools(token)\n634\t    94\t        for tool in tools:\n635\t    95\t            expected = self.pins.get(tool[\"name\"])\n636\t    96\t            actual = fingerprint(tool)\n637\t    97\t            if expected != actual:\n638\t    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n639\t    99\t            scan_metadata(tool)\n640\t   100\t        self._tools = {t[\"name\"]: t for t in tools}\n641\t   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n642\t   102\t\n643\t   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n644\t   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n645\t   105\t            await self.refresh_tools(service_ident)\n646\t   106\t\n647\t   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n648\t   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n649\t   109\t        tools = await self._list_tools(token)\n650\t   110\t        self._tools = {t[\"name\"]: t for t in tools}\n651\t   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n652\t   112\t\n653\t   113\t    def operations(self) -> list[str]:\n654\t   114\t        return sorted(self._tools)\n655\t   115\t\n656\t   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n657\t   117\t        if operation not in self._tools:\n658\t   118\t            raise UnknownErpOperation(operation)\n659\t   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n660\t   120\t        result = await self._rpc(\n661\t   121\t            \"tools/call\",\n662\t   122\t            {\n663\t   123\t                \"name\": operation,\n664\t   124\t                \"arguments\": arguments,\n665\t   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n666\t   126\t            },\n667\t   127\t            token,\n668\t   128\t        )\n669\t   129\t        if result.get(\"isError\"):\n670\t   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n671\t   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n672\t=== app/settings.py\n673\t     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n674\t     2\tfrom __future__ import annotations\n675\t     3\t\n676\t     4\timport os\n677\t     5\tfrom dataclasses import dataclass\n678\t     6\tfrom functools import lru_cache\n679\t     7\tfrom pathlib import Path\n680\t     8\t\n681\t     9\timport yaml\n682\t    10\t\n683\t    11\t\n684\t    12\tdef _env(name: str, default: str | None = None) -> str:\n685\t    13\t    value = os.environ.get(name, default)\n686\t    14\t    if value is None:\n687\t    15\t        raise RuntimeError(f\"missing required setting {name}\")\n688\t    16\t    return value\n689\t    17\t\n690\t    18\t\n691\t    19\t@dataclass(frozen=True)\n692\t    20\tclass Settings:\n693\t    21\t    database_url: str\n694\t    22\t    erp_mcp_url: str\n695\t    23\t    payments_api_url: str\n696\t    24\t    slack_api_url: str\n697\t    25\t    sts_url: str\n698\t    26\t    oidc_issuer: str\n699\t    27\t    oidc_audience: str\n700\t    28\t    oidc_jwks_url: str\n701\t    29\t    workload_token_path: str\n702\t    30\t    slack_signing_secret_path: str\n703\t    31\t    mail_gateway_hmac_path: str\n704\t    32\t    model_id: str\n705\t    33\t    extractor_model_id: str\n706\t    34\t    manifest_path: Path\n707\t    35\t    prompt_dir: Path\n708\t    36\t    policy_path: Path\n709\t    37\t    tools_path: Path\n710\t    38\t    operational_owner: str\n711\t    39\t    image_digest: str\n712\t    40\t\n713\t    41\t    @property\n714\t    42\t    def policy(self) -> dict:\n715\t    43\t        return _load_yaml(self.policy_path)\n716\t    44\t\n717\t    45\t    @property\n718\t    46\t    def manifest(self) -> dict:\n719\t    47\t        return _load_yaml(self.manifest_path)\n720\t    48\t\n721\t    49\t    @property\n722\t    50\t    def budgets(self) -> dict:\n723\t    51\t        return self.policy[\"budgets\"]\n724\t    52\t\n725\t    53\t\n726\t    54\tdef _load_yaml(path: Path) -> dict:\n727\t    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n728\t    56\t        return yaml.safe_load(fh)\n729\t    57\t\n730\t    58\t\n731\t    59\t@lru_cache(maxsize=1)\n732\t    60\tdef get_settings() -> Settings:\n733\t    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n734\t    62\t    return Settings(\n735\t    63\t        database_url=_env(\"DATABASE_URL\"),\n736\t    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n737\t    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n738\t    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n739\t    67\t        sts_url=_env(\"STS_URL\"),\n740\t    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n741\t    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n742\t    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n743\t    71\t        workload_token_path=_env(\n744\t    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n745\t    73\t        ),\n746\t    74\t        slack_signing_secret_path=_env(\n747\t    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n748\t    76\t        ),\n749\t    77\t        mail_gateway_hmac_path=_env(\n750\t    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n751\t    79\t        ),\n752\t    80\t        model_id=_env(\"MODEL_ID\"),\n753\t    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n754\t    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n755\t    83\t        prompt_dir=root / \"prompts\",\n756\t    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n757\t    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n758\t    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n759\t    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n760\t    88\t    )\n761\t=== app/startup.py\n762\t     1\t\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\n763\t     2\tfrom __future__ import annotations\n764\t     3\t\n765\t     4\timport hashlib\n766\t     5\timport logging\n767\t     6\tfrom pathlib import Path\n768\t     7\t\n769\t     8\tfrom app.identity import compute_agent_type_id\n770\t     9\tfrom app.settings import Settings\n771\t    10\t\n772\t    11\tlog = logging.getLogger(__name__)\n773\t    12\t\n774\t    13\t\n775\t    14\tdef sha256_file(path: Path) -> str:\n776\t    15\t    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n777\t    16\t\n778\t    17\t\n779\t    18\tdef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n780\t    19\t    mismatches: list[str] = []\n781\t    20\t    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n782\t    21\t        mismatches.append(f\"image: running {settings.image_digest}\")\n783\t    22\t    for name, entry in manifest[\"prompts\"].items():\n784\t    23\t        path = settings.prompt_dir / Path(entry[\"path\"]).name\n785\t    24\t        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n786\t    25\t            mismatches.append(f\"prompt:{name}\")\n787\t    26\t    for name in (\"policy\", \"tools\"):\n788\t    27\t        entry = manifest[\"config\"][name]\n789\t    28\t        path = settings.policy_path if name == \"policy\" else settings.tools_path\n790\t    29\t        if sha256_file(path) != entry[\"sha256\"]:\n791\t    30\t            mismatches.append(f\"config:{name}\")\n792\t    31\t    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n793\t    32\t        mismatches.append(\"model:primary\")\n794\t    33\t    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n795\t    34\t        mismatches.append(\"model:extractor\")\n796\t    35\t    return mismatches\n797\t    36\t\n798\t    37\t\n799\t    38\tdef startup_checks(settings: Settings) -> str:\n800\t    39\t    \"\"\"Return the agent-type-id for this process.\"\"\"\n801\t    40\t    manifest = settings.manifest\n802\t    41\t    mismatches = running_state_mismatches(settings, manifest)\n803\t    42\t    if mismatches:\n804\t    43\t        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n805\t    44\t    agent_type_id = compute_agent_type_id(manifest)\n806\t    45\t    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n807\t    46\t    return agent_type_id\n808\t=== app/killswitch.py\n809\t     1\t\"\"\"Operator stop control.\n810\t     2\t\n811\t     3\tOperators halt the fleet or one business unit by setting a row in\n812\t     4\t``control_flags`` with the ``procurement_ops`` database role (see\n813\t     5\tops/README in the platform runbook). The agent's own database role has\n814\t     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n815\t     7\t\"\"\"\n816\t     8\tfrom __future__ import annotations\n817\t     9\t\n818\t    10\t\n819\t    11\tclass AgentHalted(Exception):\n820\t    12\t    pass\n821\t    13\t\n822\t    14\t\n823\t    15\t_QUERY = \"\"\"\n824\t    16\tSELECT scope, reason, set_by, set_at\n825\t    17\tFROM control_flags\n826\t    18\tWHERE halted\n827\t    19\t  AND (scope = 'fleet' OR scope = $1)\n828\t    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n829\t    21\tLIMIT 1\n830\t    22\t\"\"\"\n831\t    23\t\n832\t    24\t\n833\t    25\tasync def assert_running(pool, tenant: str) -> None:\n834\t    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n835\t    27\t    if row is not None:\n836\t    28\t        raise AgentHalted(\n837\t    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n838\t    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n839\t    31\t        )\n840\t=== release/manifest.yaml\n841\t     1\t# Release manifest for the procurement agent. Regenerated by CI on every\n842\t     2\t# release build (see .github/workflows/ci.yaml, job \"release\").\n843\t     3\trelease: \"procurement-agent 2026.09.4\"\n844\t     4\towner: team-procurement-platform\n845\t     5\t\n846\t     6\timage:\n847\t     7\t  repository: registry.example-corp.test/procurement/agent\n848\t     8\t  digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n849\t     9\t  sbom: \"registry.example-corp.test/procurement/agent:sha256-7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0.sbom\"\n850\t    10\t  signer:\n851\t    11\t    issuer: \"https://token.actions.githubusercontent.com\"\n852\t    12\t    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n853\t    13\t\n854\t    14\tharness:\n855\t    15\t  source_commit: \"3f9a1c7e2b8d4f6a0c5e9b1d7f3a8c2e6b4d0f91\"\n856\t    16\t  digest: \"sha256:5b2d8f1a9c3e7b0d4f6a2c8e1b5d9f3a7c0e4b8d2f6a1c5e9b3d7f0a4c8e2b6d\"\n857\t    17\t\n858\t    18\tprompts:\n859\t    19\t  system:\n860\t    20\t    path: prompts/system.md\n861\t    21\t    sha256: \"sha256:dcf69216667e65a0be3711d99aac81b707ba843296e7ce26d6fcbdb50c5bcc50\"\n862\t    22\t  extractor:\n863\t    23\t    path: prompts/extractor.md\n864\t    24\t    sha256: \"sha256:6ef6527b77ffcca8851e7a8760e6373f3daede15d5b343b878737f0deec28de3\"\n865\t    25\t\n866\t    26\tconfig:\n867\t    27\t  policy:\n868\t    28\t    path: config/policy.yaml\n869\t    29\t    version: \"proc-policy-2026.09.3\"\n870\t    30\t    sha256: \"sha256:d6a55f1e170bdd457958243ddd9aa938f4ca707a3e1e9d1e7bca2a54df33ad32\"\n871\t    31\t  tools:\n872\t    32\t    path: config/tools.yaml\n873\t    33\t    sha256: \"sha256:86dccc3d7d166bf8e131c3b2afbe5f2b846a57eaaf087b55f9e308844eda9400\"\n874\t    34\t  network_policy: deploy/k8s/networkpolicy.yaml\n875\t    35\t  image_policy: deploy/k8s/kyverno-verify-images.yaml\n876\t    36\t\n877\t    37\tmodels:\n878\t    38\t  primary:\n879\t    39\t    role: \"main agent\"\n880\t    40\t    owner: team-procurement-platform\n881\t    41\t    provider: anthropic\n882\t    42\t    model_id: \"claude-sonnet-4-5-20250929\"\n883\t    43\t    id_kind: \"pinned snapshot\"\n884\t    44\t    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n885\t    45\t    adapter: none\n886\t    46\t    fine_tune: none\n887\t    47\t    training_run: \"not applicable\"\n888\t    48\t    served_version: \"recorded per call from response.model\"\n889\t    49\t    provider_undisclosed: [weights digest, pretraining data version]\n890\t    50\t  extractor:\n891\t    51\t    role: \"line-item extraction sub-agent\"\n892\t    52\t    owner: team-procurement-platform\n893\t    53\t    provider: anthropic\n894\t    54\t    model_id: \"claude-haiku-4-5-20251001\"\n895\t    55\t    id_kind: \"pinned snapshot\"\n896\t    56\t    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n897\t    57\t    adapter: none\n898\t    58\t    fine_tune: none\n899\t    59\t    training_run: \"not applicable\"\n900\t    60\t    served_version: \"recorded per call from response.model\"\n901\t    61\t    provider_undisclosed: [weights digest, pretraining data version]\n902\t    62\t\n903\t    63\tmcp_servers:\n904\t    64\t  erp:\n905\t    65\t    endpoint: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n906\t    66\t    owner: team-erp-integrations\n907\t    67\t\n908\t    68\t# Fingerprints of the approved ERP MCP tools (name, description, inputSchema,\n909\t    69\t# annotations), computed by app.mcp_client.fingerprint.\n910\t    70\ttool_pins:\n911\t    71\t  budget.get_remaining: \"sha256:bc96af69ba1cfd67b5428269dc74aa3e754f4dfe2d5dfa81deb0af68819379ca\"\n912\t    72\t  vendor.get: \"sha256:7db5e65fb6d482d06985b19b7f1fce7422398b117bc7482f0380108cd6a6a1fe\"\n913\t    73\t  vendor.search: \"sha256:3bd5aa0908885e967ce8ee1aa22e37b4f4fba867c8eac2b4127bca626731092c\"\n914\t    74\t  vendor.update_remit_to: \"sha256:d3d3916ee6d742311c92f4972a1ffeb0f24782e729351f3e375f13eb05b94c1b\"\n915\t    75\t  invoice.get: \"sha256:848ece38456338a085cb7091a2bbf1024e07946d62beb32a9ee94d2fa2fa8876\"\n916\t    76\t  invoice.list_open: \"sha256:12bb2318f3876da6421183032cdd36727e545275e8eaf6fff66451d09371f12b\"\n917\t    77\t  invoice.mark_paid: \"sha256:3a208eb55ee3a39962316b5d25fe6ba23457380c01aa39a5469ce3691130b05a\"\n918\t    78\t  invoice.void: \"sha256:9645bec805f2ffdfa44f698f49e8701a6487afa3cb3e3c5c44e721cb21633d4c\"\n919\t    79\t  po.get: \"sha256:121df83a279fc2ae3764c83faeb34f3037026586991c9192144ad7b727d18d7b\"\n920\t    80\t  po.list_open: \"sha256:203c57fd158a8edf11b8dc02be534bc805d8caaf0959db8280f59ea0e5beb70a\"\n921\t    81\t  po.create: \"sha256:fb15c157f7d79321972b310d74ee6c88a0fc76fd8edbbe4e821dcaa95a0852c6\"\n922\t    82\t\n923\t    83\tbudgets: config/policy.yaml#budgets\n924\t    84\tidentity:\n925\t    85\t  service_account: procurement-agent\n926\t    86\t  spiffe_id: \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n927\t    87\t  sts_audiences: [erp-mcp-gateway, payments-api, slack-proxy]\n928\t    88\tmemory:\n929\t    89\t  store: \"postgres procurement.dept_notes\"\n930\t    90\t  expiry_unverified_days: 30\n931\t    91\tretrieval: none\n932\t"}]},"parent_tool_use_id":null,"session_id":"a772fce6-3235-4ab2-ba24-c62b009a560f","uuid":"3d5feeb4-2edd-4376-bfcd-fd0ef50d248b","timestamp":"2026-10-20T13:21:08.366Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-nos5y33x/a772fce6-3235-4ab2-ba24-c62b009a560f/tool-results/bjzh7esnn.txt","content":"=== app/audit.py\n     1\t\"\"\"Execution audit graph.\n     2\t\n     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n     5\ttool call -> authorization decision -> result or error. Writes are\n     6\tsynchronous and are made before the action they describe; if the write\n     7\tfails, the caller raises and the action does not run.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport hashlib\n    12\timport json\n    13\timport uuid\n    14\tfrom datetime import datetime, timezone\n    15\tfrom typing import Any\n    16\t\n    17\tfrom opentelemetry import trace\n    18\t\n    19\tfrom app.context_size import ContextMeasure\n    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n    21\tfrom app.redact import redact_value\n    22\t\n    23\tEVENT_KINDS = {\n    24\t    \"run_started\",\n    25\t    \"run_finished\",\n    26\t    \"run_halted\",\n    27\t    \"model_decision\",\n    28\t    \"tool_proposed\",\n    29\t    \"authz_decision\",\n    30\t    \"approval_requested\",\n    31\t    \"approval_decided\",\n    32\t    \"tool_result\",\n    33\t    \"tool_error\",\n    34\t    \"tool_denied\",\n    35\t    \"budget_exceeded\",\n    36\t    \"subagent_started\",\n    37\t    \"subagent_finished\",\n    38\t    \"background_job\",\n    39\t}\n    40\t\n    41\t_INSERT = \"\"\"\n    42\tINSERT INTO audit_events (\n    43\t    node_id, parent_node_id, run_id, ts, kind,\n    44\t    accountable_party, operational_owner, tenant,\n    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n    46\t    delegated_subject, agent_principal, parent_instance_id,\n    47\t    policy_version, approval_id, operation_id,\n    48\t    context_tokens, context_method, context_compacted,\n    49\t    payload\n    50\t) VALUES (\n    51\t    $1, $2, $3, $4, $5,\n    52\t    $6, $7, $8,\n    53\t    $9, $10, $11, $12,\n    54\t    $13, $14, $15,\n    55\t    $16, $17, $18,\n    56\t    $19, $20, $21,\n    57\t    $22::jsonb\n    58\t)\n    59\t\"\"\"\n    60\t\n    61\t\n    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n    64\t    return {k: redact_value(v) for k, v in args.items()}\n    65\t\n    66\t\n    67\tdef digest(value: Any) -> str:\n    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    70\t\n    71\t\n    72\tasync def record(\n    73\t    pool,\n    74\t    ident: RunIdentity,\n    75\t    *,\n    76\t    kind: str,\n    77\t    payload: dict[str, Any] | None = None,\n    78\t    parent: str | None = None,\n    79\t    context: ContextMeasure | None = None,\n    80\t    policy_version: str | None = None,\n    81\t    approval_id: str | None = None,\n    82\t    operation_id: str | None = None,\n    83\t) -> str:\n    84\t    if kind not in EVENT_KINDS:\n    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n    86\t    for name in IDENTITY_FIELDS:\n    87\t        if not getattr(ident, name):\n    88\t            raise ValueError(f\"audit record missing {name}\")\n    89\t    span_ctx = trace.get_current_span().get_span_context()\n    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n    91\t    node_id = f\"node-{uuid.uuid4()}\"\n    92\t    measure = context or ContextMeasure.unavailable()\n    93\t    await pool.execute(\n    94\t        _INSERT,\n    95\t        node_id,\n    96\t        parent,\n    97\t        ident.run_id,\n    98\t        datetime.now(timezone.utc),\n    99\t        kind,\n   100\t        ident.accountable_party,\n   101\t        ident.operational_owner,\n   102\t        ident.tenant,\n   103\t        ident.agent_type_id,\n   104\t        ident.agent_instance_id,\n   105\t        ident.trace_id,\n   106\t        span_id,\n   107\t        ident.delegated_subject,\n   108\t        ident.agent_principal,\n   109\t        ident.parent_instance_id,\n   110\t        policy_version,\n   111\t        approval_id,\n   112\t        operation_id,\n   113\t        measure.tokens,\n   114\t        measure.method,\n   115\t        measure.compacted,\n   116\t        json.dumps(redact_value(payload or {}), default=str),\n   117\t    )\n   118\t    return node_id\n=== app/identity.py\n     1\t\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n     2\t\n     3\tThe agent runs under its own Kubernetes service account. Its projected\n     4\tservice-account token is exchanged at the internal STS for short-lived,\n     5\taudience-bound tokens. The launching user's token is never forwarded to an\n     6\tintegration; the user is carried as the delegated subject of the exchange.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport time\n    13\timport uuid\n    14\tfrom dataclasses import dataclass, field, replace\n    15\tfrom pathlib import Path\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.settings import Settings\n    20\t\n    21\tIDENTITY_FIELDS = (\n    22\t    \"accountable_party\",\n    23\t    \"operational_owner\",\n    24\t    \"tenant\",\n    25\t    \"agent_type_id\",\n    26\t    \"agent_instance_id\",\n    27\t    \"trace_id\",\n    28\t)\n    29\t\n    30\t\n    31\t@dataclass(frozen=True)\n    32\tclass RunIdentity:\n    33\t    accountable_party: str\n    34\t    operational_owner: str\n    35\t    tenant: str\n    36\t    agent_type_id: str\n    37\t    agent_instance_id: str\n    38\t    trace_id: str\n    39\t    run_id: str\n    40\t    delegated_subject: str\n    41\t    agent_principal: str\n    42\t    parent_instance_id: str | None = None\n    43\t    role: str = \"procurement\"\n    44\t\n    45\t    def __post_init__(self) -> None:\n    46\t        for name in IDENTITY_FIELDS:\n    47\t            if not getattr(self, name):\n    48\t                raise ValueError(f\"identity field {name} is empty\")\n    49\t\n    50\t    def child(self, role: str) -> \"RunIdentity\":\n    51\t        return replace(\n    52\t            self,\n    53\t            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n    54\t            parent_instance_id=self.agent_instance_id,\n    55\t            role=role,\n    56\t        )\n    57\t\n    58\t\n    59\tdef new_instance_id() -> str:\n    60\t    return f\"inst-{uuid.uuid4()}\"\n    61\t\n    62\t\n    63\tdef compute_agent_type_id(manifest: dict) -> str:\n    64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    65\t    material = {\n    66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n    67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n    68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n    69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n    70\t        \"models\": manifest[\"models\"],\n    71\t        \"config\": manifest[\"config\"],\n    72\t        \"tools\": manifest[\"tool_pins\"],\n    73\t    }\n    74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n    76\t\n    77\t\n    78\t@dataclass\n    79\tclass _CachedToken:\n    80\t    value: str\n    81\t    expires_at: float\n    82\t\n    83\t\n    84\t@dataclass\n    85\tclass TokenBroker:\n    86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n    87\t\n    88\t    settings: Settings\n    89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n    90\t\n    91\t    def _workload_token(self) -> str:\n    92\t        return Path(self.settings.workload_token_path).read_text().strip()\n    93\t\n    94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n    95\t        key = (audience, scope, ident.tenant)\n    96\t        cached = self._cache.get(key)\n    97\t        if cached and cached.expires_at - 30 > time.time():\n    98\t            return cached.value\n    99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n   100\t            resp = await client.post(\n   101\t                self.settings.sts_url,\n   102\t                data={\n   103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n   104\t                    \"subject_token\": self._workload_token(),\n   105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n   106\t                    \"audience\": audience,\n   107\t                    \"scope\": scope,\n   108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n   109\t                    \"actor_token\": ident.delegated_subject,\n   110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n   111\t                },\n   112\t            )\n   113\t            resp.raise_for_status()\n   114\t            body = resp.json()\n   115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n   116\t        self._cache[key] = token\n   117\t        return token.value\n=== app/loop.py\n     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n=== app/extractor.py\n     1\t\"\"\"Line-item extraction sub-agent.\n     2\t\n     3\tThe parent procurement agent delegates structured extraction to a smaller\n     4\tmodel. The child runs under its own instance id, links to its parent in the\n     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport json\n    10\timport logging\n    11\tfrom typing import Any\n    12\t\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom app import audit\n    16\tfrom app.budget import Budget\n    17\tfrom app.context_size import measure_context\n    18\tfrom app.identity import RunIdentity\n    19\tfrom app.redact import redact_for_model\n    20\tfrom app.tools import build_registry\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n    24\t\n    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n    26\tMAX_TURNS = 4\n    27\t\n    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n    29\t\n    30\t\n    31\tclass ExtractionFailed(Exception):\n    32\t    pass\n    33\t\n    34\t\n    35\tclass LineItemExtractor:\n    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n    37\t        self.client = client\n    38\t        self.settings = settings\n    39\t        self.deps = deps\n    40\t        self.system_prompt = system_prompt\n    41\t\n    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n    43\t        budget.check_subagent()\n    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n    47\t\n    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n    51\t            start_node = await audit.record(\n    52\t                self.deps.pool,\n    53\t                ident,\n    54\t                kind=\"subagent_started\",\n    55\t                payload={\n    56\t                    \"role\": EXTRACTOR_ROLE,\n    57\t                    \"doc_id\": doc_id,\n    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n    59\t                    \"tools\": registry.names(),\n    60\t                },\n    61\t            )\n    62\t\n    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n    64\t            for _turn in range(MAX_TURNS):\n    65\t                budget.check_step()\n    66\t                request = {\n    67\t                    \"model\": self.settings.extractor_model_id,\n    68\t                    \"system\": self.system_prompt,\n    69\t                    \"messages\": messages,\n    70\t                    \"tools\": registry.schemas(),\n    71\t                    \"max_tokens\": 4096,\n    72\t                }\n    73\t                ctx = await measure_context(self.client, request, compacted=False)\n    74\t                response = await self.client.messages.create(**request)\n    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n    76\t                await budget.flush(self.deps.pool)\n    77\t                ctx = ctx.finalize(response.usage)\n    78\t                decision = await audit.record(\n    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n    81\t                             \"stop_reason\": response.stop_reason},\n    82\t                )\n    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n    85\t                if not uses:\n    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n    87\t                    items = _parse_items(text)\n    88\t                    await audit.record(\n    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n    90\t                        payload={\"items\": len(items)},\n    91\t                    )\n    92\t                    return items\n    93\t                results = []\n    94\t                for use in uses:\n    95\t                    budget.check_tool_call()\n    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n    97\t                messages.append({\"role\": \"user\", \"content\": results})\n    98\t\n    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n   100\t\n   101\t\n   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n   103\t    try:\n   104\t        data = json.loads(text)\n   105\t    except json.JSONDecodeError as exc:\n   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n   107\t    if not isinstance(data, list) or len(data) > 500:\n   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n   109\t    items = []\n   110\t    for raw in data:\n   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n   114\t    return items\n=== app/mcp_client.py\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n=== app/settings.py\n     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t\n    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )\n=== app/startup.py\n     1\t\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\timport logging\n     6\tfrom pathlib import Path\n     7\t\n     8\tfrom app.identity import compute_agent_type_id\n     9\tfrom app.settings import Settings\n    10\t\n    11\tlog = logging.getLogger(__name__)\n    12\t\n    13\t\n    14\tdef sha256_file(path: Path) -> str:\n    15\t    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n    16\t\n    17\t\n    18\tdef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n    19\t    mismatches: list[str] = []\n    20\t    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n    21\t        mismatches.append(f\"image: running {settings.image_digest}\")\n    22\t    for name, entry in manifest[\"prompts\"].items():\n    23\t        path = settings.prompt_dir / Path(entry[\"path\"]).name\n    24\t        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n    25\t            mismatches.append(f\"prompt:{name}\")\n    26\t    for name in (\"policy\", \"tools\"):\n    27\t        entry = manifest[\"config\"][name]\n    28\t        path = settings.policy_path if name == \"policy\" else settings.tools_path\n    29\t        if sha256_file(path) != entry[\"sha256\"]:\n    30\t            mismatches.append(f\"config:{name}\")\n    31\t    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n    32\t        mismatches.append(\"model:primary\")\n    33\t    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n    34\t        mismatches.append(\"model:extractor\")\n    35\t    return mismatches\n    36\t\n    37\t\n    38\tdef startup_checks(settings: Settings) -> str:\n    39\t    \"\"\"Return the agent-type-id for this process.\"\"\"\n    40\t    manifest = settings.manifest\n    41\t    mismatches = running_state_mismatches(settings, manifest)\n    42\t    if mismatches:\n    43\t        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n    44\t    agent_type_id = compute_agent_type_id(manifest)\n    45\t    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n    46\t    return agent_type_id\n=== app/killswitch.py\n     1\t\"\"\"Operator stop control.\n     2\t\n     3\tOperators halt the fleet or one business unit by setting a row in\n     4\t``control_flags`` with the ``procurement_ops`` database role (see\n     5\tops/README in the platform runbook). The agent's own database role has\n     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\t\n    11\tclass AgentHalted(Exception):\n    12\t    pass\n    13\t\n    14\t\n    15\t_QUERY = \"\"\"\n    16\tSELECT scope, reason, set_by, set_at\n    17\tFROM control_flags\n    18\tWHERE halted\n    19\t  AND (scope = 'fleet' OR scope = $1)\n    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n    21\tLIMIT 1\n    22\t\"\"\"\n    23\t\n    24\t\n    25\tasync def assert_running(pool, tenant: str) -> None:\n    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n    27\t    if row is not None:\n    28\t        raise AgentHalted(\n    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n    31\t        )\n=== release/manifest.yaml\n     1\t# Release manifest for the procurement agent. Regenerated by CI on every\n     2\t# release build (see .github/workflows/ci.yaml, job \"release\").\n     3\trelease: \"procurement-agent 2026.09.4\"\n     4\towner: team-procurement-platform\n     5\t\n     6\timage:\n     7\t  repository: registry.example-corp.test/procurement/agent\n     8\t  digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n     9\t  sbom: \"registry.example-corp.test/procurement/agent:sha256-7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0.sbom\"\n    10\t  signer:\n    11\t    issuer: \"https://token.actions.githubusercontent.com\"\n    12\t    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    13\t\n    14\tharness:\n    15\t  source_commit: \"3f9a1c7e2b8d4f6a0c5e9b1d7f3a8c2e6b4d0f91\"\n    16\t  digest: \"sha256:5b2d8f1a9c3e7b0d4f6a2c8e1b5d9f3a7c0e4b8d2f6a1c5e9b3d7f0a4c8e2b6d\"\n    17\t\n    18\tprompts:\n    19\t  system:\n    20\t    path: prompts/system.md\n    21\t    sha256: \"sha256:dcf69216667e65a0be3711d99aac81b707ba843296e7ce26d6fcbdb50c5bcc50\"\n    22\t  extractor:\n    23\t    path: prompts/extractor.md\n    24\t    sha256: \"sha256:6ef6527b77ffcca8851e7a8760e6373f3daede15d5b343b878737f0deec28de3\"\n    25\t\n    26\tconfig:\n    27\t  policy:\n    28\t    path: config/policy.yaml\n    29\t    version: \"proc-policy-2026.09.3\"\n    30\t    sha256: \"sha256:d6a55f1e170bdd457958243ddd9aa938f4ca707a3e1e9d1e7bca2a54df33ad32\"\n    31\t  tools:\n    32\t    path: config/tools.yaml\n    33\t    sha256: \"sha256:86dccc3d7d166bf8e131c3b2afbe5f2b846a57eaaf087b55f9e308844eda9400\"\n    34\t  network_policy: deploy/k8s/networkpolicy.yaml\n    35\t  image_policy: deploy/k8s/kyverno-verify-images.yaml\n    36\t\n    37\tmodels:\n    38\t  primary:\n    39\t    role: \"main agent\"\n    40\t    owner: team-procurement-platform\n    41\t    provider: anthropic\n    42\t    model_id: \"claude-sonnet-4-5-20250929\"\n    43\t    id_kind: \"pinned snapshot\"\n    44\t    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    45\t    adapter: none\n    46\t    fine_tune: none\n    47\t    training_run: \"not applicable\"\n    48\t    served_version: \"recorded per call from response.model\"\n    49\t    provider_undisclosed: [weights digest, pretraining data version]\n    50\t  extractor:\n    51\t    role: \"line-item extraction sub-agent\"\n    52\t    owner: team-procurement-platform\n    53\t    provider: anthropic\n    54\t    model_id: \"claude-haiku-4-5-20251001\"\n    55\t    id_kind: \"pinned snapshot\"\n    56\t    id_kind_source: \"Anthropic models overview, checked 2026-09-22\"\n    57\t    adapter: none\n    58\t    fine_tune: none\n    59\t    training_run: \"not applicable\"\n    60\t    served_version: \"recorded per call from response.model\"\n    61\t    provider_undisclosed: [weights digest, pretraining data version]\n    62\t\n    63\tmcp_servers:\n    64\t  erp:\n    65\t    endpoint: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    66\t    owner: team-erp-integrations\n    67\t\n    68\t# Fingerprints of the approved ERP MCP tools (name, description, inputSchema,\n    69\t# annotations), computed by app.mcp_client.fingerprint.\n    70\ttool_pins:\n    71\t  budget.get_remaining: \"sha256:bc96af69ba1cfd67b5428269dc74aa3e754f4dfe2d5dfa81deb0af68819379ca\"\n    72\t  vendor.get: \"sha256:7db5e65fb6d482d06985b19b7f1fce7422398b117bc7482f0380108cd6a6a1fe\"\n    73\t  vendor.search: \"sha256:3bd5aa0908885e967ce8ee1aa22e37b4f4fba867c8eac2b4127bca626731092c\"\n    74\t  vendor.update_remit_to: \"sha256:d3d3916ee6d742311c92f4972a1ffeb0f24782e729351f3e375f13eb05b94c1b\"\n    75\t  invoice.get: \"sha256:848ece38456338a085cb7091a2bbf1024e07946d62beb32a9ee94d2fa2fa8876\"\n    76\t  invoice.list_open: \"sha256:12bb2318f3876da6421183032cdd36727e545275e8eaf6fff66451d09371f12b\"\n    77\t  invoice.mark_paid: \"sha256:3a208eb55ee3a39962316b5d25fe6ba23457380c01aa39a5469ce3691130b05a\"\n    78\t  invoice.void: \"sha256:9645bec805f2ffdfa44f698f49e8701a6487afa3cb3e3c5c44e721cb21633d4c\"\n    79\t  po.get: \"sha256:121df83a279fc2ae3764c83faeb34f3037026586991c9192144ad7b727d18d7b\"\n    80\t  po.list_open: \"sha256:203c57fd158a8edf11b8dc02be534bc805d8caaf0959db8280f59ea0e5beb70a\"\n    81\t  po.create: \"sha256:fb15c157f7d79321972b310d74ee6c88a0fc76fd8edbbe4e821dcaa95a0852c6\"\n    82\t\n    83\tbudgets: config/policy.yaml#budgets\n    84\tidentity:\n    85\t  service_account: procurement-agent\n    86\t  spiffe_id: \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    87\t  sts_audiences: [erp-mcp-gateway, payments-api, slack-proxy]\n    88\tmemory:\n    89\t  store: \"postgres procurement.dept_notes\"\n    90\t  expiry_unverified_days: 30\n    91\tretrieval: none\n","numLines":932,"startLine":1,"totalLines":932}},"tool_result_meta":[{"id":"toolu_017j3XVSaZZhTiVhHjSEA1tU","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
