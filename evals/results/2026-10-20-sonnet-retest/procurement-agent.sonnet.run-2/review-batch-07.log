{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SgNpXH1CoDHnornAy6bV5f","type":"tool_result","content":"=== .github/workflows/ci.yaml\n     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    16\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    17\t        with:\n    18\t          python-version: \"3.11\"\n    19\t      - run: pip install -e '.[test]'\n    20\t      - run: pytest -q\n    21\t      - name: Secret scan\n    22\t        uses: gitleaks/gitleaks-action@83373cf2f8c4db6e24b41c1a9b086bb9619e9cd3 # v2.3.7\n    23\t      - name: Manifest hashes match files\n    24\t        run: |\n    25\t          python - <<'PY'\n    26\t          import hashlib, yaml, sys\n    27\t          m = yaml.safe_load(open(\"release/manifest.yaml\"))\n    28\t          bad = []\n    29\t          for group in (\"prompts\", \"config\"):\n    30\t              for name, e in m[group].items():\n    31\t                  if isinstance(e, dict) and \"sha256\" in e:\n    32\t                      got = \"sha256:\" + hashlib.sha256(open(e[\"path\"], \"rb\").read()).hexdigest()\n    33\t                      if got != e[\"sha256\"]:\n    34\t                          bad.append(e[\"path\"])\n    35\t          if bad:\n    36\t              sys.exit(\"manifest out of date: \" + \", \".join(bad))\n    37\t          PY\n    38\t\n    39\t  release:\n    40\t    if: github.ref == 'refs/heads/main'\n    41\t    needs: test\n    42\t    runs-on: ubuntu-24.04\n    43\t    permissions:\n    44\t      contents: read\n    45\t      id-token: write\n    46\t      packages: write\n    47\t      attestations: write\n    48\t    steps:\n    49\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    50\t      - uses: sigstore/cosign-installer@dc72c7d5c4d10cd6bcb8cf6e3fd625a9e5e537da # v3.7.0\n    51\t        with:\n    52\t          cosign-release: \"v2.6.2\"\n    53\t      - uses: docker/setup-buildx-action@c47758b77c9736f4b2ef4073d4d51994fabfe349 # v3.7.1\n    54\t      - uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0\n    55\t        with:\n    56\t          registry: registry.example-corp.test\n    57\t          username: ${{ github.actor }}\n    58\t          password: ${{ secrets.GITHUB_TOKEN }}\n    59\t      - id: build\n    60\t        uses: docker/build-push-action@4f58ea79222b3b9dc2c8bbdd6debcef730109a75 # v6.9.0\n    61\t        with:\n    62\t          context: .\n    63\t          push: true\n    64\t          tags: registry.example-corp.test/procurement/agent:${{ github.sha }}\n    65\t          provenance: false\n    66\t          sbom: false\n    67\t      - name: SBOM\n    68\t        uses: anchore/sbom-action@251a468eed47e5082b105c3ba6ee500c0e65a764 # v0.17.6\n    69\t        with:\n    70\t          image: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    71\t          format: cyclonedx-json\n    72\t          output-file: sbom.cdx.json\n    73\t      - name: Sign and attest\n    74\t        env:\n    75\t          IMAGE: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    76\t        run: |\n    77\t          cosign sign --yes \"$IMAGE\"\n    78\t          cosign attest --yes --type cyclonedx --predicate sbom.cdx.json \"$IMAGE\"\n    79\t      - uses: actions/attest-build-provenance@1c608d11d69870c2092266b3f9a6f3abbf17002c # v1.4.3\n    80\t        with:\n    81\t          subject-name: registry.example-corp.test/procurement/agent\n    82\t          subject-digest: ${{ steps.build.outputs.digest }}\n    83\t          push-to-registry: true\n=== app/main.py\n     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport hashlib\n     6\timport hmac\n     7\timport json\n     8\timport logging\n     9\timport time\n    10\timport uuid\n    11\tfrom contextlib import asynccontextmanager\n    12\tfrom pathlib import Path\n    13\tfrom urllib.parse import parse_qs\n    14\t\n    15\timport asyncpg\n    16\timport jwt\n    17\tfrom anthropic import AsyncAnthropic\n    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n    20\tfrom opentelemetry import trace\n    21\tfrom pydantic import BaseModel, Field\n    22\t\n    23\tfrom app import audit, ingest\n    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n    25\tfrom app.extractor import LineItemExtractor\n    26\tfrom app.gate import PolicyGate\n    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n    28\tfrom app.loop import AgentDeps, ProcurementAgent\n    29\tfrom app.mcp_client import ErpMcpClient\n    30\tfrom app.redact import RedactingFilter\n    31\tfrom app.settings import get_settings\n    32\tfrom app.startup import startup_checks\n    33\tfrom app.tools.slack import SlackClient\n    34\t\n    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n    36\tfor handler in logging.getLogger().handlers:\n    37\t    handler.addFilter(RedactingFilter())\n    38\tlog = logging.getLogger(\"procurement\")\n    39\t\n    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    41\tbearer = HTTPBearer()\n    42\t\n    43\t\n    44\tclass RunRequest(BaseModel):\n    45\t    task: str = Field(min_length=1, max_length=4000)\n    46\t    department: str = Field(min_length=1, max_length=64)\n    47\t\n    48\t\n    49\tclass Principal(BaseModel):\n    50\t    subject: str\n    51\t    business_unit: str\n    52\t\n    53\t\n    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    55\t    return RunIdentity(\n    56\t        accountable_party=\"system:procurement-agent\",\n    57\t        operational_owner=settings.operational_owner,\n    58\t        tenant=tenant,\n    59\t        agent_type_id=agent_type_id,\n    60\t        agent_instance_id=new_instance_id(),\n    61\t        trace_id=uuid.uuid4().hex,\n    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n    63\t        delegated_subject=\"system:procurement-agent\",\n    64\t        agent_principal=AGENT_PRINCIPAL,\n    65\t    )\n    66\t\n    67\t\n    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n    69\t    while True:\n    70\t        await asyncio.sleep(60)\n    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n    72\t        count = await app.state.pool.fetchval(\n    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n    75\t        )\n    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n    78\t\n    79\t\n    80\t@asynccontextmanager\n    81\tasync def lifespan(app: FastAPI):\n    82\t    settings = get_settings()\n    83\t    agent_type_id = startup_checks(settings)\n    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    85\t    broker = TokenBroker(settings)\n    86\t\n    87\t    async def slack_token() -> str:\n    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n    89\t\n    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n    92\t    gate = PolicyGate(settings.policy, approvals)\n    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n    95\t\n    96\t    client = AsyncAnthropic()\n    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    98\t    deps.extractor = LineItemExtractor(\n    99\t        client=client, settings=settings, deps=deps,\n   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n   101\t    )\n   102\t    app.state.settings = settings\n   103\t    app.state.pool = pool\n   104\t    app.state.agent_type_id = agent_type_id\n   105\t    app.state.approvals = approvals\n   106\t    app.state.agent = ProcurementAgent(\n   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n   108\t    )\n   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n   111\t    try:\n   112\t        yield\n   113\t    finally:\n   114\t        sweeper.cancel()\n   115\t        await pool.close()\n   116\t\n   117\t\n   118\tapp = FastAPI(lifespan=lifespan)\n   119\tapp.include_router(ingest.router)\n   120\t\n   121\t\n   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n   123\t    settings = request.app.state.settings\n   124\t    try:\n   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n   126\t        claims = jwt.decode(\n   127\t            creds.credentials,\n   128\t            key.key,\n   129\t            algorithms=[\"RS256\", \"ES256\"],\n   130\t            audience=settings.oidc_audience,\n   131\t            issuer=settings.oidc_issuer,\n   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n   133\t        )\n   134\t    except jwt.PyJWTError as exc:\n   135\t        raise HTTPException(401, \"invalid token\") from exc\n   136\t    bu = claims.get(\"bu\")\n   137\t    if not bu:\n   138\t        raise HTTPException(403, \"token has no business unit\")\n   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n   140\t\n   141\t\n   142\t@app.post(\"/runs\")\n   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n   144\t    settings = request.app.state.settings\n   145\t    span_ctx = trace.get_current_span().get_span_context()\n   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n   147\t    ident = RunIdentity(\n   148\t        accountable_party=principal.subject,\n   149\t        operational_owner=settings.operational_owner,\n   150\t        tenant=principal.business_unit,\n   151\t        agent_type_id=request.app.state.agent_type_id,\n   152\t        agent_instance_id=new_instance_id(),\n   153\t        trace_id=trace_id,\n   154\t        run_id=f\"run-{uuid.uuid4()}\",\n   155\t        delegated_subject=principal.subject,\n   156\t        agent_principal=AGENT_PRINCIPAL,\n   157\t    )\n   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n   161\t\n   162\t\n   163\t@app.post(\"/slack/interactions\")\n   164\tasync def slack_interactions(request: Request) -> dict:\n   165\t    body = await request.body()\n   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n   167\t    if abs(time.time() - int(timestamp)) > 300:\n   168\t        raise HTTPException(401, \"stale request\")\n   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n   172\t        raise HTTPException(401, \"bad signature\")\n   173\t\n   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n   175\t    action = payload[\"actions\"][0]\n   176\t    slack_user = payload[\"user\"][\"id\"]\n   177\t    row = await request.app.state.pool.fetchrow(\n   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n   179\t    )\n   180\t    if row is None:\n   181\t        raise HTTPException(403, \"not an approver\")\n   182\t    try:\n   183\t        await request.app.state.approvals.decide(\n   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n   185\t            approve=action[\"action_id\"] == \"approve\",\n   186\t        )\n   187\t    except ApproverNotAuthorized as exc:\n   188\t        raise HTTPException(403, str(exc)) from exc\n   189\t    except ValueError as exc:\n   190\t        raise HTTPException(409, str(exc)) from exc\n   191\t    return {\"ok\": True}\n   192\t\n   193\t\n   194\t@app.get(\"/healthz\")\n   195\tasync def healthz() -> dict:\n   196\t    return {\"ok\": True}\n=== README.md\n     1\t# procurement-agent\n     2\t\n     3\tProcurement agent for Example Corp business units. It reads vendor quotes and\n     4\tinvoices that arrive by email, checks them against department budgets, raises\n     5\tpurchase orders in the ERP, pays matched invoices, and talks to staff and\n     6\tvendors in Slack. It keeps short per-department notes between runs.\n     7\t\n     8\t## Architecture\n     9\t\n    10\t```\n    11\tmail gateway --HMAC--> /ingest/mail --> documents (Postgres, per business unit)\n    12\tstaff (OIDC JWT) ----> /runs --> ProcurementAgent loop (app/loop.py)\n    13\t                                   |-- PolicyGate (app/gate.py) + approvals (Slack buttons)\n    14\t                                   |-- Budget (app/budget.py)\n    15\t                                   |-- audit graph (app/audit.py -> audit_events)\n    16\t                                   |-- tools:\n    17\t                                   |     read_document, extract_line_items -> LineItemExtractor sub-agent\n    18\t                                   |     get_budget, erp_call, create_purchase_order -> ERP MCP via gateway\n    19\t                                   |     pay_invoice -> payments API\n    20\t                                   |     post_slack_message -> Slack (via slack-proxy)\n    21\t                                   |     memory_read, memory_write -> dept_notes\n    22\t```\n    23\t\n    24\t* **Tenancy.** Each run belongs to one business unit, taken from the `bu`\n    25\t  claim of the caller's verified OIDC token. Documents, notes, approvals and\n    26\t  quotas are keyed by business unit.\n    27\t* **Identity.** The agent runs as the `procurement-agent` service account.\n    28\t  Its projected token (10-minute lifetime) is exchanged at the internal STS\n    29\t  for audience-bound tokens for the ERP gateway, payments API and Slack\n    30\t  proxy. User tokens are never forwarded.\n    31\t* **Approvals.** `create_purchase_order`, `pay_invoice` and vendor messages\n    32\t  require an approval from a role listed in `config/policy.yaml`. Approval\n    33\t  requests are posted to `#approvals-<bu>` with the argument summary.\n    34\t* **Budgets.** Per-run step, time, token, cost, tool-rate and sub-agent\n    35\t  limits, plus per-user, per-business-unit and fleet quotas for daily spend\n    36\t  and run starts. See `config/policy.yaml`.\n    37\t* **Audit.** Every run step is a row in `audit_events` linked to its parent\n    38\t  step, with the six identity fields, policy version, approval id and\n    39\t  decision-time context size. The agent's database role can insert audit\n    40\t  rows but not update or delete them.\n    41\t\n    42\t## Context size\n    43\t\n    44\tLogged on every audit row as `context_tokens` and `context_method`:\n    45\t\n    46\t| method | meaning |\n    47\t|---|---|\n    48\t| `count_tokens_api` | exact request counted with the provider's token-count endpoint before the call (includes cached prefix) |\n    49\t| `usage_sum_estimate` | counting failed; `input_tokens + cache_read + cache_creation` from the response |\n    50\t| `unavailable` | neither available; `context_tokens` is NULL, never 0 |\n    51\t\n    52\t`context_compacted` is true when the harness dropped earlier turns before the\n    53\tcall (`app/loop.py:_compact`). Provider-side truncation is not visible.\n    54\t\n    55\t## Operating\n    56\t\n    57\t* **Halt.** Insert or update a row in `control_flags` (`scope = 'fleet'` or\n    58\t  `'tenant:<bu>'`, `halted = true`) as `procurement_ops`. New runs refuse to\n    59\t  start while a halt is set.\n    60\t* **Release.** Merges to `main` build, sign (keyless cosign), and attest the\n    61\t  image (SLSA provenance and CycloneDX SBOM). Kyverno rejects unsigned or\n    62\t  unattested images in `procurement-prod`.\n    63\t* **Network.** Default-deny egress with explicit rules for DNS, the egress\n    64\t  proxy, the Slack proxy, the database, the ERP gateway and the STS.\n    65\t\n    66\t## Tests\n    67\t\n    68\t```bash\n    69\tpip install -e '.[test]'\n    70\tpytest -q\n    71\t```\n=== deploy/k8s/deployment.yaml\n     1\tapiVersion: apps/v1\n     2\tkind: Deployment\n     3\tmetadata:\n     4\t  name: procurement-agent\n     5\t  namespace: procurement-prod\n     6\t  labels:\n     7\t    app: procurement-agent\n     8\t    owner: team-procurement-platform\n     9\tspec:\n    10\t  replicas: 3\n    11\t  selector:\n    12\t    matchLabels:\n    13\t      app: procurement-agent\n    14\t  template:\n    15\t    metadata:\n    16\t      labels:\n    17\t        app: procurement-agent\n    18\t    spec:\n    19\t      serviceAccountName: procurement-agent\n    20\t      automountServiceAccountToken: false\n    21\t      hostUsers: false\n    22\t      enableServiceLinks: false\n    23\t      securityContext:\n    24\t        runAsNonRoot: true\n    25\t        runAsUser: 65532\n    26\t        runAsGroup: 65532\n    27\t        fsGroup: 65532\n    28\t        seccompProfile:\n    29\t          type: RuntimeDefault\n    30\t      containers:\n    31\t        - name: agent\n    32\t          image: registry.example-corp.test/procurement/agent@sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\n    33\t          imagePullPolicy: IfNotPresent\n    34\t          ports:\n    35\t            - containerPort: 8080\n    36\t              name: http\n    37\t          env:\n    38\t            - name: IMAGE_DIGEST\n    39\t              value: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n    40\t            - name: MODEL_ID\n    41\t              value: \"claude-sonnet-4-5-20250929\"\n    42\t            - name: EXTRACTOR_MODEL_ID\n    43\t              value: \"claude-haiku-4-5-20251001\"\n    44\t            - name: DATABASE_URL\n    45\t              value: \"postgresql://procurement_agent@procurement-db.procurement-data.svc.cluster.local:5432/procurement?sslmode=verify-full\"\n    46\t            - name: ERP_MCP_URL\n    47\t              value: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    48\t            - name: PAYMENTS_API_URL\n    49\t              value: \"https://api.payments.example-pay.test\"\n    50\t            - name: SLACK_API_URL\n    51\t              value: \"https://slack-proxy.egress.svc.cluster.local:8443/api\"\n    52\t            - name: STS_URL\n    53\t              value: \"https://sts.identity.svc.cluster.local/oauth2/token\"\n    54\t            - name: OIDC_ISSUER\n    55\t              value: \"https://login.example-corp.test\"\n    56\t            - name: OIDC_JWKS_URL\n    57\t              value: \"https://login.example-corp.test/.well-known/jwks.json\"\n    58\t            - name: HTTPS_PROXY\n    59\t              value: \"http://egress-proxy.egress.svc.cluster.local:3128\"\n    60\t            - name: NO_PROXY\n    61\t              value: \".svc.cluster.local\"\n    62\t            - name: OTEL_EXPORTER_OTLP_ENDPOINT\n    63\t              value: \"http://otel-collector.observability.svc.cluster.local:4317\"\n    64\t            - name: OTEL_SERVICE_NAME\n    65\t              value: \"procurement-agent\"\n    66\t            - name: OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT\n    67\t              value: \"false\"\n    68\t          securityContext:\n    69\t            allowPrivilegeEscalation: false\n    70\t            privileged: false\n    71\t            readOnlyRootFilesystem: true\n    72\t            runAsNonRoot: true\n    73\t            capabilities:\n    74\t              drop: [\"ALL\"]\n    75\t            seccompProfile:\n    76\t              type: RuntimeDefault\n    77\t          resources:\n    78\t            requests:\n    79\t              cpu: 250m\n    80\t              memory: 512Mi\n    81\t            limits:\n    82\t              cpu: \"1\"\n    83\t              memory: 1Gi\n    84\t          readinessProbe:\n    85\t            httpGet:\n    86\t              path: /healthz\n    87\t              port: http\n    88\t          volumeMounts:\n    89\t            - name: workload-token\n    90\t              mountPath: /var/run/secrets/tokens\n    91\t              readOnly: true\n    92\t            - name: slack-signing\n    93\t              mountPath: /var/run/secrets/slack\n    94\t              readOnly: true\n    95\t            - name: mail-hmac\n    96\t              mountPath: /var/run/secrets/mail\n    97\t              readOnly: true\n    98\t            - name: tmp\n    99\t              mountPath: /tmp\n   100\t      volumes:\n   101\t        - name: workload-token\n   102\t          projected:\n   103\t            sources:\n   104\t              - serviceAccountToken:\n   105\t                  path: procurement-agent\n   106\t                  audience: sts.identity.example-corp.test\n   107\t                  expirationSeconds: 600\n   108\t        - name: slack-signing\n   109\t          secret:\n   110\t            secretName: procurement-slack-signing\n   111\t        - name: mail-hmac\n   112\t          secret:\n   113\t            secretName: procurement-mail-gateway-hmac\n   114\t        - name: tmp\n   115\t          emptyDir:\n   116\t            medium: Memory\n   117\t            sizeLimit: 64Mi\n=== deploy/k8s/serviceaccount.yaml\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: procurement-prod\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: latest\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: procurement-agent\n    15\t  namespace: procurement-prod\n    16\t  labels:\n    17\t    app: procurement-agent\n    18\tautomountServiceAccountToken: false\n=== config/policy.yaml\n     1\tversion: \"proc-policy-2026.09.3\"\n     2\t\n     3\t# Operations that change money, vendor records, or purchase commitments.\n     4\t# Denied unless a valid approval exists for the operation and its target.\n     5\thigh_impact_tools:\n     6\t  - create_purchase_order\n     7\t  - pay_invoice\n     8\t\n     9\terp:\n    10\t  # Namespaces the agent may reach through the generic erp_call tool.\n    11\t  read_prefixes:\n    12\t    - \"budget.\"\n    13\t    - \"vendor.\"\n    14\t    - \"invoice.\"\n    15\t    - \"po.get\"\n    16\t    - \"po.list\"\n    17\t  # Scope requested from the STS for each ERP operation; the ERP enforces it.\n    18\t  operation_scopes:\n    19\t    budget.get_remaining: \"erp.read\"\n    20\t    vendor.get: \"erp.read\"\n    21\t    vendor.search: \"erp.read\"\n    22\t    vendor.update_remit_to: \"erp.read erp.vendor.write\"\n    23\t    invoice.get: \"erp.read\"\n    24\t    invoice.list_open: \"erp.read\"\n    25\t    invoice.mark_paid: \"erp.read erp.invoice.write\"\n    26\t    invoice.void: \"erp.read erp.invoice.write\"\n    27\t    po.get: \"erp.read\"\n    28\t    po.list_open: \"erp.read\"\n    29\t    po.create: \"erp.read erp.po.create\"\n    30\t\n    31\tapprovals:\n    32\t  ttl_minutes: 60\n    33\t  approver_roles:\n    34\t    pay_invoice: [ap_manager, finance_controller]\n    35\t    create_purchase_order: [budget_owner, finance_controller]\n    36\t    post_slack_message: [procurement_lead]\n    37\t\n    38\tbudgets:\n    39\t  per_run:\n    40\t    max_steps: 25\n    41\t    max_wall_seconds: 300\n    42\t    max_tokens: 400000\n    43\t    max_cost_usd: 4.00\n    44\t    max_tool_calls_per_minute: 30\n    45\t    max_subagents: 3\n    46\t  quotas_daily_usd:\n    47\t    user: 25\n    48\t    tenant: 250\n    49\t    fleet: 1500\n    50\t  run_starts_per_minute:\n    51\t    user: 5\n    52\t    tenant: 40\n    53\t    fleet: 200\n=== pyproject.toml\n     1\t[project]\n     2\tname = \"procurement-agent\"\n     3\tversion = \"2026.9.4\"\n     4\tdescription = \"Procurement agent: quotes, purchase orders, invoice payment.\"\n     5\trequires-python = \">=3.11\"\n     6\tdependencies = [\n     7\t  \"fastapi==0.115.6\",\n     8\t  \"uvicorn==0.32.1\",\n     9\t  \"asyncpg==0.30.0\",\n    10\t  \"httpx==0.28.1\",\n    11\t  \"pydantic==2.10.4\",\n    12\t  \"pyyaml==6.0.2\",\n    13\t  \"pyjwt[crypto]==2.10.1\",\n    14\t  \"pypdf==5.1.0\",\n    15\t  \"anthropic==0.75.0\",\n    16\t  \"opentelemetry-sdk==1.29.0\",\n    17\t  \"opentelemetry-exporter-otlp==1.29.0\",\n    18\t]\n    19\t\n    20\t[project.optional-dependencies]\n    21\ttest = [\"pytest==8.3.4\", \"pytest-asyncio==0.25.0\"]\n    22\t\n    23\t[tool.pytest.ini_options]\n    24\tasyncio_mode = \"auto\"\n    25\ttestpaths = [\"tests\"]\n=== Dockerfile\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.11.10-slim-bookworm@sha256:2a6386ad2db20e7f55073f69a98d6da2cf9f168e05e7487d2670c22e4ad2a1bd AS build\n     3\tWORKDIR /src\n     4\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     5\tCOPY pyproject.toml ./\n     6\tCOPY app ./app\n     7\tRUN pip install --target /opt/site .\n     8\tRUN python -m compileall -q app\n     9\t\n    10\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:8f3c1a6e2b9d4f7a0c5e8b1d3f6a9c2e5b8d1f4a7c0e3b6d9f2a5c8e1b4d7f0a\n    11\tWORKDIR /app\n    12\tENV PYTHONPATH=/opt/site:/app \\\n    13\t    PYTHONDONTWRITEBYTECODE=1 \\\n    14\t    APP_ROOT=/app\n    15\tCOPY --from=build /opt/site /opt/site\n    16\tCOPY --from=build /src/app /app/app\n    17\tCOPY prompts /app/prompts\n    18\tCOPY config /app/config\n    19\tCOPY release/manifest.yaml /app/release/manifest.yaml\n    20\tUSER 65532:65532\n    21\tEXPOSE 8080\n    22\tENTRYPOINT [\"python\", \"-m\", \"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\", \"--no-server-header\"]\n.github:\n.\n..\nworkflows\n\n.github/workflows:\n.\n..\nci.yaml\n.\n..\n.github\napp\nbrace-findings.json\nbrace-inventory.json\nbrace-prescan.json\nconfig\ndeploy\nDockerfile\nmigrations\nprompts\npyproject.toml\nREADME.md\nrelease\ntests\n(eval):1: no matches found: --include=*","is_error":false}]},"parent_tool_use_id":null,"session_id":"a772fce6-3235-4ab2-ba24-c62b009a560f","uuid":"2c4ce7d1-9f42-4f53-85dd-38e5fea3d137","timestamp":"2026-10-20T13:21:13.792Z","tool_use_result":{"stdout":"=== .github/workflows/ci.yaml\n     1\tname: ci\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t\n     8\tpermissions:\n     9\t  contents: read\n    10\t\n    11\tjobs:\n    12\t  test:\n    13\t    runs-on: ubuntu-24.04\n    14\t    steps:\n    15\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    16\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    17\t        with:\n    18\t          python-version: \"3.11\"\n    19\t      - run: pip install -e '.[test]'\n    20\t      - run: pytest -q\n    21\t      - name: Secret scan\n    22\t        uses: gitleaks/gitleaks-action@83373cf2f8c4db6e24b41c1a9b086bb9619e9cd3 # v2.3.7\n    23\t      - name: Manifest hashes match files\n    24\t        run: |\n    25\t          python - <<'PY'\n    26\t          import hashlib, yaml, sys\n    27\t          m = yaml.safe_load(open(\"release/manifest.yaml\"))\n    28\t          bad = []\n    29\t          for group in (\"prompts\", \"config\"):\n    30\t              for name, e in m[group].items():\n    31\t                  if isinstance(e, dict) and \"sha256\" in e:\n    32\t                      got = \"sha256:\" + hashlib.sha256(open(e[\"path\"], \"rb\").read()).hexdigest()\n    33\t                      if got != e[\"sha256\"]:\n    34\t                          bad.append(e[\"path\"])\n    35\t          if bad:\n    36\t              sys.exit(\"manifest out of date: \" + \", \".join(bad))\n    37\t          PY\n    38\t\n    39\t  release:\n    40\t    if: github.ref == 'refs/heads/main'\n    41\t    needs: test\n    42\t    runs-on: ubuntu-24.04\n    43\t    permissions:\n    44\t      contents: read\n    45\t      id-token: write\n    46\t      packages: write\n    47\t      attestations: write\n    48\t    steps:\n    49\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    50\t      - uses: sigstore/cosign-installer@dc72c7d5c4d10cd6bcb8cf6e3fd625a9e5e537da # v3.7.0\n    51\t        with:\n    52\t          cosign-release: \"v2.6.2\"\n    53\t      - uses: docker/setup-buildx-action@c47758b77c9736f4b2ef4073d4d51994fabfe349 # v3.7.1\n    54\t      - uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0\n    55\t        with:\n    56\t          registry: registry.example-corp.test\n    57\t          username: ${{ github.actor }}\n    58\t          password: ${{ secrets.GITHUB_TOKEN }}\n    59\t      - id: build\n    60\t        uses: docker/build-push-action@4f58ea79222b3b9dc2c8bbdd6debcef730109a75 # v6.9.0\n    61\t        with:\n    62\t          context: .\n    63\t          push: true\n    64\t          tags: registry.example-corp.test/procurement/agent:${{ github.sha }}\n    65\t          provenance: false\n    66\t          sbom: false\n    67\t      - name: SBOM\n    68\t        uses: anchore/sbom-action@251a468eed47e5082b105c3ba6ee500c0e65a764 # v0.17.6\n    69\t        with:\n    70\t          image: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    71\t          format: cyclonedx-json\n    72\t          output-file: sbom.cdx.json\n    73\t      - name: Sign and attest\n    74\t        env:\n    75\t          IMAGE: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    76\t        run: |\n    77\t          cosign sign --yes \"$IMAGE\"\n    78\t          cosign attest --yes --type cyclonedx --predicate sbom.cdx.json \"$IMAGE\"\n    79\t      - uses: actions/attest-build-provenance@1c608d11d69870c2092266b3f9a6f3abbf17002c # v1.4.3\n    80\t        with:\n    81\t          subject-name: registry.example-corp.test/procurement/agent\n    82\t          subject-digest: ${{ steps.build.outputs.digest }}\n    83\t          push-to-registry: true\n=== app/main.py\n     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport hashlib\n     6\timport hmac\n     7\timport json\n     8\timport logging\n     9\timport time\n    10\timport uuid\n    11\tfrom contextlib import asynccontextmanager\n    12\tfrom pathlib import Path\n    13\tfrom urllib.parse import parse_qs\n    14\t\n    15\timport asyncpg\n    16\timport jwt\n    17\tfrom anthropic import AsyncAnthropic\n    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n    20\tfrom opentelemetry import trace\n    21\tfrom pydantic import BaseModel, Field\n    22\t\n    23\tfrom app import audit, ingest\n    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n    25\tfrom app.extractor import LineItemExtractor\n    26\tfrom app.gate import PolicyGate\n    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n    28\tfrom app.loop import AgentDeps, ProcurementAgent\n    29\tfrom app.mcp_client import ErpMcpClient\n    30\tfrom app.redact import RedactingFilter\n    31\tfrom app.settings import get_settings\n    32\tfrom app.startup import startup_checks\n    33\tfrom app.tools.slack import SlackClient\n    34\t\n    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n    36\tfor handler in logging.getLogger().handlers:\n    37\t    handler.addFilter(RedactingFilter())\n    38\tlog = logging.getLogger(\"procurement\")\n    39\t\n    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    41\tbearer = HTTPBearer()\n    42\t\n    43\t\n    44\tclass RunRequest(BaseModel):\n    45\t    task: str = Field(min_length=1, max_length=4000)\n    46\t    department: str = Field(min_length=1, max_length=64)\n    47\t\n    48\t\n    49\tclass Principal(BaseModel):\n    50\t    subject: str\n    51\t    business_unit: str\n    52\t\n    53\t\n    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    55\t    return RunIdentity(\n    56\t        accountable_party=\"system:procurement-agent\",\n    57\t        operational_owner=settings.operational_owner,\n    58\t        tenant=tenant,\n    59\t        agent_type_id=agent_type_id,\n    60\t        agent_instance_id=new_instance_id(),\n    61\t        trace_id=uuid.uuid4().hex,\n    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n    63\t        delegated_subject=\"system:procurement-agent\",\n    64\t        agent_principal=AGENT_PRINCIPAL,\n    65\t    )\n    66\t\n    67\t\n    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n    69\t    while True:\n    70\t        await asyncio.sleep(60)\n    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n    72\t        count = await app.state.pool.fetchval(\n    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n    75\t        )\n    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n    78\t\n    79\t\n    80\t@asynccontextmanager\n    81\tasync def lifespan(app: FastAPI):\n    82\t    settings = get_settings()\n    83\t    agent_type_id = startup_checks(settings)\n    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    85\t    broker = TokenBroker(settings)\n    86\t\n    87\t    async def slack_token() -> str:\n    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n    89\t\n    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n    92\t    gate = PolicyGate(settings.policy, approvals)\n    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n    95\t\n    96\t    client = AsyncAnthropic()\n    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    98\t    deps.extractor = LineItemExtractor(\n    99\t        client=client, settings=settings, deps=deps,\n   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n   101\t    )\n   102\t    app.state.settings = settings\n   103\t    app.state.pool = pool\n   104\t    app.state.agent_type_id = agent_type_id\n   105\t    app.state.approvals = approvals\n   106\t    app.state.agent = ProcurementAgent(\n   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n   108\t    )\n   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n   111\t    try:\n   112\t        yield\n   113\t    finally:\n   114\t        sweeper.cancel()\n   115\t        await pool.close()\n   116\t\n   117\t\n   118\tapp = FastAPI(lifespan=lifespan)\n   119\tapp.include_router(ingest.router)\n   120\t\n   121\t\n   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n   123\t    settings = request.app.state.settings\n   124\t    try:\n   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n   126\t        claims = jwt.decode(\n   127\t            creds.credentials,\n   128\t            key.key,\n   129\t            algorithms=[\"RS256\", \"ES256\"],\n   130\t            audience=settings.oidc_audience,\n   131\t            issuer=settings.oidc_issuer,\n   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n   133\t        )\n   134\t    except jwt.PyJWTError as exc:\n   135\t        raise HTTPException(401, \"invalid token\") from exc\n   136\t    bu = claims.get(\"bu\")\n   137\t    if not bu:\n   138\t        raise HTTPException(403, \"token has no business unit\")\n   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n   140\t\n   141\t\n   142\t@app.post(\"/runs\")\n   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n   144\t    settings = request.app.state.settings\n   145\t    span_ctx = trace.get_current_span().get_span_context()\n   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n   147\t    ident = RunIdentity(\n   148\t        accountable_party=principal.subject,\n   149\t        operational_owner=settings.operational_owner,\n   150\t        tenant=principal.business_unit,\n   151\t        agent_type_id=request.app.state.agent_type_id,\n   152\t        agent_instance_id=new_instance_id(),\n   153\t        trace_id=trace_id,\n   154\t        run_id=f\"run-{uuid.uuid4()}\",\n   155\t        delegated_subject=principal.subject,\n   156\t        agent_principal=AGENT_PRINCIPAL,\n   157\t    )\n   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n   161\t\n   162\t\n   163\t@app.post(\"/slack/interactions\")\n   164\tasync def slack_interactions(request: Request) -> dict:\n   165\t    body = await request.body()\n   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n   167\t    if abs(time.time() - int(timestamp)) > 300:\n   168\t        raise HTTPException(401, \"stale request\")\n   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n   172\t        raise HTTPException(401, \"bad signature\")\n   173\t\n   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n   175\t    action = payload[\"actions\"][0]\n   176\t    slack_user = payload[\"user\"][\"id\"]\n   177\t    row = await request.app.state.pool.fetchrow(\n   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n   179\t    )\n   180\t    if row is None:\n   181\t        raise HTTPException(403, \"not an approver\")\n   182\t    try:\n   183\t        await request.app.state.approvals.decide(\n   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n   185\t            approve=action[\"action_id\"] == \"approve\",\n   186\t        )\n   187\t    except ApproverNotAuthorized as exc:\n   188\t        raise HTTPException(403, str(exc)) from exc\n   189\t    except ValueError as exc:\n   190\t        raise HTTPException(409, str(exc)) from exc\n   191\t    return {\"ok\": True}\n   192\t\n   193\t\n   194\t@app.get(\"/healthz\")\n   195\tasync def healthz() -> dict:\n   196\t    return {\"ok\": True}\n=== README.md\n     1\t# procurement-agent\n     2\t\n     3\tProcurement agent for Example Corp business units. It reads vendor quotes and\n     4\tinvoices that arrive by email, checks them against department budgets, raises\n     5\tpurchase orders in the ERP, pays matched invoices, and talks to staff and\n     6\tvendors in Slack. It keeps short per-department notes between runs.\n     7\t\n     8\t## Architecture\n     9\t\n    10\t```\n    11\tmail gateway --HMAC--> /ingest/mail --> documents (Postgres, per business unit)\n    12\tstaff (OIDC JWT) ----> /runs --> ProcurementAgent loop (app/loop.py)\n    13\t                                   |-- PolicyGate (app/gate.py) + approvals (Slack buttons)\n    14\t                                   |-- Budget (app/budget.py)\n    15\t                                   |-- audit graph (app/audit.py -> audit_events)\n    16\t                                   |-- tools:\n    17\t                                   |     read_document, extract_line_items -> LineItemExtractor sub-agent\n    18\t                                   |     get_budget, erp_call, create_purchase_order -> ERP MCP via gateway\n    19\t                                   |     pay_invoice -> payments API\n    20\t                                   |     post_slack_message -> Slack (via slack-proxy)\n    21\t                                   |     memory_read, memory_write -> dept_notes\n    22\t```\n    23\t\n    24\t* **Tenancy.** Each run belongs to one business unit, taken from the `bu`\n    25\t  claim of the caller's verified OIDC token. Documents, notes, approvals and\n    26\t  quotas are keyed by business unit.\n    27\t* **Identity.** The agent runs as the `procurement-agent` service account.\n    28\t  Its projected token (10-minute lifetime) is exchanged at the internal STS\n    29\t  for audience-bound tokens for the ERP gateway, payments API and Slack\n    30\t  proxy. User tokens are never forwarded.\n    31\t* **Approvals.** `create_purchase_order`, `pay_invoice` and vendor messages\n    32\t  require an approval from a role listed in `config/policy.yaml`. Approval\n    33\t  requests are posted to `#approvals-<bu>` with the argument summary.\n    34\t* **Budgets.** Per-run step, time, token, cost, tool-rate and sub-agent\n    35\t  limits, plus per-user, per-business-unit and fleet quotas for daily spend\n    36\t  and run starts. See `config/policy.yaml`.\n    37\t* **Audit.** Every run step is a row in `audit_events` linked to its parent\n    38\t  step, with the six identity fields, policy version, approval id and\n    39\t  decision-time context size. The agent's database role can insert audit\n    40\t  rows but not update or delete them.\n    41\t\n    42\t## Context size\n    43\t\n    44\tLogged on every audit row as `context_tokens` and `context_method`:\n    45\t\n    46\t| method | meaning |\n    47\t|---|---|\n    48\t| `count_tokens_api` | exact request counted with the provider's token-count endpoint before the call (includes cached prefix) |\n    49\t| `usage_sum_estimate` | counting failed; `input_tokens + cache_read + cache_creation` from the response |\n    50\t| `unavailable` | neither available; `context_tokens` is NULL, never 0 |\n    51\t\n    52\t`context_compacted` is true when the harness dropped earlier turns before the\n    53\tcall (`app/loop.py:_compact`). Provider-side truncation is not visible.\n    54\t\n    55\t## Operating\n    56\t\n    57\t* **Halt.** Insert or update a row in `control_flags` (`scope = 'fleet'` or\n    58\t  `'tenant:<bu>'`, `halted = true`) as `procurement_ops`. New runs refuse to\n    59\t  start while a halt is set.\n    60\t* **Release.** Merges to `main` build, sign (keyless cosign), and attest the\n    61\t  image (SLSA provenance and CycloneDX SBOM). Kyverno rejects unsigned or\n    62\t  unattested images in `procurement-prod`.\n    63\t* **Network.** Default-deny egress with explicit rules for DNS, the egress\n    64\t  proxy, the Slack proxy, the database, the ERP gateway and the STS.\n    65\t\n    66\t## Tests\n    67\t\n    68\t```bash\n    69\tpip install -e '.[test]'\n    70\tpytest -q\n    71\t```\n=== deploy/k8s/deployment.yaml\n     1\tapiVersion: apps/v1\n     2\tkind: Deployment\n     3\tmetadata:\n     4\t  name: procurement-agent\n     5\t  namespace: procurement-prod\n     6\t  labels:\n     7\t    app: procurement-agent\n     8\t    owner: team-procurement-platform\n     9\tspec:\n    10\t  replicas: 3\n    11\t  selector:\n    12\t    matchLabels:\n    13\t      app: procurement-agent\n    14\t  template:\n    15\t    metadata:\n    16\t      labels:\n    17\t        app: procurement-agent\n    18\t    spec:\n    19\t      serviceAccountName: procurement-agent\n    20\t      automountServiceAccountToken: false\n    21\t      hostUsers: false\n    22\t      enableServiceLinks: false\n    23\t      securityContext:\n    24\t        runAsNonRoot: true\n    25\t        runAsUser: 65532\n    26\t        runAsGroup: 65532\n    27\t        fsGroup: 65532\n    28\t        seccompProfile:\n    29\t          type: RuntimeDefault\n    30\t      containers:\n    31\t        - name: agent\n    32\t          image: registry.example-corp.test/procurement/agent@sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\n    33\t          imagePullPolicy: IfNotPresent\n    34\t          ports:\n    35\t            - containerPort: 8080\n    36\t              name: http\n    37\t          env:\n    38\t            - name: IMAGE_DIGEST\n    39\t              value: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n    40\t            - name: MODEL_ID\n    41\t              value: \"claude-sonnet-4-5-20250929\"\n    42\t            - name: EXTRACTOR_MODEL_ID\n    43\t              value: \"claude-haiku-4-5-20251001\"\n    44\t            - name: DATABASE_URL\n    45\t              value: \"postgresql://procurement_agent@procurement-db.procurement-data.svc.cluster.local:5432/procurement?sslmode=verify-full\"\n    46\t            - name: ERP_MCP_URL\n    47\t              value: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    48\t            - name: PAYMENTS_API_URL\n    49\t              value: \"https://api.payments.example-pay.test\"\n    50\t            - name: SLACK_API_URL\n    51\t              value: \"https://slack-proxy.egress.svc.cluster.local:8443/api\"\n    52\t            - name: STS_URL\n    53\t              value: \"https://sts.identity.svc.cluster.local/oauth2/token\"\n    54\t            - name: OIDC_ISSUER\n    55\t              value: \"https://login.example-corp.test\"\n    56\t            - name: OIDC_JWKS_URL\n    57\t              value: \"https://login.example-corp.test/.well-known/jwks.json\"\n    58\t            - name: HTTPS_PROXY\n    59\t              value: \"http://egress-proxy.egress.svc.cluster.local:3128\"\n    60\t            - name: NO_PROXY\n    61\t              value: \".svc.cluster.local\"\n    62\t            - name: OTEL_EXPORTER_OTLP_ENDPOINT\n    63\t              value: \"http://otel-collector.observability.svc.cluster.local:4317\"\n    64\t            - name: OTEL_SERVICE_NAME\n    65\t              value: \"procurement-agent\"\n    66\t            - name: OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT\n    67\t              value: \"false\"\n    68\t          securityContext:\n    69\t            allowPrivilegeEscalation: false\n    70\t            privileged: false\n    71\t            readOnlyRootFilesystem: true\n    72\t            runAsNonRoot: true\n    73\t            capabilities:\n    74\t              drop: [\"ALL\"]\n    75\t            seccompProfile:\n    76\t              type: RuntimeDefault\n    77\t          resources:\n    78\t            requests:\n    79\t              cpu: 250m\n    80\t              memory: 512Mi\n    81\t            limits:\n    82\t              cpu: \"1\"\n    83\t              memory: 1Gi\n    84\t          readinessProbe:\n    85\t            httpGet:\n    86\t              path: /healthz\n    87\t              port: http\n    88\t          volumeMounts:\n    89\t            - name: workload-token\n    90\t              mountPath: /var/run/secrets/tokens\n    91\t              readOnly: true\n    92\t            - name: slack-signing\n    93\t              mountPath: /var/run/secrets/slack\n    94\t              readOnly: true\n    95\t            - name: mail-hmac\n    96\t              mountPath: /var/run/secrets/mail\n    97\t              readOnly: true\n    98\t            - name: tmp\n    99\t              mountPath: /tmp\n   100\t      volumes:\n   101\t        - name: workload-token\n   102\t          projected:\n   103\t            sources:\n   104\t              - serviceAccountToken:\n   105\t                  path: procurement-agent\n   106\t                  audience: sts.identity.example-corp.test\n   107\t                  expirationSeconds: 600\n   108\t        - name: slack-signing\n   109\t          secret:\n   110\t            secretName: procurement-slack-signing\n   111\t        - name: mail-hmac\n   112\t          secret:\n   113\t            secretName: procurement-mail-gateway-hmac\n   114\t        - name: tmp\n   115\t          emptyDir:\n   116\t            medium: Memory\n   117\t            sizeLimit: 64Mi\n=== deploy/k8s/serviceaccount.yaml\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: procurement-prod\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: latest\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: procurement-agent\n    15\t  namespace: procurement-prod\n    16\t  labels:\n    17\t    app: procurement-agent\n    18\tautomountServiceAccountToken: false\n=== config/policy.yaml\n     1\tversion: \"proc-policy-2026.09.3\"\n     2\t\n     3\t# Operations that change money, vendor records, or purchase commitments.\n     4\t# Denied unless a valid approval exists for the operation and its target.\n     5\thigh_impact_tools:\n     6\t  - create_purchase_order\n     7\t  - pay_invoice\n     8\t\n     9\terp:\n    10\t  # Namespaces the agent may reach through the generic erp_call tool.\n    11\t  read_prefixes:\n    12\t    - \"budget.\"\n    13\t    - \"vendor.\"\n    14\t    - \"invoice.\"\n    15\t    - \"po.get\"\n    16\t    - \"po.list\"\n    17\t  # Scope requested from the STS for each ERP operation; the ERP enforces it.\n    18\t  operation_scopes:\n    19\t    budget.get_remaining: \"erp.read\"\n    20\t    vendor.get: \"erp.read\"\n    21\t    vendor.search: \"erp.read\"\n    22\t    vendor.update_remit_to: \"erp.read erp.vendor.write\"\n    23\t    invoice.get: \"erp.read\"\n    24\t    invoice.list_open: \"erp.read\"\n    25\t    invoice.mark_paid: \"erp.read erp.invoice.write\"\n    26\t    invoice.void: \"erp.read erp.invoice.write\"\n    27\t    po.get: \"erp.read\"\n    28\t    po.list_open: \"erp.read\"\n    29\t    po.create: \"erp.read erp.po.create\"\n    30\t\n    31\tapprovals:\n    32\t  ttl_minutes: 60\n    33\t  approver_roles:\n    34\t    pay_invoice: [ap_manager, finance_controller]\n    35\t    create_purchase_order: [budget_owner, finance_controller]\n    36\t    post_slack_message: [procurement_lead]\n    37\t\n    38\tbudgets:\n    39\t  per_run:\n    40\t    max_steps: 25\n    41\t    max_wall_seconds: 300\n    42\t    max_tokens: 400000\n    43\t    max_cost_usd: 4.00\n    44\t    max_tool_calls_per_minute: 30\n    45\t    max_subagents: 3\n    46\t  quotas_daily_usd:\n    47\t    user: 25\n    48\t    tenant: 250\n    49\t    fleet: 1500\n    50\t  run_starts_per_minute:\n    51\t    user: 5\n    52\t    tenant: 40\n    53\t    fleet: 200\n=== pyproject.toml\n     1\t[project]\n     2\tname = \"procurement-agent\"\n     3\tversion = \"2026.9.4\"\n     4\tdescription = \"Procurement agent: quotes, purchase orders, invoice payment.\"\n     5\trequires-python = \">=3.11\"\n     6\tdependencies = [\n     7\t  \"fastapi==0.115.6\",\n     8\t  \"uvicorn==0.32.1\",\n     9\t  \"asyncpg==0.30.0\",\n    10\t  \"httpx==0.28.1\",\n    11\t  \"pydantic==2.10.4\",\n    12\t  \"pyyaml==6.0.2\",\n    13\t  \"pyjwt[crypto]==2.10.1\",\n    14\t  \"pypdf==5.1.0\",\n    15\t  \"anthropic==0.75.0\",\n    16\t  \"opentelemetry-sdk==1.29.0\",\n    17\t  \"opentelemetry-exporter-otlp==1.29.0\",\n    18\t]\n    19\t\n    20\t[project.optional-dependencies]\n    21\ttest = [\"pytest==8.3.4\", \"pytest-asyncio==0.25.0\"]\n    22\t\n    23\t[tool.pytest.ini_options]\n    24\tasyncio_mode = \"auto\"\n    25\ttestpaths = [\"tests\"]\n=== Dockerfile\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.11.10-slim-bookworm@sha256:2a6386ad2db20e7