{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgDaLCBDwMtSn38tQjx7e","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016zEbttPmwxoeP8pyMRXT5R","name":"Bash","input":{"command":"cat -n app/loop.py app/killswitch.py app/mcp_client.py app/tools/payments.py app/tools/erp.py app/tools/__init__.py config/policy.yaml config/tools.yaml"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12083,"cache_read_input_tokens":27549,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12083},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"deb3cf09-fb76-4851-bfdc-9aa6672ce779","uuid":"13468c79-e42f-45bb-9232-98da8791a436","timestamp":"2026-10-20T13:34:12.478Z","request_id":"req_011CgDaLBsciMqbu1yFuiz7s","wire_tool_inputs":{"toolu_016zEbttPmwxoeP8pyMRXT5R":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-i3nxdpy4/agent && cat -n app/loop.py app/killswitch.py app/mcp_client.py app/tools/payments.py app/tools/erp.py app/tools/__init__.py config/policy.yaml config/tools.yaml"}},"wire_ingest_context":{"toolu_016zEbttPmwxoeP8pyMRXT5R":{"cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-i3nxdpy4/agent"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016zEbttPmwxoeP8pyMRXT5R","type":"tool_result","content":"     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n     1\t\"\"\"Operator stop control.\n     2\t\n     3\tOperators halt the fleet or one business unit by setting a row in\n     4\t``control_flags`` with the ``procurement_ops`` database role (see\n     5\tops/README in the platform runbook). The agent's own database role has\n     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\t\n    11\tclass AgentHalted(Exception):\n    12\t    pass\n    13\t\n    14\t\n    15\t_QUERY = \"\"\"\n    16\tSELECT scope, reason, set_by, set_at\n    17\tFROM control_flags\n    18\tWHERE halted\n    19\t  AND (scope = 'fleet' OR scope = $1)\n    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n    21\tLIMIT 1\n    22\t\"\"\"\n    23\t\n    24\t\n    25\tasync def assert_running(pool, tenant: str) -> None:\n    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n    27\t    if row is not None:\n    28\t        raise AgentHalted(\n    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n    31\t        )\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n     1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.tools import Tool\n    11\t\n    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n    13\tPAYMENTS_SCOPE = \"payments.create\"\n    14\t\n    15\t\n    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n    17\t    raw = \"|\".join(\n    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n    19\t    )\n    20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n    21\t\n    22\t\n    23\tdef tools(deps) -> list[Tool]:\n    24\t    settings = deps.settings\n    25\t\n    26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n    27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n    28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n    29\t            resp = await client.post(\n    30\t                f\"{settings.payments_api_url}/v2/payments\",\n    31\t                headers={\n    32\t                    \"Authorization\": f\"Bearer {token}\",\n    33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n    34\t                },\n    35\t                json={\n    36\t                    \"business_unit\": ident.tenant,\n    37\t                    \"invoice_reference\": args[\"invoice_id\"],\n    38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n    39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n    40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n    41\t                },\n    42\t            )\n    43\t        resp.raise_for_status()\n    44\t        body = resp.json()\n    45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n    46\t\n    47\t    return [\n    48\t        Tool(\n    49\t            name=\"pay_invoice\",\n    50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n    51\t            input_schema={\n    52\t                \"type\": \"object\",\n    53\t                \"properties\": {\n    54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n    55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n    56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n    57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n    59\t                },\n    60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n    61\t                \"additionalProperties\": False,\n    62\t            },\n    63\t            invoke=pay_invoice,\n    64\t            target_field=\"invoice_id\",\n    65\t        )\n    66\t    ]\n     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tERP_READ_SCOPE = \"erp.read\"\n    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n    11\t\n    12\t\n    13\tdef tools(deps) -> list[Tool]:\n    14\t    erp = deps.erp\n    15\t\n    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n    17\t        return await erp.call(\n    18\t            \"budget.get_remaining\",\n    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n    20\t            ident,\n    21\t            ERP_READ_SCOPE,\n    22\t        )\n    23\t\n    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n    25\t        arguments = dict(args.get(\"arguments\", {}))\n    26\t        arguments[\"business_unit\"] = ident.tenant\n    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n    28\t\n    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n    30\t        return await erp.call(\n    31\t            \"po.create\",\n    32\t            {\n    33\t                \"business_unit\": ident.tenant,\n    34\t                \"department\": args[\"department\"],\n    35\t                \"vendor_id\": args[\"vendor_id\"],\n    36\t                \"lines\": args[\"lines\"],\n    37\t                \"currency\": args[\"currency\"],\n    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n    39\t                \"client_reference\": args[\"source_doc_id\"],\n    40\t            },\n    41\t            ident,\n    42\t            ERP_PO_WRITE_SCOPE,\n    43\t        )\n    44\t\n    45\t    line_schema = {\n    46\t        \"type\": \"object\",\n    47\t        \"properties\": {\n    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n    52\t        },\n    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n    54\t        \"additionalProperties\": False,\n    55\t    }\n    56\t\n    57\t    return [\n    58\t        Tool(\n    59\t            name=\"get_budget\",\n    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n    61\t            input_schema={\n    62\t                \"type\": \"object\",\n    63\t                \"properties\": {\n    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n    66\t                },\n    67\t                \"required\": [\"department\", \"fiscal_period\"],\n    68\t                \"additionalProperties\": False,\n    69\t            },\n    70\t            invoke=get_budget,\n    71\t        ),\n    72\t        Tool(\n    73\t            name=\"erp_call\",\n    74\t            description=(\n    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n    77\t            ),\n    78\t            input_schema={\n    79\t                \"type\": \"object\",\n    80\t                \"properties\": {\n    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n    82\t                    \"arguments\": {\"type\": \"object\"},\n    83\t                },\n    84\t                \"required\": [\"operation\"],\n    85\t                \"additionalProperties\": False,\n    86\t            },\n    87\t            invoke=erp_call,\n    88\t        ),\n    89\t        Tool(\n    90\t            name=\"create_purchase_order\",\n    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n    92\t            input_schema={\n    93\t                \"type\": \"object\",\n    94\t                \"properties\": {\n    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n   100\t                },\n   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n   102\t                \"additionalProperties\": False,\n   103\t            },\n   104\t            invoke=create_purchase_order,\n   105\t            target_field=\"source_doc_id\",\n   106\t        ),\n   107\t    ]\n     1\t\"\"\"Tool registry.\n     2\t\n     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n     5\tthat is not in the run's registry.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom functools import lru_cache\n    11\tfrom typing import Any, Awaitable, Callable\n    12\t\n    13\timport yaml\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\t\n    17\tDEFAULT_ROLE = \"procurement\"\n    18\t\n    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Tool:\n    24\t    name: str\n    25\t    description: str\n    26\t    input_schema: dict[str, Any]\n    27\t    invoke: Invoke\n    28\t    target_field: str | None = None\n    29\t\n    30\t    def target_of(self, args: dict[str, Any]) -> str:\n    31\t        if self.target_field is None:\n    32\t            return self.name\n    33\t        return str(args.get(self.target_field, \"\"))\n    34\t\n    35\t    def schema(self) -> dict[str, Any]:\n    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n    37\t\n    38\t\n    39\tclass ToolRegistry:\n    40\t    def __init__(self, tools: list[Tool]):\n    41\t        self._tools = {t.name: t for t in tools}\n    42\t\n    43\t    def get(self, name: str) -> Tool | None:\n    44\t        return self._tools.get(name)\n    45\t\n    46\t    def names(self) -> list[str]:\n    47\t        return sorted(self._tools)\n    48\t\n    49\t    def schemas(self) -> list[dict[str, Any]]:\n    50\t        return [self._tools[n].schema() for n in self.names()]\n    51\t\n    52\t\n    53\t@lru_cache(maxsize=1)\n    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        cfg = yaml.safe_load(fh)\n    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n    58\t\n    59\t\n    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n    61\t    from app.tools import documents, erp, memory, payments, slack\n    62\t\n    63\t    available: dict[str, Tool] = {}\n    64\t    for module in (documents, erp, memory, payments, slack):\n    65\t        for tool in module.tools(deps):\n    66\t            available[tool.name] = tool\n    67\t\n    68\t    roles = _role_tools(str(deps.settings.tools_path))\n    69\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n    70\t    return ToolRegistry([available[name] for name in allowed if name in available])\n     1\tversion: \"proc-policy-2026.09.3\"\n     2\t\n     3\t# Operations that change money, vendor records, or purchase commitments.\n     4\t# Denied unless a valid approval exists for the operation and its target.\n     5\thigh_impact_tools:\n     6\t  - create_purchase_order\n     7\t  - pay_invoice\n     8\t\n     9\terp:\n    10\t  # Namespaces the agent may reach through the generic erp_call tool.\n    11\t  read_prefixes:\n    12\t    - \"budget.\"\n    13\t    - \"vendor.\"\n    14\t    - \"invoice.\"\n    15\t    - \"po.get\"\n    16\t    - \"po.list\"\n    17\t  # Scope requested from the STS for each ERP operation; the ERP enforces it.\n    18\t  operation_scopes:\n    19\t    budget.get_remaining: \"erp.read\"\n    20\t    vendor.get: \"erp.read\"\n    21\t    vendor.search: \"erp.read\"\n    22\t    vendor.update_remit_to: \"erp.read erp.vendor.write\"\n    23\t    invoice.get: \"erp.read\"\n    24\t    invoice.list_open: \"erp.read\"\n    25\t    invoice.mark_paid: \"erp.read erp.invoice.write\"\n    26\t    invoice.void: \"erp.read erp.invoice.write\"\n    27\t    po.get: \"erp.read\"\n    28\t    po.list_open: \"erp.read\"\n    29\t    po.create: \"erp.read erp.po.create\"\n    30\t\n    31\tapprovals:\n    32\t  ttl_minutes: 60\n    33\t  approver_roles:\n    34\t    pay_invoice: [ap_manager, finance_controller]\n    35\t    create_purchase_order: [budget_owner, finance_controller]\n    36\t    post_slack_message: [procurement_lead]\n    37\t\n    38\tbudgets:\n    39\t  per_run:\n    40\t    max_steps: 25\n    41\t    max_wall_seconds: 300\n    42\t    max_tokens: 400000\n    43\t    max_cost_usd: 4.00\n    44\t    max_tool_calls_per_minute: 30\n    45\t    max_subagents: 3\n    46\t  quotas_daily_usd:\n    47\t    user: 25\n    48\t    tenant: 250\n    49\t    fleet: 1500\n    50\t  run_starts_per_minute:\n    51\t    user: 5\n    52\t    tenant: 40\n    53\t    fleet: 200\n     1\t# Tools per agent role, each with the task reason it is granted.\n     2\troles:\n     3\t  procurement:\n     4\t    tools:\n     5\t      read_document: \"Read vendor quotes, invoices and emails that arrived through the mail gateway.\"\n     6\t      extract_line_items: \"Delegate line-item extraction from long documents to the extractor.\"\n     7\t      get_budget: \"Check remaining department budget before raising a purchase order.\"\n     8\t      erp_call: \"Look up vendors, open invoices and purchase orders for matching.\"\n     9\t      create_purchase_order: \"Raise a purchase order once a quote is within budget and approved.\"\n    10\t      pay_invoice: \"Pay an invoice that is matched to a purchase order and approved.\"\n    11\t      post_slack_message: \"Ask staff for missing details and confirm orders with vendors.\"\n    12\t      memory_read: \"Recall department preferences and contract terms from earlier runs.\"\n    13\t      memory_write: \"Save new department preferences and contract terms.\"\n    14\t  extractor:\n    15\t    tools:\n    16\t      read_document: \"Read the document whose line items are being extracted.\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"deb3cf09-fb76-4851-bfdc-9aa6672ce779","uuid":"623bb221-c7d5-40fc-9b98-ef0e0e923efd","timestamp":"2026-10-20T13:34:12.521Z","tool_use_result":{"stdout":"     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n     1\t\"\"\"Operator stop control.\n     2\t\n     3\tOperators halt the fleet or one business unit by setting a row in\n     4\t``control_flags`` with the ``procurement_ops`` database role (see\n     5\tops/README in the platform runbook). The agent's own database role has\n     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\t\n    11\tclass AgentHalted(Exception):\n    12\t    pass\n    13\t\n    14\t\n    15\t_QUERY = \"\"\"\n    16\tSELECT scope, reason, set_by, set_at\n    17\tFROM control_flags\n    18\tWHERE halted\n    19\t  AND (scope = 'fleet' OR scope = $1)\n    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n    21\tLIMIT 1\n    22\t\"\"\"\n    23\t\n    24\t\n    25\tasync def assert_running(pool, tenant: str) -> None:\n    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n    27\t    if row is not None:\n    28\t        raise AgentHalted(\n    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n    31\t        )\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n     1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.tools import Tool\n    11\t\n    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n    13\tPAYMENTS_SCOPE = \"payments.create\"\n    14\t\n    15\t\n    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n    17\t    raw = \"|\".join(\n    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n    19\t    )\n    20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n    21\t\n    22\t\n    23\tdef tools(deps) -> list[Tool]:\n    24\t    settings = deps.settings\n    25\t\n    26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n    27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n    28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n    29\t            resp = await client.post(\n    30\t                f\"{settings.payments_api_url}/v2/payments\",\n    31\t                headers={\n    32\t                    \"Authorization\": f\"Bearer {token}\",\n    33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n    34\t                },\n    35\t                json={\n    36\t                    \"business_unit\": ident.tenant,\n    37\t                    \"invoice_reference\": args[\"invoice_id\"],\n    38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n    39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n    40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n    41\t                },\n    42\t            )\n    43\t        resp.raise_for_status()\n    44\t        body = resp.json()\n    45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n    46\t\n    47\t    return [\n    48\t        Tool(\n    49\t            name=\"pay_invoice\",\n    50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n    51\t            input_schema={\n    52\t                \"type\": \"object\",\n    53\t                \"properties\": {\n    54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n    55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n    56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n    57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n    59\t                },\n    60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n    61\t                \"additionalProperties\": False,\n    62\t            },\n    63\t            invoke=pay_invoice,\n    64\t            target_field=\"invoice_id\",\n    65\t        )\n    66\t    ]\n     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tERP_READ_SCOPE = \"erp.read\"\n    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n    11\t\n    12\t\n    13\tdef tools(deps) -> list[Tool]:\n    14\t    erp = deps.erp\n    15\t\n    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n    17\t        return await erp.call(\n    18\t            \"budget.get_remaining\",\n    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n    20\t            ident,\n    21\t            ERP_READ_SCOPE,\n    22\t        )\n    23\t\n    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n    25\t        arguments = dict(args.get(\"arguments\", {}))\n    26\t        arguments[\"business_unit\"] = ident.tenant\n    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n    28\t\n    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n    30\t        return await erp.call(\n    31\t            \"po.create\",\n    32\t            {\n    33\t                \"business_unit\": ident.tenant,\n    34\t                \"department\": args[\"department\"],\n    35\t                \"vendor_id\": args[\"vendor_id\"],\n    36\t                \"lines\": args[\"lines\"],\n    37\t                \"currency\": args[\"currency\"],\n    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n    39\t                \"client_reference\": args[\"source_doc_id\"],\n    40\t            },\n    41\t            ident,\n    42\t            ERP_PO_WRITE_SCOPE,\n    43\t        )\n    44\t\n    45\t    line_schema = {\n    46\t        \"type\": \"object\",\n    47\t        \"properties\": {\n    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n    52\t        },\n    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n    54\t        \"additionalProperties\": False,\n    55\t    }\n    56\t\n    57\t    return [\n    58\t        Tool(\n    59\t            name=\"get_budget\",\n    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n    61\t            input_schema={\n    62\t                \"type\": \"object\",\n    63\t                \"properties\": {\n    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n    66\t                },\n    67\t                \"required\": [\"department\", \"fiscal_period\"],\n    68\t                \"additionalProperties\": False,\n    69\t            },\n    70\t            invoke=get_budget,\n    71\t        ),\n    72\t        Tool(\n    73\t            name=\"erp_call\",\n    74\t            description=(\n    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n    77\t            ),\n    78\t            input_schema={\n    79\t                \"type\": \"object\",\n    80\t                \"properties\": {\n    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n    82\t                    \"arguments\": {\"type\": \"object\"},\n    83\t                },\n    84\t                \"required\": [\"operation\"],\n    85\t                \"additionalProperties\": False,\n    86\t            },\n    87\t            invoke=erp_call,\n    88\t        ),\n    89\t        Tool(\n    90\t            name=\"create_purchase_order\",\n    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n    92\t            input_schema={\n    93\t                \"type\": \"object\",\n    94\t                \"properties\": {\n    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n   100\t                },\n   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n   102\t                \"additionalProperties\": False,\n   103\t            },\n   104\t            invoke=create_purchase_order,\n   105\t            target_field=\"source_doc_id\",\n   106\t        ),\n   107\t    ]\n     1\t\"\"\"Tool registry.\n     2\t\n     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n     5\tthat is not in the run's registry.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom functools import lru_cache\n    11\tfrom typing import Any, Awaitable, Callable\n    12\t\n    13\timport yaml\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\t\n    17\tDEFAULT_ROLE = \"procurement\"\n    18\t\n    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Tool:\n    24\t    name: str\n    25\t    description: str\n    26\t    input_schema: dict[str, Any]\n    27\t    invoke: Invoke\n    28\t    target_field: str | None = None\n    29\t\n    30\t    def target_of(self, args: dict[str, Any]) -> str:\n    31\t        if self.target_field is None:\n    32\t            return self.name\n    33\t        return str(args.get(self.target_field, \"\"))\n    34\t\n    35\t    def schema(self) -> dict[str, Any]:\n    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n    37\t\n    38\t\n    39\tclass ToolRegistry:\n    40\t    def __init__(self, tools: list[Tool]):\n    41\t        self._tools = {t.name: t for t in tools}\n    42\t\n    43\t    def get(self, name: str) -> Tool | None:\n    44\t        return self._tools.get(name)\n    45\t\n    46\t    def names(self) -> list[str]:\n    47\t        return sorted(self._tools)\n    48\t\n    49\t    def schemas(self) -> list[dict[str, Any]]:\n    50\t        return [self._tools[n].schema() for n in self.names()]\n    51\t\n    52\t\n    53\t@lru_cache(maxsize=1)\n    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        cfg = yaml.safe_load(fh)\n    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n    58\t\n    59\t\n    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n    61\t    from app.tools import documents, erp, memory, payments, slack\n    62\t\n    63\t    available: dict[str, Tool] = {}\n    64\t    for module in (documents, erp, memory, payments, slack):\n    65\t        for tool in module.tools(deps):\n    66\t            available[tool.name] = tool\n    67\t\n    68\t    roles = _role_tools(str(deps.settings.tools_path))\n    69\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n    70\t    return ToolRegistry([available[name] for name in allowed if name in available])\n     1\tversion: \"proc-policy-2026.09.3\"\n     2\t\n     3\t# Operations that change money, vendor records, or purchase commitments.\n     4\t# Denied unless a valid approval exists for the operation and its target.\n     5\thigh_impact_tools:\n     6\t  - create_purchase_order\n     7\t  - pay_invoice\n     8\t\n     9\terp:\n    10\t  # Namespaces the agent may reach through the generic erp_call tool.\n    11\t  read_prefixes:\n    12\t    - \"budget.\"\n    13\t    - \"vendor.\"\n    14\t    - \"invoice.\"\n    15\t    - \"po.get\"\n    16\t    - \"po.list\"\n    17\t  # Scope requested from the STS for each ERP operation; the ERP enforces it.\n    18\t  operation_scopes:\n    19\t    budget.get_remaining: \"erp.read\"\n    20\t    vendor.get: \"erp.read\"\n    21\t    vendor.search: \"erp.read\"\n    22\t    vendor.update_remit_to: \"erp.read erp.vendor.write\"\n    23\t    invoice.get: \"erp.read\"\n    24\t    invoice.list_open: \"erp.read\"\n    25\t    invoice.mark_paid: \"erp.read erp.invoice.write\"\n    26\t    invoice.void: \"erp.read erp.invoice.write\"\n    27\t    po.get: \"erp.read\"\n    28\t    po.list_open: \"erp.read\"\n    29\t    po.create: \"erp.read erp.po.create\"\n    30\t\n    31\tapprovals:\n    32\t  ttl_minutes: 60\n    33\t  approver_roles:\n    34\t    pay_invoice: [ap_manager, finance_controller]\n    35\t    create_purchase_order: [budget_owner, finance_controller]\n    36\t    post_slack_message: [procurement_lead]\n    37\t\n    38\tbudgets:\n    39\t  per_run:\n    40\t    max_steps: 25\n    41\t    max_wall_seconds: 300\n    42\t    max_tokens: 400000\n    43\t    max_cost_usd: 4.00\n    44\t    max_tool_calls_per_minute: 30\n    45\t    max_subagents: 3\n    46\t  quotas_daily_usd:\n    47\t    user: 25\n    48\t    tenant: 250\n    49\t    fleet: 1500\n    50\t  run_starts_per_minute:\n    51\t    user: 5\n    52\t    tenant: 40\n    53\t    fleet: 200\n     1\t# Tools per agent role, each with the task reason it is granted.\n     2\troles:\n     3\t  procurement:\n     4\t    tools:\n     5\t      read_document: \"Read vendor quotes, invoices and emails that arrived through the mail gateway.\"\n     6\t      extract_line_items: \"Delegate line-item extraction from long documents to the extractor.\"\n     7\t      get_budget: \"Check remaining department budget before raising a purchase order.\"\n     8\t      erp_call: \"Look up vendors, open invoices and purchase orders for matching.\"\n     9\t      create_purchase_order: \"Raise a purchase order once a quote is within budget and approved.\"\n    10\t      pay_invoice: \"Pay an invoice that is matched to a purchase order and approved.\"\n    11\t      post_slack_message: \"Ask staff for missing details and confirm orders with vendors.\"\n    12\t      memory_read: \"Recall department preferences and contract terms from earlier runs.\"\n    13\t      memory_write: \"Save new department preferences and contract terms.\"\n    14\t  extractor:\n    15\t    tools:\n    16\t      read_document: \"Read the document whose line items are being extracted.\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_016zEbttPmwxoeP8pyMRXT5R","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
