{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013zLWfwnjQqVa7o2p6QQ6sF","type":"tool_result","content":"\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n\nThe agent runs under its own Kubernetes service account. Its projected\nservice-account token is exchanged at the internal STS for short-lived,\naudience-bound tokens. The launching user's token is never forwarded to an\nintegration; the user is carried as the delegated subject of the exchange.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport time\nimport uuid\nfrom dataclasses import dataclass, field, replace\nfrom pathlib import Path\n\nimport httpx\n\nfrom app.settings import Settings\n\nIDENTITY_FIELDS = (\n    \"accountable_party\",\n    \"operational_owner\",\n    \"tenant\",\n    \"agent_type_id\",\n    \"agent_instance_id\",\n    \"trace_id\",\n)\n\n\n@dataclass(frozen=True)\nclass RunIdentity:\n    accountable_party: str\n    operational_owner: str\n    tenant: str\n    agent_type_id: str\n    agent_instance_id: str\n    trace_id: str\n    run_id: str\n    delegated_subject: str\n    agent_principal: str\n    parent_instance_id: str | None = None\n    role: str = \"procurement\"\n\n    def __post_init__(self) -> None:\n        for name in IDENTITY_FIELDS:\n            if not getattr(self, name):\n                raise ValueError(f\"identity field {name} is empty\")\n\n    def child(self, role: str) -> \"RunIdentity\":\n        return replace(\n            self,\n            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n            parent_instance_id=self.agent_instance_id,\n            role=role,\n        )\n\n\ndef new_instance_id() -> str:\n    return f\"inst-{uuid.uuid4()}\"\n\n\ndef compute_agent_type_id(manifest: dict) -> str:\n    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    material = {\n        \"image_digest\": manifest[\"image\"][\"digest\"],\n        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n        \"models\": manifest[\"models\"],\n        \"config\": manifest[\"config\"],\n        \"tools\": manifest[\"tool_pins\"],\n    }\n    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n\n\n@dataclass\nclass _CachedToken:\n    value: str\n    expires_at: float\n\n\n@dataclass\nclass TokenBroker:\n    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n\n    settings: Settings\n    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n\n    def _workload_token(self) -> str:\n        return Path(self.settings.workload_token_path).read_text().strip()\n\n    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n        key = (audience, scope, ident.tenant)\n        cached = self._cache.get(key)\n        if cached and cached.expires_at - 30 > time.time():\n            return cached.value\n        async with httpx.AsyncClient(timeout=5.0) as client:\n            resp = await client.post(\n                self.settings.sts_url,\n                data={\n                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n                    \"subject_token\": self._workload_token(),\n                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n                    \"audience\": audience,\n                    \"scope\": scope,\n                    \"resource\": f\"urn:bu:{ident.tenant}\",\n                    \"actor_token\": ident.delegated_subject,\n                    \"actor_token_type\": \"urn:example:params:subject-id\",\n                },\n            )\n            resp.raise_for_status()\n            body = resp.json()\n        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n        self._cache[key] = token\n        return token.value\n\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom dataclasses import dataclass\nfrom functools import lru_cache\nfrom pathlib import Path\n\nimport yaml\n\n\ndef _env(name: str, default: str | None = None) -> str:\n    value = os.environ.get(name, default)\n    if value is None:\n        raise RuntimeError(f\"missing required setting {name}\")\n    return value\n\n\n@dataclass(frozen=True)\nclass Settings:\n    database_url: str\n    erp_mcp_url: str\n    payments_api_url: str\n    slack_api_url: str\n    sts_url: str\n    oidc_issuer: str\n    oidc_audience: str\n    oidc_jwks_url: str\n    workload_token_path: str\n    slack_signing_secret_path: str\n    mail_gateway_hmac_path: str\n    model_id: str\n    extractor_model_id: str\n    manifest_path: Path\n    prompt_dir: Path\n    policy_path: Path\n    tools_path: Path\n    operational_owner: str\n    image_digest: str\n\n    @property\n    def policy(self) -> dict:\n        return _load_yaml(self.policy_path)\n\n    @property\n    def manifest(self) -> dict:\n        return _load_yaml(self.manifest_path)\n\n    @property\n    def budgets(self) -> dict:\n        return self.policy[\"budgets\"]\n\n\ndef _load_yaml(path: Path) -> dict:\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\n        return yaml.safe_load(fh)\n\n\n@lru_cache(maxsize=1)\ndef get_settings() -> Settings:\n    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    return Settings(\n        database_url=_env(\"DATABASE_URL\"),\n        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n        sts_url=_env(\"STS_URL\"),\n        oidc_issuer=_env(\"OIDC_ISSUER\"),\n        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n        workload_token_path=_env(\n            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n        ),\n        slack_signing_secret_path=_env(\n            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n        ),\n        mail_gateway_hmac_path=_env(\n            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n        ),\n        model_id=_env(\"MODEL_ID\"),\n        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n        manifest_path=root / \"release\" / \"manifest.yaml\",\n        prompt_dir=root / \"prompts\",\n        policy_path=root / \"config\" / \"policy.yaml\",\n        tools_path=root / \"config\" / \"tools.yaml\",\n        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n        image_digest=_env(\"IMAGE_DIGEST\"),\n    )\n# syntax=docker/dockerfile:1.10\nFROM python:3.11.10-slim-bookworm@sha256:2a6386ad2db20e7f55073f69a98d6da2cf9f168e05e7487d2670c22e4ad2a1bd AS build\nWORKDIR /src\nENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\nCOPY pyproject.toml ./\nCOPY app ./app\nRUN pip install --target /opt/site .\nRUN python -m compileall -q app\n\nFROM gcr.io/distroless/python3-debian12:nonroot@sha256:8f3c1a6e2b9d4f7a0c5e8b1d3f6a9c2e5b8d1f4a7c0e3b6d9f2a5c8e1b4d7f0a\nWORKDIR /app\nENV PYTHONPATH=/opt/site:/app \\\n    PYTHONDONTWRITEBYTECODE=1 \\\n    APP_ROOT=/app\nCOPY --from=build /opt/site /opt/site\nCOPY --from=build /src/app /app/app\nCOPY prompts /app/prompts\nCOPY config /app/config\nCOPY release/manifest.yaml /app/release/manifest.yaml\nUSER 65532:65532\nEXPOSE 8080\nENTRYPOINT [\"python\", \"-m\", \"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\", \"--no-server-header\"]\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: procurement-agent\n  namespace: procurement-prod\n  labels:\n    app: procurement-agent\n    owner: team-procurement-platform\nspec:\n  replicas: 3\n  selector:\n    matchLabels:\n      app: procurement-agent\n  template:\n    metadata:\n      labels:\n        app: procurement-agent\n    spec:\n      serviceAccountName: procurement-agent\n      automountServiceAccountToken: false\n      hostUsers: false\n      enableServiceLinks: false\n      securityContext:\n        runAsNonRoot: true\n        runAsUser: 65532\n        runAsGroup: 65532\n        fsGroup: 65532\n        seccompProfile:\n          type: RuntimeDefault\n      containers:\n        - name: agent\n          image: registry.example-corp.test/procurement/agent@sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\n          imagePullPolicy: IfNotPresent\n          ports:\n            - containerPort: 8080\n              name: http\n          env:\n            - name: IMAGE_DIGEST\n              value: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n            - name: MODEL_ID\n              value: \"claude-sonnet-4-5-20250929\"\n            - name: EXTRACTOR_MODEL_ID\n              value: \"claude-haiku-4-5-20251001\"\n            - name: DATABASE_URL\n              value: \"postgresql://procurement_agent@procurement-db.procurement-data.svc.cluster.local:5432/procurement?sslmode=verify-full\"\n            - name: ERP_MCP_URL\n              value: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n            - name: PAYMENTS_API_URL\n              value: \"https://api.payments.example-pay.test\"\n            - name: SLACK_API_URL\n              value: \"https://slack-proxy.egress.svc.cluster.local:8443/api\"\n            - name: STS_URL\n              value: \"https://sts.identity.svc.cluster.local/oauth2/token\"\n            - name: OIDC_ISSUER\n              value: \"https://login.example-corp.test\"\n            - name: OIDC_JWKS_URL\n              value: \"https://login.example-corp.test/.well-known/jwks.json\"\n            - name: HTTPS_PROXY\n              value: 