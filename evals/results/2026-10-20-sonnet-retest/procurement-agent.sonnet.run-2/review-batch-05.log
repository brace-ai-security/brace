{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C5nQZ1z8R1MrmPC6wskV1X","type":"tool_result","content":"        if tool.name in self.high_impact:\n            return await self._require_approval(ident, tool, args)\n\n        return Decision(True, \"low-impact tool\", self.version)\n\n    async def _require_approval(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n        target = tool.target_of(args)\n        approval = await self.approvals.find_valid(ident, tool.name, target)\n        if approval is not None:\n            return Decision(True, \"approved\", self.version, approval_id=approval.id)\n        approval_id = await self.approvals.request(ident, tool.name, target, args)\n        return Decision(\n            False,\n            \"approval required; request opened\",\n            self.version,\n            approval_id=approval_id,\n            pending=True,\n        )\n16:from app.audit import digest, summarize_args\n33:    def __init__(self, pool, policy: dict, notifier):\n39:    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n40:        approval_id = f\"apr-{uuid.uuid4()}\"\n50:            approval_id,\n63:            approval_id=approval_id,\n69:        return approval_id\n71:    async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:\n94:    async def decide(self, approval_id: str, approver: str, approver_role: str, approve: bool) -> None:\n96:            \"SELECT tool, status, expires_at FROM approvals WHERE id = $1\", approval_id\n110:            approval_id,\n81:    expires_at: float\n89:    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n96:        cached = self._cache.get(key)\n97:        if cached and cached.expires_at - 30 > time.time():\n115:        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n116:        self._cache[key] = token","is_error":fa