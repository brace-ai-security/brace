{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011BBUADLEXaQ2xyezDxur24","type":"tool_result","content":"1\t=== app/loop.py\n2\t     1\t\"\"\"Procurement agent run loop.\n3\t     2\t\n4\t     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n5\t     4\tEvery edge writes an audit node before the next step runs. Budgets are\n6\t     5\tchecked before each model turn and each tool call.\n7\t     6\t\"\"\"\n8\t     7\tfrom __future__ import annotations\n9\t     8\t\n10\t     9\timport hashlib\n11\t    10\timport logging\n12\t    11\tfrom dataclasses import dataclass, field\n13\t    12\tfrom typing import Any\n14\t    13\t\n15\t    14\tfrom opentelemetry import trace\n16\t    15\t\n17\t    16\tfrom app import audit, killswitch\n18\t    17\tfrom app.budget import Budget, BudgetExceeded\n19\t    18\tfrom app.context_size import ContextMeasure, measure_context\n20\t    19\tfrom app.gate import PolicyGate\n21\t    20\tfrom app.identity import RunIdentity\n22\t    21\tfrom app.redact import redact_for_model\n23\t    22\tfrom app.tools import ToolRegistry, build_registry\n24\t    23\t\n25\t    24\tlog = logging.getLogger(__name__)\n26\t    25\ttracer = trace.get_tracer(\"procurement.loop\")\n27\t    26\t\n28\t    27\tCOMPACT_AFTER_MESSAGES = 40\n29\t    28\tKEEP_RECENT_MESSAGES = 12\n30\t    29\t\n31\t    30\t\n32\t    31\t@dataclass\n33\t    32\tclass AgentDeps:\n34\t    33\t    settings: Any\n35\t    34\t    pool: Any\n36\t    35\t    gate: PolicyGate\n37\t    36\t    erp: Any\n38\t    37\t    slack: Any\n39\t    38\t    broker: Any\n40\t    39\t    extractor: Any = None\n41\t    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n42\t    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n43\t    42\t\n44\t    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n45\t    44\t        return self._budgets[ident.run_id]\n46\t    45\t\n47\t    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n48\t    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n49\t    48\t\n50\t    49\t    def erp_scope_for(self, operation: str) -> str:\n51\t    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n52\t    51\t        return scopes.get(operation, \"erp.read\")\n53\t    52\t\n54\t    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n55\t    54\t        self._contexts[ident.agent_instance_id] = ctx\n56\t    55\t        proposed = await audit.record(\n57\t    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n58\t    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n59\t    58\t        )\n60\t    59\t        tool = registry.get(use.name)\n61\t    60\t        if tool is None:\n62\t    61\t            await audit.record(\n63\t    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n64\t    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n65\t    64\t            )\n66\t    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n67\t    66\t\n68\t    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n69\t    68\t        authz = await audit.record(\n70\t    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n71\t    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n72\t    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n73\t    72\t        )\n74\t    73\t        if not decision.allow:\n75\t    74\t            if decision.pending:\n76\t    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n77\t    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n78\t    77\t\n79\t    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n80\t    79\t        try:\n81\t    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n82\t    81\t                for k, v in ctx.otel_attributes().items():\n83\t    82\t                    span.set_attribute(k, v)\n84\t    83\t                output = await tool.invoke(use.input, ident)\n85\t    84\t        except BudgetExceeded:\n86\t    85\t            raise\n87\t    86\t        except Exception as exc:\n88\t    87\t            await audit.record(\n89\t    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n90\t    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n91\t    90\t                operation_id=operation_id,\n92\t    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n93\t    92\t            )\n94\t    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n95\t    94\t\n96\t    95\t        await audit.record(\n97\t    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n98\t    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n99\t    98\t            operation_id=operation_id,\n100\t    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n101\t   100\t        )\n102\t   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n103\t   102\t\n104\t   103\t\n105\t   104\tdef _error(tool_use_id: str, message: str) -> dict:\n106\t   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n107\t   106\t\n108\t   107\t\n109\t   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n110\t   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n111\t   110\t        return messages, False\n112\t   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n113\t   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n114\t   113\t        tail = tail[1:]\n115\t   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n116\t   115\t    return head + [note] + tail, True\n117\t   116\t\n118\t   117\t\n119\t   118\tclass ProcurementAgent:\n120\t   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n121\t   120\t        self.client = client\n122\t   121\t        self.deps = deps\n123\t   122\t        self.system_prompt = system_prompt\n124\t   123\t        self.role = role\n125\t   124\t\n126\t   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n127\t   126\t        pool = self.deps.pool\n128\t   127\t        await killswitch.assert_running(pool, ident.tenant)\n129\t   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n130\t   129\t        await budget.reserve_run_start(pool)\n131\t   130\t        self.deps._budgets[ident.run_id] = budget\n132\t   131\t        registry = build_registry(self.role, ident, self.deps)\n133\t   132\t\n134\t   133\t        run_node = await audit.record(\n135\t   134\t            pool, ident, kind=\"run_started\",\n136\t   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n137\t   136\t        )\n138\t   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n139\t   138\t        try:\n140\t   139\t            while True:\n141\t   140\t                budget.check_step()\n142\t   141\t                messages, compacted = _compact(messages)\n143\t   142\t                request = {\n144\t   143\t                    \"model\": self.deps.settings.model_id,\n145\t   144\t                    \"system\": self.system_prompt,\n146\t   145\t                    \"messages\": messages,\n147\t   146\t                    \"tools\": registry.schemas(),\n148\t   147\t                    \"max_tokens\": 4096,\n149\t   148\t                }\n150\t   149\t                ctx = await measure_context(self.client, request, compacted)\n151\t   150\t                response = await self.client.messages.create(**request)\n152\t   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n153\t   152\t                await budget.flush(pool)\n154\t   153\t                ctx = ctx.finalize(response.usage)\n155\t   154\t                decision = await audit.record(\n156\t   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n157\t   156\t                    payload={\n158\t   157\t                        \"requested_model\": request[\"model\"],\n159\t   158\t                        \"served_model\": response.model,\n160\t   159\t                        \"stop_reason\": response.stop_reason,\n161\t   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n162\t   161\t                    },\n163\t   162\t                )\n164\t   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n165\t   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n166\t   165\t                if not uses:\n167\t   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n168\t   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n169\t   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n170\t   169\t                    return final\n171\t   170\t                results = []\n172\t   171\t                for use in uses:\n173\t   172\t                    budget.check_tool_call()\n174\t   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n175\t   174\t                messages.append({\"role\": \"user\", \"content\": results})\n176\t   175\t        except BudgetExceeded as exc:\n177\t   176\t            await audit.record(\n178\t   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n179\t   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n180\t   179\t            )\n181\t   180\t            await self.deps.slack.post(\n182\t   181\t                channel=\"#procurement-agent-ops\",\n183\t   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n184\t   183\t            )\n185\t   184\t            return None\n186\t   185\t        finally:\n187\t   186\t            self.deps._budgets.pop(ident.run_id, None)\n188\t=== app/killswitch.py\n189\t     1\t\"\"\"Operator stop control.\n190\t     2\t\n191\t     3\tOperators halt the fleet or one business unit by setting a row in\n192\t     4\t``control_flags`` with the ``procurement_ops`` database role (see\n193\t     5\tops/README in the platform runbook). The agent's own database role has\n194\t     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n195\t     7\t\"\"\"\n196\t     8\tfrom __future__ import annotations\n197\t     9\t\n198\t    10\t\n199\t    11\tclass AgentHalted(Exception):\n200\t    12\t    pass\n201\t    13\t\n202\t    14\t\n203\t    15\t_QUERY = \"\"\"\n204\t    16\tSELECT scope, reason, set_by, set_at\n205\t    17\tFROM control_flags\n206\t    18\tWHERE halted\n207\t    19\t  AND (scope = 'fleet' OR scope = $1)\n208\t    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n209\t    21\tLIMIT 1\n210\t    22\t\"\"\"\n211\t    23\t\n212\t    24\t\n213\t    25\tasync def assert_running(pool, tenant: str) -> None:\n214\t    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n215\t    27\t    if row is not None:\n216\t    28\t        raise AgentHalted(\n217\t    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n218\t    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n219\t    31\t        )\n220\t=== app/audit.py\n221\t     1\t\"\"\"Execution audit graph.\n222\t     2\t\n223\t     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n224\t     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n225\t     5\ttool call -> authorization decision -> result or error. Writes are\n226\t     6\tsynchronous and are made before the action they describe; if the write\n227\t     7\tfails, the caller raises and the action does not run.\n228\t     8\t\"\"\"\n229\t     9\tfrom __future__ import annotations\n230\t    10\t\n231\t    11\timport hashlib\n232\t    12\timport json\n233\t    13\timport uuid\n234\t    14\tfrom datetime import datetime, timezone\n235\t    15\tfrom typing import Any\n236\t    16\t\n237\t    17\tfrom opentelemetry import trace\n238\t    18\t\n239\t    19\tfrom app.context_size import ContextMeasure\n240\t    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n241\t    21\tfrom app.redact import redact_value\n242\t    22\t\n243\t    23\tEVENT_KINDS = {\n244\t    24\t    \"run_started\",\n245\t    25\t    \"run_finished\",\n246\t    26\t    \"run_halted\",\n247\t    27\t    \"model_decision\",\n248\t    28\t    \"tool_proposed\",\n249\t    29\t    \"authz_decision\",\n250\t    30\t    \"approval_requested\",\n251\t    31\t    \"approval_decided\",\n252\t    32\t    \"tool_result\",\n253\t    33\t    \"tool_error\",\n254\t    34\t    \"tool_denied\",\n255\t    35\t    \"budget_exceeded\",\n256\t    36\t    \"subagent_started\",\n257\t    37\t    \"subagent_finished\",\n258\t    38\t    \"background_job\",\n259\t    39\t}\n260\t    40\t\n261\t    41\t_INSERT = \"\"\"\n262\t    42\tINSERT INTO audit_events (\n263\t    43\t    node_id, parent_node_id, run_id, ts, kind,\n264\t    44\t    accountable_party, operational_owner, tenant,\n265\t    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n266\t    46\t    delegated_subject, agent_principal, parent_instance_id,\n267\t    47\t    policy_version, approval_id, operation_id,\n268\t    48\t    context_tokens, context_method, context_compacted,\n269\t    49\t    payload\n270\t    50\t) VALUES (\n271\t    51\t    $1, $2, $3, $4, $5,\n272\t    52\t    $6, $7, $8,\n273\t    53\t    $9, $10, $11, $12,\n274\t    54\t    $13, $14, $15,\n275\t    55\t    $16, $17, $18,\n276\t    56\t    $19, $20, $21,\n277\t    57\t    $22::jsonb\n278\t    58\t)\n279\t    59\t\"\"\"\n280\t    60\t\n281\t    61\t\n282\t    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n283\t    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n284\t    64\t    return {k: redact_value(v) for k, v in args.items()}\n285\t    65\t\n286\t    66\t\n287\t    67\tdef digest(value: Any) -> str:\n288\t    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n289\t    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n290\t    70\t\n291\t    71\t\n292\t    72\tasync def record(\n293\t    73\t    pool,\n294\t    74\t    ident: RunIdentity,\n295\t    75\t    *,\n296\t    76\t    kind: str,\n297\t    77\t    payload: dict[str, Any] | None = None,\n298\t    78\t    parent: str | None = None,\n299\t    79\t    context: ContextMeasure | None = None,\n300\t    80\t    policy_version: str | None = None,\n301\t    81\t    approval_id: str | None = None,\n302\t    82\t    operation_id: str | None = None,\n303\t    83\t) -> str:\n304\t    84\t    if kind not in EVENT_KINDS:\n305\t    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n306\t    86\t    for name in IDENTITY_FIELDS:\n307\t    87\t        if not getattr(ident, name):\n308\t    88\t            raise ValueError(f\"audit record missing {name}\")\n309\t    89\t    span_ctx = trace.get_current_span().get_span_context()\n310\t    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n311\t    91\t    node_id = f\"node-{uuid.uuid4()}\"\n312\t    92\t    measure = context or ContextMeasure.unavailable()\n313\t    93\t    await pool.execute(\n314\t    94\t        _INSERT,\n315\t    95\t        node_id,\n316\t    96\t        parent,\n317\t    97\t        ident.run_id,\n318\t    98\t        datetime.now(timezone.utc),\n319\t    99\t        kind,\n320\t   100\t        ident.accountable_party,\n321\t   101\t        ident.operational_owner,\n322\t   102\t        ident.tenant,\n323\t   103\t        ident.agent_type_id,\n324\t   104\t        ident.agent_instance_id,\n325\t   105\t        ident.trace_id,\n326\t   106\t        span_id,\n327\t   107\t        ident.delegated_subject,\n328\t   108\t        ident.agent_principal,\n329\t   109\t        ident.parent_instance_id,\n330\t   110\t        policy_version,\n331\t   111\t        approval_id,\n332\t   112\t        operation_id,\n333\t   113\t        measure.tokens,\n334\t   114\t        measure.method,\n335\t   115\t        measure.compacted,\n336\t   116\t        json.dumps(redact_value(payload or {}), default=str),\n337\t   117\t    )\n338\t   118\t    return node_id\n339\t=== app/main.py\n340\t     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n341\t     2\tfrom __future__ import annotations\n342\t     3\t\n343\t     4\timport asyncio\n344\t     5\timport hashlib\n345\t     6\timport hmac\n346\t     7\timport json\n347\t     8\timport logging\n348\t     9\timport time\n349\t    10\timport uuid\n350\t    11\tfrom contextlib import asynccontextmanager\n351\t    12\tfrom pathlib import Path\n352\t    13\tfrom urllib.parse import parse_qs\n353\t    14\t\n354\t    15\timport asyncpg\n355\t    16\timport jwt\n356\t    17\tfrom anthropic import AsyncAnthropic\n357\t    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n358\t    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n359\t    20\tfrom opentelemetry import trace\n360\t    21\tfrom pydantic import BaseModel, Field\n361\t    22\t\n362\t    23\tfrom app import audit, ingest\n363\t    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n364\t    25\tfrom app.extractor import LineItemExtractor\n365\t    26\tfrom app.gate import PolicyGate\n366\t    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n367\t    28\tfrom app.loop import AgentDeps, ProcurementAgent\n368\t    29\tfrom app.mcp_client import ErpMcpClient\n369\t    30\tfrom app.redact import RedactingFilter\n370\t    31\tfrom app.settings import get_settings\n371\t    32\tfrom app.startup import startup_checks\n372\t    33\tfrom app.tools.slack import SlackClient\n373\t    34\t\n374\t    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n375\t    36\tfor handler in logging.getLogger().handlers:\n376\t    37\t    handler.addFilter(RedactingFilter())\n377\t    38\tlog = logging.getLogger(\"procurement\")\n378\t    39\t\n379\t    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n380\t    41\tbearer = HTTPBearer()\n381\t    42\t\n382\t    43\t\n383\t    44\tclass RunRequest(BaseModel):\n384\t    45\t    task: str = Field(min_length=1, max_length=4000)\n385\t    46\t    department: str = Field(min_length=1, max_length=64)\n386\t    47\t\n387\t    48\t\n388\t    49\tclass Principal(BaseModel):\n389\t    50\t    subject: str\n390\t    51\t    business_unit: str\n391\t    52\t\n392\t    53\t\n393\t    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n394\t    55\t    return RunIdentity(\n395\t    56\t        accountable_party=\"system:procurement-agent\",\n396\t    57\t        operational_owner=settings.operational_owner,\n397\t    58\t        tenant=tenant,\n398\t    59\t        agent_type_id=agent_type_id,\n399\t    60\t        agent_instance_id=new_instance_id(),\n400\t    61\t        trace_id=uuid.uuid4().hex,\n401\t    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n402\t    63\t        delegated_subject=\"system:procurement-agent\",\n403\t    64\t        agent_principal=AGENT_PRINCIPAL,\n404\t    65\t    )\n405\t    66\t\n406\t    67\t\n407\t    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n408\t    69\t    while True:\n409\t    70\t        await asyncio.sleep(60)\n410\t    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n411\t    72\t        count = await app.state.pool.fetchval(\n412\t    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n413\t    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n414\t    75\t        )\n415\t    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n416\t    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n417\t    78\t\n418\t    79\t\n419\t    80\t@asynccontextmanager\n420\t    81\tasync def lifespan(app: FastAPI):\n421\t    82\t    settings = get_settings()\n422\t    83\t    agent_type_id = startup_checks(settings)\n423\t    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n424\t    85\t    broker = TokenBroker(settings)\n425\t    86\t\n426\t    87\t    async def slack_token() -> str:\n427\t    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n428\t    89\t\n429\t    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n430\t    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n431\t    92\t    gate = PolicyGate(settings.policy, approvals)\n432\t    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n433\t    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n434\t    95\t\n435\t    96\t    client = AsyncAnthropic()\n436\t    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n437\t    98\t    deps.extractor = LineItemExtractor(\n438\t    99\t        client=client, settings=settings, deps=deps,\n439\t   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n440\t   101\t    )\n441\t   102\t    app.state.settings = settings\n442\t   103\t    app.state.pool = pool\n443\t   104\t    app.state.agent_type_id = agent_type_id\n444\t   105\t    app.state.approvals = approvals\n445\t   106\t    app.state.agent = ProcurementAgent(\n446\t   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n447\t   108\t    )\n448\t   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n449\t   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n450\t   111\t    try:\n451\t   112\t        yield\n452\t   113\t    finally:\n453\t   114\t        sweeper.cancel()\n454\t   115\t        await pool.close()\n455\t   116\t\n456\t   117\t\n457\t   118\tapp = FastAPI(lifespan=lifespan)\n458\t   119\tapp.include_router(ingest.router)\n459\t   120\t\n460\t   121\t\n461\t   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n462\t   123\t    settings = request.app.state.settings\n463\t   124\t    try:\n464\t   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n465\t   126\t        claims = jwt.decode(\n466\t   127\t            creds.credentials,\n467\t   128\t            key.key,\n468\t   129\t            algorithms=[\"RS256\", \"ES256\"],\n469\t   130\t            audience=settings.oidc_audience,\n470\t   131\t            issuer=settings.oidc_issuer,\n471\t   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n472\t   133\t        )\n473\t   134\t    except jwt.PyJWTError as exc:\n474\t   135\t        raise HTTPException(401, \"invalid token\") from exc\n475\t   136\t    bu = claims.get(\"bu\")\n476\t   137\t    if not bu:\n477\t   138\t        raise HTTPException(403, \"token has no business unit\")\n478\t   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n479\t   140\t\n480\t   141\t\n481\t   142\t@app.post(\"/runs\")\n482\t   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n483\t   144\t    settings = request.app.state.settings\n484\t   145\t    span_ctx = trace.get_current_span().get_span_context()\n485\t   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n486\t   147\t    ident = RunIdentity(\n487\t   148\t        accountable_party=principal.subject,\n488\t   149\t        operational_owner=settings.operational_owner,\n489\t   150\t        tenant=principal.business_unit,\n490\t   151\t        agent_type_id=request.app.state.agent_type_id,\n491\t   152\t        agent_instance_id=new_instance_id(),\n492\t   153\t        trace_id=trace_id,\n493\t   154\t        run_id=f\"run-{uuid.uuid4()}\",\n494\t   155\t        delegated_subject=principal.subject,\n495\t   156\t        agent_principal=AGENT_PRINCIPAL,\n496\t   157\t    )\n497\t   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n498\t   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n499\t   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n500\t   161\t\n501\t   162\t\n502\t   163\t@app.post(\"/slack/interactions\")\n503\t   164\tasync def slack_interactions(request: Request) -> dict:\n504\t   165\t    body = await request.body()\n505\t   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n506\t   167\t    if abs(time.time() - int(timestamp)) > 300:\n507\t   168\t        raise HTTPException(401, \"stale request\")\n508\t   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n509\t   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n510\t   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n511\t   172\t        raise HTTPException(401, \"bad signature\")\n512\t   173\t\n513\t   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n514\t   175\t    action = payload[\"actions\"][0]\n515\t   176\t    slack_user = payload[\"user\"][\"id\"]\n516\t   177\t    row = await request.app.state.pool.fetchrow(\n517\t   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n518\t   179\t    )\n519\t   180\t    if row is None:\n520\t   181\t        raise HTTPException(403, \"not an approver\")\n521\t   182\t    try:\n522\t   183\t        await request.app.state.approvals.decide(\n523\t   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n524\t   185\t            approve=action[\"action_id\"] == \"approve\",\n525\t   186\t        )\n526\t   187\t    except ApproverNotAuthorized as exc:\n527\t   188\t        raise HTTPException(403, str(exc)) from exc\n528\t   189\t    except ValueError as exc:\n529\t   190\t        raise HTTPException(409, str(exc)) from exc\n530\t   191\t    return {\"ok\": True}\n531\t   192\t\n532\t   193\t\n533\t   194\t@app.get(\"/healthz\")\n534\t   195\tasync def healthz() -> dict:\n535\t   196\t    return {\"ok\": True}\n536\t=== app/extractor.py\n537\t     1\t\"\"\"Line-item extraction sub-agent.\n538\t     2\t\n539\t     3\tThe parent procurement agent delegates structured extraction to a smaller\n540\t     4\tmodel. The child runs under its own instance id, links to its parent in the\n541\t     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n542\t     6\t\"\"\"\n543\t     7\tfrom __future__ import annotations\n544\t     8\t\n545\t     9\timport json\n546\t    10\timport logging\n547\t    11\tfrom typing import Any\n548\t    12\t\n549\t    13\tfrom opentelemetry import trace\n550\t    14\t\n551\t    15\tfrom app import audit\n552\t    16\tfrom app.budget import Budget\n553\t    17\tfrom app.context_size import measure_context\n554\t    18\tfrom app.identity import RunIdentity\n555\t    19\tfrom app.redact import redact_for_model\n556\t    20\tfrom app.tools import build_registry\n557\t    21\t\n558\t    22\tlog = logging.getLogger(__name__)\n559\t    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n560\t    24\t\n561\t    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n562\t    26\tMAX_TURNS = 4\n563\t    27\t\n564\t    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n565\t    29\t\n566\t    30\t\n567\t    31\tclass ExtractionFailed(Exception):\n568\t    32\t    pass\n569\t    33\t\n570\t    34\t\n571\t    35\tclass LineItemExtractor:\n572\t    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n573\t    37\t        self.client = client\n574\t    38\t        self.settings = settings\n575\t    39\t        self.deps = deps\n576\t    40\t        self.system_prompt = system_prompt\n577\t    41\t\n578\t    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n579\t    43\t        budget.check_subagent()\n580\t    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n581\t    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n582\t    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n583\t    47\t\n584\t    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n585\t    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n586\t    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n587\t    51\t            start_node = await audit.record(\n588\t    52\t                self.deps.pool,\n589\t    53\t                ident,\n590\t    54\t                kind=\"subagent_started\",\n591\t    55\t                payload={\n592\t    56\t                    \"role\": EXTRACTOR_ROLE,\n593\t    57\t                    \"doc_id\": doc_id,\n594\t    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n595\t    59\t                    \"tools\": registry.names(),\n596\t    60\t                },\n597\t    61\t            )\n598\t    62\t\n599\t    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n600\t    64\t            for _turn in range(MAX_TURNS):\n601\t    65\t                budget.check_step()\n602\t    66\t                request = {\n603\t    67\t                    \"model\": self.settings.extractor_model_id,\n604\t    68\t                    \"system\": self.system_prompt,\n605\t    69\t                    \"messages\": messages,\n606\t    70\t                    \"tools\": registry.schemas(),\n607\t    71\t                    \"max_tokens\": 4096,\n608\t    72\t                }\n609\t    73\t                ctx = await measure_context(self.client, request, compacted=False)\n610\t    74\t                response = await self.client.messages.create(**request)\n611\t    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n612\t    76\t                await budget.flush(self.deps.pool)\n613\t    77\t                ctx = ctx.finalize(response.usage)\n614\t    78\t                decision = await audit.record(\n615\t    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n616\t    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n617\t    81\t                             \"stop_reason\": response.stop_reason},\n618\t    82\t                )\n619\t    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n620\t    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n621\t    85\t                if not uses:\n622\t    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n623\t    87\t                    items = _parse_items(text)\n624\t    88\t                    await audit.record(\n625\t    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n626\t    90\t                        payload={\"items\": len(items)},\n627\t    91\t                    )\n628\t    92\t                    return items\n629\t    93\t                results = []\n630\t    94\t                for use in uses:\n631\t    95\t                    budget.check_tool_call()\n632\t    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n633\t    97\t                messages.append({\"role\": \"user\", \"content\": results})\n634\t    98\t\n635\t    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n636\t   100\t\n637\t   101\t\n638\t   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n639\t   103\t    try:\n640\t   104\t        data = json.loads(text)\n641\t   105\t    except json.JSONDecodeError as exc:\n642\t   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n643\t   107\t    if not isinstance(data, list) or len(data) > 500:\n644\t   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n645\t   109\t    items = []\n646\t   110\t    for raw in data:\n647\t   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n648\t   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n649\t   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n650\t   114\t    return items\n651\t=== app/budget.py\n652\t     1\t\"\"\"Hard execution budgets, enforced by the harness and not by the model.\n653\t     2\t\n654\t     3\tPer run: step count, wall-clock time, tokens, cost, tool-call rate, and\n655\t     4\tnumber of sub-agents. Sub-agents charge the parent's budget, so a child\n656\t     5\tcannot widen what the parent was given.\n657\t     6\t\n658\t     7\tAcross runs: daily spend and per-minute run starts per user, per tenant\n659\t     8\t(business unit), and for the whole fleet. Quotas are reserved in Postgres\n660\t     9\tinside one transaction, so concurrent runs cannot overshoot them.\n661\t    10\t\"\"\"\n662\t    11\tfrom __future__ import annotations\n663\t    12\t\n664\t    13\timport time\n665\t    14\tfrom collections import deque\n666\t    15\tfrom dataclasses import dataclass, field\n667\t    16\tfrom decimal import Decimal\n668\t    17\t\n669\t    18\tfrom app.identity import RunIdentity\n670\t    19\t\n671\t    20\t\n672\t    21\tclass BudgetExceeded(Exception):\n673\t    22\t    def __init__(self, limit: str, used, allowed):\n674\t    23\t        super().__init__(f\"{limit} exceeded: used={used} allowed={allowed}\")\n675\t    24\t        self.limit = limit\n676\t    25\t        self.used = used\n677\t    26\t        self.allowed = allowed\n678\t    27\t\n679\t    28\t\n680\t    29\t# USD per million tokens, from the provider price sheet referenced in the manifest.\n681\t    30\tPRICES = {\n682\t    31\t    \"claude-sonnet-4-5-20250929\": (Decimal(\"3.00\"), Decimal(\"15.00\")),\n683\t    32\t    \"claude-haiku-4-5-20251001\": (Decimal(\"1.00\"), Decimal(\"5.00\")),\n684\t    33\t}\n685\t    34\t\n686\t    35\t\n687\t    36\t@dataclass\n688\t    37\tclass Budget:\n689\t    38\t    ident: RunIdentity\n690\t    39\t    max_steps: int\n691\t    40\t    max_wall_seconds: float\n692\t    41\t    max_tokens: int\n693\t    42\t    max_cost_usd: Decimal\n694\t    43\t    max_tool_calls_per_minute: int\n695\t    44\t    max_subagents: int\n696\t    45\t    quotas_daily_usd: dict[str, Decimal]\n697\t    46\t    run_starts_per_minute: dict[str, int]\n698\t    47\t    started_at: float = field(default_factory=time.monotonic)\n699\t    48\t    steps: int = 0\n700\t    49\t    tokens: int = 0\n701\t    50\t    cost_usd: Decimal = Decimal(\"0\")\n702\t    51\t    unflushed_cost_usd: Decimal = Decimal(\"0\")\n703\t    52\t    subagents: int = 0\n704\t    53\t    _tool_calls: deque = field(default_factory=deque)\n705\t    54\t\n706\t    55\t    @classmethod\n707\t    56\t    def for_run(cls, cfg: dict, ident: RunIdentity) -> \"Budget\":\n708\t    57\t        run = cfg[\"per_run\"]\n709\t    58\t        return cls(\n710\t    59\t            ident=ident,\n711\t    60\t            max_steps=int(run[\"max_steps\"]),\n712\t    61\t            max_wall_seconds=float(run[\"max_wall_seconds\"]),\n713\t    62\t            max_tokens=int(run[\"max_tokens\"]),\n714\t    63\t            max_cost_usd=Decimal(str(run[\"max_cost_usd\"])),\n715\t    64\t            max_tool_calls_per_minute=int(run[\"max_tool_calls_per_minute\"]),\n716\t    65\t            max_subagents=int(run[\"max_subagents\"]),\n717\t    66\t            quotas_daily_usd={k: Decimal(str(v)) for k, v in cfg[\"quotas_daily_usd\"].items()},\n718\t    67\t            run_starts_per_minute={k: int(v) for k, v in cfg[\"run_starts_per_minute\"].items()},\n719\t    68\t        )\n720\t    69\t\n721\t    70\t    def _scopes(self) -> list[tuple[str, str]]:\n722\t    71\t        return [\n723\t    72\t            (\"user\", self.ident.accountable_party),\n724\t    73\t            (\"tenant\", self.ident.tenant),\n725\t    74\t            (\"fleet\", \"all\"),\n726\t    75\t        ]\n727\t    76\t\n728\t    77\t    # --- per-run limits -------------------------------------------------\n729\t    78\t\n730\t    79\t    def check_step(self) -> None:\n731\t    80\t        self.steps += 1\n732\t    81\t        if self.steps > self.max_steps:\n733\t    82\t            raise BudgetExceeded(\"max_steps\", self.steps, self.max_steps)\n734\t    83\t        elapsed = time.monotonic() - self.started_at\n735\t    84\t        if elapsed > self.max_wall_seconds:\n736\t    85\t            raise BudgetExceeded(\"max_wall_seconds\", round(elapsed, 1), self.max_wall_seconds)\n737\t    86\t\n738\t    87\t    def charge_model(self, model: str, usage) -> None:\n739\t    88\t        price_in, price_out = PRICES[model]\n740\t    89\t        tokens_in = (\n741\t    90\t            int(usage.input_tokens or 0)\n742\t    91\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n743\t    92\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n744\t    93\t        )\n745\t    94\t        tokens_out = int(usage.output_tokens or 0)\n746\t    95\t        self.tokens += tokens_in + tokens_out\n747\t    96\t        cost = (price_in * tokens_in + price_out * tokens_out) / Decimal(1_000_000)\n748\t    97\t        self.cost_usd += cost\n749\t    98\t        self.unflushed_cost_usd += cost\n750\t    99\t        if self.tokens > self.max_tokens:\n751\t   100\t            raise BudgetExceeded(\"max_tokens\", self.tokens, self.max_tokens)\n752\t   101\t        if self.cost_usd > self.max_cost_usd:\n753\t   102\t            raise BudgetExceeded(\"max_cost_usd\", self.cost_usd, self.max_cost_usd)\n754\t   103\t\n755\t   104\t    def check_tool_call(self, now: float | None = None) -> None:\n756\t   105\t        now = time.monotonic() if now is None else now\n757\t   106\t        while self._tool_calls and now - self._tool_calls[0] > 60:\n758\t   107\t            self._tool_calls.popleft()\n759\t   108\t        if len(self._tool_calls) >= self.max_tool_calls_per_minute:\n760\t   109\t            raise BudgetExceeded(\n761\t   110\t                \"max_tool_calls_per_minute\", len(self._tool_calls) + 1, self.max_tool_calls_per_minute\n762\t   111\t            )\n763\t   112\t        self._tool_calls.append(now)\n764\t   113\t\n765\t   114\t    def check_subagent(self) -> None:\n766\t   115\t        if self.subagents >= self.max_subagents:\n767\t   116\t            raise BudgetExceeded(\"max_subagents\", self.subagents + 1, self.max_subagents)\n768\t   117\t        self.subagents += 1\n769\t   118\t\n770\t   119\t    # --- cross-run quotas -----------------------------------------------\n771\t   120\t\n772\t   121\t    async def reserve_run_start(self, pool) -> None:\n773\t   122\t        async with pool.acquire() as conn:\n774\t   123\t            async with conn.transaction():\n775\t   124\t                for scope, key in self._scopes():\n776\t   125\t                    limit = self.run_starts_per_minute[scope]\n777\t   126\t                    count = await conn.fetchval(\n778\t   127\t                        \"\"\"\n779\t   128\t                        INSERT INTO run_start_window (scope, key, minute, starts)\n780\t   129\t                        VALUES ($1, $2, date_trunc('minute', now()), 1)\n781\t   130\t                        ON CONFLICT (scope, key, minute)\n782\t   131\t                        DO UPDATE SET starts = run_start_window.starts + 1\n783\t   132\t                        RETURNING starts\n784\t   133\t                        \"\"\",\n785\t   134\t                        scope,\n786\t   135\t                        key,\n787\t   136\t                    )\n788\t   137\t                    if count > limit:\n789\t   138\t                        raise BudgetExceeded(f\"run_starts_per_minute.{scope}\", count, limit)\n790\t   139\t\n791\t   140\t    async def flush(self, pool) -> None:\n792\t   141\t        \"\"\"Add this run's unflushed spend to the daily quotas, or stop the run.\"\"\"\n793\t   142\t        if self.unflushed_cost_usd <= 0:\n794\t   143\t            return\n795\t   144\t        amount = self.unflushed_cost_usd\n796\t   145\t        async with pool.acquire() as conn:\n797\t   146\t            async with conn.transaction():\n798\t   147\t                for scope, key in self._scopes():\n799\t   148\t                    limit = self.quotas_daily_usd[scope]\n800\t   149\t                    spent = await conn.fetchval(\n801\t   150\t                        \"\"\"\n802\t   151\t                        INSERT INTO spend_quota (scope, key, day, spent_usd)\n803\t   152\t                        VALUES ($1, $2, current_date, $3)\n804\t   153\t                        ON CONFLICT (scope, key, day)\n805\t   154\t                        DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd\n806\t   155\t                        RETURNING spent_usd\n807\t   156\t                        \"\"\",\n808\t   157\t                        scope,\n809\t   158\t                        key,\n810\t   159\t                        amount,\n811\t   160\t                    )\n812\t   161\t                    if spent > limit:\n813\t   162\t                        raise BudgetExceeded(f\"quota_daily_usd.{scope}\", spent, limit)\n814\t   163\t        self.unflushed_cost_usd = Decimal(\"0\")\n815\t=== app/context_size.py\n816\t     1\t\"\"\"Decision-time context size.\n817\t     2\t\n818\t     3\tCounting method (documented in README, \"Context size\"):\n819\t     4\t\n820\t     5\t1. Before each model call, the exact request (system prompt, messages and\n821\t     6\t   tool schemas) is sent to the provider's token-counting endpoint. The\n822\t     7\t   returned ``input_tokens`` is recorded with method ``count_tokens_api``.\n823\t     8\t   This is the size of the context the model decides on, including any\n824\t     9\t   prefix that will be served from the prompt cache.\n825\t    10\t2. If counting fails, the value is taken after the call from the response\n826\t    11\t   usage as ``input_tokens + cache_read_input_tokens +\n827\t    12\t   cache_creation_input_tokens`` and recorded with method\n828\t    13\t   ``usage_sum_estimate``.\n829\t    14\t3. If neither is available the value is ``NULL`` with method\n830\t    15\t   ``unavailable``. It is never recorded as zero.\n831\t    16\t\n832\t    17\t``compacted`` is true when the harness dropped or summarized earlier turns\n833\t    18\tbefore this call. Provider-side truncation is not visible to the harness and\n834\t    19\tis listed as a known limit.\n835\t    20\t\"\"\"\n836\t    21\tfrom __future__ import annotations\n837\t    22\t\n838\t    23\timport logging\n839\t    24\tfrom dataclasses import dataclass, replace\n840\t    25\t\n841\t    26\tlog = logging.getLogger(__name__)\n842\t    27\t\n843\t    28\t\n844\t    29\t@dataclass(frozen=True)\n845\t    30\tclass ContextMeasure:\n846\t    31\t    tokens: int | None\n847\t    32\t    method: str\n848\t    33\t    compacted: bool\n849\t    34\t\n850\t    35\t    @classmethod\n851\t    36\t    def unavailable(cls, compacted: bool = False) -> \"ContextMeasure\":\n852\t    37\t        return cls(tokens=None, method=\"unavailable\", compacted=compacted)\n853\t    38\t\n854\t    39\t    def finalize(self, usage) -> \"ContextMeasure\":\n855\t    40\t        if self.tokens is not None:\n856\t    41\t            return self\n857\t    42\t        if usage is None:\n858\t    43\t            return ContextMeasure.unavailable(self.compacted)\n859\t    44\t        total = (\n860\t    45\t            int(usage.input_tokens or 0)\n861\t    46\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n862\t    47\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n863\t    48\t        )\n864\t    49\t        if total <= 0:\n865\t    50\t            return ContextMeasure.unavailable(self.compacted)\n866\t    51\t        return replace(self, tokens=total, method=\"usage_sum_estimate\")\n867\t    52\t\n868\t    53\t    def otel_attributes(self) -> dict:\n869\t    54\t        attrs = {\n870\t    55\t            \"procurement.context.method\": self.method,\n871\t    56\t            \"gen_ai.conversation.compacted\": self.compacted,\n872\t    57\t        }\n873\t    58\t        if self.tokens is not None:\n874\t    59\t            attrs[\"procurement.context.tokens\"] = self.tokens\n875\t    60\t        return attrs\n876\t    61\t\n877\t    62\t\n878\t    63\tasync def measure_context(client, request: dict, compacted: bool) -> ContextMeasure:\n879\t    64\t    try:\n880\t    65\t        counted = await client.messages.count_tokens(\n881\t    66\t            model=request[\"model\"],\n882\t    67\t            system=request[\"system\"],\n883\t    68\t            messages=request[\"messages\"],\n884\t    69\t            tools=request[\"tools\"],\n885\t    70\t        )\n886\t    71\t        return ContextMeasure(int(counted.input_tokens), \"count_tokens_api\", compacted)\n887\t    72\t    except Exception:  # counting is best effort; finalize() falls back to usage\n888\t    73\t        log.warning(\"token count failed; falling back to usage\", exc_info=True)\n889\t    74\t        return ContextMeasure(tokens=None, method=\"pending_usage\", compacted=compacted)\n890\t"}]},"parent_tool_use_id":null,"session_id":"3b827d5b-bfab-40a1-abb5-44f7b73c0a8e","uuid":"864918be-33ed-4f39-8bdb-42f18f8f80e5","timestamp":"2026-10-20T13:15:12.072Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-batch-af5qmzhy/3b827d5b-bfab-40a1-abb5-44f7b73c0a8e/tool-results/b7u2esvp8.txt","content":"=== app/loop.py\n     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n=== app/killswitch.py\n     1\t\"\"\"Operator stop control.\n     2\t\n     3\tOperators halt the fleet or one business unit by setting a row in\n     4\t``control_flags`` with the ``procurement_ops`` database role (see\n     5\tops/README in the platform runbook). The agent's own database role has\n     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\t\n    11\tclass AgentHalted(Exception):\n    12\t    pass\n    13\t\n    14\t\n    15\t_QUERY = \"\"\"\n    16\tSELECT scope, reason, set_by, set_at\n    17\tFROM control_flags\n    18\tWHERE halted\n    19\t  AND (scope = 'fleet' OR scope = $1)\n    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n    21\tLIMIT 1\n    22\t\"\"\"\n    23\t\n    24\t\n    25\tasync def assert_running(pool, tenant: str) -> None:\n    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n    27\t    if row is not None:\n    28\t        raise AgentHalted(\n    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n    31\t        )\n=== app/audit.py\n     1\t\"\"\"Execution audit graph.\n     2\t\n     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n     5\ttool call -> authorization decision -> result or error. Writes are\n     6\tsynchronous and are made before the action they describe; if the write\n     7\tfails, the caller raises and the action does not run.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport hashlib\n    12\timport json\n    13\timport uuid\n    14\tfrom datetime import datetime, timezone\n    15\tfrom typing import Any\n    16\t\n    17\tfrom opentelemetry import trace\n    18\t\n    19\tfrom app.context_size import ContextMeasure\n    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n    21\tfrom app.redact import redact_value\n    22\t\n    23\tEVENT_KINDS = {\n    24\t    \"run_started\",\n    25\t    \"run_finished\",\n    26\t    \"run_halted\",\n    27\t    \"model_decision\",\n    28\t    \"tool_proposed\",\n    29\t    \"authz_decision\",\n    30\t    \"approval_requested\",\n    31\t    \"approval_decided\",\n    32\t    \"tool_result\",\n    33\t    \"tool_error\",\n    34\t    \"tool_denied\",\n    35\t    \"budget_exceeded\",\n    36\t    \"subagent_started\",\n    37\t    \"subagent_finished\",\n    38\t    \"background_job\",\n    39\t}\n    40\t\n    41\t_INSERT = \"\"\"\n    42\tINSERT INTO audit_events (\n    43\t    node_id, parent_node_id, run_id, ts, kind,\n    44\t    accountable_party, operational_owner, tenant,\n    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n    46\t    delegated_subject, agent_principal, parent_instance_id,\n    47\t    policy_version, approval_id, operation_id,\n    48\t    context_tokens, context_method, context_compacted,\n    49\t    payload\n    50\t) VALUES (\n    51\t    $1, $2, $3, $4, $5,\n    52\t    $6, $7, $8,\n    53\t    $9, $10, $11, $12,\n    54\t    $13, $14, $15,\n    55\t    $16, $17, $18,\n    56\t    $19, $20, $21,\n    57\t    $22::jsonb\n    58\t)\n    59\t\"\"\"\n    60\t\n    61\t\n    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n    64\t    return {k: redact_value(v) for k, v in args.items()}\n    65\t\n    66\t\n    67\tdef digest(value: Any) -> str:\n    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    70\t\n    71\t\n    72\tasync def record(\n    73\t    pool,\n    74\t    ident: RunIdentity,\n    75\t    *,\n    76\t    kind: str,\n    77\t    payload: dict[str, Any] | None = None,\n    78\t    parent: str | None = None,\n    79\t    context: ContextMeasure | None = None,\n    80\t    policy_version: str | None = None,\n    81\t    approval_id: str | None = None,\n    82\t    operation_id: str | None = None,\n    83\t) -> str:\n    84\t    if kind not in EVENT_KINDS:\n    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n    86\t    for name in IDENTITY_FIELDS:\n    87\t        if not getattr(ident, name):\n    88\t            raise ValueError(f\"audit record missing {name}\")\n    89\t    span_ctx = trace.get_current_span().get_span_context()\n    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n    91\t    node_id = f\"node-{uuid.uuid4()}\"\n    92\t    measure = context or ContextMeasure.unavailable()\n    93\t    await pool.execute(\n    94\t        _INSERT,\n    95\t        node_id,\n    96\t        parent,\n    97\t        ident.run_id,\n    98\t        datetime.now(timezone.utc),\n    99\t        kind,\n   100\t        ident.accountable_party,\n   101\t        ident.operational_owner,\n   102\t        ident.tenant,\n   103\t        ident.agent_type_id,\n   104\t        ident.agent_instance_id,\n   105\t        ident.trace_id,\n   106\t        span_id,\n   107\t        ident.delegated_subject,\n   108\t        ident.agent_principal,\n   109\t        ident.parent_instance_id,\n   110\t        policy_version,\n   111\t        approval_id,\n   112\t        operation_id,\n   113\t        measure.tokens,\n   114\t        measure.method,\n   115\t        measure.compacted,\n   116\t        json.dumps(redact_value(payload or {}), default=str),\n   117\t    )\n   118\t    return node_id\n=== app/main.py\n     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport hashlib\n     6\timport hmac\n     7\timport json\n     8\timport logging\n     9\timport time\n    10\timport uuid\n    11\tfrom contextlib import asynccontextmanager\n    12\tfrom pathlib import Path\n    13\tfrom urllib.parse import parse_qs\n    14\t\n    15\timport asyncpg\n    16\timport jwt\n    17\tfrom anthropic import AsyncAnthropic\n    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n    20\tfrom opentelemetry import trace\n    21\tfrom pydantic import BaseModel, Field\n    22\t\n    23\tfrom app import audit, ingest\n    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n    25\tfrom app.extractor import LineItemExtractor\n    26\tfrom app.gate import PolicyGate\n    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n    28\tfrom app.loop import AgentDeps, ProcurementAgent\n    29\tfrom app.mcp_client import ErpMcpClient\n    30\tfrom app.redact import RedactingFilter\n    31\tfrom app.settings import get_settings\n    32\tfrom app.startup import startup_checks\n    33\tfrom app.tools.slack import SlackClient\n    34\t\n    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n    36\tfor handler in logging.getLogger().handlers:\n    37\t    handler.addFilter(RedactingFilter())\n    38\tlog = logging.getLogger(\"procurement\")\n    39\t\n    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    41\tbearer = HTTPBearer()\n    42\t\n    43\t\n    44\tclass RunRequest(BaseModel):\n    45\t    task: str = Field(min_length=1, max_length=4000)\n    46\t    department: str = Field(min_length=1, max_length=64)\n    47\t\n    48\t\n    49\tclass Principal(BaseModel):\n    50\t    subject: str\n    51\t    business_unit: str\n    52\t\n    53\t\n    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    55\t    return RunIdentity(\n    56\t        accountable_party=\"system:procurement-agent\",\n    57\t        operational_owner=settings.operational_owner,\n    58\t        tenant=tenant,\n    59\t        agent_type_id=agent_type_id,\n    60\t        agent_instance_id=new_instance_id(),\n    61\t        trace_id=uuid.uuid4().hex,\n    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n    63\t        delegated_subject=\"system:procurement-agent\",\n    64\t        agent_principal=AGENT_PRINCIPAL,\n    65\t    )\n    66\t\n    67\t\n    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n    69\t    while True:\n    70\t        await asyncio.sleep(60)\n    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n    72\t        count = await app.state.pool.fetchval(\n    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n    75\t        )\n    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n    78\t\n    79\t\n    80\t@asynccontextmanager\n    81\tasync def lifespan(app: FastAPI):\n    82\t    settings = get_settings()\n    83\t    agent_type_id = startup_checks(settings)\n    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    85\t    broker = TokenBroker(settings)\n    86\t\n    87\t    async def slack_token() -> str:\n    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n    89\t\n    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n    92\t    gate = PolicyGate(settings.policy, approvals)\n    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n    95\t\n    96\t    client = AsyncAnthropic()\n    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    98\t    deps.extractor = LineItemExtractor(\n    99\t        client=client, settings=settings, deps=deps,\n   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n   101\t    )\n   102\t    app.state.settings = settings\n   103\t    app.state.pool = pool\n   104\t    app.state.agent_type_id = agent_type_id\n   105\t    app.state.approvals = approvals\n   106\t    app.state.agent = ProcurementAgent(\n   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n   108\t    )\n   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n   111\t    try:\n   112\t        yield\n   113\t    finally:\n   114\t        sweeper.cancel()\n   115\t        await pool.close()\n   116\t\n   117\t\n   118\tapp = FastAPI(lifespan=lifespan)\n   119\tapp.include_router(ingest.router)\n   120\t\n   121\t\n   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n   123\t    settings = request.app.state.settings\n   124\t    try:\n   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n   126\t        claims = jwt.decode(\n   127\t            creds.credentials,\n   128\t            key.key,\n   129\t            algorithms=[\"RS256\", \"ES256\"],\n   130\t            audience=settings.oidc_audience,\n   131\t            issuer=settings.oidc_issuer,\n   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n   133\t        )\n   134\t    except jwt.PyJWTError as exc:\n   135\t        raise HTTPException(401, \"invalid token\") from exc\n   136\t    bu = claims.get(\"bu\")\n   137\t    if not bu:\n   138\t        raise HTTPException(403, \"token has no business unit\")\n   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n   140\t\n   141\t\n   142\t@app.post(\"/runs\")\n   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n   144\t    settings = request.app.state.settings\n   145\t    span_ctx = trace.get_current_span().get_span_context()\n   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n   147\t    ident = RunIdentity(\n   148\t        accountable_party=principal.subject,\n   149\t        operational_owner=settings.operational_owner,\n   150\t        tenant=principal.business_unit,\n   151\t        agent_type_id=request.app.state.agent_type_id,\n   152\t        agent_instance_id=new_instance_id(),\n   153\t        trace_id=trace_id,\n   154\t        run_id=f\"run-{uuid.uuid4()}\",\n   155\t        delegated_subject=principal.subject,\n   156\t        agent_principal=AGENT_PRINCIPAL,\n   157\t    )\n   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n   161\t\n   162\t\n   163\t@app.post(\"/slack/interactions\")\n   164\tasync def slack_interactions(request: Request) -> dict:\n   165\t    body = await request.body()\n   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n   167\t    if abs(time.time() - int(timestamp)) > 300:\n   168\t        raise HTTPException(401, \"stale request\")\n   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n   172\t        raise HTTPException(401, \"bad signature\")\n   173\t\n   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n   175\t    action = payload[\"actions\"][0]\n   176\t    slack_user = payload[\"user\"][\"id\"]\n   177\t    row = await request.app.state.pool.fetchrow(\n   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n   179\t    )\n   180\t    if row is None:\n   181\t        raise HTTPException(403, \"not an approver\")\n   182\t    try:\n   183\t        await request.app.state.approvals.decide(\n   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n   185\t            approve=action[\"action_id\"] == \"approve\",\n   186\t        )\n   187\t    except ApproverNotAuthorized as exc:\n   188\t        raise HTTPException(403, str(exc)) from exc\n   189\t    except ValueError as exc:\n   190\t        raise HTTPException(409, str(exc)) from exc\n   191\t    return {\"ok\": True}\n   192\t\n   193\t\n   194\t@app.get(\"/healthz\")\n   195\tasync def healthz() -> dict:\n   196\t    return {\"ok\": True}\n=== app/extractor.py\n     1\t\"\"\"Line-item extraction sub-agent.\n     2\t\n     3\tThe parent procurement agent delegates structured extraction to a smaller\n     4\tmodel. The child runs under its own instance id, links to its parent in the\n     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport json\n    10\timport logging\n    11\tfrom typing import Any\n    12\t\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom app import audit\n    16\tfrom app.budget import Budget\n    17\tfrom app.context_size import measure_context\n    18\tfrom app.identity import RunIdentity\n    19\tfrom app.redact import redact_for_model\n    20\tfrom app.tools import build_registry\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n    24\t\n    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n    26\tMAX_TURNS = 4\n    27\t\n    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n    29\t\n    30\t\n    31\tclass ExtractionFailed(Exception):\n    32\t    pass\n    33\t\n    34\t\n    35\tclass LineItemExtractor:\n    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n    37\t        self.client = client\n    38\t        self.settings = settings\n    39\t        self.deps = deps\n    40\t        self.system_prompt = system_prompt\n    41\t\n    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n    43\t        budget.check_subagent()\n    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n    47\t\n    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n    51\t            start_node = await audit.record(\n    52\t                self.deps.pool,\n    53\t                ident,\n    54\t                kind=\"subagent_started\",\n    55\t                payload={\n    56\t                    \"role\": EXTRACTOR_ROLE,\n    57\t                    \"doc_id\": doc_id,\n    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n    59\t                    \"tools\": registry.names(),\n    60\t                },\n    61\t            )\n    62\t\n    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n    64\t            for _turn in range(MAX_TURNS):\n    65\t                budget.check_step()\n    66\t                request = {\n    67\t                    \"model\": self.settings.extractor_model_id,\n    68\t                    \"system\": self.system_prompt,\n    69\t                    \"messages\": messages,\n    70\t                    \"tools\": registry.schemas(),\n    71\t                    \"max_tokens\": 4096,\n    72\t                }\n    73\t                ctx = await measure_context(self.client, request, compacted=False)\n    74\t                response = await self.client.messages.create(**request)\n    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n    76\t                await budget.flush(self.deps.pool)\n    77\t                ctx = ctx.finalize(response.usage)\n    78\t                decision = await audit.record(\n    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n    81\t                             \"stop_reason\": response.stop_reason},\n    82\t                )\n    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n    85\t                if not uses:\n    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n    87\t                    items = _parse_items(text)\n    88\t                    await audit.record(\n    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n    90\t                        payload={\"items\": len(items)},\n    91\t                    )\n    92\t                    return items\n    93\t                results = []\n    94\t                for use in uses:\n    95\t                    budget.check_tool_call()\n    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n    97\t                messages.append({\"role\": \"user\", \"content\": results})\n    98\t\n    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n   100\t\n   101\t\n   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n   103\t    try:\n   104\t        data = json.loads(text)\n   105\t    except json.JSONDecodeError as exc:\n   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n   107\t    if not isinstance(data, list) or len(data) > 500:\n   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n   109\t    items = []\n   110\t    for raw in data:\n   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n   114\t    return items\n=== app/budget.py\n     1\t\"\"\"Hard execution budgets, enforced by the harness and not by the model.\n     2\t\n     3\tPer run: step count, wall-clock time, tokens, cost, tool-call rate, and\n     4\tnumber of sub-agents. Sub-agents charge the parent's budget, so a child\n     5\tcannot widen what the parent was given.\n     6\t\n     7\tAcross runs: daily spend and per-minute run starts per user, per tenant\n     8\t(business unit), and for the whole fleet. Quotas are reserved in Postgres\n     9\tinside one transaction, so concurrent runs cannot overshoot them.\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport time\n    14\tfrom collections import deque\n    15\tfrom dataclasses import dataclass, field\n    16\tfrom decimal import Decimal\n    17\t\n    18\tfrom app.identity import RunIdentity\n    19\t\n    20\t\n    21\tclass BudgetExceeded(Exception):\n    22\t    def __init__(self, limit: str, used, allowed):\n    23\t        super().__init__(f\"{limit} exceeded: used={used} allowed={allowed}\")\n    24\t        self.limit = limit\n    25\t        self.used = used\n    26\t        self.allowed = allowed\n    27\t\n    28\t\n    29\t# USD per million tokens, from the provider price sheet referenced in the manifest.\n    30\tPRICES = {\n    31\t    \"claude-sonnet-4-5-20250929\": (Decimal(\"3.00\"), Decimal(\"15.00\")),\n    32\t    \"claude-haiku-4-5-20251001\": (Decimal(\"1.00\"), Decimal(\"5.00\")),\n    33\t}\n    34\t\n    35\t\n    36\t@dataclass\n    37\tclass Budget:\n    38\t    ident: RunIdentity\n    39\t    max_steps: int\n    40\t    max_wall_seconds: float\n    41\t    max_tokens: int\n    42\t    max_cost_usd: Decimal\n    43\t    max_tool_calls_per_minute: int\n    44\t    max_subagents: int\n    45\t    quotas_daily_usd: dict[str, Decimal]\n    46\t    run_starts_per_minute: dict[str, int]\n    47\t    started_at: float = field(default_factory=time.monotonic)\n    48\t    steps: int = 0\n    49\t    tokens: int = 0\n    50\t    cost_usd: Decimal = Decimal(\"0\")\n    51\t    unflushed_cost_usd: Decimal = Decimal(\"0\")\n    52\t    subagents: int = 0\n    53\t    _tool_calls: deque = field(default_factory=deque)\n    54\t\n    55\t    @classmethod\n    56\t    def for_run(cls, cfg: dict, ident: RunIdentity) -> \"Budget\":\n    57\t        run = cfg[\"per_run\"]\n    58\t        return cls(\n    59\t            ident=ident,\n    60\t            max_steps=int(run[\"max_steps\"]),\n    61\t            max_wall_seconds=float(run[\"max_wall_seconds\"]),\n    62\t            max_tokens=int(run[\"max_tokens\"]),\n    63\t            max_cost_usd=Decimal(str(run[\"max_cost_usd\"])),\n    64\t            max_tool_calls_per_minute=int(run[\"max_tool_calls_per_minute\"]),\n    65\t            max_subagents=int(run[\"max_subagents\"]),\n    66\t            quotas_daily_usd={k: Decimal(str(v)) for k, v in cfg[\"quotas_daily_usd\"].items()},\n    67\t            run_starts_per_minute={k: int(v) for k, v in cfg[\"run_starts_per_minute\"].items()},\n    68\t        )\n    69\t\n    70\t    def _scopes(self) -> list[tuple[str, str]]:\n    71\t        return [\n    72\t            (\"user\", self.ident.accountable_party),\n    73\t            (\"tenant\", self.ident.tenant),\n    74\t            (\"fleet\", \"all\"),\n    75\t        ]\n    76\t\n    77\t    # --- per-run limits -------------------------------------------------\n    78\t\n    79\t    def check_step(self) -> None:\n    80\t        self.steps += 1\n    81\t        if self.steps > self.max_steps:\n    82\t            raise BudgetExceeded(\"max_steps\", self.steps, self.max_steps)\n    83\t        elapsed = time.monotonic() - self.started_at\n    84\t        if elapsed > self.max_wall_seconds:\n    85\t            raise BudgetExceeded(\"max_wall_seconds\", round(elapsed, 1), self.max_wall_seconds)\n    86\t\n    87\t    def charge_model(self, model: str, usage) -> None:\n    88\t        price_in, price_out = PRICES[model]\n    89\t        tokens_in = (\n    90\t            int(usage.input_tokens or 0)\n    91\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n    92\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n    93\t        )\n    94\t        tokens_out = int(usage.output_tokens or 0)\n    95\t        self.tokens += tokens_in + tokens_out\n    96\t        cost = (price_in * tokens_in + price_out * tokens_out) / Decimal(1_000_000)\n    97\t        self.cost_usd += cost\n    98\t        self.unflushed_cost_usd += cost\n    99\t        if self.tokens > self.max_tokens:\n   100\t            raise BudgetExceeded(\"max_tokens\", self.tokens, self.max_tokens)\n   101\t        if self.cost_usd > self.max_cost_usd:\n   102\t            raise BudgetExceeded(\"max_cost_usd\", self.cost_usd, self.max_cost_usd)\n   103\t\n   104\t    def check_tool_call(self, now: float | None = None) -> None:\n   105\t        now = time.monotonic() if now is None else now\n   106\t        while self._tool_calls and now - self._tool_calls[0] > 60:\n   107\t            self._tool_calls.popleft()\n   108\t        if len(self._tool_calls) >= self.max_tool_calls_per_minute:\n   109\t            raise BudgetExceeded(\n   110\t                \"max_tool_calls_per_minute\", len(self._tool_calls) + 1, self.max_tool_calls_per_minute\n   111\t            )\n   112\t        self._tool_calls.append(now)\n   113\t\n   114\t    def check_subagent(self) -> None:\n   115\t        if self.subagents >= self.max_subagents:\n   116\t            raise BudgetExceeded(\"max_subagents\", self.subagents + 1, self.max_subagents)\n   117\t        self.subagents += 1\n   118\t\n   119\t    # --- cross-run quotas -----------------------------------------------\n   120\t\n   121\t    async def reserve_run_start(self, pool) -> None:\n   122\t        async with pool.acquire() as conn:\n   123\t            async with conn.transaction():\n   124\t                for scope, key in self._scopes():\n   125\t                    limit = self.run_starts_per_minute[scope]\n   126\t                    count = await conn.fetchval(\n   127\t                        \"\"\"\n   128\t                        INSERT INTO run_start_window (scope, key, minute, starts)\n   129\t                        VALUES ($1, $2, date_trunc('minute', now()), 1)\n   130\t                        ON CONFLICT (scope, key, minute)\n   131\t                        DO UPDATE SET starts = run_start_window.starts + 1\n   132\t                        RETURNING starts\n   133\t                        \"\"\",\n   134\t                        scope,\n   135\t                        key,\n   136\t                    )\n   137\t                    if count > limit:\n   138\t                        raise BudgetExceeded(f\"run_starts_per_minute.{scope}\", count, limit)\n   139\t\n   140\t    async def flush(self, pool) -> None:\n   141\t        \"\"\"Add this run's unflushed spend to the daily quotas, or stop the run.\"\"\"\n   142\t        if self.unflushed_cost_usd <= 0:\n   143\t            return\n   144\t        amount = self.unflushed_cost_usd\n   145\t        async with pool.acquire() as conn:\n   146\t            async with conn.transaction():\n   147\t                for scope, key in self._scopes():\n   148\t                    limit = self.quotas_daily_usd[scope]\n   149\t                    spent = await conn.fetchval(\n   150\t                        \"\"\"\n   151\t                        INSERT INTO spend_quota (scope, key, day, spent_usd)\n   152\t                        VALUES ($1, $2, current_date, $3)\n   153\t                        ON CONFLICT (scope, key, day)\n   154\t                        DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd\n   155\t                        RETURNING spent_usd\n   156\t                        \"\"\",\n   157\t                        scope,\n   158\t                        key,\n   159\t                        amount,\n   160\t                    )\n   161\t                    if spent > limit:\n   162\t                        raise BudgetExceeded(f\"quota_daily_usd.{scope}\", spent, limit)\n   163\t        self.unflushed_cost_usd = Decimal(\"0\")\n=== app/context_size.py\n     1\t\"\"\"Decision-time context size.\n     2\t\n     3\tCounting method (documented in README, \"Context size\"):\n     4\t\n     5\t1. Before each model call, the exact request (system prompt, messages and\n     6\t   tool schemas) is sent to the provider's token-counting endpoint. The\n     7\t   returned ``input_tokens`` is recorded with method ``count_tokens_api``.\n     8\t   This is the size of the context the model decides on, including any\n     9\t   prefix that will be served from the prompt cache.\n    10\t2. If counting fails, the value is taken after the call from the response\n    11\t   usage as ``input_tokens + cache_read_input_tokens +\n    12\t   cache_creation_input_tokens`` and recorded with method\n    13\t   ``usage_sum_estimate``.\n    14\t3. If neither is available the value is ``NULL`` with method\n    15\t   ``unavailable``. It is never recorded as zero.\n    16\t\n    17\t``compacted`` is true when the harness dropped or summarized earlier turns\n    18\tbefore this call. Provider-side truncation is not visible to the harness and\n    19\tis listed as a known limit.\n    20\t\"\"\"\n    21\tfrom __future__ import annotations\n    22\t\n    23\timport logging\n    24\tfrom dataclasses import dataclass, replace\n    25\t\n    26\tlog = logging.getLogger(__name__)\n    27\t\n    28\t\n    29\t@dataclass(frozen=True)\n    30\tclass ContextMeasure:\n    31\t    tokens: int | None\n    32\t    method: str\n    33\t    compacted: bool\n    34\t\n    35\t    @classmethod\n    36\t    def unavailable(cls, compacted: bool = False) -> \"ContextMeasure\":\n    37\t        return cls(tokens=None, method=\"unavailable\", compacted=compacted)\n    38\t\n    39\t    def finalize(self, usage) -> \"ContextMeasure\":\n    40\t        if self.tokens is not None:\n    41\t            return self\n    42\t        if usage is None:\n    43\t            return ContextMeasure.unavailable(self.compacted)\n    44\t        total = (\n    45\t            int(usage.input_tokens or 0)\n    46\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n    47\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n    48\t        )\n    49\t        if total <= 0:\n    50\t            return ContextMeasure.unavailable(self.compacted)\n    51\t        return replace(self, tokens=total, method=\"usage_sum_estimate\")\n    52\t\n    53\t    def otel_attributes(self) -> dict:\n    54\t        attrs = {\n    55\t            \"procurement.context.method\": self.method,\n    56\t            \"gen_ai.conversation.compacted\": self.compacted,\n    57\t        }\n    58\t        if self.tokens is not None:\n    59\t            attrs[\"procurement.context.tokens\"] = self.tokens\n    60\t        return attrs\n    61\t\n    62\t\n    63\tasync def measure_context(client, request: dict, compacted: bool) -> ContextMeasure:\n    64\t    try:\n    65\t        counted = await client.messages.count_tokens(\n    66\t            model=request[\"model\"],\n    67\t            system=request[\"system\"],\n    68\t            messages=request[\"messages\"],\n    69\t            tools=request[\"tools\"],\n    70\t        )\n    71\t        return ContextMeasure(int(counted.input_tokens), \"count_tokens_api\", compacted)\n    72\t    except Exception:  # counting is best effort; finalize() falls back to usage\n    73\t        log.warning(\"token count failed; falling back to usage\", exc_info=True)\n    74\t        return ContextMeasure(tokens=None, method=\"pending_usage\", compacted=compacted)\n","numLines":890,"startLine":1,"totalLines":890}},"tool_result_meta":[{"id":"toolu_011BBUADLEXaQ2xyezDxur24","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
