d (F5). |\n\n**Unreviewed:**\n- Any host adapter or network transport (not supplied).\n- Runtime behavior, because nothing was executed.\n- Three of the four test files beyond a grep.\n- Production deployment, credential rotation and persistence.","ttft_ms":1312,"type":"result","duration_ms":66619,"uuid":"db61c832-c207-4ebf-84d3-28c44acfc659","ttft_stream_ms":870,"time_to_request_ms":95,"first_content_frame_ms":870,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-sonnet-5-5":{"inputTokens":10,"outputTokens":8208,"cacheReadInputTokens":46216,"cacheCreationInputTokens":15805,"webSearchRequests":0,"costUSD":0.1499416,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":825,"canonicalModel":"claude-sonnet-5-5","provider":"firstParty","costBasis":"list"}}}
