{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017uVYdXnXKZiGhvduVAY3XH","type":"tool_result","content":"1\timport test from 'node:test';\n2\timport assert from 'node:assert/strict';\n3\timport { workspaceName, receiptLabel, decodeEntries } from '../src/validation.mjs';\n4\timport { authenticate, requireOperator } from '../src/identity.mjs';\n5\tconst configuration = { operatorToken: 'synthetic-test-token' };\n6\t\n7\ttest('workspace names preserve simple warehouse identifiers', () => {\n8\t  assert.equal(workspaceName('bay-17'), 'bay-17');\n9\t  assert.equal(workspaceName('a'), 'a');\n10\t});\n11\ttest('workspace names reject path syntax', () => {\n12\t  for (const value of ['../bay', '/tmp', '.', '', 'UPPER', 'bay/name']) {\n13\t    assert.throws(() => workspaceName(value));\n14\t  }\n15\t});\n16\ttest('workspace length is bounded', () => {\n17\t  assert.equal(workspaceName('a'.repeat(32)).length, 32);\n18\t  assert.throws(() => workspaceName('a'.repeat(33)));\n19\t});\n20\ttest('labels remain arbitrary single line text', () => {\n21\t  assert.equal(receiptLabel('Bay 17: fragile'), 'Bay 17: fragile');\n22\t  assert.equal(receiptLabel('Bay 17 — fragile'), 'Bay 17 — fragile');\n23\t  assert.equal(receiptLabel('quoted \"value\"'), 'quoted \"value\"');\n24\t});\n25\ttest('multiline labels are not accepted', () => {\n26\t  assert.throws(() => receiptLabel('a\\nb'));\n27\t  assert.throws(() => receiptLabel('a\\rb'));\n28\t});\n29\ttest('empty and excessive labels are not accepted', () => {\n30\t  assert.throws(() => receiptLabel(''));\n31\t  assert.throws(() => receiptLabel('x'.repeat(121)));\n32\t});\n33\ttest('archive entries preserve text content', () => {\n34\t  const result = decodeEntries([{ name: 'nested/item.txt', content: 'parcel' }], 64);\n35\t  assert.deepEqual(result, [{ name: 'nested/item.txt', content: 'parcel' }]);\n36\t});\n37\ttest('archive entry count is bounded', () => {\n38\t  assert.throws(() => decodeEntries([{}, {}], 1));\n39\t  assert.throws(() => decodeEntries({}, 64));\n40\t});\n41\ttest('archive content is a bounded string', () => {\n42\t  assert.throws(() => decodeEntries([{ name: 'a', content: 17 }], 64));\n43\t  assert.throws(() => decodeEntries([{ name: 'a', content: 'x'.repeat(4097) }], 64));\n44\t});\n45\ttest('only the exact configured token authenticates', () => {\n46\t  assert.equal(authenticate({ authorization: 'Bearer synthetic-test-token' }, configuration).role, 'operator');\n47\t  assert.throws(() => authenticate({}, configuration));\n48\t  assert.throws(() => authenticate({ authorization: 'Bearer other' }, configuration));\n49\t});\n50\ttest('dispatch role cannot be replaced by a body value', () => {\n51\t  assert.throws(() => requireOperator({ role: 'viewer' }));\n52\t  assert.doesNotThrow(() => requireOperator({ role: 'operator' }));\n53\t});\n54\t"}]},"parent_tool_use_id":null,"session_id":"036ad032-3fb9-462a-8155-70aca5c50fbf","uuid":"31d73d30-7712-4447-be36-d9cd3f1bfe4b","timestamp":"2026-10-25T13:47:02.462Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-mcp-review-cslf3eml/repo/test/validation.test.mjs","content":"import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { workspaceName, receiptLabel, decodeEntries } from '../src/validation.mjs';\nimport { authenticate, requireOperator } from '../src/identity.mjs';\nconst configuration = { operatorToken: 'synthetic-test-token' };\n\ntest('workspace names preserve simple warehouse identifiers', () => {\n  assert.equal(workspaceName('bay-17'), 'bay-17');\n  assert.equal(workspaceName('a'), 'a');\n});\ntest('workspace names reject path syntax', () => {\n  for (const value of ['../bay', '/tmp', '.', '', 'UPPER', 'bay/name']) {\n    assert.throws(() => workspaceName(value));\n  }\n});\ntest('workspace length is bounded', () => {\n  assert.equal(workspaceName('a'.repeat(32)).length, 32);\n  assert.throws(() => workspaceName('a'.repeat(33)));\n});\ntest('labels remain arbitrary single line text', () => {\n  assert.equal(receiptLabel('Bay 17: fragile'), 'Bay 17: fragile');\n  assert.equal(receiptLabel('Bay 17 — fragile'), 'Bay 17 — fragile');\n  assert.equal(receiptLabel('quoted \"value\"'), 'quoted \"value\"');\n});\ntest('multiline labels are not accepted', () => {\n  assert.throws(() => receiptLabel('a\\nb'));\n  assert.throws(() => receiptLabel('a\\rb'));\n});\ntest('empty and excessive labels are not accepted', () => {\n  assert.throws(() => receiptLabel(''));\n  assert.throws(() => receiptLabel('x'.repeat(121)));\n});\ntest('archive entries preserve text content', () => {\n  const result = decodeEntries([{ name: 'nested/item.txt', content: 'parcel' }], 64);\n  assert.deepEqual(result, [{ name: 'nested/item.txt', content: 'parcel' }]);\n});\ntest('archive entry count is bounded', () => {\n  assert.throws(() => decodeEntries([{}, {}], 1));\n  assert.throws(() => decodeEntries({}, 64));\n});\ntest('archive content is a bounded string', () => {\n  assert.throws(() => decodeEntries([{ name: 'a', content: 17 }], 64));\n  assert.throws(() => decodeEntries([{ name: 'a', content: 'x'.repeat(4097) }], 64));\n});\ntest('only the exact configured token authenticates', () => {\n  assert.equal(authenticate({ authorization: 'Bearer synthetic-test-token' }, configuration).role, 'operator');\n  assert.throws(() => authenticate({}, configuration));\n  assert.throws(() => authenticate({ authorization: 'Bearer other' }, configuration));\n});\ntest('dispatch role cannot be replaced by a body value', () => {\n  assert.throws(() => requireOperator({ role: 'viewer' }));\n  assert.doesNotThrow(() => requireOperator({ role: 'operator' }));\n});\n","numLines":54,"startLine":1,"totalLines":54}},"tool_result_meta":[{"id":"toolu_017uVYdXnXKZiGhvduVAY3XH","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
