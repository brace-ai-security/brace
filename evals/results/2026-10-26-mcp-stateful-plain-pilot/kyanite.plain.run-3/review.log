{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D13cgicvDXnnTEgfUms67U","type":"tool_result","content":"1\tfrom dataclasses import dataclass\n2\tfrom copy import deepcopy\n3\tfrom .errors import Refused, Conflict\n4\t\n5\t@dataclass\n6\tclass Decision:\n7\t    tenant: str\n8\t    subject: str\n9\t    plan: str\n10\t    digest: str\n11\t    snapshot: dict\n12\t    reviewer: str\n13\t    consumed: bool = False\n14\t\n15\tclass Reviews:\n16\t    def __init__(self):\n17\t        self.decisions = {}\n18\t\n19\t    def record(self, reviewer, plan):\n20\t        self.decisions[(plan.tenant, plan.id)] = Decision(plan.tenant, plan.subject,\n21\t            plan.id, plan.digest(), plan.snapshot(), reviewer.subject)\n22\t        return {'plan': plan.id, 'revision': plan.revision, 'reviewer': reviewer.subject}\n23\t\n24\t    def consume(self, principal, plan):\n25\t        decision = self.decisions.get((principal.tenant, plan.id))\n26\t        if decision is None or decision.subject != principal.subject:\n27\t            raise Refused('review')\n28\t        if decision.consumed:\n29\t            raise Conflict('review consumed')\n30\t        decision.consumed = True\n31\t        return deepcopy(decision.snapshot)\n32\t\n33\t    def status(self, principal, plan):\n34\t        decision = self.decisions.get((principal.tenant, plan.id))\n35\t        return {'reviewed': decision is not None, 'consumed': decision.consumed if decision else False}\n36\t"}]},"parent_tool_use_id":null,"session_id":"c1ff0f0b-7851-4d69-a165-a938cfd4e835","uuid":"40bdea85-85f3-445a-9642-13ed1351974d","timestamp":"2026-10-26T05:31:34.324Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-mcp-review-9yy80dp4/repo/service/reviews.py","content":"from dataclasses import dataclass\nfrom copy import deepcopy\nfrom .errors import Refused, Conflict\n\n@dataclass\nclass Decision:\n    tenant: str\n    subject: str\n    plan: str\n    digest: str\n    snapshot: dict\n    reviewer: str\n    consumed: bool = False\n\nclass Reviews:\n    def __init__(self):\n        self.decisions = {}\n\n    def record(self, reviewer, plan):\n        self.decisions[(plan.tenant, plan.id)] = Decision(plan.tenant, plan.subject,\n            plan.id, plan.digest(), plan.snapshot(), reviewer.subject)\n        return {'plan': plan.id, 'revision': plan.revision, 'reviewer': reviewer.subject}\n\n    def consume(self, principal, plan):\n        decision = self.decisions.get((principal.tenant, plan.id))\n        if decision is None or decision.subject != principal.subject:\n            raise Refused('review')\n        if decision.consumed:\n            raise Conflict('review consumed')\n        decision.consumed = True\n        return deepcopy(decision.snapshot)\n\n    def status(self, principal, plan):\n        decision = self.decisions.get((principal.tenant, plan.id))\n        return {'reviewed': decision is not None, 'consumed': decision.consumed if decision else False}\n","numLines":36,"startLine":1,"totalLines":36}},"tool_result_meta":[{"id":"toolu_01D13cgicvDXnnTEgfUms67U","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
