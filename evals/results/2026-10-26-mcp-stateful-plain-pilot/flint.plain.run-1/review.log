le for direct in-process integration.\n","numLines":14,"startLine":1,"totalLines":14}},"tool_result_meta":[{"id":"toolu_01Js6AenAryQ9HmDavHjT1bH","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
