{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RNaDynHDJkCvUqKmvxCC6W","type":"tool_result","content":"1\tfrom copy import deepcopy\n2\tfrom urllib.parse import unquote\n3\tfrom posixpath import normpath\n4\tfrom .errors import Missing\n5\t\n6\tclass Provider:\n7\t    def __init__(self):\n8\t        self.rows = {\n9\t            ('north', '/general/guide'): {'title': 'Guide', 'body': 'General working draft'},\n10\t            ('north', '/general/style/notes'): {'title': 'Notes', 'body': 'Editorial style'},\n11\t            ('north', '/general/release%20notes'): {'title': 'Release', 'body': 'Literal percent name'},\n12\t            ('north', '/vault/budget'): {'title': 'Budget', 'body': 'North private planning'},\n13\t            ('south', '/general/guide'): {'title': 'Guide', 'body': 'South working draft'},\n14\t        }\n15\t\n16\t    def decode_locator(self, wire_locator):\n17\t        return normpath(unquote(wire_locator, encoding='utf-8', errors='strict'))\n18\t\n19\t    def get(self, tenant, wire_locator):\n20\t        locator = self.decode_locator(wire_locator)\n21\t        value = self.rows.get((tenant, locator))\n22\t        if value is None:\n23\t            raise Missing('resource')\n24\t        return deepcopy(value)\n25\t\n26\t    def head(self, tenant, wire_locator):\n27\t        value = self.get(tenant, wire_locator)\n28\t        return {'title': value['title'], 'bytes': len(value['body'].encode('utf-8'))}\n29\t\n30\t    def list_prefix(self, tenant, wire_prefix, cursor, size):\n31\t        prefix = self.decode_locator(wire_prefix).rstrip('/') + '/'\n32\t        keys = sorted(locator for (t, locator) in self.rows if t == tenant and locator.startswith(prefix))\n33\t        return {'locators': keys[cursor:cursor + size],\n34\t                'next': cursor + size if cursor + size < len(keys) else None}\n35\t"}]},"parent_tool_use_id":null,"session_id":"7ac62724-9b8b-487c-84fb-0f28bfe4ebb2","uuid":"478c7f09-1e6f-47c8-8555-72220