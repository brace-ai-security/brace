{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KRXduaB25UY3KvJDsTX6z6","type":"tool_result","content":"1\tfrom dataclasses import dataclass, asdict, replace\n2\timport hashlib\n3\timport json\n4\tfrom copy import deepcopy\n5\tfrom .errors import Missing, Refused, Conflict, Invalid\n6\tfrom .validation import name, text, integer\n7\t\n8\t@dataclass(frozen=True)\n9\tclass Plan:\n10\t    id: str\n11\t    tenant: str\n12\t    subject: str\n13\t    project: str\n14\t    document: str\n15\t    destination: str\n16\t    projection: str\n17\t    revision: int = 1\n18\t\n19\t    def snapshot(self):\n20\t        return asdict(self)\n21\t\n22\t    def digest(self):\n23\t        return hashlib.sha256(json.dumps(self.snapshot(), sort_keys=True).encode()).hexdigest()\n24\t\n25\tclass Plans:\n26\t    def __init__(self):\n27\t        self.rows = {}\n28\t        self.sequence = 0\n29\t\n30\t    def create(self, principal, arguments):\n31\t        self.sequence += 1\n32\t        pid = 'plan-' + str(self.sequence)\n33\t        plan = Plan(pid, principal.tenant, principal.subject, name(arguments['project']),\n34\t                    name(arguments['document']), name(arguments['destination']),\n35\t                    self.projection(arguments.get('projection', 'title')))\n36\t        self.rows[pid] = plan\n37\t        return plan.snapshot()\n38\t\n39\t    def projection(self, value):\n40\t        if value not in ('title', 'full'):\n41\t            raise Invalid('projection')\n42\t        return value\n43\t\n44\t    def owned(self, principal, pid):\n45\t        plan = self.rows.get(pid)\n46\t        if plan is None:\n47\t            raise Missing('plan')\n48\t        if (plan.tenant, plan.subject) != (principal.tenant, principal.subject):\n49\t            raise Refused('plan owner')\n50\t        return plan\n51\t\n52\t    def reviewable(self, principal, pid):\n53\t        plan = self.rows.get(pid)\n54\t        if plan is None:\n55\t            raise Missing('plan')\n56\t        if plan.tenant != principal.tenant:\n57\t            raise Refused('plan tenant')\n58\t        return plan\n59\t\n60\t    def update(self, principal, arguments):\n61\t        plan = self.owned(principal, name(arguments['plan']))\n62\t        if plan.revision != integer(arguments['revision'], 1):\n63\t            raise Conflict('revision')\n64\t        updated = replace(plan, destination=name(arguments.get('destination', plan.destination)),\n65\t                          projection=self.projection(arguments.get('projection', plan.projection)),\n66\t                          revision=plan.revision + 1)\n67\t        self.rows[plan.id] = updated\n68\t        return updated.snapshot()\n69\t"}]},"parent_tool_use_id":null,"session_id":"2d6a6cab-56a5-4fdf-ab00-8ab5b93f84e4","uuid":"ddb05a5c-be47-42da-a54f-44fee63894dc","timestamp":"2026-10-26T05:27:45.343Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-mcp-review-spzt0sv0/repo/service/plans.py","content":"from dataclasses import dataclass, asdict, replace\nimport hashlib\nimport json\nfrom copy import deepcopy\nfrom .errors import Missing, Refused, Conflict, Invalid\nfrom .validation import name, text, integer\n\n@dataclass(frozen=True)\nclass Plan:\n    id: str\n    tenant: str\n    subject: str\n    project: str\n    document: str\n    destination: str\n    projection: str\n    revision: int = 1\n\n    def snapshot(self):\n        return asdict(self)\n\n    def digest(self):\n        return hashlib.sha256(json.dumps(self.snapshot(), sort_keys=True).encode()).hexdigest()\n\nclass Plans:\n    def __init__(self):\n        self.rows = {}\n        self.sequence = 0\n\n    def create(self, principal, arguments):\n        self.sequence += 1\n        pid = 'plan-' + str(self.sequence)\n        plan = Plan(pid, principal.tenant, principal.subject, name(arguments['project']),\n                    name(arguments['document']), name(arguments['destination']),\n                    self.projection(arguments.get('projection', 'title')))\n        self.rows[pid] = plan\n        return plan.snapshot()\n\n    def projection(self, value):\n        if value not in ('title', 'full'):\n            raise Invalid('projection')\n        return value\n\n    def owned(self, principal, pid):\n        plan = self.rows.get(pid)\n        if plan is None:\n            raise Missing('plan')\n        if (plan.tenant, plan.subject) != (principal.tenant, principal.subject):\n            raise Refused('plan owner')\n        return plan\n\n    def reviewable(self, principal, pid):\n        plan = self.rows.get(pid)\n        if plan is None:\n            raise Missing('plan')\n        if plan.tenant != principal.tenant:\n            raise Refused('plan tenant')\n        return plan\n\n    def update(self, principal, arguments):\n        plan = self.owned(principal, name(arguments['plan']))\n        if plan.revision != integer(arguments['revision'], 1):\n            raise Conflict('revision')\n        updated = replace(plan, destination=name(arguments.get('destination', plan.destination)),\n                          projection=self.projection(arguments.get('projection', plan.projection)),\n                          revision=plan.revision + 1)\n        self.rows[plan.id] = updated\n        return updated.snapshot()\n","numLines":69,"startLine":1,"totalLines":69}},"tool_result_meta":[{"id":"toolu_01KRXduaB25UY3KvJDsTX6z6","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
