{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PafhfxcaQdnP9jv8HDop5M","type":"tool_result","content":"1\tfrom dataclasses import dataclass\n2\tfrom copy import deepcopy\n3\tfrom .errors import Refused, Conflict\n4\t\n5\t@dataclass\n6\tclass Decision:\n7\t    tenant: str\n8\t    subject: str\n9\t    plan: str\n10\t    digest: str\n11\t    snapshot: dict\n12\t    reviewer: str\n13\t    consumed: bool = False\n14\t\n15\tclass Reviews:\n16\t    def __init__(self):\n17\t        self.decisions = {}\n18\t\n19\t    def record(self, reviewer, plan):\n20\t        self.decisions[(plan.tenant, plan.id)] = Decision(plan.tenant, plan.subject,\n21\t            plan.id, plan.digest(), plan.snapshot(), reviewer.subject)\n22\t        return {'plan': plan.id, 'revision': plan.revision, 'reviewer': reviewer.subject}\n23\t\n24\t    def consume(self, principal, plan):\n25\t        decision = self.decisions.get((principal.tenant, plan.id))\n26\t        if decision is None or decision.subject != principal.subject:\n27\t            raise Refused('review')\n28\t        if decision.digest != plan.digest():\n29\t            raise Refused('review revision')\n30\t        if decision.consumed:\n31\t            raise Conflict('review consumed')\n32\t        decision.consumed = True\n33\t        return deepcopy(decision.snapshot)\n34\t\n35\t    def status(self, principal, plan):\n36\t        decision = self.decisions.get((principal.tenant, plan.id))\n37\t        return {'reviewed': decision is not None, 'consumed': decision.consumed if decision else False}\n38\t"}]},"parent_tool_use_id":null,"session_id":"2d6a6cab-56a5-4fdf-ab00-8ab5b93f84e4","uuid":"7fb1bf90-20e9-4019-892c-263b1c5645a8","timestamp":"2026-10-26T05:27:45.755Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-mcp-review-spzt0sv0/repo/service/reviews.py","content":"from dataclasses import dataclass\nfrom copy import deepcopy\nfrom .errors import Refused, Conflict\n\n@dataclass\nclass Decision:\n    tenant: str\n    subject: str\n    plan: str\n    digest: str\n    snapshot: dict\n    reviewer: str\n    consumed: bool = False\n\nclass Reviews:\n    def __init__(self):\n        self.decisions = {}\n\n    def record(self, reviewer, plan):\n        self.decisions[(plan.tenant, plan.id)] = Decision(plan.tenant, plan.subject,\n            plan.id, plan.digest(), plan.snapshot(), reviewer.subject)\n        return {'plan': plan.id, 'revision': plan.revision, 'reviewer': reviewer.subject}\n\n    def consume(self, principal, plan):\n        decision = self.decisions.get((principal.tenant, plan.id))\n        if decision is None or decision.subject != principal.subject:\n            raise Refused('review')\n        if decision.digest != plan.digest():\n            raise Refused('review revision')\n        if decision.consumed:\n            raise Conflict('review consumed')\n        decision.consumed = True\n        return deepcopy(decision.snapshot)\n\n    def status(self, principal, plan):\n        decision = self.decisions.get((principal.tenant, plan.id))\n        return {'reviewed': decision is not None, 'consumed': decision.consumed if decision else False}\n","numLines":38,"startLine":1,"totalLines":38}},"tool_result_meta":[{"id":"toolu_01PafhfxcaQdnP9jv8HDop5M","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
