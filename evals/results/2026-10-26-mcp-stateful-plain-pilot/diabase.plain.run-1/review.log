Refused('lease binding')\n        if job.state == 'cancelled':\n            raise Conflict('cancelled')\n        if job.state == 'done':\n            return self.jobs.result(job)\n        job.attempts += 1\n        rows, complete = self.dataset.select(lease.tenant, lease.project, job.cursor, self.size)\n        job.cursor += len(rows)\n        job.last = rows\n        job.state = 'done' if complete else 'paused'\n        return self.jobs.result(job)\n","numLines":24,"startLine":1,"totalLines":24}},"tool_result_meta":[{"id":"toolu_01Y47wrNe4X7RoL9fQD1ZQLe","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
