{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V8zjxWMeQJeWTa8ykewdkG","type":"tool_result","content":"1\tfrom collections import OrderedDict\n2\tfrom dataclasses import dataclass\n3\tfrom secrets import token_urlsafe\n4\tfrom .errors import Refused, Conflict\n5\t\n6\t@dataclass(frozen=True)\n7\tclass Session:\n8\t    id: str\n9\t    token: str\n10\t    subject: str\n11\t    tenant: str\n12\t    credential_id: str\n13\t    expires: float\n14\t\n15\tclass Sessions:\n16\t    def __init__(self, credentials, settings, clock):\n17\t        self.credentials = credentials\n18\t        self.settings = settings\n19\t        self.clock = clock\n20\t        self.rows = OrderedDict()\n21\t\n22\t    def prune(self):\n23\t        now = self.clock.now()\n24\t        for sid, session in list(self.rows.items()):\n25\t            if session.expires <= now:\n26\t                del self.rows[sid]\n27\t\n28\t    def open(self, token):\n29\t        principal = self.credentials.authenticate(token)\n30\t        self.prune()\n31\t        if len(self.rows) >= self.settings.session_capacity:\n32\t            raise Conflict('session capacity')\n33\t        sid = token_urlsafe(24)\n34\t        session = Session(sid, token, principal.subject, principal.tenant,\n35\t                          principal.credential_id, self.clock.now() + self.settings.session_ttl)\n36\t        self.rows[sid] = session\n37\t        return {'session': sid, 'expires_in': self.settings.session_ttl}\n38\t\n39\t    def resolve(self, sid):\n40\t        self.prune()\n41\t        if not isinstance(sid, str):\n42\t            raise Refused('session')\n43\t        session = self.rows.get(sid)\n44\t        if session is None:\n45\t            raise Refused('session')\n46\t        principal = self.credentials.authenticate(session.token)\n47\t        if (principal.subject, principal.tenant, principal.credential_id) != (\n48\t                session.subject, session.tenant, session.credential_id):\n49\t            raise Refused('session identity')\n50\t        return session, principal\n51\t\n52\t    def close(self, sid):\n53\t        session, _ = self.resolve(sid)\n54\t        del self.rows[session.id]\n55\t        return {'closed': True}\n56\t\n57\t    def count(self):\n58\t        self.prune()\n59\t        return len(self.rows)\n60\t"}]},"parent_tool_use_id":null,"session_id":"38597535-1521-4344-9c9f-f3a9bd525231","uuid":"852895a5-e776-4479-810d-da69e1a71ec0","timestamp":"2026-10-26T05:25:56.777Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-mcp-review-cfgsm5c5/repo/service/sessions.py","content":"from collections import OrderedDict\nfrom dataclasses import dataclass\nfrom secrets import token_urlsafe\nfrom .errors import Refused, Conflict\n\n@dataclass(frozen=True)\nclass Session:\n    id: str\n    token: str\n    subject: str\n    tenant: str\n    credential_id: str\n    expires: float\n\nclass Sessions:\n    def __init__(self, credentials, settings, clock):\n        self.credentials = credentials\n        self.settings = settings\n        self.clock = clock\n        self.rows = OrderedDict()\n\n    def prune(self):\n        now = self.clock.now()\n        for sid, session in list(self.rows.items()):\n            if session.expires <= now:\n                del self.rows[sid]\n\n    def open(self, token):\n        principal = self.credentials.authenticate(token)\n        self.prune()\n        if len(self.rows) >= self.settings.session_capacity:\n            raise Conflict('session capacity')\n        sid = token_urlsafe(24)\n        session = Session(sid, token, principal.subject, principal.tenant,\n                          principal.credential_id, self.clock.now() + self.settings.session_ttl)\n        self.rows[sid] = session\n        return {'session': sid, 'expires_in': self.settings.session_ttl}\n\n    def resolve(self, sid):\n        self.prune()\n        if not isinstance(sid, str):\n            raise Refused('session')\n        session = self.rows.get(sid)\n        if session is None:\n            raise Refused('session')\n        principal = self.credentials.authenticate(session.token)\n        if (principal.subject, principal.tenant, principal.credential_id) != (\n                session.subject, session.tenant, session.credential_id):\n            raise Refused('session identity')\n        return session, principal\n\n    def close(self, sid):\n        session, _ = self.resolve(sid)\n        del self.rows[session.id]\n        return {'closed': True}\n\n    def count(self):\n        self.prune()\n        return len(self.rows)\n","numLines":60,"startLine":1,"totalLines":60}},"tool_result_meta":[{"id":"toolu_01V8zjxWMeQJeWTa8ykewdkG","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
