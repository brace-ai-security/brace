ts))\n","numLines":23,"startLine":1,"totalLines":23}},"tool_result_meta":[{"id":"toolu_013Jw57y1AepW3wDqD8RCQFn","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
