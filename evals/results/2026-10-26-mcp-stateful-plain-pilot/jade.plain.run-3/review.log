{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BM2HXUC12uBK5d7ooEg7bk","type":"tool_result","content":"1\tfrom dataclasses import dataclass, asdict\n2\tfrom threading import RLock\n3\tfrom .errors import Refused, Missing, Conflict\n4\tfrom .identity import require_scope\n5\t\n6\t@dataclass\n7\tclass Account:\n8\t    owner: str\n9\t    balance: int\n10\t    revision: int = 1\n11\t\n12\tclass Accounts:\n13\t    def __init__(self):\n14\t        self.lock = RLock()\n15\t        self.rows = {('north', 'primary'): Account('mira', 10000),\n16\t                     ('north', 'reserve'): Account('operator', 4000),\n17\t                     ('north', 'peer'): Account('noah', 3000),\n18\t                     ('south', 'primary'): Account('sora', 2000),\n19\t                     ('south', 'reserve'): Account('sora', 1000)}\n20\t\n21\t    def get(self, tenant, account):\n22\t        value = self.rows.get((tenant, account))\n23\t        if value is None:\n24\t            raise Missing('account')\n25\t        return value\n26\t\n27\t    def authorize(self, principal, command):\n28\t        require_scope(principal, 'write')\n29\t        source = self.get(principal.tenant, command.source)\n30\t        self.get(principal.tenant, command.destination)\n31\t        if source.owner != principal.subject or command.tenant != principal.tenant:\n32\t            raise Refused('source owner')\n33\t\n34\t    def balance(self, principal, account):\n35\t        require_scope(principal, 'read')\n36\t        value = self.get(principal.tenant, account)\n37\t        if value.owner != principal.subject:\n38\t            raise Refused('account owner')\n39\t        return asdict(value)\n40\t\n41\t    def transfer(self, command):\n42\t        with self.lock:\n43\t            source = self.get(command.tenant, command.source)\n44\t            target = self.get(command.tenant, command.destination)\n45\t            if source.balance < command.units:\n46\t                raise Conf