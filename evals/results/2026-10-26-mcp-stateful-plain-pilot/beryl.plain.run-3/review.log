\n        self.membership.set_member(request.principal.tenant, project, subject, enabled)\n        return {'updated': True}\n","numLines":40,"startLine":1,"totalLines":40}},"tool_result_meta":[{"id":"toolu_01NntB8UtkW1ewh3bGH4ydce","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
