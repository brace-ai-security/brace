    24	    "run_started",
    25	    "run_finished",
    26	    "run_halted",
    27	    "model_decision",
    28	    "tool_proposed",
    29	    "authz_decision",
    30	    "approval_requested",
    31	    "approval_decided",
    32	    "tool_result",
    33	    "tool_error",
    34	    "tool_denied",
    35	    "budget_exceeded",
    36	    "subagent_started",
    37	    "subagent_finished",
    38	    "background_job",
    39	}
