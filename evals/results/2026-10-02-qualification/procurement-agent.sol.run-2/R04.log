agent/app/ingest.py:36:    re.compile(r"(?i)\byou are (now )?(an?|the) \w+ (agent|assistant)\b"),
agent/app/ingest.py:37:    re.compile(r"(?i)\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\b"),
agent/app/ingest.py:38:    re.compile(r"(?i)\b(update|change) (our|the) (bank|remit|payee)\b"),
