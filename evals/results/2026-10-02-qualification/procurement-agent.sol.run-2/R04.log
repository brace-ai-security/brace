agent/app/tools/documents.py:12:    "</untrusted_document>"
agent/app/tools/documents.py:13:)
agent/app/tools/documents.py:16:def tools(deps) -> list[Tool]:
agent/app/tools/documents.py:17:    pool = deps.pool
agent/app/tools/documents.py:19:    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:
agent/app/tools/documents.py:20:        row = await pool.fetchrow(
agent/app/tools/documents.py:21:            """
agent/app/tools/documents.py:22:            SELECT doc_id, source, media_type, text
agent/app/tools/documents.py:23:            FROM documents
agent/app/tools/documents.py:24:            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'
agent/app/tools/documents.py:25:            """,
agent/app/tools/documents.py:26:            args["doc_id"],
agent/app/tools/documents.py:27:            ident.tenant,
