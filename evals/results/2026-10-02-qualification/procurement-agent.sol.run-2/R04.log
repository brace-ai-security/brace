"""Tool registry.

Each agent role gets the tools listed for it in config/tools.yaml. The model
only sees schemas for those tools, and the loop rejects any call to a name
that is not in the run's registry.
"""
from __future__ import annotations

from dataclasses import dataclass
from functools import lru_cache
from typing import Any, Awaitable, Callable

import yaml

from app.identity import RunIdentity

DEFAULT_ROLE = "procurement"

Invoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]


@dataclass(frozen=True)
class Tool:
    name: str
    description: str
    input_schema: dict[str, Any]
    invoke: Invoke
    target_field: str | None = None

    def target_of(self, args: dict[str, Any]) -> str:
        if self.target_field is None:
            return self.name
        return str(args.get(self.target_field, ""))

    def schema(self) -> dict[str, Any]:
        return {"name": self.name, "description": self.description, "input_schema": self.input_schema}


class ToolRegistry:
    def __init__(self, tools: list[Tool]):
        self._tools = {t.name: t for t in tools}

    def get(self, name: str) -> Tool | None:
        return self._tools.get(name)

    def names(self) -> list[str]:
        return sorted(self._tools)

    def schemas(self) -> list[dict[str, Any]]:
        return [self._tools[n].schema() for n in self.names()]


@lru_cache(maxsize=1)
def _role_tools(path: str) -> dict[str, list[str]]:
    with open(path, "r", encoding="utf-8") as fh:
        cfg = yaml.safe_load(fh)
    return {role: list(spec["tools"].keys()) for role, spec in cfg["roles"].items()}


def build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:
    from app.tools import documents, erp, memory, payments, slack

    available: dict[str, Tool] = {}
    for module in (documents, erp, memory, payments, slack):
        for tool in module.tools(deps):
            available[tool.name] = tool

    roles = _role_tools(str(deps.settings.tools_path))
    allowed = roles.get(role, roles[DEFAULT_ROLE])
    return ToolRegistry([available[name] for name in allowed if name in available])
"""ERP tools: budget lookups, generic ERP reads, and purchase-order creation."""
from __future__ import annotations

from typing import Any

from app.identity import RunIdentity
from app.tools import Tool

ERP_READ_SCOPE = "erp.read"
ERP_PO_WRITE_SCOPE = "erp.read erp.po.create"


def tools(deps) -> list[Tool]:
    erp = deps.erp

    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:
        return await erp.call(
            "budget.get_remaining",
            {"business_unit": ident.tenant, "department": args["department"], "fiscal_period": args["fiscal_period"]},
            ident,
            ERP_READ_SCOPE,
        )

    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:
        arguments = dict(args.get("arguments", {}))
        arguments["business_unit"] = ident.tenant
        return await erp.call(args["operation"], arguments, ident, deps.erp_scope_for(args["operation"]))

    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:
        return await erp.call(
            "po.create",
            {
                "business_unit": ident.tenant,
                "department": args["department"],
                "vendor_id": args["vendor_id"],
                "lines": args["lines"],
                "currency": args["currency"],
                "source_doc_id": args["source_doc_id"],
                "client_reference": args["source_doc_id"],
            },
            ident,
            ERP_PO_WRITE_SCOPE,
        )

    line_schema = {
        "type": "object",
        "properties": {
            "sku": {"type": "string", "maxLength": 64},
            "description": {"type": "string", "maxLength": 256},
            "quantity": {"type": "number", "exclusiveMinimum": 0},
            "unit_price_cents": {"type": "integer", "minimum": 0},
        },
        "required": ["sku", "quantity", "unit_price_cents"],
        "additionalProperties": False,
    }

    return [
        Tool(
            name="get_budget",
            description="Remaining budget for a department in a fiscal period.",
            input_schema={
                "type": "object",
                "properties": {
                    "department": {"type": "string", "maxLength": 64},
                    "fiscal_period": {"type": "string", "pattern": "^FY[0-9]{4}-Q[1-4]$"},
                },
                "required": ["department", "fiscal_period"],
                "additionalProperties": False,
            },
            invoke=get_budget,
        ),
        Tool(
            name="erp_call",
            description=(
                "Look up ERP records (vendors, invoices, purchase orders, budgets). "
                "operation is an ERP operation name such as vendor.get or invoice.list_open."
            ),
            input_schema={
                "type": "object",
                "properties": {
                    "operation": {"type": "string", "maxLength": 64},
                    "arguments": {"type": "object"},
                },
                "required": ["operation"],
                "additionalProperties": False,
            },
            invoke=erp_call,
        ),
        Tool(
            name="create_purchase_order",
            description="Raise a purchase order in the ERP for an approved quote.",
            input_schema={
                "type": "object",
                "properties": {
                    "department": {"type": "string", "maxLength": 64},
                    "vendor_id": {"type": "string", "maxLength": 32},
                    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
                    "source_doc_id": {"type": "string", "maxLength": 64},
                    "lines": {"type": "array", "items": line_schema, "maxItems": 200},
                },
                "required": ["department", "vendor_id", "currency", "source_doc_id", "lines"],
                "additionalProperties": False,
            },
            invoke=create_purchase_order,
            target_field="source_doc_id",
        ),
    ]
"""Client for the ERP MCP server, reached through the internal MCP gateway.

On startup the tool list is fetched and each tool's description and input
schema are fingerprinted and compared with the pins in the release manifest.
Any unpinned or changed tool stops startup. Tool metadata is also scanned for
instruction-like content before any of it is shown to the model.
"""
from __future__ import annotations

import hashlib
import json
import logging
import re
import uuid
from typing import Any

import httpx

from app.identity import RunIdentity, TokenBroker
from app.redact import redact_text

log = logging.getLogger(__name__)

MAX_DESCRIPTION_CHARS = 1024
SUSPICIOUS_METADATA = [
    re.compile(r"(?i)ignore (all|any|previous|prior) instructions"),
    re.compile(r"(?i)\b(system prompt|you are now|act as)\b"),
    re.compile(r"(?i)\b(before|instead of) (calling|using) \w+\.\w+"),
    re.compile(r"[​-‏‪-‮⁠-⁤]"),
    re.compile(r"[A-Za-z0-9+/]{120,}={0,2}"),
]


class ToolPinMismatch(Exception):
    pass


class UnknownErpOperation(Exception):
    pass


def fingerprint(tool: dict[str, Any]) -> str:
    material = {
        "name": tool["name"],
        "description": tool.get("description", ""),
        "inputSchema": tool.get("inputSchema", {}),
        "annotations": tool.get("annotations", {}),
    }
    raw = json.dumps(material, sort_keys=True, separators=(",", ":"))
    return "sha256:" + hashlib.sha256(raw.encode("utf-8")).hexdigest()


def scan_metadata(tool: dict[str, Any]) -> None:
    description = tool.get("description", "")
    if len(description) > MAX_DESCRIPTION_CHARS:
        raise ToolPinMismatch(f"{tool['name']}: description too long")
    blob = json.dumps(tool, ensure_ascii=False)
    for pattern in SUSPICIOUS_METADATA:
        if pattern.search(blob):
            raise ToolPinMismatch(f"{tool['name']}: suspicious metadata ({pattern.pattern})")


class ErpMcpClient:
    AUDIENCE = "erp-mcp-gateway"

    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):
        self.url = url
        self.pins = pins
        self.broker = broker
        self._tools: dict[str, dict[str, Any]] = {}

    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:
        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:
            resp = await client.post(
                self.url,
                json={"jsonrpc": "2.0", "id": str(uuid.uuid4()), "method": method, "params": params},
                headers={"Authorization": f"Bearer {token}", "Mcp-Protocol-Version": "2025-06-18"},
            )
        resp.raise_for_status()
        if len(resp.content) > 512_000:
            raise ValueError("erp response too large")
        body = resp.json()
        if "error" in body:
            raise RuntimeError(f"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}")
        return body["result"]

    async def _list_tools(self, token: str) -> list[dict[str, Any]]:
        result = await self._rpc("tools/list", {}, token)
        return list(result.get("tools", []))

    async def initialize(self, service_ident: RunIdentity) -> None:
        token = await self.broker.token_for(self.AUDIENCE, "erp.tools.list", service_ident)
        tools = await self._list_tools(token)
        for tool in tools:
            expected = self.pins.get(tool["name"])
            actual = fingerprint(tool)
            if expected != actual:
                raise ToolPinMismatch(f"{tool['name']}: expected {expected}, got {actual}")
            scan_metadata(tool)
        self._tools = {t["name"]: t for t in tools}
        log.info("erp tools loaded: %d", len(self._tools))

    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:
        if message.get("method") == "notifications/tools/list_changed":
            await self.refresh_tools(service_ident)

    async def refresh_tools(self, service_ident: RunIdentity) -> None:
        token = await self.broker.token_for(self.AUDIENCE, "erp.tools.list", service_ident)
        tools = await self._list_tools(token)
        self._tools = {t["name"]: t for t in tools}
        log.info("erp tools refreshed: %d", len(self._tools))

    def operations(self) -> list[str]:
        return sorted(self._tools)

    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:
        if operation not in self._tools:
            raise UnknownErpOperation(operation)
        token = await self.broker.token_for(self.AUDIENCE, scope, ident)
        result = await self._rpc(
            "tools/call",
            {
                "name": operation,
                "arguments": arguments,
                "_meta": {"business_unit": ident.tenant, "run_id": ident.run_id},
            },
            token,
        )
        if result.get("isError"):
            raise RuntimeError(redact_text(json.dumps(result.get("content", []))))
        return result.get("structuredContent") or result.get("content")
"""Inbound documents: vendor quotes and invoices from the mail gateway.

The mail gateway posts each received message to ``/ingest/mail`` signed with
an HMAC over the timestamp and body. Accepted documents are stored per
business unit and are only ever shown to the model inside an
``untrusted_document`` wrapper (tools/documents.py).
"""
from __future__ import annotations

import base64
import email
import email.policy
import hashlib
import hmac
import io
import re
import time
import uuid
from dataclasses import dataclass
from pathlib import Path

from fastapi import APIRouter, HTTPException, Request
from pypdf import PdfReader

router = APIRouter()

MAX_BODY_BYTES = 10 * 1024 * 1024
MAX_TEXT_CHARS = 200_000
MAX_SKEW_SECONDS = 300
ALLOWED_MEDIA_TYPES = {"application/pdf", "text/plain", "message/rfc822"}
SCANNED_MEDIA_TYPES = {"application/pdf", "text/plain"}

INJECTION_PATTERNS = [
    re.compile(r"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)"),
    re.compile(r"(?i)\b(system|developer) (prompt|message)\b"),
    re.compile(r"(?i)\byou are (now )?(an?|the) \w+ (agent|assistant)\b"),
    re.compile(r"(?i)\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\b"),
    re.compile(r"(?i)\b(update|change) (our|the) (bank|remit|payee)\b"),
    re.compile(r"[​-‏‪-‮⁠-⁤]"),
]


class Rejected(Exception):
    pass


@dataclass
class Inbound:
    business_unit: str
    sender: str
    media_type: str
    raw: bytes


def verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:
    try:
        ts = int(timestamp)
    except ValueError as exc:
        raise Rejected("bad timestamp") from exc
    if abs(time.time() - ts) > MAX_SKEW_SECONDS:
        raise Rejected("stale request")
    expected = hmac.new(key, f"{timestamp}.".encode() + body, hashlib.sha256).hexdigest()
    if not hmac.compare_digest(expected, signature):
        raise Rejected("bad signature")


def extract_text(doc: Inbound) -> str:
    if doc.media_type == "application/pdf":
        reader = PdfReader(io.BytesIO(doc.raw))
        if len(reader.pages) > 50:
            raise Rejected("too many pages")
        return "\n".join(page.extract_text() or "" for page in reader.pages)
    if doc.media_type == "message/rfc822":
        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)
        body = msg.get_body(preferencelist=("plain", "html"))
        return body.get_content() if body is not None else ""
    return doc.raw.decode("utf-8", errors="strict")


def scan_for_injection(text: str) -> list[str]:
    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]


def validate(doc: Inbound) -> str:
    if doc.media_type not in ALLOWED_MEDIA_TYPES:
        raise Rejected(f"media type {doc.media_type} not accepted")
    if len(doc.raw) > MAX_BODY_BYTES:
        raise Rejected("document too large")
    try:
        text = extract_text(doc)
    except Rejected:
        raise
    except Exception as exc:
        raise Rejected(f"unreadable document: {type(exc).__name__}") from exc
    if len(text) > MAX_TEXT_CHARS:
        raise Rejected("extracted text too long")
    if doc.media_type in SCANNED_MEDIA_TYPES:
        findings = scan_for_injection(text)
        if findings:
            raise Rejected("possible prompt injection: " + "; ".join(findings))
    return text


@router.post("/ingest/mail")
async def ingest_mail(request: Request) -> dict:
    body = await request.body()
    if len(body) > MAX_BODY_BYTES * 2:
        raise HTTPException(413, "payload too large")
    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()
    try:
        verify_signature(
            key,
            request.headers.get("X-Gateway-Timestamp", ""),
            body,
            request.headers.get("X-Gateway-Signature", ""),
        )
    except Rejected as exc:
        raise HTTPException(401, str(exc)) from exc

    payload = await request.json()
    doc = Inbound(
        business_unit=payload["business_unit"],
        sender=payload["from"],
        media_type=payload["media_type"],
        raw=base64.b64decode(payload["content_b64"], validate=True),
    )
    doc_id = f"doc-{uuid.uuid4().hex[:20]}"
    pool = request.app.state.pool
    try:
        text = validate(doc)
    except Rejected as exc:
        await pool.execute(
            """
            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)
            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())
            """,
            doc_id, doc.business_unit, doc.sender, doc.media_type,
            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],
        )
        return {"doc_id": doc_id, "status": "quarantined"}

    await pool.execute(
        """
        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)
        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())
        """,
        doc_id, doc.business_unit, doc.sender, doc.media_type,
        hashlib.sha256(doc.raw).hexdigest(), text,
    )
    return {"doc_id": doc_id, "status": "accepted"}
