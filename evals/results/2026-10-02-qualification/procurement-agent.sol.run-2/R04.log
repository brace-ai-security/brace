agent/app/loop.py:1:"""Procurement agent run loop.
agent/app/loop.py:3:Graph: model turn -> (tool calls -> gate -> integration)* -> model turn ...
agent/app/loop.py:4:Every edge writes an audit node before the next step runs. Budgets are
agent/app/loop.py:5:checked before each model turn and each tool call.
agent/app/loop.py:6:"""
agent/app/loop.py:7:from __future__ import annotations
agent/app/loop.py:9:import hashlib
agent/app/loop.py:10:import logging
agent/app/loop.py:11:from dataclasses import dataclass, field
agent/app/loop.py:12:from typing import Any
agent/app/loop.py:14:from opentelemetry import trace
agent/app/loop.py:16:from app import audit, killswitch
agent/app/loop.py:17:from app.budget import Budget, BudgetExceeded
agent/app/loop.py:18:from app.context_size import ContextMeasure, measure_context
agent/app/loop.py:19:from app.gate import PolicyGate
agent/app/loop.py:20:from app.identity import RunIdentity
agent/app/loop.py:21:from app.redact import redact_for_model
agent/app/loop.py:22:from app.tools import ToolRegistry, build_registry
agent/app/loop.py:24:log = logging.getLogger(__name__)
agent/app/loop.py:25:tracer = trace.get_tracer("procurement.loop")
agent/app/loop.py:27:COMPACT_AFTER_MESSAGES = 40
agent/app/loop.py:28:KEEP_RECENT_MESSAGES = 12
agent/app/loop.py:31:@dataclass
agent/app/loop.py:32:class AgentDeps:
agent/app/loop.py:33:    settings: Any
agent/app/loop.py:34:    pool: Any
agent/app/loop.py:35:    gate: PolicyGate
agent/app/loop.py:36:    erp: Any
agent/app/loop.py:37:    slack: Any
agent/app/loop.py:38:    broker: Any
agent/app/loop.py:39:    extractor: Any = None
agent/app/loop.py:40:    _budgets: dict[str, Budget] = field(default_factory=dict)
agent/app/loop.py:41:    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)
agent/app/loop.py:43:    def current_budget(self, ident: RunIdentity) -> Budget:
agent/app/loop.py:44:        return self._budgets[ident.run_id]
agent/app/loop.py:46:    def current_context(self, ident: RunIdentity) -> ContextMeasure:
agent/app/loop.py:47:        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())
agent/app/loop.py:49:    def erp_scope_for(self, operation: str) -> str:
agent/app/loop.py:50:        scopes = self.settings.policy["erp"]["operation_scopes"]
agent/app/loop.py:51:        return scopes.get(operation, "erp.read")
agent/app/loop.py:53:    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:
agent/app/loop.py:54:        self._contexts[ident.agent_instance_id] = ctx
agent/app/loop.py:55:        proposed = await audit.record(
agent/app/loop.py:56:            self.pool, ident, kind="tool_proposed", parent=parent, context=ctx,
agent/app/loop.py:57:            payload={"tool": use.name, "tool_use_id": use.id, "args": audit.summarize_args(use.input)},
agent/app/loop.py:58:        )
agent/app/loop.py:59:        tool = registry.get(use.name)
agent/app/loop.py:60:        if tool is None:
agent/app/loop.py:61:            await audit.record(
agent/app/loop.py:62:                self.pool, ident, kind="tool_denied", parent=proposed, context=ctx,
agent/app/loop.py:63:                policy_version=self.gate.version, payload={"reason": "tool not in role allowlist"},
agent/app/loop.py:64:            )
agent/app/loop.py:65:            return _error(use.id, f"tool {use.name} is not available to this agent")
agent/app/loop.py:67:        decision = await self.gate.authorize(ident, tool, use.input)
agent/app/loop.py:68:        authz = await audit.record(
agent/app/loop.py:69:            self.pool, ident, kind="authz_decision", parent=proposed, context=ctx,
agent/app/loop.py:70:            policy_version=decision.policy_version, approval_id=decision.approval_id,
agent/app/loop.py:71:            payload={"allow": decision.allow, "reason": decision.reason, "pending": decision.pending},
agent/app/loop.py:72:        )
agent/app/loop.py:73:        if not decision.allow:
agent/app/loop.py:74:            if decision.pending:
agent/app/loop.py:75:                return _error(use.id, f"approval requested ({decision.approval_id}); do not retry until approved")
agent/app/loop.py:76:            return _error(use.id, f"denied: {decision.reason}")
agent/app/loop.py:78:        operation_id = f"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}"
agent/app/loop.py:79:        try:
agent/app/loop.py:80:            with tracer.start_as_current_span(f"execute_tool {use.name}") as span:
agent/app/loop.py:81:                for k, v in ctx.otel_attributes().items():
agent/app/loop.py:82:                    span.set_attribute(k, v)
agent/app/loop.py:83:                output = await tool.invoke(use.input, ident)
agent/app/loop.py:84:        except BudgetExceeded:
agent/app/loop.py:85:            raise
agent/app/loop.py:86:        except Exception as exc:
agent/app/loop.py:87:            await audit.record(
agent/app/loop.py:88:                self.pool, ident, kind="tool_error", parent=authz, context=ctx,
agent/app/loop.py:89:                policy_version=decision.policy_version, approval_id=decision.approval_id,
agent/app/loop.py:90:                operation_id=operation_id,
agent/app/loop.py:91:                payload={"error_type": type(exc).__name__, "error": str(exc)[:500]},
agent/app/loop.py:92:            )
agent/app/loop.py:93:            return _error(use.id, f"{use.name} failed: {type(exc).__name__}")
agent/app/loop.py:95:        await audit.record(
agent/app/loop.py:96:            self.pool, ident, kind="tool_result", parent=authz, context=ctx,
agent/app/loop.py:97:            policy_version=decision.policy_version, approval_id=decision.approval_id,
agent/app/loop.py:98:            operation_id=operation_id,
agent/app/loop.py:99:            payload={"result_sha256": audit.digest(output), "result": output},
agent/app/loop.py:100:        )
agent/app/loop.py:101:        return {"type": "tool_result", "tool_use_id": use.id, "content": redact_for_model(output)}
agent/app/loop.py:104:def _error(tool_use_id: str, message: str) -> dict:
agent/app/loop.py:105:    return {"type": "tool_result", "tool_use_id": tool_use_id, "is_error": True, "content": message}
agent/app/loop.py:108:def _compact(messages: list[dict]) -> tuple[list[dict], bool]:
agent/app/loop.py:109:    if len(messages) <= COMPACT_AFTER_MESSAGES:
agent/app/loop.py:110:        return messages, False
agent/app/loop.py:111:    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]
agent/app/loop.py:112:    while tail and tail[0]["role"] != "assistant":
agent/app/loop.py:113:        tail = tail[1:]
agent/app/loop.py:114:    note = {"role": "user", "content": "[earlier tool exchanges were removed to save space]"}
agent/app/loop.py:115:    return head + [note] + tail, True
agent/app/loop.py:118:class ProcurementAgent:
agent/app/loop.py:119:    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = "procurement"):
agent/app/loop.py:120:        self.client = client
agent/app/loop.py:121:        self.deps = deps
agent/app/loop.py:122:        self.system_prompt = system_prompt
agent/app/loop.py:123:        self.role = role
agent/app/loop.py:125:    async def run(self, ident: RunIdentity, task: str) -> str | None:
agent/app/loop.py:126:        pool = self.deps.pool
agent/app/loop.py:127:        await killswitch.assert_running(pool, ident.tenant)
agent/app/loop.py:128:        budget = Budget.for_run(self.deps.settings.budgets, ident)
agent/app/loop.py:129:        await budget.reserve_run_start(pool)
agent/app/loop.py:130:        self.deps._budgets[ident.run_id] = budget
agent/app/loop.py:131:        registry = build_registry(self.role, ident, self.deps)
agent/app/loop.py:133:        run_node = await audit.record(
agent/app/loop.py:134:            pool, ident, kind="run_started",
agent/app/loop.py:135:            payload={"task_sha256": hashlib.sha256(task.encode()).hexdigest(), "tools": registry.names()},
agent/app/loop.py:136:        )
agent/app/loop.py:137:        messages: list[dict[str, Any]] = [{"role": "user", "content": task}]
agent/app/loop.py:138:        try:
agent/app/loop.py:139:            while True:
agent/app/loop.py:140:                budget.check_step()
agent/app/loop.py:141:                messages, compacted = _compact(messages)
agent/app/loop.py:142:                request = {
agent/app/loop.py:143:                    "model": self.deps.settings.model_id,
agent/app/loop.py:144:                    "system": self.system_prompt,
agent/app/loop.py:145:                    "messages": messages,
agent/app/loop.py:146:                    "tools": registry.schemas(),
agent/app/loop.py:147:                    "max_tokens": 4096,
agent/app/loop.py:148:                }
agent/app/loop.py:149:                ctx = await measure_context(self.client, request, compacted)
agent/app/loop.py:150:                response = await self.client.messages.create(**request)
agent/app/loop.py:151:                budget.charge_model(self.deps.settings.model_id, response.usage)
agent/app/loop.py:152:                await budget.flush(pool)
agent/app/loop.py:153:                ctx = ctx.finalize(response.usage)
agent/app/loop.py:154:                decision = await audit.record(
agent/app/loop.py:155:                    pool, ident, kind="model_decision", parent=run_node, context=ctx,
agent/app/loop.py:156:                    payload={
agent/app/loop.py:157:                        "requested_model": request["model"],
agent/app/loop.py:158:                        "served_model": response.model,
agent/app/loop.py:159:                        "stop_reason": response.stop_reason,
agent/app/loop.py:160:                        "proposed_tools": [b.name for b in response.content if b.type == "tool_use"],
agent/app/loop.py:161:                    },
agent/app/loop.py:162:                )
agent/app/loop.py:163:                messages.append({"role": "assistant", "content": response.content})
agent/app/loop.py:164:                uses = [b for b in response.content if b.type == "tool_use"]
agent/app/loop.py:165:                if not uses:
agent/app/loop.py:166:                    final = "".join(b.text for b in response.content if b.type == "text")
agent/app/loop.py:167:                    await audit.record(pool, ident, kind="run_finished", parent=run_node, context=ctx,
agent/app/loop.py:168:                                       payload={"final_sha256": audit.digest(final)})
agent/app/loop.py:169:                    return final
agent/app/loop.py:170:                results = []
agent/app/loop.py:171:                for use in uses:
agent/app/loop.py:172:                    budget.check_tool_call()
agent/app/loop.py:173:                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))
agent/app/loop.py:174:                messages.append({"role": "user", "content": results})
agent/app/loop.py:175:        except BudgetExceeded as exc:
agent/app/loop.py:176:            await audit.record(
agent/app/loop.py:177:                pool, ident, kind="budget_exceeded", parent=run_node,
agent/app/loop.py:178:                payload={"limit": exc.limit, "used": str(exc.used), "allowed": str(exc.allowed)},
agent/app/loop.py:179:            )
agent/app/loop.py:180:            await self.deps.slack.post(
agent/app/loop.py:181:                channel="#procurement-agent-ops",
agent/app/loop.py:182:                text=f"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.",
agent/app/loop.py:183:            )
agent/app/loop.py:184:            return None
agent/app/loop.py:185:        finally:
agent/app/loop.py:186:            self.deps._budgets.pop(ident.run_id, None)
agent/app/tools/memory.py:1:"""Per-department notes kept between runs (Postgres ``dept_notes``).
agent/app/tools/memory.py:3:Writes are restricted to a fixed set of note kinds, length-limited, checked
agent/app/tools/memory.py:4:for instruction-like content, and stored as unverified with a 30-day expiry
agent/app/tools/memory.py:5:until a procurement lead verifies them in the admin UI. Every row records
agent/app/tools/memory.py:6:who wrote it, from which run and source document, and the context size at
agent/app/tools/memory.py:7:the time.
agent/app/tools/memory.py:8:"""
agent/app/tools/memory.py:9:from __future__ import annotations
agent/app/tools/memory.py:11:import re
agent/app/tools/memory.py:12:import uuid
agent/app/tools/memory.py:13:from typing import Any
agent/app/tools/memory.py:15:from app.identity import RunIdentity
agent/app/tools/memory.py:16:from app.tools import Tool
agent/app/tools/memory.py:18:NOTE_KINDS = ("vendor_preference", "contract_term", "budget_note", "contact")
agent/app/tools/memory.py:19:MAX_NOTE_CHARS = 800
agent/app/tools/memory.py:20:INSTRUCTION_LIKE = [
agent/app/tools/memory.py:21:    re.compile(r"(?i)\b(ignore|disregard|override)\b.{0,40}\b(instruction|policy|approval|rule)s?\b"),
agent/app/tools/memory.py:22:    re.compile(r"(?i)\b(always|never|must)\b.{0,40}\b(approve|pay|skip|send|transfer)\b"),
agent/app/tools/memory.py:23:    re.compile(r"(?i)\b(system prompt|you are|assistant:)\b"),
agent/app/tools/memory.py:24:    re.compile(r"https?://"),
agent/app/tools/memory.py:25:]
agent/app/tools/memory.py:28:class NoteRejected(Exception):
agent/app/tools/memory.py:29:    pass
agent/app/tools/memory.py:32:def check_note(text: str) -> None:
agent/app/tools/memory.py:33:    if len(text) > MAX_NOTE_CHARS:
agent/app/tools/memory.py:34:        raise NoteRejected("note too long")
agent/app/tools/memory.py:35:    for pattern in INSTRUCTION_LIKE:
agent/app/tools/memory.py:36:        if pattern.search(text):
agent/app/tools/memory.py:37:            raise NoteRejected("note looks like an instruction")
agent/app/tools/memory.py:40:def tools(deps) -> list[Tool]:
agent/app/tools/memory.py:41:    pool = deps.pool
agent/app/tools/memory.py:43:    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:
agent/app/tools/memory.py:44:        business_unit = args.get("business_unit") or ident.tenant
agent/app/tools/memory.py:45:        rows = await pool.fetch(
agent/app/tools/memory.py:46:            """
agent/app/tools/memory.py:47:            SELECT note_id, kind, body, verified, writer_instance, created_at
agent/app/tools/memory.py:48:            FROM dept_notes
agent/app/tools/memory.py:49:            WHERE business_unit = $1
agent/app/tools/memory.py:50:              AND department = $2
agent/app/tools/memory.py:51:              AND NOT quarantined
agent/app/tools/memory.py:52:              AND (verified OR expires_at > now())
agent/app/tools/memory.py:53:            ORDER BY created_at DESC
agent/app/tools/memory.py:54:            LIMIT 20
agent/app/tools/memory.py:55:            """,
agent/app/tools/memory.py:56:            business_unit,
agent/app/tools/memory.py:57:            args["department"],
agent/app/tools/memory.py:58:        )
agent/app/tools/memory.py:59:        return [
agent/app/tools/memory.py:60:            {
agent/app/tools/memory.py:61:                "note_id": r["note_id"],
agent/app/tools/memory.py:62:                "kind": r["kind"],
agent/app/tools/memory.py:63:                "body": r["body"],
agent/app/tools/memory.py:64:                "trust": "verified" if r["verified"] else "unverified",
agent/app/tools/memory.py:65:                "written": r["created_at"].isoformat(),
agent/app/tools/memory.py:66:            }
agent/app/tools/memory.py:67:            for r in rows
agent/app/tools/memory.py:68:        ]
agent/app/tools/memory.py:70:    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:
agent/app/tools/memory.py:71:        if args["kind"] not in NOTE_KINDS:
agent/app/tools/memory.py:72:            raise NoteRejected(f"unknown note kind {args['kind']}")
agent/app/tools/memory.py:73:        check_note(args["body"])
agent/app/tools/memory.py:74:        note_id = f"note-{uuid.uuid4()}"
agent/app/tools/memory.py:75:        ctx = deps.current_context(ident)
agent/app/tools/memory.py:76:        await pool.execute(
agent/app/tools/memory.py:77:            """
agent/app/tools/memory.py:78:            INSERT INTO dept_notes (
agent/app/tools/memory.py:79:                note_id, business_unit, department, kind, body,
agent/app/tools/memory.py:80:                verified, quarantined, expires_at,
agent/app/tools/memory.py:81:                writer_instance, writer_type_id, run_id, source_doc_id,
agent/app/tools/memory.py:82:                delegated_subject, context_tokens, context_method, created_at
agent/app/tools/memory.py:83:            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',
agent/app/tools/memory.py:84:                      $6, $7, $8, $9, $10, $11, $12, now())
agent/app/tools/memory.py:85:            """,
agent/app/tools/memory.py:86:            note_id,
agent/app/tools/memory.py:87:            ident.tenant,
agent/app/tools/memory.py:88:            args["department"],
agent/app/tools/memory.py:89:            args["kind"],
agent/app/tools/memory.py:90:            args["body"],
agent/app/tools/memory.py:91:            ident.agent_instance_id,
agent/app/tools/memory.py:92:            ident.agent_type_id,
agent/app/tools/memory.py:93:            ident.run_id,
agent/app/tools/memory.py:94:            args.get("source_doc_id"),
agent/app/tools/memory.py:95:            ident.delegated_subject,
agent/app/tools/memory.py:96:            ctx.tokens,
agent/app/tools/memory.py:97:            ctx.method,
agent/app/tools/memory.py:98:        )
agent/app/tools/memory.py:99:        return {"note_id": note_id, "status": "stored_unverified"}
agent/app/tools/memory.py:101:    return [
agent/app/tools/memory.py:102:        Tool(
agent/app/tools/memory.py:103:            name="memory_read",
agent/app/tools/memory.py:104:            description=(
agent/app/tools/memory.py:105:                "Read saved notes for a department. business_unit defaults to the current one; "
agent/app/tools/memory.py:106:                "shared-services staff may look up another unit's notes."
agent/app/tools/memory.py:107:            ),
agent/app/tools/memory.py:108:            input_schema={
agent/app/tools/memory.py:109:                "type": "object",
agent/app/tools/memory.py:110:                "properties": {
agent/app/tools/memory.py:111:                    "department": {"type": "string", "maxLength": 64},
agent/app/tools/memory.py:112:                    "business_unit": {"type": "string", "maxLength": 32},
agent/app/tools/memory.py:113:                },
agent/app/tools/memory.py:114:                "required": ["department"],
agent/app/tools/memory.py:115:                "additionalProperties": False,
agent/app/tools/memory.py:116:            },
agent/app/tools/memory.py:117:            invoke=memory_read,
agent/app/tools/memory.py:118:        ),
agent/app/tools/memory.py:119:        Tool(
agent/app/tools/memory.py:120:            name="memory_write",
agent/app/tools/memory.py:121:            description="Save a short factual note for a department (vendor preference, contract term, budget note, contact).",
agent/app/tools/memory.py:122:            input_schema={
agent/app/tools/memory.py:123:                "type": "object",
agent/app/tools/memory.py:124:                "properties": {
agent/app/tools/memory.py:125:                    "department": {"type": "string", "maxLength": 64},
agent/app/tools/memory.py:126:                    "kind": {"type": "string", "enum": list(NOTE_KINDS)},
agent/app/tools/memory.py:127:                    "body": {"type": "string", "maxLength": MAX_NOTE_CHARS},
agent/app/tools/memory.py:128:                    "source_doc_id": {"type": "string", "maxLength": 64},
agent/app/tools/memory.py:129:                },
agent/app/tools/memory.py:130:                "required": ["department", "kind", "body"],
agent/app/tools/memory.py:131:                "additionalProperties": False,
agent/app/tools/memory.py:132:            },
agent/app/tools/memory.py:133:            invoke=memory_write,
agent/app/tools/memory.py:134:        ),
agent/app/tools/memory.py:135:    ]
agent/app/tools/documents.py:1:"""Document tools: read an ingested quote or invoice, and extract line items."""
agent/app/tools/documents.py:2:from __future__ import annotations
agent/app/tools/documents.py:4:from typing import Any
agent/app/tools/documents.py:6:from app.identity import RunIdentity
agent/app/tools/documents.py:7:from app.tools import Tool
agent/app/tools/documents.py:9:UNTRUSTED_WRAPPER = (
agent/app/tools/documents.py:10:    "<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\n"
