agent/app/mcp_client.py:1:"""Client for the ERP MCP server, reached through the internal MCP gateway.
agent/app/mcp_client.py:3:On startup the tool list is fetched and each tool's description and input
agent/app/mcp_client.py:4:schema are fingerprinted and compared with the pins in the release manifest.
agent/app/mcp_client.py:5:Any unpinned or changed tool stops startup. Tool metadata is also scanned for
agent/app/mcp_client.py:6:instruction-like content before any of it is shown to the model.
agent/app/mcp_client.py:7:"""
agent/app/mcp_client.py:8:from __future__ import annotations
agent/app/mcp_client.py:10:import hashlib
agent/app/mcp_client.py:11:import json
agent/app/mcp_client.py:12:import logging
agent/app/mcp_client.py:13:import re
agent/app/mcp_client.py:14:import uuid
agent/app/mcp_client.py:15:from typing import Any
agent/app/mcp_client.py:17:import httpx
agent/app/mcp_client.py:19:from app.identity import RunIdentity, TokenBroker
agent/app/mcp_client.py:20:from app.redact import redact_text
agent/app/mcp_client.py:22:log = logging.getLogger(__name__)
agent/app/mcp_client.py:24:MAX_DESCRIPTION_CHARS = 1024
agent/app/mcp_client.py:25:SUSPICIOUS_METADATA = [
agent/app/mcp_client.py:26:    re.compile(r"(?i)ignore (all|any|previous|prior) instructions"),
agent/app/mcp_client.py:27:    re.compile(r"(?i)\b(system prompt|you are now|act as)\b"),
agent/app/mcp_client.py:28:    re.compile(r"(?i)\b(before|instead of) (calling|using) \w+\.\w+"),
agent/app/mcp_client.py:29:    re.compile(r"[​-‏‪-‮⁠-⁤]"),
agent/app/mcp_client.py:30:    re.compile(r"[A-Za-z0-9+/]{120,}={0,2}"),
agent/app/mcp_client.py:31:]
agent/app/mcp_client.py:34:class ToolPinMismatch(Exception):
agent/app/mcp_client.py:35:    pass
agent/app/mcp_client.py:38:class UnknownErpOperation(Exception):
agent/app/mcp_client.py:39:    pass
agent/app/mcp_client.py:42:def fingerprint(tool: dict[str, Any]) -> str:
agent/app/mcp_client.py:43:    material = {
agent/app/mcp_client.py:44:        "name": tool["name"],
agent/app/mcp_client.py:45:        "description": tool.get("description", ""),
agent/app/mcp_client.py:46:        "inputSchema": tool.get("inputSchema", {}),
agent/app/mcp_client.py:47:        "annotations": tool.get("annotations", {}),
agent/app/mcp_client.py:48:    }
agent/app/mcp_client.py:49:    raw = json.dumps(material, sort_keys=True, separators=(",", ":"))
agent/app/mcp_client.py:50:    return "sha256:" + hashlib.sha256(raw.encode("utf-8")).hexdigest()
agent/app/mcp_client.py:53:def scan_metadata(tool: dict[str, Any]) -> None:
agent/app/mcp_client.py:54:    description = tool.get("description", "")
agent/app/mcp_client.py:55:    if len(description) > MAX_DESCRIPTION_CHARS:
agent/app/mcp_client.py:56:        raise ToolPinMismatch(f"{tool['name']}: description too long")
agent/app/mcp_client.py:57:    blob = json.dumps(tool, ensure_ascii=False)
agent/app/mcp_client.py:58:    for pattern in SUSPICIOUS_METADATA:
agent/app/mcp_client.py:59:        if pattern.search(blob):
agent/app/mcp_client.py:60:            raise ToolPinMismatch(f"{tool['name']}: suspicious metadata ({pattern.pattern})")
agent/app/mcp_client.py:63:class ErpMcpClient:
agent/app/mcp_client.py:64:    AUDIENCE = "erp-mcp-gateway"
agent/app/mcp_client.py:66:    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):
agent/app/mcp_client.py:67:        self.url = url
agent/app/mcp_client.py:68:        self.pins = pins
agent/app/mcp_client.py:69:        self.broker = broker
agent/app/mcp_client.py:70:        self._tools: dict[str, dict[str, Any]] = {}
agent/app/mcp_client.py:72:    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:
agent/app/mcp_client.py:73:        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:
agent/app/mcp_client.py:74:            resp = await client.post(
agent/app/mcp_client.py:75:                self.url,
agent/app/mcp_client.py:76:                json={"jsonrpc": "2.0", "id": str(uuid.uuid4()), "method": method, "params": params},
agent/app/mcp_client.py:77:                headers={"Authorization": f"Bearer {token}", "Mcp-Protocol-Version": "2025-06-18"},
agent/app/mcp_client.py:78:            )
agent/app/mcp_client.py:79:        resp.raise_for_status()
agent/app/mcp_client.py:80:        if len(resp.content) > 512_000:
agent/app/mcp_client.py:81:            raise ValueError("erp response too large")
agent/app/mcp_client.py:82:        body = resp.json()
agent/app/mcp_client.py:83:        if "error" in body:
agent/app/mcp_client.py:84:            raise RuntimeError(f"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}")
agent/app/mcp_client.py:85:        return body["result"]
agent/app/mcp_client.py:87:    async def _list_tools(self, token: str) -> list[dict[str, Any]]:
agent/app/mcp_client.py:88:        result = await self._rpc("tools/list", {}, token)
agent/app/mcp_client.py:89:        return list(result.get("tools", []))
agent/app/mcp_client.py:91:    async def initialize(self, service_ident: RunIdentity) -> None:
agent/app/mcp_client.py:92:        token = await self.broker.token_for(self.AUDIENCE, "erp.tools.list", service_ident)
agent/app/mcp_client.py:93:        tools = await self._list_tools(token)
agent/app/mcp_client.py:94:        for tool in tools:
agent/app/mcp_client.py:95:            expected = self.pins.get(tool["name"])
agent/app/mcp_client.py:96:            actual = fingerprint(tool)
agent/app/mcp_client.py:97:            if expected != actual:
agent/app/mcp_client.py:98:                raise ToolPinMismatch(f"{tool['name']}: expected {expected}, got {actual}")
agent/app/mcp_client.py:99:            scan_metadata(tool)
agent/app/mcp_client.py:100:        self._tools = {t["name"]: t for t in tools}
agent/app/mcp_client.py:101:        log.info("erp tools loaded: %d", len(self._tools))
agent/app/mcp_client.py:103:    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:
agent/app/mcp_client.py:104:        if message.get("method") == "notifications/tools/list_changed":
agent/app/mcp_client.py:105:            await self.refresh_tools(service_ident)
agent/app/mcp_client.py:107:    async def refresh_tools(self, service_ident: RunIdentity) -> None:
agent/app/mcp_client.py:108:        token = await self.broker.token_for(self.AUDIENCE, "erp.tools.list", service_ident)
agent/app/mcp_client.py:109:        tools = await self._list_tools(token)
agent/app/mcp_client.py:110:        self._tools = {t["name"]: t for t in tools}
agent/app/mcp_client.py:111:        log.info("erp tools refreshed: %d", len(self._tools))
agent/app/mcp_client.py:113:    def operations(self) -> list[str]:
agent/app/mcp_client.py:114:        return sorted(self._tools)
agent/app/mcp_client.py:116:    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:
agent/app/mcp_client.py:117:        if operation not in self._tools:
agent/app/mcp_client.py:118:            raise UnknownErpOperation(operation)
agent/app/mcp_client.py:119:        token = await self.broker.token_for(self.AUDIENCE, scope, ident)
agent/app/mcp_client.py:120:        result = await self._rpc(
agent/app/mcp_client.py:121:            "tools/call",
agent/app/mcp_client.py:122:            {
agent/app/mcp_client.py:123:                "name": operation,
agent/app/mcp_client.py:124:                "arguments": arguments,
agent/app/mcp_client.py:125:                "_meta": {"business_unit": ident.tenant, "run_id": ident.run_id},
agent/app/mcp_client.py:126:            },
agent/app/mcp_client.py:127:            token,
agent/app/mcp_client.py:128:        )
agent/app/mcp_client.py:129:        if result.get("isError"):
agent/app/mcp_client.py:130:            raise RuntimeError(redact_text(json.dumps(result.get("content", []))))
agent/app/mcp_client.py:131:        return result.get("structuredContent") or result.get("content")
agent/app/ingest.py:1:"""Inbound documents: vendor quotes and invoices from the mail gateway.
agent/app/ingest.py:3:The mail gateway posts each received message to ``/ingest/mail`` signed with
agent/app/ingest.py:4:an HMAC over the timestamp and body. Accepted documents are stored per
agent/app/ingest.py:5:business unit and are only ever shown to the model inside an
agent/app/ingest.py:6:``untrusted_document`` wrapper (tools/documents.py).
