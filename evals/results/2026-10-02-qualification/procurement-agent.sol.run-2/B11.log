description = "Procurement agent: quotes, purchase orders, invoice payment."
requires-python = ">=3.11"
dependencies = [
  "fastapi==0.115.6",
  "uvicorn==0.32.1",
  "asyncpg==0.30.0",
  "httpx==0.28.1",
  "pydantic==2.10.4",
  "pyyaml==6.0.2",
  "pyjwt[crypto]==2.10.1",
  "pypdf==5.1.0",
  "anthropic==0.75.0",
  "opentelemetry-sdk==1.29.0",
  "opentelemetry-exporter-otlp==1.29.0",
]

[project.optional-dependencies]
test = ["pytest==8.3.4", "pytest-asyncio==0.25.0"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
name: ci

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0
        with:
          python-version: "3.11"
      - run: pip install -e '.[test]'
      - run: pytest -q
      - name: Secret scan
        uses: gitleaks/gitleaks-action@83373cf2f8c4db6e24b41c1a9b086bb9619e9cd3 # v2.3.7
      - name: Manifest hashes match files
        run: |
          python - <<'PY'
          import hashlib, yaml, sys
          m = yaml.safe_load(open("release/manifest.yaml"))
          bad = []
          for group in ("prompts", "config"):
              for name, e in m[group].items():
                  if isinstance(e, dict) and "sha256" in e:
                      got = "sha256:" + hashlib.sha256(open(e["path"], "rb").read()).hexdigest()
                      if got != e["sha256"]:
                          bad.append(e["path"])
          if bad:
              sys.exit("manifest out of date: " + ", ".join(bad))
          PY

  release:
    if: github.ref == 'refs/heads/main'
    needs: test
    runs-on: ubuntu-24.04
    permissions:
      contents: read
      id-token: write
      packages: write
      attestations: write
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      - uses: sigstore/cosign-installer@dc72c7d5c4d10cd6bcb8cf6e3fd625a9e5e537da # v3.7.0
        with:
          cosign-release: "v2.6.2"
      - uses: docker/setup-buildx-action@c47758b77c9736f4b2ef4073d4d51994fabfe349 # v3.7.1
      - uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0
        with:
          registry: registry.example-corp.test
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - id: build
        uses: docker/build-push-action@4f58ea79222b3b9dc2c8bbdd6debcef730109a75 # v6.9.0
        with:
          context: .
          push: true
          tags: registry.example-corp.test/procurement/agent:${{ github.sha }}
          provenance: false
          sbom: false
      - name: SBOM
        uses: anchore/sbom-action@251a468eed47e5082b105c3ba6ee500c0e65a764 # v0.17.6
        with:
          image: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}
          format: cyclonedx-json
          output-file: sbom.cdx.json
      - name: Sign and attest
        env:
          IMAGE: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}
        run: |
          cosign sign --yes "$IMAGE"
          cosign attest --yes --type cyclonedx --predicate sbom.cdx.json "$IMAGE"
      - uses: actions/attest-build-provenance@1c608d11d69870c2092266b3f9a6f3abbf17002c # v1.4.3
        with:
          subject-name: registry.example-corp.test/procurement/agent
          subject-digest: ${{ steps.build.outputs.digest }}
          push-to-registry: true
# procurement-agent

Procurement agent for Example Corp business units. It reads vendor quotes and
invoices that arrive by email, checks them against department budgets, raises
purchase orders in the ERP, pays matched invoices, and talks to staff and
vendors in Slack. It keeps short per-department notes between runs.

## Architecture

```
mail gateway --HMAC--> /ingest/mail --> documents (Postgres, per business unit)
staff (OIDC JWT) ----> /runs --> ProcurementAgent loop (app/loop.py)
                                   |-- PolicyGate (app/gate.py) + approvals (Slack buttons)
                                   |-- Budget (app/budget.py)
                                   |-- audit graph (app/audit.py -> audit_events)
                                   |-- tools:
                                   |     read_document, extract_line_items -> LineItemExtractor sub-agent
                                   |     get_budget, erp_call, create_purchase_order -> ERP MCP via gateway
                                   |     pay_invoice -> payments API
                                   |     post_slack_message -> Slack (via slack-proxy)
                                   |     memory_read, memory_write -> dept_notes
```

* **Tenancy.** Each run belongs to one business unit, taken from the `bu`
  claim of the caller's verified OIDC token. Documents, notes, approvals and
  quotas are keyed by business unit.
* **Identity.** The agent runs as the `procurement-agent` service account.
  Its projected token (10-minute lifetime) is exchanged at the internal STS
  for audience-bound tokens for the ERP gateway, payments API and Slack
  proxy. User tokens are never forwarded.
* **Approvals.** `create_purchase_order`, `pay_invoice` and vendor messages
  require an approval from a role listed in `config/policy.yaml`. Approval
  requests are posted to `#approvals-<bu>` with the argument summary.
* **Budgets.** Per-run step, time, token, cost, tool-rate and sub-agent
  limits, plus per-user, per-business-unit and fleet quotas for daily spend
  and run starts. See `config/policy.yaml`.
* **Audit.** Every run step is a row in `audit_events` linked to its parent
  step, with the six identity fields, policy version, approval id and
  decision-time context size. The agent's database role can insert audit
  rows but not update or delete them.

## Context size

Logged on every audit row as `context_tokens` and `context_method`:

| method | meaning |
|---|---|
| `count_tokens_api` | exact request counted with the provider's token-count endpoint before the call (includes cached prefix) |
| `usage_sum_estimate` | counting failed; `input_tokens + cache_read + cache_creation` from the response |
| `unavailable` | neither available; `context_tokens` is NULL, never 0 |

`context_compacted` is true when the harness dropped earlier turns before the
call (`app/loop.py:_compact`). Provider-side truncation is not visible.

## Operating

* **Halt.** Insert or update a row in `control_flags` (`scope = 'fleet'` or
  `'tenant:<bu>'`, `halted = true`) as `procurement_ops`. New runs refuse to
  start while a halt is set.
* **Release.** Merges to `main` build, sign (keyless cosign), and attest the
  image (SLSA provenance and CycloneDX SBOM). Kyverno rejects unsigned or
  unattested images in `procurement-prod`.
* **Network.** Default-deny egress with explicit rules for DNS, the egress
  proxy, the Slack proxy, the database, the ERP gateway and the STS.

## Tests

```bash
pip install -e '.[test]'
pytest -q
```
# Tools per agent role, each with the task reason it is granted.
roles:
  procurement:
    tools:
      read_document: "Read vendor quotes, invoices and emails that arrived through the mail gateway."
      extract_line_items: "Delegate line-item extraction from long documents to the extractor."
      get_budget: "Check remaining department budget before raising a purchase order."
      erp_call: "Look up vendors, open invoices and purchase orders for matching."
      create_purchase_order: "Raise a purchase order once a quote is within budget and approved."
      pay_invoice: "Pay an invoice that is matched to a purchase order and approved."
      post_slack_message: "Ask staff for missing details and confirm orders with vendors."
      memory_read: "Recall department preferences and contract terms from earlier runs."
      memory_write: "Save new department preferences and contract terms."
  extractor:
    tools:
      read_document: "Read the document whose line items are being extracted."
"""Tool registry.

Each agent role gets the tools listed for it in config/tools.yaml. The model
only sees schemas for those tools, and the loop rejects any call to a name
that is not in the run's registry.
"""
from __future__ import annotations

from dataclasses import dataclass
from functools import lru_cache
from typing import Any, Awaitable, Callable

import yaml

from app.identity import RunIdentity

DEFAULT_ROLE = "procurement"

Invoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]


@dataclass(frozen=True)
class Tool:
    name: str
    description: str
    input_schema: dict[str, Any]
    invoke: Invoke
    target_field: str | None = None

    def target_of(self, args: dict[str, Any]) -> str:
        if self.target_field is None:
            return self.name
        return str(args.get(self.target_field, ""))

    def schema(self) -> dict[str, Any]:
        return {"name": self.name, "description": self.description, "input_schema": self.input_schema}


class ToolRegistry:
    def __init__(self, tools: list[Tool]):
        self._tools = {t.name: t for t in tools}

    def get(self, name: str) -> Tool | None:
        return self._tools.get(name)

    def names(self) -> list[str]:
        return sorted(self._tools)

    def schemas(self) -> list[dict[str, Any]]:
        return [self._tools[n].schema() for n in self.names()]


@lru_cache(maxsize=1)
def _role_tools(path: str) -> dict[str, list[str]]:
    with open(path, "r", encoding="utf-8") as fh:
        cfg = yaml.safe_load(fh)
    return {role: list(spec["tools"].keys()) for role, spec in cfg["roles"].items()}


def build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:
    from app.tools import documents, erp, memory, payments, slack

    available: dict[str, Tool] = {}
    for module in (documents, erp, memory, payments, slack):
        for tool in module.tools(deps):
            available[tool.name] = tool

    roles = _role_tools(str(deps.settings.tools_path))
    allowed = roles.get(role, roles[DEFAULT_ROLE])
    return ToolRegistry([available[name] for name in allowed if name in available])
"""Document tools: read an ingested quote or invoice, and extract line items."""
from __future__ import annotations

from typing import Any

from app.identity import RunIdentity
from app.tools import Tool

UNTRUSTED_WRAPPER = (
    "<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\n"
    "{text}\n"
    "</untrusted_document>"
)


def tools(deps) -> list[Tool]:
    pool = deps.pool

    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:
        row = await pool.fetchrow(
            """
            SELECT doc_id, source, media_type, text
            FROM documents
            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'
            """,
            args["doc_id"],
            ident.tenant,
        )
        if row is None:
            return "document not found"
        return UNTRUSTED_WRAPPER.format(
            source=row["source"], doc_id=row["doc_id"], media_type=row["media_type"], text=row["text"]
        )

    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:
        return await deps.extractor.extract(ident, args["doc_id"], deps.current_budget(ident))

    return [
        Tool(
            name="read_document",
            description="Read the text of an ingested vendor quote, invoice, or email by doc_id.",
            input_schema={
                "type": "object",
                "properties": {"doc_id": {"type": "string", "maxLength": 64}},
                "required": ["doc_id"],
                "additionalProperties": False,
            },
            invoke=read_document,
        ),
        Tool(
            name="extract_line_items",
            description="Extract structured line items (sku, description, qty, unit price, currency) from a document.",
            input_schema={
                "type": "object",
                "properties": {"doc_id": {"type": "string", "maxLength": 64}},
                "required": ["doc_id"],
                "additionalProperties": False,
            },
            invoke=extract_line_items,
        ),
    ]
"""ERP tools: budget lookups, generic ERP reads, and purchase-order creation."""
from __future__ import annotations

from typing import Any

from app.identity import RunIdentity
from app.tools import Tool

ERP_READ_SCOPE = "erp.read"
ERP_PO_WRITE_SCOPE = "erp.read erp.po.create"


def tools(deps) -> list[Tool]:
    erp = deps.erp

    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:
        return await erp.call(
            "budget.get_remaining",
            {"business_unit": ident.tenant, "department": args["department"], "fiscal_period": args["fiscal_period"]},
            ident,
            ERP_READ_SCOPE,
        )

    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:
        arguments = dict(args.get("arguments", {}))
        arguments["business_unit"] = ident.tenant
        return await erp.call(args["operation"], arguments, ident, deps.erp_scope_for(args["operation"]))

    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:
        return await erp.call(
            "po.create",
            {
                "business_unit": ident.tenant,
                "department": args["department"],
                "vendor_id": args["vendor_id"],
                "lines": args["lines"],
                "currency": args["currency"],
                "source_doc_id": args["source_doc_id"],
                "client_reference": args["source_doc_id"],
            },
            ident,
            ERP_PO_WRITE_SCOPE,
        )

    line_schema = {
        "type": "object",
        "properties": {
            "sku": {"type": "string", "maxLength": 64},
            "description": {"type": "string", "maxLength": 256},
            "quantity": {"type": "number", "exclusiveMinimum": 0},
            "unit_price_cents": {"type": "integer", "minimum": 0},
        },
        "required": ["sku", "quantity", "unit_price_cents"],
        "additionalProperties": False,
    }

    return [
        Tool(
            name="get_budget",
            description="Remaining budget for a department in a fiscal period.",
            input_schema={
                "type": "object",
                "properties": {
                    "department": {"type": "string", "maxLength": 64},
                    "fiscal_period": {"type": "string", "pattern": "^FY[0-9]{4}-Q[1-4]$"},
                },
                "required": ["department", "fiscal_period"],
                "additionalProperties": False,
            },
            invoke=get_budget,
        ),
        Tool(
            name="erp_call",
            description=(
                "Look up ERP records (vendors, invoices, purchase orders, budgets). "
                "operation is an ERP operation name such as vendor.get or invoice.list_open."
            ),
            input_schema={
                "type": "object",
                "properties": {
                    "operation": {"type": "string", "maxLength": 64},
                    "arguments": {"type": "object"},
                },
                "required": ["operation"],
                "additionalProperties": False,
            },
            invoke=erp_call,
        ),
        Tool(
            name="create_purchase_order",
            description="Raise a purchase order in the ERP for an approved quote.",
            input_schema={
                "type": "object",
                "properties": {
                    "department": {"type": "string", "maxLength": 64},
                    "vendor_id": {"type": "string", "maxLength": 32},
                    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
                    "source_doc_id": {"type": "string", "maxLength": 64},
                    "lines": {"type": "array", "items": line_schema, "maxItems": 200},
                },
                "required": ["department", "vendor_id", "currency", "source_doc_id", "lines"],
                "additionalProperties": False,
            },
            invoke=create_purchase_order,
            target_field="source_doc_id",
        ),
    ]
"""Payments tool: pay an approved, matched invoice."""
from __future__ import annotations

import hashlib
from typing import Any

import httpx

from app.identity import RunIdentity
from app.tools import Tool

PAYMENTS_AUDIENCE = "payments-api"
PAYMENTS_SCOPE = "payments.create"


def idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:
    raw = "|".join(
        [ident.tenant, args["invoice_id"], args["payee_account_id"], str(args["amount_cents"]), args["currency"]]
    )
    return "proc-" + hashlib.sha256(raw.encode("utf-8")).hexdigest()[:48]


def tools(deps) -> list[Tool]:
    settings = deps.settings

    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:
        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)
        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:
            resp = await client.post(
                f"{settings.payments_api_url}/v2/payments",
                headers={
                    "Authorization": f"Bearer {token}",
                    "Idempotency-Key": idempotency_key(ident, args),
                },
                json={
                    "business_unit": ident.tenant,
                    "invoice_reference": args["invoice_id"],
                    "payee_account_id": args["payee_account_id"],
                    "amount": {"value": args["amount_cents"], "currency": args["currency"]},
                    "memo": args.get("memo", "")[:140],
                },
            )
        resp.raise_for_status()
        body = resp.json()
        return {"payment_id": body["id"], "status": body["status"]}

    return [
        Tool(
            name="pay_invoice",
            description="Pay a vendor invoice that has been matched to a purchase order.",
            input_schema={
                "type": "object",
                "properties": {
                    "invoice_id": {"type": "string", "maxLength": 32},
                    "payee_account_id": {"type": "string", "maxLength": 32},
                    "amount_cents": {"type": "integer", "minimum": 1},
                    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
                    "memo": {"type": "string", "maxLength": 140},
                },
                "required": ["invoice_id", "payee_account_id", "amount_cents", "currency"],
                "additionalProperties": False,
            },
            invoke=pay_invoice,
            target_field="invoice_id",
        )
    ]
"""Slack tool: message staff and vendors, plus the approvals notifier."""
from __future__ import annotations

from datetime import datetime
from typing import Any

import httpx

from app.identity import RunIdentity
from app.redact import redact_text, strip_unapproved_links
from app.tools import Tool

MAX_TEXT = 3000


def clean_outbound(text: str) -> str:
    return strip_unapproved_links(redact_text(text))[:MAX_TEXT]


class SlackClient:
    def __init__(self, api_url: str, bot_token_provider):
        self.api_url = api_url
        self._token = bot_token_provider

    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:
        payload: dict[str, Any] = {
            "channel": channel,
            "text": clean_outbound(text),
            "unfurl_links": False,
            "unfurl_media": False,
            "mrkdwn": True,
        }
        if blocks:
            payload["blocks"] = blocks
        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:
            resp = await client.post(
                f"{self.api_url}/chat.postMessage",
                headers={"Authorization": f"Bearer {await self._token()}"},
                json=payload,
            )
        resp.raise_for_status()
        body = resp.json()
        if not body.get("ok"):
            raise RuntimeError(f"slack error: {body.get('error')}")
        return {"channel": body["channel"], "ts": body["ts"]}

    async def post_approval_request(
        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime
    ) -> None:
        lines = "\n".join(f"• *{k}*: `{v}`" for k, v in summary.items())
        text = f"Approval needed for `{tool}` on `{target}` (expires {expires_at:%Y-%m-%d %H:%M} UTC)\n{lines}"
        await self.post(
            channel=f"#approvals-{tenant}",
            text=text,
            blocks=[
                {"type": "section", "text": {"type": "mrkdwn", "text": clean_outbound(text)}},
                {
                    "type": "actions",
                    "elements": [
                        {"type": "button", "action_id": "approve", "value": approval_id, "text": {"type": "plain_text", "text": "Approve"}, "style": "primary"},
                        {"type": "button", "action_id": "reject", "value": approval_id, "text": {"type": "plain_text", "text": "Reject"}, "style": "danger"},
                    ],
                },
            ],
        )


def tools(deps) -> list[Tool]:
    slack: SlackClient = deps.slack

    async def post_slack_message(args: dict[str, Any], ident: RunIdentity) -> Any:
        return await slack.post(channel=args["channel"], text=args["text"])

    return [
        Tool(
            name="post_slack_message",
            description=(
                "Post a message in Slack. Use internal channels for staff. Vendor contacts are in "
                "Slack Connect channels named #vendor-<vendor_id>; set external=true for those."
            ),
            input_schema={
                "type": "object",
                "properties": {
                    "channel": {"type": "string", "maxLength": 80},
                    "text": {"type": "string", "maxLength": MAX_TEXT},
                    "external": {"type": "boolean", "default": False},
                },
                "required": ["channel", "text"],
                "additionalProperties": False,
            },
            invoke=post_slack_message,
            target_field="channel",
        )
    ]
"""Per-department notes kept between runs (Postgres ``dept_notes``).

Writes are restricted to a fixed set of note kinds, length-limited, checked
for instruction-like content, and stored as unverified with a 30-day expiry
until a procurement lead verifies them in the admin UI. Every row records
who wrote it, from which run and source document, and the context size at
the time.
"""
from __future__ import annotations

import re
import uuid
from typing import Any

from app.identity import RunIdentity
from app.tools import Tool

NOTE_KINDS = ("vendor_preference", "contract_term", "budget_note", "contact")
MAX_NOTE_CHARS = 800
INSTRUCTION_LIKE = [
    re.compile(r"(?i)\b(ignore|disregard|override)\b.{0,40}\b(instruction|policy|approval|rule)s?\b"),
    re.compile(r"(?i)\b(always|never|must)\b.{0,40}\b(approve|pay|skip|send|transfer)\b"),
    re.compile(r"(?i)\b(system prompt|you are|assistant:)\b"),
    re.compile(r"https?://"),
]


class NoteRejected(Exception):
    pass


def check_note(text: str) -> None:
    if len(text) > MAX_NOTE_CHARS:
        raise NoteRejected("note too long")
    for pattern in INSTRUCTION_LIKE:
        if pattern.search(text):
            raise NoteRejected("note looks like an instruction")


def tools(deps) -> list[Tool]:
    pool = deps.pool

    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:
        business_unit = args.get("business_unit") or ident.tenant
        rows = await pool.fetch(
            """
            SELECT note_id, kind, body, verified, writer_instance, created_at
            FROM dept_notes
            WHERE business_unit = $1
              AND department = $2
              AND NOT quarantined
              AND (verified OR expires_at > now())
            ORDER BY created_at DESC
            LIMIT 20
            """,
            business_unit,
            args["department"],
        )
        return [
            {
                "note_id": r["note_id"],
                "kind": r["kind"],
                "body": r["body"],
                "trust": "verified" if r["verified"] else "unverified",
                "written": r["created_at"].isoformat(),
            }
            for r in rows
        ]

    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:
        if args["kind"] not in NOTE_KINDS:
            raise NoteRejected(f"unknown note kind {args['kind']}")
        check_note(args["body"])
        note_id = f"note-{uuid.uuid4()}"
        ctx = deps.current_context(ident)
        await pool.execute(
            """
            INSERT INTO dept_notes (
                note_id, business_unit, department, kind, body,
                verified, quarantined, expires_at,
                writer_instance, writer_type_id, run_id, source_doc_id,
                delegated_subject, context_tokens, context_method, created_at
            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',
                      $6, $7, $8, $9, $10, $11, $12, now())
            """,
            note_id,
            ident.tenant,
            args["department"],
            args["kind"],
            args["body"],
            ident.agent_instance_id,
            ident.agent_type_id,
            ident.run_id,
            args.get("source_doc_id"),
            ident.delegated_subject,
            ctx.tokens,
            ctx.method,
        )
        return {"note_id": note_id, "status": "stored_unverified"}

    return [
        Tool(
            name="memory_read",
            description=(
                "Read saved notes for a department. business_unit defaults to the current one; "
                "shared-services staff may look up another unit's notes."
            ),
