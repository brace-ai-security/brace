   105	    async def fetchval(self, sql, scope, key, *rest):
   106	        amount = rest[0] if rest else 1
   107	        k = (scope, key, "spend" if rest else "starts")
   108	        self.store[k] = self.store.get(k, 0) + amount
   109	        return self.store[k]
