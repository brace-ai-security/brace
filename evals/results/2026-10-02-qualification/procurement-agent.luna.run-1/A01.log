     1	"""Inbound documents: vendor quotes and invoices from the mail gateway.
     2	
     3	The mail gateway posts each received message to ``/ingest/mail`` signed with
     4	an HMAC over the timestamp and body. Accepted documents are stored per
     5	business unit and are only ever shown to the model inside an
     6	``untrusted_document`` wrapper (tools/documents.py).
     7	"""
     8	from __future__ import annotations
     9	
    10	import base64
    11	import email
    12	import email.policy
    13	import hashlib
    14	import hmac
    15	import io
    16	import re
    17	import time
    18	import uuid
    19	from dataclasses import dataclass
    20	from pathlib import Path
    21	
    22	from fastapi import APIRouter, HTTPException, Request
    23	from pypdf import PdfReader
    24	
    25	router = APIRouter()
    26	
    27	MAX_BODY_BYTES = 10 * 1024 * 1024
    28	MAX_TEXT_CHARS = 200_000
    29	MAX_SKEW_SECONDS = 300
    30	ALLOWED_MEDIA_TYPES = {"application/pdf", "text/plain", "message/rfc822"}
    31	SCANNED_MEDIA_TYPES = {"application/pdf", "text/plain"}
    32	
    33	INJECTION_PATTERNS = [
    34	    re.compile(r"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)"),
    35	    re.compile(r"(?i)\b(system|developer) (prompt|message)\b"),
    36	    re.compile(r"(?i)\byou are (now )?(an?|the) \w+ (agent|assistant)\b"),
    37	    re.compile(r"(?i)\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\b"),
    38	    re.compile(r"(?i)\b(update|change) (our|the) (bank|remit|payee)\b"),
    39	    re.compile(r"[​-‏‪-‮⁠-⁤]"),
    40	]
    41	
    42	
    43	class Rejected(Exception):
    44	    pass
    45	
    46	
    47	@dataclass
    48	class Inbound:
    49	    business_unit: str
    50	    sender: str
    51	    media_type: str
    52	    raw: bytes
    53	
    54	
    55	def verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:
    56	    try:
    57	        ts = int(timestamp)
    58	    except ValueError as exc:
    59	        raise Rejected("bad timestamp") from exc
    60	    if abs(time.time() - ts) > MAX_SKEW_SECONDS:
    61	        raise Rejected("stale request")
    62	    expected = hmac.new(key, f"{timestamp}.".encode() + body, hashlib.sha256).hexdigest()
    63	    if not hmac.compare_digest(expected, signature):
    64	        raise Rejected("bad signature")
    65	
    66	
    67	def extract_text(doc: Inbound) -> str:
    68	    if doc.media_type == "application/pdf":
    69	        reader = PdfReader(io.BytesIO(doc.raw))
    70	        if len(reader.pages) > 50:
    71	            raise Rejected("too many pages")
    72	        return "\n".join(page.extract_text() or "" for page in reader.pages)
    73	    if doc.media_type == "message/rfc822":
    74	        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)
    75	        body = msg.get_body(preferencelist=("plain", "html"))
    76	        return body.get_content() if body is not None else ""
    77	    return doc.raw.decode("utf-8", errors="strict")
    78	
    79	
    80	def scan_for_injection(text: str) -> list[str]:
    81	    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]
    82	
    83	
    84	def validate(doc: Inbound) -> str:
    85	    if doc.media_type not in ALLOWED_MEDIA_TYPES:
    86	        raise Rejected(f"media type {doc.media_type} not accepted")
    87	    if len(doc.raw) > MAX_BODY_BYTES:
    88	        raise Rejected("document too large")
    89	    try:
    90	        text = extract_text(doc)
    91	    except Rejected:
    92	        raise
    93	    except Exception as exc:
    94	        raise Rejected(f"unreadable document: {type(exc).__name__}") from exc
    95	    if len(text) > MAX_TEXT_CHARS:
    96	        raise Rejected("extracted text too long")
    97	    if doc.media_type in SCANNED_MEDIA_TYPES:
    98	        findings = scan_for_injection(text)
    99	        if findings:
   100	            raise Rejected("possible prompt injection: " + "; ".join(findings))
   101	    return text
   102	
   103	
   104	@router.post("/ingest/mail")
   105	async def ingest_mail(request: Request) -> dict:
   106	    body = await request.body()
   107	    if len(body) > MAX_BODY_BYTES * 2:
   108	        raise HTTPException(413, "payload too large")
   109	    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()
   110	    try:
   111	        verify_signature(
   112	            key,
   113	            request.headers.get("X-Gateway-Timestamp", ""),
   114	            body,
   115	            request.headers.get("X-Gateway-Signature", ""),
   116	        )
   117	    except Rejected as exc:
   118	        raise HTTPException(401, str(exc)) from exc
   119	
   120	    payload = await request.json()
   121	    doc = Inbound(
   122	        business_unit=payload["business_unit"],
   123	        sender=payload["from"],
   124	        media_type=payload["media_type"],
   125	        raw=base64.b64decode(payload["content_b64"], validate=True),
   126	    )
   127	    doc_id = f"doc-{uuid.uuid4().hex[:20]}"
   128	    pool = request.app.state.pool
   129	    try:
   130	        text = validate(doc)
   131	    except Rejected as exc:
   132	        await pool.execute(
   133	            """
   134	            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)
   135	            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())
   136	            """,
   137	            doc_id, doc.business_unit, doc.sender, doc.media_type,
   138	            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],
   139	        )
   140	        return {"doc_id": doc_id, "status": "quarantined"}
   141	
   142	    await pool.execute(
   143	        """
   144	        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)
   145	        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())
   146	        """,
   147	        doc_id, doc.business_unit, doc.sender, doc.media_type,
   148	        hashlib.sha256(doc.raw).hexdigest(), text,
   149	    )
   150	    return {"doc_id": doc_id, "status": "accepted"}
