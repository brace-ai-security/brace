     5	
     6	// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.
     7	// Each input is written as "<label>\0<bytes>\0" so that inputs cannot run together.
     8	const CONFIG_FILES = ["config/policy.yaml", "config/tools.allowlist.yaml", "config/budgets.yaml"];
     9	
    10	export interface TypeIdInputs {
    11	  imageDigest: string;
    12	  harnessVersion: string;
    13	  harnessGitSha: string;
    14	}
    15	
    16	export function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {
    17	  const parts: Array<[string, Buffer]> = [
    18	    ["image", Buffer.from(inputs.imageDigest)],
    19	    ["harness.version", Buffer.from(inputs.harnessVersion)],
    20	    ["harness.gitSha", Buffer.from(inputs.harnessGitSha)],
    21	  ];
    22	  const promptDir = join(ROOT, "prompts");
    23	  const promptFiles = readdirSync(promptDir)
    24	    .filter((f) => f.endsWith(".txt"))
    25	    .sort();
    26	  for (const f of promptFiles) {
    27	    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);
    28	  }
    29	  parts.push(["model.agent", Buffer.from(AGENT_MODEL)]);
    30	  parts.push(["model.classifier", Buffer.from(CLASSIFIER_MODEL)]);
    31	  for (const f of CONFIG_FILES) {
    32	    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);
    33	  }
    34	  return parts;
    35	}
    36	
    37	export function computeAgentTypeId(inputs: TypeIdInputs): string {
    38	  const h = createHash("sha256");
    39	  for (const [label, bytes] of typeIdManifest(inputs)) {
    40	    h.update(label);
    41	    h.update("\0");
    42	    h.update(bytes);
    43	    h.update("\0");
    44	  }
    45	  return `sha256:${h.digest("hex")}`;
    46	}
