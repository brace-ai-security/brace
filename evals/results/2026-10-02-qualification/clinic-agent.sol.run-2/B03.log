import type Anthropic from "@anthropic-ai/sdk";
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { z } from "zod";
import { CLASSIFIER_MODEL, ROOT } from "../config.js";

// Helper model that routes messages before the agent sees them. Urgent and complaint messages go
// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,
// malformed output, unknown label, or a served model other than the pinned snapshot) routes the
// message to staff. A failed classifier never defaults to "send it to the agent".

export const CLASSIFIER_PROMPT = readFileSync(join(ROOT, "prompts/intent-classifier.txt"), "utf8");
export const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;

export const CLASSIFIER_ID = `sha256:${createHash("sha256")
  .update(CLASSIFIER_MODEL)
  .update("\0")
  .update(CLASSIFIER_PROMPT)
  .update("\0")
  .update(JSON.stringify(CLASSIFIER_CONFIG))
  .digest("hex")}`;

const Intent = z.enum(["book", "reschedule", "cancel", "confirm", "coverage", "info", "urgent", "complaint", "other"]);
const Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();

export type Route = "agent" | "staff";

export interface ClassifierDecision {
  classifierId: string;
  requestedModel: string;
  servedModel: string | null;
  intent: z.infer<typeof Intent> | null;
  confidence: number | null;
  route: Route;
  failure: null | "timeout" | "api_error" | "model_mismatch" | "invalid_output" | "low_confidence";
}

const MIN_CONFIDENCE = 0.6;

export async function classifyIntent(client: Pick<Anthropic, "messages">, text: string): Promise<ClassifierDecision> {
  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };
  let res: Anthropic.Message;
  try {
    res = await client.messages.create(
      {
        model: CLASSIFIER_MODEL,
        max_tokens: CLASSIFIER_CONFIG.max_tokens,
        temperature: CLASSIFIER_CONFIG.temperature,
        system: CLASSIFIER_PROMPT,
        messages: [{ role: "user", content: `<patient_message>${text}</patient_message>` }],
      },
      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },
    );
  } catch (err) {
    const timeout = (err as { name?: string }).name === "APIConnectionTimeoutError";
    return { ...base, servedModel: null, intent: null, confidence: null, route: "staff", failure: timeout ? "timeout" : "api_error" };
  }

  if (res.model !== CLASSIFIER_MODEL) {
    return { ...base, servedModel: res.model, intent: null, confidence: null, route: "staff", failure: "model_mismatch" };
  }

  const textOut = res.content.find((b) => b.type === "text");
  let parsed: z.infer<typeof Output>;
  try {
    parsed = Output.parse(JSON.parse(textOut && textOut.type === "text" ? textOut.text : ""));
  } catch {
    return { ...base, servedModel: res.model, intent: null, confidence: null, route: "staff", failure: "invalid_output" };
  }

  if (parsed.confidence < MIN_CONFIDENCE) {
    return { ...base, servedModel: res.model, ...parsed, route: "staff", failure: "low_confidence" };
  }
  const route: Route = parsed.intent === "urgent" || parsed.intent === "complaint" ? "staff" : "agent";
  return { ...base, servedModel: res.model, ...parsed, route, failure: null };
}
import Anthropic from "@anthropic-ai/sdk";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { AGENT_MODEL, budgets, ROOT } from "../config.js";
import { audit, AuditUnavailable } from "../audit/recorder.js";
import { Halted, killSwitch } from "../control/kill-switch.js";
import { executeTool } from "../tools/executor.js";
import type { ToolRegistry } from "../tools/registry.js";
import { BudgetExceeded, DynamoQuotaStore, RunBudget } from "./budget.js";
import { classifyIntent } from "./classifier.js";
import { completeFromUsage, measureBeforeCall, spanAttributes } from "./context-size.js";
import type { RunContext } from "./identity.js";

const SYSTEM_TEMPLATE = readFileSync(join(ROOT, "prompts/system.md"), "utf8");
const anthropic = new Anthropic({ maxRetries: 1 });
const quotaStore = new DynamoQuotaStore();

export interface AgentReply {
  text: string;
  handoff: null | { reason: string };
}

function escapeTags(s: string): string {
  return s.replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

export async function runAgent(
  registry: ToolRegistry,
  ctx: RunContext,
  clinic: { name: string },
  patientText: string,
): Promise<AgentReply> {
  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });
  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });
  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);
  await audit.record({ ...ident(), event: "run.started", detail: { channel: ctx.channel } });

  try {
    await killSwitch.assertRunning(ctx.tenantId);

    const intent = await classifyIntent(anthropic, patientText);
    await audit.record({ ...ident(), event: "intent.classified", detail: { ...intent } });
    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, "intent classifier control failure");
    if (intent.route === "staff") {
      await audit.record({ ...ident(), event: "run.stopped", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });
      return { text: "Thanks. A member of our front desk team will get back to you shortly.", handoff: { reason: intent.failure ?? String(intent.intent) } };
    }

    const system = SYSTEM_TEMPLATE.replace("{{clinicName}}", clinic.name);
    const tools = registry.definitions();
    const messages: Anthropic.MessageParam[] = [
      { role: "user", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },
    ];

    for (;;) {
      budget.turn();
      await killSwitch.assertRunning(ctx.tenantId);

      const req = { model: AGENT_MODEL, system, tools, messages };
      const pre = await measureBeforeCall(anthropic, req, budget.signal);
      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });
      const contextSize = completeFromUsage(pre, res.usage);
      await budget.recordUsage(res.usage, AGENT_MODEL);

      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === "tool_use");
      await audit.record({
        ...ident(),
        event: "model.decision",
        context: contextSize,
        detail: {
          servedModel: res.model,
          stopReason: res.stop_reason,
          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),
          span: spanAttributes(contextSize),
        },
      });

      if (res.stop_reason !== "tool_use" || toolUses.length === 0) {
        const text = res.content
          .filter((b): b is Anthropic.TextBlock => b.type === "text")
          .map((b) => b.text)
          .join("\n")
          .slice(0, 320);
        await audit.record({ ...ident(), event: "run.completed" });
        return { text, handoff: null };
      }

      messages.push({ role: "assistant", content: res.content });
      const results: Anthropic.ToolResultBlockParam[] = [];
      for (const call of toolUses) {
        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));
      }
      messages.push({ role: "user", content: results });
    }
  } catch (err) {
    const reason =
      err instanceof BudgetExceeded
        ? `budget:${err.limit}`
        : err instanceof Halted
          ? `halted:${err.scope}`
          : err instanceof AuditUnavailable
            ? "audit_unavailable"
            : budget.signal.aborted
              ? `aborted:${String((budget.signal.reason as Error)?.message ?? "")}`
              : `error:${(err as Error).message.slice(0, 200)}`;
    try {
      await audit.record({ ...ident(), event: "run.stopped", reason });
    } catch {
      ctx.log.error({ runId: ctx.runId, reason }, "run stopped and audit delivery failed");
    }
    return { text: "Sorry, we couldn't finish that here. Our front desk will follow up.", handoff: { reason } };
  } finally {
    budget.dispose();
    unregister();
  }
}
import { Client } from "@modelcontextprotocol/sdk/client/index.js";
import { StreamableHTTPClientTransport } from "@modelcontextprotocol/sdk/client/streamableHttp.js";
import { GetSecretValueCommand, SecretsManagerClient } from "@aws-sdk/client-secrets-manager";
import { Agent } from "undici";
import type { PeerCertificate } from "node:tls";
import { env } from "../config.js";
import type { ConfiguredServer } from "../tools/registry.js";
import type { ServerMeta } from "../tools/metadata-scan.js";

// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the
// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under
// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.

const sm = new SecretsManagerClient({ region: env.region });

function pinnedDispatcher(server: ConfiguredServer): Agent {
  const expected = server.tlsCertSha256.toLowerCase();
  return new Agent({
    connect: {
      checkServerIdentity: (_host: string, cert: PeerCertificate) => {
        const got = cert.fingerprint256.replace(/:/g, "").toLowerCase();
        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);
      },
    },
  });
}

type Token = { value: string; exp: number };
const tokens = new Map<string, Token>();

async function ehrToken(clinicId: string, scope: string): Promise<string> {
  const cacheKey = `${clinicId}|${scope}`;
  const hit = tokens.get(cacheKey);
  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;

  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));
  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? "{}");
  const res = await fetch(token_url, {
    method: "POST",
    headers: { "content-type": "application/x-www-form-urlencoded" },
    body: new URLSearchParams({ grant_type: "client_credentials", client_id, client_secret, scope }),
  });
  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);
  const body = (await res.json()) as { access_token: string; expires_in: number };
  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });
  return body.access_token;
}

const SCOPES = "patient.read appointment.read appointment.write";
const sessions = new Map<string, Client>();

async function session(server: ConfiguredServer, clinicId: string): Promise<Client> {
  const existing = sessions.get(clinicId);
  if (existing) return existing;
  const token = await ehrToken(clinicId, SCOPES);
  const transport = new StreamableHTTPClientTransport(new URL(server.url), {
    requestInit: {
      headers: { authorization: `Bearer ${token}`, "x-clinic-id": clinicId },
      // @ts-expect-error undici dispatcher is accepted by Node's fetch
      dispatcher: pinnedDispatcher(server),
    },
  });
  const client = new Client({ name: "clinic-agent", version: "3.4.1" });
  await client.connect(transport);
  sessions.set(clinicId, client);
  setTimeout(() => {
    sessions.delete(clinicId);
    void client.close();
  }, 4 * 60_000).unref();
  return client;
}

export function ehr(server: ConfiguredServer) {
  return {
    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {
      const c = await session(server, "_catalog");
      const [tools, prompts, templates] = await Promise.all([
        c.listTools(),
        c.listPrompts().catch(() => ({ prompts: [] })),
        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),
      ]);
      return {
        reportedName: c.getServerVersion()?.name,
        meta: {
          instructions: c.getInstructions(),
          tools: tools.tools as ServerMeta["tools"],
          prompts: prompts.prompts as ServerMeta["prompts"],
          resourceTemplates: templates.resourceTemplates as ServerMeta["resourceTemplates"],
        },
      };
    },

    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {
      const c = await session(server, opts.clinicId);
      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });
      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);
      return res.structuredContent ?? res.content;
    },

    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {
      return (await this.call("get_appointment", { appointmentId }, { clinicId, signal })) as {
        id: string;
        patientId: string;
        start: string;
        serviceCode: string;
        payerId?: string;
        depositId?: string;
        status: string;
      };
    },

    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {
      return (await this.call("list_appointments_by_date", { date }, { clinicId, signal })) as Array<{
        id: string;
        patientId: string;
        start: string;
        phone: string;
        smsOptIn: boolean;
        locationName: string;
      }>;
    },
  };
}
export type Ehr = ReturnType<typeof ehr>;
terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws    = { source = "hashicorp/aws", version = "~> 6.14" }
    github = { source = "integrations/github", version = "~> 6.6" }
  }
  backend "s3" {
    bucket         = "northbay-tfstate-418295730611"
    key            = "clinic-agent/prod.tfstate"
    region         = "us-west-2"
    dynamodb_table = "northbay-tf-locks"
    encrypt        = true
  }
}

provider "aws" {
  region = var.region
  default_tags {
    tags = { app = "clinic-agent", owner = "agent-platform", data = "phi" }
  }
}

variable "region" {
  type    = string
  default = "us-west-2"
}

variable "clinic_ids" {
  type    = list(string)
  default = ["nb-castro", "nb-fremont", "nb-oakland", "nb-sanmateo", "nb-walnutcreek"]
}

data "aws_caller_identity" "current" {}

module "eks" {
  source  = "terraform-aws-modules/eks/aws"
  version = "21.3.1"

  name               = "clinic-agent-prod"
  kubernetes_version = "1.33"
  vpc_id             = module.vpc.vpc_id
  subnet_ids         = module.vpc.private_subnets

  endpoint_public_access = false
  enable_irsa            = true

  authentication_mode = "API"
  access_entries = {
    deploy = {
      principal_arn = aws_iam_role.deploy.arn
      policy_associations = {
        ns = {
          policy_arn   = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSEditPolicy"
          access_scope = { type = "namespace", namespaces = ["clinic-agent"] }
        }
      }
    }
  }

  eks_managed_node_groups = {
    agents = {
      instance_types = ["m7g.large"]
      ami_type       = "BOTTLEROCKET_ARM_64"
      min_size       = 2
      max_size       = 6
      desired_size   = 3
      metadata_options = {
        http_tokens                 = "required"
        http_put_response_hop_limit = 1
      }
    }
  }
}

module "vpc" {
  source  = "terraform-aws-modules/vpc/aws"
  version = "6.4.0"

  name            = "clinic-agent-prod"
  cidr            = "10.42.0.0/16"
  azs             = ["us-west-2a", "us-west-2b", "us-west-2c"]
  private_subnets = ["10.42.1.0/24", "10.42.2.0/24", "10.42.3.0/24"]
  public_subnets  = ["10.42.101.0/24", "10.42.102.0/24", "10.42.103.0/24"]

  enable_nat_gateway = true
  single_nat_gateway = false
}

resource "aws_ecr_repository" "agent" {
  name                 = "clinic-agent"
  image_tag_mutability = "IMMUTABLE"
  image_scanning_configuration { scan_on_push = true }
}

# State tables. Approvals are written by the staff console; budgets by the agent; the control
# table holds the stop flags operators set.
resource "aws_dynamodb_table" "approvals" {
  name         = "clinic-agent-approvals"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "id"
  attribute {
    name = "id"
    type = "S"
  }
  point_in_time_recovery { enabled = true }
}

resource "aws_dynamodb_table" "budgets" {
  name         = "clinic-agent-budgets"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "pk"
  attribute {
    name = "pk"
    type = "S"
  }
  ttl {
    attribute_name = "expiresAt"
    enabled        = true
  }
}

resource "aws_dynamodb_table" "control" {
  name         = "clinic-agent-control"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "pk"
  attribute {
    name = "pk"
    type = "S"
  }
  point_in_time_recovery { enabled = true }
}

# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).
resource "aws_s3_bucket" "audit" {
  bucket              = "clinic-agent-audit-${data.aws_caller_identity.current.account_id}"
  object_lock_enabled = true
}

resource "aws_s3_bucket_object_lock_configuration" "audit" {
  bucket = aws_s3_bucket.audit.id
  rule {
    default_retention {
      mode  = "COMPLIANCE"
      years = 7
    }
  }
}

resource "aws_kinesis_firehose_delivery_stream" "audit" {
  name        = "clinic-agent-audit"
  destination = "extended_s3"
  extended_s3_configuration {
    role_arn            = aws_iam_role.firehose.arn
    bucket_arn          = aws_s3_bucket.audit.arn
    prefix              = "audit/dt=!{timestamp:yyyy-MM-dd}/"
    error_output_prefix = "audit-errors/!{firehose:error-output-type}/"
    buffering_interval  = 60
  }
}

resource "aws_secretsmanager_secret" "ehr" {
  for_each = toset(concat(var.clinic_ids, ["_catalog"]))
  name     = "clinic-agent/ehr/${each.key}"
}

resource "aws_secretsmanager_secret" "payments" {
  for_each = toset(var.clinic_ids)
  name     = "clinic-agent/payments/${each.key}"
}

resource "aws_secretsmanager_secret" "sms" {
  for_each = toset(var.clinic_ids)
  name     = "clinic-agent/sms/${each.key}"
}

resource "aws_secretsmanager_secret" "sms_signing" {
  name = "clinic-agent/sms-signing"
}
