agent/src/agent/classifier.ts:8:// Helper model that routes messages before the agent sees them. Urgent and complaint messages go
agent/src/agent/classifier.ts:9:// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,
agent/src/agent/classifier.ts:10:// malformed output, unknown label, or a served model other than the pinned snapshot) routes the
agent/src/agent/classifier.ts:11:// message to staff. A failed classifier never defaults to "send it to the agent".
agent/src/agent/classifier.ts:13:export const CLASSIFIER_PROMPT = readFileSync(join(ROOT, "prompts/intent-classifier.txt"), "utf8");
agent/src/agent/classifier.ts:14:export const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;
agent/src/agent/classifier.ts:16:export const CLASSIFIER_ID = `sha256:${createHash("sha256")
agent/src/agent/classifier.ts:17:  .update(CLASSIFIER_MODEL)
agent/src/agent/classifier.ts:18:  .update("\0")
agent/src/agent/classifier.ts:19:  .update(CLASSIFIER_PROMPT)
agent/src/agent/classifier.ts:20:  .update("\0")
agent/src/agent/classifier.ts:21:  .update(JSON.stringify(CLASSIFIER_CONFIG))
agent/src/agent/classifier.ts:22:  .digest("hex")}`;
agent/src/agent/classifier.ts:24:const Intent = z.enum(["book", "reschedule", "cancel", "confirm", "coverage", "info", "urgent", "complaint", "other"]);
agent/src/agent/classifier.ts:25:const Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();
agent/src/agent/classifier.ts:27:export type Route = "agent" | "staff";
agent/src/agent/classifier.ts:29:export interface ClassifierDecision {
agent/src/agent/classifier.ts:30:  classifierId: string;
agent/src/agent/classifier.ts:31:  requestedModel: string;
agent/src/agent/classifier.ts:32:  servedModel: string | null;
agent/src/agent/classifier.ts:33:  intent: z.infer<typeof Intent> | null;
agent/src/agent/classifier.ts:34:  confidence: number | null;
agent/src/agent/classifier.ts:35:  route: Route;
agent/src/agent/classifier.ts:36:  failure: null | "timeout" | "api_error" | "model_mismatch" | "invalid_output" | "low_confidence";
agent/src/agent/classifier.ts:37:}
agent/src/agent/classifier.ts:39:const MIN_CONFIDENCE = 0.6;
agent/src/agent/classifier.ts:41:export async function classifyIntent(client: Pick<Anthropic, "messages">, text: string): Promise<ClassifierDecision> {
agent/src/agent/classifier.ts:42:  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };
agent/src/agent/classifier.ts:43:  let res: Anthropic.Message;
agent/src/agent/classifier.ts:44:  try {
agent/src/agent/classifier.ts:45:    res = await client.messages.create(
agent/src/agent/classifier.ts:46:      {
agent/src/agent/classifier.ts:47:        model: CLASSIFIER_MODEL,
agent/src/agent/classifier.ts:48:        max_tokens: CLASSIFIER_CONFIG.max_tokens,
agent/src/agent/classifier.ts:49:        temperature: CLASSIFIER_CONFIG.temperature,
agent/src/agent/classifier.ts:50:        system: CLASSIFIER_PROMPT,
agent/src/agent/classifier.ts:51:        messages: [{ role: "user", content: `<patient_message>${text}</patient_message>` }],
agent/src/agent/classifier.ts:52:      },
agent/src/agent/classifier.ts:53:      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },
agent/src/agent/classifier.ts:54:    );
agent/src/agent/classifier.ts:55:  } catch (err) {
agent/src/agent/classifier.ts:56:    const timeout = (err as { name?: string }).name === "APIConnectionTimeoutError";
agent/src/agent/classifier.ts:57:    return { ...base, servedModel: null, intent: null, confidence: null, route: "staff", failure: timeout ? "timeout" : "api_error" };
agent/src/agent/classifier.ts:58:  }
agent/src/agent/classifier.ts:60:  if (res.model !== CLASSIFIER_MODEL) {
agent/src/agent/classifier.ts:61:    return { ...base, servedModel: res.model, intent: null, confidence: null, route: "staff", failure: "model_mismatch" };
agent/src/agent/classifier.ts:62:  }
agent/src/agent/classifier.ts:64:  const textOut = res.content.find((b) => b.type === "text");
agent/src/agent/classifier.ts:65:  let parsed: z.infer<typeof Output>;
agent/src/agent/classifier.ts:66:  try {
agent/src/agent/classifier.ts:67:    parsed = Output.parse(JSON.parse(textOut && textOut.type === "text" ? textOut.text : ""));
agent/src/agent/classifier.ts:68:  } catch {
agent/src/agent/classifier.ts:69:    return { ...base, servedModel: res.model, intent: null, confidence: null, route: "staff", failure: "invalid_output" };
agent/src/agent/classifier.ts:70:  }
agent/src/agent/classifier.ts:72:  if (parsed.confidence < MIN_CONFIDENCE) {
agent/src/agent/classifier.ts:73:    return { ...base, servedModel: res.model, ...parsed, route: "staff", failure: "low_confidence" };
agent/src/agent/classifier.ts:74:  }
agent/src/agent/classifier.ts:75:  const route: Route = parsed.intent === "urgent" || parsed.intent === "complaint" ? "staff" : "agent";
agent/src/agent/classifier.ts:76:  return { ...base, servedModel: res.model, ...parsed, route, failure: null };
agent/src/agent/classifier.ts:77:}
