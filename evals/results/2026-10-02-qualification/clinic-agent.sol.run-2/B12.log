agent/k8s/deployment.yaml:159:# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.
agent/k8s/deployment.yaml:160:# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,
agent/k8s/deployment.yaml:161:# the group STS and auth service, and AWS service endpoints.
agent/k8s/deployment.yaml:162:apiVersion: networking.k8s.io/v1
agent/k8s/deployment.yaml:163:kind: NetworkPolicy
agent/k8s/deployment.yaml:164:metadata:
agent/k8s/deployment.yaml:165:  name: clinic-agent-egress
agent/k8s/deployment.yaml:166:  namespace: clinic-agent
agent/k8s/deployment.yaml:167:spec:
agent/k8s/deployment.yaml:168:  podSelector: {}
agent/k8s/deployment.yaml:169:  policyTypes: ["Egress", "Ingress"]
agent/k8s/deployment.yaml:170:  ingress:
agent/k8s/deployment.yaml:171:    - from:
agent/k8s/deployment.yaml:172:        - namespaceSelector:
agent/k8s/deployment.yaml:173:            matchLabels: { kubernetes.io/metadata.name: ingress }
agent/k8s/deployment.yaml:174:      ports:
agent/k8s/deployment.yaml:175:        - { port: 8080, protocol: TCP }
agent/k8s/deployment.yaml:176:  egress:
agent/k8s/deployment.yaml:177:    - to:
agent/k8s/deployment.yaml:178:        - namespaceSelector:
agent/k8s/deployment.yaml:179:            matchLabels: { kubernetes.io/metadata.name: kube-system }
agent/k8s/deployment.yaml:180:          podSelector:
agent/k8s/deployment.yaml:181:            matchLabels: { k8s-app: kube-dns }
agent/k8s/deployment.yaml:182:      ports:
agent/k8s/deployment.yaml:183:        - { port: 53, protocol: UDP }
agent/k8s/deployment.yaml:184:        - { port: 53, protocol: TCP }
agent/k8s/deployment.yaml:185:    - to:
agent/k8s/deployment.yaml:186:        - namespaceSelector:
agent/k8s/deployment.yaml:187:            matchLabels: { kubernetes.io/metadata.name: platform }
agent/k8s/deployment.yaml:188:          podSelector:
agent/k8s/deployment.yaml:189:            matchLabels: { app: egress-proxy }
agent/k8s/deployment.yaml:190:      ports:
agent/k8s/deployment.yaml:191:        - { port: 3128, protocol: TCP }
agent/k8s/deployment.yaml:192:    - to:
agent/k8s/deployment.yaml:193:        - ipBlock: { cidr: 10.60.12.0/28 }
agent/k8s/deployment.yaml:194:      ports:
agent/k8s/deployment.yaml:195:        - { port: 443, protocol: TCP }
