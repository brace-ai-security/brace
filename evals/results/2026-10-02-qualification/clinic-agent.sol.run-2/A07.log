import Anthropic from "@anthropic-ai/sdk";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { AGENT_MODEL, budgets, ROOT } from "../config.js";
import { audit, AuditUnavailable } from "../audit/recorder.js";
import { Halted, killSwitch } from "../control/kill-switch.js";
import { executeTool } from "../tools/executor.js";
import type { ToolRegistry } from "../tools/registry.js";
import { BudgetExceeded, DynamoQuotaStore, RunBudget } from "./budget.js";
import { classifyIntent } from "./classifier.js";
import { completeFromUsage, measureBeforeCall, spanAttributes } from "./context-size.js";
import type { RunContext } from "./identity.js";

const SYSTEM_TEMPLATE = readFileSync(join(ROOT, "prompts/system.md"), "utf8");
const anthropic = new Anthropic({ maxRetries: 1 });
const quotaStore = new DynamoQuotaStore();

export interface AgentReply {
  text: string;
  handoff: null | { reason: string };
}

function escapeTags(s: string): string {
  return s.replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

export async function runAgent(
  registry: ToolRegistry,
  ctx: RunContext,
  clinic: { name: string },
  patientText: string,
): Promise<AgentReply> {
  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });
  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });
  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);
  await audit.record({ ...ident(), event: "run.started", detail: { channel: ctx.channel } });

  try {
    await killSwitch.assertRunning(ctx.tenantId);

    const intent = await classifyIntent(anthropic, patientText);
    await audit.record({ ...ident(), event: "intent.classified", detail: { ...intent } });
    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, "intent classifier control failure");
    if (intent.route === "staff") {
      await audit.record({ ...ident(), event: "run.stopped", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });
      return { text: "Thanks. A member of our front desk team will get back to you shortly.", handoff: { reason: intent.failure ?? String(intent.intent) } };
    }

    const system = SYSTEM_TEMPLATE.replace("{{clinicName}}", clinic.name);
    const tools = registry.definitions();
    const messages: Anthropic.MessageParam[] = [
      { role: "user", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },
    ];

    for (;;) {
      budget.turn();
      await killSwitch.assertRunning(ctx.tenantId);

      const req = { model: AGENT_MODEL, system, tools, messages };
      const pre = await measureBeforeCall(anthropic, req, budget.signal);
      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });
      const contextSize = completeFromUsage(pre, res.usage);
      await budget.recordUsage(res.usage, AGENT_MODEL);

      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === "tool_use");
      await audit.record({
        ...ident(),
        event: "model.decision",
        context: contextSize,
        detail: {
          servedModel: res.model,
          stopReason: res.stop_reason,
          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),
          span: spanAttributes(contextSize),
        },
      });

      if (res.stop_reason !== "tool_use" || toolUses.length === 0) {
        const text = res.content
          .filter((b): b is Anthropic.TextBlock => b.type === "text")
          .map((b) => b.text)
          .join("\n")
          .slice(0, 320);
        await audit.record({ ...ident(), event: "run.completed" });
        return { text, handoff: null };
      }

      messages.push({ role: "assistant", content: res.content });
      const results: Anthropic.ToolResultBlockParam[] = [];
      for (const call of toolUses) {
        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));
      }
      messages.push({ role: "user", content: results });
    }
  } catch (err) {
    const reason =
      err instanceof BudgetExceeded
        ? `budget:${err.limit}`
        : err instanceof Halted
          ? `halted:${err.scope}`
          : err instanceof AuditUnavailable
            ? "audit_unavailable"
            : budget.signal.aborted
              ? `aborted:${String((budget.signal.reason as Error)?.message ?? "")}`
              : `error:${(err as Error).message.slice(0, 200)}`;
    try {
      await audit.record({ ...ident(), event: "run.stopped", reason });
    } catch {
      ctx.log.error({ runId: ctx.runId, reason }, "run stopped and audit delivery failed");
    }
    return { text: "Sorry, we couldn't finish that here. Our front desk will follow up.", handoff: { reason } };
  } finally {
    budget.dispose();
    unregister();
  }
}
import { FirehoseClient, PutRecordCommand } from "@aws-sdk/client-firehose";
import { randomUUID } from "node:crypto";
import { z } from "zod";
import { env } from "../config.js";

// Every audit record carries the six identity fields. Values come from RunContext, which is built
// by the HTTP layer and the worker, never from model output.
export const IdentityFields = z.object({
  accountableParty: z.string().min(1),
  operationalOwner: z.string().min(1),
  tenantId: z.string().min(1),
  agentTypeId: z.string().startsWith("sha256:"),
  agentInstanceId: z.string().uuid(),
  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),
});

export const AuditEvent = IdentityFields.extend({
  eventId: z.string().uuid(),
  ts: z.string().datetime(),
  runId: z.string().uuid(),
  event: z.enum([
    "run.started",
    "run.stopped",
    "run.completed",
    "intent.classified",
    "model.decision",
    "tool.denied",
    "tool.approval_requested",
    "tool.executed",
    "tool.failed",
    "payment.refund",
    "peer.call",
    "reminder.sent",
  ]),
  subject: z.object({ kind: z.enum(["patient", "staff", "system"]), id: z.string() }),
  tool: z.string().optional(),
  toolUseId: z.string().optional(),
  policyVersion: z.string().optional(),
  approvalId: z.string().optional(),
  reason: z.string().optional(),
  context: z
    .object({
      tokens: z.number().int().nonnegative().nullable(),
      status: z.enum(["measured", "estimated", "unavailable"]),
      method: z.string(),
      cachedInputTokens: z.number().int().nonnegative().nullable(),
      compacted: z.boolean(),
    })
    .optional(),
  detail: z.record(z.unknown()).optional(),
});
export type AuditEvent = z.infer<typeof AuditEvent>;

const firehose = new FirehoseClient({ region: env.region });

export class AuditUnavailable extends Error {}

export const audit = {
  async record(e: Omit<AuditEvent, "eventId" | "ts">): Promise<void> {
    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });
    try {
      await firehose.send(
        new PutRecordCommand({
          DeliveryStreamName: env.auditStream,
          Record: { Data: Buffer.from(JSON.stringify(full) + "\n") },
        }),
      );
    } catch (err) {
      // Callers treat this as a hard failure: an action that cannot be audited does not run.
      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);
    }
  },
};

// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.
const DROP_KEYS = new Set(["ssn", "dateOfBirth", "dob", "memberId", "subscriberId", "cardNumber", "cardLast4", "address"]);
const PATTERNS: Array<[RegExp, string]> = [
  [/\b\d{3}-\d{2}-\d{4}\b/g, "[ssn]"],
  [/\b(?:\d[ -]?){13,19}\b/g, "[card]"],
  [/\b[A-Z]{3}\d{9}\b/g, "[member-id]"],
];

export function redactPhi(value: unknown): unknown {
  if (typeof value === "string") {
    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);
  }
  if (Array.isArray(value)) return value.map(redactPhi);
  if (value && typeof value === "object") {
    const out: Record<string, unknown> = {};
    for (const [k, v] of Object.entries(value)) {
      if (DROP_KEYS.has(k)) continue;
      out[k] = redactPhi(v);
    }
    return out;
  }
  return value;
}
import type Anthropic from "@anthropic-ai/sdk";

// Context size at decision time, in tokens.
//
// Counting method. Each model decision is one Messages API call. Its response usage reports the
// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and
// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,
// including the part served from the prompt cache and the provider's own tool-use preamble, which
// the provider counts but does not show. This is a per-call value, not a run or billing total.
// We record it as "measured", with the cached share kept separately.
//
// If the response carries no usage (stream cut off, aborted call), we fall back to the
// count_tokens estimate taken just before the call for the same request, and mark it "estimated".
// If neither exists the value is null with status "unavailable". It is never reported as 0.
//
// This harness never compacts, summarizes, or truncates history inside a run, so compacted is
// always false; a run that would outgrow its token budget stops instead (see budget.ts).
export interface ContextSize {
  tokens: number | null;
  status: "measured" | "estimated" | "unavailable";
  method: string;
  cachedInputTokens: number | null;
  compacted: boolean;
}

export const USAGE_METHOD = "anthropic.messages.usage(input+cache_read+cache_creation)";
export const COUNT_METHOD = "anthropic.messages.count_tokens(pre-call estimate)";

export async function measureBeforeCall(
  client: Anthropic,
  req: Anthropic.MessageCountTokensParams,
  signal: AbortSignal,
): Promise<ContextSize> {
  try {
    const r = await client.messages.countTokens(req, { signal });
    return { tokens: r.input_tokens, status: "estimated", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };
  } catch {
    return { tokens: null, status: "unavailable", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };
  }
}

export function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {
  if (!usage) return pre;
  const cacheRead = usage.cache_read_input_tokens ?? 0;
  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);
  return { tokens: total, status: "measured", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };
}

// Span attributes so the value is searchable next to the action in traces as well as audit.
export function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {
  return {
    ...(c.tokens === null ? {} : { "clinic_agent.context.tokens": c.tokens }),
    "clinic_agent.context.status": c.status,
    "clinic_agent.context.method": c.method,
    "gen_ai.conversation.compacted": c.compacted,
  };
}
import type { FastifyInstance } from "fastify";
import { createRemoteJWKSet, jwtVerify } from "jose";
import { z } from "zod";
import { runAgent } from "../agent/loop.js";
import { newRunContext } from "../agent/identity.js";
import { env } from "../config.js";
import type { ToolRegistry } from "../tools/registry.js";

// Web chat. The widget gets a short-lived session JWT from the group auth service after the
// patient verifies by one-time code, or a staff JWT for front-desk users.
// Claims: sub, clinic_id, role ("patient" | "staff"), exp.

const jwks = createRemoteJWKSet(new URL(env.chatJwksUrl));

const ChatBody = z.object({ message: z.string().min(1).max(2000) }).strict();
const TRACEPARENT = /^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/;

export function registerWebchat(
  app: FastifyInstance,
  deps: { registry: ToolRegistry; clinicById: (id: string) => { id: string; name: string } | undefined },
): void {
  app.post("/v1/chat", { bodyLimit: 16_384 }, async (req, reply) => {
    const auth = req.headers.authorization ?? "";
    if (!auth.startsWith("Bearer ")) return reply.code(401).send({ error: "missing token" });

    let claims: { sub: string; clinic_id: string; role: "patient" | "staff" };
    try {
      const { payload } = await jwtVerify(auth.slice(7), jwks, {
        issuer: env.chatIssuer,
        audience: "clinic-agent-chat",
        algorithms: ["ES256"],
        maxTokenAge: "30m",
      });
      claims = payload as unknown as typeof claims;
    } catch {
      return reply.code(401).send({ error: "invalid token" });
    }

    const body = ChatBody.safeParse(req.body);
    if (!body.success) return reply.code(400).send({ error: "invalid body" });

    // The group site embeds one widget for all clinics and sends the clinic the patient picked.
    const tenantId = (req.headers["x-clinic-id"] as string | undefined) ?? claims.clinic_id;
    const clinic = deps.clinicById(tenantId);
    if (!clinic) return reply.code(404).send({ error: "unknown clinic" });

    const tp = req.headers.traceparent;
    const ctx = newRunContext({
      tenantId: clinic.id,
      subject: { kind: claims.role === "staff" ? "staff" : "patient", id: claims.sub },
      channel: "webchat",
      traceparent: typeof tp === "string" && TRACEPARENT.test(tp) ? tp : undefined,
      log: req.log,
    });

    const out = await runAgent(deps.registry, ctx, clinic, body.data.message);
    return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });
  });
}
import type { FastifyInstance, FastifyRequest } from "fastify";
import { createHmac, timingSafeEqual } from "node:crypto";
import { z } from "zod";
import { runAgent } from "../agent/loop.js";
import { newRunContext } from "../agent/identity.js";
import { sms } from "../integrations/sms.js";
import type { ToolRegistry } from "../tools/registry.js";

// Inbound SMS from the provider. The provider signs "<timestamp>.<raw body>" with HMAC-SHA256
// using the per-account signing secret and sends it as x-sms-signature: t=<ts>,v1=<hex>.

const Inbound = z
  .object({
    messageId: z.string().max(64),
    from: z.string().regex(/^\+[1-9]\d{7,14}$/),
    to: z.string().regex(/^\+[1-9]\d{7,14}$/),
    body: z.string().max(1600),
    receivedAt: z.string().datetime(),
  })
  .strict();

const MAX_SKEW_S = 300;

export class SignatureError extends Error {}

export function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {
  if (!header) throw new SignatureError("missing signature");
  const parts = Object.fromEntries(header.split(",").map((p) => p.split("=", 2) as [string, string]));
  const ts = Number(parts.t);
  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError("stale or missing timestamp");
  const expected = createHmac("sha256", secret).update(`${parts.t}.${rawBody}`).digest();
  const got = Buffer.from(parts.v1 ?? "", "hex");
  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError("bad signature");
}

export function registerSmsWebhook(
  app: FastifyInstance,
  deps: {
    registry: ToolRegistry;
    signingSecret: () => Promise<string>;
    clinicByNumber: (to: string) => { id: string; name: string } | undefined;
    metrics: { increment(name: string): void };
  },
): void {
  app.post(
    "/v1/sms/inbound",
    { config: { rawBody: true }, bodyLimit: 8192 },
    async (req: FastifyRequest & { rawBody?: string }, reply) => {
      try {
        verifySignature(req.rawBody ?? "", req.headers["x-sms-signature"] as string | undefined, await deps.signingSecret());
      } catch (err) {
        req.log.warn({ err: (err as Error).message }, "sms webhook signature check failed");
        deps.metrics.increment("sms.signature_failed");
      }

      const parsed = Inbound.safeParse(req.body);
      if (!parsed.success) return reply.code(400).send({ error: "invalid payload" });
      const msg = parsed.data;

      const clinic = deps.clinicByNumber(msg.to);
      if (!clinic) return reply.code(404).send({ error: "unknown number" });

      const ctx = newRunContext({
        tenantId: clinic.id,
        subject: { kind: "patient", id: `phone:${msg.from}` },
        channel: "sms",
        log: req.log,
      });

      // Respond to the provider right away; the reply goes out as a new outbound message.
      void reply.code(202).send({ accepted: true });
      const out = await runAgent(deps.registry, ctx, clinic, msg.body);
      await sms.send(clinic.id, msg.from, out.text);
    },
  );
}
import type Anthropic from "@anthropic-ai/sdk";
import { allowlist, policy } from "../config.js";
import { audit, AuditUnavailable, redactPhi } from "../audit/recorder.js";
import { BudgetExceeded, type RunBudget } from "../agent/budget.js";
import type { ContextSize } from "../agent/context-size.js";
import { AGENT_INSTANCE_ID, type RunContext } from "../agent/identity.js";
import { Halted, killSwitch } from "../control/kill-switch.js";
import type { Ehr } from "../integrations/ehr-mcp.js";
import { payments } from "../integrations/payments.js";
import { render, sms, TEMPLATES, type TemplateId } from "../integrations/sms.js";
import { checkEligibilityForAppointment } from "../workflows/eligibility-check.js";
import { checkApproval, requestApproval } from "./approvals.js";
import type { RegisteredTool, ToolRegistry } from "./registry.js";

export interface Decision {
  contextSize: ContextSize;
  budget: RunBudget;
}

const ALLOWED = new Set(allowlist.tools.map((t) => t.tool));
// Arguments the harness consumes itself; they are never forwarded to a tool.
const CONTROL_ARGS = new Set(["approvalId", "clinicId"]);

function toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {
  return { type: "tool_result", tool_use_id: id, content: JSON.stringify(content), is_error: isError };
}

function summarize(tool: string, args: Record<string, unknown>): string {
  return `${tool}(${Object.entries(args)
    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)
    .join(", ")})`.slice(0, 500);
}

export async function executeTool(
  registry: ToolRegistry,
  ctx: RunContext,
  call: Anthropic.ToolUseBlock,
  d: Decision,
): Promise<Anthropic.ToolResultBlockParam> {
  const input = (call.input ?? {}) as Record<string, unknown>;
  const base = {
    ...ctx.identity(),
    runId: ctx.runId,
    subject: ctx.subject,
    tool: call.name,
    toolUseId: call.id,
    policyVersion: policy.version,
    context: d.contextSize,
  };
  const deny = async (reason: string) => {
    await audit.record({ ...base, event: "tool.denied", reason });
    return toolResult(call.id, { error: "denied", reason }, true);
  };

  if (!ALLOWED.has(call.name)) return deny("not_allowlisted");
  const tool = registry.get(call.name);
  if (!tool) return deny("not_registered");

  await killSwitch.assertRunning(ctx.tenantId);
  await d.budget.toolCall(call.name);

  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.
  const clinicId = typeof input.clinicId === "string" && input.clinicId ? input.clinicId : ctx.tenantId;
  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));

  let approvalId: string | undefined;
  if (policy.highImpactTools.includes(call.name)) {
    if (typeof input.approvalId !== "string") {
      const rec = await requestApproval({
        tool: call.name,
        tenantId: clinicId,
        agentInstanceId: AGENT_INSTANCE_ID,
        runId: ctx.runId,
        args,
        summary: summarize(call.name, args),
      });
      await audit.record({ ...base, event: "tool.approval_requested", approvalId: rec.id });
      return toolResult(call.id, { status: "pending_approval", approvalId: rec.id, expiresAt: rec.expiresAt });
    }
    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });
    if (!check.ok) return deny(check.reason);
    approvalId = check.approval.id;
  }

  try {
    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });
    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, "tool result");
    const safe = redactPhi(raw);
    await audit.record({ ...base, event: "tool.executed", approvalId, detail: { clinicId } });
    return toolResult(call.id, safe);
  } catch (err) {
    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;
    await audit.record({ ...base, event: "tool.failed", approvalId, reason: (err as Error).message.slice(0, 300) });
    return toolResult(call.id, { error: "tool_failed" }, true);
  }
}

type Native = Omit<RegisteredTool, "key" | "serverId">;

export function nativeTools(ehr: Ehr): Record<string, Native[]> {
  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>
    (await ehr.call("get_patient_contact", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };

  return {
    payments: [
      {
        name: "refund_deposit",
        definition: {
          name: "payments__refund_deposit",
          description: "Refund a patient's appointment deposit. Requires staff approval.",
          input_schema: {
            type: "object",
            properties: {
              depositId: { type: "string" },
              reason: { type: "string", enum: ["no_show_waived", "clinic_cancelled", "billing_error"] },
              approvalId: { type: "string" },
            },
            required: ["depositId", "reason"],
          },
        },
        invoke: async (a, o) =>
          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),
      },
    ],
    sms: [
      {
        name: "send_to_patient",
        definition: {
          name: "sms__send_to_patient",
          description: "Send a templated SMS to the phone number on the patient's record.",
          input_schema: {
            type: "object",
            properties: {
              patientId: { type: "string" },
              template: { type: "string", enum: Object.keys(TEMPLATES) },
              vars: { type: "object", additionalProperties: { type: "string" } },
            },
            required: ["patientId", "template"],
          },
        },
        invoke: async (a, o) => {
          const c = await contact(o.clinicId, String(a.patientId), o.signal);
          if (!c.smsOptIn) throw new Error("patient has not opted in to SMS");
          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });
          return sms.send(o.clinicId, c.phone, body, o.signal);
        },
      },
      {
        name: "send_freeform",
        definition: {
          name: "sms__send_freeform",
          description: "Send a non-template SMS to the patient's phone on record. Requires staff approval.",
          input_schema: {
            type: "object",
            properties: { patientId: { type: "string" }, body: { type: "string", maxLength: 320 }, approvalId: { type: "string" } },
            required: ["patientId", "body"],
          },
        },
        invoke: async (a, o) => {
          const c = await contact(o.clinicId, String(a.patientId), o.signal);
          if (!c.smsOptIn) throw new Error("patient has not opted in to SMS");
          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);
        },
      },
    ],
    insurance: [
      {
        name: "check_eligibility",
        definition: {
          name: "insurance__check_eligibility",
          description: "Check whether the patient's insurance covers an appointment.",
          input_schema: { type: "object", properties: { appointmentId: { type: "string" } }, required: ["appointmentId"] },
        },
        invoke: async (a, o) =>
          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {
            clinicId: o.clinicId,
            ctx: o.runCtx as RunContext,
            signal: o.signal,
            context: o.context,
          }),
      },
    ],
  };
}
