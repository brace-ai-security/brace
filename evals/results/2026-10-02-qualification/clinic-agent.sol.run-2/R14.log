import { DynamoDBClient } from "@aws-sdk/client-dynamodb";
import { DynamoDBDocumentClient, UpdateCommand } from "@aws-sdk/lib-dynamodb";
import type { Budgets } from "../config.js";
import { env } from "../config.js";

export type LimitName =
  | "turns"
  | "wall_time"
  | "input_tokens"
  | "output_tokens"
  | "run_cost"
  | "tool_calls"
  | "tool_call_rate"
  | "peer_calls"
  | "subject_daily_cost"
  | "tenant_daily_cost"
  | "fleet_daily_cost"
  | "tenant_tool_rate"
  | "fleet_tool_rate";

export class BudgetExceeded extends Error {
  constructor(public limit: LimitName, public used: number, public max: number) {
    super(`budget exceeded: ${limit} (${used} > ${max})`);
  }
}

// Shared counters across runs and pods. add() must be atomic and refuse to go past max.
export interface QuotaStore {
  add(key: string, amount: number, max: number, ttlSeconds: number): Promise<{ ok: boolean; used: number }>;
}

export class DynamoQuotaStore implements QuotaStore {
  private ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));
  async add(key: string, amount: number, max: number, ttlSeconds: number) {
    try {
      const res = await this.ddb.send(
        new UpdateCommand({
          TableName: env.budgetTable,
          Key: { pk: key },
          UpdateExpression: "ADD used :n SET expiresAt = if_not_exists(expiresAt, :exp)",
          ConditionExpression: "attribute_not_exists(used) OR used <= :room",
          ExpressionAttributeValues: {
            ":n": amount,
            ":room": max - amount,
            ":exp": Math.floor(Date.now() / 1000) + ttlSeconds,
          },
          ReturnValues: "UPDATED_NEW",
        }),
      );
      return { ok: true, used: Number(res.Attributes?.used ?? amount) };
    } catch (err) {
      if ((err as { name?: string }).name === "ConditionalCheckFailedException") return { ok: false, used: max };
      throw err;
    }
  }
}

export interface Usage {
  input_tokens: number;
  output_tokens: number;
  cache_read_input_tokens?: number | null;
  cache_creation_input_tokens?: number | null;
}

const day = () => new Date().toISOString().slice(0, 10);
const minute = () => new Date().toISOString().slice(0, 16);

export class RunBudget {
  readonly abort = new AbortController();
  private started = Date.now();
  private timer: NodeJS.Timeout;
  private turns = 0;
  private inTok = 0;
  private outTok = 0;
  private cost = 0;
  private toolCalls = 0;
  private toolTimes: number[] = [];
  private peerCalls = 0;

  constructor(
    private b: Budgets,
    private store: QuotaStore,
    private scope: { tenantId: string; subjectId: string },
    private now: () => number = Date.now,
  ) {
    this.started = this.now();
    this.timer = setTimeout(
      () => this.abort.abort(new BudgetExceeded("wall_time", this.b.run.maxWallMs, this.b.run.maxWallMs)),
      this.b.run.maxWallMs,
    );
  }

  get signal(): AbortSignal {
    return this.abort.signal;
  }

  dispose(): void {
    clearTimeout(this.timer);
  }

  private check(limit: LimitName, used: number, max: number): void {
    if (used > max) {
      const e = new BudgetExceeded(limit, used, max);
      this.abort.abort(e);
      throw e;
    }
  }

  private checkWall(): void {
    this.check("wall_time", this.now() - this.started, this.b.run.maxWallMs);
  }

  turn(): void {
    this.checkWall();
    this.turns += 1;
    this.check("turns", this.turns, this.b.run.maxTurns);
  }

  async recordUsage(u: Usage, model: string): Promise<void> {
    const price = this.b.pricingUsdPerMTok[model];
    if (!price) throw new Error(`no pricing for model ${model}`);
    const cacheRead = u.cache_read_input_tokens ?? 0;
    const cacheWrite = u.cache_creation_input_tokens ?? 0;
    const callCost =
      (u.input_tokens * price.input +
        u.output_tokens * price.output +
        cacheRead * price.cacheRead +
        cacheWrite * price.cacheWrite) /
      1_000_000;

    this.inTok += u.input_tokens + cacheRead + cacheWrite;
    this.outTok += u.output_tokens;
    this.cost += callCost;
    this.check("input_tokens", this.inTok, this.b.run.maxInputTokens);
    this.check("output_tokens", this.outTok, this.b.run.maxOutputTokens);
    this.check("run_cost", this.cost, this.b.run.maxCostUsd);

    const q = this.b.quotas;
    await this.shared("subject_daily_cost", `cost#subject#${this.scope.subjectId}#${day()}`, callCost, q.perSubjectDailyUsd, 86400);
    await this.shared("tenant_daily_cost", `cost#tenant#${this.scope.tenantId}#${day()}`, callCost, q.perTenantDailyUsd, 86400);
    await this.shared("fleet_daily_cost", `cost#fleet#${day()}`, callCost, q.fleetDailyUsd, 86400);
  }

  async toolCall(tool: string): Promise<void> {
    this.checkWall();
    this.toolCalls += 1;
    this.check("tool_calls", this.toolCalls, this.b.run.maxToolCalls);

    const t = this.now();
    this.toolTimes = this.toolTimes.filter((x) => t - x < 60_000);
    this.toolTimes.push(t);
    this.check("tool_call_rate", this.toolTimes.length, this.b.run.maxToolCallsPerMinute);

    if (tool.startsWith("insurance__")) {
      this.peerCalls += 1;
      this.check("peer_calls", this.peerCalls, this.b.run.maxPeerCalls);
    }

    const q = this.b.quotas;
    await this.shared("tenant_tool_rate", `rate#tenant#${this.scope.tenantId}#${minute()}`, 1, q.perTenantToolCallsPerMinute, 120);
    await this.shared("fleet_tool_rate", `rate#fleet#${minute()}`, 1, q.fleetToolCallsPerMinute, 120);
  }

  private async shared(limit: LimitName, key: string, amount: number, max: number, ttl: number): Promise<void> {
    const r = await this.store.add(key, amount, max, ttl);
    if (!r.ok) {
      const e = new BudgetExceeded(limit, r.used + amount, max);
      this.abort.abort(e);
      throw e;
    }
  }
}
import { DynamoDBClient } from "@aws-sdk/client-dynamodb";
import { DynamoDBDocumentClient, BatchGetCommand } from "@aws-sdk/lib-dynamodb";
import { env } from "../config.js";

// Stop control. Operators write halted=true on "global" or "tenant#<clinicId>" in the control table.
// The agent only reads this table; every model turn and every tool call checks it, and a watcher
// aborts in-flight work for halted scopes.
export class Halted extends Error {
  constructor(public scope: string) {
    super(`agent halted (${scope})`);
  }
}

const ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));
const POLL_MS = 2000;

type Active = { tenantId: string; abort: AbortController };
const active = new Map<string, Active>();

let lastRead = 0;
let halted = new Set<string>();

async function refresh(): Promise<void> {
  const res = await ddb.send(
    new BatchGetCommand({
      RequestItems: {
        [env.controlTable]: {
          Keys: [{ pk: "global" }, ...[...new Set([...active.values()].map((a) => a.tenantId))].map((t) => ({ pk: `tenant#${t}` }))],
          ConsistentRead: true,
        },
      },
    }),
  );
  const next = new Set<string>();
  for (const item of res.Responses?.[env.controlTable] ?? []) {
    if (item.halted === true) next.add(String(item.pk));
  }
  halted = next;
  lastRead = Date.now();
}

export const killSwitch = {
  register(runId: string, tenantId: string, abort: AbortController): () => void {
    active.set(runId, { tenantId, abort });
    return () => active.delete(runId);
  },

  async assertRunning(tenantId: string): Promise<void> {
    if (Date.now() - lastRead > POLL_MS) {
      try {
        await refresh();
      } catch {
        // If the control table cannot be read, treat the agent as halted.
        throw new Halted("control-unreadable");
      }
    }
    if (halted.has("global")) throw new Halted("global");
    if (halted.has(`tenant#${tenantId}`)) throw new Halted(`tenant#${tenantId}`);
  },

  startWatcher(): NodeJS.Timeout {
    return setInterval(async () => {
      try {
        await refresh();
      } catch {
        halted = new Set(["global"]);
      }
      for (const [runId, a] of active) {
        if (halted.has("global") || halted.has(`tenant#${a.tenantId}`)) {
          a.abort.abort(new Halted(halted.has("global") ? "global" : `tenant#${a.tenantId}`));
          active.delete(runId);
        }
      }
    }, POLL_MS);
  },
};
import type Anthropic from "@anthropic-ai/sdk";
import type { ContextSize } from "../agent/context-size.js";
import { scanServer, type ServerMeta, type ToolMeta } from "./metadata-scan.js";

// Tool identity is "<serverId>__<toolName>", where serverId is the id this deployment assigned in
// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about
// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.
// Only servers listed in the manifest can contribute tools.

export interface ConfiguredServer {
  id: string;
  url: string;
  tlsCertSha256: string;
}

export interface InvokeOptions {
  clinicId: string;
  signal: AbortSignal;
  runCtx: unknown;
  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */
  context: ContextSize;
}

export interface RegisteredTool {
  key: string;
  serverId: string;
  name: string;
  definition: Anthropic.Tool;
  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;
}

export interface Conflict {
  key: string;
  conflictsWith: string;
  kind: "duplicate" | "lookalike";
}

const CONFUSABLES: Record<string, string> = { "0": "o", "1": "l", "3": "e", "5": "s", "7": "t", "@": "a", "$": "s" };

export function canonical(name: string): string {
  return name
    .normalize("NFKC")
    .toLowerCase()
    .replace(/rn/g, "m")
    .replace(/vv/g, "w")
    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)
    .replace(/[^a-z]/g, "");
}

function editDistanceAtMostOne(a: string, b: string): boolean {
  if (a === b) return true;
  if (Math.abs(a.length - b.length) > 1) return false;
  let i = 0;
  let j = 0;
  let edits = 0;
  while (i < a.length && j < b.length) {
    if (a[i] === b[j]) {
      i++;
      j++;
      continue;
    }
    if (++edits > 1) return false;
    if (a.length > b.length) i++;
    else if (b.length > a.length) j++;
    else {
      i++;
      j++;
    }
  }
  return edits + (a.length - i) + (b.length - j) <= 1;
}

export class ToolRegistry {
  private tools = new Map<string, RegisteredTool>();
  readonly conflicts: Conflict[] = [];
  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];

  constructor(private servers: ConfiguredServer[]) {}

  get(key: string): RegisteredTool | undefined {
    return this.tools.get(key);
  }

  definitions(): Anthropic.Tool[] {
    return [...this.tools.values()].map((t) => t.definition);
  }

  bareNamesExcept(serverId: string): Set<string> {
    return new Set([...this.tools.values()].filter((t) => t.serverId !== serverId).map((t) => t.name));
  }

  /** Native tools are registered first so MCP metadata that names them is caught by the scanner. */
  registerNative(serverId: string, tools: Array<Omit<RegisteredTool, "key" | "serverId">>): void {
    for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });
  }

  /**
   * serverId must be one of the configured servers, and the caller must have connected using that
   * server's pinned URL and certificate. reportedName is informational only.
   */
  registerMcp(
    serverId: string,
    reportedName: string | undefined,
    meta: ServerMeta,
    invoke: (tool: string, input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>,
  ): void {
    const cfg = this.servers.find((s) => s.id === serverId);
    if (!cfg) {
      this.rejected.push({ serverId, reason: `server not in release manifest (reported name ${reportedName ?? "none"})` });
      return;
    }
    let scan;
    try {
      scan = scanServer(meta, this.bareNamesExcept(serverId));
    } catch (err) {
      this.rejected.push({ serverId, reason: `metadata scan error: ${(err as Error).message}` });
      return;
    }
    if (scan.serverRejected) {
      this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });
      return;
    }
    for (const [tool, findings] of scan.rejectedTools) {
      this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });
    }
    for (const t of scan.acceptedTools) {
      this.add({
        key: `${serverId}__${t.name}`,
        serverId,
        name: t.name,
        definition: toDefinition(`${serverId}__${t.name}`, t),
        invoke: (input, opts) => invoke(t.name, input, opts),
      });
    }
  }

  private add(t: RegisteredTool): void {
    if (this.tools.has(t.key)) {
      this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: "duplicate" });
      this.rejected.push({ serverId: t.serverId, tool: t.name, reason: "duplicate tool key" });
      return;
    }
    const c = canonical(t.name);
    for (const existing of this.tools.values()) {
      if (existing.serverId === t.serverId) continue;
      if (existing.name === t.name) {
        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: "duplicate" });
        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });
        return;
      }
      if (editDistanceAtMostOne(canonical(existing.name), c)) {
        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: "lookalike" });
        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `looks like ${existing.key}` });
        return;
      }
    }
    this.tools.set(t.key, t);
  }
}

function toDefinition(key: string, t: ToolMeta): Anthropic.Tool {
  return {
    name: key,
    description: t.description ?? "",
    input_schema: (t.inputSchema as Anthropic.Tool.InputSchema) ?? { type: "object", properties: {} },
  };
}
