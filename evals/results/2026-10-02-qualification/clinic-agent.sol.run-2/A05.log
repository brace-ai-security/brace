     2	import { DynamoDBDocumentClient, BatchGetCommand } from "@aws-sdk/lib-dynamodb";
     3	import { env } from "../config.js";
     4	
     5	// Stop control. Operators write halted=true on "global" or "tenant#<clinicId>" in the control table.
     6	// The agent only reads this table; every model turn and every tool call checks it, and a watcher
     7	// aborts in-flight work for halted scopes.
     8	export class Halted extends Error {
     9	  constructor(public scope: string) {
    10	    super(`agent halted (${scope})`);
    11	  }
    12	}
    13	
    14	const ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));
    15	const POLL_MS = 2000;
    16	
    17	type Active = { tenantId: string; abort: AbortController };
    18	const active = new Map<string, Active>();
    19	
    20	let lastRead = 0;
    21	let halted = new Set<string>();
    22	
    23	async function refresh(): Promise<void> {
    24	  const res = await ddb.send(
    25	    new BatchGetCommand({
    26	      RequestItems: {
    27	        [env.controlTable]: {
    28	          Keys: [{ pk: "global" }, ...[...new Set([...active.values()].map((a) => a.tenantId))].map((t) => ({ pk: `tenant#${t}` }))],
    29	          ConsistentRead: true,
    30	        },
    31	      },
    32	    }),
    33	  );
    34	  const next = new Set<string>();
    35	  for (const item of res.Responses?.[env.controlTable] ?? []) {
    36	    if (item.halted === true) next.add(String(item.pk));
    37	  }
    38	  halted = next;
    39	  lastRead = Date.now();
    40	}
    41	
    42	export const killSwitch = {
    43	  register(runId: string, tenantId: string, abort: AbortController): () => void {
    44	    active.set(runId, { tenantId, abort });
    45	    return () => active.delete(runId);
    46	  },
    47	
    48	  async assertRunning(tenantId: string): Promise<void> {
    49	    if (Date.now() - lastRead > POLL_MS) {
    50	      try {
    51	        await refresh();
    52	      } catch {
    53	        // If the control table cannot be read, treat the agent as halted.
    54	        throw new Halted("control-unreadable");
    55	      }
    56	    }
    57	    if (halted.has("global")) throw new Halted("global");
    58	    if (halted.has(`tenant#${tenantId}`)) throw new Halted(`tenant#${tenantId}`);
    59	  },
    60	
    61	  startWatcher(): NodeJS.Timeout {
    62	    return setInterval(async () => {
    63	      try {
    64	        await refresh();
    65	      } catch {
    66	        halted = new Set(["global"]);
    67	      }
    68	      for (const [runId, a] of active) {
    69	        if (halted.has("global") || halted.has(`tenant#${a.tenantId}`)) {
    70	          a.abort.abort(new Halted(halted.has("global") ? "global" : `tenant#${a.tenantId}`));
    71	          active.delete(runId);
    72	        }
    73	      }
    74	    }, POLL_MS);
    75	  },
    76	};
