const sm = new SecretsManagerClient({ region: env.region });
const BASE = process.env.SMS_API ?? "https://api.sms-provider.example/v1";

export const TEMPLATES = {
  reminder: "Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.",
  booked: "Hi {firstName}, you're booked for {when} at {location}.",
  rescheduled: "Hi {firstName}, your appointment moved to {when} at {location}.",
  cancelled: "Hi {firstName}, your appointment on {when} is cancelled.",
} as const;
export type TemplateId = keyof typeof TEMPLATES;

export function render(id: TemplateId, vars: Record<string, string>): string {
  return TEMPLATES[id].replace(/\{(\w+)\}/g, (_, k: string) => (vars[k] ?? "").replace(/[^\p{L}\p{N} .,:'/-]/gu, "").slice(0, 60));
}

async function creds(clinicId: string): Promise<{ token: string; from: string }> {
  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));
  const v = JSON.parse(s.SecretString ?? "{}");
  return { token: v.api_token, from: v.from_number };
}

export const sms = {
  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {
    const c = await creds(clinicId);
    const res = await fetch(`${BASE}/messages`, {
      method: "POST",
      signal,
      headers: { authorization: `Bearer ${c.token}`, "content-type": "application/json" },
      body: JSON.stringify({ from: c.from, to, body }),
    });
    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);
    return (await res.json()) as { messageId: string };
  },
};
import { FirehoseClient, PutRecordCommand } from "@aws-sdk/client-firehose";
import { randomUUID } from "node:crypto";
import { z } from "zod";
import { env } from "../config.js";

// Every audit record carries the six identity fields. Values come from RunContext, which is built
// by the HTTP layer and the worker, never from model output.
export const IdentityFields = z.object({
  accountableParty: z.string().min(1),
  operationalOwner: z.string().min(1),
  tenantId: z.string().min(1),
  agentTypeId: z.string().startsWith("sha256:"),
  agentInstanceId: z.string().uuid(),
  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),
});

export const AuditEvent = IdentityFields.extend({
  eventId: z.string().uuid(),
  ts: z.string().datetime(),
  runId: z.string().uuid(),
  event: z.enum([
    "run.started",
    "run.stopped",
    "run.completed",
    "intent.classified",
    "model.decision",
    "tool.denied",
    "tool.approval_requested",
    "tool.executed",
    "tool.failed",
    "payment.refund",
    "peer.call",
    "reminder.sent",
  ]),
  subject: z.object({ kind: z.enum(["patient", "staff", "system"]), id: z.string() }),
  tool: z.string().optional(),
  toolUseId: z.string().optional(),
  policyVersion: z.string().optional(),
  approvalId: z.string().optional(),
  reason: z.string().optional(),
  context: z
    .object({
      tokens: z.number().int().nonnegative().nullable(),
      status: z.enum(["measured", "estimated", "unavailable"]),
      method: z.string(),
      cachedInputTokens: z.number().int().nonnegative().nullable(),
      compacted: z.boolean(),
    })
    .optional(),
  detail: z.record(z.unknown()).optional(),
});
export type AuditEvent = z.infer<typeof AuditEvent>;

const firehose = new FirehoseClient({ region: env.region });

export class AuditUnavailable extends Error {}

export const audit = {
  async record(e: Omit<AuditEvent, "eventId" | "ts">): Promise<void> {
    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });
    try {
      await firehose.send(
        new PutRecordCommand({
          DeliveryStreamName: env.auditStream,
          Record: { Data: Buffer.from(JSON.stringify(full) + "\n") },
        }),
      );
    } catch (err) {
      // Callers treat this as a hard failure: an action that cannot be audited does not run.
      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);
    }
  },
};

// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.
const DROP_KEYS = new Set(["ssn", "dateOfBirth", "dob", "memberId", "subscriberId", "cardNumber", "cardLast4", "address"]);
const PATTERNS: Array<[RegExp, string]> = [
  [/\b\d{3}-\d{2}-\d{4}\b/g, "[ssn]"],
  [/\b(?:\d[ -]?){13,19}\b/g, "[card]"],
  [/\b[A-Z]{3}\d{9}\b/g, "[member-id]"],
];

export function redactPhi(value: unknown): unknown {
  if (typeof value === "string") {
    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);
  }
  if (Array.isArray(value)) return value.map(redactPhi);
  if (value && typeof value === "object") {
    const out: Record<string, unknown> = {};
    for (const [k, v] of Object.entries(value)) {
      if (DROP_KEYS.has(k)) continue;
      out[k] = redactPhi(v);
    }
    return out;
  }
  return value;
}
import { DynamoDBClient } from "@aws-sdk/client-dynamodb";
import { DynamoDBDocumentClient, GetCommand, PutCommand } from "@aws-sdk/lib-dynamodb";
import { createHash, randomUUID } from "node:crypto";
import { env, policy } from "../config.js";

// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or
// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,
// approvedAt); the agent then retries the tool with the approval id.

export interface ApprovalRecord {
  id: string;
  status: "pending" | "approved" | "rejected";
  tool: string;
  tenantId: string;
  agentInstanceId: string;
  runId: string;
  argsHash: string;
  summary: string;
  requestedAt: string;
  expiresAt: string;
  approvedBy?: string;
  approverRole?: string;
  approvedAt?: string;
}

const ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));

export function hashArgs(args: Record<string, unknown>): string {
  const canonical = JSON.stringify(args, Object.keys(args).sort());
  return createHash("sha256").update(canonical).digest("hex");
}

export async function requestApproval(req: {
  tool: string;
  tenantId: string;
  agentInstanceId: string;
  runId: string;
  args: Record<string, unknown>;
  summary: string;
}): Promise<ApprovalRecord> {
  const now = Date.now();
  const rec: ApprovalRecord = {
    id: randomUUID(),
    status: "pending",
    tool: req.tool,
    tenantId: req.tenantId,
    agentInstanceId: req.agentInstanceId,
    runId: req.runId,
    argsHash: hashArgs(req.args),
    summary: req.summary,
    requestedAt: new Date(now).toISOString(),
    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),
  };
  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: "attribute_not_exists(id)" }));
  return rec;
}

export type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };

export async function checkApproval(req: {
  approvalId: string;
  tool: string;
  tenantId: string;
  args: Record<string, unknown>;
}): Promise<ApprovalCheck> {
  let rec: ApprovalRecord | undefined;
  try {
    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));
    rec = res.Item as ApprovalRecord | undefined;
  } catch (err) {
    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };
  }
  if (!rec) return { ok: false, reason: "approval not found" };
  if (rec.status !== "approved") return { ok: false, reason: `approval is ${rec.status}` };
  if (rec.tool !== req.tool) return { ok: false, reason: "approval is for a different tool" };
  if (rec.tenantId !== req.tenantId) return { ok: false, reason: "approval is for a different clinic" };
  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: "approval expired" };
  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {
    return { ok: false, reason: "approver lacks authority" };
  }
  return { ok: true, approval: rec };
}
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { parse } from "yaml";

export const ROOT = process.env.CLINIC_AGENT_ROOT ?? process.cwd();

export interface Policy {
  version: string;
  highImpactTools: string[];
  approval: { ttlSeconds: number; approverRoles: string[]; table: string };
}

export interface AllowlistEntry {
  tool: string;
  reason: string;
}

export interface Budgets {
  run: {
    maxTurns: number;
    maxWallMs: number;
    maxInputTokens: number;
    maxOutputTokens: number;
    maxCostUsd: number;
    maxToolCalls: number;
    maxToolCallsPerMinute: number;
    maxPeerCalls: number;
  };
  quotas: {
    perSubjectDailyUsd: number;
    perTenantDailyUsd: number;
    fleetDailyUsd: number;
    perTenantToolCallsPerMinute: number;
    fleetToolCallsPerMinute: number;
  };
  pricingUsdPerMTok: Record<string, { input: number; output: number; cacheRead: number; cacheWrite: number }>;
  onExceed: "handoff_to_staff";
}

function loadYaml<T>(rel: string): T {
  return parse(readFileSync(join(ROOT, rel), "utf8")) as T;
}

export const policy = loadYaml<Policy>("config/policy.yaml");
export const allowlist = loadYaml<{ role: string; tools: AllowlistEntry[] }>("config/tools.allowlist.yaml");
export const budgets = loadYaml<Budgets>("config/budgets.yaml");
export const manifest = JSON.parse(readFileSync(join(ROOT, "release/manifest.json"), "utf8"));

