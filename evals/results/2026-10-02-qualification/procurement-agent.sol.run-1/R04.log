"""Per-department notes kept between runs (Postgres ``dept_notes``).

Writes are restricted to a fixed set of note kinds, length-limited, checked
for instruction-like content, and stored as unverified with a 30-day expiry
until a procurement lead verifies them in the admin UI. Every row records
who wrote it, from which run and source document, and the context size at
the time.
"""
from __future__ import annotations

import re
import uuid
from typing import Any

from app.identity import RunIdentity
from app.tools import Tool

NOTE_KINDS = ("vendor_preference", "contract_term", "budget_note", "contact")
MAX_NOTE_CHARS = 800
INSTRUCTION_LIKE = [
    re.compile(r"(?i)\b(ignore|disregard|override)\b.{0,40}\b(instruction|policy|approval|rule)s?\b"),
    re.compile(r"(?i)\b(always|never|must)\b.{0,40}\b(approve|pay|skip|send|transfer)\b"),
    re.compile(r"(?i)\b(system prompt|you are|assistant:)\b"),
    re.compile(r"https?://"),
]


class NoteRejected(Exception):
    pass


def check_note(text: str) -> None:
    if len(text) > MAX_NOTE_CHARS:
        raise NoteRejected("note too long")
    for pattern in INSTRUCTION_LIKE:
        if pattern.search(text):
            raise NoteRejected("note looks like an instruction")


def tools(deps) -> list[Tool]:
    pool = deps.pool

    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:
        business_unit = args.get("business_unit") or ident.tenant
        rows = await pool.fetch(
            """
            SELECT note_id, kind, body, verified, writer_instance, created_at
            FROM dept_notes
            WHERE business_unit = $1
              AND department = $2
              AND NOT quarantined
              AND (verified OR expires_at > now())
            ORDER BY created_at DESC
            LIMIT 20
            """,
            business_unit,
            args["department"],
        )
        return [
            {
                "note_id": r["note_id"],
                "kind": r["kind"],
                "body": r["body"],
                "trust": "verified" if r["verified"] else "unverified",
                "written": r["created_at"].isoformat(),
            }
            for r in rows
        ]

    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:
        if args["kind"] not in NOTE_KINDS:
            raise NoteRejected(f"unknown note kind {args['kind']}")
        check_note(args["body"])
        note_id = f"note-{uuid.uuid4()}"
        ctx = deps.current_context(ident)
        await pool.execute(
            """
            INSERT INTO dept_notes (
                note_id, business_unit, department, kind, body,
                verified, quarantined, expires_at,
                writer_instance, writer_type_id, run_id, source_doc_id,
                delegated_subject, context_tokens, context_method, created_at
            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',
                      $6, $7, $8, $9, $10, $11, $12, now())
            """,
            note_id,
            ident.tenant,
            args["department"],
            args["kind"],
            args["body"],
            ident.agent_instance_id,
            ident.agent_type_id,
            ident.run_id,
            args.get("source_doc_id"),
            ident.delegated_subject,
            ctx.tokens,
            ctx.method,
        )
        return {"note_id": note_id, "status": "stored_unverified"}

    return [
        Tool(
            name="memory_read",
            description=(
                "Read saved notes for a department. business_unit defaults to the current one; "
                "shared-services staff may look up another unit's notes."
            ),
            input_schema={
                "type": "object",
                "properties": {
                    "department": {"type": "string", "maxLength": 64},
                    "business_unit": {"type": "string", "maxLength": 32},
                },
                "required": ["department"],
                "additionalProperties": False,
            },
            invoke=memory_read,
        ),
        Tool(
            name="memory_write",
            description="Save a short factual note for a department (vendor preference, contract term, budget note, contact).",
            input_schema={
                "type": "object",
                "properties": {
                    "department": {"type": "string", "maxLength": 64},
                    "kind": {"type": "string", "enum": list(NOTE_KINDS)},
                    "body": {"type": "string", "maxLength": MAX_NOTE_CHARS},
                    "source_doc_id": {"type": "string", "maxLength": 64},
                },
                "required": ["department", "kind", "body"],
                "additionalProperties": False,
            },
            invoke=memory_write,
        ),
    ]
"""Document tools: read an ingested quote or invoice, and extract line items."""
from __future__ import annotations

from typing import Any

from app.identity import RunIdentity
from app.tools import Tool

UNTRUSTED_WRAPPER = (
    "<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\n"
    "{text}\n"
    "</untrusted_document>"
)


def tools(deps) -> list[Tool]:
    pool = deps.pool

    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:
        row = await pool.fetchrow(
            """
            SELECT doc_id, source, media_type, text
            FROM documents
            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'
            """,
            args["doc_id"],
            ident.tenant,
        )
        if row is None:
            return "document not found"
        return UNTRUSTED_WRAPPER.format(
            source=row["source"], doc_id=row["doc_id"], media_type=row["media_type"], text=row["text"]
        )

    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:
        return await deps.extractor.extract(ident, args["doc_id"], deps.current_budget(ident))

    return [
        Tool(
            name="read_document",
            description="Read the text of an ingested vendor quote, invoice, or email by doc_id.",
            input_schema={
                "type": "object",
                "properties": {"doc_id": {"type": "string", "maxLength": 64}},
                "required": ["doc_id"],
                "additionalProperties": False,
            },
            invoke=read_document,
        ),
        Tool(
            name="extract_line_items",
            description="Extract structured line items (sku, description, qty, unit price, currency) from a document.",
            input_schema={
                "type": "object",
                "properties": {"doc_id": {"type": "string", "maxLength": 64}},
                "required": ["doc_id"],
                "additionalProperties": False,
            },
            invoke=extract_line_items,
        ),
    ]
"""Inbound documents: vendor quotes and invoices from the mail gateway.

The mail gateway posts each received message to ``/ingest/mail`` signed with
an HMAC over the timestamp and body. Accepted documents are stored per
business unit and are only ever shown to the model inside an
``untrusted_document`` wrapper (tools/documents.py).
"""
from __future__ import annotations

import base64
import email
import email.policy
import hashlib
import hmac
import io
import re
import time
import uuid
from dataclasses import dataclass
from pathlib import Path

from fastapi import APIRouter, HTTPException, Request
from pypdf import PdfReader

router = APIRouter()

MAX_BODY_BYTES = 10 * 1024 * 1024
MAX_TEXT_CHARS = 200_000
MAX_SKEW_SECONDS = 300
ALLOWED_MEDIA_TYPES = {"application/pdf", "text/plain", "message/rfc822"}
SCANNED_MEDIA_TYPES = {"application/pdf", "text/plain"}

INJECTION_PATTERNS = [
    re.compile(r"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)"),
    re.compile(r"(?i)\b(system|developer) (prompt|message)\b"),
    re.compile(r"(?i)\byou are (now )?(an?|the) \w+ (agent|assistant)\b"),
    re.compile(r"(?i)\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\b"),
    re.compile(r"(?i)\b(update|change) (our|the) (bank|remit|payee)\b"),
    re.compile(r"[​-‏‪-‮⁠-⁤]"),
]


class Rejected(Exception):
    pass


@dataclass
class Inbound:
    business_unit: str
    sender: str
    media_type: str
    raw: bytes


def verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:
    try:
        ts = int(timestamp)
    except ValueError as exc:
        raise Rejected("bad timestamp") from exc
    if abs(time.time() - ts) > MAX_SKEW_SECONDS:
        raise Rejected("stale request")
    expected = hmac.new(key, f"{timestamp}.".encode() + body, hashlib.sha256).hexdigest()
    if not hmac.compare_digest(expected, signature):
        raise Rejected("bad signature")


def extract_text(doc: Inbound) -> str:
    if doc.media_type == "application/pdf":
        reader = PdfReader(io.BytesIO(doc.raw))
        if len(reader.pages) > 50:
            raise Rejected("too many pages")
        return "\n".join(page.extract_text() or "" for page in reader.pages)
    if doc.media_type == "message/rfc822":
        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)
        body = msg.get_body(preferencelist=("plain", "html"))
        return body.get_content() if body is not None else ""
    return doc.raw.decode("utf-8", errors="strict")


def scan_for_injection(text: str) -> list[str]:
    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]


def validate(doc: Inbound) -> str:
    if doc.media_type not in ALLOWED_MEDIA_TYPES:
        raise Rejected(f"media type {doc.media_type} not accepted")
    if len(doc.raw) > MAX_BODY_BYTES:
        raise Rejected("document too large")
    try:
        text = extract_text(doc)
    except Rejected:
        raise
    except Exception as exc:
        raise Rejected(f"unreadable document: {type(exc).__name__}") from exc
    if len(text) > MAX_TEXT_CHARS:
        raise Rejected("extracted text too long")
    if doc.media_type in SCANNED_MEDIA_TYPES:
        findings = scan_for_injection(text)
        if findings:
            raise Rejected("possible prompt injection: " + "; ".join(findings))
    return text


@router.post("/ingest/mail")
async def ingest_mail(request: Request) -> dict:
    body = await request.body()
    if len(body) > MAX_BODY_BYTES * 2:
        raise HTTPException(413, "payload too large")
    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()
    try:
        verify_signature(
            key,
            request.headers.get("X-Gateway-Timestamp", ""),
            body,
            request.headers.get("X-Gateway-Signature", ""),
        )
    except Rejected as exc:
        raise HTTPException(401, str(exc)) from exc

    payload = await request.json()
    doc = Inbound(
        business_unit=payload["business_unit"],
        sender=payload["from"],
        media_type=payload["media_type"],
        raw=base64.b64decode(payload["content_b64"], validate=True),
    )
    doc_id = f"doc-{uuid.uuid4().hex[:20]}"
    pool = request.app.state.pool
    try:
        text = validate(doc)
    except Rejected as exc:
        await pool.execute(
            """
            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)
            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())
            """,
            doc_id, doc.business_unit, doc.sender, doc.media_type,
            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],
        )
        return {"doc_id": doc_id, "status": "quarantined"}

    await pool.execute(
        """
        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)
        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())
        """,
        doc_id, doc.business_unit, doc.sender, doc.media_type,
        hashlib.sha256(doc.raw).hexdigest(), text,
    )
    return {"doc_id": doc_id, "status": "accepted"}
-- Procurement agent schema. Applied by the migration job with the
-- procurement_owner role; the running agent connects as procurement_agent.

CREATE TABLE audit_events (
    node_id             text PRIMARY KEY,
    parent_node_id      text REFERENCES audit_events (node_id),
    run_id              text NOT NULL,
    ts                  timestamptz NOT NULL,
    kind                text NOT NULL,
    accountable_party   text NOT NULL CHECK (accountable_party <> ''),
    operational_owner   text NOT NULL CHECK (operational_owner <> ''),
    tenant              text NOT NULL CHECK (tenant <> ''),
    agent_type_id       text NOT NULL CHECK (agent_type_id <> ''),
    agent_instance_id   text NOT NULL CHECK (agent_instance_id <> ''),
    trace_id            text NOT NULL CHECK (trace_id <> ''),
    span_id             text,
    delegated_subject   text NOT NULL,
    agent_principal     text NOT NULL,
    parent_instance_id  text,
    policy_version      text,
    approval_id         text,
    operation_id        text,
    context_tokens      integer CHECK (context_tokens IS NULL OR context_tokens > 0),
    context_method      text NOT NULL,
    context_compacted   boolean NOT NULL,
    payload             jsonb NOT NULL
);
CREATE INDEX audit_events_run ON audit_events (run_id, ts);
CREATE INDEX audit_events_instance ON audit_events (agent_instance_id, ts);
CREATE INDEX audit_events_trace ON audit_events (trace_id);

CREATE TABLE approvals (
    id                     text PRIMARY KEY,
    tool                   text NOT NULL,
    target                 text NOT NULL,
    args_sha256            text NOT NULL,
    args_summary           jsonb NOT NULL,
    tenant                 text NOT NULL,
    requested_by_instance  text NOT NULL,
    requested_by_run       text NOT NULL,
    delegated_subject      text NOT NULL,
    status                 text NOT NULL CHECK (status IN ('pending', 'approved', 'rejected', 'expired')),
    requested_at           timestamptz NOT NULL,
    expires_at             timestamptz NOT NULL,
    approver               text,
    approver_role          text,
    decided_at             timestamptz
);
CREATE INDEX approvals_lookup ON approvals (tool, target, tenant, status);

CREATE TABLE approvers (
    slack_user_id  text PRIMARY KEY,
    email          text NOT NULL,
    role           text NOT NULL,
    business_unit  text NOT NULL,
    active         boolean NOT NULL DEFAULT true
);

CREATE TABLE documents (
    doc_id         text PRIMARY KEY,
    business_unit  text NOT NULL,
    source         text NOT NULL,
    media_type     text NOT NULL,
    sha256         text NOT NULL,
    status         text NOT NULL CHECK (status IN ('accepted', 'quarantined')),
    reject_reason  text,
    text           text,
    received_at    timestamptz NOT NULL
);
CREATE INDEX documents_bu ON documents (business_unit, doc_id);

CREATE TABLE dept_notes (
    note_id            text PRIMARY KEY,
    business_unit      text NOT NULL,
    department         text NOT NULL,
    kind               text NOT NULL,
    body               text NOT NULL,
    verified           boolean NOT NULL DEFAULT false,
    verified_by        text,
    quarantined        boolean NOT NULL DEFAULT false,
    expires_at         timestamptz,
    writer_instance    text NOT NULL,
    writer_type_id     text NOT NULL,
    run_id             text NOT NULL,
    source_doc_id      text,
    delegated_subject  text NOT NULL,
    context_tokens     integer,
    context_method     text NOT NULL,
    created_at         timestamptz NOT NULL
);
CREATE INDEX dept_notes_lookup ON dept_notes (business_unit, department, created_at DESC);
CREATE INDEX dept_notes_source ON dept_notes (source_doc_id);
CREATE INDEX dept_notes_writer ON dept_notes (writer_instance);

CREATE TABLE control_flags (
    scope    text PRIMARY KEY,           -- 'fleet' or 'tenant:<business_unit>'
    halted   boolean NOT NULL,
    reason   text NOT NULL,
    set_by   text NOT NULL,
    set_at   timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE spend_quota (
    scope      text NOT NULL,
    key        text NOT NULL,
    day        date NOT NULL,
    spent_usd  numeric(12, 4) NOT NULL,
    PRIMARY KEY (scope, key, day)
);

CREATE TABLE run_start_window (
    scope   text NOT NULL,
    key     text NOT NULL,
    minute  timestamptz NOT NULL,
    starts  integer NOT NULL,
    PRIMARY KEY (scope, key, minute)
);

-- Runtime role: append-only audit, no access to control flags beyond reading.
REVOKE ALL ON ALL TABLES IN SCHEMA public FROM procurement_agent;
GRANT SELECT, INSERT ON audit_events TO procurement_agent;
GRANT SELECT, INSERT, UPDATE ON approvals TO procurement_agent;
GRANT SELECT ON approvers TO procurement_agent;
GRANT SELECT, INSERT ON documents TO procurement_agent;
GRANT SELECT, INSERT ON dept_notes TO procurement_agent;
GRANT SELECT ON control_flags TO procurement_agent;
GRANT SELECT, INSERT, UPDATE ON spend_quota TO procurement_agent;
GRANT SELECT, INSERT, UPDATE ON run_start_window TO procurement_agent;

-- Operators: halt and resume.
GRANT SELECT, INSERT, UPDATE ON control_flags TO procurement_ops;
GRANT SELECT ON audit_events TO procurement_ops;
GRANT SELECT, UPDATE (verified, verified_by, quarantined) ON dept_notes TO procurement_ops;
