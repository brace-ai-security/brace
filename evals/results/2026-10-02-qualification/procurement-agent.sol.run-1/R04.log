"""ERP tools: budget lookups, generic ERP reads, and purchase-order creation."""
from __future__ import annotations

from typing import Any

from app.identity import RunIdentity
from app.tools import Tool

ERP_READ_SCOPE = "erp.read"
ERP_PO_WRITE_SCOPE = "erp.read erp.po.create"


def tools(deps) -> list[Tool]:
    erp = deps.erp

    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:
        return await erp.call(
            "budget.get_remaining",
            {"business_unit": ident.tenant, "department": args["department"], "fiscal_period": args["fiscal_period"]},
            ident,
            ERP_READ_SCOPE,
        )

    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:
        arguments = dict(args.get("arguments", {}))
        arguments["business_unit"] = ident.tenant
        return await erp.call(args["operation"], arguments, ident, deps.erp_scope_for(args["operation"]))

    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:
        return await erp.call(
            "po.create",
            {
                "business_unit": ident.tenant,
                "department": args["department"],
                "vendor_id": args["vendor_id"],
                "lines": args["lines"],
                "currency": args["currency"],
                "source_doc_id": args["source_doc_id"],
                "client_reference": args["source_doc_id"],
            },
            ident,
            ERP_PO_WRITE_SCOPE,
        )

    line_schema = {
        "type": "object",
        "properties": {
            "sku": {"type": "string", "maxLength": 64},
            "description": {"type": "string", "maxLength": 256},
            "quantity": {"type": "number", "exclusiveMinimum": 0},
            "unit_price_cents": {"type": "integer", "minimum": 0},
        },
        "required": ["sku", "quantity", "unit_price_cents"],
        "additionalProperties": False,
    }

    return [
        Tool(
            name="get_budget",
            description="Remaining budget for a department in a fiscal period.",
            input_schema={
                "type": "object",
                "properties": {
                    "department": {"type": "string", "maxLength": 64},
                    "fiscal_period": {"type": "string", "pattern": "^FY[0-9]{4}-Q[1-4]$"},
                },
                "required": ["department", "fiscal_period"],
                "additionalProperties": False,
            },
            invoke=get_budget,
        ),
        Tool(
            name="erp_call",
            description=(
                "Look up ERP records (vendors, invoices, purchase orders, budgets). "
                "operation is an ERP operation name such as vendor.get or invoice.list_open."
            ),
            input_schema={
                "type": "object",
                "properties": {
                    "operation": {"type": "string", "maxLength": 64},
                    "arguments": {"type": "object"},
                },
                "required": ["operation"],
                "additionalProperties": False,
            },
            invoke=erp_call,
        ),
        Tool(
            name="create_purchase_order",
            description="Raise a purchase order in the ERP for an approved quote.",
            input_schema={
                "type": "object",
                "properties": {
                    "department": {"type": "string", "maxLength": 64},
                    "vendor_id": {"type": "string", "maxLength": 32},
                    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
                    "source_doc_id": {"type": "string", "maxLength": 64},
                    "lines": {"type": "array", "items": line_schema, "maxItems": 200},
                },
                "required": ["department", "vendor_id", "currency", "source_doc_id", "lines"],
                "additionalProperties": False,
            },
            invoke=create_purchase_order,
            target_field="source_doc_id",
        ),
    ]
"""Client for the ERP MCP server, reached through the internal MCP gateway.

On startup the tool list is fetched and each tool's description and input
schema are fingerprinted and compared with the pins in the release manifest.
Any unpinned or changed tool stops startup. Tool metadata is also scanned for
instruction-like content before any of it is shown to the model.
"""
from __future__ import annotations

import hashlib
import json
import logging
import re
import uuid
from typing import Any

import httpx

from app.identity import RunIdentity, TokenBroker
from app.redact import redact_text

log = logging.getLogger(__name__)

MAX_DESCRIPTION_CHARS = 1024
SUSPICIOUS_METADATA = [
    re.compile(r"(?i)ignore (all|any|previous|prior) instructions"),
    re.compile(r"(?i)\b(system prompt|you are now|act as)\b"),
    re.compile(r"(?i)\b(before|instead of) (calling|using) \w+\.\w+"),
    re.compile(r"[​-‏‪-‮⁠-⁤]"),
    re.compile(r"[A-Za-z0-9+/]{120,}={0,2}"),
]


class ToolPinMismatch(Exception):
    pass


class UnknownErpOperation(Exception):
    pass


def fingerprint(tool: dict[str, Any]) -> str:
    material = {
        "name": tool["name"],
        "description": tool.get("description", ""),
        "inputSchema": tool.get("inputSchema", {}),
        "annotations": tool.get("annotations", {}),
    }
    raw = json.dumps(material, sort_keys=True, separators=(",", ":"))
    return "sha256:" + hashlib.sha256(raw.encode("utf-8")).hexdigest()


def scan_metadata(tool: dict[str, Any]) -> None:
    description = tool.get("description", "")
    if len(description) > MAX_DESCRIPTION_CHARS:
        raise ToolPinMismatch(f"{tool['name']}: description too long")
    blob = json.dumps(tool, ensure_ascii=False)
    for pattern in SUSPICIOUS_METADATA:
        if pattern.search(blob):
            raise ToolPinMismatch(f"{tool['name']}: suspicious metadata ({pattern.pattern})")


class ErpMcpClient:
    AUDIENCE = "erp-mcp-gateway"

    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):
        self.url = url
        self.pins = pins
        self.broker = broker
        self._tools: dict[str, dict[str, Any]] = {}

    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:
        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:
            resp = await client.post(
                self.url,
                json={"jsonrpc": "2.0", "id": str(uuid.uuid4()), "method": method, "params": params},
                headers={"Authorization": f"Bearer {token}", "Mcp-Protocol-Version": "2025-06-18"},
            )
        resp.raise_for_status()
        if len(resp.content) > 512_000:
            raise ValueError("erp response too large")
        body = resp.json()
        if "error" in body:
            raise RuntimeError(f"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}")
        return body["result"]

    async def _list_tools(self, token: str) -> list[dict[str, Any]]:
        result = await self._rpc("tools/list", {}, token)
        return list(result.get("tools", []))

    async def initialize(self, service_ident: RunIdentity) -> None:
        token = await self.broker.token_for(self.AUDIENCE, "erp.tools.list", service_ident)
        tools = await self._list_tools(token)
        for tool in tools:
            expected = self.pins.get(tool["name"])
            actual = fingerprint(tool)
            if expected != actual:
                raise ToolPinMismatch(f"{tool['name']}: expected {expected}, got {actual}")
            scan_metadata(tool)
        self._tools = {t["name"]: t for t in tools}
        log.info("erp tools loaded: %d", len(self._tools))

    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:
        if message.get("method") == "notifications/tools/list_changed":
            await self.refresh_tools(service_ident)

    async def refresh_tools(self, service_ident: RunIdentity) -> None:
        token = await self.broker.token_for(self.AUDIENCE, "erp.tools.list", service_ident)
        tools = await self._list_tools(token)
        self._tools = {t["name"]: t for t in tools}
        log.info("erp tools refreshed: %d", len(self._tools))

    def operations(self) -> list[str]:
        return sorted(self._tools)

    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:
        if operation not in self._tools:
            raise UnknownErpOperation(operation)
        token = await self.broker.token_for(self.AUDIENCE, scope, ident)
        result = await self._rpc(
            "tools/call",
            {
                "name": operation,
                "arguments": arguments,
                "_meta": {"business_unit": ident.tenant, "run_id": ident.run_id},
            },
            token,
        )
        if result.get("isError"):
            raise RuntimeError(redact_text(json.dumps(result.get("content", []))))
        return result.get("structuredContent") or result.get("content")
"""Line-item extraction sub-agent.

The parent procurement agent delegates structured extraction to a smaller
model. The child runs under its own instance id, links to its parent in the
audit graph, charges the parent's budget, and gets the extractor tool role.
"""
from __future__ import annotations

import json
import logging
from typing import Any

from opentelemetry import trace

from app import audit
from app.budget import Budget
from app.context_size import measure_context
from app.identity import RunIdentity
from app.redact import redact_for_model
from app.tools import build_registry

log = logging.getLogger(__name__)
tracer = trace.get_tracer("procurement.extractor")

EXTRACTOR_ROLE = "line_item_extractor"
MAX_TURNS = 4

LINE_ITEMS_SCHEMA_KEYS = {"sku", "description", "quantity", "unit_price_cents", "currency"}


class ExtractionFailed(Exception):
    pass


class LineItemExtractor:
    def __init__(self, *, client, settings, deps, system_prompt: str):
        self.client = client
        self.settings = settings
        self.deps = deps
        self.system_prompt = system_prompt

    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:
        budget.check_subagent()
        ident = parent.child(role=EXTRACTOR_ROLE)
        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)
        task = f"Extract every line item from document {doc_id}. Return JSON only."

        with tracer.start_as_current_span("gen_ai.invoke_agent line_item_extractor") as span:
            span.set_attribute("gen_ai.agent.id", ident.agent_instance_id)
            span.set_attribute("procurement.parent_instance_id", parent.agent_instance_id)
            start_node = await audit.record(
                self.deps.pool,
                ident,
                kind="subagent_started",
                payload={
                    "role": EXTRACTOR_ROLE,
                    "doc_id": doc_id,
                    "parent_prompt_ref": format(span.get_span_context().span_id, "016x"),
                    "tools": registry.names(),
                },
            )

            messages: list[dict[str, Any]] = [{"role": "user", "content": task}]
            for _turn in range(MAX_TURNS):
                budget.check_step()
                request = {
                    "model": self.settings.extractor_model_id,
                    "system": self.system_prompt,
                    "messages": messages,
                    "tools": registry.schemas(),
                    "max_tokens": 4096,
                }
                ctx = await measure_context(self.client, request, compacted=False)
                response = await self.client.messages.create(**request)
                budget.charge_model(self.settings.extractor_model_id, response.usage)
                await budget.flush(self.deps.pool)
                ctx = ctx.finalize(response.usage)
                decision = await audit.record(
                    self.deps.pool, ident, kind="model_decision", parent=start_node, context=ctx,
                    payload={"requested_model": request["model"], "served_model": response.model,
                             "stop_reason": response.stop_reason},
                )
                messages.append({"role": "assistant", "content": response.content})
                uses = [b for b in response.content if b.type == "tool_use"]
                if not uses:
                    text = "".join(b.text for b in response.content if b.type == "text")
                    items = _parse_items(text)
                    await audit.record(
                        self.deps.pool, ident, kind="subagent_finished", parent=start_node,
                        payload={"items": len(items)},
                    )
                    return items
                results = []
                for use in uses:
                    budget.check_tool_call()
                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))
                messages.append({"role": "user", "content": results})

        raise ExtractionFailed(f"no result after {MAX_TURNS} turns")


def _parse_items(text: str) -> list[dict[str, Any]]:
    try:
        data = json.loads(text)
    except json.JSONDecodeError as exc:
        raise ExtractionFailed("extractor returned non-JSON output") from exc
    if not isinstance(data, list) or len(data) > 500:
        raise ExtractionFailed("extractor output must be a list of at most 500 items")
    items = []
    for raw in data:
        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:
            raise ExtractionFailed("unexpected line-item fields")
        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})
    return items
"""Procurement agent run loop.

Graph: model turn -> (tool calls -> gate -> integration)* -> model turn ...
Every edge writes an audit node before the next step runs. Budgets are
checked before each model turn and each tool call.
"""
from __future__ import annotations

import hashlib
import logging
from dataclasses import dataclass, field
from typing import Any

from opentelemetry import trace

from app import audit, killswitch
from app.budget import Budget, BudgetExceeded
from app.context_size import ContextMeasure, measure_context
from app.gate import PolicyGate
from app.identity import RunIdentity
from app.redact import redact_for_model
from app.tools import ToolRegistry, build_registry

log = logging.getLogger(__name__)
tracer = trace.get_tracer("procurement.loop")

COMPACT_AFTER_MESSAGES = 40
KEEP_RECENT_MESSAGES = 12


@dataclass
class AgentDeps:
    settings: Any
    pool: Any
    gate: PolicyGate
    erp: Any
    slack: Any
    broker: Any
    extractor: Any = None
    _budgets: dict[str, Budget] = field(default_factory=dict)
    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)

    def current_budget(self, ident: RunIdentity) -> Budget:
        return self._budgets[ident.run_id]

    def current_context(self, ident: RunIdentity) -> ContextMeasure:
        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())

    def erp_scope_for(self, operation: str) -> str:
        scopes = self.settings.policy["erp"]["operation_scopes"]
        return scopes.get(operation, "erp.read")

    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:
        self._contexts[ident.agent_instance_id] = ctx
        proposed = await audit.record(
            self.pool, ident, kind="tool_proposed", parent=parent, context=ctx,
            payload={"tool": use.name, "tool_use_id": use.id, "args": audit.summarize_args(use.input)},
        )
        tool = registry.get(use.name)
        if tool is None:
            await audit.record(
                self.pool, ident, kind="tool_denied", parent=proposed, context=ctx,
                policy_version=self.gate.version, payload={"reason": "tool not in role allowlist"},
            )
            return _error(use.id, f"tool {use.name} is not available to this agent")

        decision = await self.gate.authorize(ident, tool, use.input)
        authz = await audit.record(
            self.pool, ident, kind="authz_decision", parent=proposed, context=ctx,
            policy_version=decision.policy_version, approval_id=decision.approval_id,
            payload={"allow": decision.allow, "reason": decision.reason, "pending": decision.pending},
        )
        if not decision.allow:
            if decision.pending:
                return _error(use.id, f"approval requested ({decision.approval_id}); do not retry until approved")
            return _error(use.id, f"denied: {decision.reason}")

        operation_id = f"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}"
        try:
            with tracer.start_as_current_span(f"execute_tool {use.name}") as span:
                for k, v in ctx.otel_attributes().items():
                    span.set_attribute(k, v)
                output = await tool.invoke(use.input, ident)
        except BudgetExceeded:
            raise
        except Exception as exc:
            await audit.record(
                self.pool, ident, kind="tool_error", parent=authz, context=ctx,
                policy_version=decision.policy_version, approval_id=decision.approval_id,
                operation_id=operation_id,
                payload={"error_type": type(exc).__name__, "error": str(exc)[:500]},
            )
            return _error(use.id, f"{use.name} failed: {type(exc).__name__}")

        await audit.record(
            self.pool, ident, kind="tool_result", parent=authz, context=ctx,
            policy_version=decision.policy_version, approval_id=decision.approval_id,
            operation_id=operation_id,
            payload={"result_sha256": audit.digest(output), "result": output},
        )
        return {"type": "tool_result", "tool_use_id": use.id, "content": redact_for_model(output)}


def _error(tool_use_id: str, message: str) -> dict:
    return {"type": "tool_result", "tool_use_id": tool_use_id, "is_error": True, "content": message}


def _compact(messages: list[dict]) -> tuple[list[dict], bool]:
    if len(messages) <= COMPACT_AFTER_MESSAGES:
        return messages, False
    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]
    while tail and tail[0]["role"] != "assistant":
        tail = tail[1:]
    note = {"role": "user", "content": "[earlier tool exchanges were removed to save space]"}
    return head + [note] + tail, True


class ProcurementAgent:
    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = "procurement"):
        self.client = client
        self.deps = deps
        self.system_prompt = system_prompt
        self.role = role

    async def run(self, ident: RunIdentity, task: str) -> str | None:
        pool = self.deps.pool
        await killswitch.assert_running(pool, ident.tenant)
        budget = Budget.for_run(self.deps.settings.budgets, ident)
        await budget.reserve_run_start(pool)
        self.deps._budgets[ident.run_id] = budget
        registry = build_registry(self.role, ident, self.deps)

        run_node = await audit.record(
            pool, ident, kind="run_started",
            payload={"task_sha256": hashlib.sha256(task.encode()).hexdigest(), "tools": registry.names()},
        )
        messages: list[dict[str, Any]] = [{"role": "user", "content": task}]
        try:
            while True:
                budget.check_step()
                messages, compacted = _compact(messages)
                request = {
                    "model": self.deps.settings.model_id,
                    "system": self.system_prompt,
                    "messages": messages,
                    "tools": registry.schemas(),
                    "max_tokens": 4096,
                }
                ctx = await measure_context(self.client, request, compacted)
                response = await self.client.messages.create(**request)
                budget.charge_model(self.deps.settings.model_id, response.usage)
                await budget.flush(pool)
                ctx = ctx.finalize(response.usage)
                decision = await audit.record(
                    pool, ident, kind="model_decision", parent=run_node, context=ctx,
                    payload={
                        "requested_model": request["model"],
                        "served_model": response.model,
                        "stop_reason": response.stop_reason,
                        "proposed_tools": [b.name for b in response.content if b.type == "tool_use"],
                    },
                )
                messages.append({"role": "assistant", "content": response.content})
                uses = [b for b in response.content if b.type == "tool_use"]
                if not uses:
                    final = "".join(b.text for b in response.content if b.type == "text")
                    await audit.record(pool, ident, kind="run_finished", parent=run_node, context=ctx,
                                       payload={"final_sha256": audit.digest(final)})
                    return final
                results = []
                for use in uses:
                    budget.check_tool_call()
                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))
                messages.append({"role": "user", "content": results})
        except BudgetExceeded as exc:
            await audit.record(
                pool, ident, kind="budget_exceeded", parent=run_node,
                payload={"limit": exc.limit, "used": str(exc.used), "allowed": str(exc.allowed)},
            )
            await self.deps.slack.post(
                channel="#procurement-agent-ops",
                text=f"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.",
            )
            return None
        finally:
            self.deps._budgets.pop(ident.run_id, None)
"""Tool registry.

Each agent role gets the tools listed for it in config/tools.yaml. The model
only sees schemas for those tools, and the loop rejects any call to a name
that is not in the run's registry.
"""
from __future__ import annotations

from dataclasses import dataclass
from functools import lru_cache
from typing import Any, Awaitable, Callable

import yaml

from app.identity import RunIdentity

DEFAULT_ROLE = "procurement"

Invoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]


@dataclass(frozen=True)
class Tool:
    name: str
    description: str
    input_schema: dict[str, Any]
    invoke: Invoke
    target_field: str | None = None

    def target_of(self, args: dict[str, Any]) -> str:
        if self.target_field is None:
            return self.name
        return str(args.get(self.target_field, ""))

    def schema(self) -> dict[str, Any]:
        return {"name": self.name, "description": self.description, "input_schema": self.input_schema}


class ToolRegistry:
    def __init__(self, tools: list[Tool]):
        self._tools = {t.name: t for t in tools}

    def get(self, name: str) -> Tool | None:
        return self._tools.get(name)

    def names(self) -> list[str]:
        return sorted(self._tools)

    def schemas(self) -> list[dict[str, Any]]:
        return [self._tools[n].schema() for n in self.names()]


@lru_cache(maxsize=1)
def _role_tools(path: str) -> dict[str, list[str]]:
    with open(path, "r", encoding="utf-8") as fh:
        cfg = yaml.safe_load(fh)
    return {role: list(spec["tools"].keys()) for role, spec in cfg["roles"].items()}


def build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:
    from app.tools import documents, erp, memory, payments, slack

    available: dict[str, Tool] = {}
    for module in (documents, erp, memory, payments, slack):
        for tool in module.tools(deps):
            available[tool.name] = tool

    roles = _role_tools(str(deps.settings.tools_path))
    allowed = roles.get(role, roles[DEFAULT_ROLE])
    return ToolRegistry([available[name] for name in allowed if name in available])
"""FastAPI entry point for the procurement agent."""
from __future__ import annotations

import asyncio
import hashlib
import hmac
import json
import logging
import time
import uuid
from contextlib import asynccontextmanager
from pathlib import Path
from urllib.parse import parse_qs

import asyncpg
import jwt
from anthropic import AsyncAnthropic
from fastapi import Depends, FastAPI, HTTPException, Request
from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer
from opentelemetry import trace
from pydantic import BaseModel, Field

from app import audit, ingest
from app.approvals import ApprovalStore, ApproverNotAuthorized
from app.extractor import LineItemExtractor
from app.gate import PolicyGate
from app.identity import RunIdentity, TokenBroker, new_instance_id
from app.loop import AgentDeps, ProcurementAgent
from app.mcp_client import ErpMcpClient
from app.redact import RedactingFilter
from app.settings import get_settings
from app.startup import startup_checks
from app.tools.slack import SlackClient

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(name)s %(message)s")
for handler in logging.getLogger().handlers:
    handler.addFilter(RedactingFilter())
log = logging.getLogger("procurement")

AGENT_PRINCIPAL = "spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent"
bearer = HTTPBearer()


class RunRequest(BaseModel):
    task: str = Field(min_length=1, max_length=4000)
    department: str = Field(min_length=1, max_length=64)


class Principal(BaseModel):
    subject: str
    business_unit: str


def service_identity(settings, agent_type_id: str, tenant: str = "system") -> RunIdentity:
    return RunIdentity(
        accountable_party="system:procurement-agent",
        operational_owner=settings.operational_owner,
        tenant=tenant,
        agent_type_id=agent_type_id,
        agent_instance_id=new_instance_id(),
        trace_id=uuid.uuid4().hex,
        run_id=f"bg-{uuid.uuid4()}",
        delegated_subject="system:procurement-agent",
        agent_principal=AGENT_PRINCIPAL,
    )


async def expire_approvals_forever(app: FastAPI) -> None:
    while True:
        await asyncio.sleep(60)
        ident = service_identity(app.state.settings, app.state.agent_type_id)
        count = await app.state.pool.fetchval(
            "WITH e AS (UPDATE approvals SET status = 'expired' "
            "WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e"
        )
        await audit.record(app.state.pool, ident, kind="background_job",
                           payload={"job": "expire_approvals", "expired": count})


@asynccontextmanager
async def lifespan(app: FastAPI):
    settings = get_settings()
    agent_type_id = startup_checks(settings)
    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)
    broker = TokenBroker(settings)

    async def slack_token() -> str:
        return await broker.token_for("slack-proxy", "chat:write", service_identity(settings, agent_type_id))

    slack = SlackClient(settings.slack_api_url, slack_token)
    approvals = ApprovalStore(pool, settings.policy, slack)
    gate = PolicyGate(settings.policy, approvals)
    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest["tool_pins"], broker)
    await erp.initialize(service_identity(settings, agent_type_id))

    client = AsyncAnthropic()
    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)
    deps.extractor = LineItemExtractor(
        client=client, settings=settings, deps=deps,
        system_prompt=(settings.prompt_dir / "extractor.md").read_text(),
    )
    app.state.settings = settings
    app.state.pool = pool
    app.state.agent_type_id = agent_type_id
    app.state.approvals = approvals
    app.state.agent = ProcurementAgent(
        client=client, deps=deps, system_prompt=(settings.prompt_dir / "system.md").read_text()
    )
    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)
    sweeper = asyncio.create_task(expire_approvals_forever(app))
    try:
        yield
    finally:
        sweeper.cancel()
        await pool.close()


app = FastAPI(lifespan=lifespan)
app.include_router(ingest.router)


def authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:
    settings = request.app.state.settings
    try:
        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)
        claims = jwt.decode(
            creds.credentials,
            key.key,
            algorithms=["RS256", "ES256"],
            audience=settings.oidc_audience,
            issuer=settings.oidc_issuer,
            options={"require": ["exp", "iat", "sub", "aud", "iss"]},
        )
    except jwt.PyJWTError as exc:
        raise HTTPException(401, "invalid token") from exc
    bu = claims.get("bu")
    if not bu:
        raise HTTPException(403, "token has no business unit")
    return Principal(subject=claims["sub"], business_unit=bu)


@app.post("/runs")
async def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:
    settings = request.app.state.settings
    span_ctx = trace.get_current_span().get_span_context()
    trace_id = format(span_ctx.trace_id, "032x") if span_ctx.is_valid else uuid.uuid4().hex
    ident = RunIdentity(
        accountable_party=principal.subject,
        operational_owner=settings.operational_owner,
        tenant=principal.business_unit,
        agent_type_id=request.app.state.agent_type_id,
        agent_instance_id=new_instance_id(),
        trace_id=trace_id,
        run_id=f"run-{uuid.uuid4()}",
        delegated_subject=principal.subject,
        agent_principal=AGENT_PRINCIPAL,
    )
    task = f"Department: {req.department}\n\n{req.task}"
    asyncio.create_task(request.app.state.agent.run(ident, task))
    return {"run_id": ident.run_id, "agent_instance_id": ident.agent_instance_id}


@app.post("/slack/interactions")
async def slack_interactions(request: Request) -> dict:
    body = await request.body()
    timestamp = request.headers.get("X-Slack-Request-Timestamp", "0")
    if abs(time.time() - int(timestamp)) > 300:
        raise HTTPException(401, "stale request")
    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()
    expected = "v0=" + hmac.new(secret, f"v0:{timestamp}:".encode() + body, hashlib.sha256).hexdigest()
    if not hmac.compare_digest(expected, request.headers.get("X-Slack-Signature", "")):
        raise HTTPException(401, "bad signature")

    payload = json.loads(parse_qs(body.decode())["payload"][0])
    action = payload["actions"][0]
    slack_user = payload["user"]["id"]
    row = await request.app.state.pool.fetchrow(
        "SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active", slack_user
    )
    if row is None:
        raise HTTPException(403, "not an approver")
    try:
        await request.app.state.approvals.decide(
            action["value"], approver=row["email"], approver_role=row["role"],
            approve=action["action_id"] == "approve",
        )
    except ApproverNotAuthorized as exc:
        raise HTTPException(403, str(exc)) from exc
    except ValueError as exc:
        raise HTTPException(409, str(exc)) from exc
    return {"ok": True}


@app.get("/healthz")
async def healthz() -> dict:
    return {"ok": True}
version: "proc-policy-2026.09.3"

# Operations that change money, vendor records, or purchase commitments.
# Denied unless a valid approval exists for the operation and its target.
high_impact_tools:
  - create_purchase_order
  - pay_invoice

erp:
  # Namespaces the agent may reach through the generic erp_call tool.
  read_prefixes:
    - "budget."
    - "vendor."
    - "invoice."
    - "po.get"
    - "po.list"
  # Scope requested from the STS for each ERP operation; the ERP enforces it.
  operation_scopes:
    budget.get_remaining: "erp.read"
    vendor.get: "erp.read"
    vendor.search: "erp.read"
    vendor.update_remit_to: "erp.read erp.vendor.write"
    invoice.get: "erp.read"
    invoice.list_open: "erp.read"
    invoice.mark_paid: "erp.read erp.invoice.write"
    invoice.void: "erp.read erp.invoice.write"
    po.get: "erp.read"
    po.list_open: "erp.read"
    po.create: "erp.read erp.po.create"

approvals:
  ttl_minutes: 60
  approver_roles:
    pay_invoice: [ap_manager, finance_controller]
    create_purchase_order: [budget_owner, finance_controller]
    post_slack_message: [procurement_lead]

budgets:
  per_run:
    max_steps: 25
    max_wall_seconds: 300
    max_tokens: 400000
    max_cost_usd: 4.00
    max_tool_calls_per_minute: 30
    max_subagents: 3
  quotas_daily_usd:
