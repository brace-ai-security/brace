    68	async def expire_approvals_forever(app: FastAPI) -> None:
    69	    while True:
    70	        await asyncio.sleep(60)
    71	        ident = service_identity(app.state.settings, app.state.agent_type_id)
    72	        count = await app.state.pool.fetchval(
    73	            "WITH e AS (UPDATE approvals SET status = 'expired' "
    74	            "WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e"
    75	        )
    76	        await audit.record(app.state.pool, ident, kind="background_job",
    77	                           payload={"job": "expire_approvals", "expired": count})
    78	
    79	
    80	@asynccontextmanager
    81	async def lifespan(app: FastAPI):
    82	    settings = get_settings()
    83	    agent_type_id = startup_checks(settings)
    84	    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)
    85	    broker = TokenBroker(settings)
    86	
    87	    async def slack_token() -> str:
    88	        return await broker.token_for("slack-proxy", "chat:write", service_identity(settings, agent_type_id))
    89	
    90	    slack = SlackClient(settings.slack_api_url, slack_token)
    91	    approvals = ApprovalStore(pool, settings.policy, slack)
    92	    gate = PolicyGate(settings.policy, approvals)
    93	    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest["tool_pins"], broker)
    94	    await erp.initialize(service_identity(settings, agent_type_id))
    95	
    96	    client = AsyncAnthropic()
    97	    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)
    98	    deps.extractor = LineItemExtractor(
    99	        client=client, settings=settings, deps=deps,
   100	        system_prompt=(settings.prompt_dir / "extractor.md").read_text(),
   101	    )
   102	    app.state.settings = settings
   103	    app.state.pool = pool
   104	    app.state.agent_type_id = agent_type_id
   105	    app.state.approvals = approvals
   106	    app.state.agent = ProcurementAgent(
   107	        client=client, deps=deps, system_prompt=(settings.prompt_dir / "system.md").read_text()
   108	    )
   109	    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)
   110	    sweeper = asyncio.create_task(expire_approvals_forever(app))
   111	    try:
   112	        yield
   113	    finally:
   114	        sweeper.cancel()
   115	        await pool.close()
   116	
   117	
   118	app = FastAPI(lifespan=lifespan)
   119	app.include_router(ingest.router)
