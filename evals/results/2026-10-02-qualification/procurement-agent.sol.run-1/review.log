     2	from __future__ import annotations
     3	
     4	import hashlib
     5	from typing import Any
     6	
     7	import httpx
     8	
     9	from app.identity import RunIdentity
    10	from app.tools import Tool
    11	
    12	PAYMENTS_AUDIENCE = "payments-api"
    13	PAYMENTS_SCOPE = "payments.create"
    14	
    15	
    16	def idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:
    17	    raw = "|".join(
    18	        [ident.tenant, args["invoice_id"], args["payee_account_id"], str(args["amount_cents"]), args["currency"]]
    19	    )
    20	    return "proc-" + hashlib.sha256(raw.encode("utf-8")).hexdigest()[:48]
    21	
    22	
    23	def tools(deps) -> list[Tool]:
    24	    settings = deps.settings
    25	
    26	    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:
    27	        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)
    28	        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:
    29	            resp = await client.post(
    30	                f"{settings.payments_api_url}/v2/payments",
    31	                headers={
    32	                    "Authorization": f"Bearer {token}",
    33	                    "Idempotency-Key": idempotency_key(ident, args),
    34	                },
    35	                json={
    36	                    "business_unit": ident.tenant,
    37	                    "invoice_reference": args["invoice_id"],
    38	                    "payee_account_id": args["payee_account_id"],
    39	                    "amount": {"value": args["amount_cents"], "currency": args["currency"]},
    40	                    "memo": args.get("memo", "")[:140],
    41	                },
    42	            )
    43	        resp.raise_for_status()
    44	        body = resp.json()
    45	        return {"payment_id": body["id"], "status": body["status"]}
    46	
    47	    return [
    48	        Tool(
    49	            name="pay_invoice",
    50	            description="Pay a vendor invoice that has been matched to a purchase order.",
    51	            input_schema={
    52	                "type": "object",
    53	                "properties": {
    54	                    "invoice_id": {"type": "string", "maxLength": 32},
    55	                    "payee_account_id": {"type": "string", "maxLength": 32},
    56	                    "amount_cents": {"type": "integer", "minimum": 1},
    57	                    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    58	                    "memo": {"type": "string", "maxLength": 140},
    59	                },
