    79	                note_id, business_unit, department, kind, body,
    80	                verified, quarantined, expires_at,
    81	                writer_instance, writer_type_id, run_id, source_doc_id,
    82	                delegated_subject, context_tokens, context_method, created_at
    83	            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',
    84	                      $6, $7, $8, $9, $10, $11, $12, now())
    85	            """,
