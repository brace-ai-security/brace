     1	"""Per-department notes kept between runs (Postgres ``dept_notes``).
     2	
     3	Writes are restricted to a fixed set of note kinds, length-limited, checked
     4	for instruction-like content, and stored as unverified with a 30-day expiry
     5	until a procurement lead verifies them in the admin UI. Every row records
     6	who wrote it, from which run and source document, and the context size at
     7	the time.
     8	"""
     9	from __future__ import annotations
    10	
    11	import re
    12	import uuid
    13	from typing import Any
    14	
    15	from app.identity import RunIdentity
    16	from app.tools import Tool
    17	
    18	NOTE_KINDS = ("vendor_preference", "contract_term", "budget_note", "contact")
    19	MAX_NOTE_CHARS = 800
    20	INSTRUCTION_LIKE = [
    21	    re.compile(r"(?i)\b(ignore|disregard|override)\b.{0,40}\b(instruction|policy|approval|rule)s?\b"),
    22	    re.compile(r"(?i)\b(always|never|must)\b.{0,40}\b(approve|pay|skip|send|transfer)\b"),
    23	    re.compile(r"(?i)\b(system prompt|you are|assistant:)\b"),
    24	    re.compile(r"https?://"),
    25	]
    26	
    27	
    28	class NoteRejected(Exception):
    29	    pass
    30	
    31	
    32	def check_note(text: str) -> None:
    33	    if len(text) > MAX_NOTE_CHARS:
    34	        raise NoteRejected("note too long")
    35	    for pattern in INSTRUCTION_LIKE:
    36	        if pattern.search(text):
    37	            raise NoteRejected("note looks like an instruction")
    38	
    39	
    40	def tools(deps) -> list[Tool]:
    41	    pool = deps.pool
