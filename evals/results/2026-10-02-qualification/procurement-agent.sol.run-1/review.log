    63	def compute_agent_type_id(manifest: dict) -> str:
    64	    """Content-derived agent type id over the frozen release manifest."""
    65	    material = {
    66	        "image_digest": manifest["image"]["digest"],
    67	        "harness_digest": manifest["harness"]["digest"],
    68	        "system_prompt": manifest["prompts"]["system"]["path"],
    69	        "extractor_prompt": manifest["prompts"]["extractor"]["path"],
    70	        "models": manifest["models"],
    71	        "config": manifest["config"],
    72	        "tools": manifest["tool_pins"],
    73	    }
    74	    canonical = json.dumps(material, sort_keys=True, separators=(",", ":"))
