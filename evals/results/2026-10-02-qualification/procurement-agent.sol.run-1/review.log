     1	from pathlib import Path
     2	
     3	import pytest
     4	import yaml
     5	
     6	from app.gate import PolicyGate
     7	from app.ingest import Inbound, Rejected, validate
     8	from app.tools import Tool
     9	from test_budget import ident
    10	
    11	POLICY = yaml.safe_load((Path(__file__).parents[1] / "config" / "policy.yaml").read_text())
    12	FIXTURES = Path(__file__).parent / "fixtures"
    13	
    14	
    15	class FakeApprovals:
    16	    def __init__(self, approved: set[tuple[str, str]] | None = None):
    17	        self.approved = approved or set()
    18	        self.requested: list[tuple[str, str]] = []
    19	
    20	    async def find_valid(self, ident, tool, target):
    21	        if (tool, target) in self.approved:
    22	            return type("A", (), {"id": f"apr-{tool}-{target}"})()
    23	        return None
    24	
    25	    async def request(self, ident, tool, target, args):
    26	        self.requested.append((tool, target))
    27	        return f"apr-new-{tool}"
    28	
    29	
    30	async def _noop(args, ident):
    31	    return None
    32	
    33	
    34	def tool(name: str, target_field: str | None = None) -> Tool:
    35	    return Tool(name=name, description="", input_schema={}, invoke=_noop, target_field=target_field)
    36	
    37	
    38	async def test_payment_requires_approval():
    39	    approvals = FakeApprovals()
    40	    gate = PolicyGate(POLICY, approvals)
    41	    d = await gate.authorize(ident(), tool("pay_invoice", "invoice_id"), {"invoice_id": "INV-1", "amount_cents": 100})
    42	    assert not d.allow and d.pending
    43	    assert approvals.requested == [("pay_invoice", "INV-1")]
    44	    assert d.policy_version == POLICY["version"]
    45	
    46	
    47	async def test_payment_with_approval_is_allowed():
    48	    gate = PolicyGate(POLICY, FakeApprovals({("pay_invoice", "INV-1")}))
    49	    d = await gate.authorize(ident(), tool("pay_invoice", "invoice_id"), {"invoice_id": "INV-1", "amount_cents": 100})
    50	    assert d.allow and d.approval_id == "apr-pay_invoice-INV-1"
    51	
    52	
    53	async def test_purchase_order_requires_approval():
    54	    gate = PolicyGate(POLICY, FakeApprovals())
    55	    d = await gate.authorize(ident(), tool("create_purchase_order", "source_doc_id"), {"source_doc_id": "doc-1"})
    56	    assert not d.allow
    57	
    58	
    59	@pytest.mark.parametrize("operation", ["po.create", "po.cancel", "payment_run.release", "admin.users"])
    60	async def test_erp_write_operations_denied(operation):
    61	    gate = PolicyGate(POLICY, FakeApprovals())
    62	    d = await gate.authorize(ident(), tool("erp_call"), {"operation": operation})
    63	    assert not d.allow
    64	
    65	
    66	async def test_erp_reads_allowed():
