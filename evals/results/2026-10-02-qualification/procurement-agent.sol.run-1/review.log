    71	
    72	async def test_vendor_message_requires_approval():
    73	    gate = PolicyGate(POLICY, FakeApprovals())
    74	    d = await gate.authorize(
    75	        ident(), tool("post_slack_message", "channel"),
    76	        {"channel": "#vendor-V1009", "text": "PO attached", "external": True},
    77	    )
