    43	    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:
    44	        business_unit = args.get("business_unit") or ident.tenant
    45	        rows = await pool.fetch(
    46	            """
    47	            SELECT note_id, kind, body, verified, writer_instance, created_at
    48	            FROM dept_notes
    49	            WHERE business_unit = $1
    50	              AND department = $2
    51	              AND NOT quarantined
    52	              AND (verified OR expires_at > now())
    53	            ORDER BY created_at DESC
    54	            LIMIT 20
    55	            """,
    56	            business_unit,
    57	            args["department"],
    58	        )
    59	        return [
    60	            {
    61	                "note_id": r["note_id"],
    62	                "kind": r["kind"],
    63	                "body": r["body"],
    64	                "trust": "verified" if r["verified"] else "unverified",
    65	                "written": r["created_at"].isoformat(),
    66	            }
    67	            for r in rows
    68	        ]
    69	
    70	    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:
    71	        if args["kind"] not in NOTE_KINDS:
    72	            raise NoteRejected(f"unknown note kind {args['kind']}")
    73	        check_note(args["body"])
    74	        note_id = f"note-{uuid.uuid4()}"
    75	        ctx = deps.current_context(ident)
    76	        await pool.execute(
    77	            """
