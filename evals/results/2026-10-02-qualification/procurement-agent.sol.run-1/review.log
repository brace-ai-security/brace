     9	erp:
    10	  # Namespaces the agent may reach through the generic erp_call tool.
    11	  read_prefixes:
    12	    - "budget."
    13	    - "vendor."
    14	    - "invoice."
    15	    - "po.get"
    16	    - "po.list"
