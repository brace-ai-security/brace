    91	
    92	class FakeConn:
    93	    def __init__(self, store):
    94	        self.store = store
    95	
    96	    def transaction(self):
    97	        return self
    98	
    99	    async def __aenter__(self):
   100	        return self
   101	
   102	    async def __aexit__(self, *exc):
   103	        return False
   104	
   105	    async def fetchval(self, sql, scope, key, *rest):
   106	        amount = rest[0] if rest else 1
   107	        k = (scope, key, "spend" if rest else "starts")
   108	        self.store[k] = self.store.get(k, 0) + amount
   109	        return self.store[k]
   110	
   111	
   112	class FakePool:
   113	    def __init__(self):
   114	        self.store = {}
   115	
   116	    def acquire(self):
   117	        return FakeConn(self.store)
   118	
   119	
   120	async def test_run_start_quota_per_user():
   121	    pool = FakePool()
   122	    await Budget.for_run(CFG, ident()).reserve_run_start(pool)
   123	    with pytest.raises(BudgetExceeded) as exc:
   124	        await Budget.for_run(CFG, ident()).reserve_run_start(pool)
   125	    assert exc.value.limit == "run_starts_per_minute.user"
   126	
   127	
   128	async def test_daily_spend_quota_per_tenant_and_fleet():
   129	    pool = FakePool()
   130	    pool.store[("user", "user:alice@example-corp.test", "spend")] = Decimal("0")
   131	    pool.store[("tenant", "bu-emea", "spend")] = Decimal("1.999")
   132	    b = Budget.for_run(CFG, ident())
   133	    b.unflushed_cost_usd = Decimal("0.01")
   134	    with pytest.raises(BudgetExceeded) as exc:
   135	        await b.flush(pool)
   136	    assert exc.value.limit == "quota_daily_usd.tenant"
   137	
   138	    pool.store[("tenant", "bu-emea", "spend")] = Decimal("0")
   139	    pool.store[("fleet", "all", "spend")] = Decimal("2.995")
   140	    b2 = Budget.for_run(CFG, ident())
   141	    b2.unflushed_cost_usd = Decimal("0.01")
   142	    with pytest.raises(BudgetExceeded) as exc:
   143	        await b2.flush(pool)
   144	    assert exc.value.limit == "quota_daily_usd.fleet"
