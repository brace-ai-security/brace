     1	from decimal import Decimal
     2	from types import SimpleNamespace
     3	
     4	import pytest
     5	
     6	from app.budget import Budget, BudgetExceeded
     7	from app.identity import RunIdentity
     8	
     9	CFG = {
    10	    "per_run": {
    11	        "max_steps": 3,
    12	        "max_wall_seconds": 5,
    13	        "max_tokens": 1000,
    14	        "max_cost_usd": 0.01,
    15	        "max_tool_calls_per_minute": 2,
    16	        "max_subagents": 1,
    17	    },
    18	    "quotas_daily_usd": {"user": 1, "tenant": 2, "fleet": 3},
    19	    "run_starts_per_minute": {"user": 1, "tenant": 2, "fleet": 3},
    20	}
    21	
    22	
    23	def ident() -> RunIdentity:
    24	    return RunIdentity(
    25	        accountable_party="user:alice@example-corp.test",
    26	        operational_owner="team-procurement-platform",
    27	        tenant="bu-emea",
    28	        agent_type_id="atid-test",
    29	        agent_instance_id="inst-test",
    30	        trace_id="0" * 32,
    31	        run_id="run-test",
    32	        delegated_subject="user:alice@example-corp.test",
    33	        agent_principal="spiffe://example-corp.test/ns/test/sa/procurement-agent",
    34	    )
    35	
    36	
    37	def usage(inp: int, out: int) -> SimpleNamespace:
    38	    return SimpleNamespace(input_tokens=inp, output_tokens=out,
    39	                           cache_read_input_tokens=0, cache_creation_input_tokens=0)
    40	
    41	
    42	def test_step_limit():
    43	    b = Budget.for_run(CFG, ident())
    44	    for _ in range(3):
    45	        b.check_step()
    46	    with pytest.raises(BudgetExceeded) as exc:
    47	        b.check_step()
    48	    assert exc.value.limit == "max_steps"
    49	
    50	
    51	def test_wall_clock_limit():
    52	    b = Budget.for_run(CFG, ident())
    53	    b.started_at -= 10
    54	    with pytest.raises(BudgetExceeded) as exc:
    55	        b.check_step()
    56	    assert exc.value.limit == "max_wall_seconds"
    57	
    58	
    59	def test_token_limit():
    60	    b = Budget.for_run({**CFG, "per_run": {**CFG["per_run"], "max_cost_usd": 100}}, ident())
    61	    with pytest.raises(BudgetExceeded) as exc:
    62	        b.charge_model("claude-haiku-4-5-20251001", usage(900, 200))
    63	    assert exc.value.limit == "max_tokens"
    64	
    65	
    66	def test_cost_limit():
    67	    b = Budget.for_run({**CFG, "per_run": {**CFG["per_run"], "max_tokens": 10_000_000}}, ident())
    68	    with pytest.raises(BudgetExceeded) as exc:
    69	        b.charge_model("claude-sonnet-4-5-20250929", usage(1000, 1000))
    70	    assert exc.value.limit == "max_cost_usd"
    71	    assert b.cost_usd > Decimal("0.01")
    72	
    73	
    74	def test_tool_call_rate_limit():
