   122	def authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:
   123	    settings = request.app.state.settings
   124	    try:
   125	        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)
   126	        claims = jwt.decode(
   127	            creds.credentials,
   128	            key.key,
   129	            algorithms=["RS256", "ES256"],
   130	            audience=settings.oidc_audience,
   131	            issuer=settings.oidc_issuer,
   132	            options={"require": ["exp", "iat", "sub", "aud", "iss"]},
   133	        )
   134	    except jwt.PyJWTError as exc:
   135	        raise HTTPException(401, "invalid token") from exc
   136	    bu = claims.get("bu")
   137	    if not bu:
   138	        raise HTTPException(403, "token has no business unit")
   139	    return Principal(subject=claims["sub"], business_unit=bu)
   140	
   141	
   142	@app.post("/runs")
   143	async def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:
   144	    settings = request.app.state.settings
   145	    span_ctx = trace.get_current_span().get_span_context()
   146	    trace_id = format(span_ctx.trace_id, "032x") if span_ctx.is_valid else uuid.uuid4().hex
   147	    ident = RunIdentity(
   148	        accountable_party=principal.subject,
   149	        operational_owner=settings.operational_owner,
   150	        tenant=principal.business_unit,
   151	        agent_type_id=request.app.state.agent_type_id,
   152	        agent_instance_id=new_instance_id(),
   153	        trace_id=trace_id,
   154	        run_id=f"run-{uuid.uuid4()}",
   155	        delegated_subject=principal.subject,
   156	        agent_principal=AGENT_PRINCIPAL,
   157	    )
   158	    task = f"Department: {req.department}\n\n{req.task}"
   159	    asyncio.create_task(request.app.state.agent.run(ident, task))
   160	    return {"run_id": ident.run_id, "agent_instance_id": ident.agent_instance_id}
   161	
   162	
   163	@app.post("/slack/interactions")
   164	async def slack_interactions(request: Request) -> dict:
   165	    body = await request.body()
   166	    timestamp = request.headers.get("X-Slack-Request-Timestamp", "0")
   167	    if abs(time.time() - int(timestamp)) > 300:
   168	        raise HTTPException(401, "stale request")
   169	    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()
   170	    expected = "v0=" + hmac.new(secret, f"v0:{timestamp}:".encode() + body, hashlib.sha256).hexdigest()
   171	    if not hmac.compare_digest(expected, request.headers.get("X-Slack-Signature", "")):
   172	        raise HTTPException(401, "bad signature")
   173	
   174	    payload = json.loads(parse_qs(body.decode())["payload"][0])
   175	    action = payload["actions"][0]
   176	    slack_user = payload["user"]["id"]
   177	    row = await request.app.state.pool.fetchrow(
   178	        "SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active", slack_user
   179	    )
   180	    if row is None:
   181	        raise HTTPException(403, "not an approver")
   182	    try:
   183	        await request.app.state.approvals.decide(
   184	            action["value"], approver=row["email"], approver_role=row["role"],
   185	            approve=action["action_id"] == "approve",
   186	        )
   187	    except ApproverNotAuthorized as exc:
   188	        raise HTTPException(403, str(exc)) from exc
   189	    except ValueError as exc:
   190	        raise HTTPException(409, str(exc)) from exc
   191	    return {"ok": True}
   192	
   193	
   194	@app.get("/healthz")
   195	async def healthz() -> dict:
   196	    return {"ok": True}
agent/app/identity.py
     1	"""Agent identity: who is acting, for whom, and as which agent type.
     2	
     3	The agent runs under its own Kubernetes service account. Its projected
     4	service-account token is exchanged at the internal STS for short-lived,
     5	audience-bound tokens. The launching user's token is never forwarded to an
     6	integration; the user is carried as the delegated subject of the exchange.
     7	"""
     8	from __future__ import annotations
     9	
    10	import hashlib
    11	import json
    12	import time
    13	import uuid
    14	from dataclasses import dataclass, field, replace
    15	from pathlib import Path
    16	
    17	import httpx
    18	
    19	from app.settings import Settings
    20	
    21	IDENTITY_FIELDS = (
    22	    "accountable_party",
    23	    "operational_owner",
    24	    "tenant",
    25	    "agent_type_id",
    26	    "agent_instance_id",
    27	    "trace_id",
    28	)
    29	
    30	
    31	@dataclass(frozen=True)
    32	class RunIdentity:
    33	    accountable_party: str
    34	    operational_owner: str
    35	    tenant: str
    36	    agent_type_id: str
    37	    agent_instance_id: str
    38	    trace_id: str
    39	    run_id: str
    40	    delegated_subject: str
    41	    agent_principal: str
    42	    parent_instance_id: str | None = None
    43	    role: str = "procurement"
    44	
    45	    def __post_init__(self) -> None:
    46	        for name in IDENTITY_FIELDS:
    47	            if not getattr(self, name):
    48	                raise ValueError(f"identity field {name} is empty")
    49	
    50	    def child(self, role: str) -> "RunIdentity":
    51	        return replace(
    52	            self,
    53	            agent_instance_id=f"inst-{uuid.uuid4()}",
    54	            parent_instance_id=self.agent_instance_id,
    55	            role=role,
    56	        )
    57	
    58	
    59	def new_instance_id() -> str:
    60	    return f"inst-{uuid.uuid4()}"
    61	
    62	
    63	def compute_agent_type_id(manifest: dict) -> str:
    64	    """Content-derived agent type id over the frozen release manifest."""
    65	    material = {
    66	        "image_digest": manifest["image"]["digest"],
    67	        "harness_digest": manifest["harness"]["digest"],
    68	        "system_prompt": manifest["prompts"]["system"]["path"],
    69	        "extractor_prompt": manifest["prompts"]["extractor"]["path"],
    70	        "models": manifest["models"],
    71	        "config": manifest["config"],
    72	        "tools": manifest["tool_pins"],
    73	    }
    74	    canonical = json.dumps(material, sort_keys=True, separators=(",", ":"))
    75	    return "atid-" + hashlib.sha256(canonical.encode("utf-8")).hexdigest()[:40]
    76	
    77	
    78	@dataclass
    79	class _CachedToken:
    80	    value: str
    81	    expires_at: float
    82	
    83	
    84	@dataclass
    85	class TokenBroker:
    86	    """Exchanges the workload token for audience-bound access tokens."""
    87	
    88	    settings: Settings
    89	    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)
    90	
    91	    def _workload_token(self) -> str:
    92	        return Path(self.settings.workload_token_path).read_text().strip()
    93	
    94	    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:
    95	        key = (audience, scope, ident.tenant)
    96	        cached = self._cache.get(key)
    97	        if cached and cached.expires_at - 30 > time.time():
    98	            return cached.value
    99	        async with httpx.AsyncClient(timeout=5.0) as client:
   100	            resp = await client.post(
   101	                self.settings.sts_url,
   102	                data={
   103	                    "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
   104	                    "subject_token": self._workload_token(),
   105	                    "subject_token_type": "urn:ietf:params:oauth:token-type:jwt",
   106	                    "audience": audience,
   107	                    "scope": scope,
   108	                    "resource": f"urn:bu:{ident.tenant}",
   109	                    "actor_token": ident.delegated_subject,
   110	                    "actor_token_type": "urn:example:params:subject-id",
   111	                },
   112	            )
   113	            resp.raise_for_status()
   114	            body = resp.json()
   115	        token = _CachedToken(body["access_token"], time.time() + int(body["expires_in"]))
   116	        self._cache[key] = token
   117	        return token.value
