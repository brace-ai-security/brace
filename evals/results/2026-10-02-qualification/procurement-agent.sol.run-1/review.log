    12	
    13	def tools(deps) -> list[Tool]:
    14	    erp = deps.erp
    15	
    16	    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:
    17	        return await erp.call(
    18	            "budget.get_remaining",
