    76	    b.check_tool_call(now=100.0)
    77	    b.check_tool_call(now=101.0)
    78	    with pytest.raises(BudgetExceeded) as exc:
    79	        b.check_tool_call(now=102.0)
    80	    assert exc.value.limit == "max_tool_calls_per_minute"
    81	    b.check_tool_call(now=170.0)
