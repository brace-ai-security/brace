    23	    invoice.get: "erp.read"
    24	    invoice.list_open: "erp.read"
    25	    invoice.mark_paid: "erp.read erp.invoice.write"
    26	    invoice.void: "erp.read erp.invoice.write"
    27	    po.get: "erp.read"
