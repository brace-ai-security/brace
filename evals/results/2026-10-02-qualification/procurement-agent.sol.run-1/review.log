agent/app/context_size.py
     1	"""Decision-time context size.
     2	
     3	Counting method (documented in README, "Context size"):
     4	
     5	1. Before each model call, the exact request (system prompt, messages and
     6	   tool schemas) is sent to the provider's token-counting endpoint. The
     7	   returned ``input_tokens`` is recorded with method ``count_tokens_api``.
     8	   This is the size of the context the model decides on, including any
     9	   prefix that will be served from the prompt cache.
    10	2. If counting fails, the value is taken after the call from the response
    11	   usage as ``input_tokens + cache_read_input_tokens +
    12	   cache_creation_input_tokens`` and recorded with method
    13	   ``usage_sum_estimate``.
    14	3. If neither is available the value is ``NULL`` with method
    15	   ``unavailable``. It is never recorded as zero.
    16	
    17	``compacted`` is true when the harness dropped or summarized earlier turns
    18	before this call. Provider-side truncation is not visible to the harness and
    19	is listed as a known limit.
    20	"""
    21	from __future__ import annotations
    22	
    23	import logging
    24	from dataclasses import dataclass, replace
    25	
    26	log = logging.getLogger(__name__)
    27	
    28	
    29	@dataclass(frozen=True)
    30	class ContextMeasure:
    31	    tokens: int | None
    32	    method: str
    33	    compacted: bool
    34	
    35	    @classmethod
    36	    def unavailable(cls, compacted: bool = False) -> "ContextMeasure":
    37	        return cls(tokens=None, method="unavailable", compacted=compacted)
    38	
    39	    def finalize(self, usage) -> "ContextMeasure":
    40	        if self.tokens is not None:
    41	            return self
    42	        if usage is None:
    43	            return ContextMeasure.unavailable(self.compacted)
    44	        total = (
    45	            int(usage.input_tokens or 0)
    46	            + int(getattr(usage, "cache_read_input_tokens", 0) or 0)
    47	            + int(getattr(usage, "cache_creation_input_tokens", 0) or 0)
    48	        )
    49	        if total <= 0:
    50	            return ContextMeasure.unavailable(self.compacted)
    51	        return replace(self, tokens=total, method="usage_sum_estimate")
    52	
    53	    def otel_attributes(self) -> dict:
    54	        attrs = {
    55	            "procurement.context.method": self.method,
    56	            "gen_ai.conversation.compacted": self.compacted,
    57	        }
    58	        if self.tokens is not None:
    59	            attrs["procurement.context.tokens"] = self.tokens
    60	        return attrs
    61	
    62	
    63	async def measure_context(client, request: dict, compacted: bool) -> ContextMeasure:
    64	    try:
    65	        counted = await client.messages.count_tokens(
    66	            model=request["model"],
    67	            system=request["system"],
    68	            messages=request["messages"],
    69	            tools=request["tools"],
    70	        )
    71	        return ContextMeasure(int(counted.input_tokens), "count_tokens_api", compacted)
    72	    except Exception:  # counting is best effort; finalize() falls back to usage
    73	        log.warning("token count failed; falling back to usage", exc_info=True)
    74	        return ContextMeasure(tokens=None, method="pending_usage", compacted=compacted)
agent/app/mcp_client.py
     1	"""Client for the ERP MCP server, reached through the internal MCP gateway.
     2	
     3	On startup the tool list is fetched and each tool's description and input
     4	schema are fingerprinted and compared with the pins in the release manifest.
     5	Any unpinned or changed tool stops startup. Tool metadata is also scanned for
     6	instruction-like content before any of it is shown to the model.
     7	"""
     8	from __future__ import annotations
     9	
    10	import hashlib
    11	import json
    12	import logging
    13	import re
    14	import uuid
    15	from typing import Any
    16	
    17	import httpx
    18	
    19	from app.identity import RunIdentity, TokenBroker
    20	from app.redact import redact_text
    21	
    22	log = logging.getLogger(__name__)
    23	
    24	MAX_DESCRIPTION_CHARS = 1024
    25	SUSPICIOUS_METADATA = [
    26	    re.compile(r"(?i)ignore (all|any|previous|prior) instructions"),
    27	    re.compile(r"(?i)\b(system prompt|you are now|act as)\b"),
    28	    re.compile(r"(?i)\b(before|instead of) (calling|using) \w+\.\w+"),
    29	    re.compile(r"[​-‏‪-‮⁠-⁤]"),
    30	    re.compile(r"[A-Za-z0-9+/]{120,}={0,2}"),
    31	]
    32	
    33	
    34	class ToolPinMismatch(Exception):
    35	    pass
    36	
    37	
    38	class UnknownErpOperation(Exception):
    39	    pass
    40	
    41	
    42	def fingerprint(tool: dict[str, Any]) -> str:
    43	    material = {
    44	        "name": tool["name"],
    45	        "description": tool.get("description", ""),
    46	        "inputSchema": tool.get("inputSchema", {}),
    47	        "annotations": tool.get("annotations", {}),
    48	    }
    49	    raw = json.dumps(material, sort_keys=True, separators=(",", ":"))
    50	    return "sha256:" + hashlib.sha256(raw.encode("utf-8")).hexdigest()
    51	
    52	
    53	def scan_metadata(tool: dict[str, Any]) -> None:
    54	    description = tool.get("description", "")
    55	    if len(description) > MAX_DESCRIPTION_CHARS:
    56	        raise ToolPinMismatch(f"{tool['name']}: description too long")
    57	    blob = json.dumps(tool, ensure_ascii=False)
    58	    for pattern in SUSPICIOUS_METADATA:
    59	        if pattern.search(blob):
    60	            raise ToolPinMismatch(f"{tool['name']}: suspicious metadata ({pattern.pattern})")
    61	
    62	
    63	class ErpMcpClient:
    64	    AUDIENCE = "erp-mcp-gateway"
    65	
    66	    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):
    67	        self.url = url
    68	        self.pins = pins
    69	        self.broker = broker
    70	        self._tools: dict[str, dict[str, Any]] = {}
    71	
    72	    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:
    73	        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:
    74	            resp = await client.post(
    75	                self.url,
    76	                json={"jsonrpc": "2.0", "id": str(uuid.uuid4()), "method": method, "params": params},
    77	                headers={"Authorization": f"Bearer {token}", "Mcp-Protocol-Version": "2025-06-18"},
    78	            )
    79	        resp.raise_for_status()
    80	        if len(resp.content) > 512_000:
    81	            raise ValueError("erp response too large")
    82	        body = resp.json()
    83	        if "error" in body:
    84	            raise RuntimeError(f"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}")
    85	        return body["result"]
    86	
    87	    async def _list_tools(self, token: str) -> list[dict[str, Any]]:
    88	        result = await self._rpc("tools/list", {}, token)
    89	        return list(result.get("tools", []))
    90	
    91	    async def initialize(self, service_ident: RunIdentity) -> None:
    92	        token = await self.broker.token_for(self.AUDIENCE, "erp.tools.list", service_ident)
    93	        tools = await self._list_tools(token)
    94	        for tool in tools:
    95	            expected = self.pins.get(tool["name"])
    96	            actual = fingerprint(tool)
    97	            if expected != actual:
    98	                raise ToolPinMismatch(f"{tool['name']}: expected {expected}, got {actual}")
    99	            scan_metadata(tool)
   100	        self._tools = {t["name"]: t for t in tools}
   101	        log.info("erp tools loaded: %d", len(self._tools))
   102	
   103	    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:
   104	        if message.get("method") == "notifications/tools/list_changed":
   105	            await self.refresh_tools(service_ident)
   106	
   107	    async def refresh_tools(self, service_ident: RunIdentity) -> None:
   108	        token = await self.broker.token_for(self.AUDIENCE, "erp.tools.list", service_ident)
   109	        tools = await self._list_tools(token)
   110	        self._tools = {t["name"]: t for t in tools}
   111	        log.info("erp tools refreshed: %d", len(self._tools))
   112	
   113	    def operations(self) -> list[str]:
   114	        return sorted(self._tools)
   115	
   116	    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:
   117	        if operation not in self._tools:
   118	            raise UnknownErpOperation(operation)
   119	        token = await self.broker.token_for(self.AUDIENCE, scope, ident)
   120	        result = await self._rpc(
   121	            "tools/call",
   122	            {
   123	                "name": operation,
   124	                "arguments": arguments,
   125	                "_meta": {"business_unit": ident.tenant, "run_id": ident.run_id},
   126	            },
   127	            token,
   128	        )
   129	        if result.get("isError"):
   130	            raise RuntimeError(redact_text(json.dumps(result.get("content", []))))
   131	        return result.get("structuredContent") or result.get("content")
