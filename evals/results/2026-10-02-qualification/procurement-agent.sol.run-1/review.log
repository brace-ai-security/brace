agent/app/extractor.py
     1	"""Line-item extraction sub-agent.
     2	
     3	The parent procurement agent delegates structured extraction to a smaller
     4	model. The child runs under its own instance id, links to its parent in the
     5	audit graph, charges the parent's budget, and gets the extractor tool role.
     6	"""
     7	from __future__ import annotations
     8	
     9	import json
    10	import logging
    11	from typing import Any
    12	
    13	from opentelemetry import trace
    14	
    15	from app import audit
    16	from app.budget import Budget
    17	from app.context_size import measure_context
    18	from app.identity import RunIdentity
    19	from app.redact import redact_for_model
    20	from app.tools import build_registry
    21	
    22	log = logging.getLogger(__name__)
    23	tracer = trace.get_tracer("procurement.extractor")
    24	
    25	EXTRACTOR_ROLE = "line_item_extractor"
    26	MAX_TURNS = 4
    27	
    28	LINE_ITEMS_SCHEMA_KEYS = {"sku", "description", "quantity", "unit_price_cents", "currency"}
    29	
    30	
    31	class ExtractionFailed(Exception):
    32	    pass
    33	
    34	
    35	class LineItemExtractor:
    36	    def __init__(self, *, client, settings, deps, system_prompt: str):
    37	        self.client = client
    38	        self.settings = settings
    39	        self.deps = deps
    40	        self.system_prompt = system_prompt
    41	
    42	    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:
    43	        budget.check_subagent()
    44	        ident = parent.child(role=EXTRACTOR_ROLE)
    45	        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)
    46	        task = f"Extract every line item from document {doc_id}. Return JSON only."
    47	
    48	        with tracer.start_as_current_span("gen_ai.invoke_agent line_item_extractor") as span:
    49	            span.set_attribute("gen_ai.agent.id", ident.agent_instance_id)
    50	            span.set_attribute("procurement.parent_instance_id", parent.agent_instance_id)
    51	            start_node = await audit.record(
    52	                self.deps.pool,
    53	                ident,
    54	                kind="subagent_started",
    55	                payload={
    56	                    "role": EXTRACTOR_ROLE,
    57	                    "doc_id": doc_id,
    58	                    "parent_prompt_ref": format(span.get_span_context().span_id, "016x"),
    59	                    "tools": registry.names(),
    60	                },
    61	            )
    62	
    63	            messages: list[dict[str, Any]] = [{"role": "user", "content": task}]
    64	            for _turn in range(MAX_TURNS):
    65	                budget.check_step()
    66	                request = {
    67	                    "model": self.settings.extractor_model_id,
    68	                    "system": self.system_prompt,
    69	                    "messages": messages,
    70	                    "tools": registry.schemas(),
    71	                    "max_tokens": 4096,
    72	                }
    73	                ctx = await measure_context(self.client, request, compacted=False)
    74	                response = await self.client.messages.create(**request)
    75	                budget.charge_model(self.settings.extractor_model_id, response.usage)
    76	                await budget.flush(self.deps.pool)
    77	                ctx = ctx.finalize(response.usage)
    78	                decision = await audit.record(
    79	                    self.deps.pool, ident, kind="model_decision", parent=start_node, context=ctx,
    80	                    payload={"requested_model": request["model"], "served_model": response.model,
    81	                             "stop_reason": response.stop_reason},
    82	                )
    83	                messages.append({"role": "assistant", "content": response.content})
    84	                uses = [b for b in response.content if b.type == "tool_use"]
    85	                if not uses:
    86	                    text = "".join(b.text for b in response.content if b.type == "text")
    87	                    items = _parse_items(text)
    88	                    await audit.record(
    89	                        self.deps.pool, ident, kind="subagent_finished", parent=start_node,
    90	                        payload={"items": len(items)},
    91	                    )
    92	                    return items
    93	                results = []
    94	                for use in uses:
    95	                    budget.check_tool_call()
    96	                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))
    97	                messages.append({"role": "user", "content": results})
    98	
    99	        raise ExtractionFailed(f"no result after {MAX_TURNS} turns")
   100	
   101	
   102	def _parse_items(text: str) -> list[dict[str, Any]]:
   103	    try:
   104	        data = json.loads(text)
   105	    except json.JSONDecodeError as exc:
   106	        raise ExtractionFailed("extractor returned non-JSON output") from exc
   107	    if not isinstance(data, list) or len(data) > 500:
   108	        raise ExtractionFailed("extractor output must be a list of at most 500 items")
   109	    items = []
   110	    for raw in data:
   111	        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:
   112	            raise ExtractionFailed("unexpected line-item fields")
   113	        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})
   114	    return items
agent/app/redact.py
     1	"""Redaction for model input, logs, audit payloads, and outbound messages.
     2	
     3	Applied in four places:
     4	  * tool results before they are appended to the model context (loop.py)
     5	  * every audit payload (audit.py)
     6	  * the root logging filter (main.py)
     7	  * outbound Slack text (tools/slack.py)
     8	"""
     9	from __future__ import annotations
    10	
    11	import logging
    12	import re
    13	from typing import Any
    14	from urllib.parse import urlparse
    15	
    16	SECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [
    17	    ("bearer", re.compile(r"(?i)\bbearer\s+[A-Za-z0-9._~+/=-]{16,}")),
    18	    ("jwt", re.compile(r"\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\b")),
    19	    ("acct_token", re.compile(r"\bacct_tok_[A-Za-z0-9_]{8,}\b")),
    20	    ("pay_token", re.compile(r"\bpay_tok_[A-Za-z0-9_]{8,}\b")),
    21	    ("erp_session", re.compile(r"\berp_sess_[A-Za-z0-9_]{8,}\b")),
    22	    ("password_kv", re.compile(r"(?i)\b(password|passwd|secret|api[_-]?key)\s*[:=]\s*\S+")),
    23	]
    24	
    25	# Bank details: keep the last four characters so staff can still match records.
    26	ACCOUNT_PATTERNS: list[tuple[str, re.Pattern[str]]] = [
    27	    ("iban", re.compile(r"\b[A-Z]{2}\d{2}[A-Z0-9]{11,30}\b")),
    28	    ("account_no", re.compile(r"(?i)\b(account|acct|routing)\s*(no\.?|number|#)?\s*[:#]?\s*(\d[\d -]{6,}\d)")),
    29	]
    30	
    31	MARKDOWN_IMAGE = re.compile(r"!\[[^\]]*\]\(([^)\s]+)[^)]*\)")
    32	MARKDOWN_LINK = re.compile(r"(?<!!)\[([^\]]*)\]\(([^)\s]+)[^)]*\)")
    33	SLACK_LINK = re.compile(r"<(https?://[^|>]+)(\|[^>]*)?>")
    34	BARE_URL = re.compile(r"https?://[^\s<>()]+")
    35	
    36	APPROVED_LINK_HOSTS = frozenset({"erp.example-corp.test", "intranet.example-corp.test"})
    37	
    38	
    39	def _mask_tail(match: re.Match[str]) -> str:
    40	    text = match.group(0)
    41	    return "[REDACTED:" + "*" * 4 + text[-4:] + "]"
    42	
    43	
    44	def redact_text(text: str) -> str:
    45	    for name, pattern in SECRET_PATTERNS:
    46	        text = pattern.sub(f"[REDACTED:{name}]", text)
    47	    for _name, pattern in ACCOUNT_PATTERNS:
    48	        text = pattern.sub(_mask_tail, text)
    49	    return text
    50	
    51	
    52	def redact_value(value: Any) -> Any:
    53	    if isinstance(value, str):
    54	        return redact_text(value)
    55	    if isinstance(value, dict):
    56	        return {k: redact_value(v) for k, v in value.items()}
    57	    if isinstance(value, (list, tuple)):
    58	        return [redact_value(v) for v in value]
    59	    return value
    60	
    61	
    62	def redact_for_model(value: Any) -> str:
    63	    if not isinstance(value, str):
    64	        import json
    65	
    66	        value = json.dumps(value, default=str)
    67	    return redact_text(value)
    68	
    69	
    70	def _host_ok(url: str) -> bool:
    71	    host = (urlparse(url).hostname or "").lower()
    72	    return host in APPROVED_LINK_HOSTS
    73	
    74	
    75	def strip_unapproved_links(text: str) -> str:
    76	    """Remove images entirely and drop links to hosts outside the allowlist.
    77	
    78	    Slack and most chat clients fetch link and image URLs to render previews,
    79	    so an attacker-chosen URL can carry data out without any tool call.
    80	    """
    81	    text = MARKDOWN_IMAGE.sub("[image removed]", text)
    82	    text = MARKDOWN_LINK.sub(
    83	        lambda m: m.group(0) if _host_ok(m.group(2)) else m.group(1), text
    84	    )
    85	    text = SLACK_LINK.sub(
    86	        lambda m: m.group(0) if _host_ok(m.group(1)) else "[link removed]", text
    87	    )
    88	    text = BARE_URL.sub(
    89	        lambda m: m.group(0) if _host_ok(m.group(0)) else "[link removed]", text
    90	    )
    91	    return text
    92	
    93	
    94	class RedactingFilter(logging.Filter):
    95	    def filter(self, record: logging.LogRecord) -> bool:
    96	        if isinstance(record.msg, str):
    97	            record.msg = redact_text(record.msg)
    98	        if record.args:
    99	            record.args = tuple(redact_value(a) for a in record.args)
   100	        return True
agent/app/gate.py
     1	"""Policy gate for tool calls.
     2	
     3	Runs in the harness between the model's proposed call and the integration.
     4	High-impact operations are denied unless a valid approval exists; when none
     5	exists an approval request is opened and the call returns as pending.
     6	"""
     7	from __future__ import annotations
     8	
     9	from dataclasses import dataclass
    10	from typing import Any
    11	
    12	from app.approvals import ApprovalStore
    13	from app.identity import RunIdentity
    14	
    15	
    16	@dataclass(frozen=True)
    17	class Decision:
    18	    allow: bool
    19	    reason: str
    20	    policy_version: str
    21	    approval_id: str | None = None
    22	    pending: bool = False
    23	
    24	
    25	class PolicyGate:
    26	    def __init__(self, policy: dict, approvals: ApprovalStore):
    27	        self.version: str = policy["version"]
    28	        self.high_impact: frozenset[str] = frozenset(policy["high_impact_tools"])
    29	        self.erp_read_prefixes: tuple[str, ...] = tuple(policy["erp"]["read_prefixes"])
    30	        self.approvals = approvals
    31	
    32	    async def authorize(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:
    33	        if tool.name == "erp_call":
    34	            operation = str(args.get("operation", ""))
    35	            if not operation.startswith(self.erp_read_prefixes):
    36	                return Decision(False, f"erp operation not permitted: {operation}", self.version)
    37	            return Decision(True, "erp read operation", self.version)
    38	
    39	        if tool.name == "post_slack_message":
    40	            if args.get("external", False):
    41	                return await self._require_approval(ident, tool, args)
    42	            return Decision(True, "internal staff message", self.version)
    43	
    44	        if tool.name in self.high_impact:
    45	            return await self._require_approval(ident, tool, args)
    46	
    47	        return Decision(True, "low-impact tool", self.version)
    48	
    49	    async def _require_approval(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:
    50	        target = tool.target_of(args)
    51	        approval = await self.approvals.find_valid(ident, tool.name, target)
    52	        if approval is not None:
    53	            return Decision(True, "approved", self.version, approval_id=approval.id)
    54	        approval_id = await self.approvals.request(ident, tool.name, target, args)
    55	        return Decision(
    56	            False,
    57	            "approval required; request opened",
    58	            self.version,
    59	            approval_id=approval_id,
    60	            pending=True,
    61	        )
agent/app/loop.py
     1	"""Procurement agent run loop.
     2	
     3	Graph: model turn -> (tool calls -> gate -> integration)* -> model turn ...
     4	Every edge writes an audit node before the next step runs. Budgets are
     5	checked before each model turn and each tool call.
     6	"""
     7	from __future__ import annotations
     8	
     9	import hashlib
    10	import logging
    11	from dataclasses import dataclass, field
    12	from typing import Any
    13	
    14	from opentelemetry import trace
    15	
    16	from app import audit, killswitch
    17	from app.budget import Budget, BudgetExceeded
    18	from app.context_size import ContextMeasure, measure_context
    19	from app.gate import PolicyGate
    20	from app.identity import RunIdentity
    21	from app.redact import redact_for_model
    22	from app.tools import ToolRegistry, build_registry
    23	
    24	log = logging.getLogger(__name__)
    25	tracer = trace.get_tracer("procurement.loop")
    26	
    27	COMPACT_AFTER_MESSAGES = 40
    28	KEEP_RECENT_MESSAGES = 12
    29	
    30	
    31	@dataclass
    32	class AgentDeps:
    33	    settings: Any
    34	    pool: Any
    35	    gate: PolicyGate
    36	    erp: Any
    37	    slack: Any
    38	    broker: Any
    39	    extractor: Any = None
    40	    _budgets: dict[str, Budget] = field(default_factory=dict)
    41	    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)
    42	
    43	    def current_budget(self, ident: RunIdentity) -> Budget:
    44	        return self._budgets[ident.run_id]
    45	
    46	    def current_context(self, ident: RunIdentity) -> ContextMeasure:
    47	        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())
    48	
    49	    def erp_scope_for(self, operation: str) -> str:
    50	        scopes = self.settings.policy["erp"]["operation_scopes"]
    51	        return scopes.get(operation, "erp.read")
    52	
    53	    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:
    54	        self._contexts[ident.agent_instance_id] = ctx
    55	        proposed = await audit.record(
    56	            self.pool, ident, kind="tool_proposed", parent=parent, context=ctx,
    57	            payload={"tool": use.name, "tool_use_id": use.id, "args": audit.summarize_args(use.input)},
    58	        )
    59	        tool = registry.get(use.name)
    60	        if tool is None:
    61	            await audit.record(
    62	                self.pool, ident, kind="tool_denied", parent=proposed, context=ctx,
    63	                policy_version=self.gate.version, payload={"reason": "tool not in role allowlist"},
    64	            )
    65	            return _error(use.id, f"tool {use.name} is not available to this agent")
    66	
    67	        decision = await self.gate.authorize(ident, tool, use.input)
    68	        authz = await audit.record(
    69	            self.pool, ident, kind="authz_decision", parent=proposed, context=ctx,
    70	            policy_version=decision.policy_version, approval_id=decision.approval_id,
    71	            payload={"allow": decision.allow, "reason": decision.reason, "pending": decision.pending},
    72	        )
    73	        if not decision.allow:
    74	            if decision.pending:
    75	                return _error(use.id, f"approval requested ({decision.approval_id}); do not retry until approved")
    76	            return _error(use.id, f"denied: {decision.reason}")
    77	
    78	        operation_id = f"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}"
    79	        try:
    80	            with tracer.start_as_current_span(f"execute_tool {use.name}") as span:
    81	                for k, v in ctx.otel_attributes().items():
    82	                    span.set_attribute(k, v)
    83	                output = await tool.invoke(use.input, ident)
    84	        except BudgetExceeded:
    85	            raise
    86	        except Exception as exc:
    87	            await audit.record(
    88	                self.pool, ident, kind="tool_error", parent=authz, context=ctx,
    89	                policy_version=decision.policy_version, approval_id=decision.approval_id,
    90	                operation_id=operation_id,
    91	                payload={"error_type": type(exc).__name__, "error": str(exc)[:500]},
    92	            )
    93	            return _error(use.id, f"{use.name} failed: {type(exc).__name__}")
    94	
    95	        await audit.record(
    96	            self.pool, ident, kind="tool_result", parent=authz, context=ctx,
    97	            policy_version=decision.policy_version, approval_id=decision.approval_id,
    98	            operation_id=operation_id,
    99	            payload={"result_sha256": audit.digest(output), "result": output},
   100	        )
   101	        return {"type": "tool_result", "tool_use_id": use.id, "content": redact_for_model(output)}
   102	
   103	
   104	def _error(tool_use_id: str, message: str) -> dict:
   105	    return {"type": "tool_result", "tool_use_id": tool_use_id, "is_error": True, "content": message}
   106	
   107	
   108	def _compact(messages: list[dict]) -> tuple[list[dict], bool]:
   109	    if len(messages) <= COMPACT_AFTER_MESSAGES:
   110	        return messages, False
   111	    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]
   112	    while tail and tail[0]["role"] != "assistant":
   113	        tail = tail[1:]
   114	    note = {"role": "user", "content": "[earlier tool exchanges were removed to save space]"}
   115	    return head + [note] + tail, True
   116	
   117	
   118	class ProcurementAgent:
   119	    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = "procurement"):
   120	        self.client = client
   121	        self.deps = deps
   122	        self.system_prompt = system_prompt
   123	        self.role = role
   124	
   125	    async def run(self, ident: RunIdentity, task: str) -> str | None:
   126	        pool = self.deps.pool
   127	        await killswitch.assert_running(pool, ident.tenant)
   128	        budget = Budget.for_run(self.deps.settings.budgets, ident)
   129	        await budget.reserve_run_start(pool)
   130	        self.deps._budgets[ident.run_id] = budget
   131	        registry = build_registry(self.role, ident, self.deps)
   132	
   133	        run_node = await audit.record(
   134	            pool, ident, kind="run_started",
   135	            payload={"task_sha256": hashlib.sha256(task.encode()).hexdigest(), "tools": registry.names()},
   136	        )
   137	        messages: list[dict[str, Any]] = [{"role": "user", "content": task}]
   138	        try:
   139	            while True:
   140	                budget.check_step()
   141	                messages, compacted = _compact(messages)
   142	                request = {
   143	                    "model": self.deps.settings.model_id,
   144	                    "system": self.system_prompt,
   145	                    "messages": messages,
   146	                    "tools": registry.schemas(),
   147	                    "max_tokens": 4096,
   148	                }
   149	                ctx = await measure_context(self.client, request, compacted)
   150	                response = await self.client.messages.create(**request)
   151	                budget.charge_model(self.deps.settings.model_id, response.usage)
   152	                await budget.flush(pool)
   153	                ctx = ctx.finalize(response.usage)
   154	                decision = await audit.record(
   155	                    pool, ident, kind="model_decision", parent=run_node, context=ctx,
   156	                    payload={
   157	                        "requested_model": request["model"],
   158	                        "served_model": response.model,
   159	                        "stop_reason": response.stop_reason,
   160	                        "proposed_tools": [b.name for b in response.content if b.type == "tool_use"],
   161	                    },
   162	                )
   163	                messages.append({"role": "assistant", "content": response.content})
   164	                uses = [b for b in response.content if b.type == "tool_use"]
   165	                if not uses:
   166	                    final = "".join(b.text for b in response.content if b.type == "text")
   167	                    await audit.record(pool, ident, kind="run_finished", parent=run_node, context=ctx,
   168	                                       payload={"final_sha256": audit.digest(final)})
   169	                    return final
   170	                results = []
   171	                for use in uses:
   172	                    budget.check_tool_call()
   173	                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))
   174	                messages.append({"role": "user", "content": results})
   175	        except BudgetExceeded as exc:
   176	            await audit.record(
   177	                pool, ident, kind="budget_exceeded", parent=run_node,
   178	                payload={"limit": exc.limit, "used": str(exc.used), "allowed": str(exc.allowed)},
   179	            )
   180	            await self.deps.slack.post(
   181	                channel="#procurement-agent-ops",
   182	                text=f"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.",
   183	            )
   184	            return None
   185	        finally:
   186	            self.deps._budgets.pop(ident.run_id, None)
