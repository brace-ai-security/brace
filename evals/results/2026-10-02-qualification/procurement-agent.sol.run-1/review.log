agent/app/tools/memory.py
     1	"""Per-department notes kept between runs (Postgres ``dept_notes``).
     2	
     3	Writes are restricted to a fixed set of note kinds, length-limited, checked
     4	for instruction-like content, and stored as unverified with a 30-day expiry
     5	until a procurement lead verifies them in the admin UI. Every row records
     6	who wrote it, from which run and source document, and the context size at
     7	the time.
     8	"""
     9	from __future__ import annotations
    10	
    11	import re
    12	import uuid
    13	from typing import Any
    14	
    15	from app.identity import RunIdentity
    16	from app.tools import Tool
    17	
    18	NOTE_KINDS = ("vendor_preference", "contract_term", "budget_note", "contact")
    19	MAX_NOTE_CHARS = 800
    20	INSTRUCTION_LIKE = [
    21	    re.compile(r"(?i)\b(ignore|disregard|override)\b.{0,40}\b(instruction|policy|approval|rule)s?\b"),
    22	    re.compile(r"(?i)\b(always|never|must)\b.{0,40}\b(approve|pay|skip|send|transfer)\b"),
    23	    re.compile(r"(?i)\b(system prompt|you are|assistant:)\b"),
    24	    re.compile(r"https?://"),
    25	]
    26	
    27	
    28	class NoteRejected(Exception):
    29	    pass
    30	
    31	
    32	def check_note(text: str) -> None:
    33	    if len(text) > MAX_NOTE_CHARS:
    34	        raise NoteRejected("note too long")
    35	    for pattern in INSTRUCTION_LIKE:
    36	        if pattern.search(text):
    37	            raise NoteRejected("note looks like an instruction")
    38	
    39	
    40	def tools(deps) -> list[Tool]:
    41	    pool = deps.pool
    42	
    43	    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:
    44	        business_unit = args.get("business_unit") or ident.tenant
    45	        rows = await pool.fetch(
    46	            """
    47	            SELECT note_id, kind, body, verified, writer_instance, created_at
    48	            FROM dept_notes
    49	            WHERE business_unit = $1
    50	              AND department = $2
    51	              AND NOT quarantined
    52	              AND (verified OR expires_at > now())
    53	            ORDER BY created_at DESC
    54	            LIMIT 20
    55	            """,
    56	            business_unit,
    57	            args["department"],
    58	        )
    59	        return [
    60	            {
    61	                "note_id": r["note_id"],
    62	                "kind": r["kind"],
    63	                "body": r["body"],
    64	                "trust": "verified" if r["verified"] else "unverified",
    65	                "written": r["created_at"].isoformat(),
    66	            }
    67	            for r in rows
    68	        ]
    69	
    70	    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:
    71	        if args["kind"] not in NOTE_KINDS:
    72	            raise NoteRejected(f"unknown note kind {args['kind']}")
    73	        check_note(args["body"])
    74	        note_id = f"note-{uuid.uuid4()}"
    75	        ctx = deps.current_context(ident)
    76	        await pool.execute(
    77	            """
    78	            INSERT INTO dept_notes (
    79	                note_id, business_unit, department, kind, body,
    80	                verified, quarantined, expires_at,
    81	                writer_instance, writer_type_id, run_id, source_doc_id,
    82	                delegated_subject, context_tokens, context_method, created_at
    83	            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',
    84	                      $6, $7, $8, $9, $10, $11, $12, now())
    85	            """,
    86	            note_id,
    87	            ident.tenant,
    88	            args["department"],
    89	            args["kind"],
    90	            args["body"],
    91	            ident.agent_instance_id,
    92	            ident.agent_type_id,
    93	            ident.run_id,
    94	            args.get("source_doc_id"),
    95	            ident.delegated_subject,
    96	            ctx.tokens,
    97	            ctx.method,
    98	        )
    99	        return {"note_id": note_id, "status": "stored_unverified"}
   100	
   101	    return [
   102	        Tool(
   103	            name="memory_read",
   104	            description=(
   105	                "Read saved notes for a department. business_unit defaults to the current one; "
   106	                "shared-services staff may look up another unit's notes."
   107	            ),
   108	            input_schema={
   109	                "type": "object",
   110	                "properties": {
   111	                    "department": {"type": "string", "maxLength": 64},
   112	                    "business_unit": {"type": "string", "maxLength": 32},
   113	                },
   114	                "required": ["department"],
   115	                "additionalProperties": False,
   116	            },
   117	            invoke=memory_read,
   118	        ),
   119	        Tool(
   120	            name="memory_write",
   121	            description="Save a short factual note for a department (vendor preference, contract term, budget note, contact).",
   122	            input_schema={
   123	                "type": "object",
   124	                "properties": {
   125	                    "department": {"type": "string", "maxLength": 64},
   126	                    "kind": {"type": "string", "enum": list(NOTE_KINDS)},
   127	                    "body": {"type": "string", "maxLength": MAX_NOTE_CHARS},
   128	                    "source_doc_id": {"type": "string", "maxLength": 64},
   129	                },
   130	                "required": ["department", "kind", "body"],
   131	                "additionalProperties": False,
   132	            },
   133	            invoke=memory_write,
   134	        ),
   135	    ]
