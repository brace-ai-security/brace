    17	          - resources:
    18	              kinds: [Pod]
    19	              namespaces: [procurement-prod]
    20	      validate:
    21	        message: "Images in procurement-prod must come from registry.example-corp.test/procurement and be pinned by digest."
    22	        pattern:
    23	          spec:
    24	            =(initContainers):
    25	              - image: "registry.example-corp.test/procurement/*@sha256:*"
    26	            containers:
