     1	"""Slack tool: message staff and vendors, plus the approvals notifier."""
     2	from __future__ import annotations
     3	
     4	from datetime import datetime
     5	from typing import Any
     6	
     7	import httpx
     8	
     9	from app.identity import RunIdentity
    10	from app.redact import redact_text, strip_unapproved_links
    11	from app.tools import Tool
    12	
    13	MAX_TEXT = 3000
    14	
    15	
    16	def clean_outbound(text: str) -> str:
    17	    return strip_unapproved_links(redact_text(text))[:MAX_TEXT]
    18	
    19	
    20	class SlackClient:
    21	    def __init__(self, api_url: str, bot_token_provider):
    22	        self.api_url = api_url
    23	        self._token = bot_token_provider
    24	
    25	    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:
    26	        payload: dict[str, Any] = {
    27	            "channel": channel,
    28	            "text": clean_outbound(text),
    29	            "unfurl_links": False,
    30	            "unfurl_media": False,
    31	            "mrkdwn": True,
    32	        }
    33	        if blocks:
    34	            payload["blocks"] = blocks
    35	        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:
    36	            resp = await client.post(
    37	                f"{self.api_url}/chat.postMessage",
    38	                headers={"Authorization": f"Bearer {await self._token()}"},
    39	                json=payload,
    40	            )
    41	        resp.raise_for_status()
    42	        body = resp.json()
    43	        if not body.get("ok"):
    44	            raise RuntimeError(f"slack error: {body.get('error')}")
    45	        return {"channel": body["channel"], "ts": body["ts"]}
    46	
    47	    async def post_approval_request(
    48	        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime
    49	    ) -> None:
    50	        lines = "\n".join(f"• *{k}*: `{v}`" for k, v in summary.items())
    51	        text = f"Approval needed for `{tool}` on `{target}` (expires {expires_at:%Y-%m-%d %H:%M} UTC)\n{lines}"
    52	        await self.post(
    53	            channel=f"#approvals-{tenant}",
    54	            text=text,
    55	            blocks=[
    56	                {"type": "section", "text": {"type": "mrkdwn", "text": clean_outbound(text)}},
    57	                {
    58	                    "type": "actions",
    59	                    "elements": [
    60	                        {"type": "button", "action_id": "approve", "value": approval_id, "text": {"type": "plain_text", "text": "Approve"}, "style": "primary"},
    61	                        {"type": "button", "action_id": "reject", "value": approval_id, "text": {"type": "plain_text", "text": "Reject"}, "style": "danger"},
    62	                    ],
    63	                },
    64	            ],
    65	        )
    66	
    67	
    68	def tools(deps) -> list[Tool]:
    69	    slack: SlackClient = deps.slack
    70	
    71	    async def post_slack_message(args: dict[str, Any], ident: RunIdentity) -> Any:
    72	        return await slack.post(channel=args["channel"], text=args["text"])
    73	
    74	    return [
    75	        Tool(
    76	            name="post_slack_message",
    77	            description=(
    78	                "Post a message in Slack. Use internal channels for staff. Vendor contacts are in "
    79	                "Slack Connect channels named #vendor-<vendor_id>; set external=true for those."
    80	            ),
    81	            input_schema={
    82	                "type": "object",
    83	                "properties": {
    84	                    "channel": {"type": "string", "maxLength": 80},
    85	                    "text": {"type": "string", "maxLength": MAX_TEXT},
    86	                    "external": {"type": "boolean", "default": False},
    87	                },
    88	                "required": ["channel", "text"],
    89	                "additionalProperties": False,
    90	            },
    91	            invoke=post_slack_message,
    92	            target_field="channel",
    93	        )
    94	    ]
agent/app/audit.py
     1	"""Execution audit graph.
     2	
     3	Every step of a run is one row in ``audit_events``. Rows link to their parent
     4	step, so a run can be rebuilt as a tree: run -> model decision -> proposed
     5	tool call -> authorization decision -> result or error. Writes are
     6	synchronous and are made before the action they describe; if the write
     7	fails, the caller raises and the action does not run.
     8	"""
     9	from __future__ import annotations
    10	
    11	import hashlib
    12	import json
    13	import uuid
    14	from datetime import datetime, timezone
    15	from typing import Any
    16	
    17	from opentelemetry import trace
    18	
    19	from app.context_size import ContextMeasure
    20	from app.identity import IDENTITY_FIELDS, RunIdentity
    21	from app.redact import redact_value
    22	
    23	EVENT_KINDS = {
    24	    "run_started",
    25	    "run_finished",
    26	    "run_halted",
    27	    "model_decision",
    28	    "tool_proposed",
    29	    "authz_decision",
    30	    "approval_requested",
    31	    "approval_decided",
    32	    "tool_result",
    33	    "tool_error",
    34	    "tool_denied",
    35	    "budget_exceeded",
    36	    "subagent_started",
    37	    "subagent_finished",
    38	    "background_job",
    39	}
    40	
    41	_INSERT = """
    42	INSERT INTO audit_events (
    43	    node_id, parent_node_id, run_id, ts, kind,
    44	    accountable_party, operational_owner, tenant,
    45	    agent_type_id, agent_instance_id, trace_id, span_id,
    46	    delegated_subject, agent_principal, parent_instance_id,
    47	    policy_version, approval_id, operation_id,
    48	    context_tokens, context_method, context_compacted,
    49	    payload
    50	) VALUES (
    51	    $1, $2, $3, $4, $5,
    52	    $6, $7, $8,
    53	    $9, $10, $11, $12,
    54	    $13, $14, $15,
    55	    $16, $17, $18,
    56	    $19, $20, $21,
    57	    $22::jsonb
    58	)
    59	"""
    60	
    61	
    62	def summarize_args(args: dict[str, Any]) -> dict[str, Any]:
    63	    """Key arguments for the record, with secrets and account numbers redacted."""
    64	    return {k: redact_value(v) for k, v in args.items()}
    65	
    66	
    67	def digest(value: Any) -> str:
    68	    raw = json.dumps(value, sort_keys=True, default=str, separators=(",", ":"))
    69	    return hashlib.sha256(raw.encode("utf-8")).hexdigest()
    70	
    71	
    72	async def record(
    73	    pool,
    74	    ident: RunIdentity,
    75	    *,
    76	    kind: str,
    77	    payload: dict[str, Any] | None = None,
    78	    parent: str | None = None,
    79	    context: ContextMeasure | None = None,
    80	    policy_version: str | None = None,
    81	    approval_id: str | None = None,
    82	    operation_id: str | None = None,
    83	) -> str:
    84	    if kind not in EVENT_KINDS:
    85	        raise ValueError(f"unknown audit kind {kind}")
    86	    for name in IDENTITY_FIELDS:
    87	        if not getattr(ident, name):
    88	            raise ValueError(f"audit record missing {name}")
    89	    span_ctx = trace.get_current_span().get_span_context()
    90	    span_id = format(span_ctx.span_id, "016x") if span_ctx.is_valid else None
    91	    node_id = f"node-{uuid.uuid4()}"
    92	    measure = context or ContextMeasure.unavailable()
    93	    await pool.execute(
    94	        _INSERT,
    95	        node_id,
    96	        parent,
    97	        ident.run_id,
    98	        datetime.now(timezone.utc),
    99	        kind,
   100	        ident.accountable_party,
   101	        ident.operational_owner,
   102	        ident.tenant,
   103	        ident.agent_type_id,
   104	        ident.agent_instance_id,
   105	        ident.trace_id,
   106	        span_id,
   107	        ident.delegated_subject,
   108	        ident.agent_principal,
   109	        ident.parent_instance_id,
   110	        policy_version,
   111	        approval_id,
   112	        operation_id,
   113	        measure.tokens,
   114	        measure.method,
   115	        measure.compacted,
   116	        json.dumps(redact_value(payload or {}), default=str),
   117	    )
   118	    return node_id
agent/app/approvals.py
     1	"""Approval requests and decisions for high-impact operations.
     2	
     3	Requests are posted to the business unit's approvals channel in Slack with
     4	the full argument summary. Approvers decide with the Slack buttons; the
     5	interactive callback is signature-checked in main.py and then calls
     6	``decide``. Approver authority is checked against the role map in policy.
     7	"""
     8	from __future__ import annotations
     9	
    10	import json
    11	import uuid
    12	from dataclasses import dataclass
    13	from datetime import datetime, timedelta, timezone
    14	from typing import Any
    15	
    16	from app.audit import digest, summarize_args
    17	from app.identity import RunIdentity
    18	
    19	
    20	@dataclass(frozen=True)
    21	class Approval:
    22	    id: str
    23	    approver: str
    24	    approver_role: str
    25	    expires_at: datetime
    26	
    27	
    28	class ApproverNotAuthorized(Exception):
    29	    pass
    30	
    31	
    32	class ApprovalStore:
    33	    def __init__(self, pool, policy: dict, notifier):
    34	        self.pool = pool
    35	        self.ttl = timedelta(minutes=int(policy["approvals"]["ttl_minutes"]))
    36	        self.approver_roles: dict[str, list[str]] = policy["approvals"]["approver_roles"]
    37	        self.notifier = notifier
    38	
    39	    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:
    40	        approval_id = f"apr-{uuid.uuid4()}"
    41	        expires_at = datetime.now(timezone.utc) + self.ttl
    42	        await self.pool.execute(
    43	            """
    44	            INSERT INTO approvals (
    45	                id, tool, target, args_sha256, args_summary, tenant,
    46	                requested_by_instance, requested_by_run, delegated_subject,
    47	                status, requested_at, expires_at
    48	            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)
    49	            """,
    50	            approval_id,
    51	            tool,
    52	            target,
    53	            digest(args),
    54	            json.dumps(summarize_args(args)),
    55	            ident.tenant,
    56	            ident.agent_instance_id,
    57	            ident.run_id,
    58	            ident.delegated_subject,
    59	            expires_at,
    60	        )
    61	        await self.notifier.post_approval_request(
    62	            tenant=ident.tenant,
    63	            approval_id=approval_id,
    64	            tool=tool,
    65	            target=target,
    66	            summary=summarize_args(args),
    67	            expires_at=expires_at,
    68	        )
    69	        return approval_id
    70	
    71	    async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:
    72	        row = await self.pool.fetchrow(
    73	            """
    74	            SELECT id, approver, approver_role, expires_at
    75	            FROM approvals
    76	            WHERE tool = $1
    77	              AND target = $2
    78	              AND tenant = $3
    79	              AND status = 'approved'
    80	              AND expires_at > now()
    81	            ORDER BY decided_at DESC
    82	            LIMIT 1
    83	            """,
    84	            tool,
    85	            target,
    86	            ident.tenant,
    87	        )
    88	        if row is None:
    89	            return None
    90	        if row["approver_role"] not in self.approver_roles.get(tool, []):
    91	            return None
    92	        return Approval(row["id"], row["approver"], row["approver_role"], row["expires_at"])
    93	
    94	    async def decide(self, approval_id: str, approver: str, approver_role: str, approve: bool) -> None:
    95	        row = await self.pool.fetchrow(
    96	            "SELECT tool, status, expires_at FROM approvals WHERE id = $1", approval_id
    97	        )
    98	        if row is None or row["status"] != "pending":
    99	            raise ValueError("approval is not pending")
   100	        if row["expires_at"] <= datetime.now(timezone.utc):
   101	            raise ValueError("approval request expired")
   102	        if approver_role not in self.approver_roles.get(row["tool"], []):
   103	            raise ApproverNotAuthorized(f"{approver_role} cannot approve {row['tool']}")
   104	        await self.pool.execute(
   105	            """
   106	            UPDATE approvals
   107	            SET status = $2, approver = $3, approver_role = $4, decided_at = now()
   108	            WHERE id = $1 AND status = 'pending'
   109	            """,
   110	            approval_id,
   111	            "approved" if approve else "rejected",
   112	            approver,
   113	            approver_role,
   114	        )
agent/app/budget.py
     1	"""Hard execution budgets, enforced by the harness and not by the model.
     2	
     3	Per run: step count, wall-clock time, tokens, cost, tool-call rate, and
     4	number of sub-agents. Sub-agents charge the parent's budget, so a child
     5	cannot widen what the parent was given.
     6	
     7	Across runs: daily spend and per-minute run starts per user, per tenant
     8	(business unit), and for the whole fleet. Quotas are reserved in Postgres
     9	inside one transaction, so concurrent runs cannot overshoot them.
    10	"""
    11	from __future__ import annotations
    12	
    13	import time
    14	from collections import deque
    15	from dataclasses import dataclass, field
    16	from decimal import Decimal
    17	
    18	from app.identity import RunIdentity
    19	
    20	
    21	class BudgetExceeded(Exception):
    22	    def __init__(self, limit: str, used, allowed):
    23	        super().__init__(f"{limit} exceeded: used={used} allowed={allowed}")
    24	        self.limit = limit
    25	        self.used = used
    26	        self.allowed = allowed
    27	
    28	
    29	# USD per million tokens, from the provider price sheet referenced in the manifest.
    30	PRICES = {
    31	    "claude-sonnet-4-5-20250929": (Decimal("3.00"), Decimal("15.00")),
    32	    "claude-haiku-4-5-20251001": (Decimal("1.00"), Decimal("5.00")),
    33	}
    34	
    35	
    36	@dataclass
    37	class Budget:
    38	    ident: RunIdentity
    39	    max_steps: int
    40	    max_wall_seconds: float
    41	    max_tokens: int
    42	    max_cost_usd: Decimal
    43	    max_tool_calls_per_minute: int
    44	    max_subagents: int
    45	    quotas_daily_usd: dict[str, Decimal]
    46	    run_starts_per_minute: dict[str, int]
    47	    started_at: float = field(default_factory=time.monotonic)
    48	    steps: int = 0
    49	    tokens: int = 0
    50	    cost_usd: Decimal = Decimal("0")
    51	    unflushed_cost_usd: Decimal = Decimal("0")
    52	    subagents: int = 0
    53	    _tool_calls: deque = field(default_factory=deque)
    54	
    55	    @classmethod
    56	    def for_run(cls, cfg: dict, ident: RunIdentity) -> "Budget":
    57	        run = cfg["per_run"]
    58	        return cls(
    59	            ident=ident,
    60	            max_steps=int(run["max_steps"]),
    61	            max_wall_seconds=float(run["max_wall_seconds"]),
    62	            max_tokens=int(run["max_tokens"]),
    63	            max_cost_usd=Decimal(str(run["max_cost_usd"])),
    64	            max_tool_calls_per_minute=int(run["max_tool_calls_per_minute"]),
    65	            max_subagents=int(run["max_subagents"]),
    66	            quotas_daily_usd={k: Decimal(str(v)) for k, v in cfg["quotas_daily_usd"].items()},
    67	            run_starts_per_minute={k: int(v) for k, v in cfg["run_starts_per_minute"].items()},
    68	        )
    69	
    70	    def _scopes(self) -> list[tuple[str, str]]:
    71	        return [
    72	            ("user", self.ident.accountable_party),
    73	            ("tenant", self.ident.tenant),
    74	            ("fleet", "all"),
    75	        ]
    76	
    77	    # --- per-run limits -------------------------------------------------
    78	
    79	    def check_step(self) -> None:
    80	        self.steps += 1
    81	        if self.steps > self.max_steps:
    82	            raise BudgetExceeded("max_steps", self.steps, self.max_steps)
    83	        elapsed = time.monotonic() - self.started_at
    84	        if elapsed > self.max_wall_seconds:
    85	            raise BudgetExceeded("max_wall_seconds", round(elapsed, 1), self.max_wall_seconds)
    86	
    87	    def charge_model(self, model: str, usage) -> None:
    88	        price_in, price_out = PRICES[model]
    89	        tokens_in = (
    90	            int(usage.input_tokens or 0)
    91	            + int(getattr(usage, "cache_read_input_tokens", 0) or 0)
    92	            + int(getattr(usage, "cache_creation_input_tokens", 0) or 0)
    93	        )
    94	        tokens_out = int(usage.output_tokens or 0)
    95	        self.tokens += tokens_in + tokens_out
    96	        cost = (price_in * tokens_in + price_out * tokens_out) / Decimal(1_000_000)
    97	        self.cost_usd += cost
    98	        self.unflushed_cost_usd += cost
    99	        if self.tokens > self.max_tokens:
   100	            raise BudgetExceeded("max_tokens", self.tokens, self.max_tokens)
   101	        if self.cost_usd > self.max_cost_usd:
   102	            raise BudgetExceeded("max_cost_usd", self.cost_usd, self.max_cost_usd)
   103	
   104	    def check_tool_call(self, now: float | None = None) -> None:
   105	        now = time.monotonic() if now is None else now
   106	        while self._tool_calls and now - self._tool_calls[0] > 60:
   107	            self._tool_calls.popleft()
   108	        if len(self._tool_calls) >= self.max_tool_calls_per_minute:
   109	            raise BudgetExceeded(
   110	                "max_tool_calls_per_minute", len(self._tool_calls) + 1, self.max_tool_calls_per_minute
   111	            )
   112	        self._tool_calls.append(now)
   113	
   114	    def check_subagent(self) -> None:
   115	        if self.subagents >= self.max_subagents:
   116	            raise BudgetExceeded("max_subagents", self.subagents + 1, self.max_subagents)
   117	        self.subagents += 1
   118	
   119	    # --- cross-run quotas -----------------------------------------------
   120	
   121	    async def reserve_run_start(self, pool) -> None:
   122	        async with pool.acquire() as conn:
   123	            async with conn.transaction():
   124	                for scope, key in self._scopes():
   125	                    limit = self.run_starts_per_minute[scope]
   126	                    count = await conn.fetchval(
   127	                        """
   128	                        INSERT INTO run_start_window (scope, key, minute, starts)
   129	                        VALUES ($1, $2, date_trunc('minute', now()), 1)
   130	                        ON CONFLICT (scope, key, minute)
   131	                        DO UPDATE SET starts = run_start_window.starts + 1
   132	                        RETURNING starts
   133	                        """,
   134	                        scope,
   135	                        key,
   136	                    )
   137	                    if count > limit:
   138	                        raise BudgetExceeded(f"run_starts_per_minute.{scope}", count, limit)
   139	
   140	    async def flush(self, pool) -> None:
   141	        """Add this run's unflushed spend to the daily quotas, or stop the run."""
   142	        if self.unflushed_cost_usd <= 0:
   143	            return
   144	        amount = self.unflushed_cost_usd
   145	        async with pool.acquire() as conn:
   146	            async with conn.transaction():
   147	                for scope, key in self._scopes():
   148	                    limit = self.quotas_daily_usd[scope]
   149	                    spent = await conn.fetchval(
   150	                        """
   151	                        INSERT INTO spend_quota (scope, key, day, spent_usd)
   152	                        VALUES ($1, $2, current_date, $3)
   153	                        ON CONFLICT (scope, key, day)
   154	                        DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd
   155	                        RETURNING spent_usd
   156	                        """,
   157	                        scope,
   158	                        key,
   159	                        amount,
   160	                    )
   161	                    if spent > limit:
   162	                        raise BudgetExceeded(f"quota_daily_usd.{scope}", spent, limit)
   163	        self.unflushed_cost_usd = Decimal("0")
