agent/src/control/kill-switch.ts:2:import { DynamoDBDocumentClient, BatchGetCommand } from "@aws-sdk/lib-dynamodb";
agent/src/control/kill-switch.ts:3:import { env } from "../config.js";
agent/src/control/kill-switch.ts:4:
agent/src/control/kill-switch.ts:5:// Stop control. Operators write halted=true on "global" or "tenant#<clinicId>" in the control table.
agent/src/control/kill-switch.ts:6:// The agent only reads this table; every model turn and every tool call checks it, and a watcher
agent/src/control/kill-switch.ts:7:// aborts in-flight work for halted scopes.
agent/src/control/kill-switch.ts:8:export class Halted extends Error {
agent/src/control/kill-switch.ts:9:  constructor(public scope: string) {
agent/src/control/kill-switch.ts:10:    super(`agent halted (${scope})`);
agent/src/control/kill-switch.ts:11:  }
agent/src/control/kill-switch.ts:12:}
agent/src/control/kill-switch.ts:13:
agent/src/control/kill-switch.ts:14:const ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));
agent/src/control/kill-switch.ts:15:const POLL_MS = 2000;
agent/src/control/kill-switch.ts:16:
agent/src/control/kill-switch.ts:17:type Active = { tenantId: string; abort: AbortController };
agent/src/control/kill-switch.ts:18:const active = new Map<string, Active>();
agent/src/control/kill-switch.ts:19:
agent/src/control/kill-switch.ts:20:let lastRead = 0;
agent/src/control/kill-switch.ts:21:let halted = new Set<string>();
agent/src/control/kill-switch.ts:22:
agent/src/control/kill-switch.ts:23:async function refresh(): Promise<void> {
agent/src/control/kill-switch.ts:24:  const res = await ddb.send(
agent/src/control/kill-switch.ts:25:    new BatchGetCommand({
agent/src/control/kill-switch.ts:26:      RequestItems: {
agent/src/control/kill-switch.ts:27:        [env.controlTable]: {
agent/src/control/kill-switch.ts:28:          Keys: [{ pk: "global" }, ...[...new Set([...active.values()].map((a) => a.tenantId))].map((t) => ({ pk: `tenant#${t}` }))],
agent/src/control/kill-switch.ts:29:          ConsistentRead: true,
agent/src/control/kill-switch.ts:30:        },
agent/src/control/kill-switch.ts:31:      },
agent/src/control/kill-switch.ts:32:    }),
agent/src/control/kill-switch.ts:33:  );
agent/src/control/kill-switch.ts:34:  const next = new Set<string>();
agent/src/control/kill-switch.ts:35:  for (const item of res.Responses?.[env.controlTable] ?? []) {
agent/src/control/kill-switch.ts:36:    if (item.halted === true) next.add(String(item.pk));
agent/src/control/kill-switch.ts:37:  }
agent/src/control/kill-switch.ts:38:  halted = next;
agent/src/control/kill-switch.ts:39:  lastRead = Date.now();
agent/src/control/kill-switch.ts:40:}
agent/src/control/kill-switch.ts:41:
agent/src/control/kill-switch.ts:42:export const killSwitch = {
agent/src/control/kill-switch.ts:43:  register(runId: string, tenantId: string, abort: AbortController): () => void {
agent/src/control/kill-switch.ts:44:    active.set(runId, { tenantId, abort });
agent/src/control/kill-switch.ts:45:    return () => active.delete(runId);
agent/src/control/kill-switch.ts:46:  },
agent/src/control/kill-switch.ts:47:
agent/src/control/kill-switch.ts:48:  async assertRunning(tenantId: string): Promise<void> {
agent/src/control/kill-switch.ts:49:    if (Date.now() - lastRead > POLL_MS) {
agent/src/control/kill-switch.ts:50:      try {
agent/src/control/kill-switch.ts:51:        await refresh();
agent/src/control/kill-switch.ts:52:      } catch {
agent/src/control/kill-switch.ts:53:        // If the control table cannot be read, treat the agent as halted.
agent/src/control/kill-switch.ts:54:        throw new Halted("control-unreadable");
agent/src/control/kill-switch.ts:55:      }
agent/src/control/kill-switch.ts:56:    }
agent/src/control/kill-switch.ts:57:    if (halted.has("global")) throw new Halted("global");
agent/src/control/kill-switch.ts:58:    if (halted.has(`tenant#${tenantId}`)) throw new Halted(`tenant#${tenantId}`);
agent/src/control/kill-switch.ts:59:  },
agent/src/control/kill-switch.ts:60:
agent/src/control/kill-switch.ts:61:  startWatcher(): NodeJS.Timeout {
agent/src/control/kill-switch.ts:62:    return setInterval(async () => {
agent/src/control/kill-switch.ts:63:      try {
agent/src/control/kill-switch.ts:64:        await refresh();
agent/src/control/kill-switch.ts:65:      } catch {
agent/src/control/kill-switch.ts:66:        halted = new Set(["global"]);
agent/src/control/kill-switch.ts:67:      }
agent/src/control/kill-switch.ts:68:      for (const [runId, a] of active) {
agent/src/control/kill-switch.ts:69:        if (halted.has("global") || halted.has(`tenant#${a.tenantId}`)) {
agent/src/control/kill-switch.ts:70:          a.abort.abort(new Halted(halted.has("global") ? "global" : `tenant#${a.tenantId}`));
agent/src/control/kill-switch.ts:71:          active.delete(runId);
agent/src/control/kill-switch.ts:72:        }
agent/src/control/kill-switch.ts:73:      }
agent/src/control/kill-switch.ts:74:    }, POLL_MS);
agent/src/control/kill-switch.ts:75:  },
agent/src/control/kill-switch.ts:76:};
