agent/.github/workflows/ci.yml:26:    runs-on: ubuntu-24.04
agent/.github/workflows/ci.yml:27:    steps:
agent/.github/workflows/ci.yml:28:      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0
agent/.github/workflows/ci.yml:29:      - name: Prompt digests match the release manifest
agent/.github/workflows/ci.yml:30:        run: |
agent/.github/workflows/ci.yml:31:          node -e '
agent/.github/workflows/ci.yml:32:            const fs = require("fs"), crypto = require("crypto");
agent/.github/workflows/ci.yml:33:            const m = JSON.parse(fs.readFileSync("release/manifest.json", "utf8"));
agent/.github/workflows/ci.yml:34:            let bad = 0;
agent/.github/workflows/ci.yml:35:            for (const p of m.prompts) {
agent/.github/workflows/ci.yml:36:              const got = crypto.createHash("sha256").update(fs.readFileSync(p.path)).digest("hex");
agent/.github/workflows/ci.yml:37:              if (got !== p.sha256) { console.error(`${p.path}: manifest ${p.sha256} != file ${got}`); bad++; }
agent/.github/workflows/ci.yml:38:            }
agent/.github/workflows/ci.yml:39:            const ver = JSON.parse(fs.readFileSync("package.json", "utf8")).version;
agent/.github/workflows/ci.yml:40:            if (m.harness.version !== ver) { console.error(`harness version ${m.harness.version} != package ${ver}`); bad++; }
agent/.github/workflows/ci.yml:41:            process.exit(bad ? 1 : 0);
agent/.github/workflows/ci.yml:42:          '
