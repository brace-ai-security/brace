agent/infra/terraform/github.tf:1:# Who can change production: only the deploy workflow running in the "production" or
agent/infra/terraform/github.tf:2:# "production-emergency" GitHub environment can assume the deploy role, and both environments
agent/infra/terraform/github.tf:3:# require a named reviewer from agent-platform-leads. Nobody else has write access to the
agent/infra/terraform/github.tf:4:# clinic-agent namespace (see access_entries in main.tf), and the cluster API is private.
agent/infra/terraform/github.tf:5:
agent/infra/terraform/github.tf:6:provider "github" {
agent/infra/terraform/github.tf:7:  owner = "northbay-clinics"
agent/infra/terraform/github.tf:8:}
agent/infra/terraform/github.tf:9:
agent/infra/terraform/github.tf:10:data "github_team" "leads" {
agent/infra/terraform/github.tf:11:  slug = "agent-platform-leads"
agent/infra/terraform/github.tf:12:}
agent/infra/terraform/github.tf:13:
agent/infra/terraform/github.tf:14:resource "github_branch_protection" "main" {
agent/infra/terraform/github.tf:15:  repository_id = "clinic-agent"
agent/infra/terraform/github.tf:16:  pattern       = "main"
agent/infra/terraform/github.tf:17:
agent/infra/terraform/github.tf:18:  enforce_admins                  = true
agent/infra/terraform/github.tf:19:  allows_force_pushes             = false
agent/infra/terraform/github.tf:20:  allows_deletions                = false
agent/infra/terraform/github.tf:21:  required_linear_history         = true
agent/infra/terraform/github.tf:22:  require_signed_commits          = true
agent/infra/terraform/github.tf:23:  require_conversation_resolution = true
agent/infra/terraform/github.tf:24:
agent/infra/terraform/github.tf:25:  required_pull_request_reviews {
agent/infra/terraform/github.tf:26:    required_approving_review_count = 2
agent/infra/terraform/github.tf:27:    require_code_owner_reviews      = true
agent/infra/terraform/github.tf:28:    dismiss_stale_reviews           = true
agent/infra/terraform/github.tf:29:    require_last_push_approval      = true
agent/infra/terraform/github.tf:30:  }
agent/infra/terraform/github.tf:31:
agent/infra/terraform/github.tf:32:  required_status_checks {
agent/infra/terraform/github.tf:33:    strict   = true
agent/infra/terraform/github.tf:34:    contexts = ["ci / test", "ci / manifest-check"]
agent/infra/terraform/github.tf:35:  }
agent/infra/terraform/github.tf:36:}
agent/infra/terraform/github.tf:37:
agent/infra/terraform/github.tf:38:resource "github_repository_environment" "production" {
agent/infra/terraform/github.tf:39:  repository  = "clinic-agent"
agent/infra/terraform/github.tf:40:  environment = "production"
agent/infra/terraform/github.tf:41:  reviewers {
agent/infra/terraform/github.tf:42:    teams = [data.github_team.leads.id]
agent/infra/terraform/github.tf:43:  }
agent/infra/terraform/github.tf:44:  prevent_self_review = true
agent/infra/terraform/github.tf:45:  deployment_branch_policy {
agent/infra/terraform/github.tf:46:    protected_branches     = true
agent/infra/terraform/github.tf:47:    custom_branch_policies = false
agent/infra/terraform/github.tf:48:  }
agent/infra/terraform/github.tf:49:}
agent/infra/terraform/github.tf:50:
agent/infra/terraform/github.tf:51:resource "github_repository_environment" "production_emergency" {
agent/infra/terraform/github.tf:52:  repository  = "clinic-agent"
agent/infra/terraform/github.tf:53:  environment = "production-emergency"
agent/infra/terraform/github.tf:54:  reviewers {
agent/infra/terraform/github.tf:55:    teams = [data.github_team.leads.id]
agent/infra/terraform/github.tf:56:  }
agent/infra/terraform/github.tf:57:  prevent_self_review = true
agent/infra/terraform/github.tf:58:  deployment_branch_policy {
