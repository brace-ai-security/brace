agent/infra/terraform/github.tf:69:
agent/infra/terraform/github.tf:70:resource "aws_iam_role" "deploy" {
agent/infra/terraform/github.tf:71:  name = "clinic-agent-deploy"
agent/infra/terraform/github.tf:72:  assume_role_policy = jsonencode({
agent/infra/terraform/github.tf:73:    Version = "2012-10-17"
agent/infra/terraform/github.tf:74:    Statement = [{
agent/infra/terraform/github.tf:75:      Effect    = "Allow"
agent/infra/terraform/github.tf:76:      Principal = { Federated = "arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/token.actions.githubusercontent.com" }
agent/infra/terraform/github.tf:77:      Action    = "sts:AssumeRoleWithWebIdentity"
agent/infra/terraform/github.tf:78:      Condition = {
agent/infra/terraform/github.tf:79:        StringEquals = {
agent/infra/terraform/github.tf:80:          "token.actions.githubusercontent.com:aud" = "sts.amazonaws.com"
agent/infra/terraform/github.tf:81:          "token.actions.githubusercontent.com:sub" = [
agent/infra/terraform/github.tf:82:            "repo:northbay-clinics/clinic-agent:environment:production",
agent/infra/terraform/github.tf:83:            "repo:northbay-clinics/clinic-agent:environment:production-emergency",
agent/infra/terraform/github.tf:84:          ]
agent/infra/terraform/github.tf:85:        }
agent/infra/terraform/github.tf:86:      }
agent/infra/terraform/github.tf:87:    }]
agent/infra/terraform/github.tf:88:  })
agent/infra/terraform/github.tf:89:}
agent/infra/terraform/github.tf:90:
agent/infra/terraform/github.tf:91:resource "aws_iam_role_policy" "deploy" {
agent/infra/terraform/github.tf:92:  name = "clinic-agent-deploy"
agent/infra/terraform/github.tf:93:  role = aws_iam_role.deploy.id
agent/infra/terraform/github.tf:94:  policy = jsonencode({
agent/infra/terraform/github.tf:95:    Version = "2012-10-17"
agent/infra/terraform/github.tf:96:    Statement = [
agent/infra/terraform/github.tf:97:      {
agent/infra/terraform/github.tf:98:        Effect   = "Allow"
agent/infra/terraform/github.tf:99:        Action   = ["ecr:GetAuthorizationToken"]
agent/infra/terraform/github.tf:100:        Resource = "*"
agent/infra/terraform/github.tf:101:      },
agent/infra/terraform/github.tf:102:      {
agent/infra/terraform/github.tf:103:        Effect   = "Allow"
agent/infra/terraform/github.tf:104:        Action   = ["ecr:BatchCheckLayerAvailability", "ecr:PutImage", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart", "ecr:CompleteLayerUpload", "ecr:BatchGetImage"]
agent/infra/terraform/github.tf:105:        Resource = aws_ecr_repository.agent.arn
agent/infra/terraform/github.tf:106:      },
agent/infra/terraform/github.tf:107:      {
agent/infra/terraform/github.tf:108:        Effect   = "Allow"
agent/infra/terraform/github.tf:109:        Action   = ["eks:DescribeCluster"]
agent/infra/terraform/github.tf:110:        Resource = module.eks.cluster_arn
agent/infra/terraform/github.tf:111:      },
agent/infra/terraform/github.tf:112:    ]
agent/infra/terraform/github.tf:113:  })
agent/infra/terraform/github.tf:114:}
agent/config/tools.allowlist.yaml:1:# Every tool the scheduling agent may call, with the task it serves.
agent/config/tools.allowlist.yaml:2:# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)
agent/config/tools.allowlist.yaml:3:# are not used for allow or approval decisions.
agent/config/tools.allowlist.yaml:4:role: scheduling_agent
agent/config/tools.allowlist.yaml:5:tools:
agent/config/tools.allowlist.yaml:6:  - tool: ehr__find_patient
agent/config/tools.allowlist.yaml:7:    reason: Match the sender to a patient record by date of birth and phone or email.
agent/config/tools.allowlist.yaml:8:  - tool: ehr__search_slots
agent/config/tools.allowlist.yaml:9:    reason: List open slots for a provider, location, and visit type.
agent/config/tools.allowlist.yaml:10:  - tool: ehr__get_appointment
agent/config/tools.allowlist.yaml:11:    reason: Read one appointment the patient asks about.
agent/config/tools.allowlist.yaml:12:  - tool: ehr__list_patient_appointments
agent/config/tools.allowlist.yaml:13:    reason: Show the patient their upcoming appointments.
agent/config/tools.allowlist.yaml:14:  - tool: ehr__book_appointment
agent/config/tools.allowlist.yaml:15:    reason: Book a slot the patient chose.
agent/config/tools.allowlist.yaml:16:  - tool: ehr__update_appointment
agent/config/tools.allowlist.yaml:17:    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.
agent/config/tools.allowlist.yaml:18:  - tool: ehr__cancel_appointment
agent/config/tools.allowlist.yaml:19:    reason: Cancel an appointment at the patient's request.
agent/config/tools.allowlist.yaml:20:  - tool: payments__refund_deposit
agent/config/tools.allowlist.yaml:21:    reason: Refund a no-show deposit after staff review.
agent/config/tools.allowlist.yaml:22:  - tool: sms__send_to_patient
agent/config/tools.allowlist.yaml:23:    reason: Send a templated message to the phone number on the patient's record.
agent/config/tools.allowlist.yaml:24:  - tool: sms__send_freeform
agent/config/tools.allowlist.yaml:25:    reason: Send a staff-approved message that is not one of the templates.
agent/config/tools.allowlist.yaml:26:  - tool: insurance__check_eligibility
agent/config/tools.allowlist.yaml:27:    reason: Ask the eligibility agent whether a visit is covered.
agent/config/policy.yaml:1:# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).
agent/config/policy.yaml:2:policyVersion: "2026-09-18.3"
agent/config/policy.yaml:3:
agent/config/policy.yaml:4:# Tools that never run without a staff approval bound to the request.
agent/config/policy.yaml:5:highImpactTools:
agent/config/policy.yaml:6:  - ehr__cancel_appointment
agent/config/policy.yaml:7:  - payments__refund_deposit
agent/config/policy.yaml:8:  - sms__send_freeform
agent/config/policy.yaml:9:
agent/config/policy.yaml:10:approval:
agent/config/policy.yaml:11:  ttlSeconds: 900
agent/config/policy.yaml:12:  approverRoles:
agent/config/policy.yaml:13:    - front_desk_lead
agent/config/policy.yaml:14:    - clinic_manager
agent/config/policy.yaml:15:  # Approvals are recorded in DynamoDB table clinic-agent-approvals.
agent/config/policy.yaml:16:  table: clinic-agent-approvals
