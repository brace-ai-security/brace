agent/infra/terraform/main.tf:1:terraform {
agent/infra/terraform/main.tf:2:  required_version = ">= 1.9.0"
agent/infra/terraform/main.tf:3:  required_providers {
agent/infra/terraform/main.tf:4:    aws    = { source = "hashicorp/aws", version = "~> 6.14" }
agent/infra/terraform/main.tf:5:    github = { source = "integrations/github", version = "~> 6.6" }
agent/infra/terraform/main.tf:6:  }
agent/infra/terraform/main.tf:7:  backend "s3" {
agent/infra/terraform/main.tf:8:    bucket         = "northbay-tfstate-418295730611"
agent/infra/terraform/main.tf:9:    key            = "clinic-agent/prod.tfstate"
agent/infra/terraform/main.tf:10:    region         = "us-west-2"
agent/infra/terraform/main.tf:11:    dynamodb_table = "northbay-tf-locks"
agent/infra/terraform/main.tf:12:    encrypt        = true
agent/infra/terraform/main.tf:13:  }
agent/infra/terraform/main.tf:14:}
agent/infra/terraform/main.tf:15:
agent/infra/terraform/main.tf:16:provider "aws" {
agent/infra/terraform/main.tf:17:  region = var.region
agent/infra/terraform/main.tf:18:  default_tags {
agent/infra/terraform/main.tf:19:    tags = { app = "clinic-agent", owner = "agent-platform", data = "phi" }
agent/infra/terraform/main.tf:20:  }
agent/infra/terraform/main.tf:21:}
agent/infra/terraform/main.tf:22:
agent/infra/terraform/main.tf:23:variable "region" {
agent/infra/terraform/main.tf:24:  type    = string
agent/infra/terraform/main.tf:25:  default = "us-west-2"
agent/infra/terraform/main.tf:26:}
agent/infra/terraform/main.tf:27:
agent/infra/terraform/main.tf:28:variable "clinic_ids" {
agent/infra/terraform/main.tf:29:  type    = list(string)
agent/infra/terraform/main.tf:30:  default = ["nb-castro", "nb-fremont", "nb-oakland", "nb-sanmateo", "nb-walnutcreek"]
agent/infra/terraform/main.tf:31:}
agent/infra/terraform/main.tf:32:
agent/infra/terraform/main.tf:33:data "aws_caller_identity" "current" {}
agent/infra/terraform/main.tf:34:
agent/infra/terraform/main.tf:35:module "eks" {
agent/infra/terraform/main.tf:36:  source  = "terraform-aws-modules/eks/aws"
agent/infra/terraform/main.tf:37:  version = "21.3.1"
agent/infra/terraform/main.tf:38:
agent/infra/terraform/main.tf:39:  name               = "clinic-agent-prod"
agent/infra/terraform/main.tf:40:  kubernetes_version = "1.33"
agent/infra/terraform/main.tf:41:  vpc_id             = module.vpc.vpc_id
agent/infra/terraform/main.tf:42:  subnet_ids         = module.vpc.private_subnets
agent/infra/terraform/main.tf:43:
agent/infra/terraform/main.tf:44:  endpoint_public_access = false
agent/infra/terraform/main.tf:45:  enable_irsa            = true
agent/infra/terraform/main.tf:46:
agent/infra/terraform/main.tf:47:  authentication_mode = "API"
agent/infra/terraform/main.tf:48:  access_entries = {
agent/infra/terraform/main.tf:49:    deploy = {
agent/infra/terraform/main.tf:50:      principal_arn = aws_iam_role.deploy.arn
agent/infra/terraform/main.tf:51:      policy_associations = {
agent/infra/terraform/main.tf:52:        ns = {
agent/infra/terraform/main.tf:53:          policy_arn   = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSEditPolicy"
agent/infra/terraform/main.tf:54:          access_scope = { type = "namespace", namespaces = ["clinic-agent"] }
agent/infra/terraform/main.tf:55:        }
agent/infra/terraform/main.tf:56:      }
agent/infra/terraform/main.tf:57:    }
agent/infra/terraform/main.tf:58:  }
agent/infra/terraform/main.tf:59:
agent/infra/terraform/main.tf:60:  eks_managed_node_groups = {
agent/infra/terraform/main.tf:61:    agents = {
agent/infra/terraform/main.tf:62:      instance_types = ["m7g.large"]
agent/infra/terraform/main.tf:63:      ami_type       = "BOTTLEROCKET_ARM_64"
agent/infra/terraform/main.tf:64:      min_size       = 2
agent/infra/terraform/main.tf:65:      max_size       = 6
agent/infra/terraform/main.tf:66:      desired_size   = 3
agent/infra/terraform/main.tf:67:      metadata_options = {
agent/infra/terraform/main.tf:68:        http_tokens                 = "required"
agent/infra/terraform/main.tf:69:        http_put_response_hop_limit = 1
agent/infra/terraform/main.tf:70:      }
agent/infra/terraform/main.tf:71:    }
agent/infra/terraform/main.tf:72:  }
agent/infra/terraform/main.tf:73:}
agent/infra/terraform/main.tf:74:
agent/infra/terraform/main.tf:75:module "vpc" {
agent/infra/terraform/main.tf:76:  source  = "terraform-aws-modules/vpc/aws"
agent/infra/terraform/main.tf:77:  version = "6.4.0"
agent/infra/terraform/main.tf:78:
agent/infra/terraform/main.tf:79:  name            = "clinic-agent-prod"
agent/infra/terraform/main.tf:80:  cidr            = "10.42.0.0/16"
agent/infra/terraform/main.tf:81:  azs             = ["us-west-2a", "us-west-2b", "us-west-2c"]
agent/infra/terraform/main.tf:82:  private_subnets = ["10.42.1.0/24", "10.42.2.0/24", "10.42.3.0/24"]
agent/infra/terraform/main.tf:83:  public_subnets  = ["10.42.101.0/24", "10.42.102.0/24", "10.42.103.0/24"]
agent/infra/terraform/main.tf:84:
agent/infra/terraform/main.tf:85:  enable_nat_gateway = true
agent/infra/terraform/main.tf:86:  single_nat_gateway = false
agent/infra/terraform/main.tf:87:}
agent/infra/terraform/main.tf:88:
agent/infra/terraform/main.tf:89:resource "aws_ecr_repository" "agent" {
agent/infra/terraform/main.tf:90:  name                 = "clinic-agent"
agent/infra/terraform/main.tf:91:  image_tag_mutability = "IMMUTABLE"
agent/infra/terraform/main.tf:92:  image_scanning_configuration { scan_on_push = true }
agent/infra/terraform/main.tf:93:}
agent/infra/terraform/main.tf:94:
agent/infra/terraform/main.tf:95:# State tables. Approvals are written by the staff console; budgets by the agent; the control
agent/infra/terraform/main.tf:96:# table holds the stop flags operators set.
agent/infra/terraform/main.tf:97:resource "aws_dynamodb_table" "approvals" {
agent/infra/terraform/main.tf:98:  name         = "clinic-agent-approvals"
agent/infra/terraform/main.tf:99:  billing_mode = "PAY_PER_REQUEST"
agent/infra/terraform/main.tf:100:  hash_key     = "id"
agent/infra/terraform/main.tf:101:  attribute {
agent/infra/terraform/main.tf:102:    name = "id"
agent/infra/terraform/main.tf:103:    type = "S"
agent/infra/terraform/main.tf:104:  }
agent/infra/terraform/main.tf:105:  point_in_time_recovery { enabled = true }
agent/infra/terraform/main.tf:106:}
agent/infra/terraform/main.tf:107:
agent/infra/terraform/main.tf:108:resource "aws_dynamodb_table" "budgets" {
agent/infra/terraform/main.tf:109:  name         = "clinic-agent-budgets"
agent/infra/terraform/main.tf:110:  billing_mode = "PAY_PER_REQUEST"
agent/infra/terraform/main.tf:111:  hash_key     = "pk"
agent/infra/terraform/main.tf:112:  attribute {
agent/infra/terraform/main.tf:113:    name = "pk"
agent/infra/terraform/main.tf:114:    type = "S"
agent/infra/terraform/main.tf:115:  }
agent/infra/terraform/main.tf:116:  ttl {
agent/infra/terraform/main.tf:117:    attribute_name = "expiresAt"
agent/infra/terraform/main.tf:118:    enabled        = true
agent/infra/terraform/main.tf:119:  }
agent/infra/terraform/main.tf:120:}
agent/infra/terraform/main.tf:121:
agent/infra/terraform/main.tf:122:resource "aws_dynamodb_table" "control" {
agent/infra/terraform/main.tf:123:  name         = "clinic-agent-control"
agent/infra/terraform/main.tf:124:  billing_mode = "PAY_PER_REQUEST"
agent/infra/terraform/main.tf:125:  hash_key     = "pk"
agent/infra/terraform/main.tf:126:  attribute {
agent/infra/terraform/main.tf:127:    name = "pk"
agent/infra/terraform/main.tf:128:    type = "S"
agent/infra/terraform/main.tf:129:  }
agent/infra/terraform/main.tf:130:  point_in_time_recovery { enabled = true }
agent/infra/terraform/main.tf:131:}
agent/infra/terraform/main.tf:132:
agent/infra/terraform/main.tf:133:# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).
agent/infra/terraform/main.tf:134:resource "aws_s3_bucket" "audit" {
agent/infra/terraform/main.tf:135:  bucket              = "clinic-agent-audit-${data.aws_caller_identity.current.account_id}"
agent/infra/terraform/main.tf:136:  object_lock_enabled = true
agent/infra/terraform/main.tf:137:}
agent/infra/terraform/main.tf:138:
agent/infra/terraform/main.tf:139:resource "aws_s3_bucket_object_lock_configuration" "audit" {
agent/infra/terraform/main.tf:140:  bucket = aws_s3_bucket.audit.id
agent/infra/terraform/main.tf:141:  rule {
agent/infra/terraform/main.tf:142:    default_retention {
agent/infra/terraform/main.tf:143:      mode  = "COMPLIANCE"
agent/infra/terraform/main.tf:144:      years = 7
agent/infra/terraform/main.tf:145:    }
agent/infra/terraform/main.tf:146:  }
agent/infra/terraform/main.tf:147:}
agent/infra/terraform/main.tf:148:
agent/infra/terraform/main.tf:149:resource "aws_kinesis_firehose_delivery_stream" "audit" {
agent/infra/terraform/main.tf:150:  name        = "clinic-agent-audit"
agent/infra/terraform/main.tf:151:  destination = "extended_s3"
agent/infra/terraform/main.tf:152:  extended_s3_configuration {
agent/infra/terraform/main.tf:153:    role_arn            = aws_iam_role.firehose.arn
agent/infra/terraform/main.tf:154:    bucket_arn          = aws_s3_bucket.audit.arn
agent/infra/terraform/main.tf:155:    prefix              = "audit/dt=!{timestamp:yyyy-MM-dd}/"
agent/infra/terraform/main.tf:156:    error_output_prefix = "audit-errors/!{firehose:error-output-type}/"
agent/infra/terraform/main.tf:157:    buffering_interval  = 60
agent/infra/terraform/main.tf:158:  }
agent/infra/terraform/main.tf:159:}
agent/infra/terraform/main.tf:160:
agent/infra/terraform/main.tf:161:resource "aws_secretsmanager_secret" "ehr" {
agent/infra/terraform/main.tf:162:  for_each = toset(concat(var.clinic_ids, ["_catalog"]))
agent/infra/terraform/main.tf:163:  name     = "clinic-agent/ehr/${each.key}"
