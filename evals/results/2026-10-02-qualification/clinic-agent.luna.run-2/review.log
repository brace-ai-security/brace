agent/.github/workflows/deploy.yml:1:name: deploy
agent/.github/workflows/deploy.yml:2:
agent/.github/workflows/deploy.yml:3:# Deploys the image digest named in release/manifest.json. The digest reaches the manifest through
agent/.github/workflows/deploy.yml:4:# a reviewed release PR, so what runs is always a reviewed commit.
agent/.github/workflows/deploy.yml:5:on:
agent/.github/workflows/deploy.yml:6:  workflow_dispatch:
agent/.github/workflows/deploy.yml:7:    inputs:
agent/.github/workflows/deploy.yml:8:      emergency:
agent/.github/workflows/deploy.yml:9:        description: Emergency change (hotfix/* branch, production-emergency environment)
agent/.github/workflows/deploy.yml:10:        type: boolean
agent/.github/workflows/deploy.yml:11:        default: false
agent/.github/workflows/deploy.yml:12:      owner:
agent/.github/workflows/deploy.yml:13:        description: Emergency only - person accountable for this change
agent/.github/workflows/deploy.yml:14:        type: string
agent/.github/workflows/deploy.yml:15:        default: ""
agent/.github/workflows/deploy.yml:16:      reason:
agent/.github/workflows/deploy.yml:17:        description: Emergency only - why this cannot wait for a normal release
agent/.github/workflows/deploy.yml:18:        type: string
agent/.github/workflows/deploy.yml:19:        default: ""
agent/.github/workflows/deploy.yml:20:      expires_on:
agent/.github/workflows/deploy.yml:21:        description: Emergency only - date (YYYY-MM-DD) by which it is replaced by a normal release
agent/.github/workflows/deploy.yml:22:        type: string
agent/.github/workflows/deploy.yml:23:        default: ""
agent/.github/workflows/deploy.yml:24:
agent/.github/workflows/deploy.yml:25:permissions:
agent/.github/workflows/deploy.yml:26:  contents: read
agent/.github/workflows/deploy.yml:27:  id-token: write
agent/.github/workflows/deploy.yml:28:  issues: write
agent/.github/workflows/deploy.yml:29:
agent/.github/workflows/deploy.yml:30:concurrency:
agent/.github/workflows/deploy.yml:31:  group: deploy-production
agent/.github/workflows/deploy.yml:32:  cancel-in-progress: false
agent/.github/workflows/deploy.yml:33:
agent/.github/workflows/deploy.yml:34:jobs:
agent/.github/workflows/deploy.yml:35:  deploy:
agent/.github/workflows/deploy.yml:36:    runs-on: ubuntu-24.04
agent/.github/workflows/deploy.yml:37:    environment: ${{ inputs.emergency && 'production-emergency' || 'production' }}
agent/.github/workflows/deploy.yml:38:    steps:
agent/.github/workflows/deploy.yml:39:      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0
agent/.github/workflows/deploy.yml:40:
agent/.github/workflows/deploy.yml:41:      - name: Emergency change record is complete
agent/.github/workflows/deploy.yml:42:        if: inputs.emergency
agent/.github/workflows/deploy.yml:43:        env:
agent/.github/workflows/deploy.yml:44:          OWNER: ${{ inputs.owner }}
agent/.github/workflows/deploy.yml:45:          REASON: ${{ inputs.reason }}
agent/.github/workflows/deploy.yml:46:          EXPIRES_ON: ${{ inputs.expires_on }}
agent/.github/workflows/deploy.yml:47:        run: |
agent/.github/workflows/deploy.yml:48:          test -n "$OWNER" || { echo "owner is required"; exit 1; }
agent/.github/workflows/deploy.yml:49:          test -n "$REASON" || { echo "reason is required"; exit 1; }
agent/.github/workflows/deploy.yml:50:          date -d "$EXPIRES_ON" +%F >/dev/null || { echo "expires_on must be a date"; exit 1; }
agent/.github/workflows/deploy.yml:51:          [[ "$GITHUB_REF_NAME" == hotfix/* ]] || { echo "emergency deploys come from hotfix/* branches"; exit 1; }
agent/.github/workflows/deploy.yml:52:
agent/.github/workflows/deploy.yml:53:      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0
agent/.github/workflows/deploy.yml:54:        with:
agent/.github/workflows/deploy.yml:55:          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-deploy
agent/.github/workflows/deploy.yml:56:          aws-region: us-west-2
agent/.github/workflows/deploy.yml:57:
agent/.github/workflows/deploy.yml:58:      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2
agent/.github/workflows/deploy.yml:59:        with:
agent/.github/workflows/deploy.yml:60:          cosign-release: v2.6.2
agent/.github/workflows/deploy.yml:61:
agent/.github/workflows/deploy.yml:62:      - name: Verify image signature
agent/.github/workflows/deploy.yml:63:        run: |
agent/.github/workflows/deploy.yml:64:          DIGEST=$(jq -r .image.digest release/manifest.json)
agent/.github/workflows/deploy.yml:65:          REPO=$(jq -r .image.repository release/manifest.json)
agent/.github/workflows/deploy.yml:66:          cosign verify "$REPO@$DIGEST" \
agent/.github/workflows/deploy.yml:67:            --certificate-identity "https://github.com/northbay-clinics/clinic-agent/.github/workflows/ci.yml@refs/heads/main" \
agent/.github/workflows/deploy.yml:68:            --certificate-oidc-issuer https://token.actions.githubusercontent.com
agent/.github/workflows/deploy.yml:69:          grep -q "$DIGEST" k8s/deployment.yaml || { echo "k8s/deployment.yaml does not use the manifest digest"; exit 1; }
agent/.github/workflows/deploy.yml:70:
agent/.github/workflows/deploy.yml:71:      - name: Apply
agent/.github/workflows/deploy.yml:72:        run: |
agent/.github/workflows/deploy.yml:73:          aws eks update-kubeconfig --name clinic-agent-prod
agent/.github/workflows/deploy.yml:74:          kubectl apply -f k8s/deployment.yaml
agent/.github/workflows/deploy.yml:75:          kubectl -n clinic-agent annotate deployment/clinic-agent --overwrite \
agent/.github/workflows/deploy.yml:76:            northbay.example/git-sha="$GITHUB_SHA" \
agent/.github/workflows/deploy.yml:77:            northbay.example/release="$(jq -r .release release/manifest.json)" \
agent/.github/workflows/deploy.yml:78:            northbay.example/deployed-by="$GITHUB_ACTOR" \
agent/.github/workflows/deploy.yml:79:            northbay.example/run="$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID"
agent/.github/workflows/deploy.yml:80:          kubectl -n clinic-agent rollout status deployment/clinic-agent --timeout=5m
agent/.github/workflows/deploy.yml:81:
agent/.github/workflows/deploy.yml:82:      - name: Open follow-up review for emergency change
agent/.github/workflows/deploy.yml:83:        if: inputs.emergency
agent/.github/workflows/deploy.yml:84:        env:
agent/.github/workflows/deploy.yml:85:          GH_TOKEN: ${{ github.token }}
agent/.github/workflows/deploy.yml:86:          OWNER: ${{ inputs.owner }}
agent/.github/workflows/deploy.yml:87:          REASON: ${{ inputs.reason }}
agent/.github/workflows/deploy.yml:88:          EXPIRES_ON: ${{ inputs.expires_on }}
agent/.github/workflows/deploy.yml:89:        run: |
agent/.github/workflows/deploy.yml:90:          gh issue create \
agent/.github/workflows/deploy.yml:91:            --title "Follow-up review: emergency deploy ${GITHUB_SHA::8}" \
agent/.github/workflows/deploy.yml:92:            --label emergency-change,needs-review \
agent/.github/workflows/deploy.yml:93:            --assignee "$OWNER" \
agent/.github/workflows/deploy.yml:94:            --body "Owner: $OWNER
agent/.github/workflows/deploy.yml:95:          Reason: $REASON
agent/.github/workflows/deploy.yml:96:          Ends: $EXPIRES_ON
agent/.github/workflows/deploy.yml:97:          Commit: $GITHUB_SHA
agent/.github/workflows/deploy.yml:98:          Approved in environment production-emergency by a required reviewer (see run $GITHUB_RUN_ID).
agent/.github/workflows/deploy.yml:99:          Review and merge to main via normal PR before the end date."
