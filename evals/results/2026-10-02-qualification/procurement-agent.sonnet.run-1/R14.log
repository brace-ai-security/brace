{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KFUEu7Cns93pt8awwwJDgY","type":"tool_result","content":"1\t\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport hashlib\n5\timport logging\n6\tfrom pathlib import Path\n7\t\n8\tfrom app.identity import compute_agent_type_id\n9\tfrom app.settings import Settings\n10\t\n11\tlog = logging.getLogger(__name__)\n12\t\n13\t\n14\tdef sha256_file(path: Path) -> str:\n15\t    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n16\t\n17\t\n18\tdef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n19\t    mismatches: list[str] = []\n20\t    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n21\t        mismatches.append(f\"image: running {settings.image_digest}\")\n22\t    for name, entry in manifest[\"prompts\"].items():\n23\t        path = settings.prompt_dir / Path(entry[\"path\"]).name\n24\t        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n25\t            mismatches.append(f\"prompt:{name}\")\n26\t    for name in (\"policy\", \"tools\"):\n27\t        entry = manifest[\"config\"][name]\n28\t        path = settings.policy_path if name == \"policy\" else settings.tools_path\n29\t        if sha256_file(path) != entry[\"sha256\"]:\n30\t            mismatches.append(f\"config:{name}\")\n31\t    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n32\t        mismatches.append(\"model:primary\")\n33\t    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n34\t        mismatches.append(\"model:extractor\")\n35\t    return mismatches\n36\t\n37\t\n38\tdef startup_checks(settings: Settings) -> str:\n39\t    \"\"\"Return the agent-type-id for this process.\"\"\"\n40\t    manifest = settings.manifest\n41\t    mismatches = running_state_mismatches(settings, manifest)\n42\t    if mismatches:\n43\t        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n44\t    agent_type_id = compute_agent_type_id(manifest)\n45\t    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n46\t    return agent_type_id\n47\t"}]},"parent_tool_use_id":null,"session_id":"6b3987c6-cb09-4c69-b32f-e91c9d1f0c3e","uuid":"56e48566-1df7-45e0-aee9-a0fc5b4328b0","timestamp":"2026-10-02T14:49:45.808Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-obx8iniv/agent/app/startup.py","content":"\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport logging\nfrom pathlib import Path\n\nfrom app.identity import compute_agent_type_id\nfrom app.settings import Settings\n\nlog = logging.getLogger(__name__)\n\n\ndef sha256_file(path: Path) -> str:\n    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n    mismatches: list[str] = []\n    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n        mismatches.append(f\"image: running {settings.image_digest}\")\n    for name, entry in manifest[\"prompts\"].items():\n        path = settings.prompt_dir / Path(entry[\"path\"]).name\n        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n            mismatches.append(f\"prompt:{name}\")\n    for name in (\"policy\", \"tools\"):\n        entry = manifest[\"config\"][name]\n        path = settings.policy_path if name == \"policy\" else settings.tools_path\n        if sha256_file(path) != entry[\"sha256\"]:\n            mismatches.append(f\"config:{name}\")\n    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n        mismatches.append(\"model:primary\")\n    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n        mismatches.append(\"model:extractor\")\n    return mismatches\n\n\ndef startup_checks(settings: Settings) -> str:\n    \"\"\"Return the agent-type-id for this process.\"\"\"\n    manifest = settings.manifest\n    mismatches = running_state_mismatches(settings, manifest)\n    if mismatches:\n        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n    agent_type_id = compute_agent_type_id(manifest)\n    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n    return agent_type_id\n","numLines":47,"startLine":1,"totalLines":47}}}
