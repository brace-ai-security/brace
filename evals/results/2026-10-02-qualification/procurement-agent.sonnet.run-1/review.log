{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015p2nseom5jnCZiLNZMkXkB","type":"tool_result","content":"1599\t     9\tfrom __future__ import annotations\n1600\t    10\t\n1601\t    11\timport logging\n1602\t    12\timport re\n1603\t    13\tfrom typing import Any\n1604\t    14\tfrom urllib.parse import urlparse\n1605\t    15\t\n1606\t    16\tSECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n1607\t    17\t    (\"bearer\", re.compile(r\"(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]{16,}\")),\n1608\t    18\t    (\"jwt\", re.compile(r\"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b\")),\n1609\t    19\t    (\"acct_token\", re.compile(r\"\\bacct_tok_[A-Za-z0-9_]{8,}\\b\")),\n1610\t    20\t    (\"pay_token\", re.compile(r\"\\bpay_tok_[A-Za-z0-9_]{8,}\\b\")),\n1611\t    21\t    (\"erp_session\", re.compile(r\"\\berp_sess_[A-Za-z0-9_]{8,}\\b\")),\n1612\t    22\t    (\"password_kv\", re.compile(r\"(?i)\\b(password|passwd|secret|api[_-]?key)\\s*[:=]\\s*\\S+\")),\n1613\t    23\t]\n1614\t    24\t\n1615\t    25\t# Bank details: keep the last four characters so staff can still match records.\n1616\t    26\tACCOUNT_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n1617\t    27\t    (\"iban\", re.compile(r\"\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b\")),\n1618\t    28\t    (\"account_no\", re.compile(r\"(?i)\\b(account|acct|routing)\\s*(no\\.?|number|#)?\\s*[:#]?\\s*(\\d[\\d -]{6,}\\d)\")),\n1619\t    29\t]\n1620\t    30\t\n1621\t    31\tMARKDOWN_IMAGE = re.compile(r\"!\\[[^\\]]*\\]\\(([^)\\s]+)[^)]*\\)\")\n1622\t    32\tMARKDOWN_LINK = re.compile(r\"(?<!!)\\[([^\\]]*)\\]\\(([^)\\s]+)[^)]*\\)\")\n1623\t    33\tSLACK_LINK = re.compile(r\"<(https?://[^|>]+)(\\|[^>]*)?>\")\n1624\t    34\tBARE_URL = re.compile(r\"https?://[^\\s<>()]+\")\n1625\t    35\t\n1626\t    36\tAPPROVED_LINK_HOSTS = frozenset({\"erp.example-corp.test\", \"intranet.example-corp.test\"})\n1627\t    37\t\n1628\t    38\t\n1629\t    39\tdef _mask_tail(match: re.Match[str]) -> str:\n1630\t    40\t    text = match.group(0)\n1631\t    41\t    return \"[REDACTED:\" + \"*\" * 4 + text[-4:] + \"]\"\n1632\t    42\t\n1633\t    43\t\n1634\t    44\tdef redact_text(text: str) -> str:\n1635\t    45\t    for name, pattern in SECRET_PATTERNS:\n1636\t    46\t        text = pattern.sub(f\"[REDACTED:{name}]\", text)\n1637\t    47\t    for _name, pattern in ACCOUNT_PATTERNS:\n1638\t    48\t        text = pattern.sub(_mask_tail, text)\n1639\t    49\t    return text\n1640\t    50\t\n1641\t    51\t\n1642\t    52\tdef redact_value(value: Any) -> Any:\n1643\t    53\t    if isinstance(value, str):\n1644\t    54\t        return redact_text(value)\n1645\t    55\t    if isinstance(value, dict):\n1646\t    56\t        return {k: redact_value(v) for k, v in value.items()}\n1647\t    57\t    if isinstance(value, (list, tuple)):\n1648\t    58\t        return [redact_value(v) for v in value]\n1649\t    59\t    return value\n1650\t    60\t\n1651\t    61\t\n1652\t    62\tdef redact_for_model(value: Any) -> str:\n1653\t    63\t    if not isinstance(value, str):\n1654\t    64\t        import json\n1655\t    65\t\n1656\t    66\t        value = json.dumps(value, default=str)\n1657\t    67\t    return redact_text(value)\n1658\t    68\t\n1659\t    69\t\n1660\t    70\tdef _host_ok(url: str) -> bool:\n1661\t    71\t    host = (urlparse(url).hostname or \"\").lower()\n1662\t    72\t    return host in APPROVED_LINK_HOSTS\n1663\t    73\t\n1664\t    74\t\n1665\t    75\tdef strip_unapproved_links(text: str) -> str:\n1666\t    76\t    \"\"\"Remove images entirely and drop links to hosts outside the allowlist.\n1667\t    77\t\n1668\t    78\t    Slack and most chat clients fetch link and image URLs to render previews,\n1669\t    79\t    so an attacker-chosen URL can carry data out without any tool call.\n1670\t    80\t    \"\"\"\n1671\t    81\t    text = MARKDOWN_IMAGE.sub(\"[image removed]\", text)\n1672\t    82\t    text = MARKDOWN_LINK.sub(\n1673\t    83\t        lambda m: m.group(0) if _host_ok(m.group(2)) else m.group(1), text\n1674\t    84\t    )\n1675\t    85\t    text = SLACK_LINK.sub(\n1676\t    86\t        lambda m: m.group(0) if _host_ok(m.group(1)) else \"[link removed]\", text\n1677\t    87\t    )\n1678\t    88\t    text = BARE_URL.sub(\n1679\t    89\t        lambda m: m.group(0) if _host_ok(m.group(0)) else \"[link removed]\", text\n1680\t    90\t    )\n1681\t    91\t    return text\n1682\t    92\t\n1683\t    93\t\n1684\t    94\tclass RedactingFilter(logging.Filter):\n1685\t    95\t    def filter(self, record: logging.LogRecord) -> bool:\n1686\t    96\t        if isinstance(record.msg, str):\n1687\t    97\t            record.msg = redact_text(record.msg)\n1688\t    98\t        if record.args:\n1689\t    99\t            record.args = tuple(redact_value(a) for a in record.args)\n1690\t   100\t        return True\n1691\t=== app/settings.py\n1692\t     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n1693\t     2\tfrom __future__ import annotations\n1694\t     3\t\n1695\t     4\timport os\n1696\t     5\tfrom dataclasses import dataclass\n1697\t     6\tfrom functools import lru_cache\n1698\t     7\tfrom pathlib import Path\n1699\t     8\t\n1700\t     9\timport yaml\n1701\t    10\t\n1702\t    11\t\n1703\t    12\tdef _env(name: str, default: str | None = None) -> str:\n1704\t    13\t    value = os.environ.get(name, default)\n1705\t    14\t    if value is None:\n1706\t    15\t        raise RuntimeError(f\"missing required setting {name}\")\n1707\t    16\t    return value\n1708\t    17\t\n1709\t    18\t\n1710\t    19\t@dataclass(frozen=True)\n1711\t    20\tclass Settings:\n1712\t    21\t    database_url: str\n1713\t    22\t    erp_mcp_url: str\n1714\t    23\t    payments_api_url: str\n1715\t    24\t    slack_api_url: str\n1716\t    25\t    sts_url: str\n1717\t    26\t    oidc_issuer: str\n1718\t    27\t    oidc_audience: str\n1719\t    28\t    oidc_jwks_url: str\n1720\t    29\t    workload_token_path: str\n1721\t    30\t    slack_signing_secret_path: str\n1722\t    31\t    mail_gateway_hmac_path: str\n1723\t    32\t    model_id: str\n1724\t    33\t    extractor_model_id: str\n1725\t    34\t    manifest_path: Path\n1726\t    35\t    prompt_dir: Path\n1727\t    36\t    policy_path: Path\n1728\t    37\t    tools_path: Path\n1729\t    38\t    operational_owner: str\n1730\t    39\t    image_digest: str\n1731\t    40\t\n1732\t    41\t    @property\n1733\t    42\t    def policy(self) -> dict:\n1734\t    43\t        return _load_yaml(self.policy_path)\n1735\t    44\t\n1736\t    45\t    @property\n1737\t    46\t    def manifest(self) -> dict:\n1738\t    47\t        return _load_yaml(self.manifest_path)\n1739\t    48\t\n1740\t    49\t    @property\n1741\t    50\t    def budgets(self) -> dict:\n1742\t    51\t        return self.policy[\"budgets\"]\n1743\t    52\t\n1744\t    53\t\n1745\t    54\tdef _load_yaml(path: Path) -> dict:\n1746\t    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n1747\t    56\t        return yaml.safe_load(fh)\n1748\t    57\t\n1749\t    58\t\n1750\t    59\t@lru_cache(maxsize=1)\n1751\t    60\tdef get_settings() -> Settings:\n1752\t    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n1753\t    62\t    return Settings(\n1754\t    63\t        database_url=_env(\"DATABASE_URL\"),\n1755\t    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n1756\t    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n1757\t    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n1758\t    67\t        sts_url=_env(\"STS_URL\"),\n1759\t    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n1760\t    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n1761\t    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n1762\t    71\t        workload_token_path=_env(\n1763\t    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n1764\t    73\t        ),\n1765\t    74\t        slack_signing_secret_path=_env(\n1766\t    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n1767\t    76\t        ),\n1768\t    77\t        mail_gateway_hmac_path=_env(\n1769\t    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n1770\t    79\t        ),\n1771\t    80\t        model_id=_env(\"MODEL_ID\"),\n1772\t    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n1773\t    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n1774\t    83\t        prompt_dir=root / \"prompts\",\n1775\t    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n1776\t    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n1777\t    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n1778\t    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n1779\t    88\t    )\n1780\t=== app/startup.py\n1781\t     1\t\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\n1782\t     2\tfrom __future__ import annotations\n1783\t     3\t\n1784\t     4\timport hashlib\n1785\t     5\timport logging\n1786\t     6\tfrom pathlib import Path\n1787\t     7\t\n1788\t     8\tfrom app.identity import compute_agent_type_id\n1789\t     9\tfrom app.settings import Settings\n1790\t    10\t\n1791\t    11\tlog = logging.getLogger(__name__)\n1792\t    12\t\n1793\t    13\t\n1794\t    14\tdef sha256_file(path: Path) -> str:\n1795\t    15\t    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n1796\t    16\t\n1797\t    17\t\n1798\t    18\tdef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n1799\t    19\t    mismatches: list[str] = []\n1800\t    20\t    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n1801\t    21\t        mismatches.append(f\"image: running {settings.image_digest}\")\n1802\t    22\t    for name, entry in manifest[\"prompts\"].items():\n1803\t    23\t        path = settings.prompt_dir / Path(entry[\"path\"]).name\n1804\t    24\t        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n1805\t    25\t            mismatches.append(f\"prompt:{name}\")\n1806\t    26\t    for name in (\"policy\", \"tools\"):\n1807\t    27\t        entry = manifest[\"config\"][name]\n1808\t    28\t        path = settings.policy_path if name == \"policy\" else settings.tools_path\n1809\t    29\t        if sha256_file(path) != entry[\"sha256\"]:\n1810\t    30\t            mismatches.append(f\"config:{name}\")\n1811\t    31\t    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n1812\t    32\t        mismatches.append(\"model:primary\")\n1813\t    33\t    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n1814\t    34\t        mismatches.append(\"model:extractor\")\n1815\t    35\t    return mismatches\n1816\t    36\t\n1817\t    37\t\n1818\t    38\tdef startup_checks(settings: Settings) -> str:\n1819\t    39\t    \"\"\"Return the agent-type-id for this process.\"\"\"\n1820\t    40\t    manifest = settings.manifest\n1821\t    41\t    mismatches = running_state_mismatches(settings, manifest)\n1822\t    42\t    if mismatches:\n1823\t    43\t        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n1824\t    44\t    agent_type_id = compute_agent_type_id(manifest)\n1825\t    45\t    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n1826\t    46\t    return agent_type_id\n1827\t=== app/tools/__init__.py\n1828\t     1\t\"\"\"Tool registry.\n1829\t     2\t\n1830\t     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n1831\t     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n1832\t     5\tthat is not in the run's registry.\n1833\t     6\t\"\"\"\n1834\t     7\tfrom __future__ import annotations\n1835\t     8\t\n1836\t     9\tfrom dataclasses import dataclass\n1837\t    10\tfrom functools import lru_cache\n1838\t    11\tfrom typing import Any, Awaitable, Callable\n1839\t    12\t\n1840\t    13\timport yaml\n1841\t    14\t\n1842\t    15\tfrom app.identity import RunIdentity\n1843\t    16\t\n1844\t    17\tDEFAULT_ROLE = \"procurement\"\n1845\t    18\t\n1846\t    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n1847\t    20\t\n1848\t    21\t\n1849\t    22\t@dataclass(frozen=True)\n1850\t    23\tclass Tool:\n1851\t    24\t    name: str\n1852\t    25\t    description: str\n1853\t    26\t    input_schema: dict[str, Any]\n1854\t    27\t    invoke: Invoke\n1855\t    28\t    target_field: str | None = None\n1856\t    29\t\n1857\t    30\t    def target_of(self, args: dict[str, Any]) -> str:\n1858\t    31\t        if self.target_field is None:\n1859\t    32\t            return self.name\n1860\t    33\t        return str(args.get(self.target_field, \"\"))\n1861\t    34\t\n1862\t    35\t    def schema(self) -> dict[str, Any]:\n1863\t    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n1864\t    37\t\n1865\t    38\t\n1866\t    39\tclass ToolRegistry:\n1867\t    40\t    def __init__(self, tools: list[Tool]):\n1868\t    41\t        self._tools = {t.name: t for t in tools}\n1869\t    42\t\n1870\t    43\t    def get(self, name: str) -> Tool | None:\n1871\t    44\t        return self._tools.get(name)\n1872\t    45\t\n1873\t    46\t    def names(self) -> list[str]:\n1874\t    47\t        return sorted(self._tools)\n1875\t    48\t\n1876\t    49\t    def schemas(self) -> list[dict[str, Any]]:\n1877\t    50\t        return [self._tools[n].schema() for n in self.names()]\n1878\t    51\t\n1879\t    52\t\n1880\t    53\t@lru_cache(maxsize=1)\n1881\t    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n1882\t    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n1883\t    56\t        cfg = yaml.safe_load(fh)\n1884\t    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n1885\t    58\t\n1886\t    59\t\n1887\t    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n1888\t    61\t    from app.tools import documents, erp, memory, payments, slack\n1889\t    62\t\n1890\t    63\t    available: dict[str, Tool] = {}\n1891\t    64\t    for module in (documents, erp, memory, payments, slack):\n1892\t    65\t        for tool in module.tools(deps):\n1893\t    66\t            available[tool.name] = tool\n1894\t    67\t\n1895\t    68\t    roles = _role_tools(str(deps.settings.tools_path))\n1896\t    69\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n1897\t    70\t    return ToolRegistry([available[name] for name in allowed if name in available])\n1898\t=== app/tools/documents.py\n1899\t     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n1900\t     2\tfrom __future__ import annotations\n1901\t     3\t\n1902\t     4\tfrom typing import Any\n1903\t     5\t\n1904\t     6\tfrom app.identity import RunIdentity\n1905\t     7\tfrom app.tools import Tool\n1906\t     8\t\n1907\t     9\tUNTRUSTED_WRAPPER = (\n1908\t    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n1909\t    11\t    \"{text}\\n\"\n1910\t    12\t    \"</untrusted_document>\"\n1911\t    13\t)\n1912\t    14\t\n1913\t    15\t\n1914\t    16\tdef tools(deps) -> list[Tool]:\n1915\t    17\t    pool = deps.pool\n1916\t    18\t\n1917\t    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n1918\t    20\t        row = await pool.fetchrow(\n1919\t    21\t            \"\"\"\n1920\t    22\t            SELECT doc_id, source, media_type, text\n1921\t    23\t            FROM documents\n1922\t    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n1923\t    25\t            \"\"\",\n1924\t    26\t            args[\"doc_id\"],\n1925\t    27\t            ident.tenant,\n1926\t    28\t        )\n1927\t    29\t        if row is None:\n1928\t    30\t            return \"document not found\"\n1929\t    31\t        return UNTRUSTED_WRAPPER.format(\n1930\t    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n1931\t    33\t        )\n1932\t    34\t\n1933\t    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n1934\t    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n1935\t    37\t\n1936\t    38\t    return [\n1937\t    39\t        Tool(\n1938\t    40\t            name=\"read_document\",\n1939\t    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n1940\t    42\t            input_schema={\n1941\t    43\t                \"type\": \"object\",\n1942\t    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n1943\t    45\t                \"required\": [\"doc_id\"],\n1944\t    46\t                \"additionalProperties\": False,\n1945\t    47\t            },\n1946\t    48\t            invoke=read_document,\n1947\t    49\t        ),\n1948\t    50\t        Tool(\n1949\t    51\t            name=\"extract_line_items\",\n1950\t    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n1951\t    53\t            input_schema={\n1952\t    54\t                \"type\": \"object\",\n1953\t    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n1954\t    56\t                \"required\": [\"doc_id\"],\n1955\t    57\t                \"additionalProperties\": False,\n1956\t    58\t            },\n1957\t    59\t            invoke=extract_line_items,\n1958\t    60\t        ),\n1959\t    61\t    ]\n1960\t=== app/tools/erp.py\n1961\t     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n1962\t     2\tfrom __future__ import annotations\n1963\t     3\t\n1964\t     4\tfrom typing import Any\n1965\t     5\t\n1966\t     6\tfrom app.identity import RunIdentity\n1967\t     7\tfrom app.tools import Tool\n1968\t     8\t\n1969\t     9\tERP_READ_SCOPE = \"erp.read\"\n1970\t    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n1971\t    11\t\n1972\t    12\t\n1973\t    13\tdef tools(deps) -> list[Tool]:\n1974\t    14\t    erp = deps.erp\n1975\t    15\t\n1976\t    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n1977\t    17\t        return await erp.call(\n1978\t    18\t            \"budget.get_remaining\",\n1979\t    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n1980\t    20\t            ident,\n1981\t    21\t            ERP_READ_SCOPE,\n1982\t    22\t        )\n1983\t    23\t\n1984\t    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n1985\t    25\t        arguments = dict(args.get(\"arguments\", {}))\n1986\t    26\t        arguments[\"business_unit\"] = ident.tenant\n1987\t    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n1988\t    28\t\n1989\t    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n1990\t    30\t        return await erp.call(\n1991\t    31\t            \"po.create\",\n1992\t    32\t            {\n1993\t    33\t                \"business_unit\": ident.tenant,\n1994\t    34\t                \"department\": args[\"department\"],\n1995\t    35\t                \"vendor_id\": args[\"vendor_id\"],\n1996\t    36\t                \"lines\": args[\"lines\"],\n1997\t    37\t                \"currency\": args[\"currency\"],\n1998\t    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n1999\t    39\t                \"client_reference\": args[\"source_doc_id\"],\n2000\t    40\t            },\n2001\t    41\t            ident,\n2002\t    42\t            ERP_PO_WRITE_SCOPE,\n2003\t    43\t        )\n2004\t    44\t\n2005\t    45\t    line_schema = {\n2006\t    46\t        \"type\": \"object\",\n2007\t    47\t        \"properties\": {\n2008\t    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n2009\t    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n2010\t    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n2011\t    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n2012\t    52\t        },\n2013\t    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n2014\t    54\t        \"additionalProperties\": False,\n2015\t    55\t    }\n2016\t    56\t\n2017\t    57\t    return [\n2018\t    58\t        Tool(\n2019\t    59\t            name=\"get_budget\",\n2020\t    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n2021\t    61\t            input_schema={\n2022\t    62\t                \"type\": \"object\",\n2023\t    63\t                \"properties\": {\n2024\t    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n2025\t    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n2026\t    66\t                },\n2027\t    67\t                \"required\": [\"department\", \"fiscal_period\"],\n2028\t    68\t                \"additionalProperties\": False,\n2029\t    69\t            },\n2030\t    70\t            invoke=get_budget,\n2031\t    71\t        ),\n2032\t    72\t        Tool(\n2033\t    73\t            name=\"erp_call\",\n2034\t    74\t            description=(\n2035\t    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n2036\t    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n2037\t    77\t            ),\n2038\t    78\t            input_schema={\n2039\t    79\t                \"type\": \"object\",\n2040\t    80\t                \"properties\": {\n2041\t    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n2042\t    82\t                    \"arguments\": {\"type\": \"object\"},\n2043\t    83\t                },\n2044\t    84\t                \"required\": [\"operation\"],\n2045\t    85\t                \"additionalProperties\": False,\n2046\t    86\t            },\n2047\t    87\t            invoke=erp_call,\n2048\t    88\t        ),\n2049\t    89\t        Tool(\n2050\t    90\t            name=\"create_purchase_order\",\n2051\t    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n2052\t    92\t            input_schema={\n2053\t    93\t                \"type\": \"object\",\n2054\t    94\t                \"properties\": {\n2055\t    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n2056\t    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n2057\t    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n2058\t    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n2059\t    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n2060\t   100\t                },\n2061\t   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n2062\t   102\t                \"additionalProperties\": False,\n2063\t   103\t            },\n2064\t   104\t            invoke=create_purchase_order,\n2065\t   105\t            target_field=\"source_doc_id\",\n2066\t   106\t        ),\n2067\t   107\t    ]\n2068\t=== app/tools/memory.py\n2069\t     1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n2070\t     2\t\n2071\t     3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n2072\t     4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n2073\t     5\tuntil a procurement lead verifies them in the admin UI. Every row records\n2074\t     6\twho wrote it, from which run and source document, and the context size at\n2075\t     7\tthe time.\n2076\t     8\t\"\"\"\n2077\t     9\tfrom __future__ import annotations\n2078\t    10\t\n2079\t    11\timport re\n2080\t    12\timport uuid\n2081\t    13\tfrom typing import Any\n2082\t    14\t\n2083\t    15\tfrom app.identity import RunIdentity\n2084\t    16\tfrom app.tools import Tool\n2085\t    17\t\n2086\t    18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n2087\t    19\tMAX_NOTE_CHARS = 800\n2088\t    20\tINSTRUCTION_LIKE = [\n2089\t    21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n2090\t    22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n2091\t    23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n2092\t    24\t    re.compile(r\"https?://\"),\n2093\t    25\t]\n2094\t    26\t\n2095\t    27\t\n2096\t    28\tclass NoteRejected(Exception):\n2097\t    29\t    pass\n2098\t    30\t\n2099\t    31\t\n2100\t    32\tdef check_note(text: str) -> None:\n2101\t    33\t    if len(text) > MAX_NOTE_CHARS:\n2102\t    34\t        raise NoteRejected(\"note too long\")\n2103\t    35\t    for pattern in INSTRUCTION_LIKE:\n2104\t    36\t        if pattern.search(text):\n2105\t    37\t            raise NoteRejected(\"note looks like an instruction\")\n2106\t    38\t\n2107\t    39\t\n2108\t    40\tdef tools(deps) -> list[Tool]:\n2109\t    41\t    pool = deps.pool\n2110\t    42\t\n2111\t    43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n2112\t    44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n2113\t    45\t        rows = await pool.fetch(\n2114\t    46\t            \"\"\"\n2115\t    47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n2116\t    48\t            FROM dept_notes\n2117\t    49\t            WHERE business_unit = $1\n2118\t    50\t              AND department = $2\n2119\t    51\t              AND NOT quarantined\n2120\t    52\t              AND (verified OR expires_at > now())\n2121\t    53\t            ORDER BY created_at DESC\n2122\t    54\t            LIMIT 20\n2123\t    55\t            \"\"\",\n2124\t    56\t            business_unit,\n2125\t    57\t            args[\"department\"],\n2126\t    58\t        )\n2127\t    59\t        return [\n2128\t    60\t            {\n2129\t    61\t                \"note_id\": r[\"note_id\"],\n2130\t    62\t                \"kind\": r[\"kind\"],\n2131\t    63\t                \"body\": r[\"body\"],\n2132\t    64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n2133\t    65\t                \"written\": r[\"created_at\"].isoformat(),\n2134\t    66\t            }\n2135\t    67\t            for r in rows\n2136\t    68\t        ]\n2137\t    69\t\n2138\t    70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n2139\t    71\t        if args[\"kind\"] not in NOTE_KINDS:\n2140\t    72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n2141\t    73\t        check_note(args[\"body\"])\n2142\t    74\t        note_id = f\"note-{uuid.uuid4()}\"\n2143\t    75\t        ctx = deps.current_context(ident)\n2144\t    76\t        await pool.execute(\n2145\t    77\t            \"\"\"\n2146\t    78\t            INSERT INTO dept_notes (\n2147\t    79\t                note_id, business_unit, department, kind, body,\n2148\t    80\t                verified, quarantined, expires_at,\n2149\t    81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n2150\t    82\t                delegated_subject, context_tokens, context_method, created_at\n2151\t    83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n2152\t    84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n2153\t    85\t            \"\"\",\n2154\t    86\t            note_id,\n2155\t    87\t            ident.tenant,\n2156\t    88\t            args[\"department\"],\n2157\t    89\t            args[\"kind\"],\n2158\t    90\t            args[\"body\"],\n2159\t    91\t            ident.agent_instance_id,\n2160\t    92\t            ident.agent_type_id,\n2161\t    93\t            ident.run_id,\n2162\t    94\t            args.get(\"source_doc_id\"),\n2163\t    95\t            ident.delegated_subject,\n2164\t    96\t            ctx.tokens,\n2165\t    97\t            ctx.method,\n2166\t    98\t        )\n2167\t    99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n2168\t   100\t\n2169\t   101\t    return [\n2170\t   102\t        Tool(\n2171\t   103\t            name=\"memory_read\",\n2172\t   104\t            description=(\n2173\t   105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n2174\t   106\t                \"shared-services staff may look up another unit's notes.\"\n2175\t   107\t            ),\n2176\t   108\t            input_schema={\n2177\t   109\t                \"type\": \"object\",\n2178\t   110\t                \"properties\": {\n2179\t   111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n2180\t   112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n2181\t   113\t                },\n2182\t   114\t                \"required\": [\"department\"],\n2183\t   115\t                \"additionalProperties\": False,\n2184\t   116\t            },\n2185\t   117\t            invoke=memory_read,\n2186\t   118\t        ),\n2187\t   119\t        Tool(\n2188\t   120\t            name=\"memory_write\",\n2189\t   121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n2190\t   122\t            input_schema={\n2191\t   123\t                \"type\": \"object\",\n2192\t   124\t                \"properties\": {\n2193\t   125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n2194\t   126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n2195\t   127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n2196\t   128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n2197\t   129\t                },\n2198\t   130\t                \"required\": [\"department\", \"kind\", \"body\"],\n2199\t   131\t                \"additionalProperties\": False,\n2200\t   132\t            },\n2201\t   133\t            invoke=memory_write,\n2202\t   134\t        ),\n2203\t   135\t    ]\n2204\t=== app/tools/payments.py\n2205\t     1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n2206\t     2\tfrom __future__ import annotations\n2207\t     3\t\n2208\t     4\timport hashlib\n2209\t     5\tfrom typing import Any\n2210\t     6\t\n2211\t     7\timport httpx\n2212\t     8\t\n2213\t     9\tfrom app.identity import RunIdentity\n2214\t    10\tfrom app.tools import Tool\n2215\t    11\t\n2216\t    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n2217\t    13\tPAYMENTS_SCOPE = \"payments.create\"\n2218\t    14\t\n2219\t    15\t\n2220\t    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n2221\t    17\t    raw = \"|\".join(\n2222\t    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n2223\t    19\t    )\n2224\t    20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n2225\t    21\t\n2226\t    22\t\n2227\t    23\tdef tools(deps) -> list[Tool]:\n2228\t    24\t    settings = deps.settings\n2229\t    25\t\n2230\t    26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n2231\t    27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n2232\t    28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n2233\t    29\t            resp = await client.post(\n2234\t    30\t                f\"{settings.payments_api_url}/v2/payments\",\n2235\t    31\t                headers={\n2236\t    32\t                    \"Authorization\": f\"Bearer {token}\",\n2237\t    33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n2238\t    34\t                },\n2239\t    35\t                json={\n2240\t    36\t                    \"business_unit\": ident.tenant,\n2241\t    37\t                    \"invoice_reference\": args[\"invoice_id\"],\n2242\t    38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n2243\t    39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n2244\t    40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n2245\t    41\t                },\n2246\t    42\t            )\n2247\t    43\t        resp.raise_for_status()\n2248\t    44\t        body = resp.json()\n2249\t    45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n2250\t    46\t\n2251\t    47\t    return [\n2252\t    48\t        Tool(\n2253\t    49\t            name=\"pay_invoice\",\n2254\t    50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n2255\t    51\t            input_schema={\n2256\t    52\t                \"type\": \"object\",\n2257\t    53\t                \"properties\": {\n2258\t    54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n2259\t    55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n2260\t    56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n2261\t    57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n2262\t    58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n2263\t    59\t                },\n2264\t    60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n2265\t    61\t                \"additionalProperties\": False,\n2266\t    62\t            },\n2267\t    63\t            invoke=pay_invoice,\n2268\t    64\t            target_field=\"invoice_id\",\n2269\t    65\t        )\n2270\t    66\t    ]\n2271\t=== app/tools/slack.py\n2272\t     1\t\"\"\"Slack tool: message staff and vendors, plus the approvals notifier.\"\"\"\n2273\t     2\tfrom __future__ import annotations\n2274\t     3\t\n2275\t     4\tfrom datetime import datetime\n2276\t     5\tfrom typing import Any\n2277\t     6\t\n2278\t     7\timport httpx\n2279\t     8\t\n2280\t     9\tfrom app.identity import RunIdentity\n2281\t    10\tfrom app.redact import redact_text, strip_unapproved_links\n2282\t    11\tfrom app.tools import Tool\n2283\t    12\t\n2284\t    13\tMAX_TEXT = 3000\n2285\t    14\t\n2286\t    15\t\n2287\t    16\tdef clean_outbound(text: str) -> str:\n2288\t    17\t    return strip_unapproved_links(redact_text(text))[:MAX_TEXT]\n2289\t    18\t\n2290\t    19\t\n2291\t    20\tclass SlackClient:\n2292\t    21\t    def __init__(self, api_url: str, bot_token_provider):\n2293\t    22\t        self.api_url = api_url\n2294\t    23\t        self._token = bot_token_provider\n2295\t    24\t\n2296\t    25\t    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:\n2297\t    26\t        payload: dict[str, Any] = {\n2298\t    27\t            \"channel\": channel,\n2299\t    28\t            \"text\": clean_outbound(text),\n2300\t    29\t            \"unfurl_links\": False,\n2301\t    30\t            \"unfurl_media\": False,\n2302\t    31\t            \"mrkdwn\": True,\n2303\t    32\t        }\n2304\t    33\t        if blocks:\n2305\t    34\t            payload[\"blocks\"] = blocks\n2306\t    35\t        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:\n2307\t    36\t            resp = await client.post(\n2308\t    37\t                f\"{self.api_url}/chat.postMessage\",\n2309\t    38\t                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\n2310\t    39\t                json=payload,\n2311\t    40\t            )\n2312\t    41\t        resp.raise_for_status()\n2313\t    42\t        body = resp.json()\n2314\t    43\t        if not body.get(\"ok\"):\n2315\t    44\t            raise RuntimeError(f\"slack error: {body.get('error')}\")\n2316\t    45\t        return {\"channel\": body[\"channel\"], \"ts\": body[\"ts\"]}\n2317\t    46\t\n2318\t    47\t    async def post_approval_request(\n2319\t    48\t        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\n2320\t    49\t    ) -> None:\n2321\t    50\t        lines = \"\\n\".join(f\"• *{k}*: `{v}`\" for k, v in summary.items())\n2322\t    51\t        text = f\"Approval needed for `{tool}` on `{target}` (expires {expires_at:%Y-%m-%d %H:%M} UTC)\\n{lines}\"\n2323\t    52\t        await self.post(\n2324\t    53\t            channel=f\"#approvals-{tenant}\",\n2325\t    54\t            text=text,\n2326\t    55\t            blocks=[\n2327\t    56\t                {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": clean_outbound(text)}},\n2328\t    57\t                {\n2329\t    58\t                    \"type\": \"actions\",\n2330\t    59\t                    \"elements\": [\n2331\t    60\t                        {\"type\": \"button\", \"action_id\": \"approve\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Approve\"}, \"style\": \"primary\"},\n2332\t    61\t                        {\"type\": \"button\", \"action_id\": \"reject\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Reject\"}, \"style\": \"danger\"},\n2333\t    62\t                    ],\n2334\t    63\t                },\n2335\t    64\t            ],\n2336\t    65\t        )\n2337\t    66\t\n2338\t    67\t\n2339\t    68\tdef tools(deps) -> list[Tool]:\n2340\t    69\t    slack: SlackClient = deps.slack\n2341\t    70\t\n2342\t    71\t    async def post_slack_message(args: dict[str, Any], ident: RunIdentity) -> Any:\n2343\t    72\t        return await slack.post(channel=args[\"channel\"], text=args[\"text\"])\n2344\t    73\t\n2345\t    74\t    return [\n2346\t    75\t        Tool(\n2347\t    76\t            name=\"post_slack_message\",\n2348\t    77\t            description=(\n2349\t    78\t                \"Post a message in Slack. Use internal channels for staff. Vendor contacts are in \"\n2350\t    79\t                \"Slack Connect channels named #vendor-<vendor_id>; set external=true for those.\"\n2351\t    80\t            ),\n2352\t    81\t            input_schema={\n2353\t    82\t                \"type\": \"object\",\n2354\t    83\t                \"properties\": {\n2355\t    84\t                    \"channel\": {\"type\": \"string\", \"maxLength\": 80},\n2356\t    85\t                    \"text\": {\"type\": \"string\", \"maxLength\": MAX_TEXT},\n2357\t    86\t                    \"external\": {\"type\": \"boolean\", \"default\": False},\n2358\t    87\t                },\n2359\t    88\t                \"required\": [\"channel\", \"text\"],\n2360\t    89\t                \"additionalProperties\": False,\n2361\t    90\t            },\n2362\t    91\t            invoke=post_slack_message,\n2363\t    92\t            target_field=\"channel\",\n2364\t    93\t        )\n2365\t    94\t    ]\n2366\t"}]},"parent_tool_use_id":null,"session_id":"7b08f688-90d5-4b4c-af7c-eac511a967ff","uuid":"06c5d792-4ecf-426a-b178-68ac3fd3cabb","timestamp":"2026-10-02T14:24:10.873Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-repeat-z0r2wndt/7b08f688-90d5-4b4c-af7c-eac511a967ff/tool-results/bsj8ssif6.txt","content":"     9\tfrom __future__ import annotations\n    10\t\n    11\timport logging\n    12\timport re\n    13\tfrom typing import Any\n    14\tfrom urllib.parse import urlparse\n    15\t\n    16\tSECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n    17\t    (\"bearer\", re.compile(r\"(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]{16,}\")),\n    18\t    (\"jwt\", re.compile(r\"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b\")),\n    19\t    (\"acct_token\", re.compile(r\"\\bacct_tok_[A-Za-z0-9_]{8,}\\b\")),\n    20\t    (\"pay_token\", re.compile(r\"\\bpay_tok_[A-Za-z0-9_]{8,}\\b\")),\n    21\t    (\"erp_session\", re.compile(r\"\\berp_sess_[A-Za-z0-9_]{8,}\\b\")),\n    22\t    (\"password_kv\", re.compile(r\"(?i)\\b(password|passwd|secret|api[_-]?key)\\s*[:=]\\s*\\S+\")),\n    23\t]\n    24\t\n    25\t# Bank details: keep the last four characters so staff can still match records.\n    26\tACCOUNT_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n    27\t    (\"iban\", re.compile(r\"\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b\")),\n    28\t    (\"account_no\", re.compile(r\"(?i)\\b(account|acct|routing)\\s*(no\\.?|number|#)?\\s*[:#]?\\s*(\\d[\\d -]{6,}\\d)\")),\n    29\t]\n    30\t\n    31\tMARKDOWN_IMAGE = re.compile(r\"!\\[[^\\]]*\\]\\(([^)\\s]+)[^)]*\\)\")\n    32\tMARKDOWN_LINK = re.compile(r\"(?<!!)\\[([^\\]]*)\\]\\(([^)\\s]+)[^)]*\\)\")\n    33\tSLACK_LINK = re.compile(r\"<(https?://[^|>]+)(\\|[^>]*)?>\")\n    34\tBARE_URL = re.compile(r\"https?://[^\\s<>()]+\")\n    35\t\n    36\tAPPROVED_LINK_HOSTS = frozenset({\"erp.example-corp.test\", \"intranet.example-corp.test\"})\n    37\t\n    38\t\n    39\tdef _mask_tail(match: re.Match[str]) -> str:\n    40\t    text = match.group(0)\n    41\t    return \"[REDACTED:\" + \"*\" * 4 + text[-4:] + \"]\"\n    42\t\n    43\t\n    44\tdef redact_text(text: str) -> str:\n    45\t    for name, pattern in SECRET_PATTERNS:\n    46\t        text = pattern.sub(f\"[REDACTED:{name}]\", text)\n    47\t    for _name, pattern in ACCOUNT_PATTERNS:\n    48\t        text = pattern.sub(_mask_tail, text)\n    49\t    return text\n    50\t\n    51\t\n    52\tdef redact_value(value: Any) -> Any:\n    53\t    if isinstance(value, str):\n    54\t        return redact_text(value)\n    55\t    if isinstance(value, dict):\n    56\t        return {k: redact_value(v) for k, v in value.items()}\n    57\t    if isinstance(value, (list, tuple)):\n    58\t        return [redact_value(v) for v in value]\n    59\t    return value\n    60\t\n    61\t\n    62\tdef redact_for_model(value: Any) -> str:\n    63\t    if not isinstance(value, str):\n    64\t        import json\n    65\t\n    66\t        value = json.dumps(value, default=str)\n    67\t    return redact_text(value)\n    68\t\n    69\t\n    70\tdef _host_ok(url: str) -> bool:\n    71\t    host = (urlparse(url).hostname or \"\").lower()\n    72\t    return host in APPROVED_LINK_HOSTS\n    73\t\n    74\t\n    75\tdef strip_unapproved_links(text: str) -> str:\n    76\t    \"\"\"Remove images entirely and drop links to hosts outside the allowlist.\n    77\t\n    78\t    Slack and most chat clients fetch link and image URLs to render previews,\n    79\t    so an attacker-chosen URL can carry data out without any tool call.\n    80\t    \"\"\"\n    81\t    text = MARKDOWN_IMAGE.sub(\"[image removed]\", text)\n    82\t    text = MARKDOWN_LINK.sub(\n    83\t        lambda m: m.group(0) if _host_ok(m.group(2)) else m.group(1), text\n    84\t    )\n    85\t    text = SLACK_LINK.sub(\n    86\t        lambda m: m.group(0) if _host_ok(m.group(1)) else \"[link removed]\", text\n    87\t    )\n    88\t    text = BARE_URL.sub(\n    89\t        lambda m: m.group(0) if _host_ok(m.group(0)) else \"[link removed]\", text\n    90\t    )\n    91\t    return text\n    92\t\n    93\t\n    94\tclass RedactingFilter(logging.Filter):\n    95\t    def filter(self, record: logging.LogRecord) -> bool:\n    96\t        if isinstance(record.msg, str):\n    97\t            record.msg = redact_text(record.msg)\n    98\t        if record.args:\n    99\t            record.args = tuple(redact_value(a) for a in record.args)\n   100\t        return True\n=== app/settings.py\n     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t\n    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )\n=== app/startup.py\n     1\t\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\timport logging\n     6\tfrom pathlib import Path\n     7\t\n     8\tfrom app.identity import compute_agent_type_id\n     9\tfrom app.settings import Settings\n    10\t\n    11\tlog = logging.getLogger(__name__)\n    12\t\n    13\t\n    14\tdef sha256_file(path: Path) -> str:\n    15\t    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n    16\t\n    17\t\n    18\tdef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n    19\t    mismatches: list[str] = []\n    20\t    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n    21\t        mismatches.append(f\"image: running {settings.image_digest}\")\n    22\t    for name, entry in manifest[\"prompts\"].items():\n    23\t        path = settings.prompt_dir / Path(entry[\"path\"]).name\n    24\t        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n    25\t            mismatches.append(f\"prompt:{name}\")\n    26\t    for name in (\"policy\", \"tools\"):\n    27\t        entry = manifest[\"config\"][name]\n    28\t        path = settings.policy_path if name == \"policy\" else settings.tools_path\n    29\t        if sha256_file(path) != entry[\"sha256\"]:\n    30\t            mismatches.append(f\"config:{name}\")\n    31\t    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n    32\t        mismatches.append(\"model:primary\")\n    33\t    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n    34\t        mismatches.append(\"model:extractor\")\n    35\t    return mismatches\n    36\t\n    37\t\n    38\tdef startup_checks(settings: Settings) -> str:\n    39\t    \"\"\"Return the agent-type-id for this process.\"\"\"\n    40\t    manifest = settings.manifest\n    41\t    mismatches = running_state_mismatches(settings, manifest)\n    42\t    if mismatches:\n    43\t        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n    44\t    agent_type_id = compute_agent_type_id(manifest)\n    45\t    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n    46\t    return agent_type_id\n=== app/tools/__init__.py\n     1\t\"\"\"Tool registry.\n     2\t\n     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n     5\tthat is not in the run's registry.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom functools import lru_cache\n    11\tfrom typing import Any, Awaitable, Callable\n    12\t\n    13\timport yaml\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\t\n    17\tDEFAULT_ROLE = \"procurement\"\n    18\t\n    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Tool:\n    24\t    name: str\n    25\t    description: str\n    26\t    input_schema: dict[str, Any]\n    27\t    invoke: Invoke\n    28\t    target_field: str | None = None\n    29\t\n    30\t    def target_of(self, args: dict[str, Any]) -> str:\n    31\t        if self.target_field is None:\n    32\t            return self.name\n    33\t        return str(args.get(self.target_field, \"\"))\n    34\t\n    35\t    def schema(self) -> dict[str, Any]:\n    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n    37\t\n    38\t\n    39\tclass ToolRegistry:\n    40\t    def __init__(self, tools: list[Tool]):\n    41\t        self._tools = {t.name: t for t in tools}\n    42\t\n    43\t    def get(self, name: str) -> Tool | None:\n    44\t        return self._tools.get(name)\n    45\t\n    46\t    def names(self) -> list[str]:\n    47\t        return sorted(self._tools)\n    48\t\n    49\t    def schemas(self) -> list[dict[str, Any]]:\n    50\t        return [self._tools[n].schema() for n in self.names()]\n    51\t\n    52\t\n    53\t@lru_cache(maxsize=1)\n    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        cfg = yaml.safe_load(fh)\n    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n    58\t\n    59\t\n    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n    61\t    from app.tools import documents, erp, memory, payments, slack\n    62\t\n    63\t    available: dict[str, Tool] = {}\n    64\t    for module in (documents, erp, memory, payments, slack):\n    65\t        for tool in module.tools(deps):\n    66\t            available[tool.name] = tool\n    67\t\n    68\t    roles = _role_tools(str(deps.settings.tools_path))\n    69\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n    70\t    return ToolRegistry([available[name] for name in allowed if name in available])\n=== app/tools/documents.py\n     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tUNTRUSTED_WRAPPER = (\n    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n    11\t    \"{text}\\n\"\n    12\t    \"</untrusted_document>\"\n    13\t)\n    14\t\n    15\t\n    16\tdef tools(deps) -> list[Tool]:\n    17\t    pool = deps.pool\n    18\t\n    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n    20\t        row = await pool.fetchrow(\n    21\t            \"\"\"\n    22\t            SELECT doc_id, source, media_type, text\n    23\t            FROM documents\n    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n    25\t            \"\"\",\n    26\t            args[\"doc_id\"],\n    27\t            ident.tenant,\n    28\t        )\n    29\t        if row is None:\n    30\t            return \"document not found\"\n    31\t        return UNTRUSTED_WRAPPER.format(\n    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n    33\t        )\n    34\t\n    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n    37\t\n    38\t    return [\n    39\t        Tool(\n    40\t            name=\"read_document\",\n    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n    42\t            input_schema={\n    43\t                \"type\": \"object\",\n    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    45\t                \"required\": [\"doc_id\"],\n    46\t                \"additionalProperties\": False,\n    47\t            },\n    48\t            invoke=read_document,\n    49\t        ),\n    50\t        Tool(\n    51\t            name=\"extract_line_items\",\n    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n    53\t            input_schema={\n    54\t                \"type\": \"object\",\n    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    56\t                \"required\": [\"doc_id\"],\n    57\t                \"additionalProperties\": False,\n    58\t            },\n    59\t            invoke=extract_line_items,\n    60\t        ),\n    61\t    ]\n=== app/tools/erp.py\n     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tERP_READ_SCOPE = \"erp.read\"\n    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n    11\t\n    12\t\n    13\tdef tools(deps) -> list[Tool]:\n    14\t    erp = deps.erp\n    15\t\n    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n    17\t        return await erp.call(\n    18\t            \"budget.get_remaining\",\n    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n    20\t            ident,\n    21\t            ERP_READ_SCOPE,\n    22\t        )\n    23\t\n    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n    25\t        arguments = dict(args.get(\"arguments\", {}))\n    26\t        arguments[\"business_unit\"] = ident.tenant\n    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n    28\t\n    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n    30\t        return await erp.call(\n    31\t            \"po.create\",\n    32\t            {\n    33\t                \"business_unit\": ident.tenant,\n    34\t                \"department\": args[\"department\"],\n    35\t                \"vendor_id\": args[\"vendor_id\"],\n    36\t                \"lines\": args[\"lines\"],\n    37\t                \"currency\": args[\"currency\"],\n    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n    39\t                \"client_reference\": args[\"source_doc_id\"],\n    40\t            },\n    41\t            ident,\n    42\t            ERP_PO_WRITE_SCOPE,\n    43\t        )\n    44\t\n    45\t    line_schema = {\n    46\t        \"type\": \"object\",\n    47\t        \"properties\": {\n    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n    52\t        },\n    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n    54\t        \"additionalProperties\": False,\n    55\t    }\n    56\t\n    57\t    return [\n    58\t        Tool(\n    59\t            name=\"get_budget\",\n    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n    61\t            input_schema={\n    62\t                \"type\": \"object\",\n    63\t                \"properties\": {\n    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n    66\t                },\n    67\t                \"required\": [\"department\", \"fiscal_period\"],\n    68\t                \"additionalProperties\": False,\n    69\t            },\n    70\t            invoke=get_budget,\n    71\t        ),\n    72\t        Tool(\n    73\t            name=\"erp_call\",\n    74\t            description=(\n    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n    77\t            ),\n    78\t            input_schema={\n    79\t                \"type\": \"object\",\n    80\t                \"properties\": {\n    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n    82\t                    \"arguments\": {\"type\": \"object\"},\n    83\t                },\n    84\t                \"required\": [\"operation\"],\n    85\t                \"additionalProperties\": False,\n    86\t            },\n    87\t            invoke=erp_call,\n    88\t        ),\n    89\t        Tool(\n    90\t            name=\"create_purchase_order\",\n    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n    92\t            input_schema={\n    93\t                \"type\": \"object\",\n    94\t                \"properties\": {\n    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n   100\t                },\n   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n   102\t                \"additionalProperties\": False,\n   103\t            },\n   104\t            invoke=create_purchase_order,\n   105\t            target_field=\"source_doc_id\",\n   106\t        ),\n   107\t    ]\n=== app/tools/memory.py\n     1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n     2\t\n     3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n     4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n     5\tuntil a procurement lead verifies them in the admin UI. Every row records\n     6\twho wrote it, from which run and source document, and the context size at\n     7\tthe time.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport re\n    12\timport uuid\n    13\tfrom typing import Any\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\tfrom app.tools import Tool\n    17\t\n    18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n    19\tMAX_NOTE_CHARS = 800\n    20\tINSTRUCTION_LIKE = [\n    21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n    22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n    23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n    24\t    re.compile(r\"https?://\"),\n    25\t]\n    26\t\n    27\t\n    28\tclass NoteRejected(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tdef check_note(text: str) -> None:\n    33\t    if len(text) > MAX_NOTE_CHARS:\n    34\t        raise NoteRejected(\"note too long\")\n    35\t    for pattern in INSTRUCTION_LIKE:\n    36\t        if pattern.search(text):\n    37\t            raise NoteRejected(\"note looks like an instruction\")\n    38\t\n    39\t\n    40\tdef tools(deps) -> list[Tool]:\n    41\t    pool = deps.pool\n    42\t\n    43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n    44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n    45\t        rows = await pool.fetch(\n    46\t            \"\"\"\n    47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n    48\t            FROM dept_notes\n    49\t            WHERE business_unit = $1\n    50\t              AND department = $2\n    51\t              AND NOT quarantined\n    52\t              AND (verified OR expires_at > now())\n    53\t            ORDER BY created_at DESC\n    54\t            LIMIT 20\n    55\t            \"\"\",\n    56\t            business_unit,\n    57\t            args[\"department\"],\n    58\t        )\n    59\t        return [\n    60\t            {\n    61\t                \"note_id\": r[\"note_id\"],\n    62\t                \"kind\": r[\"kind\"],\n    63\t                \"body\": r[\"body\"],\n    64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n    65\t                \"written\": r[\"created_at\"].isoformat(),\n    66\t            }\n    67\t            for r in rows\n    68\t        ]\n    69\t\n    70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n    71\t        if args[\"kind\"] not in NOTE_KINDS:\n    72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n    73\t        check_note(args[\"body\"])\n    74\t        note_id = f\"note-{uuid.uuid4()}\"\n    75\t        ctx = deps.current_context(ident)\n    76\t        await pool.execute(\n    77\t            \"\"\"\n    78\t            INSERT INTO dept_notes (\n    79\t                note_id, business_unit, department, kind, body,\n    80\t                verified, quarantined, expires_at,\n    81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n    82\t                delegated_subject, context_tokens, context_method, created_at\n    83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n    84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n    85\t            \"\"\",\n    86\t            note_id,\n    87\t            ident.tenant,\n    88\t            args[\"department\"],\n    89\t            args[\"kind\"],\n    90\t            args[\"body\"],\n    91\t            ident.agent_instance_id,\n    92\t            ident.agent_type_id,\n    93\t            ident.run_id,\n    94\t            args.get(\"source_doc_id\"),\n    95\t            ident.delegated_subject,\n    96\t            ctx.tokens,\n    97\t            ctx.method,\n    98\t        )\n    99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n   100\t\n   101\t    return [\n   102\t        Tool(\n   103\t            name=\"memory_read\",\n   104\t            description=(\n   105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n   106\t                \"shared-services staff may look up another unit's notes.\"\n   107\t            ),\n   108\t            input_schema={\n   109\t                \"type\": \"object\",\n   110\t                \"properties\": {\n   111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n   113\t                },\n   114\t                \"required\": [\"department\"],\n   115\t                \"additionalProperties\": False,\n   116\t            },\n   117\t            invoke=memory_read,\n   118\t        ),\n   119\t        Tool(\n   120\t            name=\"memory_write\",\n   121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n   122\t            input_schema={\n   123\t                \"type\": \"object\",\n   124\t                \"properties\": {\n   125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n   127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n   128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n   129\t                },\n   130\t                \"required\": [\"department\", \"kind\", \"body\"],\n   131\t                \"additionalProperties\": False,\n   132\t            },\n   133\t            invoke=memory_write,\n   134\t        ),\n   135\t    ]\n=== app/tools/payments.py\n     1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.tools import Tool\n    11\t\n    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n    13\tPAYMENTS_SCOPE = \"payments.create\"\n    14\t\n    15\t\n    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n    17\t    raw = \"|\".join(\n    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n    19\t    )\n    20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n    21\t\n    22\t\n    23\tdef tools(deps) -> list[Tool]:\n    24\t    settings = deps.settings\n    25\t\n    26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n    27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n    28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n    29\t            resp = await client.post(\n    30\t                f\"{settings.payments_api_url}/v2/payments\",\n    31\t                headers={\n    32\t                    \"Authorization\": f\"Bearer {token}\",\n    33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n    34\t                },\n    35\t                json={\n    36\t                    \"business_unit\": ident.tenant,\n    37\t                    \"invoice_reference\": args[\"invoice_id\"],\n    38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n    39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n    40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n    41\t                },\n    42\t            )\n    43\t        resp.raise_for_status()\n    44\t        body = resp.json()\n    45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n    46\t\n    47\t    return [\n    48\t        Tool(\n    49\t            name=\"pay_invoice\",\n    50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n    51\t            input_schema={\n    52\t                \"type\": \"object\",\n    53\t                \"properties\": {\n    54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n    55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n    56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n    57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n    59\t                },\n    60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n    61\t                \"additionalProperties\": False,\n    62\t            },\n    63\t            invoke=pay_invoice,\n    64\t            target_field=\"invoice_id\",\n    65\t        )\n    66\t    ]\n=== app/tools/slack.py\n     1\t\"\"\"Slack tool: message staff and vendors, plus the approvals notifier.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom datetime import datetime\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.redact import redact_text, strip_unapproved_links\n    11\tfrom app.tools import Tool\n    12\t\n    13\tMAX_TEXT = 3000\n    14\t\n    15\t\n    16\tdef clean_outbound(text: str) -> str:\n    17\t    return strip_unapproved_links(redact_text(text))[:MAX_TEXT]\n    18\t\n    19\t\n    20\tclass SlackClient:\n    21\t    def __init__(self, api_url: str, bot_token_provider):\n    22\t        self.api_url = api_url\n    23\t        self._token = bot_token_provider\n    24\t\n    25\t    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:\n    26\t        payload: dict[str, Any] = {\n    27\t            \"channel\": channel,\n    28\t            \"text\": clean_outbound(text),\n    29\t            \"unfurl_links\": False,\n    30\t            \"unfurl_media\": False,\n    31\t            \"mrkdwn\": True,\n    32\t        }\n    33\t        if blocks:\n    34\t            payload[\"blocks\"] = blocks\n    35\t        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:\n    36\t            resp = await client.post(\n    37\t                f\"{self.api_url}/chat.postMessage\",\n    38\t                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\n    39\t                json=payload,\n    40\t            )\n    41\t        resp.raise_for_status()\n    42\t        body = resp.json()\n    43\t        if not body.get(\"ok\"):\n    44\t            raise RuntimeError(f\"slack error: {body.get('error')}\")\n    45\t        return {\"channel\": body[\"channel\"], \"ts\": body[\"ts\"]}\n    46\t\n    47\t    async def post_approval_request(\n    48\t        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\n    49\t    ) -> None:\n    50\t        lines = \"\\n\".join(f\"• *{k}*: `{v}`\" for k, v in summary.items())\n    51\t        text = f\"Approval needed for `{tool}` on `{target}` (expires {expires_at:%Y-%m-%d %H:%M} UTC)\\n{lines}\"\n    52\t        await self.post(\n    53\t            channel=f\"#approvals-{tenant}\",\n    54\t            text=text,\n    55\t            blocks=[\n    56\t                {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": clean_outbound(text)}},\n    57\t                {\n    58\t                    \"type\": \"actions\",\n    59\t                    \"elements\": [\n    60\t                        {\"type\": \"button\", \"action_id\": \"approve\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Approve\"}, \"style\": \"primary\"},\n    61\t                        {\"type\": \"button\", \"action_id\": \"reject\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Reject\"}, \"style\": \"danger\"},\n    62\t                    ],\n    63\t                },\n    64\t            ],\n    65\t        )\n    66\t\n    67\t\n    68\tdef tools(deps) -> list[Tool]:\n    69\t    slack: SlackClient = deps.slack\n    70\t\n    71\t    async def post_slack_message(args: dict[str, Any], ident: RunIdentity) -> Any:\n    72\t        return await slack.post(channel=args[\"channel\"], text=args[\"text\"])\n    73\t\n    74\t    return [\n    75\t        Tool(\n    76\t            name=\"post_slack_message\",\n    77\t            description=(\n    78\t                \"Post a message in Slack. Use internal channels for staff. Vendor contacts are in \"\n    79\t                \"Slack Connect channels named #vendor-<vendor_id>; set external=true for those.\"\n    80\t            ),\n    81\t            input_schema={\n    82\t                \"type\": \"object\",\n    83\t                \"properties\": {\n    84\t                    \"channel\": {\"type\": \"string\", \"maxLength\": 80},\n    85\t                    \"text\": {\"type\": \"string\", \"maxLength\": MAX_TEXT},\n    86\t                    \"external\": {\"type\": \"boolean\", \"default\": False},\n    87\t                },\n    88\t                \"required\": [\"channel\", \"text\"],\n    89\t                \"additionalProperties\": False,\n    90\t            },\n    91\t            invoke=post_slack_message,\n    92\t            target_field=\"channel\",\n    93\t        )\n    94\t    ]\n","numLines":768,"startLine":1599,"totalLines":2366}}}
