by app.mcp_client.fingerprint.\n    70\ttool_pins:\n    71\t  budget.get_remaining: \"sha256:bc96af69ba1cfd67b5428269dc74aa3e754f4dfe2d5dfa81deb0af68819379ca\"\n    72\t  vendor.get: \"sha256:7db5e65fb6d482d06985b19b7f1fce7422398b117bc7482f0380108cd6a6a1fe\"\n    73\t  vendor.search: \"sha256:3bd5aa0908885e967ce8ee1aa22e37b4f4fba867c8eac2b4127bca626731092c\"\n    74\t  vendor.update_remit_to: \"sha256:d3d3916ee6d742311c92f4972a1ffeb0f24782e729351f3e375f13eb05b94c1b\"\n    75\t  invoice.get: \"sha256:848ece38456338a085cb7091a2bbf1024e07946d62beb32a9ee94d2fa2fa8876\"\n    76\t  invoice.list_open: \"sha256:12bb2318f3876da6421183032cdd36727e545275e8eaf6fff66451d09371f12b\"\n    77\t  invoice.mark_paid: \"sha256:3a208eb55ee3a39962316b5d25fe6ba23457380c01aa39a5469ce3691130b05a\"\n    78\t  invoice.void: \"sha256:9645bec805f2ffdfa44f698f49e8701a6487afa3cb3e3c5c44e721cb21633d4c\"\n    79\t  po.get: \"sha256:121df83a279fc2ae3764c83faeb34f3037026586991c9192144ad7b727d18d7b\"\n    80\t  po.list_open: \"sha256:203c57fd158a8edf11b8dc02be534bc805d8caaf0959db8280f59ea0e5beb70a\"\n    81\t  po.create: \"sha256:fb15c157f7d79321972b310d74ee6c88a0fc76fd8edbbe4e821dcaa95a0852c6\"\n    82\t\n    83\tbudgets: config/policy.yaml#budgets\n    84\tidentity:\n    85\t  service_account: procurement-agent\n    86\t  spiffe_id: \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    87\t  sts_audiences: [erp-mcp-gateway, payments-api, slack-proxy]\n    88\tmemory:\n    89\t  store: \"postgres procurement.dept_notes\"\n    90\t  expiry_unverified_days: 30\n    91\tretrieval: none\n     1\tapiVersion: apps/v1\n     2\tkind: Deployment\n     3\tmetadata:\n     4\t  name: procurement-agent\n     5\t  namespace: procurement-prod\n     6\t  labels:\n     7\t    app: procurement-agent\n     8\t    owner: team-procurement-platform\n     9\tspec:\n    10\t  replicas: 3\n    11\t  selector:\n    12\t    matchLabels:\n    13\t      app: procurement-agent\n    14\t  template:\n    15\t    metadata:\n    16\t      labels:\n    17\t        app: procurement-agent\n    18\t    spec:\n    19\t      serviceAccountName: procurement-agent\n    20\t      automountServiceAccountToken: false\n    21\t      hostUsers: false\n    22\t      enableServiceLinks: false\n    23\t      securityContext:\n    24\t        runAsNonRoot: true\n    25\t        runAsUser: 65532\n    26\t        runAsGroup: 65532\n    27\t        fsGroup: 65532\n    28\t        seccompProfile:\n    29\t          type: RuntimeDefault\n    30\t      containers:\n    31\t        - name: agent\n    32\t          image: registry.example-corp.test/procurement/agent@sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\n    33\t          imagePullPolicy: IfNotPresent\n    34\t          ports:\n    35\t            - containerPort: 8080\n    36\t              name: http\n    37\t          env:\n    38\t            - name: IMAGE_DIGEST\n    39\t              value: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n    40\t            - name: MODEL_ID\n    41\t              value: \"claude-sonnet-4-5-20250929\"\n    42\t            - name: EXTRACTOR_MODEL_ID\n    43\t              value: \"claude-haiku-4-5-20251001\"\n    44\t            - name: DATABASE_URL\n    45\t              value: \"postgresql://procurement_agent@procurement-db.procurement-data.svc.cluster.local:5432/procurement?sslmode=verify-full\"\n    46\t            - name: ERP_MCP_URL\n    47\t              value: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\n    48\t            - name: PAYMENTS_API_URL\n    49\t              value: \"https://api.payments.example-pay.test\"\n    50\t            - name: SLACK_API_URL\n    51\t              value: \"https://slack-proxy.egress.svc.cluster.local:8443/api\"\n    52\t            - name: STS_URL\n    53\t              value: \"https://sts.identity.svc.cluster.local/oauth2/token\"\n    54\t            - name: OIDC_ISSUER\n    55\t              value: \"https://login.example-corp.test\"\n    56\t            - name: OIDC_JWKS_URL\n    57\t              value: \"https://login.example-corp.test/.well-known/jwks.json\"\n    58\t            - name: HTTPS_PROXY\n    59\t              value: \"http://egress-proxy.egress.svc.cluster.local:3128\"\n    60\t            - name: NO_PROXY\n    61\t              value: \".svc.cluster.local\"\n    62\t            - name: OTEL_EXPORTER_OTLP_ENDPOINT\n    63\t              value: \"http://otel-collector.observability.svc.cluster.local:4317\"\n    64\t            - name: OTEL_SERVICE_NAME\n    65\t              value: \"procurement-agent\"\n    66\t            - name: OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT\n    67\t              value: \"false\"\n    68\t          securityContext:\n    69\t            allowPrivilegeEscalation: false\n    70\t            privileged: false\n    71\t            readOnlyRootFilesystem: true\n    72\t            runAsNonRoot: true\n    73\t            capabilities:\n    74\t              drop: [\"ALL\"]\n    75\t            seccompProfile:\n    76\t              type: RuntimeDefault\n    77\t          resources:\n    78\t            requests:\n    79\t              cpu: 250m\n    80\t              memory: 512Mi\n    81\t            limits:\n    82\t              cpu: \"1\"\n    83\t              memory: 1Gi\n    84\t          readinessProbe:\n    85\t            httpGet:\n    86\t              path: /healthz\n    87\t              port: http\n    88\t          volumeMounts:\n    89\t            - name: workload-token\n    90\t              mountPath: /var/run/secrets/tokens\n    91\t              readOnly: true\n    92\t            - name: slack-signing\n    93\t              mountPath: /var/run/secrets/slack\n    94\t              readOnly: true\n    95\t            - name: mail-hmac\n    96\t              mountPath: /var/run/secrets/mail\n    97\t              readOnly: true\n    98\t            - name: tmp\n    99\t              mountPath: /tmp\n   100\t      volumes:\n   101\t        - name: workload-token\n   102\t          projected:\n   103\t            sources:\n   104\t              - serviceAccountToken:\n   105\t                  path: procurement-agent\n   106\t                  audience: sts.identity.example-corp.test\n   107\t                  expirationSeconds: 600\n   108\t        - name: slack-signing\n   109\t          secret:\n   110\t            secretName: procurement-slack-signing\n   111\t        - name: mail-hmac\n   112\t          secret:\n   113\t            secretName: procurement-mail-gateway-hmac\n   114\t        - name: tmp\n   115\t          emptyDir:\n   116\t            medium: Memory\n   117\t            sizeLimit: 64Mi\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: procurement-prod\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: latest\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: procurement-agent\n    15\t  namespace: procurement-prod\n    16\t  labels:\n    17\t    app: procurement-agent\n    18\tautomountServiceAccountToken: false\n.\n..\n.github\nDockerfile\nREADME.md\napp\nconfig\ndeploy\nmigrations\nprompts\npyproject.toml\nrelease\ntests\n# procurement-agent\n\nProcurement agent for Example Corp business units. It reads vendor quotes and\ninvoices that arrive by email, checks them against department budgets, raises\npurchase orders in the ERP, pays matched invoices, and talks to staff and\nvendors in Slack. It keeps short per-department notes between runs.\n\n## Architecture\n\n```\nmail gateway --HMAC--> /ingest/mail --> documents (Postgres, per business unit)\nstaff (OIDC JWT) ----> /runs --> ProcurementAgent loop (app/loop.py)\n                                   |-- PolicyGate (app/gate.py) + approvals (Slack buttons)\n                                   |-- Budget (app/budget.py)\n                                   |-- audit graph (app/audit.py -> audit_events)\n                                   |-- tools:\n                                   |     read_document, extract_line_items -> LineItemExtractor sub-agent\n                                   |     get_budget, erp_call, create_purchase_order -> ERP MCP via gateway\n                                   |     pay_invoice -> payments API\n                                   |     post_slack_message -> Slack (via slack-proxy)\n                                   |     memory_read, memory_write -> dept_notes\n```\n\n* **Tenancy.** Each run belongs to one business unit, taken from the `bu`\n  claim of the caller's verified OIDC token. Documents, notes, approvals and\n  quotas are keyed by business unit.\n* **Identity.** The agent runs as the `procurement-agent` service account.\n  Its projected token (10-minute lifetime) is exchanged at the internal STS\n  for audience-bound tokens for the ERP gateway, payments API and Slack\n  proxy. User tokens are never forwarded.\n* **Approvals.** `create_purchase_order`, `pay_invoice` and vendor messages\n  require an approval from a role listed in `config/policy.yaml`. Approval\n  requests are posted to `#approvals-<bu>` with the argument summary.\n* **Budgets.** Per-run step, time, token, cost, tool-rate and sub-agent\n  limits, plus per-user, per-business-unit and fleet quotas for daily spend\n  and run starts. See `config/policy.yaml`.\n* **Audit.** Every run step is a row in `audit_events` linked to its parent\n  step, with the six identity fields, policy version, approval id and\n  decision-time context size. The agent's database role can insert audit\n  rows but not update or delete them.\n\n## Context size\n\nLogged on every audit row as `context_tokens` and `context_method`:\n\n| method | meaning |\n|---|---|\n| `count_tokens_api` | exact request counted with the provider's token-count endpoint before the call (includes cached prefix) |\n| `usage_sum_estimate` | counting failed; `input_tokens + cache_read + cache_creation` from the response |\n| `unavailable` | neither available; `context_tokens` is NULL, never 0 |\n\n`context_compacted` is true when the harness dropped earlier turns before the\ncall (`app/loop.py:_compact`). Provider-side truncation is not visible.\n\n## Operating\n\n* **Halt.** Insert or update a row in `control_flags` (`scope = 'fleet'` or\n  `'tenant:<bu>'`, `halted = true`) as `procurement_ops`. New runs refuse to\n  start while a halt is set.\n* **Release.** Merges to `main` build, sign (keyless cosign), and attest the\n./migrations/001_init.sql:2:-- procurement_owner role; the running agent connects as procurement_agent.\n./migrations/001_init.sql:11:    operational_owner   text NOT NULL CHECK (operational_owner <> ''),\n./app/audit.py:44:    accountable_party, operational_owner, tenant,\n./app/audit.py:101:        ident.operational_owner,\n./app/settings.py:38:    operational_owner: str\n./app/settings.py:86:        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n./app/mcp_client.py:38:class UnknownErpOperation(Exception):\n./app/mcp_client.py:118:            raise UnknownErpOperation(operation)\n./app/main.py:57:        operational_owner=settings.operational_owner,\n./app/main.py:149:        operational_owner=settings.operational_owner,\n./app/identity.py:23:    \"operational_owner\",\n./app/identity.py:34:    operational_owner: str\n./config/policy.yaml:35:    create_purchase_order: [budget_owner, finance_controller]\n./deploy/k8s/deployment.yaml:8:    owner: team-procurement-platform\n./deploy/k8s/networkpolicy.yaml:102:# Egress proxy allowlist (applied in the egress namespace by the platform team).\n./release/manifest.yaml:4:owner: team-procurement-platform\n./release/manifest.yaml:40:    owner: team-procurement-platform\n./release/manifest.yaml:52:    owner: team-procurement-platform\n./release/manifest.yaml:66:    owner: team-erp-integrations","is_error":false}]},"parent_tool_use_id":null,"session_id":"88a2b585-199f-4406-aecf-536336c8de45","uuid":"117f940e-900f-4f45-86af-94d0364e49ab","timestamp":"2026-10-02T14:34:26.311Z","tool_use_result":{"stdout":"     1\t\"\"\"Execution audit graph.\n     2\t\n     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n     5\ttool call -> authorization decision -> result or error. Writes are\n     6\tsynchronous and are made before the action they describe; if the write\n     7\tfails, the caller raises and the action does not run.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport hashlib\n    12\timport json\n    13\timport uuid\n    14\tfrom datetime import datetime, timezone\n    15\tfrom typing import Any\n    16\t\n    17\tfrom opentelemetry import trace\n    18\t\n    19\tfrom app.context_size import ContextMeasure\n    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n    21\tfrom app.redact import redact_value\n    22\t\n    23\tEVENT_KINDS = {\n    24\t    \"run_started\",\n    25\t    \"run_finished\",\n    26\t    \"run_halted\",\n    27\t    \"model_decision\",\n    28\t    \"tool_proposed\",\n    29\t    \"authz_decision\",\n    30\t    \"approval_requested\",\n    31\t    \"approval_decided\",\n    32\t    \"tool_result\",\n    33\t    \"tool_error\",\n    34\t    \"tool_denied\",\n    35\t    \"budget_exceeded\",\n    36\t    \"subagent_started\",\n    37\t    \"subagent_finished\",\n    38\t    \"background_job\",\n    39\t}\n    40\t\n    41\t_INSERT = \"\"\"\n    42\tINSERT INTO audit_events (\n    43\t    node_id, parent_node_id, run_id, ts, kind,\n    44\t    accountable_party, operational_owner, tenant,\n    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n    46\t    delegated_subject, agent_principal, parent_instance_id,\n    47\t    policy_version, approval_id, operation_id,\n    48\t    context_tokens, context_method, context_compacted,\n    49\t    payload\n    50\t) VALUES (\n    51\t    $1, $2, $3, $4, $5,\n    52\t    $6, $7, $8,\n    53\t    $9, $10, $11, $12,\n    54\t    $13, $14, $15,\n    55\t    $16, $17, $18,\n    56\t    $19, $20, $21,\n    57\t    $22::jsonb\n    58\t)\n    59\t\"\"\"\n    60\t\n    61\t\n    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n    64\t    return {k: redact_value(v) for k, v in args.items()}\n    65\t\n    66\t\n    67\tdef digest(value: Any) -> str:\n    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    70\t\n    71\t\n    72\tasync def record(\n    73\t    pool,\n    74\t    ident: RunIdentity,\n    75\t    *,\n    76\t    kind: str,\n    77\t    payload: dict[str, Any] | None = None,\n    78\t    parent: str | None = None,\n    79\t    context: ContextMeasure | None = None,\n    80\t    policy_version: str | None = None,\n    81\t    approval_id: str | None = None,\n    82\t    operation_id: str | None = None,\n    83\t) -> str:\n    84\t    if kind not in EVENT_KINDS:\n    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n    86\t    for name in IDENTITY_FIELDS:\n    87\t        if not getattr(ident, name):\n    88\t            raise ValueError(f\"audit record missing {name}\")\n    89\t    span_ctx = trace.get_current_span().get_span_context()\n    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n    91\t    node_id = f\"node-{uuid.uuid4()}\"\n    92\t    measure = context or ContextMeasure.unavailable()\n    93\t    await pool.execute(\n    94\t        _INSERT,\n    95\t        node_id,\n    96\t        parent,\n    97\t        ident.run_id,\n    98\t        datetime.now(timezone.utc),\n    99\t        kind,\n   100\t        ident.accountable_party,\n   101\t        ident.operational_owner,\n   102\t        ident.tenant,\n   103\t        ident.agent_type_id,\n   104\t        ident.agent_instance_id,\n   105\t        ident.trace_id,\n   106\t        span_id,\n   107\t        ident.delegated_subject,\n   108\t        ident.agent_principal,\n   109\t        ident.parent_instance_id,\n   110\t        policy_version,\n   111\t        approval_id,\n   112\t        operation_id,\n   113\t        measure.tokens,\n   114\t        measure.method,\n   115\t        measure.compacted,\n   116\t        json.dumps(redact_value(payload or {}), default=str),\n   117\t    )\n   118\t    return node_id\n     1\t\"\"\"Operator stop control.\n     2\t\n     3\tOperators halt the fleet or one business unit by setting a row in\n     4\t``control_flags`` with the ``procurement_ops`` database role (see\n     5\tops/README in the platform runbook). The agent's own database role has\n     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\t\n    11\tclass AgentHalted(Exception):\n    12\t    pass\n    13\t\n    14\t\n    15\t_QUERY = \"\"\"\n    16\tSELECT scope, reason, set_by, set_at\n    17\tFROM control_flags\n    18\tWHERE halted\n    19\t  AND (scope = 'fleet' OR scope = $1)\n    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n    21\tLIMIT 1\n    22\t\"\"\"\n    23\t\n    24\t\n    25\tasync def assert_running(pool, tenant: str) -> None:\n    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n    27\t    if row is not None:\n    28\t        raise AgentHalted(\n    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n    31\t        )\n     1\t\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n     2\t\n     3\tThe agent runs under its own Kubernetes service account. Its projected\n     4\tservice-account token is exchanged at the internal STS for short-lived,\n     5\taudience-bound tokens. The launching user's token is never forwarded to an\n     6\tintegration; the user is carried as the delegated subject of the exchange.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport time\n    13\timport uuid\n    14\tfrom dataclasses import dataclass, field, replace\n    15\tfrom pathlib import Path\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.settings import Settings\n    20\t\n    21\tIDENTITY_FIELDS = (\n    22\t    \"accountable_party\",\n    23\t    \"operational_owner\",\n    24\t    \"tenant\",\n    25\t    \"agent_type_id\",\n    26\t    \"agent_instance_id\",\n    27\t    \"trace_id\",\n    28\t)\n    29\t\n    30\t\n    31\t@dataclass(frozen=True)\n    32\tclass RunIdentity:\n    33\t    accountable_party: str\n    34\t    operational_owner: str\n    35\t    tenant: str\n    36\t    agent_type_id: str\n    37\t    agent_instance_id: str\n    38\t    trace_id: str\n    39\t    run_id: str\n    40\t    delegated_subject: str\n    41\t    agent_principal: str\n    42\t    parent_instance_id: str | None = None\n    43\t    role: str = \"procurement\"\n    44\t\n    45\t    def __post_init__(self) -> None:\n    46\t        for name in IDENTITY_FIELDS:\n    47\t            if not getattr(self, name):\n    48\t                raise ValueError(f\"identity field {name} is empty\")\n    49\t\n    50\t    def child(self, role: str) -> \"RunIdentity\":\n    51\t        return replace(\n    52\t            self,\n    53\t            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n    54\t            parent_instance_id=self.agent_instance_id,\n    55\t            role=role,\n    56\t        )\n    57\t\n    58\t\n    59\tdef new_instance_id() -> str:\n    60\t    return f\"inst-{uuid.uuid4()}\"\n    61\t\n    62\t\n    63\tdef compute_agent_type_id(manifest: dict) -> str:\n    64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    65\t    material = {\n    66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n    67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n    68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n    69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n    70\t        \"models\": manifest[\"models\"],\n    71\t        \"config\": manifest[\"config\"],\n    72\t        \"tools\": manifest[\"tool_pins\"],\n    73\t    }\n    74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n    76\t\n    77\t\n    78\t@dataclass\n    79\tclass _CachedToken:\n    80\t    value: str\n    81\t    expires_at: float\n    82\t\n    83\t\n    84\t@dataclass\n    85\tclass TokenBroker:\n    86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n    87\t\n    88\t    settings: Settings\n    89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n    90\t\n    91\t    def _workload_token(self) -> str:\n    92\t        return Path(self.settings.workload_token_path).read_text().strip()\n    93\t\n    94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n    95\t        key = (audience, scope, ident.tenant)\n    96\t        cached = self._cache.get(key)\n    97\t        if cached and cached.expires_at - 30 > time.time():\n    98\t            return cached.value\n    99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n   100\t            resp = await client.post(\n   101\t                self.settings.sts_url,\n   102\t                data={\n   103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n   104\t                    \"subject_token\": self._workload_token(),\n   105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n   106\t                    \"audience\": audience,\n   107\t                    \"scope\": scope,\n   108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n   109\t                    \"actor_token\": ident.delegated_subject,\n   110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n   111\t                },\n   112\t            )\n   113\t            resp.raise_for_status()\n   114\t            body = resp.json()\n   115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n   116\t        self._cache[key] = token\n   117\t        return token.value\n     1\t# Release manifest for the procurement agent. Regenerated by CI on every\n     2\t# release build (see .github/workflows/ci.yaml, job \"release\").\n     3\trelease: \"procurement-agent 2026.09.4\"\n     4\towner: team-procurement-platform\n     5\t\n     6\timage:\n     7\t  repository: registry.example-corp.test/procurement/agent\n     8\t  digest: \"sha256:7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0\"\n     9\t  sbom: \"registry.example-corp.test/procurement/agent:sha256-7c1e4a0f9b3d2e85a6c4f1b0d9e8a7c6b5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0.sbom\"\n    10\t  signer:\n    11\t    issuer: \"https://token.actions.githubusercontent.com\"\n    12\t    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n    13\t\n    14\tharness:\n    15\t  source_commit: \"3f9a1c7e2b8d4f6a0c5e9b1d7f3a8c2e6b4d0f91\"\n    16\t  digest: \"sha256:5b2d8f1a9c3e7b0d4f6a2c8e1b5d9f3a7c0e4b8d2f6a1c5e9b3d7f0a4c8e2b6d\"\n    17\t\n    18\tprompts:\n    19\t  system:\n    20\t    path: prompts/system.md\n    21\t    sha25