               text NOT NULL,\n39\t    requested_by_instance  text NOT NULL,\n40\t    requested_by_run       text NOT NULL,\n41\t    delegated_subject      text NOT NULL,\n42\t    status                 text NOT NULL CHECK (status IN ('pending', 'approved', 'rejected', 'expired')),\n43\t    requested_at           timestamptz NOT NULL,\n44\t    expires_at             timestamptz NOT NULL,\n45\t    approver               text,\n46\t    approver_role          text,\n47\t    decided_at             timestamptz\n48\t);\n49\tCREATE INDEX approvals_lookup ON approvals (tool, target, tenant, status);\n50\t\n51\tCREATE TABLE approvers (\n52\t    slack_user_id  text PRIMARY KEY,\n53\t    email          text NOT NULL,\n54\t    role           text NOT NULL,\n55\t    business_unit  text NOT NULL,\n56\t    active         boolean NOT NULL DEFAULT true\n57\t);\n58\t\n59\tCREATE TABLE documents (\n60\t    doc_id         text PRIMARY KEY,\n61\t    business_unit  text NOT NULL,\n62\t    source         text NOT NULL,\n63\t    media_type     text NOT NULL,\n64\t    sha256         text NOT NULL,\n65\t    status         text NOT NULL CHECK (status IN ('accepted', 'quarantined')),\n66\t    reject_reason  text,\n67\t    text           text,\n68\t    received_at    timestamptz NOT NULL\n69\t);\n70\tCREATE INDEX documents_bu ON documents (business_unit, doc_id);\n71\t\n72\tCREATE TABLE dept_notes (\n73\t    note_id            text PRIMARY KEY,\n74\t    business_unit      text NOT NULL,\n75\t    department         text NOT NULL,\n76\t    kind               text NOT NULL,\n77\t    body               text NOT NULL,\n78\t    verified           boolean NOT NULL DEFAULT false,\n79\t    verified_by        text,\n80\t    quarantined        boolean NOT NULL DEFAULT false,\n81\t    expires_at         timestamptz,\n82\t    writer_instance    text NOT NULL,\n83\t    writer_type_id     text NOT NULL,\n84\t    run_id             text NOT NULL,\n85\t    source_doc_id      text,\n86\t    delegated_subject  text NOT NULL,\n87\t    context_tokens     integer,\n88\t    context_method     text NOT NULL,\n89\t    created_at         timestamptz NOT NULL\n90\t);\n91\tCREATE INDEX dept_notes_lookup ON dept_notes (business_unit, department, created_at DESC);\n92\tCREATE INDEX dept_notes_source ON dept_notes (source_doc_id);\n93\tCREATE INDEX dept_notes_writer ON dept_notes (writer_instance);\n94\t\n95\tCREATE TABLE control_flags (\n96\t    scope    text PRIMARY KEY,           -- 'fleet' or 'tenant:<business_unit>'\n97\t    halted   boolean NOT NULL,\n98\t    reason   text NOT NULL,\n99\t    set_by   text NOT NULL,\n100\t    set_at   timestamptz NOT NULL DEFAULT now()\n101\t);\n102\t\n103\tCREATE TABLE spend_quota (\n104\t    scope      text NOT NULL,\n105\t    key        text NOT NULL,\n106\t    day        date NOT NULL,\n107\t    spent_usd  numeric(12, 4) NOT NULL,\n108\t    PRIMARY KEY (scope, key, day)\n109\t);\n110\t\n111\tCREATE TABLE run_start_window (\n112\t    scope   text NOT NULL,\n113\t    key     text NOT NULL,\n114\t    minute  timestamptz NOT NULL,\n115\t    starts  integer NOT NULL,\n116\t    PRIMARY KEY (scope, key, minute)\n117\t);\n118\t\n119\t-- Runtime role: append-only audit, no access to control flags beyond reading.\n120\tREVOKE ALL ON ALL TABLES IN SCHEMA public FROM procurement_agent;\n121\tGRANT SELECT, INSERT ON audit_events TO procurement_agent;\n122\tGRANT SELECT, INSERT, UPDATE ON approvals TO procurement_agent;\n123\tGRANT SELECT ON approvers TO procurement_agent;\n124\tGRANT SELECT, INSERT ON documents TO procurement_agent;\n125\tGRANT SELECT, INSERT ON dept_notes TO procurement_agent;\n126\tGRANT SELECT ON control_flags TO procurement_agent;\n127\tGRANT SELECT, INSERT, UPDATE ON spend_quota TO procurement_agent;\n128\tGRANT SELECT, INSERT, UPDATE ON run_start_window TO procurement_agent;\n129\t\n130\t-- Operators: halt and resume.\n131\tGRANT SELECT, INSERT, UPDATE ON control_flags TO procurement_ops;\n132\tGRANT SELECT ON audit_events TO procurement_ops;\n133\tGRANT SELECT, UPDATE (verified, verified_by, quarantined) ON dept_notes TO procurement_ops;\n134\t"}]},"parent_tool_use_id":null,"session_id":"e30581cc-d62e-42e3-b45d-42b74e7ca505","uuid":"987452e8-2061-46fa-b237-c59b980bef2b","timestamp":"2026-10-02T14:46:59.421Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-ntgh937c/agent/migrations/001_init.sql","content":"-- Procurement agent schema. Applied by the migration job with the\n-- procurement_owner role; the running agent connects as procurement_agent.\n\nCREATE TABLE audit_events (\n    node_id             text PRIMARY KEY,\n    parent_node_id      text REFERENCES audit_events (node_id),\n    run_id              text NOT NULL,\n    ts                  timestamptz NOT NULL,\n    kind                text NOT NULL,\n    accountable_party   text NOT NULL CHECK (accountable_party <> ''),\n    operational_owner   text NOT NULL CHECK (operational_owner <> ''),\n    tenant              text NOT NULL CHECK (tenant <> ''),\n    agent_type_id       text NOT NULL CHECK (agent_type_id <> ''),\n    agent_instance_id   text NOT NULL CHECK (agent_instance_id <> ''),\n    trace_id            text NOT NULL CHECK (trace_id <> ''),\n    span_id             text,\n    delegated_subject   text NOT NULL,\n    agent_principal     text NOT NULL,\n    parent_instance_id  text,\n    policy_version      text,\n    approval_id         text,\n    operation_id        text,\n    context_tokens      integer CHECK (context_tokens IS NULL OR context_tokens > 0),\n    context_method      text NOT NULL,\n    context_compacted   boolean NOT NULL,\n    payload             jsonb NOT NULL\n);\nCREATE INDEX audit_events_run ON audit_events (run_id, ts);\nCREATE INDEX audit_events_instance ON audit_events (agent_instance_id, ts);\nCREATE INDEX audit_events_trace ON audit_events (trace_id);\n\nCREATE TABLE approvals (\n    id                     text PRIMARY KEY,\n    tool                   text NOT NULL,\n    target                 text NOT NULL,\n    args_sha256            text NOT NULL,\n    args_summary           jsonb NOT NULL,\n    tenant                 text NOT NULL,\n    requested_by_instance  text NOT NULL,\n    requested_by_run       text NOT NULL,\n    delegated_subject      text NOT NULL,\n    status                 text NOT NULL CHECK (status IN ('pending', 'approved', 'rejected', 'expired')),\n    requested_at           timestamptz NOT NULL,\n    expires_at             timestamptz NOT NULL,\n    approver               text,\n    approver_role          text,\n    decided_at             timestamptz\n);\nCREATE INDEX approvals_lookup ON approvals (tool, target, tenant, status);\n\nCREATE TABLE approvers (\n    slack_user_id  text PRIMARY KEY,\n    email          text NOT NULL,\n    role           text NOT NULL,\n    business_unit  text NOT NULL,\n    active         boolean NOT NULL DEFAULT true\n);\n\nCREATE TABLE documents (\n    doc_id         text PRIMARY KEY,\n    business_unit  text NOT NULL,\n    source         text NOT NULL,\n    media_type     text NOT NULL,\n    sha256         text NOT NULL,\n    status         text NOT NULL CHECK (status IN ('accepted', 'quarantined')),\n    reject_reason  text,\n    text           text,\n    received_at    timestamptz NOT NULL\n);\nCREATE INDEX documents_bu ON documents (business_unit, doc_id);\n\nCREATE TABLE dept_notes (\n    note_id            text PRIMARY KEY,\n    business_unit      text NOT NULL,\n    department         text NOT NULL,\n    kind               text NOT NULL,\n    body               text NOT NULL,\n    verified           boolean NOT NULL DEFAULT false,\n    verified_by        text,\n    quarantined        boolean NOT NULL DEFAULT false,\n    expires_at         timestamptz,\n    writer_instance    text NOT NULL,\n    writer_type_id     text NOT NULL,\n    run_id             text NOT NULL,\n    source_doc_id      text,\n    delegated_subject  text NOT NULL,\n    context_tokens     integer,\n    context_method     text NOT NULL,\n    created_at         timestamptz NOT NULL\n);\nCREATE INDEX dept_notes_lookup ON dept_notes (business_unit, department, created_at DESC);\nCREATE INDEX dept_notes_source ON dept_notes (source_doc_id);\nCREATE INDEX dept_notes_writer ON dept_notes (writer_instance);\n\nCREATE TABLE control_flags (\n    scope    text PRIMARY KEY,           -- 'fleet' or 'tenant:<business_unit>'\n    halted   boolean NOT NULL,\n    reason   text NOT NULL,\n    set_by   text NOT NULL,\n    set_at   timestamptz NOT NULL DEFAULT now()\n);\n\nCREATE TABLE spend_quota (\n    scope      text NOT NULL,\n    key        text NOT NULL,\n    day        date NOT NULL,\n    spent_usd  numeric(12, 4) NOT NULL,\n    PRIMARY KEY (scope, key, day)\n);\n\nCREATE TABLE run_start_window (\n    scope   text NOT NULL,\n    key     text NOT NULL,\n    minute  timestamptz NOT NULL,\n    starts  integer NOT NULL,\n    PRIMARY KEY (scope, key, minute)\n);\n\n-- Runtime role: append-only audit, no access to control flags beyond reading.\nREVOKE ALL ON ALL TABLES IN SCHEMA public FROM procurement_agent;\nGRANT SELECT, INSERT ON audit_events TO procurement_agent;\nGRANT SELECT, INSERT, UPDATE ON approvals TO procurement_agent;\nGRANT SELECT ON approvers TO procurement_agent;\nGRANT SELECT, INSERT ON documents TO procurement_agent;\nGRANT SELECT, INSERT ON dept_notes TO procurement_agent;\nGRANT SELECT ON control_flags TO procurement_agent;\nGRANT SELECT, INSERT, UPDATE ON spend_quota TO procurement_agent;\nGRANT SELECT, INSERT, UPDATE ON run_start_window TO procurement_agent;\n\n-- Operators: halt and resume.\nGRANT SELECT, INSERT, UPDATE ON control_flags TO procurement_ops;\nGRANT SELECT ON audit_events TO procurement_ops;\nGRANT SELECT, UPDATE (verified, verified_by, quarantined) ON dept_notes TO procurement_ops;\n","numLines":134,"startLine":1,"totalLines":134}}}
