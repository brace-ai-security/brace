{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UWR6xjjgCxUqyAtgHyYrgB","type":"tool_result","content":"1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport hashlib\n5\tfrom typing import Any\n6\t\n7\timport httpx\n8\t\n9\tfrom app.identity import RunIdentity\n10\tfrom app.tools import Tool\n11\t\n12\tPAYMENTS_AUDIENCE = \"payments-api\"\n13\tPAYMENTS_SCOPE = \"payments.create\"\n14\t\n15\t\n16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n17\t    raw = \"|\".join(\n18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n19\t    )\n20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n21\t\n22\t\n23\tdef tools(deps) -> list[Tool]:\n24\t    settings = deps.settings\n25\t\n26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n29\t            resp = await client.post(\n30\t                f\"{settings.payments_api_url}/v2/payments\",\n31\t                headers={\n32\t                    \"Authorization\": f\"Bearer {token}\",\n33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n34\t                },\n35\t                json={\n36\t                    \"business_unit\": ident.tenant,\n37\t                    \"invoice_reference\": args[\"invoice_id\"],\n38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n41\t                },\n42\t            )\n43\t        resp.raise_for_status()\n44\t        body = resp.json()\n45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n46\t\n47\t    return [\n48\t        Tool(\n49\t            name=\"pay_invoice\",\n50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n51\t            input_schema={\n52\t                \"type\": \"object\",\n53\t                \"properties\": {\n54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n59\t                },\n60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n61\t                \"additionalProperties\": False,\n62\t            },\n63\t            invoke=pay_invoice,\n64\t            target_field=\"invoice_id\",\n65\t        )\n66\t    ]\n67\t"}]},"parent_tool_use_id":null,"session_id":"e30581cc-d62e-42e3-b45d-42b74e7ca505","uuid":"3a9da7d1-5ecb-407e-8432-31b537e7695c","timestamp":"2026-10-02T14:46:59.781Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-ntgh937c/agent/app/tools/payments.py","content":"\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nfrom typing import Any\n\nimport httpx\n\nfrom app.identity import RunIdentity\nfrom app.tools import Tool\n\nPAYMENTS_AUDIENCE = \"payments-api\"\nPAYMENTS_SCOPE = \"payments.create\"\n\n\ndef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n    raw = \"|\".join(\n        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n    )\n    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n\n\ndef tools(deps) -> list[Tool]:\n    settings = deps.settings\n\n    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n            resp = await client.post(\n                f\"{settings.payments_api_url}/v2/payments\",\n                headers={\n                    \"Authorization\": f\"Bearer {token}\",\n                    \"Idempotency-Key\": idempotency_key(ident, args),\n                },\n                json={\n                    \"business_unit\": ident.tenant,\n                    \"invoice_reference\": args[\"invoice_id\"],\n                    \"payee_account_id\": args[\"payee_account_id\"],\n                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n                    \"memo\": args.get(\"memo\", \"\")[:140],\n                },\n            )\n        resp.raise_for_status()\n        body = resp.json()\n        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n\n    return [\n        Tool(\n            name=\"pay_invoice\",\n            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n            input_schema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n                },\n                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n                \"additionalProperties\": False,\n            },\n            invoke=pay_invoice,\n            target_field=\"invoice_id\",\n        )\n    ]\n","numLines":67,"startLine":1,"totalLines":67}}}
