{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ACjbuj1FJtfh2CWpUcYJMs","type":"tool_result","content":"1\t\"\"\"Inbound documents: vendor quotes and invoices from the mail gateway.\n2\t\n3\tThe mail gateway posts each received message to ``/ingest/mail`` signed with\n4\tan HMAC over the timestamp and body. Accepted documents are stored per\n5\tbusiness unit and are only ever shown to the model inside an\n6\t``untrusted_document`` wrapper (tools/documents.py).\n7\t\"\"\"\n8\tfrom __future__ import annotations\n9\t\n10\timport base64\n11\timport email\n12\timport email.policy\n13\timport hashlib\n14\timport hmac\n15\timport io\n16\timport re\n17\timport time\n18\timport uuid\n19\tfrom dataclasses import dataclass\n20\tfrom pathlib import Path\n21\t\n22\tfrom fastapi import APIRouter, HTTPException, Request\n23\tfrom pypdf import PdfReader\n24\t\n25\trouter = APIRouter()\n26\t\n27\tMAX_BODY_BYTES = 10 * 1024 * 1024\n28\tMAX_TEXT_CHARS = 200_000\n29\tMAX_SKEW_SECONDS = 300\n30\tALLOWED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\", \"message/rfc822\"}\n31\tSCANNED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\"}\n32\t\n33\tINJECTION_PATTERNS = [\n34\t    re.compile(r\"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)\"),\n35\t    re.compile(r\"(?i)\\b(system|developer) (prompt|message)\\b\"),\n36\t    re.compile(r\"(?i)\\byou are (now )?(an?|the) \\w+ (agent|assistant)\\b\"),\n37\t    re.compile(r\"(?i)\\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\\b\"),\n38\t    re.compile(r\"(?i)\\b(update|change) (our|the) (bank|remit|payee)\\b\"),\n39\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n40\t]\n41\t\n42\t\n43\tclass Rejected(Exception):\n44\t    pass\n45\t\n46\t\n47\t@dataclass\n48\tclass Inbound:\n49\t    business_unit: str\n50\t    sender: str\n51\t    media_type: str\n52\t    raw: bytes\n53\t\n54\t\n55\tdef verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:\n56\t    try:\n57\t        ts = int(timestamp)\n58\t    except ValueError as exc:\n59\t        raise Rejected(\"bad timestamp\") from exc\n60\t    if abs(time.time() - ts) > MAX_SKEW_SECONDS:\n61\t        raise Rejected(\"stale request\")\n62\t    expected = hmac.new(key, f\"{timestamp}.\".encode() + body, hashlib.sha256).hexdigest()\n63\t    if not hmac.compare_digest(expected, signature):\n64\t        raise Rejected(\"bad signature\")\n65\t\n66\t\n67\tdef extract_text(doc: Inbound) -> str:\n68\t    if doc.media_type == \"application/pdf\":\n69\t        reader = PdfReader(io.BytesIO(doc.raw))\n70\t        if len(reader.pages) > 50:\n71\t            raise Rejected(\"too many pages\")\n72\t        return \"\\n\".join(page.extract_text() or \"\" for page in reader.pages)\n73\t    if doc.media_type == \"message/rfc822\":\n74\t        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)\n75\t        body = msg.get_body(preferencelist=(\"plain\", \"html\"))\n76\t        return body.get_content() if body is not None else \"\"\n77\t    return doc.raw.decode(\"utf-8\", errors=\"strict\")\n78\t\n79\t\n80\tdef scan_for_injection(text: str) -> list[str]:\n81\t    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]\n82\t\n83\t\n84\tdef validate(doc: Inbound) -> str:\n85\t    if doc.media_type not in ALLOWED_MEDIA_TYPES:\n86\t        raise Rejected(f\"media type {doc.media_type} not accepted\")\n87\t    if len(doc.raw) > MAX_BODY_BYTES:\n88\t        raise Rejected(\"document too large\")\n89\t    try:\n90\t        text = extract_text(doc)\n91\t    except Rejected:\n92\t        raise\n93\t    except Exception as exc:\n94\t        raise Rejected(f\"unreadable document: {type(exc).__name__}\") from exc\n95\t    if len(text) > MAX_TEXT_CHARS:\n96\t        raise Rejected(\"extracted text too long\")\n97\t    if doc.media_type in SCANNED_MEDIA_TYPES:\n98\t        findings = scan_for_injection(text)\n99\t        if findings:\n100\t            raise Rejected(\"possible prompt injection: \" + \"; \".join(findings))\n101\t    return text\n102\t\n103\t\n104\t@router.post(\"/ingest/mail\")\n105\tasync def ingest_mail(request: Request) -> dict:\n106\t    body = await request.body()\n107\t    if len(body) > MAX_BODY_BYTES * 2:\n108\t        raise HTTPException(413, \"payload too large\")\n109\t    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()\n110\t    try:\n111\t        verify_signature(\n112\t            key,\n113\t            request.headers.get(\"X-Gateway-Timestamp\", \"\"),\n114\t            body,\n115\t            request.headers.get(\"X-Gateway-Signature\", \"\"),\n116\t        )\n117\t    except Rejected as exc:\n118\t        raise HTTPException(401, str(exc)) from exc\n119\t\n120\t    payload = await request.json()\n121\t    doc = Inbound(\n122\t        business_unit=payload[\"business_unit\"],\n123\t        sender=payload[\"from\"],\n124\t        media_type=payload[\"media_type\"],\n125\t        raw=base64.b64decode(payload[\"content_b64\"], validate=True),\n126\t    )\n127\t    doc_id = f\"doc-{uuid.uuid4().hex[:20]}\"\n128\t    pool = request.app.state.pool\n129\t    try:\n130\t        text = validate(doc)\n131\t    except Rejected as exc:\n132\t        await pool.execute(\n133\t            \"\"\"\n134\t            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)\n135\t            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())\n136\t            \"\"\",\n137\t            doc_id, doc.business_unit, doc.sender, doc.media_type,\n138\t            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],\n139\t        )\n140\t        return {\"doc_id\": doc_id, \"status\": \"quarantined\"}\n141\t\n142\t    await pool.execute(\n143\t        \"\"\"\n144\t        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)\n145\t        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())\n146\t        \"\"\",\n147\t        doc_id, doc.business_unit, doc.sender, doc.media_type,\n148\t        hashlib.sha256(doc.raw).hexdigest(), text,\n149\t    )\n150\t    return {\"doc_id\": doc_id, \"status\": \"accepted\"}\n151\t"}]},"parent_tool_use_id":null,"session_id":"44614c7d-6091-45ec-a258-aa100076c00d","uuid":"c6831ae0-722e-4b9c-b2fa-80f12c583b12","timestamp":"2026-10-02T14:46:40.416Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-6y6u3y1y/agent/app/ingest.py","content":"\"\"\"Inbound documents: vendor quotes and invoices from the mail gateway.\n\nThe mail gateway posts each received message to ``/ingest/mail`` signed with\nan HMAC over the timestamp and body. Accepted documents are stored per\nbusiness unit and are only ever shown to the model inside an\n``untrusted_document`` wrapper (tools/documents.py).\n\"\"\"\nfrom __future__ import annotations\n\nimport base64\nimport email\nimport email.policy\nimport hashlib\nimport hmac\nimport io\nimport re\nimport time\nimport uuid\nfrom dataclasses import dataclass\nfrom pathlib import Path\n\nfrom fastapi import APIRouter, HTTPException, Request\nfrom pypdf import PdfReader\n\nrouter = APIRouter()\n\nMAX_BODY_BYTES = 10 * 1024 * 1024\nMAX_TEXT_CHARS = 200_000\nMAX_SKEW_SECONDS = 300\nALLOWED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\", \"message/rfc822\"}\nSCANNED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\"}\n\nINJECTION_PATTERNS = [\n    re.compile(r\"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)\"),\n    re.compile(r\"(?i)\\b(system|developer) (prompt|message)\\b\"),\n    re.compile(r\"(?i)\\byou are (now )?(an?|the) \\w+ (agent|assistant)\\b\"),\n    re.compile(r\"(?i)\\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\\b\"),\n    re.compile(r\"(?i)\\b(update|change) (our|the) (bank|remit|payee)\\b\"),\n    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n]\n\n\nclass Rejected(Exception):\n    pass\n\n\n@dataclass\nclass Inbound:\n    business_unit: str\n    sender: str\n    media_type: str\n    raw: bytes\n\n\ndef verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:\n    try:\n        ts = int(timestamp)\n    except ValueError as exc:\n        raise Rejected(\"bad timestamp\") from exc\n    if abs(time.time() - ts) > MAX_SKEW_SECONDS:\n        raise Rejected(\"stale request\")\n    expected = hmac.new(key, f\"{timestamp}.\".encode() + body, hashlib.sha256).hexdigest()\n    if not hmac.compare_digest(expected, signature):\n        raise Rejected(\"bad signature\")\n\n\ndef extract_text(doc: Inbound) -> str:\n    if doc.media_type == \"application/pdf\":\n        reader = PdfReader(io.BytesIO(doc.raw))\n        if len(reader.pages) > 50:\n            raise Rejected(\"too many pages\")\n        return \"\\n\".join(page.extract_text() or \"\" for page in reader.pages)\n    if doc.media_type == \"message/rfc822\":\n        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)\n        body = msg.get_body(preferencelist=(\"plain\", \"html\"))\n        return body.get_content() if body is not None else \"\"\n    return doc.raw.decode(\"utf-8\", errors=\"strict\")\n\n\ndef scan_for_injection(text: str) -> list[str]:\n    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]\n\n\ndef validate(doc: Inbound) -> str:\n    if doc.media_type not in ALLOWED_MEDIA_TYPES:\n        raise Rejected(f\"media type {doc.media_type} not accepted\")\n    if len(doc.raw) > MAX_BODY_BYTES:\n        raise Rejected(\"document too large\")\n    try:\n        text = extract_text(doc)\n    except Rejected:\n        raise\n    except Exception as exc:\n        raise Rejected(f\"unreadable document: {type(exc).__name__}\") from exc\n    if len(text) > MAX_TEXT_CHARS:\n        raise Rejected(\"extracted text too long\")\n    if doc.media_type in SCANNED_MEDIA_TYPES:\n        findings = scan_for_injection(text)\n        if findings:\n            raise Rejected(\"possible prompt injection: \" + \"; \".join(findings))\n    return text\n\n\n@router.post(\"/ingest/mail\")\nasync def ingest_mail(request: Request) -> dict:\n    body = await request.body()\n    if len(body) > MAX_BODY_BYTES * 2:\n        raise HTTPException(413, \"payload too large\")\n    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()\n    try:\n        verify_signature(\n            key,\n            request.headers.get(\"X-Gateway-Timestamp\", \"\"),\n            body,\n            request.headers.get(\"X-Gateway-Signature\", \"\"),\n        )\n    except Rejected as exc:\n        raise HTTPException(401, str(exc)) from exc\n\n    payload = await request.json()\n    doc = Inbound(\n        business_unit=payload[\"business_unit\"],\n        sender=payload[\"from\"],\n        media_type=payload[\"media_type\"],\n        raw=base64.b64decode(payload[\"content_b64\"], validate=True),\n    )\n    doc_id = f\"doc-{uuid.uuid4().hex[:20]}\"\n    pool = request.app.state.pool\n    try:\n        text = validate(doc)\n    except Rejected as exc:\n        await pool.execute(\n            \"\"\"\n            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)\n            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())\n            \"\"\",\n            doc_id, doc.business_unit, doc.sender, doc.media_type,\n            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],\n        )\n        return {\"doc_id\": doc_id, \"status\": \"quarantined\"}\n\n    await pool.execute(\n        \"\"\"\n        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)\n        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())\n        \"\"\",\n        doc_id, doc.business_unit, doc.sender, doc.media_type,\n        hashlib.sha256(doc.raw).hexdigest(), text,\n    )\n    return {\"doc_id\": doc_id, \"status\": \"accepted\"}\n","numLines":151,"startLine":1,"totalLines":151}}}
