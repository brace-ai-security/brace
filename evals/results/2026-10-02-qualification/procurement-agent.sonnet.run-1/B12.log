tr\n    payments_api_url: str\n    slack_api_url: str\n    sts_url: str\n    oidc_issuer: str\n    oidc_audience: str\n    oidc_jwks_url: str\n    workload_token_path: str\n    slack_signing_secret_path: str\n    mail_gateway_hmac_path: str\n    model_id: str\n    extractor_model_id: str\n    manifest_path: Path\n    prompt_dir: Path\n    policy_path: Path\n    tools_path: Path\n    operational_owner: str\n    image_digest: str\n\n    @property\n    def policy(self) -> dict:\n        return _load_yaml(self.policy_path)\n\n    @property\n    def manifest(self) -> dict:\n        return _load_yaml(self.manifest_path)\n\n    @property\n    def budgets(self) -> dict:\n        return self.policy[\"budgets\"]\n\n\ndef _load_yaml(path: Path) -> dict:\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\n        return yaml.safe_load(fh)\n\n\n@lru_cache(maxsize=1)\ndef get_settings() -> Settings:\n    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    return Settings(\n        database_url=_env(\"DATABASE_URL\"),\n        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n        sts_url=_env(\"STS_URL\"),\n        oidc_issuer=_env(\"OIDC_ISSUER\"),\n        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n        workload_token_path=_env(\n            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n        ),\n        slack_signing_secret_path=_env(\n            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n        ),\n        mail_gateway_hmac_path=_env(\n            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n        ),\n        model_id=_env(\"MODEL_ID\"),\n        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n        manifest_path=root / \"release\" / \"manifest.yaml\",\n        prompt_dir=root / \"prompts\",\n        policy_path=root / \"config\" / \"policy.yaml\",\n        tools_path=root / \"config\" / \"tools.yaml\",\n        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n        image_digest=_env(\"IMAGE_DIGEST\"),\n    )\n\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport logging\nfrom pathlib import Path\n\nfrom app.identity import compute_agent_type_id\nfrom app.settings import Settings\n\nlog = logging.getLogger(__name__)\n\n\ndef sha256_file(path: Path) -> str:\n    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n    mismatches: list[str] = []\n    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n        mismatches.append(f\"image: running {settings.image_digest}\")\n    for name, entry in manifest[\"prompts\"].items():\n        path = settings.prompt_dir / Path(entry[\"path\"]).name\n        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n            mismatches.append(f\"prompt:{name}\")\n    for name in (\"policy\", \"tools\"):\n        entry = manifest[\"config\"][name]\n        path = settings.policy_path if name == \"policy\" else settings.tools_path\n        if sha256_file(path) != entry[\"sha256\"]:\n            mismatches.append(f\"config:{name}\")\n    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n        mismatches.append(\"model:primary\")\n    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n        mismatches.append(\"model:extractor\")\n    return mismatches\n\n\ndef startup_checks(settings: Settings) -> str:\n    \"\"\"Return the agent-type-id for this process.\"\"\"\n    manifest = settings.manifest\n    mismatches = running_state_mismatches(settings, manifest)\n    if mismatches:\n        log.error(\"running state differs from release man