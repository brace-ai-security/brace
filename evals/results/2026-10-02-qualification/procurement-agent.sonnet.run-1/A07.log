{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013xzLz7oMHCtyajqgLdDrKu","type":"tool_result","content":"1\t\"\"\"Line-item extraction sub-agent.\n2\t\n3\tThe parent procurement agent delegates structured extraction to a smaller\n4\tmodel. The child runs under its own instance id, links to its parent in the\n5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\timport json\n10\timport logging\n11\tfrom typing import Any\n12\t\n13\tfrom opentelemetry import trace\n14\t\n15\tfrom app import audit\n16\tfrom app.budget import Budget\n17\tfrom app.context_size import measure_context\n18\tfrom app.identity import RunIdentity\n19\tfrom app.redact import redact_for_model\n20\tfrom app.tools import build_registry\n21\t\n22\tlog = logging.getLogger(__name__)\n23\ttracer = trace.get_tracer(\"procurement.extractor\")\n24\t\n25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n26\tMAX_TURNS = 4\n27\t\n28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n29\t\n30\t\n31\tclass ExtractionFailed(Exception):\n32\t    pass\n33\t\n34\t\n35\tclass LineItemExtractor:\n36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n37\t        self.client = client\n38\t        self.settings = settings\n39\t        self.deps = deps\n40\t        self.system_prompt = system_prompt\n41\t\n42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n43\t        budget.check_subagent()\n44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n47\t\n48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n51\t            start_node = await audit.record(\n52\t                self.deps.pool,\n53\t                ident,\n54\t                kind=\"subagent_started\",\n55\t                payload={\n56\t                    \"role\": EXTRACTOR_ROLE,\n57\t                    \"doc_id\": doc_id,\n58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n59\t                    \"tools\": registry.names(),\n60\t                },\n61\t            )\n62\t\n63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n64\t            for _turn in range(MAX_TURNS):\n65\t                budget.check_step()\n66\t                request = {\n67\t                    \"model\": self.settings.extractor_model_id,\n68\t                    \"system\": self.system_prompt,\n69\t                    \"messages\": messages,\n70\t                    \"tools\": registry.schemas(),\n71\t                    \"max_tokens\": 4096,\n72\t                }\n73\t                ctx = await measure_context(self.client, request, compacted=False)\n74\t                response = await self.client.messages.create(**request)\n75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n76\t                await budget.flush(self.deps.pool)\n77\t                ctx = ctx.finalize(response.usage)\n78\t                decision = await audit.record(\n79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n81\t                             \"stop_reason\": response.stop_reason},\n82\t                )\n83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n85\t                if not uses:\n86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n87\t                    items = _parse_items(text)\n88\t                    await audit.record(\n89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n90\t                        payload={\"items\": len(items)},\n91\t                    )\n92\t                    return items\n93\t                results = []\n94\t                for use in uses:\n95\t                    budget.check_tool_call()\n96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n97\t                messages.append({\"role\": \"user\", \"content\": results})\n98\t\n99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n100\t\n101\t\n102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n103\t    try:\n104\t        data = json.loads(text)\n105\t    except json.JSONDecodeError as exc:\n106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n107\t    if not isinstance(data, list) or len(data) > 500:\n108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n109\t    items = []\n110\t    for raw in data:\n111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n114\t    return items\n115\t"}]},"parent_tool_use_id":null,"session_id":"6eaa3642-4375-45b5-b34d-16db33dd7d82","uuid":"8d38d5a6-6f2b-482d-a969-bdde882799d0","timestamp":"2026-10-02T14:34:49.993Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-6wpxkgcj/agent/app/extractor.py","content":"\"\"\"Line-item extraction sub-agent.\n\nThe parent procurement agent delegates structured extraction to a smaller\nmodel. The child runs under its own instance id, links to its parent in the\naudit graph, charges the parent's budget, and gets the extractor tool role.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport logging\nfrom typing import Any\n\nfrom opentelemetry import trace\n\nfrom app import audit\nfrom app.budget import Budget\nfrom app.context_size import measure_context\nfrom app.identity import RunIdentity\nfrom app.redact import redact_for_model\nfrom app.tools import build_registry\n\nlog = logging.getLogger(__name__)\ntracer = trace.get_tracer(\"procurement.extractor\")\n\nEXTRACTOR_ROLE = \"line_item_extractor\"\nMAX_TURNS = 4\n\nLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n\n\nclass ExtractionFailed(Exception):\n    pass\n\n\nclass LineItemExtractor:\n    def __init__(self, *, client, settings, deps, system_prompt: str):\n        self.client = client\n        self.settings = settings\n        self.deps = deps\n        self.system_prompt = system_prompt\n\n    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n        budget.check_subagent()\n        ident = parent.child(role=EXTRACTOR_ROLE)\n        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n\n        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n            start_node = await audit.record(\n                self.deps.pool,\n                ident,\n                kind=\"subagent_started\",\n                payload={\n                    \"role\": EXTRACTOR_ROLE,\n                    \"doc_id\": doc_id,\n                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n                    \"tools\": registry.names(),\n                },\n            )\n\n            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n            for _turn in range(MAX_TURNS):\n                budget.check_step()\n                request = {\n                    \"model\": self.settings.extractor_model_id,\n                    \"system\": self.system_prompt,\n                    \"messages\": messages,\n                    \"tools\": registry.schemas(),\n                    \"max_tokens\": 4096,\n                }\n                ctx = await measure_context(self.client, request, compacted=False)\n                response = await self.client.messages.create(**request)\n                budget.charge_model(self.settings.extractor_model_id, response.usage)\n                await budget.flush(self.deps.pool)\n                ctx = ctx.finalize(response.usage)\n                decision = await audit.record(\n                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n                             \"stop_reason\": response.stop_reason},\n                )\n                messages.append({\"role\": \"assistant\", \"content\": response.content})\n                uses = [b for b in response.content if b.type == \"tool_use\"]\n                if not uses:\n                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n                    items = _parse_items(text)\n                    await audit.record(\n                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n                        payload={\"items\": len(items)},\n                    )\n                    return items\n                results = []\n                for use in uses:\n                    budget.check_tool_call()\n                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n                messages.append({\"role\": \"user\", \"content\": results})\n\n        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n\n\ndef _parse_items(text: str) -> list[dict[str, Any]]:\n    try:\n        data = json.loads(text)\n    except json.JSONDecodeError as exc:\n        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n    if not isinstance(data, list) or len(data) > 500:\n        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n    items = []\n    for raw in data:\n        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n            raise ExtractionFailed(\"unexpected line-item fields\")\n        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n    return items\n","numLines":115,"startLine":1,"totalLines":115}}}
