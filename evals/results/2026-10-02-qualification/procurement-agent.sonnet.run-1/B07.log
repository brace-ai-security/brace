{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018QVXvNR56ncM1Uyd2bjL94","type":"tool_result","content":"1\t\"\"\"Hard execution budgets, enforced by the harness and not by the model.\n2\t\n3\tPer run: step count, wall-clock time, tokens, cost, tool-call rate, and\n4\tnumber of sub-agents. Sub-agents charge the parent's budget, so a child\n5\tcannot widen what the parent was given.\n6\t\n7\tAcross runs: daily spend and per-minute run starts per user, per tenant\n8\t(business unit), and for the whole fleet. Quotas are reserved in Postgres\n9\tinside one transaction, so concurrent runs cannot overshoot them.\n10\t\"\"\"\n11\tfrom __future__ import annotations\n12\t\n13\timport time\n14\tfrom collections import deque\n15\tfrom dataclasses import dataclass, field\n16\tfrom decimal import Decimal\n17\t\n18\tfrom app.identity import RunIdentity\n19\t\n20\t\n21\tclass BudgetExceeded(Exception):\n22\t    def __init__(self, limit: str, used, allowed):\n23\t        super().__init__(f\"{limit} exceeded: used={used} allowed={allowed}\")\n24\t        self.limit = limit\n25\t        self.used = used\n26\t        self.allowed = allowed\n27\t\n28\t\n29\t# USD per million tokens, from the provider price sheet referenced in the manifest.\n30\tPRICES = {\n31\t    \"claude-sonnet-4-5-20250929\": (Decimal(\"3.00\"), Decimal(\"15.00\")),\n32\t    \"claude-haiku-4-5-20251001\": (Decimal(\"1.00\"), Decimal(\"5.00\")),\n33\t}\n34\t\n35\t\n36\t@dataclass\n37\tclass Budget:\n38\t    ident: RunIdentity\n39\t    max_steps: int\n40\t    max_wall_seconds: float\n41\t    max_tokens: int\n42\t    max_cost_usd: Decimal\n43\t    max_tool_calls_per_minute: int\n44\t    max_subagents: int\n45\t    quotas_daily_usd: dict[str, Decimal]\n46\t    run_starts_per_minute: dict[str, int]\n47\t    started_at: float = field(default_factory=time.monotonic)\n48\t    steps: int = 0\n49\t    tokens: int = 0\n50\t    cost_usd: Decimal = Decimal(\"0\")\n51\t    unflushed_cost_usd: Decimal = Decimal(\"0\")\n52\t    subagents: int = 0\n53\t    _tool_calls: deque = field(default_factory=deque)\n54\t\n55\t    @classmethod\n56\t    def for_run(cls, cfg: dict, ident: RunIdentity) -> \"Budget\":\n57\t        run = cfg[\"per_run\"]\n58\t        return cls(\n59\t            ident=ident,\n60\t            max_steps=int(run[\"max_steps\"]),\n61\t            max_wall_seconds=float(run[\"max_wall_seconds\"]),\n62\t            max_tokens=int(run[\"max_tokens\"]),\n63\t            max_cost_usd=Decimal(str(run[\"max_cost_usd\"])),\n64\t            max_tool_calls_per_minute=int(run[\"max_tool_calls_per_minute\"]),\n65\t            max_subagents=int(run[\"max_subagents\"]),\n66\t            quotas_daily_usd={k: Decimal(str(v)) for k, v in cfg[\"quotas_daily_usd\"].items()},\n67\t            run_starts_per_minute={k: int(v) for k, v in cfg[\"run_starts_per_minute\"].items()},\n68\t        )\n69\t\n70\t    def _scopes(self) -> list[tuple[str, str]]:\n71\t        return [\n72\t            (\"user\", self.ident.accountable_party),\n73\t            (\"tenant\", self.ident.tenant),\n74\t            (\"fleet\", \"all\"),\n75\t        ]\n76\t\n77\t    # --- per-run limits -------------------------------------------------\n78\t\n79\t    def check_step(self) -> None:\n80\t        self.steps += 1\n81\t        if self.steps > self.max_steps:\n82\t            raise BudgetExceeded(\"max_steps\", self.steps, self.max_steps)\n83\t        elapsed = time.monotonic() - self.started_at\n84\t        if elapsed > self.max_wall_seconds:\n85\t            raise BudgetExceeded(\"max_wall_seconds\", round(elapsed, 1), self.max_wall_seconds)\n86\t\n87\t    def charge_model(self, model: str, usage) -> None:\n88\t        price_in, price_out = PRICES[model]\n89\t        tokens_in = (\n90\t            int(usage.input_tokens or 0)\n91\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n92\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n93\t        )\n94\t        tokens_out = int(usage.output_tokens or 0)\n95\t        self.tokens += tokens_in + tokens_out\n96\t        cost = (price_in * tokens_in + price_out * tokens_out) / Decimal(1_000_000)\n97\t        self.cost_usd += cost\n98\t        self.unflushed_cost_usd += cost\n99\t        if self.tokens > self.max_tokens:\n100\t            raise BudgetExceeded(\"max_tokens\", self.tokens, self.max_tokens)\n101\t        if self.cost_usd > self.max_cost_usd:\n102\t            raise BudgetExceeded(\"max_cost_usd\", self.cost_usd, self.max_cost_usd)\n103\t\n104\t    def check_tool_call(self, now: float | None = None) -> None:\n105\t        now = time.monotonic() if now is None else now\n106\t        while self._tool_calls and now - self._tool_calls[0] > 60:\n107\t            self._tool_calls.popleft()\n108\t        if len(self._tool_calls) >= self.max_tool_calls_per_minute:\n109\t            raise BudgetExceeded(\n110\t                \"max_tool_calls_per_minute\", len(self._tool_calls) + 1, self.max_tool_calls_per_minute\n111\t            )\n112\t        self._tool_calls.append(now)\n113\t\n114\t    def check_subagent(self) -> None:\n115\t        if self.subagents >= self.max_subagents:\n116\t            raise BudgetExceeded(\"max_subagents\", self.subagents + 1, self.max_subagents)\n117\t        self.subagents += 1\n118\t\n119\t    # --- cross-run quotas -----------------------------------------------\n120\t\n121\t    async def reserve_run_start(self, pool) -> None:\n122\t        async with pool.acquire() as conn:\n123\t            async with conn.transaction():\n124\t                for scope, key in self._scopes():\n125\t                    limit = self.run_starts_per_minute[scope]\n126\t                    count = await conn.fetchval(\n127\t                        \"\"\"\n128\t                        INSERT INTO run_start_window (scope, key, minute, starts)\n129\t                        VALUES ($1, $2, date_trunc('minute', now()), 1)\n130\t                        ON CONFLICT (scope, key, minute)\n131\t                        DO UPDATE SET starts = run_start_window.starts + 1\n132\t                        RETURNING starts\n133\t                        \"\"\",\n134\t                        scope,\n135\t                        key,\n136\t                    )\n137\t                    if count > limit:\n138\t                        raise BudgetExceeded(f\"run_starts_per_minute.{scope}\", count, limit)\n139\t\n140\t    async def flush(self, pool) -> None:\n141\t        \"\"\"Add this run's unflushed spend to the daily quotas, or stop the run.\"\"\"\n142\t        if self.unflushed_cost_usd <= 0:\n143\t            return\n144\t        amount = self.unflushed_cost_usd\n145\t        async with pool.acquire() as conn:\n146\t            async with conn.transaction():\n147\t                for scope, key in self._scopes():\n148\t                    limit = self.quotas_daily_usd[scope]\n149\t                    spent = await conn.fetchval(\n150\t                        \"\"\"\n151\t                        INSERT INTO spend_quota (scope, key, day, spent_usd)\n152\t                        VALUES ($1, $2, current_date, $3)\n153\t                        ON CONFLICT (scope, key, day)\n154\t                        DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd\n155\t                        RETURNING spent_usd\n156\t                        \"\"\",\n157\t                        scope,\n158\t                        key,\n159\t                        amount,\n160\t                    )\n161\t                    if spent > limit:\n162\t                        raise BudgetExceeded(f\"quota_daily_usd.{scope}\", spent, limit)\n163\t        self.unflushed_cost_usd = Decimal(\"0\")\n164\t"}]},"parent_tool_use_id":null,"session_id":"11c5cfb5-c756-4c56-bc3f-c1ee247c400f","uuid":"304fe6b2-db69-4ea5-b337-e87b893f9825","timestamp":"2026-10-02T14:36:11.160Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-k7oj3g75/agent/app/budget.py","content":"\"\"\"Hard execution budgets, enforced by the harness and not by the model.\n\nPer run: step count, wall-clock time, tokens, cost, tool-call rate, and\nnumber of sub-agents. Sub-agents charge the parent's budget, so a child\ncannot widen what the parent was given.\n\nAcross runs: daily spend and per-minute run starts per user, per tenant\n(business unit), and for the whole fleet. Quotas are reserved in Postgres\ninside one transaction, so concurrent runs cannot overshoot them.\n\"\"\"\nfrom __future__ import annotations\n\nimport time\nfrom collections import deque\nfrom dataclasses import dataclass, field\nfrom decimal import Decimal\n\nfrom app.identity import RunIdentity\n\n\nclass BudgetExceeded(Exception):\n    def __init__(self, limit: str, used, allowed):\n        super().__init__(f\"{limit} exceeded: used={used} allowed={allowed}\")\n        self.limit = limit\n        self.used = used\n        self.allowed = allowed\n\n\n# USD per million tokens, from the provider price sheet referenced in the manifest.\nPRICES = {\n    \"claude-sonnet-4-5-20250929\": (Decimal(\"3.00\"), Decimal(\"15.00\")),\n    \"claude-haiku-4-5-20251001\": (Decimal(\"1.00\"), Decimal(\"5.00\")),\n}\n\n\n@dataclass\nclass Budget:\n    ident: RunIdentity\n    max_steps: int\n    max_wall_seconds: float\n    max_tokens: int\n    max_cost_usd: Decimal\n    max_tool_calls_per_minute: int\n    max_subagents: int\n    quotas_daily_usd: dict[str, Decimal]\n    run_starts_per_minute: dict[str, int]\n    started_at: float = field(default_factory=time.monotonic)\n    steps: int = 0\n    tokens: int = 0\n    cost_usd: Decimal = Decimal(\"0\")\n    unflushed_cost_usd: Decimal = Decimal(\"0\")\n    subagents: int = 0\n    _tool_calls: deque = field(default_factory=deque)\n\n    @classmethod\n    def for_run(cls, cfg: dict, ident: RunIdentity) -> \"Budget\":\n        run = cfg[\"per_run\"]\n        return cls(\n            ident=ident,\n            max_steps=int(run[\"max_steps\"]),\n            max_wall_seconds=float(run[\"max_wall_seconds\"]),\n            max_tokens=int(run[\"max_tokens\"]),\n            max_cost_usd=Decimal(str(run[\"max_cost_usd\"])),\n            max_tool_calls_per_minute=int(run[\"max_tool_calls_per_minute\"]),\n            max_subagents=int(run[\"max_subagents\"]),\n            quotas_daily_usd={k: Decimal(str(v)) for k, v in cfg[\"quotas_daily_usd\"].items()},\n            run_starts_per_minute={k: int(v) for k, v in cfg[\"run_starts_per_minute\"].items()},\n        )\n\n    def _scopes(self) -> list[tuple[str, str]]:\n        return [\n            (\"user\", self.ident.accountable_party),\n            (\"tenant\", self.ident.tenant),\n            (\"fleet\", \"all\"),\n        ]\n\n    # --- per-run limits -------------------------------------------------\n\n    def check_step(self) -> None:\n        self.steps += 1\n        if self.steps > self.max_steps:\n            raise BudgetExceeded(\"max_steps\", self.steps, self.max_steps)\n        elapsed = time.monotonic() - self.started_at\n        if elapsed > self.max_wall_seconds:\n            raise BudgetExceeded(\"max_wall_seconds\", round(elapsed, 1), self.max_wall_seconds)\n\n    def charge_model(self, model: str, usage) -> None:\n        price_in, price_out = PRICES[model]\n        tokens_in = (\n            int(usage.input_tokens or 0)\n            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n        )\n        tokens_out = int(usage.output_tokens or 0)\n        self.tokens += tokens_in + tokens_out\n        cost = (price_in * tokens_in + price_out * tokens_out) / Decimal(1_000_000)\n        self.cost_usd += cost\n        self.unflushed_cost_usd += cost\n        if self.tokens > self.max_tokens:\n            raise BudgetExceeded(\"max_tokens\", self.tokens, self.max_tokens)\n        if self.cost_usd > self.max_cost_usd:\n            raise BudgetExceeded(\"max_cost_usd\", self.cost_usd, self.max_cost_usd)\n\n    def check_tool_call(self, now: float | None = None) -> None:\n        now = time.monotonic() if now is None else now\n        while self._tool_calls and now - self._tool_calls[0] > 60:\n            self._tool_calls.popleft()\n        if len(self._tool_calls) >= self.max_tool_calls_per_minute:\n            raise BudgetExceeded(\n                \"max_tool_calls_per_minute\", len(self._tool_calls) + 1, self.max_tool_calls_per_minute\n            )\n        self._tool_calls.append(now)\n\n    def check_subagent(self) -> None:\n        if self.subagents >= self.max_subagents:\n            raise BudgetExceeded(\"max_subagents\", self.subagents + 1, self.max_subagents)\n        self.subagents += 1\n\n    # --- cross-run quotas -----------------------------------------------\n\n    async def reserve_run_start(self, pool) -> None:\n        async with pool.acquire() as conn:\n            async with conn.transaction():\n                for scope, key in self._scopes():\n                    limit = self.run_starts_per_minute[scope]\n                    count = await conn.fetchval(\n                        \"\"\"\n                        INSERT INTO run_start_window (scope, key, minute, starts)\n                        VALUES ($1, $2, date_trunc('minute', now()), 1)\n                        ON CONFLICT (scope, key, minute)\n                        DO UPDATE SET starts = run_start_window.starts + 1\n                        RETURNING starts\n                        \"\"\",\n                        scope,\n                        key,\n                    )\n                    if count > limit:\n                        raise BudgetExceeded(f\"run_starts_per_minute.{scope}\", count, limit)\n\n    async def flush(self, pool) -> None:\n        \"\"\"Add this run's unflushed spend to the daily quotas, or stop the run.\"\"\"\n        if self.unflushed_cost_usd <= 0:\n            return\n        amount = self.unflushed_cost_usd\n        async with pool.acquire() as conn:\n            async with conn.transaction():\n                for scope, key in self._scopes():\n                    limit = self.quotas_daily_usd[scope]\n                    spent = await conn.fetchval(\n                        \"\"\"\n                        INSERT INTO spend_quota (scope, key, day, spent_usd)\n                        VALUES ($1, $2, current_date, $3)\n                        ON CONFLICT (scope, key, day)\n                        DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd\n                        RETURNING spent_usd\n                        \"\"\",\n                        scope,\n                        key,\n                        amount,\n                    )\n                    if spent > limit:\n                        raise BudgetExceeded(f\"quota_daily_usd.{scope}\", spent, limit)\n        self.unflushed_cost_usd = Decimal(\"0\")\n","numLines":164,"startLine":1,"totalLines":164}}}
