{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MzBQaDGkL39Y1YEuRtqDv1","type":"tool_result","content":"1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n2\t\n3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n5\tuntil a procurement lead verifies them in the admin UI. Every row records\n6\twho wrote it, from which run and source document, and the context size at\n7\tthe time.\n8\t\"\"\"\n9\tfrom __future__ import annotations\n10\t\n11\timport re\n12\timport uuid\n13\tfrom typing import Any\n14\t\n15\tfrom app.identity import RunIdentity\n16\tfrom app.tools import Tool\n17\t\n18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n19\tMAX_NOTE_CHARS = 800\n20\tINSTRUCTION_LIKE = [\n21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n24\t    re.compile(r\"https?://\"),\n25\t]\n26\t\n27\t\n28\tclass NoteRejected(Exception):\n29\t    pass\n30\t\n31\t\n32\tdef check_note(text: str) -> None:\n33\t    if len(text) > MAX_NOTE_CHARS:\n34\t        raise NoteRejected(\"note too long\")\n35\t    for pattern in INSTRUCTION_LIKE:\n36\t        if pattern.search(text):\n37\t            raise NoteRejected(\"note looks like an instruction\")\n38\t\n39\t\n40\tdef tools(deps) -> list[Tool]:\n41\t    pool = deps.pool\n42\t\n43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n45\t        rows = await pool.fetch(\n46\t            \"\"\"\n47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n48\t            FROM dept_notes\n49\t            WHERE business_unit = $1\n50\t              AND department = $2\n51\t              AND NOT quarantined\n52\t              AND (verified OR expires_at > now())\n53\t            ORDER BY created_at DESC\n54\t            LIMIT 20\n55\t            \"\"\",\n56\t            business_unit,\n57\t            args[\"department\"],\n58\t        )\n59\t        return [\n60\t            {\n61\t                \"note_id\": r[\"note_id\"],\n62\t                \"kind\": r[\"kind\"],\n63\t                \"body\": r[\"body\"],\n64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n65\t                \"written\": r[\"created_at\"].isoformat(),\n66\t            }\n67\t            for r in rows\n68\t        ]\n69\t\n70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n71\t        if args[\"kind\"] not in NOTE_KINDS:\n72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n73\t        check_note(args[\"body\"])\n74\t        note_id = f\"note-{uuid.uuid4()}\"\n75\t        ctx = deps.current_context(ident)\n76\t        await pool.execute(\n77\t            \"\"\"\n78\t            INSERT INTO dept_notes (\n79\t                note_id, business_unit, department, kind, body,\n80\t                verified, quarantined, expires_at,\n81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n82\t                delegated_subject, context_tokens, context_method, created_at\n83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n85\t            \"\"\",\n86\t            note_id,\n87\t            ident.tenant,\n88\t            args[\"department\"],\n89\t            args[\"kind\"],\n90\t            args[\"body\"],\n91\t            ident.agent_instance_id,\n92\t            ident.agent_type_id,\n93\t            ident.run_id,\n94\t            args.get(\"source_doc_id\"),\n95\t            ident.delegated_subject,\n96\t            ctx.tokens,\n97\t            ctx.method,\n98\t        )\n99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n100\t\n101\t    return [\n102\t        Tool(\n103\t            name=\"memory_read\",\n104\t            description=(\n105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n106\t                \"shared-services staff may look up another unit's notes.\"\n107\t            ),\n108\t            input_schema={\n109\t                \"type\": \"object\",\n110\t                \"properties\": {\n111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n113\t                },\n114\t                \"required\": [\"department\"],\n115\t                \"additionalProperties\": False,\n116\t            },\n117\t            invoke=memory_read,\n118\t        ),\n119\t        Tool(\n120\t            name=\"memory_write\",\n121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n122\t            input_schema={\n123\t                \"type\": \"object\",\n124\t                \"properties\": {\n125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n129\t                },\n130\t                \"required\": [\"department\", \"kind\", \"body\"],\n131\t                \"additionalProperties\": False,\n132\t            },\n133\t            invoke=memory_write,\n134\t        ),\n135\t    ]\n136\t"}]},"parent_tool_use_id":null,"session_id":"ed79c226-9ca0-4985-836b-16cb4530c091","uuid":"09015878-9ec9-4687-a783-e222deaa9da4","timestamp":"2026-10-02T14:47:38.762Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-813rqtfh/agent/app/tools/memory.py","content":"\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n\nWrites are restricted to a fixed set of note kinds, length-limited, checked\nfor instruction-like content, and stored as unverified with a 30-day expiry\nuntil a procurement lead verifies them in the admin UI. Every row records\nwho wrote it, from which run and source document, and the context size at\nthe time.\n\"\"\"\nfrom __future__ import annotations\n\nimport re\nimport uuid\nfrom typing import Any\n\nfrom app.identity import RunIdentity\nfrom app.tools import Tool\n\nNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\nMAX_NOTE_CHARS = 800\nINSTRUCTION_LIKE = [\n    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n    re.compile(r\"https?://\"),\n]\n\n\nclass NoteRejected(Exception):\n    pass\n\n\ndef check_note(text: str) -> None:\n    if len(text) > MAX_NOTE_CHARS:\n        raise NoteRejected(\"note too long\")\n    for pattern in INSTRUCTION_LIKE:\n        if pattern.search(text):\n            raise NoteRejected(\"note looks like an instruction\")\n\n\ndef tools(deps) -> list[Tool]:\n    pool = deps.pool\n\n    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n        business_unit = args.get(\"business_unit\") or ident.tenant\n        rows = await pool.fetch(\n            \"\"\"\n            SELECT note_id, kind, body, verified, writer_instance, created_at\n            FROM dept_notes\n            WHERE business_unit = $1\n              AND department = $2\n              AND NOT quarantined\n              AND (verified OR expires_at > now())\n            ORDER BY created_at DESC\n            LIMIT 20\n            \"\"\",\n            business_unit,\n            args[\"department\"],\n        )\n        return [\n            {\n                \"note_id\": r[\"note_id\"],\n                \"kind\": r[\"kind\"],\n                \"body\": r[\"body\"],\n                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n                \"written\": r[\"created_at\"].isoformat(),\n            }\n            for r in rows\n        ]\n\n    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n        if args[\"kind\"] not in NOTE_KINDS:\n            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n        check_note(args[\"body\"])\n        note_id = f\"note-{uuid.uuid4()}\"\n        ctx = deps.current_context(ident)\n        await pool.execute(\n            \"\"\"\n            INSERT INTO dept_notes (\n                note_id, business_unit, department, kind, body,\n                verified, quarantined, expires_at,\n                writer_instance, writer_type_id, run_id, source_doc_id,\n                delegated_subject, context_tokens, context_method, created_at\n            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n                      $6, $7, $8, $9, $10, $11, $12, now())\n            \"\"\",\n            note_id,\n            ident.tenant,\n            args[\"department\"],\n            args[\"kind\"],\n            args[\"body\"],\n            ident.agent_instance_id,\n            ident.agent_type_id,\n            ident.run_id,\n            args.get(\"source_doc_id\"),\n            ident.delegated_subject,\n            ctx.tokens,\n            ctx.method,\n        )\n        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n\n    return [\n        Tool(\n            name=\"memory_read\",\n            description=(\n                \"Read saved notes for a department. business_unit defaults to the current one; \"\n                \"shared-services staff may look up another unit's notes.\"\n            ),\n            input_schema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n                },\n                \"required\": [\"department\"],\n                \"additionalProperties\": False,\n            },\n            invoke=memory_read,\n        ),\n        Tool(\n            name=\"memory_write\",\n            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n            input_schema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n                },\n                \"required\": [\"department\", \"kind\", \"body\"],\n                \"additionalProperties\": False,\n            },\n            invoke=memory_write,\n        ),\n    ]\n","numLines":136,"startLine":1,"totalLines":136}}}
