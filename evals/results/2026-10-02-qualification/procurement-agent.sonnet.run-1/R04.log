{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0139WuXJbvTYQQ4GujQbhkP4","type":"tool_result","content":"1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tfrom typing import Any\n5\t\n6\tfrom app.identity import RunIdentity\n7\tfrom app.tools import Tool\n8\t\n9\tUNTRUSTED_WRAPPER = (\n10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n11\t    \"{text}\\n\"\n12\t    \"</untrusted_document>\"\n13\t)\n14\t\n15\t\n16\tdef tools(deps) -> list[Tool]:\n17\t    pool = deps.pool\n18\t\n19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n20\t        row = await pool.fetchrow(\n21\t            \"\"\"\n22\t            SELECT doc_id, source, media_type, text\n23\t            FROM documents\n24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n25\t            \"\"\",\n26\t            args[\"doc_id\"],\n27\t            ident.tenant,\n28\t        )\n29\t        if row is None:\n30\t            return \"document not found\"\n31\t        return UNTRUSTED_WRAPPER.format(\n32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n33\t        )\n34\t\n35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n37\t\n38\t    return [\n39\t        Tool(\n40\t            name=\"read_document\",\n41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n42\t            input_schema={\n43\t                \"type\": \"object\",\n44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n45\t                \"required\": [\"doc_id\"],\n46\t                \"additionalProperties\": False,\n47\t            },\n48\t            invoke=read_document,\n49\t        ),\n50\t        Tool(\n51\t            name=\"extract_line_items\",\n52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n53\t            input_schema={\n54\t                \"type\": \"object\",\n55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n56\t                \"required\": [\"doc_id\"],\n57\t                \"additionalProperties\": False,\n58\t            },\n59\t            invoke=extract_line_items,\n60\t        ),\n61\t    ]\n62\t"}]},"parent_tool_use_id":null,"session_id":"ed79c226-9ca0-4985-836b-16cb4530c091","uuid":"b929cf1e-9f05-4b78-836f-8845f7001a87","timestamp":"2026-10-02T14:47:38.015Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-813rqtfh/agent/app/tools/documents.py","content":"\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom app.identity import RunIdentity\nfrom app.tools import Tool\n\nUNTRUSTED_WRAPPER = (\n    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n    \"{text}\\n\"\n    \"</untrusted_document>\"\n)\n\n\ndef tools(deps) -> list[Tool]:\n    pool = deps.pool\n\n    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n        row = await pool.fetchrow(\n            \"\"\"\n            SELECT doc_id, source, media_type, text\n            FROM documents\n            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n            \"\"\",\n            args[\"doc_id\"],\n            ident.tenant,\n        )\n        if row is None:\n            return \"document not found\"\n        return UNTRUSTED_WRAPPER.format(\n            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n        )\n\n    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n\n    return [\n        Tool(\n            name=\"read_document\",\n            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n            input_schema={\n                \"type\": \"object\",\n                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n                \"required\": [\"doc_id\"],\n                \"additionalProperties\": False,\n            },\n            invoke=read_document,\n        ),\n        Tool(\n            name=\"extract_line_items\",\n            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n            input_schema={\n                \"type\": \"object\",\n                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n                \"required\": [\"doc_id\"],\n                \"additionalProperties\": False,\n            },\n            invoke=extract_line_items,\n        ),\n    ]\n","numLines":62,"startLine":1,"totalLines":62}}}
