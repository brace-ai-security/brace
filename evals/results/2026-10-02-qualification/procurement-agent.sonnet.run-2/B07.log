the run.\"\"\"\n 142          if self.unflushed_cost_usd <= 0:\n 143              return\n 144          amount = self.unflushed_cost_usd\n 145          async with pool.acquire() as conn:\n 146              async with conn.transaction():\n 147                  for scope, key in self._scopes():\n 148                      limit = self.quotas_daily_usd[scope]\n 149                      spent = await conn.fetchval(\n 150                          \"\"\"\n 151>                         INSERT INTO spend_quota (scope, key, day, spent_usd)\n 152                          VALUES ($1, $2, current_date, $3)\n 153                          ON CONFLICT (scope, key, day)\n 154                          DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd\n 155                          RETURNING spent_usd\n 156                          \"\"\",\n 157                          scope,\n 158                          key,\n 159                          amount,\n 160                      )\n 161                      if spent > limit:\n 162                          raise BudgetExceeded(f\"quota_daily_usd.{scope}\", spent, limit)\n 163          self.unflushed_cost_usd = Decimal(\"0\")\n```\n\n## Your answer\n\nWrite this JSON to B07.verdict.json in this folder (or put it in verdicts.json under \"B07\"):\n```json\n{\"verdict\": \"upheld | failed | unclear\",\n \"checks\": [{\"id\": \"B07.1\", \"result\": \"holds | fails | unclear\", \"evidence\": \"path:line\", \"quote\": \"exact code\", \"note\": \"why\"}],\n \"note\": \"one sentence\"}\n```\nVerdict is **failed** if any check fails, **unclear** if none fails but any is unclear, otherwise **upheld**. A failed check needs the quoted line that makes it false: `evidence` is path:line, and `quote` is the exact text of that line. To cite two places, list both refs in `evidence` (`a.py:12, b.yaml:40`) and put each line's text on its own line in `quote`. If the check fails, add `\"violates\": [\"words copied exactly from the requiremen