f\"{n['problem']}->{n['owner']}\" for n in v['not_covered']))\n    for c in v['checks']:\n        print(f\" - {c['id']} {c['check']}\\n   V: {c['verify']}\")\nE\nrm -f /tmp/RA.txt; wc -c ../agent/.ce.txt","description":"Dump C and E checks into workspace scratch file"}},"wire_ingest_context":{"toolu_01RhXmEhQ2eRU2R6j2RmiXpA":{"cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-repeat-038tkh8l/skill"}}}
