{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019LX1vmw35CAQk4j8mMYy5i","type":"tool_result","content":"949\t=== ./app/ingest.py\n950\t     1\t\"\"\"Inbound documents: vendor quotes and invoices from the mail gateway.\n951\t     2\t\n952\t     3\tThe mail gateway posts each received message to ``/ingest/mail`` signed with\n953\t     4\tan HMAC over the timestamp and body. Accepted documents are stored per\n954\t     5\tbusiness unit and are only ever shown to the model inside an\n955\t     6\t``untrusted_document`` wrapper (tools/documents.py).\n956\t     7\t\"\"\"\n957\t     8\tfrom __future__ import annotations\n958\t     9\t\n959\t    10\timport base64\n960\t    11\timport email\n961\t    12\timport email.policy\n962\t    13\timport hashlib\n963\t    14\timport hmac\n964\t    15\timport io\n965\t    16\timport re\n966\t    17\timport time\n967\t    18\timport uuid\n968\t    19\tfrom dataclasses import dataclass\n969\t    20\tfrom pathlib import Path\n970\t    21\t\n971\t    22\tfrom fastapi import APIRouter, HTTPException, Request\n972\t    23\tfrom pypdf import PdfReader\n973\t    24\t\n974\t    25\trouter = APIRouter()\n975\t    26\t\n976\t    27\tMAX_BODY_BYTES = 10 * 1024 * 1024\n977\t    28\tMAX_TEXT_CHARS = 200_000\n978\t    29\tMAX_SKEW_SECONDS = 300\n979\t    30\tALLOWED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\", \"message/rfc822\"}\n980\t    31\tSCANNED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\"}\n981\t    32\t\n982\t    33\tINJECTION_PATTERNS = [\n983\t    34\t    re.compile(r\"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)\"),\n984\t    35\t    re.compile(r\"(?i)\\b(system|developer) (prompt|message)\\b\"),\n985\t    36\t    re.compile(r\"(?i)\\byou are (now )?(an?|the) \\w+ (agent|assistant)\\b\"),\n986\t    37\t    re.compile(r\"(?i)\\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\\b\"),\n987\t    38\t    re.compile(r\"(?i)\\b(update|change) (our|the) (bank|remit|payee)\\b\"),\n988\t    39\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n989\t    40\t]\n990\t    41\t\n991\t    42\t\n992\t    43\tclass Rejected(Exception):\n993\t    44\t    pass\n994\t    45\t\n995\t    46\t\n996\t    47\t@dataclass\n997\t    48\tclass Inbound:\n998\t    49\t    business_unit: str\n999\t    50\t    sender: str\n1000\t    51\t    media_type: str\n1001\t    52\t    raw: bytes\n1002\t    53\t\n1003\t    54\t\n1004\t    55\tdef verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:\n1005\t    56\t    try:\n1006\t    57\t        ts = int(timestamp)\n1007\t    58\t    except ValueError as exc:\n1008\t    59\t        raise Rejected(\"bad timestamp\") from exc\n1009\t    60\t    if abs(time.time() - ts) > MAX_SKEW_SECONDS:\n1010\t    61\t        raise Rejected(\"stale request\")\n1011\t    62\t    expected = hmac.new(key, f\"{timestamp}.\".encode() + body, hashlib.sha256).hexdigest()\n1012\t    63\t    if not hmac.compare_digest(expected, signature):\n1013\t    64\t        raise Rejected(\"bad signature\")\n1014\t    65\t\n1015\t    66\t\n1016\t    67\tdef extract_text(doc: Inbound) -> str:\n1017\t    68\t    if doc.media_type == \"application/pdf\":\n1018\t    69\t        reader = PdfReader(io.BytesIO(doc.raw))\n1019\t    70\t        if len(reader.pages) > 50:\n1020\t    71\t            raise Rejected(\"too many pages\")\n1021\t    72\t        return \"\\n\".join(page.extract_text() or \"\" for page in reader.pages)\n1022\t    73\t    if doc.media_type == \"message/rfc822\":\n1023\t    74\t        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)\n1024\t    75\t        body = msg.get_body(preferencelist=(\"plain\", \"html\"))\n1025\t    76\t        return body.get_content() if body is not None else \"\"\n1026\t    77\t    return doc.raw.decode(\"utf-8\", errors=\"strict\")\n1027\t    78\t\n1028\t    79\t\n1029\t    80\tdef scan_for_injection(text: str) -> list[str]:\n1030\t    81\t    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]\n1031\t    82\t\n1032\t    83\t\n1033\t    84\tdef validate(doc: Inbound) -> str:\n1034\t    85\t    if doc.media_type not in ALLOWED_MEDIA_TYPES:\n1035\t    86\t        raise Rejected(f\"media type {doc.media_type} not accepted\")\n1036\t    87\t    if len(doc.raw) > MAX_BODY_BYTES:\n1037\t    88\t        raise Rejected(\"document too large\")\n1038\t    89\t    try:\n1039\t    90\t        text = extract_text(doc)\n1040\t    91\t    except Rejected:\n1041\t    92\t        raise\n1042\t    93\t    except Exception as exc:\n1043\t    94\t        raise Rejected(f\"unreadable document: {type(exc).__name__}\") from exc\n1044\t    95\t    if len(text) > MAX_TEXT_CHARS:\n1045\t    96\t        raise Rejected(\"extracted text too long\")\n1046\t    97\t    if doc.media_type in SCANNED_MEDIA_TYPES:\n1047\t    98\t        findings = scan_for_injection(text)\n1048\t    99\t        if findings:\n1049\t   100\t            raise Rejected(\"possible prompt injection: \" + \"; \".join(findings))\n1050\t   101\t    return text\n1051\t   102\t\n1052\t   103\t\n1053\t   104\t@router.post(\"/ingest/mail\")\n1054\t   105\tasync def ingest_mail(request: Request) -> dict:\n1055\t   106\t    body = await request.body()\n1056\t   107\t    if len(body) > MAX_BODY_BYTES * 2:\n1057\t   108\t        raise HTTPException(413, \"payload too large\")\n1058\t   109\t    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()\n1059\t   110\t    try:\n1060\t   111\t        verify_signature(\n1061\t   112\t            key,\n1062\t   113\t            request.headers.get(\"X-Gateway-Timestamp\", \"\"),\n1063\t   114\t            body,\n1064\t   115\t            request.headers.get(\"X-Gateway-Signature\", \"\"),\n1065\t   116\t        )\n1066\t   117\t    except Rejected as exc:\n1067\t   118\t        raise HTTPException(401, str(exc)) from exc\n1068\t   119\t\n1069\t   120\t    payload = await request.json()\n1070\t   121\t    doc = Inbound(\n1071\t   122\t        business_unit=payload[\"business_unit\"],\n1072\t   123\t        sender=payload[\"from\"],\n1073\t   124\t        media_type=payload[\"media_type\"],\n1074\t   125\t        raw=base64.b64decode(payload[\"content_b64\"], validate=True),\n1075\t   126\t    )\n1076\t   127\t    doc_id = f\"doc-{uuid.uuid4().hex[:20]}\"\n1077\t   128\t    pool = request.app.state.pool\n1078\t   129\t    try:\n1079\t   130\t        text = validate(doc)\n1080\t   131\t    except Rejected as exc:\n1081\t   132\t        await pool.execute(\n1082\t   133\t            \"\"\"\n1083\t   134\t            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)\n1084\t   135\t            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())\n1085\t   136\t            \"\"\",\n1086\t   137\t            doc_id, doc.business_unit, doc.sender, doc.media_type,\n1087\t   138\t            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],\n1088\t   139\t        )\n1089\t   140\t        return {\"doc_id\": doc_id, \"status\": \"quarantined\"}\n1090\t   141\t\n1091\t   142\t    await pool.execute(\n1092\t   143\t        \"\"\"\n1093\t   144\t        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)\n1094\t   145\t        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())\n1095\t   146\t        \"\"\",\n1096\t   147\t        doc_id, doc.business_unit, doc.sender, doc.media_type,\n1097\t   148\t        hashlib.sha256(doc.raw).hexdigest(), text,\n1098\t   149\t    )\n1099\t   150\t    return {\"doc_id\": doc_id, \"status\": \"accepted\"}\n1100\t=== ./app/killswitch.py\n1101\t     1\t\"\"\"Operator stop control.\n1102\t     2\t\n1103\t     3\tOperators halt the fleet or one business unit by setting a row in\n1104\t     4\t``control_flags`` with the ``procurement_ops`` database role (see\n1105\t     5\tops/README in the platform runbook). The agent's own database role has\n1106\t     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n1107\t     7\t\"\"\"\n1108\t     8\tfrom __future__ import annotations\n1109\t     9\t\n1110\t    10\t\n1111\t    11\tclass AgentHalted(Exception):\n1112\t    12\t    pass\n1113\t    13\t\n1114\t    14\t\n1115\t    15\t_QUERY = \"\"\"\n1116\t    16\tSELECT scope, reason, set_by, set_at\n1117\t    17\tFROM control_flags\n1118\t    18\tWHERE halted\n1119\t    19\t  AND (scope = 'fleet' OR scope = $1)\n1120\t    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n1121\t    21\tLIMIT 1\n1122\t    22\t\"\"\"\n1123\t    23\t\n1124\t    24\t\n1125\t    25\tasync def assert_running(pool, tenant: str) -> None:\n1126\t    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n1127\t    27\t    if row is not None:\n1128\t    28\t        raise AgentHalted(\n1129\t    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n1130\t    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n1131\t    31\t        )\n1132\t=== ./app/loop.py\n1133\t     1\t\"\"\"Procurement agent run loop.\n1134\t     2\t\n1135\t     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n1136\t     4\tEvery edge writes an audit node before the next step runs. Budgets are\n1137\t     5\tchecked before each model turn and each tool call.\n1138\t     6\t\"\"\"\n1139\t     7\tfrom __future__ import annotations\n1140\t     8\t\n1141\t     9\timport hashlib\n1142\t    10\timport logging\n1143\t    11\tfrom dataclasses import dataclass, field\n1144\t    12\tfrom typing import Any\n1145\t    13\t\n1146\t    14\tfrom opentelemetry import trace\n1147\t    15\t\n1148\t    16\tfrom app import audit, killswitch\n1149\t    17\tfrom app.budget import Budget, BudgetExceeded\n1150\t    18\tfrom app.context_size import ContextMeasure, measure_context\n1151\t    19\tfrom app.gate import PolicyGate\n1152\t    20\tfrom app.identity import RunIdentity\n1153\t    21\tfrom app.redact import redact_for_model\n1154\t    22\tfrom app.tools import ToolRegistry, build_registry\n1155\t    23\t\n1156\t    24\tlog = logging.getLogger(__name__)\n1157\t    25\ttracer = trace.get_tracer(\"procurement.loop\")\n1158\t    26\t\n1159\t    27\tCOMPACT_AFTER_MESSAGES = 40\n1160\t    28\tKEEP_RECENT_MESSAGES = 12\n1161\t    29\t\n1162\t    30\t\n1163\t    31\t@dataclass\n1164\t    32\tclass AgentDeps:\n1165\t    33\t    settings: Any\n1166\t    34\t    pool: Any\n1167\t    35\t    gate: PolicyGate\n1168\t    36\t    erp: Any\n1169\t    37\t    slack: Any\n1170\t    38\t    broker: Any\n1171\t    39\t    extractor: Any = None\n1172\t    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n1173\t    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n1174\t    42\t\n1175\t    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n1176\t    44\t        return self._budgets[ident.run_id]\n1177\t    45\t\n1178\t    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n1179\t    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n1180\t    48\t\n1181\t    49\t    def erp_scope_for(self, operation: str) -> str:\n1182\t    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n1183\t    51\t        return scopes.get(operation, \"erp.read\")\n1184\t    52\t\n1185\t    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n1186\t    54\t        self._contexts[ident.agent_instance_id] = ctx\n1187\t    55\t        proposed = await audit.record(\n1188\t    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n1189\t    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n1190\t    58\t        )\n1191\t    59\t        tool = registry.get(use.name)\n1192\t    60\t        if tool is None:\n1193\t    61\t            await audit.record(\n1194\t    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n1195\t    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n1196\t    64\t            )\n1197\t    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n1198\t    66\t\n1199\t    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n1200\t    68\t        authz = await audit.record(\n1201\t    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n1202\t    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n1203\t    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n1204\t    72\t        )\n1205\t    73\t        if not decision.allow:\n1206\t    74\t            if decision.pending:\n1207\t    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n1208\t    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n1209\t    77\t\n1210\t    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n1211\t    79\t        try:\n1212\t    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n1213\t    81\t                for k, v in ctx.otel_attributes().items():\n1214\t    82\t                    span.set_attribute(k, v)\n1215\t    83\t                output = await tool.invoke(use.input, ident)\n1216\t    84\t        except BudgetExceeded:\n1217\t    85\t            raise\n1218\t    86\t        except Exception as exc:\n1219\t    87\t            await audit.record(\n1220\t    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n1221\t    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n1222\t    90\t                operation_id=operation_id,\n1223\t    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n1224\t    92\t            )\n1225\t    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n1226\t    94\t\n1227\t    95\t        await audit.record(\n1228\t    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n1229\t    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n1230\t    98\t            operation_id=operation_id,\n1231\t    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n1232\t   100\t        )\n1233\t   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n1234\t   102\t\n1235\t   103\t\n1236\t   104\tdef _error(tool_use_id: str, message: str) -> dict:\n1237\t   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n1238\t   106\t\n1239\t   107\t\n1240\t   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n1241\t   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n1242\t   110\t        return messages, False\n1243\t   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n1244\t   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n1245\t   113\t        tail = tail[1:]\n1246\t   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n1247\t   115\t    return head + [note] + tail, True\n1248\t   116\t\n1249\t   117\t\n1250\t   118\tclass ProcurementAgent:\n1251\t   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n1252\t   120\t        self.client = client\n1253\t   121\t        self.deps = deps\n1254\t   122\t        self.system_prompt = system_prompt\n1255\t   123\t        self.role = role\n1256\t   124\t\n1257\t   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n1258\t   126\t        pool = self.deps.pool\n1259\t   127\t        await killswitch.assert_running(pool, ident.tenant)\n1260\t   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n1261\t   129\t        await budget.reserve_run_start(pool)\n1262\t   130\t        self.deps._budgets[ident.run_id] = budget\n1263\t   131\t        registry = build_registry(self.role, ident, self.deps)\n1264\t   132\t\n1265\t   133\t        run_node = await audit.record(\n1266\t   134\t            pool, ident, kind=\"run_started\",\n1267\t   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n1268\t   136\t        )\n1269\t   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n1270\t   138\t        try:\n1271\t   139\t            while True:\n1272\t   140\t                budget.check_step()\n1273\t   141\t                messages, compacted = _compact(messages)\n1274\t   142\t                request = {\n1275\t   143\t                    \"model\": self.deps.settings.model_id,\n1276\t   144\t                    \"system\": self.system_prompt,\n1277\t   145\t                    \"messages\": messages,\n1278\t   146\t                    \"tools\": registry.schemas(),\n1279\t   147\t                    \"max_tokens\": 4096,\n1280\t   148\t                }\n1281\t   149\t                ctx = await measure_context(self.client, request, compacted)\n1282\t   150\t                response = await self.client.messages.create(**request)\n1283\t   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n1284\t   152\t                await budget.flush(pool)\n1285\t   153\t                ctx = ctx.finalize(response.usage)\n1286\t   154\t                decision = await audit.record(\n1287\t   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n1288\t   156\t                    payload={\n1289\t   157\t                        \"requested_model\": request[\"model\"],\n1290\t   158\t                        \"served_model\": response.model,\n1291\t   159\t                        \"stop_reason\": response.stop_reason,\n1292\t   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n1293\t   161\t                    },\n1294\t   162\t                )\n1295\t   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n1296\t   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n1297\t   165\t                if not uses:\n1298\t   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n1299\t   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n1300\t   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n1301\t   169\t                    return final\n1302\t   170\t                results = []\n1303\t   171\t                for use in uses:\n1304\t   172\t                    budget.check_tool_call()\n1305\t   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n1306\t   174\t                messages.append({\"role\": \"user\", \"content\": results})\n1307\t   175\t        except BudgetExceeded as exc:\n1308\t   176\t            await audit.record(\n1309\t   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n1310\t   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n1311\t   179\t            )\n1312\t   180\t            await self.deps.slack.post(\n1313\t   181\t                channel=\"#procurement-agent-ops\",\n1314\t   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n1315\t   183\t            )\n1316\t   184\t            return None\n1317\t   185\t        finally:\n1318\t   186\t            self.deps._budgets.pop(ident.run_id, None)\n1319\t=== ./app/main.py\n1320\t     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n1321\t     2\tfrom __future__ import annotations\n1322\t     3\t\n1323\t     4\timport asyncio\n1324\t     5\timport hashlib\n1325\t     6\timport hmac\n1326\t     7\timport json\n1327\t     8\timport logging\n1328\t     9\timport time\n1329\t    10\timport uuid\n1330\t    11\tfrom contextlib import asynccontextmanager\n1331\t    12\tfrom pathlib import Path\n1332\t    13\tfrom urllib.parse import parse_qs\n1333\t    14\t\n1334\t    15\timport asyncpg\n1335\t    16\timport jwt\n1336\t    17\tfrom anthropic import AsyncAnthropic\n1337\t    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n1338\t    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n1339\t    20\tfrom opentelemetry import trace\n1340\t    21\tfrom pydantic import BaseModel, Field\n1341\t    22\t\n1342\t    23\tfrom app import audit, ingest\n1343\t    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n1344\t    25\tfrom app.extractor import LineItemExtractor\n1345\t    26\tfrom app.gate import PolicyGate\n1346\t    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n1347\t    28\tfrom app.loop import AgentDeps, ProcurementAgent\n1348\t    29\tfrom app.mcp_client import ErpMcpClient\n1349\t    30\tfrom app.redact import RedactingFilter\n1350\t    31\tfrom app.settings import get_settings\n1351\t    32\tfrom app.startup import startup_checks\n1352\t    33\tfrom app.tools.slack import SlackClient\n1353\t    34\t\n1354\t    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n1355\t    36\tfor handler in logging.getLogger().handlers:\n1356\t    37\t    handler.addFilter(RedactingFilter())\n1357\t    38\tlog = logging.getLogger(\"procurement\")\n1358\t    39\t\n1359\t    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n1360\t    41\tbearer = HTTPBearer()\n1361\t    42\t\n1362\t    43\t\n1363\t    44\tclass RunRequest(BaseModel):\n1364\t    45\t    task: str = Field(min_length=1, max_length=4000)\n1365\t    46\t    department: str = Field(min_length=1, max_length=64)\n1366\t    47\t\n1367\t    48\t\n1368\t    49\tclass Principal(BaseModel):\n1369\t    50\t    subject: str\n1370\t    51\t    business_unit: str\n1371\t    52\t\n1372\t    53\t\n1373\t    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n1374\t    55\t    return RunIdentity(\n1375\t    56\t        accountable_party=\"system:procurement-agent\",\n1376\t    57\t        operational_owner=settings.operational_owner,\n1377\t    58\t        tenant=tenant,\n1378\t    59\t        agent_type_id=agent_type_id,\n1379\t    60\t        agent_instance_id=new_instance_id(),\n1380\t    61\t        trace_id=uuid.uuid4().hex,\n1381\t    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n1382\t    63\t        delegated_subject=\"system:procurement-agent\",\n1383\t    64\t        agent_principal=AGENT_PRINCIPAL,\n1384\t    65\t    )\n1385\t    66\t\n1386\t    67\t\n1387\t    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n1388\t    69\t    while True:\n1389\t    70\t        await asyncio.sleep(60)\n1390\t    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n1391\t    72\t        count = await app.state.pool.fetchval(\n1392\t    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n1393\t    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n1394\t    75\t        )\n1395\t    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n1396\t    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n1397\t    78\t\n1398\t    79\t\n1399\t    80\t@asynccontextmanager\n1400\t    81\tasync def lifespan(app: FastAPI):\n1401\t    82\t    settings = get_settings()\n1402\t    83\t    agent_type_id = startup_checks(settings)\n1403\t    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n1404\t    85\t    broker = TokenBroker(settings)\n1405\t    86\t\n1406\t    87\t    async def slack_token() -> str:\n1407\t    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n1408\t    89\t\n1409\t    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n1410\t    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n1411\t    92\t    gate = PolicyGate(settings.policy, approvals)\n1412\t    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n1413\t    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n1414\t    95\t\n1415\t    96\t    client = AsyncAnthropic()\n1416\t    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n1417\t    98\t    deps.extractor = LineItemExtractor(\n1418\t    99\t        client=client, settings=settings, deps=deps,\n1419\t   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n1420\t   101\t    )\n1421\t   102\t    app.state.settings = settings\n1422\t   103\t    app.state.pool = pool\n1423\t   104\t    app.state.agent_type_id = agent_type_id\n1424\t   105\t    app.state.approvals = approvals\n1425\t   106\t    app.state.agent = ProcurementAgent(\n1426\t   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n1427\t   108\t    )\n1428\t   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n1429\t   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n1430\t   111\t    try:\n1431\t   112\t        yield\n1432\t   113\t    finally:\n1433\t   114\t        sweeper.cancel()\n1434\t   115\t        await pool.close()\n1435\t   116\t\n1436\t   117\t\n1437\t   118\tapp = FastAPI(lifespan=lifespan)\n1438\t   119\tapp.include_router(ingest.router)\n1439\t   120\t\n1440\t   121\t\n1441\t   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n1442\t   123\t    settings = request.app.state.settings\n1443\t   124\t    try:\n1444\t   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n1445\t   126\t        claims = jwt.decode(\n1446\t   127\t            creds.credentials,\n1447\t   128\t            key.key,\n1448\t   129\t            algorithms=[\"RS256\", \"ES256\"],\n1449\t   130\t            audience=settings.oidc_audience,\n1450\t   131\t            issuer=settings.oidc_issuer,\n1451\t   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n1452\t   133\t        )\n1453\t   134\t    except jwt.PyJWTError as exc:\n1454\t   135\t        raise HTTPException(401, \"invalid token\") from exc\n1455\t   136\t    bu = claims.get(\"bu\")\n1456\t   137\t    if not bu:\n1457\t   138\t        raise HTTPException(403, \"token has no business unit\")\n1458\t   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n1459\t   140\t\n1460\t   141\t\n1461\t   142\t@app.post(\"/runs\")\n1462\t   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n1463\t   144\t    settings = request.app.state.settings\n1464\t   145\t    span_ctx = trace.get_current_span().get_span_context()\n1465\t   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n1466\t   147\t    ident = RunIdentity(\n1467\t   148\t        accountable_party=principal.subject,\n1468\t   149\t        operational_owner=settings.operational_owner,\n1469\t   150\t        tenant=principal.business_unit,\n1470\t   151\t        agent_type_id=request.app.state.agent_type_id,\n1471\t   152\t        agent_instance_id=new_instance_id(),\n1472\t   153\t        trace_id=trace_id,\n1473\t   154\t        run_id=f\"run-{uuid.uuid4()}\",\n1474\t   155\t        delegated_subject=principal.subject,\n1475\t   156\t        agent_principal=AGENT_PRINCIPAL,\n1476\t   157\t    )\n1477\t   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n1478\t   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n1479\t   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n1480\t   161\t\n1481\t   162\t\n1482\t   163\t@app.post(\"/slack/interactions\")\n1483\t   164\tasync def slack_interactions(request: Request) -> dict:\n1484\t   165\t    body = await request.body()\n1485\t   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n1486\t   167\t    if abs(time.time() - int(timestamp)) > 300:\n1487\t   168\t        raise HTTPException(401, \"stale request\")\n1488\t   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n1489\t   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n1490\t   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n1491\t   172\t        raise HTTPException(401, \"bad signature\")\n1492\t   173\t\n1493\t   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n1494\t   175\t    action = payload[\"actions\"][0]\n1495\t   176\t    slack_user = payload[\"user\"][\"id\"]\n1496\t   177\t    row = await request.app.state.pool.fetchrow(\n1497\t   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n1498\t   179\t    )\n1499\t   180\t    if row is None:\n1500\t   181\t        raise HTTPException(403, \"not an approver\")\n1501\t   182\t    try:\n1502\t   183\t        await request.app.state.approvals.decide(\n1503\t   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n1504\t   185\t            approve=action[\"action_id\"] == \"approve\",\n1505\t   186\t        )\n1506\t   187\t    except ApproverNotAuthorized as exc:\n1507\t   188\t        raise HTTPException(403, str(exc)) from exc\n1508\t   189\t    except ValueError as exc:\n1509\t   190\t        raise HTTPException(409, str(exc)) from exc\n1510\t   191\t    return {\"ok\": True}\n1511\t   192\t\n1512\t   193\t\n1513\t   194\t@app.get(\"/healthz\")\n1514\t   195\tasync def healthz() -> dict:\n1515\t   196\t    return {\"ok\": True}\n1516\t=== ./app/mcp_client.py\n1517\t     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n1518\t     2\t\n1519\t     3\tOn startup the tool list is fetched and each tool's description and input\n1520\t     4\tschema are fingerprinted and compared with the pins in the release manifest.\n1521\t     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n1522\t     6\tinstruction-like content before any of it is shown to the model.\n1523\t     7\t\"\"\"\n1524\t     8\tfrom __future__ import annotations\n1525\t     9\t\n1526\t    10\timport hashlib\n1527\t    11\timport json\n1528\t    12\timport logging\n1529\t    13\timport re\n1530\t    14\timport uuid\n1531\t    15\tfrom typing import Any\n1532\t    16\t\n1533\t    17\timport httpx\n1534\t    18\t\n1535\t    19\tfrom app.identity import RunIdentity, TokenBroker\n1536\t    20\tfrom app.redact import redact_text\n1537\t    21\t\n1538\t    22\tlog = logging.getLogger(__name__)\n1539\t    23\t\n1540\t    24\tMAX_DESCRIPTION_CHARS = 1024\n1541\t    25\tSUSPICIOUS_METADATA = [\n1542\t    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n1543\t    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n1544\t    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n1545\t    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n1546\t    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n1547\t    31\t]\n1548\t    32\t\n1549\t    33\t\n1550\t    34\tclass ToolPinMismatch(Exception):\n1551\t    35\t    pass\n1552\t    36\t\n1553\t    37\t\n1554\t    38\tclass UnknownErpOperation(Exception):\n1555\t    39\t    pass\n1556\t    40\t\n1557\t    41\t\n1558\t    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n1559\t    43\t    material = {\n1560\t    44\t        \"name\": tool[\"name\"],\n1561\t    45\t        \"description\": tool.get(\"description\", \"\"),\n1562\t    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n1563\t    47\t        \"annotations\": tool.get(\"annotations\", {}),\n1564\t    48\t    }\n1565\t    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n1566\t    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n1567\t    51\t\n1568\t    52\t\n1569\t    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n1570\t    54\t    description = tool.get(\"description\", \"\")\n1571\t    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n1572\t    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n1573\t    57\t    blob = json.dumps(tool, ensure_ascii=False)\n1574\t    58\t    for pattern in SUSPICIOUS_METADATA:\n1575\t    59\t        if pattern.search(blob):\n1576\t    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n1577\t    61\t\n1578\t    62\t\n1579\t    63\tclass ErpMcpClient:\n1580\t    64\t    AUDIENCE = \"erp-mcp-gateway\"\n1581\t    65\t\n1582\t    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n1583\t    67\t        self.url = url\n1584\t    68\t        self.pins = pins\n1585\t    69\t        self.broker = broker\n1586\t    70\t        self._tools: dict[str, dict[str, Any]] = {}\n1587\t    71\t\n1588\t    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n1589\t    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n1590\t    74\t            resp = await client.post(\n1591\t    75\t                self.url,\n1592\t    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n1593\t    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n1594\t    78\t            )\n1595\t    79\t        resp.raise_for_status()\n1596\t    80\t        if len(resp.content) > 512_000:\n1597\t    81\t            raise ValueError(\"erp response too large\")\n1598\t    82\t        body = resp.json()\n1599\t    83\t        if \"error\" in body:\n1600\t    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n1601\t    85\t        return body[\"result\"]\n1602\t    86\t\n1603\t    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n1604\t    88\t        result = await self._rpc(\"tools/list\", {}, token)\n1605\t    89\t        return list(result.get(\"tools\", []))\n1606\t    90\t\n1607\t    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n1608\t    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n1609\t    93\t        tools = await self._list_tools(token)\n1610\t    94\t        for tool in tools:\n1611\t    95\t            expected = self.pins.get(tool[\"name\"])\n1612\t    96\t            actual = fingerprint(tool)\n1613\t    97\t            if expected != actual:\n1614\t    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n1615\t    99\t            scan_metadata(tool)\n1616\t   100\t        self._tools = {t[\"name\"]: t for t in tools}\n1617\t   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n1618\t   102\t\n1619\t   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n1620\t   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n1621\t   105\t            await self.refresh_tools(service_ident)\n1622\t   106\t\n1623\t   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n1624\t   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n1625\t   109\t        tools = await self._list_tools(token)\n1626\t   110\t        self._tools = {t[\"name\"]: t for t in tools}\n1627\t   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n1628\t   112\t\n1629\t   113\t    def operations(self) -> list[str]:\n1630\t   114\t        return sorted(self._tools)\n1631\t   115\t\n1632\t   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n1633\t   117\t        if operation not in self._tools:\n1634\t   118\t            raise UnknownErpOperation(operation)\n1635\t   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n1636\t   120\t        result = await self._rpc(\n1637\t   121\t            \"tools/call\",\n1638\t   122\t            {\n1639\t   123\t                \"name\": operation,\n1640\t   124\t                \"arguments\": arguments,\n1641\t   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n1642\t   126\t            },\n1643\t   127\t            token,\n1644\t   128\t        )\n1645\t   129\t        if result.get(\"isError\"):\n1646\t   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n1647\t   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n1648\t=== ./app/redact.py\n1649\t     1\t\"\"\"Redaction for model input, logs, audit payloads, and outbound messages.\n1650\t     2\t\n1651\t     3\tApplied in four places:\n1652\t     4\t  * tool results before they are appended to the model context (loop.py)\n1653\t     5\t  * every audit payload (audit.py)\n1654\t     6\t  * the root logging filter (main.py)\n1655\t     7\t  * outbound Slack text (tools/slack.py)\n1656\t     8\t\"\"\"\n1657\t     9\tfrom __future__ import annotations\n1658\t    10\t\n1659\t    11\timport logging\n1660\t    12\timport re\n1661\t    13\tfrom typing import Any\n1662\t    14\tfrom urllib.parse import urlparse\n1663\t    15\t\n1664\t    16\tSECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n1665\t    17\t    (\"bearer\", re.compile(r\"(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]{16,}\")),\n1666\t    18\t    (\"jwt\", re.compile(r\"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b\")),\n1667\t    19\t    (\"acct_token\", re.compile(r\"\\bacct_tok_[A-Za-z0-9_]{8,}\\b\")),\n1668\t    20\t    (\"pay_token\", re.compile(r\"\\bpay_tok_[A-Za-z0-9_]{8,}\\b\")),\n1669\t    21\t    (\"erp_session\", re.compile(r\"\\berp_sess_[A-Za-z0-9_]{8,}\\b\")),\n1670\t    22\t    (\"password_kv\", re.compile(r\"(?i)\\b(password|passwd|secret|api[_-]?key)\\s*[:=]\\s*\\S+\")),\n1671\t    23\t]\n1672\t    24\t\n1673\t    25\t# Bank details: keep the last four characters so staff can still match records.\n1674\t    26\tACCOUNT_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n1675\t    27\t    (\"iban\", re.compile(r\"\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b\")),\n1676\t    28\t    (\"account_no\", re.compile(r\"(?i)\\b(account|acct|routing)\\s*(no\\.?|number|#)?\\s*[:#]?\\s*(\\d[\\d -]{6,}\\d)\")),\n1677\t    29\t]\n1678\t    30\t\n1679\t    31\tMARKDOWN_IMAGE = re.compile(r\"!\\[[^\\]]*\\]\\(([^)\\s]+)[^)]*\\)\")\n1680\t    32\tMARKDOWN_LINK = re.compile(r\"(?<!!)\\[([^\\]]*)\\]\\(([^)\\s]+)[^)]*\\)\")\n1681\t    33\tSLACK_LINK = re.compile(r\"<(https?://[^|>]+)(\\|[^>]*)?>\")\n1682\t    34\tBARE_URL = re.compile(r\"https?://[^\\s<>()]+\")\n1683\t    35\t\n1684\t    36\tAPPROVED_LINK_HOSTS = frozenset({\"erp.example-corp.test\", \"intranet.example-corp.test\"})\n1685\t    37\t\n1686\t    38\t\n1687\t    39\tdef _mask_tail(match: re.Match[str]) -> str:\n1688\t    40\t    text = match.group(0)\n1689\t    41\t    return \"[REDACTED:\" + \"*\" * 4 + text[-4:] + \"]\"\n1690\t    42\t\n1691\t    43\t\n1692\t    44\tdef redact_text(text: str) -> str:\n1693\t    45\t    for name, pattern in SECRET_PATTERNS:\n1694\t    46\t        text = pattern.sub(f\"[REDACTED:{name}]\", text)\n1695\t    47\t    for _name, pattern in ACCOUNT_PATTERNS:\n1696\t    48\t        text = pattern.sub(_mask_tail, text)\n1697\t    49\t    return text\n1698\t    50\t\n1699\t    51\t\n1700\t    52\tdef redact_value(value: Any) -> Any:\n1701\t    53\t    if isinstance(value, str):\n1702\t    54\t        return redact_text(value)\n1703\t    55\t    if isinstance(value, dict):\n1704\t    56\t        return {k: redact_value(v) for k, v in value.items()}\n1705\t    57\t    if isinstance(value, (list, tuple)):\n1706\t    58\t        return [redact_value(v) for v in value]\n1707\t    59\t    return value\n1708\t    60\t\n1709\t    61\t\n1710\t    62\tdef redact_for_model(value: Any) -> str:\n1711\t    63\t    if not isinstance(value, str):\n1712\t    64\t        import json\n1713\t    65\t\n1714\t    66\t        value = json.dumps(value, default=str)\n1715\t    67\t    return redact_text(value)\n1716\t    68\t\n1717\t    69\t\n1718\t    70\tdef _host_ok(url: str) -> bool:\n1719\t    71\t    host = (urlparse(url).hostname or \"\").lower()\n1720\t    72\t    return host in APPROVED_LINK_HOSTS\n1721\t    73\t\n1722\t    74\t\n1723\t    75\tdef strip_unapproved_links(text: str) -> str:\n1724\t    76\t    \"\"\"Remove images entirely and drop links to hosts outside the allowlist.\n1725\t    77\t\n1726\t    78\t    Slack and most chat clients fetch link and image URLs to render previews,\n1727\t    79\t    so an attacker-chosen URL can carry data out without any tool call.\n1728\t    80\t    \"\"\"\n1729\t    81\t    text = MARKDOWN_IMAGE.sub(\"[image removed]\", text)\n1730\t    82\t    text = MARKDOWN_LINK.sub(\n1731\t    83\t        lambda m: m.group(0) if _host_ok(m.group(2)) else m.group(1), text\n1732\t    84\t    )\n1733\t    85\t    text = SLACK_LINK.sub(\n1734\t    86\t        lambda m: m.group(0) if _host_ok(m.group(1)) else \"[link removed]\", text\n1735\t    87\t    )\n1736\t    88\t    text = BARE_URL.sub(\n1737\t    89\t        lambda m: m.group(0) if _host_ok(m.group(0)) else \"[link removed]\", text\n1738\t    90\t    )\n1739\t    91\t    return text\n1740\t    92\t\n1741\t    93\t\n1742\t    94\tclass RedactingFilter(logging.Filter):\n1743\t    95\t    def filter(self, record: logging.LogRecord) -> bool:\n1744\t    96\t        if isinstance(record.msg, str):\n1745\t    97\t            record.msg = redact_text(record.msg)\n1746\t    98\t        if record.args:\n1747\t    99\t            record.args = tuple(redact_value(a) for a in record.args)\n1748\t   100\t        return True\n1749\t=== ./app/settings.py\n1750\t     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n1751\t     2\tfrom __future__ import annotations\n1752\t     3\t\n1753\t     4\timport os\n1754\t     5\tfrom dataclasses import dataclass\n1755\t     6\tfrom functools import lru_cache\n1756\t     7\tfrom pathlib import Path\n1757\t     8\t\n1758\t     9\timport yaml\n1759\t    10\t\n1760\t    11\t\n1761\t    12\tdef _env(name: str, default: str | None = None) -> str:\n1762\t    13\t    value = os.environ.get(name, default)\n1763\t    14\t    if value is None:\n1764\t    15\t        raise RuntimeError(f\"missing required setting {name}\")\n1765\t    16\t    return value\n1766\t    17\t\n1767\t    18\t\n1768\t    19\t@dataclass(frozen=True)\n1769\t    20\tclass Settings:\n1770\t    21\t    database_url: str\n1771\t    22\t    erp_mcp_url: str\n1772\t    23\t    payments_api_url: str\n1773\t    24\t    slack_api_url: str\n1774\t    25\t    sts_url: str\n1775\t    26\t    oidc_issuer: str\n1776\t    27\t    oidc_audience: str\n1777\t    28\t    oidc_jwks_url: str\n1778\t    29\t    workload_token_path: str\n1779\t    30\t    slack_signing_secret_path: str\n1780\t    31\t    mail_gateway_hmac_path: str\n1781\t    32\t    model_id: str\n1782\t    33\t    extractor_model_id: str\n1783\t    34\t    manifest_path: Path\n1784\t    35\t    prompt_dir: Path\n1785\t    36\t    policy_path: Path\n1786\t    37\t    tools_path: Path\n1787\t    38\t    operational_owner: str\n1788\t    39\t    image_digest: str\n1789\t    40\t\n1790\t    41\t    @property\n1791\t    42\t    def policy(self) -> dict:\n1792\t    43\t        return _load_yaml(self.policy_path)\n1793\t    44\t\n1794\t    45\t    @property\n1795\t    46\t    def manifest(self) -> dict:\n1796\t    47\t        return _load_yaml(self.manifest_path)\n1797\t    48\t\n1798\t    49\t    @property\n1799\t    50\t    def budgets(self) -> dict:\n1800\t    51\t        return self.policy[\"budgets\"]\n1801\t    52\t\n1802\t    53\t\n1803\t    54\tdef _load_yaml(path: Path) -> dict:\n1804\t    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n1805\t    56\t        return yaml.safe_load(fh)\n1806\t    57\t\n1807\t    58\t\n1808\t    59\t@lru_cache(maxsize=1)\n1809\t    60\tdef get_settings() -> Settings:\n1810\t    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n1811\t    62\t    return Settings(\n1812\t    63\t        database_url=_env(\"DATABASE_URL\"),\n1813\t    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n1814\t    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n1815\t    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n1816\t    67\t        sts_url=_env(\"STS_URL\"),\n1817\t    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n1818\t    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n1819\t    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n1820\t    71\t        workload_token_path=_env(\n1821\t    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n1822\t    73\t        ),\n1823\t    74\t        slack_signing_secret_path=_env(\n1824\t    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n1825\t    76\t        ),\n1826\t    77\t        mail_gateway_hmac_path=_env(\n1827\t    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n1828\t    79\t        ),\n1829\t    80\t        model_id=_env(\"MODEL_ID\"),\n1830\t    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n1831\t    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n1832\t    83\t        prompt_dir=root / \"prompts\",\n1833\t    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n1834\t    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n1835\t    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n1836\t    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n1837\t    88\t    )\n1838\t=== ./app/startup.py\n1839\t     1\t\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\n1840\t     2\tfrom __future__ import annotations\n1841\t     3\t\n1842\t     4\timport hashlib\n1843\t     5\timport logging\n1844\t     6\tfrom pathlib import Path\n1845\t     7\t\n1846\t     8\tfrom app.identity import compute_agent_type_id\n1847\t     9\tfrom app.settings import Settings\n1848\t    10\t\n1849\t    11\tlog = logging.getLogger(__name__)\n1850\t    12\t\n1851\t    13\t\n1852\t    14\tdef sha256_file(path: Path) -> str:\n1853\t    15\t    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n1854\t    16\t\n1855\t    17\t\n1856\t    18\tdef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n1857\t    19\t    mismatches: list[str] = []\n1858\t    20\t    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n1859\t    21\t        mismatches.append(f\"image: running {settings.image_digest}\")\n1860\t    22\t    for name, entry in manifest[\"prompts\"].items():\n1861\t    23\t        path = settings.prompt_dir / Path(entry[\"path\"]).name\n1862\t    24\t        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n1863\t    25\t            mismatches.append(f\"prompt:{name}\")\n1864\t    26\t    for name in (\"policy\", \"tools\"):\n1865\t    27\t        entry = manifest[\"config\"][name]\n1866\t    28\t        path = settings.policy_path if name == \"policy\" else settings.tools_path\n1867\t    29\t        if sha256_file(path) != entry[\"sha256\"]:\n1868\t    30\t            mismatches.append(f\"config:{name}\")\n1869\t    31\t    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n1870\t    32\t        mismatches.append(\"model:primary\")\n1871\t    33\t    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n1872\t    34\t        mismatches.append(\"model:extractor\")\n1873\t    35\t    return mismatches\n1874\t    36\t\n1875\t    37\t\n1876\t    38\tdef startup_checks(settings: Settings) -> str:\n1877\t    39\t    \"\"\"Return the agent-type-id for this process.\"\"\"\n1878\t    40\t    manifest = settings.manifest\n1879\t    41\t    mismatches = running_state_mismatches(settings, manifest)\n1880\t    42\t    if mismatches:\n1881\t    43\t        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n1882\t    44\t    agent_type_id = compute_agent_type_id(manifest)\n1883\t    45\t    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n1884\t    46\t    return agent_type_id\n1885\t=== ./app/tools/__init__.py\n1886\t     1\t\"\"\"Tool registry.\n1887\t     2\t\n1888\t     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n1889\t     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n1890\t     5\tthat is not in the run's registry.\n1891\t     6\t\"\"\"\n1892\t     7\tfrom __future__ import annotations\n1893\t     8\t\n1894\t     9\tfrom dataclasses import dataclass\n1895\t    10\tfrom functools import lru_cache\n1896\t    11\tfrom typing import Any, Awaitable, Callable\n1897\t    12\t\n1898\t    13\timport yaml\n1899\t    14\t\n1900\t    15\tfrom app.identity import RunIdentity\n1901\t    16\t\n1902\t    17\tDEFAULT_ROLE = \"procurement\"\n1903\t    18\t\n1904\t    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n1905\t    20\t\n1906\t    21\t\n1907\t    22\t@dataclass(frozen=True)\n1908\t    23\tclass Tool:\n1909\t    24\t    name: str\n1910\t    25\t    description: str\n1911\t    26\t    input_schema: dict[str, Any]\n1912\t    27\t    invoke: Invoke\n1913\t    28\t    target_field: str | None = None\n1914\t    29\t\n1915\t    30\t    def target_of(self, args: dict[str, Any]) -> str:\n1916\t    31\t        if self.target_field is None:\n1917\t    32\t            return self.name\n1918\t    33\t        return str(args.get(self.target_field, \"\"))\n1919\t    34\t\n1920\t    35\t    def schema(self) -> dict[str, Any]:\n1921\t    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n1922\t    37\t\n1923\t    38\t\n1924\t    39\tclass ToolRegistry:\n1925\t    40\t    def __init__(self, tools: list[Tool]):\n1926\t    41\t        self._tools = {t.name: t for t in tools}\n1927\t    42\t\n1928\t    43\t    def get(self, name: str) -> Tool | None:\n1929\t    44\t        return self._tools.get(name)\n1930\t    45\t\n1931\t    46\t    def names(self) -> list[str]:\n1932\t    47\t        return sorted(self._tools)\n1933\t    48\t\n1934\t    49\t    def schemas(self) -> list[dict[str, Any]]:\n1935\t    50\t        return [self._tools[n].schema() for n in self.names()]\n1936\t    51\t\n1937\t    52\t\n1938\t    53\t@lru_cache(maxsize=1)\n1939\t    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n1940\t    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n1941\t    56\t        cfg = yaml.safe_load(fh)\n1942\t    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n1943\t    58\t\n1944\t    59\t\n1945\t    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n1946\t    61\t    from app.tools import documents, erp, memory, payments, slack\n1947\t    62\t\n1948\t    63\t    available: dict[str, Tool] = {}"}]},"parent_tool_use_id":null,"session_id":"9a932460-770f-4311-8553-70e3bee77013","uuid":"67eee076-d8a1-4f63-815b-e7579bb64ebe","timestamp":"2026-10-02T14:59:18.907Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-repeat-038tkh8l/9a932460-770f-4311-8553-70e3bee77013/tool-results/bo7ss49n1.txt","content":"=== ./app/ingest.py\n     1\t\"\"\"Inbound documents: vendor quotes and invoices from the mail gateway.\n     2\t\n     3\tThe mail gateway posts each received message to ``/ingest/mail`` signed with\n     4\tan HMAC over the timestamp and body. Accepted documents are stored per\n     5\tbusiness unit and are only ever shown to the model inside an\n     6\t``untrusted_document`` wrapper (tools/documents.py).\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport base64\n    11\timport email\n    12\timport email.policy\n    13\timport hashlib\n    14\timport hmac\n    15\timport io\n    16\timport re\n    17\timport time\n    18\timport uuid\n    19\tfrom dataclasses import dataclass\n    20\tfrom pathlib import Path\n    21\t\n    22\tfrom fastapi import APIRouter, HTTPException, Request\n    23\tfrom pypdf import PdfReader\n    24\t\n    25\trouter = APIRouter()\n    26\t\n    27\tMAX_BODY_BYTES = 10 * 1024 * 1024\n    28\tMAX_TEXT_CHARS = 200_000\n    29\tMAX_SKEW_SECONDS = 300\n    30\tALLOWED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\", \"message/rfc822\"}\n    31\tSCANNED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\"}\n    32\t\n    33\tINJECTION_PATTERNS = [\n    34\t    re.compile(r\"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)\"),\n    35\t    re.compile(r\"(?i)\\b(system|developer) (prompt|message)\\b\"),\n    36\t    re.compile(r\"(?i)\\byou are (now )?(an?|the) \\w+ (agent|assistant)\\b\"),\n    37\t    re.compile(r\"(?i)\\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\\b\"),\n    38\t    re.compile(r\"(?i)\\b(update|change) (our|the) (bank|remit|payee)\\b\"),\n    39\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    40\t]\n    41\t\n    42\t\n    43\tclass Rejected(Exception):\n    44\t    pass\n    45\t\n    46\t\n    47\t@dataclass\n    48\tclass Inbound:\n    49\t    business_unit: str\n    50\t    sender: str\n    51\t    media_type: str\n    52\t    raw: bytes\n    53\t\n    54\t\n    55\tdef verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:\n    56\t    try:\n    57\t        ts = int(timestamp)\n    58\t    except ValueError as exc:\n    59\t        raise Rejected(\"bad timestamp\") from exc\n    60\t    if abs(time.time() - ts) > MAX_SKEW_SECONDS:\n    61\t        raise Rejected(\"stale request\")\n    62\t    expected = hmac.new(key, f\"{timestamp}.\".encode() + body, hashlib.sha256).hexdigest()\n    63\t    if not hmac.compare_digest(expected, signature):\n    64\t        raise Rejected(\"bad signature\")\n    65\t\n    66\t\n    67\tdef extract_text(doc: Inbound) -> str:\n    68\t    if doc.media_type == \"application/pdf\":\n    69\t        reader = PdfReader(io.BytesIO(doc.raw))\n    70\t        if len(reader.pages) > 50:\n    71\t            raise Rejected(\"too many pages\")\n    72\t        return \"\\n\".join(page.extract_text() or \"\" for page in reader.pages)\n    73\t    if doc.media_type == \"message/rfc822\":\n    74\t        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)\n    75\t        body = msg.get_body(preferencelist=(\"plain\", \"html\"))\n    76\t        return body.get_content() if body is not None else \"\"\n    77\t    return doc.raw.decode(\"utf-8\", errors=\"strict\")\n    78\t\n    79\t\n    80\tdef scan_for_injection(text: str) -> list[str]:\n    81\t    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]\n    82\t\n    83\t\n    84\tdef validate(doc: Inbound) -> str:\n    85\t    if doc.media_type not in ALLOWED_MEDIA_TYPES:\n    86\t        raise Rejected(f\"media type {doc.media_type} not accepted\")\n    87\t    if len(doc.raw) > MAX_BODY_BYTES:\n    88\t        raise Rejected(\"document too large\")\n    89\t    try:\n    90\t        text = extract_text(doc)\n    91\t    except Rejected:\n    92\t        raise\n    93\t    except Exception as exc:\n    94\t        raise Rejected(f\"unreadable document: {type(exc).__name__}\") from exc\n    95\t    if len(text) > MAX_TEXT_CHARS:\n    96\t        raise Rejected(\"extracted text too long\")\n    97\t    if doc.media_type in SCANNED_MEDIA_TYPES:\n    98\t        findings = scan_for_injection(text)\n    99\t        if findings:\n   100\t            raise Rejected(\"possible prompt injection: \" + \"; \".join(findings))\n   101\t    return text\n   102\t\n   103\t\n   104\t@router.post(\"/ingest/mail\")\n   105\tasync def ingest_mail(request: Request) -> dict:\n   106\t    body = await request.body()\n   107\t    if len(body) > MAX_BODY_BYTES * 2:\n   108\t        raise HTTPException(413, \"payload too large\")\n   109\t    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()\n   110\t    try:\n   111\t        verify_signature(\n   112\t            key,\n   113\t            request.headers.get(\"X-Gateway-Timestamp\", \"\"),\n   114\t            body,\n   115\t            request.headers.get(\"X-Gateway-Signature\", \"\"),\n   116\t        )\n   117\t    except Rejected as exc:\n   118\t        raise HTTPException(401, str(exc)) from exc\n   119\t\n   120\t    payload = await request.json()\n   121\t    doc = Inbound(\n   122\t        business_unit=payload[\"business_unit\"],\n   123\t        sender=payload[\"from\"],\n   124\t        media_type=payload[\"media_type\"],\n   125\t        raw=base64.b64decode(payload[\"content_b64\"], validate=True),\n   126\t    )\n   127\t    doc_id = f\"doc-{uuid.uuid4().hex[:20]}\"\n   128\t    pool = request.app.state.pool\n   129\t    try:\n   130\t        text = validate(doc)\n   131\t    except Rejected as exc:\n   132\t        await pool.execute(\n   133\t            \"\"\"\n   134\t            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)\n   135\t            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())\n   136\t            \"\"\",\n   137\t            doc_id, doc.business_unit, doc.sender, doc.media_type,\n   138\t            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],\n   139\t        )\n   140\t        return {\"doc_id\": doc_id, \"status\": \"quarantined\"}\n   141\t\n   142\t    await pool.execute(\n   143\t        \"\"\"\n   144\t        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)\n   145\t        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())\n   146\t        \"\"\",\n   147\t        doc_id, doc.business_unit, doc.sender, doc.media_type,\n   148\t        hashlib.sha256(doc.raw).hexdigest(), text,\n   149\t    )\n   150\t    return {\"doc_id\": doc_id, \"status\": \"accepted\"}\n=== ./app/killswitch.py\n     1\t\"\"\"Operator stop control.\n     2\t\n     3\tOperators halt the fleet or one business unit by setting a row in\n     4\t``control_flags`` with the ``procurement_ops`` database role (see\n     5\tops/README in the platform runbook). The agent's own database role has\n     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\t\n    11\tclass AgentHalted(Exception):\n    12\t    pass\n    13\t\n    14\t\n    15\t_QUERY = \"\"\"\n    16\tSELECT scope, reason, set_by, set_at\n    17\tFROM control_flags\n    18\tWHERE halted\n    19\t  AND (scope = 'fleet' OR scope = $1)\n    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n    21\tLIMIT 1\n    22\t\"\"\"\n    23\t\n    24\t\n    25\tasync def assert_running(pool, tenant: str) -> None:\n    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n    27\t    if row is not None:\n    28\t        raise AgentHalted(\n    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n    31\t        )\n=== ./app/loop.py\n     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n=== ./app/main.py\n     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport hashlib\n     6\timport hmac\n     7\timport json\n     8\timport logging\n     9\timport time\n    10\timport uuid\n    11\tfrom contextlib import asynccontextmanager\n    12\tfrom pathlib import Path\n    13\tfrom urllib.parse import parse_qs\n    14\t\n    15\timport asyncpg\n    16\timport jwt\n    17\tfrom anthropic import AsyncAnthropic\n    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n    20\tfrom opentelemetry import trace\n    21\tfrom pydantic import BaseModel, Field\n    22\t\n    23\tfrom app import audit, ingest\n    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n    25\tfrom app.extractor import LineItemExtractor\n    26\tfrom app.gate import PolicyGate\n    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n    28\tfrom app.loop import AgentDeps, ProcurementAgent\n    29\tfrom app.mcp_client import ErpMcpClient\n    30\tfrom app.redact import RedactingFilter\n    31\tfrom app.settings import get_settings\n    32\tfrom app.startup import startup_checks\n    33\tfrom app.tools.slack import SlackClient\n    34\t\n    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n    36\tfor handler in logging.getLogger().handlers:\n    37\t    handler.addFilter(RedactingFilter())\n    38\tlog = logging.getLogger(\"procurement\")\n    39\t\n    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    41\tbearer = HTTPBearer()\n    42\t\n    43\t\n    44\tclass RunRequest(BaseModel):\n    45\t    task: str = Field(min_length=1, max_length=4000)\n    46\t    department: str = Field(min_length=1, max_length=64)\n    47\t\n    48\t\n    49\tclass Principal(BaseModel):\n    50\t    subject: str\n    51\t    business_unit: str\n    52\t\n    53\t\n    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    55\t    return RunIdentity(\n    56\t        accountable_party=\"system:procurement-agent\",\n    57\t        operational_owner=settings.operational_owner,\n    58\t        tenant=tenant,\n    59\t        agent_type_id=agent_type_id,\n    60\t        agent_instance_id=new_instance_id(),\n    61\t        trace_id=uuid.uuid4().hex,\n    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n    63\t        delegated_subject=\"system:procurement-agent\",\n    64\t        agent_principal=AGENT_PRINCIPAL,\n    65\t    )\n    66\t\n    67\t\n    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n    69\t    while True:\n    70\t        await asyncio.sleep(60)\n    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n    72\t        count = await app.state.pool.fetchval(\n    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n    75\t        )\n    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n    78\t\n    79\t\n    80\t@asynccontextmanager\n    81\tasync def lifespan(app: FastAPI):\n    82\t    settings = get_settings()\n    83\t    agent_type_id = startup_checks(settings)\n    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    85\t    broker = TokenBroker(settings)\n    86\t\n    87\t    async def slack_token() -> str:\n    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n    89\t\n    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n    92\t    gate = PolicyGate(settings.policy, approvals)\n    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n    95\t\n    96\t    client = AsyncAnthropic()\n    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    98\t    deps.extractor = LineItemExtractor(\n    99\t        client=client, settings=settings, deps=deps,\n   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n   101\t    )\n   102\t    app.state.settings = settings\n   103\t    app.state.pool = pool\n   104\t    app.state.agent_type_id = agent_type_id\n   105\t    app.state.approvals = approvals\n   106\t    app.state.agent = ProcurementAgent(\n   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n   108\t    )\n   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n   111\t    try:\n   112\t        yield\n   113\t    finally:\n   114\t        sweeper.cancel()\n   115\t        await pool.close()\n   116\t\n   117\t\n   118\tapp = FastAPI(lifespan=lifespan)\n   119\tapp.include_router(ingest.router)\n   120\t\n   121\t\n   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n   123\t    settings = request.app.state.settings\n   124\t    try:\n   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n   126\t        claims = jwt.decode(\n   127\t            creds.credentials,\n   128\t            key.key,\n   129\t            algorithms=[\"RS256\", \"ES256\"],\n   130\t            audience=settings.oidc_audience,\n   131\t            issuer=settings.oidc_issuer,\n   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n   133\t        )\n   134\t    except jwt.PyJWTError as exc:\n   135\t        raise HTTPException(401, \"invalid token\") from exc\n   136\t    bu = claims.get(\"bu\")\n   137\t    if not bu:\n   138\t        raise HTTPException(403, \"token has no business unit\")\n   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n   140\t\n   141\t\n   142\t@app.post(\"/runs\")\n   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n   144\t    settings = request.app.state.settings\n   145\t    span_ctx = trace.get_current_span().get_span_context()\n   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n   147\t    ident = RunIdentity(\n   148\t        accountable_party=principal.subject,\n   149\t        operational_owner=settings.operational_owner,\n   150\t        tenant=principal.business_unit,\n   151\t        agent_type_id=request.app.state.agent_type_id,\n   152\t        agent_instance_id=new_instance_id(),\n   153\t        trace_id=trace_id,\n   154\t        run_id=f\"run-{uuid.uuid4()}\",\n   155\t        delegated_subject=principal.subject,\n   156\t        agent_principal=AGENT_PRINCIPAL,\n   157\t    )\n   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n   161\t\n   162\t\n   163\t@app.post(\"/slack/interactions\")\n   164\tasync def slack_interactions(request: Request) -> dict:\n   165\t    body = await request.body()\n   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n   167\t    if abs(time.time() - int(timestamp)) > 300:\n   168\t        raise HTTPException(401, \"stale request\")\n   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n   172\t        raise HTTPException(401, \"bad signature\")\n   173\t\n   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n   175\t    action = payload[\"actions\"][0]\n   176\t    slack_user = payload[\"user\"][\"id\"]\n   177\t    row = await request.app.state.pool.fetchrow(\n   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n   179\t    )\n   180\t    if row is None:\n   181\t        raise HTTPException(403, \"not an approver\")\n   182\t    try:\n   183\t        await request.app.state.approvals.decide(\n   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n   185\t            approve=action[\"action_id\"] == \"approve\",\n   186\t        )\n   187\t    except ApproverNotAuthorized as exc:\n   188\t        raise HTTPException(403, str(exc)) from exc\n   189\t    except ValueError as exc:\n   190\t        raise HTTPException(409, str(exc)) from exc\n   191\t    return {\"ok\": True}\n   192\t\n   193\t\n   194\t@app.get(\"/healthz\")\n   195\tasync def healthz() -> dict:\n   196\t    return {\"ok\": True}\n=== ./app/mcp_client.py\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n=== ./app/redact.py\n     1\t\"\"\"Redaction for model input, logs, audit payloads, and outbound messages.\n     2\t\n     3\tApplied in four places:\n     4\t  * tool results before they are appended to the model context (loop.py)\n     5\t  * every audit payload (audit.py)\n     6\t  * the root logging filter (main.py)\n     7\t  * outbound Slack text (tools/slack.py)\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport logging\n    12\timport re\n    13\tfrom typing import Any\n    14\tfrom urllib.parse import urlparse\n    15\t\n    16\tSECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n    17\t    (\"bearer\", re.compile(r\"(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]{16,}\")),\n    18\t    (\"jwt\", re.compile(r\"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b\")),\n    19\t    (\"acct_token\", re.compile(r\"\\bacct_tok_[A-Za-z0-9_]{8,}\\b\")),\n    20\t    (\"pay_token\", re.compile(r\"\\bpay_tok_[A-Za-z0-9_]{8,}\\b\")),\n    21\t    (\"erp_session\", re.compile(r\"\\berp_sess_[A-Za-z0-9_]{8,}\\b\")),\n    22\t    (\"password_kv\", re.compile(r\"(?i)\\b(password|passwd|secret|api[_-]?key)\\s*[:=]\\s*\\S+\")),\n    23\t]\n    24\t\n    25\t# Bank details: keep the last four characters so staff can still match records.\n    26\tACCOUNT_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n    27\t    (\"iban\", re.compile(r\"\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b\")),\n    28\t    (\"account_no\", re.compile(r\"(?i)\\b(account|acct|routing)\\s*(no\\.?|number|#)?\\s*[:#]?\\s*(\\d[\\d -]{6,}\\d)\")),\n    29\t]\n    30\t\n    31\tMARKDOWN_IMAGE = re.compile(r\"!\\[[^\\]]*\\]\\(([^)\\s]+)[^)]*\\)\")\n    32\tMARKDOWN_LINK = re.compile(r\"(?<!!)\\[([^\\]]*)\\]\\(([^)\\s]+)[^)]*\\)\")\n    33\tSLACK_LINK = re.compile(r\"<(https?://[^|>]+)(\\|[^>]*)?>\")\n    34\tBARE_URL = re.compile(r\"https?://[^\\s<>()]+\")\n    35\t\n    36\tAPPROVED_LINK_HOSTS = frozenset({\"erp.example-corp.test\", \"intranet.example-corp.test\"})\n    37\t\n    38\t\n    39\tdef _mask_tail(match: re.Match[str]) -> str:\n    40\t    text = match.group(0)\n    41\t    return \"[REDACTED:\" + \"*\" * 4 + text[-4:] + \"]\"\n    42\t\n    43\t\n    44\tdef redact_text(text: str) -> str:\n    45\t    for name, pattern in SECRET_PATTERNS:\n    46\t        text = pattern.sub(f\"[REDACTED:{name}]\", text)\n    47\t    for _name, pattern in ACCOUNT_PATTERNS:\n    48\t        text = pattern.sub(_mask_tail, text)\n    49\t    return text\n    50\t\n    51\t\n    52\tdef redact_value(value: Any) -> Any:\n    53\t    if isinstance(value, str):\n    54\t        return redact_text(value)\n    55\t    if isinstance(value, dict):\n    56\t        return {k: redact_value(v) for k, v in value.items()}\n    57\t    if isinstance(value, (list, tuple)):\n    58\t        return [redact_value(v) for v in value]\n    59\t    return value\n    60\t\n    61\t\n    62\tdef redact_for_model(value: Any) -> str:\n    63\t    if not isinstance(value, str):\n    64\t        import json\n    65\t\n    66\t        value = json.dumps(value, default=str)\n    67\t    return redact_text(value)\n    68\t\n    69\t\n    70\tdef _host_ok(url: str) -> bool:\n    71\t    host = (urlparse(url).hostname or \"\").lower()\n    72\t    return host in APPROVED_LINK_HOSTS\n    73\t\n    74\t\n    75\tdef strip_unapproved_links(text: str) -> str:\n    76\t    \"\"\"Remove images entirely and drop links to hosts outside the allowlist.\n    77\t\n    78\t    Slack and most chat clients fetch link and image URLs to render previews,\n    79\t    so an attacker-chosen URL can carry data out without any tool call.\n    80\t    \"\"\"\n    81\t    text = MARKDOWN_IMAGE.sub(\"[image removed]\", text)\n    82\t    text = MARKDOWN_LINK.sub(\n    83\t        lambda m: m.group(0) if _host_ok(m.group(2)) else m.group(1), text\n    84\t    )\n    85\t    text = SLACK_LINK.sub(\n    86\t        lambda m: m.group(0) if _host_ok(m.group(1)) else \"[link removed]\", text\n    87\t    )\n    88\t    text = BARE_URL.sub(\n    89\t        lambda m: m.group(0) if _host_ok(m.group(0)) else \"[link removed]\", text\n    90\t    )\n    91\t    return text\n    92\t\n    93\t\n    94\tclass RedactingFilter(logging.Filter):\n    95\t    def filter(self, record: logging.LogRecord) -> bool:\n    96\t        if isinstance(record.msg, str):\n    97\t            record.msg = redact_text(record.msg)\n    98\t        if record.args:\n    99\t            record.args = tuple(redact_value(a) for a in record.args)\n   100\t        return True\n=== ./app/settings.py\n     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t\n    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )\n=== ./app/startup.py\n     1\t\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\timport logging\n     6\tfrom pathlib import Path\n     7\t\n     8\tfrom app.identity import compute_agent_type_id\n     9\tfrom app.settings import Settings\n    10\t\n    11\tlog = logging.getLogger(__name__)\n    12\t\n    13\t\n    14\tdef sha256_file(path: Path) -> str:\n    15\t    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n    16\t\n    17\t\n    18\tdef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n    19\t    mismatches: list[str] = []\n    20\t    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n    21\t        mismatches.append(f\"image: running {settings.image_digest}\")\n    22\t    for name, entry in manifest[\"prompts\"].items():\n    23\t        path = settings.prompt_dir / Path(entry[\"path\"]).name\n    24\t        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n    25\t            mismatches.append(f\"prompt:{name}\")\n    26\t    for name in (\"policy\", \"tools\"):\n    27\t        entry = manifest[\"config\"][name]\n    28\t        path = settings.policy_path if name == \"policy\" else settings.tools_path\n    29\t        if sha256_file(path) != entry[\"sha256\"]:\n    30\t            mismatches.append(f\"config:{name}\")\n    31\t    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n    32\t        mismatches.append(\"model:primary\")\n    33\t    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n    34\t        mismatches.append(\"model:extractor\")\n    35\t    return mismatches\n    36\t\n    37\t\n    38\tdef startup_checks(settings: Settings) -> str:\n    39\t    \"\"\"Return the agent-type-id for this process.\"\"\"\n    40\t    manifest = settings.manifest\n    41\t    mismatches = running_state_mismatches(settings, manifest)\n    42\t    if mismatches:\n    43\t        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n    44\t    agent_type_id = compute_agent_type_id(manifest)\n    45\t    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n    46\t    return agent_type_id\n=== ./app/tools/__init__.py\n     1\t\"\"\"Tool registry.\n     2\t\n     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n     5\tthat is not in the run's registry.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom functools import lru_cache\n    11\tfrom typing import Any, Awaitable, Callable\n    12\t\n    13\timport yaml\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\t\n    17\tDEFAULT_ROLE = \"procurement\"\n    18\t\n    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Tool:\n    24\t    name: str\n    25\t    description: str\n    26\t    input_schema: dict[str, Any]\n    27\t    invoke: Invoke\n    28\t    target_field: str | None = None\n    29\t\n    30\t    def target_of(self, args: dict[str, Any]) -> str:\n    31\t        if self.target_field is None:\n    32\t            return self.name\n    33\t        return str(args.get(self.target_field, \"\"))\n    34\t\n    35\t    def schema(self) -> dict[str, Any]:\n    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n    37\t\n    38\t\n    39\tclass ToolRegistry:\n    40\t    def __init__(self, tools: list[Tool]):\n    41\t        self._tools = {t.name: t for t in tools}\n    42\t\n    43\t    def get(self, name: str) -> Tool | None:\n    44\t        return self._tools.get(name)\n    45\t\n    46\t    def names(self) -> list[str]:\n    47\t        return sorted(self._tools)\n    48\t\n    49\t    def schemas(self) -> list[dict[str, Any]]:\n    50\t        return [self._tools[n].schema() for n in self.names()]\n    51\t\n    52\t\n    53\t@lru_cache(maxsize=1)\n    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        cfg = yaml.safe_load(fh)\n    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n    58\t\n    59\t\n    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n    61\t    from app.tools import documents, erp, memory, payments, slack\n    62\t\n    63\t    available: dict[str, Tool] = {}","numLines":1000,"startLine":949,"totalLines":3420}}}
