{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WMN6c2dGGaER6ocUBY8MhS","type":"tool_result","content":"50\t    49\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n51\t    50\t      - uses: sigstore/cosign-installer@dc72c7d5c4d10cd6bcb8cf6e3fd625a9e5e537da # v3.7.0\n52\t    51\t        with:\n53\t    52\t          cosign-release: \"v2.6.2\"\n54\t    53\t      - uses: docker/setup-buildx-action@c47758b77c9736f4b2ef4073d4d51994fabfe349 # v3.7.1\n55\t    54\t      - uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0\n56\t    55\t        with:\n57\t    56\t          registry: registry.example-corp.test\n58\t    57\t          username: ${{ github.actor }}\n59\t    58\t          password: ${{ secrets.GITHUB_TOKEN }}\n60\t    59\t      - id: build\n61\t    60\t        uses: docker/build-push-action@4f58ea79222b3b9dc2c8bbdd6debcef730109a75 # v6.9.0\n62\t    61\t        with:\n63\t    62\t          context: .\n64\t    63\t          push: true\n65\t    64\t          tags: registry.example-corp.test/procurement/agent:${{ github.sha }}\n66\t    65\t          provenance: false\n67\t    66\t          sbom: false\n68\t    67\t      - name: SBOM\n69\t    68\t        uses: anchore/sbom-action@251a468eed47e5082b105c3ba6ee500c0e65a764 # v0.17.6\n70\t    69\t        with:\n71\t    70\t          image: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n72\t    71\t          format: cyclonedx-json\n73\t    72\t          output-file: sbom.cdx.json\n74\t    73\t      - name: Sign and attest\n75\t    74\t        env:\n76\t    75\t          IMAGE: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n77\t    76\t        run: |\n78\t    77\t          cosign sign --yes \"$IMAGE\"\n79\t    78\t          cosign attest --yes --type cyclonedx --predicate sbom.cdx.json \"$IMAGE\"\n80\t    79\t      - uses: actions/attest-build-provenance@1c608d11d69870c2092266b3f9a6f3abbf17002c # v1.4.3\n81\t    80\t        with:\n82\t    81\t          subject-name: registry.example-corp.test/procurement/agent\n83\t    82\t          subject-digest: ${{ steps.build.outputs.digest }}\n84\t    83\t          push-to-registry: true\n85\t=== ./Dockerfile\n86\t     1\t# syntax=docker/dockerfile:1.10\n87\t     2\tFROM python:3.11.10-slim-bookworm@sha256:2a6386ad2db20e7f55073f69a98d6da2cf9f168e05e7487d2670c22e4ad2a1bd AS build\n88\t     3\tWORKDIR /src\n89\t     4\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n90\t     5\tCOPY pyproject.toml ./\n91\t     6\tCOPY app ./app\n92\t     7\tRUN pip install --target /opt/site .\n93\t     8\tRUN python -m compileall -q app\n94\t     9\t\n95\t    10\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:8f3c1a6e2b9d4f7a0c5e8b1d3f6a9c2e5b8d1f4a7c0e3b6d9f2a5c8e1b4d7f0a\n96\t    11\tWORKDIR /app\n97\t    12\tENV PYTHONPATH=/opt/site:/app \\\n98\t    13\t    PYTHONDONTWRITEBYTECODE=1 \\\n99\t    14\t    APP_ROOT=/app\n100\t    15\tCOPY --from=build /opt/site /opt/site\n101\t    16\tCOPY --from=build /src/app /app/app\n102\t    17\tCOPY prompts /app/prompts\n103\t    18\tCOPY config /app/config\n104\t    19\tCOPY release/manifest.yaml /app/release/manifest.yaml\n105\t    20\tUSER 65532:65532\n106\t    21\tEXPOSE 8080\n107\t    22\tENTRYPOINT [\"python\", \"-m\", \"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\", \"--no-server-header\"]\n108\t=== ./README.md\n109\t     1\t# procurement-agent\n110\t     2\t\n111\t     3\tProcurement agent for Example Corp business units. It reads vendor quotes and\n112\t     4\tinvoices that arrive by email, checks them against department budgets, raises\n113\t     5\tpurchase orders in the ERP, pays matched invoices, and talks to staff and\n114\t     6\tvendors in Slack. It keeps short per-department notes between runs.\n115\t     7\t\n116\t     8\t## Architecture\n117\t     9\t\n118\t    10\t```\n119\t    11\tmail gateway --HMAC--> /ingest/mail --> documents (Postgres, per business unit)\n120\t    12\tstaff (OIDC JWT) ----> /runs --> ProcurementAgent loop (app/loop.py)\n121\t    13\t                                   |-- PolicyGate (app/gate.py) + approvals (Slack buttons)\n122\t    14\t                                   |-- Budget (app/budget.py)\n123\t    15\t                                   |-- audit graph (app/audit.py -> audit_events)\n124\t    16\t                                   |-- tools:\n125\t    17\t                                   |     read_document, extract_line_items -> LineItemExtractor sub-agent\n126\t    18\t                                   |     get_budget, erp_call, create_purchase_order -> ERP MCP via gateway\n127\t    19\t                                   |     pay_invoice -> payments API\n128\t    20\t                                   |     post_slack_message -> Slack (via slack-proxy)\n129\t    21\t                                   |     memory_read, memory_write -> dept_notes\n130\t    22\t```\n131\t    23\t\n132\t    24\t* **Tenancy.** Each run belongs to one business unit, taken from the `bu`\n133\t    25\t  claim of the caller's verified OIDC token. Documents, notes, approvals and\n134\t    26\t  quotas are keyed by business unit.\n135\t    27\t* **Identity.** The agent runs as the `procurement-agent` service account.\n136\t    28\t  Its projected token (10-minute lifetime) is exchanged at the internal STS\n137\t    29\t  for audience-bound tokens for the ERP gateway, payments API and Slack\n138\t    30\t  proxy. User tokens are never forwarded.\n139\t    31\t* **Approvals.** `create_purchase_order`, `pay_invoice` and vendor messages\n140\t    32\t  require an approval from a role listed in `config/policy.yaml`. Approval\n141\t    33\t  requests are posted to `#approvals-<bu>` with the argument summary.\n142\t    34\t* **Budgets.** Per-run step, time, token, cost, tool-rate and sub-agent\n143\t    35\t  limits, plus per-user, per-business-unit and fleet quotas for daily spend\n144\t    36\t  and run starts. See `config/policy.yaml`.\n145\t    37\t* **Audit.** Every run step is a row in `audit_events` linked to its parent\n146\t    38\t  step, with the six identity fields, policy version, approval id and\n147\t    39\t  decision-time context size. The agent's database role can insert audit\n148\t    40\t  rows but not update or delete them.\n149\t    41\t\n150\t    42\t## Context size\n151\t    43\t\n152\t    44\tLogged on every audit row as `context_tokens` and `context_method`:\n153\t    45\t\n154\t    46\t| method | meaning |\n155\t    47\t|---|---|\n156\t    48\t| `count_tokens_api` | exact request counted with the provider's token-count endpoint before the call (includes cached prefix) |\n157\t    49\t| `usage_sum_estimate` | counting failed; `input_tokens + cache_read + cache_creation` from the response |\n158\t    50\t| `unavailable` | neither available; `context_tokens` is NULL, never 0 |\n159\t    51\t\n160\t    52\t`context_compacted` is true when the harness dropped earlier turns before the\n161\t    53\tcall (`app/loop.py:_compact`). Provider-side truncation is not visible.\n162\t    54\t\n163\t    55\t## Operating\n164\t    56\t\n165\t    57\t* **Halt.** Insert or update a row in `control_flags` (`scope = 'fleet'` or\n166\t    58\t  `'tenant:<bu>'`, `halted = true`) as `procurement_ops`. New runs refuse to\n167\t    59\t  start while a halt is set.\n168\t    60\t* **Release.** Merges to `main` build, sign (keyless cosign), and attest the\n169\t    61\t  image (SLSA provenance and CycloneDX SBOM). Kyverno rejects unsigned or\n170\t    62\t  unattested images in `procurement-prod`.\n171\t    63\t* **Network.** Default-deny egress with explicit rules for DNS, the egress\n172\t    64\t  proxy, the Slack proxy, the database, the ERP gateway and the STS.\n173\t    65\t\n174\t    66\t## Tests\n175\t    67\t\n176\t    68\t```bash\n177\t    69\tpip install -e '.[test]'\n178\t    70\tpytest -q\n179\t    71\t```\n180\t=== ./app/__init__.py\n181\t=== ./app/approvals.py\n182\t     1\t\"\"\"Approval requests and decisions for high-impact operations.\n183\t     2\t\n184\t     3\tRequests are posted to the business unit's approvals channel in Slack with\n185\t     4\tthe full argument summary. Approvers decide with the Slack buttons; the\n186\t     5\tinteractive callback is signature-checked in main.py and then calls\n187\t     6\t``decide``. Approver authority is checked against the role map in policy.\n188\t     7\t\"\"\"\n189\t     8\tfrom __future__ import annotations\n190\t     9\t\n191\t    10\timport json\n192\t    11\timport uuid\n193\t    12\tfrom dataclasses import dataclass\n194\t    13\tfrom datetime import datetime, timedelta, timezone\n195\t    14\tfrom typing import Any\n196\t    15\t\n197\t    16\tfrom app.audit import digest, summarize_args\n198\t    17\tfrom app.identity import RunIdentity\n199\t    18\t\n200\t    19\t\n201\t    20\t@dataclass(frozen=True)\n202\t    21\tclass Approval:\n203\t    22\t    id: str\n204\t    23\t    approver: str\n205\t    24\t    approver_role: str\n206\t    25\t    expires_at: datetime\n207\t    26\t\n208\t    27\t\n209\t    28\tclass ApproverNotAuthorized(Exception):\n210\t    29\t    pass\n211\t    30\t\n212\t    31\t\n213\t    32\tclass ApprovalStore:\n214\t    33\t    def __init__(self, pool, policy: dict, notifier):\n215\t    34\t        self.pool = pool\n216\t    35\t        self.ttl = timedelta(minutes=int(policy[\"approvals\"][\"ttl_minutes\"]))\n217\t    36\t        self.approver_roles: dict[str, list[str]] = policy[\"approvals\"][\"approver_roles\"]\n218\t    37\t        self.notifier = notifier\n219\t    38\t\n220\t    39\t    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n221\t    40\t        approval_id = f\"apr-{uuid.uuid4()}\"\n222\t    41\t        expires_at = datetime.now(timezone.utc) + self.ttl\n223\t    42\t        await self.pool.execute(\n224\t    43\t            \"\"\"\n225\t    44\t            INSERT INTO approvals (\n226\t    45\t                id, tool, target, args_sha256, args_summary, tenant,\n227\t    46\t                requested_by_instance, requested_by_run, delegated_subject,\n228\t    47\t                status, requested_at, expires_at\n229\t    48\t            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)\n230\t    49\t            \"\"\",\n231\t    50\t            approval_id,\n232\t    51\t            tool,\n233\t    52\t            target,\n234\t    53\t            digest(args),\n235\t    54\t            json.dumps(summarize_args(args)),\n236\t    55\t            ident.tenant,\n237\t    56\t            ident.agent_instance_id,\n238\t    57\t            ident.run_id,\n239\t    58\t            ident.delegated_subject,\n240\t    59\t            expires_at,\n241\t    60\t        )\n242\t    61\t        await self.notifier.post_approval_request(\n243\t    62\t            tenant=ident.tenant,\n244\t    63\t            approval_id=approval_id,\n245\t    64\t            tool=tool,\n246\t    65\t            target=target,\n247\t    66\t            summary=summarize_args(args),\n248\t    67\t            expires_at=expires_at,\n249\t    68\t        )\n250\t    69\t        return approval_id\n251\t    70\t\n252\t    71\t    async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:\n253\t    72\t        row = await self.pool.fetchrow(\n254\t    73\t            \"\"\"\n255\t    74\t            SELECT id, approver, approver_role, expires_at\n256\t    75\t            FROM approvals\n257\t    76\t            WHERE tool = $1\n258\t    77\t              AND target = $2\n259\t    78\t              AND tenant = $3\n260\t    79\t              AND status = 'approved'\n261\t    80\t              AND expires_at > now()\n262\t    81\t            ORDER BY decided_at DESC\n263\t    82\t            LIMIT 1\n264\t    83\t            \"\"\",\n265\t    84\t            tool,\n266\t    85\t            target,\n267\t    86\t            ident.tenant,\n268\t    87\t        )\n269\t    88\t        if row is None:\n270\t    89\t            return None\n271\t    90\t        if row[\"approver_role\"] not in self.approver_roles.get(tool, []):\n272\t    91\t            return None\n273\t    92\t        return Approval(row[\"id\"], row[\"approver\"], row[\"approver_role\"], row[\"expires_at\"])\n274\t    93\t\n275\t    94\t    async def decide(self, approval_id: str, approver: str, approver_role: str, approve: bool) -> None:\n276\t    95\t        row = await self.pool.fetchrow(\n277\t    96\t            \"SELECT tool, status, expires_at FROM approvals WHERE id = $1\", approval_id\n278\t    97\t        )\n279\t    98\t        if row is None or row[\"status\"] != \"pending\":\n280\t    99\t            raise ValueError(\"approval is not pending\")\n281\t   100\t        if row[\"expires_at\"] <= datetime.now(timezone.utc):\n282\t   101\t            raise ValueError(\"approval request expired\")\n283\t   102\t        if approver_role not in self.approver_roles.get(row[\"tool\"], []):\n284\t   103\t            raise ApproverNotAuthorized(f\"{approver_role} cannot approve {row['tool']}\")\n285\t   104\t        await self.pool.execute(\n286\t   105\t            \"\"\"\n287\t   106\t            UPDATE approvals\n288\t   107\t            SET status = $2, approver = $3, approver_role = $4, decided_at = now()\n289\t   108\t            WHERE id = $1 AND status = 'pending'\n290\t   109\t            \"\"\",\n291\t   110\t            approval_id,\n292\t   111\t            \"approved\" if approve else \"rejected\",\n293\t   112\t            approver,\n294\t   113\t            approver_role,\n295\t   114\t        )\n296\t=== ./app/audit.py\n297\t     1\t\"\"\"Execution audit graph.\n298\t     2\t\n299\t     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n300\t     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n301\t     5\ttool call -> authorization decision -> result or error. Writes are\n302\t     6\tsynchronous and are made before the action they describe; if the write\n303\t     7\tfails, the caller raises and the action does not run.\n304\t     8\t\"\"\"\n305\t     9\tfrom __future__ import annotations\n306\t    10\t\n307\t    11\timport hashlib\n308\t    12\timport json\n309\t    13\timport uuid\n310\t    14\tfrom datetime import datetime, timezone\n311\t    15\tfrom typing import Any\n312\t    16\t\n313\t    17\tfrom opentelemetry import trace\n314\t    18\t\n315\t    19\tfrom app.context_size import ContextMeasure\n316\t    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n317\t    21\tfrom app.redact import redact_value\n318\t    22\t\n319\t    23\tEVENT_KINDS = {\n320\t    24\t    \"run_started\",\n321\t    25\t    \"run_finished\",\n322\t    26\t    \"run_halted\",\n323\t    27\t    \"model_decision\",\n324\t    28\t    \"tool_proposed\",\n325\t    29\t    \"authz_decision\",\n326\t    30\t    \"approval_requested\",\n327\t    31\t    \"approval_decided\",\n328\t    32\t    \"tool_result\",\n329\t    33\t    \"tool_error\",\n330\t    34\t    \"tool_denied\",\n331\t    35\t    \"budget_exceeded\",\n332\t    36\t    \"subagent_started\",\n333\t    37\t    \"subagent_finished\",\n334\t    38\t    \"background_job\",\n335\t    39\t}\n336\t    40\t\n337\t    41\t_INSERT = \"\"\"\n338\t    42\tINSERT INTO audit_events (\n339\t    43\t    node_id, parent_node_id, run_id, ts, kind,\n340\t    44\t    accountable_party, operational_owner, tenant,\n341\t    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n342\t    46\t    delegated_subject, agent_principal, parent_instance_id,\n343\t    47\t    policy_version, approval_id, operation_id,\n344\t    48\t    context_tokens, context_method, context_compacted,\n345\t    49\t    payload\n346\t    50\t) VALUES (\n347\t    51\t    $1, $2, $3, $4, $5,\n348\t    52\t    $6, $7, $8,\n349\t    53\t    $9, $10, $11, $12,\n350\t    54\t    $13, $14, $15,\n351\t    55\t    $16, $17, $18,\n352\t    56\t    $19, $20, $21,\n353\t    57\t    $22::jsonb\n354\t    58\t)\n355\t    59\t\"\"\"\n356\t    60\t\n357\t    61\t\n358\t    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n359\t    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n360\t    64\t    return {k: redact_value(v) for k, v in args.items()}\n361\t    65\t\n362\t    66\t\n363\t    67\tdef digest(value: Any) -> str:\n364\t    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n365\t    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n366\t    70\t\n367\t    71\t\n368\t    72\tasync def record(\n369\t    73\t    pool,\n370\t    74\t    ident: RunIdentity,\n371\t    75\t    *,\n372\t    76\t    kind: str,\n373\t    77\t    payload: dict[str, Any] | None = None,\n374\t    78\t    parent: str | None = None,\n375\t    79\t    context: ContextMeasure | None = None,\n376\t    80\t    policy_version: str | None = None,\n377\t    81\t    approval_id: str | None = None,\n378\t    82\t    operation_id: str | None = None,\n379\t    83\t) -> str:\n380\t    84\t    if kind not in EVENT_KINDS:\n381\t    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n382\t    86\t    for name in IDENTITY_FIELDS:\n383\t    87\t        if not getattr(ident, name):\n384\t    88\t            raise ValueError(f\"audit record missing {name}\")\n385\t    89\t    span_ctx = trace.get_current_span().get_span_context()\n386\t    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n387\t    91\t    node_id = f\"node-{uuid.uuid4()}\"\n388\t    92\t    measure = context or ContextMeasure.unavailable()\n389\t    93\t    await pool.execute(\n390\t    94\t        _INSERT,\n391\t    95\t        node_id,\n392\t    96\t        parent,\n393\t    97\t        ident.run_id,\n394\t    98\t        datetime.now(timezone.utc),\n395\t    99\t        kind,\n396\t   100\t        ident.accountable_party,\n397\t   101\t        ident.operational_owner,\n398\t   102\t        ident.tenant,\n399\t   103\t        ident.agent_type_id,\n400\t   104\t        ident.agent_instance_id,\n401\t   105\t        ident.trace_id,\n402\t   106\t        span_id,\n403\t   107\t        ident.delegated_subject,\n404\t   108\t        ident.agent_principal,\n405\t   109\t        ident.parent_instance_id,\n406\t   110\t        policy_version,\n407\t   111\t        approval_id,\n408\t   112\t        operation_id,\n409\t   113\t        measure.tokens,\n410\t   114\t        measure.method,\n411\t   115\t        measure.compacted,\n412\t   116\t        json.dumps(redact_value(payload or {}), default=str),\n413\t   117\t    )\n414\t   118\t    return node_id\n415\t=== ./app/budget.py\n416\t     1\t\"\"\"Hard execution budgets, enforced by the harness and not by the model.\n417\t     2\t\n418\t     3\tPer run: step count, wall-clock time, tokens, cost, tool-call rate, and\n419\t     4\tnumber of sub-agents. Sub-agents charge the parent's budget, so a child\n420\t     5\tcannot widen what the parent was given.\n421\t     6\t\n422\t     7\tAcross runs: daily spend and per-minute run starts per user, per tenant\n423\t     8\t(business unit), and for the whole fleet. Quotas are reserved in Postgres\n424\t     9\tinside one transaction, so concurrent runs cannot overshoot them.\n425\t    10\t\"\"\"\n426\t    11\tfrom __future__ import annotations\n427\t    12\t\n428\t    13\timport time\n429\t    14\tfrom collections import deque\n430\t    15\tfrom dataclasses import dataclass, field\n431\t    16\tfrom decimal import Decimal\n432\t    17\t\n433\t    18\tfrom app.identity import RunIdentity\n434\t    19\t\n435\t    20\t\n436\t    21\tclass BudgetExceeded(Exception):\n437\t    22\t    def __init__(self, limit: str, used, allowed):\n438\t    23\t        super().__init__(f\"{limit} exceeded: used={used} allowed={allowed}\")\n439\t    24\t        self.limit = limit\n440\t    25\t        self.used = used\n441\t    26\t        self.allowed = allowed\n442\t    27\t\n443\t    28\t\n444\t    29\t# USD per million tokens, from the provider price sheet referenced in the manifest.\n445\t    30\tPRICES = {\n446\t    31\t    \"claude-sonnet-4-5-20250929\": (Decimal(\"3.00\"), Decimal(\"15.00\")),\n447\t    32\t    \"claude-haiku-4-5-20251001\": (Decimal(\"1.00\"), Decimal(\"5.00\")),\n448\t    33\t}\n449\t    34\t\n450\t    35\t\n451\t    36\t@dataclass\n452\t    37\tclass Budget:\n453\t    38\t    ident: RunIdentity\n454\t    39\t    max_steps: int\n455\t    40\t    max_wall_seconds: float\n456\t    41\t    max_tokens: int\n457\t    42\t    max_cost_usd: Decimal\n458\t    43\t    max_tool_calls_per_minute: int\n459\t    44\t    max_subagents: int\n460\t    45\t    quotas_daily_usd: dict[str, Decimal]\n461\t    46\t    run_starts_per_minute: dict[str, int]\n462\t    47\t    started_at: float = field(default_factory=time.monotonic)\n463\t    48\t    steps: int = 0\n464\t    49\t    tokens: int = 0\n465\t    50\t    cost_usd: Decimal = Decimal(\"0\")\n466\t    51\t    unflushed_cost_usd: Decimal = Decimal(\"0\")\n467\t    52\t    subagents: int = 0\n468\t    53\t    _tool_calls: deque = field(default_factory=deque)\n469\t    54\t\n470\t    55\t    @classmethod\n471\t    56\t    def for_run(cls, cfg: dict, ident: RunIdentity) -> \"Budget\":\n472\t    57\t        run = cfg[\"per_run\"]\n473\t    58\t        return cls(\n474\t    59\t            ident=ident,\n475\t    60\t            max_steps=int(run[\"max_steps\"]),\n476\t    61\t            max_wall_seconds=float(run[\"max_wall_seconds\"]),\n477\t    62\t            max_tokens=int(run[\"max_tokens\"]),\n478\t    63\t            max_cost_usd=Decimal(str(run[\"max_cost_usd\"])),\n479\t    64\t            max_tool_calls_per_minute=int(run[\"max_tool_calls_per_minute\"]),\n480\t    65\t            max_subagents=int(run[\"max_subagents\"]),\n481\t    66\t            quotas_daily_usd={k: Decimal(str(v)) for k, v in cfg[\"quotas_daily_usd\"].items()},\n482\t    67\t            run_starts_per_minute={k: int(v) for k, v in cfg[\"run_starts_per_minute\"].items()},\n483\t    68\t        )\n484\t    69\t\n485\t    70\t    def _scopes(self) -> list[tuple[str, str]]:\n486\t    71\t        return [\n487\t    72\t            (\"user\", self.ident.accountable_party),\n488\t    73\t            (\"tenant\", self.ident.tenant),\n489\t    74\t            (\"fleet\", \"all\"),\n490\t    75\t        ]\n491\t    76\t\n492\t    77\t    # --- per-run limits -------------------------------------------------\n493\t    78\t\n494\t    79\t    def check_step(self) -> None:\n495\t    80\t        self.steps += 1\n496\t    81\t        if self.steps > self.max_steps:\n497\t    82\t            raise BudgetExceeded(\"max_steps\", self.steps, self.max_steps)\n498\t    83\t        elapsed = time.monotonic() - self.started_at\n499\t    84\t        if elapsed > self.max_wall_seconds:\n500\t    85\t            raise BudgetExceeded(\"max_wall_seconds\", round(elapsed, 1), self.max_wall_seconds)\n501\t    86\t\n502\t    87\t    def charge_model(self, model: str, usage) -> None:\n503\t    88\t        price_in, price_out = PRICES[model]\n504\t    89\t        tokens_in = (\n505\t    90\t            int(usage.input_tokens or 0)\n506\t    91\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n507\t    92\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n508\t    93\t        )\n509\t    94\t        tokens_out = int(usage.output_tokens or 0)\n510\t    95\t        self.tokens += tokens_in + tokens_out\n511\t    96\t        cost = (price_in * tokens_in + price_out * tokens_out) / Decimal(1_000_000)\n512\t    97\t        self.cost_usd += cost\n513\t    98\t        self.unflushed_cost_usd += cost\n514\t    99\t        if self.tokens > self.max_tokens:\n515\t   100\t            raise BudgetExceeded(\"max_tokens\", self.tokens, self.max_tokens)\n516\t   101\t        if self.cost_usd > self.max_cost_usd:\n517\t   102\t            raise BudgetExceeded(\"max_cost_usd\", self.cost_usd, self.max_cost_usd)\n518\t   103\t\n519\t   104\t    def check_tool_call(self, now: float | None = None) -> None:\n520\t   105\t        now = time.monotonic() if now is None else now\n521\t   106\t        while self._tool_calls and now - self._tool_calls[0] > 60:\n522\t   107\t            self._tool_calls.popleft()\n523\t   108\t        if len(self._tool_calls) >= self.max_tool_calls_per_minute:\n524\t   109\t            raise BudgetExceeded(\n525\t   110\t                \"max_tool_calls_per_minute\", len(self._tool_calls) + 1, self.max_tool_calls_per_minute\n526\t   111\t            )\n527\t   112\t        self._tool_calls.append(now)\n528\t   113\t\n529\t   114\t    def check_subagent(self) -> None:\n530\t   115\t        if self.subagents >= self.max_subagents:\n531\t   116\t            raise BudgetExceeded(\"max_subagents\", self.subagents + 1, self.max_subagents)\n532\t   117\t        self.subagents += 1\n533\t   118\t\n534\t   119\t    # --- cross-run quotas -----------------------------------------------\n535\t   120\t\n536\t   121\t    async def reserve_run_start(self, pool) -> None:\n537\t   122\t        async with pool.acquire() as conn:\n538\t   123\t            async with conn.transaction():\n539\t   124\t                for scope, key in self._scopes():\n540\t   125\t                    limit = self.run_starts_per_minute[scope]\n541\t   126\t                    count = await conn.fetchval(\n542\t   127\t                        \"\"\"\n543\t   128\t                        INSERT INTO run_start_window (scope, key, minute, starts)\n544\t   129\t                        VALUES ($1, $2, date_trunc('minute', now()), 1)\n545\t   130\t                        ON CONFLICT (scope, key, minute)\n546\t   131\t                        DO UPDATE SET starts = run_start_window.starts + 1\n547\t   132\t                        RETURNING starts\n548\t   133\t                        \"\"\",\n549\t   134\t                        scope,\n550\t   135\t                        key,\n551\t   136\t                    )\n552\t   137\t                    if count > limit:\n553\t   138\t                        raise BudgetExceeded(f\"run_starts_per_minute.{scope}\", count, limit)\n554\t   139\t\n555\t   140\t    async def flush(self, pool) -> None:\n556\t   141\t        \"\"\"Add this run's unflushed spend to the daily quotas, or stop the run.\"\"\"\n557\t   142\t        if self.unflushed_cost_usd <= 0:\n558\t   143\t            return\n559\t   144\t        amount = self.unflushed_cost_usd\n560\t   145\t        async with pool.acquire() as conn:\n561\t   146\t            async with conn.transaction():\n562\t   147\t                for scope, key in self._scopes():\n563\t   148\t                    limit = self.quotas_daily_usd[scope]\n564\t   149\t                    spent = await conn.fetchval(\n565\t   150\t                        \"\"\"\n566\t   151\t                        INSERT INTO spend_quota (scope, key, day, spent_usd)\n567\t   152\t                        VALUES ($1, $2, current_date, $3)\n568\t   153\t                        ON CONFLICT (scope, key, day)\n569\t   154\t                        DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd\n570\t   155\t                        RETURNING spent_usd\n571\t   156\t                        \"\"\",\n572\t   157\t                        scope,\n573\t   158\t                        key,\n574\t   159\t                        amount,\n575\t   160\t                    )\n576\t   161\t                    if spent > limit:\n577\t   162\t                        raise BudgetExceeded(f\"quota_daily_usd.{scope}\", spent, limit)\n578\t   163\t        self.unflushed_cost_usd = Decimal(\"0\")\n579\t=== ./app/context_size.py\n580\t     1\t\"\"\"Decision-time context size.\n581\t     2\t\n582\t     3\tCounting method (documented in README, \"Context size\"):\n583\t     4\t\n584\t     5\t1. Before each model call, the exact request (system prompt, messages and\n585\t     6\t   tool schemas) is sent to the provider's token-counting endpoint. The\n586\t     7\t   returned ``input_tokens`` is recorded with method ``count_tokens_api``.\n587\t     8\t   This is the size of the context the model decides on, including any\n588\t     9\t   prefix that will be served from the prompt cache.\n589\t    10\t2. If counting fails, the value is taken after the call from the response\n590\t    11\t   usage as ``input_tokens + cache_read_input_tokens +\n591\t    12\t   cache_creation_input_tokens`` and recorded with method\n592\t    13\t   ``usage_sum_estimate``.\n593\t    14\t3. If neither is available the value is ``NULL`` with method\n594\t    15\t   ``unavailable``. It is never recorded as zero.\n595\t    16\t\n596\t    17\t``compacted`` is true when the harness dropped or summarized earlier turns\n597\t    18\tbefore this call. Provider-side truncation is not visible to the harness and\n598\t    19\tis listed as a known limit.\n599\t    20\t\"\"\"\n600\t    21\tfrom __future__ import annotations\n601\t    22\t\n602\t    23\timport logging\n603\t    24\tfrom dataclasses import dataclass, replace\n604\t    25\t\n605\t    26\tlog = logging.getLogger(__name__)\n606\t    27\t\n607\t    28\t\n608\t    29\t@dataclass(frozen=True)\n609\t    30\tclass ContextMeasure:\n610\t    31\t    tokens: int | None\n611\t    32\t    method: str\n612\t    33\t    compacted: bool\n613\t    34\t\n614\t    35\t    @classmethod\n615\t    36\t    def unavailable(cls, compacted: bool = False) -> \"ContextMeasure\":\n616\t    37\t        return cls(tokens=None, method=\"unavailable\", compacted=compacted)\n617\t    38\t\n618\t    39\t    def finalize(self, usage) -> \"ContextMeasure\":\n619\t    40\t        if self.tokens is not None:\n620\t    41\t            return self\n621\t    42\t        if usage is None:\n622\t    43\t            return ContextMeasure.unavailable(self.compacted)\n623\t    44\t        total = (\n624\t    45\t            int(usage.input_tokens or 0)\n625\t    46\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n626\t    47\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n627\t    48\t        )\n628\t    49\t        if total <= 0:\n629\t    50\t            return ContextMeasure.unavailable(self.compacted)\n630\t    51\t        return replace(self, tokens=total, method=\"usage_sum_estimate\")\n631\t    52\t\n632\t    53\t    def otel_attributes(self) -> dict:\n633\t    54\t        attrs = {\n634\t    55\t            \"procurement.context.method\": self.method,\n635\t    56\t            \"gen_ai.conversation.compacted\": self.compacted,\n636\t    57\t        }\n637\t    58\t        if self.tokens is not None:\n638\t    59\t            attrs[\"procurement.context.tokens\"] = self.tokens\n639\t    60\t        return attrs\n640\t    61\t\n641\t    62\t\n642\t    63\tasync def measure_context(client, request: dict, compacted: bool) -> ContextMeasure:\n643\t    64\t    try:\n644\t    65\t        counted = await client.messages.count_tokens(\n645\t    66\t            model=request[\"model\"],\n646\t    67\t            system=request[\"system\"],\n647\t    68\t            messages=request[\"messages\"],\n648\t    69\t            tools=request[\"tools\"],\n649\t    70\t        )\n650\t    71\t        return ContextMeasure(int(counted.input_tokens), \"count_tokens_api\", compacted)\n651\t    72\t    except Exception:  # counting is best effort; finalize() falls back to usage\n652\t    73\t        log.warning(\"token count failed; falling back to usage\", exc_info=True)\n653\t    74\t        return ContextMeasure(tokens=None, method=\"pending_usage\", compacted=compacted)\n654\t=== ./app/extractor.py\n655\t     1\t\"\"\"Line-item extraction sub-agent.\n656\t     2\t\n657\t     3\tThe parent procurement agent delegates structured extraction to a smaller\n658\t     4\tmodel. The child runs under its own instance id, links to its parent in the\n659\t     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n660\t     6\t\"\"\"\n661\t     7\tfrom __future__ import annotations\n662\t     8\t\n663\t     9\timport json\n664\t    10\timport logging\n665\t    11\tfrom typing import Any\n666\t    12\t\n667\t    13\tfrom opentelemetry import trace\n668\t    14\t\n669\t    15\tfrom app import audit\n670\t    16\tfrom app.budget import Budget\n671\t    17\tfrom app.context_size import measure_context\n672\t    18\tfrom app.identity import RunIdentity\n673\t    19\tfrom app.redact import redact_for_model\n674\t    20\tfrom app.tools import build_registry\n675\t    21\t\n676\t    22\tlog = logging.getLogger(__name__)\n677\t    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n678\t    24\t\n679\t    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n680\t    26\tMAX_TURNS = 4\n681\t    27\t\n682\t    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n683\t    29\t\n684\t    30\t\n685\t    31\tclass ExtractionFailed(Exception):\n686\t    32\t    pass\n687\t    33\t\n688\t    34\t\n689\t    35\tclass LineItemExtractor:\n690\t    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n691\t    37\t        self.client = client\n692\t    38\t        self.settings = settings\n693\t    39\t        self.deps = deps\n694\t    40\t        self.system_prompt = system_prompt\n695\t    41\t\n696\t    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n697\t    43\t        budget.check_subagent()\n698\t    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n699\t    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n700\t    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n701\t    47\t\n702\t    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n703\t    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n704\t    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n705\t    51\t            start_node = await audit.record(\n706\t    52\t                self.deps.pool,\n707\t    53\t                ident,\n708\t    54\t                kind=\"subagent_started\",\n709\t    55\t                payload={\n710\t    56\t                    \"role\": EXTRACTOR_ROLE,\n711\t    57\t                    \"doc_id\": doc_id,\n712\t    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n713\t    59\t                    \"tools\": registry.names(),\n714\t    60\t                },\n715\t    61\t            )\n716\t    62\t\n717\t    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n718\t    64\t            for _turn in range(MAX_TURNS):\n719\t    65\t                budget.check_step()\n720\t    66\t                request = {\n721\t    67\t                    \"model\": self.settings.extractor_model_id,\n722\t    68\t                    \"system\": self.system_prompt,\n723\t    69\t                    \"messages\": messages,\n724\t    70\t                    \"tools\": registry.schemas(),\n725\t    71\t                    \"max_tokens\": 4096,\n726\t    72\t                }\n727\t    73\t                ctx = await measure_context(self.client, request, compacted=False)\n728\t    74\t                response = await self.client.messages.create(**request)\n729\t    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n730\t    76\t                await budget.flush(self.deps.pool)\n731\t    77\t                ctx = ctx.finalize(response.usage)\n732\t    78\t                decision = await audit.record(\n733\t    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n734\t    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n735\t    81\t                             \"stop_reason\": response.stop_reason},\n736\t    82\t                )\n737\t    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n738\t    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n739\t    85\t                if not uses:\n740\t    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n741\t    87\t                    items = _parse_items(text)\n742\t    88\t                    await audit.record(\n743\t    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n744\t    90\t                        payload={\"items\": len(items)},\n745\t    91\t                    )\n746\t    92\t                    return items\n747\t    93\t                results = []\n748\t    94\t                for use in uses:\n749\t    95\t                    budget.check_tool_call()\n750\t    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n751\t    97\t                messages.append({\"role\": \"user\", \"content\": results})\n752\t    98\t\n753\t    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n754\t   100\t\n755\t   101\t\n756\t   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n757\t   103\t    try:\n758\t   104\t        data = json.loads(text)\n759\t   105\t    except json.JSONDecodeError as exc:\n760\t   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n761\t   107\t    if not isinstance(data, list) or len(data) > 500:\n762\t   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n763\t   109\t    items = []\n764\t   110\t    for raw in data:\n765\t   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n766\t   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n767\t   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n768\t   114\t    return items\n769\t=== ./app/gate.py\n770\t     1\t\"\"\"Policy gate for tool calls.\n771\t     2\t\n772\t     3\tRuns in the harness between the model's proposed call and the integration.\n773\t     4\tHigh-impact operations are denied unless a valid approval exists; when none\n774\t     5\texists an approval request is opened and the call returns as pending.\n775\t     6\t\"\"\"\n776\t     7\tfrom __future__ import annotations\n777\t     8\t\n778\t     9\tfrom dataclasses import dataclass\n779\t    10\tfrom typing import Any\n780\t    11\t\n781\t    12\tfrom app.approvals import ApprovalStore\n782\t    13\tfrom app.identity import RunIdentity\n783\t    14\t\n784\t    15\t\n785\t    16\t@dataclass(frozen=True)\n786\t    17\tclass Decision:\n787\t    18\t    allow: bool\n788\t    19\t    reason: str\n789\t    20\t    policy_version: str\n790\t    21\t    approval_id: str | None = None\n791\t    22\t    pending: bool = False\n792\t    23\t\n793\t    24\t\n794\t    25\tclass PolicyGate:\n795\t    26\t    def __init__(self, policy: dict, approvals: ApprovalStore):\n796\t    27\t        self.version: str = policy[\"version\"]\n797\t    28\t        self.high_impact: frozenset[str] = frozenset(policy[\"high_impact_tools\"])\n798\t    29\t        self.erp_read_prefixes: tuple[str, ...] = tuple(policy[\"erp\"][\"read_prefixes\"])\n799\t    30\t        self.approvals = approvals\n800\t    31\t\n801\t    32\t    async def authorize(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n802\t    33\t        if tool.name == \"erp_call\":\n803\t    34\t            operation = str(args.get(\"operation\", \"\"))\n804\t    35\t            if not operation.startswith(self.erp_read_prefixes):\n805\t    36\t                return Decision(False, f\"erp operation not permitted: {operation}\", self.version)\n806\t    37\t            return Decision(True, \"erp read operation\", self.version)\n807\t    38\t\n808\t    39\t        if tool.name == \"post_slack_message\":\n809\t    40\t            if args.get(\"external\", False):\n810\t    41\t                return await self._require_approval(ident, tool, args)\n811\t    42\t            return Decision(True, \"internal staff message\", self.version)\n812\t    43\t\n813\t    44\t        if tool.name in self.high_impact:\n814\t    45\t            return await self._require_approval(ident, tool, args)\n815\t    46\t\n816\t    47\t        return Decision(True, \"low-impact tool\", self.version)\n817\t    48\t\n818\t    49\t    async def _require_approval(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n819\t    50\t        target = tool.target_of(args)\n820\t    51\t        approval = await self.approvals.find_valid(ident, tool.name, target)\n821\t    52\t        if approval is not None:\n822\t    53\t            return Decision(True, \"approved\", self.version, approval_id=approval.id)\n823\t    54\t        approval_id = await self.approvals.request(ident, tool.name, target, args)\n824\t    55\t        return Decision(\n825\t    56\t            False,\n826\t    57\t            \"approval required; request opened\",\n827\t    58\t            self.version,\n828\t    59\t            approval_id=approval_id,\n829\t    60\t            pending=True,\n830\t    61\t        )\n831\t=== ./app/identity.py\n832\t     1\t\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n833\t     2\t\n834\t     3\tThe agent runs under its own Kubernetes service account. Its projected\n835\t     4\tservice-account token is exchanged at the internal STS for short-lived,\n836\t     5\taudience-bound tokens. The launching user's token is never forwarded to an\n837\t     6\tintegration; the user is carried as the delegated subject of the exchange.\n838\t     7\t\"\"\"\n839\t     8\tfrom __future__ import annotations\n840\t     9\t\n841\t    10\timport hashlib\n842\t    11\timport json\n843\t    12\timport time\n844\t    13\timport uuid\n845\t    14\tfrom dataclasses import dataclass, field, replace\n846\t    15\tfrom pathlib import Path\n847\t    16\t\n848\t    17\timport httpx\n849\t    18\t\n850\t    19\tfrom app.settings import Settings\n851\t    20\t\n852\t    21\tIDENTITY_FIELDS = (\n853\t    22\t    \"accountable_party\",\n854\t    23\t    \"operational_owner\",\n855\t    24\t    \"tenant\",\n856\t    25\t    \"agent_type_id\",\n857\t    26\t    \"agent_instance_id\",\n858\t    27\t    \"trace_id\",\n859\t    28\t)\n860\t    29\t\n861\t    30\t\n862\t    31\t@dataclass(frozen=True)\n863\t    32\tclass RunIdentity:\n864\t    33\t    accountable_party: str\n865\t    34\t    operational_owner: str\n866\t    35\t    tenant: str\n867\t    36\t    agent_type_id: str\n868\t    37\t    agent_instance_id: str\n869\t    38\t    trace_id: str\n870\t    39\t    run_id: str\n871\t    40\t    delegated_subject: str\n872\t    41\t    agent_principal: str\n873\t    42\t    parent_instance_id: str | None = None\n874\t    43\t    role: str = \"procurement\"\n875\t    44\t\n876\t    45\t    def __post_init__(self) -> None:\n877\t    46\t        for name in IDENTITY_FIELDS:\n878\t    47\t            if not getattr(self, name):\n879\t    48\t                raise ValueError(f\"identity field {name} is empty\")\n880\t    49\t\n881\t    50\t    def child(self, role: str) -> \"RunIdentity\":\n882\t    51\t        return replace(\n883\t    52\t            self,\n884\t    53\t            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n885\t    54\t            parent_instance_id=self.agent_instance_id,\n886\t    55\t            role=role,\n887\t    56\t        )\n888\t    57\t\n889\t    58\t\n890\t    59\tdef new_instance_id() -> str:\n891\t    60\t    return f\"inst-{uuid.uuid4()}\"\n892\t    61\t\n893\t    62\t\n894\t    63\tdef compute_agent_type_id(manifest: dict) -> str:\n895\t    64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n896\t    65\t    material = {\n897\t    66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n898\t    67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n899\t    68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n900\t    69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n901\t    70\t        \"models\": manifest[\"models\"],\n902\t    71\t        \"config\": manifest[\"config\"],\n903\t    72\t        \"tools\": manifest[\"tool_pins\"],\n904\t    73\t    }\n905\t    74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n906\t    75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n907\t    76\t\n908\t    77\t\n909\t    78\t@dataclass\n910\t    79\tclass _CachedToken:\n911\t    80\t    value: str\n912\t    81\t    expires_at: float\n913\t    82\t\n914\t    83\t\n915\t    84\t@dataclass\n916\t    85\tclass TokenBroker:\n917\t    86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n918\t    87\t\n919\t    88\t    settings: Settings\n920\t    89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n921\t    90\t\n922\t    91\t    def _workload_token(self) -> str:\n923\t    92\t        return Path(self.settings.workload_token_path).read_text().strip()\n924\t    93\t\n925\t    94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n926\t    95\t        key = (audience, scope, ident.tenant)\n927\t    96\t        cached = self._cache.get(key)\n928\t    97\t        if cached and cached.expires_at - 30 > time.time():\n929\t    98\t            return cached.value\n930\t    99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n931\t   100\t            resp = await client.post(\n932\t   101\t                self.settings.sts_url,\n933\t   102\t                data={\n934\t   103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n935\t   104\t                    \"subject_token\": self._workload_token(),\n936\t   105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n937\t   106\t                    \"audience\": audience,\n938\t   107\t                    \"scope\": scope,\n939\t   108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n940\t   109\t                    \"actor_token\": ident.delegated_subject,\n941\t   110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n942\t   111\t                },\n943\t   112\t            )\n944\t   113\t            resp.raise_for_status()\n945\t   114\t            body = resp.json()\n946\t   115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n947\t   116\t        self._cache[key] = token\n948\t   117\t        return token.value\n949\t=== ./app/ingest.py"}]},"parent_tool_use_id":null,"session_id":"9a932460-770f-4311-8553-70e3bee77013","uuid":"067ad541-94bb-4be8-b177-dbad3b3f6600","timestamp":"2026-10-02T14:59:15.928Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-repeat-038tkh8l/9a932460-770f-4311-8553-70e3bee77013/tool-results/bo7ss49n1.txt","content":"    49\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    50\t      - uses: sigstore/cosign-installer@dc72c7d5c4d10cd6bcb8cf6e3fd625a9e5e537da # v3.7.0\n    51\t        with:\n    52\t          cosign-release: \"v2.6.2\"\n    53\t      - uses: docker/setup-buildx-action@c47758b77c9736f4b2ef4073d4d51994fabfe349 # v3.7.1\n    54\t      - uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0\n    55\t        with:\n    56\t          registry: registry.example-corp.test\n    57\t          username: ${{ github.actor }}\n    58\t          password: ${{ secrets.GITHUB_TOKEN }}\n    59\t      - id: build\n    60\t        uses: docker/build-push-action@4f58ea79222b3b9dc2c8bbdd6debcef730109a75 # v6.9.0\n    61\t        with:\n    62\t          context: .\n    63\t          push: true\n    64\t          tags: registry.example-corp.test/procurement/agent:${{ github.sha }}\n    65\t          provenance: false\n    66\t          sbom: false\n    67\t      - name: SBOM\n    68\t        uses: anchore/sbom-action@251a468eed47e5082b105c3ba6ee500c0e65a764 # v0.17.6\n    69\t        with:\n    70\t          image: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    71\t          format: cyclonedx-json\n    72\t          output-file: sbom.cdx.json\n    73\t      - name: Sign and attest\n    74\t        env:\n    75\t          IMAGE: registry.example-corp.test/procurement/agent@${{ steps.build.outputs.digest }}\n    76\t        run: |\n    77\t          cosign sign --yes \"$IMAGE\"\n    78\t          cosign attest --yes --type cyclonedx --predicate sbom.cdx.json \"$IMAGE\"\n    79\t      - uses: actions/attest-build-provenance@1c608d11d69870c2092266b3f9a6f3abbf17002c # v1.4.3\n    80\t        with:\n    81\t          subject-name: registry.example-corp.test/procurement/agent\n    82\t          subject-digest: ${{ steps.build.outputs.digest }}\n    83\t          push-to-registry: true\n=== ./Dockerfile\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.11.10-slim-bookworm@sha256:2a6386ad2db20e7f55073f69a98d6da2cf9f168e05e7487d2670c22e4ad2a1bd AS build\n     3\tWORKDIR /src\n     4\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     5\tCOPY pyproject.toml ./\n     6\tCOPY app ./app\n     7\tRUN pip install --target /opt/site .\n     8\tRUN python -m compileall -q app\n     9\t\n    10\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:8f3c1a6e2b9d4f7a0c5e8b1d3f6a9c2e5b8d1f4a7c0e3b6d9f2a5c8e1b4d7f0a\n    11\tWORKDIR /app\n    12\tENV PYTHONPATH=/opt/site:/app \\\n    13\t    PYTHONDONTWRITEBYTECODE=1 \\\n    14\t    APP_ROOT=/app\n    15\tCOPY --from=build /opt/site /opt/site\n    16\tCOPY --from=build /src/app /app/app\n    17\tCOPY prompts /app/prompts\n    18\tCOPY config /app/config\n    19\tCOPY release/manifest.yaml /app/release/manifest.yaml\n    20\tUSER 65532:65532\n    21\tEXPOSE 8080\n    22\tENTRYPOINT [\"python\", \"-m\", \"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\", \"--no-server-header\"]\n=== ./README.md\n     1\t# procurement-agent\n     2\t\n     3\tProcurement agent for Example Corp business units. It reads vendor quotes and\n     4\tinvoices that arrive by email, checks them against department budgets, raises\n     5\tpurchase orders in the ERP, pays matched invoices, and talks to staff and\n     6\tvendors in Slack. It keeps short per-department notes between runs.\n     7\t\n     8\t## Architecture\n     9\t\n    10\t```\n    11\tmail gateway --HMAC--> /ingest/mail --> documents (Postgres, per business unit)\n    12\tstaff (OIDC JWT) ----> /runs --> ProcurementAgent loop (app/loop.py)\n    13\t                                   |-- PolicyGate (app/gate.py) + approvals (Slack buttons)\n    14\t                                   |-- Budget (app/budget.py)\n    15\t                                   |-- audit graph (app/audit.py -> audit_events)\n    16\t                                   |-- tools:\n    17\t                                   |     read_document, extract_line_items -> LineItemExtractor sub-agent\n    18\t                                   |     get_budget, erp_call, create_purchase_order -> ERP MCP via gateway\n    19\t                                   |     pay_invoice -> payments API\n    20\t                                   |     post_slack_message -> Slack (via slack-proxy)\n    21\t                                   |     memory_read, memory_write -> dept_notes\n    22\t```\n    23\t\n    24\t* **Tenancy.** Each run belongs to one business unit, taken from the `bu`\n    25\t  claim of the caller's verified OIDC token. Documents, notes, approvals and\n    26\t  quotas are keyed by business unit.\n    27\t* **Identity.** The agent runs as the `procurement-agent` service account.\n    28\t  Its projected token (10-minute lifetime) is exchanged at the internal STS\n    29\t  for audience-bound tokens for the ERP gateway, payments API and Slack\n    30\t  proxy. User tokens are never forwarded.\n    31\t* **Approvals.** `create_purchase_order`, `pay_invoice` and vendor messages\n    32\t  require an approval from a role listed in `config/policy.yaml`. Approval\n    33\t  requests are posted to `#approvals-<bu>` with the argument summary.\n    34\t* **Budgets.** Per-run step, time, token, cost, tool-rate and sub-agent\n    35\t  limits, plus per-user, per-business-unit and fleet quotas for daily spend\n    36\t  and run starts. See `config/policy.yaml`.\n    37\t* **Audit.** Every run step is a row in `audit_events` linked to its parent\n    38\t  step, with the six identity fields, policy version, approval id and\n    39\t  decision-time context size. The agent's database role can insert audit\n    40\t  rows but not update or delete them.\n    41\t\n    42\t## Context size\n    43\t\n    44\tLogged on every audit row as `context_tokens` and `context_method`:\n    45\t\n    46\t| method | meaning |\n    47\t|---|---|\n    48\t| `count_tokens_api` | exact request counted with the provider's token-count endpoint before the call (includes cached prefix) |\n    49\t| `usage_sum_estimate` | counting failed; `input_tokens + cache_read + cache_creation` from the response |\n    50\t| `unavailable` | neither available; `context_tokens` is NULL, never 0 |\n    51\t\n    52\t`context_compacted` is true when the harness dropped earlier turns before the\n    53\tcall (`app/loop.py:_compact`). Provider-side truncation is not visible.\n    54\t\n    55\t## Operating\n    56\t\n    57\t* **Halt.** Insert or update a row in `control_flags` (`scope = 'fleet'` or\n    58\t  `'tenant:<bu>'`, `halted = true`) as `procurement_ops`. New runs refuse to\n    59\t  start while a halt is set.\n    60\t* **Release.** Merges to `main` build, sign (keyless cosign), and attest the\n    61\t  image (SLSA provenance and CycloneDX SBOM). Kyverno rejects unsigned or\n    62\t  unattested images in `procurement-prod`.\n    63\t* **Network.** Default-deny egress with explicit rules for DNS, the egress\n    64\t  proxy, the Slack proxy, the database, the ERP gateway and the STS.\n    65\t\n    66\t## Tests\n    67\t\n    68\t```bash\n    69\tpip install -e '.[test]'\n    70\tpytest -q\n    71\t```\n=== ./app/__init__.py\n=== ./app/approvals.py\n     1\t\"\"\"Approval requests and decisions for high-impact operations.\n     2\t\n     3\tRequests are posted to the business unit's approvals channel in Slack with\n     4\tthe full argument summary. Approvers decide with the Slack buttons; the\n     5\tinteractive callback is signature-checked in main.py and then calls\n     6\t``decide``. Approver authority is checked against the role map in policy.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport json\n    11\timport uuid\n    12\tfrom dataclasses import dataclass\n    13\tfrom datetime import datetime, timedelta, timezone\n    14\tfrom typing import Any\n    15\t\n    16\tfrom app.audit import digest, summarize_args\n    17\tfrom app.identity import RunIdentity\n    18\t\n    19\t\n    20\t@dataclass(frozen=True)\n    21\tclass Approval:\n    22\t    id: str\n    23\t    approver: str\n    24\t    approver_role: str\n    25\t    expires_at: datetime\n    26\t\n    27\t\n    28\tclass ApproverNotAuthorized(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tclass ApprovalStore:\n    33\t    def __init__(self, pool, policy: dict, notifier):\n    34\t        self.pool = pool\n    35\t        self.ttl = timedelta(minutes=int(policy[\"approvals\"][\"ttl_minutes\"]))\n    36\t        self.approver_roles: dict[str, list[str]] = policy[\"approvals\"][\"approver_roles\"]\n    37\t        self.notifier = notifier\n    38\t\n    39\t    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n    40\t        approval_id = f\"apr-{uuid.uuid4()}\"\n    41\t        expires_at = datetime.now(timezone.utc) + self.ttl\n    42\t        await self.pool.execute(\n    43\t            \"\"\"\n    44\t            INSERT INTO approvals (\n    45\t                id, tool, target, args_sha256, args_summary, tenant,\n    46\t                requested_by_instance, requested_by_run, delegated_subject,\n    47\t                status, requested_at, expires_at\n    48\t            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)\n    49\t            \"\"\",\n    50\t            approval_id,\n    51\t            tool,\n    52\t            target,\n    53\t            digest(args),\n    54\t            json.dumps(summarize_args(args)),\n    55\t            ident.tenant,\n    56\t            ident.agent_instance_id,\n    57\t            ident.run_id,\n    58\t            ident.delegated_subject,\n    59\t            expires_at,\n    60\t        )\n    61\t        await self.notifier.post_approval_request(\n    62\t            tenant=ident.tenant,\n    63\t            approval_id=approval_id,\n    64\t            tool=tool,\n    65\t            target=target,\n    66\t            summary=summarize_args(args),\n    67\t            expires_at=expires_at,\n    68\t        )\n    69\t        return approval_id\n    70\t\n    71\t    async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:\n    72\t        row = await self.pool.fetchrow(\n    73\t            \"\"\"\n    74\t            SELECT id, approver, approver_role, expires_at\n    75\t            FROM approvals\n    76\t            WHERE tool = $1\n    77\t              AND target = $2\n    78\t              AND tenant = $3\n    79\t              AND status = 'approved'\n    80\t              AND expires_at > now()\n    81\t            ORDER BY decided_at DESC\n    82\t            LIMIT 1\n    83\t            \"\"\",\n    84\t            tool,\n    85\t            target,\n    86\t            ident.tenant,\n    87\t        )\n    88\t        if row is None:\n    89\t            return None\n    90\t        if row[\"approver_role\"] not in self.approver_roles.get(tool, []):\n    91\t            return None\n    92\t        return Approval(row[\"id\"], row[\"approver\"], row[\"approver_role\"], row[\"expires_at\"])\n    93\t\n    94\t    async def decide(self, approval_id: str, approver: str, approver_role: str, approve: bool) -> None:\n    95\t        row = await self.pool.fetchrow(\n    96\t            \"SELECT tool, status, expires_at FROM approvals WHERE id = $1\", approval_id\n    97\t        )\n    98\t        if row is None or row[\"status\"] != \"pending\":\n    99\t            raise ValueError(\"approval is not pending\")\n   100\t        if row[\"expires_at\"] <= datetime.now(timezone.utc):\n   101\t            raise ValueError(\"approval request expired\")\n   102\t        if approver_role not in self.approver_roles.get(row[\"tool\"], []):\n   103\t            raise ApproverNotAuthorized(f\"{approver_role} cannot approve {row['tool']}\")\n   104\t        await self.pool.execute(\n   105\t            \"\"\"\n   106\t            UPDATE approvals\n   107\t            SET status = $2, approver = $3, approver_role = $4, decided_at = now()\n   108\t            WHERE id = $1 AND status = 'pending'\n   109\t            \"\"\",\n   110\t            approval_id,\n   111\t            \"approved\" if approve else \"rejected\",\n   112\t            approver,\n   113\t            approver_role,\n   114\t        )\n=== ./app/audit.py\n     1\t\"\"\"Execution audit graph.\n     2\t\n     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n     5\ttool call -> authorization decision -> result or error. Writes are\n     6\tsynchronous and are made before the action they describe; if the write\n     7\tfails, the caller raises and the action does not run.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport hashlib\n    12\timport json\n    13\timport uuid\n    14\tfrom datetime import datetime, timezone\n    15\tfrom typing import Any\n    16\t\n    17\tfrom opentelemetry import trace\n    18\t\n    19\tfrom app.context_size import ContextMeasure\n    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n    21\tfrom app.redact import redact_value\n    22\t\n    23\tEVENT_KINDS = {\n    24\t    \"run_started\",\n    25\t    \"run_finished\",\n    26\t    \"run_halted\",\n    27\t    \"model_decision\",\n    28\t    \"tool_proposed\",\n    29\t    \"authz_decision\",\n    30\t    \"approval_requested\",\n    31\t    \"approval_decided\",\n    32\t    \"tool_result\",\n    33\t    \"tool_error\",\n    34\t    \"tool_denied\",\n    35\t    \"budget_exceeded\",\n    36\t    \"subagent_started\",\n    37\t    \"subagent_finished\",\n    38\t    \"background_job\",\n    39\t}\n    40\t\n    41\t_INSERT = \"\"\"\n    42\tINSERT INTO audit_events (\n    43\t    node_id, parent_node_id, run_id, ts, kind,\n    44\t    accountable_party, operational_owner, tenant,\n    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n    46\t    delegated_subject, agent_principal, parent_instance_id,\n    47\t    policy_version, approval_id, operation_id,\n    48\t    context_tokens, context_method, context_compacted,\n    49\t    payload\n    50\t) VALUES (\n    51\t    $1, $2, $3, $4, $5,\n    52\t    $6, $7, $8,\n    53\t    $9, $10, $11, $12,\n    54\t    $13, $14, $15,\n    55\t    $16, $17, $18,\n    56\t    $19, $20, $21,\n    57\t    $22::jsonb\n    58\t)\n    59\t\"\"\"\n    60\t\n    61\t\n    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n    64\t    return {k: redact_value(v) for k, v in args.items()}\n    65\t\n    66\t\n    67\tdef digest(value: Any) -> str:\n    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    70\t\n    71\t\n    72\tasync def record(\n    73\t    pool,\n    74\t    ident: RunIdentity,\n    75\t    *,\n    76\t    kind: str,\n    77\t    payload: dict[str, Any] | None = None,\n    78\t    parent: str | None = None,\n    79\t    context: ContextMeasure | None = None,\n    80\t    policy_version: str | None = None,\n    81\t    approval_id: str | None = None,\n    82\t    operation_id: str | None = None,\n    83\t) -> str:\n    84\t    if kind not in EVENT_KINDS:\n    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n    86\t    for name in IDENTITY_FIELDS:\n    87\t        if not getattr(ident, name):\n    88\t            raise ValueError(f\"audit record missing {name}\")\n    89\t    span_ctx = trace.get_current_span().get_span_context()\n    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n    91\t    node_id = f\"node-{uuid.uuid4()}\"\n    92\t    measure = context or ContextMeasure.unavailable()\n    93\t    await pool.execute(\n    94\t        _INSERT,\n    95\t        node_id,\n    96\t        parent,\n    97\t        ident.run_id,\n    98\t        datetime.now(timezone.utc),\n    99\t        kind,\n   100\t        ident.accountable_party,\n   101\t        ident.operational_owner,\n   102\t        ident.tenant,\n   103\t        ident.agent_type_id,\n   104\t        ident.agent_instance_id,\n   105\t        ident.trace_id,\n   106\t        span_id,\n   107\t        ident.delegated_subject,\n   108\t        ident.agent_principal,\n   109\t        ident.parent_instance_id,\n   110\t        policy_version,\n   111\t        approval_id,\n   112\t        operation_id,\n   113\t        measure.tokens,\n   114\t        measure.method,\n   115\t        measure.compacted,\n   116\t        json.dumps(redact_value(payload or {}), default=str),\n   117\t    )\n   118\t    return node_id\n=== ./app/budget.py\n     1\t\"\"\"Hard execution budgets, enforced by the harness and not by the model.\n     2\t\n     3\tPer run: step count, wall-clock time, tokens, cost, tool-call rate, and\n     4\tnumber of sub-agents. Sub-agents charge the parent's budget, so a child\n     5\tcannot widen what the parent was given.\n     6\t\n     7\tAcross runs: daily spend and per-minute run starts per user, per tenant\n     8\t(business unit), and for the whole fleet. Quotas are reserved in Postgres\n     9\tinside one transaction, so concurrent runs cannot overshoot them.\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport time\n    14\tfrom collections import deque\n    15\tfrom dataclasses import dataclass, field\n    16\tfrom decimal import Decimal\n    17\t\n    18\tfrom app.identity import RunIdentity\n    19\t\n    20\t\n    21\tclass BudgetExceeded(Exception):\n    22\t    def __init__(self, limit: str, used, allowed):\n    23\t        super().__init__(f\"{limit} exceeded: used={used} allowed={allowed}\")\n    24\t        self.limit = limit\n    25\t        self.used = used\n    26\t        self.allowed = allowed\n    27\t\n    28\t\n    29\t# USD per million tokens, from the provider price sheet referenced in the manifest.\n    30\tPRICES = {\n    31\t    \"claude-sonnet-4-5-20250929\": (Decimal(\"3.00\"), Decimal(\"15.00\")),\n    32\t    \"claude-haiku-4-5-20251001\": (Decimal(\"1.00\"), Decimal(\"5.00\")),\n    33\t}\n    34\t\n    35\t\n    36\t@dataclass\n    37\tclass Budget:\n    38\t    ident: RunIdentity\n    39\t    max_steps: int\n    40\t    max_wall_seconds: float\n    41\t    max_tokens: int\n    42\t    max_cost_usd: Decimal\n    43\t    max_tool_calls_per_minute: int\n    44\t    max_subagents: int\n    45\t    quotas_daily_usd: dict[str, Decimal]\n    46\t    run_starts_per_minute: dict[str, int]\n    47\t    started_at: float = field(default_factory=time.monotonic)\n    48\t    steps: int = 0\n    49\t    tokens: int = 0\n    50\t    cost_usd: Decimal = Decimal(\"0\")\n    51\t    unflushed_cost_usd: Decimal = Decimal(\"0\")\n    52\t    subagents: int = 0\n    53\t    _tool_calls: deque = field(default_factory=deque)\n    54\t\n    55\t    @classmethod\n    56\t    def for_run(cls, cfg: dict, ident: RunIdentity) -> \"Budget\":\n    57\t        run = cfg[\"per_run\"]\n    58\t        return cls(\n    59\t            ident=ident,\n    60\t            max_steps=int(run[\"max_steps\"]),\n    61\t            max_wall_seconds=float(run[\"max_wall_seconds\"]),\n    62\t            max_tokens=int(run[\"max_tokens\"]),\n    63\t            max_cost_usd=Decimal(str(run[\"max_cost_usd\"])),\n    64\t            max_tool_calls_per_minute=int(run[\"max_tool_calls_per_minute\"]),\n    65\t            max_subagents=int(run[\"max_subagents\"]),\n    66\t            quotas_daily_usd={k: Decimal(str(v)) for k, v in cfg[\"quotas_daily_usd\"].items()},\n    67\t            run_starts_per_minute={k: int(v) for k, v in cfg[\"run_starts_per_minute\"].items()},\n    68\t        )\n    69\t\n    70\t    def _scopes(self) -> list[tuple[str, str]]:\n    71\t        return [\n    72\t            (\"user\", self.ident.accountable_party),\n    73\t            (\"tenant\", self.ident.tenant),\n    74\t            (\"fleet\", \"all\"),\n    75\t        ]\n    76\t\n    77\t    # --- per-run limits -------------------------------------------------\n    78\t\n    79\t    def check_step(self) -> None:\n    80\t        self.steps += 1\n    81\t        if self.steps > self.max_steps:\n    82\t            raise BudgetExceeded(\"max_steps\", self.steps, self.max_steps)\n    83\t        elapsed = time.monotonic() - self.started_at\n    84\t        if elapsed > self.max_wall_seconds:\n    85\t            raise BudgetExceeded(\"max_wall_seconds\", round(elapsed, 1), self.max_wall_seconds)\n    86\t\n    87\t    def charge_model(self, model: str, usage) -> None:\n    88\t        price_in, price_out = PRICES[model]\n    89\t        tokens_in = (\n    90\t            int(usage.input_tokens or 0)\n    91\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n    92\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n    93\t        )\n    94\t        tokens_out = int(usage.output_tokens or 0)\n    95\t        self.tokens += tokens_in + tokens_out\n    96\t        cost = (price_in * tokens_in + price_out * tokens_out) / Decimal(1_000_000)\n    97\t        self.cost_usd += cost\n    98\t        self.unflushed_cost_usd += cost\n    99\t        if self.tokens > self.max_tokens:\n   100\t            raise BudgetExceeded(\"max_tokens\", self.tokens, self.max_tokens)\n   101\t        if self.cost_usd > self.max_cost_usd:\n   102\t            raise BudgetExceeded(\"max_cost_usd\", self.cost_usd, self.max_cost_usd)\n   103\t\n   104\t    def check_tool_call(self, now: float | None = None) -> None:\n   105\t        now = time.monotonic() if now is None else now\n   106\t        while self._tool_calls and now - self._tool_calls[0] > 60:\n   107\t            self._tool_calls.popleft()\n   108\t        if len(self._tool_calls) >= self.max_tool_calls_per_minute:\n   109\t            raise BudgetExceeded(\n   110\t                \"max_tool_calls_per_minute\", len(self._tool_calls) + 1, self.max_tool_calls_per_minute\n   111\t            )\n   112\t        self._tool_calls.append(now)\n   113\t\n   114\t    def check_subagent(self) -> None:\n   115\t        if self.subagents >= self.max_subagents:\n   116\t            raise BudgetExceeded(\"max_subagents\", self.subagents + 1, self.max_subagents)\n   117\t        self.subagents += 1\n   118\t\n   119\t    # --- cross-run quotas -----------------------------------------------\n   120\t\n   121\t    async def reserve_run_start(self, pool) -> None:\n   122\t        async with pool.acquire() as conn:\n   123\t            async with conn.transaction():\n   124\t                for scope, key in self._scopes():\n   125\t                    limit = self.run_starts_per_minute[scope]\n   126\t                    count = await conn.fetchval(\n   127\t                        \"\"\"\n   128\t                        INSERT INTO run_start_window (scope, key, minute, starts)\n   129\t                        VALUES ($1, $2, date_trunc('minute', now()), 1)\n   130\t                        ON CONFLICT (scope, key, minute)\n   131\t                        DO UPDATE SET starts = run_start_window.starts + 1\n   132\t                        RETURNING starts\n   133\t                        \"\"\",\n   134\t                        scope,\n   135\t                        key,\n   136\t                    )\n   137\t                    if count > limit:\n   138\t                        raise BudgetExceeded(f\"run_starts_per_minute.{scope}\", count, limit)\n   139\t\n   140\t    async def flush(self, pool) -> None:\n   141\t        \"\"\"Add this run's unflushed spend to the daily quotas, or stop the run.\"\"\"\n   142\t        if self.unflushed_cost_usd <= 0:\n   143\t            return\n   144\t        amount = self.unflushed_cost_usd\n   145\t        async with pool.acquire() as conn:\n   146\t            async with conn.transaction():\n   147\t                for scope, key in self._scopes():\n   148\t                    limit = self.quotas_daily_usd[scope]\n   149\t                    spent = await conn.fetchval(\n   150\t                        \"\"\"\n   151\t                        INSERT INTO spend_quota (scope, key, day, spent_usd)\n   152\t                        VALUES ($1, $2, current_date, $3)\n   153\t                        ON CONFLICT (scope, key, day)\n   154\t                        DO UPDATE SET spent_usd = spend_quota.spent_usd + EXCLUDED.spent_usd\n   155\t                        RETURNING spent_usd\n   156\t                        \"\"\",\n   157\t                        scope,\n   158\t                        key,\n   159\t                        amount,\n   160\t                    )\n   161\t                    if spent > limit:\n   162\t                        raise BudgetExceeded(f\"quota_daily_usd.{scope}\", spent, limit)\n   163\t        self.unflushed_cost_usd = Decimal(\"0\")\n=== ./app/context_size.py\n     1\t\"\"\"Decision-time context size.\n     2\t\n     3\tCounting method (documented in README, \"Context size\"):\n     4\t\n     5\t1. Before each model call, the exact request (system prompt, messages and\n     6\t   tool schemas) is sent to the provider's token-counting endpoint. The\n     7\t   returned ``input_tokens`` is recorded with method ``count_tokens_api``.\n     8\t   This is the size of the context the model decides on, including any\n     9\t   prefix that will be served from the prompt cache.\n    10\t2. If counting fails, the value is taken after the call from the response\n    11\t   usage as ``input_tokens + cache_read_input_tokens +\n    12\t   cache_creation_input_tokens`` and recorded with method\n    13\t   ``usage_sum_estimate``.\n    14\t3. If neither is available the value is ``NULL`` with method\n    15\t   ``unavailable``. It is never recorded as zero.\n    16\t\n    17\t``compacted`` is true when the harness dropped or summarized earlier turns\n    18\tbefore this call. Provider-side truncation is not visible to the harness and\n    19\tis listed as a known limit.\n    20\t\"\"\"\n    21\tfrom __future__ import annotations\n    22\t\n    23\timport logging\n    24\tfrom dataclasses import dataclass, replace\n    25\t\n    26\tlog = logging.getLogger(__name__)\n    27\t\n    28\t\n    29\t@dataclass(frozen=True)\n    30\tclass ContextMeasure:\n    31\t    tokens: int | None\n    32\t    method: str\n    33\t    compacted: bool\n    34\t\n    35\t    @classmethod\n    36\t    def unavailable(cls, compacted: bool = False) -> \"ContextMeasure\":\n    37\t        return cls(tokens=None, method=\"unavailable\", compacted=compacted)\n    38\t\n    39\t    def finalize(self, usage) -> \"ContextMeasure\":\n    40\t        if self.tokens is not None:\n    41\t            return self\n    42\t        if usage is None:\n    43\t            return ContextMeasure.unavailable(self.compacted)\n    44\t        total = (\n    45\t            int(usage.input_tokens or 0)\n    46\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n    47\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n    48\t        )\n    49\t        if total <= 0:\n    50\t            return ContextMeasure.unavailable(self.compacted)\n    51\t        return replace(self, tokens=total, method=\"usage_sum_estimate\")\n    52\t\n    53\t    def otel_attributes(self) -> dict:\n    54\t        attrs = {\n    55\t            \"procurement.context.method\": self.method,\n    56\t            \"gen_ai.conversation.compacted\": self.compacted,\n    57\t        }\n    58\t        if self.tokens is not None:\n    59\t            attrs[\"procurement.context.tokens\"] = self.tokens\n    60\t        return attrs\n    61\t\n    62\t\n    63\tasync def measure_context(client, request: dict, compacted: bool) -> ContextMeasure:\n    64\t    try:\n    65\t        counted = await client.messages.count_tokens(\n    66\t            model=request[\"model\"],\n    67\t            system=request[\"system\"],\n    68\t            messages=request[\"messages\"],\n    69\t            tools=request[\"tools\"],\n    70\t        )\n    71\t        return ContextMeasure(int(counted.input_tokens), \"count_tokens_api\", compacted)\n    72\t    except Exception:  # counting is best effort; finalize() falls back to usage\n    73\t        log.warning(\"token count failed; falling back to usage\", exc_info=True)\n    74\t        return ContextMeasure(tokens=None, method=\"pending_usage\", compacted=compacted)\n=== ./app/extractor.py\n     1\t\"\"\"Line-item extraction sub-agent.\n     2\t\n     3\tThe parent procurement agent delegates structured extraction to a smaller\n     4\tmodel. The child runs under its own instance id, links to its parent in the\n     5\taudit graph, charges the parent's budget, and gets the extractor tool role.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport json\n    10\timport logging\n    11\tfrom typing import Any\n    12\t\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom app import audit\n    16\tfrom app.budget import Budget\n    17\tfrom app.context_size import measure_context\n    18\tfrom app.identity import RunIdentity\n    19\tfrom app.redact import redact_for_model\n    20\tfrom app.tools import build_registry\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\ttracer = trace.get_tracer(\"procurement.extractor\")\n    24\t\n    25\tEXTRACTOR_ROLE = \"line_item_extractor\"\n    26\tMAX_TURNS = 4\n    27\t\n    28\tLINE_ITEMS_SCHEMA_KEYS = {\"sku\", \"description\", \"quantity\", \"unit_price_cents\", \"currency\"}\n    29\t\n    30\t\n    31\tclass ExtractionFailed(Exception):\n    32\t    pass\n    33\t\n    34\t\n    35\tclass LineItemExtractor:\n    36\t    def __init__(self, *, client, settings, deps, system_prompt: str):\n    37\t        self.client = client\n    38\t        self.settings = settings\n    39\t        self.deps = deps\n    40\t        self.system_prompt = system_prompt\n    41\t\n    42\t    async def extract(self, parent: RunIdentity, doc_id: str, budget: Budget) -> list[dict[str, Any]]:\n    43\t        budget.check_subagent()\n    44\t        ident = parent.child(role=EXTRACTOR_ROLE)\n    45\t        registry = build_registry(EXTRACTOR_ROLE, ident, self.deps)\n    46\t        task = f\"Extract every line item from document {doc_id}. Return JSON only.\"\n    47\t\n    48\t        with tracer.start_as_current_span(\"gen_ai.invoke_agent line_item_extractor\") as span:\n    49\t            span.set_attribute(\"gen_ai.agent.id\", ident.agent_instance_id)\n    50\t            span.set_attribute(\"procurement.parent_instance_id\", parent.agent_instance_id)\n    51\t            start_node = await audit.record(\n    52\t                self.deps.pool,\n    53\t                ident,\n    54\t                kind=\"subagent_started\",\n    55\t                payload={\n    56\t                    \"role\": EXTRACTOR_ROLE,\n    57\t                    \"doc_id\": doc_id,\n    58\t                    \"parent_prompt_ref\": format(span.get_span_context().span_id, \"016x\"),\n    59\t                    \"tools\": registry.names(),\n    60\t                },\n    61\t            )\n    62\t\n    63\t            messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n    64\t            for _turn in range(MAX_TURNS):\n    65\t                budget.check_step()\n    66\t                request = {\n    67\t                    \"model\": self.settings.extractor_model_id,\n    68\t                    \"system\": self.system_prompt,\n    69\t                    \"messages\": messages,\n    70\t                    \"tools\": registry.schemas(),\n    71\t                    \"max_tokens\": 4096,\n    72\t                }\n    73\t                ctx = await measure_context(self.client, request, compacted=False)\n    74\t                response = await self.client.messages.create(**request)\n    75\t                budget.charge_model(self.settings.extractor_model_id, response.usage)\n    76\t                await budget.flush(self.deps.pool)\n    77\t                ctx = ctx.finalize(response.usage)\n    78\t                decision = await audit.record(\n    79\t                    self.deps.pool, ident, kind=\"model_decision\", parent=start_node, context=ctx,\n    80\t                    payload={\"requested_model\": request[\"model\"], \"served_model\": response.model,\n    81\t                             \"stop_reason\": response.stop_reason},\n    82\t                )\n    83\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n    84\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n    85\t                if not uses:\n    86\t                    text = \"\".join(b.text for b in response.content if b.type == \"text\")\n    87\t                    items = _parse_items(text)\n    88\t                    await audit.record(\n    89\t                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n    90\t                        payload={\"items\": len(items)},\n    91\t                    )\n    92\t                    return items\n    93\t                results = []\n    94\t                for use in uses:\n    95\t                    budget.check_tool_call()\n    96\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n    97\t                messages.append({\"role\": \"user\", \"content\": results})\n    98\t\n    99\t        raise ExtractionFailed(f\"no result after {MAX_TURNS} turns\")\n   100\t\n   101\t\n   102\tdef _parse_items(text: str) -> list[dict[str, Any]]:\n   103\t    try:\n   104\t        data = json.loads(text)\n   105\t    except json.JSONDecodeError as exc:\n   106\t        raise ExtractionFailed(\"extractor returned non-JSON output\") from exc\n   107\t    if not isinstance(data, list) or len(data) > 500:\n   108\t        raise ExtractionFailed(\"extractor output must be a list of at most 500 items\")\n   109\t    items = []\n   110\t    for raw in data:\n   111\t        if not isinstance(raw, dict) or not set(raw) <= LINE_ITEMS_SCHEMA_KEYS:\n   112\t            raise ExtractionFailed(\"unexpected line-item fields\")\n   113\t        items.append({k: redact_for_model(v) if isinstance(v, str) else v for k, v in raw.items()})\n   114\t    return items\n=== ./app/gate.py\n     1\t\"\"\"Policy gate for tool calls.\n     2\t\n     3\tRuns in the harness between the model's proposed call and the integration.\n     4\tHigh-impact operations are denied unless a valid approval exists; when none\n     5\texists an approval request is opened and the call returns as pending.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom typing import Any\n    11\t\n    12\tfrom app.approvals import ApprovalStore\n    13\tfrom app.identity import RunIdentity\n    14\t\n    15\t\n    16\t@dataclass(frozen=True)\n    17\tclass Decision:\n    18\t    allow: bool\n    19\t    reason: str\n    20\t    policy_version: str\n    21\t    approval_id: str | None = None\n    22\t    pending: bool = False\n    23\t\n    24\t\n    25\tclass PolicyGate:\n    26\t    def __init__(self, policy: dict, approvals: ApprovalStore):\n    27\t        self.version: str = policy[\"version\"]\n    28\t        self.high_impact: frozenset[str] = frozenset(policy[\"high_impact_tools\"])\n    29\t        self.erp_read_prefixes: tuple[str, ...] = tuple(policy[\"erp\"][\"read_prefixes\"])\n    30\t        self.approvals = approvals\n    31\t\n    32\t    async def authorize(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n    33\t        if tool.name == \"erp_call\":\n    34\t            operation = str(args.get(\"operation\", \"\"))\n    35\t            if not operation.startswith(self.erp_read_prefixes):\n    36\t                return Decision(False, f\"erp operation not permitted: {operation}\", self.version)\n    37\t            return Decision(True, \"erp read operation\", self.version)\n    38\t\n    39\t        if tool.name == \"post_slack_message\":\n    40\t            if args.get(\"external\", False):\n    41\t                return await self._require_approval(ident, tool, args)\n    42\t            return Decision(True, \"internal staff message\", self.version)\n    43\t\n    44\t        if tool.name in self.high_impact:\n    45\t            return await self._require_approval(ident, tool, args)\n    46\t\n    47\t        return Decision(True, \"low-impact tool\", self.version)\n    48\t\n    49\t    async def _require_approval(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n    50\t        target = tool.target_of(args)\n    51\t        approval = await self.approvals.find_valid(ident, tool.name, target)\n    52\t        if approval is not None:\n    53\t            return Decision(True, \"approved\", self.version, approval_id=approval.id)\n    54\t        approval_id = await self.approvals.request(ident, tool.name, target, args)\n    55\t        return Decision(\n    56\t            False,\n    57\t            \"approval required; request opened\",\n    58\t            self.version,\n    59\t            approval_id=approval_id,\n    60\t            pending=True,\n    61\t        )\n=== ./app/identity.py\n     1\t\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n     2\t\n     3\tThe agent runs under its own Kubernetes service account. Its projected\n     4\tservice-account token is exchanged at the internal STS for short-lived,\n     5\taudience-bound tokens. The launching user's token is never forwarded to an\n     6\tintegration; the user is carried as the delegated subject of the exchange.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport time\n    13\timport uuid\n    14\tfrom dataclasses import dataclass, field, replace\n    15\tfrom pathlib import Path\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.settings import Settings\n    20\t\n    21\tIDENTITY_FIELDS = (\n    22\t    \"accountable_party\",\n    23\t    \"operational_owner\",\n    24\t    \"tenant\",\n    25\t    \"agent_type_id\",\n    26\t    \"agent_instance_id\",\n    27\t    \"trace_id\",\n    28\t)\n    29\t\n    30\t\n    31\t@dataclass(frozen=True)\n    32\tclass RunIdentity:\n    33\t    accountable_party: str\n    34\t    operational_owner: str\n    35\t    tenant: str\n    36\t    agent_type_id: str\n    37\t    agent_instance_id: str\n    38\t    trace_id: str\n    39\t    run_id: str\n    40\t    delegated_subject: str\n    41\t    agent_principal: str\n    42\t    parent_instance_id: str | None = None\n    43\t    role: str = \"procurement\"\n    44\t\n    45\t    def __post_init__(self) -> None:\n    46\t        for name in IDENTITY_FIELDS:\n    47\t            if not getattr(self, name):\n    48\t                raise ValueError(f\"identity field {name} is empty\")\n    49\t\n    50\t    def child(self, role: str) -> \"RunIdentity\":\n    51\t        return replace(\n    52\t            self,\n    53\t            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n    54\t            parent_instance_id=self.agent_instance_id,\n    55\t            role=role,\n    56\t        )\n    57\t\n    58\t\n    59\tdef new_instance_id() -> str:\n    60\t    return f\"inst-{uuid.uuid4()}\"\n    61\t\n    62\t\n    63\tdef compute_agent_type_id(manifest: dict) -> str:\n    64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    65\t    material = {\n    66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n    67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n    68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n    69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n    70\t        \"models\": manifest[\"models\"],\n    71\t        \"config\": manifest[\"config\"],\n    72\t        \"tools\": manifest[\"tool_pins\"],\n    73\t    }\n    74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n    76\t\n    77\t\n    78\t@dataclass\n    79\tclass _CachedToken:\n    80\t    value: str\n    81\t    expires_at: float\n    82\t\n    83\t\n    84\t@dataclass\n    85\tclass TokenBroker:\n    86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n    87\t\n    88\t    settings: Settings\n    89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n    90\t\n    91\t    def _workload_token(self) -> str:\n    92\t        return Path(self.settings.workload_token_path).read_text().strip()\n    93\t\n    94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n    95\t        key = (audience, scope, ident.tenant)\n    96\t        cached = self._cache.get(key)\n    97\t        if cached and cached.expires_at - 30 > time.time():\n    98\t            return cached.value\n    99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n   100\t            resp = await client.post(\n   101\t                self.settings.sts_url,\n   102\t                data={\n   103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n   104\t                    \"subject_token\": self._workload_token(),\n   105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n   106\t                    \"audience\": audience,\n   107\t                    \"scope\": scope,\n   108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n   109\t                    \"actor_token\": ident.delegated_subject,\n   110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n   111\t                },\n   112\t            )\n   113\t            resp.raise_for_status()\n   114\t            body = resp.json()\n   115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n   116\t        self._cache[key] = token\n   117\t        return token.value\n=== ./app/ingest.py","numLines":900,"startLine":50,"totalLines":3420}}}
