ame: erp-mcp-gateway\n62\t      ports:\n63\t        - { protocol: TCP, port: 8443 }\n64\t    - to:\n65\t        - namespaceSelector:\n66\t            matchLabels:\n67\t              kubernetes.io/metadata.name: identity\n68\t          podSelector:\n69\t            matchLabels:\n70\t              app: sts\n71\t      ports:\n72\t        - { protocol: TCP, port: 443 }\n73\t    - to:\n74\t        - ipBlock:\n75\t            cidr: 0.0.0.0/0\n76\t            except:\n77\t              - 10.0.0.0/8\n78\t              - 172.16.0.0/12\n79\t              - 192.168.0.0/16\n80\t              - 169.254.0.0/16\n81\t      ports:\n82\t        - { protocol: TCP, port: 443 }\n83\t---\n84\tapiVersion: networking.k8s.io/v1\n85\tkind: NetworkPolicy\n86\tmetadata:\n87\t  name: procurement-agent-ingress\n88\t  namespace: procurement-prod\n89\tspec:\n90\t  podSelector:\n91\t    matchLabels:\n92\t      app: procurement-agent\n93\t  policyTypes: [\"Ingress\"]\n94\t  ingress:\n95\t    - from:\n96\t        - namespaceSelector:\n97\t            matchLabels:\n98\t              kubernetes.io/metadata.name: ingress\n99\t      ports:\n100\t        - { protocol: TCP, port: 8080 }\n101\t---\n102\t# Egress proxy allowlist (applied in the egress namespace by the platform team).\n103\tapiVersion: v1\n104\tkind: ConfigMap\n105\tmetadata:\n106\t  name: egress-proxy-allowlist-procurement\n107\t  namespace: egress\n108\tdata:\n109\t  allowlist.txt: |\n110\t    api.anthropic.com\n111\t    api.payments.example-pay.test\n112\t    login.example-corp.test\n113\t"}]},"parent_tool_use_id":null,"session_id":"d0ef42b1-c1f7-49d9-899d-3a741d2b0498","uuid":"2bef769f-fbbc-48ea-9b4f-ac8fab085023","timestamp":"2026-10-02T15:13:15.883Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-yr2kpyp0/agent/deploy/k8s/networkpolicy.yaml","content":"apiVersion: networking.k8s.io/v1\nkind: NetworkPolicy\nmetadata:\n  name: procurement-agent-default-deny\n 