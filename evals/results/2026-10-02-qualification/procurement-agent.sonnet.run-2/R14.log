{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012fd7zcQU2cn8PXunrffK47","type":"tool_result","content":"1\t\"\"\"Approval requests and decisions for high-impact operations.\n2\t\n3\tRequests are posted to the business unit's approvals channel in Slack with\n4\tthe full argument summary. Approvers decide with the Slack buttons; the\n5\tinteractive callback is signature-checked in main.py and then calls\n6\t``decide``. Approver authority is checked against the role map in policy.\n7\t\"\"\"\n8\tfrom __future__ import annotations\n9\t\n10\timport json\n11\timport uuid\n12\tfrom dataclasses import dataclass\n13\tfrom datetime import datetime, timedelta, timezone\n14\tfrom typing import Any\n15\t\n16\tfrom app.audit import digest, summarize_args\n17\tfrom app.identity import RunIdentity\n18\t\n19\t\n20\t@dataclass(frozen=True)\n21\tclass Approval:\n22\t    id: str\n23\t    approver: str\n24\t    approver_role: str\n25\t    expires_at: datetime\n26\t\n27\t\n28\tclass ApproverNotAuthorized(Exception):\n29\t    pass\n30\t\n31\t\n32\tclass ApprovalStore:\n33\t    def __init__(self, pool, policy: dict, notifier):\n34\t        self.pool = pool\n35\t        self.ttl = timedelta(minutes=int(policy[\"approvals\"][\"ttl_minutes\"]))\n36\t        self.approver_roles: dict[str, list[str]] = policy[\"approvals\"][\"approver_roles\"]\n37\t        self.notifier = notifier\n38\t\n39\t    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n40\t        approval_id = f\"apr-{uuid.uuid4()}\"\n41\t        expires_at = datetime.now(timezone.utc) + self.ttl\n42\t        await self.pool.execute(\n43\t            \"\"\"\n44\t            INSERT INTO approvals (\n45\t                id, tool, target, args_sha256, args_summary, tenant,\n46\t                requested_by_instance, requested_by_run, delegated_subject,\n47\t                status, requested_at, expires_at\n48\t            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)\n49\t            \"\"\",\n50\t            approval_id,\n51\t            tool,\n52\t            target,\n53\t            digest(args),\n54\t            json.dumps(summarize_args(args)),\n55\t            ident.tenant,\n56\t            ident.agent_instance_id,\n57\t            ident.run_id,\n58\t            ident.delegated_subject,\n59\t            expires_at,\n60\t        )\n61\t        await self.notifier.post_approval_request(\n62\t            tenant=ident.tenant,\n63\t            approval_id=approval_id,\n64\t            tool=tool,\n65\t            target=target,\n66\t            summary=summarize_args(args),\n67\t            expires_at=expires_at,\n68\t        )\n69\t        return approval_id\n70\t\n71\t    async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:\n72\t        row = await self.pool.fetchrow(\n73\t            \"\"\"\n74\t            SELECT id, approver, approver_role, expires_at\n75\t            FROM approvals\n76\t            WHERE tool = $1\n77\t              AND target = $2\n78\t              AND tenant = $3\n79\t              AND status = 'approved'\n80\t              AND expires_at > now()\n81\t            ORDER BY decided_at DESC\n82\t            LIMIT 1\n83\t            \"\"\",\n84\t            tool,\n85\t            target,\n86\t            ident.tenant,\n87\t        )\n88\t        if row is None:\n89\t            return None\n90\t        if row[\"approver_role\"] not in self.approver_roles.get(tool, []):\n91\t            return None\n92\t        return Approval(row[\"id\"], row[\"approver\"], row[\"approver_role\"], row[\"expires_at\"])\n93\t\n94\t    async def decide(self, approval_id: str, approver: str, approver_role: str, approve: bool) -> None:\n95\t        row = await self.pool.fetchrow(\n96\t            \"SELECT tool, status, expires_at FROM approvals WHERE id = $1\", approval_id\n97\t        )\n98\t        if row is None or row[\"status\"] != \"pending\":\n99\t            raise ValueError(\"approval is not pending\")\n100\t        if row[\"expires_at\"] <= datetime.now(timezone.utc):\n101\t            raise ValueError(\"approval request expired\")\n102\t        if approver_role not in self.approver_roles.get(row[\"tool\"], []):\n103\t            raise ApproverNotAuthorized(f\"{approver_role} cannot approve {row['tool']}\")\n104\t        await self.pool.execute(\n105\t            \"\"\"\n106\t            UPDATE approvals\n107\t            SET status = $2, approver = $3, approver_role = $4, decided_at = now()\n108\t            WHERE id = $1 AND status = 'pending'\n109\t            \"\"\",\n110\t            approval_id,\n111\t            \"approved\" if approve else \"rejected\",\n112\t            approver,\n113\t            approver_role,\n114\t        )\n115\t"}]},"parent_tool_use_id":null,"session_id":"b77a2b72-3781-4b8d-95ab-92a7851b40ba","uuid":"2c160410-c6dd-45d6-969e-62b84d8fb6a0","timestamp":"2026-10-02T15:16:31.101Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-0u8u6125/agent/app/approvals.py","content":"\"\"\"Approval requests and decisions for high-impact operations.\n\nRequests are posted to the business unit's approvals channel in Slack with\nthe full argument summary. Approvers decide with the Slack buttons; the\ninteractive callback is signature-checked in main.py and then calls\n``decide``. Approver authority is checked against the role map in policy.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport uuid\nfrom dataclasses import dataclass\nfrom datetime import datetime, timedelta, timezone\nfrom typing import Any\n\nfrom app.audit import digest, summarize_args\nfrom app.identity import RunIdentity\n\n\n@dataclass(frozen=True)\nclass Approval:\n    id: str\n    approver: str\n    approver_role: str\n    expires_at: datetime\n\n\nclass ApproverNotAuthorized(Exception):\n    pass\n\n\nclass ApprovalStore:\n    def __init__(self, pool, policy: dict, notifier):\n        self.pool = pool\n        self.ttl = timedelta(minutes=int(policy[\"approvals\"][\"ttl_minutes\"]))\n        self.approver_roles: dict[str, list[str]] = policy[\"approvals\"][\"approver_roles\"]\n        self.notifier = notifier\n\n    async def request(self, ident: RunIdentity, tool: str, target: str, args: dict[str, Any]) -> str:\n        approval_id = f\"apr-{uuid.uuid4()}\"\n        expires_at = datetime.now(timezone.utc) + self.ttl\n        await self.pool.execute(\n            \"\"\"\n            INSERT INTO approvals (\n                id, tool, target, args_sha256, args_summary, tenant,\n                requested_by_instance, requested_by_run, delegated_subject,\n                status, requested_at, expires_at\n            ) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7, $8, $9, 'pending', now(), $10)\n            \"\"\",\n            approval_id,\n            tool,\n            target,\n            digest(args),\n            json.dumps(summarize_args(args)),\n            ident.tenant,\n            ident.agent_instance_id,\n            ident.run_id,\n            ident.delegated_subject,\n            expires_at,\n        )\n        await self.notifier.post_approval_request(\n            tenant=ident.tenant,\n            approval_id=approval_id,\n            tool=tool,\n            target=target,\n            summary=summarize_args(args),\n            expires_at=expires_at,\n        )\n        return approval_id\n\n    async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:\n        row = await self.pool.fetchrow(\n            \"\"\"\n            SELECT id, approver, approver_role, expires_at\n            FROM approvals\n            WHERE tool = $1\n              AND target = $2\n              AND tenant = $3\n              AND status = 'approved'\n              AND expires_at > now()\n            ORDER BY decided_at DESC\n            LIMIT 1\n            \"\"\",\n            tool,\n            target,\n            ident.tenant,\n        )\n        if row is None:\n            return None\n        if row[\"approver_role\"] not in self.approver_roles.get(tool, []):\n            return None\n        return Approval(row[\"id\"], row[\"approver\"], row[\"approver_role\"], row[\"expires_at\"])\n\n    async def decide(self, approval_id: str, approver: str, approver_role: str, approve: bool) -> None:\n        row = await self.pool.fetchrow(\n            \"SELECT tool, status, expires_at FROM approvals WHERE id = $1\", approval_id\n        )\n        if row is None or row[\"status\"] != \"pending\":\n            raise ValueError(\"approval is not pending\")\n        if row[\"expires_at\"] <= datetime.now(timezone.utc):\n            raise ValueError(\"approval request expired\")\n        if approver_role not in self.approver_roles.get(row[\"tool\"], []):\n            raise ApproverNotAuthorized(f\"{approver_role} cannot approve {row['tool']}\")\n        await self.pool.execute(\n            \"\"\"\n            UPDATE approvals\n            SET status = $2, approver = $3, approver_role = $4, decided_at = now()\n            WHERE id = $1 AND status = 'pending'\n            \"\"\",\n            approval_id,\n            \"approved\" if approve else \"rejected\",\n            approver,\n            approver_role,\n        )\n","numLines":115,"startLine":1,"totalLines":115}}}
