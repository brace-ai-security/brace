{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Evgrw1u36hopUxmCmGtqfr","type":"tool_result","content":"1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport asyncio\n5\timport hashlib\n6\timport hmac\n7\timport json\n8\timport logging\n9\timport time\n10\timport uuid\n11\tfrom contextlib import asynccontextmanager\n12\tfrom pathlib import Path\n13\tfrom urllib.parse import parse_qs\n14\t\n15\timport asyncpg\n16\timport jwt\n17\tfrom anthropic import AsyncAnthropic\n18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n20\tfrom opentelemetry import trace\n21\tfrom pydantic import BaseModel, Field\n22\t\n23\tfrom app import audit, ingest\n24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n25\tfrom app.extractor import LineItemExtractor\n26\tfrom app.gate import PolicyGate\n27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n28\tfrom app.loop import AgentDeps, ProcurementAgent\n29\tfrom app.mcp_client import ErpMcpClient\n30\tfrom app.redact import RedactingFilter\n31\tfrom app.settings import get_settings\n32\tfrom app.startup import startup_checks\n33\tfrom app.tools.slack import SlackClient\n34\t\n35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n36\tfor handler in logging.getLogger().handlers:\n37\t    handler.addFilter(RedactingFilter())\n38\tlog = logging.getLogger(\"procurement\")\n39\t\n40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n41\tbearer = HTTPBearer()\n42\t\n43\t\n44\tclass RunRequest(BaseModel):\n45\t    task: str = Field(min_length=1, max_length=4000)\n46\t    department: str = Field(min_length=1, max_length=64)\n47\t\n48\t\n49\tclass Principal(BaseModel):\n50\t    subject: str\n51\t    business_unit: str\n52\t\n53\t\n54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n55\t    return RunIdentity(\n56\t        accountable_party=\"system:procurement-agent\",\n57\t        operational_owner=settings.operational_owner,\n58\t        tenant=tenant,\n59\t        agent_type_id=agent_type_id,\n60\t        agent_instance_id=new_instance_id(),\n61\t        trace_id=uuid.uuid4().hex,\n62\t        run_id=f\"bg-{uuid.uuid4()}\",\n63\t        delegated_subject=\"system:procurement-agent\",\n64\t        agent_principal=AGENT_PRINCIPAL,\n65\t    )\n66\t\n67\t\n68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n69\t    while True:\n70\t        await asyncio.sleep(60)\n71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n72\t        count = await app.state.pool.fetchval(\n73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n75\t        )\n76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n78\t\n79\t\n80\t@asynccontextmanager\n81\tasync def lifespan(app: FastAPI):\n82\t    settings = get_settings()\n83\t    agent_type_id = startup_checks(settings)\n84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n85\t    broker = TokenBroker(settings)\n86\t\n87\t    async def slack_token() -> str:\n88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n89\t\n90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n92\t    gate = PolicyGate(settings.policy, approvals)\n93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n94\t    await erp.initialize(service_identity(settings, agent_type_id))\n95\t\n96\t    client = AsyncAnthropic()\n97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n98\t    deps.extractor = LineItemExtractor(\n99\t        client=client, settings=settings, deps=deps,\n100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n101\t    )\n102\t    app.state.settings = settings\n103\t    app.state.pool = pool\n104\t    app.state.agent_type_id = agent_type_id\n105\t    app.state.approvals = approvals\n106\t    app.state.agent = ProcurementAgent(\n107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n108\t    )\n109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n111\t    try:\n112\t        yield\n113\t    finally:\n114\t        sweeper.cancel()\n115\t        await pool.close()\n116\t\n117\t\n118\tapp = FastAPI(lifespan=lifespan)\n119\tapp.include_router(ingest.router)\n120\t\n121\t\n122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n123\t    settings = request.app.state.settings\n124\t    try:\n125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n126\t        claims = jwt.decode(\n127\t            creds.credentials,\n128\t            key.key,\n129\t            algorithms=[\"RS256\", \"ES256\"],\n130\t            audience=settings.oidc_audience,\n131\t            issuer=settings.oidc_issuer,\n132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n133\t        )\n134\t    except jwt.PyJWTError as exc:\n135\t        raise HTTPException(401, \"invalid token\") from exc\n136\t    bu = claims.get(\"bu\")\n137\t    if not bu:\n138\t        raise HTTPException(403, \"token has no business unit\")\n139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n140\t\n141\t\n142\t@app.post(\"/runs\")\n143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n144\t    settings = request.app.state.settings\n145\t    span_ctx = trace.get_current_span().get_span_context()\n146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n147\t    ident = RunIdentity(\n148\t        accountable_party=principal.subject,\n149\t        operational_owner=settings.operational_owner,\n150\t        tenant=principal.business_unit,\n151\t        agent_type_id=request.app.state.agent_type_id,\n152\t        agent_instance_id=new_instance_id(),\n153\t        trace_id=trace_id,\n154\t        run_id=f\"run-{uuid.uuid4()}\",\n155\t        delegated_subject=principal.subject,\n156\t        agent_principal=AGENT_PRINCIPAL,\n157\t    )\n158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n161\t\n162\t\n163\t@app.post(\"/slack/interactions\")\n164\tasync def slack_interactions(request: Request) -> dict:\n165\t    body = await request.body()\n166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n167\t    if abs(time.time() - int(timestamp)) > 300:\n168\t        raise HTTPException(401, \"stale request\")\n169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n172\t        raise HTTPException(401, \"bad signature\")\n173\t\n174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n175\t    action = payload[\"actions\"][0]\n176\t    slack_user = payload[\"user\"][\"id\"]\n177\t    row = await request.app.state.pool.fetchrow(\n178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n179\t    )\n180\t    if row is None:\n181\t        raise HTTPException(403, \"not an approver\")\n182\t    try:\n183\t        await request.app.state.approvals.decide(\n184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n185\t            approve=action[\"action_id\"] == \"approve\",\n186\t        )\n187\t    except ApproverNotAuthorized as exc:\n188\t        raise HTTPException(403, str(exc)) from exc\n189\t    except ValueError as exc:\n190\t        raise HTTPException(409, str(exc)) from exc\n191\t    return {\"ok\": True}\n192\t\n193\t\n194\t@app.get(\"/healthz\")\n195\tasync def healthz() -> dict:\n196\t    return {\"ok\": True}\n197\t"}]},"parent_tool_use_id":null,"session_id":"b77a2b72-3781-4b8d-95ab-92a7851b40ba","uuid":"6a5b7d41-4154-4308-9569-e0fdab3cf88e","timestamp":"2026-10-02T15:16:30.394Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-0u8u6125/agent/app/main.py","content":"\"\"\"FastAPI entry point for the procurement agent.\"\"\"\nfrom __future__ import annotations\n\nimport asyncio\nimport hashlib\nimport hmac\nimport json\nimport logging\nimport time\nimport uuid\nfrom contextlib import asynccontextmanager\nfrom pathlib import Path\nfrom urllib.parse import parse_qs\n\nimport asyncpg\nimport jwt\nfrom anthropic import AsyncAnthropic\nfrom fastapi import Depends, FastAPI, HTTPException, Request\nfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\nfrom opentelemetry import trace\nfrom pydantic import BaseModel, Field\n\nfrom app import audit, ingest\nfrom app.approvals import ApprovalStore, ApproverNotAuthorized\nfrom app.extractor import LineItemExtractor\nfrom app.gate import PolicyGate\nfrom app.identity import RunIdentity, TokenBroker, new_instance_id\nfrom app.loop import AgentDeps, ProcurementAgent\nfrom app.mcp_client import ErpMcpClient\nfrom app.redact import RedactingFilter\nfrom app.settings import get_settings\nfrom app.startup import startup_checks\nfrom app.tools.slack import SlackClient\n\nlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\nfor handler in logging.getLogger().handlers:\n    handler.addFilter(RedactingFilter())\nlog = logging.getLogger(\"procurement\")\n\nAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\nbearer = HTTPBearer()\n\n\nclass RunRequest(BaseModel):\n    task: str = Field(min_length=1, max_length=4000)\n    department: str = Field(min_length=1, max_length=64)\n\n\nclass Principal(BaseModel):\n    subject: str\n    business_unit: str\n\n\ndef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    return RunIdentity(\n        accountable_party=\"system:procurement-agent\",\n        operational_owner=settings.operational_owner,\n        tenant=tenant,\n        agent_type_id=agent_type_id,\n        agent_instance_id=new_instance_id(),\n        trace_id=uuid.uuid4().hex,\n        run_id=f\"bg-{uuid.uuid4()}\",\n        delegated_subject=\"system:procurement-agent\",\n        agent_principal=AGENT_PRINCIPAL,\n    )\n\n\nasync def expire_approvals_forever(app: FastAPI) -> None:\n    while True:\n        await asyncio.sleep(60)\n        ident = service_identity(app.state.settings, app.state.agent_type_id)\n        count = await app.state.pool.fetchval(\n            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n        )\n        await audit.record(app.state.pool, ident, kind=\"background_job\",\n                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n\n\n@asynccontextmanager\nasync def lifespan(app: FastAPI):\n    settings = get_settings()\n    agent_type_id = startup_checks(settings)\n    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    broker = TokenBroker(settings)\n\n    async def slack_token() -> str:\n        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n\n    slack = SlackClient(settings.slack_api_url, slack_token)\n    approvals = ApprovalStore(pool, settings.policy, slack)\n    gate = PolicyGate(settings.policy, approvals)\n    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    await erp.initialize(service_identity(settings, agent_type_id))\n\n    client = AsyncAnthropic()\n    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    deps.extractor = LineItemExtractor(\n        client=client, settings=settings, deps=deps,\n        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n    )\n    app.state.settings = settings\n    app.state.pool = pool\n    app.state.agent_type_id = agent_type_id\n    app.state.approvals = approvals\n    app.state.agent = ProcurementAgent(\n        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n    )\n    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n    sweeper = asyncio.create_task(expire_approvals_forever(app))\n    try:\n        yield\n    finally:\n        sweeper.cancel()\n        await pool.close()\n\n\napp = FastAPI(lifespan=lifespan)\napp.include_router(ingest.router)\n\n\ndef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n    settings = request.app.state.settings\n    try:\n        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n        claims = jwt.decode(\n            creds.credentials,\n            key.key,\n            algorithms=[\"RS256\", \"ES256\"],\n            audience=settings.oidc_audience,\n            issuer=settings.oidc_issuer,\n            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n        )\n    except jwt.PyJWTError as exc:\n        raise HTTPException(401, \"invalid token\") from exc\n    bu = claims.get(\"bu\")\n    if not bu:\n        raise HTTPException(403, \"token has no business unit\")\n    return Principal(subject=claims[\"sub\"], business_unit=bu)\n\n\n@app.post(\"/runs\")\nasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n    settings = request.app.state.settings\n    span_ctx = trace.get_current_span().get_span_context()\n    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n    ident = RunIdentity(\n        accountable_party=principal.subject,\n        operational_owner=settings.operational_owner,\n        tenant=principal.business_unit,\n        agent_type_id=request.app.state.agent_type_id,\n        agent_instance_id=new_instance_id(),\n        trace_id=trace_id,\n        run_id=f\"run-{uuid.uuid4()}\",\n        delegated_subject=principal.subject,\n        agent_principal=AGENT_PRINCIPAL,\n    )\n    task = f\"Department: {req.department}\\n\\n{req.task}\"\n    asyncio.create_task(request.app.state.agent.run(ident, task))\n    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n\n\n@app.post(\"/slack/interactions\")\nasync def slack_interactions(request: Request) -> dict:\n    body = await request.body()\n    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n    if abs(time.time() - int(timestamp)) > 300:\n        raise HTTPException(401, \"stale request\")\n    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n        raise HTTPException(401, \"bad signature\")\n\n    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n    action = payload[\"actions\"][0]\n    slack_user = payload[\"user\"][\"id\"]\n    row = await request.app.state.pool.fetchrow(\n        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n    )\n    if row is None:\n        raise HTTPException(403, \"not an approver\")\n    try:\n        await request.app.state.approvals.decide(\n            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n            approve=action[\"action_id\"] == \"approve\",\n        )\n    except ApproverNotAuthorized as exc:\n        raise HTTPException(403, str(exc)) from exc\n    except ValueError as exc:\n        raise HTTPException(409, str(exc)) from exc\n    return {\"ok\": True}\n\n\n@app.get(\"/healthz\")\nasync def healthz() -> dict:\n    return {\"ok\": True}\n","numLines":197,"startLine":1,"totalLines":197}}}
