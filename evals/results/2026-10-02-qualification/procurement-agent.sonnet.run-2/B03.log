{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G3pA8zxDf8kiH4CFcnaYrB","type":"tool_result","content":"1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport os\n5\tfrom dataclasses import dataclass\n6\tfrom functools import lru_cache\n7\tfrom pathlib import Path\n8\t\n9\timport yaml\n10\t\n11\t\n12\tdef _env(name: str, default: str | None = None) -> str:\n13\t    value = os.environ.get(name, default)\n14\t    if value is None:\n15\t        raise RuntimeError(f\"missing required setting {name}\")\n16\t    return value\n17\t\n18\t\n19\t@dataclass(frozen=True)\n20\tclass Settings:\n21\t    database_url: str\n22\t    erp_mcp_url: str\n23\t    payments_api_url: str\n24\t    slack_api_url: str\n25\t    sts_url: str\n26\t    oidc_issuer: str\n27\t    oidc_audience: str\n28\t    oidc_jwks_url: str\n29\t    workload_token_path: str\n30\t    slack_signing_secret_path: str\n31\t    mail_gateway_hmac_path: str\n32\t    model_id: str\n33\t    extractor_model_id: str\n34\t    manifest_path: Path\n35\t    prompt_dir: Path\n36\t    policy_path: Path\n37\t    tools_path: Path\n38\t    operational_owner: str\n39\t    image_digest: str\n40\t\n41\t    @property\n42\t    def policy(self) -> dict:\n43\t        return _load_yaml(self.policy_path)\n44\t\n45\t    @property\n46\t    def manifest(self) -> dict:\n47\t        return _load_yaml(self.manifest_path)\n48\t\n49\t    @property\n50\t    def budgets(self) -> dict:\n51\t        return self.policy[\"budgets\"]\n52\t\n53\t\n54\tdef _load_yaml(path: Path) -> dict:\n55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n56\t        return yaml.safe_load(fh)\n57\t\n58\t\n59\t@lru_cache(maxsize=1)\n60\tdef get_settings() -> Settings:\n61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n62\t    return Settings(\n63\t        database_url=_env(\"DATABASE_URL\"),\n64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n67\t        sts_url=_env(\"STS_URL\"),\n68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n71\t        workload_token_path=_env(\n72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n73\t        ),\n74\t        slack_signing_secret_path=_env(\n75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n76\t        ),\n77\t        mail_gateway_hmac_path=_env(\n78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n79\t        ),\n80\t        model_id=_env(\"MODEL_ID\"),\n81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n83\t        prompt_dir=root / \"prompts\",\n84\t        policy_path=root / \"config\" / \"policy.yaml\",\n85\t        tools_path=root / \"config\" / \"tools.yaml\",\n86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n88\t    )\n89\t"}]},"parent_tool_use_id":null,"session_id":"0c942f6c-f301-4bf3-af81-77d8b8b17cc7","uuid":"cdd70dbe-b93c-46ec-a42c-9d9863551039","timestamp":"2026-10-02T15:10:13.124Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-j6uzhho9/agent/app/settings.py","content":"\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom dataclasses import dataclass\nfrom functools import lru_cache\nfrom pathlib import Path\n\nimport yaml\n\n\ndef _env(name: str, default: str | None = None) -> str:\n    value = os.environ.get(name, default)\n    if value is None:\n        raise RuntimeError(f\"missing required setting {name}\")\n    return value\n\n\n@dataclass(frozen=True)\nclass Settings:\n    database_url: str\n    erp_mcp_url: str\n    payments_api_url: str\n    slack_api_url: str\n    sts_url: str\n    oidc_issuer: str\n    oidc_audience: str\n    oidc_jwks_url: str\n    workload_token_path: str\n    slack_signing_secret_path: str\n    mail_gateway_hmac_path: str\n    model_id: str\n    extractor_model_id: str\n    manifest_path: Path\n    prompt_dir: Path\n    policy_path: Path\n    tools_path: Path\n    operational_owner: str\n    image_digest: str\n\n    @property\n    def policy(self) -> dict:\n        return _load_yaml(self.policy_path)\n\n    @property\n    def manifest(self) -> dict:\n        return _load_yaml(self.manifest_path)\n\n    @property\n    def budgets(self) -> dict:\n        return self.policy[\"budgets\"]\n\n\ndef _load_yaml(path: Path) -> dict:\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\n        return yaml.safe_load(fh)\n\n\n@lru_cache(maxsize=1)\ndef get_settings() -> Settings:\n    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    return Settings(\n        database_url=_env(\"DATABASE_URL\"),\n        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n        sts_url=_env(\"STS_URL\"),\n        oidc_issuer=_env(\"OIDC_ISSUER\"),\n        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n        workload_token_path=_env(\n            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n        ),\n        slack_signing_secret_path=_env(\n            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n        ),\n        mail_gateway_hmac_path=_env(\n            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n        ),\n        model_id=_env(\"MODEL_ID\"),\n        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n        manifest_path=root / \"release\" / \"manifest.yaml\",\n        prompt_dir=root / \"prompts\",\n        policy_path=root / \"config\" / \"policy.yaml\",\n        tools_path=root / \"config\" / \"tools.yaml\",\n        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n        image_digest=_env(\"IMAGE_DIGEST\"),\n    )\n","numLines":89,"startLine":1,"totalLines":89}}}
