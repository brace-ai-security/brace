rp\"][\"operation_scopes\"]\n37\t  51          return scopes.get(operation, \"erp.read\")\n38\t  52  \n39\t  53      async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n40\t  54          self._contexts[ident.agent_instance_id] = ctx\n41\t  55>         proposed = await audit.record(\n42\t  56              self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n43\t  57              payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n44\t  58          )\n45\t  59          tool = registry.get(use.name)\n46\t  60          if tool is None:\n47\t  61              await audit.record(\n48\t  62                  self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n49\t  63                  policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n50\t  64              )\n51\t  65              return _error(use.id, f\"tool {use.name} is not available to this agent\")\n52\t  66  \n53\t  67          decision = await self.gate.authorize(ident, tool, use.input)\n54\t```\n55\t\n56\t## R07.2\n57\t\n58\t**Check:** Each value is labeled measured, estimated, or unavailable, and a missing value is stored as unknown, never as zero.\n59\t\n60\t**How to verify:** 1) Find where context size is recorded. 2) Check a label of measured, estimated, or unavailable, and how missing values are stored. 3) Answer no if there is no label, or a missing value defaults to `0` (`or 0`, `?? 0`, `.get(..., 0)`).\n61\t\n62\t**Reviewer's evidence:** app/context_size.py:37 — \"return cls(tokens=None, method=\"unavailable\", compacted=compacted)\"\n63\t\n64\t**Reviewer's note:** Method label is stored and missing values are NULL, with a DB check rejecting zero\n65\t\n66\t`app/context_size.py` lines 25–49 (cited lines marked >):\n67\t```\n68\t  25  \n69\t  26  log = logging.getLogger(__name__)\n70\t  27  \n71\t  28  \n72\t  29  @dataclass(frozen=