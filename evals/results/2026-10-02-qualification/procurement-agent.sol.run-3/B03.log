"""Agent identity: who is acting, for whom, and as which agent type.

The agent runs under its own Kubernetes service account. Its projected
service-account token is exchanged at the internal STS for short-lived,
audience-bound tokens. The launching user's token is never forwarded to an
integration; the user is carried as the delegated subject of the exchange.
"""
from __future__ import annotations

import hashlib
import json
import time
import uuid
from dataclasses import dataclass, field, replace
from pathlib import Path

import httpx

from app.settings import Settings

IDENTITY_FIELDS = (
    "accountable_party",
    "operational_owner",
    "tenant",
    "agent_type_id",
    "agent_instance_id",
    "trace_id",
)


@dataclass(frozen=True)
class RunIdentity:
    accountable_party: str
    operational_owner: str
    tenant: str
    agent_type_id: str
    agent_instance_id: str
    trace_id: str
    run_id: str
    delegated_subject: str
    agent_principal: str
    parent_instance_id: str | None = None
    role: str = "procurement"

    def __post_init__(self) -> None:
        for name in IDENTITY_FIELDS:
            if not getattr(self, name):
                raise ValueError(f"identity field {name} is empty")

    def child(self, role: str) -> "RunIdentity":
        return replace(
            self,
            agent_instance_id=f"inst-{uuid.uuid4()}",
            parent_instance_id=self.agent_instance_id,
            role=role,
        )


def new_instance_id() -> str:
    return f"inst-{uuid.uuid4()}"


def compute_agent_type_id(manifest: dict) -> str:
    """Content-derived agent type id over the frozen release manifest."""
    material = {
        "image_digest": manifest["image"]["digest"],
        "harness_digest": manifest["harness"]["digest"],
        "system_prompt": manifest["prompts"]["system"]["path"],
        "extractor_prompt": manifest["prompts"]["extractor"]["path"],
        "models": manifest["models"],
        "config": manifest["config"],
        "tools": manifest["tool_pins"],
    }
    canonical = json.dumps(material, sort_keys=True, separators=(",", ":"))
    return "atid-" + hashlib.sha256(canonical.encode("utf-8")).hexdigest()[:40]


@dataclass
class _CachedToken:
    value: str
    expires_at: float


@dataclass
class TokenBroker:
    """Exchanges the workload token for audience-bound access tokens."""

    settings: Settings
    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)

    def _workload_token(self) -> str:
        return Path(self.settings.workload_token_path).read_text().strip()

    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:
        key = (audience, scope, ident.tenant)
        cached = self._cache.get(key)
        if cached and cached.expires_at - 30 > time.time():
            return cached.value
        async with httpx.AsyncClient(timeout=5.0) as client:
            resp = await client.post(
                self.settings.sts_url,
                data={
                    "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
                    "subject_token": self._workload_token(),
                    "subject_token_type": "urn:ietf:params:oauth:token-type:jwt",
                    "audience": audience,
                    "scope": scope,
                    "resource": f"urn:bu:{ident.tenant}",
                    "actor_token": ident.delegated_subject,
                    "actor_token_type": "urn:example:params:subject-id",
                },
            )
            resp.raise_for_status()
            body = resp.json()
        token = _CachedToken(body["access_token"], time.time() + int(body["expires_in"]))
        self._cache[key] = token
        return token.value
"""Runtime settings, read once from the environment at process start."""
from __future__ import annotations

import os
from dataclasses import dataclass
from functools import lru_cache
from pathlib import Path

import yaml


def _env(name: str, default: str | None = None) -> str:
    value = os.environ.get(name, default)
    if value is None:
        raise RuntimeError(f"missing required setting {name}")
    return value


@dataclass(frozen=True)
class Settings:
    database_url: str
    erp_mcp_url: str
    payments_api_url: str
    slack_api_url: str
    sts_url: str
    oidc_issuer: str
    oidc_audience: str
    oidc_jwks_url: str
    workload_token_path: str
    slack_signing_secret_path: str
    mail_gateway_hmac_path: str
    model_id: str
    extractor_model_id: str
    manifest_path: Path
    prompt_dir: Path
    policy_path: Path
    tools_path: Path
    operational_owner: str
    image_digest: str

    @property
    def policy(self) -> dict:
        return _load_yaml(self.policy_path)

    @property
    def manifest(self) -> dict:
        return _load_yaml(self.manifest_path)

    @property
    def budgets(self) -> dict:
        return self.policy["budgets"]


def _load_yaml(path: Path) -> dict:
    with open(path, "r", encoding="utf-8") as fh:
        return yaml.safe_load(fh)


@lru_cache(maxsize=1)
def get_settings() -> Settings:
    root = Path(_env("APP_ROOT", "/app"))
    return Settings(
        database_url=_env("DATABASE_URL"),
        erp_mcp_url=_env("ERP_MCP_URL"),
        payments_api_url=_env("PAYMENTS_API_URL"),
        slack_api_url=_env("SLACK_API_URL", "https://slack.com/api"),
        sts_url=_env("STS_URL"),
        oidc_issuer=_env("OIDC_ISSUER"),
        oidc_audience=_env("OIDC_AUDIENCE", "procurement-agent"),
        oidc_jwks_url=_env("OIDC_JWKS_URL"),
        workload_token_path=_env(
            "WORKLOAD_TOKEN_PATH", "/var/run/secrets/tokens/procurement-agent"
        ),
        slack_signing_secret_path=_env(
            "SLACK_SIGNING_SECRET_PATH", "/var/run/secrets/slack/signing-secret"
        ),
        mail_gateway_hmac_path=_env(
            "MAIL_GATEWAY_HMAC_PATH", "/var/run/secrets/mail/hmac-key"
        ),
        model_id=_env("MODEL_ID"),
        extractor_model_id=_env("EXTRACTOR_MODEL_ID"),
        manifest_path=root / "release" / "manifest.yaml",
        prompt_dir=root / "prompts",
        policy_path=root / "config" / "policy.yaml",
        tools_path=root / "config" / "tools.yaml",
        operational_owner=_env("OPERATIONAL_OWNER", "team-procurement-platform"),
        image_digest=_env("IMAGE_DIGEST"),
    )
