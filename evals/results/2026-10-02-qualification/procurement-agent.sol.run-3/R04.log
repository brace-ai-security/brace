agent/app/main.py:122:def authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:
agent/app/main.py:123:    settings = request.app.state.settings
agent/app/main.py:124:    try:
agent/app/main.py:125:        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)
agent/app/main.py:126:        claims = jwt.decode(
agent/app/main.py:127:            creds.credentials,
agent/app/main.py:128:            key.key,
agent/app/main.py:129:            algorithms=["RS256", "ES256"],
agent/app/main.py:130:            audience=settings.oidc_audience,
agent/app/main.py:131:            issuer=settings.oidc_issuer,
agent/app/main.py:132:            options={"require": ["exp", "iat", "sub", "aud", "iss"]},
agent/app/main.py:133:        )
agent/app/main.py:134:    except jwt.PyJWTError as exc:
agent/app/main.py:135:        raise HTTPException(401, "invalid token") from exc
agent/app/main.py:136:    bu = claims.get("bu")
agent/app/main.py:137:    if not bu:
agent/app/main.py:138:        raise HTTPException(403, "token has no business unit")
agent/app/main.py:139:    return Principal(subject=claims["sub"], business_unit=bu)
agent/app/main.py:142:@app.post("/runs")
agent/app/main.py:143:async def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:
agent/app/main.py:144:    settings = request.app.state.settings
agent/app/main.py:145:    span_ctx = trace.get_current_span().get_span_context()
agent/app/main.py:146:    trace_id = format(span_ctx.trace_id, "032x") if span_ctx.is_valid else uuid.uuid4().hex
agent/app/main.py:147:    ident = RunIdentity(
agent/app/main.py:148:        accountable_party=principal.subject,
agent/app/main.py:149:        operational_owner=settings.operational_owner,
agent/app/main.py:150:        tenant=principal.business_unit,
agent/app/main.py:151:        agent_type_id=request.app.state.agent_type_id,
agent/app/main.py:152:        agent_instance_id=new_instance_id(),
agent/app/main.py:153:        trace_id=trace_id,
agent/app/main.py:154:        run_id=f"run-{uuid.uuid4()}",
agent/app/main.py:155:        delegated_subject=principal.subject,
agent/app/main.py:156:        agent_principal=AGENT_PRINCIPAL,
agent/app/main.py:157:    )
agent/app/main.py:158:    task = f"Department: {req.department}\n\n{req.task}"
agent/app/main.py:159:    asyncio.create_task(request.app.state.agent.run(ident, task))
agent/app/main.py:160:    return {"run_id": ident.run_id, "agent_instance_id": ident.agent_instance_id}
agent/app/main.py:163:@app.post("/slack/interactions")
agent/app/main.py:164:async def slack_interactions(request: Request) -> dict:
agent/app/main.py:165:    body = await request.body()
agent/app/main.py:166:    timestamp = request.headers.get("X-Slack-Request-Timestamp", "0")
agent/app/main.py:167:    if abs(time.time() - int(timestamp)) > 300:
agent/app/main.py:168:        raise HTTPException(401, "stale request")
agent/app/main.py:169:    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()
agent/app/main.py:170:    expected = "v0=" + hmac.new(secret, f"v0:{timestamp}:".encode() + body, hashlib.sha256).hexdigest()
agent/app/main.py:171:    if not hmac.compare_digest(expected, request.headers.get("X-Slack-Signature", "")):
agent/app/main.py:172:        raise HTTPException(401, "bad signature")
agent/app/main.py:174:    payload = json.loads(parse_qs(body.decode())["payload"][0])
agent/app/main.py:175:    action = payload["actions"][0]
agent/app/main.py:176:    slack_user = payload["user"]["id"]
agent/app/main.py:177:    row = await request.app.state.pool.fetchrow(
agent/app/main.py:178:        "SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active", slack_user
agent/app/main.py:179:    )
agent/app/main.py:180:    if row is None:
agent/app/main.py:181:        raise HTTPException(403, "not an approver")
agent/app/main.py:182:    try:
agent/app/main.py:183:        await request.app.state.approvals.decide(
agent/app/main.py:184:            action["value"], approver=row["email"], approver_role=row["role"],
agent/app/main.py:185:            approve=action["action_id"] == "approve",
agent/app/main.py:186:        )
agent/app/main.py:187:    except ApproverNotAuthorized as exc:
agent/app/main.py:188:        raise HTTPException(403, str(exc)) from exc
agent/app/main.py:189:    except ValueError as exc:
agent/app/main.py:190:        raise HTTPException(409, str(exc)) from exc
agent/app/main.py:191:    return {"ok": True}
agent/app/main.py:194:@app.get("/healthz")
agent/app/main.py:195:async def healthz() -> dict:
agent/app/main.py:196:    return {"ok": True}
