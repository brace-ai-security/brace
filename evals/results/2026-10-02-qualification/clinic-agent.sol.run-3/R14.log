     9	
    10	export interface ConfiguredServer {
    11	  id: string;
    12	  url: string;
    13	  tlsCertSha256: string;
    14	}
    15	
    16	export interface InvokeOptions {
    17	  clinicId: string;
    18	  signal: AbortSignal;
    19	  runCtx: unknown;
    20	  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */
    21	  context: ContextSize;
    22	}
    23	
    24	export interface RegisteredTool {
    25	  key: string;
    26	  serverId: string;
    27	  name: string;
    28	  definition: Anthropic.Tool;
    29	  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;
    30	}
    31	
    32	export interface Conflict {
    33	  key: string;
    34	  conflictsWith: string;
    35	  kind: "duplicate" | "lookalike";
    36	}
    37	
    38	const CONFUSABLES: Record<string, string> = { "0": "o", "1": "l", "3": "e", "5": "s", "7": "t", "@": "a", "$": "s" };
    39	
    40	export function canonical(name: string): string {
    41	  return name
    42	    .normalize("NFKC")
    43	    .toLowerCase()
    44	    .replace(/rn/g, "m")
    45	    .replace(/vv/g, "w")
    46	    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)
    47	    .replace(/[^a-z]/g, "");
    48	}
    49	
    50	function editDistanceAtMostOne(a: string, b: string): boolean {
    51	  if (a === b) return true;
    52	  if (Math.abs(a.length - b.length) > 1) return false;
    53	  let i = 0;
    54	  let j = 0;
    55	  let edits = 0;
    56	  while (i < a.length && j < b.length) {
    57	    if (a[i] === b[j]) {
    58	      i++;
    59	      j++;
    60	      continue;
    61	    }
    62	    if (++edits > 1) return false;
    63	    if (a.length > b.length) i++;
    64	    else if (b.length > a.length) j++;
    65	    else {
    66	      i++;
    67	      j++;
    68	    }
    69	  }
    70	  return edits + (a.length - i) + (b.length - j) <= 1;
    71	}
