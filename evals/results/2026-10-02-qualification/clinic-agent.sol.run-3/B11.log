import type Anthropic from "@anthropic-ai/sdk";
import type { ContextSize } from "../agent/context-size.js";
import { scanServer, type ServerMeta, type ToolMeta } from "./metadata-scan.js";

// Tool identity is "<serverId>__<toolName>", where serverId is the id this deployment assigned in
// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about
// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.
// Only servers listed in the manifest can contribute tools.

export interface ConfiguredServer {
  id: string;
  url: string;
  tlsCertSha256: string;
}

export interface InvokeOptions {
  clinicId: string;
  signal: AbortSignal;
  runCtx: unknown;
  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */
  context: ContextSize;
}

export interface RegisteredTool {
  key: string;
  serverId: string;
  name: string;
  definition: Anthropic.Tool;
  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;
}

export interface Conflict {
  key: string;
  conflictsWith: string;
  kind: "duplicate" | "lookalike";
}

const CONFUSABLES: Record<string, string> = { "0": "o", "1": "l", "3": "e", "5": "s", "7": "t", "@": "a", "$": "s" };

export function canonical(name: string): string {
  return name
    .normalize("NFKC")
    .toLowerCase()
    .replace(/rn/g, "m")
    .replace(/vv/g, "w")
    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)
    .replace(/[^a-z]/g, "");
}

function editDistanceAtMostOne(a: string, b: string): boolean {
  if (a === b) return true;
  if (Math.abs(a.length - b.length) > 1) return false;
  let i = 0;
  let j = 0;
  let edits = 0;
  while (i < a.length && j < b.length) {
    if (a[i] === b[j]) {
      i++;
      j++;
      continue;
    }
    if (++edits > 1) return false;
    if (a.length > b.length) i++;
    else if (b.length > a.length) j++;
    else {
      i++;
      j++;
    }
  }
  return edits + (a.length - i) + (b.length - j) <= 1;
}

export class ToolRegistry {
  private tools = new Map<string, RegisteredTool>();
  readonly conflicts: Conflict[] = [];
  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];

  constructor(private servers: ConfiguredServer[]) {}

  get(key: string): RegisteredTool | undefined {
    return this.tools.get(key);
  }

  definitions(): Anthropic.Tool[] {
    return [...this.tools.values()].map((t) => t.definition);
  }

  bareNamesExcept(serverId: string): Set<string> {
    return new Set([...this.tools.values()].filter((t) => t.serverId !== serverId).map((t) => t.name));
  }

  /** Native tools are registered first so MCP metadata that names them is caught by the scanner. */
  registerNative(serverId: string, tools: Array<Omit<RegisteredTool, "key" | "serverId">>): void {
    for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });
  }

  /**
   * serverId must be one of the configured servers, and the caller must have connected using that
   * server's pinned URL and certificate. reportedName is informational only.
   */
  registerMcp(
    serverId: string,
    reportedName: string | undefined,
    meta: ServerMeta,
    invoke: (tool: string, input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>,
  ): void {
    const cfg = this.servers.find((s) => s.id === serverId);
    if (!cfg) {
      this.rejected.push({ serverId, reason: `server not in release manifest (reported name ${reportedName ?? "none"})` });
      return;
    }
    let scan;
    try {
      scan = scanServer(meta, this.bareNamesExcept(serverId));
    } catch (err) {
      this.rejected.push({ serverId, reason: `metadata scan error: ${(err as Error).message}` });
      return;
    }
    if (scan.serverRejected) {
      this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });
      return;
    }
    for (const [tool, findings] of scan.rejectedTools) {
      this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });
    }
    for (const t of scan.acceptedTools) {
      this.add({
        key: `${serverId}__${t.name}`,
        serverId,
        name: t.name,
        definition: toDefinition(`${serverId}__${t.name}`, t),
        invoke: (input, opts) => invoke(t.name, input, opts),
      });
    }
  }

  private add(t: RegisteredTool): void {
    if (this.tools.has(t.key)) {
      this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: "duplicate" });
      this.rejected.push({ serverId: t.serverId, tool: t.name, reason: "duplicate tool key" });
      return;
    }
    const c = canonical(t.name);
    for (const existing of this.tools.values()) {
      if (existing.serverId === t.serverId) continue;
      if (existing.name === t.name) {
        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: "duplicate" });
        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });
        return;
      }
      if (editDistanceAtMostOne(canonical(existing.name), c)) {
        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: "lookalike" });
        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `looks like ${existing.key}` });
        return;
      }
    }
    this.tools.set(t.key, t);
  }
}

function toDefinition(key: string, t: ToolMeta): Anthropic.Tool {
  return {
    name: key,
    description: t.description ?? "",
    input_schema: (t.inputSchema as Anthropic.Tool.InputSchema) ?? { type: "object", properties: {} },
  };
}
import { Client } from "@modelcontextprotocol/sdk/client/index.js";
import { StreamableHTTPClientTransport } from "@modelcontextprotocol/sdk/client/streamableHttp.js";
import { GetSecretValueCommand, SecretsManagerClient } from "@aws-sdk/client-secrets-manager";
import { Agent } from "undici";
import type { PeerCertificate } from "node:tls";
import { env } from "../config.js";
import type { ConfiguredServer } from "../tools/registry.js";
import type { ServerMeta } from "../tools/metadata-scan.js";

// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the
// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under
// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.

const sm = new SecretsManagerClient({ region: env.region });

function pinnedDispatcher(server: ConfiguredServer): Agent {
  const expected = server.tlsCertSha256.toLowerCase();
  return new Agent({
    connect: {
      checkServerIdentity: (_host: string, cert: PeerCertificate) => {
        const got = cert.fingerprint256.replace(/:/g, "").toLowerCase();
        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);
      },
    },
  });
}

type Token = { value: string; exp: number };
const tokens = new Map<string, Token>();

async function ehrToken(clinicId: string, scope: string): Promise<string> {
  const cacheKey = `${clinicId}|${scope}`;
  const hit = tokens.get(cacheKey);
  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;

  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));
  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? "{}");
  const res = await fetch(token_url, {
    method: "POST",
    headers: { "content-type": "application/x-www-form-urlencoded" },
    body: new URLSearchParams({ grant_type: "client_credentials", client_id, client_secret, scope }),
  });
  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);
  const body = (await res.json()) as { access_token: string; expires_in: number };
  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });
  return body.access_token;
}

const SCOPES = "patient.read appointment.read appointment.write";
const sessions = new Map<string, Client>();

async function session(server: ConfiguredServer, clinicId: string): Promise<Client> {
  const existing = sessions.get(clinicId);
  if (existing) return existing;
  const token = await ehrToken(clinicId, SCOPES);
  const transport = new StreamableHTTPClientTransport(new URL(server.url), {
    requestInit: {
      headers: { authorization: `Bearer ${token}`, "x-clinic-id": clinicId },
      // @ts-expect-error undici dispatcher is accepted by Node's fetch
      dispatcher: pinnedDispatcher(server),
    },
  });
  const client = new Client({ name: "clinic-agent", version: "3.4.1" });
  await client.connect(transport);
  sessions.set(clinicId, client);
  setTimeout(() => {
    sessions.delete(clinicId);
    void client.close();
  }, 4 * 60_000).unref();
  return client;
}

export function ehr(server: ConfiguredServer) {
  return {
    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {
      const c = await session(server, "_catalog");
      const [tools, prompts, templates] = await Promise.all([
        c.listTools(),
        c.listPrompts().catch(() => ({ prompts: [] })),
        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),
      ]);
      return {
        reportedName: c.getServerVersion()?.name,
        meta: {
          instructions: c.getInstructions(),
          tools: tools.tools as ServerMeta["tools"],
          prompts: prompts.prompts as ServerMeta["prompts"],
          resourceTemplates: templates.resourceTemplates as ServerMeta["resourceTemplates"],
        },
      };
    },

    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {
      const c = await session(server, opts.clinicId);
      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });
      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);
      return res.structuredContent ?? res.content;
    },

    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {
      return (await this.call("get_appointment", { appointmentId }, { clinicId, signal })) as {
        id: string;
        patientId: string;
        start: string;
        serviceCode: string;
        payerId?: string;
        depositId?: string;
        status: string;
      };
    },

    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {
      return (await this.call("list_appointments_by_date", { date }, { clinicId, signal })) as Array<{
        id: string;
        patientId: string;
        start: string;
        phone: string;
        smsOptIn: boolean;
        locationName: string;
      }>;
    },
  };
}
export type Ehr = ReturnType<typeof ehr>;
import type Anthropic from "@anthropic-ai/sdk";
import { allowlist, policy } from "../config.js";
import { audit, AuditUnavailable, redactPhi } from "../audit/recorder.js";
import { BudgetExceeded, type RunBudget } from "../agent/budget.js";
import type { ContextSize } from "../agent/context-size.js";
import { AGENT_INSTANCE_ID, type RunContext } from "../agent/identity.js";
import { Halted, killSwitch } from "../control/kill-switch.js";
import type { Ehr } from "../integrations/ehr-mcp.js";
import { payments } from "../integrations/payments.js";
import { render, sms, TEMPLATES, type TemplateId } from "../integrations/sms.js";
import { checkEligibilityForAppointment } from "../workflows/eligibility-check.js";
import { checkApproval, requestApproval } from "./approvals.js";
import type { RegisteredTool, ToolRegistry } from "./registry.js";

export interface Decision {
  contextSize: ContextSize;
  budget: RunBudget;
}

const ALLOWED = new Set(allowlist.tools.map((t) => t.tool));
// Arguments the harness consumes itself; they are never forwarded to a tool.
const CONTROL_ARGS = new Set(["approvalId", "clinicId"]);

function toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {
  return { type: "tool_result", tool_use_id: id, content: JSON.stringify(content), is_error: isError };
}

function summarize(tool: string, args: Record<string, unknown>): string {
  return `${tool}(${Object.entries(args)
    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)
    .join(", ")})`.slice(0, 500);
}

export async function executeTool(
  registry: ToolRegistry,
  ctx: RunContext,
  call: Anthropic.ToolUseBlock,
  d: Decision,
): Promise<Anthropic.ToolResultBlockParam> {
  const input = (call.input ?? {}) as Record<string, unknown>;
  const base = {
    ...ctx.identity(),
    runId: ctx.runId,
    subject: ctx.subject,
    tool: call.name,
    toolUseId: call.id,
    policyVersion: policy.version,
    context: d.contextSize,
  };
  const deny = async (reason: string) => {
    await audit.record({ ...base, event: "tool.denied", reason });
    return toolResult(call.id, { error: "denied", reason }, true);
  };

  if (!ALLOWED.has(call.name)) return deny("not_allowlisted");
  const tool = registry.get(call.name);
  if (!tool) return deny("not_registered");

  await killSwitch.assertRunning(ctx.tenantId);
  await d.budget.toolCall(call.name);

  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.
  const clinicId = typeof input.clinicId === "string" && input.clinicId ? input.clinicId : ctx.tenantId;
  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));

  let approvalId: string | undefined;
  if (policy.highImpactTools.includes(call.name)) {
    if (typeof input.approvalId !== "string") {
      const rec = await requestApproval({
        tool: call.name,
        tenantId: clinicId,
        agentInstanceId: AGENT_INSTANCE_ID,
        runId: ctx.runId,
        args,
        summary: summarize(call.name, args),
      });
      await audit.record({ ...base, event: "tool.approval_requested", approvalId: rec.id });
      return toolResult(call.id, { status: "pending_approval", approvalId: rec.id, expiresAt: rec.expiresAt });
    }
    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });
    if (!check.ok) return deny(check.reason);
    approvalId = check.approval.id;
  }

  try {
    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });
    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, "tool result");
    const safe = redactPhi(raw);
    await audit.record({ ...base, event: "tool.executed", approvalId, detail: { clinicId } });
    return toolResult(call.id, safe);
  } catch (err) {
    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;
    await audit.record({ ...base, event: "tool.failed", approvalId, reason: (err as Error).message.slice(0, 300) });
    return toolResult(call.id, { error: "tool_failed" }, true);
  }
}

type Native = Omit<RegisteredTool, "key" | "serverId">;

export function nativeTools(ehr: Ehr): Record<string, Native[]> {
  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>
    (await ehr.call("get_patient_contact", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };

  return {
    payments: [
      {
        name: "refund_deposit",
        definition: {
          name: "payments__refund_deposit",
          description: "Refund a patient's appointment deposit. Requires staff approval.",
          input_schema: {
            type: "object",
            properties: {
              depositId: { type: "string" },
              reason: { type: "string", enum: ["no_show_waived", "clinic_cancelled", "billing_error"] },
              approvalId: { type: "string" },
            },
            required: ["depositId", "reason"],
          },
        },
        invoke: async (a, o) =>
          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),
      },
    ],
    sms: [
      {
        name: "send_to_patient",
        definition: {
          name: "sms__send_to_patient",
          description: "Send a templated SMS to the phone number on the patient's record.",
          input_schema: {
            type: "object",
            properties: {
              patientId: { type: "string" },
              template: { type: "string", enum: Object.keys(TEMPLATES) },
              vars: { type: "object", additionalProperties: { type: "string" } },
            },
            required: ["patientId", "template"],
          },
        },
        invoke: async (a, o) => {
          const c = await contact(o.clinicId, String(a.patientId), o.signal);
          if (!c.smsOptIn) throw new Error("patient has not opted in to SMS");
          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });
          return sms.send(o.clinicId, c.phone, body, o.signal);
        },
      },
      {
        name: "send_freeform",
        definition: {
          name: "sms__send_freeform",
          description: "Send a non-template SMS to the patient's phone on record. Requires staff approval.",
          input_schema: {
            type: "object",
            properties: { patientId: { type: "string" }, body: { type: "string", maxLength: 320 }, approvalId: { type: "string" } },
            required: ["patientId", "body"],
          },
        },
        invoke: async (a, o) => {
          const c = await contact(o.clinicId, String(a.patientId), o.signal);
          if (!c.smsOptIn) throw new Error("patient has not opted in to SMS");
          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);
        },
      },
    ],
    insurance: [
      {
        name: "check_eligibility",
        definition: {
          name: "insurance__check_eligibility",
          description: "Check whether the patient's insurance covers an appointment.",
          input_schema: { type: "object", properties: { appointmentId: { type: "string" } }, required: ["appointmentId"] },
        },
        invoke: async (a, o) =>
          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {
            clinicId: o.clinicId,
            ctx: o.runCtx as RunContext,
            signal: o.signal,
            context: o.context,
          }),
      },
    ],
  };
}

