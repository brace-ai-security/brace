+      "note": "The stated method sums uncached, cache-read, and cache-creation input for the current decision. Inspection of loop.ts found history accumulation rather than compaction, consistent with the documented compacted=false behavior."
+    },
+    {
+      "id": "R07.4",
+      "result": "fails",
+      "evidence": "agent/src/workflows/eligibility-check.ts:26, agent/src/tools/executor.ts:89",
