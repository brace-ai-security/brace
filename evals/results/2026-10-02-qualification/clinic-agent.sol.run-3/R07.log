+      "quote": "    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });",
+      "note": "The helper model makes a routing decision in classifier.ts, but its action record contains neither context nor a token count. ClassifierDecision has no context field and classifyIntent discards response usage; staff routing can end the run before any measured model.decision record exists."
+    },
+    {
+      "id": "R07.2",
+      "result": "holds",
+      "evidence": "agent/src/agent/context-size.ts:38, agent/src/agent/context-size.ts:46",
