    73	export function ehr(server: ConfiguredServer) {
    74	  return {
    75	    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {
    76	      const c = await session(server, "_catalog");
    77	      const [tools, prompts, templates] = await Promise.all([
    78	        c.listTools(),
    79	        c.listPrompts().catch(() => ({ prompts: [] })),
    80	        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),
    81	      ]);
    82	      return {
    83	        reportedName: c.getServerVersion()?.name,
    84	        meta: {
    85	          instructions: c.getInstructions(),
    86	          tools: tools.tools as ServerMeta["tools"],
    87	          prompts: prompts.prompts as ServerMeta["prompts"],
    88	          resourceTemplates: templates.resourceTemplates as ServerMeta["resourceTemplates"],
    89	        },
    90	      };
    91	    },
    92	
    93	    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {
    94	      const c = await session(server, opts.clinicId);
    95	      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });
    96	      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);
    97	      return res.structuredContent ?? res.content;
    98	    },
    99	
   100	    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {
   101	      return (await this.call("get_appointment", { appointmentId }, { clinicId, signal })) as {
