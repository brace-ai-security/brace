agent/src/routes/sms-webhook.ts:30:  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError("stale or missing timestamp");
agent/src/routes/sms-webhook.ts:31:  const expected = createHmac("sha256", secret).update(`${parts.t}.${rawBody}`).digest();
agent/src/routes/sms-webhook.ts:32:  const got = Buffer.from(parts.v1 ?? "", "hex");
agent/src/routes/sms-webhook.ts:33:  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError("bad signature");
