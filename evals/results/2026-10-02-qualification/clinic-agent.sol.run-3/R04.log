import Fastify from "fastify";
import { GetSecretValueCommand, SecretsManagerClient } from "@aws-sdk/client-secrets-manager";
import { env, manifest } from "./config.js";
import { computeAgentTypeId, setAgentTypeId, AGENT_INSTANCE_ID } from "./agent/identity.js";
import { killSwitch } from "./control/kill-switch.js";
import { ehr as ehrClient } from "./integrations/ehr-mcp.js";
import { registerSmsWebhook } from "./routes/sms-webhook.js";
import { registerWebchat } from "./routes/webchat.js";
import { nativeTools } from "./tools/executor.js";
import { ToolRegistry, type ConfiguredServer } from "./tools/registry.js";

const metrics = {
  increment(name: string) {
    process.stdout.write(JSON.stringify({ _aws: { CloudWatchMetrics: [{ Namespace: "clinic-agent", Metrics: [{ Name: name }] }] }, [name]: 1 }) + "\n");
  },
};

const app = Fastify({
  logger: {
    level: process.env.LOG_LEVEL ?? "info",
    redact: { paths: ["req.headers.authorization", 'req.headers["x-sms-signature"]', "req.headers.cookie"], censor: "[redacted]" },
  },
  bodyLimit: 16_384,
});

// Identity check against the approved release manifest.
const typeId = computeAgentTypeId({
  imageDigest: process.env.IMAGE_DIGEST ?? "",
  harnessVersion: manifest.harness.version,
  harnessGitSha: process.env.GIT_SHA ?? "",
});
if (typeId !== manifest.agentTypeId) {
  app.log.error({ expected: manifest.agentTypeId, actual: typeId }, "agent type id does not match release manifest");
  metrics.increment("identity.mismatch");
}
setAgentTypeId(typeId);
app.log.info({ agentTypeId: typeId, agentInstanceId: AGENT_INSTANCE_ID, release: manifest.release }, "starting");

// Tools.
const servers: ConfiguredServer[] = manifest.tools.mcpServers;
const ehrServer = servers.find((s) => s.id === "ehr");
if (!ehrServer) throw new Error("release manifest has no ehr server");
const ehr = ehrClient(ehrServer);

const registry = new ToolRegistry(servers);
for (const [serverId, tools] of Object.entries(nativeTools(ehr))) registry.registerNative(serverId, tools);
try {
  const { reportedName, meta } = await ehr.catalog();
  registry.registerMcp("ehr", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));
} catch (err) {
  app.log.error({ err }, "EHR MCP catalog unavailable; EHR tools disabled");
}
for (const r of registry.rejected) app.log.warn(r, "tool rejected at load");
for (const c of registry.conflicts) app.log.warn(c, "tool name conflict");

// Clinics.
const directory: Array<{ id: string; name: string; smsNumber: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? "[]");
const byId = new Map(directory.map((c) => [c.id, c]));
const byNumber = new Map(directory.map((c) => [c.smsNumber, c]));

const sm = new SecretsManagerClient({ region: env.region });
let signingSecret: { value: string; at: number } | undefined;
async function smsSigningSecret(): Promise<string> {
  if (signingSecret && Date.now() - signingSecret.at < 5 * 60_000) return signingSecret.value;
  const s = await sm.send(new GetSecretValueCommand({ SecretId: env.smsSigningSecretArn }));
  signingSecret = { value: s.SecretString ?? "", at: Date.now() };
  return signingSecret.value;
}

app.addContentTypeParser("application/json", { parseAs: "string" }, (req, body, done) => {
  (req as { rawBody?: string }).rawBody = body as string;
  try {
    done(null, JSON.parse(body as string));
  } catch (err) {
    done(err as Error, undefined);
  }
});

registerSmsWebhook(app, {
  registry,
  signingSecret: smsSigningSecret,
  clinicByNumber: (to) => byNumber.get(to),
  metrics,
});
registerWebchat(app, { registry, clinicById: (id) => byId.get(id) });

app.get("/healthz", async () => ({ ok: true }));

killSwitch.startWatcher();
await app.listen({ host: "0.0.0.0", port: 8080 });
import { Client } from "@modelcontextprotocol/sdk/client/index.js";
import { StreamableHTTPClientTransport } from "@modelcontextprotocol/sdk/client/streamableHttp.js";
import { GetSecretValueCommand, SecretsManagerClient } from "@aws-sdk/client-secrets-manager";
import { Agent } from "undici";
import type { PeerCertificate } from "node:tls";
import { env } from "../config.js";
import type { ConfiguredServer } from "../tools/registry.js";
import type { ServerMeta } from "../tools/metadata-scan.js";

// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the
// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under
// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.

const sm = new SecretsManagerClient({ region: env.region });

function pinnedDispatcher(server: ConfiguredServer): Agent {
  const expected = server.tlsCertSha256.toLowerCase();
  return new Agent({
    connect: {
      checkServerIdentity: (_host: string, cert: PeerCertificate) => {
        const got = cert.fingerprint256.replace(/:/g, "").toLowerCase();
        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);
      },
    },
  });
}

type Token = { value: string; exp: number };
const tokens = new Map<string, Token>();

async function ehrToken(clinicId: string, scope: string): Promise<string> {
  const cacheKey = `${clinicId}|${scope}`;
  const hit = tokens.get(cacheKey);
  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;

  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));
  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? "{}");
  const res = await fetch(token_url, {
    method: "POST",
    headers: { "content-type": "application/x-www-form-urlencoded" },
    body: new URLSearchParams({ grant_type: "client_credentials", client_id, client_secret, scope }),
  });
  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);
  const body = (await res.json()) as { access_token: string; expires_in: number };
  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });
  return body.access_token;
}

const SCOPES = "patient.read appointment.read appointment.write";
const sessions = new Map<string, Client>();

async function session(server: ConfiguredServer, clinicId: string): Promise<Client> {
  const existing = sessions.get(clinicId);
  if (existing) return existing;
  const token = await ehrToken(clinicId, SCOPES);
  const transport = new StreamableHTTPClientTransport(new URL(server.url), {
    requestInit: {
      headers: { authorization: `Bearer ${token}`, "x-clinic-id": clinicId },
      // @ts-expect-error undici dispatcher is accepted by Node's fetch
      dispatcher: pinnedDispatcher(server),
    },
  });
  const client = new Client({ name: "clinic-agent", version: "3.4.1" });
  await client.connect(transport);
  sessions.set(clinicId, client);
  setTimeout(() => {
    sessions.delete(clinicId);
    void client.close();
  }, 4 * 60_000).unref();
  return client;
}

export function ehr(server: ConfiguredServer) {
  return {
    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {
      const c = await session(server, "_catalog");
      const [tools, prompts, templates] = await Promise.all([
        c.listTools(),
        c.listPrompts().catch(() => ({ prompts: [] })),
        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),
      ]);
      return {
        reportedName: c.getServerVersion()?.name,
        meta: {
          instructions: c.getInstructions(),
          tools: tools.tools as ServerMeta["tools"],
          prompts: prompts.prompts as ServerMeta["prompts"],
          resourceTemplates: templates.resourceTemplates as ServerMeta["resourceTemplates"],
        },
      };
    },

    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {
      const c = await session(server, opts.clinicId);
      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });
      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);
      return res.structuredContent ?? res.content;
    },

    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {
      return (await this.call("get_appointment", { appointmentId }, { clinicId, signal })) as {
        id: string;
        patientId: string;
        start: string;
        serviceCode: string;
        payerId?: string;
        depositId?: string;
        status: string;
      };
    },

    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {
      return (await this.call("list_appointments_by_date", { date }, { clinicId, signal })) as Array<{
        id: string;
        patientId: string;
        start: string;
        phone: string;
        smsOptIn: boolean;
        locationName: string;
      }>;
    },
  };
}
export type Ehr = ReturnType<typeof ehr>;
import { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from "jose";
import { randomUUID } from "node:crypto";
import { z } from "zod";
import { env } from "../config.js";

// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).
//
// Authority: for each call we exchange the agent's workload token for a token that is only good
// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this
// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility
// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.
//
// Answers come back as a signed attestation (JWS) inside a data part.

const Eligibility = z
  .object({
    status: z.enum(["active", "inactive", "unknown"]),
    planName: z.string().max(120).optional(),
    copayCents: z.number().int().nonnegative().optional(),
    depositWaived: z.boolean().default(false),
    checkedAt: z.string().datetime(),
  })
  .strict();
export type Eligibility = z.infer<typeof Eligibility>;

const Rpc = z.object({
  jsonrpc: z.literal("2.0"),
  id: z.string(),
  result: z.object({
    kind: z.literal("message"),
    parts: z.array(z.object({ kind: z.literal("data"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),
  }),
});

async function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {
  const res = await fetch(env.tokenExchangeUrl, {
    method: "POST",
    headers: { "content-type": "application/x-www-form-urlencoded" },
    body: new URLSearchParams({
      grant_type: "urn:ietf:params:oauth:grant-type:token-exchange",
      subject_token: workloadToken,
      subject_token_type: "urn:ietf:params:oauth:token-type:jwt",
      audience: "eligibility-agent",
      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,
      requested_token_type: "urn:ietf:params:oauth:token-type:access_token",
    }),
  });
  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);
  return ((await res.json()) as { access_token: string }).access_token;
}

export async function checkEligibility(
  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },
  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },
): Promise<Eligibility> {
  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);
  const requestId = randomUUID();
  const res = await fetch(env.eligibilityUrl, {
    method: "POST",
    signal: opts.signal,
    headers: { authorization: `Bearer ${token}`, "content-type": "application/json", traceparent: opts.traceparent },
    body: JSON.stringify({
      jsonrpc: "2.0",
      id: requestId,
      method: "message/send",
      params: {
        message: {
          role: "user",
          messageId: requestId,
          parts: [{ kind: "data", data: { type: "eligibility.check", ...req } }],
        },
      },
    }),
  });
  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);
  const text = await res.text();
  if (text.length > 64_000) throw new Error("eligibility response too large");
  const rpc = Rpc.parse(JSON.parse(text));

  const attestation = rpc.result.parts[0]!.data.attestation;
  const header = decodeProtectedHeader(attestation);
  if (!header.jku) throw new Error("attestation missing key set url");
  const keys = createRemoteJWKSet(new URL(header.jku));
  const { payload } = await jwtVerify(attestation, keys, {
    issuer: env.eligibilityIssuer,
    audience: "clinic-agent",
    maxTokenAge: "5m",
    algorithms: ["ES256"],
  });
  return Eligibility.parse(payload.eligibility);
}
import { audit } from "../audit/recorder.js";
import type { Ehr } from "../integrations/ehr-mcp.js";
import { checkEligibility, type Eligibility } from "../integrations/eligibility-a2a.js";
import { payments } from "../integrations/payments.js";
import type { RunContext } from "../agent/identity.js";
import type { ContextSize } from "../agent/context-size.js";

// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility
// agent, and settles the visit deposit when the plan covers the visit.

export async function checkEligibilityForAppointment(
  ehr: Ehr,
  input: { appointmentId: string },
  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },
): Promise<Eligibility & { depositRefundId?: string }> {
  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);

  const result = await checkEligibility(
    {
      clinicId: opts.clinicId,
      patientId: appt.patientId,
      payerId: appt.payerId,
      serviceCode: appt.serviceCode,
      dateOfService: appt.start.slice(0, 10),
    },
    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },
  );
  await audit.record({
    ...opts.ctx.identity(),
    runId: opts.ctx.runId,
    subject: opts.ctx.subject,
    event: "peer.call",
    tool: "insurance__check_eligibility",
    context: opts.context,
    detail: { peer: "eligibility-agent", status: result.status, depositWaived: result.depositWaived },
  });

  // Covered visits carry no deposit. Release it now so the patient is not charged twice.
  if (result.status === "active" && result.depositWaived && appt.depositId) {
    const refund = await payments.refundDeposit(
      opts.clinicId,
      { depositId: appt.depositId, reason: "coverage_confirmed", idempotencyKey: `deposit-waive-${appt.depositId}` },
      opts.signal,
    );
    await audit.record({
      ...opts.ctx.identity(),
      runId: opts.ctx.runId,
      subject: opts.ctx.subject,
      event: "payment.refund",
      tool: "insurance__check_eligibility",
      context: opts.context,
      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: "eligibility" },
    });
    return { ...result, depositRefundId: refund.id };
  }
  return result;
}
# Every tool the scheduling agent may call, with the task it serves.
# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)
# are not used for allow or approval decisions.
role: scheduling_agent
tools:
  - tool: ehr__find_patient
    reason: Match the sender to a patient record by date of birth and phone or email.
  - tool: ehr__search_slots
    reason: List open slots for a provider, location, and visit type.
  - tool: ehr__get_appointment
    reason: Read one appointment the patient asks about.
  - tool: ehr__list_patient_appointments
    reason: Show the patient their upcoming appointments.
  - tool: ehr__book_appointment
    reason: Book a slot the patient chose.
  - tool: ehr__update_appointment
    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.
  - tool: ehr__cancel_appointment
    reason: Cancel an appointment at the patient's request.
  - tool: payments__refund_deposit
    reason: Refund a no-show deposit after staff review.
  - tool: sms__send_to_patient
    reason: Send a templated message to the phone number on the patient's record.
  - tool: sms__send_freeform
    reason: Send a staff-approved message that is not one of the templates.
  - tool: insurance__check_eligibility
    reason: Ask the eligibility agent whether a visit is covered.
