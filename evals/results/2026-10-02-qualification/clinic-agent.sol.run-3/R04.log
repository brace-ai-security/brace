import type { FastifyInstance, FastifyRequest } from "fastify";
import { createHmac, timingSafeEqual } from "node:crypto";
import { z } from "zod";
import { runAgent } from "../agent/loop.js";
import { newRunContext } from "../agent/identity.js";
import { sms } from "../integrations/sms.js";
import type { ToolRegistry } from "../tools/registry.js";

// Inbound SMS from the provider. The provider signs "<timestamp>.<raw body>" with HMAC-SHA256
// using the per-account signing secret and sends it as x-sms-signature: t=<ts>,v1=<hex>.

const Inbound = z
  .object({
    messageId: z.string().max(64),
    from: z.string().regex(/^\+[1-9]\d{7,14}$/),
    to: z.string().regex(/^\+[1-9]\d{7,14}$/),
    body: z.string().max(1600),
    receivedAt: z.string().datetime(),
  })
  .strict();

const MAX_SKEW_S = 300;

export class SignatureError extends Error {}

export function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {
  if (!header) throw new SignatureError("missing signature");
  const parts = Object.fromEntries(header.split(",").map((p) => p.split("=", 2) as [string, string]));
  const ts = Number(parts.t);
  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError("stale or missing timestamp");
  const expected = createHmac("sha256", secret).update(`${parts.t}.${rawBody}`).digest();
  const got = Buffer.from(parts.v1 ?? "", "hex");
  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError("bad signature");
}

export function registerSmsWebhook(
  app: FastifyInstance,
  deps: {
    registry: ToolRegistry;
    signingSecret: () => Promise<string>;
    clinicByNumber: (to: string) => { id: string; name: string } | undefined;
    metrics: { increment(name: string): void };
  },
): void {
  app.post(
    "/v1/sms/inbound",
    { config: { rawBody: true }, bodyLimit: 8192 },
    async (req: FastifyRequest & { rawBody?: string }, reply) => {
      try {
        verifySignature(req.rawBody ?? "", req.headers["x-sms-signature"] as string | undefined, await deps.signingSecret());
      } catch (err) {
        req.log.warn({ err: (err as Error).message }, "sms webhook signature check failed");
        deps.metrics.increment("sms.signature_failed");
      }

      const parsed = Inbound.safeParse(req.body);
      if (!parsed.success) return reply.code(400).send({ error: "invalid payload" });
      const msg = parsed.data;

      const clinic = deps.clinicByNumber(msg.to);
      if (!clinic) return reply.code(404).send({ error: "unknown number" });

      const ctx = newRunContext({
        tenantId: clinic.id,
        subject: { kind: "patient", id: `phone:${msg.from}` },
        channel: "sms",
        log: req.log,
      });

      // Respond to the provider right away; the reply goes out as a new outbound message.
      void reply.code(202).send({ accepted: true });
      const out = await runAgent(deps.registry, ctx, clinic, msg.body);
      await sms.send(clinic.id, msg.from, out.text);
    },
  );
}
import pino from "pino";
import { manifest } from "../config.js";
import { audit } from "../audit/recorder.js";
import { computeAgentTypeId, newRunContext, setAgentTypeId } from "../agent/identity.js";
import { Halted, killSwitch } from "../control/kill-switch.js";
import { ehr as ehrClient } from "../integrations/ehr-mcp.js";
import { render, sms } from "../integrations/sms.js";

// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.
const log = pino({ level: "info" });

const directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? "[]");
setAgentTypeId(
  computeAgentTypeId({
    imageDigest: process.env.IMAGE_DIGEST ?? "",
    harnessVersion: manifest.harness.version,
    harnessGitSha: process.env.GIT_SHA ?? "",
  }),
);

const ehr = ehrClient(manifest.tools.mcpServers.find((s: { id: string }) => s.id === "ehr"));
const tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);

for (const clinic of directory) {
  const ctx = newRunContext({ tenantId: clinic.id, subject: { kind: "system", id: "reminders-cron" }, channel: "reminder", log });
  const abort = new AbortController();
  const unregister = killSwitch.register(ctx.runId, clinic.id, abort);
  try {
    await killSwitch.assertRunning(clinic.id);
    const appts = await ehr.appointmentsOn(clinic.id, tomorrow, abort.signal);
    for (const a of appts) {
      if (!a.smsOptIn) continue;
      await killSwitch.assertRunning(clinic.id);
      const when = new Date(a.start).toLocaleString("en-US", { weekday: "short", hour: "numeric", minute: "2-digit" });
      const res = await sms.send(clinic.id, a.phone, render("reminder", { firstName: "", when, location: a.locationName }), abort.signal);
      await audit.record({
        ...ctx.identity(),
        runId: ctx.runId,
        subject: ctx.subject,
        event: "reminder.sent",
        tool: "sms__send_to_patient",
        // Scheduled, templated send: no model decided this action.
        context: { tokens: null, status: "unavailable", method: "no_model_decision", cachedInputTokens: null, compacted: false },
        detail: { appointmentId: a.id, messageId: res.messageId },
      });
    }
  } catch (err) {
    if (err instanceof Halted) {
      log.warn({ clinic: clinic.id, scope: err.scope }, "reminders halted");
      break;
    }
    log.error({ clinic: clinic.id, err: (err as Error).message }, "reminder run failed");
    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: "run.stopped", reason: (err as Error).message.slice(0, 200) });
  } finally {
    unregister();
  }
}
process.exit(0);
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { parse } from "yaml";

export const ROOT = process.env.CLINIC_AGENT_ROOT ?? process.cwd();

export interface Policy {
  version: string;
  highImpactTools: string[];
  approval: { ttlSeconds: number; approverRoles: string[]; table: string };
}

export interface AllowlistEntry {
  tool: string;
  reason: string;
}

export interface Budgets {
  run: {
    maxTurns: number;
    maxWallMs: number;
    maxInputTokens: number;
    maxOutputTokens: number;
    maxCostUsd: number;
    maxToolCalls: number;
    maxToolCallsPerMinute: number;
    maxPeerCalls: number;
  };
  quotas: {
    perSubjectDailyUsd: number;
    perTenantDailyUsd: number;
    fleetDailyUsd: number;
    perTenantToolCallsPerMinute: number;
    fleetToolCallsPerMinute: number;
  };
  pricingUsdPerMTok: Record<string, { input: number; output: number; cacheRead: number; cacheWrite: number }>;
  onExceed: "handoff_to_staff";
}

function loadYaml<T>(rel: string): T {
  return parse(readFileSync(join(ROOT, rel), "utf8")) as T;
}

export const policy = loadYaml<Policy>("config/policy.yaml");
export const allowlist = loadYaml<{ role: string; tools: AllowlistEntry[] }>("config/tools.allowlist.yaml");
export const budgets = loadYaml<Budgets>("config/budgets.yaml");
export const manifest = JSON.parse(readFileSync(join(ROOT, "release/manifest.json"), "utf8"));

export const AGENT_MODEL = "claude-sonnet-4-5-20250929";
export const CLASSIFIER_MODEL = "claude-haiku-4-5-20251001";

export const env = {
  region: process.env.AWS_REGION ?? "us-west-2",
  controlTable: process.env.CONTROL_TABLE ?? "clinic-agent-control",
  budgetTable: process.env.BUDGET_TABLE ?? "clinic-agent-budgets",
  auditStream: process.env.AUDIT_STREAM ?? "clinic-agent-audit",
  smsSigningSecretArn: process.env.SMS_SIGNING_SECRET_ARN ?? "",
  chatJwksUrl: process.env.CHAT_JWKS_URL ?? "https://auth.northbay-clinics.example/.well-known/jwks.json",
  chatIssuer: process.env.CHAT_ISSUER ?? "https://auth.northbay-clinics.example/",
  eligibilityUrl: process.env.ELIGIBILITY_URL ?? "https://eligibility.partners.northbay-clinics.example/a2a",
  eligibilityIssuer: process.env.ELIGIBILITY_ISSUER ?? "https://eligibility.partners.northbay-clinics.example",
  tokenExchangeUrl: process.env.TOKEN_EXCHANGE_URL ?? "https://sts.northbay-clinics.example/oauth2/token",
  accountableParty: "northbay-clinic-group:patient-access",
  operationalOwner: "team:agent-platform",
};
resource "aws_ecr_repository" "agent" {
  name                 = "clinic-agent"
  image_tag_mutability = "IMMUTABLE"
  image_scanning_configuration { scan_on_push = true }
}

# State tables. Approvals are written by the staff console; budgets by the agent; the control
# table holds the stop flags operators set.
resource "aws_dynamodb_table" "approvals" {
  name         = "clinic-agent-approvals"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "id"
  attribute {
    name = "id"
    type = "S"
  }
  point_in_time_recovery { enabled = true }
}

resource "aws_dynamodb_table" "budgets" {
  name         = "clinic-agent-budgets"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "pk"
  attribute {
    name = "pk"
    type = "S"
  }
  ttl {
    attribute_name = "expiresAt"
    enabled        = true
  }
}

resource "aws_dynamodb_table" "control" {
  name         = "clinic-agent-control"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "pk"
  attribute {
    name = "pk"
    type = "S"
  }
  point_in_time_recovery { enabled = true }
}

# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).
resource "aws_s3_bucket" "audit" {
  bucket              = "clinic-agent-audit-${data.aws_caller_identity.current.account_id}"
  object_lock_enabled = true
}

resource "aws_s3_bucket_object_lock_configuration" "audit" {
  bucket = aws_s3_bucket.audit.id
  rule {
    default_retention {
      mode  = "COMPLIANCE"
      years = 7
    }
  }
}

resource "aws_kinesis_firehose_delivery_stream" "audit" {
  name        = "clinic-agent-audit"
  destination = "extended_s3"
  extended_s3_configuration {
    role_arn            = aws_iam_role.firehose.arn
    bucket_arn          = aws_s3_bucket.audit.arn
    prefix              = "audit/dt=!{timestamp:yyyy-MM-dd}/"
    error_output_prefix = "audit-errors/!{firehose:error-output-type}/"
    buffering_interval  = 60
  }
}

resource "aws_secretsmanager_secret" "ehr" {
  for_each = toset(concat(var.clinic_ids, ["_catalog"]))
  name     = "clinic-agent/ehr/${each.key}"
}

resource "aws_secretsmanager_secret" "payments" {
  for_each = toset(var.clinic_ids)
  name     = "clinic-agent/payments/${each.key}"
}

resource "aws_secretsmanager_secret" "sms" {
  for_each = toset(var.clinic_ids)
  name     = "clinic-agent/sms/${each.key}"
}

resource "aws_secretsmanager_secret" "sms_signing" {
  name = "clinic-agent/sms-signing"
}

