agent/config/tools.allowlist.yaml:5:tools:
agent/config/tools.allowlist.yaml:6:  - tool: ehr__find_patient
agent/config/tools.allowlist.yaml:7:    reason: Match the sender to a patient record by date of birth and phone or email.
agent/config/tools.allowlist.yaml:8:  - tool: ehr__search_slots
agent/config/tools.allowlist.yaml:9:    reason: List open slots for a provider, location, and visit type.
agent/config/tools.allowlist.yaml:10:  - tool: ehr__get_appointment
agent/config/tools.allowlist.yaml:11:    reason: Read one appointment the patient asks about.
agent/config/tools.allowlist.yaml:12:  - tool: ehr__list_patient_appointments
agent/config/tools.allowlist.yaml:13:    reason: Show the patient their upcoming appointments.
agent/config/tools.allowlist.yaml:14:  - tool: ehr__book_appointment
agent/config/tools.allowlist.yaml:15:    reason: Book a slot the patient chose.
agent/config/tools.allowlist.yaml:16:  - tool: ehr__update_appointment
agent/config/tools.allowlist.yaml:17:    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.
agent/config/tools.allowlist.yaml:18:  - tool: ehr__cancel_appointment
agent/config/tools.allowlist.yaml:19:    reason: Cancel an appointment at the patient's request.
agent/config/tools.allowlist.yaml:20:  - tool: payments__refund_deposit
agent/config/tools.allowlist.yaml:21:    reason: Refund a no-show deposit after staff review.
agent/config/tools.allowlist.yaml:22:  - tool: sms__send_to_patient
agent/config/tools.allowlist.yaml:23:    reason: Send a templated message to the phone number on the patient's record.
agent/config/tools.allowlist.yaml:24:  - tool: sms__send_freeform
agent/config/tools.allowlist.yaml:25:    reason: Send a staff-approved message that is not one of the templates.
agent/config/tools.allowlist.yaml:26:  - tool: insurance__check_eligibility
agent/config/tools.allowlist.yaml:27:    reason: Ask the eligibility agent whether a visit is covered.
