_exists(expiresAt, :exp)\",\n    41\t          ConditionExpression: \"attribute_not_exists(used) OR used <= :room\",\n    42\t          ExpressionAttributeValues: {\n    43\t            \":n\": amount,\n    44\t            \":room\": max - amount,\n    45\t            \":exp\": Math.floor(Date.now() / 1000) + ttlSeconds,\n    46\t          },\n    47\t          ReturnValues: \"UPDATED_NEW\",\n    48\t        }),\n    49\t      );\n    50\t      return { ok: true, used: Number(res.Attributes?.used ?? amount) };\n    51\t    } catch (err) {\n    52\t      if ((err as { name?: string }).name === \"ConditionalCheckFailedException\") return { ok: false, used: max };\n    53\t      throw err;\n    54\t    }\n    55\t  }\n    56\t}\n    57\t\n    58\texport interface Usage {\n    59\t  input_tokens: number;\n    60\t  output_tokens: number;\n    61\t  cache_read_input_tokens?: number | null;\n    62\t  cache_creation_input_tokens?: number | null;\n    63\t}\n    64\t\n    65\tconst day = () => new Date().toISOString().slice(0, 10);\n    66\tconst minute = () => new Date().toISOString().slice(0, 16);\n    67\t\n    68\texport class RunBudget {\n    69\t  readonly abort = new AbortController();\n    70\t  private started = Date.now();\n    71\t  private timer: NodeJS.Timeout;\n    72\t  private turns = 0;\n    73\t  private inTok = 0;\n    74\t  private outTok = 0;\n    75\t  private cost = 0;\n    76\t  private toolCalls = 0;\n    77\t  private toolTimes: number[] = [];\n    78\t  private peerCalls = 0;\n    79\t\n    80\t  constructor(\n    81\t    private b: Budgets,\n    82\t    private store: QuotaStore,\n    83\t    private scope: { tenantId: string; subjectId: string },\n    84\t    private now: () => number = Date.now,\n    85\t  ) {\n    86\t    this.started = this.now();\n    87\t    this.timer = setTimeout(\n    88\t      () => this.abort.abort(new BudgetExceeded(\"wall_time\", this.b.run.maxWallMs, this.b.run.maxWallMs)),\n    89\t      this.b.run.maxWallMs,\n    90\t    );\n    91\t  }\n    92\t\n    93\t  get signal(): AbortSignal {\n    94\t    return this.abort.signal;\n    95\t  }\n    96\t\n    97\t  dispose(): void {\n    98\t    clearTimeout(this.timer);\n    99\t  }\n   100\t\n   101\t  private check(limit: LimitName, used: number, max: number): void {\n   102\t    if (used > max) {\n   103\t      const e = new BudgetExceeded(limit, used, max);\n   104\t      this.abort.abort(e);\n   105\t      throw e;\n   106\t    }\n   107\t  }\n   108\t\n   109\t  private checkWall(): void {\n   110\t    this.check(\"wall_time\", this.now() - this.started, this.b.run.maxWallMs);\n   111\t  }\n   112\t\n   113\t  turn(): void {\n   114\t    this.checkWall();\n   115\t    this.turns += 1;\n   116\t    this.check(\"turns\", this.turns, this.b.run.maxTurns);\n   117\t  }\n   118\t\n   119\t  async recordUsage(u: Usage, model: string): Promise<void> {\n   120\t    const price = this.b.pricingUsdPerMTok[model];\n   121\t    if (!price) throw new Error(`no pricing for model ${model}`);\n   122\t    const cacheRead = u.cache_read_input_tokens ?? 0;\n   123\t    const cacheWrite = u.cache_creation_input_tokens ?? 0;\n   124\t    const callCost =\n   125\t      (u.input_tokens * price.input +\n   126\t        u.output_tokens * price.output +\n   127\t        cacheRead * price.cacheRead +\n   128\t        cacheWrite * price.cacheWrite) /\n   129\t      1_000_000;\n   130\t\n   131\t    this.inTok += u.input_tokens + cacheRead + cacheWrite;\n   132\t    this.outTok += u.output_tokens;\n   133\t    this.cost += callCost;\n   134\t    this.check(\"input_tokens\", this.inTok, this.b.run.maxInputTokens);\n   135\t    this.check(\"output_tokens\", this.outTok, this.b.run.maxOutputTokens);\n   136\t    this.check(\"run_cost\", this.cost, this.b.run.maxCostUsd);\n   137\t\n   138\t    const q = this.b.quotas;\n   139\t    await this.shared(\"subject_daily_cost\", `cost#subject#${this.scope.subjectId}#${day()}`, callCost, q.perSubjectDailyUsd, 86400);\n   140\t    await this.shared(\"tenant_daily_cost\", `cost#tenant#${this.scope.tenantId}#${day()}`, callCost, q.perTenantDailyUsd, 86400);\n   141\t    await this.shared(\"fleet_daily_cost\", `cost#fleet#${day()}`, callCost, q.fleetDailyUsd, 86400);\n   142\t  }\n   143\t\n   144\t  async toolCall(tool: string): Promise<void> {\n   145\t    this.checkWall();\n   146\t    this.toolCalls += 1;\n   147\t    this.check(\"tool_calls\", this.toolCalls, this.b.run.maxToolCalls);\n   148\t\n   149\t    const t = this.now();\n   150\t    this.toolTimes = this.toolTimes.filter((x) => t - x < 60_000);\n   151\t    this.toolTimes.push(t);\n   152\t    this.check(\"tool_call_rate\", this.toolTimes.length, this.b.run.maxToolCallsPerMinute);\n   153\t\n   154\t    if (tool.startsWith(\"insurance__\")) {\n   155\t      this.peerCalls += 1;\n   156\t      this.check(\"peer_calls\", this.peerCalls, this.b.run.maxPeerCalls);\n   157\t    }\n   158\t\n   159\t    const q = this.b.quotas;\n   160\t    await this.shared(\"tenant_tool_rate\", `rate#tenant#${this.scope.tenantId}#${minute()}`, 1, q.perTenantToolCallsPerMinute, 120);\n   161\t    await this.shared(\"fleet_tool_rate\", `rate#fleet#${minute()}`, 1, q.fleetToolCallsPerMinute, 120);\n   162\t  }\n   163\t\n   164\t  private async shared(limit: LimitName, key: string, amount: number, max: number, ttl: number): Promise<void> {\n   165\t    const r = await this.store.add(key, amount, max, ttl);\n   166\t    if (!r.ok) {\n   167\t      const e = new BudgetExceeded(limit, r.used + amount, max);\n   168\t      this.abort.abort(e);\n   169\t      throw e;\n   170\t    }\n   171\t  }\n   172\t}\n     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\nagent\naudit\nconfig.ts\ncontrol\nintegrations\nroutes\nserver.ts\ntools\nworkers\nworkflows\n\nsrc/agent:\nbudget.ts\nclassifier.ts\ncontext-size.ts\nidentity.ts\nloop.ts\n\nsrc/audit:\nrecorder.ts\n\nsrc/control:\nkill-switch.ts\n\nsrc/integrations:\nehr-mcp.ts\neligibility-a2a.ts\npayments.ts\nsms.ts\n\nsrc/routes