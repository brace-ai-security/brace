{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014po9yNwVvmSa84xBHyXfeR","type":"tool_result","content":"1\timport type { FastifyInstance } from \"fastify\";\n2\timport { createRemoteJWKSet, jwtVerify } from \"jose\";\n3\timport { z } from \"zod\";\n4\timport { runAgent } from \"../agent/loop.js\";\n5\timport { newRunContext } from \"../agent/identity.js\";\n6\timport { env } from \"../config.js\";\n7\timport type { ToolRegistry } from \"../tools/registry.js\";\n8\t\n9\t// Web chat. The widget gets a short-lived session JWT from the group auth service after the\n10\t// patient verifies by one-time code, or a staff JWT for front-desk users.\n11\t// Claims: sub, clinic_id, role (\"patient\" | \"staff\"), exp.\n12\t\n13\tconst jwks = createRemoteJWKSet(new URL(env.chatJwksUrl));\n14\t\n15\tconst ChatBody = z.object({ message: z.string().min(1).max(2000) }).strict();\n16\tconst TRACEPARENT = /^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/;\n17\t\n18\texport function registerWebchat(\n19\t  app: FastifyInstance,\n20\t  deps: { registry: ToolRegistry; clinicById: (id: string) => { id: string; name: string } | undefined },\n21\t): void {\n22\t  app.post(\"/v1/chat\", { bodyLimit: 16_384 }, async (req, reply) => {\n23\t    const auth = req.headers.authorization ?? \"\";\n24\t    if (!auth.startsWith(\"Bearer \")) return reply.code(401).send({ error: \"missing token\" });\n25\t\n26\t    let claims: { sub: string; clinic_id: string; role: \"patient\" | \"staff\" };\n27\t    try {\n28\t      const { payload } = await jwtVerify(auth.slice(7), jwks, {\n29\t        issuer: env.chatIssuer,\n30\t        audience: \"clinic-agent-chat\",\n31\t        algorithms: [\"ES256\"],\n32\t        maxTokenAge: \"30m\",\n33\t      });\n34\t      claims = payload as unknown as typeof claims;\n35\t    } catch {\n36\t      return reply.code(401).send({ error: \"invalid token\" });\n37\t    }\n38\t\n39\t    const body = ChatBody.safeParse(req.body);\n40\t    if (!body.success) return reply.code(400).send({ error: \"invalid body\" });\n41\t\n42\t    // The group site embeds one widget for all clinics and sends the clinic the patient picked.\n43\t    const tenantId = (req.headers[\"x-clinic-id\"] as string | undefined) ?? claims.clinic_id;\n44\t    const clinic = deps.clinicById(tenantId);\n45\t    if (!clinic) return reply.code(404).send({ error: \"unknown clinic\" });\n46\t\n47\t    const tp = req.headers.traceparent;\n48\t    const ctx = newRunContext({\n49\t      tenantId: clinic.id,\n50\t      subject: { kind: claims.role === \"staff\" ? \"staff\" : \"patient\", id: claims.sub },\n51\t      channel: \"webchat\",\n52\t      traceparent: typeof tp === \"string\" && TRACEPARENT.test(tp) ? tp : undefined,\n53\t      log: req.log,\n54\t    });\n55\t\n56\t    const out = await runAgent(deps.registry, ctx, clinic, body.data.message);\n57\t    return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });\n58\t  });\n59\t}\n60\t"}]},"parent_tool_use_id":null,"session_id":"29563294-217c-407e-8b87-42521726a071","uuid":"b0dd938e-0132-41cc-a7b9-24b84886943f","timestamp":"2026-10-02T16:08:19.721Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-repeat-80qi2mwl/agent/src/routes/webchat.ts","content":"import type { FastifyInstance } from \"fastify\";\nimport { createRemoteJWKSet, jwtVerify } from \"jose\";\nimport { z } from \"zod\";\nimport { runAgent } from \"../agent/loop.js\";\nimport { newRunContext } from \"../agent/identity.js\";\nimport { env } from \"../config.js\";\nimport type { ToolRegistry } from \"../tools/registry.js\";\n\n// Web chat. The widget gets a short-lived session JWT from the group auth service after the\n// patient verifies by one-time code, or a staff JWT for front-desk users.\n// Claims: sub, clinic_id, role (\"patient\" | \"staff\"), exp.\n\nconst jwks = createRemoteJWKSet(new URL(env.chatJwksUrl));\n\nconst ChatBody = z.object({ message: z.string().min(1).max(2000) }).strict();\nconst TRACEPARENT = /^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/;\n\nexport function registerWebchat(\n  app: FastifyInstance,\n  deps: { registry: ToolRegistry; clinicById: (id: string) => { id: string; name: string } | undefined },\n): void {\n  app.post(\"/v1/chat\", { bodyLimit: 16_384 }, async (req, reply) => {\n    const auth = req.headers.authorization ?? \"\";\n    if (!auth.startsWith(\"Bearer \")) return reply.code(401).send({ error: \"missing token\" });\n\n    let claims: { sub: string; clinic_id: string; role: \"patient\" | \"staff\" };\n    try {\n      const { payload } = await jwtVerify(auth.slice(7), jwks, {\n        issuer: env.chatIssuer,\n        audience: \"clinic-agent-chat\",\n        algorithms: [\"ES256\"],\n        maxTokenAge: \"30m\",\n      });\n      claims = payload as unknown as typeof claims;\n    } catch {\n      return reply.code(401).send({ error: \"invalid token\" });\n    }\n\n    const body = ChatBody.safeParse(req.body);\n    if (!body.success) return reply.code(400).send({ error: \"invalid body\" });\n\n    // The group site embeds one widget for all clinics and sends the clinic the patient picked.\n    const tenantId = (req.headers[\"x-clinic-id\"] as string | undefined) ?? claims.clinic_id;\n    const clinic = deps.clinicById(tenantId);\n    if (!clinic) return reply.code(404).send({ error: \"unknown clinic\" });\n\n    const tp = req.headers.traceparent;\n    const ctx = newRunContext({\n      tenantId: clinic.id,\n      subject: { kind: claims.role === \"staff\" ? \"staff\" : \"patient\", id: claims.sub },\n      channel: \"webchat\",\n      traceparent: typeof tp === \"string\" && TRACEPARENT.test(tp) ? tp : undefined,\n      log: req.log,\n    });\n\n    const out = await runAgent(deps.registry, ctx, clinic, body.data.message);\n    return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });\n  });\n}\n","numLines":60,"startLine":1,"totalLines":60}}}
