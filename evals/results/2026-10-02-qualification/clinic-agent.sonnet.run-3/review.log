{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RYbEDKh4z6JVPaptyPMcHV","type":"tool_result","content":"1\timport type Anthropic from \"@anthropic-ai/sdk\";\n2\timport type { ContextSize } from \"../agent/context-size.js\";\n3\timport { scanServer, type ServerMeta, type ToolMeta } from \"./metadata-scan.js\";\n4\t\n5\t// Tool identity is \"<serverId>__<toolName>\", where serverId is the id this deployment assigned in\n6\t// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about\n7\t// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.\n8\t// Only servers listed in the manifest can contribute tools.\n9\t\n10\texport interface ConfiguredServer {\n11\t  id: string;\n12\t  url: string;\n13\t  tlsCertSha256: string;\n14\t}\n15\t\n16\texport interface InvokeOptions {\n17\t  clinicId: string;\n18\t  signal: AbortSignal;\n19\t  runCtx: unknown;\n20\t  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */\n21\t  context: ContextSize;\n22\t}\n23\t\n24\texport interface RegisteredTool {\n25\t  key: string;\n26\t  serverId: string;\n27\t  name: string;\n28\t  definition: Anthropic.Tool;\n29\t  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;\n30\t}\n31\t\n32\texport interface Conflict {\n33\t  key: string;\n34\t  conflictsWith: string;\n35\t  kind: \"duplicate\" | \"lookalike\";\n36\t}\n37\t\n38\tconst CONFUSABLES: Record<string, string> = { \"0\": \"o\", \"1\": \"l\", \"3\": \"e\", \"5\": \"s\", \"7\": \"t\", \"@\": \"a\", \"$\": \"s\" };\n39\t\n40\texport function canonical(name: string): string {\n41\t  return name\n42\t    .normalize(\"NFKC\")\n43\t    .toLowerCase()\n44\t    .replace(/rn/g, \"m\")\n45\t    .replace(/vv/g, \"w\")\n46\t    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)\n47\t    .replace(/[^a-z]/g, \"\");\n48\t}\n49\t\n50\tfunction editDistanceAtMostOne(a: string, b: string): boolean {\n51\t  if (a === b) return true;\n52\t  if (Math.abs(a.length - b.length) > 1) return false;\n53\t  let i = 0;\n54\t  let j = 0;\n55\t  let edits = 0;\n56\t  while (i < a.length && j < b.length) {\n57\t    if (a[i] === b[j]) {\n58\t      i++;\n59\t      j++;\n60\t      continue;\n61\t    }\n62\t    if (++edits > 1) return false;\n63\t    if (a.length > b.length) i++;\n64\t    else if (b.length > a.length) j++;\n65\t    else {\n66\t      i++;\n67\t      j++;\n68\t    }\n69\t  }\n70\t  return edits + (a.length - i) + (b.length - j) <= 1;\n71\t}\n72\t\n73\texport class ToolRegistry {\n74\t  private tools = new Map<string, RegisteredTool>();\n75\t  readonly conflicts: Conflict[] = [];\n76\t  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];\n77\t\n78\t  constructor(private servers: ConfiguredServer[]) {}\n79\t\n80\t  get(key: string): RegisteredTool | undefined {\n81\t    return this.tools.get(key);\n82\t  }\n83\t\n84\t  definitions(): Anthropic.Tool[] {\n85\t    return [...this.tools.values()].map((t) => t.definition);\n86\t  }\n87\t\n88\t  bareNamesExcept(serverId: string): Set<string> {\n89\t    return new Set([...this.tools.values()].filter((t) => t.serverId !== serverId).map((t) => t.name));\n90\t  }\n91\t\n92\t  /** Native tools are registered first so MCP metadata that names them is caught by the scanner. */\n93\t  registerNative(serverId: string, tools: Array<Omit<RegisteredTool, \"key\" | \"serverId\">>): void {\n94\t    for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\n95\t  }\n96\t\n97\t  /**\n98\t   * serverId must be one of the configured servers, and the caller must have connected using that\n99\t   * server's pinned URL and certificate. reportedName is informational only.\n100\t   */\n101\t  registerMcp(\n102\t    serverId: string,\n103\t    reportedName: string | undefined,\n104\t    meta: ServerMeta,\n105\t    invoke: (tool: string, input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>,\n106\t  ): void {\n107\t    const cfg = this.servers.find((s) => s.id === serverId);\n108\t    if (!cfg) {\n109\t      this.rejected.push({ serverId, reason: `server not in release manifest (reported name ${reportedName ?? \"none\"})` });\n110\t      return;\n111\t    }\n112\t    let scan;\n113\t    try {\n114\t      scan = scanServer(meta, this.bareNamesExcept(serverId));\n115\t    } catch (err) {\n116\t      this.rejected.push({ serverId, reason: `metadata scan error: ${(err as Error).message}` });\n117\t      return;\n118\t    }\n119\t    if (scan.serverRejected) {\n120\t      this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });\n121\t      return;\n122\t    }\n123\t    for (const [tool, findings] of scan.rejectedTools) {\n124\t      this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });\n125\t    }\n126\t    for (const t of scan.acceptedTools) {\n127\t      this.add({\n128\t        key: `${serverId}__${t.name}`,\n129\t        serverId,\n130\t        name: t.name,\n131\t        definition: toDefinition(`${serverId}__${t.name}`, t),\n132\t        invoke: (input, opts) => invoke(t.name, input, opts),\n133\t      });\n134\t    }\n135\t  }\n136\t\n137\t  private add(t: RegisteredTool): void {\n138\t    if (this.tools.has(t.key)) {\n139\t      this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: \"duplicate\" });\n140\t      this.rejected.push({ serverId: t.serverId, tool: t.name, reason: \"duplicate tool key\" });\n141\t      return;\n142\t    }\n143\t    const c = canonical(t.name);\n144\t    for (const existing of this.tools.values()) {\n145\t      if (existing.serverId === t.serverId) continue;\n146\t      if (existing.name === t.name) {\n147\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"duplicate\" });\n148\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });\n149\t        return;\n150\t      }\n151\t      if (editDistanceAtMostOne(canonical(existing.name), c)) {\n152\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"lookalike\" });\n153\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `looks like ${existing.key}` });\n154\t        return;\n155\t      }\n156\t    }\n157\t    this.tools.set(t.key, t);\n158\t  }\n159\t}\n160\t\n161\tfunction toDefinition(key: string, t: ToolMeta): Anthropic.Tool {\n162\t  return {\n163\t    name: key,\n164\t    description: t.description ?? \"\",\n165\t    input_schema: (t.inputSchema as Anthropic.Tool.InputSchema) ?? { type: \"object\", properties: {} },\n166\t  };\n167\t}\n168\t"}]},"parent_tool_use_id":null,"session_id":"29563294-217c-407e-8b87-42521726a071","uuid":"58031763-a797-41c1-b21d-d65e3947428b","timestamp":"2026-10-02T16:08:03.365Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-repeat-80qi2mwl/agent/src/tools/registry.ts","content":"import type Anthropic from \"@anthropic-ai/sdk\";\nimport type { ContextSize } from \"../agent/context-size.js\";\nimport { scanServer, type ServerMeta, type ToolMeta } from \"./metadata-scan.js\";\n\n// Tool identity is \"<serverId>__<toolName>\", where serverId is the id this deployment assigned in\n// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about\n// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.\n// Only servers listed in the manifest can contribute tools.\n\nexport interface ConfiguredServer {\n  id: string;\n  url: string;\n  tlsCertSha256: string;\n}\n\nexport interface InvokeOptions {\n  clinicId: string;\n  signal: AbortSignal;\n  runCtx: unknown;\n  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */\n  context: ContextSize;\n}\n\nexport interface RegisteredTool {\n  key: string;\n  serverId: string;\n  name: string;\n  definition: Anthropic.Tool;\n  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;\n}\n\nexport interface Conflict {\n  key: string;\n  conflictsWith: string;\n  kind: \"duplicate\" | \"lookalike\";\n}\n\nconst CONFUSABLES: Record<string, string> = { \"0\": \"o\", \"1\": \"l\", \"3\": \"e\", \"5\": \"s\", \"7\": \"t\", \"@\": \"a\", \"$\": \"s\" };\n\nexport function canonical(name: string): string {\n  return name\n    .normalize(\"NFKC\")\n    .toLowerCase()\n    .replace(/rn/g, \"m\")\n    .replace(/vv/g, \"w\")\n    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)\n    .replace(/[^a-z]/g, \"\");\n}\n\nfunction editDistanceAtMostOne(a: string, b: string): boolean {\n  if (a === b) return true;\n  if (Math.abs(a.length - b.length) > 1) return false;\n  let i = 0;\n  let j = 0;\n  let edits = 0;\n  while (i < a.length && j < b.length) {\n    if (a[i] === b[j]) {\n      i++;\n      j++;\n      continue;\n    }\n    if (++edits > 1) return false;\n    if (a.length > b.length) i++;\n    else if (b.length > a.length) j++;\n    else {\n      i++;\n      j++;\n    }\n  }\n  return edits + (a.length - i) + (b.length - j) <= 1;\n}\n\nexport class ToolRegistry {\n  private tools = new Map<string, RegisteredTool>();\n  readonly conflicts: Conflict[] = [];\n  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];\n\n  constructor(private servers: ConfiguredServer[]) {}\n\n  get(key: string): RegisteredTool | undefined {\n    return this.tools.get(key);\n  }\n\n  definitions(): Anthropic.Tool[] {\n    return [...this.tools.values()].map((t) => t.definition);\n  }\n\n  bareNamesExcept(serverId: string): Set<string> {\n    return new Set([...this.tools.values()].filter((t) => t.serverId !== serverId).map((t) => t.name));\n  }\n\n  /** Native tools are registered first so MCP metadata that names them is caught by the scanner. */\n  registerNative(serverId: string, tools: Array<Omit<RegisteredTool, \"key\" | \"serverId\">>): void {\n    for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\n  }\n\n  /**\n   * serverId must be one of the configured servers, and the caller must have connected using that\n   * server's pinned URL and certificate. reportedName is informational only.\n   */\n  registerMcp(\n    serverId: string,\n    reportedName: string | undefined,\n    meta: ServerMeta,\n    invoke: (tool: string, input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>,\n  ): void {\n    const cfg = this.servers.find((s) => s.id === serverId);\n    if (!cfg) {\n      this.rejected.push({ serverId, reason: `server not in release manifest (reported name ${reportedName ?? \"none\"})` });\n      return;\n    }\n    let scan;\n    try {\n      scan = scanServer(meta, this.bareNamesExcept(serverId));\n    } catch (err) {\n      this.rejected.push({ serverId, reason: `metadata scan error: ${(err as Error).message}` });\n      return;\n    }\n    if (scan.serverRejected) {\n      this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });\n      return;\n    }\n    for (const [tool, findings] of scan.rejectedTools) {\n      this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });\n    }\n    for (const t of scan.acceptedTools) {\n      this.add({\n        key: `${serverId}__${t.name}`,\n        serverId,\n        name: t.name,\n        definition: toDefinition(`${serverId}__${t.name}`, t),\n        invoke: (input, opts) => invoke(t.name, input, opts),\n      });\n    }\n  }\n\n  private add(t: RegisteredTool): void {\n    if (this.tools.has(t.key)) {\n      this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: \"duplicate\" });\n      this.rejected.push({ serverId: t.serverId, tool: t.name, reason: \"duplicate tool key\" });\n      return;\n    }\n    const c = canonical(t.name);\n    for (const existing of this.tools.values()) {\n      if (existing.serverId === t.serverId) continue;\n      if (existing.name === t.name) {\n        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"duplicate\" });\n        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });\n        return;\n      }\n      if (editDistanceAtMostOne(canonical(existing.name), c)) {\n        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"lookalike\" });\n        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `looks like ${existing.key}` });\n        return;\n      }\n    }\n    this.tools.set(t.key, t);\n  }\n}\n\nfunction toDefinition(key: string, t: ToolMeta): Anthropic.Tool {\n  return {\n    name: key,\n    description: t.description ?? \"\",\n    input_schema: (t.inputSchema as Anthropic.Tool.InputSchema) ?? { type: \"object\", properties: {} },\n  };\n}\n","numLines":168,"startLine":1,"totalLines":168}}}
