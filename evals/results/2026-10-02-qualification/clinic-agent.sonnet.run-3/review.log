{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BbLG9fiFLRUh8TzokcTqFE","type":"tool_result","content":"1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n2\timport { env } from \"../config.js\";\n3\t\n4\t// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n5\t// can send; free-form text goes through sms__send_freeform, which needs approval.\n6\t\n7\tconst sm = new SecretsManagerClient({ region: env.region });\n8\tconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n9\t\n10\texport const TEMPLATES = {\n11\t  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n12\t  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n13\t  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n14\t  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n15\t} as const;\n16\texport type TemplateId = keyof typeof TEMPLATES;\n17\t\n18\texport function render(id: TemplateId, vars: Record<string, string>): string {\n19\t  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n20\t}\n21\t\n22\tasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n23\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n24\t  const v = JSON.parse(s.SecretString ?? \"{}\");\n25\t  return { token: v.api_token, from: v.from_number };\n26\t}\n27\t\n28\texport const sms = {\n29\t  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n30\t    const c = await creds(clinicId);\n31\t    const res = await fetch(`${BASE}/messages`, {\n32\t      method: \"POST\",\n33\t      signal,\n34\t      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n35\t      body: JSON.stringify({ from: c.from, to, body }),\n36\t    });\n37\t    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n38\t    return (await res.json()) as { messageId: string };\n39\t  },\n40\t};\n41\t"}]},"parent_tool_use_id":null,"session_id":"29563294-217c-407e-8b87-42521726a071","uuid":"940a6002-0e3b-4ef9-a685-4477fcfc444c","timestamp":"2026-10-02T16:08:17.587Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-repeat-80qi2mwl/agent/src/integrations/sms.ts","content":"import { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\nimport { env } from \"../config.js\";\n\n// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n// can send; free-form text goes through sms__send_freeform, which needs approval.\n\nconst sm = new SecretsManagerClient({ region: env.region });\nconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n\nexport const TEMPLATES = {\n  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n} as const;\nexport type TemplateId = keyof typeof TEMPLATES;\n\nexport function render(id: TemplateId, vars: Record<string, string>): string {\n  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n}\n\nasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n  const v = JSON.parse(s.SecretString ?? \"{}\");\n  return { token: v.api_token, from: v.from_number };\n}\n\nexport const sms = {\n  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n    const c = await creds(clinicId);\n    const res = await fetch(`${BASE}/messages`, {\n      method: \"POST\",\n      signal,\n      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ from: c.from, to, body }),\n    });\n    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n    return (await res.json()) as { messageId: string };\n  },\n};\n","numLines":41,"startLine":1,"totalLines":41}}}
