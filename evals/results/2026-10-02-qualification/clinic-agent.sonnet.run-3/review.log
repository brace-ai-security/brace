{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016bxGDFEVPYCMFcSgjbTVgG","type":"tool_result","content":"=== k8s/deployment.yaml\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: clinic-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.33\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: clinic-agent\n    15\t  namespace: clinic-agent\n    16\t  annotations:\n    17\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    18\t    eks.amazonaws.com/token-expiration: \"3600\"\n    19\tautomountServiceAccountToken: false\n    20\t---\n    21\tapiVersion: v1\n    22\tkind: ServiceAccount\n    23\tmetadata:\n    24\t  name: clinic-agent-reminders\n    25\t  namespace: clinic-agent\n    26\t  annotations:\n    27\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    28\tautomountServiceAccountToken: false\n    29\t---\n    30\tapiVersion: v1\n    31\tkind: ConfigMap\n    32\tmetadata:\n    33\t  name: clinic-agent\n    34\t  namespace: clinic-agent\n    35\tdata:\n    36\t  CLINIC_DIRECTORY: |\n    37\t    [{\"id\":\"nb-castro\",\"name\":\"Northbay Castro\",\"smsNumber\":\"+14155550110\"},\n    38\t     {\"id\":\"nb-fremont\",\"name\":\"Northbay Fremont\",\"smsNumber\":\"+15105550111\"},\n    39\t     {\"id\":\"nb-oakland\",\"name\":\"Northbay Oakland\",\"smsNumber\":\"+15105550112\"},\n    40\t     {\"id\":\"nb-sanmateo\",\"name\":\"Northbay San Mateo\",\"smsNumber\":\"+16505550113\"},\n    41\t     {\"id\":\"nb-walnutcreek\",\"name\":\"Northbay Walnut Creek\",\"smsNumber\":\"+19255550114\"}]\n    42\t  SMS_SIGNING_SECRET_ARN: arn:aws:secretsmanager:us-west-2:418295730611:secret:clinic-agent/sms-signing\n    43\t  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n    44\t  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n    45\t---\n    46\tapiVersion: apps/v1\n    47\tkind: Deployment\n    48\tmetadata:\n    49\t  name: clinic-agent\n    50\t  namespace: clinic-agent\n    51\t  labels: { app: clinic-agent }\n    52\tspec:\n    53\t  replicas: 3\n    54\t  selector:\n    55\t    matchLabels: { app: clinic-agent }\n    56\t  template:\n    57\t    metadata:\n    58\t      labels: { app: clinic-agent }\n    59\t    spec:\n    60\t      serviceAccountName: clinic-agent\n    61\t      automountServiceAccountToken: false\n    62\t      hostUsers: false\n    63\t      hostNetwork: false\n    64\t      hostPID: false\n    65\t      hostIPC: false\n    66\t      enableServiceLinks: false\n    67\t      securityContext:\n    68\t        runAsNonRoot: true\n    69\t        runAsUser: 65532\n    70\t        runAsGroup: 65532\n    71\t        fsGroup: 65532\n    72\t        seccompProfile:\n    73\t          type: RuntimeDefault\n    74\t      containers:\n    75\t        - name: agent\n    76\t          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    77\t          ports:\n    78\t            - containerPort: 8080\n    79\t          envFrom:\n    80\t            - configMapRef: { name: clinic-agent }\n    81\t          env:\n    82\t            - name: IMAGE_DIGEST\n    83\t              value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    84\t            - name: GIT_SHA\n    85\t              value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n    86\t          securityContext:\n    87\t            allowPrivilegeEscalation: false\n    88\t            privileged: false\n    89\t            readOnlyRootFilesystem: true\n    90\t            runAsNonRoot: true\n    91\t            capabilities:\n    92\t              drop: [\"ALL\"]\n    93\t            seccompProfile:\n    94\t              type: RuntimeDefault\n    95\t          resources:\n    96\t            requests: { cpu: 250m, memory: 384Mi }\n    97\t            limits: { cpu: \"1\", memory: 768Mi }\n    98\t          readinessProbe:\n    99\t            httpGet: { path: /healthz, port: 8080 }\n   100\t          volumeMounts:\n   101\t            - { name: tmp, mountPath: /tmp }\n   102\t            - { name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true }\n   103\t      volumes:\n   104\t        - name: tmp\n   105\t          emptyDir: { medium: Memory, sizeLimit: 32Mi }\n   106\t        - name: sts-token\n   107\t          projected:\n   108\t            sources:\n   109\t              - serviceAccountToken:\n   110\t                  audience: https://sts.northbay-clinics.example\n   111\t                  expirationSeconds: 900\n   112\t                  path: sts-token\n   113\t---\n   114\tapiVersion: batch/v1\n   115\tkind: CronJob\n   116\tmetadata:\n   117\t  name: clinic-agent-reminders\n   118\t  namespace: clinic-agent\n   119\tspec:\n   120\t  schedule: \"0 17 * * *\"\n   121\t  timeZone: America/Los_Angeles\n   122\t  concurrencyPolicy: Forbid\n   123\t  jobTemplate:\n   124\t    spec:\n   125\t      backoffLimit: 0\n   126\t      activeDeadlineSeconds: 1800\n   127\t      template:\n   128\t        metadata:\n   129\t          labels: { app: clinic-agent-reminders }\n   130\t        spec:\n   131\t          serviceAccountName: clinic-agent-reminders\n   132\t          automountServiceAccountToken: false\n   133\t          restartPolicy: Never\n   134\t          hostUsers: false\n   135\t          securityContext:\n   136\t            runAsNonRoot: true\n   137\t            runAsUser: 65532\n   138\t            runAsGroup: 65532\n   139\t            seccompProfile:\n   140\t              type: RuntimeDefault\n   141\t          containers:\n   142\t            - name: reminders\n   143\t              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   144\t              args: [\"dist/workers/reminders.js\"]\n   145\t              envFrom:\n   146\t                - configMapRef: { name: clinic-agent }\n   147\t              env:\n   148\t                - name: IMAGE_DIGEST\n   149\t                  value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   150\t                - name: GIT_SHA\n   151\t                  value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n   152\t              securityContext:\n   153\t                allowPrivilegeEscalation: false\n   154\t                privileged: false\n   155\t                readOnlyRootFilesystem: true\n   156\t                capabilities:\n   157\t                  drop: [\"ALL\"]\n   158\t---\n   159\t# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n   160\t# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,\n   161\t# the group STS and auth service, and AWS service endpoints.\n   162\tapiVersion: networking.k8s.io/v1\n   163\tkind: NetworkPolicy\n   164\tmetadata:\n   165\t  name: clinic-agent-egress\n   166\t  namespace: clinic-agent\n   167\tspec:\n   168\t  podSelector: {}\n   169\t  policyTypes: [\"Egress\", \"Ingress\"]\n   170\t  ingress:\n   171\t    - from:\n   172\t        - namespaceSelector:\n   173\t            matchLabels: { kubernetes.io/metadata.name: ingress }\n   174\t      ports:\n   175\t        - { port: 8080, protocol: TCP }\n   176\t  egress:\n   177\t    - to:\n   178\t        - namespaceSelector:\n   179\t            matchLabels: { kubernetes.io/metadata.name: kube-system }\n   180\t          podSelector:\n   181\t            matchLabels: { k8s-app: kube-dns }\n   182\t      ports:\n   183\t        - { port: 53, protocol: UDP }\n   184\t        - { port: 53, protocol: TCP }\n   185\t    - to:\n   186\t        - namespaceSelector:\n   187\t            matchLabels: { kubernetes.io/metadata.name: platform }\n   188\t          podSelector:\n   189\t            matchLabels: { app: egress-proxy }\n   190\t      ports:\n   191\t        - { port: 3128, protocol: TCP }\n   192\t    - to:\n   193\t        - ipBlock: { cidr: 10.60.12.0/28 }\n   194\t      ports:\n   195\t        - { port: 443, protocol: TCP }\n=== infra/terraform/github.tf\n     1\t# Who can change production: only the deploy workflow running in the \"production\" or\n     2\t# \"production-emergency\" GitHub environment can assume the deploy role, and both environments\n     3\t# require a named reviewer from agent-platform-leads. Nobody else has write access to the\n     4\t# clinic-agent namespace (see access_entries in main.tf), and the cluster API is private.\n     5\t\n     6\tprovider \"github\" {\n     7\t  owner = \"northbay-clinics\"\n     8\t}\n     9\t\n    10\tdata \"github_team\" \"leads\" {\n    11\t  slug = \"agent-platform-leads\"\n    12\t}\n    13\t\n    14\tresource \"github_branch_protection\" \"main\" {\n    15\t  repository_id = \"clinic-agent\"\n    16\t  pattern       = \"main\"\n    17\t\n    18\t  enforce_admins                  = true\n    19\t  allows_force_pushes             = false\n    20\t  allows_deletions                = false\n    21\t  required_linear_history         = true\n    22\t  require_signed_commits          = true\n    23\t  require_conversation_resolution = true\n    24\t\n    25\t  required_pull_request_reviews {\n    26\t    required_approving_review_count = 2\n    27\t    require_code_owner_reviews      = true\n    28\t    dismiss_stale_reviews           = true\n    29\t    require_last_push_approval      = true\n    30\t  }\n    31\t\n    32\t  required_status_checks {\n    33\t    strict   = true\n    34\t    contexts = [\"ci / test\", \"ci / manifest-check\"]\n    35\t  }\n    36\t}\n    37\t\n    38\tresource \"github_repository_environment\" \"production\" {\n    39\t  repository  = \"clinic-agent\"\n    40\t  environment = \"production\"\n    41\t  reviewers {\n    42\t    teams = [data.github_team.leads.id]\n    43\t  }\n    44\t  prevent_self_review = true\n    45\t  deployment_branch_policy {\n    46\t    protected_branches     = true\n    47\t    custom_branch_policies = false\n    48\t  }\n    49\t}\n    50\t\n    51\tresource \"github_repository_environment\" \"production_emergency\" {\n    52\t  repository  = \"clinic-agent\"\n    53\t  environment = \"production-emergency\"\n    54\t  reviewers {\n    55\t    teams = [data.github_team.leads.id]\n    56\t  }\n    57\t  prevent_self_review = true\n    58\t  deployment_branch_policy {\n    59\t    protected_branches     = false\n    60\t    custom_branch_policies = true\n    61\t  }\n    62\t}\n    63\t\n    64\tresource \"github_repository_environment_deployment_policy\" \"emergency_branches\" {\n    65\t  repository     = \"clinic-agent\"\n    66\t  environment    = github_repository_environment.production_emergency.environment\n    67\t  branch_pattern = \"hotfix/*\"\n    68\t}\n    69\t\n    70\tresource \"aws_iam_role\" \"deploy\" {\n    71\t  name = \"clinic-agent-deploy\"\n    72\t  assume_role_policy = jsonencode({\n    73\t    Version = \"2012-10-17\"\n    74\t    Statement = [{\n    75\t      Effect    = \"Allow\"\n    76\t      Principal = { Federated = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/token.actions.githubusercontent.com\" }\n    77\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n    78\t      Condition = {\n    79\t        StringEquals = {\n    80\t          \"token.actions.githubusercontent.com:aud\" = \"sts.amazonaws.com\"\n    81\t          \"token.actions.githubusercontent.com:sub\" = [\n    82\t            \"repo:northbay-clinics/clinic-agent:environment:production\",\n    83\t            \"repo:northbay-clinics/clinic-agent:environment:production-emergency\",\n    84\t          ]\n    85\t        }\n    86\t      }\n    87\t    }]\n    88\t  })\n    89\t}\n    90\t\n    91\tresource \"aws_iam_role_policy\" \"deploy\" {\n    92\t  name = \"clinic-agent-deploy\"\n    93\t  role = aws_iam_role.deploy.id\n    94\t  policy = jsonencode({\n    95\t    Version = \"2012-10-17\"\n    96\t    Statement = [\n    97\t      {\n    98\t        Effect   = \"Allow\"\n    99\t        Action   = [\"ecr:GetAuthorizationToken\"]\n   100\t        Resource = \"*\"\n   101\t      },\n   102\t      {\n   103\t        Effect   = \"Allow\"\n   104\t        Action   = [\"ecr:BatchCheckLayerAvailability\", \"ecr:PutImage\", \"ecr:InitiateLayerUpload\", \"ecr:UploadLayerPart\", \"ecr:CompleteLayerUpload\", \"ecr:BatchGetImage\"]\n   105\t        Resource = aws_ecr_repository.agent.arn\n   106\t      },\n   107\t      {\n   108\t        Effect   = \"Allow\"\n   109\t        Action   = [\"eks:DescribeCluster\"]\n   110\t        Resource = module.eks.cluster_arn\n   111\t      },\n   112\t    ]\n   113\t  })\n   114\t}\n=== infra/terraform/iam.tf\n     1\t# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:\n     2\t# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.\n     3\tresource \"aws_iam_role\" \"runtime\" {\n     4\t  name                 = \"clinic-agent-runtime\"\n     5\t  max_session_duration = 3600\n     6\t  assume_role_policy = jsonencode({\n     7\t    Version = \"2012-10-17\"\n     8\t    Statement = [{\n     9\t      Effect    = \"Allow\"\n    10\t      Principal = { Federated = module.eks.oidc_provider_arn }\n    11\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n    12\t      Condition = {\n    13\t        StringEquals = {\n    14\t          \"${module.eks.oidc_provider}:sub\" = [\n    15\t            \"system:serviceaccount:clinic-agent:clinic-agent\",\n    16\t            \"system:serviceaccount:clinic-agent:clinic-agent-reminders\",\n    17\t          ]\n    18\t          \"${module.eks.oidc_provider}:aud\" = \"sts.amazonaws.com\"\n    19\t        }\n    20\t      }\n    21\t    }]\n    22\t  })\n    23\t}\n    24\t\n    25\tresource \"aws_iam_role_policy\" \"runtime\" {\n    26\t  name = \"clinic-agent-runtime\"\n    27\t  role = aws_iam_role.runtime.id\n    28\t  policy = jsonencode({\n    29\t    Version = \"2012-10-17\"\n    30\t    Statement = [\n    31\t      {\n    32\t        Sid      = \"ReadClinicSecrets\"\n    33\t        Effect   = \"Allow\"\n    34\t        Action   = [\"secretsmanager:GetSecretValue\"]\n    35\t        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\n    36\t      },\n    37\t      {\n    38\t        Sid    = \"AgentState\"\n    39\t        Effect = \"Allow\"\n    40\t        Action = [\n    41\t          \"dynamodb:GetItem\",\n    42\t          \"dynamodb:BatchGetItem\",\n    43\t          \"dynamodb:PutItem\",\n    44\t          \"dynamodb:UpdateItem\",\n    45\t          \"dynamodb:Query\",\n    46\t        ]\n    47\t        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*\"\n    48\t      },\n    49\t      {\n    50\t        Sid      = \"Audit\"\n    51\t        Effect   = \"Allow\"\n    52\t        Action   = [\"firehose:PutRecord\", \"firehose:PutRecordBatch\"]\n    53\t        Resource = aws_kinesis_firehose_delivery_stream.audit.arn\n    54\t      },\n    55\t    ]\n    56\t  })\n    57\t}\n    58\t\n    59\t# Operators who may stop the agent. Assumable only through SSO by the on-call group.\n    60\tresource \"aws_iam_role\" \"ops_killswitch\" {\n    61\t  name = \"clinic-agent-ops\"\n    62\t  assume_role_policy = jsonencode({\n    63\t    Version = \"2012-10-17\"\n    64\t    Statement = [{\n    65\t      Effect    = \"Allow\"\n    66\t      Principal = { AWS = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\" }\n    67\t      Action    = \"sts:AssumeRole\"\n    68\t      Condition = {\n    69\t        StringLike = { \"aws:PrincipalArn\" = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*\" }\n    70\t      }\n    71\t    }]\n    72\t  })\n    73\t}\n    74\t\n    75\tresource \"aws_iam_role_policy\" \"ops_killswitch\" {\n    76\t  name = \"clinic-agent-ops\"\n    77\t  role = aws_iam_role.ops_killswitch.id\n    78\t  policy = jsonencode({\n    79\t    Version = \"2012-10-17\"\n    80\t    Statement = [{\n    81\t      Effect   = \"Allow\"\n    82\t      Action   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:GetItem\"]\n    83\t      Resource = aws_dynamodb_table.control.arn\n    84\t    }]\n    85\t  })\n    86\t}\n    87\t\n    88\tresource \"aws_iam_role\" \"firehose\" {\n    89\t  name = \"clinic-agent-audit-firehose\"\n    90\t  assume_role_policy = jsonencode({\n    91\t    Version   = \"2012-10-17\"\n    92\t    Statement = [{ Effect = \"Allow\", Principal = { Service = \"firehose.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n    93\t  })\n    94\t}\n    95\t\n    96\tresource \"aws_iam_role_policy\" \"firehose\" {\n    97\t  name = \"write-audit-bucket\"\n    98\t  role = aws_iam_role.firehose.id\n    99\t  policy = jsonencode({\n   100\t    Version = \"2012-10-17\"\n   101\t    Statement = [{\n   102\t      Effect   = \"Allow\"\n   103\t      Action   = [\"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:GetBucketLocation\"]\n   104\t      Resource = [aws_s3_bucket.audit.arn, \"${aws_s3_bucket.audit.arn}/*\"]\n   105\t    }]\n   106\t  })\n   107\t}\n=== infra/terraform/main.tf\n     1\tterraform {\n     2\t  required_version = \">= 1.9.0\"\n     3\t  required_providers {\n     4\t    aws    = { source = \"hashicorp/aws\", version = \"~> 6.14\" }\n     5\t    github = { source = \"integrations/github\", version = \"~> 6.6\" }\n     6\t  }\n     7\t  backend \"s3\" {\n     8\t    bucket         = \"northbay-tfstate-418295730611\"\n     9\t    key            = \"clinic-agent/prod.tfstate\"\n    10\t    region         = \"us-west-2\"\n    11\t    dynamodb_table = \"northbay-tf-locks\"\n    12\t    encrypt        = true\n    13\t  }\n    14\t}\n    15\t\n    16\tprovider \"aws\" {\n    17\t  region = var.region\n    18\t  default_tags {\n    19\t    tags = { app = \"clinic-agent\", owner = \"agent-platform\", data = \"phi\" }\n    20\t  }\n    21\t}\n    22\t\n    23\tvariable \"region\" {\n    24\t  type    = string\n    25\t  default = \"us-west-2\"\n    26\t}\n    27\t\n    28\tvariable \"clinic_ids\" {\n    29\t  type    = list(string)\n    30\t  default = [\"nb-castro\", \"nb-fremont\", \"nb-oakland\", \"nb-sanmateo\", \"nb-walnutcreek\"]\n    31\t}\n    32\t\n    33\tdata \"aws_caller_identity\" \"current\" {}\n    34\t\n    35\tmodule \"eks\" {\n    36\t  source  = \"terraform-aws-modules/eks/aws\"\n    37\t  version = \"21.3.1\"\n    38\t\n    39\t  name               = \"clinic-agent-prod\"\n    40\t  kubernetes_version = \"1.33\"\n    41\t  vpc_id             = module.vpc.vpc_id\n    42\t  subnet_ids         = module.vpc.private_subnets\n    43\t\n    44\t  endpoint_public_access = false\n    45\t  enable_irsa            = true\n    46\t\n    47\t  authentication_mode = \"API\"\n    48\t  access_entries = {\n    49\t    deploy = {\n    50\t      principal_arn = aws_iam_role.deploy.arn\n    51\t      policy_associations = {\n    52\t        ns = {\n    53\t          policy_arn   = \"arn:aws:eks::aws:cluster-access-policy/AmazonEKSEditPolicy\"\n    54\t          access_scope = { type = \"namespace\", namespaces = [\"clinic-agent\"] }\n    55\t        }\n    56\t      }\n    57\t    }\n    58\t  }\n    59\t\n    60\t  eks_managed_node_groups = {\n    61\t    agents = {\n    62\t      instance_types = [\"m7g.large\"]\n    63\t      ami_type       = \"BOTTLEROCKET_ARM_64\"\n    64\t      min_size       = 2\n    65\t      max_size       = 6\n    66\t      desired_size   = 3\n    67\t      metadata_options = {\n    68\t        http_tokens                 = \"required\"\n    69\t        http_put_response_hop_limit = 1\n    70\t      }\n    71\t    }\n    72\t  }\n    73\t}\n    74\t\n    75\tmodule \"vpc\" {\n    76\t  source  = \"terraform-aws-modules/vpc/aws\"\n    77\t  version = \"6.4.0\"\n    78\t\n    79\t  name            = \"clinic-agent-prod\"\n    80\t  cidr            = \"10.42.0.0/16\"\n    81\t  azs             = [\"us-west-2a\", \"us-west-2b\", \"us-west-2c\"]\n    82\t  private_subnets = [\"10.42.1.0/24\", \"10.42.2.0/24\", \"10.42.3.0/24\"]\n    83\t  public_subnets  = [\"10.42.101.0/24\", \"10.42.102.0/24\", \"10.42.103.0/24\"]\n    84\t\n    85\t  enable_nat_gateway = true\n    86\t  single_nat_gateway = false\n    87\t}\n    88\t\n    89\tresource \"aws_ecr_repository\" \"agent\" {\n    90\t  name                 = \"clinic-agent\"\n    91\t  image_tag_mutability = \"IMMUTABLE\"\n    92\t  image_scanning_configuration { scan_on_push = true }\n    93\t}\n    94\t\n    95\t# State tables. Approvals are written by the staff console; budgets by the agent; the control\n    96\t# table holds the stop flags operators set.\n    97\tresource \"aws_dynamodb_table\" \"approvals\" {\n    98\t  name         = \"clinic-agent-approvals\"\n    99\t  billing_mode = \"PAY_PER_REQUEST\"\n   100\t  hash_key     = \"id\"\n   101\t  attribute {\n   102\t    name = \"id\"\n   103\t    type = \"S\"\n   104\t  }\n   105\t  point_in_time_recovery { enabled = true }\n   106\t}\n   107\t\n   108\tresource \"aws_dynamodb_table\" \"budgets\" {\n   109\t  name         = \"clinic-agent-budgets\"\n   110\t  billing_mode = \"PAY_PER_REQUEST\"\n   111\t  hash_key     = \"pk\"\n   112\t  attribute {\n   113\t    name = \"pk\"\n   114\t    type = \"S\"\n   115\t  }\n   116\t  ttl {\n   117\t    attribute_name = \"expiresAt\"\n   118\t    enabled        = true\n   119\t  }\n   120\t}\n   121\t\n   122\tresource \"aws_dynamodb_table\" \"control\" {\n   123\t  name         = \"clinic-agent-control\"\n   124\t  billing_mode = \"PAY_PER_REQUEST\"\n   125\t  hash_key     = \"pk\"\n   126\t  attribute {\n   127\t    name = \"pk\"\n   128\t    type = \"S\"\n   129\t  }\n   130\t  point_in_time_recovery { enabled = true }\n   131\t}\n   132\t\n   133\t# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).\n   134\tresource \"aws_s3_bucket\" \"audit\" {\n   135\t  bucket              = \"clinic-agent-audit-${data.aws_caller_identity.current.account_id}\"\n   136\t  object_lock_enabled = true\n   137\t}\n   138\t\n   139\tresource \"aws_s3_bucket_object_lock_configuration\" \"audit\" {\n   140\t  bucket = aws_s3_bucket.audit.id\n   141\t  rule {\n   142\t    default_retention {\n   143\t      mode  = \"COMPLIANCE\"\n   144\t      years = 7\n   145\t    }\n   146\t  }\n   147\t}\n   148\t\n   149\tresource \"aws_kinesis_firehose_delivery_stream\" \"audit\" {\n   150\t  name        = \"clinic-agent-audit\"\n   151\t  destination = \"extended_s3\"\n   152\t  extended_s3_configuration {\n   153\t    role_arn            = aws_iam_role.firehose.arn\n   154\t    bucket_arn          = aws_s3_bucket.audit.arn\n   155\t    prefix              = \"audit/dt=!{timestamp:yyyy-MM-dd}/\"\n   156\t    error_output_prefix = \"audit-errors/!{firehose:error-output-type}/\"\n   157\t    buffering_interval  = 60\n   158\t  }\n   159\t}\n   160\t\n   161\tresource \"aws_secretsmanager_secret\" \"ehr\" {\n   162\t  for_each = toset(concat(var.clinic_ids, [\"_catalog\"]))\n   163\t  name     = \"clinic-agent/ehr/${each.key}\"\n   164\t}\n   165\t\n   166\tresource \"aws_secretsmanager_secret\" \"payments\" {\n   167\t  for_each = toset(var.clinic_ids)\n   168\t  name     = \"clinic-agent/payments/${each.key}\"\n   169\t}\n   170\t\n   171\tresource \"aws_secretsmanager_secret\" \"sms\" {\n   172\t  for_each = toset(var.clinic_ids)\n   173\t  name     = \"clinic-agent/sms/${each.key}\"\n   174\t}\n   175\t\n   176\tresource \"aws_secretsmanager_secret\" \"sms_signing\" {\n   177\t  name = \"clinic-agent/sms-signing\"\n   178\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"29563294-217c-407e-8b87-42521726a071","uuid":"551faa3d-29b4-4bdb-b76d-1b43ff92651f","timestamp":"2026-10-02T16:08:26.204Z","tool_use_result":{"stdout":"=== k8s/deployment.yaml\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: clinic-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.33\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: clinic-agent\n    15\t  namespace: clinic-agent\n    16\t  annotations:\n    17\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    18\t    eks.amazonaws.com/token-expiration: \"3600\"\n    19\tautomountServiceAccountToken: false\n    20\t---\n    21\tapiVersion: v1\n    22\tkind: ServiceAccount\n    23\tmetadata:\n    24\t  name: clinic-agent-reminders\n    25\t  namespace: clinic-agent\n    26\t  annotations:\n    27\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    28\tautomountServiceAccountToken: false\n    29\t---\n    30\tapiVersion: v1\n    31\tkind: ConfigMap\n    32\tmetadata:\n    33\t  name: clinic-agent\n    34\t  namespace: clinic-agent\n    35\tdata:\n    36\t  CLINIC_DIRECTORY: |\n    37\t    [{\"id\":\"nb-castro\",\"name\":\"Northbay Castro\",\"smsNumber\":\"+14155550110\"},\n    38\t     {\"id\":\"nb-fremont\",\"name\":\"Northbay Fremont\",\"smsNumber\":\"+15105550111\"},\n    39\t     {\"id\":\"nb-oakland\",\"name\":\"Northbay Oakland\",\"smsNumber\":\"+15105550112\"},\n    40\t     {\"id\":\"nb-sanmateo\",\"name\":\"Northbay San Mateo\",\"smsNumber\":\"+16505550113\"},\n    41\t     {\"id\":\"nb-walnutcreek\",\"name\":\"Northbay Walnut Creek\",\"smsNumber\":\"+19255550114\"}]\n    42\t  SMS_SIGNING_SECRET_ARN: arn:aws:secretsmanager:us-west-2:418295730611:secret:clinic-agent/sms-signing\n    43\t  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n    44\t  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n    45\t---\n    46\tapiVersion: apps/v1\n    47\tkind: Deployment\n    48\tmetadata:\n    49\t  name: clinic-agent\n    50\t  namespace: clinic-agent\n    51\t  labels: { app: clinic-agent }\n    52\tspec:\n    53\t  replicas: 3\n    54\t  selector:\n    55\t    matchLabels: { app: clinic-agent }\n    56\t  template:\n    57\t    metadata:\n    58\t      labels: { app: clinic-agent }\n    59\t    spec:\n    60\t      serviceAccountName: clinic-agent\n    61\t      automountServiceAccountToken: false\n    62\t      hostUsers: false\n    63\t      hostNetwork: false\n    64\t      hostPID: false\n    65\t      hostIPC: false\n    66\t      enableServiceLinks: false\n    67\t      securityContext:\n    68\t        runAsNonRoot: true\n    69\t        runAsUser: 65532\n    70\t        runAsGroup: 65532\n    71\t        fsGroup: 65532\n    72\t        seccompProfile:\n    73\t          type: RuntimeDefault\n    74\t      containers:\n    75\t        - name: agent\n    76\t          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    77\t          ports:\n    78\t            - containerPort: 8080\n    79\t          envFrom:\n    80\t            - configMapRef: { name: clinic-agent }\n    81\t          env:\n    82\t            - name: IMAGE_DIGEST\n    83\t              value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n    84\t            - name: GIT_SHA\n    85\t              value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n    86\t          securityContext:\n    87\t            allowPrivilegeEscalation: false\n    88\t            privileged: false\n    89\t            readOnlyRootFilesystem: true\n    90\t            runAsNonRoot: true\n    91\t            capabilities:\n    92\t              drop: [\"ALL\"]\n    93\t            seccompProfile:\n    94\t              type: RuntimeDefault\n    95\t          resources:\n    96\t            requests: { cpu: 250m, memory: 384Mi }\n    97\t            limits: { cpu: \"1\", memory: 768Mi }\n    98\t          readinessProbe:\n    99\t            httpGet: { path: /healthz, port: 8080 }\n   100\t          volumeMounts:\n   101\t            - { name: tmp, mountPath: /tmp }\n   102\t            - { name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true }\n   103\t      volumes:\n   104\t        - name: tmp\n   105\t          emptyDir: { medium: Memory, sizeLimit: 32Mi }\n   106\t        - name: sts-token\n   107\t          projected:\n   108\t            sources:\n   109\t              - serviceAccountToken:\n   110\t                  audience: https://sts.northbay-clinics.example\n   111\t                  expirationSeconds: 900\n   112\t                  path: sts-token\n   113\t---\n   114\tapiVersion: batch/v1\n   115\tkind: CronJob\n   116\tmetadata:\n   117\t  name: clinic-agent-reminders\n   118\t  namespace: clinic-agent\n   119\tspec:\n   120\t  schedule: \"0 17 * * *\"\n   121\t  timeZone: America/Los_Angeles\n   122\t  concurrencyPolicy: Forbid\n   123\t  jobTemplate:\n   124\t    spec:\n   125\t      backoffLimit: 0\n   126\t      activeDeadlineSeconds: 1800\n   127\t      template:\n   128\t        metadata:\n   129\t          labels: { app: clinic-agent-reminders }\n   130\t        spec:\n   131\t          serviceAccountName: clinic-agent-reminders\n   132\t          automountServiceAccountToken: false\n   133\t          restartPolicy: Never\n   134\t          hostUsers: false\n   135\t          securityContext:\n   136\t            runAsNonRoot: true\n   137\t            runAsUser: 65532\n   138\t            runAsGroup: 65532\n   139\t            seccompProfile:\n   140\t              type: RuntimeDefault\n   141\t          containers:\n   142\t            - name: reminders\n   143\t              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   144\t              args: [\"dist/workers/reminders.js\"]\n   145\t              envFrom:\n   146\t                - configMapRef: { name: clinic-agent }\n   147\t              env:\n   148\t                - name: IMAGE_DIGEST\n   149\t                  value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n   150\t                - name: GIT_SHA\n   151\t                  value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n   152\t              securityContext:\n   153\t                allowPrivilegeEscalation: false\n   154\t                privileged: false\n   155\t                readOnlyRootFilesystem: true\n   156\t                capabilities:\n   157\t                  drop: [\"ALL\"]\n   158\t---\n   159\t# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n   160\t# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,\n   161\t# the group STS and auth service, and AWS service endpoints.\n   162\tapiVersion: networking.k8s.io/v1\n   163\tkind: NetworkPolicy\n   164\tmetadata:\n   165\t  name: clinic-agent-egress\n   166\t  namespace: clinic-agent\n   167\tspec:\n   168\t  podSelector: {}\n   169\t  policyTypes: [\"Egress\", \"Ingress\"]\n   170\t  ingress:\n   171\t    - from:\n   172\t        - namespaceSelector:\n   173\t            matchLabels: { kubernetes.io/metadata.name: ingress }\n   174\t      ports:\n   175\t        - { port: 8080, protocol: TCP }\n   176\t  egress:\n   177\t    - to:\n   178\t        - namespaceSelector:\n   179\t            matchLabels: { kubernetes.io/metadata.name: kube-system }\n   180\t          podSelector:\n   181\t            matchLabels: { k8s-app: kube-dns }\n   182\t      ports:\n   183\t        - { port: 53, protocol: UDP }\n   184\t        - { port: 53, protocol: TCP }\n   185\t    - to:\n   186\t        - namespaceSelector:\n   187\t            matchLabels: { kubernetes.io/metadata.name: platform }\n   188\t          podSelector:\n   189\t            matchLabels: { app: egress-proxy }\n   190\t      ports:\n   191\t        - { port: 3128, protocol: TCP }\n   192\t    - to:\n   193\t        - ipBlock: { cidr: 10.60.12.0/28 }\n   194\t      ports:\n   195\t        - { port: 443, protocol: TCP }\n=== infra/terraform/github.tf\n     1\t# Who can change production: only the deploy workflow running in the \"production\" or\n     2\t# \"production-emergency\" GitHub environment can assume the deploy role, and both environments\n     3\t# require a named reviewer from agent-platform-leads. Nobody else has write access to the\n     4\t# clinic-agent namespace (see access_entries in main.tf), and the cluster API is private.\n     5\t\n     6\tprovider \"github\" {\n     7\t  owner = \"northbay-clinics\"\n     8\t}\n     9\t\n    10\tdata \"github_team\" \"leads\" {\n    11\t  slug = \"agent-platform-leads\"\n    12\t}\n    13\t\n    14\tresource \"github_branch_protection\" \"main\" {\n    15\t  repository_id = \"clinic-agent\"\n    16\t  pattern       = \"main\"\n    17\t\n    18\t  enforce_admins                  = true\n    19\t  allows_force_pushes             = false\n    20\t  allows_deletions                = false\n    21\t  required_linear_history         = true\n    22\t  require_signed_commits          = true\n    23\t  require_conversation_resolution = true\n    24\t\n    25\t  required_pull_request_reviews {\n    26\t    required_approving_review_count = 2\n    27\t    require_code_owner_reviews      = true\n    28\t    dismiss_stale_reviews           = true\n    29\t    require_last_push_approval      = true\n    30\t  }\n    31\t\n    32\t  required_status_checks {\n    33\t    strict   = true\n    34\t    contexts = [\"ci / test\", \"ci / manifest-check\"]\n    35\t  }\n    36\t}\n    37\t\n    38\tresource \"github_repository_environment\" \"production\" {\n    39\t  repository  = \"clinic-agent\"\n    40\t  environment = \"production\"\n    41\t  reviewers {\n    42\t    teams = [data.github_team.leads.id]\n    43\t  }\n    44\t  prevent_self_review = true\n    45\t  deployment_branch_policy {\n    46\t    protected_branches     = true\n    47\t    custom_branch_policies = false\n    48\t  }\n    49\t}\n    50\t\n    51\tresource \"github_repository_environment\" \"production_emergency\" {\n    52\t  repository  = \"clinic-agent\"\n    53\t  environment = \"production-emergency\"\n    54\t  reviewers {\n    55\t    teams = [data.github_team.leads.id]\n    56\t  }\n    57\t  prevent_self_review = true\n    58\t  deployment_branch_policy {\n    59\t    protected_branches     = false\n    60\t    custom_branch_policies = true\n    61\t  }\n    62\t}\n    63\t\n    64\tresource \"github_repository_environment_deployment_policy\" \"emergency_branches\" {\n    65\t  repository     = \"clinic-agent\"\n    66\t  environment    = github_repository_environment.production_emergency.environment\n    67\t  branch_pattern = \"hotfix/*\"\n    68\t}\n    69\t\n    70\tresource \"aws_iam_role\" \"deploy\" {\n    71\t  name = \"clinic-agent-deploy\"\n    72\t  assume_role_policy = jsonencode({\n    73\t    Version = \"2012-10-17\"\n    74\t    Statement = [{\n    75\t      Effect    = \"Allow\"\n    76\t      Principal = { Federated = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/token.actions.githubusercontent.com\" }\n    77\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n    78\t      Condition = {\n    79\t        StringEquals = {\n    80\t          \"token.actions.githubusercontent.com:aud\" = \"sts.amazonaws.com\"\n    81\t          \"token.actions.githubusercontent.com:sub\" = [\n    82\t            \"repo:northbay-clinics/clinic-agent:environment:production\",\n    83\t            \"repo:northbay-clinics/clinic-agent:environment:production-emergency\",\n    84\t          ]\n    85\t        }\n    86\t      }\n    87\t    }]\n    88\t  })\n    89\t}\n    90\t\n    91\tresource \"aws_iam_role_policy\" \"deploy\" {\n    92\t  name = \"clinic-agent-deploy\"\n    93\t  role = aws_iam_role.deploy.id\n    94\t  policy = jsonencode({\n    95\t    Version = \"2012-10-17\"\n    96\t    Statement = [\n    97\t      {\n    98\t        Effect   = \"Allow\"\n    99\t        Action   = [\"ecr:GetAuthorizationToken\"]\n   100\t        Resource = \"*\"\n   101\t      },\n   102\t      {\n   103\t        Effect   = \"Allow\"\n   104\t        Action   = [\"ecr:BatchCheckLayerAvailability\", \"ecr:PutImage\", \"ecr:InitiateLayerUpload\", \"ecr:UploadLayerPart\", \"ecr:CompleteLayerUpload\", \"ecr:BatchGetImage\"]\n   105\t        Resource = aws_ecr_repository.agent.arn\n   106\t      },\n   107\t      {\n   108\t        Effect   = \"Allow\"\n   109\t        Action   = [\"eks:DescribeCluster\"]\n   110\t        Resource = module.eks.cluster_arn\n   111\t      },\n   112\t    ]\n   113\t  })\n   114\t}\n=== infra/terraform/iam.tf\n     1\t# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:\n     2\t# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.\n     3\tresource \"aws_iam_role\" \"runtime\" {\n     4\t  name                 = \"clinic-agent-runtime\"\n     5\t  max_session_duration = 3600\n     6\t  assume_role_policy = jsonencode({\n     7\t    Version = \"2012-10-17\"\n     8\t    Statement = [{\n     9\t      Effect    = \"Allow\"\n    10\t      Principal = { Federated = module.eks.oidc_provider_arn }\n    11\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n    12\t      Condition = {\n    13\t        StringEquals = {\n    14\t          \"${module.eks.oidc_provider}:sub\" = [\n    15\t            \"system:serviceaccount:clinic-agent:clinic-agent\",\n    16\t            \"system:serviceaccount:clinic-agent:clinic-agent-reminders\",\n    17\t          ]\n    18\t          \"${module.eks.oidc_provider}:aud\" = \"sts.amazonaws.com\"\n    19\t        }\n    20\t      }\n    21\t    }]\n    22\t  })\n    23\t}\n    24\t\n    25\tresource \"aws_iam_role_policy\" \"runtime\" {\n    26\t  name = \"clinic-agent-runtime\"\n    27\t  role = aws_iam_role.runtime.id\n    28\t  policy = jsonencode({\n    29\t    Version = \"2012-10-17\"\n    30\t    Statement = [\n    31\t      {\n    32\t        Sid      = \"ReadClinicSecrets\"\n    33\t        Effect   = \"Allow\"\n    34\t        Action   = [\"secretsmanager:GetSecretValue\"]\n    35\t        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\n    36\t      },\n    37\t      {\n    38\t        Sid    = \"AgentState\"\n    39\t        Effect = \"Allow\"\n    40\t        Action = [\n    41\t          \"dynamodb:GetItem\",\n    42\t          \"dynamodb:BatchGetItem\",\n    43\t          \"dynamodb:PutItem\",\n    44\t          \"dynamodb:UpdateItem\",\n    45\t          \"dynamodb:Query\",\n    46\t        ]\n    47\t        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*\"\n    48\t      },\n    49\t      {\n    50\t        Sid      = \"Audit\"\n    51\t        Effect   = \"Allow\"\n    52\t        Action   = [\"firehose:PutRecord\", \"firehose:PutRecordBatch\"]\n    53\t        Resource = aws_kinesis_firehose_delivery_stream.audit.arn\n    54\t      },\n    55\t    ]\n    56\t  })\n    57\t}\n    58\t\n    59\t# Operators who may stop the agent. Assumable only through SSO by the on-call group.\n    60\tresource \"aws_iam_role\" \"ops_killswitch\" {\n    61\t  name = \"clinic-agent-ops\"\n    62\t  assume_role_policy = jsonencode({\n    63\t    Version = \"2012-10-17\"\n    64\t    Statement = [{\n    65\t      Effect    = \"Allow\"\n    66\t      Principal = { AWS = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\" }\n    67\t      Action    = \"sts:AssumeRole\"\n    68\t      Condition = {\n    69\t        StringLike = { \"aws:PrincipalArn\" = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*\" }\n    70\t      }\n    71\t    }]\n    72\t  })\n    73\t}\n    74\t\n    75\tresource \"aws_iam_role_policy\" \"ops_killswitch\" {\n    76\t  name = \"clinic-agent-ops\"\n    77\t  role = aws_iam_role.ops_killswitch.id\n    78\t  policy = jsonencode({\n    79\t    Version = \"2012-10-17\"\n    80\t    Statement = [{\n    81\t      Effect   = \"Allow\"\n    82\t      Action   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:GetItem\"]\n    83\t      Resource = aws_dynamodb_table.control.arn\n    84\t    }]\n    85\t  })\n    86\t}\n    87\t\n    88\tresource \"aws_iam_role\" \"firehose\" {\n    89\t  name = \"clinic-agent-audit-firehose\"\n    90\t  assume_role_policy = jsonencode({\n    91\t    Version   = \"2012-10-17\"\n    92\t    Statement = [{ Effect = \"Allow\", Principal = { Service = \"firehose.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n    93\t  })\n    94\t}\n    95\t\n    96\tresource \"aws_iam_role_policy\" \"firehose\" {\n    97\t  name = \"write-audit-bucket\"\n    98\t  role = aws_iam_role.firehose.id\n    99\t  policy = jsonencode({\n   100\t    Version = \"2012-10-17\"\n   101\t    Statement = [{\n   102\t      Effect   = \"Allow\"\n   103\t      Action   = [\"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:GetBucketLocation\"]\n   104\t      Resource = [aws_s3_bucket.audit.arn, \"${aws_s3_bucket.audit.arn}/*\"]\n   105\t    }]\n   106\t  })\n   107\t}\n=== infra/terraform/main.tf\n     1\tterraform {\n     2\t  required_version = \">= 1.9.0\"\n     3\t  required_providers {\n     4\t    aws    = { source = \"hashicorp/aws\", version = \"~> 6.14\" }\n     5\t    github = { source = \"integrations/github\", version = \"~> 6.6\" }\n     6\t  }\n     7\t  backend \"s3\" {\n     8\t    bucket         = \"northbay-tfstate-418295730611\"\n     9\t    key            = \"clinic-agent/prod.tfstate\"\n    10\t    region         = \"us-west-2\"\n    11\t    dynamodb_table = \"northbay-tf-locks\"\n    12\t    encrypt        = true\n    13\t  }\n    14\t}\n    15\t\n    16\tprovider \"aws\" {\n    17\t  region = var.region\n    18\t  default_tags {\n    19\t    tags = { app = \"clinic-agent\", owner = \"agent-platform\", data = \"phi\" }\n    20\t  }\n    21\t}\n    22\t\n    23\tvariable \"region\" {\n    24\t  type    = string\n    25\t  default = \"us-west-2\"\n    26\t}\n    27\t\n    28\tvariable \"clinic_ids\" {\n    29\t  type    = list(string)\n    30\t  default = [\"nb-castro\", \"nb-fremont\", \"nb-oakland\", \"nb-sanmateo\", \"nb-walnutcreek\"]\n    31\t}\n    32\t\n    33\tdata \"aws_caller_identity\" \"current\" {}\n    34\t\n    35\tmodule \"eks\" {\n    36\t  source  = \"terraform-aws-modules/eks/aws\"\n    37\t  version = \"21.3.1\"\n    38\t\n    39\t  name               = \"clinic-agent-prod\"\n    40\t  kubernetes_version = \"1.33\"\n    41\t  vpc_id             = module.vpc.vpc_id\n    42\t  subnet_ids         = module.vpc.private_subnets\n    43\t\n    44\t  endpoint_public_access = false\n    45\t  enable_irsa            = true\n    46\t\n    47\t  authentication_mode = \"API\"\n    48\t  access_entries = {\n    49\t    deploy = {\n    50\t      principal_arn = aws_iam_role.deploy.arn\n    51\t      policy_associations = {\n    52\t        ns = {\n    53\t          policy_arn   = \"arn:aws:eks::aws:cluster-access-policy/AmazonEKSEditPolicy\"\n    54\t          access_scope = { type = \"namespace\", namespaces = [\"clinic-agent\"] }\n    55\t        }\n    56\t      }\n    57\t    }\n    58\t  }\n    59\t\n    60\t  eks_managed_node_groups = {\n    61\t    agents = {\n    62\t      instance_types = [\"m7g.large\"]\n    63\t      ami_type       = \"BOTTLEROCKET_ARM_64\"\n    64\t      min_size       = 2\n    65\t      max_size       = 6\n    66\t      desired_size   = 3\n    67\t      metadata_options = {\n    68\t        http_tokens                 = \"required\"\n    69\t        http_put_response_hop_limit = 1\n    70\t      }\n    71\t    }\n    72\t  }\n    73\t}\n    74\t\n    75\tmodule \"vpc\" {\n    76\t  source  = \"terraform-aws-modules/vpc/aws\"\n    77\t  version = \"6.4.0\"\n    78\t\n    79\t  name            = \"clinic-agent-prod\"\n    80\t  cidr            = \"10.42.0.0/16\"\n    81\t  azs             = [\"us-west-2a\", \"us-west-2b\", \"us-west-2c\"]\n    82\t  private_subnets = [\"10.42.1.0/24\", \"10.42.2.0/24\", \"10.42.3.0/24\"]\n    83\t  public_subnets  = [\"10.42.101.0/24\", \"10.42.102.0/24\", \"10.42.103.0/24\"]\n    84\t\n    85\t  enable_nat_gateway = true\n    86\t  single_nat_gateway = false\n    87\t}\n    88\t\n    89\tresource \"aws_ecr_repository\" \"agent\" {\n    90\t  name                 = \"clinic-agent\"\n    91\t  image_tag_mutability = \"IMMUTABLE\"\n    92\t  image_scanning_configuration { scan_on_push = true }\n    93\t}\n    94\t\n    95\t# State tables. Approvals are written by the staff console; budgets by the agent; the control\n    96\t# table holds the stop flags operators set.\n    97\tresource \"aws_dynamodb_table\" \"approvals\" {\n    98\t  name         = \"clinic-agent-approvals\"\n    99\t  billing_mode = \"PAY_PER_REQUEST\"\n   100\t  hash_key     = \"id\"\n   101\t  attribute {\n   102\t    name = \"id\"\n   103\t    type = \"S\"\n   104\t  }\n   105\t  point_in_time_recovery { enabled = true }\n   106\t}\n   107\t\n   108\tresource \"aws_dynamodb_table\" \"budgets\" {\n   109\t  name         = \"clinic-agent-budgets\"\n   110\t  billing_mode = \"PAY_PER_REQUEST\"\n   111\t  hash_key     = \"pk\"\n   112\t  attribute {\n   113\t    name = \"pk\"\n   114\t    type = \"S\"\n   115\t  }\n   116\t  ttl {\n   117\t    attribute_name = \"expiresAt\"\n   118\t    enabled        = true\n   119\t  }\n   120\t}\n   121\t\n   122\tresource \"aws_dynamodb_table\" \"control\" {\n   123\t  name         = \"clinic-agent-control\"\n   124\t  billing_mode = \"PAY_PER_REQUEST\"\n   125\t  hash_key     = \"pk\"\n   126\t  attribute {\n   127\t    name = \"pk\"\n   128\t    type = \"S\"\n   129\t  }\n   130\t  point_in_time_recovery { enabled = true }\n   131\t}\n   132\t\n   133\t# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).\n   134\tresource \"aws_s3_bucket\" \"audit\" {\n   135\t  bucket              = \"clinic-agent-audit-${data.aws_caller_identity.current.account_id}\"\n   136\t  object_lock_enabled = true\n   137\t}\n   138\t\n   139\tresource \"aws_s3_bucket_object_lock_configuration\" \"audit\" {\n   140\t  bucket = aws_s3_bucket.audit.id\n   141\t  rule {\n   142\t    default_retention {\n   143\t      mode  = \"COMPLIANCE\"\n   144\t      years = 7\n   145\t    }\n   146\t  }\n   147\t}\n   148\t\n   149\tresource \"aws_kinesis_firehose_delivery_stream\" \"audit\" {\n   150\t  name        = \"clinic-agent-audit\"\n   151\t  destination = \"extended_s3\"\n   152\t  extended_s3_configuration {\n   153\t    role_arn            = aws_iam_role.firehose.arn\n   154\t    bucket_arn          = aws_s3_bucket.audit.arn\n   155\t    prefix              = \"audit/dt=!{timestamp:yyyy-MM-dd}/\"\n   156\t    error_output_prefix = \"audit-errors/!{firehose:error-output-type}/\"\n   157\t    buffering_interval  = 60\n   158\t  }\n   159\t}\n   160\t\n   161\tresource \"aws_secretsmanager_secret\" \"ehr\" {\n   162\t  for_each = toset(concat(var.clinic_ids, [\"_catalog\"]))\n   163\t  name     = \"clinic-agent/ehr/${each.key}\"\n   164\t}\n   165\t\n   166\tresource \"aws_secretsmanager_secret\" \"payments\" {\n   167\t  for_each = toset(var.clinic_ids)\n   168\t  name     = \"clinic-agent/payments/${each.key}\"\n   169\t}\n   170\t\n   171\tresource \"aws_secretsmanager_secret\" \"sms\" {\n   172\t  for_each = toset(var.clinic_ids)\n   173\t  name     = \"clinic-agent/sms/${each.key}\"\n   174\t}\n   175\t\n   176\tresource \"aws_secretsmanager_secret\" \"sms_signing\" {\n   177\t  name = \"clinic-agent/sms-signing\"\n   178\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
