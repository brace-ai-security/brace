.boolean(),\n48\t    })\n49\t    .optional(),\n50\t  detail: z.record(z.unknown()).optional(),\n51\t});\n52\texport type AuditEvent = z.infer<typeof AuditEvent>;\n53\t\n54\tconst firehose = new FirehoseClient({ region: env.region });\n55\t\n56\texport class AuditUnavailable extends Error {}\n57\t\n58\texport const audit = {\n59\t  async record(e: Omit<AuditEvent, \"eventId\" | \"ts\">): Promise<void> {\n60\t    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });\n61\t    try {\n62\t      await firehose.send(\n63\t        new PutRecordCommand({\n64\t          DeliveryStreamName: env.auditStream,\n65\t          Record: { Data: Buffer.from(JSON.stringify(full) + \"\\n\") },\n66\t        }),\n67\t      );\n68\t    } catch (err) {\n69\t      // Callers treat this as a hard failure: an action that cannot be audited does not run.\n70\t      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);\n71\t    }\n72\t  },\n73\t};\n74\t\n75\t// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.\n76\tconst DROP_KEYS = new Set([\"ssn\", \"dateOfBirth\", \"dob\", \"memberId\", \"subscriberId\", \"cardNumber\", \"cardLast4\", \"address\"]);\n77\tconst PATTERNS: Array<[RegExp, string]> = [\n78\t  [/\\b\\d{3}-\\d{2}-\\d{4}\\b/g, \"[ssn]\"],\n79\t  [/\\b(?:\\d[ -]?){13,19}\\b/g, \"[card]\"],\n80\t  [/\\b[A-Z]{3}\\d{9}\\b/g, \"[member-id]\"],\n81\t];\n82\t\n83\texport function redactPhi(value: unknown): unknown {\n84\t  if (typeof value === \"string\") {\n85\t    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);\n86\t  }\n87\t  if (Array.isArray(value)) return value.map(redactPhi);\n88\t  if (value && typeof value === \"object\") {\n89\t    const out: Record<string, unknown> = {};\n90\t    for (const [k, v] of Object.entries(value)) {\n91\t      if (DROP_KEYS.has(k)) continue;\n92\t      out[k] = redactPhi(v);\n93\t    }\n94\t    return out;\n95\t  }\n96\t  return value;\n97\t}\n98\t"}]},"parent_tool_use_id":null,"session_id":"29563294-217c-407e-8b87-42521726a071","uuid":"c599efa7-8364-4bf4-b245-a7fc7ba77085","timestamp":"2026-10-02T16:08:10.120Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-repeat-80qi2mwl/agent/src/audit/recorder.ts","content":"import { FirehoseClient, PutRecordCommand } from \"@aws-sdk/client-firehose\";\nimport { randomUUID } from \"node:crypto\";\nimport { z } from \"zod\";\nimport { env } from \"../config.js\";\n\n// Every audit record carries the six identity fields. Values come from RunContext, which is built\n// by the HTTP layer and the worker, never from model output.\nexport const IdentityFields = z.object({\n  accountableParty: z.string().min(1),\n  operationalOwner: z.string().min(1),\n  tenantId: z.string().min(1),\n  agentTypeId: z.string().startsWith(\"sha256:\"),\n  agentInstanceId: z.string().uuid(),\n  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),\n});\n\nexport const AuditEvent = IdentityFields.extend({\n  eventId: z.string().uuid(),\n  ts: z.string().datetime(),\n  runId: z.string().uuid(),\n  event: z.enum([\n    \"run.started\",\n    \"run.stopped\",\n    \"run.completed\",\n    \"intent.classified\",\n    \"model.decision\",\n    \"tool.denied\",\n    \"tool.approval_requested\",\n    \"tool.executed\",\n    \"tool.failed\",\n    \"payment.refund\",\n    \"peer.call\",\n    \"reminder.sent\",\n  ]),\n  subject: z.object({ kind: z.enum([\"patient\", \"staff\", \"system\"]), id: z.string() }),\n  tool: z.string().optional(),\n  toolUseId: z.string().optional(),\n  policyVersion: z.string().optional(),\n  approvalId: z.string().optional(),\n  reason: z.string().optional(),\n  context: z\n    .object({\n      tokens: z.number().int().nonnegative().nullable(),\n      status: z.enum([\"measured\", \"estimated\", \"unavailable\"]),\n      method: z.string(),\n      cachedInputTokens: z.number(