001, 1), MODEL), \"input_tokens\");\n    79\t    await expectLimit(new RunBudget(small(), new MemoryQuotaStore(), scope).recordUsage(usage(1, 1_001), MODEL), \"output_tokens\");\n    80\t    await expectLimit(\n    81\t      new RunBudget(small({ maxCostUsd: 0.01, maxInputTokens: 1e9 }), new MemoryQuotaStore(), scope).recordUsage(usage(5_000, 0), MODEL),\n    82\t      \"run_cost\",\n    83\t    );\n    84\t  });\n    85\t\n    86\t  it(\"counts cached input toward the token limit\", async () => {\n    87\t    const b = new RunBudget(small(), new MemoryQuotaStore(), scope);\n    88\t    await expectLimit(b.recordUsage({ input_tokens: 10, output_tokens: 1, cache_read_input_tokens: 10_000 }, MODEL), \"input_tokens\");\n    89\t  });\n    90\t\n    91\t  it(\"stops on total tool calls, tool-call rate, and peer calls\", async () => {\n    92\t    const b1 = new RunBudget(small({ maxToolCallsPerMinute: 100 }), new MemoryQuotaStore(), scope);\n    93\t    for (let i = 0; i < 5; i++) await b1.toolCall(\"ehr__search_slots\");\n    94\t    await expectLimit(b1.toolCall(\"ehr__search_slots\"), \"tool_calls\");\n    95\t\n    96\t    const b2 = new RunBudget(small({ maxToolCalls: 100 }), new MemoryQuotaStore(), scope);\n    97\t    for (let i = 0; i < 4; i++) await b2.toolCall(\"ehr__search_slots\");\n    98\t    await expectLimit(b2.toolCall(\"ehr__search_slots\"), \"tool_call_rate\");\n    99\t\n   100\t    const b3 = new RunBudget(small(), new MemoryQuotaStore(), scope);\n   101\t    await b3.toolCall(\"insurance__check_eligibility\");\n   102\t    await expectLimit(b3.toolCall(\"insurance__check_eligibility\"), \"peer_calls\");\n   103\t  });\n   104\t\n   105\t  it(\"enforces per-subject, per-tenant, and fleet spend across many small runs\", async () => {\n   106\t    const store = new MemoryQuotaStore();\n   107\t    const cfg = small({}, { perSubjectDailyUsd: 0.05 });\n   108\t    // Each run spends about $0.03, well under its own run_cost limit.\n   109\t    await new RunBudget(cfg, store, scope).recordUsage(usage(5_000, 1_000), MODEL);\n   110\t    await expectLimit(new RunBudget(cfg, store, scope).recordUsage(usage(5_000, 1_000), MODEL), \"subject_daily_cost\");\n   111\t\n   112\t    const tStore = new MemoryQuotaStore();\n   113\t    const tCfg = small({}, { perTenantDailyUsd: 0.05 });\n   114\t    await new RunBudget(tCfg, tStore, { ...scope, subjectId: \"a\" }).recordUsage(usage(5_000, 1_000), MODEL);\n   115\t    await expectLimit(new RunBudget(tCfg, tStore, { ...scope, subjectId: \"b\" }).recordUsage(usage(5_000, 1_000), MODEL), \"tenant_daily_cost\");\n   116\t\n   117\t    const fStore = new MemoryQuotaStore();\n   118\t    const fCfg = small({}, { fleetDailyUsd: 0.05 });\n   119\t    await new RunBudget(fCfg, fStore, { tenantId: \"nb-castro\", subjectId: \"a\" }).recordUsage(usage(5_000, 1_000), MODEL);\n   120\t    await expectLimit(\n   121\t      new RunBudget(fCfg, fStore, { tenantId: \"nb-oakland\", subjectId: \"b\" }).recordUsage(usage(5_000, 1_000), MODEL),\n   122\t      \"fleet_daily_cost\",\n   123\t    );\n   124\t  });\n   125\t\n   126\t  it(\"enforces per-tenant and fleet tool-call rates across runs\", async () => {\n   127\t    const store = new MemoryQuotaStore();\n   128\t    const cfg = small({}, { perTenantToolCallsPerMinute: 3 });\n   129\t    for (let i = 0; i < 3; i++) await new RunBudget(cfg, store, scope).toolCall(\"ehr__search_slots\");\n   130\t    await expectLimit(new RunBudget(cfg, store, scope).toolCall(\"ehr__search_slots\"), \"tenant_tool_rate\");\n   131\t\n   132\t    const fStore = new MemoryQuotaStore();\n   133\t    const fCfg = small({}, { fleetToolCallsPerMinute: 2 });\n   134\t    await new RunBudget(fCfg, fStore, { tenantId: \"nb-castro\", subjectId: \"a\" }).toolCall(\"ehr__search_slots\");\n   135\t    await new RunBudget(fCfg, fStore, { tenantId: \"nb-fremont\", subjectId: \"b\" }).toolCall(\"ehr__search_slots\");\n   136\t    await expectLimit(new RunBudget(fCfg, fStore, { t