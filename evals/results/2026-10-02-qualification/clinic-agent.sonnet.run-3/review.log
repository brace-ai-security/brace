{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TKmoZau4ENevkhyenFdUju","type":"tool_result","content":"1\timport type { FastifyInstance, FastifyRequest } from \"fastify\";\n2\timport { createHmac, timingSafeEqual } from \"node:crypto\";\n3\timport { z } from \"zod\";\n4\timport { runAgent } from \"../agent/loop.js\";\n5\timport { newRunContext } from \"../agent/identity.js\";\n6\timport { sms } from \"../integrations/sms.js\";\n7\timport type { ToolRegistry } from \"../tools/registry.js\";\n8\t\n9\t// Inbound SMS from the provider. The provider signs \"<timestamp>.<raw body>\" with HMAC-SHA256\n10\t// using the per-account signing secret and sends it as x-sms-signature: t=<ts>,v1=<hex>.\n11\t\n12\tconst Inbound = z\n13\t  .object({\n14\t    messageId: z.string().max(64),\n15\t    from: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n16\t    to: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n17\t    body: z.string().max(1600),\n18\t    receivedAt: z.string().datetime(),\n19\t  })\n20\t  .strict();\n21\t\n22\tconst MAX_SKEW_S = 300;\n23\t\n24\texport class SignatureError extends Error {}\n25\t\n26\texport function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {\n27\t  if (!header) throw new SignatureError(\"missing signature\");\n28\t  const parts = Object.fromEntries(header.split(\",\").map((p) => p.split(\"=\", 2) as [string, string]));\n29\t  const ts = Number(parts.t);\n30\t  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError(\"stale or missing timestamp\");\n31\t  const expected = createHmac(\"sha256\", secret).update(`${parts.t}.${rawBody}`).digest();\n32\t  const got = Buffer.from(parts.v1 ?? \"\", \"hex\");\n33\t  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError(\"bad signature\");\n34\t}\n35\t\n36\texport function registerSmsWebhook(\n37\t  app: FastifyInstance,\n38\t  deps: {\n39\t    registry: ToolRegistry;\n40\t    signingSecret: () => Promise<string>;\n41\t    clinicByNumber: (to: string) => { id: string; name: string } | undefined;\n42\t    metrics: { increment(name: string): void };\n43\t  },\n44\t): void {\n45\t  app.post(\n46\t    \"/v1/sms/inbound\",\n47\t    { config: { rawBody: true }, bodyLimit: 8192 },\n48\t    async (req: FastifyRequest & { rawBody?: string }, reply) => {\n49\t      try {\n50\t        verifySignature(req.rawBody ?? \"\", req.headers[\"x-sms-signature\"] as string | undefined, await deps.signingSecret());\n51\t      } catch (err) {\n52\t        req.log.warn({ err: (err as Error).message }, \"sms webhook signature check failed\");\n53\t        deps.metrics.increment(\"sms.signature_failed\");\n54\t      }\n55\t\n56\t      const parsed = Inbound.safeParse(req.body);\n57\t      if (!parsed.success) return reply.code(400).send({ error: \"invalid payload\" });\n58\t      const msg = parsed.data;\n59\t\n60\t      const clinic = deps.clinicByNumber(msg.to);\n61\t      if (!clinic) return reply.code(404).send({ error: \"unknown number\" });\n62\t\n63\t      const ctx = newRunContext({\n64\t        tenantId: clinic.id,\n65\t        subject: { kind: \"patient\", id: `phone:${msg.from}` },\n66\t        channel: \"sms\",\n67\t        log: req.log,\n68\t      });\n69\t\n70\t      // Respond to the provider right away; the reply goes out as a new outbound message.\n71\t      void reply.code(202).send({ accepted: true });\n72\t      const out = await runAgent(deps.registry, ctx, clinic, msg.body);\n73\t      await sms.send(clinic.id, msg.from, out.text);\n74\t    },\n75\t  );\n76\t}\n77\t"}]},"parent_tool_use_id":null,"session_id":"29563294-217c-407e-8b87-42521726a071","uuid":"ab461e81-c033-4b3a-bb66-eda800d1400c","timestamp":"2026-10-02T16:08:20.212Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-repeat-80qi2mwl/agent/src/routes/sms-webhook.ts","content":"import type { FastifyInstance, FastifyRequest } from \"fastify\";\nimport { createHmac, timingSafeEqual } from \"node:crypto\";\nimport { z } from \"zod\";\nimport { runAgent } from \"../agent/loop.js\";\nimport { newRunContext } from \"../agent/identity.js\";\nimport { sms } from \"../integrations/sms.js\";\nimport type { ToolRegistry } from \"../tools/registry.js\";\n\n// Inbound SMS from the provider. The provider signs \"<timestamp>.<raw body>\" with HMAC-SHA256\n// using the per-account signing secret and sends it as x-sms-signature: t=<ts>,v1=<hex>.\n\nconst Inbound = z\n  .object({\n    messageId: z.string().max(64),\n    from: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n    to: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n    body: z.string().max(1600),\n    receivedAt: z.string().datetime(),\n  })\n  .strict();\n\nconst MAX_SKEW_S = 300;\n\nexport class SignatureError extends Error {}\n\nexport function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {\n  if (!header) throw new SignatureError(\"missing signature\");\n  const parts = Object.fromEntries(header.split(\",\").map((p) => p.split(\"=\", 2) as [string, string]));\n  const ts = Number(parts.t);\n  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError(\"stale or missing timestamp\");\n  const expected = createHmac(\"sha256\", secret).update(`${parts.t}.${rawBody}`).digest();\n  const got = Buffer.from(parts.v1 ?? \"\", \"hex\");\n  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError(\"bad signature\");\n}\n\nexport function registerSmsWebhook(\n  app: FastifyInstance,\n  deps: {\n    registry: ToolRegistry;\n    signingSecret: () => Promise<string>;\n    clinicByNumber: (to: string) => { id: string; name: string } | undefined;\n    metrics: { increment(name: string): void };\n  },\n): void {\n  app.post(\n    \"/v1/sms/inbound\",\n    { config: { rawBody: true }, bodyLimit: 8192 },\n    async (req: FastifyRequest & { rawBody?: string }, reply) => {\n      try {\n        verifySignature(req.rawBody ?? \"\", req.headers[\"x-sms-signature\"] as string | undefined, await deps.signingSecret());\n      } catch (err) {\n        req.log.warn({ err: (err as Error).message }, \"sms webhook signature check failed\");\n        deps.metrics.increment(\"sms.signature_failed\");\n      }\n\n      const parsed = Inbound.safeParse(req.body);\n      if (!parsed.success) return reply.code(400).send({ error: \"invalid payload\" });\n      const msg = parsed.data;\n\n      const clinic = deps.clinicByNumber(msg.to);\n      if (!clinic) return reply.code(404).send({ error: \"unknown number\" });\n\n      const ctx = newRunContext({\n        tenantId: clinic.id,\n        subject: { kind: \"patient\", id: `phone:${msg.from}` },\n        channel: \"sms\",\n        log: req.log,\n      });\n\n      // Respond to the provider right away; the reply goes out as a new outbound message.\n      void reply.code(202).send({ accepted: true });\n      const out = await runAgent(deps.registry, ctx, clinic, msg.body);\n      await sms.send(clinic.id, msg.from, out.text);\n    },\n  );\n}\n","numLines":77,"startLine":1,"totalLines":77}}}
