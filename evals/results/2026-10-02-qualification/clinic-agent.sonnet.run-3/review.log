{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F613cYnWTKkwgqL4QpZw9x","type":"tool_result","content":"1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n2\timport { DynamoDBDocumentClient, UpdateCommand } from \"@aws-sdk/lib-dynamodb\";\n3\timport type { Budgets } from \"../config.js\";\n4\timport { env } from \"../config.js\";\n5\t\n6\texport type LimitName =\n7\t  | \"turns\"\n8\t  | \"wall_time\"\n9\t  | \"input_tokens\"\n10\t  | \"output_tokens\"\n11\t  | \"run_cost\"\n12\t  | \"tool_calls\"\n13\t  | \"tool_call_rate\"\n14\t  | \"peer_calls\"\n15\t  | \"subject_daily_cost\"\n16\t  | \"tenant_daily_cost\"\n17\t  | \"fleet_daily_cost\"\n18\t  | \"tenant_tool_rate\"\n19\t  | \"fleet_tool_rate\";\n20\t\n21\texport class BudgetExceeded extends Error {\n22\t  constructor(public limit: LimitName, public used: number, public max: number) {\n23\t    super(`budget exceeded: ${limit} (${used} > ${max})`);\n24\t  }\n25\t}\n26\t\n27\t// Shared counters across runs and pods. add() must be atomic and refuse to go past max.\n28\texport interface QuotaStore {\n29\t  add(key: string, amount: number, max: number, ttlSeconds: number): Promise<{ ok: boolean; used: number }>;\n30\t}\n31\t\n32\texport class DynamoQuotaStore implements QuotaStore {\n33\t  private ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n34\t  async add(key: string, amount: number, max: number, ttlSeconds: number) {\n35\t    try {\n36\t      const res = await this.ddb.send(\n37\t        new UpdateCommand({\n38\t          TableName: env.budgetTable,\n39\t          Key: { pk: key },\n40\t          UpdateExpression: \"ADD used :n SET expiresAt = if_not_exists(expiresAt, :exp)\",\n41\t          ConditionExpression: \"attribute_not_exists(used) OR used <= :room\",\n42\t          ExpressionAttributeValues: {\n43\t            \":n\": amount,\n44\t            \":room\": max - amount,\n45\t            \":exp\": Math.floor(Date.now() / 1000) + ttlSeconds,\n46\t          },\n47\t          ReturnValues: \"UPDATED_NEW\",\n48\t        }),\n49\t      );\n50\t      return { ok: true, used: Number(res.Attributes?.used ?? amount) };\n51\t    } catch (err) {\n52\t      if ((err as { name?: string }).name === \"ConditionalCheckFailedException\") return { ok: false, used: max };\n53\t      throw err;\n54\t    }\n55\t  }\n56\t}\n57\t\n58\texport interface Usage {\n59\t  input_tokens: number;\n60\t  output_tokens: number;\n61\t  cache_read_input_tokens?: number | null;\n62\t  cache_creation_input_tokens?: number | null;\n63\t}\n64\t\n65\tconst day = () => new Date().toISOString().slice(0, 10);\n66\tconst minute = () => new Date().toISOString().slice(0, 16);\n67\t\n68\texport class RunBudget {\n69\t  readonly abort = new AbortController();\n70\t  private started = Date.now();\n71\t  private timer: NodeJS.Timeout;\n72\t  private turns = 0;\n73\t  private inTok = 0;\n74\t  private outTok = 0;\n75\t  private cost = 0;\n76\t  private toolCalls = 0;\n77\t  private toolTimes: number[] = [];\n78\t  private peerCalls = 0;\n79\t\n80\t  constructor(\n81\t    private b: Budgets,\n82\t    private store: QuotaStore,\n83\t    private scope: { tenantId: string; subjectId: string },\n84\t    private now: () => number = Date.now,\n85\t  ) {\n86\t    this.started = this.now();\n87\t    this.timer = setTimeout(\n88\t      () => this.abort.abort(new BudgetExceeded(\"wall_time\", this.b.run.maxWallMs, this.b.run.maxWallMs)),\n89\t      this.b.run.maxWallMs,\n90\t    );\n91\t  }\n92\t\n93\t  get signal(): AbortSignal {\n94\t    return this.abort.signal;\n95\t  }\n96\t\n97\t  dispose(): void {\n98\t    clearTimeout(this.timer);\n99\t  }\n100\t\n101\t  private check(limit: LimitName, used: number, max: number): void {\n102\t    if (used > max) {\n103\t      const e = new BudgetExceeded(limit, used, max);\n104\t      this.abort.abort(e);\n105\t      throw e;\n106\t    }\n107\t  }\n108\t\n109\t  private checkWall(): void {\n110\t    this.check(\"wall_time\", this.now() - this.started, this.b.run.maxWallMs);\n111\t  }\n112\t\n113\t  turn(): void {\n114\t    this.checkWall();\n115\t    this.turns += 1;\n116\t    this.check(\"turns\", this.turns, this.b.run.maxTurns);\n117\t  }\n118\t\n119\t  async recordUsage(u: Usage, model: string): Promise<void> {\n120\t    const price = this.b.pricingUsdPerMTok[model];\n121\t    if (!price) throw new Error(`no pricing for model ${model}`);\n122\t    const cacheRead = u.cache_read_input_tokens ?? 0;\n123\t    const cacheWrite = u.cache_creation_input_tokens ?? 0;\n124\t    const callCost =\n125\t      (u.input_tokens * price.input +\n126\t        u.output_tokens * price.output +\n127\t        cacheRead * price.cacheRead +\n128\t        cacheWrite * price.cacheWrite) /\n129\t      1_000_000;\n130\t\n131\t    this.inTok += u.input_tokens + cacheRead + cacheWrite;\n132\t    this.outTok += u.output_tokens;\n133\t    this.cost += callCost;\n134\t    this.check(\"input_tokens\", this.inTok, this.b.run.maxInputTokens);\n135\t    this.check(\"output_tokens\", this.outTok, this.b.run.maxOutputTokens);\n136\t    this.check(\"run_cost\", this.cost, this.b.run.maxCostUsd);\n137\t\n138\t    const q = this.b.quotas;\n139\t    await this.shared(\"subject_daily_cost\", `cost#subject#${this.scope.subjectId}#${day()}`, callCost, q.perSubjectDailyUsd, 86400);\n140\t    await this.shared(\"tenant_daily_cost\", `cost#tenant#${this.scope.tenantId}#${day()}`, callCost, q.perTenantDailyUsd, 86400);\n141\t    await this.shared(\"fleet_daily_cost\", `cost#fleet#${day()}`, callCost, q.fleetDailyUsd, 86400);\n142\t  }\n143\t\n144\t  async toolCall(tool: string): Promise<void> {\n145\t    this.checkWall();\n146\t    this.toolCalls += 1;\n147\t    this.check(\"tool_calls\", this.toolCalls, this.b.run.maxToolCalls);\n148\t\n149\t    const t = this.now();\n150\t    this.toolTimes = this.toolTimes.filter((x) => t - x < 60_000);\n151\t    this.toolTimes.push(t);\n152\t    this.check(\"tool_call_rate\", this.toolTimes.length, this.b.run.maxToolCallsPerMinute);\n153\t\n154\t    if (tool.startsWith(\"insurance__\")) {\n155\t      this.peerCalls += 1;\n156\t      this.check(\"peer_calls\", this.peerCalls, this.b.run.maxPeerCalls);\n157\t    }\n158\t\n159\t    const q = this.b.quotas;\n160\t    await this.shared(\"tenant_tool_rate\", `rate#tenant#${this.scope.tenantId}#${minute()}`, 1, q.perTenantToolCallsPerMinute, 120);\n161\t    await this.shared(\"fleet_tool_rate\", `rate#fleet#${minute()}`, 1, q.fleetToolCallsPerMinute, 120);\n162\t  }\n163\t\n164\t  private async shared(limit: LimitName, key: string, amount: number, max: number, ttl: number): Promise<void> {\n165\t    const r = await this.store.add(key, amount, max, ttl);\n166\t    if (!r.ok) {\n167\t      const e = new BudgetExceeded(limit, r.used + amount, max);\n168\t      this.abort.abort(e);\n169\t      throw e;\n170\t    }\n171\t  }\n172\t}\n173\t"}]},"parent_tool_use_id":null,"session_id":"29563294-217c-407e-8b87-42521726a071","uuid":"484f7093-49a1-40b5-ae96-cc1ec1c8bb03","timestamp":"2026-10-02T16:08:08.416Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-repeat-80qi2mwl/agent/src/agent/budget.ts","content":"import { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\nimport { DynamoDBDocumentClient, UpdateCommand } from \"@aws-sdk/lib-dynamodb\";\nimport type { Budgets } from \"../config.js\";\nimport { env } from \"../config.js\";\n\nexport type LimitName =\n  | \"turns\"\n  | \"wall_time\"\n  | \"input_tokens\"\n  | \"output_tokens\"\n  | \"run_cost\"\n  | \"tool_calls\"\n  | \"tool_call_rate\"\n  | \"peer_calls\"\n  | \"subject_daily_cost\"\n  | \"tenant_daily_cost\"\n  | \"fleet_daily_cost\"\n  | \"tenant_tool_rate\"\n  | \"fleet_tool_rate\";\n\nexport class BudgetExceeded extends Error {\n  constructor(public limit: LimitName, public used: number, public max: number) {\n    super(`budget exceeded: ${limit} (${used} > ${max})`);\n  }\n}\n\n// Shared counters across runs and pods. add() must be atomic and refuse to go past max.\nexport interface QuotaStore {\n  add(key: string, amount: number, max: number, ttlSeconds: number): Promise<{ ok: boolean; used: number }>;\n}\n\nexport class DynamoQuotaStore implements QuotaStore {\n  private ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n  async add(key: string, amount: number, max: number, ttlSeconds: number) {\n    try {\n      const res = await this.ddb.send(\n        new UpdateCommand({\n          TableName: env.budgetTable,\n          Key: { pk: key },\n          UpdateExpression: \"ADD used :n SET expiresAt = if_not_exists(expiresAt, :exp)\",\n          ConditionExpression: \"attribute_not_exists(used) OR used <= :room\",\n          ExpressionAttributeValues: {\n            \":n\": amount,\n            \":room\": max - amount,\n            \":exp\": Math.floor(Date.now() / 1000) + ttlSeconds,\n          },\n          ReturnValues: \"UPDATED_NEW\",\n        }),\n      );\n      return { ok: true, used: Number(res.Attributes?.used ?? amount) };\n    } catch (err) {\n      if ((err as { name?: string }).name === \"ConditionalCheckFailedException\") return { ok: false, used: max };\n      throw err;\n    }\n  }\n}\n\nexport interface Usage {\n  input_tokens: number;\n  output_tokens: number;\n  cache_read_input_tokens?: number | null;\n  cache_creation_input_tokens?: number | null;\n}\n\nconst day = () => new Date().toISOString().slice(0, 10);\nconst minute = () => new Date().toISOString().slice(0, 16);\n\nexport class RunBudget {\n  readonly abort = new AbortController();\n  private started = Date.now();\n  private timer: NodeJS.Timeout;\n  private turns = 0;\n  private inTok = 0;\n  private outTok = 0;\n  private cost = 0;\n  private toolCalls = 0;\n  private toolTimes: number[] = [];\n  private peerCalls = 0;\n\n  constructor(\n    private b: Budgets,\n    private store: QuotaStore,\n    private scope: { tenantId: string; subjectId: string },\n    private now: () => number = Date.now,\n  ) {\n    this.started = this.now();\n    this.timer = setTimeout(\n      () => this.abort.abort(new BudgetExceeded(\"wall_time\", this.b.run.maxWallMs, this.b.run.maxWallMs)),\n      this.b.run.maxWallMs,\n    );\n  }\n\n  get signal(): AbortSignal {\n    return this.abort.signal;\n  }\n\n  dispose(): void {\n    clearTimeout(this.timer);\n  }\n\n  private check(limit: LimitName, used: number, max: number): void {\n    if (used > max) {\n      const e = new BudgetExceeded(limit, used, max);\n      this.abort.abort(e);\n      throw e;\n    }\n  }\n\n  private checkWall(): void {\n    this.check(\"wall_time\", this.now() - this.started, this.b.run.maxWallMs);\n  }\n\n  turn(): void {\n    this.checkWall();\n    this.turns += 1;\n    this.check(\"turns\", this.turns, this.b.run.maxTurns);\n  }\n\n  async recordUsage(u: Usage, model: string): Promise<void> {\n    const price = this.b.pricingUsdPerMTok[model];\n    if (!price) throw new Error(`no pricing for model ${model}`);\n    const cacheRead = u.cache_read_input_tokens ?? 0;\n    const cacheWrite = u.cache_creation_input_tokens ?? 0;\n    const callCost =\n      (u.input_tokens * price.input +\n        u.output_tokens * price.output +\n        cacheRead * price.cacheRead +\n        cacheWrite * price.cacheWrite) /\n      1_000_000;\n\n    this.inTok += u.input_tokens + cacheRead + cacheWrite;\n    this.outTok += u.output_tokens;\n    this.cost += callCost;\n    this.check(\"input_tokens\", this.inTok, this.b.run.maxInputTokens);\n    this.check(\"output_tokens\", this.outTok, this.b.run.maxOutputTokens);\n    this.check(\"run_cost\", this.cost, this.b.run.maxCostUsd);\n\n    const q = this.b.quotas;\n    await this.shared(\"subject_daily_cost\", `cost#subject#${this.scope.subjectId}#${day()}`, callCost, q.perSubjectDailyUsd, 86400);\n    await this.shared(\"tenant_daily_cost\", `cost#tenant#${this.scope.tenantId}#${day()}`, callCost, q.perTenantDailyUsd, 86400);\n    await this.shared(\"fleet_daily_cost\", `cost#fleet#${day()}`, callCost, q.fleetDailyUsd, 86400);\n  }\n\n  async toolCall(tool: string): Promise<void> {\n    this.checkWall();\n    this.toolCalls += 1;\n    this.check(\"tool_calls\", this.toolCalls, this.b.run.maxToolCalls);\n\n    const t = this.now();\n    this.toolTimes = this.toolTimes.filter((x) => t - x < 60_000);\n    this.toolTimes.push(t);\n    this.check(\"tool_call_rate\", this.toolTimes.length, this.b.run.maxToolCallsPerMinute);\n\n    if (tool.startsWith(\"insurance__\")) {\n      this.peerCalls += 1;\n      this.check(\"peer_calls\", this.peerCalls, this.b.run.maxPeerCalls);\n    }\n\n    const q = this.b.quotas;\n    await this.shared(\"tenant_tool_rate\", `rate#tenant#${this.scope.tenantId}#${minute()}`, 1, q.perTenantToolCallsPerMinute, 120);\n    await this.shared(\"fleet_tool_rate\", `rate#fleet#${minute()}`, 1, q.fleetToolCallsPerMinute, 120);\n  }\n\n  private async shared(limit: LimitName, key: string, amount: number, max: number, ttl: number): Promise<void> {\n    const r = await this.store.add(key, amount, max, ttl);\n    if (!r.ok) {\n      const e = new BudgetExceeded(limit, r.used + amount, max);\n      this.abort.abort(e);\n      throw e;\n    }\n  }\n}\n","numLines":173,"startLine":1,"totalLines":173}}}
