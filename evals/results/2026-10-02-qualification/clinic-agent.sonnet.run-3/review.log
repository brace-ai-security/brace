{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XBMxQYsSr7XuipzPGWhJgY","type":"tool_result","content":"1\timport type Anthropic from \"@anthropic-ai/sdk\";\n2\t\n3\t// Context size at decision time, in tokens.\n4\t//\n5\t// Counting method. Each model decision is one Messages API call. Its response usage reports the\n6\t// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and\n7\t// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,\n8\t// including the part served from the prompt cache and the provider's own tool-use preamble, which\n9\t// the provider counts but does not show. This is a per-call value, not a run or billing total.\n10\t// We record it as \"measured\", with the cached share kept separately.\n11\t//\n12\t// If the response carries no usage (stream cut off, aborted call), we fall back to the\n13\t// count_tokens estimate taken just before the call for the same request, and mark it \"estimated\".\n14\t// If neither exists the value is null with status \"unavailable\". It is never reported as 0.\n15\t//\n16\t// This harness never compacts, summarizes, or truncates history inside a run, so compacted is\n17\t// always false; a run that would outgrow its token budget stops instead (see budget.ts).\n18\texport interface ContextSize {\n19\t  tokens: number | null;\n20\t  status: \"measured\" | \"estimated\" | \"unavailable\";\n21\t  method: string;\n22\t  cachedInputTokens: number | null;\n23\t  compacted: boolean;\n24\t}\n25\t\n26\texport const USAGE_METHOD = \"anthropic.messages.usage(input+cache_read+cache_creation)\";\n27\texport const COUNT_METHOD = \"anthropic.messages.count_tokens(pre-call estimate)\";\n28\t\n29\texport async function measureBeforeCall(\n30\t  client: Anthropic,\n31\t  req: Anthropic.MessageCountTokensParams,\n32\t  signal: AbortSignal,\n33\t): Promise<ContextSize> {\n34\t  try {\n35\t    const r = await client.messages.countTokens(req, { signal });\n36\t    return { tokens: r.input_tokens, status: \"estimated\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n37\t  } catch {\n38\t    return { tokens: null, status: \"unavailable\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n39\t  }\n40\t}\n41\t\n42\texport function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {\n43\t  if (!usage) return pre;\n44\t  const cacheRead = usage.cache_read_input_tokens ?? 0;\n45\t  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);\n46\t  return { tokens: total, status: \"measured\", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };\n47\t}\n48\t\n49\t// Span attributes so the value is searchable next to the action in traces as well as audit.\n50\texport function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {\n51\t  return {\n52\t    ...(c.tokens === null ? {} : { \"clinic_agent.context.tokens\": c.tokens }),\n53\t    \"clinic_agent.context.status\": c.status,\n54\t    \"clinic_agent.context.method\": c.method,\n55\t    \"gen_ai.conversation.compacted\": c.compacted,\n56\t  };\n57\t}\n58\t"}]},"parent_tool_use_id":null,"session_id":"29563294-217c-407e-8b87-42521726a071","uuid":"bc57451f-6f27-4bb9-ae74-cd743cb09f6b","timestamp":"2026-10-02T16:08:09.552Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-repeat-80qi2mwl/agent/src/agent/context-size.ts","content":"import type Anthropic from \"@anthropic-ai/sdk\";\n\n// Context size at decision time, in tokens.\n//\n// Counting method. Each model decision is one Messages API call. Its response usage reports the\n// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and\n// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,\n// including the part served from the prompt cache and the provider's own tool-use preamble, which\n// the provider counts but does not show. This is a per-call value, not a run or billing total.\n// We record it as \"measured\", with the cached share kept separately.\n//\n// If the response carries no usage (stream cut off, aborted call), we fall back to the\n// count_tokens estimate taken just before the call for the same request, and mark it \"estimated\".\n// If neither exists the value is null with status \"unavailable\". It is never reported as 0.\n//\n// This harness never compacts, summarizes, or truncates history inside a run, so compacted is\n// always false; a run that would outgrow its token budget stops instead (see budget.ts).\nexport interface ContextSize {\n  tokens: number | null;\n  status: \"measured\" | \"estimated\" | \"unavailable\";\n  method: string;\n  cachedInputTokens: number | null;\n  compacted: boolean;\n}\n\nexport const USAGE_METHOD = \"anthropic.messages.usage(input+cache_read+cache_creation)\";\nexport const COUNT_METHOD = \"anthropic.messages.count_tokens(pre-call estimate)\";\n\nexport async function measureBeforeCall(\n  client: Anthropic,\n  req: Anthropic.MessageCountTokensParams,\n  signal: AbortSignal,\n): Promise<ContextSize> {\n  try {\n    const r = await client.messages.countTokens(req, { signal });\n    return { tokens: r.input_tokens, status: \"estimated\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n  } catch {\n    return { tokens: null, status: \"unavailable\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n  }\n}\n\nexport function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {\n  if (!usage) return pre;\n  const cacheRead = usage.cache_read_input_tokens ?? 0;\n  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);\n  return { tokens: total, status: \"measured\", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };\n}\n\n// Span attributes so the value is searchable next to the action in traces as well as audit.\nexport function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {\n  return {\n    ...(c.tokens === null ? {} : { \"clinic_agent.context.tokens\": c.tokens }),\n    \"clinic_agent.context.status\": c.status,\n    \"clinic_agent.context.method\": c.method,\n    \"gen_ai.conversation.compacted\": c.compacted,\n  };\n}\n","numLines":58,"startLine":1,"totalLines":58}}}
