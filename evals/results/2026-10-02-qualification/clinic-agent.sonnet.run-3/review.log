 }\n45\t  return `sha256:${h.digest(\"hex\")}`;\n46\t}\n47\t\n48\t// One instance id per process. Pods are the unit an operator contains.\n49\texport const AGENT_INSTANCE_ID = randomUUID();\n50\t\n51\tlet AGENT_TYPE_ID = \"\";\n52\texport function setAgentTypeId(id: string): void {\n53\t  AGENT_TYPE_ID = id;\n54\t}\n55\t\n56\texport interface Subject {\n57\t  kind: \"patient\" | \"staff\" | \"system\";\n58\t  id: string;\n59\t}\n60\t\n61\texport interface Logger {\n62\t  info(obj: object, msg?: string): void;\n63\t  warn(obj: object, msg?: string): void;\n64\t  error(obj: object, msg?: string): void;\n65\t}\n66\t\n67\texport interface RunContext {\n68\t  runId: string;\n69\t  tenantId: string;\n70\t  subject: Subject;\n71\t  channel: \"sms\" | \"webchat\" | \"reminder\";\n72\t  traceparent: string;\n73\t  log: Logger;\n74\t  identity(): {\n75\t    accountableParty: string;\n76\t    operationalOwner: string;\n77\t    tenantId: string;\n78\t    agentTypeId: string;\n79\t    agentInstanceId: string;\n80\t    traceparent: string;\n81\t  };\n82\t  workloadToken(): Promise<string>;\n83\t}\n84\t\n85\t// Projected service-account token (audience: the group STS), rotated by the kubelet.\n86\tconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n87\t\n88\texport function newRunContext(init: {\n89\t  tenantId: string;\n90\t  subject: Subject;\n91\t  channel: RunContext[\"channel\"];\n92\t  traceparent?: string;\n93\t  log: Logger;\n94\t}): RunContext {\n95\t  const runId = randomUUID();\n96\t  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n97\t  return {\n98\t    runId,\n99\t    tenantId: init.tenantId,\n100\t    subject: init.subject,\n101\t    channel: init.channel,\n102\t    traceparent,\n103\t    log: init.log,\n104\t    identity: () => ({\n105\t      accountableParty: env.accountableParty,\n106\t      operationalOwner: env.operationalOwner,\n107\t      tenantId: init.tenantId,\n108\t      agentTypeId: AGENT_TYPE_ID,\n109\t      agentInstanceId: AGENT_INSTANCE_ID,\n110\t      traceparent,\n111\t    }),\n112\t    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n113\t  };\n114\t}\n115\t"}]},"parent_tool_use_id":null,"session_id":"29563294-217c-407e-8b87-42521726a071","uuid":"40d329b4-6641-4f84-9e6d-4a9beb211902","timestamp":"2026-10-02T16:08:07.875Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-repeat-80qi2mwl/agent/src/agent/identity.ts","content":"import { createHash, randomUUID } from \"node:crypto\";\nimport { readdirSync, readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n\n// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\nconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n\nexport interface TypeIdInputs {\n  imageDigest: string;\n  harnessVersion: string;\n  harnessGitSha: string;\n}\n\nexport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n  const parts: Array<[string, Buffer]> = [\n    [\"image\", Buffer.from(inputs.imageDigest)],\n    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n  ];\n  const promptDir = join(ROOT, \"prompts\");\n  const promptFiles = readdirSync(promptDir)\n    .filter((f) => f.endsWith(\".txt\"))\n    .sort();\n  for (const f of promptFiles) {\n    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n  }\n  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n  for (const f of CONFIG_FILES) {\n    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n  }\n  return parts;\n}\n\nexport function computeAgentTypeId(inputs: TypeIdInputs): string {\n  const h = createHash(\"sha256\");\n  for (const [label, bytes] of typeIdManifest(inputs)) {\n    h.update(label);\n    h.update(\"\\0\");\n    h.update(bytes);\n    h.update(\"\\0\");\n  }\n  return `sha256:${h.digest(\"hex\")}`;\n}\n\n// One instance id per process. Pods are the unit an operator contains.\nexport const AGENT_INSTANCE_ID = randomUUID();\n\nlet AGENT_TYPE_ID = \"\";\nexport function setAgentTypeId(id: string): void {\n  AGENT_TYPE_ID = id;\n}\n\nexport interface Subject {\n  kind: \"patient\" | \"staff\" | \"system\";\n  id: string;\n}\n\nexport interface Logger {\n  info(obj: object, msg?: string): void;\n  warn(obj: object, msg?: string): void;\n  error(obj: object, msg?: string): void;\n}\n\nexport interface RunContext {\n  runId: string;\n  tenantId: string;\n  subject: Subject;\n  channel: \"sms\" | \"webchat\" | \"reminder\";\n  traceparent: string;\n  log: Logger;\n  identity(): {\n    accountableParty: string;\n    operationalOwner: string;\n    tenantId: string;\n    agentTypeId: string;\n    agentInstanceId: string;\n    traceparent: string;\n  };\n  workloadToken(): Promise<string>;\n}\n\n// Projected service-account token (audience: the group STS), rotated by the kubelet.\nconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n\nexport function newRunContext(init: {\n  tenantId: string;\n  subject: Subject;\n  channel: RunContext[\"channel\"];\n  traceparent?: string;\n  log: Logger;\n}): RunContext {\n  const runId = randomUUID();\n  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n  return {\n    runId,\n    tenantId: init.tenantId,\n    subject: init.subject,\n    channel: init.channel,\n    traceparent,\n    log: init.log,\n    identity: () => ({\n      accountableParty: env.accountableParty,\n      operationalOwner: env.operationalOwner,\n      tenantId: init.tenantId,\n      agentTypeId: AGENT_TYPE_ID,\n      agentInstanceId: AGENT_INSTANCE_ID,\n      traceparent,\n    }),\n    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n  };\n}\n","numLines":115,"startLine":1,"totalLines":115}}}
