nst reply = (model: string, text: string) => async () => ({ model, content: [{ type: \"text\", text }] });\n    98\t\n    99\t  it(\"routes ordinary intents to the agent and records the classifier identity\", async () => {\n   100\t    const d = await classifyIntent(fake(reply(\"claude-haiku-4-5-20251001\", '{\"intent\":\"book\",\"confidence\":0.93}')), \"can I come in tuesday\");\n   101\t    expect(d).toMatchObject({ route: \"agent\", intent: \"book\", failure: null, classifierId: CLASSIFIER_ID });\n   102\t  });\n   103\t\n   104\t  it(\"routes urgent messages to staff\", async () => {\n   105\t    const d = await classifyIntent(fake(reply(\"claude-haiku-4-5-20251001\", '{\"intent\":\"urgent\",\"confidence\":0.88}')), \"chest pain\");\n   106\t    expect(d.route).toBe(\"staff\");\n   107\t  });\n   108\t\n   109\t  it(\"treats a swapped served model as a control failure\", async () => {\n   110\t    const d = await classifyIntent(fake(reply(\"claude-haiku-4-5\", '{\"intent\":\"book\",\"confidence\":0.99}')), \"book me\");\n   111\t    expect(d).toMatchObject({ route: \"staff\", failure: \"model_mismatch\", servedModel: \"claude-haiku-4-5\" });\n   112\t  });\n   113\t\n   114\t  it(\"treats timeout, malformed output, unknown labels, and low confidence as failures\", async () => {\n   115\t    const timeout = Object.assign(new Error(\"timed out\"), { name: \"APIConnectionTimeoutError\" });\n   116\t    expect((await classifyIntent(fake(async () => Promise.reject(timeout)), \"hi\")).failure).toBe(\"timeout\");\n   117\t    expect((await classifyIntent(fake(reply(\"claude-haiku-4-5-20251001\", \"book\")), \"hi\")).failure).toBe(\"invalid_output\");\n   118\t    expect((await classifyIntent(fake(reply(\"claude-haiku-4-5-20251001\", '{\"intent\":\"refund\",\"confidence\":0.9}')), \"hi\")).failure).toBe(\"invalid_output\");\n   119\t    expect((await classifyIntent(fake(reply(\"claude-haiku-4-5-20251001\", '{\"intent\":\"book\",\"confidence\":0.2}')), \"hi\")).failure).toBe(\"low_confidence\");\n   120\t  });\n   121\t});\n     1\timport { afterEach, beforeEach, describe, expect, it, vi } from \"vitest\";\n     2\timport { BudgetExceeded, RunBudget, type QuotaStore } from \"../src/agent/budget.js\";\n     3\timport type { Budgets } from \"../src/config.js\";\n     4\t\n     5\tclass MemoryQuotaStore implements QuotaStore {\n     6\t  used = new Map<string, number>();\n     7\t  async add(key: string, amount: number, max: number) {\n     8\t    const cur = this.used.get(key) ?? 0;\n     9\t    if (cur + amount > max) return { ok: false, used: cur };\n    10\t    this.used.set(key, cur + amount);\n    11\t    return { ok: true, used: cur + amount };\n    12\t  }\n    13\t}\n    14\t\n    15\tconst MODEL = \"claude-sonnet-4-5-20250929\";\n    16\t\n    17\tfunction small(overrides: Partial<Budgets[\"run\"]> = {}, quotas: Partial<Budgets[\"quotas\"]> = {}): Budgets {\n    18\t  return {\n    19\t    run: {\n    20\t      maxTurns: 3,\n    21\t      maxWallMs: 1000,\n    22\t      maxInputTokens: 10_000,\n    23\t      maxOutputTokens: 1_000,\n    24\t      maxCostUsd: 1,\n    25\t      maxToolCalls: 5,\n    26\t      maxToolCallsPerMinute: 4,\n    27\t      maxPeerCalls: 1,\n    28\t      ...overrides,\n    29\t    },\n    30\t    quotas: {\n    31\t      perSubjectDailyUsd: 100,\n    32\t      perTenantDailyUsd: 100,\n    33\t      fleetDailyUsd: 100,\n    34\t      perTenantToolCallsPerMinute: 100,\n    35\t      fleetToolCallsPerMinute: 100,\n    36\t      ...quotas,\n    37\t    },\n    38\t    pricingUsdPerMTok: { [MODEL]: { input: 3, output: 15, cacheRead: 0.3, cacheWrite: 3.75 } },\n    39\t    onExceed: \"handoff_to_staff\",\n    40\t  };\n    41\t}\n    42\t\n    43\tconst scope = { tenantId: \"nb-castro\", subjectId: \"phone:+14155550199\" };\n    44\tconst usage = (i: number, o: number) => ({ input_tokens: i, output_tokens: o });\n    45\t\n    46\tasync function expectLimit(p: Promise<unknown> | (() => unknown), limit: string) {\n    47\t  try {\n    48\t    await (typeof p === \"function\" ? p() : p);\n    49\t  } catch (e) {\n    50\t    expect(e).toBeInstanceOf(BudgetExceeded);\n    51\t    expect((e as BudgetExceeded).limit).toBe(limit);\n    52\t    return;\n    53\t  }\n    54\t  throw new Error(`expected ${limit} to be exceeded`);\n    55\t}\n    56\t\n    57\tdescribe(\"RunBudget hard limits\", () => {\n    58\t  beforeEach(() => vi.useFakeTimers());\n    59\t  afterEach(() => vi.useRealTimers());\n    60\t\n    61\t  it(\"stops at the turn limit\", async () => {\n    62\t    const b = new RunBudget(small(), new MemoryQuotaStore(), scope);\n    63\t    b.turn();\n    64\t    b.turn();\n    65\t    b.turn();\n    66\t    await expectLimit(() => b.turn(), \"turns\");\n    67\t    expect(b.signal.aborted).toBe(true);\n    68\t  });\n    69\t\n    70\t  it(\"aborts in-flight work at the wall-clock limit\", async () => {\n    71\t    const b = new RunBudget(small(), new MemoryQuotaStore(), scope);\n    72\t    vi.advanceTimersByTime(1001);\n    73\t    expect(b.signal.aborted).toBe(true);\n    74\t    expect((b.signal.reason as BudgetExceeded).limit).toBe(\"wall_time\");\n    75\t  });\n    76\t\n    77\t  it(\"stops on input tokens, output tokens, and run cost\", async () => {\n    78\t    await expectLimit(new RunBudget(small(), new MemoryQuotaStore(), scope).recordUsage(usage(10_001, 1), MODEL), \"input_tokens\");\n    79\t    await expectLimit(new RunBudget(small(), new MemoryQuotaStore(), scope).recordUsage(usage(1, 1_001), MODEL), \"output_tokens\");\n    80\t    await expectLimit(\n    81\t      new RunBudget(small({ maxCostUsd: 0.01, maxInputTokens: 1e9 }), new MemoryQuotaStore(), scope).recordUsage(usage(5_000, 0), MODEL),\n    82\t      \"run_cost\",\n    83\t    );\n    84\t  });\n    85\t\n    86\t  it(\"counts cached input toward the token limit\", async () => {\n    87\t    const b = new RunBudget(small(), new MemoryQuotaStore(), scope);\n    88\t    await expectLimit(b.recordUsage({ input_tokens: 10, output_tokens: 1, cache_read_input_tokens: 10_000 }, MODEL), \"input_tokens\");\n    89\t  });\n    90\t\n    91\t  it(\"stops on total tool calls, tool-call rate, and peer calls\", async () => {\n    92\t    const b1 = new RunBudget(small({ maxToolCallsPerMinute: 100 }), new MemoryQuotaStore(), scope);\n    93\t    for (let i = 0; i < 5; i++) await b1.toolCall(\"ehr__search_slots\");\n    94\t    await expectLimit(b1.toolCall(\"ehr__search_slots\"), \"tool_calls\");\n    95\t\n    96\t    const b2 = new RunBudget(small({ maxToolCalls: 100 }), new MemoryQuotaStore(), scope);\n    97\t    for (let i = 0; i < 4; i++) await b2.toolCall(\"ehr__search_slots\");\n    98\t    await expectLimit(b2.toolCall(\"ehr__search_slots\"), \"tool_call_rate\");\n    99\t\n   100\t    const b3 = new RunBudget(small(), new MemoryQuotaStore(), scope);\n   101\t    await b3.toolCall(\"insurance__check_eligibility\");\n   102\t    await expectLimit(b3.toolCall(\"insurance__check_eligibility\"), \"peer_calls\");\n   103\t  });\n   104\t\n   105\t  it(\"enforces per-subject, per-tenant, and fleet spend across many small runs\", async () => {\n   106\t    const store = new MemoryQuotaStore();\n   107\t    const cfg = small({}, { perSubjectDailyUsd: 0.05 });\n   108\t    // Each run spends about $0.03, well under its own run_cost limit.\n   109\t    await new RunBudget(cfg, store, scope).recordUsage(usage(5_000, 1_000), MODEL);\n   110\t    await expectLimit(new RunBudget(cfg, store, scope).recordUsage(usage(5_000, 1_000), MODEL), \"subject_daily_cost\");\n   111\t\n   112\t    const tStore = new MemoryQuotaStore();\n   113\t    const tCfg = small({}, { perTenantDailyUsd: 0.05 });\n   114\t    await new RunBudget(tCfg, tStore, { ...scope, subjectId: \"a\" }).recordUsage(usage(5_000, 1_000), MODEL);\n   115\t    await expectLimit(new RunBudget(tCfg, tStore, { ...scope, subjectId: \"b\" }).recordUsage(usage(5_000, 1_000), MODEL), \"tenant_daily_cost\");\n   116\t\n   117\t    const fStore = new MemoryQuotaStore();\n   118\t    const fCfg = small({}, { fleetDailyUsd: 0.05 });\n   119\t    await new RunBudget(fCfg, fStore, { tenantId: \"nb-castro\", subjectId: \"a\" }).recordUsage(usage(5_000, 1_000), MODEL);\n   120\t    await expectLimit(\n   121\t      new RunBudget(fCfg, fStore, { tenantId: \"nb-oakland\", subjectId: \"b\" }).recordUsage(usage(5_000, 1_000), MODEL),\n   122\t      \"fleet_daily_cost\",\n   123\t    );\n   124\t  });\n   125\t\n   126\t  it(\"enforces per-tenant and fleet tool-call rates across runs\", async () => {\n   127\t    const store = new MemoryQuotaStore();\n   128\t    const cfg = small({}, { perTenantToolCallsPerMinute: 3 });\n   129\t    for (let i = 0; i < 3; i++) await new RunBudget(cfg, store, scope).toolCall(\"ehr__search_slots\");\n   130\t    await expectLimit(new RunBudget(cfg, store, scope).toolCall(\"ehr__search_slots\"), \"tenant_tool_rate\");\n   131\t\n   132\t    const fStore = new MemoryQuotaStore();\n   133\t    const fCfg = small({}, { fleetToolCallsPerMinute: 2 });\n   134\t    await new RunBudget(fCfg, fStore, { tenantId: \"nb-castro\", subjectId: \"a\" }).toolCall(\"ehr__search_slots\");\n   135\t    await new RunBudget(fCfg, fStore, { tenantId: \"nb-fremont\", subjectId: \"b\" }).toolCall(\"ehr__search_slots\");\n   136\t    await expectLimit(new RunBudget(fCfg, fStore, { tenantId: \"nb-oakland\", subjectId: \"c\" }).toolCall(\"ehr__search_slots\"), \"fleet_tool_rate\");\n   137\t  });\n   138\t\n   139\t  it(\"fails the run when the shared quota store is unavailable\", async () => {\n   140\t    const broken: QuotaStore = { add: async () => Promise.reject(new Error(\"throttled\")) };\n   141\t    await expect(new RunBudget(small(), broken, scope).toolCall(\"ehr__search_slots\")).rejects.toThrow(\"throttled\");\n   142\t  });\n   143\t});\n   37284 skill/references/agent.md\n   67489 skill/references/build-time.md\n  162629 skill/references/checks.json\n   43163 skill/references/configuration.md\n   60871 skill/references/ecosystem.md\n   73514 skill/references/run-time.md\n   29742 skill/heuristics/agent.yaml\n   52463 skill/heuristics/build-time.yaml\n   30175 skill/heuristics/configuration.yaml\n   41269 skill/heuristics/ecosystem.yaml\n   46192 skill/heuristics/run-time.yaml\n  644791 total\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2023\",\n    \"module\": \"NodeNext\",\n    \"moduleResolution\": \"NodeNext\",\n    \"outDir\": \"dist\",\n    \"rootDir\": \"src\",\n    \"strict\": true,\n    \"noUncheckedIndexedAccess\": true,\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true,\n    \"sourceMap\": true\n  },\n  \"include\": [\"src\"]\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
