{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HN6QvoNmNt4EH4yd9fX1ky","type":"tool_result","content":"1\timport type Anthropic from \"@anthropic-ai/sdk\";\n2\timport { createHash } from \"node:crypto\";\n3\timport { readFileSync } from \"node:fs\";\n4\timport { join } from \"node:path\";\n5\timport { z } from \"zod\";\n6\timport { CLASSIFIER_MODEL, ROOT } from \"../config.js\";\n7\t\n8\t// Helper model that routes messages before the agent sees them. Urgent and complaint messages go\n9\t// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\n10\t// malformed output, unknown label, or a served model other than the pinned snapshot) routes the\n11\t// message to staff. A failed classifier never defaults to \"send it to the agent\".\n12\t\n13\texport const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");\n14\texport const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\n15\t\n16\texport const CLASSIFIER_ID = `sha256:${createHash(\"sha256\")\n17\t  .update(CLASSIFIER_MODEL)\n18\t  .update(\"\\0\")\n19\t  .update(CLASSIFIER_PROMPT)\n20\t  .update(\"\\0\")\n21\t  .update(JSON.stringify(CLASSIFIER_CONFIG))\n22\t  .digest(\"hex\")}`;\n23\t\n24\tconst Intent = z.enum([\"book\", \"reschedule\", \"cancel\", \"confirm\", \"coverage\", \"info\", \"urgent\", \"complaint\", \"other\"]);\n25\tconst Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();\n26\t\n27\texport type Route = \"agent\" | \"staff\";\n28\t\n29\texport interface ClassifierDecision {\n30\t  classifierId: string;\n31\t  requestedModel: string;\n32\t  servedModel: string | null;\n33\t  intent: z.infer<typeof Intent> | null;\n34\t  confidence: number | null;\n35\t  route: Route;\n36\t  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n37\t}\n38\t\n39\tconst MIN_CONFIDENCE = 0.6;\n40\t\n41\texport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n42\t  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n43\t  let res: Anthropic.Message;\n44\t  try {\n45\t    res = await client.messages.create(\n46\t      {\n47\t        model: CLASSIFIER_MODEL,\n48\t        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n49\t        temperature: CLASSIFIER_CONFIG.temperature,\n50\t        system: CLASSIFIER_PROMPT,\n51\t        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n52\t      },\n53\t      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n54\t    );\n55\t  } catch (err) {\n56\t    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n57\t    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n58\t  }\n59\t\n60\t  if (res.model !== CLASSIFIER_MODEL) {\n61\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n62\t  }\n63\t\n64\t  const textOut = res.content.find((b) => b.type === \"text\");\n65\t  let parsed: z.infer<typeof Output>;\n66\t  try {\n67\t    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n68\t  } catch {\n69\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n70\t  }\n71\t\n72\t  if (parsed.confidence < MIN_CONFIDENCE) {\n73\t    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n74\t  }\n75\t  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n76\t  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n77\t}\n78\t"}]},"parent_tool_use_id":null,"session_id":"29563294-217c-407e-8b87-42521726a071","uuid":"60cf81bf-e18f-432b-ad19-2f186503c752","timestamp":"2026-10-02T16:08:08.990Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-repeat-80qi2mwl/agent/src/agent/classifier.ts","content":"import type Anthropic from \"@anthropic-ai/sdk\";\nimport { createHash } from \"node:crypto\";\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { z } from \"zod\";\nimport { CLASSIFIER_MODEL, ROOT } from \"../config.js\";\n\n// Helper model that routes messages before the agent sees them. Urgent and complaint messages go\n// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\n// malformed output, unknown label, or a served model other than the pinned snapshot) routes the\n// message to staff. A failed classifier never defaults to \"send it to the agent\".\n\nexport const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");\nexport const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\n\nexport const CLASSIFIER_ID = `sha256:${createHash(\"sha256\")\n  .update(CLASSIFIER_MODEL)\n  .update(\"\\0\")\n  .update(CLASSIFIER_PROMPT)\n  .update(\"\\0\")\n  .update(JSON.stringify(CLASSIFIER_CONFIG))\n  .digest(\"hex\")}`;\n\nconst Intent = z.enum([\"book\", \"reschedule\", \"cancel\", \"confirm\", \"coverage\", \"info\", \"urgent\", \"complaint\", \"other\"]);\nconst Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();\n\nexport type Route = \"agent\" | \"staff\";\n\nexport interface ClassifierDecision {\n  classifierId: string;\n  requestedModel: string;\n  servedModel: string | null;\n  intent: z.infer<typeof Intent> | null;\n  confidence: number | null;\n  route: Route;\n  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n}\n\nconst MIN_CONFIDENCE = 0.6;\n\nexport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n  let res: Anthropic.Message;\n  try {\n    res = await client.messages.create(\n      {\n        model: CLASSIFIER_MODEL,\n        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n        temperature: CLASSIFIER_CONFIG.temperature,\n        system: CLASSIFIER_PROMPT,\n        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n      },\n      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n    );\n  } catch (err) {\n    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n  }\n\n  if (res.model !== CLASSIFIER_MODEL) {\n    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n  }\n\n  const textOut = res.content.find((b) => b.type === \"text\");\n  let parsed: z.infer<typeof Output>;\n  try {\n    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n  } catch {\n    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n  }\n\n  if (parsed.confidence < MIN_CONFIDENCE) {\n    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n  }\n  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n}\n","numLines":78,"startLine":1,"totalLines":78}}}
