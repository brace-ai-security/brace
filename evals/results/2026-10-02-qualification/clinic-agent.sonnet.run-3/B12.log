{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VFN2EeD73gP5c5BjcSdPu6","type":"tool_result","content":"1\tname: deploy\n2\t\n3\t# Deploys the image digest named in release/manifest.json. The digest reaches the manifest through\n4\t# a reviewed release PR, so what runs is always a reviewed commit.\n5\ton:\n6\t  workflow_dispatch:\n7\t    inputs:\n8\t      emergency:\n9\t        description: Emergency change (hotfix/* branch, production-emergency environment)\n10\t        type: boolean\n11\t        default: false\n12\t      owner:\n13\t        description: Emergency only - person accountable for this change\n14\t        type: string\n15\t        default: \"\"\n16\t      reason:\n17\t        description: Emergency only - why this cannot wait for a normal release\n18\t        type: string\n19\t        default: \"\"\n20\t      expires_on:\n21\t        description: Emergency only - date (YYYY-MM-DD) by which it is replaced by a normal release\n22\t        type: string\n23\t        default: \"\"\n24\t\n25\tpermissions:\n26\t  contents: read\n27\t  id-token: write\n28\t  issues: write\n29\t\n30\tconcurrency:\n31\t  group: deploy-production\n32\t  cancel-in-progress: false\n33\t\n34\tjobs:\n35\t  deploy:\n36\t    runs-on: ubuntu-24.04\n37\t    environment: ${{ inputs.emergency && 'production-emergency' || 'production' }}\n38\t    steps:\n39\t      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n40\t\n41\t      - name: Emergency change record is complete\n42\t        if: inputs.emergency\n43\t        env:\n44\t          OWNER: ${{ inputs.owner }}\n45\t          REASON: ${{ inputs.reason }}\n46\t          EXPIRES_ON: ${{ inputs.expires_on }}\n47\t        run: |\n48\t          test -n \"$OWNER\" || { echo \"owner is required\"; exit 1; }\n49\t          test -n \"$REASON\" || { echo \"reason is required\"; exit 1; }\n50\t          date -d \"$EXPIRES_ON\" +%F >/dev/null || { echo \"expires_on must be a date\"; exit 1; }\n51\t          [[ \"$GITHUB_REF_NAME\" == hotfix/* ]] || { echo \"emergency deploys come from hotfix/* branches\"; exit 1; }\n52\t\n53\t      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n54\t        with:\n55\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-deploy\n56\t          aws-region: us-west-2\n57\t\n58\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n59\t        with:\n60\t          cosign-release: v2.6.2\n61\t\n62\t      - name: Verify image signature\n63\t        run: |\n64\t          DIGEST=$(jq -r .image.digest release/manifest.json)\n65\t          REPO=$(jq -r .image.repository release/manifest.json)\n66\t          cosign verify \"$REPO@$DIGEST\" \\\n67\t            --certificate-identity \"https://github.com/northbay-clinics/clinic-agent/.github/workflows/ci.yml@refs/heads/main\" \\\n68\t            --certificate-oidc-issuer https://token.actions.githubusercontent.com\n69\t          grep -q \"$DIGEST\" k8s/deployment.yaml || { echo \"k8s/deployment.yaml does not use the manifest digest\"; exit 1; }\n70\t\n71\t      - name: Apply\n72\t        run: |\n73\t          aws eks update-kubeconfig --name clinic-agent-prod\n74\t          kubectl apply -f k8s/deployment.yaml\n75\t          kubectl -n clinic-agent annotate deployment/clinic-agent --overwrite \\\n76\t            northbay.example/git-sha=\"$GITHUB_SHA\" \\\n77\t            northbay.example/release=\"$(jq -r .release release/manifest.json)\" \\\n78\t            northbay.example/deployed-by=\"$GITHUB_ACTOR\" \\\n79\t            northbay.example/run=\"$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID\"\n80\t          kubectl -n clinic-agent rollout status deployment/clinic-agent --timeout=5m\n81\t\n82\t      - name: Open follow-up review for emergency change\n83\t        if: inputs.emergency\n84\t        env:\n85\t          GH_TOKEN: ${{ github.token }}\n86\t          OWNER: ${{ inputs.owner }}\n87\t          REASON: ${{ inputs.reason }}\n88\t          EXPIRES_ON: ${{ inputs.expires_on }}\n89\t        run: |\n90\t          gh issue create \\\n91\t            --title \"Follow-up review: emergency deploy ${GITHUB_SHA::8}\" \\\n92\t            --label emergency-change,needs-review \\\n93\t            --assignee \"$OWNER\" \\\n94\t            --body \"Owner: $OWNER\n95\t          Reason: $REASON\n96\t          Ends: $EXPIRES_ON\n97\t          Commit: $GITHUB_SHA\n98\t          Approved in environment production-emergency by a required reviewer (see run $GITHUB_RUN_ID).\n99\t          Review and merge to main via normal PR before the end date.\"\n100\t"}]},"parent_tool_use_id":null,"session_id":"7896552e-9ea4-450a-afd2-58b35082d378","uuid":"8ecfbfe5-8f50-4ecc-9199-6e128971192b","timestamp":"2026-10-02T16:26:44.374Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-mh6znvbm/agent/.github/workflows/deploy.yml","content":"name: deploy\n\n# Deploys the image digest named in release/manifest.json. The digest reaches the manifest through\n# a reviewed release PR, so what runs is always a reviewed commit.\non:\n  workflow_dispatch:\n    inputs:\n      emergency:\n        description: Emergency change (hotfix/* branch, production-emergency environment)\n        type: boolean\n        default: false\n      owner:\n        description: Emergency only - person accountable for this change\n        type: string\n        default: \"\"\n      reason:\n        description: Emergency only - why this cannot wait for a normal release\n        type: string\n        default: \"\"\n      expires_on:\n        description: Emergency only - date (YYYY-MM-DD) by which it is replaced by a normal release\n        type: string\n        default: \"\"\n\npermissions:\n  contents: read\n  id-token: write\n  issues: write\n\nconcurrency:\n  group: deploy-production\n  cancel-in-progress: false\n\njobs:\n  deploy:\n    runs-on: ubuntu-24.04\n    environment: ${{ inputs.emergency && 'production-emergency' || 'production' }}\n    steps:\n      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n\n      - name: Emergency change record is complete\n        if: inputs.emergency\n        env:\n          OWNER: ${{ inputs.owner }}\n          REASON: ${{ inputs.reason }}\n          EXPIRES_ON: ${{ inputs.expires_on }}\n        run: |\n          test -n \"$OWNER\" || { echo \"owner is required\"; exit 1; }\n          test -n \"$REASON\" || { echo \"reason is required\"; exit 1; }\n          date -d \"$EXPIRES_ON\" +%F >/dev/null || { echo \"expires_on must be a date\"; exit 1; }\n          [[ \"$GITHUB_REF_NAME\" == hotfix/* ]] || { echo \"emergency deploys come from hotfix/* branches\"; exit 1; }\n\n      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n        with:\n          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-deploy\n          aws-region: us-west-2\n\n      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n        with:\n          cosign-release: v2.6.2\n\n      - name: Verify image signature\n        run: |\n          DIGEST=$(jq -r .image.digest release/manifest.json)\n          REPO=$(jq -r .image.repository release/manifest.json)\n          cosign verify \"$REPO@$DIGEST\" \\\n            --certificate-identity \"https://github.com/northbay-clinics/clinic-agent/.github/workflows/ci.yml@refs/heads/main\" \\\n            --certificate-oidc-issuer https://token.actions.githubusercontent.com\n          grep -q \"$DIGEST\" k8s/deployment.yaml || { echo \"k8s/deployment.yaml does not use the manifest digest\"; exit 1; }\n\n      - name: Apply\n        run: |\n          aws eks update-kubeconfig --name clinic-agent-prod\n          kubectl apply -f k8s/deployment.yaml\n          kubectl -n clinic-agent annotate deployment/clinic-agent --overwrite \\\n            northbay.example/git-sha=\"$GITHUB_SHA\" \\\n            northbay.example/release=\"$(jq -r .release release/manifest.json)\" \\\n            northbay.example/deployed-by=\"$GITHUB_ACTOR\" \\\n            northbay.example/run=\"$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID\"\n          kubectl -n clinic-agent rollout status deployment/clinic-agent --timeout=5m\n\n      - name: Open follow-up review for emergency change\n        if: inputs.emergency\n        env:\n          GH_TOKEN: ${{ github.token }}\n          OWNER: ${{ inputs.owner }}\n          REASON: ${{ inputs.reason }}\n          EXPIRES_ON: ${{ inputs.expires_on }}\n        run: |\n          gh issue create \\\n            --title \"Follow-up review: emergency deploy ${GITHUB_SHA::8}\" \\\n            --label emergency-change,needs-review \\\n            --assignee \"$OWNER\" \\\n            --body \"Owner: $OWNER\n          Reason: $REASON\n          Ends: $EXPIRES_ON\n          Commit: $GITHUB_SHA\n          Approved in environment production-emergency by a required reviewer (see run $GITHUB_RUN_ID).\n          Review and merge to main via normal PR before the end date.\"\n","numLines":100,"startLine":1,"totalLines":100}}}
