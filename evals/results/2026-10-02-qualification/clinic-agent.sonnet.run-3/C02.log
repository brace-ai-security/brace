 ${m.harness.version} != package ${ver}`); bad++; }\n            process.exit(bad ? 1 : 0);\n          '\n\n  image:\n    if: github.ref == 'refs/heads/main'\n    needs: [test, manifest-check]\n    runs-on: ubuntu-24.04\n    permissions:\n      contents: read\n      id-token: write\n      attestations: write\n      packages: write\n    steps:\n      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n        with:\n          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-image-build\n          aws-region: us-west-2\n      - uses: aws-actions/amazon-ecr-login@062b18b96a7aff071d4dc91bc00c4c1a7945b076 # v2.0.1\n        id: ecr\n      - uses: docker/setup-buildx-action@e468171a9de216ec08956ac3ada2f0791b6bd435 # v3.11.1\n      - uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n        id: build\n        with:\n          push: true\n          tags: ${{ steps.ecr.outputs.registry }}/clinic-agent:${{ github.sha }}\n          provenance: mode=max\n          sbom: true\n      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n        with:\n          cosign-release: v2.6.2\n      - name: Sign image\n        run: cosign sign --yes ${{ steps.ecr.outputs.registry }}/clinic-agent@${{ steps.build.outputs.digest }}\n      - uses: actions/attest-build-provenance@977bb373ede98d70efdf65b84cb5f73e068dcc2a # v3.0.0\n        with:\n          subject-name: ${{ steps.ecr.outputs.registry }}/clinic-agent\n          subject-digest: ${{ steps.build.outputs.digest }}\n          push-to-registry: true\napiVersion: v1\nkind: Namespace\nmetadata:\n  name: clinic-agent\n  labels:\n    pod-security.kubernetes.io/enforce: restricted\n    pod-security.kubernetes.io/enforce-version: v1.33\n    pod-security.kubernetes.io/audit: restricted\n    pod-security.kubernetes.io/warn: restricted\n---\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: clinic-agent\n  namespace: clinic-agent\n  annotations:\n    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    eks.amazonaws.com/token-expiration: \"3600\"\nautomountServiceAccountToken: false\n---\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: clinic-agent-reminders\n  namespace: clinic-agent\n  annotations:\n    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\nautomountServiceAccountToken: false\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: clinic-agent\n  namespace: clinic-agent\ndata:\n  CLINIC_DIRECTORY: |\n    [{\"id\":\"nb-castro\",\"name\":\"Northbay Castro\",\"smsNumber\":\"+14155550110\"},\n     {\"id\":\"nb-fremont\",\"name\":\"Northbay Fremont\",\"smsNumber\":\"+15105550111\"},\n     {\"id\":\"nb-oakland\",\"name\":\"Northbay Oakland\",\"smsNumber\":\"+15105550112\"},\n     {\"id\":\"nb-sanmateo\",\"name\":\"Northbay San Mateo\",\"smsNumber\":\"+16505550113\"},\n     {\"id\":\"nb-walnutcreek\",\"name\":\"Northbay Walnut Creek\",\"smsNumber\":\"+19255550114\"}]\n  SMS_SIGNING_SECRET_ARN: arn:aws:secretsmanager:us-west-2:418295730611:secret:clinic-agent/sms-signing\n  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: clinic-agent\n  namespace: clinic-agent\n  labels: { app: clinic-agent }\nspec:\n  replicas: 3\n  selector:\n    matchLabels: { app: clinic-agent }\n  template:\n    metadata:\n      labels: { app: clinic-agent }\n    spec:\n      serviceAccountName: clinic-agent\n      automountServiceAccountToken: false\n      hostUsers: false\n      hostNetwork: false\n      hostPID: false\n      hostIPC: false\n      enableServiceLinks: false\n      securityContext:\n        runAsNonRoot: true\n        runAsUser: 65532\n        runAsGroup: 65532\n        fsGroup: 65532\n        seccompProfile:\n          type: RuntimeDefault\n      containers:\n        - name: agent\n          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n          ports:\n            - containerPort: 8080\n          envFrom:\n            - configMapRef: { name: clinic-agent }\n          env:\n            - name: IMAGE_DIGEST\n              value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n            - name: GIT_SHA\n              value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n          securityContext:\n            allowPrivilegeEscalation: false\n            privileged: false\n            readOnlyRootFilesystem: true\n            runAsNonRoot: true\n            capabilities:\n              drop: [\"ALL\"]\n            seccompProfile:\n              type: RuntimeDefault\n          resources:\n            requests: { cpu: 250m, memory: 384Mi }\n            limits: { cpu: \"1\", memory: 768Mi }\n          readinessProbe:\n            httpGet: { path: /healthz, port: 8080 }\n          volumeMounts:\n            - { name: tmp, mountPath: /tmp }\n            - { name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true }\n      volumes:\n        - name: tmp\n          emptyDir: { medium: Memory, sizeLimit: 32Mi }\n        - name: sts-token\n          projected:\n            sources:\n              - serviceAccountToken:\n                  audience: https://sts.northbay-clinics.example\n                  expirationSeconds: 900\n                  path: sts-token\n---\napiVersion: batch/v1\nkind: CronJob\nmetadata:\n  name: clinic-agent-reminders\n  namespace: clinic-agent\nspec:\n  schedule: \"0 17 * * *\"\n  timeZone: America/Los_Angeles\n  concurrencyPolicy: Forbid\n  jobTemplate:\n    spec:\n      backoffLimit: 0\n      activeDeadlineSeconds: 1800\n      template:\n        metadata:\n          labels: { app: clinic-agent-reminders }\n        spec:\n          serviceAccountName: clinic-agent-reminders\n          automountServiceAccountToken: false\n          restartPolicy: Never\n          hostUsers: false\n          securityContext:\n            runAsNonRoot: true\n            runAsUser: 65532\n            runAsGroup: 65532\n            seccompProfile:\n              type: RuntimeDefault\n          containers:\n            - name: reminders\n              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n              args: [\"dist/workers/reminders.js\"]\n              envFrom:\n                - configMapRef: { name: clinic-agent }\n              env:\n                - name: IMAGE_DIGEST\n                  value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n                - name: GIT_SHA\n                  value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n              securityContext:\n                allowPrivilegeEscalation: false\n                privileged: false\n                readOnlyRootFilesystem: true\n                capabilities:\n                  drop: [\"ALL\"]\n---\n# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,\n# the group STS and auth service, and AWS service endpoints.\napiVersion: networking.k8s.io/v1\nkind: NetworkPolicy\nmetadata:\n  name: clinic-agent-egress\n  namespace: clinic-agent\nspec:\n  podSelector: {}\n  policyTypes: [\"Egress\", \"Ingress\"]\n  ingress:\n    - from:\n        - namespaceSelector:\n            matchLabels: { kubernetes.io/metadata.name: ingress }\n      ports:\n        - { port: 8080, protocol: TCP }\n  egress:\n    - to:\n        - namespaceSelector:\n            matchLabels: { kubernetes.io/metadata.name: kube-system }\n          podSelector:\n            matchLabels: { k8s-app: kube-dns }\n      ports:\n        - { port: 53, protocol: UDP }\n        - { port: 53, protocol: TCP }\n    - to:\n        - namespaceSelector:\n            matchLabels: { kubernetes.io/metadata.name: platform }\n          podSelector:\n            matchLabels: { app: egress-proxy }\n      ports:\n        - { port: 3128, protocol: TCP }\n    - to:\n        - ipBlock: { cidr: 10.60.12.0/28 }\n      ports:\n        - { port: 443, protocol: TCP }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
