onfig.ts:53:  region: process.env.AWS_REGION ?? \"us-west-2\",\nsrc/config.ts:54:  controlTable: process.env.CONTROL_TABLE ?? \"clinic-agent-control\",\nsrc/config.ts:55:  budgetTable: process.env.BUDGET_TABLE ?? \"clinic-agent-budgets\",\nsrc/config.ts:56:  auditStream: process.env.AUDIT_STREAM ?? \"clinic-agent-audit\",\nsrc/config.ts:57:  smsSigningSecretArn: process.env.SMS_SIGNING_SECRET_ARN ?? \"\",\nsrc/config.ts:58:  chatJwksUrl: process.env.CHAT_JWKS_URL ?? \"https://auth.northbay-clinics.example/.well-known/jwks.json\",\nsrc/config.ts:59:  chatIssuer: process.env.CHAT_ISSUER ?? \"https://auth.northbay-clinics.example/\",\nsrc/config.ts:60:  eligibilityUrl: process.env.ELIGIBILITY_URL ?? \"https://eligibility.partners.northbay-clinics.example/a2a\",\nsrc/config.ts:61:  eligibilityIssuer: process.env.ELIGIBILITY_ISSUER ?? \"https://eligibility.partners.northbay-clinics.example\",\nsrc/config.ts:62:  tokenExchangeUrl: process.env.TOKEN_EXCHANGE_URL ?? \"https://sts.northbay-clinics.example/oauth2/token\",\nsrc/server.ts:20:    level: process.env.LOG_LEVEL ?? \"info\",\nsrc/server.ts:28:  imageDigest: process.env.IMAGE_DIGEST ?? \"\",\nsrc/server.ts:30:  harnessGitSha: process.env.GIT_SHA ?? \"\",\nsrc/server.ts:57:const directory: Array<{ id: string; name: string; smsNumber: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\nname: ci\n\non:\n  pull_request:\n  push:\n    branches: [main]\n\npermissions:\n  contents: read\n\njobs:\n  test:\n    runs-on: ubuntu-24.04\n    steps:\n      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5.0.0\n        with:\n          node-version: \"22.11\"\n          cache: npm\n      - run: npm ci --ignore-scripts\n      - run: npm run lint\n      - run: npm test\n      - run: npm run build\n\n  manifest-check:\n    runs-on: ubuntu-24.04\n    steps:\n      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n      - name: Prompt digests match the release manifest\n        run: |\n          node -e '\n            const fs = require(\"fs\"), crypto = require(\"crypto\");\n            const m = JSON.parse(fs.readFileSync(\"release/manifest.json\", \"utf8\"));\n            let bad = 0;\n            for (const p of m.prompts) {\n              const got = crypto.createHash(\"sha256\").update(fs.readFileSync(p.path)).digest(\"hex\");\n              if (got !== p.sha256) { console.error(`${p.path}: manifest ${p.sha256} != file ${got}`); bad++; }\n            }\n            const ver = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\")).version;\n            if (m.harness.version !== ver) { console.error(`harness version ${m.harness.version} != package ${ver}`); bad++; }\n            process.exit(bad ? 1 : 0);\n          '\n\n  image:\n    if: github.ref == 'refs/heads/main'\n    needs: [test, manifest-check]\n    runs-on: ubuntu-24.04\n    permissions:\n      contents: read\n      id-token: write\n      attestations: write\n      packages: write\n    steps:\n      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0\n      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n        with:\n          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-image-build\n          aws-region: us-west-2\n      - uses: aws-actions/amazon-ecr-login@062b18b96a7aff071d4dc91bc00c4c1a7945b076 # v2.0.1\n        id: ecr\n      - uses: docker/setup-buildx-action@e468171a9de216ec08956ac3ada2f0791b6bd435 # v3.11.1\n      - uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n        id: build\n        with:\n          push: true\n          tags: ${{ steps.ecr.outputs.registry }}/clinic-agent:${{ github.sha }}\n          provenance: mode=max\n          sbom: true\n      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n        with:\n    