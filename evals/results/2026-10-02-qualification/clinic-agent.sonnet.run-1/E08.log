{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01855qxCDGgBt8ijXPnCfGMj","type":"tool_result","content":"1\timport { audit } from \"../audit/recorder.js\";\n2\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n3\timport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\n4\timport { payments } from \"../integrations/payments.js\";\n5\timport type { RunContext } from \"../agent/identity.js\";\n6\timport type { ContextSize } from \"../agent/context-size.js\";\n7\t\n8\t// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n9\t// agent, and settles the visit deposit when the plan covers the visit.\n10\t\n11\texport async function checkEligibilityForAppointment(\n12\t  ehr: Ehr,\n13\t  input: { appointmentId: string },\n14\t  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n15\t): Promise<Eligibility & { depositRefundId?: string }> {\n16\t  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n17\t\n18\t  const result = await checkEligibility(\n19\t    {\n20\t      clinicId: opts.clinicId,\n21\t      patientId: appt.patientId,\n22\t      payerId: appt.payerId,\n23\t      serviceCode: appt.serviceCode,\n24\t      dateOfService: appt.start.slice(0, 10),\n25\t    },\n26\t    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n27\t  );\n28\t  await audit.record({\n29\t    ...opts.ctx.identity(),\n30\t    runId: opts.ctx.runId,\n31\t    subject: opts.ctx.subject,\n32\t    event: \"peer.call\",\n33\t    tool: \"insurance__check_eligibility\",\n34\t    context: opts.context,\n35\t    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n36\t  });\n37\t\n38\t  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n39\t  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n40\t    const refund = await payments.refundDeposit(\n41\t      opts.clinicId,\n42\t      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n43\t      opts.signal,\n44\t    );\n45\t    await audit.record({\n46\t      ...opts.ctx.identity(),\n47\t      runId: opts.ctx.runId,\n48\t      subject: opts.ctx.subject,\n49\t      event: \"payment.refund\",\n50\t      tool: \"insurance__check_eligibility\",\n51\t      context: opts.context,\n52\t      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n53\t    });\n54\t    return { ...result, depositRefundId: refund.id };\n55\t  }\n56\t  return result;\n57\t}\n58\t"}]},"parent_tool_use_id":null,"session_id":"35e2620e-82db-4842-acb4-a31074ab64ce","uuid":"c32758ac-0ae6-42c1-bd2c-8997262c818b","timestamp":"2026-10-02T14:53:19.913Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-5whr93sa/agent/src/workflows/eligibility-check.ts","content":"import { audit } from \"../audit/recorder.js\";\nimport type { Ehr } from \"../integrations/ehr-mcp.js\";\nimport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\nimport { payments } from \"../integrations/payments.js\";\nimport type { RunContext } from \"../agent/identity.js\";\nimport type { ContextSize } from \"../agent/context-size.js\";\n\n// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n// agent, and settles the visit deposit when the plan covers the visit.\n\nexport async function checkEligibilityForAppointment(\n  ehr: Ehr,\n  input: { appointmentId: string },\n  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n): Promise<Eligibility & { depositRefundId?: string }> {\n  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n\n  const result = await checkEligibility(\n    {\n      clinicId: opts.clinicId,\n      patientId: appt.patientId,\n      payerId: appt.payerId,\n      serviceCode: appt.serviceCode,\n      dateOfService: appt.start.slice(0, 10),\n    },\n    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n  );\n  await audit.record({\n    ...opts.ctx.identity(),\n    runId: opts.ctx.runId,\n    subject: opts.ctx.subject,\n    event: \"peer.call\",\n    tool: \"insurance__check_eligibility\",\n    context: opts.context,\n    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n  });\n\n  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n    const refund = await payments.refundDeposit(\n      opts.clinicId,\n      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n      opts.signal,\n    );\n    await audit.record({\n      ...opts.ctx.identity(),\n      runId: opts.ctx.runId,\n      subject: opts.ctx.subject,\n      event: \"payment.refund\",\n      tool: \"insurance__check_eligibility\",\n      context: opts.context,\n      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n    });\n    return { ...result, depositRefundId: refund.id };\n  }\n  return result;\n}\n","numLines":58,"startLine":1,"totalLines":58}}}
