{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U8xaSeymYHgfAppNyCx4Dc","type":"tool_result","content":"     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n     5\t// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n     6\t// The provider enforces Idempotency-Key for 24 hours.\n     7\t\n     8\tconst sm = new SecretsManagerClient({ region: env.region });\n     9\tconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n    10\t\n    11\tasync function key(clinicId: string): Promise<string> {\n    12\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n    13\t  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n    14\t}\n    15\t\n    16\texport interface Refund {\n    17\t  id: string;\n    18\t  depositId: string;\n    19\t  amountCents: number;\n    20\t  status: \"pending\" | \"succeeded\" | \"failed\";\n    21\t}\n    22\t\n    23\texport const payments = {\n    24\t  async refundDeposit(\n    25\t    clinicId: string,\n    26\t    req: { depositId: string; reason: string; idempotencyKey: string },\n    27\t    signal?: AbortSignal,\n    28\t  ): Promise<Refund> {\n    29\t    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n    30\t      method: \"POST\",\n    31\t      signal,\n    32\t      headers: {\n    33\t        authorization: `Bearer ${await key(clinicId)}`,\n    34\t        \"content-type\": \"application/json\",\n    35\t        \"idempotency-key\": req.idempotencyKey,\n    36\t      },\n    37\t      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    38\t    });\n    39\t    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    40\t    return (await res.json()) as Refund;\n    41\t  },\n    42\t};\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n     5\t// can send; free-form text goes through sms__send_freeform, which needs approval.\n     6\t\n     7\tconst sm = new SecretsManagerClient({ region: env.region });\n     8\tconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n     9\t\n    10\texport const TEMPLATES = {\n    11\t  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n    12\t  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n    13\t  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n    14\t  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n    15\t} as const;\n    16\texport type TemplateId = keyof typeof TEMPLATES;\n    17\t\n    18\texport function render(id: TemplateId, vars: Record<string, string>): string {\n    19\t  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n    20\t}\n    21\t\n    22\tasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n    23\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n    24\t  const v = JSON.parse(s.SecretString ?? \"{}\");\n    25\t  return { token: v.api_token, from: v.from_number };\n    26\t}\n    27\t\n    28\texport const sms = {\n    29\t  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n    30\t    const c = await creds(clinicId);\n    31\t    const res = await fetch(`${BASE}/messages`, {\n    32\t      method: \"POST\",\n    33\t      signal,\n    34\t      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n    35\t      body: JSON.stringify({ from: c.from, to, body }),\n    36\t    });\n    37\t    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n    38\t    return (await res.json()) as { messageId: string };\n    39\t  },\n    40\t};\n     1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n     2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n     3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     4\timport { Agent } from \"undici\";\n     5\timport type { PeerCertificate } from \"node:tls\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n     8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n     9\t\n    10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n    11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n    12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n    13\t\n    14\tconst sm = new SecretsManagerClient({ region: env.region });\n    15\t\n    16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n    17\t  const expected = server.tlsCertSha256.toLowerCase();\n    18\t  return new Agent({\n    19\t    connect: {\n    20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n    21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n    22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n    23\t      },\n    24\t    },\n    25\t  });\n    26\t}\n    27\t\n    28\ttype Token = { value: string; exp: number };\n    29\tconst tokens = new Map<string, Token>();\n    30\t\n    31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n    32\t  const cacheKey = `${clinicId}|${scope}`;\n    33\t  const hit = tokens.get(cacheKey);\n    34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n    35\t\n    36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n    37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n    38\t  const res = await fetch(token_url, {\n    39\t    method: \"POST\",\n    40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n    42\t  });\n    43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n    44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n    45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n    46\t  return body.access_token;\n    47\t}\n    48\t\n    49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n    50\tconst sessions = new Map<string, Client>();\n    51\t\n    52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n    53\t  const existing = sessions.get(clinicId);\n    54\t  if (existing) return existing;\n    55\t  const token = await ehrToken(clinicId, SCOPES);\n    56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    57\t    requestInit: {\n    58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n    59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n    60\t      dispatcher: pinnedDispatcher(server),\n    61\t    },\n    62\t  });\n    63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n    64\t  await client.connect(transport);\n    65\t  sessions.set(clinicId, client);\n    66\t  setTimeout(() => {\n    67\t    sessions.delete(clinicId);\n    68\t    void client.close();\n    69\t  }, 4 * 60_000).unref();\n    70\t  return client;\n    71\t}\n    72\t\n    73\texport function ehr(server: ConfiguredServer) {\n    74\t  return {\n    75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n    76\t      const c = await session(server, \"_catalog\");\n    77\t      const [tools, prompts, templates] = await Promise.all([\n    78\t        c.listTools(),\n    79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n    80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n    81\t      ]);\n    82\t      return {\n    83\t        reportedName: c.getServerVersion()?.name,\n    84\t        meta: {\n    85\t          instructions: c.getInstructions(),\n    86\t          tools: tools.tools as ServerMeta[\"tools\"],\n    87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n    88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n    89\t        },\n    90\t      };\n    91\t    },\n    92\t\n    93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n    94\t      const c = await session(server, opts.clinicId);\n    95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n    96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n    97\t      return res.structuredContent ?? res.content;\n    98\t    },\n    99\t\n   100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n   101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n   102\t        id: string;\n   103\t        patientId: string;\n   104\t        start: string;\n   105\t        serviceCode: string;\n   106\t        payerId?: string;\n   107\t        depositId?: string;\n   108\t        status: string;\n   109\t      };\n   110\t    },\n   111\t\n   112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n   113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n   114\t        id: string;\n   115\t        patientId: string;\n   116\t        start: string;\n   117\t        phone: string;\n   118\t        smsOptIn: boolean;\n   119\t        locationName: string;\n   120\t      }>;\n   121\t    },\n   122\t  };\n   123\t}\n   124\texport type Ehr = ReturnType<typeof ehr>;\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: clinic-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.33\n     8\t    pod-security.kubernetes.io/audit: restricted\n     9\t    pod-security.kubernetes.io/warn: restricted\n    10\t---\n    11\tapiVersion: v1\n    12\tkind: ServiceAccount\n    13\tmetadata:\n    14\t  name: clinic-agent\n    15\t  namespace: clinic-agent\n    16\t  annotations:\n    17\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    18\t    eks.amazonaws.com/token-expiration: \"3600\"\n    19\tautomountServiceAccountToken: false\n    20\t---\n    21\tapiVersion: v1\n    22\tkind: ServiceAccount\n    23\tmetadata:\n    24\t  name: clinic-agent-reminders\n    25\t  namespace: clinic-agent\n    26\t  annotations:\n    27\t    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    28\tautomountServiceAccountToken: false\n    29\t---\n    30\tapiVersion: v1\n    31\tkind: ConfigMap\n    32\tmetadata:\n    33\t  name: clinic-agent\n    34\t  namespace: clinic-agent\n    35\tdata:\n    36\t 