{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0163bFWoQDrxeTCgGRmMgtRY","type":"tool_result","content":"<persisted-output>\nOutput too large (39KB). Full output saved to: /Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-challenger-twobz5zx/c7f3b81a-9de1-4e5a-bc26-5401b3fd868f/tool-results/bk575550t.txt\n\nPreview (first 2KB):\nimport { createHash, randomUUID } from \"node:crypto\";\nimport { readdirSync, readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n\n// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\nconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n\nexport interface TypeIdInputs {\n  imageDigest: string;\n  harnessVersion: string;\n  harnessGitSha: string;\n}\n\nexport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n  const parts: Array<[string, Buffer]> = [\n    [\"image\", Buffer.from(inputs.imageDigest)],\n    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n  ];\n  const promptDir = join(ROOT, \"prompts\");\n  const promptFiles = readdirSync(promptDir)\n    .filter((f) => f.endsWith(\".txt\"))\n    .sort();\n  for (const f of promptFiles) {\n    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n  }\n  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n  for (const f of CONFIG_FILES) {\n    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n  }\n  return parts;\n}\n\nexport function computeAgentTypeId(inputs: TypeIdInputs): string {\n  const h = createHash(\"sha256\");\n  for (const [label, bytes] of typeIdManifest(inputs)) {\n    h.update(label);\n    h.update(\"\\0\");\n    h.update(bytes);\n    h.update(\"\\0\");\n  }\n  return `sha256:${h.digest(\"hex\")}`;\n}\n\n// One instance id per process. Pods are the unit an operator contains.\nexport const AGENT_INSTANCE_ID = randomUUID();\n\nlet AGENT_TYPE_ID = \"\";\nexport function setAgentTypeId(id: string): void {\n  AGENT_TYPE_ID = id;\n}\n\nexport interface Subject {\n  kind: \"patient\" | \"staff\" | \"system\";\n  id: string;\n}\n\nexport interface Logger {\n...\n</persisted-output>","is_error":false}]},"parent_tool_use_id":null,"session_id":"c7f3b81a-9de1-4e5a-bc26-5401b3fd868f","uuid":"99cc8750-7013-46b6-9319-17e46ec88b77","timestamp":"2026-10-02T14:46:57.018Z","tool_use_result":{"stdout":"import { createHash, randomUUID } from \"node:crypto\";\nimport { readdirSync, readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n\n// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\nconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n\nexport interface TypeIdInputs {\n  imageDigest: string;\n  harnessVersion: string;\n  harnessGitSha: string;\n}\n\nexport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n  const parts: Array<[string, Buffer]> = [\n    [\"image\", Buffer.from(inputs.imageDigest)],\n    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n  ];\n  const promptDir = join(ROOT, \"prompts\");\n  const promptFiles = readdirSync(promptDir)\n    .filter((f) => f.endsWith(\".txt\"))\n    .sort();\n  for (const f of promptFiles) {\n    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n  }\n  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n  for (const f of CONFIG_FILES) {\n    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n  }\n  return parts;\n}\n\nexport function computeAgentTypeId(inputs: TypeIdInputs): string {\n  const h = createHash(\"sha256\");\n  for (const [label, bytes] of typeIdManifest(inputs)) {\n    h.update(label);\n    h.update(\"\\0\");\n    h.update(bytes);\n    h.update(\"\\0\");\n  }\n  return `sha256:${h.digest(\"hex\")}`;\n}\n\n// One instance id per process. Pods are the unit an operator contains.\nexport const AGENT_INSTANCE_ID = randomUUID();\n\nlet AGENT_TYPE_ID = \"\";\nexport function setAgentTypeId(id: string): void {\n  AGENT_TYPE_ID = id;\n}\n\nexport interface Subject {\n  kind: \"patient\" | \"staff\" | \"system\";\n  id: string;\n}\n\nexport interface Logger {\n  info(obj: object, msg?: string): void;\n  warn(obj: object, msg?: string): void;\n  error(obj: object, msg?: string): void;\n}\n\nexport interface RunContext {\n  runId: string;\n  tenantId: string;\n  subject: Subject;\n  channel: \"sms\" | \"webchat\" | \"reminder\";\n  traceparent: string;\n  log: Logger;\n  identity(): {\n    accountableParty: string;\n    operationalOwner: string;\n    tenantId: string;\n    agentTypeId: string;\n    agentInstanceId: string;\n    traceparent: string;\n  };\n  workloadToken(): Promise<string>;\n}\n\n// Projected service-account token (audience: the group STS), rotated by the kubelet.\nconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n\nexport function newRunContext(init: {\n  tenantId: string;\n  subject: Subject;\n  channel: RunContext[\"channel\"];\n  traceparent?: string;\n  log: Logger;\n}): RunContext {\n  const runId = randomUUID();\n  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n  return {\n    runId,\n    tenantId: init.tenantId,\n    subject: init.subject,\n    channel: init.channel,\n    traceparent,\n    log: init.log,\n    identity: () => ({\n      accountableParty: env.accountableParty,\n      operationalOwner: env.operationalOwner,\n      tenantId: init.tenantId,\n      agentTypeId: AGENT_TYPE_ID,\n      agentInstanceId: AGENT_INSTANCE_ID,\n      traceparent,\n    }),\n    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n  };\n}\nimport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\nimport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\nimport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\nimport { Agent } from \"undici\";\nimport type { PeerCertificate } from \"node:tls\";\nimport { env } from \"../config.js\";\nimport type { ConfiguredServer } from \"../tools/registry.js\";\nimport type { ServerMeta } from \"../tools/metadata-scan.js\";\n\n// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n\nconst sm = new SecretsManagerClient({ region: env.region });\n\nfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n  const expected = server.tlsCertSha256.toLowerCase();\n  return new Agent({\n    connect: {\n      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n      },\n    },\n  });\n}\n\ntype Token = { value: string; exp: number };\nconst tokens = new Map<string, Token>();\n\nasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n  const cacheKey = `${clinicId}|${scope}`;\n  const hit = tokens.get(cacheKey);\n  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n\n  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n  const res = await fetch(token_url, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n  });\n  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n  const body = (await res.json()) as { access_token: string; expires_in: number };\n  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n  return body.access_token;\n}\n\nconst SCOPES = \"patient.read appointment.read appointment.write\";\nconst sessions = new Map<string, Client>();\n\nasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n  const existing = sessions.get(clinicId);\n  if (existing) return existing;\n  const token = await ehrToken(clinicId, SCOPES);\n  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    requestInit: {\n      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n      dispatcher: pinnedDispatcher(server),\n    },\n  });\n  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n  await client.connect(transport);\n  sessions.set(clinicId, client);\n  setTimeout(() => {\n    sessions.delete(clinicId);\n    void client.close();\n  }, 4 * 60_000).unref();\n  return client;\n}\n\nexport function ehr(server: ConfiguredServer) {\n  return {\n    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n      const c = await session(server, \"_catalog\");\n      const [tools, prompts, templates] = await Promise.all([\n        c.listTools(),\n        c.listPrompts().catch(() => ({ prompts: [] })),\n        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n      ]);\n      return {\n        reportedName: c.getServerVersion()?.name,\n        meta: {\n          instructions: c.getInstructions(),\n          tools: tools.tools as ServerMeta[\"tools\"],\n          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n        },\n      };\n    },\n\n    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n      const c = await session(server, opts.clinicId);\n      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n      return res.structuredContent ?? res.content;\n    },\n\n    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n        id: string;\n        patientId: string;\n        start: string;\n        serviceCode: string;\n        payerId?: string;\n        depositId?: string;\n        status: string;\n      };\n    },\n\n    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n        id: string;\n        patientId: string;\n        start: string;\n        phone: string;\n        smsOptIn: boolean;\n        locationName: string;\n      }>;\n    },\n  };\n}\nexport type Ehr = ReturnType<typeof ehr>;\nimport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\nimport { randomUUID } from \"node:crypto\";\nimport { z } from \"zod\";\nimport { env } from \"../config.js\";\n\n// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n//\n// Authority: for each call we exchange the agent's workload token for a token that is only good\n// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n//\n// Answers come back as a signed attestation (JWS) inside a data part.\n\nconst Eligibility = z\n  .object({\n    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    planName: z.string().max(120).optional(),\n    copayCents: z.number().int().nonnegative().optional(),\n    depositWaived: z.boolean().default(false),\n    checkedAt: z.string().datetime(),\n  })\n  .strict();\nexport type Eligibility = z.infer<typeof Eligibility>;\n\nconst Rpc = z.object({\n  jsonrpc: z.literal(\"2.0\"),\n  id: z.string(),\n  result: z.object({\n    kind: z.literal(\"message\"),\n    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n  }),\n});\n\nasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n  const res = await fetch(env.tokenExchangeUrl, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    body: new URLSearchParams({\n      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n      subject_token: workloadToken,\n      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n      audience: \"eligibility-agent\",\n      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    }),\n  });\n  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n  return ((await res.json()) as { access_token: string }).access_token;\n}\n\nexport async function checkEligibility(\n  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n): Promise<Eligibility> {\n  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n  const requestId = randomUUID();\n  const res = await fetch(env.eligibilityUrl, {\n    method: \"POST\",\n    signal: opts.signal,\n    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    body: JSON.stringify({\n      jsonrpc: \"2.0\",\n      id: requestId,\n      method: \"message/send\",\n      params: {\n        message: {\n          role: \"user\",\n          messageId: requestId,\n          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n        },\n      },\n    }),\n  });\n  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n  const text = await res.text();\n  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n  const rpc = Rpc.parse(JSON.parse(text));\n\n  const attestation = rpc.result.parts[0]!.data.attestation;\n  const header = decodeProtectedHeader(attestation);\n  if (!header.jku) throw new Error(\"attestation missing key set url\");\n  const keys = createRemoteJWKSet(new URL(header.jku));\n  const { payload } = await jwtVerify(attestation, keys, {\n    issuer: env.eligibilityIssuer,\n    audience: \"clinic-agent\",\n    maxTokenAge: \"5m\",\n    algorithms: [\"ES256\"],\n  });\n  return Eligibility.parse(payload.eligibility);\n}\nimport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\nimport { env } from \"../config.js\";\n\n// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n// The provider enforces Idempotency-Key for 24 hours.\n\nconst sm = new SecretsManagerClient({ region: env.region });\nconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n\nasync function key(clinicId: string): Promise<string> {\n  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n}\n\nexport interface Refund {\n  id: string;\n  depositId: string;\n  amountCents: number;\n  status: \"pending\" | \"succeeded\" | \"failed\";\n}\n\nexport const payments = {\n  async refundDeposit(\n    clinicId: string,\n    req: { depositId: string; reason: string; idempotencyKey: string },\n    signal?: AbortSignal,\n  ): Promise<Refund> {\n    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n      method: \"POST\",\n      signal,\n      headers: {\n        authorization: `Bearer ${await key(clinicId)}`,\n        \"content-type\": \"application/json\",\n        \"idempotency-key\": req.idempotencyKey,\n      },\n      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    });\n    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    return (await res.json()) as Refund;\n  },\n};\nimport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\nimport { env } from \"../config.js\";\n\n// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n// can send; free-form text goes through sms__send_freeform, which needs approval.\n\nconst sm = new SecretsManagerClient({ region: env.region });\nconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n\nexport const TEMPLATES = {\n  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n} as const;\nexport type TemplateId = keyof typeof TEMPLATES;\n\nexport function render(id: TemplateId, vars: Record<string, string>): string {\n  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n}\n\nasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n  const v = JSON.parse(s.SecretString ?? \"{}\");\n  return { token: v.api_token, from: v.from_number };\n}\n\nexport const sms = {\n  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n    const c = await creds(clinicId);\n    const res = await fetch(`${BASE}/messages`, {\n      method: \"POST\",\n      signal,\n      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ from: c.from, to, body }),\n    });\n    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n    return (await res.json()) as { messageId: string };\n  },\n};\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { parse } from \"yaml\";\n\nexport const ROOT = process.env.CLINIC_AGENT_ROOT ?? process.cwd();\n\nexport interface Policy {\n  version: string;\n  highImpactTools: string[];\n  approval: { ttlSeconds: number; approverRoles: string[]; table: string };\n}\n\nexport interface AllowlistEntry {\n  tool: string;\n  reason: string;\n}\n\nexport interface Budgets {\n  run: {\n    maxTurns: number;\n    maxWallMs: number;\n    maxInputTokens: number;\n    maxOutputTokens: number;\n    maxCostUsd: number;\n    maxToolCalls: number;\n    maxToolCallsPerMinute: number;\n    maxPeerCalls: number;\n  };\n  quotas: {\n    perSubjectDailyUsd: number;\n    perTenantDailyUsd: number;\n    fleetDailyUsd: number;\n    perTenantToolCallsPerMinute: number;\n    fleetToolCallsPerMinute: number;\n  };\n  pricingUsdPerMTok: Record<string, { input: number; output: number; cacheRead: number; cacheWrite: number }>;\n  onExceed: \"handoff_to_staff\";\n}\n\nfunction loadYaml<T>(rel: string): T {\n  return parse(readFileSync(join(ROOT, rel), \"utf8\")) as T;\n}\n\nexport const policy = loadYaml<Policy>(\"config/policy.yaml\");\nexport const allowlist = loadYaml<{ role: string; tools: AllowlistEntry[] }>(\"config/tools.allowlist.yaml\");\nexport const budgets = loadYaml<Budgets>(\"config/budgets.yaml\");\nexport const manifest = JSON.parse(readFileSync(join(ROOT, \"release/manifest.json\"), \"utf8\"));\n\nexport const AGENT_MODEL = \"claude-sonnet-4-5-20250929\";\nexport const CLASSIFIER_MODEL = \"claude-haiku-4-5-20251001\";\n\nexport const env = {\n  region: process.env.AWS_REGION ?? \"us-west-2\",\n  controlTable: process.env.CONTROL_TABLE ?? \"clinic-agent-control\",\n  budgetTable: process.env.BUDGET_TABLE ?? \"clinic-agent-budgets\",\n  auditStream: process.env.AUDIT_STREAM ?? \"clinic-agent-audit\",\n  smsSigningSecretArn: process.env.SMS_SIGNING_SECRET_ARN ?? \"\",\n  chatJwksUrl: process.env.CHAT_JWKS_URL ?? \"https://auth.northbay-clinics.example/.well-known/jwks.json\",\n  chatIssuer: process.env.CHAT_ISSUER ?? \"https://auth.northbay-clinics.example/\",\n  eligibilityUrl: process.env.ELIGIBILITY_URL ?? \"https://eligibility.partners.northbay-clinics.example/a2a\",\n  eligibilityIssuer: process.env.ELIGIBILITY_ISSUER ?? \"https://eligibility.partners.northbay-clinics.example\",\n  tokenExchangeUrl: process.env.TOKEN_EXCHANGE_URL ?? \"https://sts.northbay-clinics.example/oauth2/token\",\n  accountableParty: \"northbay-clinic-group:patient-access\",\n  operationalOwner: \"team:agent-platform\",\n};\napiVersion: v1\nkind: Namespace\nmetadata:\n  name: clinic-agent\n  labels:\n    pod-security.kubernetes.io/enforce: restricted\n    pod-security.kubernetes.io/enforce-version: v1.33\n    pod-security.kubernetes.io/audit: restricted\n    pod-security.kubernetes.io/warn: restricted\n---\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: clinic-agent\n  namespace: clinic-agent\n  annotations:\n    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\n    eks.amazonaws.com/token-expiration: \"3600\"\nautomountServiceAccountToken: false\n---\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: clinic-agent-reminders\n  namespace: clinic-agent\n  annotations:\n    eks.amazonaws.com/role-arn: arn:aws:iam::418295730611:role/clinic-agent-runtime\nautomountServiceAccountToken: false\n---\napiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: clinic-agent\n  namespace: clinic-agent\ndata:\n  CLINIC_DIRECTORY: |\n    [{\"id\":\"nb-castro\",\"name\":\"Northbay Castro\",\"smsNumber\":\"+14155550110\"},\n     {\"id\":\"nb-fremont\",\"name\":\"Northbay Fremont\",\"smsNumber\":\"+15105550111\"},\n     {\"id\":\"nb-oakland\",\"name\":\"Northbay Oakland\",\"smsNumber\":\"+15105550112\"},\n     {\"id\":\"nb-sanmateo\",\"name\":\"Northbay San Mateo\",\"smsNumber\":\"+16505550113\"},\n     {\"id\":\"nb-walnutcreek\",\"name\":\"Northbay Walnut Creek\",\"smsNumber\":\"+19255550114\"}]\n  SMS_SIGNING_SECRET_ARN: arn:aws:secretsmanager:us-west-2:418295730611:secret:clinic-agent/sms-signing\n  HTTPS_PROXY: http://egress-proxy.platform.svc.cluster.local:3128\n  NO_PROXY: ehr-mcp.internal.northbay-clinics.example,.svc.cluster.local\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: clinic-agent\n  namespace: clinic-agent\n  labels: { app: clinic-agent }\nspec:\n  replicas: 3\n  selector:\n    matchLabels: { app: clinic-agent }\n  template:\n    metadata:\n      labels: { app: clinic-agent }\n    spec:\n      serviceAccountName: clinic-agent\n      automountServiceAccountToken: false\n      hostUsers: false\n      hostNetwork: false\n      hostPID: false\n      hostIPC: false\n      enableServiceLinks: false\n      securityContext:\n        runAsNonRoot: true\n        runAsUser: 65532\n        runAsGroup: 65532\n        fsGroup: 65532\n        seccompProfile:\n          type: RuntimeDefault\n      containers:\n        - name: agent\n          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n          ports:\n            - containerPort: 8080\n          envFrom:\n            - configMapRef: { name: clinic-agent }\n          env:\n            - name: IMAGE_DIGEST\n              value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n            - name: GIT_SHA\n              value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n          securityContext:\n            allowPrivilegeEscalation: false\n            privileged: false\n            readOnlyRootFilesystem: true\n            runAsNonRoot: true\n            capabilities:\n              drop: [\"ALL\"]\n            seccompProfile:\n              type: RuntimeDefault\n          resources:\n            requests: { cpu: 250m, memory: 384Mi }\n            limits: { cpu: \"1\", memory: 768Mi }\n          readinessProbe:\n            httpGet: { path: /healthz, port: 8080 }\n          volumeMounts:\n            - { name: tmp, mountPath: /tmp }\n            - { name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true }\n      volumes:\n        - name: tmp\n          emptyDir: { medium: Memory, sizeLimit: 32Mi }\n        - name: sts-token\n          projected:\n            sources:\n              - serviceAccountToken:\n                  audience: https://sts.northbay-clinics.example\n                  expirationSeconds: 900\n                  path: sts-token\n---\napiVersion: batch/v1\nkind: CronJob\nmetadata:\n  name: clinic-agent-reminders\n  namespace: clinic-agent\nspec:\n  schedule: \"0 17 * * *\"\n  timeZone: America/Los_Angeles\n  concurrencyPolicy: Forbid\n  jobTemplate:\n    spec:\n      backoffLimit: 0\n      activeDeadlineSeconds: 1800\n      template:\n        metadata:\n          labels: { app: clinic-agent-reminders }\n        spec:\n          serviceAccountName: clinic-agent-reminders\n          automountServiceAccountToken: false\n          restartPolicy: Never\n          hostUsers: false\n          securityContext:\n            runAsNonRoot: true\n            runAsUser: 65532\n            runAsGroup: 65532\n            seccompProfile:\n              type: RuntimeDefault\n          containers:\n            - name: reminders\n              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n              args: [\"dist/workers/reminders.js\"]\n              envFrom:\n                - configMapRef: { name: clinic-agent }\n              env:\n                - name: IMAGE_DIGEST\n                  value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n                - name: GIT_SHA\n                  value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70\n              securityContext:\n                allowPrivilegeEscalation: false\n                privileged: false\n                readOnlyRootFilesystem: true\n                capabilities:\n                  drop: [\"ALL\"]\n---\n# Egress: DNS, the EHR MCP endpoint (private link), and the platform egress proxy only.\n# The proxy allows api.anthropic.com, the payments and SMS providers, the eligibility agent,\n# the group STS and auth service, and AWS service endpoints.\napiVersion: networking.k8s.io/v1\nkind: NetworkPolicy\nmetadata:\n  name: clinic-agent-egress\n  namespace: clinic-agent\nspec:\n  podSelector: {}\n  policyTypes: [\"Egress\", \"Ingress\"]\n  ingress:\n    - from:\n        - namespaceSelector:\n            matchLabels: { kubernetes.io/metadata.name: ingress }\n      ports:\n        - { port: 8080, protocol: TCP }\n  egress:\n    - to:\n        - namespaceSelector:\n            matchLabels: { kubernetes.io/metadata.name: kube-system }\n          podSelector:\n            matchLabels: { k8s-app: kube-dns }\n      ports:\n        - { port: 53, protocol: UDP }\n        - { port: 53, protocol: TCP }\n    - to:\n        - namespaceSelector:\n            matchLabels: { kubernetes.io/metadata.name: platform }\n          podSelector:\n            matchLabels: { app: egress-proxy }\n      ports:\n        - { port: 3128, protocol: TCP }\n    - to:\n        - ipBlock: { cidr: 10.60.12.0/28 }\n      ports:\n        - { port: 443, protocol: TCP }\n# Who can change production: only the deploy workflow running in the \"production\" or\n# \"production-emergency\" GitHub environment can assume the deploy role, and both environments\n# require a named reviewer from agent-platform-leads. Nobody else has write access to the\n# clinic-agent namespace (see access_entries in main.tf), and the cluster API is private.\n\nprovider \"github\" {\n  owner = \"northbay-clinics\"\n}\n\ndata \"github_team\" \"leads\" {\n  slug = \"agent-platform-leads\"\n}\n\nresource \"github_branch_protection\" \"main\" {\n  repository_id = \"clinic-agent\"\n  pattern       = \"main\"\n\n  enforce_admins                  = true\n  allows_force_pushes             = false\n  allows_deletions                = false\n  required_linear_history         = true\n  require_signed_commits          = true\n  require_conversation_resolution = true\n\n  required_pull_request_reviews {\n    required_approving_review_count = 2\n    require_code_owner_reviews      = true\n    dismiss_stale_reviews           = true\n    require_last_push_approval      = true\n  }\n\n  required_status_checks {\n    strict   = true\n    contexts = [\"ci / test\", \"ci / manifest-check\"]\n  }\n}\n\nresource \"github_repository_environment\" \"production\" {\n  repository  = \"clinic-agent\"\n  environment = \"production\"\n  reviewers {\n    teams = [data.github_team.leads.id]\n  }\n  prevent_self_review = true\n  deployment_branch_policy {\n    protected_branches     = true\n    custom_branch_policies = false\n  }\n}\n\nresource \"github_repository_environment\" \"production_emergency\" {\n  repository  = \"clinic-agent\"\n  environment = \"production-emergency\"\n  reviewers {\n    teams = [data.github_team.leads.id]\n  }\n  prevent_self_review = true\n  deployment_branch_policy {\n    protected_branches     = false\n    custom_branch_policies = true\n  }\n}\n\nresource \"github_repository_environment_deployment_policy\" \"emergency_branches\" {\n  repository     = \"clinic-agent\"\n  environment    = github_repository_environment.production_emergency.environment\n  branch_pattern = \"hotfix/*\"\n}\n\nresource \"aws_iam_role\" \"deploy\" {\n  name = \"clinic-agent-deploy\"\n  assume_role_policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect    = \"Allow\"\n      Principal = { Federated = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/token.actions.githubusercontent.com\" }\n      Action    = \"sts:AssumeRoleWithWebIdentity\"\n      Condition = {\n        StringEquals = {\n          \"token.actions.githubusercontent.com:aud\" = \"sts.amazonaws.com\"\n          \"token.actions.githubusercontent.com:sub\" = [\n            \"repo:northbay-clinics/clinic-agent:environment:production\",\n            \"repo:northbay-clinics/clinic-agent:environment:production-emergency\",\n          ]\n        }\n      }\n    }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"deploy\" {\n  name = \"clinic-agent-deploy\"\n  role = aws_iam_role.deploy.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [\n      {\n        Effect   = \"Allow\"\n        Action   = [\"ecr:GetAuthorizationToken\"]\n        Resource = \"*\"\n      },\n      {\n        Effect   = \"Allow\"\n        Action   = [\"ecr:BatchCheckLayerAvailability\", \"ecr:PutImage\", \"ecr:InitiateLayerUpload\", \"ecr:UploadLayerPart\", \"ecr:CompleteLayerUpload\", \"ecr:BatchGetImage\"]\n        Resource = aws_ecr_repository.agent.arn\n      },\n      {\n        Effect   = \"Allow\"\n        Action   = [\"eks:DescribeCluster\"]\n        Resource = module.eks.cluster_arn\n      },\n    ]\n  })\n}\n# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:\n# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.\nresource \"aws_iam_role\" \"runtime\" {\n  name                 = \"clinic-agent-runtime\"\n  max_session_duration = 3600\n  assume_role_policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect    = \"Allow\"\n      Principal = { Federated = module.eks.oidc_provider_arn }\n      Action    = \"sts:AssumeRoleWithWebIdentity\"\n      Condition = {\n        StringEquals = {\n          \"${module.eks.oidc_provider}:sub\" = [\n            \"system:serviceaccount:clinic-agent:clinic-agent\",\n            \"system:serviceaccount:clinic-agent:clinic-agent-reminders\",\n          ]\n          \"${module.eks.oidc_provider}:aud\" = \"sts.amazonaws.com\"\n        }\n      }\n    }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"runtime\" {\n  name = \"clinic-agent-runtime\"\n  role = aws_iam_role.runtime.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [\n      {\n        Sid      = \"ReadClinicSecrets\"\n        Effect   = \"Allow\"\n        Action   = [\"secretsmanager:GetSecretValue\"]\n        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\n      },\n      {\n        Sid    = \"AgentState\"\n        Effect = \"Allow\"\n        Action = [\n          \"dynamodb:GetItem\",\n          \"dynamodb:BatchGetItem\",\n          \"dynamodb:PutItem\",\n          \"dynamodb:UpdateItem\",\n          \"dynamodb:Query\",\n        ]\n        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agen","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-challenger-twobz5zx/c7f3b81a-9de1-4e5a-bc26-5401b3fd868f/tool-results/bk575550t.txt","persistedOutputSize":39916}}
