n \"lead_role\": \"agent_team\"\n}\nNC [{\"problem\": \"Denied actions not recorded in the audit trail\", \"owner\": \"R13\"}, {\"problem\": \"Approvals that can be replayed, reused in parallel, or used after expiry\", \"owner\": \"B06\"}, {\"problem\": \"Outside effects left unreconciled after the agent is stopped\", \"owner\": \"R12\"}, {\"problem\": \"A chain of individually allowed actions that adds up to data theft\", \"owner\": \"R09\"}, {\"problem\": \"Tool output not labelled or kept apart from trusted instructions\", \"owner\": \"R02\"}]\n{\n \"item\": \"B09\",\n \"gate\": \"G2\",\n \"title\": \"Egress allowlist\",\n \"requirement\": \"Allow only the outside destinations the task needs. Test a blocked destination and ways around the block, such as going straight past a proxy or gateway. Cover redirects, DNS changes and rebinding, IPv4 and IPv6, and cloud metadata or loopback addresses where they apply. An allowed domain can still host an attacker's account or receive leaked data. So also limit which resources and tenants the agent can reach, and what data it can send. Record each block and confirm the right operator hears about it.\",\n \"rating\": \"gap\",\n \"confidence\": \"medium\",\n \"evidence\": [\n  {\n   \"file\": \"k8s/deployment.yaml\",\n   \"line\": 193,\n   \"note\": \"NetworkPolicy blocks routes around the proxy\"\n  }\n ],\n \"checks\": [\n  {\n   \"id\": \"B09.1\",\n   \"check\": \"Outbound traffic is default-deny, with a destination allowlist enforced at a proxy, gateway, or network policy.\",\n   \"verify\": \"1) Find egress rules (NetworkPolicy egress, Cilium FQDN, proxy ACLs, cloud firewall). 2) Check outbound is default deny with a destination allowlist. 3) Answer no if egress allows `0.0.0.0/0` or broad CIDRs, no egress rules exist, or the allowlist is only in app code the agent runs. Answer unknown if egress is set outside this repo.\",\n   \"met\": \"unknown\",\n   \"evidence\": \"\",\n   \"quote\": \"\",\n   \"counter_search\": \"\",\n   \"note\": \"[challenge: unclear] The NetworkPolicy is default-deny and allows only DNS, the platform egress-proxy on 3128, and one /28 on 443. The destination allowlist is in the platform proxy, which is not in this repo (only described in the comment at lines 159-161).\"\n  },\n  {\n   \"id\": \"B09.2\",\n   \"check\": \"Network policy blocks direct routes around the proxy or gateway, for both IPv4 and IPv6.\",\n   \"verify\": \"1) Check whether the proxy is enforced by network policy or only by `HTTP_PROXY`/`HTTPS_PROXY` env. 2) Check IPv6 egress rules. 3) Answer no if pods can reach the internet except via the proxy, the proxy is only an env var, `NO_PROXY` is broad, or IPv6 is not restricted.\",\n   \"met\": \"yes\",\n   \"evidence\": \"k8s/deployment.yaml:193\",\n   \"quote\": \"ipBlock: { cidr: 10.60.12.0/28 }\",\n   \"counter_search\": \"Checked whether the proxy is env-only; policy limits egress to DNS, proxy pods and one IPv4 /28, NO_PROXY is narrow, and no IPv6 rule is allowed.\",\n   \"note\": \"NetworkPolicy blocks routes around the proxy\"\n  },\n  {\n   \"id\": \"B09.3\",\n   \"check\": \"Redirect targets and resolved IP addresses are checked against the allowlist, and cloud metadata and loopback addresses are blocked.\",\n   \"verify\": \"1) Find fetch and HTTP client code (`requests`, `fetch`, `http.Client`, `follow_redirects`, `allow_redirects`). 2) Check each redirect hop and resolved IP is checked. 3) Answer no if redirects are followed unchecked, the check uses the hostname but not the resolved IP, or 169.254.169.254, fd00:ec2::254, or 127.0.0.0/8 and ::1 are not blocked.\",\n   \"met\": \"no\",\n   \"evidence\": \"src/integrations/eligibility-a2a.ts:83, src/integrations/eligibility-a2a.ts:58\",\n   \"quote\": \"  const keys = createRemoteJWKSet(new URL(header.jku));\\n  const res = await fetch(env.eligibilityUrl, {\",\n   \"counter_search\": \"\",\n   \"note\": \"[challenge] The jku URL is taken from the unverified attestation header, which the peer controls, and the app fetches it with no host allowlist, resolved-IP check or metadata/loopback block. The fetch calls use default redirect-following with no per-hop check. The only controls would be in the external proxy, so this destination is not constrained in the repo.\"\n  },\n  {\n   \"id\": \"B09.4\",\n   \"check\": \"Allowed destinations are limited by resource, tenant, or path where needed, not only by domain.\",\n   \"verify\": \"1) List allowed destinations that are shared services (S3, GitHub, storage, paste sites). 2) Check rules limit bucket, account, repo, tenant, or path. 3) Answer no if a shared service is allowed by domain or wildcard (`*.s3.amazonaws.com`) alone, or path checks use string prefix without normalising.\",\n   \"met\": \"unknown\",\n   \"evidence\": \"\",\n   \"quote\": \"\",\n   \"counter_search\": \"\",\n   \"note\": \"[challenge: unclear] The per-resource and tenant rules would be in the platform proxy, which is not in this repo. The comment also lists 'AWS service endpoints' as allowed, with no visible resource limit.\"\n  },\n  {\n   \"id\": \"B09.5\",\n   \"check\": \"Each blocked request is logged and routed as an alert to a named operator.\",\n   \"verify\": \"1) Find where blocked requests are logged (proxy deny log, policy audit, app code). 2) Find the alert route to a named operator. 3) Answer no if blocks are not logged, only allowed requests are logged, or no alert route names an operator. Answer unknown if alerting lives outside this repo.\",\n   \"met\": \"unknown\",\n   \"evidence\": \"\",\n   \"quote\": \"\",\n   \"counter_search\": \"\",\n   \"note\": \"[challenge: unclear] Blocked-request logging and alert routing to a named operator are not in this repo.\"\n  }\n ],\n \"red_flags_found\": [\n  \"src/integrations/eligibility-a2a.ts:83, src/integrations/eligibility-a2a.ts:58 The jku URL is taken from the unverified attestation header, which the peer controls, and the app fetches it with no host allowlist,