 - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0\n    54\t        with:\n    55\t          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-deploy\n    56\t          aws-region: us-west-2\n    57\t\n    58\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    59\t        with:\n    60\t          cosign-release: v2.6.2\n    61\t\n    62\t      - name: Verify image signature\n    63\t        run: |\n    64\t          DIGEST=$(jq -r .image.digest release/manifest.json)\n    65\t          REPO=$(jq -r .image.repository release/manifest.json)\n    66\t          cosign verify \"$REPO@$DIGEST\" \\\n    67\t            --certificate-identity \"https://github.com/northbay-clinics/clinic-agent/.github/workflows/ci.yml@refs/heads/main\" \\\n    68\t            --certificate-oidc-issuer https://token.actions.githubusercontent.com\n    69\t          grep -q \"$DIGEST\" k8s/deployment.yaml || { echo \"k8s/deployment.yaml does not use the manifest digest\"; exit 1; }\n    70\t\n    71\t      - name: Apply\n    72\t        run: |\n    73\t          aws eks update-kubeconfig --name clinic-agent-prod\n    74\t          kubectl apply -f k8s/deployment.yaml\n    75\t          kubectl -n clinic-agent annotate deployment/clinic-agent --overwrite \\\n    76\t            northbay.example/git-sha=\"$GITHUB_SHA\" \\\n    77\t            northbay.example/release=\"$(jq -r .release release/manifest.json)\" \\\n    78\t            northbay.example/deployed-by=\"$GITHUB_ACTOR\" \\\n    79\t            northbay.example/run=\"$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID\"\n    80\t          kubectl -n clinic-agent rollout status deployment/clinic-agent --timeout=5m\n    81\t\n    82\t      - name: Open follow-up review for emergency change\n    83\t        if: inputs.emergency\n    84\t        env:\n    85\t          GH_TOKEN: ${{ github.token }}\n    86\t          OWNER: ${{ inputs.owner }}\n    87\t          REASON: ${{ inputs.reason }}\n    88\t          EXPIRES_ON: ${{ inputs.expires_on }}\n    89\t        run: |\n    90\t          gh issue create \\\n    91\t            --title \"Follow-up review: emergency deploy ${GITHUB_SHA::8}\" \\\n    92\t            --label emergency-change,needs-review \\\n    93\t            --assignee \"$OWNER\" \\\n    94\t            --body \"Owner: $OWNER\n    95\t          Reason: $REASON\n    96\t          Ends: $EXPIRES_ON\n    97\t          Commit: $GITHUB_SHA\n    98\t          Approved in environment production-emergency by a required reviewer (see run $GITHUB_RUN_ID).\n    99\t          Review and merge to main via normal PR before the end date.\"\n1-terraform {\n2:  required_version = \">= 1.9.0\"\n3-  required_providers {\n4:    aws    = { source = \"hashicorp/aws\", version = \"~> 6.14\" }\n5:    github = { source = \"integrations/github\", version = \"~> 6.6\" }\n6-  }\n7-  backend \"s3\" {\n8-    bucket         = \"northbay-tfstate-418295730611\"\n9-    key            = \"clinic-agent/prod.tfstate\"\n--\n34-\n35-module \"eks\" {\n36:  source  = \"terraform-aws-modules/eks/aws\"\n37:  version = \"21.3.1\"\n38-\n39-  name               = \"clinic-agent-prod\"\n40:  kubernetes_version = \"1.33\"\n41-  vpc_id             = module.vpc.vpc_id\n42-  subnet_ids         = module.vpc.private_subnets\n43-\n44-  endpoint_public_access = false\n--\n74-\n75-module \"vpc\" {\n76:  source  = \"terraform-aws-modules/vpc/aws\"\n77:  version = \"6.4.0\"\n78-\n79-  name            = \"clinic-agent-prod\"\n80-  cidr            = \"10.42.0.0/16\"\n81-  azs             = [\"us-west-2a\", \"us-west-2b\", \"us-west-2c\"]\n--\n87-}\n88-\n89:resource \"aws_ecr_repository\" \"agent\" {\n90-  name                 = \"clinic-agent\"\n91-  image_tag_mutability = \"IMMUTABLE\"\n92-  image_scanning_configuration { scan_on_push = true }\n93-}\n--\n95-# State tables. Approvals are written by the staff console; budgets by the agent; the control\n96-# table holds the stop flags operators set.\n97:resource \"aws_dynamodb_table\" \"approvals\" {\n98-  name         = \"clinic-agent-approvals\"\n99-  billing_mode = \"PAY_PER_REQUEST\"\n100-  hash_key     = \"id\"\n101-  attribute {\n--\n106-}\n107-\n108:resource \"aws_dynamodb_table\" \"budgets\" {\n109-  name         = \"clinic-agent-budgets\"\n110-  billing_mode = \"PAY_PER_REQUEST\"\n111-  hash_key     = \"pk\"\n112-  attribute {\n--\n120-}\n121-\n122:resource \"aws_dynamodb_table\" \"control\" {\n123-  name         = \"clinic-agent-control\"\n124-  billing_mode = \"PAY_PER_REQUEST\"\nk8s/deployment.yaml:76:          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\nk8s/deployment.yaml:143:              image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8\n(eval):1: no matches found: --include=*.ts","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
