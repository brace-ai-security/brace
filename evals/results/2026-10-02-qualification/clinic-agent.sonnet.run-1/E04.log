?? res.content;\n    39\t    },\n    40\t\n    41\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n    42\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n    43\t        id: string;\n    44\t        patientId: string;\n    45\t        start: string;\n    46\t        serviceCode: string;\n    47\t        payerId?: string;\n    48\t        depositId?: string;\n    49\t        status: string;\n    50\t      };\n    51\t    },\n    52\t\n    53\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n    54\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n    55\t        id: string;\n    56\t        patientId: string;\n    57\t        start: string;\n    58\t        phone: string;\n    59\t        smsOptIn: boolean;\n    60\t        locationName: string;\n    61\t      }>;\nconst servers: ConfiguredServer[] = manifest.tools.mcpServers;\nconst ehrServer = servers.find((s) => s.id === \"ehr\");\nif (!ehrServer) throw new Error(\"release manifest has no ehr server\");\nconst ehr = ehrClient(ehrServer);\n\nconst registry = new ToolRegistry(servers);\nfor (const [serverId, tools] of Object.entries(nativeTools(ehr))) registry.registerNative(serverId, tools);\ntry {\n  const { reportedName, meta } = await ehr.catalog();\n  registry.registerMcp(\"ehr\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\n} catch (err) {\n  app.log.error({ err }, \"EHR MCP catalog unavailable; EHR tools disabled\");\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"f6f98e29-b240-4bc1-a995-33ed4be63bb0","uuid":"e73a6ef3-3a75-446d-ab68-2e3901662199","timestamp":"2026-10-02T14:52:32.613Z","tool_use_result":{"stdout":"     1\t      dispatcher: pinnedDispatcher(server),\n     2\t    },\n     3\t  });\n     4\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n     