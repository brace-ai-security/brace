erId, reason: `metadata scan error: ${(err as Error).message}` });\n 117        return;\n 118      }\n 119      if (scan.serverRejected) {\n 120        this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });\n 121        return;\n 122      }\n 123      for (const [tool, findings] of scan.rejectedTools) {\n 124        this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });\n 125      }\n 126      for (const t of scan.acceptedTools) {\n 127        this.add({\n 128>         key: `${serverId}__${t.name}`,\n 129          serverId,\n 130          name: t.name,\n 131          definition: toDefinition(`${serverId}__${t.name}`, t),\n 132          invoke: (input, opts) => invoke(t.name, input, opts),\n 133        });\n 134      }\n 135    }\n 136  \n 137    private add(t: RegisteredTool): void {\n 138      if (this.tools.has(t.key)) {\n 139        this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: \"duplicate\" });\n 140        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: \"duplicate tool key\" });\n```\n\n## E05.2\n\n**Check:** The registry flags duplicate and lookalike tool names across servers.\n\n**How to verify:** 1) Open tool registration code. 2) Look for a check that compares new tool names across servers for duplicates and lookalikes (case, homoglyphs, separators). 3) Answer no if registration silently overwrites or accepts duplicates.\n\n**Reviewer's evidence:** src/tools/registry.ts:151 — \"if (editDistanceAtMostOne(canonical(existing.name), c)) {\"\n\n**Reviewer's note:** Duplicate and lookalike names are flagged and rejected\n\n`src/tools/registry.ts` lines 139–163 (cited lines marked >):\n```\n 139        this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: \"duplicate\" });\n 140        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: \"duplicate tool key\" });\n 141        return;\n 142      }\n 143      const c = canonical(t.name);\n 144      for (const existing of this.tools.values()) {\n 145        if (existing.serverId === t.serverId) continue;\n 146        if (existing.name === t.name) {\n 147          this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"duplicate\" });\n 148          this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });\n 149          return;\n 150        }\n 151>       if (editDistanceAtMostOne(canonical(existing.name), c)) {\n 152          this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"lookalike\" });\n 153          this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `looks like ${existing.key}` });\n 154          return;\n 155        }\n 156      }\n 157      this.tools.set(t.key, t);\n 158    }\n 159  }\n 160  \n 161  function toDefinition(key: string, t: ToolMeta): Anthropic.Tool {\n 162    return {\n 163      name: key,\n```\n\n## E05.3\n\n**Check:** Approval is bound to the verified server identity, so a new server with a matching tool name or self-reported name does not inherit approval or replace the approved tool.\n\n**How to verify:** 1) Find where tool approval is stored and checked. 2) Check approval is keyed by verified server identity, not tool name or self-reported server name. 3) Answer no if a new server with a matching tool name or server name would count as approved or replace the approved tool.\n\n**Reviewer's evidence:** config/policy.yaml:6 — \"- ehr__cancel_appointment\"\n\n**Reviewer's note:** Approval keyed by server id plus tool name\n\n`config/policy.yaml` lines 1–16 (cited lines marked >):\n```\n   1  # Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).\n   2  policyVersion: \"2026-09-18.3\"\n   3  \n   4  # Tools that never run without a staff approval bound to the request.\n   5  highImpactTools:\n   6>   - ehr__cancel_appointment\n   7    - payments__refund_deposit\