{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UnSNS51GVE5XwMKzyZueHa","type":"tool_result","content":"1\timport Anthropic from \"@anthropic-ai/sdk\";\n2\timport { readFileSync } from \"node:fs\";\n3\timport { join } from \"node:path\";\n4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n7\timport { executeTool } from \"../tools/executor.js\";\n8\timport type { ToolRegistry } from \"../tools/registry.js\";\n9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n10\timport { classifyIntent } from \"./classifier.js\";\n11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n12\timport type { RunContext } from \"./identity.js\";\n13\t\n14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n16\tconst quotaStore = new DynamoQuotaStore();\n17\t\n18\texport interface AgentReply {\n19\t  text: string;\n20\t  handoff: null | { reason: string };\n21\t}\n22\t\n23\tfunction escapeTags(s: string): string {\n24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n25\t}\n26\t\n27\texport async function runAgent(\n28\t  registry: ToolRegistry,\n29\t  ctx: RunContext,\n30\t  clinic: { name: string },\n31\t  patientText: string,\n32\t): Promise<AgentReply> {\n33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n37\t\n38\t  try {\n39\t    await killSwitch.assertRunning(ctx.tenantId);\n40\t\n41\t    const intent = await classifyIntent(anthropic, patientText);\n42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n44\t    if (intent.route === \"staff\") {\n45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n47\t    }\n48\t\n49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n50\t    const tools = registry.definitions();\n51\t    const messages: Anthropic.MessageParam[] = [\n52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n53\t    ];\n54\t\n55\t    for (;;) {\n56\t      budget.turn();\n57\t      await killSwitch.assertRunning(ctx.tenantId);\n58\t\n59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n62\t      const contextSize = completeFromUsage(pre, res.usage);\n63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n64\t\n65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n66\t      await audit.record({\n67\t        ...ident(),\n68\t        event: \"model.decision\",\n69\t        context: contextSize,\n70\t        detail: {\n71\t          servedModel: res.model,\n72\t          stopReason: res.stop_reason,\n73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n74\t          span: spanAttributes(contextSize),\n75\t        },\n76\t      });\n77\t\n78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n79\t        const text = res.content\n80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n81\t          .map((b) => b.text)\n82\t          .join(\"\\n\")\n83\t          .slice(0, 320);\n84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n85\t        return { text, handoff: null };\n86\t      }\n87\t\n88\t      messages.push({ role: \"assistant\", content: res.content });\n89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n90\t      for (const call of toolUses) {\n91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n92\t      }\n93\t      messages.push({ role: \"user\", content: results });\n94\t    }\n95\t  } catch (err) {\n96\t    const reason =\n97\t      err instanceof BudgetExceeded\n98\t        ? `budget:${err.limit}`\n99\t        : err instanceof Halted\n100\t          ? `halted:${err.scope}`\n101\t          : err instanceof AuditUnavailable\n102\t            ? \"audit_unavailable\"\n103\t            : budget.signal.aborted\n104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n106\t    try {\n107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n108\t    } catch {\n109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n110\t    }\n111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n112\t  } finally {\n113\t    budget.dispose();\n114\t    unregister();\n115\t  }\n116\t}\n117\t"}]},"parent_tool_use_id":null,"session_id":"e7e91a56-8e26-4882-b939-10679f6422bd","uuid":"949e30a4-d02a-4f07-883a-cae976bec045","timestamp":"2026-10-02T14:33:00.633Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-repeat-kcdj20d6/agent/src/agent/loop.ts","content":"import Anthropic from \"@anthropic-ai/sdk\";\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\nimport { audit, AuditUnavailable } from \"../audit/recorder.js\";\nimport { Halted, killSwitch } from \"../control/kill-switch.js\";\nimport { executeTool } from \"../tools/executor.js\";\nimport type { ToolRegistry } from \"../tools/registry.js\";\nimport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\nimport { classifyIntent } from \"./classifier.js\";\nimport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\nimport type { RunContext } from \"./identity.js\";\n\nconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\nconst anthropic = new Anthropic({ maxRetries: 1 });\nconst quotaStore = new DynamoQuotaStore();\n\nexport interface AgentReply {\n  text: string;\n  handoff: null | { reason: string };\n}\n\nfunction escapeTags(s: string): string {\n  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n}\n\nexport async function runAgent(\n  registry: ToolRegistry,\n  ctx: RunContext,\n  clinic: { name: string },\n  patientText: string,\n): Promise<AgentReply> {\n  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n\n  try {\n    await killSwitch.assertRunning(ctx.tenantId);\n\n    const intent = await classifyIntent(anthropic, patientText);\n    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    if (intent.route === \"staff\") {\n      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    }\n\n    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    const tools = registry.definitions();\n    const messages: Anthropic.MessageParam[] = [\n      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    ];\n\n    for (;;) {\n      budget.turn();\n      await killSwitch.assertRunning(ctx.tenantId);\n\n      const req = { model: AGENT_MODEL, system, tools, messages };\n      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n      const contextSize = completeFromUsage(pre, res.usage);\n      await budget.recordUsage(res.usage, AGENT_MODEL);\n\n      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n      await audit.record({\n        ...ident(),\n        event: \"model.decision\",\n        context: contextSize,\n        detail: {\n          servedModel: res.model,\n          stopReason: res.stop_reason,\n          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n          span: spanAttributes(contextSize),\n        },\n      });\n\n      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n        const text = res.content\n          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n          .map((b) => b.text)\n          .join(\"\\n\")\n          .slice(0, 320);\n        await audit.record({ ...ident(), event: \"run.completed\" });\n        return { text, handoff: null };\n      }\n\n      messages.push({ role: \"assistant\", content: res.content });\n      const results: Anthropic.ToolResultBlockParam[] = [];\n      for (const call of toolUses) {\n        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n      }\n      messages.push({ role: \"user\", content: results });\n    }\n  } catch (err) {\n    const reason =\n      err instanceof BudgetExceeded\n        ? `budget:${err.limit}`\n        : err instanceof Halted\n          ? `halted:${err.scope}`\n          : err instanceof AuditUnavailable\n            ? \"audit_unavailable\"\n            : budget.signal.aborted\n              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n              : `error:${(err as Error).message.slice(0, 200)}`;\n    try {\n      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n    } catch {\n      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n    }\n    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n  } finally {\n    budget.dispose();\n    unregister();\n  }\n}\n","numLines":117,"startLine":1,"totalLines":117}}}
