warded to a tool.\n    22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n    23\t\n    24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n    25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n    26\t}\n    27\t\n    28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n    29\t  return `${tool}(${Object.entries(args)\n    30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    31\t    .join(\", \")})`.slice(0, 500);\n    32\t}\n    33\t\n    34\texport async function executeTool(\n    35\t  registry: ToolRegistry,\n    36\t  ctx: RunContext,\n    37\t  call: Anthropic.ToolUseBlock,\n    38\t  d: Decision,\n    39\t): Promise<Anthropic.ToolResultBlockParam> {\n    40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n    41\t  const base = {\n    42\t    ...ctx.identity(),\n    43\t    runId: ctx.runId,\n    44\t    subject: ctx.subject,\n    45\t    tool: call.name,\n    46\t    toolUseId: call.id,\n    47\t    policyVersion: policy.version,\n    48\t    context: d.contextSize,\n    49\t  };\n    50\t  const deny = async (reason: string) => {\n    51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n    52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n    53\t  };\n    54\t\n    55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n    56\t  const tool = registry.get(call.name);\n    57\t  if (!tool) return deny(\"not_registered\");\n    58\t\n    59\t  await killSwitch.assertRunning(ctx.tenantId);\n    60\t  await d.budget.toolCall(call.name);\n    61\t\n    62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n    63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n    64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n    65\t\n    66\t  let approvalId: string | undefined;\n    67\t  if (policy.highImpactTools.includes(call.name)) {\n    68\t    if (typeof input.approvalId !== \"string\") {\n    69\t      const rec = await requestApproval({\n    70\t        tool: call.name,\n    71\t        tenantId: clinicId,\n    72\t        agentInstanceId: AGENT_INSTANCE_ID,\n    73\t        runId: ctx.runId,\n    74\t        args,\n    75\t        summary: summarize(call.name, args),\n    76\t      });\n    77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n    78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    79\t    }\n    80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    81\t    if (!check.ok) return deny(check.reason);\n    82\t    approvalId = check.approval.id;\n    83\t  }\n    84\t\n    85\t  try {\n    86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    88\t    const safe = redactPhi(raw);\n    89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    90\t    return toolResult(call.id, safe);\n    91\t  } catch (err) {\n    92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n    95\t  }\n    96\t}\n    97\t\n    98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n    99\t\n   100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n   101\t  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n   102\t    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n   103\t\n   104\t  return {\n   105\t    payments: [\n   106\t      {\n   107\t        name: \"refund_deposit\",\n   108\t        definition: {\n   109\t          name: \"payments__refund_deposit\",\n   110\t          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n   111\t          input_schema: {\n   112\t            type: \"object\",\n   113\t            properties: {\n   114\t              depositId: { type: \"string\" },\n   115\t              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n   116\t              approvalId: { type: \"string\" },\n   117\t            },\n   118\t            required: [\"depositId\", \"reason\"],\n   119\t          },\n   120\t        },\n   121\t        invoke: async (a, o) =>\n   122\t          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n   123\t      },\n   124\t    ],\n   125\t    sms: [\n   126\t      {\n   127\t        name: \"send_to_patient\",\n   128\t        definition: {\n   129\t          name: \"sms__send_to_patient\",\n   130\t          description: \"Send a templated SMS to the phone number on the patient's record.\",\n   131\t          input_schema: {\n   132\t            type: \"object\",\n   133\t            properties: {\n   134\t              patientId: { type: \"string\" },\n   135\t              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n   136\t              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n   137\t            },\n   138\t            required: [\"patientId\", \"template\"],\n   139\t          },\n   140\t        },\n   141\t        invoke: async (a, o) => {\n   142\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   143\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   144\t          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n   145\t          return sms.send(o.clinicId, c.phone, body, o.signal);\n   146\t        },\n   147\t      },\n   148\t      {\n   149\t        name: \"send_freeform\",\n   150\t        definition: {\n   151\t          name: \"sms__send_freeform\",\n   152\t          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n   153\t          input_schema: {\n   154\t            type: \"object\",\n   155\t            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n   156\t            required: [\"patientId\", \"body\"],\n   157\t          },\n   158\t        },\n   159\t        invoke: async (a, o) => {\n   160\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   161\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   162\t          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n   163\t        },\n   164\t      },\n   165\t    ],\n   166\t    insurance: [\n   167\t      {\n   168\t        name: \"check_eligibility\",\n   169\t        definition: {\n   170\t          name: \"insurance__check_eligibility\",\n   171\t          description: \"Check whether the patient's insurance covers an appointment.\",\n   172\t          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n   173\t        },\n   174\t        invoke: async (a, o) =>\n   175\t          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n   176\t            clinicId: o.clinicId,\n   177\t            ctx: o.runCtx as RunContext,\n   178\t            signal: o.signal,\n   179\t            context: o.context,\n   180\t          }),\n   181\t      },\n   182\t    ],\n   183\t  };\n   184\t}\n=== src/tools/registry.ts\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport type { ContextSize } from \"../agent/context-size.js\";\n     3\timport { scanServer, type ServerMeta, type ToolMeta } from \"./metadata-scan.js\";\n     4\t\n     5\t// Tool identity is \"<serverId>__<toolName>\", where serverId is the id this deployment assigned in\n     6\t// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about\n     7\t// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.\n     8\t// Only servers listed in the manifest can contribute tools.\n     9\t\n    10\texport interface ConfiguredServer {\n    11\t  id: string;\n    12\t  url: string;\n    13\t  tlsCertSha256: string;\n    14\t}\n    15\t\n    16\texport interface InvokeOptions {\n    17\t  clinicId: string;\n    18\t  signal: AbortSignal;\n    19\t  runCtx: unknown;\n    20\t  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */\n    21\t  context: ContextSize;\n    22\t}\n    23\t\n    24\texport interface RegisteredTool {\n    25\t  key: string;\n    26\t  serverId: string;\n    27\t  name: string;\n    28\t  definition: Anthropic.Tool;\n    29\t  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;\n    30\t}\n    31\t\n    32\texport interface Conflict {\n    33\t  key: string;\n    34\t  conflictsWith: string;\n    35\t  kind: \"duplicate\" | \"lookalike\";\n    36\t}\n    37\t\n    38\tconst CONFUSABLES: Record<string, string> = { \"0\": \"o\", \"1\": \"l\", \"3\": \"e\", \"5\": \"s\", \"7\": \"t\", \"@\": \"a\", \"$\": \"s\" };\n    39\t\n    40\texport function canonical(name: string): string {\n    41\t  return name\n    42\t    .normalize(\"NFKC\")\n    43\t    .toLowerCase()\n    44\t    .replace(/rn/g, \"m\")\n    45\t    .replace(/vv/g, \"w\")\n    46\t    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)\n    47\t    .replace(/[^a-z]/g, \"\");\n    48\t}\n    49\t\n    50\tfunction editDistanceAtMostOne(a: string, b: string): boolean {\n    51\t  if (a === b) return true;\n    52\t  if (Math.abs(a.length - b.length) > 1) return false;\n    53\t  let i = 0;\n    54\t  let j = 0;\n    55\t  let edits = 0;\n    56\t  while (i < a.length && j < b.length) {\n    57\t    if (a[i] === b[j]) {\n    58\t      i++;\n    59\t      j++;\n    60\t      continue;\n    61\t    }\n    62\t    if (++edits > 1) return false;\n    63\t    if (a.length > b.length) i++;\n    64\t    else if (b.length > a.length) j++;\n    65\t    else {\n    66\t      i++;\n    67\t      j++;\n    68\t    }\n    69\t  }\n    70\t  return edits + (a.length - i) + (b.length - j) <= 1;\n    71\t}\n    72\t\n    73\texport class ToolRegistry {\n    74\t  private tools = new Map<string, RegisteredTool>();\n    75\t  readonly conflicts: Conflict[] = [];\n    76\t  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];\n    77\t\n    78\t  constructor(private servers: ConfiguredServer[]) {}\n    79\t\n    80\t  get(key: string): RegisteredTool | undefined {\n    81\t    return this.tools.get(key);\n    82\t  }\n    83\t\n    84\t  definitions(): Anthropic.Tool[] {\n    85\t    return [...this.tools.values()].map((t) => t.definition);\n    86\t  }\n    87\t\n    88\t  bareNamesExcept(serverId: string): Set<string> {\n    89\t    return new Set([...this.tools.values()].filter((t) => t.serverId !== serverId).map((t) => t.name));\n    90\t  }\n    91\t\n    92\t  /** Native tools are registered first so MCP metadata that names them is caught by the scanner. */\n    93\t  registerNative(serverId: string, tools: Array<Omit<RegisteredTool, \"key\" | \"serverId\">>): void {\n    94\t    for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\n    95\t  }\n    96\t\n    97\t  /**\n    98\t   * serverId must be one of the configured servers, and the caller must have connected using that\n    99\t   * server's pinned URL and certificate. reportedName is informational only.\n   100\t   */\n   101\t  registerMcp(\n   102\t    serverId: string,\n   103\t    reportedName: string | undefined,\n   104\t    meta: ServerMeta,\n   105\t    invoke: (tool: string, input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>,\n   106\t  ): void {\n   107\t    const cfg = this.servers.find((s) => s.id === serverId);\n   108\t    if (!cfg) {\n   109\t      this.rejected.push({ serverId, reason: `server not in release manifest (reported name ${reportedName ?? \"none\"})` });\n   110\t      return;\n   111\t    }\n   112\t    let scan;\n   113\t    try {\n   114\t      scan = scanServer(meta, this.bareNamesExcept(serverId));\n   115\t    } catch (err) {\n   116\t      this.rejected.push({ serverId, reason: `metadata scan error: ${(err as Error).message}` });\n   117\t      return;\n   118\t    }\n   119\t    if (scan.serverRejected) {\n   120\t      this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });\n   121\t      return;\n   122\t    }\n   123\t    for (const [tool, findings] of scan.rejectedTools) {\n   124\t      this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });\n   125\t    }\n   126\t    for (const t of scan.acceptedTools) {\n   127\t      this.add({\n   128\t        key: `${serverId}__${t.name}`,\n   129\t        serverId,\n   130\t        name: t.name,\n   131\t        definition: toDefinition(`${serverId}__${t.name}`, t),\n   132\t        invoke: (input, opts) => invoke(t.name, input, opts),\n   133\t      });\n   134\t    }\n   135\t  }\n   136\t\n   137\t  private add(t: RegisteredTool): void {\n   138\t    if (this.tools.has(t.key)) {\n   139\t      this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: \"duplicate\" });\n   140\t      this.rejected.push({ serverId: t.serverId, tool: t.name, reason: \"duplicate tool key\" });\n   141\t      return;\n   142\t    }\n   143\t    const c = canonical(t.name);\n   144\t    for (const existing of this.tools.values()) {\n   145\t      if (existing.serverId === t.serverId) continue;\n   146\t      if (existing.name === t.name) {\n   147\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"duplicate\" });\n   148\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });\n   149\t        return;\n   150\t      }\n   151\t      if (editDistanceAtMostOne(canonical(existing.name), c)) {\n   152\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"lookalike\" });\n   153\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `looks like ${existing.key}` });\n   154\t        return;\n   155\t      }\n   156\t    }\n   157\t    this.tools.set(t.key, t);\n   158\t  }\n   159\t}\n   160\t\n   161\tfunction toDefinition(key: string, t: ToolMeta): Anthropic.Tool {\n   162\t  return {\n   163\t    name: key,\n   164\t    description: t.description ?? \"\",\n   165\t    input_schema: (t.inputSchema as Anthropic.Tool.InputSchema) ?? { type: \"object\", properties: {} },\n   166\t  };\n   167\t}\n=== src/tools/approvals.ts\n     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport { createHash, randomUUID } from \"node:crypto\";\n     4\timport { env, policy } from \"../config.js\";\n     5\t\n     6\t// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n     7\t// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n     8\t// approvedAt); the agent then retries the tool with the approval id.\n     9\t\n    10\texport interface ApprovalRecord {\n    11\t  id: string;\n    12\t  status: \"pending\" | \"approved\" | \"rejected\";\n    13\t  tool: string;\n    14\t  tenantId: string;\n    15\t  agentInstanceId: string;\n    16\t  runId: string;\n    17\t  argsHash: string;\n    18\t  summary: string;\n    19\t  requestedAt: string;\n    20\t  expiresAt: string;\n    21\t  approvedBy?: string;\n    22\t  approverRole?: string;\n    23\t  approvedAt?: string;\n    24\t}\n    25\t\n    26\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    27\t\n    28\texport function hashArgs(args: Record<string, unknown>): string {\n    29\t  const canonical = JSON.stringify(args, Object.keys(args).sort());\n    30\t  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n    31\t}\n    32\t\n    33\texport async function requestApproval(req: {\n    34\t  tool: string;\n    35\t  tenantId: string;\n    36\t  agentInstanceId: string;\n    37\t  runId: string;\n    38\t  args: Record<string, unknown>;\n    39\t  summary: string;\n    40\t}): Promise<ApprovalRecord> {\n    41\t  const now = Date.now();\n    42\t  const rec: ApprovalRecord = {\n    43\t    id: randomUUID(),\n    44\t    status: \"pending\",\n    45\t    tool: req.tool,\n    46\t    tenantId: req.tenantId,\n    47\t    agentInstanceId: req.agentInstanceId,\n    48\t    runId: req.runId,\n    49\t    argsHash: hashArgs(req.args),\n    50\t    summary: req.summary,\n    51\t    requestedAt: new Date(now).toISOString(),\n    52\t    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n    53\t  };\n    54\t  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n    55\t  return rec;\n    56\t}\n    57\t\n    58\texport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n    59\t\n    60\texport async function checkApproval(req: {\n    61\t  approvalId: string;\n    62\t  tool: string;\n    63\t  tenantId: string;\n    64\t  args: Record<string, unknown>;\n    65\t}): Promise<ApprovalCheck> {\n    66\t  let rec: ApprovalRecord | undefined;\n    67\t  try {\n    68\t    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    69\t    rec = res.Item as ApprovalRecord | undefined;\n    70\t  } catch (err) {\n    71\t    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n    72\t  }\n    73\t  if (!rec) return { ok: false, reason: \"approval not found\" };\n    74\t  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n    75\t  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n    76\t  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n    77\t  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n    78\t  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    79\t    return { ok: false, reason: \"approver lacks authority\" };\n    80\t  }\n    81\t  return { ok: true, approval: rec };\n    82\t}\n=== src/tools/metadata-scan.ts\n     1\t// Scans MCP server metadata before any of it reaches the model.\n     2\t//\n     3\t// Covered fields: server instructions, tool name, title, description, every string inside the\n     4\t// input and output schemas (titles, descriptions, enum values, defaults, examples), annotations,\n     5\t// prompt names/descriptions/argument descriptions, and resource template names/descriptions/URIs.\n     6\t//\n     7\t// A finding on a tool rejects that tool. A finding on the server instructions or a prompt or\n     8\t// resource template rejects the whole server. If the scanner itself throws, the caller treats the\n     9\t// server as unavailable; nothing unscanned is passed on.\n    10\t\n    11\texport interface ToolMeta {\n    12\t  name: string;\n    13\t  title?: string;\n    14\t  description?: string;\n    15\t  inputSchema?: unknown;\n    16\t  outputSchema?: unknown;\n    17\t  annotations?: Record<string, unknown>;\n    18\t}\n    19\t\n    20\texport interface ServerMeta {\n    21\t  instructions?: string;\n    22\t  tools: ToolMeta[];\n    23\t  prompts?: Array<{ name: string; description?: string; arguments?: Array<{ name: string; description?: string }> }>;\n    24\t  resourceTemplates?: Array<{ name: string; uriTemplate: string; description?: string }>;\n    25\t}\n    26\t\n    27\texport interface Finding {\n    28\t  where: string;\n    29\t  rule: string;\n    30\t  sample: string;\n    31\t}\n    32\t\n    33\texport const LIMITS = {\n    34\t  name: 64,\n    35\t  title: 120,\n    36\t  description: 1024,\n    37\t  schemaString: 512,\n    38\t  instructions: 2048,\n    39\t} as const;\n    40\t\n    41\tconst RULES: Array<{ rule: string; re: RegExp }> = [\n    42\t  // Invisible, bidi, and control characters (tab and newline allowed).\n    43\t  { rule: \"control_or_invisible_char\", re: /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F­​-‏‪-‮⁠-⁤⁦-⁩﻿\\u{E0000}-\\u{E007F}]/u },\n    44\t  // Role and instruction overrides.\n    45\t  { rule: \"role_override\", re: /\\b(ignore|disregard|override|forget)\\b.{0,40}\\b(previous|prior|above|system|instructions?|rules?)\\b/i },\n    46\t  { rule: \"role_override\", re: /\\b(you are now|act as|new instructions|system prompt|developer message)\\b/i },\n    47\t  { rule: \"role_marker\", re: /<\\/?(system|assistant|user|instructions?)>|\\[\\/?INST\\]|^\\s*(system|assistant)\\s*:/im },\n    48\t  // Directing the model to hide things or to act before or instead of the user.\n    49\t  { rule: \"concealment\", re: /\\b(do not|don't|never)\\b.{0,30}\\b(tell|mention|reveal|show|inform)\\b.{0,30}\\b(user|patient|staff)\\b/i },\n    50\t  { rule: \"precondition_injection\", re: /\\b(before|after|instead of)\\b.{0,30}\\b(calling|using|running)\\b.{0,40}\\b(always|must|first)\\b/i },\n    51\t  // Encoded payloads.\n    52\t  { rule: \"base64_blob\", re: /\\b[A-Za-z0-9+/]{48,}={0,2}(?![A-Za-z0-9+/])/ },\n    53\t  { rule: \"hex_blob\", re: /\\b(?:[0-9a-f]{2}){32,}\\b/i },\n    54\t  { rule: \"escaped_unicode\", re: /(\\\\u[0-9a-f]{4}){4,}|(&#x?[0-9a-f]+;){4,}/i },\n    55\t  // Places data could be sent.\n    56\t  { rule: \"url\", re: /\\b(?:https?|ftp|wss?|file|data):\\/?\\/?[^\\s\"'<>]+/i },\n    57\t  { rule: \"email\", re: /\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/i },\n    58\t  { rule: \"phone_number\", re: /\\+?\\d[\\d ().-]{9,}\\d/ },\n    59\t];\n    60\t\n    61\tfunction scanString(where: string, s: string, max: number, otherServerTools: Set<string>, out: Finding[]): void {\n    62\t  if (s.length > max) out.push({ where, rule: \"too_long\", sample: `${s.length} > ${max}` });\n    63\t  for (const { rule, re } of RULES) {\n    64\t    const m = re.exec(s);\n    65\t    if (m) out.push({ where, rule, sample: m[0].slice(0, 40) });\n    66\t  }\n    67\t  const lower = s.toLowerCase();\n    68\t  for (const t of otherServerTools) {\n    69\t    if (lower.includes(t.toLowerCase())) out.push({ where, rule: \"references_other_server_tool\", sample: t });\n    70\t  }\n    71\t}\n    72\t\n    73\tfunction walkSchema(where: string, node: unknown, otherServerTools: Set<string>, out: Finding[], depth = 0): void {\n    74\t  if (depth > 12) {\n    75\t    out.push({ where, rule: \"schema_too_deep\", sample: String(depth) });\n    76\t    return;\n    77\t  }\n    78\t  if (typeof node === \"string\") {\n    79\t    scanString(where, node, LIMITS.schemaString, otherServerTools, out);\n    80\t  } else if (Array.isArray(node)) {\n    81\t    node.forEach((v, i) => walkSchema(`${where}[${i}]`, v, otherServerTools, out, depth + 1));\n    82\t  } else if (node && typeof node === \"object\") {\n    83\t    for (const [k, v] of Object.entries(node)) {\n    84\t      scanString(`${where}.<key>`, k, LIMITS.name, otherServerTools, out);\n    85\t      walkSchema(`${where}.${k}`, v, otherServerTools, out, depth + 1);\n    86\t    }\n    87\t  }\n    88\t}\n    89\t\n    90\texport interface ScanResult {\n    91\t  serverRejected: boolean;\n    92\t  serverFindings: Finding[];\n    93\t  rejectedTools: Map<string, Finding[]>;\n    94\t  acceptedTools: ToolMeta[];\n    95\t}\n    96\t\n    97\t/** otherServerTools: bare tool names exposed by every other configured server and native tool set. */\n    98\texport function scanServer(meta: ServerMeta, otherServerTools: Set<string>): ScanResult {\n    99\t  const serverFindings: Finding[] = [];\n   100\t  if (meta.instructions !== undefined) {\n   101\t    scanString(\"instructions\", meta.instructions, LIMITS.instructions, otherServerTools, serverFindings);\n   102\t  }\n   103\t  for (const p of meta.prompts ?? []) {\n   104\t    scanString(`prompt:${p.name}.name`, p.name, LIMITS.name, otherServerTools, serverFindings);\n   105\t    if (p.description) scanString(`prompt:${p.name}.description`, p.description, LIMITS.description, otherServerTools, serverFindings);\n   106\t    for (const a of p.arguments ?? []) {\n   107\t      if (a.description) scanString(`prompt:${p.name}.arg:${a.name}`, a.description, LIMITS.schemaString, otherServerTools, serverFindings);\n   108\t    }\n   109\t  }\n   110\t  for (const r of meta.resourceTemplates ?? []) {\n   111\t    scanString(`resource:${r.name}.name`, r.name, LIMITS.name, otherServerTools, serverFindings);\n   112\t    if (r.description) scanString(`resource:${r.name}.description`, r.description, LIMITS.description, otherServerTools, serverFindings);\n   113\t    // Server-scoped schemes (ehr://...) pass; web, file, and data URLs are findings like anywhere else.\n   114\t    scanString(`resource:${r.name}.uriTemplate`, r.uriTemplate, LIMITS.schemaString, otherServerTools, serverFindings);\n   115\t  }\n   116\t\n   117\t  const rejectedTools = new Map<string, Finding[]>();\n   118\t  const acceptedTools: ToolMeta[] = [];\n   119\t  for (const t of meta.tools) {\n   120\t    const f: Finding[] = [];\n   121\t    if (!/^[a-z][a-z0-9_]{0,63}$/.test(t.name)) f.push({ where: \"name\", rule: \"bad_tool_name\", sample: t.name.slice(0, 40) });\n   122\t    if (t.title) scanString(\"title\", t.title, LIMITS.title, otherServerTools, f);\n   123\t    if (t.description) scanString(\"description\", t.description, LIMITS.description, otherServerTools, f);\n   124\t    walkSchema(\"inputSchema\", t.inputSchema ?? {}, otherServerTools, f);\n   125\t    walkSchema(\"outputSchema\", t.outputSchema ?? {}, otherServerTools, f);\n   126\t    walkSchema(\"annotations\", t.annotations ?? {}, otherServerTools, f);\n   127\t    if (f.length) rejectedTools.set(t.name, f);\n   128\t    else acceptedTools.push(t);\n   129\t  }\n   130\t  return { serverRejected: serverFindings.length > 0, serverFindings, rejectedTools, acceptedTools };\n   131\t}\n=== src/agent/loop.ts\n     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-repeat-kcdj20d6/e7e91a56-8e26-4882-b939-10679f6422bd/tool-results/bhg7v2i8j.txt","persistedOutputSize":37113}}
