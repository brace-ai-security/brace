{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SDnBcCcczWF5hVNzwtywe9","type":"tool_result","content":"import type Anthropic from \"@anthropic-ai/sdk\";\nimport { allowlist, policy } from \"../config.js\";\nimport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\nimport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\nimport type { ContextSize } from \"../agent/context-size.js\";\nimport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\nimport { Halted, killSwitch } from \"../control/kill-switch.js\";\nimport type { Ehr } from \"../integrations/ehr-mcp.js\";\nimport { payments } from \"../integrations/payments.js\";\nimport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\nimport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\nimport { checkApproval, requestApproval } from \"./approvals.js\";\nimport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n\nexport interface Decision {\n  contextSize: ContextSize;\n  budget: RunBudget;\n}\n\nconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n// Arguments the harness consumes itself; they are never forwarded to a tool.\nconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n\nfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n}\n\nfunction summarize(tool: string, args: Record<string, unknown>): string {\n  return `${tool}(${Object.entries(args)\n    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    .join(\", \")})`.slice(0, 500);\n}\n\nexport async function executeTool(\n  registry: ToolRegistry,\n  ctx: RunContext,\n  call: Anthropic.ToolUseBlock,\n  d: Decision,\n): Promise<Anthropic.ToolResultBlockParam> {\n  const input = (call.input ?? {}) as Record<string, unknown>;\n  const base = {\n    ...ctx.identity(),\n    runId: ctx.runId,\n    subject: ctx.subject,\n    tool: call.name,\n    toolUseId: call.id,\n    policyVersion: policy.version,\n    context: d.contextSize,\n  };\n  const deny = async (reason: string) => {\n    await audit.record({ ...base, event: \"tool.denied\", reason });\n    return toolResult(call.id, { error: \"denied\", reason }, true);\n  };\n\n  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n  const tool = registry.get(call.name);\n  if (!tool) return deny(\"not_registered\");\n\n  await killSwitch.assertRunning(ctx.tenantId);\n  await d.budget.toolCall(call.name);\n\n  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n\n  let approvalId: string | undefined;\n  if (policy.highImpactTools.includes(call.name)) {\n    if (typeof input.approvalId !== \"string\") {\n      const rec = await requestApproval({\n        tool: call.name,\n        tenantId: clinicId,\n        agentInstanceId: AGENT_INSTANCE_ID,\n        runId: ctx.runId,\n        args,\n        summary: summarize(call.name, args),\n      });\n      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    }\n    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    if (!check.ok) return deny(check.reason);\n    approvalId = check.approval.id;\n  }\n\n  try {\n    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    const safe = redactPhi(raw);\n    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    return toolResult(call.id, safe);\n  } catch (err) {\n    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    return toolResult(call.id, { error: \"tool_failed\" }, true);\n  }\n}\n\ntype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n\nexport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n\n  return {\n    payments: [\n      {\n        name: \"refund_deposit\",\n        definition: {\n          name: \"payments__refund_deposit\",\n          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n          input_schema: {\n            type: \"object\",\n            properties: {\n              depositId: { type: \"string\" },\n              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n              approvalId: { type: \"string\" },\n            },\n            required: [\"depositId\", \"reason\"],\n          },\n        },\n        invoke: async (a, o) =>\n          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n      },\n    ],\n    sms: [\n      {\n        name: \"send_to_patient\",\n        definition: {\n          name: \"sms__send_to_patient\",\n          description: \"Send a templated SMS to the phone number on the patient's record.\",\n          input_schema: {\n            type: \"object\",\n            properties: {\n              patientId: { type: \"string\" },\n              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n            },\n            required: [\"patientId\", \"template\"],\n          },\n        },\n        invoke: async (a, o) => {\n          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n          return sms.send(o.clinicId, c.phone, body, o.signal);\n        },\n      },\n      {\n        name: \"send_freeform\",\n        definition: {\n          name: \"sms__send_freeform\",\n          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n          input_schema: {\n            type: \"object\",\n            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n            required: [\"patientId\", \"body\"],\n          },\n        },\n        invoke: async (a, o) => {\n          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n        },\n      },\n    ],\n    insurance: [\n      {\n        name: \"check_eligibility\",\n        definition: {\n          name: \"insurance__check_eligibility\",\n          description: \"Check whether the patient's insurance covers an appointment.\",\n          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n        },\n        invoke: async (a, o) =>\n          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n            clinicId: o.clinicId,\n            ctx: o.runCtx as RunContext,\n            signal: o.signal,\n            context: o.context,\n          }),\n      },\n    ],\n  };\n}\nimport { audit } from \"../audit/recorder.js\";\nimport type { Ehr } from \"../integrations/ehr-mcp.js\";\nimport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\nimport { payments } from \"../integrations/payments.js\";\nimport type { RunContext } from \"../agent/identity.js\";\nimport type { ContextSize } from \"../agent/context-size.js\";\n\n// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n// agent, and settles the visit deposit when the plan covers the visit.\n\nexport async function checkEligibilityForAppointment(\n  ehr: Ehr,\n  input: { appointmentId: string },\n  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n): Promise<Eligibility & { depositRefundId?: string }> {\n  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n\n  const result = await checkEligibility(\n    {\n      clinicId: opts.clinicId,\n      patientId: appt.patientId,\n      payerId: appt.payerId,\n      serviceCode: appt.serviceCode,\n      dateOfService: appt.start.slice(0, 10),\n    },\n    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n  );\n  await audit.record({\n    ...opts.ctx.identity(),\n    runId: opts.ctx.runId,\n    subject: opts.ctx.subject,\n    event: \"peer.call\",\n    tool: \"insurance__check_eligibility\",\n    context: opts.context,\n    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n  });\n\n  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n    const refund = await payments.refundDeposit(\n      opts.clinicId,\n      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n      opts.signal,\n    );\n    await audit.record({\n      ...opts.ctx.identity(),\n      runId: opts.ctx.runId,\n      subject: opts.ctx.subject,\n      event: \"payment.refund\",\n      tool: \"insurance__check_eligibility\",\n      context: opts.context,\n      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n    });\n    return { ...result, depositRefundId: refund.id };\n  }\n  return result;\n}\nimport pino from \"pino\";\nimport { manifest } from \"../config.js\";\nimport { audit } from \"../audit/recorder.js\";\nimport { computeAgentTypeId, newRunContext, setAgentTypeId } from \"../agent/identity.js\";\nimport { Halted, killSwitch } from \"../control/kill-switch.js\";\nimport { ehr as ehrClient } from \"../integrations/ehr-mcp.js\";\nimport { render, sms } from \"../integrations/sms.js\";\n\n// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.\nconst log = pino({ level: \"info\" });\n\nconst directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\nsetAgentTypeId(\n  computeAgentTypeId({\n    imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    harnessVersion: manifest.harness.version,\n    harnessGitSha: process.env.GIT_SHA ?? \"\",\n  }),\n);\n\nconst ehr = ehrClient(manifest.tools.mcpServers.find((s: { id: string }) => s.id === \"ehr\"));\nconst tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);\n\nfor (const clinic of directory) {\n  const ctx = newRunContext({ tenantId: clinic.id, subject: { kind: \"system\", id: \"reminders-cron\" }, channel: \"reminder\", log });\n  const abort = new AbortController();\n  const unregister = killSwitch.register(ctx.runId, clinic.id, abort);\n  try {\n    await killSwitch.assertRunning(clinic.id);\n    const appts = await ehr.appointmentsOn(clinic.id, tomorrow, abort.signal);\n    for (const a of appts) {\n      if (!a.smsOptIn) continue;\n      await killSwitch.assertRunning(clinic.id);\n      const when = new Date(a.start).toLocaleString(\"en-US\", { weekday: \"short\", hour: \"numeric\", minute: \"2-digit\" });\n      const res = await sms.send(clinic.id, a.phone, render(\"reminder\", { firstName: \"\", when, location: a.locationName }), abort.signal);\n      await audit.record({\n        ...ctx.identity(),\n        runId: ctx.runId,\n        subject: ctx.subject,\n        event: \"reminder.sent\",\n        tool: \"sms__send_to_patient\",\n        // Scheduled, templated send: no model decided this action.\n        context: { tokens: null, status: \"unavailable\", method: \"no_model_decision\", cachedInputTokens: null, compacted: false },\n        detail: { appointmentId: a.id, messageId: res.messageId },\n      });\n    }\n  } catch (err) {\n    if (err instanceof Halted) {\n      log.warn({ clinic: clinic.id, scope: err.scope }, \"reminders halted\");\n      break;\n    }\n    log.error({ clinic: clinic.id, err: (err as Error).message }, \"reminder run failed\");\n    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \"run.stopped\", reason: (err as Error).message.slice(0, 200) });\n  } finally {\n    unregister();\n  }\n}\nprocess.exit(0);\nimport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\nimport { randomUUID } from \"node:crypto\";\nimport { z } from \"zod\";\nimport { env } from \"../config.js\";\n\n// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n//\n// Authority: for each call we exchange the agent's workload token for a token that is only good\n// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n//\n// Answers come back as a signed attestation (JWS) inside a data part.\n\nconst Eligibility = z\n  .object({\n    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    planName: z.string().max(120).optional(),\n    copayCents: z.number().int().nonnegative().optional(),\n    depositWaived: z.boolean().default(false),\n    checkedAt: z.string().datetime(),\n  })\n  .strict();\nexport type Eligibility = z.infer<typeof Eligibility>;\n\nconst Rpc = z.object({\n  jsonrpc: z.literal(\"2.0\"),\n  id: z.string(),\n  result: z.object({\n    kind: z.literal(\"message\"),\n    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n  }),\n});\n\nasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n  const res = await fetch(env.tokenExchangeUrl, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    body: new URLSearchParams({\n      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n      subject_token: workloadToken,\n      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n      audience: \"eligibility-agent\",\n      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    }),\n  });\n  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n  return ((await res.json()) as { access_token: string }).access_token;\n}\n\nexport async function checkEligibility(\n  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n): Promise<Eligibility> {\n  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n  const requestId = randomUUID();\n  const res = await fetch(env.eligibilityUrl, {\n    method: \"POST\",\n    signal: opts.signal,\n    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    body: JSON.stringify({\n      jsonrpc: \"2.0\",\n      id: requestId,\n      method: \"message/send\",\n      params: {\n        message: {\n          role: \"user\",\n          messageId: requestId,\n          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n        },\n      },\n    }),\n  });\n  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n  const text = await res.text();\n  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n  const rpc = Rpc.parse(JSON.parse(text));\n\n  const attestation = rpc.result.parts[0]!.data.attestation;\n  const header = decodeProtectedHeader(attestation);\n  if (!header.jku) throw new Error(\"attestation missing key set url\");\n  const keys = createRemoteJWKSet(new URL(header.jku));\n  const { payload } = await jwtVerify(attestation, keys, {\n    issuer: env.eligibilityIssuer,\n    audience: \"clinic-agent\",\n    maxTokenAge: \"5m\",\n    algorithms: [\"ES256\"],\n  });\n  return Eligibility.parse(payload.eligibility);\n}\nimport type Anthropic from \"@anthropic-ai/sdk\";\nimport { createHash } from \"node:crypto\";\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { z } from \"zod\";\nimport { CLASSIFIER_MODEL, ROOT } from \"../config.js\";\n\n// Helper model that routes messages before the agent sees them. Urgent and complaint messages go\n// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\n// malformed output, unknown label, or a served model other than the pinned snapshot) routes the\n// message to staff. A failed classifier never defaults to \"send it to the agent\".\n\nexport const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");\nexport const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\n\nexport const CLASSIFIER_ID = `sha256:${createHash(\"sha256\")\n  .update(CLASSIFIER_MODEL)\n  .update(\"\\0\")\n  .update(CLASSIFIER_PROMPT)\n  .update(\"\\0\")\n  .update(JSON.stringify(CLASSIFIER_CONFIG))\n  .digest(\"hex\")}`;\n\nconst Intent = z.enum([\"book\", \"reschedule\", \"cancel\", \"confirm\", \"coverage\", \"info\", \"urgent\", \"complaint\", \"other\"]);\nconst Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();\n\nexport type Route = \"agent\" | \"staff\";\n\nexport interface ClassifierDecision {\n  classifierId: string;\n  requestedModel: string;\n  servedModel: string | null;\n  intent: z.infer<typeof Intent> | null;\n  confidence: number | null;\n  route: Route;\n  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n}\n\nconst MIN_CONFIDENCE = 0.6;\n\nexport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n  let res: Anthropic.Message;\n  try {\n    res = await client.messages.create(\n      {\n        model: CLASSIFIER_MODEL,\n        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n        temperature: CLASSIFIER_CONFIG.temperature,\n        system: CLASSIFIER_PROMPT,\n        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n      },\n      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n    );\n  } catch (err) {\n    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n  }\n\n  if (res.model !== CLASSIFIER_MODEL) {\n    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n  }\n\n  const textOut = res.content.find((b) => b.type === \"text\");\n  let parsed: z.infer<typeof Output>;\n  try {\n    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n  } catch {\n    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n  }\n\n  if (parsed.confidence < MIN_CONFIDENCE) {\n    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n  }\n  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n}\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { parse } from \"yaml\";\n\nexport const ROOT = process.env.CLINIC_AGENT_ROOT ?? process.cwd();\n\nexport interface Policy {\n  version: string;\n  highImpactTools: string[];\n  approval: { ttlSeconds: number; approverRoles: string[]; table: string };\n}\n\nexport interface AllowlistEntry {\n  tool: string;\n  reason: string;\n}\n\nexport interface Budgets {\n  run: {\n    maxTurns: number;\n    maxWallMs: number;\n    maxInputTokens: number;\n    maxOutputTokens: number;\n    maxCostUsd: number;\n    maxToolCalls: number;\n    maxToolCallsPerMinute: number;\n    maxPeerCalls: number;\n  };\n  quotas: {\n    perSubjectDailyUsd: number;\n    perTenantDailyUsd: number;\n    fleetDailyUsd: number;\n    perTenantToolCallsPerMinute: number;\n    fleetToolCallsPerMinute: number;\n  };\n  pricingUsdPerMTok: Record<string, { input: number; output: number; cacheRead: number; cacheWrite: number }>;\n  onExceed: \"handoff_to_staff\";\n}\n\nfunction loadYaml<T>(rel: string): T {\n  return parse(readFileSync(join(ROOT, rel), \"utf8\")) as T;\n}\n\nexport const policy = loadYaml<Policy>(\"config/policy.yaml\");\nexport const allowlist = loadYaml<{ role: string; tools: AllowlistEntry[] }>(\"config/tools.allowlist.yaml\");\nexport const budgets = loadYaml<Budgets>(\"config/budgets.yaml\");\nexport const manifest = JSON.parse(readFileSync(join(ROOT, \"release/manifest.json\"), \"utf8\"));\n\nexport const AGENT_MODEL = \"claude-sonnet-4-5-20250929\";\nexport const CLASSIFIER_MODEL = \"claude-haiku-4-5-20251001\";\n\nexport const env = {\n  region: process.env.AWS_REGION ?? \"us-west-2\",\n  controlTable: process.env.CONTROL_TABLE ?? \"clinic-agent-control\",\n  budgetTable: process.env.BUDGET_TABLE ?? \"clinic-agent-budgets\",\n  auditStream: process.env.AUDIT_STREAM ?? \"clinic-agent-audit\",\n  smsSigningSecretArn: process.env.SMS_SIGNING_SECRET_ARN ?? \"\",\n  chatJwksUrl: process.env.CHAT_JWKS_URL ?? \"https://auth.northbay-clinics.example/.well-known/jwks.json\",\n  chatIssuer: process.env.CHAT_ISSUER ?? \"https://auth.northbay-clinics.example/\",\n  eligibilityUrl: process.env.ELIGIBILITY_URL ?? \"https://eligibility.partners.northbay-clinics.example/a2a\",\n  eligibilityIssuer: process.env.ELIGIBILITY_ISSUER ?? \"https://eligibility.partners.northbay-clinics.example\",\n  tokenExchangeUrl: process.env.TOKEN_EXCHANGE_URL ?? \"https://sts.northbay-clinics.example/oauth2/token\",\n  accountableParty: \"northbay-clinic-group:patient-access\",\n  operationalOwner: \"team:agent-platform\",\n};\n(eval):1: no matches found: --include=*.ts","is_error":false}]},"parent_tool_use_id":null,"session_id":"695db836-8ff1-488f-ab73-7de2877af2cd","uuid":"ab9b3e47-fe0e-4f54-bda5-5436b503e8d0","timestamp":"2026-10-02T14:47:59.196Z","tool_use_result":{"stdout":"import type Anthropic from \"@anthropic-ai/sdk\";\nimport { allowlist, policy } from \"../config.js\";\nimport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\nimport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\nimport type { ContextSize } from \"../agent/context-size.js\";\nimport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\nimport { Halted, killSwitch } from \"../control/kill-switch.js\";\nimport type { Ehr } from \"../integrations/ehr-mcp.js\";\nimport { payments } from \"../integrations/payments.js\";\nimport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\nimport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\nimport { checkApproval, requestApproval } from \"./approvals.js\";\nimport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n\nexport interface Decision {\n  contextSize: ContextSize;\n  budget: RunBudget;\n}\n\nconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n// Arguments the harness consumes itself; they are never forwarded to a tool.\nconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n\nfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n}\n\nfunction summarize(tool: string, args: Record<string, unknown>): string {\n  return `${tool}(${Object.entries(args)\n    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    .join(\", \")})`.slice(0, 500);\n}\n\nexport async function executeTool(\n  registry: ToolRegistry,\n  ctx: RunContext,\n  call: Anthropic.ToolUseBlock,\n  d: Decision,\n): Promise<Anthropic.ToolResultBlockParam> {\n  const input = (call.input ?? {}) as Record<string, unknown>;\n  const base = {\n    ...ctx.identity(),\n    runId: ctx.runId,\n    subject: ctx.subject,\n    tool: call.name,\n    toolUseId: call.id,\n    policyVersion: policy.version,\n    context: d.contextSize,\n  };\n  const deny = async (reason: string) => {\n    await audit.record({ ...base, event: \"tool.denied\", reason });\n    return toolResult(call.id, { error: \"denied\", reason }, true);\n  };\n\n  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n  const tool = registry.get(call.name);\n  if (!tool) return deny(\"not_registered\");\n\n  await killSwitch.assertRunning(ctx.tenantId);\n  await d.budget.toolCall(call.name);\n\n  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n\n  let approvalId: string | undefined;\n  if (policy.highImpactTools.includes(call.name)) {\n    if (typeof input.approvalId !== \"string\") {\n      const rec = await requestApproval({\n        tool: call.name,\n        tenantId: clinicId,\n        agentInstanceId: AGENT_INSTANCE_ID,\n        runId: ctx.runId,\n        args,\n        summary: summarize(call.name, args),\n      });\n      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    }\n    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    if (!check.ok) return deny(check.reason);\n    approvalId = check.approval.id;\n  }\n\n  try {\n    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    const safe = redactPhi(raw);\n    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    return toolResult(call.id, safe);\n  } catch (err) {\n    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    return toolResult(call.id, { error: \"tool_failed\" }, true);\n  }\n}\n\ntype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n\nexport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n\n  return {\n    payments: [\n      {\n        name: \"refund_deposit\",\n        definition: {\n          name: \"payments__refund_deposit\",\n          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n          input_schema: {\n            type: \"object\",\n            properties: {\n              depositId: { type: \"string\" },\n              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n              approvalId: { type: \"string\" },\n            },\n            required: [\"depositId\", \"reason\"],\n          },\n        },\n        invoke: async (a, o) =>\n          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n      },\n    ],\n    sms: [\n      {\n        name: \"send_to_patient\",\n        definition: {\n          name: \"sms__send_to_patient\",\n          description: \"Send a templated SMS to the phone number on the patient's record.\",\n          input_schema: {\n            type: \"object\",\n            properties: {\n              patientId: { type: \"string\" },\n              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n            },\n            required: [\"patientId\", \"template\"],\n          },\n        },\n        invoke: async (a, o) => {\n          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n          return sms.send(o.clinicId, c.phone, body, o.signal);\n        },\n      },\n      {\n        name: \"send_freeform\",\n        definition: {\n          name: \"sms__send_freeform\",\n          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n          input_schema: {\n            type: \"object\",\n            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n            required: [\"patientId\", \"body\"],\n          },\n        },\n        invoke: async (a, o) => {\n          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n        },\n      },\n    ],\n    insurance: [\n      {\n        name: \"check_eligibility\",\n        definition: {\n          name: \"insurance__check_eligibility\",\n          description: \"Check whether the patient's insurance covers an appointment.\",\n          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n        },\n        invoke: async (a, o) =>\n          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n            clinicId: o.clinicId,\n            ctx: o.runCtx as RunContext,\n            signal: o.signal,\n            context: o.context,\n          }),\n      },\n    ],\n  };\n}\nimport { audit } from \"../audit/recorder.js\";\nimport type { Ehr } from \"../integrations/ehr-mcp.js\";\nimport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\nimport { payments } from \"../integrations/payments.js\";\nimport type { RunContext } from \"../agent/identity.js\";\nimport type { ContextSize } from \"../agent/context-size.js\";\n\n// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n// agent, and settles the visit deposit when the plan covers the visit.\n\nexport async function checkEligibilityForAppointment(\n  ehr: Ehr,\n  input: { appointmentId: string },\n  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n): Promise<Eligibility & { depositRefundId?: string }> {\n  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n\n  const result = await checkEligibility(\n    {\n      clinicId: opts.clinicId,\n      patientId: appt.patientId,\n      payerId: appt.payerId,\n      serviceCode: appt.serviceCode,\n      dateOfService: appt.start.slice(0, 10),\n    },\n    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n  );\n  await audit.record({\n    ...opts.ctx.identity(),\n    runId: opts.ctx.runId,\n    subject: opts.ctx.subject,\n    event: \"peer.call\",\n    tool: \"insurance__check_eligibility\",\n    context: opts.context,\n    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n  });\n\n  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n    const refund = await payments.refundDeposit(\n      opts.clinicId,\n      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n      opts.signal,\n    );\n    await audit.record({\n      ...opts.ctx.identity(),\n      runId: opts.ctx.runId,\n      subject: opts.ctx.subject,\n      event: \"payment.refund\",\n      tool: \"insurance__check_eligibility\",\n      context: opts.context,\n      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n    });\n    return { ...result, depositRefundId: refund.id };\n  }\n  return result;\n}\nimport pino from \"pino\";\nimport { manifest } from \"../config.js\";\nimport { audit } from \"../audit/recorder.js\";\nimport { computeAgentTypeId, newRunContext, setAgentTypeId } from \"../agent/identity.js\";\nimport { Halted, killSwitch } from \"../control/kill-switch.js\";\nimport { ehr as ehrClient } from \"../integrations/ehr-mcp.js\";\nimport { render, sms } from \"../integrations/sms.js\";\n\n// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.\nconst log = pino({ level: \"info\" });\n\nconst directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\nsetAgentTypeId(\n  computeAgentTypeId({\n    imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    harnessVersion: manifest.harness.version,\n    harnessGitSha: process.env.GIT_SHA ?? \"\",\n  }),\n);\n\nconst ehr = ehrClient(manifest.tools.mcpServers.find((s: { id: string }) => s.id === \"ehr\"));\nconst tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);\n\nfor (const clinic of directory) {\n  const ctx = newRunContext({ tenantId: clinic.id, subject: { kind: \"system\", id: \"reminders-cron\" }, channel: \"reminder\", log });\n  const abort = new AbortController();\n  const unregister = killSwitch.register(ctx.runId, clinic.id, abort);\n  try {\n    await killSwitch.assertRunning(clinic.id);\n    const appts = await ehr.appointmentsOn(clinic.id, tomorrow, abort.signal);\n    for (const a of appts) {\n      if (!a.smsOptIn) continue;\n      await killSwitch.assertRunning(clinic.id);\n      const when = new Date(a.start).toLocaleString(\"en-US\", { weekday: \"short\", hour: \"numeric\", minute: \"2-digit\" });\n      const res = await sms.send(clinic.id, a.phone, render(\"reminder\", { firstName: \"\", when, location: a.locationName }), abort.signal);\n      await audit.record({\n        ...ctx.identity(),\n        runId: ctx.runId,\n        subject: ctx.subject,\n        event: \"reminder.sent\",\n        tool: \"sms__send_to_patient\",\n        // Scheduled, templated send: no model decided this action.\n        context: { tokens: null, status: \"unavailable\", method: \"no_model_decision\", cachedInputTokens: null, compacted: false },\n        detail: { appointmentId: a.id, messageId: res.messageId },\n      });\n    }\n  } catch (err) {\n    if (err instanceof Halted) {\n      log.warn({ clinic: clinic.id, scope: err.scope }, \"reminders halted\");\n      break;\n    }\n    log.error({ clinic: clinic.id, err: (err as Error).message }, \"reminder run failed\");\n    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \"run.stopped\", reason: (err as Error).message.slice(0, 200) });\n  } finally {\n    unregister();\n  }\n}\nprocess.exit(0);\nimport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\nimport { randomUUID } from \"node:crypto\";\nimport { z } from \"zod\";\nimport { env } from \"../config.js\";\n\n// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n//\n// Authority: for each call we exchange the agent's workload token for a token that is only good\n// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n//\n// Answers come back as a signed attestation (JWS) inside a data part.\n\nconst Eligibility = z\n  .object({\n    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    planName: z.string().max(120).optional(),\n    copayCents: z.number().int().nonnegative().optional(),\n    depositWaived: z.boolean().default(false),\n    checkedAt: z.string().datetime(),\n  })\n  .strict();\nexport type Eligibility = z.infer<typeof Eligibility>;\n\nconst Rpc = z.object({\n  jsonrpc: z.literal(\"2.0\"),\n  id: z.string(),\n  result: z.object({\n    kind: z.literal(\"message\"),\n    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n  }),\n});\n\nasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n  const res = await fetch(env.tokenExchangeUrl, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    body: new URLSearchParams({\n      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n      subject_token: workloadToken,\n      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n      audience: \"eligibility-agent\",\n      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    }),\n  });\n  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n  return ((await res.json()) as { access_token: string }).access_token;\n}\n\nexport async function checkEligibility(\n  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n): Promise<Eligibility> {\n  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n  const requestId = randomUUID();\n  const res = await fetch(env.eligibilityUrl, {\n    method: \"POST\",\n    signal: opts.signal,\n    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    body: JSON.stringify({\n      jsonrpc: \"2.0\",\n      id: requestId,\n      method: \"message/send\",\n      params: {\n        message: {\n          role: \"user\",\n          messageId: requestId,\n          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n        },\n      },\n    }),\n  });\n  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n  const text = await res.text();\n  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n  const rpc = Rpc.parse(JSON.parse(text));\n\n  const attestation = rpc.result.parts[0]!.data.attestation;\n  const header = decodeProtectedHeader(attestation);\n  if (!header.jku) throw new Error(\"attestation missing key set url\");\n  const keys = createRemoteJWKSet(new URL(header.jku));\n  const { payload } = await jwtVerify(attestation, keys, {\n    issuer: env.eligibilityIssuer,\n    audience: \"clinic-agent\",\n    maxTokenAge: \"5m\",\n    algorithms: [\"ES256\"],\n  });\n  return Eligibility.parse(payload.eligibility);\n}\nimport type Anthropic from \"@anthropic-ai/sdk\";\nimport { createHash } from \"node:crypto\";\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { z } from \"zod\";\nimport { CLASSIFIER_MODEL, ROOT } from \"../config.js\";\n\n// Helper model that routes messages before the agent sees them. Urgent and complaint messages go\n// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\n// malformed output, unknown label, or a served model other than the pinned snapshot) routes the\n// message to staff. A failed classifier never defaults to \"send it to the agent\".\n\nexport const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");\nexport const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\n\nexport const CLASSIFIER_ID = `sha256:${createHash(\"sha256\")\n  .update(CLASSIFIER_MODEL)\n  .update(\"\\0\")\n  .update(CLASSIFIER_PROMPT)\n  .update(\"\\0\")\n  .update(JSON.stringify(CLASSIFIER_CONFIG))\n  .digest(\"hex\")}`;\n\nconst Intent = z.enum([\"book\", \"reschedule\", \"cancel\", \"confirm\", \"coverage\", \"info\", \"urgent\", \"complaint\", \"other\"]);\nconst Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();\n\nexport type Route = \"agent\" | \"staff\";\n\nexport interface ClassifierDecision {\n  classifierId: string;\n  requestedModel: string;\n  servedModel: string | null;\n  intent: z.infer<typeof Intent> | null;\n  confidence: number | null;\n  route: Route;\n  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n}\n\nconst MIN_CONFIDENCE = 0.6;\n\nexport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n  let res: Anthropic.Message;\n  try {\n    res = await client.messages.create(\n      {\n        model: CLASSIFIER_MODEL,\n        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n        temperature: CLASSIFIER_CONFIG.temperature,\n        system: CLASSIFIER_PROMPT,\n        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n      },\n      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n    );\n  } catch (err) {\n    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n  }\n\n  if (res.model !== CLASSIFIER_MODEL) {\n    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n  }\n\n  const textOut = res.content.find((b) => b.type === \"text\");\n  let parsed: z.infer<typeof Output>;\n  try {\n    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n  } catch {\n    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n  }\n\n  if (parsed.confidence < MIN_CONFIDENCE) {\n    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n  }\n  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n}\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { parse } from \"yaml\";\n\nexport const ROOT = process.env.CLINIC_AGENT_ROOT ?? process.cwd();\n\nexport interface Policy {\n  version: string;\n  highImpactTools: string[];\n  approval: { ttlSeconds: number; approverRoles: string[]; table: string };\n}\n\nexport interface AllowlistEntry {\n  tool: string;\n  reason: string;\n}\n\nexport interface Budgets {\n  run: {\n    maxTurns: number;\n    maxWallMs: number;\n    maxInputTokens: number;\n    maxOutputTokens: number;\n    maxCostUsd: number;\n    maxToolCalls: number;\n    maxToolCallsPerMinute: number;\n    maxPeerCalls: number;\n  };\n  quotas: {\n    perSubjectDailyUsd: number;\n    perTenantDailyUsd: number;\n    fleetDailyUsd: number;\n    perTenantToolCallsPerMinute: number;\n    fleetToolCallsPerMinute: number;\n  };\n  pricingUsdPerMTok: Record<string, { input: number; output: number; cacheRead: number; cacheWrite: number }>;\n  onExceed: \"handoff_to_staff\";\n}\n\nfunction loadYaml<T>(rel: string): T {\n  return parse(readFileSync(join(ROOT, rel), \"utf8\")) as T;\n}\n\nexport const policy = loadYaml<Policy>(\"config/policy.yaml\");\nexport const allowlist = loadYaml<{ role: string; tools: AllowlistEntry[] }>(\"config/tools.allowlist.yaml\");\nexport const budgets = loadYaml<Budgets>(\"config/budgets.yaml\");\nexport const manifest = JSON.parse(readFileSync(join(ROOT, \"release/manifest.json\"), \"utf8\"));\n\nexport const AGENT_MODEL = \"claude-sonnet-4-5-20250929\";\nexport const CLASSIFIER_MODEL = \"claude-haiku-4-5-20251001\";\n\nexport const env = {\n  region: process.env.AWS_REGION ?? \"us-west-2\",\n  controlTable: process.env.CONTROL_TABLE ?? \"clinic-agent-control\",\n  budgetTable: process.env.BUDGET_TABLE ?? \"clinic-agent-budgets\",\n  auditStream: process.env.AUDIT_STREAM ?? \"clinic-agent-audit\",\n  smsSigningSecretArn: process.env.SMS_SIGNING_SECRET_ARN ?? \"\",\n  chatJwksUrl: process.env.CHAT_JWKS_URL ?? \"https://auth.northbay-clinics.example/.well-known/jwks.json\",\n  chatIssuer: process.env.CHAT_ISSUER ?? \"https://auth.northbay-clinics.example/\",\n  eligibilityUrl: process.env.ELIGIBILITY_URL ?? \"https://eligibility.partners.northbay-clinics.example/a2a\",\n  eligibilityIssuer: process.env.ELIGIBILITY_ISSUER ?? \"https://eligibility.partners.northbay-clinics.example\",\n  tokenExchangeUrl: process.env.TOKEN_EXCHANGE_URL ?? \"https://sts.northbay-clinics.example/oauth2/token\",\n  accountableParty: \"northbay-clinic-group:patient-access\",\n  operationalOwner: \"team:agent-platform\",\n};\n(eval):1: no matches found: --include=*.ts","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
