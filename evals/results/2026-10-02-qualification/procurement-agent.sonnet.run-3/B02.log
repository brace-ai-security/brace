{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C9xQps8tdcG6VJfXi8Ayid","type":"tool_result","content":"     1\t\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n     2\t\n     3\tThe agent runs under its own Kubernetes service account. Its projected\n     4\tservice-account token is exchanged at the internal STS for short-lived,\n     5\taudience-bound tokens. The launching user's token is never forwarded to an\n     6\tintegration; the user is carried as the delegated subject of the exchange.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport time\n    13\timport uuid\n    14\tfrom dataclasses import dataclass, field, replace\n    15\tfrom pathlib import Path\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.settings import Settings\n    20\t\n    21\tIDENTITY_FIELDS = (\n    22\t    \"accountable_party\",\n    23\t    \"operational_owner\",\n    24\t    \"tenant\",\n    25\t    \"agent_type_id\",\n    26\t    \"agent_instance_id\",\n    27\t    \"trace_id\",\n    28\t)\n    29\t\n    30\t\n    31\t@dataclass(frozen=True)\n    32\tclass RunIdentity:\n    33\t    accountable_party: str\n    34\t    operational_owner: str\n    35\t    tenant: str\n    36\t    agent_type_id: str\n    37\t    agent_instance_id: str\n    38\t    trace_id: str\n    39\t    run_id: str\n    40\t    delegated_subject: str\n    41\t    agent_principal: str\n    42\t    parent_instance_id: str | None = None\n    43\t    role: str = \"procurement\"\n    44\t\n    45\t    def __post_init__(self) -> None:\n    46\t        for name in IDENTITY_FIELDS:\n    47\t            if not getattr(self, name):\n    48\t                raise ValueError(f\"identity field {name} is empty\")\n    49\t\n    50\t    def child(self, role: str) -> \"RunIdentity\":\n    51\t        return replace(\n    52\t            self,\n    53\t            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n    54\t            parent_instance_id=self.agent_instance_id,\n    55\t            role=role,\n    56\t        )\n    57\t\n    58\t\n    59\tdef new_instance_id() -> str:\n    60\t    return f\"inst-{uuid.uuid4()}\"\n    61\t\n    62\t\n    63\tdef compute_agent_type_id(manifest: dict) -> str:\n    64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    65\t    material = {\n    66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n    67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n    68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n    69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n    70\t        \"models\": manifest[\"models\"],\n    71\t        \"config\": manifest[\"config\"],\n    72\t        \"tools\": manifest[\"tool_pins\"],\n    73\t    }\n    74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n    76\t\n    77\t\n    78\t@dataclass\n    79\tclass _CachedToken:\n    80\t    value: str\n    81\t    expires_at: float\n    82\t\n    83\t\n    84\t@dataclass\n    85\tclass TokenBroker:\n    86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n    87\t\n    88\t    settings: Settings\n    89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n    90\t\n    91\t    def _workload_token(self) -> str:\n    92\t        return Path(self.settings.workload_token_path).read_text().strip()\n    93\t\n    94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n    95\t        key = (audience, scope, ident.tenant)\n    96\t        cached = self._cache.get(key)\n    97\t        if cached and cached.expires_at - 30 > time.time():\n    98\t            return cached.value\n    99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n   100\t            resp = await client.post(\n   101\t                self.settings.sts_url,\n   102\t                data={\n   103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n   104\t                    \"subject_token\": self._workload_token(),\n   105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n   106\t                    \"audience\": audience,\n   107\t                    \"scope\": scope,\n   108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n   109\t                    \"actor_token\": ident.delegated_subject,\n   110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n   111\t                },\n   112\t            )\n   113\t            resp.raise_for_status()\n   114\t            body = resp.json()\n   115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n   116\t        self._cache[key] = token\n   117\t        return token.value\n   120\t\n   121\t\n   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n   123\t    settings = request.app.state.settings\n   124\t    try:\n   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n   126\t        claims = jwt.decode(\n   127\t            creds.credentials,\n   128\t            key.key,\n   129\t            algorithms=[\"RS256\", \"ES256\"],\n   130\t            audience=settings.oidc_audience,\n   131\t            issuer=settings.oidc_issuer,\n   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n   133\t        )\n   134\t    except jwt.PyJWTError as exc:\n   135\t        raise HTTPException(401, \"invalid token\") from exc\n   136\t    bu = claims.get(\"bu\")\n   137\t    if not bu:\n   138\t        raise HTTPException(403, \"token has no business unit\")\n   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n   140\t\n   141\t\n   142\t@app.post(\"/runs\")\n   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n   144\t    settings = request.app.state.settings\n   145\t    span_ctx = trace.get_current_span().get_span_context()\n   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n   147\t    ident = RunIdentity(\n   148\t        accountable_party=principal.subject,\n   149\t        operational_owner=settings.operational_owner,\n   150\t        tenant=principal.business_unit,\n   151\t        agent_type_id=request.app.state.agent_type_id,\n   152\t        agent_instance_id=new_instance_id(),\n   153\t        trace_id=trace_id,\n   154\t        run_id=f\"run-{uuid.uuid4()}\",\n   155\t        delegated_subject=principal.subject,\n   156\t        agent_principal=AGENT_PRINCIPAL,\n   157\t    )\n   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n   161\t\n   162\t\n   163\t@app.post(\"/slack/interactions\")\n   164\tasync def slack_interactions(request: Request) -> dict:\n   165\t    body = await request.body()\n   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n   167\t    if abs(time.time() - int(timestamp)) > 300:\n   168\t        raise HTTPException(401, \"stale request\")\n   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n   172\t        raise HTTPException(401, \"bad signature\")\n   173\t\n   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n   175\t    action = payload[\"actions\"][0]\n   176\t    slack_user = payload[\"user\"][\"id\"]\n   177\t    row = await request.app.state.pool.fetchrow(\n   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n   179\t    )\n   180\t    if row is None:\n   181\t        raise HTTPException(403, \"not an approver\")\n   182\t    try:\n   183\t        await request.app.state.approvals.decide(\n   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n   185\t            approve=action[\"action_id\"] == \"approve\",\n   186\t        )\n   187\t    except ApproverNotAuthorized as exc:\n   188\t        raise HTTPException(403, str(exc)) from exc\n   189\t    except ValueError as exc:\n   190\t        raise HTTPException(409, str(exc)) from exc\n     1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n     2\t\n     3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n     4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n     5\tuntil a procurement lead verifies them in the admin UI. Every row records\n     6\twho wrote it, from which run and source document, and the context size at\n     7\tthe time.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport re\n    12\timport uuid\n    13\tfrom typing import Any\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\tfrom app.tools import Tool\n    17\t\n    18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n    19\tMAX_NOTE_CHARS = 800\n    20\tINSTRUCTION_LIKE = [\n    21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n    22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n    23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n    24\t    re.compile(r\"https?://\"),\n    25\t]\n    26\t\n    27\t\n    28\tclass NoteRejected(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tdef check_note(text: str) -> None:\n    33\t    if len(text) > MAX_NOTE_CHARS:\n    34\t        raise NoteRejected(\"note too long\")\n    35\t    for pattern in INSTRUCTION_LIKE:\n    36\t        if pattern.search(text):\n    37\t            raise NoteRejected(\"note looks like an instruction\")\n    38\t\n    39\t\n    40\tdef tools(deps) -> list[Tool]:\n    41\t    pool = deps.pool\n    42\t\n    43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n    44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n    45\t        rows = await pool.fetch(\n    46\t            \"\"\"\n    47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n    48\t            FROM dept_notes\n    49\t            WHERE business_unit = $1\n    50\t              AND department = $2\n    51\t              AND NOT quarantined\n    52\t              AND (verified OR expires_at > now())\n    53\t            ORDER BY created_at DESC\n    54\t            LIMIT 20\n    55\t            \"\"\",\n    56\t            business_unit,\n    57\t            args[\"department\"],\n    58\t        )\n    59\t        return [\n    60\t            {\n    61\t                \"note_id\": r[\"note_id\"],\n    62\t                \"kind\": r[\"kind\"],\n    63\t                \"body\": r[\"body\"],\n    64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n    65\t                \"written\": r[\"created_at\"].isoformat(),\n    66\t            }\n    67\t            for r in rows\n    68\t        ]\n    69\t\n    70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n    71\t        if args[\"kind\"] not in NOTE_KINDS:\n    72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n    73\t        check_note(args[\"body\"])\n    74\t        note_id = f\"note-{uuid.uuid4()}\"\n    75\t        ctx = deps.current_context(ident)\n    76\t        await pool.execute(\n    77\t            \"\"\"\n    78\t            INSERT INTO dept_notes (\n    79\t                note_id, business_unit, department, kind, body,\n    80\t                verified, quarantined, expires_at,\n    81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n    82\t                delegated_subject, context_tokens, context_method, created_at\n    83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n    84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n    85\t            \"\"\",\n    86\t            note_id,\n    87\t            ident.tenant,\n    88\t            args[\"department\"],\n    89\t            args[\"kind\"],\n    90\t            args[\"body\"],\n    91\t            ident.agent_instance_id,\n    92\t            ident.agent_type_id,\n    93\t            ident.run_id,\n    94\t            args.get(\"source_doc_id\"),\n    95\t            ident.delegated_subject,\n    96\t            ctx.tokens,\n    97\t            ctx.method,\n    98\t        )\n    99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n   100\t\n   101\t    return [\n   102\t        Tool(\n   103\t            name=\"memory_read\",\n   104\t            description=(\n   105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n   106\t                \"shared-services staff may look up another unit's notes.\"\n   107\t            ),\n   108\t            input_schema={\n   109\t                \"type\": \"object\",\n   110\t                \"properties\": {\n   111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n   113\t                },\n   114\t                \"required\": [\"department\"],\n   115\t                \"additionalProperties\": False,\n   116\t            },\n   117\t            invoke=memory_read,\n   118\t        ),\n   119\t        Tool(\n   120\t            name=\"memory_write\",\n   121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n   122\t            input_schema={\n   123\t                \"type\": \"object\",\n   124\t                \"properties\": {\n   125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n   127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n   128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n   129\t                },\n   130\t                \"required\": [\"department\", \"kind\", \"body\"],\n   131\t                \"additionalProperties\": False,\n   132\t            },\n   133\t            invoke=memory_write,\n   134\t        ),\n   135\t    ]\n-- Procurement agent schema. Applied by the migration job with the\n-- procurement_owner role; the running agent connects as procurement_agent.\n\nCREATE TABLE audit_events (\n    node_id             text PRIMARY KEY,\n    parent_node_id      text REFERENCES audit_events (node_id),\n    run_id              text NOT NULL,\n    ts                  timestamptz NOT NULL,\n    kind                text NOT NULL,\n    accountable_party   text NOT NULL CHECK (accountable_party <> ''),\n    operational_owner   text NOT NULL CHECK (operational_owner <> ''),\n    tenant              text NOT NULL CHECK (tenant <> ''),\n    agent_type_id       text NOT NULL CHECK (agent_type_id <> ''),\n    agent_instance_id   text NOT NULL CHECK (agent_instance_id <> ''),\n    trace_id            text NOT NULL CHECK (trace_id <> ''),\n    span_id             text,\n    delegated_subject   text NOT NULL,\n    agent_principal     text NOT NULL,\n    parent_instance_id  text,\n    policy_version      text,\n    approval_id         text,\n    operation_id        text,\n    context_tokens      integer CHECK (context_tokens IS NULL OR context_tokens > 0),\n    context_method      text NOT NULL,\n    context_compacted   boolean NOT NULL,\n    payload             jsonb NOT NULL\n);\nCREATE INDEX audit_events_run ON audit_events (run_id, ts);\nCREATE INDEX audit_events_instance ON audit_events (agent_instance_id, ts);\nCREATE INDEX audit_events_trace ON audit_events (trace_id);\n\nCREATE TABLE approvals (\n    id                     text PRIMARY KEY,\n    tool                   text NOT NULL,\n    target                 text NOT NULL,\n    args_sha256            text NOT NULL,\n    args_summary           jsonb NOT NULL,\n    tenant                 text NOT NULL,\n    requested_by_instance  text NOT NULL,\n    requested_by_run       text NOT NULL,\n    delegated_subject      text NOT NULL,\n    status                 text NOT NULL CHECK (status IN ('pending', 'approved', 'rejected', 'expired')),\n    requested_at           timestamptz NOT NULL,\n    expires_at             timestamptz NOT NULL,\n    approver               text,\n    approver_role          text,\n    decided_at             timestamptz\n);\nCREATE INDEX approvals_lookup ON approvals (tool, target, tenant, status);\n\nCREATE TABLE approvers (\n    slack_user_id  text PRIMARY KEY,\n    email          text NOT NULL,\n    role           text NOT NULL,\n    business_unit  text NOT NULL,\n    active         boolean NOT NULL DEFAULT true\n);\n\nCREATE TABLE documents (\n    doc_id         text PRIMARY KEY,\n    business_unit  text NOT NULL,\n    source         text NOT NULL,\n    media_type     text NOT NULL,\n    sha256         text NOT NULL,\n    status         text NOT NULL CHECK (status IN ('accepted', 'quarantined')),\n    reject_reason  text,\n    text           text,\n    received_at    timestamptz NOT NULL\n);\nCREATE INDEX documents_bu ON documents (business_unit, doc_id);\n\nCREATE TABLE dept_notes (\n    note_id            text PRIMARY KEY,\n    business_unit      text NOT NULL,\n    department         text NOT NULL,\n    kind               text NOT NULL,\n    body               text NOT NULL,\n    verified           boolean NOT NULL DEFAULT false,\n    verified_by        text,\n    quarantined        boolean NOT NULL DEFAULT false,\n    expires_at         timestamptz,\n    writer_instance    text NOT NULL,\n    writer_type_id     text NOT NULL,\n    run_id             text NOT NULL,\n    source_doc_id      text,\n    delegated_subject  text NOT NULL,\n    context_tokens     integer,\n    context_method     text NOT NULL,\n    created_at         timestamptz NOT NULL\n);\nCREATE INDEX dept_notes_lookup ON dept_notes (business_unit, department, created_at DESC);\nCREATE INDEX dept_notes_source ON dept_notes (source_doc_id);\nCREATE INDEX dept_notes_writer ON dept_notes (writer_instance);\n\nCREATE TABLE control_flags (\n    scope    text PRIMARY KEY,           -- 'fleet' or 'tenant:<business_unit>'\n    halted   boolean NOT NULL,\n    reason   text NOT NULL,\n    set_by   text NOT NULL,\n    set_at   timestamptz NOT NULL DEFAULT now()\n);\n\nCREATE TABLE spend_quota (\n    scope      text NOT NULL,\n    key        text NOT NULL,\n    day        date NOT NULL,\n    spent_usd  numeric(12, 4) NOT NULL,\n    PRIMARY KEY (scope, key, day)\n);\n\nCREATE TABLE run_start_window (\n    scope   text NOT NULL,\n    key     text NOT NULL,\n    minute  timestamptz NOT NULL,\n    starts  integer NOT NULL,\n    PRIMARY KEY (scope, key, minute)\n);\n\n-- Runtime role: append-only audit, no access to control flags beyond reading.\nREVOKE ALL ON ALL TABLES IN SCHEMA public FROM procurement_agent;\nGRANT SELECT, INSERT ON audit_events TO procurement_agent;\nGRANT SELECT, INSERT, UPDATE ON approvals TO procurement_agent;\nGRANT SELECT ON approvers TO procurement_agent;\nGRANT SELECT, INSERT ON documents TO procurement_agent;\nGRANT SELECT, INSERT ON dept_notes TO procurement_agent;\nGRANT SELECT ON control_flags TO procurement_agent;\nGRANT SELECT, INSERT, UPDATE ON spend_quota TO procurement_agent;\nGRANT SELECT, INSERT, UPDATE ON run_start_window TO procurement_agent;\n\n-- Operators: halt and resume.\nGRANT SELECT, INSERT, UPDATE ON control_flags TO procurement_ops;\nGRANT SELECT ON audit_events TO procurement_ops;\nGRANT SELECT, UPDATE (verified, verified_by, quarantined) ON dept_notes TO procurement_ops;\napiVersion: v1\nkind: Namespace\nmetadata:\n  name: procurement-prod\n  labels:\n    pod-security.kubernetes.io/enforce: restricted\n    pod-security.kubernetes.io/enforce-version: latest\n    pod-security.kubernetes.io/audit: restricted\n    pod-security.kubernetes.io/warn: restricted\n---\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: procurement-agent\n  namespace: procurement-prod\n  labels:\n    app: procurement-agent\nautomountServiceAccountToken: false\napp/killswitch.py:25:async def assert_running(pool, tenant: str) -> None:\napp/killswitch.py:26:    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\napp/tools/payments.py:18:        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\napp/tools/payments.py:27:        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\napp/tools/payments.py:32:                    \"Authorization\": f\"Bearer {token}\",\napp/tools/payments.py:36:                    \"business_unit\": ident.tenant,\napp/tools/erp.py:19:            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\napp/tools/erp.py:26:        arguments[\"business_unit\"] = ident.tenant\napp/tools/erp.py:33:                \"business_unit\": ident.tenant,\napp/tools/memory.py:44:        business_unit = args.get(\"business_unit\") or ident.tenant\napp/tools/memory.py:87:            ident.tenant,\napp/tools/documents.py:27:            ident.tenant,\napp/tools/slack.py:38:                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\napp/tools/slack.py:48:        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\napp/tools/slack.py:53:            channel=f\"#approvals-{tenant}\",\napp/audit.py:44:    accountable_party, operational_owner, tenant,\napp/audit.py:102:        ident.tenant,\napp/approvals.py:45:                id, tool, target, args_sha256, args_summary, tenant,\napp/approvals.py:55:            ident.tenant,\napp/approvals.py:62:            tenant=ident.tenant,\napp/approvals.py:78:              AND tenant = $3\napp/approvals.py:86:            ident.tenant,\napp/budget.py:7:Across runs: daily spend and per-minute run starts per user, per tenant\napp/budget.py:73:            (\"tenant\", self.ident.tenant),\napp/loop.py:127:        await killswitch.assert_running(pool, ident.tenant)\napp/loop.py:182:                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\napp/mcp_client.py:77:                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\napp/mcp_client.py:92:        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\napp/mcp_client.py:108:        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\napp/mcp_client.py:119:        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\napp/mcp_client.py:125:                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\napp/main.py:19:from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\napp/main.py:54:def service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\napp/main.py:58:        tenant=tenant,\napp/main.py:88:        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\napp/main.py:122:def authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\napp/main.py:150:        tenant=principal.business_unit,\nconfig/policy.yaml:48:    tenant: 250\nconfig/policy.yaml:52:    tenant: 40","is_error":false}]},"parent_tool_use_id":null,"session_id":"43f55bb4-3ca6-4bab-a7e4-15740d8fb479","uuid":"5e9efcbe-46f6-4513-a0cb-b8e6b23fa03e","timestamp":"2026-10-02T16:09:57.522Z","tool_use_result":{"stdout":"     1\t\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n     2\t\n     3\tThe agent runs under its own Kubernetes service account. Its projected\n     4\tservice-account token is exchanged at the internal STS for short-lived,\n     5\taudience-bound tokens. The launching user's token is never forwarded to an\n     6\tintegration; the user is carried as the delegated subject of the exchange.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport time\n    13\timport uuid\n    14\tfrom dataclasses import dataclass, field, replace\n    15\tfrom pathlib import Path\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.settings import Settings\n    20\t\n    21\tIDENTITY_FIELDS = (\n    22\t    \"accountable_party\",\n    23\t    \"operational_owner\",\n    24\t    \"tenant\",\n    25\t    \"agent_type_id\",\n    26\t    \"agent_instance_id\",\n    27\t    \"trace_id\",\n    28\t)\n    29\t\n    30\t\n    31\t@dataclass(frozen=True)\n    32\tclass RunIdentity:\n    33\t    accountable_party: str\n    34\t    operational_owner: str\n    35\t    tenant: str\n    36\t    agent_type_id: str\n    37\t    agent_instance_id: str\n    38\t    trace_id: str\n    39\t    run_id: str\n    40\t    delegated_subject: str\n    41\t    agent_principal: str\n    42\t    parent_instance_id: str | None = None\n    43\t    role: str = \"procurement\"\n    44\t\n    45\t    def __post_init__(self) -> None:\n    46\t        for name in IDENTITY_FIELDS:\n    47\t            if not getattr(self, name):\n    48\t                raise ValueError(f\"identity field {name} is empty\")\n    49\t\n    50\t    def child(self, role: str) -> \"RunIdentity\":\n    51\t        return replace(\n    52\t            self,\n    53\t            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n    54\t            parent_instance_id=self.agent_instance_id,\n    55\t            role=role,\n    56\t        )\n    57\t\n    58\t\n    59\tdef new_instance_id() -> str:\n    60\t    return f\"inst-{uuid.uuid4()}\"\n    61\t\n    62\t\n    63\tdef compute_agent_type_id(manifest: dict) -> str:\n    64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    65\t    material = {\n    66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n    67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n    68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n    69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n    70\t        \"models\": manifest[\"models\"],\n    71\t        \"config\": manifest[\"config\"],\n    72\t        \"tools\": manifest[\"tool_pins\"],\n    73\t    }\n    74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n    76\t\n    77\t\n    78\t@dataclass\n    79\tclass _CachedToken:\n    80\t    value: str\n    81\t    expires_at: float\n    82\t\n    83\t\n    84\t@dataclass\n    85\tclass TokenBroker:\n    86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n    87\t\n    88\t    settings: Settings\n    89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n    90\t\n    91\t    def _workload_token(self) -> str:\n    92\t        return Path(self.settings.workload_token_path).read_text().strip()\n    93\t\n    94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n    95\t        key = (audience, scope, ident.tenant)\n    96\t        cached = self._cache.get(key)\n    97\t        if cached and cached.expires_at - 30 > time.time():\n    98\t            return cached.value\n    99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n   100\t            resp = await client.post(\n   101\t                self.settings.sts_url,\n   102\t                data={\n   103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n   104\t                    \"subject_token\": self._workload_token(),\n   105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n   106\t                    \"audience\": audience,\n   107\t                    \"scope\": scope,\n   108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n   109\t                    \"actor_token\": ident.delegated_subject,\n   110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n   111\t                },\n   112\t            )\n   113\t            resp.raise_for_status()\n   114\t            body = resp.json()\n   115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n   116\t        self._cache[key] = token\n   117\t        return token.value\n   120\t\n   121\t\n   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n   123\t    settings = request.app.state.settings\n   124\t    try:\n   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n   126\t        claims = jwt.decode(\n   127\t            creds.credentials,\n   128\t            key.key,\n   129\t            algorithms=[\"RS256\", \"ES256\"],\n   130\t            audience=settings.oidc_audience,\n   131\t            issuer=settings.oidc_issuer,\n   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n   133\t        )\n   134\t    except jwt.PyJWTError as exc:\n   135\t        raise HTTPException(401, \"invalid token\") from exc\n   136\t    bu = claims.get(\"bu\")\n   137\t    if not bu:\n   138\t        raise HTTPException(403, \"token has no business unit\")\n   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n   140\t\n   141\t\n   142\t@app.post(\"/runs\")\n   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n   144\t    settings = request.app.state.settings\n   145\t    span_ctx = trace.get_current_span().get_span_context()\n   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n   147\t    ident = RunIdentity(\n   148\t        accountable_party=principal.subject,\n   149\t        operational_owner=settings.operational_owner,\n   150\t        tenant=principal.business_unit,\n   151\t        agent_type_id=request.app.state.agent_type_id,\n   152\t        agent_instance_id=new_instance_id(),\n   153\t        trace_id=trace_id,\n   154\t        run_id=f\"run-{uuid.uuid4()}\",\n   155\t        delegated_subject=principal.subject,\n   156\t        agent_principal=AGENT_PRINCIPAL,\n   157\t    )\n   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n   161\t\n   162\t\n   163\t@app.post(\"/slack/interactions\")\n   164\tasync def slack_interactions(request: Request) -> dict:\n   165\t    body = await request.body()\n   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n   167\t    if abs(time.time() - int(timestamp)) > 300:\n   168\t        raise HTTPException(401, \"stale request\")\n   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n   172\t        raise HTTPException(401, \"bad signature\")\n   173\t\n   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n   175\t    action = payload[\"actions\"][0]\n   176\t    slack_user = payload[\"user\"][\"id\"]\n   177\t    row = await request.app.state.pool.fetchrow(\n   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n   179\t    )\n   180\t    if row is None:\n   181\t        raise HTTPException(403, \"not an approver\")\n   182\t    try:\n   183\t        await request.app.state.approvals.decide(\n   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n   185\t            approve=action[\"action_id\"] == \"approve\",\n   186\t        )\n   187\t    except ApproverNotAuthorized as exc:\n   188\t        raise HTTPException(403, str(exc)) from exc\n   189\t    except ValueError as exc:\n   190\t        raise HTTPException(409, str(exc)) from exc\n     1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n     2\t\n     3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n     4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n     5\tuntil a procurement lead verifies them in the admin UI. Every row records\n     6\twho wrote it, from which run and source document, and the context size at\n     7\tthe time.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport re\n    12\timport uuid\n    13\tfrom typing import Any\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\tfrom app.tools import Tool\n    17\t\n    18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n    19\tMAX_NOTE_CHARS = 800\n    20\tINSTRUCTION_LIKE = [\n    21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n    22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n    23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n    24\t    re.compile(r\"https?://\"),\n    25\t]\n    26\t\n    27\t\n    28\tclass NoteRejected(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tdef check_note(text: str) -> None:\n    33\t    if len(text) > MAX_NOTE_CHARS:\n    34\t        raise NoteRejected(\"note too long\")\n    35\t    for pattern in INSTRUCTION_LIKE:\n    36\t        if pattern.search(text):\n    37\t            raise NoteRejected(\"note looks like an instruction\")\n    38\t\n    39\t\n    40\tdef tools(deps) -> list[Tool]:\n    41\t    pool = deps.pool\n    42\t\n    43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n    44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n    45\t        rows = await pool.fetch(\n    46\t            \"\"\"\n    47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n    48\t            FROM dept_notes\n    49\t            WHERE business_unit = $1\n    50\t              AND department = $2\n    51\t              AND NOT quarantined\n    52\t              AND (verified OR expires_at > now())\n    53\t            ORDER BY created_at DESC\n    54\t            LIMIT 20\n    55\t            \"\"\",\n    56\t            business_unit,\n    57\t            args[\"department\"],\n    58\t        )\n    59\t        return [\n    60\t            {\n    61\t                \"note_id\": r[\"note_id\"],\n    62\t                \"kind\": r[\"kind\"],\n    63\t                \"body\": r[\"body\"],\n    64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n    65\t                \"written\": r[\"created_at\"].isoformat(),\n    66\t            }\n    67\t            for r in rows\n    68\t        ]\n    69\t\n    70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n    71\t        if args[\"kind\"] not in NOTE_KINDS:\n    72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n    73\t        check_note(args[\"body\"])\n    74\t        note_id = f\"note-{uuid.uuid4()}\"\n    75\t        ctx = deps.current_context(ident)\n    76\t        await pool.execute(\n    77\t            \"\"\"\n    78\t            INSERT INTO dept_notes (\n    79\t                note_id, business_unit, department, kind, body,\n    80\t                verified, quarantined, expires_at,\n    81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n    82\t                delegated_subject, context_tokens, context_method, created_at\n    83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n    84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n    85\t            \"\"\",\n    86\t            note_id,\n    87\t            ident.tenant,\n    88\t            args[\"department\"],\n    89\t            args[\"kind\"],\n    90\t            args[\"body\"],\n    91\t            ident.agent_instance_id,\n    92\t            ident.agent_type_id,\n    93\t            ident.run_id,\n    94\t            args.get(\"source_doc_id\"),\n    95\t            ident.delegated_subject,\n    96\t            ctx.tokens,\n    97\t            ctx.method,\n    98\t        )\n    99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n   100\t\n   101\t    return [\n   102\t        Tool(\n   103\t            name=\"memory_read\",\n   104\t            description=(\n   105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n   106\t                \"shared-services staff may look up another unit's notes.\"\n   107\t            ),\n   108\t            input_schema={\n   109\t                \"type\": \"object\",\n   110\t                \"properties\": {\n   111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n   113\t                },\n   114\t                \"required\": [\"department\"],\n   115\t                \"additionalProperties\": False,\n   116\t            },\n   117\t            invoke=memory_read,\n   118\t        ),\n   119\t        Tool(\n   120\t            name=\"memory_write\",\n   121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n   122\t            input_schema={\n   123\t                \"type\": \"object\",\n   124\t                \"properties\": {\n   125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n   127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n   128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n   129\t                },\n   130\t                \"required\": [\"department\", \"kind\", \"body\"],\n   131\t                \"additionalProperties\": False,\n   132\t            },\n   133\t            invoke=memory_write,\n   134\t        ),\n   135\t    ]\n-- Procurement agent schema. Applied by the migration job with the\n-- procurement_owner role; the running agent connects as procurement_agent.\n\nCREATE TABLE audit_events (\n    node_id             text PRIMARY KEY,\n    parent_node_id      text REFERENCES audit_events (node_id),\n    run_id              text NOT NULL,\n    ts                  timestamptz NOT NULL,\n    kind                text NOT NULL,\n    accountable_party   text NOT NULL CHECK (accountable_party <> ''),\n    operational_owner   text NOT NULL CHECK (operational_owner <> ''),\n    tenant              text NOT NULL CHECK (tenant <> ''),\n    agent_type_id       text NOT NULL CHECK (agent_type_id <> ''),\n    agent_instance_id   text NOT NULL CHECK (agent_instance_id <> ''),\n    trace_id            text NOT NULL CHECK (trace_id <> ''),\n    span_id             text,\n    delegated_subject   text NOT NULL,\n    agent_principal     text NOT NULL,\n    parent_instance_id  text,\n    policy_version      text,\n    approval_id         text,\n    operation_id        text,\n    context_tokens      integer CHECK (context_tokens IS NULL OR context_tokens > 0),\n    context_method      text NOT NULL,\n    context_compacted   boolean NOT NULL,\n    payload             jsonb NOT NULL\n);\nCREATE INDEX audit_events_run ON audit_events (run_id, ts);\nCREATE INDEX audit_events_instance ON audit_events (agent_instance_id, ts);\nCREATE INDEX audit_events_trace ON audit_events (trace_id);\n\nCREATE TABLE approvals (\n    id                     text PRIMARY KEY,\n    tool                   text NOT NULL,\n    target                 text NOT NULL,\n    args_sha256            text NOT NULL,\n    args_summary           jsonb NOT NULL,\n    tenant                 text NOT NULL,\n    requested_by_instance  text NOT NULL,\n    requested_by_run       text NOT NULL,\n    delegated_subject      text NOT NULL,\n    status                 text NOT NULL CHECK (status IN ('pending', 'approved', 'rejected', 'expired')),\n    requested_at           timestamptz NOT NULL,\n    expires_at             timestamptz NOT NULL,\n    approver               text,\n    approver_role          text,\n    decided_at             timestamptz\n);\nCREATE INDEX approvals_lookup ON approvals (tool, target, tenant, status);\n\nCREATE TABLE approvers (\n    slack_user_id  text PRIMARY KEY,\n    email          text NOT NULL,\n    role           text NOT NULL,\n    business_unit  text NOT NULL,\n    active         boolean NOT NULL DEFAULT true\n);\n\nCREATE TABLE documents (\n    doc_id         text PRIMARY KEY,\n    business_unit  text NOT NULL,\n    source         text NOT NULL,\n    media_type     text NOT NULL,\n    sha256         text NOT NULL,\n    status         text NOT NULL CHECK (status IN ('accepted', 'quarantined')),\n    reject_reason  text,\n    text           text,\n    received_at    timestamptz NOT NULL\n);\nCREATE INDEX documents_bu ON documents (business_unit, doc_id);\n\nCREATE TABLE dept_notes (\n    note_id            text PRIMARY KEY,\n    business_unit      text NOT NULL,\n    department         text NOT NULL,\n    kind               text NOT NULL,\n    body               text NOT NULL,\n    verified           boolean NOT NULL DEFAULT false,\n    verified_by        text,\n    quarantined        boolean NOT NULL DEFAULT false,\n    expires_at         timestamptz,\n    writer_instance    text NOT NULL,\n    writer_type_id     text NOT NULL,\n    run_id             text NOT NULL,\n    source_doc_id      text,\n    delegated_subject  text NOT NULL,\n    context_tokens     integer,\n    context_method     text NOT NULL,\n    created_at         timestamptz NOT NULL\n);\nCREATE INDEX dept_notes_lookup ON dept_notes (business_unit, department, created_at DESC);\nCREATE INDEX dept_notes_source ON dept_notes (source_doc_id);\nCREATE INDEX dept_notes_writer ON dept_notes (writer_instance);\n\nCREATE TABLE control_flags (\n    scope    text PRIMARY KEY,           -- 'fleet' or 'tenant:<business_unit>'\n    halted   boolean NOT NULL,\n    reason   text NOT NULL,\n    set_by   text NOT NULL,\n    set_at   timestamptz NOT NULL DEFAULT now()\n);\n\nCREATE TABLE spend_quota (\n    scope      text NOT NULL,\n    key        text NOT NULL,\n    day        date NOT NULL,\n    spent_usd  numeric(12, 4) NOT NULL,\n    PRIMARY KEY (scope, key, day)\n);\n\nCREATE TABLE run_start_window (\n    scope   text NOT NULL,\n    key     text NOT NULL,\n    minute  timestamptz NOT NULL,\n    starts  integer NOT NULL,\n    PRIMARY KEY (scope, key, minute)\n);\n\n-- Runtime role: append-only audit, no access to control flags beyond reading.\nREVOKE ALL ON ALL TABLES IN SCHEMA public FROM procurement_agent;\nGRANT SELECT, INSERT ON audit_events TO procurement_agent;\nGRANT SELECT, INSERT, UPDATE ON approvals TO procurement_agent;\nGRANT SELECT ON approvers TO procurement_agent;\nGRANT SELECT, INSERT ON documents TO procurement_agent;\nGRANT SELECT, INSERT ON dept_notes TO procurement_agent;\nGRANT SELECT ON control_flags TO procurement_agent;\nGRANT SELECT, INSERT, UPDATE ON spend_quota TO procurement_agent;\nGRANT SELECT, INSERT, UPDATE ON run_start_window TO procurement_agent;\n\n-- Operators: halt and resume.\nGRANT SELECT, INSERT, UPDATE ON control_flags TO procurement_ops;\nGRANT SELECT ON audit_events TO procurement_ops;\nGRANT SELECT, UPDATE (verified, verified_by, quarantined) ON dept_notes TO procurement_ops;\napiVersion: v1\nkind: Namespace\nmetadata:\n  name: procurement-prod\n  labels:\n    pod-security.kubernetes.io/enforce: restricted\n    pod-security.kubernetes.io/enforce-version: latest\n    pod-security.kubernetes.io/audit: restricted\n    pod-security.kubernetes.io/warn: restricted\n---\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: procurement-agent\n  namespace: procurement-prod\n  labels:\n    app: procurement-agent\nautomountServiceAccountToken: false\napp/killswitch.py:25:async def assert_running(pool, tenant: str) -> None:\napp/killswitch.py:26:    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\napp/tools/payments.py:18:        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\napp/tools/payments.py:27:        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\napp/tools/payments.py:32:                    \"Authorization\": f\"Bearer {token}\",\napp/tools/payments.py:36:                    \"business_unit\": ident.tenant,\napp/tools/erp.py:19:            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\napp/tools/erp.py:26:        arguments[\"business_unit\"] = ident.tenant\napp/tools/erp.py:33:                \"business_unit\": ident.tenant,\napp/tools/memory.py:44:        business_unit = args.get(\"business_unit\") or ident.tenant\napp/tools/memory.py:87:            ident.tenant,\napp/tools/documents.py:27:            ident.tenant,\napp/tools/slack.py:38:                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\napp/tools/slack.py:48:        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\napp/tools/slack.py:53:            channel=f\"#approvals-{tenant}\",\napp/audit.py:44:    accountable_party, operational_owner, tenant,\napp/audit.py:102:        ident.tenant,\napp/approvals.py:45:                id, tool, target, args_sha256, args_summary, tenant,\napp/approvals.py:55:            ident.tenant,\napp/approvals.py:62:            tenant=ident.tenant,\napp/approvals.py:78:              AND tenant = $3\napp/approvals.py:86:            ident.tenant,\napp/budget.py:7:Across runs: daily spend and per-minute run starts per user, per tenant\napp/budget.py:73:            (\"tenant\", self.ident.tenant),\napp/loop.py:127:        await killswitch.assert_running(pool, ident.tenant)\napp/loop.py:182:                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\napp/mcp_client.py:77:                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\napp/mcp_client.py:92:        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\napp/mcp_client.py:108:        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\napp/mcp_client.py:119:        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\napp/mcp_client.py:125:                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\napp/main.py:19:from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\napp/main.py:54:def service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\napp/main.py:58:        tenant=tenant,\napp/main.py:88:        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\napp/main.py:122:def authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\napp/main.py:150:        tenant=principal.business_unit,\nconfig/policy.yaml:48:    tenant: 250\nconfig/policy.yaml:52:    tenant: 40","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
