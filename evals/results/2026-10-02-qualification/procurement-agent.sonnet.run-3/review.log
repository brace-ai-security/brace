 \"registry.example-corp.test/procurement/*\"\n250\t    37\t          mutateDigest: false\n251\t    38\t          verifyDigest: true\n252\t    39\t          required: true\n253\t    40\t          attestors:\n254\t    41\t            - entries:\n255\t    42\t                - keyless:\n256\t    43\t                    issuer: \"https://token.actions.githubusercontent.com\"\n257\t    44\t                    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n258\t    45\t                    rekor:\n259\t    46\t                      url: https://rekor.sigstore.dev\n260\t    47\t          attestations:\n261\t    48\t            - type: https://slsa.dev/provenance/v1\n262\t    49\t              attestors:\n263\t    50\t                - entries:\n264\t    51\t                    - keyless:\n265\t    52\t                        issuer: \"https://token.actions.githubusercontent.com\"\n266\t    53\t                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n267\t    54\t              conditions:\n268\t    55\t                - all:\n269\t    56\t                    - key: \"{{ buildDefinition.buildType }}\"\n270\t    57\t                      operator: Equals\n271\t    58\t                      value: \"https://actions.github.io/buildtypes/workflow/v1\"\n272\t    59\t                    - key: \"{{ buildDefinition.externalParameters.workflow.repository }}\"\n273\t    60\t                      operator: Equals\n274\t    61\t                      value: \"https://github.com/example-corp/procurement-agent\"\n275\t    62\t                    - key: \"{{ buildDefinition.externalParameters.workflow.ref }}\"\n276\t    63\t                      operator: Equals\n277\t    64\t                      value: \"refs/heads/main\"\n278\t    65\t                    - key: \"{{ buildDefinition.externalParameters.workflow.path }}\"\n279\t    66\t                      op