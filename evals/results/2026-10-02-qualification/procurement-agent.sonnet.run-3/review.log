{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012MLBAh7KEeYXLZMgeaBvdz","type":"tool_result","content":"1700\t    58\t\n1701\t    59\t@lru_cache(maxsize=1)\n1702\t    60\tdef get_settings() -> Settings:\n1703\t    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n1704\t    62\t    return Settings(\n1705\t    63\t        database_url=_env(\"DATABASE_URL\"),\n1706\t    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n1707\t    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n1708\t    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n1709\t    67\t        sts_url=_env(\"STS_URL\"),\n1710\t    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n1711\t    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n1712\t    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n1713\t    71\t        workload_token_path=_env(\n1714\t    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n1715\t    73\t        ),\n1716\t    74\t        slack_signing_secret_path=_env(\n1717\t    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n1718\t    76\t        ),\n1719\t    77\t        mail_gateway_hmac_path=_env(\n1720\t    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n1721\t    79\t        ),\n1722\t    80\t        model_id=_env(\"MODEL_ID\"),\n1723\t    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n1724\t    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n1725\t    83\t        prompt_dir=root / \"prompts\",\n1726\t    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n1727\t    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n1728\t    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n1729\t    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n1730\t    88\t    )\n1731\t=== app/startup.py\n1732\t     1\t\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\n1733\t     2\tfrom __future__ import annotations\n1734\t     3\t\n1735\t     4\timport hashlib\n1736\t     5\timport logging\n1737\t     6\tfrom pathlib import Path\n1738\t     7\t\n1739\t     8\tfrom app.identity import compute_agent_type_id\n1740\t     9\tfrom app.settings import Settings\n1741\t    10\t\n1742\t    11\tlog = logging.getLogger(__name__)\n1743\t    12\t\n1744\t    13\t\n1745\t    14\tdef sha256_file(path: Path) -> str:\n1746\t    15\t    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n1747\t    16\t\n1748\t    17\t\n1749\t    18\tdef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n1750\t    19\t    mismatches: list[str] = []\n1751\t    20\t    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n1752\t    21\t        mismatches.append(f\"image: running {settings.image_digest}\")\n1753\t    22\t    for name, entry in manifest[\"prompts\"].items():\n1754\t    23\t        path = settings.prompt_dir / Path(entry[\"path\"]).name\n1755\t    24\t        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n1756\t    25\t            mismatches.append(f\"prompt:{name}\")\n1757\t    26\t    for name in (\"policy\", \"tools\"):\n1758\t    27\t        entry = manifest[\"config\"][name]\n1759\t    28\t        path = settings.policy_path if name == \"policy\" else settings.tools_path\n1760\t    29\t        if sha256_file(path) != entry[\"sha256\"]:\n1761\t    30\t            mismatches.append(f\"config:{name}\")\n1762\t    31\t    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n1763\t    32\t        mismatches.append(\"model:primary\")\n1764\t    33\t    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n1765\t    34\t        mismatches.append(\"model:extractor\")\n1766\t    35\t    return mismatches\n1767\t    36\t\n1768\t    37\t\n1769\t    38\tdef startup_checks(settings: Settings) -> str:\n1770\t    39\t    \"\"\"Return the agent-type-id for this process.\"\"\"\n1771\t    40\t    manifest = settings.manifest\n1772\t    41\t    mismatches = running_state_mismatches(settings, manifest)\n1773\t    42\t    if mismatches:\n1774\t    43\t        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n1775\t    44\t    agent_type_id = compute_agent_type_id(manifest)\n1776\t    45\t    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n1777\t    46\t    return agent_type_id\n1778\t=== app/tools/__init__.py\n1779\t     1\t\"\"\"Tool registry.\n1780\t     2\t\n1781\t     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n1782\t     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n1783\t     5\tthat is not in the run's registry.\n1784\t     6\t\"\"\"\n1785\t     7\tfrom __future__ import annotations\n1786\t     8\t\n1787\t     9\tfrom dataclasses import dataclass\n1788\t    10\tfrom functools import lru_cache\n1789\t    11\tfrom typing import Any, Awaitable, Callable\n1790\t    12\t\n1791\t    13\timport yaml\n1792\t    14\t\n1793\t    15\tfrom app.identity import RunIdentity\n1794\t    16\t\n1795\t    17\tDEFAULT_ROLE = \"procurement\"\n1796\t    18\t\n1797\t    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n1798\t    20\t\n1799\t    21\t\n1800\t    22\t@dataclass(frozen=True)\n1801\t    23\tclass Tool:\n1802\t    24\t    name: str\n1803\t    25\t    description: str\n1804\t    26\t    input_schema: dict[str, Any]\n1805\t    27\t    invoke: Invoke\n1806\t    28\t    target_field: str | None = None\n1807\t    29\t\n1808\t    30\t    def target_of(self, args: dict[str, Any]) -> str:\n1809\t    31\t        if self.target_field is None:\n1810\t    32\t            return self.name\n1811\t    33\t        return str(args.get(self.target_field, \"\"))\n1812\t    34\t\n1813\t    35\t    def schema(self) -> dict[str, Any]:\n1814\t    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n1815\t    37\t\n1816\t    38\t\n1817\t    39\tclass ToolRegistry:\n1818\t    40\t    def __init__(self, tools: list[Tool]):\n1819\t    41\t        self._tools = {t.name: t for t in tools}\n1820\t    42\t\n1821\t    43\t    def get(self, name: str) -> Tool | None:\n1822\t    44\t        return self._tools.get(name)\n1823\t    45\t\n1824\t    46\t    def names(self) -> list[str]:\n1825\t    47\t        return sorted(self._tools)\n1826\t    48\t\n1827\t    49\t    def schemas(self) -> list[dict[str, Any]]:\n1828\t    50\t        return [self._tools[n].schema() for n in self.names()]\n1829\t    51\t\n1830\t    52\t\n1831\t    53\t@lru_cache(maxsize=1)\n1832\t    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n1833\t    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n1834\t    56\t        cfg = yaml.safe_load(fh)\n1835\t    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n1836\t    58\t\n1837\t    59\t\n1838\t    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n1839\t    61\t    from app.tools import documents, erp, memory, payments, slack\n1840\t    62\t\n1841\t    63\t    available: dict[str, Tool] = {}\n1842\t    64\t    for module in (documents, erp, memory, payments, slack):\n1843\t    65\t        for tool in module.tools(deps):\n1844\t    66\t            available[tool.name] = tool\n1845\t    67\t\n1846\t    68\t    roles = _role_tools(str(deps.settings.tools_path))\n1847\t    69\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n1848\t    70\t    return ToolRegistry([available[name] for name in allowed if name in available])\n1849\t=== app/tools/documents.py\n1850\t     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n1851\t     2\tfrom __future__ import annotations\n1852\t     3\t\n1853\t     4\tfrom typing import Any\n1854\t     5\t\n1855\t     6\tfrom app.identity import RunIdentity\n1856\t     7\tfrom app.tools import Tool\n1857\t     8\t\n1858\t     9\tUNTRUSTED_WRAPPER = (\n1859\t    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n1860\t    11\t    \"{text}\\n\"\n1861\t    12\t    \"</untrusted_document>\"\n1862\t    13\t)\n1863\t    14\t\n1864\t    15\t\n1865\t    16\tdef tools(deps) -> list[Tool]:\n1866\t    17\t    pool = deps.pool\n1867\t    18\t\n1868\t    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n1869\t    20\t        row = await pool.fetchrow(\n1870\t    21\t            \"\"\"\n1871\t    22\t            SELECT doc_id, source, media_type, text\n1872\t    23\t            FROM documents\n1873\t    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n1874\t    25\t            \"\"\",\n1875\t    26\t            args[\"doc_id\"],\n1876\t    27\t            ident.tenant,\n1877\t    28\t        )\n1878\t    29\t        if row is None:\n1879\t    30\t            return \"document not found\"\n1880\t    31\t        return UNTRUSTED_WRAPPER.format(\n1881\t    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n1882\t    33\t        )\n1883\t    34\t\n1884\t    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n1885\t    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n1886\t    37\t\n1887\t    38\t    return [\n1888\t    39\t        Tool(\n1889\t    40\t            name=\"read_document\",\n1890\t    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n1891\t    42\t            input_schema={\n1892\t    43\t                \"type\": \"object\",\n1893\t    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n1894\t    45\t                \"required\": [\"doc_id\"],\n1895\t    46\t                \"additionalProperties\": False,\n1896\t    47\t            },\n1897\t    48\t            invoke=read_document,\n1898\t    49\t        ),\n1899\t    50\t        Tool(\n1900\t    51\t            name=\"extract_line_items\",\n1901\t    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n1902\t    53\t            input_schema={\n1903\t    54\t                \"type\": \"object\",\n1904\t    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n1905\t    56\t                \"required\": [\"doc_id\"],\n1906\t    57\t                \"additionalProperties\": False,\n1907\t    58\t            },\n1908\t    59\t            invoke=extract_line_items,\n1909\t    60\t        ),\n1910\t    61\t    ]\n1911\t=== app/tools/erp.py\n1912\t     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n1913\t     2\tfrom __future__ import annotations\n1914\t     3\t\n1915\t     4\tfrom typing import Any\n1916\t     5\t\n1917\t     6\tfrom app.identity import RunIdentity\n1918\t     7\tfrom app.tools import Tool\n1919\t     8\t\n1920\t     9\tERP_READ_SCOPE = \"erp.read\"\n1921\t    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n1922\t    11\t\n1923\t    12\t\n1924\t    13\tdef tools(deps) -> list[Tool]:\n1925\t    14\t    erp = deps.erp\n1926\t    15\t\n1927\t    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n1928\t    17\t        return await erp.call(\n1929\t    18\t            \"budget.get_remaining\",\n1930\t    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n1931\t    20\t            ident,\n1932\t    21\t            ERP_READ_SCOPE,\n1933\t    22\t        )\n1934\t    23\t\n1935\t    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n1936\t    25\t        arguments = dict(args.get(\"arguments\", {}))\n1937\t    26\t        arguments[\"business_unit\"] = ident.tenant\n1938\t    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n1939\t    28\t\n1940\t    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n1941\t    30\t        return await erp.call(\n1942\t    31\t            \"po.create\",\n1943\t    32\t            {\n1944\t    33\t                \"business_unit\": ident.tenant,\n1945\t    34\t                \"department\": args[\"department\"],\n1946\t    35\t                \"vendor_id\": args[\"vendor_id\"],\n1947\t    36\t                \"lines\": args[\"lines\"],\n1948\t    37\t                \"currency\": args[\"currency\"],\n1949\t    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n1950\t    39\t                \"client_reference\": args[\"source_doc_id\"],\n1951\t    40\t            },\n1952\t    41\t            ident,\n1953\t    42\t            ERP_PO_WRITE_SCOPE,\n1954\t    43\t        )\n1955\t    44\t\n1956\t    45\t    line_schema = {\n1957\t    46\t        \"type\": \"object\",\n1958\t    47\t        \"properties\": {\n1959\t    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n1960\t    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n1961\t    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n1962\t    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n1963\t    52\t        },\n1964\t    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n1965\t    54\t        \"additionalProperties\": False,\n1966\t    55\t    }\n1967\t    56\t\n1968\t    57\t    return [\n1969\t    58\t        Tool(\n1970\t    59\t            name=\"get_budget\",\n1971\t    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n1972\t    61\t            input_schema={\n1973\t    62\t                \"type\": \"object\",\n1974\t    63\t                \"properties\": {\n1975\t    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n1976\t    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n1977\t    66\t                },\n1978\t    67\t                \"required\": [\"department\", \"fiscal_period\"],\n1979\t    68\t                \"additionalProperties\": False,\n1980\t    69\t            },\n1981\t    70\t            invoke=get_budget,\n1982\t    71\t        ),\n1983\t    72\t        Tool(\n1984\t    73\t            name=\"erp_call\",\n1985\t    74\t            description=(\n1986\t    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n1987\t    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n1988\t    77\t            ),\n1989\t    78\t            input_schema={\n1990\t    79\t                \"type\": \"object\",\n1991\t    80\t                \"properties\": {\n1992\t    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n1993\t    82\t                    \"arguments\": {\"type\": \"object\"},\n1994\t    83\t                },\n1995\t    84\t                \"required\": [\"operation\"],\n1996\t    85\t                \"additionalProperties\": False,\n1997\t    86\t            },\n1998\t    87\t            invoke=erp_call,\n1999\t    88\t        ),\n2000\t    89\t        Tool(\n2001\t    90\t            name=\"create_purchase_order\",\n2002\t    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n2003\t    92\t            input_schema={\n2004\t    93\t                \"type\": \"object\",\n2005\t    94\t                \"properties\": {\n2006\t    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n2007\t    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n2008\t    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n2009\t    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n2010\t    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n2011\t   100\t                },\n2012\t   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n2013\t   102\t                \"additionalProperties\": False,\n2014\t   103\t            },\n2015\t   104\t            invoke=create_purchase_order,\n2016\t   105\t            target_field=\"source_doc_id\",\n2017\t   106\t        ),\n2018\t   107\t    ]\n2019\t=== app/tools/memory.py\n2020\t     1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n2021\t     2\t\n2022\t     3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n2023\t     4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n2024\t     5\tuntil a procurement lead verifies them in the admin UI. Every row records\n2025\t     6\twho wrote it, from which run and source document, and the context size at\n2026\t     7\tthe time.\n2027\t     8\t\"\"\"\n2028\t     9\tfrom __future__ import annotations\n2029\t    10\t\n2030\t    11\timport re\n2031\t    12\timport uuid\n2032\t    13\tfrom typing import Any\n2033\t    14\t\n2034\t    15\tfrom app.identity import RunIdentity\n2035\t    16\tfrom app.tools import Tool\n2036\t    17\t\n2037\t    18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n2038\t    19\tMAX_NOTE_CHARS = 800\n2039\t    20\tINSTRUCTION_LIKE = [\n2040\t    21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n2041\t    22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n2042\t    23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n2043\t    24\t    re.compile(r\"https?://\"),\n2044\t    25\t]\n2045\t    26\t\n2046\t    27\t\n2047\t    28\tclass NoteRejected(Exception):\n2048\t    29\t    pass\n2049\t    30\t\n2050\t    31\t\n2051\t    32\tdef check_note(text: str) -> None:\n2052\t    33\t    if len(text) > MAX_NOTE_CHARS:\n2053\t    34\t        raise NoteRejected(\"note too long\")\n2054\t    35\t    for pattern in INSTRUCTION_LIKE:\n2055\t    36\t        if pattern.search(text):\n2056\t    37\t            raise NoteRejected(\"note looks like an instruction\")\n2057\t    38\t\n2058\t    39\t\n2059\t    40\tdef tools(deps) -> list[Tool]:\n2060\t    41\t    pool = deps.pool\n2061\t    42\t\n2062\t    43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n2063\t    44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n2064\t    45\t        rows = await pool.fetch(\n2065\t    46\t            \"\"\"\n2066\t    47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n2067\t    48\t            FROM dept_notes\n2068\t    49\t            WHERE business_unit = $1\n2069\t    50\t              AND department = $2\n2070\t    51\t              AND NOT quarantined\n2071\t    52\t              AND (verified OR expires_at > now())\n2072\t    53\t            ORDER BY created_at DESC\n2073\t    54\t            LIMIT 20\n2074\t    55\t            \"\"\",\n2075\t    56\t            business_unit,\n2076\t    57\t            args[\"department\"],\n2077\t    58\t        )\n2078\t    59\t        return [\n2079\t    60\t            {\n2080\t    61\t                \"note_id\": r[\"note_id\"],\n2081\t    62\t                \"kind\": r[\"kind\"],\n2082\t    63\t                \"body\": r[\"body\"],\n2083\t    64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n2084\t    65\t                \"written\": r[\"created_at\"].isoformat(),\n2085\t    66\t            }\n2086\t    67\t            for r in rows\n2087\t    68\t        ]\n2088\t    69\t\n2089\t    70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n2090\t    71\t        if args[\"kind\"] not in NOTE_KINDS:\n2091\t    72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n2092\t    73\t        check_note(args[\"body\"])\n2093\t    74\t        note_id = f\"note-{uuid.uuid4()}\"\n2094\t    75\t        ctx = deps.current_context(ident)\n2095\t    76\t        await pool.execute(\n2096\t    77\t            \"\"\"\n2097\t    78\t            INSERT INTO dept_notes (\n2098\t    79\t                note_id, business_unit, department, kind, body,\n2099\t    80\t                verified, quarantined, expires_at,\n2100\t    81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n2101\t    82\t                delegated_subject, context_tokens, context_method, created_at\n2102\t    83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n2103\t    84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n2104\t    85\t            \"\"\",\n2105\t    86\t            note_id,\n2106\t    87\t            ident.tenant,\n2107\t    88\t            args[\"department\"],\n2108\t    89\t            args[\"kind\"],\n2109\t    90\t            args[\"body\"],\n2110\t    91\t            ident.agent_instance_id,\n2111\t    92\t            ident.agent_type_id,\n2112\t    93\t            ident.run_id,\n2113\t    94\t            args.get(\"source_doc_id\"),\n2114\t    95\t            ident.delegated_subject,\n2115\t    96\t            ctx.tokens,\n2116\t    97\t            ctx.method,\n2117\t    98\t        )\n2118\t    99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n2119\t   100\t\n2120\t   101\t    return [\n2121\t   102\t        Tool(\n2122\t   103\t            name=\"memory_read\",\n2123\t   104\t            description=(\n2124\t   105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n2125\t   106\t                \"shared-services staff may look up another unit's notes.\"\n2126\t   107\t            ),\n2127\t   108\t            input_schema={\n2128\t   109\t                \"type\": \"object\",\n2129\t   110\t                \"properties\": {\n2130\t   111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n2131\t   112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n2132\t   113\t                },\n2133\t   114\t                \"required\": [\"department\"],\n2134\t   115\t                \"additionalProperties\": False,\n2135\t   116\t            },\n2136\t   117\t            invoke=memory_read,\n2137\t   118\t        ),\n2138\t   119\t        Tool(\n2139\t   120\t            name=\"memory_write\",\n2140\t   121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n2141\t   122\t            input_schema={\n2142\t   123\t                \"type\": \"object\",\n2143\t   124\t                \"properties\": {\n2144\t   125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n2145\t   126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n2146\t   127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n2147\t   128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n2148\t   129\t                },\n2149\t   130\t                \"required\": [\"department\", \"kind\", \"body\"],\n2150\t   131\t                \"additionalProperties\": False,\n2151\t   132\t            },\n2152\t   133\t            invoke=memory_write,\n2153\t   134\t        ),\n2154\t   135\t    ]\n2155\t=== app/tools/payments.py\n2156\t     1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n2157\t     2\tfrom __future__ import annotations\n2158\t     3\t\n2159\t     4\timport hashlib\n2160\t     5\tfrom typing import Any\n2161\t     6\t\n2162\t     7\timport httpx\n2163\t     8\t\n2164\t     9\tfrom app.identity import RunIdentity\n2165\t    10\tfrom app.tools import Tool\n2166\t    11\t\n2167\t    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n2168\t    13\tPAYMENTS_SCOPE = \"payments.create\"\n2169\t    14\t\n2170\t    15\t\n2171\t    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n2172\t    17\t    raw = \"|\".join(\n2173\t    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n2174\t    19\t    )\n2175\t    20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n2176\t    21\t\n2177\t    22\t\n2178\t    23\tdef tools(deps) -> list[Tool]:\n2179\t    24\t    settings = deps.settings\n2180\t    25\t\n2181\t    26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n2182\t    27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n2183\t    28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n2184\t    29\t            resp = await client.post(\n2185\t    30\t                f\"{settings.payments_api_url}/v2/payments\",\n2186\t    31\t                headers={\n2187\t    32\t                    \"Authorization\": f\"Bearer {token}\",\n2188\t    33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n2189\t    34\t                },\n2190\t    35\t                json={\n2191\t    36\t                    \"business_unit\": ident.tenant,\n2192\t    37\t                    \"invoice_reference\": args[\"invoice_id\"],\n2193\t    38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n2194\t    39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n2195\t    40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n2196\t    41\t                },\n2197\t    42\t            )\n2198\t    43\t        resp.raise_for_status()\n2199\t    44\t        body = resp.json()\n2200\t    45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n2201\t    46\t\n2202\t    47\t    return [\n2203\t    48\t        Tool(\n2204\t    49\t            name=\"pay_invoice\",\n2205\t    50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n2206\t    51\t            input_schema={\n2207\t    52\t                \"type\": \"object\",\n2208\t    53\t                \"properties\": {\n2209\t    54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n2210\t    55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n2211\t    56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n2212\t    57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n2213\t    58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n2214\t    59\t                },\n2215\t    60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n2216\t    61\t                \"additionalProperties\": False,\n2217\t    62\t            },\n2218\t    63\t            invoke=pay_invoice,\n2219\t    64\t            target_field=\"invoice_id\",\n2220\t    65\t        )\n2221\t    66\t    ]\n2222\t=== app/tools/slack.py\n2223\t     1\t\"\"\"Slack tool: message staff and vendors, plus the approvals notifier.\"\"\"\n2224\t     2\tfrom __future__ import annotations\n2225\t     3\t\n2226\t     4\tfrom datetime import datetime\n2227\t     5\tfrom typing import Any\n2228\t     6\t\n2229\t     7\timport httpx\n2230\t     8\t\n2231\t     9\tfrom app.identity import RunIdentity\n2232\t    10\tfrom app.redact import redact_text, strip_unapproved_links\n2233\t    11\tfrom app.tools import Tool\n2234\t    12\t\n2235\t    13\tMAX_TEXT = 3000\n2236\t    14\t\n2237\t    15\t\n2238\t    16\tdef clean_outbound(text: str) -> str:\n2239\t    17\t    return strip_unapproved_links(redact_text(text))[:MAX_TEXT]\n2240\t    18\t\n2241\t    19\t\n2242\t    20\tclass SlackClient:\n2243\t    21\t    def __init__(self, api_url: str, bot_token_provider):\n2244\t    22\t        self.api_url = api_url\n2245\t    23\t        self._token = bot_token_provider\n2246\t    24\t\n2247\t    25\t    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:\n2248\t    26\t        payload: dict[str, Any] = {\n2249\t    27\t            \"channel\": channel,\n2250\t    28\t            \"text\": clean_outbound(text),\n2251\t    29\t            \"unfurl_links\": False,\n2252\t    30\t            \"unfurl_media\": False,\n2253\t    31\t            \"mrkdwn\": True,\n2254\t    32\t        }\n2255\t    33\t        if blocks:\n2256\t    34\t            payload[\"blocks\"] = blocks\n2257\t    35\t        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:\n2258\t    36\t            resp = await client.post(\n2259\t    37\t                f\"{self.api_url}/chat.postMessage\",\n2260\t    38\t                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\n2261\t    39\t                json=payload,\n2262\t    40\t            )\n2263\t    41\t        resp.raise_for_status()\n2264\t    42\t        body = resp.json()\n2265\t    43\t        if not body.get(\"ok\"):\n2266\t    44\t            raise RuntimeError(f\"slack error: {body.get('error')}\")\n2267\t    45\t        return {\"channel\": body[\"channel\"], \"ts\": body[\"ts\"]}\n2268\t    46\t\n2269\t    47\t    async def post_approval_request(\n2270\t    48\t        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\n2271\t    49\t    ) -> None:\n2272\t    50\t        lines = \"\\n\".join(f\"• *{k}*: `{v}`\" for k, v in summary.items())\n2273\t    51\t        text = f\"Approval needed for `{tool}` on `{target}` (expires {expires_at:%Y-%m-%d %H:%M} UTC)\\n{lines}\"\n2274\t    52\t        await self.post(\n2275\t    53\t            channel=f\"#approvals-{tenant}\",\n2276\t    54\t            text=text,\n2277\t    55\t            blocks=[\n2278\t    56\t                {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": clean_outbound(text)}},\n2279\t    57\t                {\n2280\t    58\t                    \"type\": \"actions\",\n2281\t    59\t                    \"elements\": [\n2282\t    60\t                        {\"type\": \"button\", \"action_id\": \"approve\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Approve\"}, \"style\": \"primary\"},\n2283\t    61\t                        {\"type\": \"button\", \"action_id\": \"reject\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Reject\"}, \"style\": \"danger\"},\n2284\t    62\t                    ],\n2285\t    63\t                },\n2286\t    64\t            ],\n2287\t    65\t        )\n2288\t    66\t\n2289\t    67\t\n2290\t    68\tdef tools(deps) -> list[Tool]:\n2291\t    69\t    slack: SlackClient = deps.slack\n2292\t    70\t\n2293\t    71\t    async def post_slack_message(args: dict[str, Any], ident: RunIdentity) -> Any:\n2294\t    72\t        return await slack.post(channel=args[\"channel\"], text=args[\"text\"])\n2295\t    73\t\n2296\t    74\t    return [\n2297\t    75\t        Tool(\n2298\t    76\t            name=\"post_slack_message\",\n2299\t    77\t            description=(\n2300\t    78\t                \"Post a message in Slack. Use internal channels for staff. Vendor contacts are in \"\n2301\t    79\t                \"Slack Connect channels named #vendor-<vendor_id>; set external=true for those.\"\n2302\t    80\t            ),\n2303\t    81\t            input_schema={\n2304\t    82\t                \"type\": \"object\",\n2305\t    83\t                \"properties\": {\n2306\t    84\t                    \"channel\": {\"type\": \"string\", \"maxLength\": 80},\n2307\t    85\t                    \"text\": {\"type\": \"string\", \"maxLength\": MAX_TEXT},\n2308\t    86\t                    \"external\": {\"type\": \"boolean\", \"default\": False},\n2309\t    87\t                },\n2310\t    88\t                \"required\": [\"channel\", \"text\"],\n2311\t    89\t                \"additionalProperties\": False,\n2312\t    90\t            },\n2313\t    91\t            invoke=post_slack_message,\n2314\t    92\t            target_field=\"channel\",\n2315\t    93\t        )\n2316\t    94\t    ]\n2317\t"}]},"parent_tool_use_id":null,"session_id":"26203897-c02e-482f-8eda-5e1c431a7535","uuid":"debd08b3-bb0e-4859-98b8-fb247836d561","timestamp":"2026-10-02T15:55:12.288Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-repeat-m0jquuov/26203897-c02e-482f-8eda-5e1c431a7535/tool-results/bqdy2cvk4.txt","content":"    58\t\n    59\t@lru_cache(maxsize=1)\n    60\tdef get_settings() -> Settings:\n    61\t    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    62\t    return Settings(\n    63\t        database_url=_env(\"DATABASE_URL\"),\n    64\t        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n    65\t        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n    66\t        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n    67\t        sts_url=_env(\"STS_URL\"),\n    68\t        oidc_issuer=_env(\"OIDC_ISSUER\"),\n    69\t        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n    70\t        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n    71\t        workload_token_path=_env(\n    72\t            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n    73\t        ),\n    74\t        slack_signing_secret_path=_env(\n    75\t            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n    76\t        ),\n    77\t        mail_gateway_hmac_path=_env(\n    78\t            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n    79\t        ),\n    80\t        model_id=_env(\"MODEL_ID\"),\n    81\t        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n    82\t        manifest_path=root / \"release\" / \"manifest.yaml\",\n    83\t        prompt_dir=root / \"prompts\",\n    84\t        policy_path=root / \"config\" / \"policy.yaml\",\n    85\t        tools_path=root / \"config\" / \"tools.yaml\",\n    86\t        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n    87\t        image_digest=_env(\"IMAGE_DIGEST\"),\n    88\t    )\n=== app/startup.py\n     1\t\"\"\"Startup checks: compare the running artifacts with the release manifest.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\timport logging\n     6\tfrom pathlib import Path\n     7\t\n     8\tfrom app.identity import compute_agent_type_id\n     9\tfrom app.settings import Settings\n    10\t\n    11\tlog = logging.getLogger(__name__)\n    12\t\n    13\t\n    14\tdef sha256_file(path: Path) -> str:\n    15\t    return \"sha256:\" + hashlib.sha256(path.read_bytes()).hexdigest()\n    16\t\n    17\t\n    18\tdef running_state_mismatches(settings: Settings, manifest: dict) -> list[str]:\n    19\t    mismatches: list[str] = []\n    20\t    if settings.image_digest != manifest[\"image\"][\"digest\"]:\n    21\t        mismatches.append(f\"image: running {settings.image_digest}\")\n    22\t    for name, entry in manifest[\"prompts\"].items():\n    23\t        path = settings.prompt_dir / Path(entry[\"path\"]).name\n    24\t        if not path.exists() or sha256_file(path) != entry[\"sha256\"]:\n    25\t            mismatches.append(f\"prompt:{name}\")\n    26\t    for name in (\"policy\", \"tools\"):\n    27\t        entry = manifest[\"config\"][name]\n    28\t        path = settings.policy_path if name == \"policy\" else settings.tools_path\n    29\t        if sha256_file(path) != entry[\"sha256\"]:\n    30\t            mismatches.append(f\"config:{name}\")\n    31\t    if settings.model_id != manifest[\"models\"][\"primary\"][\"model_id\"]:\n    32\t        mismatches.append(\"model:primary\")\n    33\t    if settings.extractor_model_id != manifest[\"models\"][\"extractor\"][\"model_id\"]:\n    34\t        mismatches.append(\"model:extractor\")\n    35\t    return mismatches\n    36\t\n    37\t\n    38\tdef startup_checks(settings: Settings) -> str:\n    39\t    \"\"\"Return the agent-type-id for this process.\"\"\"\n    40\t    manifest = settings.manifest\n    41\t    mismatches = running_state_mismatches(settings, manifest)\n    42\t    if mismatches:\n    43\t        log.error(\"running state differs from release manifest: %s\", \", \".join(mismatches))\n    44\t    agent_type_id = compute_agent_type_id(manifest)\n    45\t    log.info(\"agent_type_id=%s release=%s\", agent_type_id, manifest[\"release\"])\n    46\t    return agent_type_id\n=== app/tools/__init__.py\n     1\t\"\"\"Tool registry.\n     2\t\n     3\tEach agent role gets the tools listed for it in config/tools.yaml. The model\n     4\tonly sees schemas for those tools, and the loop rejects any call to a name\n     5\tthat is not in the run's registry.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass\n    10\tfrom functools import lru_cache\n    11\tfrom typing import Any, Awaitable, Callable\n    12\t\n    13\timport yaml\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\t\n    17\tDEFAULT_ROLE = \"procurement\"\n    18\t\n    19\tInvoke = Callable[[dict[str, Any], RunIdentity], Awaitable[Any]]\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Tool:\n    24\t    name: str\n    25\t    description: str\n    26\t    input_schema: dict[str, Any]\n    27\t    invoke: Invoke\n    28\t    target_field: str | None = None\n    29\t\n    30\t    def target_of(self, args: dict[str, Any]) -> str:\n    31\t        if self.target_field is None:\n    32\t            return self.name\n    33\t        return str(args.get(self.target_field, \"\"))\n    34\t\n    35\t    def schema(self) -> dict[str, Any]:\n    36\t        return {\"name\": self.name, \"description\": self.description, \"input_schema\": self.input_schema}\n    37\t\n    38\t\n    39\tclass ToolRegistry:\n    40\t    def __init__(self, tools: list[Tool]):\n    41\t        self._tools = {t.name: t for t in tools}\n    42\t\n    43\t    def get(self, name: str) -> Tool | None:\n    44\t        return self._tools.get(name)\n    45\t\n    46\t    def names(self) -> list[str]:\n    47\t        return sorted(self._tools)\n    48\t\n    49\t    def schemas(self) -> list[dict[str, Any]]:\n    50\t        return [self._tools[n].schema() for n in self.names()]\n    51\t\n    52\t\n    53\t@lru_cache(maxsize=1)\n    54\tdef _role_tools(path: str) -> dict[str, list[str]]:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        cfg = yaml.safe_load(fh)\n    57\t    return {role: list(spec[\"tools\"].keys()) for role, spec in cfg[\"roles\"].items()}\n    58\t\n    59\t\n    60\tdef build_registry(role: str, ident: RunIdentity, deps) -> ToolRegistry:\n    61\t    from app.tools import documents, erp, memory, payments, slack\n    62\t\n    63\t    available: dict[str, Tool] = {}\n    64\t    for module in (documents, erp, memory, payments, slack):\n    65\t        for tool in module.tools(deps):\n    66\t            available[tool.name] = tool\n    67\t\n    68\t    roles = _role_tools(str(deps.settings.tools_path))\n    69\t    allowed = roles.get(role, roles[DEFAULT_ROLE])\n    70\t    return ToolRegistry([available[name] for name in allowed if name in available])\n=== app/tools/documents.py\n     1\t\"\"\"Document tools: read an ingested quote or invoice, and extract line items.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tUNTRUSTED_WRAPPER = (\n    10\t    \"<untrusted_document source={source!r} doc_id={doc_id!r} media_type={media_type!r}>\\n\"\n    11\t    \"{text}\\n\"\n    12\t    \"</untrusted_document>\"\n    13\t)\n    14\t\n    15\t\n    16\tdef tools(deps) -> list[Tool]:\n    17\t    pool = deps.pool\n    18\t\n    19\t    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n    20\t        row = await pool.fetchrow(\n    21\t            \"\"\"\n    22\t            SELECT doc_id, source, media_type, text\n    23\t            FROM documents\n    24\t            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n    25\t            \"\"\",\n    26\t            args[\"doc_id\"],\n    27\t            ident.tenant,\n    28\t        )\n    29\t        if row is None:\n    30\t            return \"document not found\"\n    31\t        return UNTRUSTED_WRAPPER.format(\n    32\t            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n    33\t        )\n    34\t\n    35\t    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n    36\t        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n    37\t\n    38\t    return [\n    39\t        Tool(\n    40\t            name=\"read_document\",\n    41\t            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n    42\t            input_schema={\n    43\t                \"type\": \"object\",\n    44\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    45\t                \"required\": [\"doc_id\"],\n    46\t                \"additionalProperties\": False,\n    47\t            },\n    48\t            invoke=read_document,\n    49\t        ),\n    50\t        Tool(\n    51\t            name=\"extract_line_items\",\n    52\t            description=\"Extract structured line items (sku, description, qty, unit price, currency) from a document.\",\n    53\t            input_schema={\n    54\t                \"type\": \"object\",\n    55\t                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n    56\t                \"required\": [\"doc_id\"],\n    57\t                \"additionalProperties\": False,\n    58\t            },\n    59\t            invoke=extract_line_items,\n    60\t        ),\n    61\t    ]\n=== app/tools/erp.py\n     1\t\"\"\"ERP tools: budget lookups, generic ERP reads, and purchase-order creation.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom typing import Any\n     5\t\n     6\tfrom app.identity import RunIdentity\n     7\tfrom app.tools import Tool\n     8\t\n     9\tERP_READ_SCOPE = \"erp.read\"\n    10\tERP_PO_WRITE_SCOPE = \"erp.read erp.po.create\"\n    11\t\n    12\t\n    13\tdef tools(deps) -> list[Tool]:\n    14\t    erp = deps.erp\n    15\t\n    16\t    async def get_budget(args: dict[str, Any], ident: RunIdentity) -> Any:\n    17\t        return await erp.call(\n    18\t            \"budget.get_remaining\",\n    19\t            {\"business_unit\": ident.tenant, \"department\": args[\"department\"], \"fiscal_period\": args[\"fiscal_period\"]},\n    20\t            ident,\n    21\t            ERP_READ_SCOPE,\n    22\t        )\n    23\t\n    24\t    async def erp_call(args: dict[str, Any], ident: RunIdentity) -> Any:\n    25\t        arguments = dict(args.get(\"arguments\", {}))\n    26\t        arguments[\"business_unit\"] = ident.tenant\n    27\t        return await erp.call(args[\"operation\"], arguments, ident, deps.erp_scope_for(args[\"operation\"]))\n    28\t\n    29\t    async def create_purchase_order(args: dict[str, Any], ident: RunIdentity) -> Any:\n    30\t        return await erp.call(\n    31\t            \"po.create\",\n    32\t            {\n    33\t                \"business_unit\": ident.tenant,\n    34\t                \"department\": args[\"department\"],\n    35\t                \"vendor_id\": args[\"vendor_id\"],\n    36\t                \"lines\": args[\"lines\"],\n    37\t                \"currency\": args[\"currency\"],\n    38\t                \"source_doc_id\": args[\"source_doc_id\"],\n    39\t                \"client_reference\": args[\"source_doc_id\"],\n    40\t            },\n    41\t            ident,\n    42\t            ERP_PO_WRITE_SCOPE,\n    43\t        )\n    44\t\n    45\t    line_schema = {\n    46\t        \"type\": \"object\",\n    47\t        \"properties\": {\n    48\t            \"sku\": {\"type\": \"string\", \"maxLength\": 64},\n    49\t            \"description\": {\"type\": \"string\", \"maxLength\": 256},\n    50\t            \"quantity\": {\"type\": \"number\", \"exclusiveMinimum\": 0},\n    51\t            \"unit_price_cents\": {\"type\": \"integer\", \"minimum\": 0},\n    52\t        },\n    53\t        \"required\": [\"sku\", \"quantity\", \"unit_price_cents\"],\n    54\t        \"additionalProperties\": False,\n    55\t    }\n    56\t\n    57\t    return [\n    58\t        Tool(\n    59\t            name=\"get_budget\",\n    60\t            description=\"Remaining budget for a department in a fiscal period.\",\n    61\t            input_schema={\n    62\t                \"type\": \"object\",\n    63\t                \"properties\": {\n    64\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    65\t                    \"fiscal_period\": {\"type\": \"string\", \"pattern\": \"^FY[0-9]{4}-Q[1-4]$\"},\n    66\t                },\n    67\t                \"required\": [\"department\", \"fiscal_period\"],\n    68\t                \"additionalProperties\": False,\n    69\t            },\n    70\t            invoke=get_budget,\n    71\t        ),\n    72\t        Tool(\n    73\t            name=\"erp_call\",\n    74\t            description=(\n    75\t                \"Look up ERP records (vendors, invoices, purchase orders, budgets). \"\n    76\t                \"operation is an ERP operation name such as vendor.get or invoice.list_open.\"\n    77\t            ),\n    78\t            input_schema={\n    79\t                \"type\": \"object\",\n    80\t                \"properties\": {\n    81\t                    \"operation\": {\"type\": \"string\", \"maxLength\": 64},\n    82\t                    \"arguments\": {\"type\": \"object\"},\n    83\t                },\n    84\t                \"required\": [\"operation\"],\n    85\t                \"additionalProperties\": False,\n    86\t            },\n    87\t            invoke=erp_call,\n    88\t        ),\n    89\t        Tool(\n    90\t            name=\"create_purchase_order\",\n    91\t            description=\"Raise a purchase order in the ERP for an approved quote.\",\n    92\t            input_schema={\n    93\t                \"type\": \"object\",\n    94\t                \"properties\": {\n    95\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n    96\t                    \"vendor_id\": {\"type\": \"string\", \"maxLength\": 32},\n    97\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    98\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n    99\t                    \"lines\": {\"type\": \"array\", \"items\": line_schema, \"maxItems\": 200},\n   100\t                },\n   101\t                \"required\": [\"department\", \"vendor_id\", \"currency\", \"source_doc_id\", \"lines\"],\n   102\t                \"additionalProperties\": False,\n   103\t            },\n   104\t            invoke=create_purchase_order,\n   105\t            target_field=\"source_doc_id\",\n   106\t        ),\n   107\t    ]\n=== app/tools/memory.py\n     1\t\"\"\"Per-department notes kept between runs (Postgres ``dept_notes``).\n     2\t\n     3\tWrites are restricted to a fixed set of note kinds, length-limited, checked\n     4\tfor instruction-like content, and stored as unverified with a 30-day expiry\n     5\tuntil a procurement lead verifies them in the admin UI. Every row records\n     6\twho wrote it, from which run and source document, and the context size at\n     7\tthe time.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport re\n    12\timport uuid\n    13\tfrom typing import Any\n    14\t\n    15\tfrom app.identity import RunIdentity\n    16\tfrom app.tools import Tool\n    17\t\n    18\tNOTE_KINDS = (\"vendor_preference\", \"contract_term\", \"budget_note\", \"contact\")\n    19\tMAX_NOTE_CHARS = 800\n    20\tINSTRUCTION_LIKE = [\n    21\t    re.compile(r\"(?i)\\b(ignore|disregard|override)\\b.{0,40}\\b(instruction|policy|approval|rule)s?\\b\"),\n    22\t    re.compile(r\"(?i)\\b(always|never|must)\\b.{0,40}\\b(approve|pay|skip|send|transfer)\\b\"),\n    23\t    re.compile(r\"(?i)\\b(system prompt|you are|assistant:)\\b\"),\n    24\t    re.compile(r\"https?://\"),\n    25\t]\n    26\t\n    27\t\n    28\tclass NoteRejected(Exception):\n    29\t    pass\n    30\t\n    31\t\n    32\tdef check_note(text: str) -> None:\n    33\t    if len(text) > MAX_NOTE_CHARS:\n    34\t        raise NoteRejected(\"note too long\")\n    35\t    for pattern in INSTRUCTION_LIKE:\n    36\t        if pattern.search(text):\n    37\t            raise NoteRejected(\"note looks like an instruction\")\n    38\t\n    39\t\n    40\tdef tools(deps) -> list[Tool]:\n    41\t    pool = deps.pool\n    42\t\n    43\t    async def memory_read(args: dict[str, Any], ident: RunIdentity) -> Any:\n    44\t        business_unit = args.get(\"business_unit\") or ident.tenant\n    45\t        rows = await pool.fetch(\n    46\t            \"\"\"\n    47\t            SELECT note_id, kind, body, verified, writer_instance, created_at\n    48\t            FROM dept_notes\n    49\t            WHERE business_unit = $1\n    50\t              AND department = $2\n    51\t              AND NOT quarantined\n    52\t              AND (verified OR expires_at > now())\n    53\t            ORDER BY created_at DESC\n    54\t            LIMIT 20\n    55\t            \"\"\",\n    56\t            business_unit,\n    57\t            args[\"department\"],\n    58\t        )\n    59\t        return [\n    60\t            {\n    61\t                \"note_id\": r[\"note_id\"],\n    62\t                \"kind\": r[\"kind\"],\n    63\t                \"body\": r[\"body\"],\n    64\t                \"trust\": \"verified\" if r[\"verified\"] else \"unverified\",\n    65\t                \"written\": r[\"created_at\"].isoformat(),\n    66\t            }\n    67\t            for r in rows\n    68\t        ]\n    69\t\n    70\t    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n    71\t        if args[\"kind\"] not in NOTE_KINDS:\n    72\t            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n    73\t        check_note(args[\"body\"])\n    74\t        note_id = f\"note-{uuid.uuid4()}\"\n    75\t        ctx = deps.current_context(ident)\n    76\t        await pool.execute(\n    77\t            \"\"\"\n    78\t            INSERT INTO dept_notes (\n    79\t                note_id, business_unit, department, kind, body,\n    80\t                verified, quarantined, expires_at,\n    81\t                writer_instance, writer_type_id, run_id, source_doc_id,\n    82\t                delegated_subject, context_tokens, context_method, created_at\n    83\t            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n    84\t                      $6, $7, $8, $9, $10, $11, $12, now())\n    85\t            \"\"\",\n    86\t            note_id,\n    87\t            ident.tenant,\n    88\t            args[\"department\"],\n    89\t            args[\"kind\"],\n    90\t            args[\"body\"],\n    91\t            ident.agent_instance_id,\n    92\t            ident.agent_type_id,\n    93\t            ident.run_id,\n    94\t            args.get(\"source_doc_id\"),\n    95\t            ident.delegated_subject,\n    96\t            ctx.tokens,\n    97\t            ctx.method,\n    98\t        )\n    99\t        return {\"note_id\": note_id, \"status\": \"stored_unverified\"}\n   100\t\n   101\t    return [\n   102\t        Tool(\n   103\t            name=\"memory_read\",\n   104\t            description=(\n   105\t                \"Read saved notes for a department. business_unit defaults to the current one; \"\n   106\t                \"shared-services staff may look up another unit's notes.\"\n   107\t            ),\n   108\t            input_schema={\n   109\t                \"type\": \"object\",\n   110\t                \"properties\": {\n   111\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   112\t                    \"business_unit\": {\"type\": \"string\", \"maxLength\": 32},\n   113\t                },\n   114\t                \"required\": [\"department\"],\n   115\t                \"additionalProperties\": False,\n   116\t            },\n   117\t            invoke=memory_read,\n   118\t        ),\n   119\t        Tool(\n   120\t            name=\"memory_write\",\n   121\t            description=\"Save a short factual note for a department (vendor preference, contract term, budget note, contact).\",\n   122\t            input_schema={\n   123\t                \"type\": \"object\",\n   124\t                \"properties\": {\n   125\t                    \"department\": {\"type\": \"string\", \"maxLength\": 64},\n   126\t                    \"kind\": {\"type\": \"string\", \"enum\": list(NOTE_KINDS)},\n   127\t                    \"body\": {\"type\": \"string\", \"maxLength\": MAX_NOTE_CHARS},\n   128\t                    \"source_doc_id\": {\"type\": \"string\", \"maxLength\": 64},\n   129\t                },\n   130\t                \"required\": [\"department\", \"kind\", \"body\"],\n   131\t                \"additionalProperties\": False,\n   132\t            },\n   133\t            invoke=memory_write,\n   134\t        ),\n   135\t    ]\n=== app/tools/payments.py\n     1\t\"\"\"Payments tool: pay an approved, matched invoice.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport hashlib\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.tools import Tool\n    11\t\n    12\tPAYMENTS_AUDIENCE = \"payments-api\"\n    13\tPAYMENTS_SCOPE = \"payments.create\"\n    14\t\n    15\t\n    16\tdef idempotency_key(ident: RunIdentity, args: dict[str, Any]) -> str:\n    17\t    raw = \"|\".join(\n    18\t        [ident.tenant, args[\"invoice_id\"], args[\"payee_account_id\"], str(args[\"amount_cents\"]), args[\"currency\"]]\n    19\t    )\n    20\t    return \"proc-\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()[:48]\n    21\t\n    22\t\n    23\tdef tools(deps) -> list[Tool]:\n    24\t    settings = deps.settings\n    25\t\n    26\t    async def pay_invoice(args: dict[str, Any], ident: RunIdentity) -> Any:\n    27\t        token = await deps.broker.token_for(PAYMENTS_AUDIENCE, PAYMENTS_SCOPE, ident)\n    28\t        async with httpx.AsyncClient(timeout=30.0, follow_redirects=False) as client:\n    29\t            resp = await client.post(\n    30\t                f\"{settings.payments_api_url}/v2/payments\",\n    31\t                headers={\n    32\t                    \"Authorization\": f\"Bearer {token}\",\n    33\t                    \"Idempotency-Key\": idempotency_key(ident, args),\n    34\t                },\n    35\t                json={\n    36\t                    \"business_unit\": ident.tenant,\n    37\t                    \"invoice_reference\": args[\"invoice_id\"],\n    38\t                    \"payee_account_id\": args[\"payee_account_id\"],\n    39\t                    \"amount\": {\"value\": args[\"amount_cents\"], \"currency\": args[\"currency\"]},\n    40\t                    \"memo\": args.get(\"memo\", \"\")[:140],\n    41\t                },\n    42\t            )\n    43\t        resp.raise_for_status()\n    44\t        body = resp.json()\n    45\t        return {\"payment_id\": body[\"id\"], \"status\": body[\"status\"]}\n    46\t\n    47\t    return [\n    48\t        Tool(\n    49\t            name=\"pay_invoice\",\n    50\t            description=\"Pay a vendor invoice that has been matched to a purchase order.\",\n    51\t            input_schema={\n    52\t                \"type\": \"object\",\n    53\t                \"properties\": {\n    54\t                    \"invoice_id\": {\"type\": \"string\", \"maxLength\": 32},\n    55\t                    \"payee_account_id\": {\"type\": \"string\", \"maxLength\": 32},\n    56\t                    \"amount_cents\": {\"type\": \"integer\", \"minimum\": 1},\n    57\t                    \"currency\": {\"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\"},\n    58\t                    \"memo\": {\"type\": \"string\", \"maxLength\": 140},\n    59\t                },\n    60\t                \"required\": [\"invoice_id\", \"payee_account_id\", \"amount_cents\", \"currency\"],\n    61\t                \"additionalProperties\": False,\n    62\t            },\n    63\t            invoke=pay_invoice,\n    64\t            target_field=\"invoice_id\",\n    65\t        )\n    66\t    ]\n=== app/tools/slack.py\n     1\t\"\"\"Slack tool: message staff and vendors, plus the approvals notifier.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\tfrom datetime import datetime\n     5\tfrom typing import Any\n     6\t\n     7\timport httpx\n     8\t\n     9\tfrom app.identity import RunIdentity\n    10\tfrom app.redact import redact_text, strip_unapproved_links\n    11\tfrom app.tools import Tool\n    12\t\n    13\tMAX_TEXT = 3000\n    14\t\n    15\t\n    16\tdef clean_outbound(text: str) -> str:\n    17\t    return strip_unapproved_links(redact_text(text))[:MAX_TEXT]\n    18\t\n    19\t\n    20\tclass SlackClient:\n    21\t    def __init__(self, api_url: str, bot_token_provider):\n    22\t        self.api_url = api_url\n    23\t        self._token = bot_token_provider\n    24\t\n    25\t    async def post(self, channel: str, text: str, blocks: list | None = None) -> dict[str, Any]:\n    26\t        payload: dict[str, Any] = {\n    27\t            \"channel\": channel,\n    28\t            \"text\": clean_outbound(text),\n    29\t            \"unfurl_links\": False,\n    30\t            \"unfurl_media\": False,\n    31\t            \"mrkdwn\": True,\n    32\t        }\n    33\t        if blocks:\n    34\t            payload[\"blocks\"] = blocks\n    35\t        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:\n    36\t            resp = await client.post(\n    37\t                f\"{self.api_url}/chat.postMessage\",\n    38\t                headers={\"Authorization\": f\"Bearer {await self._token()}\"},\n    39\t                json=payload,\n    40\t            )\n    41\t        resp.raise_for_status()\n    42\t        body = resp.json()\n    43\t        if not body.get(\"ok\"):\n    44\t            raise RuntimeError(f\"slack error: {body.get('error')}\")\n    45\t        return {\"channel\": body[\"channel\"], \"ts\": body[\"ts\"]}\n    46\t\n    47\t    async def post_approval_request(\n    48\t        self, *, tenant: str, approval_id: str, tool: str, target: str, summary: dict, expires_at: datetime\n    49\t    ) -> None:\n    50\t        lines = \"\\n\".join(f\"• *{k}*: `{v}`\" for k, v in summary.items())\n    51\t        text = f\"Approval needed for `{tool}` on `{target}` (expires {expires_at:%Y-%m-%d %H:%M} UTC)\\n{lines}\"\n    52\t        await self.post(\n    53\t            channel=f\"#approvals-{tenant}\",\n    54\t            text=text,\n    55\t            blocks=[\n    56\t                {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": clean_outbound(text)}},\n    57\t                {\n    58\t                    \"type\": \"actions\",\n    59\t                    \"elements\": [\n    60\t                        {\"type\": \"button\", \"action_id\": \"approve\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Approve\"}, \"style\": \"primary\"},\n    61\t                        {\"type\": \"button\", \"action_id\": \"reject\", \"value\": approval_id, \"text\": {\"type\": \"plain_text\", \"text\": \"Reject\"}, \"style\": \"danger\"},\n    62\t                    ],\n    63\t                },\n    64\t            ],\n    65\t        )\n    66\t\n    67\t\n    68\tdef tools(deps) -> list[Tool]:\n    69\t    slack: SlackClient = deps.slack\n    70\t\n    71\t    async def post_slack_message(args: dict[str, Any], ident: RunIdentity) -> Any:\n    72\t        return await slack.post(channel=args[\"channel\"], text=args[\"text\"])\n    73\t\n    74\t    return [\n    75\t        Tool(\n    76\t            name=\"post_slack_message\",\n    77\t            description=(\n    78\t                \"Post a message in Slack. Use internal channels for staff. Vendor contacts are in \"\n    79\t                \"Slack Connect channels named #vendor-<vendor_id>; set external=true for those.\"\n    80\t            ),\n    81\t            input_schema={\n    82\t                \"type\": \"object\",\n    83\t                \"properties\": {\n    84\t                    \"channel\": {\"type\": \"string\", \"maxLength\": 80},\n    85\t                    \"text\": {\"type\": \"string\", \"maxLength\": MAX_TEXT},\n    86\t                    \"external\": {\"type\": \"boolean\", \"default\": False},\n    87\t                },\n    88\t                \"required\": [\"channel\", \"text\"],\n    89\t                \"additionalProperties\": False,\n    90\t            },\n    91\t            invoke=post_slack_message,\n    92\t            target_field=\"channel\",\n    93\t        )\n    94\t    ]\n","numLines":618,"startLine":1700,"totalLines":2317}}}
