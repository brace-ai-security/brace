# B04\nu(\"B04.1\",\"Revocation of the agent service account would live in the STS or identity provider, which is outside this repo.\")\nu(\"B04.2\",\"The only in-repo stop path is a database flag read by the agent itself (killswitch.py); gateway or STS enforcement is outside this repo.\")\nu(\"B04.3\",\"Workload token lives 600 s (deployment.yaml:107) and STS tokens are cached until expiry (identity.py:97); no revocation limit is stated and service-side validation is outside this repo.\")\nu(\"B04.4\",\"No revoke code or runbook is in this repo, so coverage of access tokens and open sessions cannot be judged.\")\nitem(\"B04\",\"needs_evidence\",\"medium\",\"Independent revocation is not visible in the repo; it depends on the STS and gateways, and cached tokens outlive any revoke.\",\"Show the revoke runbook, a stated maximum cutoff time, and a test that disabling the service account blocks calls while the user keeps access.\")\n# B05\nn(\"B05.1\",\"config/policy.yaml:13\",\"- \\\"vendor.\\\"\",\"High-impact list covers only create_purchase_order and pay_invoice; vendor.update_remit_to, invoice.mark_paid and invoice.void are reachable and not listed.\")\nn(\"B05.2\",\"app/gate.py:35\",\"if not operation.startswith(self.erp_read_prefixes):\",\"The erp_call gate checks only an operation-name prefix, and pay_invoice approval is keyed on invoice_id alone so payee and amount are unchecked.\")\nn(\"B05.3\",\"app/gate.py:40\",\"if args.get(\\\"external\\\", False):\",\"Vendor messages are gated only when the model sets external=true, so a post to a #vendor channel with external false and erp_call writes skip approval.\")\ny(\"B05.4\",\"app/gate.py:56\",\"\\\"approval required; request opened\\\",\",\"Searched for auto-approve flags, bypass modes and timeout-proceeds paths; a pending approval returns an error and only a Slack approver role can decide.\",\"Blocked high-impact tools wait for a human approver role\")\nn(\"B05.5\",\"app/gate.py:42\",\"return Decision(True, \\\"internal staff message\\\", self.version)\",\"Agent reads untrusted email, reaches financial systems and acts outside, yet erp writes and Slack posts are ungated and invoice text can choose arguments.\")\nflag(\"B05\",\"app/gate.py:35\",\"erp_call prefix gate lets vendor.update_remit_to, invoice.mark_paid and invoice.void run with no approval\")\nflag(\"B05\",\"app/gate.py:40\",\"External-send approval depends on a model-set external flag, so a vendor message with external false needs no approval\")\nhit(\"H001\",\"confirmed\",\"The prefix check on erp_call operations is the gate for ERP calls and lets write operations through; recorded under B05.\",\"B05\")\nitem(\"B05\",\"gap\",\"high\",\"ERP write operations and vendor messages can run with no approval because the gate uses name prefixes and a model-set flag.\",\"Gate erp_call by exact read operation, add vendor.update_remit_to, invoice.mark_paid and invoice.void to high_impact, and decide external from the channel name in code.\",[\"Block them by default in the execution path\",\"authorize its operation, target, and arguments\"],[\"B01\"])\n# B06\ny(\"B06.1\",\"app/approvals.py:45\",\"id, tool, target, args_sha256, args_summary, tenant,\",\"Searched for boolean-only approvals; the record has instance, tool, target, args hash, summary, approver, role and expiry.\",\"Approval table stores instance, operation, target, args hash and expiry\")\nn(\"B06.2\",\"app/approvals.py:77\",\"AND target = $2\",\"find_valid matches tool, target and tenant only; it never compares agent instance or the args hash stored at request time.\")\nn(\"B06.3\",\"app/approvals.py:71\",\"async def find_valid(self, ident: RunIdentity, tool: str, target: str) -> Approval | None:\",\"An approved row is never marked used, so it can be replayed or used in parallel until it expires after 60 minutes.\")\nn(\"B06.4\",\"app/main.py:178\",\"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\",\"Approver role is checked, but the appr