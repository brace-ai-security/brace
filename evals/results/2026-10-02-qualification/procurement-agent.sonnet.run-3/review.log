{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WhcLrwok4K9vYQCLSQz9Fm","type":"tool_result","content":"700\t    38\t\n701\t    39\t        if tool.name == \"post_slack_message\":\n702\t    40\t            if args.get(\"external\", False):\n703\t    41\t                return await self._require_approval(ident, tool, args)\n704\t    42\t            return Decision(True, \"internal staff message\", self.version)\n705\t    43\t\n706\t    44\t        if tool.name in self.high_impact:\n707\t    45\t            return await self._require_approval(ident, tool, args)\n708\t    46\t\n709\t    47\t        return Decision(True, \"low-impact tool\", self.version)\n710\t    48\t\n711\t    49\t    async def _require_approval(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n712\t    50\t        target = tool.target_of(args)\n713\t    51\t        approval = await self.approvals.find_valid(ident, tool.name, target)\n714\t    52\t        if approval is not None:\n715\t    53\t            return Decision(True, \"approved\", self.version, approval_id=approval.id)\n716\t    54\t        approval_id = await self.approvals.request(ident, tool.name, target, args)\n717\t    55\t        return Decision(\n718\t    56\t            False,\n719\t    57\t            \"approval required; request opened\",\n720\t    58\t            self.version,\n721\t    59\t            approval_id=approval_id,\n722\t    60\t            pending=True,\n723\t    61\t        )\n724\t=== app/identity.py\n725\t     1\t\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n726\t     2\t\n727\t     3\tThe agent runs under its own Kubernetes service account. Its projected\n728\t     4\tservice-account token is exchanged at the internal STS for short-lived,\n729\t     5\taudience-bound tokens. The launching user's token is never forwarded to an\n730\t     6\tintegration; the user is carried as the delegated subject of the exchange.\n731\t     7\t\"\"\"\n732\t     8\tfrom __future__ import annotations\n733\t     9\t\n734\t    10\timport hashlib\n735\t    11\timport json\n736\t    12\timport time\n737\t    13\timport uuid\n738\t    14\tfrom dataclasses import dataclass, field, replace\n739\t    15\tfrom pathlib import Path\n740\t    16\t\n741\t    17\timport httpx\n742\t    18\t\n743\t    19\tfrom app.settings import Settings\n744\t    20\t\n745\t    21\tIDENTITY_FIELDS = (\n746\t    22\t    \"accountable_party\",\n747\t    23\t    \"operational_owner\",\n748\t    24\t    \"tenant\",\n749\t    25\t    \"agent_type_id\",\n750\t    26\t    \"agent_instance_id\",\n751\t    27\t    \"trace_id\",\n752\t    28\t)\n753\t    29\t\n754\t    30\t\n755\t    31\t@dataclass(frozen=True)\n756\t    32\tclass RunIdentity:\n757\t    33\t    accountable_party: str\n758\t    34\t    operational_owner: str\n759\t    35\t    tenant: str\n760\t    36\t    agent_type_id: str\n761\t    37\t    agent_instance_id: str\n762\t    38\t    trace_id: str\n763\t    39\t    run_id: str\n764\t    40\t    delegated_subject: str\n765\t    41\t    agent_principal: str\n766\t    42\t    parent_instance_id: str | None = None\n767\t    43\t    role: str = \"procurement\"\n768\t    44\t\n769\t    45\t    def __post_init__(self) -> None:\n770\t    46\t        for name in IDENTITY_FIELDS:\n771\t    47\t            if not getattr(self, name):\n772\t    48\t                raise ValueError(f\"identity field {name} is empty\")\n773\t    49\t\n774\t    50\t    def child(self, role: str) -> \"RunIdentity\":\n775\t    51\t        return replace(\n776\t    52\t            self,\n777\t    53\t            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n778\t    54\t            parent_instance_id=self.agent_instance_id,\n779\t    55\t            role=role,\n780\t    56\t        )\n781\t    57\t\n782\t    58\t\n783\t    59\tdef new_instance_id() -> str:\n784\t    60\t    return f\"inst-{uuid.uuid4()}\"\n785\t    61\t\n786\t    62\t\n787\t    63\tdef compute_agent_type_id(manifest: dict) -> str:\n788\t    64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n789\t    65\t    material = {\n790\t    66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n791\t    67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n792\t    68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n793\t    69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n794\t    70\t        \"models\": manifest[\"models\"],\n795\t    71\t        \"config\": manifest[\"config\"],\n796\t    72\t        \"tools\": manifest[\"tool_pins\"],\n797\t    73\t    }\n798\t    74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n799\t    75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n800\t    76\t\n801\t    77\t\n802\t    78\t@dataclass\n803\t    79\tclass _CachedToken:\n804\t    80\t    value: str\n805\t    81\t    expires_at: float\n806\t    82\t\n807\t    83\t\n808\t    84\t@dataclass\n809\t    85\tclass TokenBroker:\n810\t    86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n811\t    87\t\n812\t    88\t    settings: Settings\n813\t    89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n814\t    90\t\n815\t    91\t    def _workload_token(self) -> str:\n816\t    92\t        return Path(self.settings.workload_token_path).read_text().strip()\n817\t    93\t\n818\t    94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n819\t    95\t        key = (audience, scope, ident.tenant)\n820\t    96\t        cached = self._cache.get(key)\n821\t    97\t        if cached and cached.expires_at - 30 > time.time():\n822\t    98\t            return cached.value\n823\t    99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n824\t   100\t            resp = await client.post(\n825\t   101\t                self.settings.sts_url,\n826\t   102\t                data={\n827\t   103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n828\t   104\t                    \"subject_token\": self._workload_token(),\n829\t   105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n830\t   106\t                    \"audience\": audience,\n831\t   107\t                    \"scope\": scope,\n832\t   108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n833\t   109\t                    \"actor_token\": ident.delegated_subject,\n834\t   110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n835\t   111\t                },\n836\t   112\t            )\n837\t   113\t            resp.raise_for_status()\n838\t   114\t            body = resp.json()\n839\t   115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n840\t   116\t        self._cache[key] = token\n841\t   117\t        return token.value\n842\t=== app/ingest.py\n843\t     1\t\"\"\"Inbound documents: vendor quotes and invoices from the mail gateway.\n844\t     2\t\n845\t     3\tThe mail gateway posts each received message to ``/ingest/mail`` signed with\n846\t     4\tan HMAC over the timestamp and body. Accepted documents are stored per\n847\t     5\tbusiness unit and are only ever shown to the model inside an\n848\t     6\t``untrusted_document`` wrapper (tools/documents.py).\n849\t     7\t\"\"\"\n850\t     8\tfrom __future__ import annotations\n851\t     9\t\n852\t    10\timport base64\n853\t    11\timport email\n854\t    12\timport email.policy\n855\t    13\timport hashlib\n856\t    14\timport hmac\n857\t    15\timport io\n858\t    16\timport re\n859\t    17\timport time\n860\t    18\timport uuid\n861\t    19\tfrom dataclasses import dataclass\n862\t    20\tfrom pathlib import Path\n863\t    21\t\n864\t    22\tfrom fastapi import APIRouter, HTTPException, Request\n865\t    23\tfrom pypdf import PdfReader\n866\t    24\t\n867\t    25\trouter = APIRouter()\n868\t    26\t\n869\t    27\tMAX_BODY_BYTES = 10 * 1024 * 1024\n870\t    28\tMAX_TEXT_CHARS = 200_000\n871\t    29\tMAX_SKEW_SECONDS = 300\n872\t    30\tALLOWED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\", \"message/rfc822\"}\n873\t    31\tSCANNED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\"}\n874\t    32\t\n875\t    33\tINJECTION_PATTERNS = [\n876\t    34\t    re.compile(r\"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)\"),\n877\t    35\t    re.compile(r\"(?i)\\b(system|developer) (prompt|message)\\b\"),\n878\t    36\t    re.compile(r\"(?i)\\byou are (now )?(an?|the) \\w+ (agent|assistant)\\b\"),\n879\t    37\t    re.compile(r\"(?i)\\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\\b\"),\n880\t    38\t    re.compile(r\"(?i)\\b(update|change) (our|the) (bank|remit|payee)\\b\"),\n881\t    39\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n882\t    40\t]\n883\t    41\t\n884\t    42\t\n885\t    43\tclass Rejected(Exception):\n886\t    44\t    pass\n887\t    45\t\n888\t    46\t\n889\t    47\t@dataclass\n890\t    48\tclass Inbound:\n891\t    49\t    business_unit: str\n892\t    50\t    sender: str\n893\t    51\t    media_type: str\n894\t    52\t    raw: bytes\n895\t    53\t\n896\t    54\t\n897\t    55\tdef verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:\n898\t    56\t    try:\n899\t    57\t        ts = int(timestamp)\n900\t    58\t    except ValueError as exc:\n901\t    59\t        raise Rejected(\"bad timestamp\") from exc\n902\t    60\t    if abs(time.time() - ts) > MAX_SKEW_SECONDS:\n903\t    61\t        raise Rejected(\"stale request\")\n904\t    62\t    expected = hmac.new(key, f\"{timestamp}.\".encode() + body, hashlib.sha256).hexdigest()\n905\t    63\t    if not hmac.compare_digest(expected, signature):\n906\t    64\t        raise Rejected(\"bad signature\")\n907\t    65\t\n908\t    66\t\n909\t    67\tdef extract_text(doc: Inbound) -> str:\n910\t    68\t    if doc.media_type == \"application/pdf\":\n911\t    69\t        reader = PdfReader(io.BytesIO(doc.raw))\n912\t    70\t        if len(reader.pages) > 50:\n913\t    71\t            raise Rejected(\"too many pages\")\n914\t    72\t        return \"\\n\".join(page.extract_text() or \"\" for page in reader.pages)\n915\t    73\t    if doc.media_type == \"message/rfc822\":\n916\t    74\t        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)\n917\t    75\t        body = msg.get_body(preferencelist=(\"plain\", \"html\"))\n918\t    76\t        return body.get_content() if body is not None else \"\"\n919\t    77\t    return doc.raw.decode(\"utf-8\", errors=\"strict\")\n920\t    78\t\n921\t    79\t\n922\t    80\tdef scan_for_injection(text: str) -> list[str]:\n923\t    81\t    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]\n924\t    82\t\n925\t    83\t\n926\t    84\tdef validate(doc: Inbound) -> str:\n927\t    85\t    if doc.media_type not in ALLOWED_MEDIA_TYPES:\n928\t    86\t        raise Rejected(f\"media type {doc.media_type} not accepted\")\n929\t    87\t    if len(doc.raw) > MAX_BODY_BYTES:\n930\t    88\t        raise Rejected(\"document too large\")\n931\t    89\t    try:\n932\t    90\t        text = extract_text(doc)\n933\t    91\t    except Rejected:\n934\t    92\t        raise\n935\t    93\t    except Exception as exc:\n936\t    94\t        raise Rejected(f\"unreadable document: {type(exc).__name__}\") from exc\n937\t    95\t    if len(text) > MAX_TEXT_CHARS:\n938\t    96\t        raise Rejected(\"extracted text too long\")\n939\t    97\t    if doc.media_type in SCANNED_MEDIA_TYPES:\n940\t    98\t        findings = scan_for_injection(text)\n941\t    99\t        if findings:\n942\t   100\t            raise Rejected(\"possible prompt injection: \" + \"; \".join(findings))\n943\t   101\t    return text\n944\t   102\t\n945\t   103\t\n946\t   104\t@router.post(\"/ingest/mail\")\n947\t   105\tasync def ingest_mail(request: Request) -> dict:\n948\t   106\t    body = await request.body()\n949\t   107\t    if len(body) > MAX_BODY_BYTES * 2:\n950\t   108\t        raise HTTPException(413, \"payload too large\")\n951\t   109\t    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()\n952\t   110\t    try:\n953\t   111\t        verify_signature(\n954\t   112\t            key,\n955\t   113\t            request.headers.get(\"X-Gateway-Timestamp\", \"\"),\n956\t   114\t            body,\n957\t   115\t            request.headers.get(\"X-Gateway-Signature\", \"\"),\n958\t   116\t        )\n959\t   117\t    except Rejected as exc:\n960\t   118\t        raise HTTPException(401, str(exc)) from exc\n961\t   119\t\n962\t   120\t    payload = await request.json()\n963\t   121\t    doc = Inbound(\n964\t   122\t        business_unit=payload[\"business_unit\"],\n965\t   123\t        sender=payload[\"from\"],\n966\t   124\t        media_type=payload[\"media_type\"],\n967\t   125\t        raw=base64.b64decode(payload[\"content_b64\"], validate=True),\n968\t   126\t    )\n969\t   127\t    doc_id = f\"doc-{uuid.uuid4().hex[:20]}\"\n970\t   128\t    pool = request.app.state.pool\n971\t   129\t    try:\n972\t   130\t        text = validate(doc)\n973\t   131\t    except Rejected as exc:\n974\t   132\t        await pool.execute(\n975\t   133\t            \"\"\"\n976\t   134\t            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)\n977\t   135\t            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())\n978\t   136\t            \"\"\",\n979\t   137\t            doc_id, doc.business_unit, doc.sender, doc.media_type,\n980\t   138\t            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],\n981\t   139\t        )\n982\t   140\t        return {\"doc_id\": doc_id, \"status\": \"quarantined\"}\n983\t   141\t\n984\t   142\t    await pool.execute(\n985\t   143\t        \"\"\"\n986\t   144\t        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)\n987\t   145\t        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())\n988\t   146\t        \"\"\",\n989\t   147\t        doc_id, doc.business_unit, doc.sender, doc.media_type,\n990\t   148\t        hashlib.sha256(doc.raw).hexdigest(), text,\n991\t   149\t    )\n992\t   150\t    return {\"doc_id\": doc_id, \"status\": \"accepted\"}\n993\t=== app/killswitch.py\n994\t     1\t\"\"\"Operator stop control.\n995\t     2\t\n996\t     3\tOperators halt the fleet or one business unit by setting a row in\n997\t     4\t``control_flags`` with the ``procurement_ops`` database role (see\n998\t     5\tops/README in the platform runbook). The agent's own database role has\n999\t     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n1000\t     7\t\"\"\"\n1001\t     8\tfrom __future__ import annotations\n1002\t     9\t\n1003\t    10\t\n1004\t    11\tclass AgentHalted(Exception):\n1005\t    12\t    pass\n1006\t    13\t\n1007\t    14\t\n1008\t    15\t_QUERY = \"\"\"\n1009\t    16\tSELECT scope, reason, set_by, set_at\n1010\t    17\tFROM control_flags\n1011\t    18\tWHERE halted\n1012\t    19\t  AND (scope = 'fleet' OR scope = $1)\n1013\t    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n1014\t    21\tLIMIT 1\n1015\t    22\t\"\"\"\n1016\t    23\t\n1017\t    24\t\n1018\t    25\tasync def assert_running(pool, tenant: str) -> None:\n1019\t    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n1020\t    27\t    if row is not None:\n1021\t    28\t        raise AgentHalted(\n1022\t    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n1023\t    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n1024\t    31\t        )\n1025\t=== app/loop.py\n1026\t     1\t\"\"\"Procurement agent run loop.\n1027\t     2\t\n1028\t     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n1029\t     4\tEvery edge writes an audit node before the next step runs. Budgets are\n1030\t     5\tchecked before each model turn and each tool call.\n1031\t     6\t\"\"\"\n1032\t     7\tfrom __future__ import annotations\n1033\t     8\t\n1034\t     9\timport hashlib\n1035\t    10\timport logging\n1036\t    11\tfrom dataclasses import dataclass, field\n1037\t    12\tfrom typing import Any\n1038\t    13\t\n1039\t    14\tfrom opentelemetry import trace\n1040\t    15\t\n1041\t    16\tfrom app import audit, killswitch\n1042\t    17\tfrom app.budget import Budget, BudgetExceeded\n1043\t    18\tfrom app.context_size import ContextMeasure, measure_context\n1044\t    19\tfrom app.gate import PolicyGate\n1045\t    20\tfrom app.identity import RunIdentity\n1046\t    21\tfrom app.redact import redact_for_model\n1047\t    22\tfrom app.tools import ToolRegistry, build_registry\n1048\t    23\t\n1049\t    24\tlog = logging.getLogger(__name__)\n1050\t    25\ttracer = trace.get_tracer(\"procurement.loop\")\n1051\t    26\t\n1052\t    27\tCOMPACT_AFTER_MESSAGES = 40\n1053\t    28\tKEEP_RECENT_MESSAGES = 12\n1054\t    29\t\n1055\t    30\t\n1056\t    31\t@dataclass\n1057\t    32\tclass AgentDeps:\n1058\t    33\t    settings: Any\n1059\t    34\t    pool: Any\n1060\t    35\t    gate: PolicyGate\n1061\t    36\t    erp: Any\n1062\t    37\t    slack: Any\n1063\t    38\t    broker: Any\n1064\t    39\t    extractor: Any = None\n1065\t    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n1066\t    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n1067\t    42\t\n1068\t    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n1069\t    44\t        return self._budgets[ident.run_id]\n1070\t    45\t\n1071\t    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n1072\t    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n1073\t    48\t\n1074\t    49\t    def erp_scope_for(self, operation: str) -> str:\n1075\t    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n1076\t    51\t        return scopes.get(operation, \"erp.read\")\n1077\t    52\t\n1078\t    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n1079\t    54\t        self._contexts[ident.agent_instance_id] = ctx\n1080\t    55\t        proposed = await audit.record(\n1081\t    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n1082\t    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n1083\t    58\t        )\n1084\t    59\t        tool = registry.get(use.name)\n1085\t    60\t        if tool is None:\n1086\t    61\t            await audit.record(\n1087\t    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n1088\t    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n1089\t    64\t            )\n1090\t    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n1091\t    66\t\n1092\t    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n1093\t    68\t        authz = await audit.record(\n1094\t    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n1095\t    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n1096\t    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n1097\t    72\t        )\n1098\t    73\t        if not decision.allow:\n1099\t    74\t            if decision.pending:\n1100\t    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n1101\t    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n1102\t    77\t\n1103\t    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n1104\t    79\t        try:\n1105\t    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n1106\t    81\t                for k, v in ctx.otel_attributes().items():\n1107\t    82\t                    span.set_attribute(k, v)\n1108\t    83\t                output = await tool.invoke(use.input, ident)\n1109\t    84\t        except BudgetExceeded:\n1110\t    85\t            raise\n1111\t    86\t        except Exception as exc:\n1112\t    87\t            await audit.record(\n1113\t    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n1114\t    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n1115\t    90\t                operation_id=operation_id,\n1116\t    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n1117\t    92\t            )\n1118\t    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n1119\t    94\t\n1120\t    95\t        await audit.record(\n1121\t    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n1122\t    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n1123\t    98\t            operation_id=operation_id,\n1124\t    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n1125\t   100\t        )\n1126\t   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n1127\t   102\t\n1128\t   103\t\n1129\t   104\tdef _error(tool_use_id: str, message: str) -> dict:\n1130\t   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n1131\t   106\t\n1132\t   107\t\n1133\t   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n1134\t   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n1135\t   110\t        return messages, False\n1136\t   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n1137\t   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n1138\t   113\t        tail = tail[1:]\n1139\t   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n1140\t   115\t    return head + [note] + tail, True\n1141\t   116\t\n1142\t   117\t\n1143\t   118\tclass ProcurementAgent:\n1144\t   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n1145\t   120\t        self.client = client\n1146\t   121\t        self.deps = deps\n1147\t   122\t        self.system_prompt = system_prompt\n1148\t   123\t        self.role = role\n1149\t   124\t\n1150\t   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n1151\t   126\t        pool = self.deps.pool\n1152\t   127\t        await killswitch.assert_running(pool, ident.tenant)\n1153\t   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n1154\t   129\t        await budget.reserve_run_start(pool)\n1155\t   130\t        self.deps._budgets[ident.run_id] = budget\n1156\t   131\t        registry = build_registry(self.role, ident, self.deps)\n1157\t   132\t\n1158\t   133\t        run_node = await audit.record(\n1159\t   134\t            pool, ident, kind=\"run_started\",\n1160\t   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n1161\t   136\t        )\n1162\t   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n1163\t   138\t        try:\n1164\t   139\t            while True:\n1165\t   140\t                budget.check_step()\n1166\t   141\t                messages, compacted = _compact(messages)\n1167\t   142\t                request = {\n1168\t   143\t                    \"model\": self.deps.settings.model_id,\n1169\t   144\t                    \"system\": self.system_prompt,\n1170\t   145\t                    \"messages\": messages,\n1171\t   146\t                    \"tools\": registry.schemas(),\n1172\t   147\t                    \"max_tokens\": 4096,\n1173\t   148\t                }\n1174\t   149\t                ctx = await measure_context(self.client, request, compacted)\n1175\t   150\t                response = await self.client.messages.create(**request)\n1176\t   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n1177\t   152\t                await budget.flush(pool)\n1178\t   153\t                ctx = ctx.finalize(response.usage)\n1179\t   154\t                decision = await audit.record(\n1180\t   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n1181\t   156\t                    payload={\n1182\t   157\t                        \"requested_model\": request[\"model\"],\n1183\t   158\t                        \"served_model\": response.model,\n1184\t   159\t                        \"stop_reason\": response.stop_reason,\n1185\t   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n1186\t   161\t                    },\n1187\t   162\t                )\n1188\t   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n1189\t   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n1190\t   165\t                if not uses:\n1191\t   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n1192\t   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n1193\t   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n1194\t   169\t                    return final\n1195\t   170\t                results = []\n1196\t   171\t                for use in uses:\n1197\t   172\t                    budget.check_tool_call()\n1198\t   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n1199\t   174\t                messages.append({\"role\": \"user\", \"content\": results})\n1200\t   175\t        except BudgetExceeded as exc:\n1201\t   176\t            await audit.record(\n1202\t   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n1203\t   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n1204\t   179\t            )\n1205\t   180\t            await self.deps.slack.post(\n1206\t   181\t                channel=\"#procurement-agent-ops\",\n1207\t   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n1208\t   183\t            )\n1209\t   184\t            return None\n1210\t   185\t        finally:\n1211\t   186\t            self.deps._budgets.pop(ident.run_id, None)\n1212\t=== app/main.py\n1213\t     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n1214\t     2\tfrom __future__ import annotations\n1215\t     3\t\n1216\t     4\timport asyncio\n1217\t     5\timport hashlib\n1218\t     6\timport hmac\n1219\t     7\timport json\n1220\t     8\timport logging\n1221\t     9\timport time\n1222\t    10\timport uuid\n1223\t    11\tfrom contextlib import asynccontextmanager\n1224\t    12\tfrom pathlib import Path\n1225\t    13\tfrom urllib.parse import parse_qs\n1226\t    14\t\n1227\t    15\timport asyncpg\n1228\t    16\timport jwt\n1229\t    17\tfrom anthropic import AsyncAnthropic\n1230\t    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n1231\t    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n1232\t    20\tfrom opentelemetry import trace\n1233\t    21\tfrom pydantic import BaseModel, Field\n1234\t    22\t\n1235\t    23\tfrom app import audit, ingest\n1236\t    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n1237\t    25\tfrom app.extractor import LineItemExtractor\n1238\t    26\tfrom app.gate import PolicyGate\n1239\t    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n1240\t    28\tfrom app.loop import AgentDeps, ProcurementAgent\n1241\t    29\tfrom app.mcp_client import ErpMcpClient\n1242\t    30\tfrom app.redact import RedactingFilter\n1243\t    31\tfrom app.settings import get_settings\n1244\t    32\tfrom app.startup import startup_checks\n1245\t    33\tfrom app.tools.slack import SlackClient\n1246\t    34\t\n1247\t    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n1248\t    36\tfor handler in logging.getLogger().handlers:\n1249\t    37\t    handler.addFilter(RedactingFilter())\n1250\t    38\tlog = logging.getLogger(\"procurement\")\n1251\t    39\t\n1252\t    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n1253\t    41\tbearer = HTTPBearer()\n1254\t    42\t\n1255\t    43\t\n1256\t    44\tclass RunRequest(BaseModel):\n1257\t    45\t    task: str = Field(min_length=1, max_length=4000)\n1258\t    46\t    department: str = Field(min_length=1, max_length=64)\n1259\t    47\t\n1260\t    48\t\n1261\t    49\tclass Principal(BaseModel):\n1262\t    50\t    subject: str\n1263\t    51\t    business_unit: str\n1264\t    52\t\n1265\t    53\t\n1266\t    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n1267\t    55\t    return RunIdentity(\n1268\t    56\t        accountable_party=\"system:procurement-agent\",\n1269\t    57\t        operational_owner=settings.operational_owner,\n1270\t    58\t        tenant=tenant,\n1271\t    59\t        agent_type_id=agent_type_id,\n1272\t    60\t        agent_instance_id=new_instance_id(),\n1273\t    61\t        trace_id=uuid.uuid4().hex,\n1274\t    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n1275\t    63\t        delegated_subject=\"system:procurement-agent\",\n1276\t    64\t        agent_principal=AGENT_PRINCIPAL,\n1277\t    65\t    )\n1278\t    66\t\n1279\t    67\t\n1280\t    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n1281\t    69\t    while True:\n1282\t    70\t        await asyncio.sleep(60)\n1283\t    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n1284\t    72\t        count = await app.state.pool.fetchval(\n1285\t    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n1286\t    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n1287\t    75\t        )\n1288\t    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n1289\t    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n1290\t    78\t\n1291\t    79\t\n1292\t    80\t@asynccontextmanager\n1293\t    81\tasync def lifespan(app: FastAPI):\n1294\t    82\t    settings = get_settings()\n1295\t    83\t    agent_type_id = startup_checks(settings)\n1296\t    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n1297\t    85\t    broker = TokenBroker(settings)\n1298\t    86\t\n1299\t    87\t    async def slack_token() -> str:\n1300\t    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n1301\t    89\t\n1302\t    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n1303\t    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n1304\t    92\t    gate = PolicyGate(settings.policy, approvals)\n1305\t    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n1306\t    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n1307\t    95\t\n1308\t    96\t    client = AsyncAnthropic()\n1309\t    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n1310\t    98\t    deps.extractor = LineItemExtractor(\n1311\t    99\t        client=client, settings=settings, deps=deps,\n1312\t   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n1313\t   101\t    )\n1314\t   102\t    app.state.settings = settings\n1315\t   103\t    app.state.pool = pool\n1316\t   104\t    app.state.agent_type_id = agent_type_id\n1317\t   105\t    app.state.approvals = approvals\n1318\t   106\t    app.state.agent = ProcurementAgent(\n1319\t   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n1320\t   108\t    )\n1321\t   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n1322\t   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n1323\t   111\t    try:\n1324\t   112\t        yield\n1325\t   113\t    finally:\n1326\t   114\t        sweeper.cancel()\n1327\t   115\t        await pool.close()\n1328\t   116\t\n1329\t   117\t\n1330\t   118\tapp = FastAPI(lifespan=lifespan)\n1331\t   119\tapp.include_router(ingest.router)\n1332\t   120\t\n1333\t   121\t\n1334\t   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n1335\t   123\t    settings = request.app.state.settings\n1336\t   124\t    try:\n1337\t   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n1338\t   126\t        claims = jwt.decode(\n1339\t   127\t            creds.credentials,\n1340\t   128\t            key.key,\n1341\t   129\t            algorithms=[\"RS256\", \"ES256\"],\n1342\t   130\t            audience=settings.oidc_audience,\n1343\t   131\t            issuer=settings.oidc_issuer,\n1344\t   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n1345\t   133\t        )\n1346\t   134\t    except jwt.PyJWTError as exc:\n1347\t   135\t        raise HTTPException(401, \"invalid token\") from exc\n1348\t   136\t    bu = claims.get(\"bu\")\n1349\t   137\t    if not bu:\n1350\t   138\t        raise HTTPException(403, \"token has no business unit\")\n1351\t   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n1352\t   140\t\n1353\t   141\t\n1354\t   142\t@app.post(\"/runs\")\n1355\t   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n1356\t   144\t    settings = request.app.state.settings\n1357\t   145\t    span_ctx = trace.get_current_span().get_span_context()\n1358\t   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n1359\t   147\t    ident = RunIdentity(\n1360\t   148\t        accountable_party=principal.subject,\n1361\t   149\t        operational_owner=settings.operational_owner,\n1362\t   150\t        tenant=principal.business_unit,\n1363\t   151\t        agent_type_id=request.app.state.agent_type_id,\n1364\t   152\t        agent_instance_id=new_instance_id(),\n1365\t   153\t        trace_id=trace_id,\n1366\t   154\t        run_id=f\"run-{uuid.uuid4()}\",\n1367\t   155\t        delegated_subject=principal.subject,\n1368\t   156\t        agent_principal=AGENT_PRINCIPAL,\n1369\t   157\t    )\n1370\t   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n1371\t   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n1372\t   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n1373\t   161\t\n1374\t   162\t\n1375\t   163\t@app.post(\"/slack/interactions\")\n1376\t   164\tasync def slack_interactions(request: Request) -> dict:\n1377\t   165\t    body = await request.body()\n1378\t   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n1379\t   167\t    if abs(time.time() - int(timestamp)) > 300:\n1380\t   168\t        raise HTTPException(401, \"stale request\")\n1381\t   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n1382\t   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n1383\t   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n1384\t   172\t        raise HTTPException(401, \"bad signature\")\n1385\t   173\t\n1386\t   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n1387\t   175\t    action = payload[\"actions\"][0]\n1388\t   176\t    slack_user = payload[\"user\"][\"id\"]\n1389\t   177\t    row = await request.app.state.pool.fetchrow(\n1390\t   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n1391\t   179\t    )\n1392\t   180\t    if row is None:\n1393\t   181\t        raise HTTPException(403, \"not an approver\")\n1394\t   182\t    try:\n1395\t   183\t        await request.app.state.approvals.decide(\n1396\t   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n1397\t   185\t            approve=action[\"action_id\"] == \"approve\",\n1398\t   186\t        )\n1399\t   187\t    except ApproverNotAuthorized as exc:\n1400\t   188\t        raise HTTPException(403, str(exc)) from exc\n1401\t   189\t    except ValueError as exc:\n1402\t   190\t        raise HTTPException(409, str(exc)) from exc\n1403\t   191\t    return {\"ok\": True}\n1404\t   192\t\n1405\t   193\t\n1406\t   194\t@app.get(\"/healthz\")\n1407\t   195\tasync def healthz() -> dict:\n1408\t   196\t    return {\"ok\": True}\n1409\t=== app/mcp_client.py\n1410\t     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n1411\t     2\t\n1412\t     3\tOn startup the tool list is fetched and each tool's description and input\n1413\t     4\tschema are fingerprinted and compared with the pins in the release manifest.\n1414\t     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n1415\t     6\tinstruction-like content before any of it is shown to the model.\n1416\t     7\t\"\"\"\n1417\t     8\tfrom __future__ import annotations\n1418\t     9\t\n1419\t    10\timport hashlib\n1420\t    11\timport json\n1421\t    12\timport logging\n1422\t    13\timport re\n1423\t    14\timport uuid\n1424\t    15\tfrom typing import Any\n1425\t    16\t\n1426\t    17\timport httpx\n1427\t    18\t\n1428\t    19\tfrom app.identity import RunIdentity, TokenBroker\n1429\t    20\tfrom app.redact import redact_text\n1430\t    21\t\n1431\t    22\tlog = logging.getLogger(__name__)\n1432\t    23\t\n1433\t    24\tMAX_DESCRIPTION_CHARS = 1024\n1434\t    25\tSUSPICIOUS_METADATA = [\n1435\t    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n1436\t    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n1437\t    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n1438\t    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n1439\t    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n1440\t    31\t]\n1441\t    32\t\n1442\t    33\t\n1443\t    34\tclass ToolPinMismatch(Exception):\n1444\t    35\t    pass\n1445\t    36\t\n1446\t    37\t\n1447\t    38\tclass UnknownErpOperation(Exception):\n1448\t    39\t    pass\n1449\t    40\t\n1450\t    41\t\n1451\t    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n1452\t    43\t    material = {\n1453\t    44\t        \"name\": tool[\"name\"],\n1454\t    45\t        \"description\": tool.get(\"description\", \"\"),\n1455\t    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n1456\t    47\t        \"annotations\": tool.get(\"annotations\", {}),\n1457\t    48\t    }\n1458\t    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n1459\t    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n1460\t    51\t\n1461\t    52\t\n1462\t    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n1463\t    54\t    description = tool.get(\"description\", \"\")\n1464\t    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n1465\t    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n1466\t    57\t    blob = json.dumps(tool, ensure_ascii=False)\n1467\t    58\t    for pattern in SUSPICIOUS_METADATA:\n1468\t    59\t        if pattern.search(blob):\n1469\t    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n1470\t    61\t\n1471\t    62\t\n1472\t    63\tclass ErpMcpClient:\n1473\t    64\t    AUDIENCE = \"erp-mcp-gateway\"\n1474\t    65\t\n1475\t    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n1476\t    67\t        self.url = url\n1477\t    68\t        self.pins = pins\n1478\t    69\t        self.broker = broker\n1479\t    70\t        self._tools: dict[str, dict[str, Any]] = {}\n1480\t    71\t\n1481\t    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n1482\t    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n1483\t    74\t            resp = await client.post(\n1484\t    75\t                self.url,\n1485\t    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n1486\t    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n1487\t    78\t            )\n1488\t    79\t        resp.raise_for_status()\n1489\t    80\t        if len(resp.content) > 512_000:\n1490\t    81\t            raise ValueError(\"erp response too large\")\n1491\t    82\t        body = resp.json()\n1492\t    83\t        if \"error\" in body:\n1493\t    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n1494\t    85\t        return body[\"result\"]\n1495\t    86\t\n1496\t    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n1497\t    88\t        result = await self._rpc(\"tools/list\", {}, token)\n1498\t    89\t        return list(result.get(\"tools\", []))\n1499\t    90\t\n1500\t    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n1501\t    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n1502\t    93\t        tools = await self._list_tools(token)\n1503\t    94\t        for tool in tools:\n1504\t    95\t            expected = self.pins.get(tool[\"name\"])\n1505\t    96\t            actual = fingerprint(tool)\n1506\t    97\t            if expected != actual:\n1507\t    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n1508\t    99\t            scan_metadata(tool)\n1509\t   100\t        self._tools = {t[\"name\"]: t for t in tools}\n1510\t   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n1511\t   102\t\n1512\t   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n1513\t   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n1514\t   105\t            await self.refresh_tools(service_ident)\n1515\t   106\t\n1516\t   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n1517\t   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n1518\t   109\t        tools = await self._list_tools(token)\n1519\t   110\t        self._tools = {t[\"name\"]: t for t in tools}\n1520\t   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n1521\t   112\t\n1522\t   113\t    def operations(self) -> list[str]:\n1523\t   114\t        return sorted(self._tools)\n1524\t   115\t\n1525\t   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n1526\t   117\t        if operation not in self._tools:\n1527\t   118\t            raise UnknownErpOperation(operation)\n1528\t   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n1529\t   120\t        result = await self._rpc(\n1530\t   121\t            \"tools/call\",\n1531\t   122\t            {\n1532\t   123\t                \"name\": operation,\n1533\t   124\t                \"arguments\": arguments,\n1534\t   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n1535\t   126\t            },\n1536\t   127\t            token,\n1537\t   128\t        )\n1538\t   129\t        if result.get(\"isError\"):\n1539\t   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n1540\t   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n1541\t=== app/redact.py\n1542\t     1\t\"\"\"Redaction for model input, logs, audit payloads, and outbound messages.\n1543\t     2\t\n1544\t     3\tApplied in four places:\n1545\t     4\t  * tool results before they are appended to the model context (loop.py)\n1546\t     5\t  * every audit payload (audit.py)\n1547\t     6\t  * the root logging filter (main.py)\n1548\t     7\t  * outbound Slack text (tools/slack.py)\n1549\t     8\t\"\"\"\n1550\t     9\tfrom __future__ import annotations\n1551\t    10\t\n1552\t    11\timport logging\n1553\t    12\timport re\n1554\t    13\tfrom typing import Any\n1555\t    14\tfrom urllib.parse import urlparse\n1556\t    15\t\n1557\t    16\tSECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n1558\t    17\t    (\"bearer\", re.compile(r\"(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]{16,}\")),\n1559\t    18\t    (\"jwt\", re.compile(r\"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b\")),\n1560\t    19\t    (\"acct_token\", re.compile(r\"\\bacct_tok_[A-Za-z0-9_]{8,}\\b\")),\n1561\t    20\t    (\"pay_token\", re.compile(r\"\\bpay_tok_[A-Za-z0-9_]{8,}\\b\")),\n1562\t    21\t    (\"erp_session\", re.compile(r\"\\berp_sess_[A-Za-z0-9_]{8,}\\b\")),\n1563\t    22\t    (\"password_kv\", re.compile(r\"(?i)\\b(password|passwd|secret|api[_-]?key)\\s*[:=]\\s*\\S+\")),\n1564\t    23\t]\n1565\t    24\t\n1566\t    25\t# Bank details: keep the last four characters so staff can still match records.\n1567\t    26\tACCOUNT_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n1568\t    27\t    (\"iban\", re.compile(r\"\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b\")),\n1569\t    28\t    (\"account_no\", re.compile(r\"(?i)\\b(account|acct|routing)\\s*(no\\.?|number|#)?\\s*[:#]?\\s*(\\d[\\d -]{6,}\\d)\")),\n1570\t    29\t]\n1571\t    30\t\n1572\t    31\tMARKDOWN_IMAGE = re.compile(r\"!\\[[^\\]]*\\]\\(([^)\\s]+)[^)]*\\)\")\n1573\t    32\tMARKDOWN_LINK = re.compile(r\"(?<!!)\\[([^\\]]*)\\]\\(([^)\\s]+)[^)]*\\)\")\n1574\t    33\tSLACK_LINK = re.compile(r\"<(https?://[^|>]+)(\\|[^>]*)?>\")\n1575\t    34\tBARE_URL = re.compile(r\"https?://[^\\s<>()]+\")\n1576\t    35\t\n1577\t    36\tAPPROVED_LINK_HOSTS = frozenset({\"erp.example-corp.test\", \"intranet.example-corp.test\"})\n1578\t    37\t\n1579\t    38\t\n1580\t    39\tdef _mask_tail(match: re.Match[str]) -> str:\n1581\t    40\t    text = match.group(0)\n1582\t    41\t    return \"[REDACTED:\" + \"*\" * 4 + text[-4:] + \"]\"\n1583\t    42\t\n1584\t    43\t\n1585\t    44\tdef redact_text(text: str) -> str:\n1586\t    45\t    for name, pattern in SECRET_PATTERNS:\n1587\t    46\t        text = pattern.sub(f\"[REDACTED:{name}]\", text)\n1588\t    47\t    for _name, pattern in ACCOUNT_PATTERNS:\n1589\t    48\t        text = pattern.sub(_mask_tail, text)\n1590\t    49\t    return text\n1591\t    50\t\n1592\t    51\t\n1593\t    52\tdef redact_value(value: Any) -> Any:\n1594\t    53\t    if isinstance(value, str):\n1595\t    54\t        return redact_text(value)\n1596\t    55\t    if isinstance(value, dict):\n1597\t    56\t        return {k: redact_value(v) for k, v in value.items()}\n1598\t    57\t    if isinstance(value, (list, tuple)):\n1599\t    58\t        return [redact_value(v) for v in value]\n1600\t    59\t    return value\n1601\t    60\t\n1602\t    61\t\n1603\t    62\tdef redact_for_model(value: Any) -> str:\n1604\t    63\t    if not isinstance(value, str):\n1605\t    64\t        import json\n1606\t    65\t\n1607\t    66\t        value = json.dumps(value, default=str)\n1608\t    67\t    return redact_text(value)\n1609\t    68\t\n1610\t    69\t\n1611\t    70\tdef _host_ok(url: str) -> bool:\n1612\t    71\t    host = (urlparse(url).hostname or \"\").lower()\n1613\t    72\t    return host in APPROVED_LINK_HOSTS\n1614\t    73\t\n1615\t    74\t\n1616\t    75\tdef strip_unapproved_links(text: str) -> str:\n1617\t    76\t    \"\"\"Remove images entirely and drop links to hosts outside the allowlist.\n1618\t    77\t\n1619\t    78\t    Slack and most chat clients fetch link and image URLs to render previews,\n1620\t    79\t    so an attacker-chosen URL can carry data out without any tool call.\n1621\t    80\t    \"\"\"\n1622\t    81\t    text = MARKDOWN_IMAGE.sub(\"[image removed]\", text)\n1623\t    82\t    text = MARKDOWN_LINK.sub(\n1624\t    83\t        lambda m: m.group(0) if _host_ok(m.group(2)) else m.group(1), text\n1625\t    84\t    )\n1626\t    85\t    text = SLACK_LINK.sub(\n1627\t    86\t        lambda m: m.group(0) if _host_ok(m.group(1)) else \"[link removed]\", text\n1628\t    87\t    )\n1629\t    88\t    text = BARE_URL.sub(\n1630\t    89\t        lambda m: m.group(0) if _host_ok(m.group(0)) else \"[link removed]\", text\n1631\t    90\t    )\n1632\t    91\t    return text\n1633\t    92\t\n1634\t    93\t\n1635\t    94\tclass RedactingFilter(logging.Filter):\n1636\t    95\t    def filter(self, record: logging.LogRecord) -> bool:\n1637\t    96\t        if isinstance(record.msg, str):\n1638\t    97\t            record.msg = redact_text(record.msg)\n1639\t    98\t        if record.args:\n1640\t    99\t            record.args = tuple(redact_value(a) for a in record.args)\n1641\t   100\t        return True\n1642\t=== app/settings.py\n1643\t     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n1644\t     2\tfrom __future__ import annotations\n1645\t     3\t\n1646\t     4\timport os\n1647\t     5\tfrom dataclasses import dataclass\n1648\t     6\tfrom functools import lru_cache\n1649\t     7\tfrom pathlib import Path\n1650\t     8\t\n1651\t     9\timport yaml\n1652\t    10\t\n1653\t    11\t\n1654\t    12\tdef _env(name: str, default: str | None = None) -> str:\n1655\t    13\t    value = os.environ.get(name, default)\n1656\t    14\t    if value is None:\n1657\t    15\t        raise RuntimeError(f\"missing required setting {name}\")\n1658\t    16\t    return value\n1659\t    17\t\n1660\t    18\t\n1661\t    19\t@dataclass(frozen=True)\n1662\t    20\tclass Settings:\n1663\t    21\t    database_url: str\n1664\t    22\t    erp_mcp_url: str\n1665\t    23\t    payments_api_url: str\n1666\t    24\t    slack_api_url: str\n1667\t    25\t    sts_url: str\n1668\t    26\t    oidc_issuer: str\n1669\t    27\t    oidc_audience: str\n1670\t    28\t    oidc_jwks_url: str\n1671\t    29\t    workload_token_path: str\n1672\t    30\t    slack_signing_secret_path: str\n1673\t    31\t    mail_gateway_hmac_path: str\n1674\t    32\t    model_id: str\n1675\t    33\t    extractor_model_id: str\n1676\t    34\t    manifest_path: Path\n1677\t    35\t    prompt_dir: Path\n1678\t    36\t    policy_path: Path\n1679\t    37\t    tools_path: Path\n1680\t    38\t    operational_owner: str\n1681\t    39\t    image_digest: str\n1682\t    40\t\n1683\t    41\t    @property\n1684\t    42\t    def policy(self) -> dict:\n1685\t    43\t        return _load_yaml(self.policy_path)\n1686\t    44\t\n1687\t    45\t    @property\n1688\t    46\t    def manifest(self) -> dict:\n1689\t    47\t        return _load_yaml(self.manifest_path)\n1690\t    48\t\n1691\t    49\t    @property\n1692\t    50\t    def budgets(self) -> dict:\n1693\t    51\t        return self.policy[\"budgets\"]\n1694\t    52\t\n1695\t    53\t\n1696\t    54\tdef _load_yaml(path: Path) -> dict:\n1697\t    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n1698\t    56\t        return yaml.safe_load(fh)\n1699\t    57\t"}]},"parent_tool_use_id":null,"session_id":"26203897-c02e-482f-8eda-5e1c431a7535","uuid":"f03f4f6b-4038-48c2-9b7f-b1661d57486b","timestamp":"2026-10-02T15:55:06.870Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-repeat-m0jquuov/26203897-c02e-482f-8eda-5e1c431a7535/tool-results/bqdy2cvk4.txt","content":"    38\t\n    39\t        if tool.name == \"post_slack_message\":\n    40\t            if args.get(\"external\", False):\n    41\t                return await self._require_approval(ident, tool, args)\n    42\t            return Decision(True, \"internal staff message\", self.version)\n    43\t\n    44\t        if tool.name in self.high_impact:\n    45\t            return await self._require_approval(ident, tool, args)\n    46\t\n    47\t        return Decision(True, \"low-impact tool\", self.version)\n    48\t\n    49\t    async def _require_approval(self, ident: RunIdentity, tool, args: dict[str, Any]) -> Decision:\n    50\t        target = tool.target_of(args)\n    51\t        approval = await self.approvals.find_valid(ident, tool.name, target)\n    52\t        if approval is not None:\n    53\t            return Decision(True, \"approved\", self.version, approval_id=approval.id)\n    54\t        approval_id = await self.approvals.request(ident, tool.name, target, args)\n    55\t        return Decision(\n    56\t            False,\n    57\t            \"approval required; request opened\",\n    58\t            self.version,\n    59\t            approval_id=approval_id,\n    60\t            pending=True,\n    61\t        )\n=== app/identity.py\n     1\t\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n     2\t\n     3\tThe agent runs under its own Kubernetes service account. Its projected\n     4\tservice-account token is exchanged at the internal STS for short-lived,\n     5\taudience-bound tokens. The launching user's token is never forwarded to an\n     6\tintegration; the user is carried as the delegated subject of the exchange.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport time\n    13\timport uuid\n    14\tfrom dataclasses import dataclass, field, replace\n    15\tfrom pathlib import Path\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.settings import Settings\n    20\t\n    21\tIDENTITY_FIELDS = (\n    22\t    \"accountable_party\",\n    23\t    \"operational_owner\",\n    24\t    \"tenant\",\n    25\t    \"agent_type_id\",\n    26\t    \"agent_instance_id\",\n    27\t    \"trace_id\",\n    28\t)\n    29\t\n    30\t\n    31\t@dataclass(frozen=True)\n    32\tclass RunIdentity:\n    33\t    accountable_party: str\n    34\t    operational_owner: str\n    35\t    tenant: str\n    36\t    agent_type_id: str\n    37\t    agent_instance_id: str\n    38\t    trace_id: str\n    39\t    run_id: str\n    40\t    delegated_subject: str\n    41\t    agent_principal: str\n    42\t    parent_instance_id: str | None = None\n    43\t    role: str = \"procurement\"\n    44\t\n    45\t    def __post_init__(self) -> None:\n    46\t        for name in IDENTITY_FIELDS:\n    47\t            if not getattr(self, name):\n    48\t                raise ValueError(f\"identity field {name} is empty\")\n    49\t\n    50\t    def child(self, role: str) -> \"RunIdentity\":\n    51\t        return replace(\n    52\t            self,\n    53\t            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n    54\t            parent_instance_id=self.agent_instance_id,\n    55\t            role=role,\n    56\t        )\n    57\t\n    58\t\n    59\tdef new_instance_id() -> str:\n    60\t    return f\"inst-{uuid.uuid4()}\"\n    61\t\n    62\t\n    63\tdef compute_agent_type_id(manifest: dict) -> str:\n    64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    65\t    material = {\n    66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n    67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n    68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n    69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n    70\t        \"models\": manifest[\"models\"],\n    71\t        \"config\": manifest[\"config\"],\n    72\t        \"tools\": manifest[\"tool_pins\"],\n    73\t    }\n    74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n    76\t\n    77\t\n    78\t@dataclass\n    79\tclass _CachedToken:\n    80\t    value: str\n    81\t    expires_at: float\n    82\t\n    83\t\n    84\t@dataclass\n    85\tclass TokenBroker:\n    86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n    87\t\n    88\t    settings: Settings\n    89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n    90\t\n    91\t    def _workload_token(self) -> str:\n    92\t        return Path(self.settings.workload_token_path).read_text().strip()\n    93\t\n    94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n    95\t        key = (audience, scope, ident.tenant)\n    96\t        cached = self._cache.get(key)\n    97\t        if cached and cached.expires_at - 30 > time.time():\n    98\t            return cached.value\n    99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n   100\t            resp = await client.post(\n   101\t                self.settings.sts_url,\n   102\t                data={\n   103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n   104\t                    \"subject_token\": self._workload_token(),\n   105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n   106\t                    \"audience\": audience,\n   107\t                    \"scope\": scope,\n   108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n   109\t                    \"actor_token\": ident.delegated_subject,\n   110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n   111\t                },\n   112\t            )\n   113\t            resp.raise_for_status()\n   114\t            body = resp.json()\n   115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n   116\t        self._cache[key] = token\n   117\t        return token.value\n=== app/ingest.py\n     1\t\"\"\"Inbound documents: vendor quotes and invoices from the mail gateway.\n     2\t\n     3\tThe mail gateway posts each received message to ``/ingest/mail`` signed with\n     4\tan HMAC over the timestamp and body. Accepted documents are stored per\n     5\tbusiness unit and are only ever shown to the model inside an\n     6\t``untrusted_document`` wrapper (tools/documents.py).\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport base64\n    11\timport email\n    12\timport email.policy\n    13\timport hashlib\n    14\timport hmac\n    15\timport io\n    16\timport re\n    17\timport time\n    18\timport uuid\n    19\tfrom dataclasses import dataclass\n    20\tfrom pathlib import Path\n    21\t\n    22\tfrom fastapi import APIRouter, HTTPException, Request\n    23\tfrom pypdf import PdfReader\n    24\t\n    25\trouter = APIRouter()\n    26\t\n    27\tMAX_BODY_BYTES = 10 * 1024 * 1024\n    28\tMAX_TEXT_CHARS = 200_000\n    29\tMAX_SKEW_SECONDS = 300\n    30\tALLOWED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\", \"message/rfc822\"}\n    31\tSCANNED_MEDIA_TYPES = {\"application/pdf\", \"text/plain\"}\n    32\t\n    33\tINJECTION_PATTERNS = [\n    34\t    re.compile(r\"(?i)ignore (all|any|the|previous|prior|above) (instructions|rules)\"),\n    35\t    re.compile(r\"(?i)\\b(system|developer) (prompt|message)\\b\"),\n    36\t    re.compile(r\"(?i)\\byou are (now )?(an?|the) \\w+ (agent|assistant)\\b\"),\n    37\t    re.compile(r\"(?i)\\b(call|use|invoke) (the )?(pay_invoice|erp_call|create_purchase_order|post_slack_message|memory_write)\\b\"),\n    38\t    re.compile(r\"(?i)\\b(update|change) (our|the) (bank|remit|payee)\\b\"),\n    39\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    40\t]\n    41\t\n    42\t\n    43\tclass Rejected(Exception):\n    44\t    pass\n    45\t\n    46\t\n    47\t@dataclass\n    48\tclass Inbound:\n    49\t    business_unit: str\n    50\t    sender: str\n    51\t    media_type: str\n    52\t    raw: bytes\n    53\t\n    54\t\n    55\tdef verify_signature(key: bytes, timestamp: str, body: bytes, signature: str) -> None:\n    56\t    try:\n    57\t        ts = int(timestamp)\n    58\t    except ValueError as exc:\n    59\t        raise Rejected(\"bad timestamp\") from exc\n    60\t    if abs(time.time() - ts) > MAX_SKEW_SECONDS:\n    61\t        raise Rejected(\"stale request\")\n    62\t    expected = hmac.new(key, f\"{timestamp}.\".encode() + body, hashlib.sha256).hexdigest()\n    63\t    if not hmac.compare_digest(expected, signature):\n    64\t        raise Rejected(\"bad signature\")\n    65\t\n    66\t\n    67\tdef extract_text(doc: Inbound) -> str:\n    68\t    if doc.media_type == \"application/pdf\":\n    69\t        reader = PdfReader(io.BytesIO(doc.raw))\n    70\t        if len(reader.pages) > 50:\n    71\t            raise Rejected(\"too many pages\")\n    72\t        return \"\\n\".join(page.extract_text() or \"\" for page in reader.pages)\n    73\t    if doc.media_type == \"message/rfc822\":\n    74\t        msg = email.message_from_bytes(doc.raw, policy=email.policy.default)\n    75\t        body = msg.get_body(preferencelist=(\"plain\", \"html\"))\n    76\t        return body.get_content() if body is not None else \"\"\n    77\t    return doc.raw.decode(\"utf-8\", errors=\"strict\")\n    78\t\n    79\t\n    80\tdef scan_for_injection(text: str) -> list[str]:\n    81\t    return [p.pattern for p in INJECTION_PATTERNS if p.search(text)]\n    82\t\n    83\t\n    84\tdef validate(doc: Inbound) -> str:\n    85\t    if doc.media_type not in ALLOWED_MEDIA_TYPES:\n    86\t        raise Rejected(f\"media type {doc.media_type} not accepted\")\n    87\t    if len(doc.raw) > MAX_BODY_BYTES:\n    88\t        raise Rejected(\"document too large\")\n    89\t    try:\n    90\t        text = extract_text(doc)\n    91\t    except Rejected:\n    92\t        raise\n    93\t    except Exception as exc:\n    94\t        raise Rejected(f\"unreadable document: {type(exc).__name__}\") from exc\n    95\t    if len(text) > MAX_TEXT_CHARS:\n    96\t        raise Rejected(\"extracted text too long\")\n    97\t    if doc.media_type in SCANNED_MEDIA_TYPES:\n    98\t        findings = scan_for_injection(text)\n    99\t        if findings:\n   100\t            raise Rejected(\"possible prompt injection: \" + \"; \".join(findings))\n   101\t    return text\n   102\t\n   103\t\n   104\t@router.post(\"/ingest/mail\")\n   105\tasync def ingest_mail(request: Request) -> dict:\n   106\t    body = await request.body()\n   107\t    if len(body) > MAX_BODY_BYTES * 2:\n   108\t        raise HTTPException(413, \"payload too large\")\n   109\t    key = Path(request.app.state.settings.mail_gateway_hmac_path).read_bytes().strip()\n   110\t    try:\n   111\t        verify_signature(\n   112\t            key,\n   113\t            request.headers.get(\"X-Gateway-Timestamp\", \"\"),\n   114\t            body,\n   115\t            request.headers.get(\"X-Gateway-Signature\", \"\"),\n   116\t        )\n   117\t    except Rejected as exc:\n   118\t        raise HTTPException(401, str(exc)) from exc\n   119\t\n   120\t    payload = await request.json()\n   121\t    doc = Inbound(\n   122\t        business_unit=payload[\"business_unit\"],\n   123\t        sender=payload[\"from\"],\n   124\t        media_type=payload[\"media_type\"],\n   125\t        raw=base64.b64decode(payload[\"content_b64\"], validate=True),\n   126\t    )\n   127\t    doc_id = f\"doc-{uuid.uuid4().hex[:20]}\"\n   128\t    pool = request.app.state.pool\n   129\t    try:\n   130\t        text = validate(doc)\n   131\t    except Rejected as exc:\n   132\t        await pool.execute(\n   133\t            \"\"\"\n   134\t            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)\n   135\t            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())\n   136\t            \"\"\",\n   137\t            doc_id, doc.business_unit, doc.sender, doc.media_type,\n   138\t            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],\n   139\t        )\n   140\t        return {\"doc_id\": doc_id, \"status\": \"quarantined\"}\n   141\t\n   142\t    await pool.execute(\n   143\t        \"\"\"\n   144\t        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)\n   145\t        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())\n   146\t        \"\"\",\n   147\t        doc_id, doc.business_unit, doc.sender, doc.media_type,\n   148\t        hashlib.sha256(doc.raw).hexdigest(), text,\n   149\t    )\n   150\t    return {\"doc_id\": doc_id, \"status\": \"accepted\"}\n=== app/killswitch.py\n     1\t\"\"\"Operator stop control.\n     2\t\n     3\tOperators halt the fleet or one business unit by setting a row in\n     4\t``control_flags`` with the ``procurement_ops`` database role (see\n     5\tops/README in the platform runbook). The agent's own database role has\n     6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\t\n    11\tclass AgentHalted(Exception):\n    12\t    pass\n    13\t\n    14\t\n    15\t_QUERY = \"\"\"\n    16\tSELECT scope, reason, set_by, set_at\n    17\tFROM control_flags\n    18\tWHERE halted\n    19\t  AND (scope = 'fleet' OR scope = $1)\n    20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n    21\tLIMIT 1\n    22\t\"\"\"\n    23\t\n    24\t\n    25\tasync def assert_running(pool, tenant: str) -> None:\n    26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n    27\t    if row is not None:\n    28\t        raise AgentHalted(\n    29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n    30\t            f\"(scope={row['scope']}): {row['reason']}\"\n    31\t        )\n=== app/loop.py\n     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n    47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n    48\t\n    49\t    def erp_scope_for(self, operation: str) -> str:\n    50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n    51\t        return scopes.get(operation, \"erp.read\")\n    52\t\n    53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n    54\t        self._contexts[ident.agent_instance_id] = ctx\n    55\t        proposed = await audit.record(\n    56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n    57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n    58\t        )\n    59\t        tool = registry.get(use.name)\n    60\t        if tool is None:\n    61\t            await audit.record(\n    62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n    63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n    64\t            )\n    65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   129\t        await budget.reserve_run_start(pool)\n   130\t        self.deps._budgets[ident.run_id] = budget\n   131\t        registry = build_registry(self.role, ident, self.deps)\n   132\t\n   133\t        run_node = await audit.record(\n   134\t            pool, ident, kind=\"run_started\",\n   135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n   136\t        )\n   137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n   138\t        try:\n   139\t            while True:\n   140\t                budget.check_step()\n   141\t                messages, compacted = _compact(messages)\n   142\t                request = {\n   143\t                    \"model\": self.deps.settings.model_id,\n   144\t                    \"system\": self.system_prompt,\n   145\t                    \"messages\": messages,\n   146\t                    \"tools\": registry.schemas(),\n   147\t                    \"max_tokens\": 4096,\n   148\t                }\n   149\t                ctx = await measure_context(self.client, request, compacted)\n   150\t                response = await self.client.messages.create(**request)\n   151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n   152\t                await budget.flush(pool)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n=== app/main.py\n     1\t\"\"\"FastAPI entry point for the procurement agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport hashlib\n     6\timport hmac\n     7\timport json\n     8\timport logging\n     9\timport time\n    10\timport uuid\n    11\tfrom contextlib import asynccontextmanager\n    12\tfrom pathlib import Path\n    13\tfrom urllib.parse import parse_qs\n    14\t\n    15\timport asyncpg\n    16\timport jwt\n    17\tfrom anthropic import AsyncAnthropic\n    18\tfrom fastapi import Depends, FastAPI, HTTPException, Request\n    19\tfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\n    20\tfrom opentelemetry import trace\n    21\tfrom pydantic import BaseModel, Field\n    22\t\n    23\tfrom app import audit, ingest\n    24\tfrom app.approvals import ApprovalStore, ApproverNotAuthorized\n    25\tfrom app.extractor import LineItemExtractor\n    26\tfrom app.gate import PolicyGate\n    27\tfrom app.identity import RunIdentity, TokenBroker, new_instance_id\n    28\tfrom app.loop import AgentDeps, ProcurementAgent\n    29\tfrom app.mcp_client import ErpMcpClient\n    30\tfrom app.redact import RedactingFilter\n    31\tfrom app.settings import get_settings\n    32\tfrom app.startup import startup_checks\n    33\tfrom app.tools.slack import SlackClient\n    34\t\n    35\tlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s %(message)s\")\n    36\tfor handler in logging.getLogger().handlers:\n    37\t    handler.addFilter(RedactingFilter())\n    38\tlog = logging.getLogger(\"procurement\")\n    39\t\n    40\tAGENT_PRINCIPAL = \"spiffe://example-corp.test/ns/procurement-prod/sa/procurement-agent\"\n    41\tbearer = HTTPBearer()\n    42\t\n    43\t\n    44\tclass RunRequest(BaseModel):\n    45\t    task: str = Field(min_length=1, max_length=4000)\n    46\t    department: str = Field(min_length=1, max_length=64)\n    47\t\n    48\t\n    49\tclass Principal(BaseModel):\n    50\t    subject: str\n    51\t    business_unit: str\n    52\t\n    53\t\n    54\tdef service_identity(settings, agent_type_id: str, tenant: str = \"system\") -> RunIdentity:\n    55\t    return RunIdentity(\n    56\t        accountable_party=\"system:procurement-agent\",\n    57\t        operational_owner=settings.operational_owner,\n    58\t        tenant=tenant,\n    59\t        agent_type_id=agent_type_id,\n    60\t        agent_instance_id=new_instance_id(),\n    61\t        trace_id=uuid.uuid4().hex,\n    62\t        run_id=f\"bg-{uuid.uuid4()}\",\n    63\t        delegated_subject=\"system:procurement-agent\",\n    64\t        agent_principal=AGENT_PRINCIPAL,\n    65\t    )\n    66\t\n    67\t\n    68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n    69\t    while True:\n    70\t        await asyncio.sleep(60)\n    71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n    72\t        count = await app.state.pool.fetchval(\n    73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n    74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n    75\t        )\n    76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n    77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n    78\t\n    79\t\n    80\t@asynccontextmanager\n    81\tasync def lifespan(app: FastAPI):\n    82\t    settings = get_settings()\n    83\t    agent_type_id = startup_checks(settings)\n    84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    85\t    broker = TokenBroker(settings)\n    86\t\n    87\t    async def slack_token() -> str:\n    88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n    89\t\n    90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n    91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n    92\t    gate = PolicyGate(settings.policy, approvals)\n    93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    94\t    await erp.initialize(service_identity(settings, agent_type_id))\n    95\t\n    96\t    client = AsyncAnthropic()\n    97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    98\t    deps.extractor = LineItemExtractor(\n    99\t        client=client, settings=settings, deps=deps,\n   100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n   101\t    )\n   102\t    app.state.settings = settings\n   103\t    app.state.pool = pool\n   104\t    app.state.agent_type_id = agent_type_id\n   105\t    app.state.approvals = approvals\n   106\t    app.state.agent = ProcurementAgent(\n   107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n   108\t    )\n   109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n   110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n   111\t    try:\n   112\t        yield\n   113\t    finally:\n   114\t        sweeper.cancel()\n   115\t        await pool.close()\n   116\t\n   117\t\n   118\tapp = FastAPI(lifespan=lifespan)\n   119\tapp.include_router(ingest.router)\n   120\t\n   121\t\n   122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n   123\t    settings = request.app.state.settings\n   124\t    try:\n   125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n   126\t        claims = jwt.decode(\n   127\t            creds.credentials,\n   128\t            key.key,\n   129\t            algorithms=[\"RS256\", \"ES256\"],\n   130\t            audience=settings.oidc_audience,\n   131\t            issuer=settings.oidc_issuer,\n   132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n   133\t        )\n   134\t    except jwt.PyJWTError as exc:\n   135\t        raise HTTPException(401, \"invalid token\") from exc\n   136\t    bu = claims.get(\"bu\")\n   137\t    if not bu:\n   138\t        raise HTTPException(403, \"token has no business unit\")\n   139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n   140\t\n   141\t\n   142\t@app.post(\"/runs\")\n   143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n   144\t    settings = request.app.state.settings\n   145\t    span_ctx = trace.get_current_span().get_span_context()\n   146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n   147\t    ident = RunIdentity(\n   148\t        accountable_party=principal.subject,\n   149\t        operational_owner=settings.operational_owner,\n   150\t        tenant=principal.business_unit,\n   151\t        agent_type_id=request.app.state.agent_type_id,\n   152\t        agent_instance_id=new_instance_id(),\n   153\t        trace_id=trace_id,\n   154\t        run_id=f\"run-{uuid.uuid4()}\",\n   155\t        delegated_subject=principal.subject,\n   156\t        agent_principal=AGENT_PRINCIPAL,\n   157\t    )\n   158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n   159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n   160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n   161\t\n   162\t\n   163\t@app.post(\"/slack/interactions\")\n   164\tasync def slack_interactions(request: Request) -> dict:\n   165\t    body = await request.body()\n   166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n   167\t    if abs(time.time() - int(timestamp)) > 300:\n   168\t        raise HTTPException(401, \"stale request\")\n   169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n   170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n   171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n   172\t        raise HTTPException(401, \"bad signature\")\n   173\t\n   174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n   175\t    action = payload[\"actions\"][0]\n   176\t    slack_user = payload[\"user\"][\"id\"]\n   177\t    row = await request.app.state.pool.fetchrow(\n   178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n   179\t    )\n   180\t    if row is None:\n   181\t        raise HTTPException(403, \"not an approver\")\n   182\t    try:\n   183\t        await request.app.state.approvals.decide(\n   184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n   185\t            approve=action[\"action_id\"] == \"approve\",\n   186\t        )\n   187\t    except ApproverNotAuthorized as exc:\n   188\t        raise HTTPException(403, str(exc)) from exc\n   189\t    except ValueError as exc:\n   190\t        raise HTTPException(409, str(exc)) from exc\n   191\t    return {\"ok\": True}\n   192\t\n   193\t\n   194\t@app.get(\"/healthz\")\n   195\tasync def healthz() -> dict:\n   196\t    return {\"ok\": True}\n=== app/mcp_client.py\n     1\t\"\"\"Client for the ERP MCP server, reached through the internal MCP gateway.\n     2\t\n     3\tOn startup the tool list is fetched and each tool's description and input\n     4\tschema are fingerprinted and compared with the pins in the release manifest.\n     5\tAny unpinned or changed tool stops startup. Tool metadata is also scanned for\n     6\tinstruction-like content before any of it is shown to the model.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport json\n    12\timport logging\n    13\timport re\n    14\timport uuid\n    15\tfrom typing import Any\n    16\t\n    17\timport httpx\n    18\t\n    19\tfrom app.identity import RunIdentity, TokenBroker\n    20\tfrom app.redact import redact_text\n    21\t\n    22\tlog = logging.getLogger(__name__)\n    23\t\n    24\tMAX_DESCRIPTION_CHARS = 1024\n    25\tSUSPICIOUS_METADATA = [\n    26\t    re.compile(r\"(?i)ignore (all|any|previous|prior) instructions\"),\n    27\t    re.compile(r\"(?i)\\b(system prompt|you are now|act as)\\b\"),\n    28\t    re.compile(r\"(?i)\\b(before|instead of) (calling|using) \\w+\\.\\w+\"),\n    29\t    re.compile(r\"[​-‏‪-‮⁠-⁤]\"),\n    30\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    31\t]\n    32\t\n    33\t\n    34\tclass ToolPinMismatch(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass UnknownErpOperation(Exception):\n    39\t    pass\n    40\t\n    41\t\n    42\tdef fingerprint(tool: dict[str, Any]) -> str:\n    43\t    material = {\n    44\t        \"name\": tool[\"name\"],\n    45\t        \"description\": tool.get(\"description\", \"\"),\n    46\t        \"inputSchema\": tool.get(\"inputSchema\", {}),\n    47\t        \"annotations\": tool.get(\"annotations\", {}),\n    48\t    }\n    49\t    raw = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    50\t    return \"sha256:\" + hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    51\t\n    52\t\n    53\tdef scan_metadata(tool: dict[str, Any]) -> None:\n    54\t    description = tool.get(\"description\", \"\")\n    55\t    if len(description) > MAX_DESCRIPTION_CHARS:\n    56\t        raise ToolPinMismatch(f\"{tool['name']}: description too long\")\n    57\t    blob = json.dumps(tool, ensure_ascii=False)\n    58\t    for pattern in SUSPICIOUS_METADATA:\n    59\t        if pattern.search(blob):\n    60\t            raise ToolPinMismatch(f\"{tool['name']}: suspicious metadata ({pattern.pattern})\")\n    61\t\n    62\t\n    63\tclass ErpMcpClient:\n    64\t    AUDIENCE = \"erp-mcp-gateway\"\n    65\t\n    66\t    def __init__(self, url: str, pins: dict[str, str], broker: TokenBroker):\n    67\t        self.url = url\n    68\t        self.pins = pins\n    69\t        self.broker = broker\n    70\t        self._tools: dict[str, dict[str, Any]] = {}\n    71\t\n    72\t    async def _rpc(self, method: str, params: dict[str, Any], token: str) -> dict[str, Any]:\n    73\t        async with httpx.AsyncClient(timeout=20.0, follow_redirects=False) as client:\n    74\t            resp = await client.post(\n    75\t                self.url,\n    76\t                json={\"jsonrpc\": \"2.0\", \"id\": str(uuid.uuid4()), \"method\": method, \"params\": params},\n    77\t                headers={\"Authorization\": f\"Bearer {token}\", \"Mcp-Protocol-Version\": \"2025-06-18\"},\n    78\t            )\n    79\t        resp.raise_for_status()\n    80\t        if len(resp.content) > 512_000:\n    81\t            raise ValueError(\"erp response too large\")\n    82\t        body = resp.json()\n    83\t        if \"error\" in body:\n    84\t            raise RuntimeError(f\"erp error {body['error'].get('code')}: {redact_text(str(body['error'].get('message')))}\")\n    85\t        return body[\"result\"]\n    86\t\n    87\t    async def _list_tools(self, token: str) -> list[dict[str, Any]]:\n    88\t        result = await self._rpc(\"tools/list\", {}, token)\n    89\t        return list(result.get(\"tools\", []))\n    90\t\n    91\t    async def initialize(self, service_ident: RunIdentity) -> None:\n    92\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n    93\t        tools = await self._list_tools(token)\n    94\t        for tool in tools:\n    95\t            expected = self.pins.get(tool[\"name\"])\n    96\t            actual = fingerprint(tool)\n    97\t            if expected != actual:\n    98\t                raise ToolPinMismatch(f\"{tool['name']}: expected {expected}, got {actual}\")\n    99\t            scan_metadata(tool)\n   100\t        self._tools = {t[\"name\"]: t for t in tools}\n   101\t        log.info(\"erp tools loaded: %d\", len(self._tools))\n   102\t\n   103\t    async def on_notification(self, message: dict[str, Any], service_ident: RunIdentity) -> None:\n   104\t        if message.get(\"method\") == \"notifications/tools/list_changed\":\n   105\t            await self.refresh_tools(service_ident)\n   106\t\n   107\t    async def refresh_tools(self, service_ident: RunIdentity) -> None:\n   108\t        token = await self.broker.token_for(self.AUDIENCE, \"erp.tools.list\", service_ident)\n   109\t        tools = await self._list_tools(token)\n   110\t        self._tools = {t[\"name\"]: t for t in tools}\n   111\t        log.info(\"erp tools refreshed: %d\", len(self._tools))\n   112\t\n   113\t    def operations(self) -> list[str]:\n   114\t        return sorted(self._tools)\n   115\t\n   116\t    async def call(self, operation: str, arguments: dict[str, Any], ident: RunIdentity, scope: str) -> Any:\n   117\t        if operation not in self._tools:\n   118\t            raise UnknownErpOperation(operation)\n   119\t        token = await self.broker.token_for(self.AUDIENCE, scope, ident)\n   120\t        result = await self._rpc(\n   121\t            \"tools/call\",\n   122\t            {\n   123\t                \"name\": operation,\n   124\t                \"arguments\": arguments,\n   125\t                \"_meta\": {\"business_unit\": ident.tenant, \"run_id\": ident.run_id},\n   126\t            },\n   127\t            token,\n   128\t        )\n   129\t        if result.get(\"isError\"):\n   130\t            raise RuntimeError(redact_text(json.dumps(result.get(\"content\", []))))\n   131\t        return result.get(\"structuredContent\") or result.get(\"content\")\n=== app/redact.py\n     1\t\"\"\"Redaction for model input, logs, audit payloads, and outbound messages.\n     2\t\n     3\tApplied in four places:\n     4\t  * tool results before they are appended to the model context (loop.py)\n     5\t  * every audit payload (audit.py)\n     6\t  * the root logging filter (main.py)\n     7\t  * outbound Slack text (tools/slack.py)\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport logging\n    12\timport re\n    13\tfrom typing import Any\n    14\tfrom urllib.parse import urlparse\n    15\t\n    16\tSECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n    17\t    (\"bearer\", re.compile(r\"(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]{16,}\")),\n    18\t    (\"jwt\", re.compile(r\"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b\")),\n    19\t    (\"acct_token\", re.compile(r\"\\bacct_tok_[A-Za-z0-9_]{8,}\\b\")),\n    20\t    (\"pay_token\", re.compile(r\"\\bpay_tok_[A-Za-z0-9_]{8,}\\b\")),\n    21\t    (\"erp_session\", re.compile(r\"\\berp_sess_[A-Za-z0-9_]{8,}\\b\")),\n    22\t    (\"password_kv\", re.compile(r\"(?i)\\b(password|passwd|secret|api[_-]?key)\\s*[:=]\\s*\\S+\")),\n    23\t]\n    24\t\n    25\t# Bank details: keep the last four characters so staff can still match records.\n    26\tACCOUNT_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n    27\t    (\"iban\", re.compile(r\"\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b\")),\n    28\t    (\"account_no\", re.compile(r\"(?i)\\b(account|acct|routing)\\s*(no\\.?|number|#)?\\s*[:#]?\\s*(\\d[\\d -]{6,}\\d)\")),\n    29\t]\n    30\t\n    31\tMARKDOWN_IMAGE = re.compile(r\"!\\[[^\\]]*\\]\\(([^)\\s]+)[^)]*\\)\")\n    32\tMARKDOWN_LINK = re.compile(r\"(?<!!)\\[([^\\]]*)\\]\\(([^)\\s]+)[^)]*\\)\")\n    33\tSLACK_LINK = re.compile(r\"<(https?://[^|>]+)(\\|[^>]*)?>\")\n    34\tBARE_URL = re.compile(r\"https?://[^\\s<>()]+\")\n    35\t\n    36\tAPPROVED_LINK_HOSTS = frozenset({\"erp.example-corp.test\", \"intranet.example-corp.test\"})\n    37\t\n    38\t\n    39\tdef _mask_tail(match: re.Match[str]) -> str:\n    40\t    text = match.group(0)\n    41\t    return \"[REDACTED:\" + \"*\" * 4 + text[-4:] + \"]\"\n    42\t\n    43\t\n    44\tdef redact_text(text: str) -> str:\n    45\t    for name, pattern in SECRET_PATTERNS:\n    46\t        text = pattern.sub(f\"[REDACTED:{name}]\", text)\n    47\t    for _name, pattern in ACCOUNT_PATTERNS:\n    48\t        text = pattern.sub(_mask_tail, text)\n    49\t    return text\n    50\t\n    51\t\n    52\tdef redact_value(value: Any) -> Any:\n    53\t    if isinstance(value, str):\n    54\t        return redact_text(value)\n    55\t    if isinstance(value, dict):\n    56\t        return {k: redact_value(v) for k, v in value.items()}\n    57\t    if isinstance(value, (list, tuple)):\n    58\t        return [redact_value(v) for v in value]\n    59\t    return value\n    60\t\n    61\t\n    62\tdef redact_for_model(value: Any) -> str:\n    63\t    if not isinstance(value, str):\n    64\t        import json\n    65\t\n    66\t        value = json.dumps(value, default=str)\n    67\t    return redact_text(value)\n    68\t\n    69\t\n    70\tdef _host_ok(url: str) -> bool:\n    71\t    host = (urlparse(url).hostname or \"\").lower()\n    72\t    return host in APPROVED_LINK_HOSTS\n    73\t\n    74\t\n    75\tdef strip_unapproved_links(text: str) -> str:\n    76\t    \"\"\"Remove images entirely and drop links to hosts outside the allowlist.\n    77\t\n    78\t    Slack and most chat clients fetch link and image URLs to render previews,\n    79\t    so an attacker-chosen URL can carry data out without any tool call.\n    80\t    \"\"\"\n    81\t    text = MARKDOWN_IMAGE.sub(\"[image removed]\", text)\n    82\t    text = MARKDOWN_LINK.sub(\n    83\t        lambda m: m.group(0) if _host_ok(m.group(2)) else m.group(1), text\n    84\t    )\n    85\t    text = SLACK_LINK.sub(\n    86\t        lambda m: m.group(0) if _host_ok(m.group(1)) else \"[link removed]\", text\n    87\t    )\n    88\t    text = BARE_URL.sub(\n    89\t        lambda m: m.group(0) if _host_ok(m.group(0)) else \"[link removed]\", text\n    90\t    )\n    91\t    return text\n    92\t\n    93\t\n    94\tclass RedactingFilter(logging.Filter):\n    95\t    def filter(self, record: logging.LogRecord) -> bool:\n    96\t        if isinstance(record.msg, str):\n    97\t            record.msg = redact_text(record.msg)\n    98\t        if record.args:\n    99\t            record.args = tuple(redact_value(a) for a in record.args)\n   100\t        return True\n=== app/settings.py\n     1\t\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport os\n     5\tfrom dataclasses import dataclass\n     6\tfrom functools import lru_cache\n     7\tfrom pathlib import Path\n     8\t\n     9\timport yaml\n    10\t\n    11\t\n    12\tdef _env(name: str, default: str | None = None) -> str:\n    13\t    value = os.environ.get(name, default)\n    14\t    if value is None:\n    15\t        raise RuntimeError(f\"missing required setting {name}\")\n    16\t    return value\n    17\t\n    18\t\n    19\t@dataclass(frozen=True)\n    20\tclass Settings:\n    21\t    database_url: str\n    22\t    erp_mcp_url: str\n    23\t    payments_api_url: str\n    24\t    slack_api_url: str\n    25\t    sts_url: str\n    26\t    oidc_issuer: str\n    27\t    oidc_audience: str\n    28\t    oidc_jwks_url: str\n    29\t    workload_token_path: str\n    30\t    slack_signing_secret_path: str\n    31\t    mail_gateway_hmac_path: str\n    32\t    model_id: str\n    33\t    extractor_model_id: str\n    34\t    manifest_path: Path\n    35\t    prompt_dir: Path\n    36\t    policy_path: Path\n    37\t    tools_path: Path\n    38\t    operational_owner: str\n    39\t    image_digest: str\n    40\t\n    41\t    @property\n    42\t    def policy(self) -> dict:\n    43\t        return _load_yaml(self.policy_path)\n    44\t\n    45\t    @property\n    46\t    def manifest(self) -> dict:\n    47\t        return _load_yaml(self.manifest_path)\n    48\t\n    49\t    @property\n    50\t    def budgets(self) -> dict:\n    51\t        return self.policy[\"budgets\"]\n    52\t\n    53\t\n    54\tdef _load_yaml(path: Path) -> dict:\n    55\t    with open(path, \"r\", encoding=\"utf-8\") as fh:\n    56\t        return yaml.safe_load(fh)\n    57\t","numLines":1000,"startLine":700,"totalLines":2317}}}
