\t    66\t            - name: OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT\n162\t    67\t              value: \"false\"\n163\t    68\t          securityContext:\n164\t    69\t            allowPrivilegeEscalation: false\n165\t    70\t            privileged: false\n166\t    71\t            readOnlyRootFilesystem: true\n167\t    72\t            runAsNonRoot: true\n168\t    73\t            capabilities:\n169\t    74\t              drop: [\"ALL\"]\n170\t    75\t            seccompProfile:\n171\t    76\t              type: RuntimeDefault\n172\t    77\t          resources:\n173\t    78\t            requests:\n174\t    79\t              cpu: 250m\n175\t    80\t              memory: 512Mi\n176\t    81\t            limits:\n177\t    82\t              cpu: \"1\"\n178\t    83\t              memory: 1Gi\n179\t    84\t          readinessProbe:\n180\t    85\t            httpGet:\n181\t    86\t              path: /healthz\n182\t    87\t              port: http\n183\t    88\t          volumeMounts:\n184\t    89\t            - name: workload-token\n185\t    90\t              mountPath: /var/run/secrets/tokens\n186\t    91\t              readOnly: true\n187\t    92\t            - name: slack-signing\n188\t    93\t              mountPath: /var/run/secrets/slack\n189\t    94\t              readOnly: true\n190\t    95\t            - name: mail-hmac\n191\t    96\t              mountPath: /var/run/secrets/mail\n192\t    97\t              readOnly: true\n193\t    98\t            - name: tmp\n194\t    99\t              mountPath: /tmp\n195\t   100\t      volumes:\n196\t   101\t        - name: workload-token\n197\t   102\t          projected:\n198\t   103\t            sources:\n199\t   104\t              - serviceAccountToken:\n200\t   105\t                  path: procurement-agent\n201\t   106\t                  audience: sts.identity.example-corp.test\n202\t   107\t                  expirationSeconds: 600\n203\t   108\t        - name: slack-signing\n204\t   109\t          secret:\n205