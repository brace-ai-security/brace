{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GctqcYtWfGzuXgK1q7mL7A","type":"tool_result","content":"\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n\nThe agent runs under its own Kubernetes service account. Its projected\nservice-account token is exchanged at the internal STS for short-lived,\naudience-bound tokens. The launching user's token is never forwarded to an\nintegration; the user is carried as the delegated subject of the exchange.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport time\nimport uuid\nfrom dataclasses import dataclass, field, replace\nfrom pathlib import Path\n\nimport httpx\n\nfrom app.settings import Settings\n\nIDENTITY_FIELDS = (\n    \"accountable_party\",\n    \"operational_owner\",\n    \"tenant\",\n    \"agent_type_id\",\n    \"agent_instance_id\",\n    \"trace_id\",\n)\n\n\n@dataclass(frozen=True)\nclass RunIdentity:\n    accountable_party: str\n    operational_owner: str\n    tenant: str\n    agent_type_id: str\n    agent_instance_id: str\n    trace_id: str\n    run_id: str\n    delegated_subject: str\n    agent_principal: str\n    parent_instance_id: str | None = None\n    role: str = \"procurement\"\n\n    def __post_init__(self) -> None:\n        for name in IDENTITY_FIELDS:\n            if not getattr(self, name):\n                raise ValueError(f\"identity field {name} is empty\")\n\n    def child(self, role: str) -> \"RunIdentity\":\n        return replace(\n            self,\n            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n            parent_instance_id=self.agent_instance_id,\n            role=role,\n        )\n\n\ndef new_instance_id() -> str:\n    return f\"inst-{uuid.uuid4()}\"\n\n\ndef compute_agent_type_id(manifest: dict) -> str:\n    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    material = {\n        \"image_digest\": manifest[\"image\"][\"digest\"],\n        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n        \"models\": manifest[\"models\"],\n        \"config\": manifest[\"config\"],\n        \"tools\": manifest[\"tool_pins\"],\n    }\n    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n\n\n@dataclass\nclass _CachedToken:\n    value: str\n    expires_at: float\n\n\n@dataclass\nclass TokenBroker:\n    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n\n    settings: Settings\n    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n\n    def _workload_token(self) -> str:\n        return Path(self.settings.workload_token_path).read_text().strip()\n\n    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n        key = (audience, scope, ident.tenant)\n        cached = self._cache.get(key)\n        if cached and cached.expires_at - 30 > time.time():\n            return cached.value\n        async with httpx.AsyncClient(timeout=5.0) as client:\n            resp = await client.post(\n                self.settings.sts_url,\n                data={\n                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n                    \"subject_token\": self._workload_token(),\n                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n                    \"audience\": audience,\n                    \"scope\": scope,\n                    \"resource\": f\"urn:bu:{ident.tenant}\",\n                    \"actor_token\": ident.delegated_subject,\n                    \"actor_token_type\": \"urn:example:params:subject-id\",\n                },\n            )\n            resp.raise_for_status()\n            body = resp.json()\n        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n        self._cache[key] = token\n        return token.value\napp/audit.py:63:    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\napp/redact.py:16:SECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\napp/redact.py:22:    (\"password_kv\", re.compile(r\"(?i)\\b(password|passwd|secret|api[_-]?key)\\s*[:=]\\s*\\S+\")),\napp/redact.py:45:    for name, pattern in SECRET_PATTERNS:\napp/settings.py:22:    erp_mcp_url: str\napp/settings.py:30:    slack_signing_secret_path: str\napp/settings.py:64:        erp_mcp_url=_env(\"ERP_MCP_URL\"),\napp/settings.py:72:            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\napp/settings.py:74:        slack_signing_secret_path=_env(\napp/settings.py:75:            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\napp/settings.py:78:            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\napp/main.py:29:from app.mcp_client import ErpMcpClient\napp/main.py:93:    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\napp/main.py:169:    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\napp/main.py:170:    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\ndeploy/k8s/deployment.yaml:46:            - name: ERP_MCP_URL\ndeploy/k8s/deployment.yaml:47:              value: \"https://erp-mcp-gateway.erp-mcp-gateway.svc.cluster.local:8443/mcp\"\ndeploy/k8s/deployment.yaml:90:              mountPath: /var/run/secrets/tokens\ndeploy/k8s/deployment.yaml:93:              mountPath: /var/run/secrets/slack\ndeploy/k8s/deployment.yaml:96:              mountPath: /var/run/secrets/mail\ndeploy/k8s/deployment.yaml:109:          secret:\ndeploy/k8s/deployment.yaml:110:            secretName: procurement-slack-signing\ndeploy/k8s/deployment.yaml:112:          se