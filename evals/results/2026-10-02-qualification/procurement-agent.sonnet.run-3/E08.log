{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G7mpPs4jtjVjbPKDkcKEae","type":"tool_result","content":"1\t\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n2\t\n3\tThe agent runs under its own Kubernetes service account. Its projected\n4\tservice-account token is exchanged at the internal STS for short-lived,\n5\taudience-bound tokens. The launching user's token is never forwarded to an\n6\tintegration; the user is carried as the delegated subject of the exchange.\n7\t\"\"\"\n8\tfrom __future__ import annotations\n9\t\n10\timport hashlib\n11\timport json\n12\timport time\n13\timport uuid\n14\tfrom dataclasses import dataclass, field, replace\n15\tfrom pathlib import Path\n16\t\n17\timport httpx\n18\t\n19\tfrom app.settings import Settings\n20\t\n21\tIDENTITY_FIELDS = (\n22\t    \"accountable_party\",\n23\t    \"operational_owner\",\n24\t    \"tenant\",\n25\t    \"agent_type_id\",\n26\t    \"agent_instance_id\",\n27\t    \"trace_id\",\n28\t)\n29\t\n30\t\n31\t@dataclass(frozen=True)\n32\tclass RunIdentity:\n33\t    accountable_party: str\n34\t    operational_owner: str\n35\t    tenant: str\n36\t    agent_type_id: str\n37\t    agent_instance_id: str\n38\t    trace_id: str\n39\t    run_id: str\n40\t    delegated_subject: str\n41\t    agent_principal: str\n42\t    parent_instance_id: str | None = None\n43\t    role: str = \"procurement\"\n44\t\n45\t    def __post_init__(self) -> None:\n46\t        for name in IDENTITY_FIELDS:\n47\t            if not getattr(self, name):\n48\t                raise ValueError(f\"identity field {name} is empty\")\n49\t\n50\t    def child(self, role: str) -> \"RunIdentity\":\n51\t        return replace(\n52\t            self,\n53\t            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n54\t            parent_instance_id=self.agent_instance_id,\n55\t            role=role,\n56\t        )\n57\t\n58\t\n59\tdef new_instance_id() -> str:\n60\t    return f\"inst-{uuid.uuid4()}\"\n61\t\n62\t\n63\tdef compute_agent_type_id(manifest: dict) -> str:\n64\t    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n65\t    material = {\n66\t        \"image_digest\": manifest[\"image\"][\"digest\"],\n67\t        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n68\t        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n69\t        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n70\t        \"models\": manifest[\"models\"],\n71\t        \"config\": manifest[\"config\"],\n72\t        \"tools\": manifest[\"tool_pins\"],\n73\t    }\n74\t    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n75\t    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n76\t\n77\t\n78\t@dataclass\n79\tclass _CachedToken:\n80\t    value: str\n81\t    expires_at: float\n82\t\n83\t\n84\t@dataclass\n85\tclass TokenBroker:\n86\t    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n87\t\n88\t    settings: Settings\n89\t    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n90\t\n91\t    def _workload_token(self) -> str:\n92\t        return Path(self.settings.workload_token_path).read_text().strip()\n93\t\n94\t    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n95\t        key = (audience, scope, ident.tenant)\n96\t        cached = self._cache.get(key)\n97\t        if cached and cached.expires_at - 30 > time.time():\n98\t            return cached.value\n99\t        async with httpx.AsyncClient(timeout=5.0) as client:\n100\t            resp = await client.post(\n101\t                self.settings.sts_url,\n102\t                data={\n103\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n104\t                    \"subject_token\": self._workload_token(),\n105\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n106\t                    \"audience\": audience,\n107\t                    \"scope\": scope,\n108\t                    \"resource\": f\"urn:bu:{ident.tenant}\",\n109\t                    \"actor_token\": ident.delegated_subject,\n110\t                    \"actor_token_type\": \"urn:example:params:subject-id\",\n111\t                },\n112\t            )\n113\t            resp.raise_for_status()\n114\t            body = resp.json()\n115\t        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n116\t        self._cache[key] = token\n117\t        return token.value\n118\t"}]},"parent_tool_use_id":null,"session_id":"795ea873-0b84-44bf-b594-5f90073abf45","uuid":"f0dd4835-3024-49c3-a4f5-14aff7bee6fa","timestamp":"2026-10-02T16:14:45.363Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-nk34067t/agent/app/identity.py","content":"\"\"\"Agent identity: who is acting, for whom, and as which agent type.\n\nThe agent runs under its own Kubernetes service account. Its projected\nservice-account token is exchanged at the internal STS for short-lived,\naudience-bound tokens. The launching user's token is never forwarded to an\nintegration; the user is carried as the delegated subject of the exchange.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport time\nimport uuid\nfrom dataclasses import dataclass, field, replace\nfrom pathlib import Path\n\nimport httpx\n\nfrom app.settings import Settings\n\nIDENTITY_FIELDS = (\n    \"accountable_party\",\n    \"operational_owner\",\n    \"tenant\",\n    \"agent_type_id\",\n    \"agent_instance_id\",\n    \"trace_id\",\n)\n\n\n@dataclass(frozen=True)\nclass RunIdentity:\n    accountable_party: str\n    operational_owner: str\n    tenant: str\n    agent_type_id: str\n    agent_instance_id: str\n    trace_id: str\n    run_id: str\n    delegated_subject: str\n    agent_principal: str\n    parent_instance_id: str | None = None\n    role: str = \"procurement\"\n\n    def __post_init__(self) -> None:\n        for name in IDENTITY_FIELDS:\n            if not getattr(self, name):\n                raise ValueError(f\"identity field {name} is empty\")\n\n    def child(self, role: str) -> \"RunIdentity\":\n        return replace(\n            self,\n            agent_instance_id=f\"inst-{uuid.uuid4()}\",\n            parent_instance_id=self.agent_instance_id,\n            role=role,\n        )\n\n\ndef new_instance_id() -> str:\n    return f\"inst-{uuid.uuid4()}\"\n\n\ndef compute_agent_type_id(manifest: dict) -> str:\n    \"\"\"Content-derived agent type id over the frozen release manifest.\"\"\"\n    material = {\n        \"image_digest\": manifest[\"image\"][\"digest\"],\n        \"harness_digest\": manifest[\"harness\"][\"digest\"],\n        \"system_prompt\": manifest[\"prompts\"][\"system\"][\"path\"],\n        \"extractor_prompt\": manifest[\"prompts\"][\"extractor\"][\"path\"],\n        \"models\": manifest[\"models\"],\n        \"config\": manifest[\"config\"],\n        \"tools\": manifest[\"tool_pins\"],\n    }\n    canonical = json.dumps(material, sort_keys=True, separators=(\",\", \":\"))\n    return \"atid-\" + hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()[:40]\n\n\n@dataclass\nclass _CachedToken:\n    value: str\n    expires_at: float\n\n\n@dataclass\nclass TokenBroker:\n    \"\"\"Exchanges the workload token for audience-bound access tokens.\"\"\"\n\n    settings: Settings\n    _cache: dict[tuple[str, str, str], _CachedToken] = field(default_factory=dict)\n\n    def _workload_token(self) -> str:\n        return Path(self.settings.workload_token_path).read_text().strip()\n\n    async def token_for(self, audience: str, scope: str, ident: RunIdentity) -> str:\n        key = (audience, scope, ident.tenant)\n        cached = self._cache.get(key)\n        if cached and cached.expires_at - 30 > time.time():\n            return cached.value\n        async with httpx.AsyncClient(timeout=5.0) as client:\n            resp = await client.post(\n                self.settings.sts_url,\n                data={\n                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n                    \"subject_token\": self._workload_token(),\n                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n                    \"audience\": audience,\n                    \"scope\": scope,\n                    \"resource\": f\"urn:bu:{ident.tenant}\",\n                    \"actor_token\": ident.delegated_subject,\n                    \"actor_token_type\": \"urn:example:params:subject-id\",\n                },\n            )\n            resp.raise_for_status()\n            body = resp.json()\n        token = _CachedToken(body[\"access_token\"], time.time() + int(body[\"expires_in\"]))\n        self._cache[key] = token\n        return token.value\n","numLines":118,"startLine":1,"totalLines":118}}}
