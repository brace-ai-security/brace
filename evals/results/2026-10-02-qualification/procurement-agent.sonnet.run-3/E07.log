z\")\n   195\tasync def healthz() -> dict:\n   196\t    return {\"ok\": True}\n./migrations/001_init.sql:17:    delegated_subject   text NOT NULL,\n./migrations/001_init.sql:41:    delegated_subject      text NOT NULL,\n./migrations/001_init.sql:86:    delegated_subject  text NOT NULL,\n./app/tools/memory.py:82:                delegated_subject, context_tokens, context_method, created_at\n./app/tools/memory.py:95:            ident.delegated_subject,\n./app/audit.py:36:    \"subagent_started\",\n./app/audit.py:37:    \"subagent_finished\",\n./app/audit.py:46:    delegated_subject, agent_principal, parent_instance_id,\n./app/audit.py:107:        ident.delegated_subject,\n./app/approvals.py:5:interactive callback is signature-checked in main.py and then calls\n./app/approvals.py:46:                requested_by_instance, requested_by_run, delegated_subject,\n./app/approvals.py:58:            ident.delegated_subject,\n./app/budget.py:4:number of sub-agents. Sub-agents charge the parent's budget, so a child\n./app/budget.py:44:    max_subagents: int\n./app/budget.py:52:    subagents: int = 0\n./app/budget.py:65:            max_subagents=int(run[\"max_subagents\"]),\n./app/budget.py:114:    def check_subagent(self) -> None:\n./app/budget.py:115:        if self.subagents >= self.max_subagents:\n./app/budget.py:116:            raise BudgetExceeded(\"max_subagents\", self.subagents + 1, self.max_subagents)\n./app/budget.py:117:        self.subagents += 1\n./app/extractor.py:1:\"\"\"Line-item extraction sub-agent.\n./app/extractor.py:3:The parent procurement agent delegates structured extraction to a smaller\n./app/extractor.py:43:        budget.check_subagent()\n./app/extractor.py:54:                kind=\"subagent_started\",\n./app/extractor.py:89:                        self.deps.pool, ident, kind=\"subagent_finished\", parent=start_node,\n./app/identity.py:6:integration; the user is carried as the delegated subject of the exchange.\n./app/identity.py:40:    delegated_subject: str\n./app/identity.py:109:                    \"actor_token\": ident.delegated_subject,\n./config/policy.yaml:45:    max_subagents: 3\n./config/tools.yaml:6:      extract_line_items: \"Delegate line-item extraction from long documents to the extractor.\"\n./deploy/k8s/kyverno-verify-images.yaml:11:  webhookTimeoutSeconds: 15\n./tests/test_budget.py:16:        \"max_subagents\": 1,\n./tests/test_budget.py:32:        delegated_subject=\"user:alice@example-corp.test\",\n./tests/test_budget.py:84:def test_subagent_limit():\n./tests/test_budget.py:86:    b.check_subagent()\n./tests/test_budget.py:88:        b.check_subagent()\n./tests/test_budget.py:89:    assert exc.value.limit == \"max_subagents\"\n./release/manifest.yaml:30:    sha256: \"sha256:d6a55f1e170bdd457958243ddd9aa938f4ca707a3e1e9d1e7bca2a54df33ad32\"\n./release/manifest.yaml:51:    role: \"line-item extraction sub-agent\"\n./README.md:17:                                   |     read_document, extract_line_items -> LineItemExtractor sub-agent\n./README.md:34:* **Budgets.** Per-run step, time, token, cost, tool-rate and sub-agent","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
