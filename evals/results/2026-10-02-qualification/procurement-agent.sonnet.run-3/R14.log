{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P5E8S1g2URiiGrmjLeNr3f","type":"tool_result","content":"60\t        agent_instance_id=new_instance_id(),\n61\t        trace_id=uuid.uuid4().hex,\n62\t        run_id=f\"bg-{uuid.uuid4()}\",\n63\t        delegated_subject=\"system:procurement-agent\",\n64\t        agent_principal=AGENT_PRINCIPAL,\n65\t    )\n66\t\n67\t\n68\tasync def expire_approvals_forever(app: FastAPI) -> None:\n69\t    while True:\n70\t        await asyncio.sleep(60)\n71\t        ident = service_identity(app.state.settings, app.state.agent_type_id)\n72\t        count = await app.state.pool.fetchval(\n73\t            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n74\t            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n75\t        )\n76\t        await audit.record(app.state.pool, ident, kind=\"background_job\",\n77\t                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n78\t\n79\t\n80\t@asynccontextmanager\n81\tasync def lifespan(app: FastAPI):\n82\t    settings = get_settings()\n83\t    agent_type_id = startup_checks(settings)\n84\t    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n85\t    broker = TokenBroker(settings)\n86\t\n87\t    async def slack_token() -> str:\n88\t        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n89\t\n90\t    slack = SlackClient(settings.slack_api_url, slack_token)\n91\t    approvals = ApprovalStore(pool, settings.policy, slack)\n92\t    gate = PolicyGate(settings.policy, approvals)\n93\t    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n94\t    await erp.initialize(service_identity(settings, agent_type_id))\n95\t\n96\t    client = AsyncAnthropic()\n97\t    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n98\t    deps.extractor = LineItemExtractor(\n99\t        client=client, settings=settings, deps=deps,\n100\t        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n101\t    )\n102\t    app.state.settings = settings\n103\t    app.state.pool = pool\n104\t    app.state.agent_type_id = agent_type_id\n105\t    app.state.approvals = approvals\n106\t    app.state.agent = ProcurementAgent(\n107\t        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n108\t    )\n109\t    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n110\t    sweeper = asyncio.create_task(expire_approvals_forever(app))\n111\t    try:\n112\t        yield\n113\t    finally:\n114\t        sweeper.cancel()\n115\t        await pool.close()\n116\t\n117\t\n118\tapp = FastAPI(lifespan=lifespan)\n119\tapp.include_router(ingest.router)\n120\t\n121\t\n122\tdef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n123\t    settings = request.app.state.settings\n124\t    try:\n125\t        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n126\t        claims = jwt.decode(\n127\t            creds.credentials,\n128\t            key.key,\n129\t            algorithms=[\"RS256\", \"ES256\"],\n130\t            audience=settings.oidc_audience,\n131\t            issuer=settings.oidc_issuer,\n132\t            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n133\t        )\n134\t    except jwt.PyJWTError as exc:\n135\t        raise HTTPException(401, \"invalid token\") from exc\n136\t    bu = claims.get(\"bu\")\n137\t    if not bu:\n138\t        raise HTTPException(403, \"token has no business unit\")\n139\t    return Principal(subject=claims[\"sub\"], business_unit=bu)\n140\t\n141\t\n142\t@app.post(\"/runs\")\n143\tasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n144\t    settings = request.app.state.settings\n145\t    span_ctx = trace.get_current_span().get_span_context()\n146\t    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n147\t    ident = RunIdentity(\n148\t        accountable_party=principal.subject,\n149\t        operational_owner=settings.operational_owner,\n150\t        tenant=principal.business_unit,\n151\t        agent_type_id=request.app.state.agent_type_id,\n152\t        agent_instance_id=new_instance_id(),\n153\t        trace_id=trace_id,\n154\t        run_id=f\"run-{uuid.uuid4()}\",\n155\t        delegated_subject=principal.subject,\n156\t        agent_principal=AGENT_PRINCIPAL,\n157\t    )\n158\t    task = f\"Department: {req.department}\\n\\n{req.task}\"\n159\t    asyncio.create_task(request.app.state.agent.run(ident, task))\n160\t    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n161\t\n162\t\n163\t@app.post(\"/slack/interactions\")\n164\tasync def slack_interactions(request: Request) -> dict:\n165\t    body = await request.body()\n166\t    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n167\t    if abs(time.time() - int(timestamp)) > 300:\n168\t        raise HTTPException(401, \"stale request\")\n169\t    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n170\t    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n171\t    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n172\t        raise HTTPException(401, \"bad signature\")\n173\t\n174\t    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n175\t    action = payload[\"actions\"][0]\n176\t    slack_user = payload[\"user\"][\"id\"]\n177\t    row = await request.app.state.pool.fetchrow(\n178\t        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n179\t    )\n180\t    if row is None:\n181\t        raise HTTPException(403, \"not an approver\")\n182\t    try:\n183\t        await request.app.state.approvals.decide(\n184\t            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n185\t            approve=action[\"action_id\"] == \"approve\",\n186\t        )\n187\t    except ApproverNotAuthorized as exc:\n188\t        raise HTTPException(403, str(exc)) from exc\n189\t    except ValueError as exc:\n190\t        raise HTTPException(409, str(exc)) from exc\n191\t    return {\"ok\": True}\n192\t\n193\t\n194\t@app.get(\"/healthz\")\n195\tasync def healthz() -> dict:\n196\t    return {\"ok\": True}\n197\t"}]},"parent_tool_use_id":null,"session_id":"9f767789-334f-4305-8e43-0959520bade1","uuid":"9bba47f3-2d83-4984-ab07-48708e159009","timestamp":"2026-10-02T16:17:30.916Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-ayetmh4d/agent/app/main.py","content":"        agent_instance_id=new_instance_id(),\n        trace_id=uuid.uuid4().hex,\n        run_id=f\"bg-{uuid.uuid4()}\",\n        delegated_subject=\"system:procurement-agent\",\n        agent_principal=AGENT_PRINCIPAL,\n    )\n\n\nasync def expire_approvals_forever(app: FastAPI) -> None:\n    while True:\n        await asyncio.sleep(60)\n        ident = service_identity(app.state.settings, app.state.agent_type_id)\n        count = await app.state.pool.fetchval(\n            \"WITH e AS (UPDATE approvals SET status = 'expired' \"\n            \"WHERE status = 'pending' AND expires_at <= now() RETURNING 1) SELECT count(*) FROM e\"\n        )\n        await audit.record(app.state.pool, ident, kind=\"background_job\",\n                           payload={\"job\": \"expire_approvals\", \"expired\": count})\n\n\n@asynccontextmanager\nasync def lifespan(app: FastAPI):\n    settings = get_settings()\n    agent_type_id = startup_checks(settings)\n    pool = await asyncpg.create_pool(settings.database_url, min_size=2, max_size=10)\n    broker = TokenBroker(settings)\n\n    async def slack_token() -> str:\n        return await broker.token_for(\"slack-proxy\", \"chat:write\", service_identity(settings, agent_type_id))\n\n    slack = SlackClient(settings.slack_api_url, slack_token)\n    approvals = ApprovalStore(pool, settings.policy, slack)\n    gate = PolicyGate(settings.policy, approvals)\n    erp = ErpMcpClient(settings.erp_mcp_url, settings.manifest[\"tool_pins\"], broker)\n    await erp.initialize(service_identity(settings, agent_type_id))\n\n    client = AsyncAnthropic()\n    deps = AgentDeps(settings=settings, pool=pool, gate=gate, erp=erp, slack=slack, broker=broker)\n    deps.extractor = LineItemExtractor(\n        client=client, settings=settings, deps=deps,\n        system_prompt=(settings.prompt_dir / \"extractor.md\").read_text(),\n    )\n    app.state.settings = settings\n    app.state.pool = pool\n    app.state.agent_type_id = agent_type_id\n    app.state.approvals = approvals\n    app.state.agent = ProcurementAgent(\n        client=client, deps=deps, system_prompt=(settings.prompt_dir / \"system.md\").read_text()\n    )\n    app.state.jwks = jwt.PyJWKClient(settings.oidc_jwks_url, cache_keys=True, lifespan=300)\n    sweeper = asyncio.create_task(expire_approvals_forever(app))\n    try:\n        yield\n    finally:\n        sweeper.cancel()\n        await pool.close()\n\n\napp = FastAPI(lifespan=lifespan)\napp.include_router(ingest.router)\n\n\ndef authenticate(request: Request, creds: HTTPAuthorizationCredentials = Depends(bearer)) -> Principal:\n    settings = request.app.state.settings\n    try:\n        key = request.app.state.jwks.get_signing_key_from_jwt(creds.credentials)\n        claims = jwt.decode(\n            creds.credentials,\n            key.key,\n            algorithms=[\"RS256\", \"ES256\"],\n            audience=settings.oidc_audience,\n            issuer=settings.oidc_issuer,\n            options={\"require\": [\"exp\", \"iat\", \"sub\", \"aud\", \"iss\"]},\n        )\n    except jwt.PyJWTError as exc:\n        raise HTTPException(401, \"invalid token\") from exc\n    bu = claims.get(\"bu\")\n    if not bu:\n        raise HTTPException(403, \"token has no business unit\")\n    return Principal(subject=claims[\"sub\"], business_unit=bu)\n\n\n@app.post(\"/runs\")\nasync def start_run(req: RunRequest, request: Request, principal: Principal = Depends(authenticate)) -> dict:\n    settings = request.app.state.settings\n    span_ctx = trace.get_current_span().get_span_context()\n    trace_id = format(span_ctx.trace_id, \"032x\") if span_ctx.is_valid else uuid.uuid4().hex\n    ident = RunIdentity(\n        accountable_party=principal.subject,\n        operational_owner=settings.operational_owner,\n        tenant=principal.business_unit,\n        agent_type_id=request.app.state.agent_type_id,\n        agent_instance_id=new_instance_id(),\n        trace_id=trace_id,\n        run_id=f\"run-{uuid.uuid4()}\",\n        delegated_subject=principal.subject,\n        agent_principal=AGENT_PRINCIPAL,\n    )\n    task = f\"Department: {req.department}\\n\\n{req.task}\"\n    asyncio.create_task(request.app.state.agent.run(ident, task))\n    return {\"run_id\": ident.run_id, \"agent_instance_id\": ident.agent_instance_id}\n\n\n@app.post(\"/slack/interactions\")\nasync def slack_interactions(request: Request) -> dict:\n    body = await request.body()\n    timestamp = request.headers.get(\"X-Slack-Request-Timestamp\", \"0\")\n    if abs(time.time() - int(timestamp)) > 300:\n        raise HTTPException(401, \"stale request\")\n    secret = Path(request.app.state.settings.slack_signing_secret_path).read_bytes().strip()\n    expected = \"v0=\" + hmac.new(secret, f\"v0:{timestamp}:\".encode() + body, hashlib.sha256).hexdigest()\n    if not hmac.compare_digest(expected, request.headers.get(\"X-Slack-Signature\", \"\")):\n        raise HTTPException(401, \"bad signature\")\n\n    payload = json.loads(parse_qs(body.decode())[\"payload\"][0])\n    action = payload[\"actions\"][0]\n    slack_user = payload[\"user\"][\"id\"]\n    row = await request.app.state.pool.fetchrow(\n        \"SELECT email, role FROM approvers WHERE slack_user_id = $1 AND active\", slack_user\n    )\n    if row is None:\n        raise HTTPException(403, \"not an approver\")\n    try:\n        await request.app.state.approvals.decide(\n            action[\"value\"], approver=row[\"email\"], approver_role=row[\"role\"],\n            approve=action[\"action_id\"] == \"approve\",\n        )\n    except ApproverNotAuthorized as exc:\n        raise HTTPException(403, str(exc)) from exc\n    except ValueError as exc:\n        raise HTTPException(409, str(exc)) from exc\n    return {\"ok\": True}\n\n\n@app.get(\"/healthz\")\nasync def healthz() -> dict:\n    return {\"ok\": True}\n","numLines":138,"startLine":60,"totalLines":197}}}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CfdiEB5dTn56srVZo9pdj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BSuNGYgsmQkpL4AoG4EoYj","name":"Read","input":{"file_path":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-ayetmh4d/agent/app/loop.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2401,"cache_read_input_tokens":9740,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2401},"output_tokens":7,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9f767789-334f-4305-8e43-0959520bade1","uuid":"74e4053c-966e-4cc2-bef8-dd58996cbfa4","timestamp":"2026-10-02T16:17:31.763Z","request_id":"req_011CfdiEAqFKmuu7NXeNzUjG","wire_tool_inputs":{"toolu_01BSuNGYgsmQkpL4AoG4EoYj":{"file_path":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-ayetmh4d/agent/app/loop.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BSuNGYgsmQkpL4AoG4EoYj","type":"tool_result","content":"1\t\"\"\"Procurement agent run loop.\n2\t\n3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n4\tEvery edge writes an audit node before the next step runs. Budgets are\n5\tchecked before each model turn and each tool call.\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\timport hashlib\n10\timport logging\n11\tfrom dataclasses import dataclass, field\n12\tfrom typing import Any\n13\t\n14\tfrom opentelemetry import trace\n15\t\n16\tfrom app import audit, killswitch\n17\tfrom app.budget import Budget, BudgetExceeded\n18\tfrom app.context_size import ContextMeasure, measure_context\n19\tfrom app.gate import PolicyGate\n20\tfrom app.identity import RunIdentity\n21\tfrom app.redact import redact_for_model\n22\tfrom app.tools import ToolRegistry, build_registry\n23\t\n24\tlog = logging.getLogger(__name__)\n25\ttracer = trace.get_tracer(\"procurement.loop\")\n26\t\n27\tCOMPACT_AFTER_MESSAGES = 40\n28\tKEEP_RECENT_MESSAGES = 12\n29\t\n30\t\n31\t@dataclass\n32\tclass AgentDeps:\n33\t    settings: Any\n34\t    pool: Any\n35\t    gate: PolicyGate\n36\t    erp: Any\n37\t    slack: Any\n38\t    broker: Any\n39\t    extractor: Any = None\n40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n42\t\n43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n44\t        return self._budgets[ident.run_id]\n45\t\n46\t    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n47\t        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n48\t\n49\t    def erp_scope_for(self, operation: str) -> str:\n50\t        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n51\t        return scopes.get(operation, \"erp.read\")\n52\t\n53\t    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n54\t        self._contexts[ident.agent_instance_id] = ctx\n55\t        proposed = await audit.record(\n56\t            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n57\t            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n58\t        )\n59\t        tool = registry.get(use.name)\n60\t        if tool is None:\n61\t            await audit.record(\n62\t                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n63\t                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n64\t            )\n65\t            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n66\t\n67\t        decision = await self.gate.authorize(ident, tool, use.input)\n68\t        authz = await audit.record(\n69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n72\t        )\n73\t        if not decision.allow:\n74\t            if decision.pending:\n75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n76\t            return _error(use.id, f\"denied: {decision.reason}\")\n77\t\n78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n79\t        try:\n80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n81\t                for k, v in ctx.otel_attributes().items():\n82\t                    span.set_attribute(k, v)\n83\t                output = await tool.invoke(use.input, ident)\n84\t        except BudgetExceeded:\n85\t            raise\n86\t        except Exception as exc:\n87\t            await audit.record(\n88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n90\t                operation_id=operation_id,\n91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n92\t            )\n93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n94\t\n95\t        await audit.record(\n96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n98\t            operation_id=operation_id,\n99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n100\t        )\n101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n102\t\n103\t\n104\tdef _error(tool_use_id: str, message: str) -> dict:\n105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n106\t\n107\t\n108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n110\t        return messages, False\n111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n112\t    while tail and tail[0][\"role\"] != \"assistant\":\n113\t        tail = tail[1:]\n114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n115\t    return head + [note] + tail, True\n116\t\n117\t\n118\tclass ProcurementAgent:\n119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n120\t        self.client = client\n121\t        self.deps = deps\n122\t        self.system_prompt = system_prompt\n123\t        self.role = role\n124\t\n125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n126\t        pool = self.deps.pool\n127\t        await killswitch.assert_running(pool, ident.tenant)\n128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n129\t        await budget.reserve_run_start(pool)\n130\t        self.deps._budgets[ident.run_id] = budget\n131\t        registry = build_registry(self.role, ident, self.deps)\n132\t\n133\t        run_node = await audit.record(\n134\t            pool, ident, kind=\"run_started\",\n135\t            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n136\t        )\n137\t        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n138\t        try:\n139\t            while True:\n140\t                budget.check_step()\n141\t                messages, compacted = _compact(messages)\n142\t                request = {\n143\t                    \"model\": self.deps.settings.model_id,\n144\t                    \"system\": self.system_prompt,\n145\t                    \"messages\": messages,\n146\t                    \"tools\": registry.schemas(),\n147\t                    \"max_tokens\": 4096,\n148\t                }\n149\t                ctx = await measure_context(self.client, request, compacted)\n150\t                response = await self.client.messages.create(**request)\n151\t                budget.charge_model(self.deps.settings.model_id, response.usage)\n152\t                await budget.flush(pool)\n153\t                ctx = ctx.finalize(response.usage)\n154\t                decision = await audit.record(\n155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n156\t                    payload={\n157\t                        \"requested_model\": request[\"model\"],\n158\t                        \"served_model\": response.model,\n159\t                        \"stop_reason\": response.stop_reason,\n160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n161\t                    },\n162\t                )\n163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n165\t                if not uses:\n166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n168\t                                       payload={\"final_sha256\": audit.digest(final)})\n169\t                    return final\n170\t                results = []\n171\t                for use in uses:\n172\t                    budget.check_tool_call()\n173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n174\t                messages.append({\"role\": \"user\", \"content\": results})\n175\t        except BudgetExceeded as exc:\n176\t            await audit.record(\n177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n179\t            )\n180\t            await self.deps.slack.post(\n181\t                channel=\"#procurement-agent-ops\",\n182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n183\t            )\n184\t            return None\n185\t        finally:\n186\t            self.deps._budgets.pop(ident.run_id, None)\n187\t"}]},"parent_tool_use_id":null,"session_id":"9f767789-334f-4305-8e43-0959520bade1","uuid":"1da0fd01-70f7-45cd-8408-0979938e509e","timestamp":"2026-10-02T16:17:31.779Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-ayetmh4d/agent/app/loop.py","content":"\"\"\"Procurement agent run loop.\n\nGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\nEvery edge writes an audit node before the next step runs. Budgets are\nchecked before each model turn and each tool call.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport logging\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nfrom opentelemetry import trace\n\nfrom app import audit, killswitch\nfrom app.budget import Budget, BudgetExceeded\nfrom app.context_size import ContextMeasure, measure_context\nfrom app.gate import PolicyGate\nfrom app.identity import RunIdentity\nfrom app.redact import redact_for_model\nfrom app.tools import ToolRegistry, build_registry\n\nlog = logging.getLogger(__name__)\ntracer = trace.get_tracer(\"procurement.loop\")\n\nCOMPACT_AFTER_MESSAGES = 40\nKEEP_RECENT_MESSAGES = 12\n\n\n@dataclass\nclass AgentDeps:\n    settings: Any\n    pool: Any\n    gate: PolicyGate\n    erp: Any\n    slack: Any\n    broker: Any\n    extractor: Any = None\n    _budgets: dict[str, Budget] = field(default_factory=dict)\n    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n\n    def current_budget(self, ident: RunIdentity) -> Budget:\n        return self._budgets[ident.run_id]\n\n    def current_context(self, ident: RunIdentity) -> ContextMeasure:\n        return self._contexts.get(ident.agent_instance_id, ContextMeasure.unavailable())\n\n    def erp_scope_for(self, operation: str) -> str:\n        scopes = self.settings.policy[\"erp\"][\"operation_scopes\"]\n        return scopes.get(operation, \"erp.read\")\n\n    async def execute_tool(self, ident, registry: ToolRegistry, use, parent: str, ctx: ContextMeasure) -> dict:\n        self._contexts[ident.agent_instance_id] = ctx\n        proposed = await audit.record(\n            self.pool, ident, kind=\"tool_proposed\", parent=parent, context=ctx,\n            payload={\"tool\": use.name, \"tool_use_id\": use.id, \"args\": audit.summarize_args(use.input)},\n        )\n        tool = registry.get(use.name)\n        if tool is None:\n            await audit.record(\n                self.pool, ident, kind=\"tool_denied\", parent=proposed, context=ctx,\n                policy_version=self.gate.version, payload={\"reason\": \"tool not in role allowlist\"},\n            )\n            return _error(use.id, f\"tool {use.name} is not available to this agent\")\n\n        decision = await self.gate.authorize(ident, tool, use.input)\n        authz = await audit.record(\n            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n            policy_version=decision.policy_version, approval_id=decision.approval_id,\n            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n        )\n        if not decision.allow:\n            if decision.pending:\n                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n            return _error(use.id, f\"denied: {decision.reason}\")\n\n        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n        try:\n            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n                for k, v in ctx.otel_attributes().items():\n                    span.set_attribute(k, v)\n                output = await tool.invoke(use.input, ident)\n        except BudgetExceeded:\n            raise\n        except Exception as exc:\n            await audit.record(\n                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n                policy_version=decision.policy_version, approval_id=decision.approval_id,\n                operation_id=operation_id,\n                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n            )\n            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n\n        await audit.record(\n            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n            policy_version=decision.policy_version, approval_id=decision.approval_id,\n            operation_id=operation_id,\n            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n        )\n        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n\n\ndef _error(tool_use_id: str, message: str) -> dict:\n    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n\n\ndef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n    if len(messages) <= COMPACT_AFTER_MESSAGES:\n        return messages, False\n    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n    while tail and tail[0][\"role\"] != \"assistant\":\n        tail = tail[1:]\n    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n    return head + [note] + tail, True\n\n\nclass ProcurementAgent:\n    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n        self.client = client\n        self.deps = deps\n        self.system_prompt = system_prompt\n        self.role = role\n\n    async def run(self, ident: RunIdentity, task: str) -> str | None:\n        pool = self.deps.pool\n        await killswitch.assert_running(pool, ident.tenant)\n        budget = Budget.for_run(self.deps.settings.budgets, ident)\n        await budget.reserve_run_start(pool)\n        self.deps._budgets[ident.run_id] = budget\n        registry = build_registry(self.role, ident, self.deps)\n\n        run_node = await audit.record(\n            pool, ident, kind=\"run_started\",\n            payload={\"task_sha256\": hashlib.sha256(task.encode()).hexdigest(), \"tools\": registry.names()},\n        )\n        messages: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": task}]\n        try:\n            while True:\n                budget.check_step()\n                messages, compacted = _compact(messages)\n                request = {\n                    \"model\": self.deps.settings.model_id,\n                    \"system\": self.system_prompt,\n                    \"messages\": messages,\n                    \"tools\": registry.schemas(),\n                    \"max_tokens\": 4096,\n                }\n                ctx = await measure_context(self.client, request, compacted)\n                response = await self.client.messages.create(**request)\n                budget.charge_model(self.deps.settings.model_id, response.usage)\n                await budget.flush(pool)\n                ctx = ctx.finalize(response.usage)\n                decision = await audit.record(\n                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n                    payload={\n                        \"requested_model\": request[\"model\"],\n                        \"served_model\": response.model,\n                        \"stop_reason\": response.stop_reason,\n                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n                    },\n                )\n                messages.append({\"role\": \"assistant\", \"content\": response.content})\n                uses = [b for b in response.content if b.type == \"tool_use\"]\n                if not uses:\n                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n                                       payload={\"final_sha256\": audit.digest(final)})\n                    return final\n                results = []\n                for use in uses:\n                    budget.check_tool_call()\n                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n                messages.append({\"role\": \"user\", \"content\": results})\n        except BudgetExceeded as exc:\n            await audit.record(\n                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n            )\n            await self.deps.slack.post(\n                channel=\"#procurement-agent-ops\",\n                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n            )\n            return None\n        finally:\n            self.deps._budgets.pop(ident.run_id, None)\n","numLines":187,"startLine":1,"totalLines":187}}}
