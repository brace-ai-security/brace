{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HvKch67dE7cC5JH2bnS1Mt","type":"tool_result","content":"1\t\"\"\"Redaction for model input, logs, audit payloads, and outbound messages.\n2\t\n3\tApplied in four places:\n4\t  * tool results before they are appended to the model context (loop.py)\n5\t  * every audit payload (audit.py)\n6\t  * the root logging filter (main.py)\n7\t  * outbound Slack text (tools/slack.py)\n8\t\"\"\"\n9\tfrom __future__ import annotations\n10\t\n11\timport logging\n12\timport re\n13\tfrom typing import Any\n14\tfrom urllib.parse import urlparse\n15\t\n16\tSECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n17\t    (\"bearer\", re.compile(r\"(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]{16,}\")),\n18\t    (\"jwt\", re.compile(r\"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b\")),\n19\t    (\"acct_token\", re.compile(r\"\\bacct_tok_[A-Za-z0-9_]{8,}\\b\")),\n20\t    (\"pay_token\", re.compile(r\"\\bpay_tok_[A-Za-z0-9_]{8,}\\b\")),\n21\t    (\"erp_session\", re.compile(r\"\\berp_sess_[A-Za-z0-9_]{8,}\\b\")),\n22\t    (\"password_kv\", re.compile(r\"(?i)\\b(password|passwd|secret|api[_-]?key)\\s*[:=]\\s*\\S+\")),\n23\t]\n24\t\n25\t# Bank details: keep the last four characters so staff can still match records.\n26\tACCOUNT_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n27\t    (\"iban\", re.compile(r\"\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b\")),\n28\t    (\"account_no\", re.compile(r\"(?i)\\b(account|acct|routing)\\s*(no\\.?|number|#)?\\s*[:#]?\\s*(\\d[\\d -]{6,}\\d)\")),\n29\t]\n30\t\n31\tMARKDOWN_IMAGE = re.compile(r\"!\\[[^\\]]*\\]\\(([^)\\s]+)[^)]*\\)\")\n32\tMARKDOWN_LINK = re.compile(r\"(?<!!)\\[([^\\]]*)\\]\\(([^)\\s]+)[^)]*\\)\")\n33\tSLACK_LINK = re.compile(r\"<(https?://[^|>]+)(\\|[^>]*)?>\")\n34\tBARE_URL = re.compile(r\"https?://[^\\s<>()]+\")\n35\t\n36\tAPPROVED_LINK_HOSTS = frozenset({\"erp.example-corp.test\", \"intranet.example-corp.test\"})\n37\t\n38\t\n39\tdef _mask_tail(match: re.Match[str]) -> str:\n40\t    text = match.group(0)\n41\t    return \"[REDACTED:\" + \"*\" * 4 + text[-4:] + \"]\"\n42\t\n43\t\n44\tdef redact_text(text: str) -> str:\n45\t    for name, pattern in SECRET_PATTERNS:\n46\t        text = pattern.sub(f\"[REDACTED:{name}]\", text)\n47\t    for _name, pattern in ACCOUNT_PATTERNS:\n48\t        text = pattern.sub(_mask_tail, text)\n49\t    return text\n50\t\n51\t\n52\tdef redact_value(value: Any) -> Any:\n53\t    if isinstance(value, str):\n54\t        return redact_text(value)\n55\t    if isinstance(value, dict):\n56\t        return {k: redact_value(v) for k, v in value.items()}\n57\t    if isinstance(value, (list, tuple)):\n58\t        return [redact_value(v) for v in value]\n59\t    return value\n60\t\n61\t\n62\tdef redact_for_model(value: Any) -> str:\n63\t    if not isinstance(value, str):\n64\t        import json\n65\t\n66\t        value = json.dumps(value, default=str)\n67\t    return redact_text(value)\n68\t\n69\t\n70\tdef _host_ok(url: str) -> bool:\n71\t    host = (urlparse(url).hostname or \"\").lower()\n72\t    return host in APPROVED_LINK_HOSTS\n73\t\n74\t\n75\tdef strip_unapproved_links(text: str) -> str:\n76\t    \"\"\"Remove images entirely and drop links to hosts outside the allowlist.\n77\t\n78\t    Slack and most chat clients fetch link and image URLs to render previews,\n79\t    so an attacker-chosen URL can carry data out without any tool call.\n80\t    \"\"\"\n81\t    text = MARKDOWN_IMAGE.sub(\"[image removed]\", text)\n82\t    text = MARKDOWN_LINK.sub(\n83\t        lambda m: m.group(0) if _host_ok(m.group(2)) else m.group(1), text\n84\t    )\n85\t    text = SLACK_LINK.sub(\n86\t        lambda m: m.group(0) if _host_ok(m.group(1)) else \"[link removed]\", text\n87\t    )\n88\t    text = BARE_URL.sub(\n89\t        lambda m: m.group(0) if _host_ok(m.group(0)) else \"[link removed]\", text\n90\t    )\n91\t    return text\n92\t\n93\t\n94\tclass RedactingFilter(logging.Filter):\n95\t    def filter(self, record: logging.LogRecord) -> bool:\n96\t        if isinstance(record.msg, str):\n97\t            record.msg = redact_text(record.msg)\n98\t        if record.args:\n99\t            record.args = tuple(redact_value(a) for a in record.args)\n100\t        return True\n101\t"}]},"parent_tool_use_id":null,"session_id":"8b3e8d62-cb57-4f98-8f9e-a230c15e8510","uuid":"e1b63db1-4cfe-4df5-b16a-8382c4e367ac","timestamp":"2026-10-02T16:15:48.394Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-p52pl_b3/agent/app/redact.py","content":"\"\"\"Redaction for model input, logs, audit payloads, and outbound messages.\n\nApplied in four places:\n  * tool results before they are appended to the model context (loop.py)\n  * every audit payload (audit.py)\n  * the root logging filter (main.py)\n  * outbound Slack text (tools/slack.py)\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport re\nfrom typing import Any\nfrom urllib.parse import urlparse\n\nSECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n    (\"bearer\", re.compile(r\"(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]{16,}\")),\n    (\"jwt\", re.compile(r\"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b\")),\n    (\"acct_token\", re.compile(r\"\\bacct_tok_[A-Za-z0-9_]{8,}\\b\")),\n    (\"pay_token\", re.compile(r\"\\bpay_tok_[A-Za-z0-9_]{8,}\\b\")),\n    (\"erp_session\", re.compile(r\"\\berp_sess_[A-Za-z0-9_]{8,}\\b\")),\n    (\"password_kv\", re.compile(r\"(?i)\\b(password|passwd|secret|api[_-]?key)\\s*[:=]\\s*\\S+\")),\n]\n\n# Bank details: keep the last four characters so staff can still match records.\nACCOUNT_PATTERNS: list[tuple[str, re.Pattern[str]]] = [\n    (\"iban\", re.compile(r\"\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b\")),\n    (\"account_no\", re.compile(r\"(?i)\\b(account|acct|routing)\\s*(no\\.?|number|#)?\\s*[:#]?\\s*(\\d[\\d -]{6,}\\d)\")),\n]\n\nMARKDOWN_IMAGE = re.compile(r\"!\\[[^\\]]*\\]\\(([^)\\s]+)[^)]*\\)\")\nMARKDOWN_LINK = re.compile(r\"(?<!!)\\[([^\\]]*)\\]\\(([^)\\s]+)[^)]*\\)\")\nSLACK_LINK = re.compile(r\"<(https?://[^|>]+)(\\|[^>]*)?>\")\nBARE_URL = re.compile(r\"https?://[^\\s<>()]+\")\n\nAPPROVED_LINK_HOSTS = frozenset({\"erp.example-corp.test\", \"intranet.example-corp.test\"})\n\n\ndef _mask_tail(match: re.Match[str]) -> str:\n    text = match.group(0)\n    return \"[REDACTED:\" + \"*\" * 4 + text[-4:] + \"]\"\n\n\ndef redact_text(text: str) -> str:\n    for name, pattern in SECRET_PATTERNS:\n        text = pattern.sub(f\"[REDACTED:{name}]\", text)\n    for _name, pattern in ACCOUNT_PATTERNS:\n        text = pattern.sub(_mask_tail, text)\n    return text\n\n\ndef redact_value(value: Any) -> Any:\n    if isinstance(value, str):\n        return redact_text(value)\n    if isinstance(value, dict):\n        return {k: redact_value(v) for k, v in value.items()}\n    if isinstance(value, (list, tuple)):\n        return [redact_value(v) for v in value]\n    return value\n\n\ndef redact_for_model(value: Any) -> str:\n    if not isinstance(value, str):\n        import json\n\n        value = json.dumps(value, default=str)\n    return redact_text(value)\n\n\ndef _host_ok(url: str) -> bool:\n    host = (urlparse(url).hostname or \"\").lower()\n    return host in APPROVED_LINK_HOSTS\n\n\ndef strip_unapproved_links(text: str) -> str:\n    \"\"\"Remove images entirely and drop links to hosts outside the allowlist.\n\n    Slack and most chat clients fetch link and image URLs to render previews,\n    so an attacker-chosen URL can carry data out without any tool call.\n    \"\"\"\n    text = MARKDOWN_IMAGE.sub(\"[image removed]\", text)\n    text = MARKDOWN_LINK.sub(\n        lambda m: m.group(0) if _host_ok(m.group(2)) else m.group(1), text\n    )\n    text = SLACK_LINK.sub(\n        lambda m: m.group(0) if _host_ok(m.group(1)) else \"[link removed]\", text\n    )\n    text = BARE_URL.sub(\n        lambda m: m.group(0) if _host_ok(m.group(0)) else \"[link removed]\", text\n    )\n    return text\n\n\nclass RedactingFilter(logging.Filter):\n    def filter(self, record: logging.LogRecord) -> bool:\n        if isinstance(record.msg, str):\n            record.msg = redact_text(record.msg)\n        if record.args:\n            record.args = tuple(redact_value(a) for a in record.args)\n        return True\n","numLines":101,"startLine":1,"totalLines":101}}}
