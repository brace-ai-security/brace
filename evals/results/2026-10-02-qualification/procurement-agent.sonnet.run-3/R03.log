{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RB13QRMrz6sHJ814x8bAzs","type":"tool_result","content":"    payload = await request.json()\n    doc = Inbound(\n        business_unit=payload[\"business_unit\"],\n        sender=payload[\"from\"],\n        media_type=payload[\"media_type\"],\n        raw=base64.b64decode(payload[\"content_b64\"], validate=True),\n    )\n    doc_id = f\"doc-{uuid.uuid4().hex[:20]}\"\n    pool = request.app.state.pool\n    try:\n        text = validate(doc)\n    except Rejected as exc:\n        await pool.execute(\n            \"\"\"\n            INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, reject_reason, received_at)\n            VALUES ($1, $2, $3, $4, $5, 'quarantined', $6, now())\n            \"\"\",\n            doc_id, doc.business_unit, doc.sender, doc.media_type,\n            hashlib.sha256(doc.raw).hexdigest(), str(exc)[:500],\n        )\n        return {\"doc_id\": doc_id, \"status\": \"quarantined\"}\n\n    await pool.execute(\n        \"\"\"\n        INSERT INTO documents (doc_id, business_unit, source, media_type, sha256, status, text, received_at)\n        VALUES ($1, $2, $3, $4, $5, 'accepted', $6, now())\n        \"\"\",\n        doc_id, doc.business_unit, doc.sender, doc.media_type,\n        hashlib.sha256(doc.raw).hexdigest(), text,\n    )\n    return {\"doc_id\": doc_id, \"status\": \"accepted\"}\n\ndef tools(deps) -> list[Tool]:\n    pool = deps.pool\n\n    async def read_document(args: dict[str, Any], ident: RunIdentity) -> str:\n        row = await pool.fetchrow(\n            \"\"\"\n            SELECT doc_id, source, media_type, text\n            FROM documents\n            WHERE doc_id = $1 AND business_unit = $2 AND status = 'accepted'\n            \"\"\",\n            args[\"doc_id\"],\n            ident.tenant,\n        )\n        if row is None:\n            return \"document not found\"\n        return UNTRUSTED_WRAPPER.format(\n            source=row[\"source\"], doc_id=row[\"doc_id\"], media_type=row[\"media_type\"], text=row[\"text\"]\n        )\n\n    async def extract_line_items(args: dict[str, Any], ident: RunIdentity) -> Any:\n        return await deps.extractor.extract(ident, args[\"doc_id\"], deps.current_budget(ident))\n\n    return [\n        Tool(\n            name=\"read_document\",\n            description=\"Read the text of an ingested vendor quote, invoice, or email by doc_id.\",\n            input_schema={\n                \"type\": \"object\",\n                \"properties\": {\"doc_id\": {\"type\": \"string\", \"maxLength\": 64}},\n                \"required\": [\"doc_id\"],\n    async def memory_write(args: dict[str, Any], ident: RunIdentity) -> Any:\n        if args[\"kind\"] not in NOTE_KINDS:\n            raise NoteRejected(f\"unknown note kind {args['kind']}\")\n        check_note(args[\"body\"])\n        note_id = f\"note-{uuid.uuid4()}\"\n        ctx = deps.current_context(ident)\n        await pool.execute(\n            \"\"\"\n            INSERT INTO dept_notes (\n                note_id, business_unit, department, kind, body,\n                verified, quarantined, expires_at,\n                writer_instance, writer_type_id, run_id, source_doc_id,\n                delegated_subject, context_tokens, context_method, created_at\n            ) VALUES ($1, $2, $3, $4, $5, false, false, now() + interval '30 days',\n                      $6, $7, $8, $9, $10, $11, $12, now())\n            \"\"\",\n            note_id,\n            ident.tenant,\n            args[\"department\"],\n            args[\"kind\"],\n            args[\"body\"],\n            ident.agent_instance_id,\n            ident.agent_type_id,\n            ident.run_id,\n            args.get(\"source_doc_id\"),\n            ident.delegated_subject,\napp/approvals.py:4:the full argument summary. Approvers decide with the Slack buttons; the\napp/approvals.py:45:                id, tool, target, args_sha256, args_summary, ten