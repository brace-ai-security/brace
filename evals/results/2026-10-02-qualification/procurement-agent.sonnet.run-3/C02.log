{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M964Ctn3RC9ybM9agHFcYf","type":"tool_result","content":"name: ci\n\non:\n  pull_request:\n  push:\n    branches: [main]\n\npermissions:\n  contents: read\n\njobs:\n  test:\n    runs-on: ubuntu-24.04\n    steps:\n      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n        with:\n          python-version: \"3.11\"\n      - run: pip install -e '.[test]'\n      - run: pytest -q\n      - name: Secret scan\n        uses: gitleaks/gitleaks-action@83373cf2f8c4db6e24b41c1a9b086bb9619e9cd3 # v2.3.7\n      - name: Manifest hashes match files\n        run: |\n          python - <<'PY'\n          import hashlib, yaml, sys\n          m = yaml.safe_load(open(\"release/manifest.yaml\"))\n          bad = []\n          for group in (\"prompts\", \"config\"):\n              for name, e in m[group].items():\n                  if isinstance(e, dict) and \"sha256\" in e:\n                      got = \"sha256:\" + hashlib.sha256(open(e[\"path\"], \"rb\").read()).hexdigest()\n                      if got != e[\"sha256\"]:\n                          bad.append(e[\"path\"])\n          if bad:\n              sys.exit(\"manifest out of date: \" + \", \".join(bad))\n          PY\n\n  release:\n    if: github.ref == 'refs/heads/main'\n    needs: test\n    runs-on: ubuntu-24.04\n    permissions:\n      contents: read\n      id-token: write\n      packages: write\n      attestations: write\n    steps:\n      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n      - uses: sigstore/cosign-installer@dc72c7d5c4d10cd6bcb8cf6e3fd625a9e5e537da # v3.7.0\n        with:\n          cosign-release: \"v2.6.2\"\n      - uses: docker/setup-buildx-action@c47758b77c9736f4b2ef4073d4d51994fabfe349 # v3.7.1\n      - uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0\n        with