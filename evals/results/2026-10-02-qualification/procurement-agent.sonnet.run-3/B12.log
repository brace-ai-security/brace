\"\n            - name: OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT\n              value: \"false\"\n          securityContext:\n            allowPrivilegeEscalation: false\n            privileged: false\n            readOnlyRootFilesystem: true\n            runAsNonRoot: true\n            capabilities:\n              drop: [\"ALL\"]\n            seccompProfile:\n              type: RuntimeDefault\n          resources:\n            requests:\n              cpu: 250m\n              memory: 512Mi\n            limits:\n              cpu: \"1\"\n              memory: 1Gi\n          readinessProbe:\n            httpGet:\n              path: /healthz\n              port: http\n          volumeMounts:\n            - name: workload-token\n              mountPath: /var/run/secrets/tokens\n              readOnly: true\n            - name: slack-signing\n              mountPath: /var/run/secrets/slack\n              readOnly: true\n            - name: mail-hmac\n              mountPath: /var/run/secrets/mail\n              readOnly: true\n            - name: tmp\n              mountPath: /tmp\n      volumes:\n        - name: workload-token\n          projected:\n            sources:\n              - serviceAccountToken:\n                  path: procurement-agent\n                  audience: sts.identity.example-corp.test\n                  expirationSeconds: 600\n        - name: slack-signing\n          secret:\n            secretName: procurement-slack-signing\n        - name: mail-hmac\n          secret:\n            secretName: procurement-mail-gateway-hmac\n        - name: tmp\n          emptyDir:\n            medium: Memory\n            sizeLimit: 64Mi\napiVersion: kyverno.io/v1\nkind: ClusterPolicy\nmetadata:\n  name: procurement-verify-images\n  annotations:\n    policies.kyverno.io/title: Verify procurement agent images\n    kyverno.io/kyverno-version: \"1.15.2\"\nspec:\n  validationFailureAction: Enforce\n  background: false\n  webhookTimeoutSeconds: 15\n  failurePolicy: Fail\n  rules:\n    - name: only-approved-registry\n      match:\n        any:\n          - resources:\n              kinds: [Pod]\n              namespaces: [procurement-prod]\n      validate:\n        message: \"Images in procurement-prod must come from registry.example-corp.test/procurement and be pinned by digest.\"\n        pattern:\n          spec:\n            =(initContainers):\n              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n            containers:\n              - image: \"registry.example-corp.test/procurement/*@sha256:*\"\n    - name: verify-signature-and-provenance\n      match:\n        any:\n          - resources:\n              kinds: [Pod]\n              namespaces: [procurement-prod]\n      verifyImages:\n        - imageReferences:\n            - \"registry.example-corp.test/procurement/*\"\n          mutateDigest: false\n          verifyDigest: true\n          required: true\n          attestors:\n            - entries:\n                - keyless:\n                    issuer: \"https://token.actions.githubusercontent.com\"\n                    subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n                    rekor:\n                      url: https://rekor.sigstore.dev\n          attestations:\n            - type: https://slsa.dev/provenance/v1\n              attestors:\n                - entries:\n                    - keyless:\n                        issuer: \"https://token.actions.githubusercontent.com\"\n                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n              conditions:\n                - all:\n                    - key: \"{{ buildDefinition.buildType }}\"\n                      operator: Equals\n                      value: \"https://actions.github.io/buildtypes/workflow/v1\"\n                    - key: \"{{ buildDefinition.externalParameters.workflow.repository }}\"\n                      operator: Equals\n                      value: \"https://github.com/example-corp/procurement-agent\"\n                    - key: \"{{ buildDefinition.externalParameters.workflow.ref }}\"\n                      operator: Equals\n                      value: \"refs/heads/main\"\n                    - key: \"{{ buildDefinition.externalParameters.workflow.path }}\"\n                      operator: Equals\n                      value: \".github/workflows/ci.yaml\"\n                    - key: \"{{ runDetails.builder.id }}\"\n                      operator: Equals\n                      value: \"https://github.com/actions/runner/github-hosted\"\n            - type: https://cyclonedx.org/bom\n              attestors:\n                - entries:\n                    - keyless:\n                        issuer: \"https://token.actions.githubusercontent.com\"\n                        subject: \"https://github.com/example-corp/procurement-agent/.github/workflows/ci.yaml@refs/heads/main\"\n\"\"\"Runtime settings, read once from the environment at process start.\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom dataclasses import dataclass\nfrom functools import lru_cache\nfrom pathlib import Path\n\nimport yaml\n\n\ndef _env(name: str, default: str | None = None) -> str:\n    value = os.environ.get(name, default)\n    if value is None:\n        raise RuntimeError(f\"missing required setting {name}\")\n    return value\n\n\n@dataclass(frozen=True)\nclass Settings:\n    database_url: str\n    erp_mcp_url: str\n    payments_api_url: str\n    slack_api_url: str\n    sts_url: str\n    oidc_issuer: str\n    oidc_audience: str\n    oidc_jwks_url: str\n    workload_token_path: str\n    slack_signing_secret_path: str\n    mail_gateway_hmac_path: str\n    model_id: str\n    extractor_model_id: str\n    manifest_path: Path\n    prompt_dir: Path\n    policy_path: Path\n    tools_path: Path\n    operational_owner: str\n    image_digest: str\n\n    @property\n    def policy(self) -> dict:\n        return _load_yaml(self.policy_path)\n\n    @property\n    def manifest(self) -> dict:\n        return _load_yaml(self.manifest_path)\n\n    @property\n    def budgets(self) -> dict:\n        return self.policy[\"budgets\"]\n\n\ndef _load_yaml(path: Path) -> dict:\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\n        return yaml.safe_load(fh)\n\n\n@lru_cache(maxsize=1)\ndef get_settings() -> Settings:\n    root = Path(_env(\"APP_ROOT\", \"/app\"))\n    return Settings(\n        database_url=_env(\"DATABASE_URL\"),\n        erp_mcp_url=_env(\"ERP_MCP_URL\"),\n        payments_api_url=_env(\"PAYMENTS_API_URL\"),\n        slack_api_url=_env(\"SLACK_API_URL\", \"https://slack.com/api\"),\n        sts_url=_env(\"STS_URL\"),\n        oidc_issuer=_env(\"OIDC_ISSUER\"),\n        oidc_audience=_env(\"OIDC_AUDIENCE\", \"procurement-agent\"),\n        oidc_jwks_url=_env(\"OIDC_JWKS_URL\"),\n        workload_token_path=_env(\n            \"WORKLOAD_TOKEN_PATH\", \"/var/run/secrets/tokens/procurement-agent\"\n        ),\n        slack_signing_secret_path=_env(\n            \"SLACK_SIGNING_SECRET_PATH\", \"/var/run/secrets/slack/signing-secret\"\n        ),\n        mail_gateway_hmac_path=_env(\n            \"MAIL_GATEWAY_HMAC_PATH\", \"/var/run/secrets/mail/hmac-key\"\n        ),\n        model_id=_env(\"MODEL_ID\"),\n        extractor_model_id=_env(\"EXTRACTOR_MODEL_ID\"),\n        manifest_path=root / \"release\" / \"manifest.yaml\",\n        prompt_dir=root / \"prompts\",\n        policy_path=root / \"config\" / \"policy.yaml\",\n        tools_path=root / \"config\" / \"tools.yaml\",\n        operational_owner=_env(\"OPERATIONAL_OWNER\", \"team-procurement-platform\"),\n        image_digest=_env(\"IMAGE_DIGEST\"),\n    )\n(eval):1: no matches found: --include=*.py","is_error":false}]},"parent_tool_use_id":null,"session_id":"9e0f4be1-06af-48e9-9d5f-af8285e70db3","uuid":"d2ce3cba-00c0-4db1-a7df-5ccfb23d345e","timestam