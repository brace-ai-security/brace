{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XEh62y5UFo2GNuaPVPyG7b","type":"tool_result","content":"1\t\"\"\"Operator stop control.\n2\t\n3\tOperators halt the fleet or one business unit by setting a row in\n4\t``control_flags`` with the ``procurement_ops`` database role (see\n5\tops/README in the platform runbook). The agent's own database role has\n6\tSELECT only on this table, so the agent cannot clear or delay a halt.\n7\t\"\"\"\n8\tfrom __future__ import annotations\n9\t\n10\t\n11\tclass AgentHalted(Exception):\n12\t    pass\n13\t\n14\t\n15\t_QUERY = \"\"\"\n16\tSELECT scope, reason, set_by, set_at\n17\tFROM control_flags\n18\tWHERE halted\n19\t  AND (scope = 'fleet' OR scope = $1)\n20\tORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\n21\tLIMIT 1\n22\t\"\"\"\n23\t\n24\t\n25\tasync def assert_running(pool, tenant: str) -> None:\n26\t    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n27\t    if row is not None:\n28\t        raise AgentHalted(\n29\t            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n30\t            f\"(scope={row['scope']}): {row['reason']}\"\n31\t        )\n32\t"}]},"parent_tool_use_id":null,"session_id":"7640e8ab-a39a-40b3-bc03-66675d3b8e23","uuid":"884b1214-a846-4c4d-bbcf-79d438e2a5fb","timestamp":"2026-10-02T16:09:30.540Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-boc7ec6b/agent/app/killswitch.py","content":"\"\"\"Operator stop control.\n\nOperators halt the fleet or one business unit by setting a row in\n``control_flags`` with the ``procurement_ops`` database role (see\nops/README in the platform runbook). The agent's own database role has\nSELECT only on this table, so the agent cannot clear or delay a halt.\n\"\"\"\nfrom __future__ import annotations\n\n\nclass AgentHalted(Exception):\n    pass\n\n\n_QUERY = \"\"\"\nSELECT scope, reason, set_by, set_at\nFROM control_flags\nWHERE halted\n  AND (scope = 'fleet' OR scope = $1)\nORDER BY CASE WHEN scope = 'fleet' THEN 0 ELSE 1 END\nLIMIT 1\n\"\"\"\n\n\nasync def assert_running(pool, tenant: str) -> None:\n    row = await pool.fetchrow(_QUERY, f\"tenant:{tenant}\")\n    if row is not None:\n        raise AgentHalted(\n            f\"halted by {row['set_by']} at {row['set_at'].isoformat()} \"\n            f\"(scope={row['scope']}): {row['reason']}\"\n        )\n","numLines":32,"startLine":1,"totalLines":32}}}
