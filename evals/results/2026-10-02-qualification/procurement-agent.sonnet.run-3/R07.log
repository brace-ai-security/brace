{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CfdiBdT3bj9DXq6HhCMcC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UELGTB7FvPyvnMyXv9Bzhc","name":"Bash","input":{"command":"cd agent/app; cat -n context_size.py audit.py; cat -n loop.py | sed -n 1,45p; cat -n loop.py | sed -n 66,128p; cat -n loop.py | sed -n 153,400p; cat ../migrations/001_init.sql"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3835,"cache_read_input_tokens":6666,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3835},"output_tokens":9,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e0be3d74-fcbe-47e1-8f3c-c64e0c54d4db","uuid":"a1c9f1bc-6f31-4975-9224-8fafa141726f","timestamp":"2026-10-02T16:16:54.070Z","request_id":"req_011CfdiBd2FypRw91FSVZEZu","wire_tool_inputs":{"toolu_01UELGTB7FvPyvnMyXv9Bzhc":{"command":"cd agent/app; cat -n context_size.py audit.py; cat -n loop.py | sed -n 1,45p; cat -n loop.py | sed -n 66,128p; cat -n loop.py | sed -n 153,400p; cat ../migrations/001_init.sql"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UELGTB7FvPyvnMyXv9Bzhc","type":"tool_result","content":"     1\t\"\"\"Decision-time context size.\n     2\t\n     3\tCounting method (documented in README, \"Context size\"):\n     4\t\n     5\t1. Before each model call, the exact request (system prompt, messages and\n     6\t   tool schemas) is sent to the provider's token-counting endpoint. The\n     7\t   returned ``input_tokens`` is recorded with method ``count_tokens_api``.\n     8\t   This is the size of the context the model decides on, including any\n     9\t   prefix that will be served from the prompt cache.\n    10\t2. If counting fails, the value is taken after the call from the response\n    11\t   usage as ``input_tokens + cache_read_input_tokens +\n    12\t   cache_creation_input_tokens`` and recorded with method\n    13\t   ``usage_sum_estimate``.\n    14\t3. If neither is available the value is ``NULL`` with method\n    15\t   ``unavailable``. It is never recorded as zero.\n    16\t\n    17\t``compacted`` is true when the harness dropped or summarized earlier turns\n    18\tbefore this call. Provider-side truncation is not visible to the harness and\n    19\tis listed as a known limit.\n    20\t\"\"\"\n    21\tfrom __future__ import annotations\n    22\t\n    23\timport logging\n    24\tfrom dataclasses import dataclass, replace\n    25\t\n    26\tlog = logging.getLogger(__name__)\n    27\t\n    28\t\n    29\t@dataclass(frozen=True)\n    30\tclass ContextMeasure:\n    31\t    tokens: int | None\n    32\t    method: str\n    33\t    compacted: bool\n    34\t\n    35\t    @classmethod\n    36\t    def unavailable(cls, compacted: bool = False) -> \"ContextMeasure\":\n    37\t        return cls(tokens=None, method=\"unavailable\", compacted=compacted)\n    38\t\n    39\t    def finalize(self, usage) -> \"ContextMeasure\":\n    40\t        if self.tokens is not None:\n    41\t            return self\n    42\t        if usage is None:\n    43\t            return ContextMeasure.unavailable(self.compacted)\n    44\t        total = (\n    45\t            int(usage.input_tokens or 0)\n    46\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n    47\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n    48\t        )\n    49\t        if total <= 0:\n    50\t            return ContextMeasure.unavailable(self.compacted)\n    51\t        return replace(self, tokens=total, method=\"usage_sum_estimate\")\n    52\t\n    53\t    def otel_attributes(self) -> dict:\n    54\t        attrs = {\n    55\t            \"procurement.context.method\": self.method,\n    56\t            \"gen_ai.conversation.compacted\": self.compacted,\n    57\t        }\n    58\t        if self.tokens is not None:\n    59\t            attrs[\"procurement.context.tokens\"] = self.tokens\n    60\t        return attrs\n    61\t\n    62\t\n    63\tasync def measure_context(client, request: dict, compacted: bool) -> ContextMeasure:\n    64\t    try:\n    65\t        counted = await client.messages.count_tokens(\n    66\t            model=request[\"model\"],\n    67\t            system=request[\"system\"],\n    68\t            messages=request[\"messages\"],\n    69\t            tools=request[\"tools\"],\n    70\t        )\n    71\t        return ContextMeasure(int(counted.input_tokens), \"count_tokens_api\", compacted)\n    72\t    except Exception:  # counting is best effort; finalize() falls back to usage\n    73\t        log.warning(\"token count failed; falling back to usage\", exc_info=True)\n    74\t        return ContextMeasure(tokens=None, method=\"pending_usage\", compacted=compacted)\n     1\t\"\"\"Execution audit graph.\n     2\t\n     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n     5\ttool call -> authorization decision -> result or error. Writes are\n     6\tsynchronous and are made before the action they describe; if the write\n     7\tfails, the caller raises and the action does not run.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport hashlib\n    12\timport json\n    13\timport uuid\n    14\tfrom datetime import datetime, timezone\n    15\tfrom typing import Any\n    16\t\n    17\tfrom opentelemetry import trace\n    18\t\n    19\tfrom app.context_size import ContextMeasure\n    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n    21\tfrom app.redact import redact_value\n    22\t\n    23\tEVENT_KINDS = {\n    24\t    \"run_started\",\n    25\t    \"run_finished\",\n    26\t    \"run_halted\",\n    27\t    \"model_decision\",\n    28\t    \"tool_proposed\",\n    29\t    \"authz_decision\",\n    30\t    \"approval_requested\",\n    31\t    \"approval_decided\",\n    32\t    \"tool_result\",\n    33\t    \"tool_error\",\n    34\t    \"tool_denied\",\n    35\t    \"budget_exceeded\",\n    36\t    \"subagent_started\",\n    37\t    \"subagent_finished\",\n    38\t    \"background_job\",\n    39\t}\n    40\t\n    41\t_INSERT = \"\"\"\n    42\tINSERT INTO audit_events (\n    43\t    node_id, parent_node_id, run_id, ts, kind,\n    44\t    accountable_party, operational_owner, tenant,\n    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n    46\t    delegated_subject, agent_principal, parent_instance_id,\n    47\t    policy_version, approval_id, operation_id,\n    48\t    context_tokens, context_method, context_compacted,\n    49\t    payload\n    50\t) VALUES (\n    51\t    $1, $2, $3, $4, $5,\n    52\t    $6, $7, $8,\n    53\t    $9, $10, $11, $12,\n    54\t    $13, $14, $15,\n    55\t    $16, $17, $18,\n    56\t    $19, $20, $21,\n    57\t    $22::jsonb\n    58\t)\n    59\t\"\"\"\n    60\t\n    61\t\n    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n    64\t    return {k: redact_value(v) for k, v in args.items()}\n    65\t\n    66\t\n    67\tdef digest(value: Any) -> str:\n    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    70\t\n    71\t\n    72\tasync def record(\n    73\t    pool,\n    74\t    ident: RunIdentity,\n    75\t    *,\n    76\t    kind: str,\n    77\t    payload: dict[str, Any] | None = None,\n    78\t    parent: str | None = None,\n    79\t    context: ContextMeasure | None = None,\n    80\t    policy_version: str | None = None,\n    81\t    approval_id: str | None = None,\n    82\t    operation_id: str | None = None,\n    83\t) -> str:\n    84\t    if kind not in EVENT_KINDS:\n    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n    86\t    for name in IDENTITY_FIELDS:\n    87\t        if not getattr(ident, name):\n    88\t            raise ValueError(f\"audit record missing {name}\")\n    89\t    span_ctx = trace.get_current_span().get_span_context()\n    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n    91\t    node_id = f\"node-{uuid.uuid4()}\"\n    92\t    measure = context or ContextMeasure.unavailable()\n    93\t    await pool.execute(\n    94\t        _INSERT,\n    95\t        node_id,\n    96\t        parent,\n    97\t        ident.run_id,\n    98\t        datetime.now(timezone.utc),\n    99\t        kind,\n   100\t        ident.accountable_party,\n   101\t        ident.operational_owner,\n   102\t        ident.tenant,\n   103\t        ident.agent_type_id,\n   104\t        ident.agent_instance_id,\n   105\t        ident.trace_id,\n   106\t        span_id,\n   107\t        ident.delegated_subject,\n   108\t        ident.agent_principal,\n   109\t        ident.parent_instance_id,\n   110\t        policy_version,\n   111\t        approval_id,\n   112\t        operation_id,\n   113\t        measure.tokens,\n   114\t        measure.method,\n   115\t        measure.compacted,\n   116\t        json.dumps(redact_value(payload or {}), default=str),\n   117\t    )\n   118\t    return node_id\n     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n-- Procurement agent schema. Applied by the migration job with the\n-- procurement_owner role; the running agent connects as procurement_agent.\n\nCREATE TABLE audit_events (\n    node_id             text PRIMARY KEY,\n    parent_node_id      text REFERENCES audit_events (node_id),\n    run_id              text NOT NULL,\n    ts                  timestamptz NOT NULL,\n    kind                text NOT NULL,\n    accountable_party   text NOT NULL CHECK (accountable_party <> ''),\n    operational_owner   text NOT NULL CHECK (operational_owner <> ''),\n    tenant              text NOT NULL CHECK (tenant <> ''),\n    agent_type_id       text NOT NULL CHECK (agent_type_id <> ''),\n    agent_instance_id   text NOT NULL CHECK (agent_instance_id <> ''),\n    trace_id            text NOT NULL CHECK (trace_id <> ''),\n    span_id             text,\n    delegated_subject   text NOT NULL,\n    agent_principal     text NOT NULL,\n    parent_instance_id  text,\n    policy_version      text,\n    approval_id         text,\n    operation_id        text,\n    context_tokens      integer CHECK (context_tokens IS NULL OR context_tokens > 0),\n    context_method      text NOT NULL,\n    context_compacted   boolean NOT NULL,\n    payload             jsonb NOT NULL\n);\nCREATE INDEX audit_events_run ON audit_events (run_id, ts);\nCREATE INDEX audit_events_instance ON audit_events (agent_instance_id, ts);\nCREATE INDEX audit_events_trace ON audit_events (trace_id);\n\nCREATE TABLE approvals (\n    id                     text PRIMARY KEY,\n    tool                   text NOT NULL,\n    target                 text NOT NULL,\n    args_sha256            text NOT NULL,\n    args_summary           jsonb NOT NULL,\n    tenant                 text NOT NULL,\n    requested_by_instance  text NOT NULL,\n    requested_by_run       text NOT NULL,\n    delegated_subject      text NOT NULL,\n    status                 text NOT NULL CHECK (status IN ('pending', 'approved', 'rejected', 'expired')),\n    requested_at           timestamptz NOT NULL,\n    expires_at             timestamptz NOT NULL,\n    approver               text,\n    approver_role          text,\n    decided_at             timestamptz\n);\nCREATE INDEX approvals_lookup ON approvals (tool, target, tenant, status);\n\nCREATE TABLE approvers (\n    slack_user_id  text PRIMARY KEY,\n    email          text NOT NULL,\n    role           text NOT NULL,\n    business_unit  text NOT NULL,\n    active         boolean NOT NULL DEFAULT true\n);\n\nCREATE TABLE documents (\n    doc_id         text PRIMARY KEY,\n    business_unit  text NOT NULL,\n    source         text NOT NULL,\n    media_type     text NOT NULL,\n    sha256         text NOT NULL,\n    status         text NOT NULL CHECK (status IN ('accepted', 'quarantined')),\n    reject_reason  text,\n    text           text,\n    received_at    timestamptz NOT NULL\n);\nCREATE INDEX documents_bu ON documents (business_unit, doc_id);\n\nCREATE TABLE dept_notes (\n    note_id            text PRIMARY KEY,\n    business_unit      text NOT NULL,\n    department         text NOT NULL,\n    kind               text NOT NULL,\n    body               text NOT NULL,\n    verified           boolean NOT NULL DEFAULT false,\n    verified_by        text,\n    quarantined        boolean NOT NULL DEFAULT false,\n    expires_at         timestamptz,\n    writer_instance    text NOT NULL,\n    writer_type_id     text NOT NULL,\n    run_id             text NOT NULL,\n    source_doc_id      text,\n    delegated_subject  text NOT NULL,\n    context_tokens     integer,\n    context_method     text NOT NULL,\n    created_at         timestamptz NOT NULL\n);\nCREATE INDEX dept_notes_lookup ON dept_notes (business_unit, department, created_at DESC);\nCREATE INDEX dept_notes_source ON dept_notes (source_doc_id);\nCREATE INDEX dept_notes_writer ON dept_notes (writer_instance);\n\nCREATE TABLE control_flags (\n    scope    text PRIMARY KEY,           -- 'fleet' or 'tenant:<business_unit>'\n    halted   boolean NOT NULL,\n    reason   text NOT NULL,\n    set_by   text NOT NULL,\n    set_at   timestamptz NOT NULL DEFAULT now()\n);\n\nCREATE TABLE spend_quota (\n    scope      text NOT NULL,\n    key        text NOT NULL,\n    day        date NOT NULL,\n    spent_usd  numeric(12, 4) NOT NULL,\n    PRIMARY KEY (scope, key, day)\n);\n\nCREATE TABLE run_start_window (\n    scope   text NOT NULL,\n    key     text NOT NULL,\n    minute  timestamptz NOT NULL,\n    starts  integer NOT NULL,\n    PRIMARY KEY (scope, key, minute)\n);\n\n-- Runtime role: append-only audit, no access to control flags beyond reading.\nREVOKE ALL ON ALL TABLES IN SCHEMA public FROM procurement_agent;\nGRANT SELECT, INSERT ON audit_events TO procurement_agent;\nGRANT SELECT, INSERT, UPDATE ON approvals TO procurement_agent;\nGRANT SELECT ON approvers TO procurement_agent;\nGRANT SELECT, INSERT ON documents TO procurement_agent;\nGRANT SELECT, INSERT ON dept_notes TO procurement_agent;\nGRANT SELECT ON control_flags TO procurement_agent;\nGRANT SELECT, INSERT, UPDATE ON spend_quota TO procurement_agent;\nGRANT SELECT, INSERT, UPDATE ON run_start_window TO procurement_agent;\n\n-- Operators: halt and resume.\nGRANT SELECT, INSERT, UPDATE ON control_flags TO procurement_ops;\nGRANT SELECT ON audit_events TO procurement_ops;\nGRANT SELECT, UPDATE (verified, verified_by, quarantined) ON dept_notes TO procurement_ops;","is_error":false}]},"parent_tool_use_id":null,"session_id":"e0be3d74-fcbe-47e1-8f3c-c64e0c54d4db","uuid":"9054cac0-da73-406c-9c79-6a0bfce885ca","timestamp":"2026-10-02T16:16:54.210Z","tool_use_result":{"stdout":"     1\t\"\"\"Decision-time context size.\n     2\t\n     3\tCounting method (documented in README, \"Context size\"):\n     4\t\n     5\t1. Before each model call, the exact request (system prompt, messages and\n     6\t   tool schemas) is sent to the provider's token-counting endpoint. The\n     7\t   returned ``input_tokens`` is recorded with method ``count_tokens_api``.\n     8\t   This is the size of the context the model decides on, including any\n     9\t   prefix that will be served from the prompt cache.\n    10\t2. If counting fails, the value is taken after the call from the response\n    11\t   usage as ``input_tokens + cache_read_input_tokens +\n    12\t   cache_creation_input_tokens`` and recorded with method\n    13\t   ``usage_sum_estimate``.\n    14\t3. If neither is available the value is ``NULL`` with method\n    15\t   ``unavailable``. It is never recorded as zero.\n    16\t\n    17\t``compacted`` is true when the harness dropped or summarized earlier turns\n    18\tbefore this call. Provider-side truncation is not visible to the harness and\n    19\tis listed as a known limit.\n    20\t\"\"\"\n    21\tfrom __future__ import annotations\n    22\t\n    23\timport logging\n    24\tfrom dataclasses import dataclass, replace\n    25\t\n    26\tlog = logging.getLogger(__name__)\n    27\t\n    28\t\n    29\t@dataclass(frozen=True)\n    30\tclass ContextMeasure:\n    31\t    tokens: int | None\n    32\t    method: str\n    33\t    compacted: bool\n    34\t\n    35\t    @classmethod\n    36\t    def unavailable(cls, compacted: bool = False) -> \"ContextMeasure\":\n    37\t        return cls(tokens=None, method=\"unavailable\", compacted=compacted)\n    38\t\n    39\t    def finalize(self, usage) -> \"ContextMeasure\":\n    40\t        if self.tokens is not None:\n    41\t            return self\n    42\t        if usage is None:\n    43\t            return ContextMeasure.unavailable(self.compacted)\n    44\t        total = (\n    45\t            int(usage.input_tokens or 0)\n    46\t            + int(getattr(usage, \"cache_read_input_tokens\", 0) or 0)\n    47\t            + int(getattr(usage, \"cache_creation_input_tokens\", 0) or 0)\n    48\t        )\n    49\t        if total <= 0:\n    50\t            return ContextMeasure.unavailable(self.compacted)\n    51\t        return replace(self, tokens=total, method=\"usage_sum_estimate\")\n    52\t\n    53\t    def otel_attributes(self) -> dict:\n    54\t        attrs = {\n    55\t            \"procurement.context.method\": self.method,\n    56\t            \"gen_ai.conversation.compacted\": self.compacted,\n    57\t        }\n    58\t        if self.tokens is not None:\n    59\t            attrs[\"procurement.context.tokens\"] = self.tokens\n    60\t        return attrs\n    61\t\n    62\t\n    63\tasync def measure_context(client, request: dict, compacted: bool) -> ContextMeasure:\n    64\t    try:\n    65\t        counted = await client.messages.count_tokens(\n    66\t            model=request[\"model\"],\n    67\t            system=request[\"system\"],\n    68\t            messages=request[\"messages\"],\n    69\t            tools=request[\"tools\"],\n    70\t        )\n    71\t        return ContextMeasure(int(counted.input_tokens), \"count_tokens_api\", compacted)\n    72\t    except Exception:  # counting is best effort; finalize() falls back to usage\n    73\t        log.warning(\"token count failed; falling back to usage\", exc_info=True)\n    74\t        return ContextMeasure(tokens=None, method=\"pending_usage\", compacted=compacted)\n     1\t\"\"\"Execution audit graph.\n     2\t\n     3\tEvery step of a run is one row in ``audit_events``. Rows link to their parent\n     4\tstep, so a run can be rebuilt as a tree: run -> model decision -> proposed\n     5\ttool call -> authorization decision -> result or error. Writes are\n     6\tsynchronous and are made before the action they describe; if the write\n     7\tfails, the caller raises and the action does not run.\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport hashlib\n    12\timport json\n    13\timport uuid\n    14\tfrom datetime import datetime, timezone\n    15\tfrom typing import Any\n    16\t\n    17\tfrom opentelemetry import trace\n    18\t\n    19\tfrom app.context_size import ContextMeasure\n    20\tfrom app.identity import IDENTITY_FIELDS, RunIdentity\n    21\tfrom app.redact import redact_value\n    22\t\n    23\tEVENT_KINDS = {\n    24\t    \"run_started\",\n    25\t    \"run_finished\",\n    26\t    \"run_halted\",\n    27\t    \"model_decision\",\n    28\t    \"tool_proposed\",\n    29\t    \"authz_decision\",\n    30\t    \"approval_requested\",\n    31\t    \"approval_decided\",\n    32\t    \"tool_result\",\n    33\t    \"tool_error\",\n    34\t    \"tool_denied\",\n    35\t    \"budget_exceeded\",\n    36\t    \"subagent_started\",\n    37\t    \"subagent_finished\",\n    38\t    \"background_job\",\n    39\t}\n    40\t\n    41\t_INSERT = \"\"\"\n    42\tINSERT INTO audit_events (\n    43\t    node_id, parent_node_id, run_id, ts, kind,\n    44\t    accountable_party, operational_owner, tenant,\n    45\t    agent_type_id, agent_instance_id, trace_id, span_id,\n    46\t    delegated_subject, agent_principal, parent_instance_id,\n    47\t    policy_version, approval_id, operation_id,\n    48\t    context_tokens, context_method, context_compacted,\n    49\t    payload\n    50\t) VALUES (\n    51\t    $1, $2, $3, $4, $5,\n    52\t    $6, $7, $8,\n    53\t    $9, $10, $11, $12,\n    54\t    $13, $14, $15,\n    55\t    $16, $17, $18,\n    56\t    $19, $20, $21,\n    57\t    $22::jsonb\n    58\t)\n    59\t\"\"\"\n    60\t\n    61\t\n    62\tdef summarize_args(args: dict[str, Any]) -> dict[str, Any]:\n    63\t    \"\"\"Key arguments for the record, with secrets and account numbers redacted.\"\"\"\n    64\t    return {k: redact_value(v) for k, v in args.items()}\n    65\t\n    66\t\n    67\tdef digest(value: Any) -> str:\n    68\t    raw = json.dumps(value, sort_keys=True, default=str, separators=(\",\", \":\"))\n    69\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n    70\t\n    71\t\n    72\tasync def record(\n    73\t    pool,\n    74\t    ident: RunIdentity,\n    75\t    *,\n    76\t    kind: str,\n    77\t    payload: dict[str, Any] | None = None,\n    78\t    parent: str | None = None,\n    79\t    context: ContextMeasure | None = None,\n    80\t    policy_version: str | None = None,\n    81\t    approval_id: str | None = None,\n    82\t    operation_id: str | None = None,\n    83\t) -> str:\n    84\t    if kind not in EVENT_KINDS:\n    85\t        raise ValueError(f\"unknown audit kind {kind}\")\n    86\t    for name in IDENTITY_FIELDS:\n    87\t        if not getattr(ident, name):\n    88\t            raise ValueError(f\"audit record missing {name}\")\n    89\t    span_ctx = trace.get_current_span().get_span_context()\n    90\t    span_id = format(span_ctx.span_id, \"016x\") if span_ctx.is_valid else None\n    91\t    node_id = f\"node-{uuid.uuid4()}\"\n    92\t    measure = context or ContextMeasure.unavailable()\n    93\t    await pool.execute(\n    94\t        _INSERT,\n    95\t        node_id,\n    96\t        parent,\n    97\t        ident.run_id,\n    98\t        datetime.now(timezone.utc),\n    99\t        kind,\n   100\t        ident.accountable_party,\n   101\t        ident.operational_owner,\n   102\t        ident.tenant,\n   103\t        ident.agent_type_id,\n   104\t        ident.agent_instance_id,\n   105\t        ident.trace_id,\n   106\t        span_id,\n   107\t        ident.delegated_subject,\n   108\t        ident.agent_principal,\n   109\t        ident.parent_instance_id,\n   110\t        policy_version,\n   111\t        approval_id,\n   112\t        operation_id,\n   113\t        measure.tokens,\n   114\t        measure.method,\n   115\t        measure.compacted,\n   116\t        json.dumps(redact_value(payload or {}), default=str),\n   117\t    )\n   118\t    return node_id\n     1\t\"\"\"Procurement agent run loop.\n     2\t\n     3\tGraph: model turn -> (tool calls -> gate -> integration)* -> model turn ...\n     4\tEvery edge writes an audit node before the next step runs. Budgets are\n     5\tchecked before each model turn and each tool call.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport logging\n    11\tfrom dataclasses import dataclass, field\n    12\tfrom typing import Any\n    13\t\n    14\tfrom opentelemetry import trace\n    15\t\n    16\tfrom app import audit, killswitch\n    17\tfrom app.budget import Budget, BudgetExceeded\n    18\tfrom app.context_size import ContextMeasure, measure_context\n    19\tfrom app.gate import PolicyGate\n    20\tfrom app.identity import RunIdentity\n    21\tfrom app.redact import redact_for_model\n    22\tfrom app.tools import ToolRegistry, build_registry\n    23\t\n    24\tlog = logging.getLogger(__name__)\n    25\ttracer = trace.get_tracer(\"procurement.loop\")\n    26\t\n    27\tCOMPACT_AFTER_MESSAGES = 40\n    28\tKEEP_RECENT_MESSAGES = 12\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass AgentDeps:\n    33\t    settings: Any\n    34\t    pool: Any\n    35\t    gate: PolicyGate\n    36\t    erp: Any\n    37\t    slack: Any\n    38\t    broker: Any\n    39\t    extractor: Any = None\n    40\t    _budgets: dict[str, Budget] = field(default_factory=dict)\n    41\t    _contexts: dict[str, ContextMeasure] = field(default_factory=dict)\n    42\t\n    43\t    def current_budget(self, ident: RunIdentity) -> Budget:\n    44\t        return self._budgets[ident.run_id]\n    45\t\n    66\t\n    67\t        decision = await self.gate.authorize(ident, tool, use.input)\n    68\t        authz = await audit.record(\n    69\t            self.pool, ident, kind=\"authz_decision\", parent=proposed, context=ctx,\n    70\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    71\t            payload={\"allow\": decision.allow, \"reason\": decision.reason, \"pending\": decision.pending},\n    72\t        )\n    73\t        if not decision.allow:\n    74\t            if decision.pending:\n    75\t                return _error(use.id, f\"approval requested ({decision.approval_id}); do not retry until approved\")\n    76\t            return _error(use.id, f\"denied: {decision.reason}\")\n    77\t\n    78\t        operation_id = f\"op-{hashlib.sha256((authz + use.id).encode()).hexdigest()[:24]}\"\n    79\t        try:\n    80\t            with tracer.start_as_current_span(f\"execute_tool {use.name}\") as span:\n    81\t                for k, v in ctx.otel_attributes().items():\n    82\t                    span.set_attribute(k, v)\n    83\t                output = await tool.invoke(use.input, ident)\n    84\t        except BudgetExceeded:\n    85\t            raise\n    86\t        except Exception as exc:\n    87\t            await audit.record(\n    88\t                self.pool, ident, kind=\"tool_error\", parent=authz, context=ctx,\n    89\t                policy_version=decision.policy_version, approval_id=decision.approval_id,\n    90\t                operation_id=operation_id,\n    91\t                payload={\"error_type\": type(exc).__name__, \"error\": str(exc)[:500]},\n    92\t            )\n    93\t            return _error(use.id, f\"{use.name} failed: {type(exc).__name__}\")\n    94\t\n    95\t        await audit.record(\n    96\t            self.pool, ident, kind=\"tool_result\", parent=authz, context=ctx,\n    97\t            policy_version=decision.policy_version, approval_id=decision.approval_id,\n    98\t            operation_id=operation_id,\n    99\t            payload={\"result_sha256\": audit.digest(output), \"result\": output},\n   100\t        )\n   101\t        return {\"type\": \"tool_result\", \"tool_use_id\": use.id, \"content\": redact_for_model(output)}\n   102\t\n   103\t\n   104\tdef _error(tool_use_id: str, message: str) -> dict:\n   105\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"is_error\": True, \"content\": message}\n   106\t\n   107\t\n   108\tdef _compact(messages: list[dict]) -> tuple[list[dict], bool]:\n   109\t    if len(messages) <= COMPACT_AFTER_MESSAGES:\n   110\t        return messages, False\n   111\t    head, tail = messages[:1], messages[-KEEP_RECENT_MESSAGES:]\n   112\t    while tail and tail[0][\"role\"] != \"assistant\":\n   113\t        tail = tail[1:]\n   114\t    note = {\"role\": \"user\", \"content\": \"[earlier tool exchanges were removed to save space]\"}\n   115\t    return head + [note] + tail, True\n   116\t\n   117\t\n   118\tclass ProcurementAgent:\n   119\t    def __init__(self, *, client, deps: AgentDeps, system_prompt: str, role: str = \"procurement\"):\n   120\t        self.client = client\n   121\t        self.deps = deps\n   122\t        self.system_prompt = system_prompt\n   123\t        self.role = role\n   124\t\n   125\t    async def run(self, ident: RunIdentity, task: str) -> str | None:\n   126\t        pool = self.deps.pool\n   127\t        await killswitch.assert_running(pool, ident.tenant)\n   128\t        budget = Budget.for_run(self.deps.settings.budgets, ident)\n   153\t                ctx = ctx.finalize(response.usage)\n   154\t                decision = await audit.record(\n   155\t                    pool, ident, kind=\"model_decision\", parent=run_node, context=ctx,\n   156\t                    payload={\n   157\t                        \"requested_model\": request[\"model\"],\n   158\t                        \"served_model\": response.model,\n   159\t                        \"stop_reason\": response.stop_reason,\n   160\t                        \"proposed_tools\": [b.name for b in response.content if b.type == \"tool_use\"],\n   161\t                    },\n   162\t                )\n   163\t                messages.append({\"role\": \"assistant\", \"content\": response.content})\n   164\t                uses = [b for b in response.content if b.type == \"tool_use\"]\n   165\t                if not uses:\n   166\t                    final = \"\".join(b.text for b in response.content if b.type == \"text\")\n   167\t                    await audit.record(pool, ident, kind=\"run_finished\", parent=run_node, context=ctx,\n   168\t                                       payload={\"final_sha256\": audit.digest(final)})\n   169\t                    return final\n   170\t                results = []\n   171\t                for use in uses:\n   172\t                    budget.check_tool_call()\n   173\t                    results.append(await self.deps.execute_tool(ident, registry, use, decision, ctx))\n   174\t                messages.append({\"role\": \"user\", \"content\": results})\n   175\t        except BudgetExceeded as exc:\n   176\t            await audit.record(\n   177\t                pool, ident, kind=\"budget_exceeded\", parent=run_node,\n   178\t                payload={\"limit\": exc.limit, \"used\": str(exc.used), \"allowed\": str(exc.allowed)},\n   179\t            )\n   180\t            await self.deps.slack.post(\n   181\t                channel=\"#procurement-agent-ops\",\n   182\t                text=f\"Run {ident.run_id} ({ident.tenant}) stopped: {exc.limit} exceeded.\",\n   183\t            )\n   184\t            return None\n   185\t        finally:\n   186\t            self.deps._budgets.pop(ident.run_id, None)\n-- Procurement agent schema. Applied by the migration job with the\n-- procurement_owner role; the running agent connects as procurement_agent.\n\nCREATE TABLE audit_events (\n    node_id             text PRIMARY KEY,\n    parent_node_id      text REFERENCES audit_events (node_id),\n    run_id              text NOT NULL,\n    ts                  timestamptz NOT NULL,\n    kind                text NOT NULL,\n    accountable_party   text NOT NULL CHECK (accountable_party <> ''),\n    operational_owner   text NOT NULL CHECK (operational_owner <> ''),\n    tenant              text NOT NULL CHECK (tenant <> ''),\n    agent_type_id       text NOT NULL CHECK (agent_type_id <> ''),\n    agent_instance_id   text NOT NULL CHECK (agent_instance_id <> ''),\n    trace_id            text NOT NULL CHECK (trace_id <> ''),\n    span_id             text,\n    delegated_subject   text NOT NULL,\n    agent_principal     text NOT NULL,\n    parent_instance_id  text,\n    policy_version      text,\n    approval_id         text,\n    operation_id        text,\n    context_tokens      integer CHECK (context_tokens IS NULL OR context_tokens > 0),\n    context_method      text NOT NULL,\n    context_compacted   boolean NOT NULL,\n    payload             jsonb NOT NULL\n);\nCREATE INDEX audit_events_run ON audit_events (run_id, ts);\nCREATE INDEX audit_events_instance ON audit_events (agent_instance_id, ts);\nCREATE INDEX audit_events_trace ON audit_events (trace_id);\n\nCREATE TABLE approvals (\n    id                     text PRIMARY KEY,\n    tool                   text NOT NULL,\n    target                 text NOT NULL,\n    args_sha256            text NOT NULL,\n    args_summary           jsonb NOT NULL,\n    tenant                 text NOT NULL,\n    requested_by_instance  text NOT NULL,\n    requested_by_run       text NOT NULL,\n    delegated_subject      text NOT NULL,\n    status                 text NOT NULL CHECK (status IN ('pending', 'approved', 'rejected', 'expired')),\n    requested_at           timestamptz NOT NULL,\n    expires_at             timestamptz NOT NULL,\n    approver               text,\n    approver_role          text,\n    decided_at             timestamptz\n);\nCREATE INDEX approvals_lookup ON approvals (tool, target, tenant, status);\n\nCREATE TABLE approvers (\n    slack_user_id  text PRIMARY KEY,\n    email          text NOT NULL,\n    role           text NOT NULL,\n    business_unit  text NOT NULL,\n    active         boolean NOT NULL DEFAULT true\n);\n\nCREATE TABLE documents (\n    doc_id         text PRIMARY KEY,\n    business_unit  text NOT NULL,\n    source         text NOT NULL,\n    media_type     text NOT NULL,\n    sha256         text NOT NULL,\n    status         text NOT NULL CHECK (status IN ('accepted', 'quarantined')),\n    reject_reason  text,\n    text           text,\n    received_at    timestamptz NOT NULL\n);\nCREATE INDEX documents_bu ON documents (business_unit, doc_id);\n\nCREATE TABLE dept_notes (\n    note_id            text PRIMARY KEY,\n    business_unit      text NOT NULL,\n    department         text NOT NULL,\n    kind               text NOT NULL,\n    body               text NOT NULL,\n    verified           boolean NOT NULL DEFAULT false,\n    verified_by        text,\n    quarantined        boolean NOT NULL DEFAULT false,\n    expires_at         timestamptz,\n    writer_instance    text NOT NULL,\n    writer_type_id     text NOT NULL,\n    run_id             text NOT NULL,\n    source_doc_id      text,\n    delegated_subject  text NOT NULL,\n    context_tokens     integer,\n    context_method     text NOT NULL,\n    created_at         timestamptz NOT NULL\n);\nCREATE INDEX dept_notes_lookup ON dept_notes (business_unit, department, created_at DESC);\nCREATE INDEX dept_notes_source ON dept_notes (source_doc_id);\nCREATE INDEX dept_notes_writer ON dept_notes (writer_instance);\n\nCREATE TABLE control_flags (\n    scope    text PRIMARY KEY,           -- 'fleet' or 'tenant:<business_unit>'\n    halted   boolean NOT NULL,\n    reason   text NOT NULL,\n    set_by   text NOT NULL,\n    set_at   timestamptz NOT NULL DEFAULT now()\n);\n\nCREATE TABLE spend_quota (\n    scope      text NOT NULL,\n    key        text NOT NULL,\n    day        date NOT NULL,\n    spent_usd  numeric(12, 4) NOT NULL,\n    PRIMARY KEY (scope, key, day)\n);\n\nCREATE TABLE run_start_window (\n    scope   text NOT NULL,\n    key     text NOT NULL,\n    minute  timestamptz NOT NULL,\n    starts  integer NOT NULL,\n    PRIMARY KEY (scope, key, minute)\n);\n\n-- Runtime role: append-only audit, no access to control flags beyond reading.\nREVOKE ALL ON ALL TABLES IN SCHEMA public FROM procurement_agent;\nGRANT SELECT, INSERT ON audit_events TO procurement_agent;\nGRANT SELECT, INSERT, UPDATE ON approvals TO procurement_agent;\nGRANT SELECT ON approvers TO procurement_agent;\nGRANT SELECT, INSERT ON documents TO procurement_agent;\nGRANT SELECT, INSERT ON dept_notes TO procurement_agent;\nGRANT SELECT ON control_flags TO procurement_agent;\nGRANT SELECT, INSERT, UPDATE ON spend_quota TO procurement_agent;\nGRANT SELECT, INSERT, UPDATE ON run_start_window TO procurement_agent;\n\n-- Operators: halt and resume.\nGRANT SELECT, INSERT, UPDATE ON control_flags TO procurement_ops;\nGRANT SELECT ON audit_events TO procurement_ops;\nGRANT SELECT, UPDATE (verified, verified_by, quarantined) ON dept_notes TO procurement_ops;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
