{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PTQqR3e7TG5juKrHdAgGRq","type":"tool_result","content":"import pino from \"pino\";\nimport { manifest } from \"../config.js\";\nimport { audit } from \"../audit/recorder.js\";\nimport { computeAgentTypeId, newRunContext, setAgentTypeId } from \"../agent/identity.js\";\nimport { Halted, killSwitch } from \"../control/kill-switch.js\";\nimport { ehr as ehrClient } from \"../integrations/ehr-mcp.js\";\nimport { render, sms } from \"../integrations/sms.js\";\n\n// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.\nconst log = pino({ level: \"info\" });\n\nconst directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\nsetAgentTypeId(\n  computeAgentTypeId({\n    imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    harnessVersion: manifest.harness.version,\n    harnessGitSha: process.env.GIT_SHA ?? \"\",\n  }),\n);\n\nconst ehr = ehrClient(manifest.tools.mcpServers.find((s: { id: string }) => s.id === \"ehr\"));\nconst tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);\n\nfor (const clinic of directory) {\n  const ctx = newRunContext({ tenantId: clinic.id, subject: { kind: \"system\", id: \"reminders-cron\" }, channel: \"reminder\", log });\n  const abort = new AbortController();\n  const unregister = killSwitch.register(ctx.runId, clinic.id, abort);\n  try {\n    await killSwitch.assertRunning(clinic.id);\n    const appts = await ehr.appointmentsOn(clinic.id, tomorrow, abort.signal);\n    for (const a of appts) {\n      if (!a.smsOptIn) continue;\n      await killSwitch.assertRunning(clinic.id);\n      const when = new Date(a.start).toLocaleString(\"en-US\", { weekday: \"short\", hour: \"numeric\", minute: \"2-digit\" });\n      const res = await sms.send(clinic.id, a.phone, render(\"reminder\", { firstName: \"\", when, location: a.locationName }), abort.signal);\n      await audit.record({\n        ...ctx.identity(),\n        runId: ctx.runId,\n        subject: ctx.subject,\n        event: \"reminder.sent\",\n        tool: \"sms__send_to_patient\",\n        // Scheduled, templated send: no model decided this action.\n        context: { tokens: null, status: \"unavailable\", method: \"no_model_decision\", cachedInputTokens: null, compacted: false },\n        detail: { appointmentId: a.id, messageId: res.messageId },\n      });\n    }\n  } catch (err) {\n    if (err instanceof Halted) {\n      log.warn({ clinic: clinic.id, scope: err.scope }, \"reminders halted\");\n      break;\n    }\n    log.error({ clinic: clinic.id, err: (err as Error).message }, \"reminder run failed\");\n    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \"run.stopped\", reason: (err as Error).message.slice(0, 200) });\n  } finally {\n    unregister();\n  }\n}\nprocess.exit(0);\nimport { audit } from \"../audit/recorder.js\";\nimport type { Ehr } from \"../integrations/ehr-mcp.js\";\nimport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\nimport { payments } from \"../integrations/payments.js\";\nimport type { RunContext } from \"../agent/identity.js\";\nimport type { ContextSize } from \"../agent/context-size.js\";\n\n// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n// agent, and settles the visit deposit when the plan covers the visit.\n\nexport async function checkEligibilityForAppointment(\n  ehr: Ehr,\n  input: { appointmentId: string },\n  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n): Promise<Eligibility & { depositRefundId?: string }> {\n  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n\n  const result = await checkEligibility(\n    {\n      clinicId: opts.clinicId,\n      patientId: appt.patientId,\n      payerId: appt.payerId,\n      serviceCode: appt.serviceCode,\n      dateOfService: appt.start.slice(0, 10),\n    },\n    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n  );\n  await audit.record({\n    ...opts.ctx.identity(),\n    runId: opts.ctx.runId,\n    subject: opts.ctx.subject,\n    event: \"peer.call\",\n    tool: \"insurance__check_eligibility\",\n    context: opts.context,\n    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n  });\n\n  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n    const refund = await payments.refundDeposit(\n      opts.clinicId,\n      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n      opts.signal,\n    );\n    await audit.record({\n      ...opts.ctx.identity(),\n      runId: opts.ctx.runId,\n      subject: opts.ctx.subject,\n      event: \"payment.refund\",\n      tool: \"insurance__check_eligibility\",\n      context: opts.context,\n      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n    });\n    return { ...result, depositRefundId: refund.id };\n  }\n  return result;\n}\nimport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\nimport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\nimport { createHash, randomUUID } from \"node:crypto\";\nimport { env, policy } from \"../config.js\";\n\n// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n// approvedAt); the agent then retries the tool with the approval id.\n\nexport interface ApprovalRecord {\n  id: string;\n  status: \"pending\" | \"approved\" | \"rejected\";\n  tool: string;\n  tenantId: string;\n  agentInstanceId: string;\n  runId: string;\n  argsHash: string;\n  summary: string;\n  requestedAt: string;\n  expiresAt: string;\n  approvedBy?: string;\n  approverRole?: string;\n  approvedAt?: string;\n}\n\nconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n\nexport function hashArgs(args: Record<string, unknown>): string {\n  const canonical = JSON.stringify(args, Object.keys(args).sort());\n  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n}\n\nexport async function requestApproval(req: {\n  tool: string;\n  tenantId: string;\n  agentInstanceId: string;\n  runId: string;\n  args: Record<string, unknown>;\n  summary: string;\n}): Promise<ApprovalRecord> {\n  const now = Date.now();\n  const rec: ApprovalRecord = {\n    id: randomUUID(),\n    status: \"pending\",\n    tool: req.tool,\n    tenantId: req.tenantId,\n    agentInstanceId: req.agentInstanceId,\n    runId: req.runId,\n    argsHash: hashArgs(req.args),\n    summary: req.summary,\n    requestedAt: new Date(now).toISOString(),\n    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n  };\n  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n  return rec;\n}\n\nexport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n\nexport async function checkApproval(req: {\n  approvalId: string;\n  tool: string;\n  tenantId: string;\n  args: Record<string, unknown>;\n}): Promise<ApprovalCheck> {\n  let rec: ApprovalRecord | undefined;\n  try {\n    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    rec = res.Item as ApprovalRecord | undefined;\n  } catch (err) {\n    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n  }\n  if (!rec) return { ok: false, reason: \"approval not found\" };\n  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    return { ok: false, reason: \"approver lacks authority\" };\n  }\n  return { ok: true, approval: rec };\n}\nimport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\nimport { env } from \"../config.js\";\n\n// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n// The provider enforces Idempotency-Key for 24 hours.\n\nconst sm = new SecretsManagerClient({ region: env.region });\nconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n\nasync function key(clinicId: string): Promise<string> {\n  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n}\n\nexport interface Refund {\n  id: string;\n  depositId: string;\n  amountCents: number;\n  status: \"pending\" | \"succeeded\" | \"failed\";\n}\n\nexport const payments = {\n  async refundDeposit(\n    clinicId: string,\n    req: { depositId: string; reason: string; idempotencyKey: string },\n    signal?: AbortSignal,\n  ): Promise<Refund> {\n    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n      method: \"POST\",\n      signal,\n      headers: {\n        authorization: `Bearer ${await key(clinicId)}`,\n        \"content-type\": \"application/json\",\n        \"idempotency-key\": req.idempotencyKey,\n      },\n      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    });\n    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    return (await res.json()) as Refund;\n  },\n};\n# clinic-agent\n\nPatient-scheduling agent for the Northbay Clinic Group. Patients reach it by SMS or by the web chat\nwidget on each clinic's site. It looks up, books, reschedules, and cancels appointments in the EHR,\nsends SMS reminders, refunds no-show deposits, and asks the insurance-eligibility agent whether a\nvisit is covered.\n\nEach clinic is a tenant. A clinic's patients, appointments, deposits, and EHR credentials are kept\nseparate from every other clinic's.\n\n## Components\n\n| Piece | Where | Notes |\n|---|---|---|\n| HTTP service (Fastify) | `src/server.ts` | `/v1/sms/inbound` webhook, `/v1/chat` web chat |\n| Agent loop | `src/agent/loop.ts` | Claude Sonnet 4.5 snapshot, tool use |\n| Intent classifier | `src/agent/classifier.ts` | Claude Haiku 4.5 snapshot, routes emergencies and complaints to staff |\n| Tool registry | `src/tools/registry.ts` | EHR MCP server plus native tools, scanned on load |\n| Tool executor | `src/tools/executor.ts` | allowlist, kill switch, budgets, approvals, audit |\n| EHR | `src/integrations/ehr-mcp.ts` | MCP over streamable HTTP with mTLS, per-clinic OAuth client |\n| Payments | `src/integrations/payments.ts` | deposit refunds, provider idempotency keys |\n| SMS | `src/integrations/sms.ts` | outbound reminders and replies |\n| Eligibility peer | `src/integrations/eligibility-a2a.ts` | A2A `message/send`, token exchange per call |\n| Reminder job | `src/workers/reminders.ts` | Kubernetes CronJob, 17:00 local each day |\n\nThere is no vector store and no conversation memory. Every run starts from the patient's message and\nthe EHR. Conversation transcripts are not stored by this service.\n\n## High-impact actions\n\n`config/policy.yaml` lists the tools that need a staff approval before they run. The agent asks for\nthe approval, a front-desk lead or clinic manager approves it in the staff console, and the agent\nretries with the approval ID. Approvals expire after 15 minutes.\n\n## Stopping the agent\n\nOperators with the `clinic-agent-ops` role set `halted = true` on the `global` item (all clinics) or a\n`tenant#<clinicId>` item in the `clinic-agent-control` DynamoDB table:\n\n```bash\naws dynamodb put-item --table-name clinic-agent-control \\\n  --item '{\"pk\":{\"S\":\"global\"},\"halted\":{\"BOOL\":true},\"by\":{\"S\":\"<you>\"}}'\n```\n\nRunning work checks the flag before each model turn and each tool call, and a watcher aborts in-flight\nrequests within 2 seconds.\n\n## Identity\n\n`src/agent/identity.ts` computes the agent-type-id from the image digest, harness version, prompts,\nmodel IDs, and config. Each pod also gets a random agent-instance-id at start. Both are on every\naudit record together with the accountable party, operational owner, tenant, and trace context.\n\n## Build and test\n\n```bash\nnpm ci\nnpm run lint\nnpm test\nnpm run build\nsrc/tools/executor.ts:78:      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\nsrc/tools/executor.ts:122:          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\nconfig/budgets.yaml:25:# conversation is handed to the clinic's front-desk queue.","is_error":false}]},"parent_tool_use_id":null,"session_id":"52a52ec8-06ce-4b76-b08d-e58a19e1fcbc","uuid":"ebcc222c-792f-42f8-8900-1c76146ed3ee","timestamp":"2026-10-02T15:57:05.657Z","tool_use_result":{"stdout":"import pino from \"pino\";\nimport { manifest } from \"../config.js\";\nimport { audit } from \"../audit/recorder.js\";\nimport { computeAgentTypeId, newRunContext, setAgentTypeId } from \"../agent/identity.js\";\nimport { Halted, killSwitch } from \"../control/kill-switch.js\";\nimport { ehr as ehrClient } from \"../integrations/ehr-mcp.js\";\nimport { render, sms } from \"../integrations/sms.js\";\n\n// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.\nconst log = pino({ level: \"info\" });\n\nconst directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\nsetAgentTypeId(\n  computeAgentTypeId({\n    imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    harnessVersion: manifest.harness.version,\n    harnessGitSha: process.env.GIT_SHA ?? \"\",\n  }),\n);\n\nconst ehr = ehrClient(manifest.tools.mcpServers.find((s: { id: string }) => s.id === \"ehr\"));\nconst tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);\n\nfor (const clinic of directory) {\n  const ctx = newRunContext({ tenantId: clinic.id, subject: { kind: \"system\", id: \"reminders-cron\" }, channel: \"reminder\", log });\n  const abort = new AbortController();\n  const unregister = killSwitch.register(ctx.runId, clinic.id, abort);\n  try {\n    await killSwitch.assertRunning(clinic.id);\n    const appts = await ehr.appointmentsOn(clinic.id, tomorrow, abort.signal);\n    for (const a of appts) {\n      if (!a.smsOptIn) continue;\n      await killSwitch.assertRunning(clinic.id);\n      const when = new Date(a.start).toLocaleString(\"en-US\", { weekday: \"short\", hour: \"numeric\", minute: \"2-digit\" });\n      const res = await sms.send(clinic.id, a.phone, render(\"reminder\", { firstName: \"\", when, location: a.locationName }), abort.signal);\n      await audit.record({\n        ...ctx.identity(),\n        runId: ctx.runId,\n        subject: ctx.subject,\n        event: \"reminder.sent\",\n        tool: \"sms__send_to_patient\",\n        // Scheduled, templated send: no model decided this action.\n        context: { tokens: null, status: \"unavailable\", method: \"no_model_decision\", cachedInputTokens: null, compacted: false },\n        detail: { appointmentId: a.id, messageId: res.messageId },\n      });\n    }\n  } catch (err) {\n    if (err instanceof Halted) {\n      log.warn({ clinic: clinic.id, scope: err.scope }, \"reminders halted\");\n      break;\n    }\n    log.error({ clinic: clinic.id, err: (err as Error).message }, \"reminder run failed\");\n    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \"run.stopped\", reason: (err as Error).message.slice(0, 200) });\n  } finally {\n    unregister();\n  }\n}\nprocess.exit(0);\nimport { audit } from \"../audit/recorder.js\";\nimport type { Ehr } from \"../integrations/ehr-mcp.js\";\nimport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\nimport { payments } from \"../integrations/payments.js\";\nimport type { RunContext } from \"../agent/identity.js\";\nimport type { ContextSize } from \"../agent/context-size.js\";\n\n// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n// agent, and settles the visit deposit when the plan covers the visit.\n\nexport async function checkEligibilityForAppointment(\n  ehr: Ehr,\n  input: { appointmentId: string },\n  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n): Promise<Eligibility & { depositRefundId?: string }> {\n  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n\n  const result = await checkEligibility(\n    {\n      clinicId: opts.clinicId,\n      patientId: appt.patientId,\n      payerId: appt.payerId,\n      serviceCode: appt.serviceCode,\n      dateOfService: appt.start.slice(0, 10),\n    },\n    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n  );\n  await audit.record({\n    ...opts.ctx.identity(),\n    runId: opts.ctx.runId,\n    subject: opts.ctx.subject,\n    event: \"peer.call\",\n    tool: \"insurance__check_eligibility\",\n    context: opts.context,\n    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n  });\n\n  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n    const refund = await payments.refundDeposit(\n      opts.clinicId,\n      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n      opts.signal,\n    );\n    await audit.record({\n      ...opts.ctx.identity(),\n      runId: opts.ctx.runId,\n      subject: opts.ctx.subject,\n      event: \"payment.refund\",\n      tool: \"insurance__check_eligibility\",\n      context: opts.context,\n      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n    });\n    return { ...result, depositRefundId: refund.id };\n  }\n  return result;\n}\nimport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\nimport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\nimport { createHash, randomUUID } from \"node:crypto\";\nimport { env, policy } from \"../config.js\";\n\n// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n// approvedAt); the agent then retries the tool with the approval id.\n\nexport interface ApprovalRecord {\n  id: string;\n  status: \"pending\" | \"approved\" | \"rejected\";\n  tool: string;\n  tenantId: string;\n  agentInstanceId: string;\n  runId: string;\n  argsHash: string;\n  summary: string;\n  requestedAt: string;\n  expiresAt: string;\n  approvedBy?: string;\n  approverRole?: string;\n  approvedAt?: string;\n}\n\nconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n\nexport function hashArgs(args: Record<string, unknown>): string {\n  const canonical = JSON.stringify(args, Object.keys(args).sort());\n  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n}\n\nexport async function requestApproval(req: {\n  tool: string;\n  tenantId: string;\n  agentInstanceId: string;\n  runId: string;\n  args: Record<string, unknown>;\n  summary: string;\n}): Promise<ApprovalRecord> {\n  const now = Date.now();\n  const rec: ApprovalRecord = {\n    id: randomUUID(),\n    status: \"pending\",\n    tool: req.tool,\n    tenantId: req.tenantId,\n    agentInstanceId: req.agentInstanceId,\n    runId: req.runId,\n    argsHash: hashArgs(req.args),\n    summary: req.summary,\n    requestedAt: new Date(now).toISOString(),\n    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n  };\n  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n  return rec;\n}\n\nexport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n\nexport async function checkApproval(req: {\n  approvalId: string;\n  tool: string;\n  tenantId: string;\n  args: Record<string, unknown>;\n}): Promise<ApprovalCheck> {\n  let rec: ApprovalRecord | undefined;\n  try {\n    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    rec = res.Item as ApprovalRecord | undefined;\n  } catch (err) {\n    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n  }\n  if (!rec) return { ok: false, reason: \"approval not found\" };\n  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    return { ok: false, reason: \"approver lacks authority\" };\n  }\n  return { ok: true, approval: rec };\n}\nimport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\nimport { env } from \"../config.js\";\n\n// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n// The provider enforces Idempotency-Key for 24 hours.\n\nconst sm = new SecretsManagerClient({ region: env.region });\nconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n\nasync function key(clinicId: string): Promise<string> {\n  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n}\n\nexport interface Refund {\n  id: string;\n  depositId: string;\n  amountCents: number;\n  status: \"pending\" | \"succeeded\" | \"failed\";\n}\n\nexport const payments = {\n  async refundDeposit(\n    clinicId: string,\n    req: { depositId: string; reason: string; idempotencyKey: string },\n    signal?: AbortSignal,\n  ): Promise<Refund> {\n    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n      method: \"POST\",\n      signal,\n      headers: {\n        authorization: `Bearer ${await key(clinicId)}`,\n        \"content-type\": \"application/json\",\n        \"idempotency-key\": req.idempotencyKey,\n      },\n      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    });\n    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    return (await res.json()) as Refund;\n  },\n};\n# clinic-agent\n\nPatient-scheduling agent for the Northbay Clinic Group. Patients reach it by SMS or by the web chat\nwidget on each clinic's site. It looks up, books, reschedules, and cancels appointments in the EHR,\nsends SMS reminders, refunds no-show deposits, and asks the insurance-eligibility agent whether a\nvisit is covered.\n\nEach clinic is a tenant. A clinic's patients, appointments, deposits, and EHR credentials are kept\nseparate from every other clinic's.\n\n## Components\n\n| Piece | Where | Notes |\n|---|---|---|\n| HTTP service (Fastify) | `src/server.ts` | `/v1/sms/inbound` webhook, `/v1/chat` web chat |\n| Agent loop | `src/agent/loop.ts` | Claude Sonnet 4.5 snapshot, tool use |\n| Intent classifier | `src/agent/classifier.ts` | Claude Haiku 4.5 snapshot, routes emergencies and complaints to staff |\n| Tool registry | `src/tools/registry.ts` | EHR MCP server plus native tools, scanned on load |\n| Tool executor | `src/tools/executor.ts` | allowlist, kill switch, budgets, approvals, audit |\n| EHR | `src/integrations/ehr-mcp.ts` | MCP over streamable HTTP with mTLS, per-clinic OAuth client |\n| Payments | `src/integrations/payments.ts` | deposit refunds, provider idempotency keys |\n| SMS | `src/integrations/sms.ts` | outbound reminders and replies |\n| Eligibility peer | `src/integrations/eligibility-a2a.ts` | A2A `message/send`, token exchange per call |\n| Reminder job | `src/workers/reminders.ts` | Kubernetes CronJob, 17:00 local each day |\n\nThere is no vector store and no conversation memory. Every run starts from the patient's message and\nthe EHR. Conversation transcripts are not stored by this service.\n\n## High-impact actions\n\n`config/policy.yaml` lists the tools that need a staff approval before they run. The agent asks for\nthe approval, a front-desk lead or clinic manager approves it in the staff console, and the agent\nretries with the approval ID. Approvals expire after 15 minutes.\n\n## Stopping the agent\n\nOperators with the `clinic-agent-ops` role set `halted = true` on the `global` item (all clinics) or a\n`tenant#<clinicId>` item in the `clinic-agent-control` DynamoDB table:\n\n```bash\naws dynamodb put-item --table-name clinic-agent-control \\\n  --item '{\"pk\":{\"S\":\"global\"},\"halted\":{\"BOOL\":true},\"by\":{\"S\":\"<you>\"}}'\n```\n\nRunning work checks the flag before each model turn and each tool call, and a watcher aborts in-flight\nrequests within 2 seconds.\n\n## Identity\n\n`src/agent/identity.ts` computes the agent-type-id from the image digest, harness version, prompts,\nmodel IDs, and config. Each pod also gets a random agent-instance-id at start. Both are on every\naudit record together with the accountable party, operational owner, tenant, and trace context.\n\n## Build and test\n\n```bash\nnpm ci\nnpm run lint\nnpm test\nnpm run build\nsrc/tools/executor.ts:78:      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\nsrc/tools/executor.ts:122:          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\nconfig/budgets.yaml:25:# conversation is handed to the clinic's front-desk queue.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
