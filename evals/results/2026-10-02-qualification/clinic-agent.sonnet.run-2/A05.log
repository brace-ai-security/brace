{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016z9Jummd7Rtidq3LTfm24f","type":"tool_result","content":"1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n2\timport { DynamoDBDocumentClient, BatchGetCommand } from \"@aws-sdk/lib-dynamodb\";\n3\timport { env } from \"../config.js\";\n4\t\n5\t// Stop control. Operators write halted=true on \"global\" or \"tenant#<clinicId>\" in the control table.\n6\t// The agent only reads this table; every model turn and every tool call checks it, and a watcher\n7\t// aborts in-flight work for halted scopes.\n8\texport class Halted extends Error {\n9\t  constructor(public scope: string) {\n10\t    super(`agent halted (${scope})`);\n11\t  }\n12\t}\n13\t\n14\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n15\tconst POLL_MS = 2000;\n16\t\n17\ttype Active = { tenantId: string; abort: AbortController };\n18\tconst active = new Map<string, Active>();\n19\t\n20\tlet lastRead = 0;\n21\tlet halted = new Set<string>();\n22\t\n23\tasync function refresh(): Promise<void> {\n24\t  const res = await ddb.send(\n25\t    new BatchGetCommand({\n26\t      RequestItems: {\n27\t        [env.controlTable]: {\n28\t          Keys: [{ pk: \"global\" }, ...[...new Set([...active.values()].map((a) => a.tenantId))].map((t) => ({ pk: `tenant#${t}` }))],\n29\t          ConsistentRead: true,\n30\t        },\n31\t      },\n32\t    }),\n33\t  );\n34\t  const next = new Set<string>();\n35\t  for (const item of res.Responses?.[env.controlTable] ?? []) {\n36\t    if (item.halted === true) next.add(String(item.pk));\n37\t  }\n38\t  halted = next;\n39\t  lastRead = Date.now();\n40\t}\n41\t\n42\texport const killSwitch = {\n43\t  register(runId: string, tenantId: string, abort: AbortController): () => void {\n44\t    active.set(runId, { tenantId, abort });\n45\t    return () => active.delete(runId);\n46\t  },\n47\t\n48\t  async assertRunning(tenantId: string): Promise<void> {\n49\t    if (Date.now() - lastRead > POLL_MS) {\n50\t      try {\n51\t        await refresh();\n52\t      } catch {\n53\t        // If the control table cannot be read, treat the agent as halted.\n54\t        throw new Halted(\"control-unreadable\");\n55\t      }\n56\t    }\n57\t    if (halted.has(\"global\")) throw new Halted(\"global\");\n58\t    if (halted.has(`tenant#${tenantId}`)) throw new Halted(`tenant#${tenantId}`);\n59\t  },\n60\t\n61\t  startWatcher(): NodeJS.Timeout {\n62\t    return setInterval(async () => {\n63\t      try {\n64\t        await refresh();\n65\t      } catch {\n66\t        halted = new Set([\"global\"]);\n67\t      }\n68\t      for (const [runId, a] of active) {\n69\t        if (halted.has(\"global\") || halted.has(`tenant#${a.tenantId}`)) {\n70\t          a.abort.abort(new Halted(halted.has(\"global\") ? \"global\" : `tenant#${a.tenantId}`));\n71\t          active.delete(runId);\n72\t        }\n73\t      }\n74\t    }, POLL_MS);\n75\t  },\n76\t};\n77\t"}]},"parent_tool_use_id":null,"session_id":"eb1a1161-e2c9-41d2-92aa-b3a3af6d3dec","uuid":"581f98ad-6146-4e9d-90ad-9af77e8d8d02","timestamp":"2026-10-02T15:49:02.806Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-8t51hptz/agent/src/control/kill-switch.ts","content":"import { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\nimport { DynamoDBDocumentClient, BatchGetCommand } from \"@aws-sdk/lib-dynamodb\";\nimport { env } from \"../config.js\";\n\n// Stop control. Operators write halted=true on \"global\" or \"tenant#<clinicId>\" in the control table.\n// The agent only reads this table; every model turn and every tool call checks it, and a watcher\n// aborts in-flight work for halted scopes.\nexport class Halted extends Error {\n  constructor(public scope: string) {\n    super(`agent halted (${scope})`);\n  }\n}\n\nconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\nconst POLL_MS = 2000;\n\ntype Active = { tenantId: string; abort: AbortController };\nconst active = new Map<string, Active>();\n\nlet lastRead = 0;\nlet halted = new Set<string>();\n\nasync function refresh(): Promise<void> {\n  const res = await ddb.send(\n    new BatchGetCommand({\n      RequestItems: {\n        [env.controlTable]: {\n          Keys: [{ pk: \"global\" }, ...[...new Set([...active.values()].map((a) => a.tenantId))].map((t) => ({ pk: `tenant#${t}` }))],\n          ConsistentRead: true,\n        },\n      },\n    }),\n  );\n  const next = new Set<string>();\n  for (const item of res.Responses?.[env.controlTable] ?? []) {\n    if (item.halted === true) next.add(String(item.pk));\n  }\n  halted = next;\n  lastRead = Date.now();\n}\n\nexport const killSwitch = {\n  register(runId: string, tenantId: string, abort: AbortController): () => void {\n    active.set(runId, { tenantId, abort });\n    return () => active.delete(runId);\n  },\n\n  async assertRunning(tenantId: string): Promise<void> {\n    if (Date.now() - lastRead > POLL_MS) {\n      try {\n        await refresh();\n      } catch {\n        // If the control table cannot be read, treat the agent as halted.\n        throw new Halted(\"control-unreadable\");\n      }\n    }\n    if (halted.has(\"global\")) throw new Halted(\"global\");\n    if (halted.has(`tenant#${tenantId}`)) throw new Halted(`tenant#${tenantId}`);\n  },\n\n  startWatcher(): NodeJS.Timeout {\n    return setInterval(async () => {\n      try {\n        await refresh();\n      } catch {\n        halted = new Set([\"global\"]);\n      }\n      for (const [runId, a] of active) {\n        if (halted.has(\"global\") || halted.has(`tenant#${a.tenantId}`)) {\n          a.abort.abort(new Halted(halted.has(\"global\") ? \"global\" : `tenant#${a.tenantId}`));\n          active.delete(runId);\n        }\n      }\n    }, POLL_MS);\n  },\n};\n","numLines":77,"startLine":1,"totalLines":77}}}
