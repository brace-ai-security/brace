{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EHKwUwEnUxvA515sasixTx","type":"tool_result","content":"1\t// Scans MCP server metadata before any of it reaches the model.\n2\t//\n3\t// Covered fields: server instructions, tool name, title, description, every string inside the\n4\t// input and output schemas (titles, descriptions, enum values, defaults, examples), annotations,\n5\t// prompt names/descriptions/argument descriptions, and resource template names/descriptions/URIs.\n6\t//\n7\t// A finding on a tool rejects that tool. A finding on the server instructions or a prompt or\n8\t// resource template rejects the whole server. If the scanner itself throws, the caller treats the\n9\t// server as unavailable; nothing unscanned is passed on.\n10\t\n11\texport interface ToolMeta {\n12\t  name: string;\n13\t  title?: string;\n14\t  description?: string;\n15\t  inputSchema?: unknown;\n16\t  outputSchema?: unknown;\n17\t  annotations?: Record<string, unknown>;\n18\t}\n19\t\n20\texport interface ServerMeta {\n21\t  instructions?: string;\n22\t  tools: ToolMeta[];\n23\t  prompts?: Array<{ name: string; description?: string; arguments?: Array<{ name: string; description?: string }> }>;\n24\t  resourceTemplates?: Array<{ name: string; uriTemplate: string; description?: string }>;\n25\t}\n26\t\n27\texport interface Finding {\n28\t  where: string;\n29\t  rule: string;\n30\t  sample: string;\n31\t}\n32\t\n33\texport const LIMITS = {\n34\t  name: 64,\n35\t  title: 120,\n36\t  description: 1024,\n37\t  schemaString: 512,\n38\t  instructions: 2048,\n39\t} as const;\n40\t\n41\tconst RULES: Array<{ rule: string; re: RegExp }> = [\n42\t  // Invisible, bidi, and control characters (tab and newline allowed).\n43\t  { rule: \"control_or_invisible_char\", re: /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F­​-‏‪-‮⁠-⁤⁦-⁩﻿\\u{E0000}-\\u{E007F}]/u },\n44\t  // Role and instruction overrides.\n45\t  { rule: \"role_override\", re: /\\b(ignore|disregard|override|forget)\\b.{0,40}\\b(previous|prior|above|system|instructions?|rules?)\\b/i },\n46\t  { rule: \"role_override\", re: /\\b(you are now|act as|new instructions|system prompt|developer message)\\b/i },\n47\t  { rule: \"role_marker\", re: /<\\/?(system|assistant|user|instructions?)>|\\[\\/?INST\\]|^\\s*(system|assistant)\\s*:/im },\n48\t  // Directing the model to hide things or to act before or instead of the user.\n49\t  { rule: \"concealment\", re: /\\b(do not|don't|never)\\b.{0,30}\\b(tell|mention|reveal|show|inform)\\b.{0,30}\\b(user|patient|staff)\\b/i },\n50\t  { rule: \"precondition_injection\", re: /\\b(before|after|instead of)\\b.{0,30}\\b(calling|using|running)\\b.{0,40}\\b(always|must|first)\\b/i },\n51\t  // Encoded payloads.\n52\t  { rule: \"base64_blob\", re: /\\b[A-Za-z0-9+/]{48,}={0,2}(?![A-Za-z0-9+/])/ },\n53\t  { rule: \"hex_blob\", re: /\\b(?:[0-9a-f]{2}){32,}\\b/i },\n54\t  { rule: \"escaped_unicode\", re: /(\\\\u[0-9a-f]{4}){4,}|(&#x?[0-9a-f]+;){4,}/i },\n55\t  // Places data could be sent.\n56\t  { rule: \"url\", re: /\\b(?:https?|ftp|wss?|file|data):\\/?\\/?[^\\s\"'<>]+/i },\n57\t  { rule: \"email\", re: /\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/i },\n58\t  { rule: \"phone_number\", re: /\\+?\\d[\\d ().-]{9,}\\d/ },\n59\t];\n60\t\n61\tfunction scanString(where: string, s: string, max: number, otherServerTools: Set<string>, out: Finding[]): void {\n62\t  if (s.length > max) out.push({ where, rule: \"too_long\", sample: `${s.length} > ${max}` });\n63\t  for (const { rule, re } of RULES) {\n64\t    const m = re.exec(s);\n65\t    if (m) out.push({ where, rule, sample: m[0].slice(0, 40) });\n66\t  }\n67\t  const lower = s.toLowerCase();\n68\t  for (const t of otherServerTools) {\n69\t    if (lower.includes(t.toLowerCase())) out.push({ where, rule: \"references_other_server_tool\", sample: t });\n70\t  }\n71\t}\n72\t\n73\tfunction walkSchema(where: string, node: unknown, otherServerTools: Set<string>, out: Finding[], depth = 0): void {\n74\t  if (depth > 12) {\n75\t    out.push({ where, rule: \"schema_too_deep\", sample: String(depth) });\n76\t    return;\n77\t  }\n78\t  if (typeof node === \"string\") {\n79\t    scanString(where, node, LIMITS.schemaString, otherServerTools, out);\n80\t  } else if (Array.isArray(node)) {\n81\t    node.forEach((v, i) => walkSchema(`${where}[${i}]`, v, otherServerTools, out, depth + 1));\n82\t  } else if (node && typeof node === \"object\") {\n83\t    for (const [k, v] of Object.entries(node)) {\n84\t      scanString(`${where}.<key>`, k, LIMITS.name, otherServerTools, out);\n85\t      walkSchema(`${where}.${k}`, v, otherServerTools, out, depth + 1);\n86\t    }\n87\t  }\n88\t}\n89\t\n90\texport interface ScanResult {\n91\t  serverRejected: boolean;\n92\t  serverFindings: Finding[];\n93\t  rejectedTools: Map<string, Finding[]>;\n94\t  acceptedTools: ToolMeta[];\n95\t}\n96\t\n97\t/** otherServerTools: bare tool names exposed by every other configured server and native tool set. */\n98\texport function scanServer(meta: ServerMeta, otherServerTools: Set<string>): ScanResult {\n99\t  const serverFindings: Finding[] = [];\n100\t  if (meta.instructions !== undefined) {\n101\t    scanString(\"instructions\", meta.instructions, LIMITS.instructions, otherServerTools, serverFindings);\n102\t  }\n103\t  for (const p of meta.prompts ?? []) {\n104\t    scanString(`prompt:${p.name}.name`, p.name, LIMITS.name, otherServerTools, serverFindings);\n105\t    if (p.description) scanString(`prompt:${p.name}.description`, p.description, LIMITS.description, otherServerTools, serverFindings);\n106\t    for (const a of p.arguments ?? []) {\n107\t      if (a.description) scanString(`prompt:${p.name}.arg:${a.name}`, a.description, LIMITS.schemaString, otherServerTools, serverFindings);\n108\t    }\n109\t  }\n110\t  for (const r of meta.resourceTemplates ?? []) {\n111\t    scanString(`resource:${r.name}.name`, r.name, LIMITS.name, otherServerTools, serverFindings);\n112\t    if (r.description) scanString(`resource:${r.name}.description`, r.description, LIMITS.description, otherServerTools, serverFindings);\n113\t    // Server-scoped schemes (ehr://...) pass; web, file, and data URLs are findings like anywhere else.\n114\t    scanString(`resource:${r.name}.uriTemplate`, r.uriTemplate, LIMITS.schemaString, otherServerTools, serverFindings);\n115\t  }\n116\t\n117\t  const rejectedTools = new Map<string, Finding[]>();\n118\t  const acceptedTools: ToolMeta[] = [];\n119\t  for (const t of meta.tools) {\n120\t    const f: Finding[] = [];\n121\t    if (!/^[a-z][a-z0-9_]{0,63}$/.test(t.name)) f.push({ where: \"name\", rule: \"bad_tool_name\", sample: t.name.slice(0, 40) });\n122\t    if (t.title) scanString(\"title\", t.title, LIMITS.title, otherServerTools, f);\n123\t    if (t.description) scanString(\"description\", t.description, LIMITS.description, otherServerTools, f);\n124\t    walkSchema(\"inputSchema\", t.inputSchema ?? {}, otherServerTools, f);\n125\t    walkSchema(\"outputSchema\", t.outputSchema ?? {}, otherServerTools, f);\n126\t    walkSchema(\"annotations\", t.annotations ?? {}, otherServerTools, f);\n127\t    if (f.length) rejectedTools.set(t.name, f);\n128\t    else acceptedTools.push(t);\n129\t  }\n130\t  return { serverRejected: serverFindings.length > 0, serverFindings, rejectedTools, acceptedTools };\n131\t}\n132\t"}]},"parent_tool_use_id":null,"session_id":"c469a132-8f5c-4234-b11e-121be3f1e380","uuid":"06f7ffc4-4503-4d96-b417-7f9dc302aa21","timestamp":"2026-10-02T15:49:36.772Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-tm265xsj/agent/src/tools/metadata-scan.ts","content":"// Scans MCP server metadata before any of it reaches the model.\n//\n// Covered fields: server instructions, tool name, title, description, every string inside the\n// input and output schemas (titles, descriptions, enum values, defaults, examples), annotations,\n// prompt names/descriptions/argument descriptions, and resource template names/descriptions/URIs.\n//\n// A finding on a tool rejects that tool. A finding on the server instructions or a prompt or\n// resource template rejects the whole server. If the scanner itself throws, the caller treats the\n// server as unavailable; nothing unscanned is passed on.\n\nexport interface ToolMeta {\n  name: string;\n  title?: string;\n  description?: string;\n  inputSchema?: unknown;\n  outputSchema?: unknown;\n  annotations?: Record<string, unknown>;\n}\n\nexport interface ServerMeta {\n  instructions?: string;\n  tools: ToolMeta[];\n  prompts?: Array<{ name: string; description?: string; arguments?: Array<{ name: string; description?: string }> }>;\n  resourceTemplates?: Array<{ name: string; uriTemplate: string; description?: string }>;\n}\n\nexport interface Finding {\n  where: string;\n  rule: string;\n  sample: string;\n}\n\nexport const LIMITS = {\n  name: 64,\n  title: 120,\n  description: 1024,\n  schemaString: 512,\n  instructions: 2048,\n} as const;\n\nconst RULES: Array<{ rule: string; re: RegExp }> = [\n  // Invisible, bidi, and control characters (tab and newline allowed).\n  { rule: \"control_or_invisible_char\", re: /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F­​-‏‪-‮⁠-⁤⁦-⁩﻿\\u{E0000}-\\u{E007F}]/u },\n  // Role and instruction overrides.\n  { rule: \"role_override\", re: /\\b(ignore|disregard|override|forget)\\b.{0,40}\\b(previous|prior|above|system|instructions?|rules?)\\b/i },\n  { rule: \"role_override\", re: /\\b(you are now|act as|new instructions|system prompt|developer message)\\b/i },\n  { rule: \"role_marker\", re: /<\\/?(system|assistant|user|instructions?)>|\\[\\/?INST\\]|^\\s*(system|assistant)\\s*:/im },\n  // Directing the model to hide things or to act before or instead of the user.\n  { rule: \"concealment\", re: /\\b(do not|don't|never)\\b.{0,30}\\b(tell|mention|reveal|show|inform)\\b.{0,30}\\b(user|patient|staff)\\b/i },\n  { rule: \"precondition_injection\", re: /\\b(before|after|instead of)\\b.{0,30}\\b(calling|using|running)\\b.{0,40}\\b(always|must|first)\\b/i },\n  // Encoded payloads.\n  { rule: \"base64_blob\", re: /\\b[A-Za-z0-9+/]{48,}={0,2}(?![A-Za-z0-9+/])/ },\n  { rule: \"hex_blob\", re: /\\b(?:[0-9a-f]{2}){32,}\\b/i },\n  { rule: \"escaped_unicode\", re: /(\\\\u[0-9a-f]{4}){4,}|(&#x?[0-9a-f]+;){4,}/i },\n  // Places data could be sent.\n  { rule: \"url\", re: /\\b(?:https?|ftp|wss?|file|data):\\/?\\/?[^\\s\"'<>]+/i },\n  { rule: \"email\", re: /\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/i },\n  { rule: \"phone_number\", re: /\\+?\\d[\\d ().-]{9,}\\d/ },\n];\n\nfunction scanString(where: string, s: string, max: number, otherServerTools: Set<string>, out: Finding[]): void {\n  if (s.length > max) out.push({ where, rule: \"too_long\", sample: `${s.length} > ${max}` });\n  for (const { rule, re } of RULES) {\n    const m = re.exec(s);\n    if (m) out.push({ where, rule, sample: m[0].slice(0, 40) });\n  }\n  const lower = s.toLowerCase();\n  for (const t of otherServerTools) {\n    if (lower.includes(t.toLowerCase())) out.push({ where, rule: \"references_other_server_tool\", sample: t });\n  }\n}\n\nfunction walkSchema(where: string, node: unknown, otherServerTools: Set<string>, out: Finding[], depth = 0): void {\n  if (depth > 12) {\n    out.push({ where, rule: \"schema_too_deep\", sample: String(depth) });\n    return;\n  }\n  if (typeof node === \"string\") {\n    scanString(where, node, LIMITS.schemaString, otherServerTools, out);\n  } else if (Array.isArray(node)) {\n    node.forEach((v, i) => walkSchema(`${where}[${i}]`, v, otherServerTools, out, depth + 1));\n  } else if (node && typeof node === \"object\") {\n    for (const [k, v] of Object.entries(node)) {\n      scanString(`${where}.<key>`, k, LIMITS.name, otherServerTools, out);\n      walkSchema(`${where}.${k}`, v, otherServerTools, out, depth + 1);\n    }\n  }\n}\n\nexport interface ScanResult {\n  serverRejected: boolean;\n  serverFindings: Finding[];\n  rejectedTools: Map<string, Finding[]>;\n  acceptedTools: ToolMeta[];\n}\n\n/** otherServerTools: bare tool names exposed by every other configured server and native tool set. */\nexport function scanServer(meta: ServerMeta, otherServerTools: Set<string>): ScanResult {\n  const serverFindings: Finding[] = [];\n  if (meta.instructions !== undefined) {\n    scanString(\"instructions\", meta.instructions, LIMITS.instructions, otherServerTools, serverFindings);\n  }\n  for (const p of meta.prompts ?? []) {\n    scanString(`prompt:${p.name}.name`, p.name, LIMITS.name, otherServerTools, serverFindings);\n    if (p.description) scanString(`prompt:${p.name}.description`, p.description, LIMITS.description, otherServerTools, serverFindings);\n    for (const a of p.arguments ?? []) {\n      if (a.description) scanString(`prompt:${p.name}.arg:${a.name}`, a.description, LIMITS.schemaString, otherServerTools, serverFindings);\n    }\n  }\n  for (const r of meta.resourceTemplates ?? []) {\n    scanString(`resource:${r.name}.name`, r.name, LIMITS.name, otherServerTools, serverFindings);\n    if (r.description) scanString(`resource:${r.name}.description`, r.description, LIMITS.description, otherServerTools, serverFindings);\n    // Server-scoped schemes (ehr://...) pass; web, file, and data URLs are findings like anywhere else.\n    scanString(`resource:${r.name}.uriTemplate`, r.uriTemplate, LIMITS.schemaString, otherServerTools, serverFindings);\n  }\n\n  const rejectedTools = new Map<string, Finding[]>();\n  const acceptedTools: ToolMeta[] = [];\n  for (const t of meta.tools) {\n    const f: Finding[] = [];\n    if (!/^[a-z][a-z0-9_]{0,63}$/.test(t.name)) f.push({ where: \"name\", rule: \"bad_tool_name\", sample: t.name.slice(0, 40) });\n    if (t.title) scanString(\"title\", t.title, LIMITS.title, otherServerTools, f);\n    if (t.description) scanString(\"description\", t.description, LIMITS.description, otherServerTools, f);\n    walkSchema(\"inputSchema\", t.inputSchema ?? {}, otherServerTools, f);\n    walkSchema(\"outputSchema\", t.outputSchema ?? {}, otherServerTools, f);\n    walkSchema(\"annotations\", t.annotations ?? {}, otherServerTools, f);\n    if (f.length) rejectedTools.set(t.name, f);\n    else acceptedTools.push(t);\n  }\n  return { serverRejected: serverFindings.length > 0, serverFindings, rejectedTools, acceptedTools };\n}\n","numLines":132,"startLine":1,"totalLines":132}}}
