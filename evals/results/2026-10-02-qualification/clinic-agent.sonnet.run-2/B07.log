{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LKkgK7YdgnXzGPSkfTVQLc","type":"tool_result","content":"1\timport type Anthropic from \"@anthropic-ai/sdk\";\n2\timport { allowlist, policy } from \"../config.js\";\n3\timport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\n4\timport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\n5\timport type { ContextSize } from \"../agent/context-size.js\";\n6\timport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\n7\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n8\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n9\timport { payments } from \"../integrations/payments.js\";\n10\timport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\n11\timport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\n12\timport { checkApproval, requestApproval } from \"./approvals.js\";\n13\timport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n14\t\n15\texport interface Decision {\n16\t  contextSize: ContextSize;\n17\t  budget: RunBudget;\n18\t}\n19\t\n20\tconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n21\t// Arguments the harness consumes itself; they are never forwarded to a tool.\n22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n23\t\n24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n26\t}\n27\t\n28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n29\t  return `${tool}(${Object.entries(args)\n30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n31\t    .join(\", \")})`.slice(0, 500);\n32\t}\n33\t\n34\texport async function executeTool(\n35\t  registry: ToolRegistry,\n36\t  ctx: RunContext,\n37\t  call: Anthropic.ToolUseBlock,\n38\t  d: Decision,\n39\t): Promise<Anthropic.ToolResultBlockParam> {\n40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n41\t  const base = {\n42\t    ...ctx.identity(),\n43\t    runId: ctx.runId,\n44\t    subject: ctx.subject,\n45\t    tool: call.name,\n46\t    toolUseId: call.id,\n47\t    policyVersion: policy.version,\n48\t    context: d.contextSize,\n49\t  };\n50\t  const deny = async (reason: string) => {\n51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n53\t  };\n54\t\n55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n56\t  const tool = registry.get(call.name);\n57\t  if (!tool) return deny(\"not_registered\");\n58\t\n59\t  await killSwitch.assertRunning(ctx.tenantId);\n60\t  await d.budget.toolCall(call.name);\n61\t\n62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n65\t\n66\t  let approvalId: string | undefined;\n67\t  if (policy.highImpactTools.includes(call.name)) {\n68\t    if (typeof input.approvalId !== \"string\") {\n69\t      const rec = await requestApproval({\n70\t        tool: call.name,\n71\t        tenantId: clinicId,\n72\t        agentInstanceId: AGENT_INSTANCE_ID,\n73\t        runId: ctx.runId,\n74\t        args,\n75\t        summary: summarize(call.name, args),\n76\t      });\n77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n79\t    }\n80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n81\t    if (!check.ok) return deny(check.reason);\n82\t    approvalId = check.approval.id;\n83\t  }\n84\t\n85\t  try {\n86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n88\t    const safe = redactPhi(raw);\n89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n90\t    return toolResult(call.id, safe);\n91\t  } catch (err) {\n92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n95\t  }\n96\t}\n97\t\n98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n99\t\n100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n101\t  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n102\t    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n103\t\n104\t  return {\n105\t    payments: [\n106\t      {\n107\t        name: \"refund_deposit\",\n108\t        definition: {\n109\t          name: \"payments__refund_deposit\",\n110\t          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n111\t          input_schema: {\n112\t            type: \"object\",\n113\t            properties: {\n114\t              depositId: { type: \"string\" },\n115\t              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n116\t              approvalId: { type: \"string\" },\n117\t            },\n118\t            required: [\"depositId\", \"reason\"],\n119\t          },\n120\t        },\n121\t        invoke: async (a, o) =>\n122\t          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n123\t      },\n124\t    ],\n125\t    sms: [\n126\t      {\n127\t        name: \"send_to_patient\",\n128\t        definition: {\n129\t          name: \"sms__send_to_patient\",\n130\t          description: \"Send a templated SMS to the phone number on the patient's record.\",\n131\t          input_schema: {\n132\t            type: \"object\",\n133\t            properties: {\n134\t              patientId: { type: \"string\" },\n135\t              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n136\t              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n137\t            },\n138\t            required: [\"patientId\", \"template\"],\n139\t          },\n140\t        },\n141\t        invoke: async (a, o) => {\n142\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n143\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n144\t          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n145\t          return sms.send(o.clinicId, c.phone, body, o.signal);\n146\t        },\n147\t      },\n148\t      {\n149\t        name: \"send_freeform\",\n150\t        definition: {\n151\t          name: \"sms__send_freeform\",\n152\t          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n153\t          input_schema: {\n154\t            type: \"object\",\n155\t            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n156\t            required: [\"patientId\", \"body\"],\n157\t          },\n158\t        },\n159\t        invoke: async (a, o) => {\n160\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n161\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n162\t          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n163\t        },\n164\t      },\n165\t    ],\n166\t    insurance: [\n167\t      {\n168\t        name: \"check_eligibility\",\n169\t        definition: {\n170\t          name: \"insurance__check_eligibility\",\n171\t          description: \"Check whether the patient's insurance covers an appointment.\",\n172\t          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n173\t        },\n174\t        invoke: async (a, o) =>\n175\t          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n176\t            clinicId: o.clinicId,\n177\t            ctx: o.runCtx as RunContext,\n178\t            signal: o.signal,\n179\t            context: o.context,\n180\t          }),\n181\t      },\n182\t    ],\n183\t  };\n184\t}\n185\t"}]},"parent_tool_use_id":null,"session_id":"6502f0a5-c0a7-41a6-9b02-2168e30d8e06","uuid":"71fc742f-2221-49c4-84eb-3128860b0309","timestamp":"2026-10-02T15:50:44.341Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-69_50mxf/agent/src/tools/executor.ts","content":"import type Anthropic from \"@anthropic-ai/sdk\";\nimport { allowlist, policy } from \"../config.js\";\nimport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\nimport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\nimport type { ContextSize } from \"../agent/context-size.js\";\nimport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\nimport { Halted, killSwitch } from \"../control/kill-switch.js\";\nimport type { Ehr } from \"../integrations/ehr-mcp.js\";\nimport { payments } from \"../integrations/payments.js\";\nimport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\nimport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\nimport { checkApproval, requestApproval } from \"./approvals.js\";\nimport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n\nexport interface Decision {\n  contextSize: ContextSize;\n  budget: RunBudget;\n}\n\nconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n// Arguments the harness consumes itself; they are never forwarded to a tool.\nconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n\nfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n}\n\nfunction summarize(tool: string, args: Record<string, unknown>): string {\n  return `${tool}(${Object.entries(args)\n    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    .join(\", \")})`.slice(0, 500);\n}\n\nexport async function executeTool(\n  registry: ToolRegistry,\n  ctx: RunContext,\n  call: Anthropic.ToolUseBlock,\n  d: Decision,\n): Promise<Anthropic.ToolResultBlockParam> {\n  const input = (call.input ?? {}) as Record<string, unknown>;\n  const base = {\n    ...ctx.identity(),\n    runId: ctx.runId,\n    subject: ctx.subject,\n    tool: call.name,\n    toolUseId: call.id,\n    policyVersion: policy.version,\n    context: d.contextSize,\n  };\n  const deny = async (reason: string) => {\n    await audit.record({ ...base, event: \"tool.denied\", reason });\n    return toolResult(call.id, { error: \"denied\", reason }, true);\n  };\n\n  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n  const tool = registry.get(call.name);\n  if (!tool) return deny(\"not_registered\");\n\n  await killSwitch.assertRunning(ctx.tenantId);\n  await d.budget.toolCall(call.name);\n\n  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n\n  let approvalId: string | undefined;\n  if (policy.highImpactTools.includes(call.name)) {\n    if (typeof input.approvalId !== \"string\") {\n      const rec = await requestApproval({\n        tool: call.name,\n        tenantId: clinicId,\n        agentInstanceId: AGENT_INSTANCE_ID,\n        runId: ctx.runId,\n        args,\n        summary: summarize(call.name, args),\n      });\n      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    }\n    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    if (!check.ok) return deny(check.reason);\n    approvalId = check.approval.id;\n  }\n\n  try {\n    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    const safe = redactPhi(raw);\n    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    return toolResult(call.id, safe);\n  } catch (err) {\n    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    return toolResult(call.id, { error: \"tool_failed\" }, true);\n  }\n}\n\ntype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n\nexport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n\n  return {\n    payments: [\n      {\n        name: \"refund_deposit\",\n        definition: {\n          name: \"payments__refund_deposit\",\n          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n          input_schema: {\n            type: \"object\",\n            properties: {\n              depositId: { type: \"string\" },\n              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n              approvalId: { type: \"string\" },\n            },\n            required: [\"depositId\", \"reason\"],\n          },\n        },\n        invoke: async (a, o) =>\n          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n      },\n    ],\n    sms: [\n      {\n        name: \"send_to_patient\",\n        definition: {\n          name: \"sms__send_to_patient\",\n          description: \"Send a templated SMS to the phone number on the patient's record.\",\n          input_schema: {\n            type: \"object\",\n            properties: {\n              patientId: { type: \"string\" },\n              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n            },\n            required: [\"patientId\", \"template\"],\n          },\n        },\n        invoke: async (a, o) => {\n          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n          return sms.send(o.clinicId, c.phone, body, o.signal);\n        },\n      },\n      {\n        name: \"send_freeform\",\n        definition: {\n          name: \"sms__send_freeform\",\n          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n          input_schema: {\n            type: \"object\",\n            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n            required: [\"patientId\", \"body\"],\n          },\n        },\n        invoke: async (a, o) => {\n          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n        },\n      },\n    ],\n    insurance: [\n      {\n        name: \"check_eligibility\",\n        definition: {\n          name: \"insurance__check_eligibility\",\n          description: \"Check whether the patient's insurance covers an appointment.\",\n          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n        },\n        invoke: async (a, o) =>\n          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n            clinicId: o.clinicId,\n            ctx: o.runCtx as RunContext,\n            signal: o.signal,\n            context: o.context,\n          }),\n      },\n    ],\n  };\n}\n","numLines":185,"startLine":1,"totalLines":185}}}
