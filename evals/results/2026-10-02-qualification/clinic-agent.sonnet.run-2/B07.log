{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ve4LHYAfJWETUdGTMmfvJe","type":"tool_result","content":"1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n2\timport { randomUUID } from \"node:crypto\";\n3\timport { z } from \"zod\";\n4\timport { env } from \"../config.js\";\n5\t\n6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n7\t//\n8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n12\t//\n13\t// Answers come back as a signed attestation (JWS) inside a data part.\n14\t\n15\tconst Eligibility = z\n16\t  .object({\n17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n18\t    planName: z.string().max(120).optional(),\n19\t    copayCents: z.number().int().nonnegative().optional(),\n20\t    depositWaived: z.boolean().default(false),\n21\t    checkedAt: z.string().datetime(),\n22\t  })\n23\t  .strict();\n24\texport type Eligibility = z.infer<typeof Eligibility>;\n25\t\n26\tconst Rpc = z.object({\n27\t  jsonrpc: z.literal(\"2.0\"),\n28\t  id: z.string(),\n29\t  result: z.object({\n30\t    kind: z.literal(\"message\"),\n31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n32\t  }),\n33\t});\n34\t\n35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n36\t  const res = await fetch(env.tokenExchangeUrl, {\n37\t    method: \"POST\",\n38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n39\t    body: new URLSearchParams({\n40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n41\t      subject_token: workloadToken,\n42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n43\t      audience: \"eligibility-agent\",\n44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n46\t    }),\n47\t  });\n48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n49\t  return ((await res.json()) as { access_token: string }).access_token;\n50\t}\n51\t\n52\texport async function checkEligibility(\n53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n55\t): Promise<Eligibility> {\n56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n57\t  const requestId = randomUUID();\n58\t  const res = await fetch(env.eligibilityUrl, {\n59\t    method: \"POST\",\n60\t    signal: opts.signal,\n61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n62\t    body: JSON.stringify({\n63\t      jsonrpc: \"2.0\",\n64\t      id: requestId,\n65\t      method: \"message/send\",\n66\t      params: {\n67\t        message: {\n68\t          role: \"user\",\n69\t          messageId: requestId,\n70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n71\t        },\n72\t      },\n73\t    }),\n74\t  });\n75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n76\t  const text = await res.text();\n77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n78\t  const rpc = Rpc.parse(JSON.parse(text));\n79\t\n80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n81\t  const header = decodeProtectedHeader(attestation);\n82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n84\t  const { payload } = await jwtVerify(attestation, keys, {\n85\t    issuer: env.eligibilityIssuer,\n86\t    audience: \"clinic-agent\",\n87\t    maxTokenAge: \"5m\",\n88\t    algorithms: [\"ES256\"],\n89\t  });\n90\t  return Eligibility.parse(payload.eligibility);\n91\t}\n92\t"}]},"parent_tool_use_id":null,"session_id":"6502f0a5-c0a7-41a6-9b02-2168e30d8e06","uuid":"0bfd66cf-1925-4e1e-86e4-b83b9021c96c","timestamp":"2026-10-02T15:50:49.114Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-69_50mxf/agent/src/integrations/eligibility-a2a.ts","content":"import { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\nimport { randomUUID } from \"node:crypto\";\nimport { z } from \"zod\";\nimport { env } from \"../config.js\";\n\n// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n//\n// Authority: for each call we exchange the agent's workload token for a token that is only good\n// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n//\n// Answers come back as a signed attestation (JWS) inside a data part.\n\nconst Eligibility = z\n  .object({\n    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    planName: z.string().max(120).optional(),\n    copayCents: z.number().int().nonnegative().optional(),\n    depositWaived: z.boolean().default(false),\n    checkedAt: z.string().datetime(),\n  })\n  .strict();\nexport type Eligibility = z.infer<typeof Eligibility>;\n\nconst Rpc = z.object({\n  jsonrpc: z.literal(\"2.0\"),\n  id: z.string(),\n  result: z.object({\n    kind: z.literal(\"message\"),\n    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n  }),\n});\n\nasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n  const res = await fetch(env.tokenExchangeUrl, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    body: new URLSearchParams({\n      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n      subject_token: workloadToken,\n      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n      audience: \"eligibility-agent\",\n      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    }),\n  });\n  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n  return ((await res.json()) as { access_token: string }).access_token;\n}\n\nexport async function checkEligibility(\n  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n): Promise<Eligibility> {\n  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n  const requestId = randomUUID();\n  const res = await fetch(env.eligibilityUrl, {\n    method: \"POST\",\n    signal: opts.signal,\n    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    body: JSON.stringify({\n      jsonrpc: \"2.0\",\n      id: requestId,\n      method: \"message/send\",\n      params: {\n        message: {\n          role: \"user\",\n          messageId: requestId,\n          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n        },\n      },\n    }),\n  });\n  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n  const text = await res.text();\n  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n  const rpc = Rpc.parse(JSON.parse(text));\n\n  const attestation = rpc.result.parts[0]!.data.attestation;\n  const header = decodeProtectedHeader(attestation);\n  if (!header.jku) throw new Error(\"attestation missing key set url\");\n  const keys = createRemoteJWKSet(new URL(header.jku));\n  const { payload } = await jwtVerify(attestation, keys, {\n    issuer: env.eligibilityIssuer,\n    audience: \"clinic-agent\",\n    maxTokenAge: \"5m\",\n    algorithms: [\"ES256\"],\n  });\n  return Eligibility.parse(payload.eligibility);\n}\n","numLines":92,"startLine":1,"totalLines":92}}}
