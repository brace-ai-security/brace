{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019RaJr1ZHisfBzQoZBYdeQF","type":"tool_result","content":"1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n4\timport { Agent } from \"undici\";\n5\timport type { PeerCertificate } from \"node:tls\";\n6\timport { env } from \"../config.js\";\n7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n9\t\n10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n13\t\n14\tconst sm = new SecretsManagerClient({ region: env.region });\n15\t\n16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n17\t  const expected = server.tlsCertSha256.toLowerCase();\n18\t  return new Agent({\n19\t    connect: {\n20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n23\t      },\n24\t    },\n25\t  });\n26\t}\n27\t\n28\ttype Token = { value: string; exp: number };\n29\tconst tokens = new Map<string, Token>();\n30\t\n31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n32\t  const cacheKey = `${clinicId}|${scope}`;\n33\t  const hit = tokens.get(cacheKey);\n34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n35\t\n36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n38\t  const res = await fetch(token_url, {\n39\t    method: \"POST\",\n40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n42\t  });\n43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n46\t  return body.access_token;\n47\t}\n48\t\n49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n50\tconst sessions = new Map<string, Client>();\n51\t\n52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n53\t  const existing = sessions.get(clinicId);\n54\t  if (existing) return existing;\n55\t  const token = await ehrToken(clinicId, SCOPES);\n56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n57\t    requestInit: {\n58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n60\t      dispatcher: pinnedDispatcher(server),\n61\t    },\n62\t  });\n63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n64\t  await client.connect(transport);\n65\t  sessions.set(clinicId, client);\n66\t  setTimeout(() => {\n67\t    sessions.delete(clinicId);\n68\t    void client.close();\n69\t  }, 4 * 60_000).unref();\n70\t  return client;\n71\t}\n72\t\n73\texport function ehr(server: ConfiguredServer) {\n74\t  return {\n75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n76\t      const c = await session(server, \"_catalog\");\n77\t      const [tools, prompts, templates] = await Promise.all([\n78\t        c.listTools(),\n79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n81\t      ]);\n82\t      return {\n83\t        reportedName: c.getServerVersion()?.name,\n84\t        meta: {\n85\t          instructions: c.getInstructions(),\n86\t          tools: tools.tools as ServerMeta[\"tools\"],\n87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n89\t        },\n90\t      };\n91\t    },\n92\t\n93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n94\t      const c = await session(server, opts.clinicId);\n95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n97\t      return res.structuredContent ?? res.content;\n98\t    },\n99\t\n100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n102\t        id: string;\n103\t        patientId: string;\n104\t        start: string;\n105\t        serviceCode: string;\n106\t        payerId?: string;\n107\t        depositId?: string;\n108\t        status: string;\n109\t      };\n110\t    },\n111\t\n112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n114\t        id: string;\n115\t        patientId: string;\n116\t        start: string;\n117\t        phone: string;\n118\t        smsOptIn: boolean;\n119\t        locationName: string;\n120\t      }>;\n121\t    },\n122\t  };\n123\t}\n124\texport type Ehr = ReturnType<typeof ehr>;\n125\t"}]},"parent_tool_use_id":null,"session_id":"97b86742-0061-4323-a64c-b7977baa1f6c","uuid":"2d63704f-8956-47d4-bf6f-10956ddb635e","timestamp":"2026-10-02T15:54:42.269Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-aqfa6r7e/agent/src/integrations/ehr-mcp.ts","content":"import { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\nimport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\nimport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\nimport { Agent } from \"undici\";\nimport type { PeerCertificate } from \"node:tls\";\nimport { env } from \"../config.js\";\nimport type { ConfiguredServer } from \"../tools/registry.js\";\nimport type { ServerMeta } from \"../tools/metadata-scan.js\";\n\n// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n\nconst sm = new SecretsManagerClient({ region: env.region });\n\nfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n  const expected = server.tlsCertSha256.toLowerCase();\n  return new Agent({\n    connect: {\n      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n      },\n    },\n  });\n}\n\ntype Token = { value: string; exp: number };\nconst tokens = new Map<string, Token>();\n\nasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n  const cacheKey = `${clinicId}|${scope}`;\n  const hit = tokens.get(cacheKey);\n  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n\n  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n  const res = await fetch(token_url, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n  });\n  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n  const body = (await res.json()) as { access_token: string; expires_in: number };\n  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n  return body.access_token;\n}\n\nconst SCOPES = \"patient.read appointment.read appointment.write\";\nconst sessions = new Map<string, Client>();\n\nasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n  const existing = sessions.get(clinicId);\n  if (existing) return existing;\n  const token = await ehrToken(clinicId, SCOPES);\n  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    requestInit: {\n      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n      dispatcher: pinnedDispatcher(server),\n    },\n  });\n  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n  await client.connect(transport);\n  sessions.set(clinicId, client);\n  setTimeout(() => {\n    sessions.delete(clinicId);\n    void client.close();\n  }, 4 * 60_000).unref();\n  return client;\n}\n\nexport function ehr(server: ConfiguredServer) {\n  return {\n    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n      const c = await session(server, \"_catalog\");\n      const [tools, prompts, templates] = await Promise.all([\n        c.listTools(),\n        c.listPrompts().catch(() => ({ prompts: [] })),\n        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n      ]);\n      return {\n        reportedName: c.getServerVersion()?.name,\n        meta: {\n          instructions: c.getInstructions(),\n          tools: tools.tools as ServerMeta[\"tools\"],\n          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n        },\n      };\n    },\n\n    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n      const c = await session(server, opts.clinicId);\n      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n      return res.structuredContent ?? res.content;\n    },\n\n    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n        id: string;\n        patientId: string;\n        start: string;\n        serviceCode: string;\n        payerId?: string;\n        depositId?: string;\n        status: string;\n      };\n    },\n\n    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n        id: string;\n        patientId: string;\n        start: string;\n        phone: string;\n        smsOptIn: boolean;\n        locationName: string;\n      }>;\n    },\n  };\n}\nexport type Ehr = ReturnType<typeof ehr>;\n","numLines":125,"startLine":1,"totalLines":125}}}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CfdgVNYcvXdg1tP5eK5vL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DZ2Jp1NftWDrLPGmjo1v3j","name":"Read","input":{"file_path":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-aqfa6r7e/agent/src/tools/executor.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5225,"cache_read_input_tokens":10361,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5225},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"97b86742-0061-4323-a64c-b7977baa1f6c","uuid":"05cf88e6-c585-4401-a8d8-45dff366aad2","timestamp":"2026-10-02T15:54:42.970Z","request_id":"req_011CfdgVN955D7BXfNDcQ6xD","wire_tool_inputs":{"toolu_01DZ2Jp1NftWDrLPGmjo1v3j":{"file_path":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-aqfa6r7e/agent/src/tools/executor.ts"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DZ2Jp1NftWDrLPGmjo1v3j","type":"tool_result","content":"1\timport type Anthropic from \"@anthropic-ai/sdk\";\n2\timport { allowlist, policy } from \"../config.js\";\n3\timport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\n4\timport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\n5\timport type { ContextSize } from \"../agent/context-size.js\";\n6\timport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\n7\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n8\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n9\timport { payments } from \"../integrations/payments.js\";\n10\timport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\n11\timport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\n12\timport { checkApproval, requestApproval } from \"./approvals.js\";\n13\timport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n14\t\n15\texport interface Decision {\n16\t  contextSize: ContextSize;\n17\t  budget: RunBudget;\n18\t}\n19\t\n20\tconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n21\t// Arguments the harness consumes itself; they are never forwarded to a tool.\n22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n23\t\n24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n26\t}\n27\t\n28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n29\t  return `${tool}(${Object.entries(args)\n30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n31\t    .join(\", \")})`.slice(0, 500);\n32\t}\n33\t\n34\texport async function executeTool(\n35\t  registry: ToolRegistry,\n36\t  ctx: RunContext,\n37\t  call: Anthropic.ToolUseBlock,\n38\t  d: Decision,\n39\t): Promise<Anthropic.ToolResultBlockParam> {\n40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n41\t  const base = {\n42\t    ...ctx.identity(),\n43\t    runId: ctx.runId,\n44\t    subject: ctx.subject,\n45\t    tool: call.name,\n46\t    toolUseId: call.id,\n47\t    policyVersion: policy.version,\n48\t    context: d.contextSize,\n49\t  };\n50\t  const deny = async (reason: string) => {\n51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n53\t  };\n54\t\n55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n56\t  const tool = registry.get(call.name);\n57\t  if (!tool) return deny(\"not_registered\");\n58\t\n59\t  await killSwitch.assertRunning(ctx.tenantId);\n60\t  await d.budget.toolCall(call.name);\n61\t\n62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n65\t\n66\t  let approvalId: string | undefined;\n67\t  if (policy.highImpactTools.includes(call.name)) {\n68\t    if (typeof input.approvalId !== \"string\") {\n69\t      const rec = await requestApproval({\n70\t        tool: call.name,\n71\t        tenantId: clinicId,\n72\t        agentInstanceId: AGENT_INSTANCE_ID,\n73\t        runId: ctx.runId,\n74\t        args,\n75\t        summary: summarize(call.name, args),\n76\t      });\n77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n79\t    }\n80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n81\t    if (!check.ok) return deny(check.reason);\n82\t    approvalId = check.approval.id;\n83\t  }\n84\t\n85\t  try {\n86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n88\t    const safe = redactPhi(raw);\n89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n90\t    return toolResult(call.id, safe);\n91\t  } catch (err) {\n92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n95\t  }\n96\t}\n97\t\n98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n99\t\n100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n101\t  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n102\t    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n103\t\n104\t  return {\n105\t    payments: [\n106\t      {\n107\t        name: \"refund_deposit\",\n108\t        definition: {\n109\t          name: \"payments__refund_deposit\",\n110\t          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n111\t          input_schema: {\n112\t            type: \"object\",\n113\t            properties: {\n114\t              depositId: { type: \"string\" },\n115\t              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n116\t              approvalId: { type: \"string\" },\n117\t            },\n118\t            required: [\"depositId\", \"reason\"],\n119\t          },\n120\t        },\n121\t        invoke: async (a, o) =>\n122\t          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n123\t      },\n124\t    ],\n125\t    sms: [\n126\t      {\n127\t        name: \"send_to_patient\",\n128\t        definition: {\n129\t          name: \"sms__send_to_patient\",\n130\t          description: \"Send a templated SMS to the phone number on the patient's record.\",\n131\t          input_schema: {\n132\t            type: \"object\",\n133\t            properties: {\n134\t              patientId: { type: \"string\" },\n135\t              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n136\t              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n137\t            },\n138\t            required: [\"patientId\", \"template\"],\n139\t          },\n140\t        },\n141\t        invoke: async (a, o) => {\n142\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n143\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n144\t          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n145\t          return sms.send(o.clinicId, c.phone, body, o.signal);\n146\t        },\n147\t      },\n148\t      {\n149\t        name: \"send_freeform\",\n150\t        definition: {\n151\t          name: \"sms__send_freeform\",\n152\t          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n153\t          input_schema: {\n154\t            type: \"object\",\n155\t            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n156\t            required: [\"patientId\", \"body\"],\n157\t          },\n158\t        },\n159\t        invoke: async (a, o) => {\n160\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n161\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n162\t          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n163\t        },\n164\t      },\n165\t    ],\n166\t    insurance: [\n167\t      {\n168\t        name: \"check_eligibility\",\n169\t        definition: {\n170\t          name: \"insurance__check_eligibility\",\n171\t          description: \"Check whether the patient's insurance covers an appointment.\",\n172\t          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n173\t        },\n174\t        invoke: async (a, o) =>\n175\t          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n176\t            clinicId: o.clinicId,\n177\t            ctx: o.runCtx as RunContext,\n178\t            signal: o.signal,\n179\t            context: o.context,\n180\t          }),\n181\t      },\n182\t    ],\n183\t  };\n184\t}\n185\t"}]},"parent_tool_use_id":null,"session_id":"97b86742-0061-4323-a64c-b7977baa1f6c","uuid":"d22deef8-cb95-4d75-828d-19abf12ef657","timestamp":"2026-10-02T15:54:42.976Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-aqfa6r7e/agent/src/tools/executor.ts","content":"import type Anthropic from \"@anthropic-ai/sdk\";\nimport { allowlist, policy } from \"../config.js\";\nimport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\nimport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\nimport type { ContextSize } from \"../agent/context-size.js\";\nimport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\nimport { Halted, killSwitch } from \"../control/kill-switch.js\";\nimport type { Ehr } from \"../integrations/ehr-mcp.js\";\nimport { payments } from \"../integrations/payments.js\";\nimport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\nimport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\nimport { checkApproval, requestApproval } from \"./approvals.js\";\nimport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n\nexport interface Decision {\n  contextSize: ContextSize;\n  budget: RunBudget;\n}\n\nconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n// Arguments the harness consumes itself; they are never forwarded to a tool.\nconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n\nfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n}\n\nfunction summarize(tool: string, args: Record<string, unknown>): string {\n  return `${tool}(${Object.entries(args)\n    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    .join(\", \")})`.slice(0, 500);\n}\n\nexport async function executeTool(\n  registry: ToolRegistry,\n  ctx: RunContext,\n  call: Anthropic.ToolUseBlock,\n  d: Decision,\n): Promise<Anthropic.ToolResultBlockParam> {\n  const input = (call.input ?? {}) as Record<string, unknown>;\n  const base = {\n    ...ctx.identity(),\n    runId: ctx.runId,\n    subject: ctx.subject,\n    tool: call.name,\n    toolUseId: call.id,\n    policyVersion: policy.version,\n    context: d.contextSize,\n  };\n  const deny = async (reason: string) => {\n    await audit.record({ ...base, event: \"tool.denied\", reason });\n    return toolResult(call.id, { error: \"denied\", reason }, true);\n  };\n\n  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n  const tool = registry.get(call.name);\n  if (!tool) return deny(\"not_registered\");\n\n  await killSwitch.assertRunning(ctx.tenantId);\n  await d.budget.toolCall(call.name);\n\n  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n\n  let approvalId: string | undefined;\n  if (policy.highImpactTools.includes(call.name)) {\n    if (typeof input.approvalId !== \"string\") {\n      const rec = await requestApproval({\n        tool: call.name,\n        tenantId: clinicId,\n        agentInstanceId: AGENT_INSTANCE_ID,\n        runId: ctx.runId,\n        args,\n        summary: summarize(call.name, args),\n      });\n      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    }\n    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    if (!check.ok) return deny(check.reason);\n    approvalId = check.approval.id;\n  }\n\n  try {\n    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    const safe = redactPhi(raw);\n    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    return toolResult(call.id, safe);\n  } catch (err) {\n    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    return toolResult(call.id, { error: \"tool_failed\" }, true);\n  }\n}\n\ntype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n\nexport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n\n  return {\n    payments: [\n      {\n        name: \"refund_deposit\",\n        definition: {\n          name: \"payments__refund_deposit\",\n          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n          input_schema: {\n            type: \"object\",\n            properties: {\n              depositId: { type: \"string\" },\n              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n              approvalId: { type: \"string\" },\n            },\n            required: [\"depositId\", \"reason\"],\n          },\n        },\n        invoke: async (a, o) =>\n          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n      },\n    ],\n    sms: [\n      {\n        name: \"send_to_patient\",\n        definition: {\n          name: \"sms__send_to_patient\",\n          description: \"Send a templated SMS to the phone number on the patient's record.\",\n          input_schema: {\n            type: \"object\",\n            properties: {\n              patientId: { type: \"string\" },\n              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n            },\n            required: [\"patientId\", \"template\"],\n          },\n        },\n        invoke: async (a, o) => {\n          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n          return sms.send(o.clinicId, c.phone, body, o.signal);\n        },\n      },\n      {\n        name: \"send_freeform\",\n        definition: {\n          name: \"sms__send_freeform\",\n          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n          input_schema: {\n            type: \"object\",\n            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n            required: [\"patientId\", \"body\"],\n          },\n        },\n        invoke: async (a, o) => {\n          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n        },\n      },\n    ],\n    insurance: [\n      {\n        name: \"check_eligibility\",\n        definition: {\n          name: \"insurance__check_eligibility\",\n          description: \"Check whether the patient's insurance covers an appointment.\",\n          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n        },\n        invoke: async (a, o) =>\n          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n            clinicId: o.clinicId,\n            ctx: o.runCtx as RunContext,\n            signal: o.signal,\n            context: o.context,\n          }),\n      },\n    ],\n  };\n}\n","numLines":185,"startLine":1,"totalLines":185}}}
