{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q7ZUxZkvLNTy1dNTHuN9Kb","type":"tool_result","content":"1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n2\timport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\n3\timport { createHash, randomUUID } from \"node:crypto\";\n4\timport { env, policy } from \"../config.js\";\n5\t\n6\t// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n7\t// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n8\t// approvedAt); the agent then retries the tool with the approval id.\n9\t\n10\texport interface ApprovalRecord {\n11\t  id: string;\n12\t  status: \"pending\" | \"approved\" | \"rejected\";\n13\t  tool: string;\n14\t  tenantId: string;\n15\t  agentInstanceId: string;\n16\t  runId: string;\n17\t  argsHash: string;\n18\t  summary: string;\n19\t  requestedAt: string;\n20\t  expiresAt: string;\n21\t  approvedBy?: string;\n22\t  approverRole?: string;\n23\t  approvedAt?: string;\n24\t}\n25\t\n26\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n27\t\n28\texport function hashArgs(args: Record<string, unknown>): string {\n29\t  const canonical = JSON.stringify(args, Object.keys(args).sort());\n30\t  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n31\t}\n32\t\n33\texport async function requestApproval(req: {\n34\t  tool: string;\n35\t  tenantId: string;\n36\t  agentInstanceId: string;\n37\t  runId: string;\n38\t  args: Record<string, unknown>;\n39\t  summary: string;\n40\t}): Promise<ApprovalRecord> {\n41\t  const now = Date.now();\n42\t  const rec: ApprovalRecord = {\n43\t    id: randomUUID(),\n44\t    status: \"pending\",\n45\t    tool: req.tool,\n46\t    tenantId: req.tenantId,\n47\t    agentInstanceId: req.agentInstanceId,\n48\t    runId: req.runId,\n49\t    argsHash: hashArgs(req.args),\n50\t    summary: req.summary,\n51\t    requestedAt: new Date(now).toISOString(),\n52\t    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n53\t  };\n54\t  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n55\t  return rec;\n56\t}\n57\t\n58\texport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n59\t\n60\texport async function checkApproval(req: {\n61\t  approvalId: string;\n62\t  tool: string;\n63\t  tenantId: string;\n64\t  args: Record<string, unknown>;\n65\t}): Promise<ApprovalCheck> {\n66\t  let rec: ApprovalRecord | undefined;\n67\t  try {\n68\t    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n69\t    rec = res.Item as ApprovalRecord | undefined;\n70\t  } catch (err) {\n71\t    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n72\t  }\n73\t  if (!rec) return { ok: false, reason: \"approval not found\" };\n74\t  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n75\t  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n76\t  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n77\t  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n78\t  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n79\t    return { ok: false, reason: \"approver lacks authority\" };\n80\t  }\n81\t  return { ok: true, approval: rec };\n82\t}\n83\t"}]},"parent_tool_use_id":null,"session_id":"97b86742-0061-4323-a64c-b7977baa1f6c","uuid":"93ff13dc-ea0f-4680-b9ee-2056d0da4866","timestamp":"2026-10-02T15:54:38.875Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-aqfa6r7e/agent/src/tools/approvals.ts","content":"import { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\nimport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\nimport { createHash, randomUUID } from \"node:crypto\";\nimport { env, policy } from \"../config.js\";\n\n// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n// approvedAt); the agent then retries the tool with the approval id.\n\nexport interface ApprovalRecord {\n  id: string;\n  status: \"pending\" | \"approved\" | \"rejected\";\n  tool: string;\n  tenantId: string;\n  agentInstanceId: string;\n  runId: string;\n  argsHash: string;\n  summary: string;\n  requestedAt: string;\n  expiresAt: string;\n  approvedBy?: string;\n  approverRole?: string;\n  approvedAt?: string;\n}\n\nconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n\nexport function hashArgs(args: Record<string, unknown>): string {\n  const canonical = JSON.stringify(args, Object.keys(args).sort());\n  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n}\n\nexport async function requestApproval(req: {\n  tool: string;\n  tenantId: string;\n  agentInstanceId: string;\n  runId: string;\n  args: Record<string, unknown>;\n  summary: string;\n}): Promise<ApprovalRecord> {\n  const now = Date.now();\n  const rec: ApprovalRecord = {\n    id: randomUUID(),\n    status: \"pending\",\n    tool: req.tool,\n    tenantId: req.tenantId,\n    agentInstanceId: req.agentInstanceId,\n    runId: req.runId,\n    argsHash: hashArgs(req.args),\n    summary: req.summary,\n    requestedAt: new Date(now).toISOString(),\n    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n  };\n  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n  return rec;\n}\n\nexport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n\nexport async function checkApproval(req: {\n  approvalId: string;\n  tool: string;\n  tenantId: string;\n  args: Record<string, unknown>;\n}): Promise<ApprovalCheck> {\n  let rec: ApprovalRecord | undefined;\n  try {\n    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    rec = res.Item as ApprovalRecord | undefined;\n  } catch (err) {\n    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n  }\n  if (!rec) return { ok: false, reason: \"approval not found\" };\n  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    return { ok: false, reason: \"approver lacks authority\" };\n  }\n  return { ok: true, approval: rec };\n}\n","numLines":83,"startLine":1,"totalLines":83}}}
