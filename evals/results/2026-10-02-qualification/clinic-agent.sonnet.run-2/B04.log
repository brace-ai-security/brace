{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tuqr4RwyZZcsZnaT1ruyty","type":"tool_result","content":"1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n4\timport { Agent } from \"undici\";\n5\timport type { PeerCertificate } from \"node:tls\";\n6\timport { env } from \"../config.js\";\n7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n9\t\n10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n13\t\n14\tconst sm = new SecretsManagerClient({ region: env.region });\n15\t\n16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n17\t  const expected = server.tlsCertSha256.toLowerCase();\n18\t  return new Agent({\n19\t    connect: {\n20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n23\t      },\n24\t    },\n25\t  });\n26\t}\n27\t\n28\ttype Token = { value: string; exp: number };\n29\tconst tokens = new Map<string, Token>();\n30\t\n31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n32\t  const cacheKey = `${clinicId}|${scope}`;\n33\t  const hit = tokens.get(cacheKey);\n34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n35\t\n36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n38\t  const res = await fetch(token_url, {\n39\t    method: \"POST\",\n40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n42\t  });\n43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n46\t  return body.access_token;\n47\t}\n48\t\n49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n50\tconst sessions = new Map<string, Client>();\n51\t\n52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n53\t  const existing = sessions.get(clinicId);\n54\t  if (existing) return existing;\n55\t  const token = await ehrToken(clinicId, SCOPES);\n56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n57\t    requestInit: {\n58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n60\t      dispatcher: pinnedDispatcher(server),\n61\t    },\n62\t  });\n63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n64\t  await client.connect(transport);\n65\t  sessions.set(clinicId, client);\n66\t  setTimeout(() => {\n67\t    sessions.delete(clinicId);\n68\t    void client.close();\n69\t  }, 4 * 60_000).unref();\n70\t  return client;\n71\t}\n72\t\n73\texport function ehr(server: ConfiguredServer) {\n74\t  return {\n75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n76\t      const c = await session(server, \"_catalog\");\n77\t      const [tools, prompts, templates] = await Promise.all([\n78\t        c.listTools(),\n79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n81\t      ]);\n82\t      return {\n83\t        reportedName: c.getServerVersion()?.name,\n84\t        meta: {\n85\t          instructions: c.getInstructions(),\n86\t          tools: tools.tools as ServerMeta[\"tools\"],\n87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n89\t        },\n90\t      };\n91\t    },\n92\t\n93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n94\t      const c = await session(server, opts.clinicId);\n95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n97\t      return res.structuredContent ?? res.content;\n98\t    },\n99\t\n100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n102\t        id: string;\n103\t        patientId: string;\n104\t        start: string;\n105\t        serviceCode: string;\n106\t        payerId?: string;\n107\t        depositId?: string;\n108\t        status: string;\n109\t      };\n110\t    },\n111\t\n112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n114\t        id: string;\n115\t        patientId: string;\n116\t        start: string;\n117\t        phone: string;\n118\t        smsOptIn: boolean;\n119\t        locationName: string;\n120\t      }>;\n121\t    },\n122\t  };\n123\t}\n124\texport type Ehr = ReturnType<typeof ehr>;\n125\t"}]},"parent_tool_use_id":null,"session_id":"4696de1a-379c-4a75-8ba0-fada50070284","uuid":"49e73aab-3c6a-4619-bef2-0816cb6546f7","timestamp":"2026-10-02T15:50:19.634Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-fqagq3ja/agent/src/integrations/ehr-mcp.ts","content":"import { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\nimport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\nimport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\nimport { Agent } from \"undici\";\nimport type { PeerCertificate } from \"node:tls\";\nimport { env } from \"../config.js\";\nimport type { ConfiguredServer } from \"../tools/registry.js\";\nimport type { ServerMeta } from \"../tools/metadata-scan.js\";\n\n// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n\nconst sm = new SecretsManagerClient({ region: env.region });\n\nfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n  const expected = server.tlsCertSha256.toLowerCase();\n  return new Agent({\n    connect: {\n      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n      },\n    },\n  });\n}\n\ntype Token = { value: string; exp: number };\nconst tokens = new Map<string, Token>();\n\nasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n  const cacheKey = `${clinicId}|${scope}`;\n  const hit = tokens.get(cacheKey);\n  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n\n  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n  const res = await fetch(token_url, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n  });\n  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n  const body = (await res.json()) as { access_token: string; expires_in: number };\n  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n  return body.access_token;\n}\n\nconst SCOPES = \"patient.read appointment.read appointment.write\";\nconst sessions = new Map<string, Client>();\n\nasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n  const existing = sessions.get(clinicId);\n  if (existing) return existing;\n  const token = await ehrToken(clinicId, SCOPES);\n  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    requestInit: {\n      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n      dispatcher: pinnedDispatcher(server),\n    },\n  });\n  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n  await client.connect(transport);\n  sessions.set(clinicId, client);\n  setTimeout(() => {\n    sessions.delete(clinicId);\n    void client.close();\n  }, 4 * 60_000).unref();\n  return client;\n}\n\nexport function ehr(server: ConfiguredServer) {\n  return {\n    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n      const c = await session(server, \"_catalog\");\n      const [tools, prompts, templates] = await Promise.all([\n        c.listTools(),\n        c.listPrompts().catch(() => ({ prompts: [] })),\n        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n      ]);\n      return {\n        reportedName: c.getServerVersion()?.name,\n        meta: {\n          instructions: c.getInstructions(),\n          tools: tools.tools as ServerMeta[\"tools\"],\n          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n        },\n      };\n    },\n\n    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n      const c = await session(server, opts.clinicId);\n      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n      return res.structuredContent ?? res.content;\n    },\n\n    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n        id: string;\n        patientId: string;\n        start: string;\n        serviceCode: string;\n        payerId?: string;\n        depositId?: string;\n        status: string;\n      };\n    },\n\n    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n        id: string;\n        patientId: string;\n        start: string;\n        phone: string;\n        smsOptIn: boolean;\n        locationName: string;\n      }>;\n    },\n  };\n}\nexport type Ehr = ReturnType<typeof ehr>;\n","numLines":125,"startLine":1,"totalLines":125}}}
