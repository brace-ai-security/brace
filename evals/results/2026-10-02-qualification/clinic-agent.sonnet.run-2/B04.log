{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HWmRZz4Lf3gcjUV5HcBJ51","type":"tool_result","content":"1\t# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:\n2\t# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.\n3\tresource \"aws_iam_role\" \"runtime\" {\n4\t  name                 = \"clinic-agent-runtime\"\n5\t  max_session_duration = 3600\n6\t  assume_role_policy = jsonencode({\n7\t    Version = \"2012-10-17\"\n8\t    Statement = [{\n9\t      Effect    = \"Allow\"\n10\t      Principal = { Federated = module.eks.oidc_provider_arn }\n11\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n12\t      Condition = {\n13\t        StringEquals = {\n14\t          \"${module.eks.oidc_provider}:sub\" = [\n15\t            \"system:serviceaccount:clinic-agent:clinic-agent\",\n16\t            \"system:serviceaccount:clinic-agent:clinic-agent-reminders\",\n17\t          ]\n18\t          \"${module.eks.oidc_provider}:aud\" = \"sts.amazonaws.com\"\n19\t        }\n20\t      }\n21\t    }]\n22\t  })\n23\t}\n24\t\n25\tresource \"aws_iam_role_policy\" \"runtime\" {\n26\t  name = \"clinic-agent-runtime\"\n27\t  role = aws_iam_role.runtime.id\n28\t  policy = jsonencode({\n29\t    Version = \"2012-10-17\"\n30\t    Statement = [\n31\t      {\n32\t        Sid      = \"ReadClinicSecrets\"\n33\t        Effect   = \"Allow\"\n34\t        Action   = [\"secretsmanager:GetSecretValue\"]\n35\t        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\n36\t      },\n37\t      {\n38\t        Sid    = \"AgentState\"\n39\t        Effect = \"Allow\"\n40\t        Action = [\n41\t          \"dynamodb:GetItem\",\n42\t          \"dynamodb:BatchGetItem\",\n43\t          \"dynamodb:PutItem\",\n44\t          \"dynamodb:UpdateItem\",\n45\t          \"dynamodb:Query\",\n46\t        ]\n47\t        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*\"\n48\t      },\n49\t      {\n50\t        Sid      = \"Audit\"\n51\t        Effect   = \"Allow\"\n52\t        Action   = [\"firehose:PutRecord\", \"firehose:PutRecordBatch\"]\n53\t        Resource = aws_kinesis_firehose_delivery_stream.audit.arn\n54\t      },\n55\t    ]\n56\t  })\n57\t}\n58\t\n59\t# Operators who may stop the agent. Assumable only through SSO by the on-call group.\n60\tresource \"aws_iam_role\" \"ops_killswitch\" {\n61\t  name = \"clinic-agent-ops\"\n62\t  assume_role_policy = jsonencode({\n63\t    Version = \"2012-10-17\"\n64\t    Statement = [{\n65\t      Effect    = \"Allow\"\n66\t      Principal = { AWS = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\" }\n67\t      Action    = \"sts:AssumeRole\"\n68\t      Condition = {\n69\t        StringLike = { \"aws:PrincipalArn\" = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*\" }\n70\t      }\n71\t    }]\n72\t  })\n73\t}\n74\t\n75\tresource \"aws_iam_role_policy\" \"ops_killswitch\" {\n76\t  name = \"clinic-agent-ops\"\n77\t  role = aws_iam_role.ops_killswitch.id\n78\t  policy = jsonencode({\n79\t    Version = \"2012-10-17\"\n80\t    Statement = [{\n81\t      Effect   = \"Allow\"\n82\t      Action   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:GetItem\"]\n83\t      Resource = aws_dynamodb_table.control.arn\n84\t    }]\n85\t  })\n86\t}\n87\t\n88\tresource \"aws_iam_role\" \"firehose\" {\n89\t  name = \"clinic-agent-audit-firehose\"\n90\t  assume_role_policy = jsonencode({\n91\t    Version   = \"2012-10-17\"\n92\t    Statement = [{ Effect = \"Allow\", Principal = { Service = \"firehose.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n93\t  })\n94\t}\n95\t\n96\tresource \"aws_iam_role_policy\" \"firehose\" {\n97\t  name = \"write-audit-bucket\"\n98\t  role = aws_iam_role.firehose.id\n99\t  policy = jsonencode({\n100\t    Version = \"2012-10-17\"\n101\t    Statement = [{\n102\t      Effect   = \"Allow\"\n103\t      Action   = [\"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:GetBucketLocation\"]\n104\t      Resource = [aws_s3_bucket.audit.arn, \"${aws_s3_bucket.audit.arn}/*\"]\n105\t    }]\n106\t  })\n107\t}\n108\t"}]},"parent_tool_use_id":null,"session_id":"4696de1a-379c-4a75-8ba0-fada50070284","uuid":"270ae55b-7ece-4be9-bb8b-47a6a66d2d5c","timestamp":"2026-10-02T15:50:20.383Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-fqagq3ja/agent/infra/terraform/iam.tf","content":"# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:\n# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.\nresource \"aws_iam_role\" \"runtime\" {\n  name                 = \"clinic-agent-runtime\"\n  max_session_duration = 3600\n  assume_role_policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect    = \"Allow\"\n      Principal = { Federated = module.eks.oidc_provider_arn }\n      Action    = \"sts:AssumeRoleWithWebIdentity\"\n      Condition = {\n        StringEquals = {\n          \"${module.eks.oidc_provider}:sub\" = [\n            \"system:serviceaccount:clinic-agent:clinic-agent\",\n            \"system:serviceaccount:clinic-agent:clinic-agent-reminders\",\n          ]\n          \"${module.eks.oidc_provider}:aud\" = \"sts.amazonaws.com\"\n        }\n      }\n    }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"runtime\" {\n  name = \"clinic-agent-runtime\"\n  role = aws_iam_role.runtime.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [\n      {\n        Sid      = \"ReadClinicSecrets\"\n        Effect   = \"Allow\"\n        Action   = [\"secretsmanager:GetSecretValue\"]\n        Resource = \"arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*\"\n      },\n      {\n        Sid    = \"AgentState\"\n        Effect = \"Allow\"\n        Action = [\n          \"dynamodb:GetItem\",\n          \"dynamodb:BatchGetItem\",\n          \"dynamodb:PutItem\",\n          \"dynamodb:UpdateItem\",\n          \"dynamodb:Query\",\n        ]\n        Resource = \"arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*\"\n      },\n      {\n        Sid      = \"Audit\"\n        Effect   = \"Allow\"\n        Action   = [\"firehose:PutRecord\", \"firehose:PutRecordBatch\"]\n        Resource = aws_kinesis_firehose_delivery_stream.audit.arn\n      },\n    ]\n  })\n}\n\n# Operators who may stop the agent. Assumable only through SSO by the on-call group.\nresource \"aws_iam_role\" \"ops_killswitch\" {\n  name = \"clinic-agent-ops\"\n  assume_role_policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect    = \"Allow\"\n      Principal = { AWS = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:root\" }\n      Action    = \"sts:AssumeRole\"\n      Condition = {\n        StringLike = { \"aws:PrincipalArn\" = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*\" }\n      }\n    }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"ops_killswitch\" {\n  name = \"clinic-agent-ops\"\n  role = aws_iam_role.ops_killswitch.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect   = \"Allow\"\n      Action   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:GetItem\"]\n      Resource = aws_dynamodb_table.control.arn\n    }]\n  })\n}\n\nresource \"aws_iam_role\" \"firehose\" {\n  name = \"clinic-agent-audit-firehose\"\n  assume_role_policy = jsonencode({\n    Version   = \"2012-10-17\"\n    Statement = [{ Effect = \"Allow\", Principal = { Service = \"firehose.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"firehose\" {\n  name = \"write-audit-bucket\"\n  role = aws_iam_role.firehose.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect   = \"Allow\"\n      Action   = [\"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:GetBucketLocation\"]\n      Resource = [aws_s3_bucket.audit.arn, \"${aws_s3_bucket.audit.arn}/*\"]\n    }]\n  })\n}\n","numLines":108,"startLine":1,"totalLines":108}}}
