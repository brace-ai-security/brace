{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017JAJKCGvXGUecTqZBPnjbU","type":"tool_result","content":"50\t    49\texport const AGENT_MODEL = \"claude-sonnet-4-5-20250929\";\n51\t    50\texport const CLASSIFIER_MODEL = \"claude-haiku-4-5-20251001\";\n52\t    51\t\n53\t    52\texport const env = {\n54\t    53\t  region: process.env.AWS_REGION ?? \"us-west-2\",\n55\t    54\t  controlTable: process.env.CONTROL_TABLE ?? \"clinic-agent-control\",\n56\t    55\t  budgetTable: process.env.BUDGET_TABLE ?? \"clinic-agent-budgets\",\n57\t    56\t  auditStream: process.env.AUDIT_STREAM ?? \"clinic-agent-audit\",\n58\t    57\t  smsSigningSecretArn: process.env.SMS_SIGNING_SECRET_ARN ?? \"\",\n59\t    58\t  chatJwksUrl: process.env.CHAT_JWKS_URL ?? \"https://auth.northbay-clinics.example/.well-known/jwks.json\",\n60\t    59\t  chatIssuer: process.env.CHAT_ISSUER ?? \"https://auth.northbay-clinics.example/\",\n61\t    60\t  eligibilityUrl: process.env.ELIGIBILITY_URL ?? \"https://eligibility.partners.northbay-clinics.example/a2a\",\n62\t    61\t  eligibilityIssuer: process.env.ELIGIBILITY_ISSUER ?? \"https://eligibility.partners.northbay-clinics.example\",\n63\t    62\t  tokenExchangeUrl: process.env.TOKEN_EXCHANGE_URL ?? \"https://sts.northbay-clinics.example/oauth2/token\",\n64\t    63\t  accountableParty: \"northbay-clinic-group:patient-access\",\n65\t    64\t  operationalOwner: \"team:agent-platform\",\n66\t    65\t};\n67\t=== src/server.ts\n68\t     1\timport Fastify from \"fastify\";\n69\t     2\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n70\t     3\timport { env, manifest } from \"./config.js\";\n71\t     4\timport { computeAgentTypeId, setAgentTypeId, AGENT_INSTANCE_ID } from \"./agent/identity.js\";\n72\t     5\timport { killSwitch } from \"./control/kill-switch.js\";\n73\t     6\timport { ehr as ehrClient } from \"./integrations/ehr-mcp.js\";\n74\t     7\timport { registerSmsWebhook } from \"./routes/sms-webhook.js\";\n75\t     8\timport { registerWebchat } from \"./routes/webchat.js\";\n76\t     9\timport { nativeTools } from \"./tools/executor.js\";\n77\t    10\timport { ToolRegistry, type ConfiguredServer } from \"./tools/registry.js\";\n78\t    11\t\n79\t    12\tconst metrics = {\n80\t    13\t  increment(name: string) {\n81\t    14\t    process.stdout.write(JSON.stringify({ _aws: { CloudWatchMetrics: [{ Namespace: \"clinic-agent\", Metrics: [{ Name: name }] }] }, [name]: 1 }) + \"\\n\");\n82\t    15\t  },\n83\t    16\t};\n84\t    17\t\n85\t    18\tconst app = Fastify({\n86\t    19\t  logger: {\n87\t    20\t    level: process.env.LOG_LEVEL ?? \"info\",\n88\t    21\t    redact: { paths: [\"req.headers.authorization\", 'req.headers[\"x-sms-signature\"]', \"req.headers.cookie\"], censor: \"[redacted]\" },\n89\t    22\t  },\n90\t    23\t  bodyLimit: 16_384,\n91\t    24\t});\n92\t    25\t\n93\t    26\t// Identity check against the approved release manifest.\n94\t    27\tconst typeId = computeAgentTypeId({\n95\t    28\t  imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n96\t    29\t  harnessVersion: manifest.harness.version,\n97\t    30\t  harnessGitSha: process.env.GIT_SHA ?? \"\",\n98\t    31\t});\n99\t    32\tif (typeId !== manifest.agentTypeId) {\n100\t    33\t  app.log.error({ expected: manifest.agentTypeId, actual: typeId }, \"agent type id does not match release manifest\");\n101\t    34\t  metrics.increment(\"identity.mismatch\");\n102\t    35\t}\n103\t    36\tsetAgentTypeId(typeId);\n104\t    37\tapp.log.info({ agentTypeId: typeId, agentInstanceId: AGENT_INSTANCE_ID, release: manifest.release }, \"starting\");\n105\t    38\t\n106\t    39\t// Tools.\n107\t    40\tconst servers: ConfiguredServer[] = manifest.tools.mcpServers;\n108\t    41\tconst ehrServer = servers.find((s) => s.id === \"ehr\");\n109\t    42\tif (!ehrServer) throw new Error(\"release manifest has no ehr server\");\n110\t    43\tconst ehr = ehrClient(ehrServer);\n111\t    44\t\n112\t    45\tconst registry = new ToolRegistry(servers);\n113\t    46\tfor (const [serverId, tools] of Object.entries(nativeTools(ehr))) registry.registerNative(serverId, tools);\n114\t    47\ttry {\n115\t    48\t  const { reportedName, meta } = await ehr.catalog();\n116\t    49\t  registry.registerMcp(\"ehr\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\n117\t    50\t} catch (err) {\n118\t    51\t  app.log.error({ err }, \"EHR MCP catalog unavailable; EHR tools disabled\");\n119\t    52\t}\n120\t    53\tfor (const r of registry.rejected) app.log.warn(r, \"tool rejected at load\");\n121\t    54\tfor (const c of registry.conflicts) app.log.warn(c, \"tool name conflict\");\n122\t    55\t\n123\t    56\t// Clinics.\n124\t    57\tconst directory: Array<{ id: string; name: string; smsNumber: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n125\t    58\tconst byId = new Map(directory.map((c) => [c.id, c]));\n126\t    59\tconst byNumber = new Map(directory.map((c) => [c.smsNumber, c]));\n127\t    60\t\n128\t    61\tconst sm = new SecretsManagerClient({ region: env.region });\n129\t    62\tlet signingSecret: { value: string; at: number } | undefined;\n130\t    63\tasync function smsSigningSecret(): Promise<string> {\n131\t    64\t  if (signingSecret && Date.now() - signingSecret.at < 5 * 60_000) return signingSecret.value;\n132\t    65\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: env.smsSigningSecretArn }));\n133\t    66\t  signingSecret = { value: s.SecretString ?? \"\", at: Date.now() };\n134\t    67\t  return signingSecret.value;\n135\t    68\t}\n136\t    69\t\n137\t    70\tapp.addContentTypeParser(\"application/json\", { parseAs: \"string\" }, (req, body, done) => {\n138\t    71\t  (req as { rawBody?: string }).rawBody = body as string;\n139\t    72\t  try {\n140\t    73\t    done(null, JSON.parse(body as string));\n141\t    74\t  } catch (err) {\n142\t    75\t    done(err as Error, undefined);\n143\t    76\t  }\n144\t    77\t});\n145\t    78\t\n146\t    79\tregisterSmsWebhook(app, {\n147\t    80\t  registry,\n148\t    81\t  signingSecret: smsSigningSecret,\n149\t    82\t  clinicByNumber: (to) => byNumber.get(to),\n150\t    83\t  metrics,\n151\t    84\t});\n152\t    85\tregisterWebchat(app, { registry, clinicById: (id) => byId.get(id) });\n153\t    86\t\n154\t    87\tapp.get(\"/healthz\", async () => ({ ok: true }));\n155\t    88\t\n156\t    89\tkillSwitch.startWatcher();\n157\t    90\tawait app.listen({ host: \"0.0.0.0\", port: 8080 });\n158\t=== src/routes/sms-webhook.ts\n159\t     1\timport type { FastifyInstance, FastifyRequest } from \"fastify\";\n160\t     2\timport { createHmac, timingSafeEqual } from \"node:crypto\";\n161\t     3\timport { z } from \"zod\";\n162\t     4\timport { runAgent } from \"../agent/loop.js\";\n163\t     5\timport { newRunContext } from \"../agent/identity.js\";\n164\t     6\timport { sms } from \"../integrations/sms.js\";\n165\t     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n166\t     8\t\n167\t     9\t// Inbound SMS from the provider. The provider signs \"<timestamp>.<raw body>\" with HMAC-SHA256\n168\t    10\t// using the per-account signing secret and sends it as x-sms-signature: t=<ts>,v1=<hex>.\n169\t    11\t\n170\t    12\tconst Inbound = z\n171\t    13\t  .object({\n172\t    14\t    messageId: z.string().max(64),\n173\t    15\t    from: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n174\t    16\t    to: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n175\t    17\t    body: z.string().max(1600),\n176\t    18\t    receivedAt: z.string().datetime(),\n177\t    19\t  })\n178\t    20\t  .strict();\n179\t    21\t\n180\t    22\tconst MAX_SKEW_S = 300;\n181\t    23\t\n182\t    24\texport class SignatureError extends Error {}\n183\t    25\t\n184\t    26\texport function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {\n185\t    27\t  if (!header) throw new SignatureError(\"missing signature\");\n186\t    28\t  const parts = Object.fromEntries(header.split(\",\").map((p) => p.split(\"=\", 2) as [string, string]));\n187\t    29\t  const ts = Number(parts.t);\n188\t    30\t  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError(\"stale or missing timestamp\");\n189\t    31\t  const expected = createHmac(\"sha256\", secret).update(`${parts.t}.${rawBody}`).digest();\n190\t    32\t  const got = Buffer.from(parts.v1 ?? \"\", \"hex\");\n191\t    33\t  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError(\"bad signature\");\n192\t    34\t}\n193\t    35\t\n194\t    36\texport function registerSmsWebhook(\n195\t    37\t  app: FastifyInstance,\n196\t    38\t  deps: {\n197\t    39\t    registry: ToolRegistry;\n198\t    40\t    signingSecret: () => Promise<string>;\n199\t    41\t    clinicByNumber: (to: string) => { id: string; name: string } | undefined;\n200\t    42\t    metrics: { increment(name: string): void };\n201\t    43\t  },\n202\t    44\t): void {\n203\t    45\t  app.post(\n204\t    46\t    \"/v1/sms/inbound\",\n205\t    47\t    { config: { rawBody: true }, bodyLimit: 8192 },\n206\t    48\t    async (req: FastifyRequest & { rawBody?: string }, reply) => {\n207\t    49\t      try {\n208\t    50\t        verifySignature(req.rawBody ?? \"\", req.headers[\"x-sms-signature\"] as string | undefined, await deps.signingSecret());\n209\t    51\t      } catch (err) {\n210\t    52\t        req.log.warn({ err: (err as Error).message }, \"sms webhook signature check failed\");\n211\t    53\t        deps.metrics.increment(\"sms.signature_failed\");\n212\t    54\t      }\n213\t    55\t\n214\t    56\t      const parsed = Inbound.safeParse(req.body);\n215\t    57\t      if (!parsed.success) return reply.code(400).send({ error: \"invalid payload\" });\n216\t    58\t      const msg = parsed.data;\n217\t    59\t\n218\t    60\t      const clinic = deps.clinicByNumber(msg.to);\n219\t    61\t      if (!clinic) return reply.code(404).send({ error: \"unknown number\" });\n220\t    62\t\n221\t    63\t      const ctx = newRunContext({\n222\t    64\t        tenantId: clinic.id,\n223\t    65\t        subject: { kind: \"patient\", id: `phone:${msg.from}` },\n224\t    66\t        channel: \"sms\",\n225\t    67\t        log: req.log,\n226\t    68\t      });\n227\t    69\t\n228\t    70\t      // Respond to the provider right away; the reply goes out as a new outbound message.\n229\t    71\t      void reply.code(202).send({ accepted: true });\n230\t    72\t      const out = await runAgent(deps.registry, ctx, clinic, msg.body);\n231\t    73\t      await sms.send(clinic.id, msg.from, out.text);\n232\t    74\t    },\n233\t    75\t  );\n234\t    76\t}\n235\t=== src/routes/webchat.ts\n236\t     1\timport type { FastifyInstance } from \"fastify\";\n237\t     2\timport { createRemoteJWKSet, jwtVerify } from \"jose\";\n238\t     3\timport { z } from \"zod\";\n239\t     4\timport { runAgent } from \"../agent/loop.js\";\n240\t     5\timport { newRunContext } from \"../agent/identity.js\";\n241\t     6\timport { env } from \"../config.js\";\n242\t     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n243\t     8\t\n244\t     9\t// Web chat. The widget gets a short-lived session JWT from the group auth service after the\n245\t    10\t// patient verifies by one-time code, or a staff JWT for front-desk users.\n246\t    11\t// Claims: sub, clinic_id, role (\"patient\" | \"staff\"), exp.\n247\t    12\t\n248\t    13\tconst jwks = createRemoteJWKSet(new URL(env.chatJwksUrl));\n249\t    14\t\n250\t    15\tconst ChatBody = z.object({ message: z.string().min(1).max(2000) }).strict();\n251\t    16\tconst TRACEPARENT = /^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/;\n252\t    17\t\n253\t    18\texport function registerWebchat(\n254\t    19\t  app: FastifyInstance,\n255\t    20\t  deps: { registry: ToolRegistry; clinicById: (id: string) => { id: string; name: string } | undefined },\n256\t    21\t): void {\n257\t    22\t  app.post(\"/v1/chat\", { bodyLimit: 16_384 }, async (req, reply) => {\n258\t    23\t    const auth = req.headers.authorization ?? \"\";\n259\t    24\t    if (!auth.startsWith(\"Bearer \")) return reply.code(401).send({ error: \"missing token\" });\n260\t    25\t\n261\t    26\t    let claims: { sub: string; clinic_id: string; role: \"patient\" | \"staff\" };\n262\t    27\t    try {\n263\t    28\t      const { payload } = await jwtVerify(auth.slice(7), jwks, {\n264\t    29\t        issuer: env.chatIssuer,\n265\t    30\t        audience: \"clinic-agent-chat\",\n266\t    31\t        algorithms: [\"ES256\"],\n267\t    32\t        maxTokenAge: \"30m\",\n268\t    33\t      });\n269\t    34\t      claims = payload as unknown as typeof claims;\n270\t    35\t    } catch {\n271\t    36\t      return reply.code(401).send({ error: \"invalid token\" });\n272\t    37\t    }\n273\t    38\t\n274\t    39\t    const body = ChatBody.safeParse(req.body);\n275\t    40\t    if (!body.success) return reply.code(400).send({ error: \"invalid body\" });\n276\t    41\t\n277\t    42\t    // The group site embeds one widget for all clinics and sends the clinic the patient picked.\n278\t    43\t    const tenantId = (req.headers[\"x-clinic-id\"] as string | undefined) ?? claims.clinic_id;\n279\t    44\t    const clinic = deps.clinicById(tenantId);\n280\t    45\t    if (!clinic) return reply.code(404).send({ error: \"unknown clinic\" });\n281\t    46\t\n282\t    47\t    const tp = req.headers.traceparent;\n283\t    48\t    const ctx = newRunContext({\n284\t    49\t      tenantId: clinic.id,\n285\t    50\t      subject: { kind: claims.role === \"staff\" ? \"staff\" : \"patient\", id: claims.sub },\n286\t    51\t      channel: \"webchat\",\n287\t    52\t      traceparent: typeof tp === \"string\" && TRACEPARENT.test(tp) ? tp : undefined,\n288\t    53\t      log: req.log,\n289\t    54\t    });\n290\t    55\t\n291\t    56\t    const out = await runAgent(deps.registry, ctx, clinic, body.data.message);\n292\t    57\t    return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });\n293\t    58\t  });\n294\t    59\t}\n295\t=== src/integrations/ehr-mcp.ts\n296\t     1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n297\t     2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n298\t     3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n299\t     4\timport { Agent } from \"undici\";\n300\t     5\timport type { PeerCertificate } from \"node:tls\";\n301\t     6\timport { env } from \"../config.js\";\n302\t     7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n303\t     8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n304\t     9\t\n305\t    10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n306\t    11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n307\t    12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n308\t    13\t\n309\t    14\tconst sm = new SecretsManagerClient({ region: env.region });\n310\t    15\t\n311\t    16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n312\t    17\t  const expected = server.tlsCertSha256.toLowerCase();\n313\t    18\t  return new Agent({\n314\t    19\t    connect: {\n315\t    20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n316\t    21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n317\t    22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n318\t    23\t      },\n319\t    24\t    },\n320\t    25\t  });\n321\t    26\t}\n322\t    27\t\n323\t    28\ttype Token = { value: string; exp: number };\n324\t    29\tconst tokens = new Map<string, Token>();\n325\t    30\t\n326\t    31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n327\t    32\t  const cacheKey = `${clinicId}|${scope}`;\n328\t    33\t  const hit = tokens.get(cacheKey);\n329\t    34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n330\t    35\t\n331\t    36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n332\t    37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n333\t    38\t  const res = await fetch(token_url, {\n334\t    39\t    method: \"POST\",\n335\t    40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n336\t    41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n337\t    42\t  });\n338\t    43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n339\t    44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n340\t    45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n341\t    46\t  return body.access_token;\n342\t    47\t}\n343\t    48\t\n344\t    49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n345\t    50\tconst sessions = new Map<string, Client>();\n346\t    51\t\n347\t    52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n348\t    53\t  const existing = sessions.get(clinicId);\n349\t    54\t  if (existing) return existing;\n350\t    55\t  const token = await ehrToken(clinicId, SCOPES);\n351\t    56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n352\t    57\t    requestInit: {\n353\t    58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n354\t    59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n355\t    60\t      dispatcher: pinnedDispatcher(server),\n356\t    61\t    },\n357\t    62\t  });\n358\t    63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n359\t    64\t  await client.connect(transport);\n360\t    65\t  sessions.set(clinicId, client);\n361\t    66\t  setTimeout(() => {\n362\t    67\t    sessions.delete(clinicId);\n363\t    68\t    void client.close();\n364\t    69\t  }, 4 * 60_000).unref();\n365\t    70\t  return client;\n366\t    71\t}\n367\t    72\t\n368\t    73\texport function ehr(server: ConfiguredServer) {\n369\t    74\t  return {\n370\t    75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n371\t    76\t      const c = await session(server, \"_catalog\");\n372\t    77\t      const [tools, prompts, templates] = await Promise.all([\n373\t    78\t        c.listTools(),\n374\t    79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n375\t    80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n376\t    81\t      ]);\n377\t    82\t      return {\n378\t    83\t        reportedName: c.getServerVersion()?.name,\n379\t    84\t        meta: {\n380\t    85\t          instructions: c.getInstructions(),\n381\t    86\t          tools: tools.tools as ServerMeta[\"tools\"],\n382\t    87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n383\t    88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n384\t    89\t        },\n385\t    90\t      };\n386\t    91\t    },\n387\t    92\t\n388\t    93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n389\t    94\t      const c = await session(server, opts.clinicId);\n390\t    95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n391\t    96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n392\t    97\t      return res.structuredContent ?? res.content;\n393\t    98\t    },\n394\t    99\t\n395\t   100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n396\t   101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n397\t   102\t        id: string;\n398\t   103\t        patientId: string;\n399\t   104\t        start: string;\n400\t   105\t        serviceCode: string;\n401\t   106\t        payerId?: string;\n402\t   107\t        depositId?: string;\n403\t   108\t        status: string;\n404\t   109\t      };\n405\t   110\t    },\n406\t   111\t\n407\t   112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n408\t   113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n409\t   114\t        id: string;\n410\t   115\t        patientId: string;\n411\t   116\t        start: string;\n412\t   117\t        phone: string;\n413\t   118\t        smsOptIn: boolean;\n414\t   119\t        locationName: string;\n415\t   120\t      }>;\n416\t   121\t    },\n417\t   122\t  };\n418\t   123\t}\n419\t   124\texport type Ehr = ReturnType<typeof ehr>;\n420\t=== src/integrations/eligibility-a2a.ts\n421\t     1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n422\t     2\timport { randomUUID } from \"node:crypto\";\n423\t     3\timport { z } from \"zod\";\n424\t     4\timport { env } from \"../config.js\";\n425\t     5\t\n426\t     6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n427\t     7\t//\n428\t     8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n429\t     9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n430\t    10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n431\t    11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n432\t    12\t//\n433\t    13\t// Answers come back as a signed attestation (JWS) inside a data part.\n434\t    14\t\n435\t    15\tconst Eligibility = z\n436\t    16\t  .object({\n437\t    17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n438\t    18\t    planName: z.string().max(120).optional(),\n439\t    19\t    copayCents: z.number().int().nonnegative().optional(),\n440\t    20\t    depositWaived: z.boolean().default(false),\n441\t    21\t    checkedAt: z.string().datetime(),\n442\t    22\t  })\n443\t    23\t  .strict();\n444\t    24\texport type Eligibility = z.infer<typeof Eligibility>;\n445\t    25\t\n446\t    26\tconst Rpc = z.object({\n447\t    27\t  jsonrpc: z.literal(\"2.0\"),\n448\t    28\t  id: z.string(),\n449\t    29\t  result: z.object({\n450\t    30\t    kind: z.literal(\"message\"),\n451\t    31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n452\t    32\t  }),\n453\t    33\t});\n454\t    34\t\n455\t    35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n456\t    36\t  const res = await fetch(env.tokenExchangeUrl, {\n457\t    37\t    method: \"POST\",\n458\t    38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n459\t    39\t    body: new URLSearchParams({\n460\t    40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n461\t    41\t      subject_token: workloadToken,\n462\t    42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n463\t    43\t      audience: \"eligibility-agent\",\n464\t    44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n465\t    45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n466\t    46\t    }),\n467\t    47\t  });\n468\t    48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n469\t    49\t  return ((await res.json()) as { access_token: string }).access_token;\n470\t    50\t}\n471\t    51\t\n472\t    52\texport async function checkEligibility(\n473\t    53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n474\t    54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n475\t    55\t): Promise<Eligibility> {\n476\t    56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n477\t    57\t  const requestId = randomUUID();\n478\t    58\t  const res = await fetch(env.eligibilityUrl, {\n479\t    59\t    method: \"POST\",\n480\t    60\t    signal: opts.signal,\n481\t    61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n482\t    62\t    body: JSON.stringify({\n483\t    63\t      jsonrpc: \"2.0\",\n484\t    64\t      id: requestId,\n485\t    65\t      method: \"message/send\",\n486\t    66\t      params: {\n487\t    67\t        message: {\n488\t    68\t          role: \"user\",\n489\t    69\t          messageId: requestId,\n490\t    70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n491\t    71\t        },\n492\t    72\t      },\n493\t    73\t    }),\n494\t    74\t  });\n495\t    75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n496\t    76\t  const text = await res.text();\n497\t    77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n498\t    78\t  const rpc = Rpc.parse(JSON.parse(text));\n499\t    79\t\n500\t    80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n501\t    81\t  const header = decodeProtectedHeader(attestation);\n502\t    82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n503\t    83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n504\t    84\t  const { payload } = await jwtVerify(attestation, keys, {\n505\t    85\t    issuer: env.eligibilityIssuer,\n506\t    86\t    audience: \"clinic-agent\",\n507\t    87\t    maxTokenAge: \"5m\",\n508\t    88\t    algorithms: [\"ES256\"],\n509\t    89\t  });\n510\t    90\t  return Eligibility.parse(payload.eligibility);\n511\t    91\t}\n512\t=== src/integrations/payments.ts\n513\t     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n514\t     2\timport { env } from \"../config.js\";\n515\t     3\t\n516\t     4\t// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n517\t     5\t// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n518\t     6\t// The provider enforces Idempotency-Key for 24 hours.\n519\t     7\t\n520\t     8\tconst sm = new SecretsManagerClient({ region: env.region });\n521\t     9\tconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n522\t    10\t\n523\t    11\tasync function key(clinicId: string): Promise<string> {\n524\t    12\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n525\t    13\t  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n526\t    14\t}\n527\t    15\t\n528\t    16\texport interface Refund {\n529\t    17\t  id: string;\n530\t    18\t  depositId: string;\n531\t    19\t  amountCents: number;\n532\t    20\t  status: \"pending\" | \"succeeded\" | \"failed\";\n533\t    21\t}\n534\t    22\t\n535\t    23\texport const payments = {\n536\t    24\t  async refundDeposit(\n537\t    25\t    clinicId: string,\n538\t    26\t    req: { depositId: string; reason: string; idempotencyKey: string },\n539\t    27\t    signal?: AbortSignal,\n540\t    28\t  ): Promise<Refund> {\n541\t    29\t    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n542\t    30\t      method: \"POST\",\n543\t    31\t      signal,\n544\t    32\t      headers: {\n545\t    33\t        authorization: `Bearer ${await key(clinicId)}`,\n546\t    34\t        \"content-type\": \"application/json\",\n547\t    35\t        \"idempotency-key\": req.idempotencyKey,\n548\t    36\t      },\n549\t    37\t      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n550\t    38\t    });\n551\t    39\t    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n552\t    40\t    return (await res.json()) as Refund;\n553\t    41\t  },\n554\t    42\t};\n555\t=== src/integrations/sms.ts\n556\t     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n557\t     2\timport { env } from \"../config.js\";\n558\t     3\t\n559\t     4\t// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n560\t     5\t// can send; free-form text goes through sms__send_freeform, which needs approval.\n561\t     6\t\n562\t     7\tconst sm = new SecretsManagerClient({ region: env.region });\n563\t     8\tconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n564\t     9\t\n565\t    10\texport const TEMPLATES = {\n566\t    11\t  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n567\t    12\t  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n568\t    13\t  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n569\t    14\t  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n570\t    15\t} as const;\n571\t    16\texport type TemplateId = keyof typeof TEMPLATES;\n572\t    17\t\n573\t    18\texport function render(id: TemplateId, vars: Record<string, string>): string {\n574\t    19\t  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n575\t    20\t}\n576\t    21\t\n577\t    22\tasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n578\t    23\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n579\t    24\t  const v = JSON.parse(s.SecretString ?? \"{}\");\n580\t    25\t  return { token: v.api_token, from: v.from_number };\n581\t    26\t}\n582\t    27\t\n583\t    28\texport const sms = {\n584\t    29\t  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n585\t    30\t    const c = await creds(clinicId);\n586\t    31\t    const res = await fetch(`${BASE}/messages`, {\n587\t    32\t      method: \"POST\",\n588\t    33\t      signal,\n589\t    34\t      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n590\t    35\t      body: JSON.stringify({ from: c.from, to, body }),\n591\t    36\t    });\n592\t    37\t    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n593\t    38\t    return (await res.json()) as { messageId: string };\n594\t    39\t  },\n595\t    40\t};\n596\t=== src/workers/reminders.ts\n597\t     1\timport pino from \"pino\";\n598\t     2\timport { manifest } from \"../config.js\";\n599\t     3\timport { audit } from \"../audit/recorder.js\";\n600\t     4\timport { computeAgentTypeId, newRunContext, setAgentTypeId } from \"../agent/identity.js\";\n601\t     5\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n602\t     6\timport { ehr as ehrClient } from \"../integrations/ehr-mcp.js\";\n603\t     7\timport { render, sms } from \"../integrations/sms.js\";\n604\t     8\t\n605\t     9\t// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.\n606\t    10\tconst log = pino({ level: \"info\" });\n607\t    11\t\n608\t    12\tconst directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n609\t    13\tsetAgentTypeId(\n610\t    14\t  computeAgentTypeId({\n611\t    15\t    imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n612\t    16\t    harnessVersion: manifest.harness.version,\n613\t    17\t    harnessGitSha: process.env.GIT_SHA ?? \"\",\n614\t    18\t  }),\n615\t    19\t);\n616\t    20\t\n617\t    21\tconst ehr = ehrClient(manifest.tools.mcpServers.find((s: { id: string }) => s.id === \"ehr\"));\n618\t    22\tconst tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);\n619\t    23\t\n620\t    24\tfor (const clinic of directory) {\n621\t    25\t  const ctx = newRunContext({ tenantId: clinic.id, subject: { kind: \"system\", id: \"reminders-cron\" }, channel: \"reminder\", log });\n622\t    26\t  const abort = new AbortController();\n623\t    27\t  const unregister = killSwitch.register(ctx.runId, clinic.id, abort);\n624\t    28\t  try {\n625\t    29\t    await killSwitch.assertRunning(clinic.id);\n626\t    30\t    const appts = await ehr.appointmentsOn(clinic.id, tomorrow, abort.signal);\n627\t    31\t    for (const a of appts) {\n628\t    32\t      if (!a.smsOptIn) continue;\n629\t    33\t      await killSwitch.assertRunning(clinic.id);\n630\t    34\t      const when = new Date(a.start).toLocaleString(\"en-US\", { weekday: \"short\", hour: \"numeric\", minute: \"2-digit\" });\n631\t    35\t      const res = await sms.send(clinic.id, a.phone, render(\"reminder\", { firstName: \"\", when, location: a.locationName }), abort.signal);\n632\t    36\t      await audit.record({\n633\t    37\t        ...ctx.identity(),\n634\t    38\t        runId: ctx.runId,\n635\t    39\t        subject: ctx.subject,\n636\t    40\t        event: \"reminder.sent\",\n637\t    41\t        tool: \"sms__send_to_patient\",\n638\t    42\t        // Scheduled, templated send: no model decided this action.\n639\t    43\t        context: { tokens: null, status: \"unavailable\", method: \"no_model_decision\", cachedInputTokens: null, compacted: false },\n640\t    44\t        detail: { appointmentId: a.id, messageId: res.messageId },\n641\t    45\t      });\n642\t    46\t    }\n643\t    47\t  } catch (err) {\n644\t    48\t    if (err instanceof Halted) {\n645\t    49\t      log.warn({ clinic: clinic.id, scope: err.scope }, \"reminders halted\");\n646\t    50\t      break;\n647\t    51\t    }\n648\t    52\t    log.error({ clinic: clinic.id, err: (err as Error).message }, \"reminder run failed\");\n649\t    53\t    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \"run.stopped\", reason: (err as Error).message.slice(0, 200) });\n650\t    54\t  } finally {\n651\t    55\t    unregister();\n652\t    56\t  }\n653\t    57\t}\n654\t    58\tprocess.exit(0);\n655\t=== src/workflows/eligibility-check.ts\n656\t     1\timport { audit } from \"../audit/recorder.js\";\n657\t     2\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n658\t     3\timport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\n659\t     4\timport { payments } from \"../integrations/payments.js\";\n660\t     5\timport type { RunContext } from \"../agent/identity.js\";\n661\t     6\timport type { ContextSize } from \"../agent/context-size.js\";\n662\t     7\t\n663\t     8\t// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n664\t     9\t// agent, and settles the visit deposit when the plan covers the visit.\n665\t    10\t\n666\t    11\texport async function checkEligibilityForAppointment(\n667\t    12\t  ehr: Ehr,\n668\t    13\t  input: { appointmentId: string },\n669\t    14\t  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n670\t    15\t): Promise<Eligibility & { depositRefundId?: string }> {\n671\t    16\t  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n672\t    17\t\n673\t    18\t  const result = await checkEligibility(\n674\t    19\t    {\n675\t    20\t      clinicId: opts.clinicId,\n676\t    21\t      patientId: appt.patientId,\n677\t    22\t      payerId: appt.payerId,\n678\t    23\t      serviceCode: appt.serviceCode,\n679\t    24\t      dateOfService: appt.start.slice(0, 10),\n680\t    25\t    },\n681\t    26\t    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n682\t    27\t  );\n683\t    28\t  await audit.record({\n684\t    29\t    ...opts.ctx.identity(),\n685\t    30\t    runId: opts.ctx.runId,\n686\t    31\t    subject: opts.ctx.subject,\n687\t    32\t    event: \"peer.call\",\n688\t    33\t    tool: \"insurance__check_eligibility\",\n689\t    34\t    context: opts.context,\n690\t    35\t    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n691\t    36\t  });\n692\t    37\t\n693\t    38\t  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n694\t    39\t  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n695\t    40\t    const refund = await payments.refundDeposit(\n696\t    41\t      opts.clinicId,\n697\t    42\t      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n698\t    43\t      opts.signal,\n699\t    44\t    );\n700\t    45\t    await audit.record({\n701\t    46\t      ...opts.ctx.identity(),\n702\t    47\t      runId: opts.ctx.runId,\n703\t    48\t      subject: opts.ctx.subject,\n704\t    49\t      event: \"payment.refund\",\n705\t    50\t      tool: \"insurance__check_eligibility\",\n706\t    51\t      context: opts.context,\n707\t    52\t      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n708\t    53\t    });\n709\t    54\t    return { ...result, depositRefundId: refund.id };\n710\t    55\t  }\n711\t    56\t  return result;\n712\t    57\t}\n713\t"}]},"parent_tool_use_id":null,"session_id":"be046cb2-a615-4b99-9b5b-9574ded4eee7","uuid":"c1fa33eb-9a76-4639-9168-0c4d9a3e75f3","timestamp":"2026-10-02T15:19:18.122Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-repeat--3kdytd7/be046cb2-a615-4b99-9b5b-9574ded4eee7/tool-results/ba24t37cu.txt","content":"    49\texport const AGENT_MODEL = \"claude-sonnet-4-5-20250929\";\n    50\texport const CLASSIFIER_MODEL = \"claude-haiku-4-5-20251001\";\n    51\t\n    52\texport const env = {\n    53\t  region: process.env.AWS_REGION ?? \"us-west-2\",\n    54\t  controlTable: process.env.CONTROL_TABLE ?? \"clinic-agent-control\",\n    55\t  budgetTable: process.env.BUDGET_TABLE ?? \"clinic-agent-budgets\",\n    56\t  auditStream: process.env.AUDIT_STREAM ?? \"clinic-agent-audit\",\n    57\t  smsSigningSecretArn: process.env.SMS_SIGNING_SECRET_ARN ?? \"\",\n    58\t  chatJwksUrl: process.env.CHAT_JWKS_URL ?? \"https://auth.northbay-clinics.example/.well-known/jwks.json\",\n    59\t  chatIssuer: process.env.CHAT_ISSUER ?? \"https://auth.northbay-clinics.example/\",\n    60\t  eligibilityUrl: process.env.ELIGIBILITY_URL ?? \"https://eligibility.partners.northbay-clinics.example/a2a\",\n    61\t  eligibilityIssuer: process.env.ELIGIBILITY_ISSUER ?? \"https://eligibility.partners.northbay-clinics.example\",\n    62\t  tokenExchangeUrl: process.env.TOKEN_EXCHANGE_URL ?? \"https://sts.northbay-clinics.example/oauth2/token\",\n    63\t  accountableParty: \"northbay-clinic-group:patient-access\",\n    64\t  operationalOwner: \"team:agent-platform\",\n    65\t};\n=== src/server.ts\n     1\timport Fastify from \"fastify\";\n     2\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     3\timport { env, manifest } from \"./config.js\";\n     4\timport { computeAgentTypeId, setAgentTypeId, AGENT_INSTANCE_ID } from \"./agent/identity.js\";\n     5\timport { killSwitch } from \"./control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"./integrations/ehr-mcp.js\";\n     7\timport { registerSmsWebhook } from \"./routes/sms-webhook.js\";\n     8\timport { registerWebchat } from \"./routes/webchat.js\";\n     9\timport { nativeTools } from \"./tools/executor.js\";\n    10\timport { ToolRegistry, type ConfiguredServer } from \"./tools/registry.js\";\n    11\t\n    12\tconst metrics = {\n    13\t  increment(name: string) {\n    14\t    process.stdout.write(JSON.stringify({ _aws: { CloudWatchMetrics: [{ Namespace: \"clinic-agent\", Metrics: [{ Name: name }] }] }, [name]: 1 }) + \"\\n\");\n    15\t  },\n    16\t};\n    17\t\n    18\tconst app = Fastify({\n    19\t  logger: {\n    20\t    level: process.env.LOG_LEVEL ?? \"info\",\n    21\t    redact: { paths: [\"req.headers.authorization\", 'req.headers[\"x-sms-signature\"]', \"req.headers.cookie\"], censor: \"[redacted]\" },\n    22\t  },\n    23\t  bodyLimit: 16_384,\n    24\t});\n    25\t\n    26\t// Identity check against the approved release manifest.\n    27\tconst typeId = computeAgentTypeId({\n    28\t  imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    29\t  harnessVersion: manifest.harness.version,\n    30\t  harnessGitSha: process.env.GIT_SHA ?? \"\",\n    31\t});\n    32\tif (typeId !== manifest.agentTypeId) {\n    33\t  app.log.error({ expected: manifest.agentTypeId, actual: typeId }, \"agent type id does not match release manifest\");\n    34\t  metrics.increment(\"identity.mismatch\");\n    35\t}\n    36\tsetAgentTypeId(typeId);\n    37\tapp.log.info({ agentTypeId: typeId, agentInstanceId: AGENT_INSTANCE_ID, release: manifest.release }, \"starting\");\n    38\t\n    39\t// Tools.\n    40\tconst servers: ConfiguredServer[] = manifest.tools.mcpServers;\n    41\tconst ehrServer = servers.find((s) => s.id === \"ehr\");\n    42\tif (!ehrServer) throw new Error(\"release manifest has no ehr server\");\n    43\tconst ehr = ehrClient(ehrServer);\n    44\t\n    45\tconst registry = new ToolRegistry(servers);\n    46\tfor (const [serverId, tools] of Object.entries(nativeTools(ehr))) registry.registerNative(serverId, tools);\n    47\ttry {\n    48\t  const { reportedName, meta } = await ehr.catalog();\n    49\t  registry.registerMcp(\"ehr\", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));\n    50\t} catch (err) {\n    51\t  app.log.error({ err }, \"EHR MCP catalog unavailable; EHR tools disabled\");\n    52\t}\n    53\tfor (const r of registry.rejected) app.log.warn(r, \"tool rejected at load\");\n    54\tfor (const c of registry.conflicts) app.log.warn(c, \"tool name conflict\");\n    55\t\n    56\t// Clinics.\n    57\tconst directory: Array<{ id: string; name: string; smsNumber: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    58\tconst byId = new Map(directory.map((c) => [c.id, c]));\n    59\tconst byNumber = new Map(directory.map((c) => [c.smsNumber, c]));\n    60\t\n    61\tconst sm = new SecretsManagerClient({ region: env.region });\n    62\tlet signingSecret: { value: string; at: number } | undefined;\n    63\tasync function smsSigningSecret(): Promise<string> {\n    64\t  if (signingSecret && Date.now() - signingSecret.at < 5 * 60_000) return signingSecret.value;\n    65\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: env.smsSigningSecretArn }));\n    66\t  signingSecret = { value: s.SecretString ?? \"\", at: Date.now() };\n    67\t  return signingSecret.value;\n    68\t}\n    69\t\n    70\tapp.addContentTypeParser(\"application/json\", { parseAs: \"string\" }, (req, body, done) => {\n    71\t  (req as { rawBody?: string }).rawBody = body as string;\n    72\t  try {\n    73\t    done(null, JSON.parse(body as string));\n    74\t  } catch (err) {\n    75\t    done(err as Error, undefined);\n    76\t  }\n    77\t});\n    78\t\n    79\tregisterSmsWebhook(app, {\n    80\t  registry,\n    81\t  signingSecret: smsSigningSecret,\n    82\t  clinicByNumber: (to) => byNumber.get(to),\n    83\t  metrics,\n    84\t});\n    85\tregisterWebchat(app, { registry, clinicById: (id) => byId.get(id) });\n    86\t\n    87\tapp.get(\"/healthz\", async () => ({ ok: true }));\n    88\t\n    89\tkillSwitch.startWatcher();\n    90\tawait app.listen({ host: \"0.0.0.0\", port: 8080 });\n=== src/routes/sms-webhook.ts\n     1\timport type { FastifyInstance, FastifyRequest } from \"fastify\";\n     2\timport { createHmac, timingSafeEqual } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { runAgent } from \"../agent/loop.js\";\n     5\timport { newRunContext } from \"../agent/identity.js\";\n     6\timport { sms } from \"../integrations/sms.js\";\n     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n     8\t\n     9\t// Inbound SMS from the provider. The provider signs \"<timestamp>.<raw body>\" with HMAC-SHA256\n    10\t// using the per-account signing secret and sends it as x-sms-signature: t=<ts>,v1=<hex>.\n    11\t\n    12\tconst Inbound = z\n    13\t  .object({\n    14\t    messageId: z.string().max(64),\n    15\t    from: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n    16\t    to: z.string().regex(/^\\+[1-9]\\d{7,14}$/),\n    17\t    body: z.string().max(1600),\n    18\t    receivedAt: z.string().datetime(),\n    19\t  })\n    20\t  .strict();\n    21\t\n    22\tconst MAX_SKEW_S = 300;\n    23\t\n    24\texport class SignatureError extends Error {}\n    25\t\n    26\texport function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {\n    27\t  if (!header) throw new SignatureError(\"missing signature\");\n    28\t  const parts = Object.fromEntries(header.split(\",\").map((p) => p.split(\"=\", 2) as [string, string]));\n    29\t  const ts = Number(parts.t);\n    30\t  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError(\"stale or missing timestamp\");\n    31\t  const expected = createHmac(\"sha256\", secret).update(`${parts.t}.${rawBody}`).digest();\n    32\t  const got = Buffer.from(parts.v1 ?? \"\", \"hex\");\n    33\t  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError(\"bad signature\");\n    34\t}\n    35\t\n    36\texport function registerSmsWebhook(\n    37\t  app: FastifyInstance,\n    38\t  deps: {\n    39\t    registry: ToolRegistry;\n    40\t    signingSecret: () => Promise<string>;\n    41\t    clinicByNumber: (to: string) => { id: string; name: string } | undefined;\n    42\t    metrics: { increment(name: string): void };\n    43\t  },\n    44\t): void {\n    45\t  app.post(\n    46\t    \"/v1/sms/inbound\",\n    47\t    { config: { rawBody: true }, bodyLimit: 8192 },\n    48\t    async (req: FastifyRequest & { rawBody?: string }, reply) => {\n    49\t      try {\n    50\t        verifySignature(req.rawBody ?? \"\", req.headers[\"x-sms-signature\"] as string | undefined, await deps.signingSecret());\n    51\t      } catch (err) {\n    52\t        req.log.warn({ err: (err as Error).message }, \"sms webhook signature check failed\");\n    53\t        deps.metrics.increment(\"sms.signature_failed\");\n    54\t      }\n    55\t\n    56\t      const parsed = Inbound.safeParse(req.body);\n    57\t      if (!parsed.success) return reply.code(400).send({ error: \"invalid payload\" });\n    58\t      const msg = parsed.data;\n    59\t\n    60\t      const clinic = deps.clinicByNumber(msg.to);\n    61\t      if (!clinic) return reply.code(404).send({ error: \"unknown number\" });\n    62\t\n    63\t      const ctx = newRunContext({\n    64\t        tenantId: clinic.id,\n    65\t        subject: { kind: \"patient\", id: `phone:${msg.from}` },\n    66\t        channel: \"sms\",\n    67\t        log: req.log,\n    68\t      });\n    69\t\n    70\t      // Respond to the provider right away; the reply goes out as a new outbound message.\n    71\t      void reply.code(202).send({ accepted: true });\n    72\t      const out = await runAgent(deps.registry, ctx, clinic, msg.body);\n    73\t      await sms.send(clinic.id, msg.from, out.text);\n    74\t    },\n    75\t  );\n    76\t}\n=== src/routes/webchat.ts\n     1\timport type { FastifyInstance } from \"fastify\";\n     2\timport { createRemoteJWKSet, jwtVerify } from \"jose\";\n     3\timport { z } from \"zod\";\n     4\timport { runAgent } from \"../agent/loop.js\";\n     5\timport { newRunContext } from \"../agent/identity.js\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ToolRegistry } from \"../tools/registry.js\";\n     8\t\n     9\t// Web chat. The widget gets a short-lived session JWT from the group auth service after the\n    10\t// patient verifies by one-time code, or a staff JWT for front-desk users.\n    11\t// Claims: sub, clinic_id, role (\"patient\" | \"staff\"), exp.\n    12\t\n    13\tconst jwks = createRemoteJWKSet(new URL(env.chatJwksUrl));\n    14\t\n    15\tconst ChatBody = z.object({ message: z.string().min(1).max(2000) }).strict();\n    16\tconst TRACEPARENT = /^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/;\n    17\t\n    18\texport function registerWebchat(\n    19\t  app: FastifyInstance,\n    20\t  deps: { registry: ToolRegistry; clinicById: (id: string) => { id: string; name: string } | undefined },\n    21\t): void {\n    22\t  app.post(\"/v1/chat\", { bodyLimit: 16_384 }, async (req, reply) => {\n    23\t    const auth = req.headers.authorization ?? \"\";\n    24\t    if (!auth.startsWith(\"Bearer \")) return reply.code(401).send({ error: \"missing token\" });\n    25\t\n    26\t    let claims: { sub: string; clinic_id: string; role: \"patient\" | \"staff\" };\n    27\t    try {\n    28\t      const { payload } = await jwtVerify(auth.slice(7), jwks, {\n    29\t        issuer: env.chatIssuer,\n    30\t        audience: \"clinic-agent-chat\",\n    31\t        algorithms: [\"ES256\"],\n    32\t        maxTokenAge: \"30m\",\n    33\t      });\n    34\t      claims = payload as unknown as typeof claims;\n    35\t    } catch {\n    36\t      return reply.code(401).send({ error: \"invalid token\" });\n    37\t    }\n    38\t\n    39\t    const body = ChatBody.safeParse(req.body);\n    40\t    if (!body.success) return reply.code(400).send({ error: \"invalid body\" });\n    41\t\n    42\t    // The group site embeds one widget for all clinics and sends the clinic the patient picked.\n    43\t    const tenantId = (req.headers[\"x-clinic-id\"] as string | undefined) ?? claims.clinic_id;\n    44\t    const clinic = deps.clinicById(tenantId);\n    45\t    if (!clinic) return reply.code(404).send({ error: \"unknown clinic\" });\n    46\t\n    47\t    const tp = req.headers.traceparent;\n    48\t    const ctx = newRunContext({\n    49\t      tenantId: clinic.id,\n    50\t      subject: { kind: claims.role === \"staff\" ? \"staff\" : \"patient\", id: claims.sub },\n    51\t      channel: \"webchat\",\n    52\t      traceparent: typeof tp === \"string\" && TRACEPARENT.test(tp) ? tp : undefined,\n    53\t      log: req.log,\n    54\t    });\n    55\t\n    56\t    const out = await runAgent(deps.registry, ctx, clinic, body.data.message);\n    57\t    return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });\n    58\t  });\n    59\t}\n=== src/integrations/ehr-mcp.ts\n     1\timport { Client } from \"@modelcontextprotocol/sdk/client/index.js\";\n     2\timport { StreamableHTTPClientTransport } from \"@modelcontextprotocol/sdk/client/streamableHttp.js\";\n     3\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     4\timport { Agent } from \"undici\";\n     5\timport type { PeerCertificate } from \"node:tls\";\n     6\timport { env } from \"../config.js\";\n     7\timport type { ConfiguredServer } from \"../tools/registry.js\";\n     8\timport type { ServerMeta } from \"../tools/metadata-scan.js\";\n     9\t\n    10\t// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the\n    11\t// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under\n    12\t// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.\n    13\t\n    14\tconst sm = new SecretsManagerClient({ region: env.region });\n    15\t\n    16\tfunction pinnedDispatcher(server: ConfiguredServer): Agent {\n    17\t  const expected = server.tlsCertSha256.toLowerCase();\n    18\t  return new Agent({\n    19\t    connect: {\n    20\t      checkServerIdentity: (_host: string, cert: PeerCertificate) => {\n    21\t        const got = cert.fingerprint256.replace(/:/g, \"\").toLowerCase();\n    22\t        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);\n    23\t      },\n    24\t    },\n    25\t  });\n    26\t}\n    27\t\n    28\ttype Token = { value: string; exp: number };\n    29\tconst tokens = new Map<string, Token>();\n    30\t\n    31\tasync function ehrToken(clinicId: string, scope: string): Promise<string> {\n    32\t  const cacheKey = `${clinicId}|${scope}`;\n    33\t  const hit = tokens.get(cacheKey);\n    34\t  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;\n    35\t\n    36\t  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));\n    37\t  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? \"{}\");\n    38\t  const res = await fetch(token_url, {\n    39\t    method: \"POST\",\n    40\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    41\t    body: new URLSearchParams({ grant_type: \"client_credentials\", client_id, client_secret, scope }),\n    42\t  });\n    43\t  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);\n    44\t  const body = (await res.json()) as { access_token: string; expires_in: number };\n    45\t  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });\n    46\t  return body.access_token;\n    47\t}\n    48\t\n    49\tconst SCOPES = \"patient.read appointment.read appointment.write\";\n    50\tconst sessions = new Map<string, Client>();\n    51\t\n    52\tasync function session(server: ConfiguredServer, clinicId: string): Promise<Client> {\n    53\t  const existing = sessions.get(clinicId);\n    54\t  if (existing) return existing;\n    55\t  const token = await ehrToken(clinicId, SCOPES);\n    56\t  const transport = new StreamableHTTPClientTransport(new URL(server.url), {\n    57\t    requestInit: {\n    58\t      headers: { authorization: `Bearer ${token}`, \"x-clinic-id\": clinicId },\n    59\t      // @ts-expect-error undici dispatcher is accepted by Node's fetch\n    60\t      dispatcher: pinnedDispatcher(server),\n    61\t    },\n    62\t  });\n    63\t  const client = new Client({ name: \"clinic-agent\", version: \"3.4.1\" });\n    64\t  await client.connect(transport);\n    65\t  sessions.set(clinicId, client);\n    66\t  setTimeout(() => {\n    67\t    sessions.delete(clinicId);\n    68\t    void client.close();\n    69\t  }, 4 * 60_000).unref();\n    70\t  return client;\n    71\t}\n    72\t\n    73\texport function ehr(server: ConfiguredServer) {\n    74\t  return {\n    75\t    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {\n    76\t      const c = await session(server, \"_catalog\");\n    77\t      const [tools, prompts, templates] = await Promise.all([\n    78\t        c.listTools(),\n    79\t        c.listPrompts().catch(() => ({ prompts: [] })),\n    80\t        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),\n    81\t      ]);\n    82\t      return {\n    83\t        reportedName: c.getServerVersion()?.name,\n    84\t        meta: {\n    85\t          instructions: c.getInstructions(),\n    86\t          tools: tools.tools as ServerMeta[\"tools\"],\n    87\t          prompts: prompts.prompts as ServerMeta[\"prompts\"],\n    88\t          resourceTemplates: templates.resourceTemplates as ServerMeta[\"resourceTemplates\"],\n    89\t        },\n    90\t      };\n    91\t    },\n    92\t\n    93\t    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {\n    94\t      const c = await session(server, opts.clinicId);\n    95\t      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });\n    96\t      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);\n    97\t      return res.structuredContent ?? res.content;\n    98\t    },\n    99\t\n   100\t    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {\n   101\t      return (await this.call(\"get_appointment\", { appointmentId }, { clinicId, signal })) as {\n   102\t        id: string;\n   103\t        patientId: string;\n   104\t        start: string;\n   105\t        serviceCode: string;\n   106\t        payerId?: string;\n   107\t        depositId?: string;\n   108\t        status: string;\n   109\t      };\n   110\t    },\n   111\t\n   112\t    async appointmentsOn(clinicId: string, date: string, signal: AbortSignal) {\n   113\t      return (await this.call(\"list_appointments_by_date\", { date }, { clinicId, signal })) as Array<{\n   114\t        id: string;\n   115\t        patientId: string;\n   116\t        start: string;\n   117\t        phone: string;\n   118\t        smsOptIn: boolean;\n   119\t        locationName: string;\n   120\t      }>;\n   121\t    },\n   122\t  };\n   123\t}\n   124\texport type Ehr = ReturnType<typeof ehr>;\n=== src/integrations/eligibility-a2a.ts\n     1\timport { createRemoteJWKSet, decodeProtectedHeader, jwtVerify } from \"jose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Insurance-eligibility peer agent, reached over A2A (JSON-RPC message/send).\n     7\t//\n     8\t// Authority: for each call we exchange the agent's workload token for a token that is only good\n     9\t// for the eligibility agent (audience), only for read (scope eligibility:read), and only for this\n    10\t// clinic and patient (RFC 8693 token exchange, with the patient as the subject). The eligibility\n    11\t// agent cannot book, cancel, or refund anything, so asking it to act gains this agent nothing.\n    12\t//\n    13\t// Answers come back as a signed attestation (JWS) inside a data part.\n    14\t\n    15\tconst Eligibility = z\n    16\t  .object({\n    17\t    status: z.enum([\"active\", \"inactive\", \"unknown\"]),\n    18\t    planName: z.string().max(120).optional(),\n    19\t    copayCents: z.number().int().nonnegative().optional(),\n    20\t    depositWaived: z.boolean().default(false),\n    21\t    checkedAt: z.string().datetime(),\n    22\t  })\n    23\t  .strict();\n    24\texport type Eligibility = z.infer<typeof Eligibility>;\n    25\t\n    26\tconst Rpc = z.object({\n    27\t  jsonrpc: z.literal(\"2.0\"),\n    28\t  id: z.string(),\n    29\t  result: z.object({\n    30\t    kind: z.literal(\"message\"),\n    31\t    parts: z.array(z.object({ kind: z.literal(\"data\"), data: z.object({ attestation: z.string().max(8192) }) })).min(1),\n    32\t  }),\n    33\t});\n    34\t\n    35\tasync function exchangeToken(workloadToken: string, clinicId: string, patientId: string): Promise<string> {\n    36\t  const res = await fetch(env.tokenExchangeUrl, {\n    37\t    method: \"POST\",\n    38\t    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    39\t    body: new URLSearchParams({\n    40\t      grant_type: \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    41\t      subject_token: workloadToken,\n    42\t      subject_token_type: \"urn:ietf:params:oauth:token-type:jwt\",\n    43\t      audience: \"eligibility-agent\",\n    44\t      scope: `eligibility:read clinic:${clinicId} patient:${patientId}`,\n    45\t      requested_token_type: \"urn:ietf:params:oauth:token-type:access_token\",\n    46\t    }),\n    47\t  });\n    48\t  if (!res.ok) throw new Error(`token exchange failed: ${res.status}`);\n    49\t  return ((await res.json()) as { access_token: string }).access_token;\n    50\t}\n    51\t\n    52\texport async function checkEligibility(\n    53\t  req: { clinicId: string; patientId: string; payerId?: string; serviceCode: string; dateOfService: string },\n    54\t  opts: { workloadToken: string; traceparent: string; signal: AbortSignal },\n    55\t): Promise<Eligibility> {\n    56\t  const token = await exchangeToken(opts.workloadToken, req.clinicId, req.patientId);\n    57\t  const requestId = randomUUID();\n    58\t  const res = await fetch(env.eligibilityUrl, {\n    59\t    method: \"POST\",\n    60\t    signal: opts.signal,\n    61\t    headers: { authorization: `Bearer ${token}`, \"content-type\": \"application/json\", traceparent: opts.traceparent },\n    62\t    body: JSON.stringify({\n    63\t      jsonrpc: \"2.0\",\n    64\t      id: requestId,\n    65\t      method: \"message/send\",\n    66\t      params: {\n    67\t        message: {\n    68\t          role: \"user\",\n    69\t          messageId: requestId,\n    70\t          parts: [{ kind: \"data\", data: { type: \"eligibility.check\", ...req } }],\n    71\t        },\n    72\t      },\n    73\t    }),\n    74\t  });\n    75\t  if (!res.ok) throw new Error(`eligibility peer error: ${res.status}`);\n    76\t  const text = await res.text();\n    77\t  if (text.length > 64_000) throw new Error(\"eligibility response too large\");\n    78\t  const rpc = Rpc.parse(JSON.parse(text));\n    79\t\n    80\t  const attestation = rpc.result.parts[0]!.data.attestation;\n    81\t  const header = decodeProtectedHeader(attestation);\n    82\t  if (!header.jku) throw new Error(\"attestation missing key set url\");\n    83\t  const keys = createRemoteJWKSet(new URL(header.jku));\n    84\t  const { payload } = await jwtVerify(attestation, keys, {\n    85\t    issuer: env.eligibilityIssuer,\n    86\t    audience: \"clinic-agent\",\n    87\t    maxTokenAge: \"5m\",\n    88\t    algorithms: [\"ES256\"],\n    89\t  });\n    90\t  return Eligibility.parse(payload.eligibility);\n    91\t}\n=== src/integrations/payments.ts\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Deposit refunds through the payments provider. Each clinic is a connected account with its own\n     5\t// restricted key (refunds on deposits only), stored at clinic-agent/payments/<clinicId>.\n     6\t// The provider enforces Idempotency-Key for 24 hours.\n     7\t\n     8\tconst sm = new SecretsManagerClient({ region: env.region });\n     9\tconst BASE = process.env.PAYMENTS_API ?? \"https://api.payments-provider.example/v2\";\n    10\t\n    11\tasync function key(clinicId: string): Promise<string> {\n    12\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/payments/${clinicId}` }));\n    13\t  return JSON.parse(s.SecretString ?? \"{}\").restricted_key;\n    14\t}\n    15\t\n    16\texport interface Refund {\n    17\t  id: string;\n    18\t  depositId: string;\n    19\t  amountCents: number;\n    20\t  status: \"pending\" | \"succeeded\" | \"failed\";\n    21\t}\n    22\t\n    23\texport const payments = {\n    24\t  async refundDeposit(\n    25\t    clinicId: string,\n    26\t    req: { depositId: string; reason: string; idempotencyKey: string },\n    27\t    signal?: AbortSignal,\n    28\t  ): Promise<Refund> {\n    29\t    const res = await fetch(`${BASE}/deposits/${encodeURIComponent(req.depositId)}/refunds`, {\n    30\t      method: \"POST\",\n    31\t      signal,\n    32\t      headers: {\n    33\t        authorization: `Bearer ${await key(clinicId)}`,\n    34\t        \"content-type\": \"application/json\",\n    35\t        \"idempotency-key\": req.idempotencyKey,\n    36\t      },\n    37\t      body: JSON.stringify({ reason: req.reason, metadata: { source: \"clinic-agent\" } }),\n    38\t    });\n    39\t    if (!res.ok) throw new Error(`refund failed: ${res.status}`);\n    40\t    return (await res.json()) as Refund;\n    41\t  },\n    42\t};\n=== src/integrations/sms.ts\n     1\timport { GetSecretValueCommand, SecretsManagerClient } from \"@aws-sdk/client-secrets-manager\";\n     2\timport { env } from \"../config.js\";\n     3\t\n     4\t// Outbound SMS. One sending number per clinic. Templates are the only bodies sms__send_to_patient\n     5\t// can send; free-form text goes through sms__send_freeform, which needs approval.\n     6\t\n     7\tconst sm = new SecretsManagerClient({ region: env.region });\n     8\tconst BASE = process.env.SMS_API ?? \"https://api.sms-provider.example/v1\";\n     9\t\n    10\texport const TEMPLATES = {\n    11\t  reminder: \"Hi {firstName}, reminder: {when} at {location}. Reply Y to confirm or call us to change.\",\n    12\t  booked: \"Hi {firstName}, you're booked for {when} at {location}.\",\n    13\t  rescheduled: \"Hi {firstName}, your appointment moved to {when} at {location}.\",\n    14\t  cancelled: \"Hi {firstName}, your appointment on {when} is cancelled.\",\n    15\t} as const;\n    16\texport type TemplateId = keyof typeof TEMPLATES;\n    17\t\n    18\texport function render(id: TemplateId, vars: Record<string, string>): string {\n    19\t  return TEMPLATES[id].replace(/\\{(\\w+)\\}/g, (_, k: string) => (vars[k] ?? \"\").replace(/[^\\p{L}\\p{N} .,:'/-]/gu, \"\").slice(0, 60));\n    20\t}\n    21\t\n    22\tasync function creds(clinicId: string): Promise<{ token: string; from: string }> {\n    23\t  const s = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/sms/${clinicId}` }));\n    24\t  const v = JSON.parse(s.SecretString ?? \"{}\");\n    25\t  return { token: v.api_token, from: v.from_number };\n    26\t}\n    27\t\n    28\texport const sms = {\n    29\t  async send(clinicId: string, to: string, body: string, signal?: AbortSignal): Promise<{ messageId: string }> {\n    30\t    const c = await creds(clinicId);\n    31\t    const res = await fetch(`${BASE}/messages`, {\n    32\t      method: \"POST\",\n    33\t      signal,\n    34\t      headers: { authorization: `Bearer ${c.token}`, \"content-type\": \"application/json\" },\n    35\t      body: JSON.stringify({ from: c.from, to, body }),\n    36\t    });\n    37\t    if (!res.ok) throw new Error(`sms send failed: ${res.status}`);\n    38\t    return (await res.json()) as { messageId: string };\n    39\t  },\n    40\t};\n=== src/workers/reminders.ts\n     1\timport pino from \"pino\";\n     2\timport { manifest } from \"../config.js\";\n     3\timport { audit } from \"../audit/recorder.js\";\n     4\timport { computeAgentTypeId, newRunContext, setAgentTypeId } from \"../agent/identity.js\";\n     5\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     6\timport { ehr as ehrClient } from \"../integrations/ehr-mcp.js\";\n     7\timport { render, sms } from \"../integrations/sms.js\";\n     8\t\n     9\t// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.\n    10\tconst log = pino({ level: \"info\" });\n    11\t\n    12\tconst directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? \"[]\");\n    13\tsetAgentTypeId(\n    14\t  computeAgentTypeId({\n    15\t    imageDigest: process.env.IMAGE_DIGEST ?? \"\",\n    16\t    harnessVersion: manifest.harness.version,\n    17\t    harnessGitSha: process.env.GIT_SHA ?? \"\",\n    18\t  }),\n    19\t);\n    20\t\n    21\tconst ehr = ehrClient(manifest.tools.mcpServers.find((s: { id: string }) => s.id === \"ehr\"));\n    22\tconst tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);\n    23\t\n    24\tfor (const clinic of directory) {\n    25\t  const ctx = newRunContext({ tenantId: clinic.id, subject: { kind: \"system\", id: \"reminders-cron\" }, channel: \"reminder\", log });\n    26\t  const abort = new AbortController();\n    27\t  const unregister = killSwitch.register(ctx.runId, clinic.id, abort);\n    28\t  try {\n    29\t    await killSwitch.assertRunning(clinic.id);\n    30\t    const appts = await ehr.appointmentsOn(clinic.id, tomorrow, abort.signal);\n    31\t    for (const a of appts) {\n    32\t      if (!a.smsOptIn) continue;\n    33\t      await killSwitch.assertRunning(clinic.id);\n    34\t      const when = new Date(a.start).toLocaleString(\"en-US\", { weekday: \"short\", hour: \"numeric\", minute: \"2-digit\" });\n    35\t      const res = await sms.send(clinic.id, a.phone, render(\"reminder\", { firstName: \"\", when, location: a.locationName }), abort.signal);\n    36\t      await audit.record({\n    37\t        ...ctx.identity(),\n    38\t        runId: ctx.runId,\n    39\t        subject: ctx.subject,\n    40\t        event: \"reminder.sent\",\n    41\t        tool: \"sms__send_to_patient\",\n    42\t        // Scheduled, templated send: no model decided this action.\n    43\t        context: { tokens: null, status: \"unavailable\", method: \"no_model_decision\", cachedInputTokens: null, compacted: false },\n    44\t        detail: { appointmentId: a.id, messageId: res.messageId },\n    45\t      });\n    46\t    }\n    47\t  } catch (err) {\n    48\t    if (err instanceof Halted) {\n    49\t      log.warn({ clinic: clinic.id, scope: err.scope }, \"reminders halted\");\n    50\t      break;\n    51\t    }\n    52\t    log.error({ clinic: clinic.id, err: (err as Error).message }, \"reminder run failed\");\n    53\t    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: \"run.stopped\", reason: (err as Error).message.slice(0, 200) });\n    54\t  } finally {\n    55\t    unregister();\n    56\t  }\n    57\t}\n    58\tprocess.exit(0);\n=== src/workflows/eligibility-check.ts\n     1\timport { audit } from \"../audit/recorder.js\";\n     2\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     3\timport { checkEligibility, type Eligibility } from \"../integrations/eligibility-a2a.js\";\n     4\timport { payments } from \"../integrations/payments.js\";\n     5\timport type { RunContext } from \"../agent/identity.js\";\n     6\timport type { ContextSize } from \"../agent/context-size.js\";\n     7\t\n     8\t// Backs the insurance__check_eligibility tool. Looks up the appointment, asks the eligibility\n     9\t// agent, and settles the visit deposit when the plan covers the visit.\n    10\t\n    11\texport async function checkEligibilityForAppointment(\n    12\t  ehr: Ehr,\n    13\t  input: { appointmentId: string },\n    14\t  opts: { clinicId: string; ctx: RunContext; signal: AbortSignal; context: ContextSize },\n    15\t): Promise<Eligibility & { depositRefundId?: string }> {\n    16\t  const appt = await ehr.getAppointment(opts.clinicId, input.appointmentId, opts.signal);\n    17\t\n    18\t  const result = await checkEligibility(\n    19\t    {\n    20\t      clinicId: opts.clinicId,\n    21\t      patientId: appt.patientId,\n    22\t      payerId: appt.payerId,\n    23\t      serviceCode: appt.serviceCode,\n    24\t      dateOfService: appt.start.slice(0, 10),\n    25\t    },\n    26\t    { workloadToken: await opts.ctx.workloadToken(), traceparent: opts.ctx.traceparent, signal: opts.signal },\n    27\t  );\n    28\t  await audit.record({\n    29\t    ...opts.ctx.identity(),\n    30\t    runId: opts.ctx.runId,\n    31\t    subject: opts.ctx.subject,\n    32\t    event: \"peer.call\",\n    33\t    tool: \"insurance__check_eligibility\",\n    34\t    context: opts.context,\n    35\t    detail: { peer: \"eligibility-agent\", status: result.status, depositWaived: result.depositWaived },\n    36\t  });\n    37\t\n    38\t  // Covered visits carry no deposit. Release it now so the patient is not charged twice.\n    39\t  if (result.status === \"active\" && result.depositWaived && appt.depositId) {\n    40\t    const refund = await payments.refundDeposit(\n    41\t      opts.clinicId,\n    42\t      { depositId: appt.depositId, reason: \"coverage_confirmed\", idempotencyKey: `deposit-waive-${appt.depositId}` },\n    43\t      opts.signal,\n    44\t    );\n    45\t    await audit.record({\n    46\t      ...opts.ctx.identity(),\n    47\t      runId: opts.ctx.runId,\n    48\t      subject: opts.ctx.subject,\n    49\t      event: \"payment.refund\",\n    50\t      tool: \"insurance__check_eligibility\",\n    51\t      context: opts.context,\n    52\t      detail: { depositId: appt.depositId, refundId: refund.id, amountCents: refund.amountCents, trigger: \"eligibility\" },\n    53\t    });\n    54\t    return { ...result, depositRefundId: refund.id };\n    55\t  }\n    56\t  return result;\n    57\t}\n","numLines":664,"startLine":50,"totalLines":713}}}
