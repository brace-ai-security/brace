e\": \"G2\",\n      \"title\": \"Verified, namespaced tools\",\n      \"requirement\": \"Identify each tool by a verified server identity plus the tool name. Base server identity on the verified endpoint, credential, or registry namespace. A server's self-reported name is neither unique nor trustworthy. Flag lookalike and duplicate names across servers. Test that a new server can't quietly swap its tool in for an approved one.\",\n      \"not_covered\": [\n        {\n          \"problem\": \"Hidden instructions inside a tool's metadata\",\n          \"owner\": \"E04\"\n        },\n        {\n          \"problem\": \"A tool's description or schema changing after it was approved\",\n          \"owner\": \"E03\"\n        },\n        {\n          \"problem\": \"Peer agent identity not authenticated on each message\",\n          \"owner\": \"E07\"\n        },\n        {\n          \"problem\": \"Gateway not authenticating callers or authorizing each action\",\n          \"owner\": \"E06\"\n        }\n      ],\n      \"rating\": \"likely_pass\",\n      \"confidence\": \"medium\",\n      \"evidence\": [\n        {\n          \"file\": \"src/tools/registry.ts\",\n          \"line\": 128,\n          \"note\": \"Keys are the manifest server id plus tool name.\"\n        }\n      ],\n      \"checks\": [\n        {\n          \"id\": \"E05.1\",\n          \"check\": \"Tools are keyed by verified server identity (endpoint, credential, or registry namespace) plus tool name, never by bare tool name or a server's self-reported name.\",\n          \"verify\": \"1) Find the tool registry or lookup map. 2) Check its key is a verified endpoint, credential, or registry namespace plus tool name. 3) Answer no if tools are keyed by bare tool name or the server's self-reported name (`serverInfo.name`), or a later server overwrites an earlier entry with the same tool name.\",\n          \"met\": \"yes\",\n          \"evidence\": \"src/tools/registry.ts:128\",\n          \"quote\": \"key: `${