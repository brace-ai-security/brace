{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UYjKjw5bbgFAD6D9xk91UA","type":"tool_result","content":"40\t    39\t          Key: { pk: key },\n41\t    40\t          UpdateExpression: \"ADD used :n SET expiresAt = if_not_exists(expiresAt, :exp)\",\n42\t    41\t          ConditionExpression: \"attribute_not_exists(used) OR used <= :room\",\n43\t    42\t          ExpressionAttributeValues: {\n44\t    43\t            \":n\": amount,\n45\t    44\t            \":room\": max - amount,\n46\t    45\t            \":exp\": Math.floor(Date.now() / 1000) + ttlSeconds,\n47\t    46\t          },\n48\t    47\t          ReturnValues: \"UPDATED_NEW\",\n49\t    48\t        }),\n50\t    49\t      );\n51\t    50\t      return { ok: true, used: Number(res.Attributes?.used ?? amount) };\n52\t    51\t    } catch (err) {\n53\t    52\t      if ((err as { name?: string }).name === \"ConditionalCheckFailedException\") return { ok: false, used: max };\n54\t    53\t      throw err;\n55\t    54\t    }\n56\t    55\t  }\n57\t    56\t}\n58\t    57\t\n59\t    58\texport interface Usage {\n60\t    59\t  input_tokens: number;\n61\t    60\t  output_tokens: number;\n62\t    61\t  cache_read_input_tokens?: number | null;\n63\t    62\t  cache_creation_input_tokens?: number | null;\n64\t    63\t}\n65\t    64\t\n66\t    65\tconst day = () => new Date().toISOString().slice(0, 10);\n67\t    66\tconst minute = () => new Date().toISOString().slice(0, 16);\n68\t    67\t\n69\t    68\texport class RunBudget {\n70\t    69\t  readonly abort = new AbortController();\n71\t    70\t  private started = Date.now();\n72\t    71\t  private timer: NodeJS.Timeout;\n73\t    72\t  private turns = 0;\n74\t    73\t  private inTok = 0;\n75\t    74\t  private outTok = 0;\n76\t    75\t  private cost = 0;\n77\t    76\t  private toolCalls = 0;\n78\t    77\t  private toolTimes: number[] = [];\n79\t    78\t  private peerCalls = 0;\n80\t    79\t\n81\t    80\t  constructor(\n82\t    81\t    private b: Budgets,\n83\t    82\t    private store: QuotaStore,\n84\t    83\t    private scope: { tenantId: string; subjectId: string },\n85\t    84\t    private now: () => number = Date.now,\n86\t    85\t  ) {\n87\t    86\t    this.started = this.now();\n88\t    87\t    this.timer = setTimeout(\n89\t    88\t      () => this.abort.abort(new BudgetExceeded(\"wall_time\", this.b.run.maxWallMs, this.b.run.maxWallMs)),\n90\t    89\t      this.b.run.maxWallMs,\n91\t    90\t    );\n92\t    91\t  }\n93\t    92\t\n94\t    93\t  get signal(): AbortSignal {\n95\t    94\t    return this.abort.signal;\n96\t    95\t  }\n97\t    96\t\n98\t    97\t  dispose(): void {\n99\t    98\t    clearTimeout(this.timer);\n100\t    99\t  }\n101\t   100\t\n102\t   101\t  private check(limit: LimitName, used: number, max: number): void {\n103\t   102\t    if (used > max) {\n104\t   103\t      const e = new BudgetExceeded(limit, used, max);\n105\t   104\t      this.abort.abort(e);\n106\t   105\t      throw e;\n107\t   106\t    }\n108\t   107\t  }\n109\t   108\t\n110\t   109\t  private checkWall(): void {\n111\t   110\t    this.check(\"wall_time\", this.now() - this.started, this.b.run.maxWallMs);\n112\t   111\t  }\n113\t   112\t\n114\t   113\t  turn(): void {\n115\t   114\t    this.checkWall();\n116\t   115\t    this.turns += 1;\n117\t   116\t    this.check(\"turns\", this.turns, this.b.run.maxTurns);\n118\t   117\t  }\n119\t   118\t\n120\t   119\t  async recordUsage(u: Usage, model: string): Promise<void> {\n121\t   120\t    const price = this.b.pricingUsdPerMTok[model];\n122\t   121\t    if (!price) throw new Error(`no pricing for model ${model}`);\n123\t   122\t    const cacheRead = u.cache_read_input_tokens ?? 0;\n124\t   123\t    const cacheWrite = u.cache_creation_input_tokens ?? 0;\n125\t   124\t    const callCost =\n126\t   125\t      (u.input_tokens * price.input +\n127\t   126\t        u.output_tokens * price.output +\n128\t   127\t        cacheRead * price.cacheRead +\n129\t   128\t        cacheWrite * price.cacheWrite) /\n130\t   129\t      1_000_000;\n131\t   130\t\n132\t   131\t    this.inTok += u.input_tokens + cacheRead + cacheWrite;\n133\t   132\t    this.outTok += u.output_tokens;\n134\t   133\t    this.cost += callCost;\n135\t   134\t    this.check(\"input_tokens\", this.inTok, this.b.run.maxInputTokens);\n136\t   135\t    this.check(\"output_tokens\", this.outTok, this.b.run.maxOutputTokens);\n137\t   136\t    this.check(\"run_cost\", this.cost, this.b.run.maxCostUsd);\n138\t   137\t\n139\t   138\t    const q = this.b.quotas;\n140\t   139\t    await this.shared(\"subject_daily_cost\", `cost#subject#${this.scope.subjectId}#${day()}`, callCost, q.perSubjectDailyUsd, 86400);\n141\t   140\t    await this.shared(\"tenant_daily_cost\", `cost#tenant#${this.scope.tenantId}#${day()}`, callCost, q.perTenantDailyUsd, 86400);\n142\t   141\t    await this.shared(\"fleet_daily_cost\", `cost#fleet#${day()}`, callCost, q.fleetDailyUsd, 86400);\n143\t   142\t  }\n144\t   143\t\n145\t   144\t  async toolCall(tool: string): Promise<void> {\n146\t   145\t    this.checkWall();\n147\t   146\t    this.toolCalls += 1;\n148\t   147\t    this.check(\"tool_calls\", this.toolCalls, this.b.run.maxToolCalls);\n149\t   148\t\n150\t   149\t    const t = this.now();\n151\t   150\t    this.toolTimes = this.toolTimes.filter((x) => t - x < 60_000);\n152\t   151\t    this.toolTimes.push(t);\n153\t   152\t    this.check(\"tool_call_rate\", this.toolTimes.length, this.b.run.maxToolCallsPerMinute);\n154\t   153\t\n155\t   154\t    if (tool.startsWith(\"insurance__\")) {\n156\t   155\t      this.peerCalls += 1;\n157\t   156\t      this.check(\"peer_calls\", this.peerCalls, this.b.run.maxPeerCalls);\n158\t   157\t    }\n159\t   158\t\n160\t   159\t    const q = this.b.quotas;\n161\t   160\t    await this.shared(\"tenant_tool_rate\", `rate#tenant#${this.scope.tenantId}#${minute()}`, 1, q.perTenantToolCallsPerMinute, 120);\n162\t   161\t    await this.shared(\"fleet_tool_rate\", `rate#fleet#${minute()}`, 1, q.fleetToolCallsPerMinute, 120);\n163\t   162\t  }\n164\t   163\t\n165\t   164\t  private async shared(limit: LimitName, key: string, amount: number, max: number, ttl: number): Promise<void> {\n166\t   165\t    const r = await this.store.add(key, amount, max, ttl);\n167\t   166\t    if (!r.ok) {\n168\t   167\t      const e = new BudgetExceeded(limit, r.used + amount, max);\n169\t   168\t      this.abort.abort(e);\n170\t   169\t      throw e;\n171\t   170\t    }\n172\t   171\t  }\n173\t   172\t}\n174\t=== src/agent/classifier.ts\n175\t     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n176\t     2\timport { createHash } from \"node:crypto\";\n177\t     3\timport { readFileSync } from \"node:fs\";\n178\t     4\timport { join } from \"node:path\";\n179\t     5\timport { z } from \"zod\";\n180\t     6\timport { CLASSIFIER_MODEL, ROOT } from \"../config.js\";\n181\t     7\t\n182\t     8\t// Helper model that routes messages before the agent sees them. Urgent and complaint messages go\n183\t     9\t// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\n184\t    10\t// malformed output, unknown label, or a served model other than the pinned snapshot) routes the\n185\t    11\t// message to staff. A failed classifier never defaults to \"send it to the agent\".\n186\t    12\t\n187\t    13\texport const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");\n188\t    14\texport const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\n189\t    15\t\n190\t    16\texport const CLASSIFIER_ID = `sha256:${createHash(\"sha256\")\n191\t    17\t  .update(CLASSIFIER_MODEL)\n192\t    18\t  .update(\"\\0\")\n193\t    19\t  .update(CLASSIFIER_PROMPT)\n194\t    20\t  .update(\"\\0\")\n195\t    21\t  .update(JSON.stringify(CLASSIFIER_CONFIG))\n196\t    22\t  .digest(\"hex\")}`;\n197\t    23\t\n198\t    24\tconst Intent = z.enum([\"book\", \"reschedule\", \"cancel\", \"confirm\", \"coverage\", \"info\", \"urgent\", \"complaint\", \"other\"]);\n199\t    25\tconst Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();\n200\t    26\t\n201\t    27\texport type Route = \"agent\" | \"staff\";\n202\t    28\t\n203\t    29\texport interface ClassifierDecision {\n204\t    30\t  classifierId: string;\n205\t    31\t  requestedModel: string;\n206\t    32\t  servedModel: string | null;\n207\t    33\t  intent: z.infer<typeof Intent> | null;\n208\t    34\t  confidence: number | null;\n209\t    35\t  route: Route;\n210\t    36\t  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n211\t    37\t}\n212\t    38\t\n213\t    39\tconst MIN_CONFIDENCE = 0.6;\n214\t    40\t\n215\t    41\texport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n216\t    42\t  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n217\t    43\t  let res: Anthropic.Message;\n218\t    44\t  try {\n219\t    45\t    res = await client.messages.create(\n220\t    46\t      {\n221\t    47\t        model: CLASSIFIER_MODEL,\n222\t    48\t        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n223\t    49\t        temperature: CLASSIFIER_CONFIG.temperature,\n224\t    50\t        system: CLASSIFIER_PROMPT,\n225\t    51\t        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n226\t    52\t      },\n227\t    53\t      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n228\t    54\t    );\n229\t    55\t  } catch (err) {\n230\t    56\t    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n231\t    57\t    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n232\t    58\t  }\n233\t    59\t\n234\t    60\t  if (res.model !== CLASSIFIER_MODEL) {\n235\t    61\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n236\t    62\t  }\n237\t    63\t\n238\t    64\t  const textOut = res.content.find((b) => b.type === \"text\");\n239\t    65\t  let parsed: z.infer<typeof Output>;\n240\t    66\t  try {\n241\t    67\t    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n242\t    68\t  } catch {\n243\t    69\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n244\t    70\t  }\n245\t    71\t\n246\t    72\t  if (parsed.confidence < MIN_CONFIDENCE) {\n247\t    73\t    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n248\t    74\t  }\n249\t    75\t  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n250\t    76\t  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n251\t    77\t}\n252\t=== src/agent/context-size.ts\n253\t     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n254\t     2\t\n255\t     3\t// Context size at decision time, in tokens.\n256\t     4\t//\n257\t     5\t// Counting method. Each model decision is one Messages API call. Its response usage reports the\n258\t     6\t// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and\n259\t     7\t// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,\n260\t     8\t// including the part served from the prompt cache and the provider's own tool-use preamble, which\n261\t     9\t// the provider counts but does not show. This is a per-call value, not a run or billing total.\n262\t    10\t// We record it as \"measured\", with the cached share kept separately.\n263\t    11\t//\n264\t    12\t// If the response carries no usage (stream cut off, aborted call), we fall back to the\n265\t    13\t// count_tokens estimate taken just before the call for the same request, and mark it \"estimated\".\n266\t    14\t// If neither exists the value is null with status \"unavailable\". It is never reported as 0.\n267\t    15\t//\n268\t    16\t// This harness never compacts, summarizes, or truncates history inside a run, so compacted is\n269\t    17\t// always false; a run that would outgrow its token budget stops instead (see budget.ts).\n270\t    18\texport interface ContextSize {\n271\t    19\t  tokens: number | null;\n272\t    20\t  status: \"measured\" | \"estimated\" | \"unavailable\";\n273\t    21\t  method: string;\n274\t    22\t  cachedInputTokens: number | null;\n275\t    23\t  compacted: boolean;\n276\t    24\t}\n277\t    25\t\n278\t    26\texport const USAGE_METHOD = \"anthropic.messages.usage(input+cache_read+cache_creation)\";\n279\t    27\texport const COUNT_METHOD = \"anthropic.messages.count_tokens(pre-call estimate)\";\n280\t    28\t\n281\t    29\texport async function measureBeforeCall(\n282\t    30\t  client: Anthropic,\n283\t    31\t  req: Anthropic.MessageCountTokensParams,\n284\t    32\t  signal: AbortSignal,\n285\t    33\t): Promise<ContextSize> {\n286\t    34\t  try {\n287\t    35\t    const r = await client.messages.countTokens(req, { signal });\n288\t    36\t    return { tokens: r.input_tokens, status: \"estimated\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n289\t    37\t  } catch {\n290\t    38\t    return { tokens: null, status: \"unavailable\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n291\t    39\t  }\n292\t    40\t}\n293\t    41\t\n294\t    42\texport function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {\n295\t    43\t  if (!usage) return pre;\n296\t    44\t  const cacheRead = usage.cache_read_input_tokens ?? 0;\n297\t    45\t  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);\n298\t    46\t  return { tokens: total, status: \"measured\", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };\n299\t    47\t}\n300\t    48\t\n301\t    49\t// Span attributes so the value is searchable next to the action in traces as well as audit.\n302\t    50\texport function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {\n303\t    51\t  return {\n304\t    52\t    ...(c.tokens === null ? {} : { \"clinic_agent.context.tokens\": c.tokens }),\n305\t    53\t    \"clinic_agent.context.status\": c.status,\n306\t    54\t    \"clinic_agent.context.method\": c.method,\n307\t    55\t    \"gen_ai.conversation.compacted\": c.compacted,\n308\t    56\t  };\n309\t    57\t}\n310\t=== src/agent/identity.ts\n311\t     1\timport { createHash, randomUUID } from \"node:crypto\";\n312\t     2\timport { readdirSync, readFileSync } from \"node:fs\";\n313\t     3\timport { join } from \"node:path\";\n314\t     4\timport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n315\t     5\t\n316\t     6\t// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n317\t     7\t// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\n318\t     8\tconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n319\t     9\t\n320\t    10\texport interface TypeIdInputs {\n321\t    11\t  imageDigest: string;\n322\t    12\t  harnessVersion: string;\n323\t    13\t  harnessGitSha: string;\n324\t    14\t}\n325\t    15\t\n326\t    16\texport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n327\t    17\t  const parts: Array<[string, Buffer]> = [\n328\t    18\t    [\"image\", Buffer.from(inputs.imageDigest)],\n329\t    19\t    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n330\t    20\t    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n331\t    21\t  ];\n332\t    22\t  const promptDir = join(ROOT, \"prompts\");\n333\t    23\t  const promptFiles = readdirSync(promptDir)\n334\t    24\t    .filter((f) => f.endsWith(\".txt\"))\n335\t    25\t    .sort();\n336\t    26\t  for (const f of promptFiles) {\n337\t    27\t    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n338\t    28\t  }\n339\t    29\t  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n340\t    30\t  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n341\t    31\t  for (const f of CONFIG_FILES) {\n342\t    32\t    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n343\t    33\t  }\n344\t    34\t  return parts;\n345\t    35\t}\n346\t    36\t\n347\t    37\texport function computeAgentTypeId(inputs: TypeIdInputs): string {\n348\t    38\t  const h = createHash(\"sha256\");\n349\t    39\t  for (const [label, bytes] of typeIdManifest(inputs)) {\n350\t    40\t    h.update(label);\n351\t    41\t    h.update(\"\\0\");\n352\t    42\t    h.update(bytes);\n353\t    43\t    h.update(\"\\0\");\n354\t    44\t  }\n355\t    45\t  return `sha256:${h.digest(\"hex\")}`;\n356\t    46\t}\n357\t    47\t\n358\t    48\t// One instance id per process. Pods are the unit an operator contains.\n359\t    49\texport const AGENT_INSTANCE_ID = randomUUID();\n360\t    50\t\n361\t    51\tlet AGENT_TYPE_ID = \"\";\n362\t    52\texport function setAgentTypeId(id: string): void {\n363\t    53\t  AGENT_TYPE_ID = id;\n364\t    54\t}\n365\t    55\t\n366\t    56\texport interface Subject {\n367\t    57\t  kind: \"patient\" | \"staff\" | \"system\";\n368\t    58\t  id: string;\n369\t    59\t}\n370\t    60\t\n371\t    61\texport interface Logger {\n372\t    62\t  info(obj: object, msg?: string): void;\n373\t    63\t  warn(obj: object, msg?: string): void;\n374\t    64\t  error(obj: object, msg?: string): void;\n375\t    65\t}\n376\t    66\t\n377\t    67\texport interface RunContext {\n378\t    68\t  runId: string;\n379\t    69\t  tenantId: string;\n380\t    70\t  subject: Subject;\n381\t    71\t  channel: \"sms\" | \"webchat\" | \"reminder\";\n382\t    72\t  traceparent: string;\n383\t    73\t  log: Logger;\n384\t    74\t  identity(): {\n385\t    75\t    accountableParty: string;\n386\t    76\t    operationalOwner: string;\n387\t    77\t    tenantId: string;\n388\t    78\t    agentTypeId: string;\n389\t    79\t    agentInstanceId: string;\n390\t    80\t    traceparent: string;\n391\t    81\t  };\n392\t    82\t  workloadToken(): Promise<string>;\n393\t    83\t}\n394\t    84\t\n395\t    85\t// Projected service-account token (audience: the group STS), rotated by the kubelet.\n396\t    86\tconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n397\t    87\t\n398\t    88\texport function newRunContext(init: {\n399\t    89\t  tenantId: string;\n400\t    90\t  subject: Subject;\n401\t    91\t  channel: RunContext[\"channel\"];\n402\t    92\t  traceparent?: string;\n403\t    93\t  log: Logger;\n404\t    94\t}): RunContext {\n405\t    95\t  const runId = randomUUID();\n406\t    96\t  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n407\t    97\t  return {\n408\t    98\t    runId,\n409\t    99\t    tenantId: init.tenantId,\n410\t   100\t    subject: init.subject,\n411\t   101\t    channel: init.channel,\n412\t   102\t    traceparent,\n413\t   103\t    log: init.log,\n414\t   104\t    identity: () => ({\n415\t   105\t      accountableParty: env.accountableParty,\n416\t   106\t      operationalOwner: env.operationalOwner,\n417\t   107\t      tenantId: init.tenantId,\n418\t   108\t      agentTypeId: AGENT_TYPE_ID,\n419\t   109\t      agentInstanceId: AGENT_INSTANCE_ID,\n420\t   110\t      traceparent,\n421\t   111\t    }),\n422\t   112\t    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n423\t   113\t  };\n424\t   114\t}\n425\t=== src/agent/loop.ts\n426\t     1\timport Anthropic from \"@anthropic-ai/sdk\";\n427\t     2\timport { readFileSync } from \"node:fs\";\n428\t     3\timport { join } from \"node:path\";\n429\t     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n430\t     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n431\t     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n432\t     7\timport { executeTool } from \"../tools/executor.js\";\n433\t     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n434\t     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n435\t    10\timport { classifyIntent } from \"./classifier.js\";\n436\t    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n437\t    12\timport type { RunContext } from \"./identity.js\";\n438\t    13\t\n439\t    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n440\t    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n441\t    16\tconst quotaStore = new DynamoQuotaStore();\n442\t    17\t\n443\t    18\texport interface AgentReply {\n444\t    19\t  text: string;\n445\t    20\t  handoff: null | { reason: string };\n446\t    21\t}\n447\t    22\t\n448\t    23\tfunction escapeTags(s: string): string {\n449\t    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n450\t    25\t}\n451\t    26\t\n452\t    27\texport async function runAgent(\n453\t    28\t  registry: ToolRegistry,\n454\t    29\t  ctx: RunContext,\n455\t    30\t  clinic: { name: string },\n456\t    31\t  patientText: string,\n457\t    32\t): Promise<AgentReply> {\n458\t    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n459\t    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n460\t    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n461\t    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n462\t    37\t\n463\t    38\t  try {\n464\t    39\t    await killSwitch.assertRunning(ctx.tenantId);\n465\t    40\t\n466\t    41\t    const intent = await classifyIntent(anthropic, patientText);\n467\t    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n468\t    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n469\t    44\t    if (intent.route === \"staff\") {\n470\t    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n471\t    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n472\t    47\t    }\n473\t    48\t\n474\t    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n475\t    50\t    const tools = registry.definitions();\n476\t    51\t    const messages: Anthropic.MessageParam[] = [\n477\t    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n478\t    53\t    ];\n479\t    54\t\n480\t    55\t    for (;;) {\n481\t    56\t      budget.turn();\n482\t    57\t      await killSwitch.assertRunning(ctx.tenantId);\n483\t    58\t\n484\t    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n485\t    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n486\t    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n487\t    62\t      const contextSize = completeFromUsage(pre, res.usage);\n488\t    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n489\t    64\t\n490\t    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n491\t    66\t      await audit.record({\n492\t    67\t        ...ident(),\n493\t    68\t        event: \"model.decision\",\n494\t    69\t        context: contextSize,\n495\t    70\t        detail: {\n496\t    71\t          servedModel: res.model,\n497\t    72\t          stopReason: res.stop_reason,\n498\t    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n499\t    74\t          span: spanAttributes(contextSize),\n500\t    75\t        },\n501\t    76\t      });\n502\t    77\t\n503\t    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n504\t    79\t        const text = res.content\n505\t    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n506\t    81\t          .map((b) => b.text)\n507\t    82\t          .join(\"\\n\")\n508\t    83\t          .slice(0, 320);\n509\t    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n510\t    85\t        return { text, handoff: null };\n511\t    86\t      }\n512\t    87\t\n513\t    88\t      messages.push({ role: \"assistant\", content: res.content });\n514\t    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n515\t    90\t      for (const call of toolUses) {\n516\t    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n517\t    92\t      }\n518\t    93\t      messages.push({ role: \"user\", content: results });\n519\t    94\t    }\n520\t    95\t  } catch (err) {\n521\t    96\t    const reason =\n522\t    97\t      err instanceof BudgetExceeded\n523\t    98\t        ? `budget:${err.limit}`\n524\t    99\t        : err instanceof Halted\n525\t   100\t          ? `halted:${err.scope}`\n526\t   101\t          : err instanceof AuditUnavailable\n527\t   102\t            ? \"audit_unavailable\"\n528\t   103\t            : budget.signal.aborted\n529\t   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n530\t   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n531\t   106\t    try {\n532\t   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n533\t   108\t    } catch {\n534\t   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n535\t   110\t    }\n536\t   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n537\t   112\t  } finally {\n538\t   113\t    budget.dispose();\n539\t   114\t    unregister();\n540\t   115\t  }\n541\t   116\t}\n542\t=== src/tools/approvals.ts\n543\t     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n544\t     2\timport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\n545\t     3\timport { createHash, randomUUID } from \"node:crypto\";\n546\t     4\timport { env, policy } from \"../config.js\";\n547\t     5\t\n548\t     6\t// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n549\t     7\t// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n550\t     8\t// approvedAt); the agent then retries the tool with the approval id.\n551\t     9\t\n552\t    10\texport interface ApprovalRecord {\n553\t    11\t  id: string;\n554\t    12\t  status: \"pending\" | \"approved\" | \"rejected\";\n555\t    13\t  tool: string;\n556\t    14\t  tenantId: string;\n557\t    15\t  agentInstanceId: string;\n558\t    16\t  runId: string;\n559\t    17\t  argsHash: string;\n560\t    18\t  summary: string;\n561\t    19\t  requestedAt: string;\n562\t    20\t  expiresAt: string;\n563\t    21\t  approvedBy?: string;\n564\t    22\t  approverRole?: string;\n565\t    23\t  approvedAt?: string;\n566\t    24\t}\n567\t    25\t\n568\t    26\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n569\t    27\t\n570\t    28\texport function hashArgs(args: Record<string, unknown>): string {\n571\t    29\t  const canonical = JSON.stringify(args, Object.keys(args).sort());\n572\t    30\t  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n573\t    31\t}\n574\t    32\t\n575\t    33\texport async function requestApproval(req: {\n576\t    34\t  tool: string;\n577\t    35\t  tenantId: string;\n578\t    36\t  agentInstanceId: string;\n579\t    37\t  runId: string;\n580\t    38\t  args: Record<string, unknown>;\n581\t    39\t  summary: string;\n582\t    40\t}): Promise<ApprovalRecord> {\n583\t    41\t  const now = Date.now();\n584\t    42\t  const rec: ApprovalRecord = {\n585\t    43\t    id: randomUUID(),\n586\t    44\t    status: \"pending\",\n587\t    45\t    tool: req.tool,\n588\t    46\t    tenantId: req.tenantId,\n589\t    47\t    agentInstanceId: req.agentInstanceId,\n590\t    48\t    runId: req.runId,\n591\t    49\t    argsHash: hashArgs(req.args),\n592\t    50\t    summary: req.summary,\n593\t    51\t    requestedAt: new Date(now).toISOString(),\n594\t    52\t    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n595\t    53\t  };\n596\t    54\t  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n597\t    55\t  return rec;\n598\t    56\t}\n599\t    57\t\n600\t    58\texport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n601\t    59\t\n602\t    60\texport async function checkApproval(req: {\n603\t    61\t  approvalId: string;\n604\t    62\t  tool: string;\n605\t    63\t  tenantId: string;\n606\t    64\t  args: Record<string, unknown>;\n607\t    65\t}): Promise<ApprovalCheck> {\n608\t    66\t  let rec: ApprovalRecord | undefined;\n609\t    67\t  try {\n610\t    68\t    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n611\t    69\t    rec = res.Item as ApprovalRecord | undefined;\n612\t    70\t  } catch (err) {\n613\t    71\t    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n614\t    72\t  }\n615\t    73\t  if (!rec) return { ok: false, reason: \"approval not found\" };\n616\t    74\t  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n617\t    75\t  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n618\t    76\t  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n619\t    77\t  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n620\t    78\t  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n621\t    79\t    return { ok: false, reason: \"approver lacks authority\" };\n622\t    80\t  }\n623\t    81\t  return { ok: true, approval: rec };\n624\t    82\t}\n625\t=== src/tools/executor.ts\n626\t     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n627\t     2\timport { allowlist, policy } from \"../config.js\";\n628\t     3\timport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\n629\t     4\timport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\n630\t     5\timport type { ContextSize } from \"../agent/context-size.js\";\n631\t     6\timport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\n632\t     7\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n633\t     8\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n634\t     9\timport { payments } from \"../integrations/payments.js\";\n635\t    10\timport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\n636\t    11\timport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\n637\t    12\timport { checkApproval, requestApproval } from \"./approvals.js\";\n638\t    13\timport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n639\t    14\t\n640\t    15\texport interface Decision {\n641\t    16\t  contextSize: ContextSize;\n642\t    17\t  budget: RunBudget;\n643\t    18\t}\n644\t    19\t\n645\t    20\tconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n646\t    21\t// Arguments the harness consumes itself; they are never forwarded to a tool.\n647\t    22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n648\t    23\t\n649\t    24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n650\t    25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n651\t    26\t}\n652\t    27\t\n653\t    28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n654\t    29\t  return `${tool}(${Object.entries(args)\n655\t    30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n656\t    31\t    .join(\", \")})`.slice(0, 500);\n657\t    32\t}\n658\t    33\t\n659\t    34\texport async function executeTool(\n660\t    35\t  registry: ToolRegistry,\n661\t    36\t  ctx: RunContext,\n662\t    37\t  call: Anthropic.ToolUseBlock,\n663\t    38\t  d: Decision,\n664\t    39\t): Promise<Anthropic.ToolResultBlockParam> {\n665\t    40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n666\t    41\t  const base = {\n667\t    42\t    ...ctx.identity(),\n668\t    43\t    runId: ctx.runId,\n669\t    44\t    subject: ctx.subject,\n670\t    45\t    tool: call.name,\n671\t    46\t    toolUseId: call.id,\n672\t    47\t    policyVersion: policy.version,\n673\t    48\t    context: d.contextSize,\n674\t    49\t  };\n675\t    50\t  const deny = async (reason: string) => {\n676\t    51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n677\t    52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n678\t    53\t  };\n679\t    54\t\n680\t    55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n681\t    56\t  const tool = registry.get(call.name);\n682\t    57\t  if (!tool) return deny(\"not_registered\");\n683\t    58\t\n684\t    59\t  await killSwitch.assertRunning(ctx.tenantId);\n685\t    60\t  await d.budget.toolCall(call.name);\n686\t    61\t\n687\t    62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n688\t    63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n689\t    64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n690\t    65\t\n691\t    66\t  let approvalId: string | undefined;\n692\t    67\t  if (policy.highImpactTools.includes(call.name)) {\n693\t    68\t    if (typeof input.approvalId !== \"string\") {\n694\t    69\t      const rec = await requestApproval({\n695\t    70\t        tool: call.name,\n696\t    71\t        tenantId: clinicId,\n697\t    72\t        agentInstanceId: AGENT_INSTANCE_ID,\n698\t    73\t        runId: ctx.runId,\n699\t    74\t        args,\n700\t    75\t        summary: summarize(call.name, args),\n701\t    76\t      });\n702\t    77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n703\t    78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n704\t    79\t    }\n705\t    80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n706\t    81\t    if (!check.ok) return deny(check.reason);\n707\t    82\t    approvalId = check.approval.id;\n708\t    83\t  }\n709\t    84\t\n710\t    85\t  try {\n711\t    86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n712\t    87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n713\t    88\t    const safe = redactPhi(raw);\n714\t    89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n715\t    90\t    return toolResult(call.id, safe);\n716\t    91\t  } catch (err) {\n717\t    92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n718\t    93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n719\t    94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n720\t    95\t  }\n721\t    96\t}\n722\t    97\t\n723\t    98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n724\t    99\t\n725\t   100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n726\t   101\t  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n727\t   102\t    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n728\t   103\t\n729\t   104\t  return {\n730\t   105\t    payments: [\n731\t   106\t      {\n732\t   107\t        name: \"refund_deposit\",\n733\t   108\t        definition: {\n734\t   109\t          name: \"payments__refund_deposit\",\n735\t   110\t          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n736\t   111\t          input_schema: {\n737\t   112\t            type: \"object\",\n738\t   113\t            properties: {\n739\t   114\t              depositId: { type: \"string\" },\n740\t   115\t              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n741\t   116\t              approvalId: { type: \"string\" },\n742\t   117\t            },\n743\t   118\t            required: [\"depositId\", \"reason\"],\n744\t   119\t          },\n745\t   120\t        },\n746\t   121\t        invoke: async (a, o) =>\n747\t   122\t          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n748\t   123\t      },\n749\t   124\t    ],\n750\t   125\t    sms: [\n751\t   126\t      {\n752\t   127\t        name: \"send_to_patient\",\n753\t   128\t        definition: {\n754\t   129\t          name: \"sms__send_to_patient\",\n755\t   130\t          description: \"Send a templated SMS to the phone number on the patient's record.\",\n756\t   131\t          input_schema: {\n757\t   132\t            type: \"object\",\n758\t   133\t            properties: {\n759\t   134\t              patientId: { type: \"string\" },\n760\t   135\t              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n761\t   136\t              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n762\t   137\t            },\n763\t   138\t            required: [\"patientId\", \"template\"],\n764\t   139\t          },\n765\t   140\t        },\n766\t   141\t        invoke: async (a, o) => {\n767\t   142\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n768\t   143\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n769\t   144\t          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n770\t   145\t          return sms.send(o.clinicId, c.phone, body, o.signal);\n771\t   146\t        },\n772\t   147\t      },\n773\t   148\t      {\n774\t   149\t        name: \"send_freeform\",\n775\t   150\t        definition: {\n776\t   151\t          name: \"sms__send_freeform\",\n777\t   152\t          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n778\t   153\t          input_schema: {\n779\t   154\t            type: \"object\",\n780\t   155\t            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n781\t   156\t            required: [\"patientId\", \"body\"],\n782\t   157\t          },\n783\t   158\t        },\n784\t   159\t        invoke: async (a, o) => {\n785\t   160\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n786\t   161\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n787\t   162\t          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n788\t   163\t        },\n789\t   164\t      },\n790\t   165\t    ],\n791\t   166\t    insurance: [\n792\t   167\t      {\n793\t   168\t        name: \"check_eligibility\",\n794\t   169\t        definition: {\n795\t   170\t          name: \"insurance__check_eligibility\",\n796\t   171\t          description: \"Check whether the patient's insurance covers an appointment.\",\n797\t   172\t          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n798\t   173\t        },\n799\t   174\t        invoke: async (a, o) =>\n800\t   175\t          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n801\t   176\t            clinicId: o.clinicId,\n802\t   177\t            ctx: o.runCtx as RunContext,\n803\t   178\t            signal: o.signal,\n804\t   179\t            context: o.context,\n805\t   180\t          }),\n806\t   181\t      },\n807\t   182\t    ],\n808\t   183\t  };\n809\t   184\t}\n810\t=== src/tools/metadata-scan.ts\n811\t     1\t// Scans MCP server metadata before any of it reaches the model.\n812\t     2\t//\n813\t     3\t// Covered fields: server instructions, tool name, title, description, every string inside the\n814\t     4\t// input and output schemas (titles, descriptions, enum values, defaults, examples), annotations,\n815\t     5\t// prompt names/descriptions/argument descriptions, and resource template names/descriptions/URIs.\n816\t     6\t//\n817\t     7\t// A finding on a tool rejects that tool. A finding on the server instructions or a prompt or\n818\t     8\t// resource template rejects the whole server. If the scanner itself throws, the caller treats the\n819\t     9\t// server as unavailable; nothing unscanned is passed on.\n820\t    10\t\n821\t    11\texport interface ToolMeta {\n822\t    12\t  name: string;\n823\t    13\t  title?: string;\n824\t    14\t  description?: string;\n825\t    15\t  inputSchema?: unknown;\n826\t    16\t  outputSchema?: unknown;\n827\t    17\t  annotations?: Record<string, unknown>;\n828\t    18\t}\n829\t    19\t\n830\t    20\texport interface ServerMeta {\n831\t    21\t  instructions?: string;\n832\t    22\t  tools: ToolMeta[];\n833\t    23\t  prompts?: Array<{ name: string; description?: string; arguments?: Array<{ name: string; description?: string }> }>;\n834\t    24\t  resourceTemplates?: Array<{ name: string; uriTemplate: string; description?: string }>;\n835\t    25\t}\n836\t    26\t\n837\t    27\texport interface Finding {\n838\t    28\t  where: string;\n839\t    29\t  rule: string;\n840\t    30\t  sample: string;\n841\t    31\t}\n842\t    32\t\n843\t    33\texport const LIMITS = {\n844\t    34\t  name: 64,\n845\t    35\t  title: 120,\n846\t    36\t  description: 1024,\n847\t    37\t  schemaString: 512,\n848\t    38\t  instructions: 2048,\n849\t    39\t} as const;\n850\t    40\t\n851\t    41\tconst RULES: Array<{ rule: string; re: RegExp }> = [\n852\t    42\t  // Invisible, bidi, and control characters (tab and newline allowed).\n853\t    43\t  { rule: \"control_or_invisible_char\", re: /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F­​-‏‪-‮⁠-⁤⁦-⁩﻿\\u{E0000}-\\u{E007F}]/u },\n854\t    44\t  // Role and instruction overrides.\n855\t    45\t  { rule: \"role_override\", re: /\\b(ignore|disregard|override|forget)\\b.{0,40}\\b(previous|prior|above|system|instructions?|rules?)\\b/i },\n856\t    46\t  { rule: \"role_override\", re: /\\b(you are now|act as|new instructions|system prompt|developer message)\\b/i },\n857\t    47\t  { rule: \"role_marker\", re: /<\\/?(system|assistant|user|instructions?)>|\\[\\/?INST\\]|^\\s*(system|assistant)\\s*:/im },\n858\t    48\t  // Directing the model to hide things or to act before or instead of the user.\n859\t    49\t  { rule: \"concealment\", re: /\\b(do not|don't|never)\\b.{0,30}\\b(tell|mention|reveal|show|inform)\\b.{0,30}\\b(user|patient|staff)\\b/i },\n860\t    50\t  { rule: \"precondition_injection\", re: /\\b(before|after|instead of)\\b.{0,30}\\b(calling|using|running)\\b.{0,40}\\b(always|must|first)\\b/i },\n861\t    51\t  // Encoded payloads.\n862\t    52\t  { rule: \"base64_blob\", re: /\\b[A-Za-z0-9+/]{48,}={0,2}(?![A-Za-z0-9+/])/ },\n863\t    53\t  { rule: \"hex_blob\", re: /\\b(?:[0-9a-f]{2}){32,}\\b/i },\n864\t    54\t  { rule: \"escaped_unicode\", re: /(\\\\u[0-9a-f]{4}){4,}|(&#x?[0-9a-f]+;){4,}/i },\n865\t    55\t  // Places data could be sent.\n866\t    56\t  { rule: \"url\", re: /\\b(?:https?|ftp|wss?|file|data):\\/?\\/?[^\\s\"'<>]+/i },\n867\t    57\t  { rule: \"email\", re: /\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/i },\n868\t    58\t  { rule: \"phone_number\", re: /\\+?\\d[\\d ().-]{9,}\\d/ },\n869\t    59\t];\n870\t    60\t\n871\t    61\tfunction scanString(where: string, s: string, max: number, otherServerTools: Set<string>, out: Finding[]): void {\n872\t    62\t  if (s.length > max) out.push({ where, rule: \"too_long\", sample: `${s.length} > ${max}` });\n873\t    63\t  for (const { rule, re } of RULES) {\n874\t    64\t    const m = re.exec(s);\n875\t    65\t    if (m) out.push({ where, rule, sample: m[0].slice(0, 40) });\n876\t    66\t  }\n877\t    67\t  const lower = s.toLowerCase();\n878\t    68\t  for (const t of otherServerTools) {\n879\t    69\t    if (lower.includes(t.toLowerCase())) out.push({ where, rule: \"references_other_server_tool\", sample: t });\n880\t    70\t  }\n881\t    71\t}\n882\t    72\t\n883\t    73\tfunction walkSchema(where: string, node: unknown, otherServerTools: Set<string>, out: Finding[], depth = 0): void {\n884\t    74\t  if (depth > 12) {\n885\t    75\t    out.push({ where, rule: \"schema_too_deep\", sample: String(depth) });\n886\t    76\t    return;\n887\t    77\t  }\n888\t    78\t  if (typeof node === \"string\") {\n889\t    79\t    scanString(where, node, LIMITS.schemaString, otherServerTools, out);\n890\t    80\t  } else if (Array.isArray(node)) {\n891\t    81\t    node.forEach((v, i) => walkSchema(`${where}[${i}]`, v, otherServerTools, out, depth + 1));\n892\t    82\t  } else if (node && typeof node === \"object\") {\n893\t    83\t    for (const [k, v] of Object.entries(node)) {\n894\t    84\t      scanString(`${where}.<key>`, k, LIMITS.name, otherServerTools, out);\n895\t    85\t      walkSchema(`${where}.${k}`, v, otherServerTools, out, depth + 1);\n896\t    86\t    }\n897\t    87\t  }\n898\t    88\t}\n899\t    89\t\n900\t    90\texport interface ScanResult {\n901\t    91\t  serverRejected: boolean;\n902\t    92\t  serverFindings: Finding[];\n903\t    93\t  rejectedTools: Map<string, Finding[]>;\n904\t    94\t  acceptedTools: ToolMeta[];\n905\t    95\t}\n906\t    96\t\n907\t    97\t/** otherServerTools: bare tool names exposed by every other configured server and native tool set. */\n908\t    98\texport function scanServer(meta: ServerMeta, otherServerTools: Set<string>): ScanResult {\n909\t    99\t  const serverFindings: Finding[] = [];\n910\t   100\t  if (meta.instructions !== undefined) {\n911\t   101\t    scanString(\"instructions\", meta.instructions, LIMITS.instructions, otherServerTools, serverFindings);\n912\t   102\t  }\n913\t   103\t  for (const p of meta.prompts ?? []) {\n914\t   104\t    scanString(`prompt:${p.name}.name`, p.name, LIMITS.name, otherServerTools, serverFindings);\n915\t   105\t    if (p.description) scanString(`prompt:${p.name}.description`, p.description, LIMITS.description, otherServerTools, serverFindings);\n916\t   106\t    for (const a of p.arguments ?? []) {\n917\t   107\t      if (a.description) scanString(`prompt:${p.name}.arg:${a.name}`, a.description, LIMITS.schemaString, otherServerTools, serverFindings);\n918\t   108\t    }\n919\t   109\t  }\n920\t   110\t  for (const r of meta.resourceTemplates ?? []) {\n921\t   111\t    scanString(`resource:${r.name}.name`, r.name, LIMITS.name, otherServerTools, serverFindings);\n922\t   112\t    if (r.description) scanString(`resource:${r.name}.description`, r.description, LIMITS.description, otherServerTools, serverFindings);\n923\t   113\t    // Server-scoped schemes (ehr://...) pass; web, file, and data URLs are findings like anywhere else.\n924\t   114\t    scanString(`resource:${r.name}.uriTemplate`, r.uriTemplate, LIMITS.schemaString, otherServerTools, serverFindings);\n925\t   115\t  }\n926\t   116\t\n927\t   117\t  const rejectedTools = new Map<string, Finding[]>();\n928\t   118\t  const acceptedTools: ToolMeta[] = [];\n929\t   119\t  for (const t of meta.tools) {\n930\t   120\t    const f: Finding[] = [];\n931\t   121\t    if (!/^[a-z][a-z0-9_]{0,63}$/.test(t.name)) f.push({ where: \"name\", rule: \"bad_tool_name\", sample: t.name.slice(0, 40) });\n932\t   122\t    if (t.title) scanString(\"title\", t.title, LIMITS.title, otherServerTools, f);\n933\t   123\t    if (t.description) scanString(\"description\", t.description, LIMITS.description, otherServerTools, f);\n934\t   124\t    walkSchema(\"inputSchema\", t.inputSchema ?? {}, otherServerTools, f);\n935\t   125\t    walkSchema(\"outputSchema\", t.outputSchema ?? {}, otherServerTools, f);\n936\t   126\t    walkSchema(\"annotations\", t.annotations ?? {}, otherServerTools, f);\n937\t   127\t    if (f.length) rejectedTools.set(t.name, f);\n938\t   128\t    else acceptedTools.push(t);\n939\t   129\t  }\n940\t   130\t  return { serverRejected: serverFindings.length > 0, serverFindings, rejectedTools, acceptedTools };\n941\t   131\t}\n942\t=== src/tools/registry.ts\n943\t     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n944\t     2\timport type { ContextSize } from \"../agent/context-size.js\";\n945\t     3\timport { scanServer, type ServerMeta, type ToolMeta } from \"./metadata-scan.js\";\n946\t     4\t\n947\t     5\t// Tool identity is \"<serverId>__<toolName>\", where serverId is the id this deployment assigned in\n948\t     6\t// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about\n949\t     7\t// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.\n950\t     8\t// Only servers listed in the manifest can contribute tools.\n951\t     9\t\n952\t    10\texport interface ConfiguredServer {\n953\t    11\t  id: string;\n954\t    12\t  url: string;\n955\t    13\t  tlsCertSha256: string;\n956\t    14\t}\n957\t    15\t\n958\t    16\texport interface InvokeOptions {\n959\t    17\t  clinicId: string;\n960\t    18\t  signal: AbortSignal;\n961\t    19\t  runCtx: unknown;\n962\t    20\t  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */\n963\t    21\t  context: ContextSize;\n964\t    22\t}\n965\t    23\t\n966\t    24\texport interface RegisteredTool {\n967\t    25\t  key: string;\n968\t    26\t  serverId: string;\n969\t    27\t  name: string;\n970\t    28\t  definition: Anthropic.Tool;\n971\t    29\t  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;\n972\t    30\t}\n973\t    31\t\n974\t    32\texport interface Conflict {\n975\t    33\t  key: string;\n976\t    34\t  conflictsWith: string;\n977\t    35\t  kind: \"duplicate\" | \"lookalike\";\n978\t    36\t}\n979\t    37\t\n980\t    38\tconst CONFUSABLES: Record<string, string> = { \"0\": \"o\", \"1\": \"l\", \"3\": \"e\", \"5\": \"s\", \"7\": \"t\", \"@\": \"a\", \"$\": \"s\" };\n981\t    39\t\n982\t    40\texport function canonical(name: string): string {\n983\t    41\t  return name\n984\t    42\t    .normalize(\"NFKC\")\n985\t    43\t    .toLowerCase()\n986\t    44\t    .replace(/rn/g, \"m\")\n987\t    45\t    .replace(/vv/g, \"w\")\n988\t    46\t    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)\n989\t    47\t    .replace(/[^a-z]/g, \"\");\n990\t    48\t}\n991\t    49\t\n992\t    50\tfunction editDistanceAtMostOne(a: string, b: string): boolean {\n993\t    51\t  if (a === b) return true;\n994\t    52\t  if (Math.abs(a.length - b.length) > 1) return false;\n995\t    53\t  let i = 0;\n996\t    54\t  let j = 0;\n997\t    55\t  let edits = 0;\n998\t    56\t  while (i < a.length && j < b.length) {\n999\t    57\t    if (a[i] === b[j]) {\n1000\t    58\t      i++;\n1001\t    59\t      j++;\n1002\t    60\t      continue;\n1003\t    61\t    }\n1004\t    62\t    if (++edits > 1) return false;\n1005\t    63\t    if (a.length > b.length) i++;\n1006\t    64\t    else if (b.length > a.length) j++;\n1007\t    65\t    else {\n1008\t    66\t      i++;\n1009\t    67\t      j++;\n1010\t    68\t    }\n1011\t    69\t  }\n1012\t    70\t  return edits + (a.length - i) + (b.length - j) <= 1;\n1013\t    71\t}\n1014\t    72\t\n1015\t    73\texport class ToolRegistry {\n1016\t    74\t  private tools = new Map<string, RegisteredTool>();\n1017\t    75\t  readonly conflicts: Conflict[] = [];\n1018\t    76\t  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];\n1019\t    77\t\n1020\t    78\t  constructor(private servers: ConfiguredServer[]) {}\n1021\t    79\t\n1022\t    80\t  get(key: string): RegisteredTool | undefined {\n1023\t    81\t    return this.tools.get(key);\n1024\t    82\t  }\n1025\t    83\t\n1026\t    84\t  definitions(): Anthropic.Tool[] {\n1027\t    85\t    return [...this.tools.values()].map((t) => t.definition);\n1028\t    86\t  }\n1029\t    87\t\n1030\t    88\t  bareNamesExcept(serverId: string): Set<string> {\n1031\t    89\t    return new Set([...this.tools.values()].filter((t) => t.serverId !== serverId).map((t) => t.name));\n1032\t    90\t  }\n1033\t    91\t\n1034\t    92\t  /** Native tools are registered first so MCP metadata that names them is caught by the scanner. */\n1035\t    93\t  registerNative(serverId: string, tools: Array<Omit<RegisteredTool, \"key\" | \"serverId\">>): void {\n1036\t    94\t    for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\n1037\t    95\t  }\n1038\t    96\t\n1039\t    97\t  /**\n1040\t    98\t   * serverId must be one of the configured servers, and the caller must have connected using that\n1041\t    99\t   * server's pinned URL and certificate. reportedName is informational only.\n1042\t   100\t   */\n1043\t   101\t  registerMcp(\n1044\t   102\t    serverId: string,\n1045\t   103\t    reportedName: string | undefined,\n1046\t   104\t    meta: ServerMeta,\n1047\t   105\t    invoke: (tool: string, input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>,\n1048\t   106\t  ): void {\n1049\t   107\t    const cfg = this.servers.find((s) => s.id === serverId);\n1050\t   108\t    if (!cfg) {\n1051\t   109\t      this.rejected.push({ serverId, reason: `server not in release manifest (reported name ${reportedName ?? \"none\"})` });\n1052\t   110\t      return;\n1053\t   111\t    }\n1054\t   112\t    let scan;\n1055\t   113\t    try {\n1056\t   114\t      scan = scanServer(meta, this.bareNamesExcept(serverId));\n1057\t   115\t    } catch (err) {\n1058\t   116\t      this.rejected.push({ serverId, reason: `metadata scan error: ${(err as Error).message}` });\n1059\t   117\t      return;\n1060\t   118\t    }\n1061\t   119\t    if (scan.serverRejected) {\n1062\t   120\t      this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });\n1063\t   121\t      return;\n1064\t   122\t    }\n1065\t   123\t    for (const [tool, findings] of scan.rejectedTools) {\n1066\t   124\t      this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });\n1067\t   125\t    }\n1068\t   126\t    for (const t of scan.acceptedTools) {\n1069\t   127\t      this.add({\n1070\t   128\t        key: `${serverId}__${t.name}`,\n1071\t   129\t        serverId,\n1072\t   130\t        name: t.name,\n1073\t   131\t        definition: toDefinition(`${serverId}__${t.name}`, t),\n1074\t   132\t        invoke: (input, opts) => invoke(t.name, input, opts),\n1075\t   133\t      });\n1076\t   134\t    }\n1077\t   135\t  }\n1078\t   136\t\n1079\t   137\t  private add(t: RegisteredTool): void {\n1080\t   138\t    if (this.tools.has(t.key)) {\n1081\t   139\t      this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: \"duplicate\" });\n1082\t   140\t      this.rejected.push({ serverId: t.serverId, tool: t.name, reason: \"duplicate tool key\" });\n1083\t   141\t      return;\n1084\t   142\t    }\n1085\t   143\t    const c = canonical(t.name);\n1086\t   144\t    for (const existing of this.tools.values()) {\n1087\t   145\t      if (existing.serverId === t.serverId) continue;\n1088\t   146\t      if (existing.name === t.name) {\n1089\t   147\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"duplicate\" });\n1090\t   148\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });\n1091\t   149\t        return;\n1092\t   150\t      }\n1093\t   151\t      if (editDistanceAtMostOne(canonical(existing.name), c)) {\n1094\t   152\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"lookalike\" });\n1095\t   153\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `looks like ${existing.key}` });\n1096\t   154\t        return;\n1097\t   155\t      }\n1098\t   156\t    }\n1099\t   157\t    this.tools.set(t.key, t);\n1100\t   158\t  }\n1101\t   159\t}\n1102\t   160\t\n1103\t   161\tfunction toDefinition(key: string, t: ToolMeta): Anthropic.Tool {\n1104\t   162\t  return {\n1105\t   163\t    name: key,\n1106\t   164\t    description: t.description ?? \"\",\n1107\t   165\t    input_schema: (t.inputSchema as Anthropic.Tool.InputSchema) ?? { type: \"object\", properties: {} },\n1108\t   166\t  };\n1109\t   167\t}\n1110\t=== src/control/kill-switch.ts\n1111\t     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n1112\t     2\timport { DynamoDBDocumentClient, BatchGetCommand } from \"@aws-sdk/lib-dynamodb\";\n1113\t     3\timport { env } from \"../config.js\";\n1114\t     4\t\n1115\t     5\t// Stop control. Operators write halted=true on \"global\" or \"tenant#<clinicId>\" in the control table.\n1116\t     6\t// The agent only reads this table; every model turn and every tool call checks it, and a watcher\n1117\t     7\t// aborts in-flight work for halted scopes.\n1118\t     8\texport class Halted extends Error {\n1119\t     9\t  constructor(public scope: string) {\n1120\t    10\t    super(`agent halted (${scope})`);\n1121\t    11\t  }\n1122\t    12\t}\n1123\t    13\t\n1124\t    14\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n1125\t    15\tconst POLL_MS = 2000;\n1126\t    16\t\n1127\t    17\ttype Active = { tenantId: string; abort: AbortController };\n1128\t    18\tconst active = new Map<string, Active>();\n1129\t    19\t\n1130\t    20\tlet lastRead = 0;\n1131\t    21\tlet halted = new Set<string>();\n1132\t    22\t\n1133\t    23\tasync function refresh(): Promise<void> {\n1134\t    24\t  const res = await ddb.send(\n1135\t    25\t    new BatchGetCommand({\n1136\t    26\t      RequestItems: {\n1137\t    27\t        [env.controlTable]: {\n1138\t    28\t          Keys: [{ pk: \"global\" }, ...[...new Set([...active.values()].map((a) => a.tenantId))].map((t) => ({ pk: `tenant#${t}` }))],\n1139\t    29\t          ConsistentRead: true,\n1140\t    30\t        },\n1141\t    31\t      },\n1142\t    32\t    }),\n1143\t    33\t  );\n1144\t    34\t  const next = new Set<string>();\n1145\t    35\t  for (const item of res.Responses?.[env.controlTable] ?? []) {\n1146\t    36\t    if (item.halted === true) next.add(String(item.pk));\n1147\t    37\t  }\n1148\t    38\t  halted = next;\n1149\t    39\t  lastRead = Date.now();\n1150\t    40\t}\n1151\t    41\t\n1152\t    42\texport const killSwitch = {\n1153\t    43\t  register(runId: string, tenantId: string, abort: AbortController): () => void {\n1154\t    44\t    active.set(runId, { tenantId, abort });\n1155\t    45\t    return () => active.delete(runId);\n1156\t    46\t  },\n1157\t    47\t\n1158\t    48\t  async assertRunning(tenantId: string): Promise<void> {\n1159\t    49\t    if (Date.now() - lastRead > POLL_MS) {\n1160\t    50\t      try {\n1161\t    51\t        await refresh();\n1162\t    52\t      } catch {\n1163\t    53\t        // If the control table cannot be read, treat the agent as halted.\n1164\t    54\t        throw new Halted(\"control-unreadable\");\n1165\t    55\t      }\n1166\t    56\t    }\n1167\t    57\t    if (halted.has(\"global\")) throw new Halted(\"global\");\n1168\t    58\t    if (halted.has(`tenant#${tenantId}`)) throw new Halted(`tenant#${tenantId}`);\n1169\t    59\t  },\n1170\t    60\t\n1171\t    61\t  startWatcher(): NodeJS.Timeout {\n1172\t    62\t    return setInterval(async () => {\n1173\t    63\t      try {\n1174\t    64\t        await refresh();\n1175\t    65\t      } catch {\n1176\t    66\t        halted = new Set([\"global\"]);\n1177\t    67\t      }\n1178\t    68\t      for (const [runId, a] of active) {\n1179\t    69\t        if (halted.has(\"global\") || halted.has(`tenant#${a.tenantId}`)) {\n1180\t    70\t          a.abort.abort(new Halted(halted.has(\"global\") ? \"global\" : `tenant#${a.tenantId}`));\n1181\t    71\t          active.delete(runId);\n1182\t    72\t        }\n1183\t    73\t      }\n1184\t    74\t    }, POLL_MS);\n1185\t    75\t  },\n1186\t    76\t};\n1187\t=== src/audit/recorder.ts\n1188\t     1\timport { FirehoseClient, PutRecordCommand } from \"@aws-sdk/client-firehose\";\n1189\t     2\timport { randomUUID } from \"node:crypto\";\n1190\t     3\timport { z } from \"zod\";\n1191\t     4\timport { env } from \"../config.js\";\n1192\t     5\t\n1193\t     6\t// Every audit record carries the six identity fields. Values come from RunContext, which is built\n1194\t     7\t// by the HTTP layer and the worker, never from model output.\n1195\t     8\texport const IdentityFields = z.object({\n1196\t     9\t  accountableParty: z.string().min(1),\n1197\t    10\t  operationalOwner: z.string().min(1),\n1198\t    11\t  tenantId: z.string().min(1),\n1199\t    12\t  agentTypeId: z.string().startsWith(\"sha256:\"),\n1200\t    13\t  agentInstanceId: z.string().uuid(),\n1201\t    14\t  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),\n1202\t    15\t});\n1203\t    16\t\n1204\t    17\texport const AuditEvent = IdentityFields.extend({\n1205\t    18\t  eventId: z.string().uuid(),\n1206\t    19\t  ts: z.string().datetime(),\n1207\t    20\t  runId: z.string().uuid(),\n1208\t    21\t  event: z.enum([\n1209\t    22\t    \"run.started\",\n1210\t    23\t    \"run.stopped\",\n1211\t    24\t    \"run.completed\",\n1212\t    25\t    \"intent.classified\",\n1213\t    26\t    \"model.decision\",\n1214\t    27\t    \"tool.denied\",\n1215\t    28\t    \"tool.approval_requested\",\n1216\t    29\t    \"tool.executed\",\n1217\t    30\t    \"tool.failed\",\n1218\t    31\t    \"payment.refund\",\n1219\t    32\t    \"peer.call\",\n1220\t    33\t    \"reminder.sent\",\n1221\t    34\t  ]),\n1222\t    35\t  subject: z.object({ kind: z.enum([\"patient\", \"staff\", \"system\"]), id: z.string() }),\n1223\t    36\t  tool: z.string().optional(),\n1224\t    37\t  toolUseId: z.string().optional(),\n1225\t    38\t  policyVersion: z.string().optional(),\n1226\t    39\t  approvalId: z.string().optional(),\n1227\t    40\t  reason: z.string().optional(),\n1228\t    41\t  context: z\n1229\t    42\t    .object({\n1230\t    43\t      tokens: z.number().int().nonnegative().nullable(),\n1231\t    44\t      status: z.enum([\"measured\", \"estimated\", \"unavailable\"]),\n1232\t    45\t      method: z.string(),\n1233\t    46\t      cachedInputTokens: z.number().int().nonnegative().nullable(),\n1234\t    47\t      compacted: z.boolean(),\n1235\t    48\t    })\n1236\t    49\t    .optional(),\n1237\t    50\t  detail: z.record(z.unknown()).optional(),\n1238\t    51\t});\n1239\t    52\texport type AuditEvent = z.infer<typeof AuditEvent>;\n1240\t    53\t\n1241\t    54\tconst firehose = new FirehoseClient({ region: env.region });\n1242\t    55\t\n1243\t    56\texport class AuditUnavailable extends Error {}\n1244\t    57\t\n1245\t    58\texport const audit = {\n1246\t    59\t  async record(e: Omit<AuditEvent, \"eventId\" | \"ts\">): Promise<void> {\n1247\t    60\t    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });\n1248\t    61\t    try {\n1249\t    62\t      await firehose.send(\n1250\t    63\t        new PutRecordCommand({\n1251\t    64\t          DeliveryStreamName: env.auditStream,\n1252\t    65\t          Record: { Data: Buffer.from(JSON.stringify(full) + \"\\n\") },\n1253\t    66\t        }),\n1254\t    67\t      );\n1255\t    68\t    } catch (err) {\n1256\t    69\t      // Callers treat this as a hard failure: an action that cannot be audited does not run.\n1257\t    70\t      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);\n1258\t    71\t    }\n1259\t    72\t  },\n1260\t    73\t};\n1261\t    74\t\n1262\t    75\t// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.\n1263\t    76\tconst DROP_KEYS = new Set([\"ssn\", \"dateOfBirth\", \"dob\", \"memberId\", \"subscriberId\", \"cardNumber\", \"cardLast4\", \"address\"]);\n1264\t    77\tconst PATTERNS: Array<[RegExp, string]> = [\n1265\t    78\t  [/\\b\\d{3}-\\d{2}-\\d{4}\\b/g, \"[ssn]\"],\n1266\t    79\t  [/\\b(?:\\d[ -]?){13,19}\\b/g, \"[card]\"],\n1267\t    80\t  [/\\b[A-Z]{3}\\d{9}\\b/g, \"[member-id]\"],\n1268\t    81\t];\n1269\t    82\t\n1270\t    83\texport function redactPhi(value: unknown): unknown {\n1271\t    84\t  if (typeof value === \"string\") {\n1272\t    85\t    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);\n1273\t    86\t  }\n1274\t    87\t  if (Array.isArray(value)) return value.map(redactPhi);\n1275\t    88\t  if (value && typeof value === \"object\") {\n1276\t    89\t    const out: Record<string, unknown> = {};\n1277\t    90\t    for (const [k, v] of Object.entries(value)) {\n1278\t    91\t      if (DROP_KEYS.has(k)) continue;\n1279\t    92\t      out[k] = redactPhi(v);\n1280\t    93\t    }\n1281\t    94\t    return out;\n1282\t    95\t  }\n1283\t    96\t  return value;\n1284\t    97\t}\n1285\t"}]},"parent_tool_use_id":null,"session_id":"be046cb2-a615-4b99-9b5b-9574ded4eee7","uuid":"ce5860da-a582-498a-92a5-58048d55ec0e","timestamp":"2026-10-02T15:19:10.580Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-repeat--3kdytd7/be046cb2-a615-4b99-9b5b-9574ded4eee7/tool-results/b2mw9nrvf.txt","content":"    39\t          Key: { pk: key },\n    40\t          UpdateExpression: \"ADD used :n SET expiresAt = if_not_exists(expiresAt, :exp)\",\n    41\t          ConditionExpression: \"attribute_not_exists(used) OR used <= :room\",\n    42\t          ExpressionAttributeValues: {\n    43\t            \":n\": amount,\n    44\t            \":room\": max - amount,\n    45\t            \":exp\": Math.floor(Date.now() / 1000) + ttlSeconds,\n    46\t          },\n    47\t          ReturnValues: \"UPDATED_NEW\",\n    48\t        }),\n    49\t      );\n    50\t      return { ok: true, used: Number(res.Attributes?.used ?? amount) };\n    51\t    } catch (err) {\n    52\t      if ((err as { name?: string }).name === \"ConditionalCheckFailedException\") return { ok: false, used: max };\n    53\t      throw err;\n    54\t    }\n    55\t  }\n    56\t}\n    57\t\n    58\texport interface Usage {\n    59\t  input_tokens: number;\n    60\t  output_tokens: number;\n    61\t  cache_read_input_tokens?: number | null;\n    62\t  cache_creation_input_tokens?: number | null;\n    63\t}\n    64\t\n    65\tconst day = () => new Date().toISOString().slice(0, 10);\n    66\tconst minute = () => new Date().toISOString().slice(0, 16);\n    67\t\n    68\texport class RunBudget {\n    69\t  readonly abort = new AbortController();\n    70\t  private started = Date.now();\n    71\t  private timer: NodeJS.Timeout;\n    72\t  private turns = 0;\n    73\t  private inTok = 0;\n    74\t  private outTok = 0;\n    75\t  private cost = 0;\n    76\t  private toolCalls = 0;\n    77\t  private toolTimes: number[] = [];\n    78\t  private peerCalls = 0;\n    79\t\n    80\t  constructor(\n    81\t    private b: Budgets,\n    82\t    private store: QuotaStore,\n    83\t    private scope: { tenantId: string; subjectId: string },\n    84\t    private now: () => number = Date.now,\n    85\t  ) {\n    86\t    this.started = this.now();\n    87\t    this.timer = setTimeout(\n    88\t      () => this.abort.abort(new BudgetExceeded(\"wall_time\", this.b.run.maxWallMs, this.b.run.maxWallMs)),\n    89\t      this.b.run.maxWallMs,\n    90\t    );\n    91\t  }\n    92\t\n    93\t  get signal(): AbortSignal {\n    94\t    return this.abort.signal;\n    95\t  }\n    96\t\n    97\t  dispose(): void {\n    98\t    clearTimeout(this.timer);\n    99\t  }\n   100\t\n   101\t  private check(limit: LimitName, used: number, max: number): void {\n   102\t    if (used > max) {\n   103\t      const e = new BudgetExceeded(limit, used, max);\n   104\t      this.abort.abort(e);\n   105\t      throw e;\n   106\t    }\n   107\t  }\n   108\t\n   109\t  private checkWall(): void {\n   110\t    this.check(\"wall_time\", this.now() - this.started, this.b.run.maxWallMs);\n   111\t  }\n   112\t\n   113\t  turn(): void {\n   114\t    this.checkWall();\n   115\t    this.turns += 1;\n   116\t    this.check(\"turns\", this.turns, this.b.run.maxTurns);\n   117\t  }\n   118\t\n   119\t  async recordUsage(u: Usage, model: string): Promise<void> {\n   120\t    const price = this.b.pricingUsdPerMTok[model];\n   121\t    if (!price) throw new Error(`no pricing for model ${model}`);\n   122\t    const cacheRead = u.cache_read_input_tokens ?? 0;\n   123\t    const cacheWrite = u.cache_creation_input_tokens ?? 0;\n   124\t    const callCost =\n   125\t      (u.input_tokens * price.input +\n   126\t        u.output_tokens * price.output +\n   127\t        cacheRead * price.cacheRead +\n   128\t        cacheWrite * price.cacheWrite) /\n   129\t      1_000_000;\n   130\t\n   131\t    this.inTok += u.input_tokens + cacheRead + cacheWrite;\n   132\t    this.outTok += u.output_tokens;\n   133\t    this.cost += callCost;\n   134\t    this.check(\"input_tokens\", this.inTok, this.b.run.maxInputTokens);\n   135\t    this.check(\"output_tokens\", this.outTok, this.b.run.maxOutputTokens);\n   136\t    this.check(\"run_cost\", this.cost, this.b.run.maxCostUsd);\n   137\t\n   138\t    const q = this.b.quotas;\n   139\t    await this.shared(\"subject_daily_cost\", `cost#subject#${this.scope.subjectId}#${day()}`, callCost, q.perSubjectDailyUsd, 86400);\n   140\t    await this.shared(\"tenant_daily_cost\", `cost#tenant#${this.scope.tenantId}#${day()}`, callCost, q.perTenantDailyUsd, 86400);\n   141\t    await this.shared(\"fleet_daily_cost\", `cost#fleet#${day()}`, callCost, q.fleetDailyUsd, 86400);\n   142\t  }\n   143\t\n   144\t  async toolCall(tool: string): Promise<void> {\n   145\t    this.checkWall();\n   146\t    this.toolCalls += 1;\n   147\t    this.check(\"tool_calls\", this.toolCalls, this.b.run.maxToolCalls);\n   148\t\n   149\t    const t = this.now();\n   150\t    this.toolTimes = this.toolTimes.filter((x) => t - x < 60_000);\n   151\t    this.toolTimes.push(t);\n   152\t    this.check(\"tool_call_rate\", this.toolTimes.length, this.b.run.maxToolCallsPerMinute);\n   153\t\n   154\t    if (tool.startsWith(\"insurance__\")) {\n   155\t      this.peerCalls += 1;\n   156\t      this.check(\"peer_calls\", this.peerCalls, this.b.run.maxPeerCalls);\n   157\t    }\n   158\t\n   159\t    const q = this.b.quotas;\n   160\t    await this.shared(\"tenant_tool_rate\", `rate#tenant#${this.scope.tenantId}#${minute()}`, 1, q.perTenantToolCallsPerMinute, 120);\n   161\t    await this.shared(\"fleet_tool_rate\", `rate#fleet#${minute()}`, 1, q.fleetToolCallsPerMinute, 120);\n   162\t  }\n   163\t\n   164\t  private async shared(limit: LimitName, key: string, amount: number, max: number, ttl: number): Promise<void> {\n   165\t    const r = await this.store.add(key, amount, max, ttl);\n   166\t    if (!r.ok) {\n   167\t      const e = new BudgetExceeded(limit, r.used + amount, max);\n   168\t      this.abort.abort(e);\n   169\t      throw e;\n   170\t    }\n   171\t  }\n   172\t}\n=== src/agent/classifier.ts\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { createHash } from \"node:crypto\";\n     3\timport { readFileSync } from \"node:fs\";\n     4\timport { join } from \"node:path\";\n     5\timport { z } from \"zod\";\n     6\timport { CLASSIFIER_MODEL, ROOT } from \"../config.js\";\n     7\t\n     8\t// Helper model that routes messages before the agent sees them. Urgent and complaint messages go\n     9\t// to staff; everything else goes to the agent loop. Any failure of this control (timeout, refusal,\n    10\t// malformed output, unknown label, or a served model other than the pinned snapshot) routes the\n    11\t// message to staff. A failed classifier never defaults to \"send it to the agent\".\n    12\t\n    13\texport const CLASSIFIER_PROMPT = readFileSync(join(ROOT, \"prompts/intent-classifier.txt\"), \"utf8\");\n    14\texport const CLASSIFIER_CONFIG = { max_tokens: 64, temperature: 0, timeoutMs: 4000 } as const;\n    15\t\n    16\texport const CLASSIFIER_ID = `sha256:${createHash(\"sha256\")\n    17\t  .update(CLASSIFIER_MODEL)\n    18\t  .update(\"\\0\")\n    19\t  .update(CLASSIFIER_PROMPT)\n    20\t  .update(\"\\0\")\n    21\t  .update(JSON.stringify(CLASSIFIER_CONFIG))\n    22\t  .digest(\"hex\")}`;\n    23\t\n    24\tconst Intent = z.enum([\"book\", \"reschedule\", \"cancel\", \"confirm\", \"coverage\", \"info\", \"urgent\", \"complaint\", \"other\"]);\n    25\tconst Output = z.object({ intent: Intent, confidence: z.number().min(0).max(1) }).strict();\n    26\t\n    27\texport type Route = \"agent\" | \"staff\";\n    28\t\n    29\texport interface ClassifierDecision {\n    30\t  classifierId: string;\n    31\t  requestedModel: string;\n    32\t  servedModel: string | null;\n    33\t  intent: z.infer<typeof Intent> | null;\n    34\t  confidence: number | null;\n    35\t  route: Route;\n    36\t  failure: null | \"timeout\" | \"api_error\" | \"model_mismatch\" | \"invalid_output\" | \"low_confidence\";\n    37\t}\n    38\t\n    39\tconst MIN_CONFIDENCE = 0.6;\n    40\t\n    41\texport async function classifyIntent(client: Pick<Anthropic, \"messages\">, text: string): Promise<ClassifierDecision> {\n    42\t  const base = { classifierId: CLASSIFIER_ID, requestedModel: CLASSIFIER_MODEL };\n    43\t  let res: Anthropic.Message;\n    44\t  try {\n    45\t    res = await client.messages.create(\n    46\t      {\n    47\t        model: CLASSIFIER_MODEL,\n    48\t        max_tokens: CLASSIFIER_CONFIG.max_tokens,\n    49\t        temperature: CLASSIFIER_CONFIG.temperature,\n    50\t        system: CLASSIFIER_PROMPT,\n    51\t        messages: [{ role: \"user\", content: `<patient_message>${text}</patient_message>` }],\n    52\t      },\n    53\t      { timeout: CLASSIFIER_CONFIG.timeoutMs, maxRetries: 0 },\n    54\t    );\n    55\t  } catch (err) {\n    56\t    const timeout = (err as { name?: string }).name === \"APIConnectionTimeoutError\";\n    57\t    return { ...base, servedModel: null, intent: null, confidence: null, route: \"staff\", failure: timeout ? \"timeout\" : \"api_error\" };\n    58\t  }\n    59\t\n    60\t  if (res.model !== CLASSIFIER_MODEL) {\n    61\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"model_mismatch\" };\n    62\t  }\n    63\t\n    64\t  const textOut = res.content.find((b) => b.type === \"text\");\n    65\t  let parsed: z.infer<typeof Output>;\n    66\t  try {\n    67\t    parsed = Output.parse(JSON.parse(textOut && textOut.type === \"text\" ? textOut.text : \"\"));\n    68\t  } catch {\n    69\t    return { ...base, servedModel: res.model, intent: null, confidence: null, route: \"staff\", failure: \"invalid_output\" };\n    70\t  }\n    71\t\n    72\t  if (parsed.confidence < MIN_CONFIDENCE) {\n    73\t    return { ...base, servedModel: res.model, ...parsed, route: \"staff\", failure: \"low_confidence\" };\n    74\t  }\n    75\t  const route: Route = parsed.intent === \"urgent\" || parsed.intent === \"complaint\" ? \"staff\" : \"agent\";\n    76\t  return { ...base, servedModel: res.model, ...parsed, route, failure: null };\n    77\t}\n=== src/agent/context-size.ts\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\t\n     3\t// Context size at decision time, in tokens.\n     4\t//\n     5\t// Counting method. Each model decision is one Messages API call. Its response usage reports the\n     6\t// prompt of that single call in three parts: input_tokens (uncached), cache_read_input_tokens, and\n     7\t// cache_creation_input_tokens. Their sum is the full prompt the model read for this decision,\n     8\t// including the part served from the prompt cache and the provider's own tool-use preamble, which\n     9\t// the provider counts but does not show. This is a per-call value, not a run or billing total.\n    10\t// We record it as \"measured\", with the cached share kept separately.\n    11\t//\n    12\t// If the response carries no usage (stream cut off, aborted call), we fall back to the\n    13\t// count_tokens estimate taken just before the call for the same request, and mark it \"estimated\".\n    14\t// If neither exists the value is null with status \"unavailable\". It is never reported as 0.\n    15\t//\n    16\t// This harness never compacts, summarizes, or truncates history inside a run, so compacted is\n    17\t// always false; a run that would outgrow its token budget stops instead (see budget.ts).\n    18\texport interface ContextSize {\n    19\t  tokens: number | null;\n    20\t  status: \"measured\" | \"estimated\" | \"unavailable\";\n    21\t  method: string;\n    22\t  cachedInputTokens: number | null;\n    23\t  compacted: boolean;\n    24\t}\n    25\t\n    26\texport const USAGE_METHOD = \"anthropic.messages.usage(input+cache_read+cache_creation)\";\n    27\texport const COUNT_METHOD = \"anthropic.messages.count_tokens(pre-call estimate)\";\n    28\t\n    29\texport async function measureBeforeCall(\n    30\t  client: Anthropic,\n    31\t  req: Anthropic.MessageCountTokensParams,\n    32\t  signal: AbortSignal,\n    33\t): Promise<ContextSize> {\n    34\t  try {\n    35\t    const r = await client.messages.countTokens(req, { signal });\n    36\t    return { tokens: r.input_tokens, status: \"estimated\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    37\t  } catch {\n    38\t    return { tokens: null, status: \"unavailable\", method: COUNT_METHOD, cachedInputTokens: null, compacted: false };\n    39\t  }\n    40\t}\n    41\t\n    42\texport function completeFromUsage(pre: ContextSize, usage: Anthropic.Usage | undefined | null): ContextSize {\n    43\t  if (!usage) return pre;\n    44\t  const cacheRead = usage.cache_read_input_tokens ?? 0;\n    45\t  const total = usage.input_tokens + cacheRead + (usage.cache_creation_input_tokens ?? 0);\n    46\t  return { tokens: total, status: \"measured\", method: USAGE_METHOD, cachedInputTokens: cacheRead, compacted: false };\n    47\t}\n    48\t\n    49\t// Span attributes so the value is searchable next to the action in traces as well as audit.\n    50\texport function spanAttributes(c: ContextSize): Record<string, string | number | boolean> {\n    51\t  return {\n    52\t    ...(c.tokens === null ? {} : { \"clinic_agent.context.tokens\": c.tokens }),\n    53\t    \"clinic_agent.context.status\": c.status,\n    54\t    \"clinic_agent.context.method\": c.method,\n    55\t    \"gen_ai.conversation.compacted\": c.compacted,\n    56\t  };\n    57\t}\n=== src/agent/identity.ts\n     1\timport { createHash, randomUUID } from \"node:crypto\";\n     2\timport { readdirSync, readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { ROOT, AGENT_MODEL, CLASSIFIER_MODEL, env } from \"../config.js\";\n     5\t\n     6\t// agent-type-id = sha256 over a fixed, ordered manifest of identity-defining inputs.\n     7\t// Each input is written as \"<label>\\0<bytes>\\0\" so that inputs cannot run together.\n     8\tconst CONFIG_FILES = [\"config/policy.yaml\", \"config/tools.allowlist.yaml\", \"config/budgets.yaml\"];\n     9\t\n    10\texport interface TypeIdInputs {\n    11\t  imageDigest: string;\n    12\t  harnessVersion: string;\n    13\t  harnessGitSha: string;\n    14\t}\n    15\t\n    16\texport function typeIdManifest(inputs: TypeIdInputs): Array<[string, Buffer]> {\n    17\t  const parts: Array<[string, Buffer]> = [\n    18\t    [\"image\", Buffer.from(inputs.imageDigest)],\n    19\t    [\"harness.version\", Buffer.from(inputs.harnessVersion)],\n    20\t    [\"harness.gitSha\", Buffer.from(inputs.harnessGitSha)],\n    21\t  ];\n    22\t  const promptDir = join(ROOT, \"prompts\");\n    23\t  const promptFiles = readdirSync(promptDir)\n    24\t    .filter((f) => f.endsWith(\".txt\"))\n    25\t    .sort();\n    26\t  for (const f of promptFiles) {\n    27\t    parts.push([`prompt:${f}`, readFileSync(join(promptDir, f))]);\n    28\t  }\n    29\t  parts.push([\"model.agent\", Buffer.from(AGENT_MODEL)]);\n    30\t  parts.push([\"model.classifier\", Buffer.from(CLASSIFIER_MODEL)]);\n    31\t  for (const f of CONFIG_FILES) {\n    32\t    parts.push([`config:${f}`, readFileSync(join(ROOT, f))]);\n    33\t  }\n    34\t  return parts;\n    35\t}\n    36\t\n    37\texport function computeAgentTypeId(inputs: TypeIdInputs): string {\n    38\t  const h = createHash(\"sha256\");\n    39\t  for (const [label, bytes] of typeIdManifest(inputs)) {\n    40\t    h.update(label);\n    41\t    h.update(\"\\0\");\n    42\t    h.update(bytes);\n    43\t    h.update(\"\\0\");\n    44\t  }\n    45\t  return `sha256:${h.digest(\"hex\")}`;\n    46\t}\n    47\t\n    48\t// One instance id per process. Pods are the unit an operator contains.\n    49\texport const AGENT_INSTANCE_ID = randomUUID();\n    50\t\n    51\tlet AGENT_TYPE_ID = \"\";\n    52\texport function setAgentTypeId(id: string): void {\n    53\t  AGENT_TYPE_ID = id;\n    54\t}\n    55\t\n    56\texport interface Subject {\n    57\t  kind: \"patient\" | \"staff\" | \"system\";\n    58\t  id: string;\n    59\t}\n    60\t\n    61\texport interface Logger {\n    62\t  info(obj: object, msg?: string): void;\n    63\t  warn(obj: object, msg?: string): void;\n    64\t  error(obj: object, msg?: string): void;\n    65\t}\n    66\t\n    67\texport interface RunContext {\n    68\t  runId: string;\n    69\t  tenantId: string;\n    70\t  subject: Subject;\n    71\t  channel: \"sms\" | \"webchat\" | \"reminder\";\n    72\t  traceparent: string;\n    73\t  log: Logger;\n    74\t  identity(): {\n    75\t    accountableParty: string;\n    76\t    operationalOwner: string;\n    77\t    tenantId: string;\n    78\t    agentTypeId: string;\n    79\t    agentInstanceId: string;\n    80\t    traceparent: string;\n    81\t  };\n    82\t  workloadToken(): Promise<string>;\n    83\t}\n    84\t\n    85\t// Projected service-account token (audience: the group STS), rotated by the kubelet.\n    86\tconst WORKLOAD_TOKEN_PATH = process.env.WORKLOAD_TOKEN_PATH ?? \"/var/run/secrets/tokens/sts-token\";\n    87\t\n    88\texport function newRunContext(init: {\n    89\t  tenantId: string;\n    90\t  subject: Subject;\n    91\t  channel: RunContext[\"channel\"];\n    92\t  traceparent?: string;\n    93\t  log: Logger;\n    94\t}): RunContext {\n    95\t  const runId = randomUUID();\n    96\t  const traceparent = init.traceparent ?? `00-${randomUUID().replace(/-/g, \"\")}-${randomUUID().replace(/-/g, \"\").slice(0, 16)}-01`;\n    97\t  return {\n    98\t    runId,\n    99\t    tenantId: init.tenantId,\n   100\t    subject: init.subject,\n   101\t    channel: init.channel,\n   102\t    traceparent,\n   103\t    log: init.log,\n   104\t    identity: () => ({\n   105\t      accountableParty: env.accountableParty,\n   106\t      operationalOwner: env.operationalOwner,\n   107\t      tenantId: init.tenantId,\n   108\t      agentTypeId: AGENT_TYPE_ID,\n   109\t      agentInstanceId: AGENT_INSTANCE_ID,\n   110\t      traceparent,\n   111\t    }),\n   112\t    workloadToken: async () => readFileSync(WORKLOAD_TOKEN_PATH, \"utf8\").trim(),\n   113\t  };\n   114\t}\n=== src/agent/loop.ts\n     1\timport Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { readFileSync } from \"node:fs\";\n     3\timport { join } from \"node:path\";\n     4\timport { AGENT_MODEL, budgets, ROOT } from \"../config.js\";\n     5\timport { audit, AuditUnavailable } from \"../audit/recorder.js\";\n     6\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     7\timport { executeTool } from \"../tools/executor.js\";\n     8\timport type { ToolRegistry } from \"../tools/registry.js\";\n     9\timport { BudgetExceeded, DynamoQuotaStore, RunBudget } from \"./budget.js\";\n    10\timport { classifyIntent } from \"./classifier.js\";\n    11\timport { completeFromUsage, measureBeforeCall, spanAttributes } from \"./context-size.js\";\n    12\timport type { RunContext } from \"./identity.js\";\n    13\t\n    14\tconst SYSTEM_TEMPLATE = readFileSync(join(ROOT, \"prompts/system.md\"), \"utf8\");\n    15\tconst anthropic = new Anthropic({ maxRetries: 1 });\n    16\tconst quotaStore = new DynamoQuotaStore();\n    17\t\n    18\texport interface AgentReply {\n    19\t  text: string;\n    20\t  handoff: null | { reason: string };\n    21\t}\n    22\t\n    23\tfunction escapeTags(s: string): string {\n    24\t  return s.replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    25\t}\n    26\t\n    27\texport async function runAgent(\n    28\t  registry: ToolRegistry,\n    29\t  ctx: RunContext,\n    30\t  clinic: { name: string },\n    31\t  patientText: string,\n    32\t): Promise<AgentReply> {\n    33\t  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });\n    34\t  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });\n    35\t  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);\n    36\t  await audit.record({ ...ident(), event: \"run.started\", detail: { channel: ctx.channel } });\n    37\t\n    38\t  try {\n    39\t    await killSwitch.assertRunning(ctx.tenantId);\n    40\t\n    41\t    const intent = await classifyIntent(anthropic, patientText);\n    42\t    await audit.record({ ...ident(), event: \"intent.classified\", detail: { ...intent } });\n    43\t    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, \"intent classifier control failure\");\n    44\t    if (intent.route === \"staff\") {\n    45\t      await audit.record({ ...ident(), event: \"run.stopped\", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });\n    46\t      return { text: \"Thanks. A member of our front desk team will get back to you shortly.\", handoff: { reason: intent.failure ?? String(intent.intent) } };\n    47\t    }\n    48\t\n    49\t    const system = SYSTEM_TEMPLATE.replace(\"{{clinicName}}\", clinic.name);\n    50\t    const tools = registry.definitions();\n    51\t    const messages: Anthropic.MessageParam[] = [\n    52\t      { role: \"user\", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },\n    53\t    ];\n    54\t\n    55\t    for (;;) {\n    56\t      budget.turn();\n    57\t      await killSwitch.assertRunning(ctx.tenantId);\n    58\t\n    59\t      const req = { model: AGENT_MODEL, system, tools, messages };\n    60\t      const pre = await measureBeforeCall(anthropic, req, budget.signal);\n    61\t      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });\n    62\t      const contextSize = completeFromUsage(pre, res.usage);\n    63\t      await budget.recordUsage(res.usage, AGENT_MODEL);\n    64\t\n    65\t      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === \"tool_use\");\n    66\t      await audit.record({\n    67\t        ...ident(),\n    68\t        event: \"model.decision\",\n    69\t        context: contextSize,\n    70\t        detail: {\n    71\t          servedModel: res.model,\n    72\t          stopReason: res.stop_reason,\n    73\t          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),\n    74\t          span: spanAttributes(contextSize),\n    75\t        },\n    76\t      });\n    77\t\n    78\t      if (res.stop_reason !== \"tool_use\" || toolUses.length === 0) {\n    79\t        const text = res.content\n    80\t          .filter((b): b is Anthropic.TextBlock => b.type === \"text\")\n    81\t          .map((b) => b.text)\n    82\t          .join(\"\\n\")\n    83\t          .slice(0, 320);\n    84\t        await audit.record({ ...ident(), event: \"run.completed\" });\n    85\t        return { text, handoff: null };\n    86\t      }\n    87\t\n    88\t      messages.push({ role: \"assistant\", content: res.content });\n    89\t      const results: Anthropic.ToolResultBlockParam[] = [];\n    90\t      for (const call of toolUses) {\n    91\t        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));\n    92\t      }\n    93\t      messages.push({ role: \"user\", content: results });\n    94\t    }\n    95\t  } catch (err) {\n    96\t    const reason =\n    97\t      err instanceof BudgetExceeded\n    98\t        ? `budget:${err.limit}`\n    99\t        : err instanceof Halted\n   100\t          ? `halted:${err.scope}`\n   101\t          : err instanceof AuditUnavailable\n   102\t            ? \"audit_unavailable\"\n   103\t            : budget.signal.aborted\n   104\t              ? `aborted:${String((budget.signal.reason as Error)?.message ?? \"\")}`\n   105\t              : `error:${(err as Error).message.slice(0, 200)}`;\n   106\t    try {\n   107\t      await audit.record({ ...ident(), event: \"run.stopped\", reason });\n   108\t    } catch {\n   109\t      ctx.log.error({ runId: ctx.runId, reason }, \"run stopped and audit delivery failed\");\n   110\t    }\n   111\t    return { text: \"Sorry, we couldn't finish that here. Our front desk will follow up.\", handoff: { reason } };\n   112\t  } finally {\n   113\t    budget.dispose();\n   114\t    unregister();\n   115\t  }\n   116\t}\n=== src/tools/approvals.ts\n     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, GetCommand, PutCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport { createHash, randomUUID } from \"node:crypto\";\n     4\timport { env, policy } from \"../config.js\";\n     5\t\n     6\t// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or\n     7\t// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,\n     8\t// approvedAt); the agent then retries the tool with the approval id.\n     9\t\n    10\texport interface ApprovalRecord {\n    11\t  id: string;\n    12\t  status: \"pending\" | \"approved\" | \"rejected\";\n    13\t  tool: string;\n    14\t  tenantId: string;\n    15\t  agentInstanceId: string;\n    16\t  runId: string;\n    17\t  argsHash: string;\n    18\t  summary: string;\n    19\t  requestedAt: string;\n    20\t  expiresAt: string;\n    21\t  approvedBy?: string;\n    22\t  approverRole?: string;\n    23\t  approvedAt?: string;\n    24\t}\n    25\t\n    26\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    27\t\n    28\texport function hashArgs(args: Record<string, unknown>): string {\n    29\t  const canonical = JSON.stringify(args, Object.keys(args).sort());\n    30\t  return createHash(\"sha256\").update(canonical).digest(\"hex\");\n    31\t}\n    32\t\n    33\texport async function requestApproval(req: {\n    34\t  tool: string;\n    35\t  tenantId: string;\n    36\t  agentInstanceId: string;\n    37\t  runId: string;\n    38\t  args: Record<string, unknown>;\n    39\t  summary: string;\n    40\t}): Promise<ApprovalRecord> {\n    41\t  const now = Date.now();\n    42\t  const rec: ApprovalRecord = {\n    43\t    id: randomUUID(),\n    44\t    status: \"pending\",\n    45\t    tool: req.tool,\n    46\t    tenantId: req.tenantId,\n    47\t    agentInstanceId: req.agentInstanceId,\n    48\t    runId: req.runId,\n    49\t    argsHash: hashArgs(req.args),\n    50\t    summary: req.summary,\n    51\t    requestedAt: new Date(now).toISOString(),\n    52\t    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),\n    53\t  };\n    54\t  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: \"attribute_not_exists(id)\" }));\n    55\t  return rec;\n    56\t}\n    57\t\n    58\texport type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };\n    59\t\n    60\texport async function checkApproval(req: {\n    61\t  approvalId: string;\n    62\t  tool: string;\n    63\t  tenantId: string;\n    64\t  args: Record<string, unknown>;\n    65\t}): Promise<ApprovalCheck> {\n    66\t  let rec: ApprovalRecord | undefined;\n    67\t  try {\n    68\t    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));\n    69\t    rec = res.Item as ApprovalRecord | undefined;\n    70\t  } catch (err) {\n    71\t    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };\n    72\t  }\n    73\t  if (!rec) return { ok: false, reason: \"approval not found\" };\n    74\t  if (rec.status !== \"approved\") return { ok: false, reason: `approval is ${rec.status}` };\n    75\t  if (rec.tool !== req.tool) return { ok: false, reason: \"approval is for a different tool\" };\n    76\t  if (rec.tenantId !== req.tenantId) return { ok: false, reason: \"approval is for a different clinic\" };\n    77\t  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: \"approval expired\" };\n    78\t  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {\n    79\t    return { ok: false, reason: \"approver lacks authority\" };\n    80\t  }\n    81\t  return { ok: true, approval: rec };\n    82\t}\n=== src/tools/executor.ts\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport { allowlist, policy } from \"../config.js\";\n     3\timport { audit, AuditUnavailable, redactPhi } from \"../audit/recorder.js\";\n     4\timport { BudgetExceeded, type RunBudget } from \"../agent/budget.js\";\n     5\timport type { ContextSize } from \"../agent/context-size.js\";\n     6\timport { AGENT_INSTANCE_ID, type RunContext } from \"../agent/identity.js\";\n     7\timport { Halted, killSwitch } from \"../control/kill-switch.js\";\n     8\timport type { Ehr } from \"../integrations/ehr-mcp.js\";\n     9\timport { payments } from \"../integrations/payments.js\";\n    10\timport { render, sms, TEMPLATES, type TemplateId } from \"../integrations/sms.js\";\n    11\timport { checkEligibilityForAppointment } from \"../workflows/eligibility-check.js\";\n    12\timport { checkApproval, requestApproval } from \"./approvals.js\";\n    13\timport type { RegisteredTool, ToolRegistry } from \"./registry.js\";\n    14\t\n    15\texport interface Decision {\n    16\t  contextSize: ContextSize;\n    17\t  budget: RunBudget;\n    18\t}\n    19\t\n    20\tconst ALLOWED = new Set(allowlist.tools.map((t) => t.tool));\n    21\t// Arguments the harness consumes itself; they are never forwarded to a tool.\n    22\tconst CONTROL_ARGS = new Set([\"approvalId\", \"clinicId\"]);\n    23\t\n    24\tfunction toolResult(id: string, content: unknown, isError = false): Anthropic.ToolResultBlockParam {\n    25\t  return { type: \"tool_result\", tool_use_id: id, content: JSON.stringify(content), is_error: isError };\n    26\t}\n    27\t\n    28\tfunction summarize(tool: string, args: Record<string, unknown>): string {\n    29\t  return `${tool}(${Object.entries(args)\n    30\t    .map(([k, v]) => `${k}=${JSON.stringify(v)}`)\n    31\t    .join(\", \")})`.slice(0, 500);\n    32\t}\n    33\t\n    34\texport async function executeTool(\n    35\t  registry: ToolRegistry,\n    36\t  ctx: RunContext,\n    37\t  call: Anthropic.ToolUseBlock,\n    38\t  d: Decision,\n    39\t): Promise<Anthropic.ToolResultBlockParam> {\n    40\t  const input = (call.input ?? {}) as Record<string, unknown>;\n    41\t  const base = {\n    42\t    ...ctx.identity(),\n    43\t    runId: ctx.runId,\n    44\t    subject: ctx.subject,\n    45\t    tool: call.name,\n    46\t    toolUseId: call.id,\n    47\t    policyVersion: policy.version,\n    48\t    context: d.contextSize,\n    49\t  };\n    50\t  const deny = async (reason: string) => {\n    51\t    await audit.record({ ...base, event: \"tool.denied\", reason });\n    52\t    return toolResult(call.id, { error: \"denied\", reason }, true);\n    53\t  };\n    54\t\n    55\t  if (!ALLOWED.has(call.name)) return deny(\"not_allowlisted\");\n    56\t  const tool = registry.get(call.name);\n    57\t  if (!tool) return deny(\"not_registered\");\n    58\t\n    59\t  await killSwitch.assertRunning(ctx.tenantId);\n    60\t  await d.budget.toolCall(call.name);\n    61\t\n    62\t  // Front-desk staff working one clinic's chat can act for a sibling clinic in the group.\n    63\t  const clinicId = typeof input.clinicId === \"string\" && input.clinicId ? input.clinicId : ctx.tenantId;\n    64\t  const args = Object.fromEntries(Object.entries(input).filter(([k]) => !CONTROL_ARGS.has(k)));\n    65\t\n    66\t  let approvalId: string | undefined;\n    67\t  if (policy.highImpactTools.includes(call.name)) {\n    68\t    if (typeof input.approvalId !== \"string\") {\n    69\t      const rec = await requestApproval({\n    70\t        tool: call.name,\n    71\t        tenantId: clinicId,\n    72\t        agentInstanceId: AGENT_INSTANCE_ID,\n    73\t        runId: ctx.runId,\n    74\t        args,\n    75\t        summary: summarize(call.name, args),\n    76\t      });\n    77\t      await audit.record({ ...base, event: \"tool.approval_requested\", approvalId: rec.id });\n    78\t      return toolResult(call.id, { status: \"pending_approval\", approvalId: rec.id, expiresAt: rec.expiresAt });\n    79\t    }\n    80\t    const check = await checkApproval({ approvalId: input.approvalId, tool: call.name, tenantId: clinicId, args });\n    81\t    if (!check.ok) return deny(check.reason);\n    82\t    approvalId = check.approval.id;\n    83\t  }\n    84\t\n    85\t  try {\n    86\t    const raw = await tool.invoke(args, { clinicId, signal: d.budget.signal, runCtx: ctx, context: d.contextSize });\n    87\t    ctx.log.info({ tool: call.name, toolUseId: call.id, clinicId, result: raw }, \"tool result\");\n    88\t    const safe = redactPhi(raw);\n    89\t    await audit.record({ ...base, event: \"tool.executed\", approvalId, detail: { clinicId } });\n    90\t    return toolResult(call.id, safe);\n    91\t  } catch (err) {\n    92\t    if (err instanceof Halted || err instanceof BudgetExceeded || err instanceof AuditUnavailable) throw err;\n    93\t    await audit.record({ ...base, event: \"tool.failed\", approvalId, reason: (err as Error).message.slice(0, 300) });\n    94\t    return toolResult(call.id, { error: \"tool_failed\" }, true);\n    95\t  }\n    96\t}\n    97\t\n    98\ttype Native = Omit<RegisteredTool, \"key\" | \"serverId\">;\n    99\t\n   100\texport function nativeTools(ehr: Ehr): Record<string, Native[]> {\n   101\t  const contact = async (clinicId: string, patientId: string, signal: AbortSignal) =>\n   102\t    (await ehr.call(\"get_patient_contact\", { patientId }, { clinicId, signal })) as { phone: string; smsOptIn: boolean; firstName: string };\n   103\t\n   104\t  return {\n   105\t    payments: [\n   106\t      {\n   107\t        name: \"refund_deposit\",\n   108\t        definition: {\n   109\t          name: \"payments__refund_deposit\",\n   110\t          description: \"Refund a patient's appointment deposit. Requires staff approval.\",\n   111\t          input_schema: {\n   112\t            type: \"object\",\n   113\t            properties: {\n   114\t              depositId: { type: \"string\" },\n   115\t              reason: { type: \"string\", enum: [\"no_show_waived\", \"clinic_cancelled\", \"billing_error\"] },\n   116\t              approvalId: { type: \"string\" },\n   117\t            },\n   118\t            required: [\"depositId\", \"reason\"],\n   119\t          },\n   120\t        },\n   121\t        invoke: async (a, o) =>\n   122\t          payments.refundDeposit(o.clinicId, { depositId: String(a.depositId), reason: String(a.reason), idempotencyKey: `refund-${a.depositId}` }, o.signal),\n   123\t      },\n   124\t    ],\n   125\t    sms: [\n   126\t      {\n   127\t        name: \"send_to_patient\",\n   128\t        definition: {\n   129\t          name: \"sms__send_to_patient\",\n   130\t          description: \"Send a templated SMS to the phone number on the patient's record.\",\n   131\t          input_schema: {\n   132\t            type: \"object\",\n   133\t            properties: {\n   134\t              patientId: { type: \"string\" },\n   135\t              template: { type: \"string\", enum: Object.keys(TEMPLATES) },\n   136\t              vars: { type: \"object\", additionalProperties: { type: \"string\" } },\n   137\t            },\n   138\t            required: [\"patientId\", \"template\"],\n   139\t          },\n   140\t        },\n   141\t        invoke: async (a, o) => {\n   142\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   143\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   144\t          const body = render(a.template as TemplateId, { firstName: c.firstName, ...((a.vars as Record<string, string>) ?? {}) });\n   145\t          return sms.send(o.clinicId, c.phone, body, o.signal);\n   146\t        },\n   147\t      },\n   148\t      {\n   149\t        name: \"send_freeform\",\n   150\t        definition: {\n   151\t          name: \"sms__send_freeform\",\n   152\t          description: \"Send a non-template SMS to the patient's phone on record. Requires staff approval.\",\n   153\t          input_schema: {\n   154\t            type: \"object\",\n   155\t            properties: { patientId: { type: \"string\" }, body: { type: \"string\", maxLength: 320 }, approvalId: { type: \"string\" } },\n   156\t            required: [\"patientId\", \"body\"],\n   157\t          },\n   158\t        },\n   159\t        invoke: async (a, o) => {\n   160\t          const c = await contact(o.clinicId, String(a.patientId), o.signal);\n   161\t          if (!c.smsOptIn) throw new Error(\"patient has not opted in to SMS\");\n   162\t          return sms.send(o.clinicId, c.phone, String(a.body).slice(0, 320), o.signal);\n   163\t        },\n   164\t      },\n   165\t    ],\n   166\t    insurance: [\n   167\t      {\n   168\t        name: \"check_eligibility\",\n   169\t        definition: {\n   170\t          name: \"insurance__check_eligibility\",\n   171\t          description: \"Check whether the patient's insurance covers an appointment.\",\n   172\t          input_schema: { type: \"object\", properties: { appointmentId: { type: \"string\" } }, required: [\"appointmentId\"] },\n   173\t        },\n   174\t        invoke: async (a, o) =>\n   175\t          checkEligibilityForAppointment(ehr, { appointmentId: String(a.appointmentId) }, {\n   176\t            clinicId: o.clinicId,\n   177\t            ctx: o.runCtx as RunContext,\n   178\t            signal: o.signal,\n   179\t            context: o.context,\n   180\t          }),\n   181\t      },\n   182\t    ],\n   183\t  };\n   184\t}\n=== src/tools/metadata-scan.ts\n     1\t// Scans MCP server metadata before any of it reaches the model.\n     2\t//\n     3\t// Covered fields: server instructions, tool name, title, description, every string inside the\n     4\t// input and output schemas (titles, descriptions, enum values, defaults, examples), annotations,\n     5\t// prompt names/descriptions/argument descriptions, and resource template names/descriptions/URIs.\n     6\t//\n     7\t// A finding on a tool rejects that tool. A finding on the server instructions or a prompt or\n     8\t// resource template rejects the whole server. If the scanner itself throws, the caller treats the\n     9\t// server as unavailable; nothing unscanned is passed on.\n    10\t\n    11\texport interface ToolMeta {\n    12\t  name: string;\n    13\t  title?: string;\n    14\t  description?: string;\n    15\t  inputSchema?: unknown;\n    16\t  outputSchema?: unknown;\n    17\t  annotations?: Record<string, unknown>;\n    18\t}\n    19\t\n    20\texport interface ServerMeta {\n    21\t  instructions?: string;\n    22\t  tools: ToolMeta[];\n    23\t  prompts?: Array<{ name: string; description?: string; arguments?: Array<{ name: string; description?: string }> }>;\n    24\t  resourceTemplates?: Array<{ name: string; uriTemplate: string; description?: string }>;\n    25\t}\n    26\t\n    27\texport interface Finding {\n    28\t  where: string;\n    29\t  rule: string;\n    30\t  sample: string;\n    31\t}\n    32\t\n    33\texport const LIMITS = {\n    34\t  name: 64,\n    35\t  title: 120,\n    36\t  description: 1024,\n    37\t  schemaString: 512,\n    38\t  instructions: 2048,\n    39\t} as const;\n    40\t\n    41\tconst RULES: Array<{ rule: string; re: RegExp }> = [\n    42\t  // Invisible, bidi, and control characters (tab and newline allowed).\n    43\t  { rule: \"control_or_invisible_char\", re: /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F­​-‏‪-‮⁠-⁤⁦-⁩﻿\\u{E0000}-\\u{E007F}]/u },\n    44\t  // Role and instruction overrides.\n    45\t  { rule: \"role_override\", re: /\\b(ignore|disregard|override|forget)\\b.{0,40}\\b(previous|prior|above|system|instructions?|rules?)\\b/i },\n    46\t  { rule: \"role_override\", re: /\\b(you are now|act as|new instructions|system prompt|developer message)\\b/i },\n    47\t  { rule: \"role_marker\", re: /<\\/?(system|assistant|user|instructions?)>|\\[\\/?INST\\]|^\\s*(system|assistant)\\s*:/im },\n    48\t  // Directing the model to hide things or to act before or instead of the user.\n    49\t  { rule: \"concealment\", re: /\\b(do not|don't|never)\\b.{0,30}\\b(tell|mention|reveal|show|inform)\\b.{0,30}\\b(user|patient|staff)\\b/i },\n    50\t  { rule: \"precondition_injection\", re: /\\b(before|after|instead of)\\b.{0,30}\\b(calling|using|running)\\b.{0,40}\\b(always|must|first)\\b/i },\n    51\t  // Encoded payloads.\n    52\t  { rule: \"base64_blob\", re: /\\b[A-Za-z0-9+/]{48,}={0,2}(?![A-Za-z0-9+/])/ },\n    53\t  { rule: \"hex_blob\", re: /\\b(?:[0-9a-f]{2}){32,}\\b/i },\n    54\t  { rule: \"escaped_unicode\", re: /(\\\\u[0-9a-f]{4}){4,}|(&#x?[0-9a-f]+;){4,}/i },\n    55\t  // Places data could be sent.\n    56\t  { rule: \"url\", re: /\\b(?:https?|ftp|wss?|file|data):\\/?\\/?[^\\s\"'<>]+/i },\n    57\t  { rule: \"email\", re: /\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/i },\n    58\t  { rule: \"phone_number\", re: /\\+?\\d[\\d ().-]{9,}\\d/ },\n    59\t];\n    60\t\n    61\tfunction scanString(where: string, s: string, max: number, otherServerTools: Set<string>, out: Finding[]): void {\n    62\t  if (s.length > max) out.push({ where, rule: \"too_long\", sample: `${s.length} > ${max}` });\n    63\t  for (const { rule, re } of RULES) {\n    64\t    const m = re.exec(s);\n    65\t    if (m) out.push({ where, rule, sample: m[0].slice(0, 40) });\n    66\t  }\n    67\t  const lower = s.toLowerCase();\n    68\t  for (const t of otherServerTools) {\n    69\t    if (lower.includes(t.toLowerCase())) out.push({ where, rule: \"references_other_server_tool\", sample: t });\n    70\t  }\n    71\t}\n    72\t\n    73\tfunction walkSchema(where: string, node: unknown, otherServerTools: Set<string>, out: Finding[], depth = 0): void {\n    74\t  if (depth > 12) {\n    75\t    out.push({ where, rule: \"schema_too_deep\", sample: String(depth) });\n    76\t    return;\n    77\t  }\n    78\t  if (typeof node === \"string\") {\n    79\t    scanString(where, node, LIMITS.schemaString, otherServerTools, out);\n    80\t  } else if (Array.isArray(node)) {\n    81\t    node.forEach((v, i) => walkSchema(`${where}[${i}]`, v, otherServerTools, out, depth + 1));\n    82\t  } else if (node && typeof node === \"object\") {\n    83\t    for (const [k, v] of Object.entries(node)) {\n    84\t      scanString(`${where}.<key>`, k, LIMITS.name, otherServerTools, out);\n    85\t      walkSchema(`${where}.${k}`, v, otherServerTools, out, depth + 1);\n    86\t    }\n    87\t  }\n    88\t}\n    89\t\n    90\texport interface ScanResult {\n    91\t  serverRejected: boolean;\n    92\t  serverFindings: Finding[];\n    93\t  rejectedTools: Map<string, Finding[]>;\n    94\t  acceptedTools: ToolMeta[];\n    95\t}\n    96\t\n    97\t/** otherServerTools: bare tool names exposed by every other configured server and native tool set. */\n    98\texport function scanServer(meta: ServerMeta, otherServerTools: Set<string>): ScanResult {\n    99\t  const serverFindings: Finding[] = [];\n   100\t  if (meta.instructions !== undefined) {\n   101\t    scanString(\"instructions\", meta.instructions, LIMITS.instructions, otherServerTools, serverFindings);\n   102\t  }\n   103\t  for (const p of meta.prompts ?? []) {\n   104\t    scanString(`prompt:${p.name}.name`, p.name, LIMITS.name, otherServerTools, serverFindings);\n   105\t    if (p.description) scanString(`prompt:${p.name}.description`, p.description, LIMITS.description, otherServerTools, serverFindings);\n   106\t    for (const a of p.arguments ?? []) {\n   107\t      if (a.description) scanString(`prompt:${p.name}.arg:${a.name}`, a.description, LIMITS.schemaString, otherServerTools, serverFindings);\n   108\t    }\n   109\t  }\n   110\t  for (const r of meta.resourceTemplates ?? []) {\n   111\t    scanString(`resource:${r.name}.name`, r.name, LIMITS.name, otherServerTools, serverFindings);\n   112\t    if (r.description) scanString(`resource:${r.name}.description`, r.description, LIMITS.description, otherServerTools, serverFindings);\n   113\t    // Server-scoped schemes (ehr://...) pass; web, file, and data URLs are findings like anywhere else.\n   114\t    scanString(`resource:${r.name}.uriTemplate`, r.uriTemplate, LIMITS.schemaString, otherServerTools, serverFindings);\n   115\t  }\n   116\t\n   117\t  const rejectedTools = new Map<string, Finding[]>();\n   118\t  const acceptedTools: ToolMeta[] = [];\n   119\t  for (const t of meta.tools) {\n   120\t    const f: Finding[] = [];\n   121\t    if (!/^[a-z][a-z0-9_]{0,63}$/.test(t.name)) f.push({ where: \"name\", rule: \"bad_tool_name\", sample: t.name.slice(0, 40) });\n   122\t    if (t.title) scanString(\"title\", t.title, LIMITS.title, otherServerTools, f);\n   123\t    if (t.description) scanString(\"description\", t.description, LIMITS.description, otherServerTools, f);\n   124\t    walkSchema(\"inputSchema\", t.inputSchema ?? {}, otherServerTools, f);\n   125\t    walkSchema(\"outputSchema\", t.outputSchema ?? {}, otherServerTools, f);\n   126\t    walkSchema(\"annotations\", t.annotations ?? {}, otherServerTools, f);\n   127\t    if (f.length) rejectedTools.set(t.name, f);\n   128\t    else acceptedTools.push(t);\n   129\t  }\n   130\t  return { serverRejected: serverFindings.length > 0, serverFindings, rejectedTools, acceptedTools };\n   131\t}\n=== src/tools/registry.ts\n     1\timport type Anthropic from \"@anthropic-ai/sdk\";\n     2\timport type { ContextSize } from \"../agent/context-size.js\";\n     3\timport { scanServer, type ServerMeta, type ToolMeta } from \"./metadata-scan.js\";\n     4\t\n     5\t// Tool identity is \"<serverId>__<toolName>\", where serverId is the id this deployment assigned in\n     6\t// the release manifest to a pinned endpoint + TLS certificate. The name a server reports about\n     7\t// itself (serverInfo.name) is logged and never used for identity, lookup, or approval.\n     8\t// Only servers listed in the manifest can contribute tools.\n     9\t\n    10\texport interface ConfiguredServer {\n    11\t  id: string;\n    12\t  url: string;\n    13\t  tlsCertSha256: string;\n    14\t}\n    15\t\n    16\texport interface InvokeOptions {\n    17\t  clinicId: string;\n    18\t  signal: AbortSignal;\n    19\t  runCtx: unknown;\n    20\t  /** Context size of the model decision that proposed this call; carried into any audit the tool writes. */\n    21\t  context: ContextSize;\n    22\t}\n    23\t\n    24\texport interface RegisteredTool {\n    25\t  key: string;\n    26\t  serverId: string;\n    27\t  name: string;\n    28\t  definition: Anthropic.Tool;\n    29\t  invoke: (input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>;\n    30\t}\n    31\t\n    32\texport interface Conflict {\n    33\t  key: string;\n    34\t  conflictsWith: string;\n    35\t  kind: \"duplicate\" | \"lookalike\";\n    36\t}\n    37\t\n    38\tconst CONFUSABLES: Record<string, string> = { \"0\": \"o\", \"1\": \"l\", \"3\": \"e\", \"5\": \"s\", \"7\": \"t\", \"@\": \"a\", \"$\": \"s\" };\n    39\t\n    40\texport function canonical(name: string): string {\n    41\t  return name\n    42\t    .normalize(\"NFKC\")\n    43\t    .toLowerCase()\n    44\t    .replace(/rn/g, \"m\")\n    45\t    .replace(/vv/g, \"w\")\n    46\t    .replace(/[0-9@$]/g, (c) => CONFUSABLES[c] ?? c)\n    47\t    .replace(/[^a-z]/g, \"\");\n    48\t}\n    49\t\n    50\tfunction editDistanceAtMostOne(a: string, b: string): boolean {\n    51\t  if (a === b) return true;\n    52\t  if (Math.abs(a.length - b.length) > 1) return false;\n    53\t  let i = 0;\n    54\t  let j = 0;\n    55\t  let edits = 0;\n    56\t  while (i < a.length && j < b.length) {\n    57\t    if (a[i] === b[j]) {\n    58\t      i++;\n    59\t      j++;\n    60\t      continue;\n    61\t    }\n    62\t    if (++edits > 1) return false;\n    63\t    if (a.length > b.length) i++;\n    64\t    else if (b.length > a.length) j++;\n    65\t    else {\n    66\t      i++;\n    67\t      j++;\n    68\t    }\n    69\t  }\n    70\t  return edits + (a.length - i) + (b.length - j) <= 1;\n    71\t}\n    72\t\n    73\texport class ToolRegistry {\n    74\t  private tools = new Map<string, RegisteredTool>();\n    75\t  readonly conflicts: Conflict[] = [];\n    76\t  readonly rejected: Array<{ serverId: string; tool?: string; reason: string }> = [];\n    77\t\n    78\t  constructor(private servers: ConfiguredServer[]) {}\n    79\t\n    80\t  get(key: string): RegisteredTool | undefined {\n    81\t    return this.tools.get(key);\n    82\t  }\n    83\t\n    84\t  definitions(): Anthropic.Tool[] {\n    85\t    return [...this.tools.values()].map((t) => t.definition);\n    86\t  }\n    87\t\n    88\t  bareNamesExcept(serverId: string): Set<string> {\n    89\t    return new Set([...this.tools.values()].filter((t) => t.serverId !== serverId).map((t) => t.name));\n    90\t  }\n    91\t\n    92\t  /** Native tools are registered first so MCP metadata that names them is caught by the scanner. */\n    93\t  registerNative(serverId: string, tools: Array<Omit<RegisteredTool, \"key\" | \"serverId\">>): void {\n    94\t    for (const t of tools) this.add({ ...t, serverId, key: `${serverId}__${t.name}` });\n    95\t  }\n    96\t\n    97\t  /**\n    98\t   * serverId must be one of the configured servers, and the caller must have connected using that\n    99\t   * server's pinned URL and certificate. reportedName is informational only.\n   100\t   */\n   101\t  registerMcp(\n   102\t    serverId: string,\n   103\t    reportedName: string | undefined,\n   104\t    meta: ServerMeta,\n   105\t    invoke: (tool: string, input: Record<string, unknown>, opts: InvokeOptions) => Promise<unknown>,\n   106\t  ): void {\n   107\t    const cfg = this.servers.find((s) => s.id === serverId);\n   108\t    if (!cfg) {\n   109\t      this.rejected.push({ serverId, reason: `server not in release manifest (reported name ${reportedName ?? \"none\"})` });\n   110\t      return;\n   111\t    }\n   112\t    let scan;\n   113\t    try {\n   114\t      scan = scanServer(meta, this.bareNamesExcept(serverId));\n   115\t    } catch (err) {\n   116\t      this.rejected.push({ serverId, reason: `metadata scan error: ${(err as Error).message}` });\n   117\t      return;\n   118\t    }\n   119\t    if (scan.serverRejected) {\n   120\t      this.rejected.push({ serverId, reason: `server metadata findings: ${JSON.stringify(scan.serverFindings)}` });\n   121\t      return;\n   122\t    }\n   123\t    for (const [tool, findings] of scan.rejectedTools) {\n   124\t      this.rejected.push({ serverId, tool, reason: `tool metadata findings: ${JSON.stringify(findings)}` });\n   125\t    }\n   126\t    for (const t of scan.acceptedTools) {\n   127\t      this.add({\n   128\t        key: `${serverId}__${t.name}`,\n   129\t        serverId,\n   130\t        name: t.name,\n   131\t        definition: toDefinition(`${serverId}__${t.name}`, t),\n   132\t        invoke: (input, opts) => invoke(t.name, input, opts),\n   133\t      });\n   134\t    }\n   135\t  }\n   136\t\n   137\t  private add(t: RegisteredTool): void {\n   138\t    if (this.tools.has(t.key)) {\n   139\t      this.conflicts.push({ key: t.key, conflictsWith: t.key, kind: \"duplicate\" });\n   140\t      this.rejected.push({ serverId: t.serverId, tool: t.name, reason: \"duplicate tool key\" });\n   141\t      return;\n   142\t    }\n   143\t    const c = canonical(t.name);\n   144\t    for (const existing of this.tools.values()) {\n   145\t      if (existing.serverId === t.serverId) continue;\n   146\t      if (existing.name === t.name) {\n   147\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"duplicate\" });\n   148\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });\n   149\t        return;\n   150\t      }\n   151\t      if (editDistanceAtMostOne(canonical(existing.name), c)) {\n   152\t        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: \"lookalike\" });\n   153\t        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `looks like ${existing.key}` });\n   154\t        return;\n   155\t      }\n   156\t    }\n   157\t    this.tools.set(t.key, t);\n   158\t  }\n   159\t}\n   160\t\n   161\tfunction toDefinition(key: string, t: ToolMeta): Anthropic.Tool {\n   162\t  return {\n   163\t    name: key,\n   164\t    description: t.description ?? \"\",\n   165\t    input_schema: (t.inputSchema as Anthropic.Tool.InputSchema) ?? { type: \"object\", properties: {} },\n   166\t  };\n   167\t}\n=== src/control/kill-switch.ts\n     1\timport { DynamoDBClient } from \"@aws-sdk/client-dynamodb\";\n     2\timport { DynamoDBDocumentClient, BatchGetCommand } from \"@aws-sdk/lib-dynamodb\";\n     3\timport { env } from \"../config.js\";\n     4\t\n     5\t// Stop control. Operators write halted=true on \"global\" or \"tenant#<clinicId>\" in the control table.\n     6\t// The agent only reads this table; every model turn and every tool call checks it, and a watcher\n     7\t// aborts in-flight work for halted scopes.\n     8\texport class Halted extends Error {\n     9\t  constructor(public scope: string) {\n    10\t    super(`agent halted (${scope})`);\n    11\t  }\n    12\t}\n    13\t\n    14\tconst ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));\n    15\tconst POLL_MS = 2000;\n    16\t\n    17\ttype Active = { tenantId: string; abort: AbortController };\n    18\tconst active = new Map<string, Active>();\n    19\t\n    20\tlet lastRead = 0;\n    21\tlet halted = new Set<string>();\n    22\t\n    23\tasync function refresh(): Promise<void> {\n    24\t  const res = await ddb.send(\n    25\t    new BatchGetCommand({\n    26\t      RequestItems: {\n    27\t        [env.controlTable]: {\n    28\t          Keys: [{ pk: \"global\" }, ...[...new Set([...active.values()].map((a) => a.tenantId))].map((t) => ({ pk: `tenant#${t}` }))],\n    29\t          ConsistentRead: true,\n    30\t        },\n    31\t      },\n    32\t    }),\n    33\t  );\n    34\t  const next = new Set<string>();\n    35\t  for (const item of res.Responses?.[env.controlTable] ?? []) {\n    36\t    if (item.halted === true) next.add(String(item.pk));\n    37\t  }\n    38\t  halted = next;\n    39\t  lastRead = Date.now();\n    40\t}\n    41\t\n    42\texport const killSwitch = {\n    43\t  register(runId: string, tenantId: string, abort: AbortController): () => void {\n    44\t    active.set(runId, { tenantId, abort });\n    45\t    return () => active.delete(runId);\n    46\t  },\n    47\t\n    48\t  async assertRunning(tenantId: string): Promise<void> {\n    49\t    if (Date.now() - lastRead > POLL_MS) {\n    50\t      try {\n    51\t        await refresh();\n    52\t      } catch {\n    53\t        // If the control table cannot be read, treat the agent as halted.\n    54\t        throw new Halted(\"control-unreadable\");\n    55\t      }\n    56\t    }\n    57\t    if (halted.has(\"global\")) throw new Halted(\"global\");\n    58\t    if (halted.has(`tenant#${tenantId}`)) throw new Halted(`tenant#${tenantId}`);\n    59\t  },\n    60\t\n    61\t  startWatcher(): NodeJS.Timeout {\n    62\t    return setInterval(async () => {\n    63\t      try {\n    64\t        await refresh();\n    65\t      } catch {\n    66\t        halted = new Set([\"global\"]);\n    67\t      }\n    68\t      for (const [runId, a] of active) {\n    69\t        if (halted.has(\"global\") || halted.has(`tenant#${a.tenantId}`)) {\n    70\t          a.abort.abort(new Halted(halted.has(\"global\") ? \"global\" : `tenant#${a.tenantId}`));\n    71\t          active.delete(runId);\n    72\t        }\n    73\t      }\n    74\t    }, POLL_MS);\n    75\t  },\n    76\t};\n=== src/audit/recorder.ts\n     1\timport { FirehoseClient, PutRecordCommand } from \"@aws-sdk/client-firehose\";\n     2\timport { randomUUID } from \"node:crypto\";\n     3\timport { z } from \"zod\";\n     4\timport { env } from \"../config.js\";\n     5\t\n     6\t// Every audit record carries the six identity fields. Values come from RunContext, which is built\n     7\t// by the HTTP layer and the worker, never from model output.\n     8\texport const IdentityFields = z.object({\n     9\t  accountableParty: z.string().min(1),\n    10\t  operationalOwner: z.string().min(1),\n    11\t  tenantId: z.string().min(1),\n    12\t  agentTypeId: z.string().startsWith(\"sha256:\"),\n    13\t  agentInstanceId: z.string().uuid(),\n    14\t  traceparent: z.string().regex(/^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/),\n    15\t});\n    16\t\n    17\texport const AuditEvent = IdentityFields.extend({\n    18\t  eventId: z.string().uuid(),\n    19\t  ts: z.string().datetime(),\n    20\t  runId: z.string().uuid(),\n    21\t  event: z.enum([\n    22\t    \"run.started\",\n    23\t    \"run.stopped\",\n    24\t    \"run.completed\",\n    25\t    \"intent.classified\",\n    26\t    \"model.decision\",\n    27\t    \"tool.denied\",\n    28\t    \"tool.approval_requested\",\n    29\t    \"tool.executed\",\n    30\t    \"tool.failed\",\n    31\t    \"payment.refund\",\n    32\t    \"peer.call\",\n    33\t    \"reminder.sent\",\n    34\t  ]),\n    35\t  subject: z.object({ kind: z.enum([\"patient\", \"staff\", \"system\"]), id: z.string() }),\n    36\t  tool: z.string().optional(),\n    37\t  toolUseId: z.string().optional(),\n    38\t  policyVersion: z.string().optional(),\n    39\t  approvalId: z.string().optional(),\n    40\t  reason: z.string().optional(),\n    41\t  context: z\n    42\t    .object({\n    43\t      tokens: z.number().int().nonnegative().nullable(),\n    44\t      status: z.enum([\"measured\", \"estimated\", \"unavailable\"]),\n    45\t      method: z.string(),\n    46\t      cachedInputTokens: z.number().int().nonnegative().nullable(),\n    47\t      compacted: z.boolean(),\n    48\t    })\n    49\t    .optional(),\n    50\t  detail: z.record(z.unknown()).optional(),\n    51\t});\n    52\texport type AuditEvent = z.infer<typeof AuditEvent>;\n    53\t\n    54\tconst firehose = new FirehoseClient({ region: env.region });\n    55\t\n    56\texport class AuditUnavailable extends Error {}\n    57\t\n    58\texport const audit = {\n    59\t  async record(e: Omit<AuditEvent, \"eventId\" | \"ts\">): Promise<void> {\n    60\t    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });\n    61\t    try {\n    62\t      await firehose.send(\n    63\t        new PutRecordCommand({\n    64\t          DeliveryStreamName: env.auditStream,\n    65\t          Record: { Data: Buffer.from(JSON.stringify(full) + \"\\n\") },\n    66\t        }),\n    67\t      );\n    68\t    } catch (err) {\n    69\t      // Callers treat this as a hard failure: an action that cannot be audited does not run.\n    70\t      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);\n    71\t    }\n    72\t  },\n    73\t};\n    74\t\n    75\t// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.\n    76\tconst DROP_KEYS = new Set([\"ssn\", \"dateOfBirth\", \"dob\", \"memberId\", \"subscriberId\", \"cardNumber\", \"cardLast4\", \"address\"]);\n    77\tconst PATTERNS: Array<[RegExp, string]> = [\n    78\t  [/\\b\\d{3}-\\d{2}-\\d{4}\\b/g, \"[ssn]\"],\n    79\t  [/\\b(?:\\d[ -]?){13,19}\\b/g, \"[card]\"],\n    80\t  [/\\b[A-Z]{3}\\d{9}\\b/g, \"[member-id]\"],\n    81\t];\n    82\t\n    83\texport function redactPhi(value: unknown): unknown {\n    84\t  if (typeof value === \"string\") {\n    85\t    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);\n    86\t  }\n    87\t  if (Array.isArray(value)) return value.map(redactPhi);\n    88\t  if (value && typeof value === \"object\") {\n    89\t    const out: Record<string, unknown> = {};\n    90\t    for (const [k, v] of Object.entries(value)) {\n    91\t      if (DROP_KEYS.has(k)) continue;\n    92\t      out[k] = redactPhi(v);\n    93\t    }\n    94\t    return out;\n    95\t  }\n    96\t  return value;\n    97\t}\n","numLines":1246,"startLine":40,"totalLines":1285}}}
