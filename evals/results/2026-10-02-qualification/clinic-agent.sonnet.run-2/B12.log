{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YQKrH6kre7WaoqDdAmaJ1x","type":"tool_result","content":"1\t# Who can change production: only the deploy workflow running in the \"production\" or\n2\t# \"production-emergency\" GitHub environment can assume the deploy role, and both environments\n3\t# require a named reviewer from agent-platform-leads. Nobody else has write access to the\n4\t# clinic-agent namespace (see access_entries in main.tf), and the cluster API is private.\n5\t\n6\tprovider \"github\" {\n7\t  owner = \"northbay-clinics\"\n8\t}\n9\t\n10\tdata \"github_team\" \"leads\" {\n11\t  slug = \"agent-platform-leads\"\n12\t}\n13\t\n14\tresource \"github_branch_protection\" \"main\" {\n15\t  repository_id = \"clinic-agent\"\n16\t  pattern       = \"main\"\n17\t\n18\t  enforce_admins                  = true\n19\t  allows_force_pushes             = false\n20\t  allows_deletions                = false\n21\t  required_linear_history         = true\n22\t  require_signed_commits          = true\n23\t  require_conversation_resolution = true\n24\t\n25\t  required_pull_request_reviews {\n26\t    required_approving_review_count = 2\n27\t    require_code_owner_reviews      = true\n28\t    dismiss_stale_reviews           = true\n29\t    require_last_push_approval      = true\n30\t  }\n31\t\n32\t  required_status_checks {\n33\t    strict   = true\n34\t    contexts = [\"ci / test\", \"ci / manifest-check\"]\n35\t  }\n36\t}\n37\t\n38\tresource \"github_repository_environment\" \"production\" {\n39\t  repository  = \"clinic-agent\"\n40\t  environment = \"production\"\n41\t  reviewers {\n42\t    teams = [data.github_team.leads.id]\n43\t  }\n44\t  prevent_self_review = true\n45\t  deployment_branch_policy {\n46\t    protected_branches     = true\n47\t    custom_branch_policies = false\n48\t  }\n49\t}\n50\t\n51\tresource \"github_repository_environment\" \"production_emergency\" {\n52\t  repository  = \"clinic-agent\"\n53\t  environment = \"production-emergency\"\n54\t  reviewers {\n55\t    teams = [data.github_team.leads.id]\n56\t  }\n57\t  prevent_self_review = true\n58\t  deployment_branch_policy {\n59\t    protected_branches     = false\n60\t    custom_branch_policies = true\n61\t  }\n62\t}\n63\t\n64\tresource \"github_repository_environment_deployment_policy\" \"emergency_branches\" {\n65\t  repository     = \"clinic-agent\"\n66\t  environment    = github_repository_environment.production_emergency.environment\n67\t  branch_pattern = \"hotfix/*\"\n68\t}\n69\t\n70\tresource \"aws_iam_role\" \"deploy\" {\n71\t  name = \"clinic-agent-deploy\"\n72\t  assume_role_policy = jsonencode({\n73\t    Version = \"2012-10-17\"\n74\t    Statement = [{\n75\t      Effect    = \"Allow\"\n76\t      Principal = { Federated = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/token.actions.githubusercontent.com\" }\n77\t      Action    = \"sts:AssumeRoleWithWebIdentity\"\n78\t      Condition = {\n79\t        StringEquals = {\n80\t          \"token.actions.githubusercontent.com:aud\" = \"sts.amazonaws.com\"\n81\t          \"token.actions.githubusercontent.com:sub\" = [\n82\t            \"repo:northbay-clinics/clinic-agent:environment:production\",\n83\t            \"repo:northbay-clinics/clinic-agent:environment:production-emergency\",\n84\t          ]\n85\t        }\n86\t      }\n87\t    }]\n88\t  })\n89\t}\n90\t\n91\tresource \"aws_iam_role_policy\" \"deploy\" {\n92\t  name = \"clinic-agent-deploy\"\n93\t  role = aws_iam_role.deploy.id\n94\t  policy = jsonencode({\n95\t    Version = \"2012-10-17\"\n96\t    Statement = [\n97\t      {\n98\t        Effect   = \"Allow\"\n99\t        Action   = [\"ecr:GetAuthorizationToken\"]\n100\t        Resource = \"*\"\n101\t      },\n102\t      {\n103\t        Effect   = \"Allow\"\n104\t        Action   = [\"ecr:BatchCheckLayerAvailability\", \"ecr:PutImage\", \"ecr:InitiateLayerUpload\", \"ecr:UploadLayerPart\", \"ecr:CompleteLayerUpload\", \"ecr:BatchGetImage\"]\n105\t        Resource = aws_ecr_repository.agent.arn\n106\t      },\n107\t      {\n108\t        Effect   = \"Allow\"\n109\t        Action   = [\"eks:DescribeCluster\"]\n110\t        Resource = module.eks.cluster_arn\n111\t      },\n112\t    ]\n113\t  })\n114\t}\n115\t"}]},"parent_tool_use_id":null,"session_id":"cc985f2a-b73b-42bc-94aa-096826a815c0","uuid":"87d4adb3-4e7e-48f1-8b67-1e5bdbcc947e","timestamp":"2026-10-02T15:51:58.193Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-x0qnnfwu/agent/infra/terraform/github.tf","content":"# Who can change production: only the deploy workflow running in the \"production\" or\n# \"production-emergency\" GitHub environment can assume the deploy role, and both environments\n# require a named reviewer from agent-platform-leads. Nobody else has write access to the\n# clinic-agent namespace (see access_entries in main.tf), and the cluster API is private.\n\nprovider \"github\" {\n  owner = \"northbay-clinics\"\n}\n\ndata \"github_team\" \"leads\" {\n  slug = \"agent-platform-leads\"\n}\n\nresource \"github_branch_protection\" \"main\" {\n  repository_id = \"clinic-agent\"\n  pattern       = \"main\"\n\n  enforce_admins                  = true\n  allows_force_pushes             = false\n  allows_deletions                = false\n  required_linear_history         = true\n  require_signed_commits          = true\n  require_conversation_resolution = true\n\n  required_pull_request_reviews {\n    required_approving_review_count = 2\n    require_code_owner_reviews      = true\n    dismiss_stale_reviews           = true\n    require_last_push_approval      = true\n  }\n\n  required_status_checks {\n    strict   = true\n    contexts = [\"ci / test\", \"ci / manifest-check\"]\n  }\n}\n\nresource \"github_repository_environment\" \"production\" {\n  repository  = \"clinic-agent\"\n  environment = \"production\"\n  reviewers {\n    teams = [data.github_team.leads.id]\n  }\n  prevent_self_review = true\n  deployment_branch_policy {\n    protected_branches     = true\n    custom_branch_policies = false\n  }\n}\n\nresource \"github_repository_environment\" \"production_emergency\" {\n  repository  = \"clinic-agent\"\n  environment = \"production-emergency\"\n  reviewers {\n    teams = [data.github_team.leads.id]\n  }\n  prevent_self_review = true\n  deployment_branch_policy {\n    protected_branches     = false\n    custom_branch_policies = true\n  }\n}\n\nresource \"github_repository_environment_deployment_policy\" \"emergency_branches\" {\n  repository     = \"clinic-agent\"\n  environment    = github_repository_environment.production_emergency.environment\n  branch_pattern = \"hotfix/*\"\n}\n\nresource \"aws_iam_role\" \"deploy\" {\n  name = \"clinic-agent-deploy\"\n  assume_role_policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [{\n      Effect    = \"Allow\"\n      Principal = { Federated = \"arn:aws:iam::${data.aws_caller_identity.current.account_id}:oidc-provider/token.actions.githubusercontent.com\" }\n      Action    = \"sts:AssumeRoleWithWebIdentity\"\n      Condition = {\n        StringEquals = {\n          \"token.actions.githubusercontent.com:aud\" = \"sts.amazonaws.com\"\n          \"token.actions.githubusercontent.com:sub\" = [\n            \"repo:northbay-clinics/clinic-agent:environment:production\",\n            \"repo:northbay-clinics/clinic-agent:environment:production-emergency\",\n          ]\n        }\n      }\n    }]\n  })\n}\n\nresource \"aws_iam_role_policy\" \"deploy\" {\n  name = \"clinic-agent-deploy\"\n  role = aws_iam_role.deploy.id\n  policy = jsonencode({\n    Version = \"2012-10-17\"\n    Statement = [\n      {\n        Effect   = \"Allow\"\n        Action   = [\"ecr:GetAuthorizationToken\"]\n        Resource = \"*\"\n      },\n      {\n        Effect   = \"Allow\"\n        Action   = [\"ecr:BatchCheckLayerAvailability\", \"ecr:PutImage\", \"ecr:InitiateLayerUpload\", \"ecr:UploadLayerPart\", \"ecr:CompleteLayerUpload\", \"ecr:BatchGetImage\"]\n        Resource = aws_ecr_repository.agent.arn\n      },\n      {\n        Effect   = \"Allow\"\n        Action   = [\"eks:DescribeCluster\"]\n        Resource = module.eks.cluster_arn\n      },\n    ]\n  })\n}\n","numLines":115,"startLine":1,"totalLines":115}}}
