   141	      return;
   142	    }
   143	    const c = canonical(t.name);
   144	    for (const existing of this.tools.values()) {
   145	      if (existing.serverId === t.serverId) continue;
   146	      if (existing.name === t.name) {
   147	        this.conflicts.push({ key: t.key, conflictsWith: existing.key, kind: "duplicate" });
   148	        this.rejected.push({ serverId: t.serverId, tool: t.name, reason: `same bare name as ${existing.key}` });
