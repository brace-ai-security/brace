     9	import { BudgetExceeded, DynamoQuotaStore, RunBudget } from "./budget.js";
    10	import { classifyIntent } from "./classifier.js";
    11	import { completeFromUsage, measureBeforeCall, spanAttributes } from "./context-size.js";
    12	import type { RunContext } from "./identity.js";
    13	
    14	const SYSTEM_TEMPLATE = readFileSync(join(ROOT, "prompts/system.md"), "utf8");
    15	const anthropic = new Anthropic({ maxRetries: 1 });
    16	const quotaStore = new DynamoQuotaStore();
    17	
    18	export interface AgentReply {
    19	  text: string;
    20	  handoff: null | { reason: string };
    21	}
    22	
    23	function escapeTags(s: string): string {
    24	  return s.replace(/</g, "&lt;").replace(/>/g, "&gt;");
    25	}
    26	
    27	export async function runAgent(
    28	  registry: ToolRegistry,
    29	  ctx: RunContext,
    30	  clinic: { name: string },
    31	  patientText: string,
    32	): Promise<AgentReply> {
    33	  const ident = () => ({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject });
    34	  const budget = new RunBudget(budgets, quotaStore, { tenantId: ctx.tenantId, subjectId: ctx.subject.id });
    35	  const unregister = killSwitch.register(ctx.runId, ctx.tenantId, budget.abort);
    36	  await audit.record({ ...ident(), event: "run.started", detail: { channel: ctx.channel } });
    37	
    38	  try {
    39	    await killSwitch.assertRunning(ctx.tenantId);
    40	
    41	    const intent = await classifyIntent(anthropic, patientText);
    42	    await audit.record({ ...ident(), event: "intent.classified", detail: { ...intent } });
    43	    if (intent.failure) ctx.log.warn({ classifier: intent.requestedModel, failure: intent.failure }, "intent classifier control failure");
    44	    if (intent.route === "staff") {
    45	      await audit.record({ ...ident(), event: "run.stopped", reason: `routed_to_staff:${intent.failure ?? intent.intent}` });
    46	      return { text: "Thanks. A member of our front desk team will get back to you shortly.", handoff: { reason: intent.failure ?? String(intent.intent) } };
    47	    }
    48	
    49	    const system = SYSTEM_TEMPLATE.replace("{{clinicName}}", clinic.name);
    50	    const tools = registry.definitions();
    51	    const messages: Anthropic.MessageParam[] = [
    52	      { role: "user", content: `<patient_message>${escapeTags(patientText)}</patient_message>` },
    53	    ];
    54	
    55	    for (;;) {
    56	      budget.turn();
    57	      await killSwitch.assertRunning(ctx.tenantId);
    58	
    59	      const req = { model: AGENT_MODEL, system, tools, messages };
    60	      const pre = await measureBeforeCall(anthropic, req, budget.signal);
    61	      const res = await anthropic.messages.create({ ...req, max_tokens: 1024 }, { signal: budget.signal });
    62	      const contextSize = completeFromUsage(pre, res.usage);
    63	      await budget.recordUsage(res.usage, AGENT_MODEL);
    64	
    65	      const toolUses = res.content.filter((b): b is Anthropic.ToolUseBlock => b.type === "tool_use");
    66	      await audit.record({
    67	        ...ident(),
    68	        event: "model.decision",
    69	        context: contextSize,
    70	        detail: {
    71	          servedModel: res.model,
    72	          stopReason: res.stop_reason,
    73	          proposed: toolUses.map((t) => ({ id: t.id, name: t.name })),
    74	          span: spanAttributes(contextSize),
    75	        },
    76	      });
    77	
    78	      if (res.stop_reason !== "tool_use" || toolUses.length === 0) {
    79	        const text = res.content
    80	          .filter((b): b is Anthropic.TextBlock => b.type === "text")
    81	          .map((b) => b.text)
    82	          .join("\n")
    83	          .slice(0, 320);
    84	        await audit.record({ ...ident(), event: "run.completed" });
    85	        return { text, handoff: null };
    86	      }
    87	
    88	      messages.push({ role: "assistant", content: res.content });
    89	      const results: Anthropic.ToolResultBlockParam[] = [];
    90	      for (const call of toolUses) {
    91	        results.push(await executeTool(registry, ctx, call, { contextSize, budget }));
    92	      }
    93	      messages.push({ role: "user", content: results });
    94	    }
    95	  } catch (err) {
    96	    const reason =
    97	      err instanceof BudgetExceeded
    98	        ? `budget:${err.limit}`
    99	        : err instanceof Halted
   100	          ? `halted:${err.scope}`
   101	          : err instanceof AuditUnavailable
   102	            ? "audit_unavailable"
   103	            : budget.signal.aborted
   104	              ? `aborted:${String((budget.signal.reason as Error)?.message ?? "")}`
   105	              : `error:${(err as Error).message.slice(0, 200)}`;
   106	    try {
   107	      await audit.record({ ...ident(), event: "run.stopped", reason });
   108	    } catch {
   109	      ctx.log.error({ runId: ctx.runId, reason }, "run stopped and audit delivery failed");
   110	    }
   111	    return { text: "Sorry, we couldn't finish that here. Our front desk will follow up.", handoff: { reason } };
   112	  } finally {
   113	    budget.dispose();
   114	    unregister();
   115	  }
   116	}
     1	import Fastify from "fastify";
     2	import { GetSecretValueCommand, SecretsManagerClient } from "@aws-sdk/client-secrets-manager";
     3	import { env, manifest } from "./config.js";
     4	import { computeAgentTypeId, setAgentTypeId, AGENT_INSTANCE_ID } from "./agent/identity.js";
     5	import { killSwitch } from "./control/kill-switch.js";
     6	import { ehr as ehrClient } from "./integrations/ehr-mcp.js";
     7	import { registerSmsWebhook } from "./routes/sms-webhook.js";
     8	import { registerWebchat } from "./routes/webchat.js";
     9	import { nativeTools } from "./tools/executor.js";
    10	import { ToolRegistry, type ConfiguredServer } from "./tools/registry.js";
    11	
    12	const metrics = {
    13	  increment(name: string) {
    14	    process.stdout.write(JSON.stringify({ _aws: { CloudWatchMetrics: [{ Namespace: "clinic-agent", Metrics: [{ Name: name }] }] }, [name]: 1 }) + "\n");
    15	  },
    16	};
    17	
    18	const app = Fastify({
    19	  logger: {
    20	    level: process.env.LOG_LEVEL ?? "info",
    21	    redact: { paths: ["req.headers.authorization", 'req.headers["x-sms-signature"]', "req.headers.cookie"], censor: "[redacted]" },
    22	  },
    23	  bodyLimit: 16_384,
    24	});
    25	
    26	// Identity check against the approved release manifest.
    27	const typeId = computeAgentTypeId({
    28	  imageDigest: process.env.IMAGE_DIGEST ?? "",
    29	  harnessVersion: manifest.harness.version,
    30	  harnessGitSha: process.env.GIT_SHA ?? "",
    31	});
    32	if (typeId !== manifest.agentTypeId) {
    33	  app.log.error({ expected: manifest.agentTypeId, actual: typeId }, "agent type id does not match release manifest");
    34	  metrics.increment("identity.mismatch");
    35	}
    36	setAgentTypeId(typeId);
    37	app.log.info({ agentTypeId: typeId, agentInstanceId: AGENT_INSTANCE_ID, release: manifest.release }, "starting");
    38	
    39	// Tools.
    40	const servers: ConfiguredServer[] = manifest.tools.mcpServers;
    41	const ehrServer = servers.find((s) => s.id === "ehr");
    42	if (!ehrServer) throw new Error("release manifest has no ehr server");
    43	const ehr = ehrClient(ehrServer);
    44	
    45	const registry = new ToolRegistry(servers);
    46	for (const [serverId, tools] of Object.entries(nativeTools(ehr))) registry.registerNative(serverId, tools);
    47	try {
    48	  const { reportedName, meta } = await ehr.catalog();
    49	  registry.registerMcp("ehr", reportedName, meta, (tool, input, opts) => ehr.call(tool, input, opts));
    50	} catch (err) {
    51	  app.log.error({ err }, "EHR MCP catalog unavailable; EHR tools disabled");
    52	}
    53	for (const r of registry.rejected) app.log.warn(r, "tool rejected at load");
    54	for (const c of registry.conflicts) app.log.warn(c, "tool name conflict");
    55	
    56	// Clinics.
    57	const directory: Array<{ id: string; name: string; smsNumber: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? "[]");
    58	const byId = new Map(directory.map((c) => [c.id, c]));
    59	const byNumber = new Map(directory.map((c) => [c.smsNumber, c]));
    60	
    61	const sm = new SecretsManagerClient({ region: env.region });
    62	let signingSecret: { value: string; at: number } | undefined;
    63	async function smsSigningSecret(): Promise<string> {
    64	  if (signingSecret && Date.now() - signingSecret.at < 5 * 60_000) return signingSecret.value;
    65	  const s = await sm.send(new GetSecretValueCommand({ SecretId: env.smsSigningSecretArn }));
    66	  signingSecret = { value: s.SecretString ?? "", at: Date.now() };
    67	  return signingSecret.value;
    68	}
    69	
    70	app.addContentTypeParser("application/json", { parseAs: "string" }, (req, body, done) => {
    71	  (req as { rawBody?: string }).rawBody = body as string;
    72	  try {
    73	    done(null, JSON.parse(body as string));
    74	  } catch (err) {
    75	    done(err as Error, undefined);
    76	  }
    77	});
    78	
    79	registerSmsWebhook(app, {
    80	  registry,
    81	  signingSecret: smsSigningSecret,
    82	  clinicByNumber: (to) => byNumber.get(to),
    83	  metrics,
    84	});
    85	registerWebchat(app, { registry, clinicById: (id) => byId.get(id) });
    86	
    87	app.get("/healthz", async () => ({ ok: true }));
    88	
    89	killSwitch.startWatcher();
    90	await app.listen({ host: "0.0.0.0", port: 8080 });
# Every tool the scheduling agent may call, with the task it serves.
# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)
# are not used for allow or approval decisions.
role: scheduling_agent
tools:
  - tool: ehr__find_patient
    reason: Match the sender to a patient record by date of birth and phone or email.
  - tool: ehr__search_slots
    reason: List open slots for a provider, location, and visit type.
  - tool: ehr__get_appointment
    reason: Read one appointment the patient asks about.
  - tool: ehr__list_patient_appointments
    reason: Show the patient their upcoming appointments.
  - tool: ehr__book_appointment
    reason: Book a slot the patient chose.
  - tool: ehr__update_appointment
    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.
  - tool: ehr__cancel_appointment
    reason: Cancel an appointment at the patient's request.
  - tool: payments__refund_deposit
    reason: Refund a no-show deposit after staff review.
  - tool: sms__send_to_patient
    reason: Send a templated message to the phone number on the patient's record.
  - tool: sms__send_freeform
    reason: Send a staff-approved message that is not one of the templates.
  - tool: insurance__check_eligibility
    reason: Ask the eligibility agent whether a visit is covered.
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { parse } from "yaml";

export const ROOT = process.env.CLINIC_AGENT_ROOT ?? process.cwd();

export interface Policy {
  version: string;
  highImpactTools: string[];
  approval: { ttlSeconds: number; approverRoles: string[]; table: string };
}

export interface AllowlistEntry {
  tool: string;
  reason: string;
}

export interface Budgets {
  run: {
    maxTurns: number;
    maxWallMs: number;
    maxInputTokens: number;
    maxOutputTokens: number;
    maxCostUsd: number;
    maxToolCalls: number;
    maxToolCallsPerMinute: number;
    maxPeerCalls: number;
  };
  quotas: {
    perSubjectDailyUsd: number;
    perTenantDailyUsd: number;
    fleetDailyUsd: number;
    perTenantToolCallsPerMinute: number;
    fleetToolCallsPerMinute: number;
  };
  pricingUsdPerMTok: Record<string, { input: number; output: number; cacheRead: number; cacheWrite: number }>;
  onExceed: "handoff_to_staff";
}

function loadYaml<T>(rel: string): T {
  return parse(readFileSync(join(ROOT, rel), "utf8")) as T;
}

export const policy = loadYaml<Policy>("config/policy.yaml");
export const allowlist = loadYaml<{ role: string; tools: AllowlistEntry[] }>("config/tools.allowlist.yaml");
export const budgets = loadYaml<Budgets>("config/budgets.yaml");
export const manifest = JSON.parse(readFileSync(join(ROOT, "release/manifest.json"), "utf8"));

export const AGENT_MODEL = "claude-sonnet-4-5-20250929";
export const CLASSIFIER_MODEL = "claude-haiku-4-5-20251001";

export const env = {
  region: process.env.AWS_REGION ?? "us-west-2",
  controlTable: process.env.CONTROL_TABLE ?? "clinic-agent-control",
  budgetTable: process.env.BUDGET_TABLE ?? "clinic-agent-budgets",
  auditStream: process.env.AUDIT_STREAM ?? "clinic-agent-audit",
  smsSigningSecretArn: process.env.SMS_SIGNING_SECRET_ARN ?? "",
  chatJwksUrl: process.env.CHAT_JWKS_URL ?? "https://auth.northbay-clinics.example/.well-known/jwks.json",
  chatIssuer: process.env.CHAT_ISSUER ?? "https://auth.northbay-clinics.example/",
  eligibilityUrl: process.env.ELIGIBILITY_URL ?? "https://eligibility.partners.northbay-clinics.example/a2a",
  eligibilityIssuer: process.env.ELIGIBILITY_ISSUER ?? "https://eligibility.partners.northbay-clinics.example",
  tokenExchangeUrl: process.env.TOKEN_EXCHANGE_URL ?? "https://sts.northbay-clinics.example/oauth2/token",
  accountableParty: "northbay-clinic-group:patient-access",
  operationalOwner: "team:agent-platform",
};
{
  "name": "clinic-agent",
  "version": "3.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "reminders": "node dist/workers/reminders.js",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.65.0",
    "@aws-sdk/client-dynamodb": "3.893.0",
    "@aws-sdk/client-firehose": "3.893.0",
    "@aws-sdk/client-secrets-manager": "3.893.0",
    "@aws-sdk/lib-dynamodb": "3.893.0",
    "@modelcontextprotocol/sdk": "1.18.2",
    "fastify": "5.6.1",
    "jose": "6.1.0",
    "pino": "9.11.0",
    "undici": "7.16.0",
    "yaml": "2.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "eslint": "9.36.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
}
terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws    = { source = "hashicorp/aws", version = "~> 6.14" }
    github = { source = "integrations/github", version = "~> 6.6" }
  }
  backend "s3" {
    bucket         = "northbay-tfstate-418295730611"
    key            = "clinic-agent/prod.tfstate"
    region         = "us-west-2"
    dynamodb_table = "northbay-tf-locks"
    encrypt        = true
  }
}

provider "aws" {
  region = var.region
  default_tags {
    tags = { app = "clinic-agent", owner = "agent-platform", data = "phi" }
  }
}

variable "region" {
  type    = string
  default = "us-west-2"
}

variable "clinic_ids" {
  type    = list(string)
  default = ["nb-castro", "nb-fremont", "nb-oakland", "nb-sanmateo", "nb-walnutcreek"]
}

data "aws_caller_identity" "current" {}

module "eks" {
  source  = "terraform-aws-modules/eks/aws"
  version = "21.3.1"

  name               = "clinic-agent-prod"
  kubernetes_version = "1.33"
  vpc_id             = module.vpc.vpc_id
  subnet_ids         = module.vpc.private_subnets

  endpoint_public_access = false
  enable_irsa            = true

  authentication_mode = "API"
  access_entries = {
    deploy = {
      principal_arn = aws_iam_role.deploy.arn
      policy_associations = {
        ns = {
          policy_arn   = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSEditPolicy"
          access_scope = { type = "namespace", namespaces = ["clinic-agent"] }
        }
      }
    }
  }

  eks_managed_node_groups = {
    agents = {
      instance_types = ["m7g.large"]
      ami_type       = "BOTTLEROCKET_ARM_64"
      min_size       = 2
      max_size       = 6
      desired_size   = 3
      metadata_options = {
        http_tokens                 = "required"
        http_put_response_hop_limit = 1
      }
    }
  }
}

module "vpc" {
  source  = "terraform-aws-modules/vpc/aws"
  version = "6.4.0"

  name            = "clinic-agent-prod"
  cidr            = "10.42.0.0/16"
  azs             = ["us-west-2a", "us-west-2b", "us-west-2c"]
  private_subnets = ["10.42.1.0/24", "10.42.2.0/24", "10.42.3.0/24"]
  public_subnets  = ["10.42.101.0/24", "10.42.102.0/24", "10.42.103.0/24"]

  enable_nat_gateway = true
  single_nat_gateway = false
}

resource "aws_ecr_repository" "agent" {
  name                 = "clinic-agent"
  image_tag_mutability = "IMMUTABLE"
  image_scanning_configuration { scan_on_push = true }
}

# State tables. Approvals are written by the staff console; budgets by the agent; the control
# table holds the stop flags operators set.
resource "aws_dynamodb_table" "approvals" {
  name         = "clinic-agent-approvals"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "id"
  attribute {
    name = "id"
    type = "S"
  }
  point_in_time_recovery { enabled = true }
}

resource "aws_dynamodb_table" "budgets" {
  name         = "clinic-agent-budgets"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "pk"
  attribute {
    name = "pk"
    type = "S"
  }
  ttl {
    attribute_name = "expiresAt"
    enabled        = true
  }
}

resource "aws_dynamodb_table" "control" {
  name         = "clinic-agent-control"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "pk"
  attribute {
    name = "pk"
    type = "S"
  }
  point_in_time_recovery { enabled = true }
}

# Audit: Firehose to an S3 bucket with object lock in compliance mode (7 years, HIPAA retention).
resource "aws_s3_bucket" "audit" {
  bucket              = "clinic-agent-audit-${data.aws_caller_identity.current.account_id}"
  object_lock_enabled = true
}

resource "aws_s3_bucket_object_lock_configuration" "audit" {
  bucket = aws_s3_bucket.audit.id
  rule {
    default_retention {
      mode  = "COMPLIANCE"
      years = 7
    }
  }
}

resource "aws_kinesis_firehose_delivery_stream" "audit" {
  name        = "clinic-agent-audit"
  destination = "extended_s3"
  extended_s3_configuration {
    role_arn            = aws_iam_role.firehose.arn
    bucket_arn          = aws_s3_bucket.audit.arn
    prefix              = "audit/dt=!{timestamp:yyyy-MM-dd}/"
    error_output_prefix = "audit-errors/!{firehose:error-output-type}/"
    buffering_interval  = 60
  }
}

resource "aws_secretsmanager_secret" "ehr" {
  for_each = toset(concat(var.clinic_ids, ["_catalog"]))
  name     = "clinic-agent/ehr/${each.key}"
}

resource "aws_secretsmanager_secret" "payments" {
  for_each = toset(var.clinic_ids)
  name     = "clinic-agent/payments/${each.key}"
}

resource "aws_secretsmanager_secret" "sms" {
  for_each = toset(var.clinic_ids)
  name     = "clinic-agent/sms/${each.key}"
}

resource "aws_secretsmanager_secret" "sms_signing" {
  name = "clinic-agent/sms-signing"
}
# Runtime identity for the agent pods (IRSA). This role belongs to the agent, not to any user:
# patients and staff never receive AWS credentials, and revoking this role does not touch theirs.
resource "aws_iam_role" "runtime" {
  name                 = "clinic-agent-runtime"
  max_session_duration = 3600
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Federated = module.eks.oidc_provider_arn }
      Action    = "sts:AssumeRoleWithWebIdentity"
      Condition = {
        StringEquals = {
          "${module.eks.oidc_provider}:sub" = [
            "system:serviceaccount:clinic-agent:clinic-agent",
            "system:serviceaccount:clinic-agent:clinic-agent-reminders",
          ]
          "${module.eks.oidc_provider}:aud" = "sts.amazonaws.com"
        }
      }
    }]
  })
}

resource "aws_iam_role_policy" "runtime" {
  name = "clinic-agent-runtime"
  role = aws_iam_role.runtime.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "ReadClinicSecrets"
        Effect   = "Allow"
        Action   = ["secretsmanager:GetSecretValue"]
        Resource = "arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:clinic-agent/*"
      },
      {
        Sid    = "AgentState"
        Effect = "Allow"
        Action = [
          "dynamodb:GetItem",
          "dynamodb:BatchGetItem",
          "dynamodb:PutItem",
          "dynamodb:UpdateItem",
          "dynamodb:Query",
        ]
        Resource = "arn:aws:dynamodb:${var.region}:${data.aws_caller_identity.current.account_id}:table/clinic-agent-*"
      },
      {
        Sid      = "Audit"
        Effect   = "Allow"
        Action   = ["firehose:PutRecord", "firehose:PutRecordBatch"]
        Resource = aws_kinesis_firehose_delivery_stream.audit.arn
      },
    ]
  })
}

# Operators who may stop the agent. Assumable only through SSO by the on-call group.
resource "aws_iam_role" "ops_killswitch" {
  name = "clinic-agent-ops"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { AWS = "arn:aws:iam::${data.aws_caller_identity.current.account_id}:root" }
      Action    = "sts:AssumeRole"
      Condition = {
        StringLike = { "aws:PrincipalArn" = "arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AgentPlatformOnCall_*" }
      }
    }]
  })
}

resource "aws_iam_role_policy" "ops_killswitch" {
  name = "clinic-agent-ops"
  role = aws_iam_role.ops_killswitch.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:GetItem"]
      Resource = aws_dynamodb_table.control.arn
    }]
  })
}

resource "aws_iam_role" "firehose" {
  name = "clinic-agent-audit-firehose"
