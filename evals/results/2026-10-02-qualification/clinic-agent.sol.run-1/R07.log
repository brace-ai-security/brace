    62	      await firehose.send(
    63	        new PutRecordCommand({
    64	          DeliveryStreamName: env.auditStream,
    65	          Record: { Data: Buffer.from(JSON.stringify(full) + "\n") },
    66	        }),
    67	      );
    68	    } catch (err) {
    69	      // Callers treat this as a hard failure: an action that cannot be audited does not run.
    70	      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);
    71	    }
    72	  },
    73	};
