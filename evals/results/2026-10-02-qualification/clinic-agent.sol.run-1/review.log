   121	});
FILE agent/test/budget.test.ts
     1	import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
     2	import { BudgetExceeded, RunBudget, type QuotaStore } from "../src/agent/budget.js";
     3	import type { Budgets } from "../src/config.js";
     4	
     5	class MemoryQuotaStore implements QuotaStore {
     6	  used = new Map<string, number>();
     7	  async add(key: string, amount: number, max: number) {
     8	    const cur = this.used.get(key) ?? 0;
     9	    if (cur + amount > max) return { ok: false, used: cur };
    10	    this.used.set(key, cur + amount);
    11	    return { ok: true, used: cur + amount };
    12	  }
    13	}
    14	
    15	const MODEL = "claude-sonnet-4-5-20250929";
    16	
    17	function small(overrides: Partial<Budgets["run"]> = {}, quotas: Partial<Budgets["quotas"]> = {}): Budgets {
    18	  return {
    19	    run: {
    20	      maxTurns: 3,
    21	      maxWallMs: 1000,
    22	      maxInputTokens: 10_000,
    23	      maxOutputTokens: 1_000,
    24	      maxCostUsd: 1,
    25	      maxToolCalls: 5,
    26	      maxToolCallsPerMinute: 4,
    27	      maxPeerCalls: 1,
    28	      ...overrides,
    29	    },
    30	    quotas: {
    31	      perSubjectDailyUsd: 100,
    32	      perTenantDailyUsd: 100,
    33	      fleetDailyUsd: 100,
    34	      perTenantToolCallsPerMinute: 100,
    35	      fleetToolCallsPerMinute: 100,
    36	      ...quotas,
    37	    },
    38	    pricingUsdPerMTok: { [MODEL]: { input: 3, output: 15, cacheRead: 0.3, cacheWrite: 3.75 } },
    39	    onExceed: "handoff_to_staff",
    40	  };
    41	}
    42	
    43	const scope = { tenantId: "nb-castro", subjectId: "phone:+14155550199" };
    44	const usage = (i: number, o: number) => ({ input_tokens: i, output_tokens: o });
    45	
    46	async function expectLimit(p: Promise<unknown> | (() => unknown), limit: string) {
    47	  try {
    48	    await (typeof p === "function" ? p() : p);
    49	  } catch (e) {
    50	    expect(e).toBeInstanceOf(BudgetExceeded);
    51	    expect((e as BudgetExceeded).limit).toBe(limit);
    52	    return;
    53	  }
    54	  throw new Error(`expected ${limit} to be exceeded`);
    55	}
    56	
    57	describe("RunBudget hard limits", () => {
    58	  beforeEach(() => vi.useFakeTimers());
    59	  afterEach(() => vi.useRealTimers());
    60	
    61	  it("stops at the turn limit", async () => {
    62	    const b = new RunBudget(small(), new MemoryQuotaStore(), scope);
    63	    b.turn();
    64	    b.turn();
    65	    b.turn();
    66	    await expectLimit(() => b.turn(), "turns");
    67	    expect(b.signal.aborted).toBe(true);
    68	  });
    69	
    70	  it("aborts in-flight work at the wall-clock limit", async () => {
    71	    const b = new RunBudget(small(), new MemoryQuotaStore(), scope);
    72	    vi.advanceTimersByTime(1001);
    73	    expect(b.signal.aborted).toBe(true);
    74	    expect((b.signal.reason as BudgetExceeded).limit).toBe("wall_time");
    75	  });
    76	
    77	  it("stops on input tokens, output tokens, and run cost", async () => {
    78	    await expectLimit(new RunBudget(small(), new MemoryQuotaStore(), scope).recordUsage(usage(10_001, 1), MODEL), "input_tokens");
    79	    await expectLimit(new RunBudget(small(), new MemoryQuotaStore(), scope).recordUsage(usage(1, 1_001), MODEL), "output_tokens");
    80	    await expectLimit(
    81	      new RunBudget(small({ maxCostUsd: 0.01, maxInputTokens: 1e9 }), new MemoryQuotaStore(), scope).recordUsage(usage(5_000, 0), MODEL),
    82	      "run_cost",
    83	    );
    84	  });
    85	
    86	  it("counts cached input toward the token limit", async () => {
    87	    const b = new RunBudget(small(), new MemoryQuotaStore(), scope);
    88	    await expectLimit(b.recordUsage({ input_tokens: 10, output_tokens: 1, cache_read_input_tokens: 10_000 }, MODEL), "input_tokens");
    89	  });
    90	
    91	  it("stops on total tool calls, tool-call rate, and peer calls", async () => {
    92	    const b1 = new RunBudget(small({ maxToolCallsPerMinute: 100 }), new MemoryQuotaStore(), scope);
    93	    for (let i = 0; i < 5; i++) await b1.toolCall("ehr__search_slots");
    94	    await expectLimit(b1.toolCall("ehr__search_slots"), "tool_calls");
    95	
    96	    const b2 = new RunBudget(small({ maxToolCalls: 100 }), new MemoryQuotaStore(), scope);
    97	    for (let i = 0; i < 4; i++) await b2.toolCall("ehr__search_slots");
    98	    await expectLimit(b2.toolCall("ehr__search_slots"), "tool_call_rate");
    99	
   100	    const b3 = new RunBudget(small(), new MemoryQuotaStore(), scope);
   101	    await b3.toolCall("insurance__check_eligibility");
   102	    await expectLimit(b3.toolCall("insurance__check_eligibility"), "peer_calls");
   103	  });
   104	
   105	  it("enforces per-subject, per-tenant, and fleet spend across many small runs", async () => {
   106	    const store = new MemoryQuotaStore();
   107	    const cfg = small({}, { perSubjectDailyUsd: 0.05 });
   108	    // Each run spends about $0.03, well under its own run_cost limit.
   109	    await new RunBudget(cfg, store, scope).recordUsage(usage(5_000, 1_000), MODEL);
   110	    await expectLimit(new RunBudget(cfg, store, scope).recordUsage(usage(5_000, 1_000), MODEL), "subject_daily_cost");
   111	
   112	    const tStore = new MemoryQuotaStore();
   113	    const tCfg = small({}, { perTenantDailyUsd: 0.05 });
   114	    await new RunBudget(tCfg, tStore, { ...scope, subjectId: "a" }).recordUsage(usage(5_000, 1_000), MODEL);
   115	    await expectLimit(new RunBudget(tCfg, tStore, { ...scope, subjectId: "b" }).recordUsage(usage(5_000, 1_000), MODEL), "tenant_daily_cost");
   116	
   117	    const fStore = new MemoryQuotaStore();
   118	    const fCfg = small({}, { fleetDailyUsd: 0.05 });
   119	    await new RunBudget(fCfg, fStore, { tenantId: "nb-castro", subjectId: "a" }).recordUsage(usage(5_000, 1_000), MODEL);
   120	    await expectLimit(
   121	      new RunBudget(fCfg, fStore, { tenantId: "nb-oakland", subjectId: "b" }).recordUsage(usage(5_000, 1_000), MODEL),
   122	      "fleet_daily_cost",
   123	    );
   124	  });
   125	
   126	  it("enforces per-tenant and fleet tool-call rates across runs", async () => {
   127	    const store = new MemoryQuotaStore();
   128	    const cfg = small({}, { perTenantToolCallsPerMinute: 3 });
   129	    for (let i = 0; i < 3; i++) await new RunBudget(cfg, store, scope).toolCall("ehr__search_slots");
   130	    await expectLimit(new RunBudget(cfg, store, scope).toolCall("ehr__search_slots"), "tenant_tool_rate");
   131	
   132	    const fStore = new MemoryQuotaStore();
   133	    const fCfg = small({}, { fleetToolCallsPerMinute: 2 });
   134	    await new RunBudget(fCfg, fStore, { tenantId: "nb-castro", subjectId: "a" }).toolCall("ehr__search_slots");
   135	    await new RunBudget(fCfg, fStore, { tenantId: "nb-fremont", subjectId: "b" }).toolCall("ehr__search_slots");
   136	    await expectLimit(new RunBudget(fCfg, fStore, { tenantId: "nb-oakland", subjectId: "c" }).toolCall("ehr__search_slots"), "fleet_tool_rate");
   137	  });
   138	
   139	  it("fails the run when the shared quota store is unavailable", async () => {
   140	    const broken: QuotaStore = { add: async () => Promise.reject(new Error("throttled")) };
   141	    await expect(new RunBudget(small(), broken, scope).toolCall("ehr__search_slots")).rejects.toThrow("throttled");
   142	  });
   143	});
FILE agent/config/tools.allowlist.yaml
     1	# Every tool the scheduling agent may call, with the task it serves.
     2	# The executor denies any tool not listed here. Annotations from servers (readOnlyHint and so on)
     3	# are not used for allow or approval decisions.
     4	role: scheduling_agent
     5	tools:
     6	  - tool: ehr__find_patient
     7	    reason: Match the sender to a patient record by date of birth and phone or email.
     8	  - tool: ehr__search_slots
     9	    reason: List open slots for a provider, location, and visit type.
    10	  - tool: ehr__get_appointment
    11	    reason: Read one appointment the patient asks about.
    12	  - tool: ehr__list_patient_appointments
    13	    reason: Show the patient their upcoming appointments.
    14	  - tool: ehr__book_appointment
    15	    reason: Book a slot the patient chose.
    16	  - tool: ehr__update_appointment
    17	    reason: Change time, provider, or status (confirmed / checked_in / no_show / cancelled) of an appointment.
    18	  - tool: ehr__cancel_appointment
    19	    reason: Cancel an appointment at the patient's request.
    20	  - tool: payments__refund_deposit
    21	    reason: Refund a no-show deposit after staff review.
    22	  - tool: sms__send_to_patient
    23	    reason: Send a templated message to the phone number on the patient's record.
    24	  - tool: sms__send_freeform
    25	    reason: Send a staff-approved message that is not one of the templates.
    26	  - tool: insurance__check_eligibility
    27	    reason: Ask the eligibility agent whether a visit is covered.
FILE agent/config/policy.yaml
     1	# Action policy for the scheduling agent. Changes need agent-platform-leads review (CODEOWNERS).
     2	policyVersion: "2026-09-18.3"
     3	
     4	# Tools that never run without a staff approval bound to the request.
     5	highImpactTools:
     6	  - ehr__cancel_appointment
     7	  - payments__refund_deposit
     8	  - sms__send_freeform
     9	
    10	approval:
    11	  ttlSeconds: 900
    12	  approverRoles:
    13	    - front_desk_lead
    14	    - clinic_manager
    15	  # Approvals are recorded in DynamoDB table clinic-agent-approvals.
    16	  table: clinic-agent-approvals
FILE agent/config/budgets.yaml
     1	# Hard limits enforced by src/agent/budget.ts, outside the model.
     2	run:
     3	  maxTurns: 8                 # model calls per run
     4	  maxWallMs: 45000            # whole run, including tool calls
     5	  maxInputTokens: 120000      # summed across model calls in the run
     6	  maxOutputTokens: 6000
     7	  maxCostUsd: 0.40
     8	  maxToolCalls: 16
     9	  maxToolCallsPerMinute: 12
    10	  maxPeerCalls: 2             # calls to the eligibility agent; this agent starts no sub-agents
    11	
    12	quotas:
    13	  # Daily spend and per-minute tool-call ceilings across many runs.
    14	  perSubjectDailyUsd: 2.00    # one patient or staff user
    15	  perTenantDailyUsd: 60.00    # one clinic
    16	  fleetDailyUsd: 900.00       # all clinics
    17	  perTenantToolCallsPerMinute: 240
    18	  fleetToolCallsPerMinute: 2400
    19	
    20	pricingUsdPerMTok:
    21	  claude-sonnet-4-5-20250929: { input: 3.00, output: 15.00, cacheRead: 0.30, cacheWrite: 3.75 }
    22	  claude-haiku-4-5-20251001: { input: 1.00, output: 5.00, cacheRead: 0.10, cacheWrite: 1.25 }
    23	
    24	# When a limit is hit the run stops, the stop is audited with the limit name, and the
    25	# conversation is handed to the clinic's front-desk queue.
    26	onExceed: handoff_to_staff
