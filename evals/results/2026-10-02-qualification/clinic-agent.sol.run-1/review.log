apiVersion: apps/v1
kind: Deployment
metadata:
  name: clinic-agent
  namespace: clinic-agent
  labels: { app: clinic-agent }
spec:
  replicas: 3
  selector:
    matchLabels: { app: clinic-agent }
  template:
    metadata:
      labels: { app: clinic-agent }
    spec:
      serviceAccountName: clinic-agent
      automountServiceAccountToken: false
      hostUsers: false
      hostNetwork: false
      hostPID: false
      hostIPC: false
      enableServiceLinks: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: agent
          image: 418295730611.dkr.ecr.us-west-2.amazonaws.com/clinic-agent@sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8
          ports:
            - containerPort: 8080
          envFrom:
            - configMapRef: { name: clinic-agent }
          env:
            - name: IMAGE_DIGEST
              value: sha256:b81f3c0e9d2a4756c8e1f0a3b2d4c6e8f0a1b3c5d7e9f1a2b4c6d8e0f2a4b6c8
            - name: GIT_SHA
              value: e4b7c19d2f80a3561c7e9b0d4f2a6c8e1b3d5f70
          securityContext:
            allowPrivilegeEscalation: false
            privileged: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            capabilities:
              drop: ["ALL"]
            seccompProfile:
              type: RuntimeDefault
          resources:
            requests: { cpu: 250m, memory: 384Mi }
            limits: { cpu: "1", memory: 768Mi }
          readinessProbe:
            httpGet: { path: /healthz, port: 8080 }
          volumeMounts:
            - { name: tmp, mountPath: /tmp }
            - { name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true }
      volumes:
        - name: tmp
          emptyDir: { medium: Memory, sizeLimit: 32Mi }
        - name: sts-token
          projected:
            sources:
              - serviceAccountToken:
                  audience: https://sts.northbay-clinics.example
                  expirationSeconds: 900
                  path: sts-token
---
apiVersion: batch/v1
kind: CronJob
metadata:
