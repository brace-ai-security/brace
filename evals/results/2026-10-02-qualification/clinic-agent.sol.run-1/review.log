     6	const servers = [
     7	  { id: "ehr", url: "https://ehr-mcp.internal.northbay-clinics.example/mcp", tlsCertSha256: "1f".repeat(32) },
     8	  { id: "ehr2", url: "https://ehr2-mcp.internal.northbay-clinics.example/mcp", tlsCertSha256: "2e".repeat(32) },
     9	];
    10	const noop = async () => ({});
    11	const tool = (name: string, description = "Look up a record.") => ({ name, description, inputSchema: { type: "object", properties: {} } });
    12	
    13	describe("tool registry identity", () => {
    14	  it("keys tools by configured server id, not the server's reported name", () => {
    15	    const r = new ToolRegistry(servers);
    16	    r.registerMcp("ehr", "payments", { tools: [tool("find_patient")] }, noop);
    17	    expect(r.get("ehr__find_patient")).toBeDefined();
    18	    expect(r.get("payments__find_patient")).toBeUndefined();
    19	  });
    20	
    21	  it("refuses servers that are not in the release manifest", () => {
    22	    const r = new ToolRegistry(servers);
    23	    r.registerMcp("shadow", "ehr", { tools: [tool("cancel_appointment")] }, noop);
    24	    expect(r.definitions()).toHaveLength(0);
    25	    expect(r.rejected[0]?.reason).toMatch(/not in release manifest/);
    26	  });
    27	
    28	  it("rejects a duplicate bare name from a second server instead of replacing the approved tool", () => {
    29	    const r = new ToolRegistry(servers);
    30	    r.registerMcp("ehr", "ehr", { tools: [tool("cancel_appointment")] }, noop);
    31	    r.registerMcp("ehr2", "ehr", { tools: [tool("cancel_appointment")] }, noop);
    32	    expect(r.get("ehr__cancel_appointment")).toBeDefined();
    33	    expect(r.get("ehr2__cancel_appointment")).toBeUndefined();
    34	    expect(r.conflicts[0]).toMatchObject({ kind: "duplicate", conflictsWith: "ehr__cancel_appointment" });
    35	  });
    36	
    37	  it("flags lookalike names across servers", () => {
    38	    expect(canonical("cance1_appointrnent")).toBe(canonical("cancel_appointment"));
    39	    const r = new ToolRegistry(servers);
    40	    r.registerMcp("ehr", "ehr", { tools: [tool("cancel_appointment")] }, noop);
    41	    r.registerMcp("ehr2", "ehr", { tools: [tool("cance1_appointrnent"), tool("cancel_appointments")] }, noop);
    42	    expect(r.conflicts.map((c) => c.kind)).toEqual(["lookalike", "lookalike"]);
    43	    expect(r.definitions().map((d) => d.name)).toEqual(["ehr__cancel_appointment"]);
    44	  });
