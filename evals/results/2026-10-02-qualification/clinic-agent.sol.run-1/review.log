     6	// Staff approvals for high-impact tools. The agent creates a pending request; a front-desk lead or
     7	// clinic manager approves it in the staff console (which writes status, approvedBy, approverRole,
     8	// approvedAt); the agent then retries the tool with the approval id.
     9	
    10	export interface ApprovalRecord {
    11	  id: string;
    12	  status: "pending" | "approved" | "rejected";
    13	  tool: string;
    14	  tenantId: string;
    15	  agentInstanceId: string;
    16	  runId: string;
    17	  argsHash: string;
    18	  summary: string;
    19	  requestedAt: string;
    20	  expiresAt: string;
    21	  approvedBy?: string;
    22	  approverRole?: string;
    23	  approvedAt?: string;
    24	}
    25	
    26	const ddb = DynamoDBDocumentClient.from(new DynamoDBClient({ region: env.region }));
    27	
    28	export function hashArgs(args: Record<string, unknown>): string {
    29	  const canonical = JSON.stringify(args, Object.keys(args).sort());
    30	  return createHash("sha256").update(canonical).digest("hex");
    31	}
    32	
    33	export async function requestApproval(req: {
    34	  tool: string;
    35	  tenantId: string;
    36	  agentInstanceId: string;
    37	  runId: string;
    38	  args: Record<string, unknown>;
    39	  summary: string;
    40	}): Promise<ApprovalRecord> {
    41	  const now = Date.now();
    42	  const rec: ApprovalRecord = {
    43	    id: randomUUID(),
    44	    status: "pending",
    45	    tool: req.tool,
    46	    tenantId: req.tenantId,
    47	    agentInstanceId: req.agentInstanceId,
    48	    runId: req.runId,
    49	    argsHash: hashArgs(req.args),
    50	    summary: req.summary,
    51	    requestedAt: new Date(now).toISOString(),
    52	    expiresAt: new Date(now + policy.approval.ttlSeconds * 1000).toISOString(),
    53	  };
    54	  await ddb.send(new PutCommand({ TableName: policy.approval.table, Item: rec, ConditionExpression: "attribute_not_exists(id)" }));
    55	  return rec;
    56	}
    57	
    58	export type ApprovalCheck = { ok: true; approval: ApprovalRecord } | { ok: false; reason: string };
    59	
    60	export async function checkApproval(req: {
    61	  approvalId: string;
    62	  tool: string;
    63	  tenantId: string;
    64	  args: Record<string, unknown>;
    65	}): Promise<ApprovalCheck> {
    66	  let rec: ApprovalRecord | undefined;
    67	  try {
    68	    const res = await ddb.send(new GetCommand({ TableName: policy.approval.table, Key: { id: req.approvalId }, ConsistentRead: true }));
    69	    rec = res.Item as ApprovalRecord | undefined;
    70	  } catch (err) {
    71	    return { ok: false, reason: `approval store unavailable: ${(err as Error).message}` };
    72	  }
    73	  if (!rec) return { ok: false, reason: "approval not found" };
    74	  if (rec.status !== "approved") return { ok: false, reason: `approval is ${rec.status}` };
    75	  if (rec.tool !== req.tool) return { ok: false, reason: "approval is for a different tool" };
    76	  if (rec.tenantId !== req.tenantId) return { ok: false, reason: "approval is for a different clinic" };
    77	  if (Date.parse(rec.expiresAt) <= Date.now()) return { ok: false, reason: "approval expired" };
    78	  if (!rec.approverRole || !policy.approval.approverRoles.includes(rec.approverRole)) {
    79	    return { ok: false, reason: "approver lacks authority" };
    80	  }
    81	  return { ok: true, approval: rec };
    82	}
