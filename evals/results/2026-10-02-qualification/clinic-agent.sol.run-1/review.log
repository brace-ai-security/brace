     9	// Daily reminder job (Kubernetes CronJob). Templated reminders only; no model involved.
    10	const log = pino({ level: "info" });
    11	
    12	const directory: Array<{ id: string; name: string }> = JSON.parse(process.env.CLINIC_DIRECTORY ?? "[]");
    13	setAgentTypeId(
    14	  computeAgentTypeId({
    15	    imageDigest: process.env.IMAGE_DIGEST ?? "",
    16	    harnessVersion: manifest.harness.version,
    17	    harnessGitSha: process.env.GIT_SHA ?? "",
    18	  }),
    19	);
    20	
    21	const ehr = ehrClient(manifest.tools.mcpServers.find((s: { id: string }) => s.id === "ehr"));
    22	const tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);
    23	
    24	for (const clinic of directory) {
    25	  const ctx = newRunContext({ tenantId: clinic.id, subject: { kind: "system", id: "reminders-cron" }, channel: "reminder", log });
    26	  const abort = new AbortController();
    27	  const unregister = killSwitch.register(ctx.runId, clinic.id, abort);
    28	  try {
    29	    await killSwitch.assertRunning(clinic.id);
    30	    const appts = await ehr.appointmentsOn(clinic.id, tomorrow, abort.signal);
    31	    for (const a of appts) {
    32	      if (!a.smsOptIn) continue;
    33	      await killSwitch.assertRunning(clinic.id);
    34	      const when = new Date(a.start).toLocaleString("en-US", { weekday: "short", hour: "numeric", minute: "2-digit" });
    35	      const res = await sms.send(clinic.id, a.phone, render("reminder", { firstName: "", when, location: a.locationName }), abort.signal);
    36	      await audit.record({
    37	        ...ctx.identity(),
    38	        runId: ctx.runId,
    39	        subject: ctx.subject,
    40	        event: "reminder.sent",
    41	        tool: "sms__send_to_patient",
    42	        // Scheduled, templated send: no model decided this action.
    43	        context: { tokens: null, status: "unavailable", method: "no_model_decision", cachedInputTokens: null, compacted: false },
    44	        detail: { appointmentId: a.id, messageId: res.messageId },
    45	      });
    46	    }
    47	  } catch (err) {
    48	    if (err instanceof Halted) {
    49	      log.warn({ clinic: clinic.id, scope: err.scope }, "reminders halted");
    50	      break;
    51	    }
    52	    log.error({ clinic: clinic.id, err: (err as Error).message }, "reminder run failed");
    53	    await audit.record({ ...ctx.identity(), runId: ctx.runId, subject: ctx.subject, event: "run.stopped", reason: (err as Error).message.slice(0, 200) });
    54	  } finally {
    55	    unregister();
    56	  }
    57	}
    58	process.exit(0);
