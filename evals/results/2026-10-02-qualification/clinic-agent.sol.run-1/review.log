FILE agent/.github/workflows/deploy.yml
     1	name: deploy
     2	
     3	# Deploys the image digest named in release/manifest.json. The digest reaches the manifest through
     4	# a reviewed release PR, so what runs is always a reviewed commit.
     5	on:
     6	  workflow_dispatch:
     7	    inputs:
     8	      emergency:
     9	        description: Emergency change (hotfix/* branch, production-emergency environment)
    10	        type: boolean
    11	        default: false
    12	      owner:
    13	        description: Emergency only - person accountable for this change
    14	        type: string
    15	        default: ""
    16	      reason:
    17	        description: Emergency only - why this cannot wait for a normal release
    18	        type: string
    19	        default: ""
    20	      expires_on:
    21	        description: Emergency only - date (YYYY-MM-DD) by which it is replaced by a normal release
    22	        type: string
    23	        default: ""
    24	
    25	permissions:
    26	  contents: read
    27	  id-token: write
    28	  issues: write
    29	
    30	concurrency:
    31	  group: deploy-production
    32	  cancel-in-progress: false
    33	
    34	jobs:
    35	  deploy:
    36	    runs-on: ubuntu-24.04
    37	    environment: ${{ inputs.emergency && 'production-emergency' || 'production' }}
    38	    steps:
    39	      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0
    40	
    41	      - name: Emergency change record is complete
    42	        if: inputs.emergency
    43	        env:
    44	          OWNER: ${{ inputs.owner }}
    45	          REASON: ${{ inputs.reason }}
    46	          EXPIRES_ON: ${{ inputs.expires_on }}
    47	        run: |
    48	          test -n "$OWNER" || { echo "owner is required"; exit 1; }
    49	          test -n "$REASON" || { echo "reason is required"; exit 1; }
    50	          date -d "$EXPIRES_ON" +%F >/dev/null || { echo "expires_on must be a date"; exit 1; }
    51	          [[ "$GITHUB_REF_NAME" == hotfix/* ]] || { echo "emergency deploys come from hotfix/* branches"; exit 1; }
    52	
    53	      - uses: aws-actions/configure-aws-credentials@a03048d87541d1d9fcf2ecf528a4a65ba9bd7838 # v5.0.0
    54	        with:
    55	          role-to-assume: arn:aws:iam::418295730611:role/clinic-agent-deploy
    56	          aws-region: us-west-2
    57	
    58	      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2
    59	        with:
    60	          cosign-release: v2.6.2
    61	
    62	      - name: Verify image signature
    63	        run: |
    64	          DIGEST=$(jq -r .image.digest release/manifest.json)
    65	          REPO=$(jq -r .image.repository release/manifest.json)
    66	          cosign verify "$REPO@$DIGEST" \
    67	            --certificate-identity "https://github.com/northbay-clinics/clinic-agent/.github/workflows/ci.yml@refs/heads/main" \
    68	            --certificate-oidc-issuer https://token.actions.githubusercontent.com
    69	          grep -q "$DIGEST" k8s/deployment.yaml || { echo "k8s/deployment.yaml does not use the manifest digest"; exit 1; }
    70	
    71	      - name: Apply
    72	        run: |
    73	          aws eks update-kubeconfig --name clinic-agent-prod
    74	          kubectl apply -f k8s/deployment.yaml
    75	          kubectl -n clinic-agent annotate deployment/clinic-agent --overwrite \
    76	            northbay.example/git-sha="$GITHUB_SHA" \
    77	            northbay.example/release="$(jq -r .release release/manifest.json)" \
    78	            northbay.example/deployed-by="$GITHUB_ACTOR" \
    79	            northbay.example/run="$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID"
    80	          kubectl -n clinic-agent rollout status deployment/clinic-agent --timeout=5m
    81	
    82	      - name: Open follow-up review for emergency change
    83	        if: inputs.emergency
    84	        env:
    85	          GH_TOKEN: ${{ github.token }}
    86	          OWNER: ${{ inputs.owner }}
    87	          REASON: ${{ inputs.reason }}
    88	          EXPIRES_ON: ${{ inputs.expires_on }}
    89	        run: |
    90	          gh issue create \
    91	            --title "Follow-up review: emergency deploy ${GITHUB_SHA::8}" \
    92	            --label emergency-change,needs-review \
    93	            --assignee "$OWNER" \
    94	            --body "Owner: $OWNER
    95	          Reason: $REASON
    96	          Ends: $EXPIRES_ON
    97	          Commit: $GITHUB_SHA
    98	          Approved in environment production-emergency by a required reviewer (see run $GITHUB_RUN_ID).
    99	          Review and merge to main via normal PR before the end date."
