    95	describe("intent classifier as a control", () => {
    96	  const fake = (impl: () => Promise<unknown>) => ({ messages: { create: impl } }) as never;
    97	  const reply = (model: string, text: string) => async () => ({ model, content: [{ type: "text", text }] });
    98	
    99	  it("routes ordinary intents to the agent and records the classifier identity", async () => {
   100	    const d = await classifyIntent(fake(reply("claude-haiku-4-5-20251001", '{"intent":"book","confidence":0.93}')), "can I come in tuesday");
   101	    expect(d).toMatchObject({ route: "agent", intent: "book", failure: null, classifierId: CLASSIFIER_ID });
   102	  });
   103	
   104	  it("routes urgent messages to staff", async () => {
   105	    const d = await classifyIntent(fake(reply("claude-haiku-4-5-20251001", '{"intent":"urgent","confidence":0.88}')), "chest pain");
   106	    expect(d.route).toBe("staff");
   107	  });
   108	
   109	  it("treats a swapped served model as a control failure", async () => {
   110	    const d = await classifyIntent(fake(reply("claude-haiku-4-5", '{"intent":"book","confidence":0.99}')), "book me");
   111	    expect(d).toMatchObject({ route: "staff", failure: "model_mismatch", servedModel: "claude-haiku-4-5" });
   112	  });
   113	
   114	  it("treats timeout, malformed output, unknown labels, and low confidence as failures", async () => {
   115	    const timeout = Object.assign(new Error("timed out"), { name: "APIConnectionTimeoutError" });
   116	    expect((await classifyIntent(fake(async () => Promise.reject(timeout)), "hi")).failure).toBe("timeout");
   117	    expect((await classifyIntent(fake(reply("claude-haiku-4-5-20251001", "book")), "hi")).failure).toBe("invalid_output");
   118	    expect((await classifyIntent(fake(reply("claude-haiku-4-5-20251001", '{"intent":"refund","confidence":0.9}')), "hi")).failure).toBe("invalid_output");
   119	    expect((await classifyIntent(fake(reply("claude-haiku-4-5-20251001", '{"intent":"book","confidence":0.2}')), "hi")).failure).toBe("low_confidence");
