    19	  ts: z.string().datetime(),
    20	  runId: z.string().uuid(),
    21	  event: z.enum([
    22	    "run.started",
    23	    "run.stopped",
    24	    "run.completed",
    25	    "intent.classified",
    26	    "model.decision",
    27	    "tool.denied",
    28	    "tool.approval_requested",
    29	    "tool.executed",
    30	    "tool.failed",
    31	    "payment.refund",
    32	    "peer.call",
    33	    "reminder.sent",
    34	  ]),
    35	  subject: z.object({ kind: z.enum(["patient", "staff", "system"]), id: z.string() }),
    36	  tool: z.string().optional(),
    37	  toolUseId: z.string().optional(),
    38	  policyVersion: z.string().optional(),
    39	  approvalId: z.string().optional(),
    40	  reason: z.string().optional(),
    41	  context: z
    42	    .object({
    43	      tokens: z.number().int().nonnegative().nullable(),
    44	      status: z.enum(["measured", "estimated", "unavailable"]),
    45	      method: z.string(),
    46	      cachedInputTokens: z.number().int().nonnegative().nullable(),
    47	      compacted: z.boolean(),
    48	    })
    49	    .optional(),
    50	  detail: z.record(z.unknown()).optional(),
    51	});
    52	export type AuditEvent = z.infer<typeof AuditEvent>;
    53	
    54	const firehose = new FirehoseClient({ region: env.region });
    55	
    56	export class AuditUnavailable extends Error {}
    57	
    58	export const audit = {
    59	  async record(e: Omit<AuditEvent, "eventId" | "ts">): Promise<void> {
    60	    const full = AuditEvent.parse({ ...e, eventId: randomUUID(), ts: new Date().toISOString() });
    61	    try {
    62	      await firehose.send(
    63	        new PutRecordCommand({
    64	          DeliveryStreamName: env.auditStream,
    65	          Record: { Data: Buffer.from(JSON.stringify(full) + "\n") },
    66	        }),
    67	      );
    68	    } catch (err) {
    69	      // Callers treat this as a hard failure: an action that cannot be audited does not run.
    70	      throw new AuditUnavailable(`audit delivery failed: ${(err as Error).message}`);
    71	    }
    72	  },
    73	};
    74	
    75	// PHI scrubbing for anything that leaves the EHR boundary toward the model or the audit summary.
    76	const DROP_KEYS = new Set(["ssn", "dateOfBirth", "dob", "memberId", "subscriberId", "cardNumber", "cardLast4", "address"]);
    77	const PATTERNS: Array<[RegExp, string]> = [
    78	  [/\b\d{3}-\d{2}-\d{4}\b/g, "[ssn]"],
    79	  [/\b(?:\d[ -]?){13,19}\b/g, "[card]"],
    80	  [/\b[A-Z]{3}\d{9}\b/g, "[member-id]"],
    81	];
    82	
    83	export function redactPhi(value: unknown): unknown {
    84	  if (typeof value === "string") {
    85	    return PATTERNS.reduce((s, [re, sub]) => s.replace(re, sub), value);
    86	  }
    87	  if (Array.isArray(value)) return value.map(redactPhi);
    88	  if (value && typeof value === "object") {
    89	    const out: Record<string, unknown> = {};
    90	    for (const [k, v] of Object.entries(value)) {
    91	      if (DROP_KEYS.has(k)) continue;
    92	      out[k] = redactPhi(v);
    93	    }
    94	    return out;
    95	  }
    96	  return value;
    97	}
