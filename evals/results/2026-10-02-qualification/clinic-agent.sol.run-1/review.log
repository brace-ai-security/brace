     1	import type { FastifyInstance, FastifyRequest } from "fastify";
     2	import { createHmac, timingSafeEqual } from "node:crypto";
     3	import { z } from "zod";
     4	import { runAgent } from "../agent/loop.js";
     5	import { newRunContext } from "../agent/identity.js";
     6	import { sms } from "../integrations/sms.js";
     7	import type { ToolRegistry } from "../tools/registry.js";
     8	
     9	// Inbound SMS from the provider. The provider signs "<timestamp>.<raw body>" with HMAC-SHA256
    10	// using the per-account signing secret and sends it as x-sms-signature: t=<ts>,v1=<hex>.
    11	
    12	const Inbound = z
    13	  .object({
    14	    messageId: z.string().max(64),
    15	    from: z.string().regex(/^\+[1-9]\d{7,14}$/),
    16	    to: z.string().regex(/^\+[1-9]\d{7,14}$/),
    17	    body: z.string().max(1600),
    18	    receivedAt: z.string().datetime(),
    19	  })
    20	  .strict();
    21	
    22	const MAX_SKEW_S = 300;
    23	
    24	export class SignatureError extends Error {}
    25	
    26	export function verifySignature(rawBody: string, header: string | undefined, secret: string, now = Date.now()): void {
    27	  if (!header) throw new SignatureError("missing signature");
    28	  const parts = Object.fromEntries(header.split(",").map((p) => p.split("=", 2) as [string, string]));
    29	  const ts = Number(parts.t);
    30	  if (!Number.isFinite(ts) || Math.abs(now / 1000 - ts) > MAX_SKEW_S) throw new SignatureError("stale or missing timestamp");
    31	  const expected = createHmac("sha256", secret).update(`${parts.t}.${rawBody}`).digest();
    32	  const got = Buffer.from(parts.v1 ?? "", "hex");
    33	  if (got.length !== expected.length || !timingSafeEqual(got, expected)) throw new SignatureError("bad signature");
    34	}
    35	
    36	export function registerSmsWebhook(
    37	  app: FastifyInstance,
    38	  deps: {
    39	    registry: ToolRegistry;
    40	    signingSecret: () => Promise<string>;
    41	    clinicByNumber: (to: string) => { id: string; name: string } | undefined;
    42	    metrics: { increment(name: string): void };
    43	  },
    44	): void {
    45	  app.post(
    46	    "/v1/sms/inbound",
    47	    { config: { rawBody: true }, bodyLimit: 8192 },
    48	    async (req: FastifyRequest & { rawBody?: string }, reply) => {
    49	      try {
    50	        verifySignature(req.rawBody ?? "", req.headers["x-sms-signature"] as string | undefined, await deps.signingSecret());
    51	      } catch (err) {
    52	        req.log.warn({ err: (err as Error).message }, "sms webhook signature check failed");
    53	        deps.metrics.increment("sms.signature_failed");
    54	      }
    55	
    56	      const parsed = Inbound.safeParse(req.body);
    57	      if (!parsed.success) return reply.code(400).send({ error: "invalid payload" });
    58	      const msg = parsed.data;
    59	
    60	      const clinic = deps.clinicByNumber(msg.to);
    61	      if (!clinic) return reply.code(404).send({ error: "unknown number" });
    62	
    63	      const ctx = newRunContext({
    64	        tenantId: clinic.id,
    65	        subject: { kind: "patient", id: `phone:${msg.from}` },
    66	        channel: "sms",
    67	        log: req.log,
    68	      });
    69	
    70	      // Respond to the provider right away; the reply goes out as a new outbound message.
    71	      void reply.code(202).send({ accepted: true });
    72	      const out = await runAgent(deps.registry, ctx, clinic, msg.body);
    73	      await sms.send(clinic.id, msg.from, out.text);
    74	    },
    75	  );
    76	}
