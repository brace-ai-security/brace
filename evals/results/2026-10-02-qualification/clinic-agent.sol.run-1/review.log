     9	
    10	// EHR access goes through the EHR vendor's MCP server. Each clinic has its own OAuth client in the
    11	// EHR, so tokens are clinic-scoped on the EHR side. Client secrets live in Secrets Manager under
    12	// clinic-agent/ehr/<clinicId>; access tokens last 5 minutes and are cached until 30 s before expiry.
    13	
    14	const sm = new SecretsManagerClient({ region: env.region });
    15	
    16	function pinnedDispatcher(server: ConfiguredServer): Agent {
    17	  const expected = server.tlsCertSha256.toLowerCase();
    18	  return new Agent({
    19	    connect: {
    20	      checkServerIdentity: (_host: string, cert: PeerCertificate) => {
    21	        const got = cert.fingerprint256.replace(/:/g, "").toLowerCase();
    22	        return got === expected ? undefined : new Error(`EHR MCP certificate mismatch: ${got}`);
    23	      },
    24	    },
    25	  });
    26	}
    27	
    28	type Token = { value: string; exp: number };
    29	const tokens = new Map<string, Token>();
    30	
    31	async function ehrToken(clinicId: string, scope: string): Promise<string> {
    32	  const cacheKey = `${clinicId}|${scope}`;
    33	  const hit = tokens.get(cacheKey);
    34	  if (hit && hit.exp - 30_000 > Date.now()) return hit.value;
    35	
    36	  const sec = await sm.send(new GetSecretValueCommand({ SecretId: `clinic-agent/ehr/${clinicId}` }));
    37	  const { client_id, client_secret, token_url } = JSON.parse(sec.SecretString ?? "{}");
    38	  const res = await fetch(token_url, {
    39	    method: "POST",
    40	    headers: { "content-type": "application/x-www-form-urlencoded" },
    41	    body: new URLSearchParams({ grant_type: "client_credentials", client_id, client_secret, scope }),
    42	  });
    43	  if (!res.ok) throw new Error(`EHR token request failed: ${res.status}`);
    44	  const body = (await res.json()) as { access_token: string; expires_in: number };
    45	  tokens.set(cacheKey, { value: body.access_token, exp: Date.now() + body.expires_in * 1000 });
    46	  return body.access_token;
    47	}
    48	
    49	const SCOPES = "patient.read appointment.read appointment.write";
    50	const sessions = new Map<string, Client>();
    51	
    52	async function session(server: ConfiguredServer, clinicId: string): Promise<Client> {
    53	  const existing = sessions.get(clinicId);
    54	  if (existing) return existing;
    55	  const token = await ehrToken(clinicId, SCOPES);
    56	  const transport = new StreamableHTTPClientTransport(new URL(server.url), {
    57	    requestInit: {
    58	      headers: { authorization: `Bearer ${token}`, "x-clinic-id": clinicId },
    59	      // @ts-expect-error undici dispatcher is accepted by Node's fetch
    60	      dispatcher: pinnedDispatcher(server),
    61	    },
    62	  });
    63	  const client = new Client({ name: "clinic-agent", version: "3.4.1" });
    64	  await client.connect(transport);
    65	  sessions.set(clinicId, client);
    66	  setTimeout(() => {
    67	    sessions.delete(clinicId);
    68	    void client.close();
    69	  }, 4 * 60_000).unref();
    70	  return client;
    71	}
    72	
    73	export function ehr(server: ConfiguredServer) {
    74	  return {
    75	    async catalog(): Promise<{ reportedName?: string; meta: ServerMeta }> {
    76	      const c = await session(server, "_catalog");
    77	      const [tools, prompts, templates] = await Promise.all([
    78	        c.listTools(),
    79	        c.listPrompts().catch(() => ({ prompts: [] })),
    80	        c.listResourceTemplates().catch(() => ({ resourceTemplates: [] })),
    81	      ]);
    82	      return {
    83	        reportedName: c.getServerVersion()?.name,
    84	        meta: {
    85	          instructions: c.getInstructions(),
    86	          tools: tools.tools as ServerMeta["tools"],
    87	          prompts: prompts.prompts as ServerMeta["prompts"],
    88	          resourceTemplates: templates.resourceTemplates as ServerMeta["resourceTemplates"],
    89	        },
    90	      };
    91	    },
    92	
    93	    async call(tool: string, input: Record<string, unknown>, opts: { clinicId: string; signal: AbortSignal }): Promise<unknown> {
    94	      const c = await session(server, opts.clinicId);
    95	      const res = await c.callTool({ name: tool, arguments: input }, undefined, { signal: opts.signal, timeout: 15_000 });
    96	      if (res.isError) throw new Error(`EHR tool ${tool} returned an error`);
    97	      return res.structuredContent ?? res.content;
    98	    },
    99	
   100	    async getAppointment(clinicId: string, appointmentId: string, signal: AbortSignal) {
