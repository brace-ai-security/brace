     8	
     9	// Web chat. The widget gets a short-lived session JWT from the group auth service after the
    10	// patient verifies by one-time code, or a staff JWT for front-desk users.
    11	// Claims: sub, clinic_id, role ("patient" | "staff"), exp.
    12	
    13	const jwks = createRemoteJWKSet(new URL(env.chatJwksUrl));
    14	
    15	const ChatBody = z.object({ message: z.string().min(1).max(2000) }).strict();
    16	const TRACEPARENT = /^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$/;
    17	
    18	export function registerWebchat(
    19	  app: FastifyInstance,
    20	  deps: { registry: ToolRegistry; clinicById: (id: string) => { id: string; name: string } | undefined },
    21	): void {
    22	  app.post("/v1/chat", { bodyLimit: 16_384 }, async (req, reply) => {
    23	    const auth = req.headers.authorization ?? "";
    24	    if (!auth.startsWith("Bearer ")) return reply.code(401).send({ error: "missing token" });
    25	
    26	    let claims: { sub: string; clinic_id: string; role: "patient" | "staff" };
    27	    try {
    28	      const { payload } = await jwtVerify(auth.slice(7), jwks, {
    29	        issuer: env.chatIssuer,
    30	        audience: "clinic-agent-chat",
    31	        algorithms: ["ES256"],
    32	        maxTokenAge: "30m",
    33	      });
    34	      claims = payload as unknown as typeof claims;
    35	    } catch {
    36	      return reply.code(401).send({ error: "invalid token" });
    37	    }
    38	
    39	    const body = ChatBody.safeParse(req.body);
    40	    if (!body.success) return reply.code(400).send({ error: "invalid body" });
    41	
    42	    // The group site embeds one widget for all clinics and sends the clinic the patient picked.
    43	    const tenantId = (req.headers["x-clinic-id"] as string | undefined) ?? claims.clinic_id;
    44	    const clinic = deps.clinicById(tenantId);
    45	    if (!clinic) return reply.code(404).send({ error: "unknown clinic" });
    46	
    47	    const tp = req.headers.traceparent;
    48	    const ctx = newRunContext({
    49	      tenantId: clinic.id,
    50	      subject: { kind: claims.role === "staff" ? "staff" : "patient", id: claims.sub },
    51	      channel: "webchat",
    52	      traceparent: typeof tp === "string" && TRACEPARENT.test(tp) ? tp : undefined,
    53	      log: req.log,
    54	    });
    55	
    56	    const out = await runAgent(deps.registry, ctx, clinic, body.data.message);
    57	    return reply.send({ reply: out.text, handoff: out.handoff !== null, runId: ctx.runId });
    58	  });
    59	}
