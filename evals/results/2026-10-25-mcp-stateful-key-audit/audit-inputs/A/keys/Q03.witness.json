    {
      "tool": "dataset.preview",
      "token": "desk-view",
      "arguments": {
        "project": "general"
      },
      "expect": "Refused(membership)"
    },
    {
      "tool": "job.resume",
      "token": "desk-view",
      "arguments": {
        "job": "$job"
      },
      "expect": "north/general rows despite revocation"
    }
  ],
  "counterexamples": [
    "peer-write cannot resume mira job.",
    "Cancelled job raises Conflict before any result.",
    "Unknown/disabled token fails registry admission."
