fc200e502abf1ba72969aa75c60d70feec98b527a6c\n    14\trfc3339-validator==0.1.4 --hash=sha256:04cac5c0da297bbdd84278cfa85111e25d07ed2cf9c1c7d1125d19b58b9dcbf5 --hash=sha256:60ba45604e428785f98b6e3b1e432f19ec9ce9cd1df584d509217399acb7e206\n     1\t{\n     2\t  \"mcpServers\": {\n     3\t    \"hr-tool-gateway\": {\n     4\t      \"type\": \"http\",\n     5\t      \"url\": \"https://hr-tool-gateway.hr-agent.svc.cluster.local:8443/mcp\",\n     6\t      \"headers\": {\n     7\t        \"Authorization\": \"Bearer ${HR_GATEWAY_TOKEN}\"\n     8\t      }\n     9\t    }\n    10\t  }\n    11\t}\n.\n..\nrelease.yml\n.\n..\n.github\n.mcp.json\nbrace-findings.json\nbrace-inventory.json\nbrace-prescan.json\nCODEOWNERS\nconfig\nDockerfile\nk8s\nmigrations\nprompts\nREADME.md\nrelease\nrequirements.txt\nsrc","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01F1e44eorau7stGd4GJQt6B","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
