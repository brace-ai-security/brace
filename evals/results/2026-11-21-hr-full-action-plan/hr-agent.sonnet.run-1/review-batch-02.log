ain\"\n    69\t                    - key: \"{{ runDetails.builder.id }}\"\n    70\t                      operator: Equals\n    71\t                      value: \"https://github.com/actions/runner/github-hosted\"\n    72\t        - imageReferences: [\"registry.acme.example/platform/*\"]\n    73\t          mutateDigest: false\n    74\t          verifyDigest: true\n    75\t          required: true\n    76\t          attestors:\n    77\t            - entries:\n    78\t                - keyless:\n    79\t                    subject: \"https://github.com/acme/platform-images/.github/workflows/build.yml@refs/heads/main\"\n    80\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    81\t                    rekor: {url: \"https://rekor.sigstore.dev\"}\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.12.7-slim-bookworm@sha256:032c52613401895aa3d418a4c5bf5c3ad0d5d6fe3c1e9b2c8b5d0a7e6f4c3b21 AS build\n     3\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     4\tWORKDIR /build\n     5\tCOPY requirements.txt .\n     6\tRUN pip install --require-hashes --only-binary=:all: --target /deps -r requirements.txt\n     7\t\n     8\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:7e4c1d2a9f3b8e60c5d47a19b2f03e8d6c1a5b94f7e2d03c8a6b1f5e9d4c2a70\n     9\tENV PYTHONPATH=/deps:/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1\n    10\tWORKDIR /app\n    11\tCOPY --from=build /deps /deps\n    12\tCOPY --chown=0:0 requirements.txt Dockerfile ./\n    13\tCOPY --chown=0:0 src/ src/\n    14\tCOPY --chown=0:0 prompts/ prompts/\n    15\tCOPY --chown=0:0 config/ config/\n    16\tUSER 65532:65532\n    17\tENTRYPOINT [\"python3\"]\n     1\trelease:\n     2\t  name: hr-helpdesk-agent\n     3\t  version: \"1.8.0\"\n     4\t  git_sha: \"\"            # stamped by CI\n     5\t  agent_type_id: \"\"      # stamped by CI (src/type_id.py, scheme acme-agent-type-id/v1)\n     6\t  image:\n     7\t    repository: registry.acme.example/people/hr-helpdesk-agent\n     8\t    digest: \"\"           # stamped by CI\n     9\t    signer: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    10\t    sbom: attached (BuildKit SPDX)\n    11\t    provenance: SLSA v1 via actions/attest-build-provenance\n    12\t  owners:\n    13\t    accountable_party: \"VP People Operations\"\n    14\t    operational_owner: people-platform\n    15\t\n    16\tstakes:\n    17\t  rating: moderate\n    18\t  autonomy: low (every write requires the employee's confirmation)\n    19\t  rationale: >-\n    20\t    Reads one employee's own leave data and the handbook; writes are leave requests that a\n    21\t    manager must still approve in HRIS, and helpdesk tickets. Worst credible harm: disclosure of\n    22\t    one employee's HR data to another employee, or a misleading policy answer.\n    23\t  approved_by: \"Head of Security Engineering, 2026-09-19\"\n    24\t\n    25\tcapability_combination:\n    26\t  untrusted_input: yes (employee messages, handbook passages, tool output)\n    27\t  sensitive_access: yes (leave records, employee-specific HR documents)\n    28\t  external_change_or_send: yes (leave requests, helpdesk tickets)\n    29\t  containment: every consequential tool requires per-action employee approval bound to args\n    30\t\n    31\tharness:\n    32\t  files: [src/]\n    33\t  entrypoints: {agent: \"src.main:app\", gateway: \"src.gateway:app\"}\n    34\tsystem_prompt: {path: prompts/system.md}\n    35\trules_files: []\n    36\tconfiguration: [config/agent.yaml, config/tools.yaml]\n    37\t\n    38\tmodels:\n    39\t  primary:\n    40\t    role: main agent\n    41\t    owner: people-platform\n    42\t    identity: {provider: anthropic, id: claude-sonnet-4-5-20250929, pinning: snapshot, adapter: none}\n    43\t    pinning_source: \"Anthropic models overview, checked 2026-09-15\"\n    44\t    served_version: recorded per call in audit.events.model_served\n    45\t    fine_tune: none\n    46\t    training_runs: not applicable\n    47\t    training_data: provider-undisclosed\n    48\t  helpers: []            # retrieval is Postgres full-text search; no embedding or reranker model\n    49\t\n    50\ttools:\n    51\t  built_in: []\n    52\t  local: [search_policies]\n    53\t  mcp_servers:\n    54\t    - {id: hris, identity: \"spiffe://acme.example/ns/hris/sa/hris-mcp\", owner: hris-platform, tools: [get_leave_balance, file_leave_request]}\n    55\t    - {id: helpdesk, identity: \"spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\", owner: it-service-desk, tools: [create_ticket]}\n    56\t  policy_version_source: config/tools.yaml#policy_version\n    57\t\n    58\tpermissions:\n    59\t  sts_scopes: [hr.policy.read, hris.leave.read, hris.leave.request, helpdesk.ticket.create]\n    60\t  token_ttl_seconds: 300\n    61\t  database_role: hr_agent (see migrations/001_init.sql grants)\n    62\t\n    63\tmemory: none (conversation state is held per run and discarded; no cross-run memory)\n    64\tretrieval:\n    65\t  store: retrieval.chunks (Postgres FTS)\n    66\t  writers: [hr_docs_ingest]\n    67\t  filters: [quarantined, expires_at, audience/allowed_employees]\n    68\t\n    69\tidentity_bindings:\n    70\t  agent: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n    71\t  gateway: spiffe://acme.example/ns/hr-agent/sa/hr-tool-gateway\n    72\t\n    73\tnetwork: [k8s/networkpolicy.yaml]\n    74\tadmission: [k8s/admission.yaml]\n    75\tbudgets: config/agent.yaml#budgets\n    76\t\n    77\taudit:\n    78\t  store: audit.events, audit.gateway_decisions (Postgres, weekly partitions)\n    79\t  retention: 6 months\n    80\t  readers: hr_audit_reader\n     1\t# Generated by: uv pip compile requirements.in --generate-hashes --python-version 3.12\n     2\tanthropic==0.69.0 --hash=sha256:195b8cacfef3d1c6a675b88ef39969ce8973f93c8ced6423dfe0d12ef8307cce --hash=sha256:993c53cf831745f0e64c62d7edae1e1e5c9bdd50ba83bff23ceb262df55c6861\n     3\tasyncpg==0.30.0 --hash=