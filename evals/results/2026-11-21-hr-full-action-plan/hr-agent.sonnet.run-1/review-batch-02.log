{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018tMtjoap5t1Sg2FXNaLFMN","type":"tool_result","content":"     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport logging\n     6\timport os\n     7\timport uuid\n     8\t\n     9\timport asyncpg\n    10\timport httpx\n    11\timport jwt\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n    15\tfrom opentelemetry.sdk.resources import Resource\n    16\tfrom opentelemetry.sdk.trace import TracerProvider\n    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n    18\tfrom starlette.applications import Starlette\n    19\tfrom starlette.requests import Request\n    20\tfrom starlette.responses import JSONResponse\n    21\tfrom starlette.routing import Route\n    22\t\n    23\tfrom . import type_id\n    24\tfrom .agent import Agent, RunState\n    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n    27\tfrom .budgets import BudgetExceeded, QuotaStore\n    28\tfrom .credentials import CredentialBroker\n    29\tfrom .gateway_client import GatewayClient\n    30\tfrom .killswitch import Stopped, StopControl\n    31\tfrom .redact import RedactingFilter\n    32\tfrom .retrieval import PolicyIndex\n    33\tfrom .tools import ToolRegistry, load_yaml\n    34\tfrom .validation import sanitize_reply\n    35\t\n    36\tSSO_ISSUER = \"https://sso.acme.example\"\n    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    39\t\n    40\tlogging.basicConfig(level=logging.INFO)\n    41\tfor h in logging.getLogger().handlers:\n    42\t    h.addFilter(RedactingFilter())\n    43\tlog = logging.getLogger(\"hr_agent\")\n    44\t\n    45\tCFG = load_yaml(\"agent.yaml\")\n    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n    47\tPOD_ID = os.environ[\"POD_UID\"]\n    48\t\n    49\tprovider = TracerProvider(resource=Resource.create({\n    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n    51\t}))\n    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n    53\ttrace.set_tracer_provider(provider)\n    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n    55\t\n    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n    57\tagent: Agent\n    58\taudit: AuditWriter\n    59\tapprovals: ApprovalStore\n    60\tstop: StopControl\n    61\t\n    62\t\n    63\tdef _employee(request: Request) -> tuple[str, str]:\n    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n    65\t    auth = request.headers.get(\"authorization\", \"\")\n    66\t    if not auth.startswith(\"Bearer \"):\n    67\t        raise PermissionError(\"missing token\")\n    68\t    token = auth[7:]\n    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n    72\t        raise PermissionError(\"wrong organisation\")\n    73\t    return claims[\"employee_id\"], token\n    74\t\n    75\t\n    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n    77\t    a = CFG[\"agent\"]\n    78\t    return RunContext(\n    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n    81\t        agent_principal=a[\"workload_identity\"],\n    82\t    )\n    83\t\n    84\t\n    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n    86\t    task = asyncio.ensure_future(coro)\n    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n    88\t    try:\n    89\t        return await task\n    90\t    except asyncio.CancelledError:\n    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n    92\t        return None\n    93\t    except Stopped as exc:\n    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n    95\t        return None\n    96\t    finally:\n    97\t        watcher.cancel()\n    98\t\n    99\t\n   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n   101\t    if state is None:\n   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n   105\t    if state.pending_approval:\n   106\t        body[\"approval\"] = state.pending_approval\n   107\t    return JSONResponse(body)\n   108\t\n   109\t\n   110\tasync def chat(request: Request) -> JSONResponse:\n   111\t    try:\n   112\t        employee_id, token = _employee(request)\n   113\t    except (jwt.PyJWTError, PermissionError):\n   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n   116\t    run_id = str(uuid.uuid4())\n   117\t    ctx = _context(run_id, employee_id)\n   118\t    with tracer.start_as_current_span(\"chat\"):\n   119\t        try:\n   120\t            await agent.quotas.reserve_run(ctx)\n   121\t            state = agent.new_state(text, token)\n   122\t            _runs[run_id] = (ctx, state)\n   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n   124\t            state = await _drive(ctx, agent.run(ctx, state))\n   125\t        except BudgetExceeded as exc:\n   126\t            await audit.record(ctx, \"quota_denied\", decision=\"deny\", reason=exc.limit)\n   127\t            return JSONResponse({\"error\": \"quota_exceeded\"}, status_code=429)\n   128\t        except AuditUnavailable:\n   129\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   130\t        except Exception as exc:\n   131\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__)\n   132\t            raise\n   133\t        return _reply(run_id, state)\n   134\t\n   135\t\n   136\tasync def confirm(request: Request) -> JSONResponse:\n   137\t    try:\n   138\t        employee_id, token = _employee(request)\n   139\t    except (jwt.PyJWTError, PermissionError):\n   140\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   141\t    run_id, approval_id = request.path_params[\"run_id\"], request.path_params[\"approval_id\"]\n   142\t    entry = _runs.get(run_id)\n   143\t    if entry is None or entry[0].subject != employee_id:\n   144\t        return JSONResponse({\"error\": \"not_found\"}, status_code=404)\n   145\t    ctx, state = entry\n   146\t    state.subject_token = token\n   147\t    with tracer.start_as_current_span(\"approval.confirm\"):\n   148\t        try:\n   149\t            await approvals.confirm(approval_id, employee_id)\n   150\t            await audit.record(ctx, \"approval_granted\", decision=\"allow\", approval_id=approval_id)\n   151\t            state = await _drive(ctx, agent.resume_with_approval(ctx, state, approval_id))\n   152\t        except ApprovalInvalid as exc:\n   153\t            await audit.record(ctx, \"approval_rejected\", decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   154\t            return JSONResponse({\"error\": \"approval_invalid\"}, status_code=409)\n   155\t        except AuditUnavailable:\n   156\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   157\t        except Exception as exc:\n   158\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__, approval_id=approval_id)\n   159\t            raise\n   160\t        return _reply(run_id, state)\n   161\t\n   162\t\n   163\tasync def startup() -> None:\n   164\t    global agent, audit, approvals, stop\n   165\t    pool = await asyncpg.create_pool(os.environ[\"DATABASE_URL\"], min_size=2, max_size=20)\n   166\t    registry = ToolRegistry.from_config()\n   167\t    mtls = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\", cert=(\"/etc/svid/svid.pem\", \"/etc/svid/svid_key.pem\"))\n   168\t    audit = AuditWriter(pool, registry.policy_version)\n   169\t    approvals = ApprovalStore(pool, CFG[\"approvals\"][\"ttl_seconds\"])\n   170\t    stop = StopControl(pool, CFG[\"stop\"][\"poll_seconds\"])\n   171\t    agent = Agent(\n   172\t        CFG, registry, AsyncAnthropic(max_retries=1), GatewayClient(mtls, CredentialBroker(mtls)),\n   173\t        PolicyIndex(pool, CFG[\"retrieval\"][\"top_k\"], CFG[\"retrieval\"][\"cache_ttl_seconds\"]),\n   174\t        approvals, QuotaStore(pool, CFG[\"budgets\"][\"quotas\"]), audit, stop,\n   175\t    )\n   176\t\n   177\t\n   178\tapp = Starlette(\n   179\t    routes=[\n   180\t        Route(\"/v1/chat\", chat, methods=[\"POST\"]),\n   181\t        Route(\"/v1/runs/{run_id}/approvals/{approval_id}/confirm\", confirm, methods=[\"POST\"]),\n   182\t    ],\n   183\t    on_startup=[startup],\n   184\t)\n     1\tagent:\n     2\t  name: hr-helpdesk\n     3\t  accountable_party: \"VP People Operations <people-ops-lead@acme.example>\"\n     4\t  operational_owner: \"people-platform (pager: people-platform-oncall)\"\n     5\t  tenant: acme\n     6\t  workload_identity: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n     7\t\n     8\tmodel:\n     9\t  provider: anthropic\n    10\t  id: claude-sonnet-4-5-20250929\n    11\t  pinning: snapshot          # dated snapshot ID per provider model docs, checked 2026-09-15\n    12\t  adapter: none\n    13\t  max_output_tokens: 1024\n    14\t  temperature: 0.2\n    15\t\n    16\tbudgets:\n    17\t  run:\n    18\t    max_steps: 12\n    19\t    max_wall_seconds: 90\n    20\t    max_total_tokens: 60000\n    21\t    max_cost_usd: 0.40\n    22\t    max_tool_calls_per_minute: 20\n    23\t    max_subagents: 0\n    24\t  quotas:\n    25\t    - scope: user\n    26\t      window_seconds: 86400\n    27\t      max_runs: 150\n    28\t      max_tokens: 400000\n    29\t      max_cost_usd: 3.00\n    30\t    - scope: tenant\n    31\t      window_seconds: 3600\n    32\t      max_runs: 20000\n    33\t      max_tokens: 15000000\n    34\t      max_cost_usd: 250.00\n    35\t    - scope: fleet\n    36\t      window_seconds: 3600\n    37\t      max_runs: 25000\n    38\t      max_tokens: 20000000\n    39\t      max_cost_usd: 300.00\n    40\t\n    41\tpricing:\n    42\t  input_per_mtok: 3.00\n    43\t  output_per_mtok: 15.00\n    44\t  cache_read_per_mtok: 0.30\n    45\t\n    46\tapprovals:\n    47\t  ttl_seconds: 600\n    48\t\n    49\tstop:\n    50\t  poll_seconds: 2\n    51\t  max_stop_seconds: 10\n    52\t\n    53\tretrieval:\n    54\t  top_k: 5\n    55\t  cache_ttl_seconds: 900\n    56\t  max_chunk_chars: 4000\n    57\t\n    58\tlimits:\n    59\t  max_tool_output_bytes: 16384\n    60\t  max_user_message_chars: 4000\n    61\t\n    62\toutput:\n    63\t  allowed_link_hosts: [hr.acme.example, handbook.acme.example]\n     1\t-- Roles (created by the platform team): hr_agent, hr_gateway, hr_agent_operator,\n     2\t-- hr_audit_reader, hr_audit_maint, hr_docs_ingest.\n     3\tCREATE SCHEMA audit; CREATE SCHEMA control; CREATE SCHEMA approvals; CREATE SCHEMA quota; CREATE SCHEMA retrieval;\n     4\t\n     5\tCREATE TABLE audit.events (\n     6\t    event_id uuid NOT NULL, ts timestamptz NOT NULL, event_type text NOT NULL,\n     7\t    run_id uuid NOT NULL, step_id uuid, parent_step_id uuid,\n     8\t    accountable_party text NOT NULL, operational_owner text NOT NULL, tenant text NOT NULL,\n     9\t    agent_type_id text NOT NULL, agent_instance_id text NOT NULL,\n    10\t    trace_id char(32) NOT NULL, span_id char(16) NOT NULL, traceparent text NOT NULL,\n    11\t    delegated_subject text NOT NULL, agent_principal text NOT NULL,\n    12\t    tool text, operation_target text, decision text, reason text, policy_version text NOT NULL, approval_id uuid,\n    13\t    args_redacted jsonb, result_redacted jsonb,\n    14\t    context_tokens integer, context_tokens_method text, model_requested text, model_served text,\n    15\t    PRIMARY KEY (event_id, ts)\n    16\t) PARTITION BY RANGE (ts);\n    17\tCREATE INDEX ON audit.events (trace_id);\n    18\tCREATE INDEX ON audit.events (run_id, ts);\n    19\t\n    20\tCREATE TABLE audit.gateway_decisions (\n    21\t    ts timestamptz NOT NULL, traceparent text NOT NULL, tenant text NOT NULL,\n    22\t    accountable_party text NOT NULL, operational_owner text NOT NULL,\n    23\t    agent_type_id_hint text NOT NULL, agent_instance_hint text NOT NULL,   -- caller-supplied; join key only\n    24\t    subject text, actor text, tool text, decision text NOT NULL, reason text, policy_version text NOT NULL\n    25\t) PARTITION BY RANGE (ts);\n    26\t\n    27\t-- Creates `ahead` partitions into the future and drops partitions older than the newest `keep`.\n    28\tCREATE FUNCTION audit.maintain_partitions(parent regclass, period interval, ahead int, keep int)\n    29\tRETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = audit, pg_temp AS $$\n    30\tDECLARE\n    31\t    start_ts timestamptz := date_trunc('week', now());\n    32\t    part record;\n    33\tBEGIN\n    34\t    FOR i IN 0..ahead LOOP\n    35\t        EXECUTE format('CREATE TABLE IF NOT EXISTS %s_%s PARTITION OF %s FOR VALUES FROM (%L) TO (%L)',\n    36\t                       parent, to_char(start_ts + i * period, 'IYYY\"w\"IW'), parent,\n    37\t                       start_ts + i * period, start_ts + (i + 1) * period);\n    38\t    END LOOP;\n    39\t    FOR part IN\n    40\t        SELECT c.oid::regclass AS rel FROM pg_inherits i JOIN pg_class c ON c.oid = i.inhrelid\n    41\t         WHERE i.inhparent = parent ORDER BY c.relname DESC OFFSET keep + ahead + 1\n    42\t    LOOP\n    43\t        EXECUTE format('DROP TABLE %s', part.rel);\n    44\t    END LOOP;\n    45\tEND $$;\n    46\t\n    47\tCREATE TABLE control.stop_flags (\n    48\t    flag_id bigserial PRIMARY KEY,\n    49\t    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n    50\t    value text, active boolean NOT NULL DEFAULT true, reason text NOT NULL,\n    51\t    set_by text NOT NULL DEFAULT current_user, set_at timestamptz NOT NULL DEFAULT now()\n    52\t);\n    53\t\n    54\tCREATE TABLE approvals.grants (\n    55\t    approval_id uuid PRIMARY KEY, run_id uuid NOT NULL, agent_instance_id text NOT NULL, subject text NOT NULL,\n    56\t    operation text NOT NULL, target text NOT NULL, args_sha256 char(64) NOT NULL, args jsonb NOT NULL,\n    57\t    tool_use_id text NOT NULL, description text NOT NULL,\n    58\t    requested_at timestamptz NOT NULL, expires_at timestamptz NOT NULL,\n    59\t    approved_by text, approved_at timestamptz, used_at timestamptz\n    60\t);\n    61\t\n    62\tCREATE TABLE quota.usage (\n    63\t    scope text NOT NULL, key text NOT NULL, window_start timestamptz NOT NULL,\n    64\t    runs integer NOT NULL DEFAULT 0, tokens bigint NOT NULL DEFAULT 0, cost_usd numeric(12, 4) NOT NULL DEFAULT 0,\n    65\t    PRIMARY KEY (scope, key, window_start)\n    66\t);\n    67\t\n    68\tCREATE TABLE retrieval.index_state (id int PRIMARY KEY CHECK (id = 1), version text NOT NULL);\n    69\tCREATE TABLE retrieval.chunks (\n    70\t    chunk_id text PRIMARY KEY, doc_id text NOT NULL, source text NOT NULL,\n    71\t    added_at timestamptz NOT NULL DEFAULT now(), added_by text NOT NULL DEFAULT current_user,\n    72\t    trust text NOT NULL CHECK (trust IN ('reviewed', 'hr_authored')),\n    73\t    audience text NOT NULL CHECK (audience IN ('all', 'employee')),\n    74\t    allowed_employees text[] NOT NULL DEFAULT '{}',\n    75\t    expires_at timestamptz, quarantined boolean NOT NULL DEFAULT false, text text NOT NULL,\n    76\t    tsv tsvector GENERATED ALWAYS AS (to_tsvector('english', text)) STORED\n    77\t);\n    78\tCREATE INDEX ON retrieval.chunks USING gin (tsv);\n    79\t\n    80\tGRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\n    81\tGRANT INSERT ON audit.events TO hr_agent;\n    82\tGRANT SELECT ON control.stop_flags TO hr_agent;\n    83\tGRANT SELECT, INSERT ON approvals.grants TO hr_agent;\n    84\tGRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\n    85\tGRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\n    86\tGRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n    87\t\n    88\tGRANT USAGE ON SCHEMA audit, control TO hr_gateway;\n    89\tGRANT INSERT ON audit.gateway_decisions TO hr_gateway;\n    90\tGRANT SELECT ON control.stop_flags TO hr_gateway;\n    91\t\n    92\tGRANT USAGE ON SCHEMA control TO hr_agent_operator;\n    93\tGRANT SELECT, INSERT, UPDATE ON control.stop_flags TO hr_agent_operator;\n    94\tGRANT USAGE ON SEQUENCE control.stop_flags_flag_id_seq TO hr_agent_operator;\n    95\t\n    96\tGRANT USAGE ON SCHEMA audit TO hr_audit_reader, hr_audit_maint;\n    97\tGRANT SELECT ON ALL TABLES IN SCHEMA audit TO hr_audit_reader;\n    98\tREVOKE EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) FROM PUBLIC;\n    99\tGRANT EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) TO hr_audit_maint;\n   100\t\n   101\tGRANT USAGE ON SCHEMA retrieval TO hr_docs_ingest;\n   102\tGRANT SELECT, INSERT, UPDATE ON retrieval.chunks, retrieval.index_state TO hr_docs_ingest;\nsrc/agent.py:40:    subagents_started: int = 0\nsrc/budgets.py:66:    def check_subagent(self, started_so_far: int) -> None:\nsrc/budgets.py:67:        if started_so_far >= self.cfg[\"max_subagents\"]:\nsrc/budgets.py:68:            raise BudgetExceeded(\"max_subagents\")\nconfig/agent.yaml:23:    max_subagents: 0","is_error":false}]},"parent_tool_use_id":null,"session_id":"8d82a645-8c23-4f20-8807-403197c900cd","uuid":"339554f5-0887-4a7c-9b84-09189d1f275c","timestamp":"2026-11-21T11:26:22.617Z","tool_use_result":{"stdout":"     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport logging\n     6\timport os\n     7\timport uuid\n     8\t\n     9\timport asyncpg\n    10\timport httpx\n    11\timport jwt\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n    15\tfrom opentelemetry.sdk.resources import Resource\n    16\tfrom opentelemetry.sdk.trace import TracerProvider\n    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n    18\tfrom starlette.applications import Starlette\n    19\tfrom starlette.requests import Request\n    20\tfrom starlette.responses import JSONResponse\n    21\tfrom starlette.routing import Route\n    22\t\n    23\tfrom . import type_id\n    24\tfrom .agent import Agent, RunState\n    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n    27\tfrom .budgets import BudgetExceeded, QuotaStore\n    28\tfrom .credentials import CredentialBroker\n    29\tfrom .gateway_client import GatewayClient\n    30\tfrom .killswitch import Stopped, StopControl\n    31\tfrom .redact import RedactingFilter\n    32\tfrom .retrieval import PolicyIndex\n    33\tfrom .tools import ToolRegistry, load_yaml\n    34\tfrom .validation import sanitize_reply\n    35\t\n    36\tSSO_ISSUER = \"https://sso.acme.example\"\n    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    39\t\n    40\tlogging.basicConfig(level=logging.INFO)\n    41\tfor h in logging.getLogger().handlers:\n    42\t    h.addFilter(RedactingFilter())\n    43\tlog = logging.getLogger(\"hr_agent\")\n    44\t\n    45\tCFG = load_yaml(\"agent.yaml\")\n    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n    47\tPOD_ID = os.environ[\"POD_UID\"]\n    48\t\n    49\tprovider = TracerProvider(resource=Resource.create({\n    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n    51\t}))\n    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n    53\ttrace.set_tracer_provider(provider)\n    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n    55\t\n    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n    57\tagent: Agent\n    58\taudit: AuditWriter\n    59\tapprovals: ApprovalStore\n    60\tstop: StopControl\n    61\t\n    62\t\n    63\tdef _employee(request: Request) -> tuple[str, str]:\n    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n    65\t    auth = request.headers.get(\"authorization\", \"\")\n    66\t    if not auth.startswith(\"Bearer \"):\n    67\t        raise PermissionError(\"missing token\")\n    68\t    token = auth[7:]\n    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n    72\t        raise PermissionError(\"wrong organisation\")\n    73\t    return claims[\"employee_id\"], token\n    74\t\n    75\t\n    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n    77\t    a = CFG[\"agent\"]\n    78\t    return RunContext(\n    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n    81\t        agent_principal=a[\"workload_identity\"],\n    82\t    )\n    83\t\n    84\t\n    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n    86\t    task = asyncio.ensure_future(coro)\n    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n    88\t    try:\n    89\t        return await task\n    90\t    except asyncio.CancelledError:\n    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n    92\t        return None\n    93\t    except Stopped as exc:\n    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n    95\t        return None\n    96\t    finally:\n    97\t        watcher.cancel()\n    98\t\n    99\t\n   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n   101\t    if state is None:\n   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n   105\t    if state.pending_approval:\n   106\t        body[\"approval\"] = state.pending_approval\n   107\t    return JSONResponse(body)\n   108\t\n   109\t\n   110\tasync def chat(request: Request) -> JSONResponse:\n   111\t    try:\n   112\t        employee_id, token = _employee(request)\n   113\t    except (jwt.PyJWTError, PermissionError):\n   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n   116\t    run_id = str(uuid.uuid4())\n   117\t    ctx = _context(run_id, employee_id)\n   118\t    with tracer.start_as_current_span(\"chat\"):\n   119\t        try:\n   120\t            await agent.quotas.reserve_run(ctx)\n   121\t            state = agent.new_state(text, token)\n   122\t            _runs[run_id] = (ctx, state)\n   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n   124\t            state = await _drive(ctx, agent.run(ctx, state))\n   125\t        except BudgetExceeded as exc:\n   126\t            await audit.record(ctx, \"quota_denied\", decision=\"deny\", reason=exc.limit)\n   127\t            return JSONResponse({\"error\": \"quota_exceeded\"}, status_code=429)\n   128\t        except AuditUnavailable:\n   129\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   130\t        except Exception as exc:\n   131\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__)\n   132\t            raise\n   133\t        return _reply(run_id, state)\n   134\t\n   135\t\n   136\tasync def confirm(request: Request) -> JSONResponse:\n   137\t    try:\n   138\t        employee_id, token = _employee(request)\n   139\t    except (jwt.PyJWTError, PermissionError):\n   140\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   141\t    run_id, approval_id = request.path_params[\"run_id\"], request.path_params[\"approval_id\"]\n   142\t    entry = _runs.get(run_id)\n   143\t    if entry is None or entry[0].subject != employee_id:\n   144\t        return JSONResponse({\"error\": \"not_found\"}, status_code=404)\n   145\t    ctx, state = entry\n   146\t    state.subject_token = token\n   147\t    with tracer.start_as_current_span(\"approval.confirm\"):\n   148\t        try:\n   149\t            await approvals.confirm(approval_id, employee_id)\n   150\t            await audit.record(ctx, \"approval_granted\", decision=\"allow\", approval_id=approval_id)\n   151\t            state = await _drive(ctx, agent.resume_with_approval(ctx, state, approval_id))\n   152\t        except ApprovalInvalid as exc:\n   153\t            await audit.record(ctx, \"approval_rejected\", decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   154\t            return JSONResponse({\"error\": \"approval_invalid\"}, status_code=409)\n   155\t        except AuditUnavailable:\n   156\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   157\t        except Exception as exc:\n   158\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__, approval_id=approval_id)\n   159\t            raise\n   160\t        return _reply(run_id, state)\n   161\t\n   162\t\n   163\tasync def startup() -> None:\n   164\t    global agent, audit, approvals, stop\n   165\t    pool = await asyncpg.create_pool(os.environ[\"DATABASE_URL\"], min_size=2, max_size=20)\n   166\t    registry = ToolRegistry.from_config()\n   167\t    mtls = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\", cert=(\"/etc/svid/svid.pem\", \"/etc/svid/svid_key.pem\"))\n   168\t    audit = AuditWriter(pool, registry.policy_version)\n   169\t    approvals = ApprovalStore(pool, CFG[\"approvals\"][\"ttl_seconds\"])\n   170\t    stop = StopControl(pool, CFG[\"stop\"][\"poll_seconds\"])\n   171\t    agent = Agent(\n   172\t        CFG, registry, AsyncAnthropic(max_retries=1), GatewayClient(mtls, CredentialBroker(mtls)),\n   173\t        PolicyIndex(pool, CFG[\"retrieval\"][\"top_k\"], CFG[\"retrieval\"][\"cache_ttl_seconds\"]),\n   174\t        approvals, QuotaStore(pool, CFG[\"budgets\"][\"quotas\"]), audit, stop,\n   175\t    )\n   176\t\n   177\t\n   178\tapp = Starlette(\n   179\t    routes=[\n   180\t        Route(\"/v1/chat\", chat, methods=[\"POST\"]),\n   181\t        Route(\"/v1/runs/{run_id}/approvals/{approval_id}/confirm\", confirm, methods=[\"POST\"]),\n   182\t    ],\n   183\t    on_startup=[startup],\n   184\t)\n     1\tagent:\n     2\t  name: hr-helpdesk\n     3\t  accountable_party: \"VP People Operations <people-ops-lead@acme.example>\"\n     4\t  operational_owner: \"people-platform (pager: people-platform-oncall)\"\n     5\t  tenant: acme\n     6\t  workload_identity: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n     7\t\n     8\tmodel:\n     9\t  provider: anthropic\n    10\t  id: claude-sonnet-4-5-20250929\n    11\t  pinning: snapshot          # dated snapshot ID per provider model docs, checked 2026-09-15\n    12\t  adapter: none\n    13\t  max_output_tokens: 1024\n    14\t  temperature: 0.2\n    15\t\n    16\tbudgets:\n    17\t  run:\n    18\t    max_steps: 12\n    19\t    max_wall_seconds: 90\n    20\t    max_total_tokens: 60000\n    21\t    max_cost_usd: 0.40\n    22\t    max_tool_calls_per_minute: 20\n    23\t    max_subagents: 0\n    24\t  quotas:\n    25\t    - scope: user\n    26\t      window_seconds: 86400\n    27\t      max_runs: 150\n    28\t      max_tokens: 400000\n    29\t      max_cost_usd: 3.00\n    30\t    - scope: tenant\n    31\t      window_seconds: 3600\n    32\t      max_runs: 20000\n    33\t      max_tokens: 15000000\n    34\t      max_cost_usd: 250.00\n    35\t    - scope: fleet\n    36\t      window_seconds: 3600\n    37\t      max_runs: 25000\n    38\t      max_tokens: 20000000\n    39\t      max_cost_usd: 300.00\n    40\t\n    41\tpricing:\n    42\t  input_per_mtok: 3.00\n    43\t  output_per_mtok: 15.00\n    44\t  cache_read_per_mtok: 0.30\n    45\t\n    46\tapprovals:\n    47\t  ttl_seconds: 600\n    48\t\n    49\tstop:\n    50\t  poll_seconds: 2\n    51\t  max_stop_seconds: 10\n    52\t\n    53\tretrieval:\n    54\t  top_k: 5\n    55\t  cache_ttl_seconds: 900\n    56\t  max_chunk_chars: 4000\n    57\t\n    58\tlimits:\n    59\t  max_tool_output_bytes: 16384\n    60\t  max_user_message_chars: 4000\n    61\t\n    62\toutput:\n    63\t  allowed_link_hosts: [hr.acme.example, handbook.acme.example]\n     1\t-- Roles (created by the platform team): hr_agent, hr_gateway, hr_agent_operator,\n     2\t-- hr_audit_reader, hr_audit_maint, hr_docs_ingest.\n     3\tCREATE SCHEMA audit; CREATE SCHEMA control; CREATE SCHEMA approvals; CREATE SCHEMA quota; CREATE SCHEMA retrieval;\n     4\t\n     5\tCREATE TABLE audit.events (\n     6\t    event_id uuid NOT NULL, ts timestamptz NOT NULL, event_type text NOT NULL,\n     7\t    run_id uuid NOT NULL, step_id uuid, parent_step_id uuid,\n     8\t    accountable_party text NOT NULL, operational_owner text NOT NULL, tenant text NOT NULL,\n     9\t    agent_type_id text NOT NULL, agent_instance_id text NOT NULL,\n    10\t    trace_id char(32) NOT NULL, span_id char(16) NOT NULL, traceparent text NOT NULL,\n    11\t    delegated_subject text NOT NULL, agent_principal text NOT NULL,\n    12\t    tool text, operation_target text, decision text, reason text, policy_version text NOT NULL, approval_id uuid,\n    13\t    args_redacted jsonb, result_redacted jsonb,\n    14\t    context_tokens integer, context_tokens_method text, model_requested text, model_served text,\n    15\t    PRIMARY KEY (event_id, ts)\n    16\t) PARTITION BY RANGE (ts);\n    17\tCREATE INDEX ON audit.events (trace_id);\n    18\tCREATE INDEX ON audit.events (run_id, ts);\n    19\t\n    20\tCREATE TABLE audit.gateway_decisions (\n    21\t    ts timestamptz NOT NULL, traceparent text NOT NULL, tenant text NOT NULL,\n    22\t    accountable_party text NOT NULL, operational_owner text NOT NULL,\n    23\t    agent_type_id_hint text NOT NULL, agent_instance_hint text NOT NULL,   -- caller-supplied; join key only\n    24\t    subject text, actor text, tool text, decision text NOT NULL, reason text, policy_version text NOT NULL\n    25\t) PARTITION BY RANGE (ts);\n    26\t\n    27\t-- Creates `ahead` partitions into the future and drops partitions older than the newest `keep`.\n    28\tCREATE FUNCTION audit.maintain_partitions(parent regclass, period interval, ahead int, keep int)\n    29\tRETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = audit, pg_temp AS $$\n    30\tDECLARE\n    31\t    start_ts timestamptz := date_trunc('week', now());\n    32\t    part record;\n    33\tBEGIN\n    34\t    FOR i IN 0..ahead LOOP\n    35\t        EXECUTE format('CREATE TABLE IF NOT EXISTS %s_%s PARTITION OF %s FOR VALUES FROM (%L) TO (%L)',\n    36\t                       parent, to_char(start_ts + i * period, 'IYYY\"w\"IW'), parent,\n    37\t                       start_ts + i * period, start_ts + (i + 1) * period);\n    38\t    END LOOP;\n    39\t    FOR part IN\n    40\t        SELECT c.oid::regclass AS rel FROM pg_inherits i JOIN pg_class c ON c.oid = i.inhrelid\n    41\t         WHERE i.inhparent = parent ORDER BY c.relname DESC OFFSET keep + ahead + 1\n    42\t    LOOP\n    43\t        EXECUTE format('DROP TABLE %s', part.rel);\n    44\t    END LOOP;\n    45\tEND $$;\n    46\t\n    47\tCREATE TABLE control.stop_flags (\n    48\t    flag_id bigserial PRIMARY KEY,\n    49\t    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n    50\t    value text, active boolean NOT NULL DEFAULT true, reason text NOT NULL,\n    51\t    set_by text NOT NULL DEFAULT current_user, set_at timestamptz NOT NULL DEFAULT now()\n    52\t);\n    53\t\n    54\tCREATE TABLE approvals.grants (\n    55\t    approval_id uuid PRIMARY KEY, run_id uuid NOT NULL, agent_instance_id text NOT NULL, subject text NOT NULL,\n    56\t    operation text NOT NULL, target text NOT NULL, args_sha256 char(64) NOT NULL, args jsonb NOT NULL,\n    57\t    tool_use_id text NOT NULL, description text NOT NULL,\n    58\t    requested_at timestamptz NOT NULL, expires_at timestamptz NOT NULL,\n    59\t    approved_by text, approved_at timestamptz, used_at timestamptz\n    60\t);\n    61\t\n    62\tCREATE TABLE quota.usage (\n    63\t    scope text NOT NULL, key text NOT NULL, window_start timestamptz NOT NULL,\n    64\t    runs integer NOT NULL DEFAULT 0, tokens bigint NOT NULL DEFAULT 0, cost_usd numeric(12, 4) NOT NULL DEFAULT 0,\n    65\t    PRIMARY KEY (scope, key, window_start)\n    66\t);\n    67\t\n    68\tCREATE TABLE retrieval.index_state (id int PRIMARY KEY CHECK (id = 1), version text NOT NULL);\n    69\tCREATE TABLE retrieval.chunks (\n    70\t    chunk_id text PRIMARY KEY, doc_id text NOT NULL, source text NOT NULL,\n    71\t    added_at timestamptz NOT NULL DEFAULT now(), added_by text NOT NULL DEFAULT current_user,\n    72\t    trust text NOT NULL CHECK (trust IN ('reviewed', 'hr_authored')),\n    73\t    audience text NOT NULL CHECK (audience IN ('all', 'employee')),\n    74\t    allowed_employees text[] NOT NULL DEFAULT '{}',\n    75\t    expires_at timestamptz, quarantined boolean NOT NULL DEFAULT false, text text NOT NULL,\n    76\t    tsv tsvector GENERATED ALWAYS AS (to_tsvector('english', text)) STORED\n    77\t);\n    78\tCREATE INDEX ON retrieval.chunks USING gin (tsv);\n    79\t\n    80\tGRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\n    81\tGRANT INSERT ON audit.events TO hr_agent;\n    82\tGRANT SELECT ON control.stop_flags TO hr_agent;\n    83\tGRANT SELECT, INSERT ON approvals.grants TO hr_agent;\n    84\tGRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\n    85\tGRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\n    86\tGRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n    87\t\n    88\tGRANT USAGE ON SCHEMA audit, control TO hr_gateway;\n    89\tGRANT INSERT ON audit.gateway_decisions TO hr_gateway;\n    90\tGRANT SELECT ON control.stop_flags TO hr_gateway;\n    91\t\n    92\tGRANT USAGE ON SCHEMA control TO hr_agent_operator;\n    93\tGRANT SELECT, INSERT, UPDATE ON control.stop_flags TO hr_agent_operator;\n    94\tGRANT USAGE ON SEQUENCE control.stop_flags_flag_id_seq TO hr_agent_operator;\n    95\t\n    96\tGRANT USAGE ON SCHEMA audit TO hr_audit_reader, hr_audit_maint;\n    97\tGRANT SELECT ON ALL TABLES IN SCHEMA audit TO hr_audit_reader;\n    98\tREVOKE EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) FROM PUBLIC;\n    99\tGRANT EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) TO hr_audit_maint;\n   100\t\n   101\tGRANT USAGE ON SCHEMA retrieval TO hr_docs_ingest;\n   102\tGRANT SELECT, INSERT, UPDATE ON retrieval.chunks, retrieval.index_state TO hr_docs_ingest;\nsrc/agent.py:40:    subagents_started: int = 0\nsrc/budgets.py:66:    def check_subagent(self, started_so_far: int) -> None:\nsrc/budgets.py:67:        if started_so_far >= self.cfg[\"max_subagents\"]:\nsrc/budgets.py:68:            raise BudgetExceeded(\"max_subagents\")\nconfig/agent.yaml:23:    max_subagents: 0","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_018tMtjoap5t1Sg2FXNaLFMN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
