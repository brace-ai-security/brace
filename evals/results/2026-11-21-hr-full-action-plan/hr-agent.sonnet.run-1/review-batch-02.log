5e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    25\t        with: {python-version: \"3.12.7\"}\n    26\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    27\t        with: {cosign-release: \"v2.6.2\"}\n    28\t      - run: pip install --require-hashes -r requirements.txt\n    29\t      - run: python -m pytest -q tests/release\n    30\t      - name: Build and push\n    31\t        id: build\n    32\t        uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    33\t        with:\n    34\t          push: true\n    35\t          tags: ${{ env.IMAGE }}:${{ github.sha }}\n    36\t          sbom: true\n    37\t          provenance: mode=max\n    38\t      - name: Sign image\n    39\t        run: cosign sign --yes \"${IMAGE}@${{ steps.build.outputs.digest }}\"\n    40\t      - uses: actions/attest-build-provenance@e8998f949152b193b063cb0ec769d69d929409be # v2.4.0\n    41\t        with:\n    42\t          subject-name: ${{ env.IMAGE }}\n    43\t          subject-digest: ${{ steps.build.outputs.digest }}\n    44\t          push-to-registry: true\n    45\t      - name: Compute agent-type-id\n    46\t        id: typeid\n    47\t        run: |\n    48\t          python -m src.type_id \"${{ steps.build.outputs.digest }}\" > type-id.json\n    49\t          echo \"id=$(jq -r .agent_type_id type-id.json)\" >> \"$GITHUB_OUTPUT\"\n    50\t      - name: Stamp release manifest\n    51\t        run: |\n    52\t          yq -i '.release.agent_type_id = \"${{ steps.typeid.outputs.id }}\" |\n    53\t                 .release.image.digest = \"${{ steps.build.outputs.digest }}\" |\n    54\t                 .release.git_sha = \"${{ github.sha }}\"' release/manifest.yaml\n    55\t      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\n    56\t        with:\n    57\t          name: release-${{ github.sha }}\n    58\t          path: [type-id.json, release/manifest.yaml]\n    59\t\n    60\t  deploy:\n    61\t    needs: build\n    62\t    runs-on: ubuntu-24.04\n    63\t    environment: production\n    64\t    permissions: {contents: read, id-token: write}\n    65\t    steps:\n    66\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    67\t      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0\n    68\t        with: {name: \"release-${{ github.sha }}\"}\n    69\t      - name: Render and apply\n    70\t        run: |\n    71\t          export IMAGE_DIGEST=$(yq -r .release.image.digest release/manifest.yaml)\n    72\t          export AGENT_TYPE_ID=$(yq -r .release.agent_type_id release/manifest.yaml)\n    73\t          export GIT_SHA=${{ github.sha }}\n    74\t          for f in k8s/*.yaml; do envsubst '$IMAGE_DIGEST $AGENT_TYPE_ID $GIT_SHA' < \"$f\"; echo '---'; done \\\n    75\t            | kubectl apply --server-side -f -\n     1\t*                         @acme/people-platform\n     2\t/prompts/                 @acme/people-platform @acme/hr-policy-reviewers\n     3\t/config/                  @acme/people-platform @acme/security-engineering\n     4\t/src/gateway.py           @acme/people-platform @acme/security-engineering\n     5\t/src/approvals.py         @acme/people-platform @acme/security-engineering\n     6\t/k8s/                     @acme/people-platform @acme/platform-security\n     7\t/migrations/              @acme/people-platform @acme/data-platform\n     8\t/release/                 @acme/people-platform @acme/security-engineering\n     9\t/.github/                 @acme/platform-security\n    10\t/CODEOWNERS               @acme/platform-security\n  - *How to verify:* 1) Find admission policies (Kyverno `verifyImages`, `ClusterImagePolicy`, Gatekeeper). 2) Check the key or certificate identity and issuer are pinned. 3) Answer no if identity or issuer uses `.*` or wildcard regex, issuer is unset, or no admission policy exists. Answer unknown if admission config is outside this repo.\n- **B10.3** The policy checks provenance fields: builder, source repository, build type, and external parameters.\n  - *How to verify:* 1) In the admission policy, find attestation or provenance conditions. 2) Check builder ID, source repository, build type, and `externalParameters` are each compared to expected values. 3) Answer no if any is missing, provenance is only generated in CI but not verified, or conditions use wildcards.\n- **B10.4** The policy is in enforce mode, covers production namespaces, and denies images that match no policy.\n  - *How to verify:* 1) Read the policy mode and scope (`validationFailureAction`, `failureAction`, `mode`, namespace selectors, exclusions). 2) Check for a no-match deny. 3) Answer no if mode is `Audit` or `warn`, production namespaces are excluded or unmatched, `failurePolicy: Ignore`, or images matching no policy are allowed.\n- **B10.5** The pinned Cosign or verifier version is at least 2.6.2 (2.x) or 3.0.4 (3.x).\n  - *How to verify:* 1) Find Cosign or verifier versions in CI workflows (`cosign-installer`, `cosign-release`), Dockerfiles, and policy-controller charts. 2) Compare to 2.6.2 (2.x) and 3.0.4 (3.x). 3) Answer no if any pin is lower or uses `latest` or no version. Answer unknown if no verifier is in this repo.\n\n### Not covered here\n\nFile these problems under their owning item, not this one, unless this item's own requirement is also broken:\n\n- Tool or MCP server package not vetted or pinned → **E02**\n- Model weights or adapters loaded without a signature or format check → **C05**\n- Image runs as root or includes a shell or package manager → **B11**\n- Secrets baked into the image → **B03**\n\n### Heuristics\n\n**Provable from code:** partly\n\n**Look for:**\n- Images referenced by digest (`image@sha256:...`) in deploy manifests, not by tag alone.\n- Signing in CI (for example `cosign sign` with keyless OIDC or a managed key) and SBOM plus SLSA provenance attestation.\n- An admission policy that verifies signature and provenance, for example Kyverno `verifyImages` or Sigstore policy-controller `ClusterImagePolicy`, naming the approved key or certificate identity and issuer.\n- Provenance checks on builder, source repo, build type, and `externalParameters`.\n- Policy set to enforce (`validationFailureAction: Enforce` / `failureAction: Enforce`), scoped to production namespaces, and denying images that match no policy.\n\n**Red flags:**\n- Image tag `:latest` or any mutable tag without digest.\n- Kyverno or policy-controller policy in `Audit` mode, or excluding the production namespace.\n- Signature check with no pinned identity, for example a `--certificate-identity-regexp '.*'` or any-issuer rule.\n- Cosign pinned below 2.6.2 (2.x) or 3.0.4 (3.x) in CI or the verifier.\n- No provenance or SBOM produced by the build.\n\n**Where to look:**\n- Kubernetes Deployment/StatefulSet manifests and Helm values (image fields)\n- CI workflows (.github/workflows, .gitlab-ci.yml) for build, sign, attest steps\n- Kyverno ClusterPolicy, Sigstore ClusterImagePolicy, Gatekeeper constraints\n\n**Needs runtime evidence:** That the cluster actually runs the policy in enforce mode and rejects unsigned, wrongly signed, and wrong-provenance images, and that the running digest matches the signed build. Recipe B10.\nB06.1 none\nB06.2 none\nB06.3 none\nB06.4 none\nB06.5 none\nB07.1 none\nB07.2 none\nB07.3 none\nB07.4 none\nB08.1 none\nB08.2 none\nB08.3 none\nB09.1 none\nB09.2 none\nB09.3 none\nB09.4 none\nB09.5 none\nB10.1 none\nB10.2 none\nB10.3 none\nB10.4 none\nB10.5 none","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01SZxcQFvz3Pd7gYQWcap2f5","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
