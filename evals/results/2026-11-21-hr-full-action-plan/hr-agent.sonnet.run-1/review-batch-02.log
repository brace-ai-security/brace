ge.output_tokens\n    49\t        cost = (\n    50\t            (usage.input_tokens + cache_write) * self.pricing[\"input_per_mtok\"]\n    51\t            + cache_read * self.pricing[\"cache_read_per_mtok\"]\n    52\t            + usage.output_tokens * self.pricing[\"output_per_mtok\"]\n    53\t        ) / 1_000_000\n    54\t        self.tokens += tokens\n    55\t        self.cost_usd += cost\n    56\t        return tokens, cost\n    57\t\n    58\t    def check_tool_call(self) -> None:\n    59\t        now = time.monotonic()\n    60\t        while self.tool_calls and now - self.tool_calls[0] > 60:\n    61\t            self.tool_calls.popleft()\n    62\t        if len(self.tool_calls) >= self.cfg[\"max_tool_calls_per_minute\"]:\n    63\t            raise BudgetExceeded(\"max_tool_calls_per_minute\")\n    64\t        self.tool_calls.append(now)\n    65\t\n    66\t    def check_subagent(self, started_so_far: int) -> None:\n    67\t        if started_so_far >= self.cfg[\"max_subagents\"]:\n    68\t            raise BudgetExceeded(\"max_subagents\")\n    69\t\n    70\t\n    71\t_WINDOW = \"to_timestamp(floor(extract(epoch FROM now()) / $3) * $3)\"\n    72\t\n    73\t_RESERVE_RUN = f\"\"\"\n    74\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    75\tVALUES ($1, $2, {_WINDOW}, 1, 0, 0)\n    76\tON CONFLICT (scope, key, window_start) DO UPDATE\n    77\t   SET runs = quota.usage.runs + 1\n    78\t WHERE quota.usage.runs + 1 <= $4\n    79\t   AND quota.usage.tokens < $5\n    80\t   AND quota.usage.cost_usd < $6\n    81\tRETURNING runs\n    82\t\"\"\"\n    83\t\n    84\t_RECORD_USAGE = f\"\"\"\n    85\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    86\tVALUES ($1, $2, {_WINDOW}, 0, $4, $5)\n    87\tON CONFLICT (scope, key, window_start) DO UPDATE\n    88\t   SET tokens = quota.usage.tokens + EXCLUDED.tokens,\n    89\t       cost_usd = quota.usage.cost_usd + EXCLUDED.cost_usd\n    90\tRETURNING tokens, cost_usd\n    91\t\"\"\"\n    92\t\n    93\t\n    94\tclass QuotaStore:\n    95\t    \"\"\"Per-user, per-tenant and fleet-wide quotas, shared by every replica.\"\"\"\n    96\t\n    97\t    def __init__(self, pool: asyncpg.Pool, quotas: list[dict[str, Any]]):\n    98\t        self._pool = pool\n    99\t        self._quotas = quotas\n   100\t\n   101\t    def _key(self, scope: str, ctx: RunContext) -> str:\n   102\t        return {\"user\": ctx.subject, \"tenant\": ctx.tenant, \"fleet\": \"all\"}[scope]\n   103\t\n   104\t    async def reserve_run(self, ctx: RunContext) -> None:\n   105\t        async with self._pool.acquire() as conn, conn.transaction():\n   106\t            for q in self._quotas:\n   107\t                row = await conn.fetchrow(\n   108\t                    _RESERVE_RUN, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"],\n   109\t                    q[\"max_runs\"], q[\"max_tokens\"], q[\"max_cost_usd\"],\n   110\t                )\n   111\t                if row is None:\n   112\t                    raise BudgetExceeded(f\"quota:{q['scope']}\")\n   113\t\n   114\t    async def record_usage(self, ctx: RunContext, tokens: int, cost_usd: float) -> None:\n   115\t        \"\"\"Usage already spent is always recorded; the run stops once any window is over its limit.\"\"\"\n   116\t        exceeded: str | None = None\n   117\t        async with self._pool.acquire() as conn, conn.transaction():\n   118\t            for q in self._quotas:\n   119\t                row = await conn.fetchrow(\n   120\t                    _RECORD_USAGE, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"], tokens, cost_usd\n   121\t                )\n   122\t                if row[\"tokens\"] >= q[\"max_tokens\"] or row[\"cost_usd\"] >= q[\"max_cost_usd\"]:\n   123\t                    exceeded = exceeded or f\"quota:{q['scope']}\"\n   124\t        if exceeded:\n   125\t            raise BudgetExceeded(exceeded)","stderr":"","interrupted":false,"isImage":fal