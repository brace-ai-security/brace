able\",\"config/agent.yaml:63\",\"allowed_link_hosts: [hr.acme.example, handbook.acme.example]\",\"Output link filter only; not used for isolation.\")])\nrun(S+\"answer.py\",F,\"--repo\",REPO,\"item\",\"B08\",\"--rating\",\"likely_pass\",\"--confidence\",\"medium\",\"--summary\",\"Default-deny Cilium policy with named peers, metadata denies and restricted pods isolates the agent in infrastructure.\",\"--next\",\"Collect live policy exports and probe results from the cluster (Recipe B08).\")\n# ---- B09\ncheck(\"B09.1\",\"yes\",f\"{K}:33\",\"- matchName: api.anthropic.com\",\"Outbound traffic is default-deny with named FQDN and endpoint allows.\",\n counter=\"Searched for toEntities world, 0.0.0.0/0 and wildcard FQDNs: only the cluster-local DNS pattern at networkpolicy.yaml:31, which is not a destination allow.\",\n rows=[row(\"default deny\",\"enforced\",f\"{K}:8\",\"policyTypes: [Ingress, Egress]\",\"All egress denied unless allowed.\"),\n  row(\"internet destinations\",\"enforced\",f\"{K}:34\",\"- matchName: sso.acme.example\",\"Only two FQDNs on TCP 443.\"),\n  row(\"DNS\",\"enforced\",f\"{K}:29\",\"- matchName: api.anthropic.com\",\"DNS answers restricted to the listed names.\"),\n  row(\"gateway pod\",\"enforced\",f\"{K}:75\",'- matchPattern: \"*.svc.cluster.local\"',\"Gateway has no internet egress.\")])\ncheck(\"B09.2\",\"yes\",f\"{K}:8\",\"policyTypes: [Ingress, Egress]\",\"There is no proxy to bypass; the network policy itself is default-deny for both address families, and no proxy env vars are set.\",\n counter=\"Searched deployment env for HTTP_PROXY/NO_PROXY: none. The agent-to-helpdesk-MCP route (networkpolicy.yaml:48) goes around the tool gateway; that internal route belongs to E06.\",\n rows=[row(\"proxy by env only\",\"not_applicable\",f\"{D}:46\",\"env:\",\"No proxy variables are set; enforcement is by policy.\"),\n  row(\"IPv4 egress\",\"enforced\",f\"{K}:8\",\"policyTypes: [Ingress, Egress]\",\"Applies to all pod traffic.\"),\n  row(\"IPv6 egress\",\"enforced\",f\"{K}:54\",\"- cidr: fd00:ec2::254/128\",\"IPv6 covered by the same default deny plus explicit metadata deny.\")])\ncheck(\"B09.3\",\"unknown\",f\"{K}:51\",\"egressDeny:\",\"No app-level redirect or resolved-IP checks exist; FQDN policy and metadata denies are in Cilium but loopback is not listed and live behaviour cannot be seen from the repo. Clients call fixed URLs (gateway_client.py:17, tools.yaml:5) with no model-supplied URL.\")\ncheck(\"B09.4\",\"unknown\",f\"{K}:33\",\"- matchName: api.anthropic.com\",\"api.anthropic.com is a shared multi-tenant service allowed by domain only; Cilium FQDN rules cannot limit account or path. Need evidence of an organisation-level or proxy restriction.\")\ncheck(\"B09.5\",\"unknown\",\"\",\"\",\"No block logging or alert route appears in the repo (no Hubble or alert config); it would live in the platform team's observability. Looked in k8s/ and config/.\")\nrun(S+\"answer.py\",F,\"--repo\",REPO,\"item\",\"B09\",\"--rating\",\"needs_evidence\",\"--confidence\",\"medium\",\"--summary\",\"Egress is default-deny with a named FQDN allowlist, but redirect and loopback handling, shared-service limits and block alerts are not shown in the repo.\",\"--next\",\"Get Hubble deny logs, the alert route naming an operator, and bypass test results for redirects, IPv6 and loopback.\")\n# ---- B10\ncheck(\"B10.1\",\"yes\",f\"{D}:43\",\"image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\",\"Every runtime and base image is referenced by digest; an empty digest would yield an invalid reference, not a tag.\",\n counter=\"Searched all image: and FROM lines for tags without digest: none.\",\n rows=[row(\"agent image\",\"enforced\",f\"{D}:43\",\"hr-helpdesk-agent@${IMAGE_DIGEST}\",\"Digest from the CI-stamped manifest.\"),\n  row(\"gateway image\",\"enforced\",f\"{D}:103\",\"hr-helpdesk-agent@${IMAGE_DIGEST}\",\"Same digest-only form.\"),\n  row(\"maintenance job image\",\"enforced\",\"k8s/audit-maintenance.yaml:26\",\"psql@sha256:9b2e61c04d7f3a85\",\"Literal digest.\"),\n  row(\"Dockerfile build base\",\"enforced\",\"Dockerfile:2\",\"@sha256:032c52613401895a\",\"Digest pinned.\"),\n  row(\"Dockerfile runtime base\",\"enforced\",\"Dockerfile:8\",\"@sha256:7e4c1d2a9f3b8e60\",\"Digest pinned.\")])\ncheck(\"B10.2\",\"yes\",f\"{AD}:48\",'subject: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"',\"Keyless verification pins an exact workflow subject and issuer with no regex.\",\n counter=\"Searched admission.yaml for subjectRegExp, issuerRegExp and .*: none.\",\n rows=[row(\"agent image subject\",\"enforced\",f\"{AD}:48\",\"release.yml@refs/heads/main\",\"Exact subject.\"),\n  row(\"agent image issuer\",\"enforced\",f\"{AD}:49\",'issuer: \"https://token.actions.githubusercontent.com\"',\"Exact issuer.\"),\n  row(\"platform image subject\",\"enforced\",f\"{AD}:79\",\"build.yml@refs/heads/main\",\"Exact subject.\"),\n  row(\"platform image issuer\",\"enforced\",f\"{AD}:80\",'issuer: \"https://token.actions.githubusercontent.com\"',\"Exact issuer.\")])\ncheck(\"B10.3\",\"no\",f\"{AD}:72\",'- imageReferences: [\"registry.acme.example/platform/*\"]',\"The platform/* rule (used by the maintenance job image in hr-agent) verifies a signature only and has no attestations block, so builder, source repository, build type and externalParameters are not compared for it.\",\n counter=\"Read both verifyImages entries: the agent image entry has full conditions at admission.yaml:58-71; the platform entry has none.\")\ncheck(\"B10.4\",\"no\",f\"{AD}:35\",'- image: \"registry.acme.example/*@sha256:*\"',\"Enforce and failurePolicy Fail cover hr-agent, but the registry rule accepts any digest-pinned image from registry.acme.example while verifyImages only matches two path prefixes, so an unsigned image from any other path is admitted.\",\n counter=\"Searched for a deny rule for images matching no verifyImages entry: none.\")\ncheck(\"B10.5\",\"unknown\",\"/.github/workflows/release.yml:27\".lstrip('/'),'with: {cosign-release: \"v2.6.2\"}',\"CI pins Cosign 2.6.2, which meets the minimum, but the admission verifier is Kyverno and its Cosign version is not in this repo.\")\nrun(S+\"answer.py\",F,\"--repo\",REPO,\"item\",\"B10\",\"--rating\",\"gap\",\"--confidence\",\"high\",\"--summary\",\"Signing and provenance checks are strong for the agent image, but the admission policy lets unsigned images from other registry paths run and skips provenance for platform images.\",\n \"--next\",\"Add a rule denying any image that no verifyImages entry covers, and add provenance conditions to the platform/* entry in k8s/admission.yaml.\",\"--violates\",\"check its digest and signature against an approved signing key\")\nEOF\ncd .. && /private/tmp/claude-501/-Users-brenn-dev-brace/255658ca-f19b-460c-8892-2a477de97733/scratchpad/venv/bin/python work/b0710.py 2>&1 | cut -c1-400","uuid":"008224c4-3376-48bb-9ece-e07e42521bfe","session_id":"8d82a645-8c23-4f20-8807-403197c900cd"}
