gent.yaml, config/tools.yaml]\n    37\t\n    38\tmodels:\n    39\t  primary:\n    40\t    role: main agent\n    41\t    owner: people-platform\n    42\t    identity: {provider: anthropic, id: claude-sonnet-4-5-20250929, pinning: snapshot, adapter: none}\n    43\t    pinning_source: \"Anthropic models overview, checked 2026-09-15\"\n    44\t    served_version: recorded per call in audit.events.model_served\n    45\t    fine_tune: none\n    46\t    training_runs: not applicable\n    47\t    training_data: provider-undisclosed\n    48\t  helpers: []            # retrieval is Postgres full-text search; no embedding or reranker model\n    49\t\n    50\ttools:\n    51\t  built_in: []\n    52\t  local: [search_policies]\n    53\t  mcp_servers:\n    54\t    - {id: hris, identity: \"spiffe://acme.example/ns/hris/sa/hris-mcp\", owner: hris-platform, tools: [get_leave_balance, file_leave_request]}\n    55\t    - {id: helpdesk, identity: \"spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\", owner: it-service-desk, tools: [create_ticket]}\n    56\t  policy_version_source: config/tools.yaml#policy_version\n    57\t\n    58\tpermissions:\n    59\t  sts_scopes: [hr.policy.read, hris.leave.read, hris.leave.request, helpdesk.ticket.create]\n    60\t  token_ttl_seconds: 300\n    61\t  database_role: hr_agent (see migrations/001_init.sql grants)\n    62\t\n    63\tmemory: none (conversation state is held per run and discarded; no cross-run memory)\n    64\tretrieval:\n    65\t  store: retrieval.chunks (Postgres FTS)\n    66\t  writers: [hr_docs_ingest]\n    67\t  filters: [quarantined, expires_at, audience/allowed_employees]\n    68\t\n    69\tidentity_bindings:\n    70\t  agent: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n    71\t  gateway: spiffe://acme.example/ns/hr-agent/sa/hr-tool-gateway\n    72\t\n    73\tnetwork: [k8s/networkpolicy.yaml]\n    74\tadmission: [k8s/admission.yaml]\n    75\tbudgets: config/agent.yaml#budgets\n    76\t\n    77\taudit:\n    78\t  store: audit.events, audit.gateway_decisions (Postgres, weekly partitions)\n    79\t  retention: 6 months\n    80\t  readers: hr_audit_reader\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: hr-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.31\n     8\t    pod-security.kubernetes.io/warn: restricted\n     9\t    pod-security.kubernetes.io/audit: restricted\n    10\t    istio.io/dataplane-mode: ambient\n    11\t---\n    12\tapiVersion: kyverno.io/v1\n    13\tkind: ClusterPolicy\n    14\tmetadata:\n    15\t  name: hr-agent-verify-images\n    16\t  annotations:\n    17\t    policies.kyverno.io/owner: people-platform\n    18\tspec:\n    19\t  validationFailureAction: Enforce\n    20\t  failurePolicy: Fail\n    21\t  webhookTimeoutSeconds: 15\n    22\t  background: false\n    23\t  rules:\n    24\t    - name: only-approved-registry\n    25\t      match:\n    26\t        any:\n    27\t          - resources: {kinds: [Pod], namespaces: [hr-agent]}\n    28\t      validate:\n    29\t        message: \"Images in hr-agent must come from registry.acme.example and be referenced by digest.\"\n    30\t        pattern:\n    31\t          spec:\n    32\t            =(initContainers):\n    33\t              - image: \"registry.acme.example/*@sha256:*\"\n    34\t            containers:\n    35\t              - image: \"registry.acme.example/*@sha256:*\"\n    36\t    - name: verify-signature-and-provenance\n    37\t      match:\n    38\t        any:\n    39\t          - resources: {kinds: [Pod], namespaces: [hr-agent]}\n    40\t      verifyImages:\n    41\t        - imageReferences: [\"registry.acme.example/people/hr-helpdesk-agent*\"]\n    42\t          mutateDigest: false\n    43\t          verifyDigest: true\n    44\t          required: true\n    45\t          attestors:\n    46\t            - entries:\n    47\t                - keyless:\n    48\t                    subject: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    49\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    50\t                    rekor: {url: \"https://rekor.sigstore.dev\"}\n    51\t          attestations:\n    52\t            - type: https://slsa.dev/provenance/v1\n    53\t              attestors:\n    54\t                - entries:\n    55\t                    - keyless:\n    56\t                        subject: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    57\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    58\t              conditions:\n    59\t                - all:\n    60\t                    - key: \"{{ buildDefinition.buildType }}\"\n    61\t                      operator: Equals\n    62\t                      value: \"https://actions.github.io/buildtypes/workflow/v1\"\n    63\t                    - key: \"{{ buildDefinition.externalParameters.workflow.repository }}\"\n    64\t                      operator: Equals\n    65\t                      value: \"https://github.com/acme/hr-helpdesk-agent\"\n    66\t                    - key: \"{{ buildDefinition.externalParameters.workflow.ref }}\"\n    67\t                      operator: Equals\n    68\t                      value: \"refs/heads/main\"\n    69\t                    - key: \"{{ runDetails.builder.id }}\"\n    70\t                      operator: Equals\n    71\t                      value: \"https://github.com/actions/runner/github-hosted\"\n    72\t        - imageReferences: [\"registry.acme.example/platform/*\"]\n    73\t          mutateDigest: false\n    74\t          verifyDigest: true\n    75\t          required: true\n    76\t          attestors:\n    77\t            - entries:\n    78\t                - keyless:\n    79\t                    subject: \"https://github.com/acme/platform-images/.github/workflows/build.yml@refs/heads/main\"\n    80\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    81\t                    rekor: {url: \"https://rekor.sigstore.dev\"}\n     1\t*                         @acme/people-platform\n     2\t/prompts/                 @acme/people-platform @acme/hr-policy-reviewers\n     3\t/config/                  @acme/people-platform @acme/security-engineering\n     4\t/src/gateway.py           @acme/people-platform @acme/security-engineering\n     5\t/src/approvals.py         @acme/people-platform @acme/security-engineering\n     6\t/k8s/                     @acme/people-platform @acme/platform-security\n     7\t/migrations/              @acme/people-platform @acme/data-platform\n     8\t/release/                 @acme/people-platform @acme/security-engineering\n     9\t/.github/                 @acme/platform-security\n    10\t/CODEOWNERS               @acme/platform-security\n     1\t\"\"\"Handbook search over retrieval.chunks (Postgres full-text search).\n     2\t\n     3\tChunks are written only by the hr-docs-ingest job (role hr_docs_ingest). Each chunk carries\n     4\tsource, added_at, added_by, trust, an audience, an optional expiry and a quarantine flag.\n     5\tEmployee-specific documents (offer letters, individual arrangements) have audience\n     6\t'employee' and list the employees allowed to see them.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport time\n    12\tfrom typing import Any\n    13\t\n    14\timport asyncpg\n    15\t\n    16\t_SEARCH = \"\"\"\n    17\tSELECT c.chunk_id, c.source, c.trust, c.text,\n    18\t       ts_rank(c.tsv, websearch_to_tsquery('english', $1)) AS rank\n    19\t  FROM retrieval.chunks c\n    20\t WHERE c.tsv @@ websearch_to_tsquery('english', $1)\n    21\t   AND NOT c.quarantined\n    22\t   AND (c.expires_at IS NULL OR c.expires_at > now())\n    23\t   AND (c.audience = 'all' OR (c.audience = 'employee' AND $2 = ANY (c.allowed_employees)))\n    24\t ORDER BY rank DESC\n    25\t LIMIT $3\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass PolicyIndex:\n    30\t    def __init__(self, pool: asyncpg.Pool, top_k: int, cache_ttl: float):\n    31\t        self._pool = pool\n    32\t        self._top_k = top_k\n    33\t        self._ttl = cache_ttl\n    34\t        self._cache: dict[str, tuple[float, str, list[dict[str, Any]]]] = {}\n    35\t\n    36\t    async def _index_version(self) -> str:\n    37\t        # Bumped by ingest on every add, expiry, quarantine or permission change.\n    38\t        return await self._pool.fetchval(\"SELECT version FROM retrieval.index_state WHERE id = 1\")\n    39\t\n    40\t    def _key(self, query: str) -> str:\n    41\t        normalized = \" \".join(query.lower().split())\n    42\t        return hashlib.sha256(f\"{self._top_k}|{normalized}\".encode()).hexdigest()\n    43\t\n    44\t    async def search(self, query: str, employee_id: str) -> list[dict[str, Any]]:\n    45\t        version = await self._index_version()\n    46\t        key = self._key(query)\n    47\t        hit = self._cache.get(key)\n    48\t        if hit and hit[1] == version and time.monotonic() - hit[0] < self._ttl:\n    49\t            return hit[2]\n    50\t        rows = await self._pool.fetch(_SEARCH, query, employee_id, self._top_k)\n    51\t        chunks = [dict(r) for r in rows]\n    52\t        self._cache[key] = (time.monotonic(), version, chunks)\n    53\t        return chunks\n(eval):1: no matches found: --include=*\n{\n\"repo\": \"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-49hid7te/agent\",\n\"patterns_file\": \"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-49hid7te/skill/prescan/patterns.yaml\",\n\"files_scanned\": 24,\n\"note\": \"Hits are places to read, not findings. Answer each hit's ask before citing it.\",\n\"capped\": [],\n\"hits\": [\n{\n\"id\": \"H001\",\n\"pattern\": \"P27\",\n\"item\": \"B11\",\n\"title\": \