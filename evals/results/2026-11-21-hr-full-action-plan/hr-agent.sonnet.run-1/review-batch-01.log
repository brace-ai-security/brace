\n \"Grepped src, config and .mcp.json for wildcard grants, bypassPermissions, list_tools() and getattr/eval/globals; none. Only one agent role and entry point (src.main, plus the gateway) exist.\",\n \"One fixed registry of four named tools; the model sees only these.\",\n [R(\"tool:search_policies\",\"enforced\",\"config/tools.yaml:18\",\"search_policies:\",\"named local tool with task reason\"),\n  R(\"tool:get_leave_balance\",\"enforced\",\"config/tools.yaml:30\",\"get_leave_balance:\",\"named MCP tool\"),\n  R(\"tool:file_leave_request\",\"enforced\",\"config/tools.yaml:55\",\"file_leave_request:\",\"named MCP tool\"),\n  R(\"tool:escalate_to_human\",\"enforced\",\"config/tools.yaml:82\",\"escalate_to_human:\",\"named MCP tool\"),\n  R(\"entrypoint:agent\",\"enforced\",\"src/main.py:171\",\"agent = Agent(\",\"only agent construction; registry from config\"),\n  R(\"entrypoint:gateway\",\"enforced\",\"src/gateway.py:46\",\"MCP_TOOLS = [s for s in map(registry.get\",\"gateway uses the same registry\"),\n  R(\"config:.mcp.json\",\"enforced\",\".mcp.json:3\",'\"hr-tool-gateway\": {',\"only server listed is the gateway\")])\nyes(\"B01.2\",\"src/agent.py:72\",\"tools=self.registry.model_schemas()\",\n \"Searched for list_tools/tools/list consumers. Only gateway.py:62 calls tools/list and it uses results only to compare fingerprints for tools already in the registry; nothing discovered goes to the model.\",\n \"Model-visible tools come from the config registry, never from MCP discovery.\",\n [R(\"discovery:tools/list\",\"enforced\",\"src/gateway.py:62\",'\"method\": \"tools/list\"',\"result used only for fingerprint comparison\"),\n  R(\"filter:registry-only\",\"enforced\",\"src/gateway.py:70\",\"if local in live and fingerprint(live[local]) == spec.fingerprint:\",\"only registry specs are enabled; extra live tools ignored\"),\n  R(\"refresh-failure\",\"enforced\",\"src/gateway.py:212\",\"_disabled.update(s.qualified for s in MCP_TOOLS)\",\"refresh failure disables, not enables\"),\n  R(\"model-handoff\",\"enforced\",\"src/tools.py:76\",\"def model_schemas(self)\",\"built from the config registry\")])\nyes(\"B01.3\",\"src/agent.py:102\",\"if spec is None:\",\n \"Searched for getattr/globals/eval/registry[ dynamic lookup: none. Direct-route fallback (gateway_client.py:52) only re-sends a registered tool; gateway bypass itself is owned by E06.\",\n \"Unknown names get a deny audit row and an error result; lookup is an exact dict key.\",\n [R(\"agent-dispatch\",\"enforced\",\"src/agent.py:101\",\"spec = self.registry.get(name)\",\"exact-name lookup, None means deny\"),\n  R(\"registry-get\",\"enforced\",\"src/tools.py:68\",\"return self._tools.get(name)\",\"no prefix/alias matching\"),\n  R(\"gateway-dispatch\",\"enforced\",\"src/gateway.py:166\",'if spec is None or spec.kind != \"mcp\" or tool in _disabled:',\"unknown or disabled tool denied 403\"),\n  R(\"fallback-route\",\"enforced\",\"src/gateway_client.py:52\",\"if not spec.direct_route:\",\"fallback uses a registered spec only; gateway-skip is E06\")])\nyes(\"B01.4\",\"src/agent.py:113\",'if spec.approval == \"subject\":',\n \"Grepped readOnlyHint, destructiveHint, annotations, description: gateway.py:54 hashes annotations into a fingerprint compared for equality only; config comment says hints are never consulted. Approval mode comes only from tools.yaml.\",\n \"Approval and allow decisions read only the config approval field.\",\n [R(\"approval-mode\",\"enforced\",\"src/tools.py:45\",'if t[\"approval\"] not in (\"none\", \"subject\"):',\"approval from config only\"),\n  R(\"fingerprint\",\"enforced\",\"src/gateway.py:54\",'\"annotations\")','annotations only pinned in a hash, not used to allow'),\n  R(\"model-description\",\"enforced\",\"src/tools.py:78\",'\"description\": s.reason',\"model sees local reason text, not server description\")])\nyes(\"B01.5\",\"deployment\",\"x\",\".\",\"x\",[]) if False else None\nyes(\"B01.5\",\"k8s/deployment.yaml:58\",\"readOnlyRootFilesystem: true\",\n \"Searched for open(, fs tools, subprocess, os.system: only fixed-path reads of the projected token and config. No file tool in the registry.\",\n \"No file tool is exposed; container filesystem is read-only with tmp and token/svid mounts.\",\n [R(\"file-tool\",\"not_applicable\",\"src/tools.py:76\",\"def model_schemas(self)\",\"registry has no file or shell tool\"),\n  R(\"mount:tmp\",\"enforced\",\"k8s/deployment.yaml:65\",\"- {name: tmp, mountPath: /tmp}\",\"memory emptyDir 32Mi\"),\n  R(\"mount:token\",\"enforced\",\"k8s/deployment.yaml:66\",\"- {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\",\"read-only\"),\n  R(\"mount:svid\",\"enforced\",\"k8s/deployment.yaml:67\",\"- {name: svid, mountPath: /etc/svid, readOnly: true}\",\"read-only\"),\n  R(\"local-search\",\"enforced\",\"src/agent.py:167\",'raw = await self.index.search(args[\"query\"], ctx.subject)',\"search_policies queries Postgres, not files\")])\nitem(\"B01\",\"likely_pass\",\"medium\",\"One fixed four-tool allowlist, exact-name dispatch, and no hint-based decisions or file tools.\",\"Needs fresh challenge before it counts.\")\n\n# ---- B02\nyes(\"B02.1\",\"migrations/001_init.sql:85\",\"GRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\",\n \"Looked for Role/ClusterRoleBinding/IAM files: none; service accounts do not automount tokens. DB grants name tables and columns; no wildcard or owner role for the agent.\",\n \"Agent and gateway DB roles have table/column grants only.\",\n [R(\"db:agent-audit\",\"enforced\",\"migrations/001_init.sql:81\",\"GRANT INSERT ON audit.events TO hr_agent;\",\"insert only\"),\n  R(\"db:agent-approvals\",\"enforced\",\"migrations/001_init.sql:84\",\"GRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\",\"column-level\"),\n  R(\"db:agent-stop\",\"enforced\",\"migrations/001_init.sql:82\",\"GRANT SELECT ON control.stop_flags TO hr_agent;\",\"read only\"),\n  R(\"db:gateway\",\"enforced\",\"migrations/001_init.sql:89\",\"GRANT INSERT ON audit.gateway_decisions TO hr_gateway;\",\"insert only\"),\n  R(\"k8s:agent-sa\",\"enforced\",\"k8s/deployment.yaml:6\",\"automountServiceAccountToken: false\",\"no API token, no RBAC binding in repo\"),\n  R(\"sts-scopes\",\"enforced\",\"release/manifest.yaml:59\",\"sts_scopes: [hr.policy.read, hris.leave.read, hris.leave.request, helpdesk.ticket.create]\",\"four named scopes\")])\nyes(\"B02.2\",\"src/main.py:73\",'return claims[\"employee_id\"], token',\n \"Searched tenant/subject sources: subject and tenant come from the verified SSO token and config, never from tool arguments (all schemas set additionalProperties false and have no subject field). Retrieval cache keyed without employee is filed under R04, not B02.\",\n \"Subject comes from the verified token; targets are built from it; approvals and handbook SQL filter by subject.\",\n [R(\"subject-source\",\"enforced\",\"src/main.py:73\",'return claims[\"employee_id\"], token',\"verified token claim\"),\n  R(\"tenant-check\",\"enforced\",\"src/main.py:71\",'if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:',\"wrong org rejected\"),\n  R(\"target\",\"enforced\",\"src/agent.py:105\",\"target = spec.target(ctx.subject)\",\"from ctx not model\"),\n  R(\"tool-args\",\"enforced\",\"config/tools.yaml:44\",\"additionalProperties: false\",\"no model-supplied subject field\"),\n  R(\"approvals-sql\",\"enforced\",\"src/approvals.py:60\",\"WHERE approval_id = $1 AND subject = $2 AND approved_at IS NULL AND expires_at > now()\",\"approver must be subject\"),\n  R(\"sts-subject\",\"enforced\",\"src/credentials.py:50\",'\"subject_token\": subject_token,',\"STS token carries the employee as sub\")])\nother(\"B02.3\",\"unknown\",\"src/gateway.py:83\",\"claims = jwt.decode(\",\"Gateway verifies aud=hr-tool-gateway (gateway.py:83) and agent requests audiences (credentials.py:55,60) but the HRIS and helpdesk MCP servers that receive downstream tokens (gateway.py:123) are outside this repo, so