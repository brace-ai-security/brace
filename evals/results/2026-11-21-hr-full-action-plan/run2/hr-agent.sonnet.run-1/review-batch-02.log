{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChG1KiUjN3uiy3mpw3fcb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018fMKznVHNstFyDegLy4F8B","name":"Bash","input":{"command":"cat -n src/gateway_client.py src/credentials.py; cat config/tools.yaml; cat requirements.txt | head -30"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9549,"cache_read_input_tokens":45756,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9549},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6f14022b-46ce-4936-8598-8b32b34af28b","uuid":"59027e54-ee55-407e-aaa7-7433277b8e7e","timestamp":"2026-11-21T11:37:43.131Z","request_id":"req_011ChG1KiJoPF1J46LNzF62k","wire_tool_inputs":{"toolu_018fMKznVHNstFyDegLy4F8B":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-r46cle5_/agent && cat -n src/gateway_client.py src/credentials.py; cat config/tools.yaml; cat requirements.txt | head -30"}},"wire_ingest_context":{"toolu_018fMKznVHNstFyDegLy4F8B":{"cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-r46cle5_/agent"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018fMKznVHNstFyDegLy4F8B","type":"tool_result","content":"     1\t\"\"\"Calls MCP tools through the hr-tool-gateway.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport logging\n     5\timport uuid\n     6\tfrom typing import Any\n     7\t\n     8\timport httpx\n     9\tfrom opentelemetry.propagate import inject\n    10\t\n    11\tfrom .audit import RunContext\n    12\tfrom .credentials import CredentialBroker\n    13\tfrom .tools import ToolSpec\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.gateway_client\")\n    16\t\n    17\tGATEWAY_URL = \"https://hr-tool-gateway.hr-agent.svc.cluster.local:8443/mcp\"\n    18\tGATEWAY_AUDIENCE = \"hr-tool-gateway\"\n    19\t\n    20\t\n    21\tclass ToolDenied(Exception):\n    22\t    def __init__(self, reason: str):\n    23\t        super().__init__(reason)\n    24\t        self.reason = reason\n    25\t\n    26\t\n    27\tclass ToolError(Exception):\n    28\t    def __init__(self, status: int, detail: str):\n    29\t        super().__init__(f\"{status}\")\n    30\t        self.status = status\n    31\t        self.detail = detail\n    32\t\n    33\t\n    34\tclass GatewayUnavailable(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass GatewayClient:\n    39\t    def __init__(self, client: httpx.AsyncClient, creds: CredentialBroker):\n    40\t        self._client = client\n    41\t        self._creds = creds\n    42\t\n    43\t    async def call(\n    44\t        self, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, subject_token: str, *, operation_id: str\n    45\t    ) -> dict[str, Any]:\n    46\t        try:\n    47\t            token = await self._creds.token(\n    48\t                audience=GATEWAY_AUDIENCE, scope=spec.scope, subject_token=subject_token, subject=ctx.subject\n    49\t            )\n    50\t            return await self._post(GATEWAY_URL, token, spec, args, ctx, operation_id)\n    51\t        except GatewayUnavailable:\n    52\t            if not spec.direct_route:\n    53\t                raise\n    54\t            log.warning(\"gateway unavailable, using direct route\", extra={\"tool\": spec.qualified})\n    55\t            token = await self._creds.token(\n    56\t                audience=spec.direct_route[\"audience\"], scope=spec.scope,\n    57\t                subject_token=subject_token, subject=ctx.subject,\n    58\t            )\n    59\t            return await self._post(spec.direct_route[\"endpoint\"], token, spec, args, ctx, operation_id)\n    60\t\n    61\t    async def _post(\n    62\t        self, url: str, token: str, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, operation_id: str\n    63\t    ) -> dict[str, Any]:\n    64\t        tool_name = spec.qualified.split(\"/\", 1)[1]\n    65\t        headers = {\n    66\t            \"Authorization\": f\"Bearer {token}\",\n    67\t            \"Mcp-Method\": \"tools/call\",\n    68\t            \"Mcp-Name\": tool_name,\n    69\t            \"Idempotency-Key\": operation_id,\n    70\t            \"X-Agent-Instance\": ctx.agent_instance_id,\n    71\t            \"X-Agent-Type-Id\": ctx.agent_type_id,\n    72\t        }\n    73\t        inject(headers)\n    74\t        body = {\n    75\t            \"jsonrpc\": \"2.0\",\n    76\t            \"id\": str(uuid.uuid4()),\n    77\t            \"method\": \"tools/call\",\n    78\t            \"params\": {\"name\": tool_name, \"arguments\": args, \"_meta\": {\"server\": spec.server}},\n    79\t        }\n    80\t        try:\n    81\t            resp = await self._client.post(url, json=body, headers=headers, timeout=10.0)\n    82\t        except (httpx.ConnectError, httpx.ConnectTimeout) as exc:\n    83\t            raise GatewayUnavailable(str(exc)) from exc\n    84\t        except httpx.TimeoutException as exc:\n    85\t            raise ToolError(504, f\"no response; outcome unknown for operation {operation_id}\") from exc\n    86\t        if resp.status_code == 503:\n    87\t            raise GatewayUnavailable(resp.text[:200])\n    88\t        if resp.status_code in (401, 403, 429):\n    89\t            raise ToolDenied(resp.json().get(\"error\", \"denied\"))\n    90\t        if resp.status_code >= 400:\n    91\t            raise ToolError(resp.status_code, resp.json().get(\"detail\", resp.text))\n    92\t        payload = resp.json()\n    93\t        if \"error\" in payload:\n    94\t            raise ToolError(200, str(payload[\"error\"].get(\"message\", \"\")))\n    95\t        return payload[\"result\"][\"structuredContent\"]\n     1\t\"\"\"Per-tool, per-employee, short-lived tokens for the agent's own workload identity.\n     2\t\n     3\tThe pod's projected service-account token (audience sts.acme.example, 10 min) is the\n     4\tactor token. The employee's verified SSO token is the subject token. The STS returns an\n     5\tRFC 8693 token whose `sub` is the employee, `act.sub` is this workload, `aud` is the\n     6\trequested audience, `scope` is exactly one tool scope, and `cnf.x5t#S256` binds it to the\n     7\tpod's mTLS certificate. Lifetime is 300 s: long enough for one approval-to-execute window\n     8\ton a single call, short enough that a copied token is useless after the run.\n     9\t\"\"\"\n    10\tfrom __future__ import annotations\n    11\t\n    12\timport asyncio\n    13\timport time\n    14\tfrom dataclasses import dataclass\n    15\t\n    16\timport httpx\n    17\t\n    18\tSTS_URL = \"https://sts.identity.svc.cluster.local/oauth2/token\"\n    19\tACTOR_TOKEN_PATH = \"/var/run/secrets/tokens/sts-token\"\n    20\tTOKEN_TTL_SECONDS = 300\n    21\tREFRESH_MARGIN_SECONDS = 30\n    22\t\n    23\t\n    24\t@dataclass\n    25\tclass _Cached:\n    26\t    token: str\n    27\t    expires_at: float\n    28\t\n    29\t\n    30\tclass CredentialBroker:\n    31\t    def __init__(self, client: httpx.AsyncClient):\n    32\t        self._client = client  # configured with the pod's SPIFFE SVID for mTLS\n    33\t        self._cache: dict[tuple[str, str, str], _Cached] = {}\n    34\t        self._lock = asyncio.Lock()\n    35\t\n    36\t    def _actor_token(self) -> str:\n    37\t        # Re-read each time: kubelet rotates the projected token on disk.\n    38\t        with open(ACTOR_TOKEN_PATH, encoding=\"utf-8\") as fh:\n    39\t            return fh.read().strip()\n    40\t\n    41\t    async def token(self, *, audience: str, scope: str, subject_token: str, subject: str) -> str:\n    42\t        key = (audience, scope, subject)\n    43\t        async with self._lock:\n    44\t            hit = self._cache.get(key)\n    45\t            if hit and hit.expires_at - REFRESH_MARGIN_SECONDS > time.time():\n    46\t                return hit.token\n    47\t            resp = await self._client.post(\n    48\t                STS_URL,\n    49\t                data={\n    50\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    51\t                    \"subject_token\": subject_token,\n    52\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:id_token\",\n    53\t                    \"actor_token\": self._actor_token(),\n    54\t                    \"actor_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n    55\t                    \"audience\": audience,\n    56\t                    \"scope\": scope,\n    57\t                    \"requested_token_type\": \"urn:ietf:params:oauth:token-type:access_token\",\n    58\t                    \"requested_ttl\": str(TOKEN_TTL_SECONDS),\n    59\t                },\n    60\t                timeout=3.0,\n    61\t            )\n    62\t            resp.raise_for_status()\n    63\t            body = resp.json()\n    64\t            ttl = min(int(body.get(\"expires_in\", TOKEN_TTL_SECONDS)), TOKEN_TTL_SECONDS)\n    65\t            self._cache[key] = _Cached(body[\"access_token\"], time.time() + ttl)\n    66\t            return body[\"access_token\"]\n    67\t\n    68\t    def drop_subject(self, subject: str) -> None:\n    69\t        for key in [k for k in self._cache if k[2] == subject]:\n    70\t            del self._cache[key]\npolicy_version: \"2026-09-18.3\"\n\nservers:\n  hris:\n    endpoint: https://hris-mcp.hris.svc.cluster.local:8443/mcp\n    identity: spiffe://acme.example/ns/hris/sa/hris-mcp\n    downstream_audience: hris-mcp\n    owner: hris-platform\n  helpdesk:\n    endpoint: https://helpdesk-mcp.helpdesk.svc.cluster.local:8443/mcp\n    identity: spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\n    downstream_audience: helpdesk-mcp\n    owner: it-service-desk\n\n# Model-facing name -> qualified tool. Server annotations (readOnlyHint etc.)\n# are never consulted; approval comes only from this file.\ntools:\n  search_policies:\n    kind: local\n    reason: \"Answer policy questions from the approved HR handbook index.\"\n    scope: hr.policy.read\n    approval: none\n    input_schema:\n      type: object\n      properties:\n        query: {type: string, minLength: 3, maxLength: 300}\n      required: [query]\n      additionalProperties: false\n\n  get_leave_balance:\n    kind: mcp\n    qualified: hris/get_leave_balance\n    server: hris\n    reason: \"Show the asking employee their own leave balance.\"\n    scope: hris.leave.read\n    approval: none\n    target: \"employee:{subject}\"\n    fingerprint: \"sha256:5d1c0e9a7b3f48e2a61c9d04f7be3a92c815e6d07ab4f3c2e19d8a6b5c4f0e71\"\n    input_schema:\n      type: object\n      properties:\n        leave_type: {enum: [annual, sick, parental, unpaid]}\n      required: [leave_type]\n      additionalProperties: false\n    output_schema:\n      type: object\n      properties:\n        leave_type: {type: string, maxLength: 20}\n        balance_days: {type: number, minimum: 0, maximum: 400}\n        accrual_per_month: {type: number, minimum: 0, maximum: 5}\n        as_of: {type: string, format: date}\n      required: [leave_type, balance_days, as_of]\n  