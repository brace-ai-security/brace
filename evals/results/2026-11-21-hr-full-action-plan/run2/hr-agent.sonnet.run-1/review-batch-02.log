    direct_route:\n      endpoint: https://helpdesk-mcp.helpdesk.svc.cluster.local:8443/mcp\n      audience: helpdesk-mcp\n    input_schema:\n      type: object\n      properties:\n        summary: {type: string, minLength: 10, maxLength: 1000}\n        category: {enum: [payroll, leave, benefits, conduct, other]}\n      required: [summary, category]\n      additionalProperties: false\n    output_schema:\n      type: object\n      properties:\n        ticket_id: {type: string, pattern: \"^HR-[0-9]{6}$\"}\n        queue: {type: string, maxLength: 40}\n      required: [ticket_id]\n      additionalProperties: false\n# Generated by: uv pip compile requirements.in --generate-hashes --python-version 3.12\nanthropic==0.69.0 --hash=sha256:195b8cacfef3d1c6a675b88ef39969ce8973f93c8ced6423dfe0d12ef8307cce --hash=sha256:993c53cf831745f0e64c62d7edae1e1e5c9bdd50ba83bff23ceb262df55c6861\nasyncpg==0.30.0 --hash=sha256:b6b92bb65c90b2f0021eb3a07a00b1ba86121b903c63c5e7d886d5bb01ae75c8 --hash=sha256:4091cc4ff944aa26d10fec6fa14e825b170437082162fc43d7e3ef43763c6582\nhttpx==0.28.1 --hash=sha256:41989ee577a16868199c6fa98d8de899296004dd7b2702a84753f9d6cf937221 --hash=sha256:daca608a9349068bcf9bb5128258d6c7d70dd3007a8f79ad77b0045978b09077\njsonschema==4.25.1 --hash=sha256:305a92a6d768f487e631523cd1517c7c032ae20c82a4c6a49a01edd65e0839b0 --hash=sha256:1dce1dec65770c771d3ca7a9ca631cf694780951ddf94720c40973bee72cb667\nopentelemetry-api==1.37.0 --hash=sha256:aa170874a075dfba7084f009410de29d6fe3a9fba809237ec1dcecf31ef09659 --hash=sha256:adfe125b669855a528ebb5166eb930e21ccdde3425aac1bf636f3145f354aa67\nopentelemetry-sdk==1.37.0 --hash=sha256:97163bab89eb4f6224572d6fd2789187df3576b73095a4f395d0dacfe65f8ef3 --hash=sha256:584321cbbf1718625348ac96bfb04d67cc2c9d45cdb682d6dc1c49567b77a894\nopentelemetry-exporter-otlp-proto-grpc==1.37.0 --hash=sha256:1a51f4e0b05d4fdc60119efaef84a0be6154f38def98353d105c3881b1578a40 --hash=sha256:b29f85df6cb6ab4d6366fc36a30c9dada977f6d49aa4ed0a55839fc2f76c69a0\npyjwt[crypto]