{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012x4TmLoxy8DxveWxsq37WF","type":"tool_result","content":"    20\t WHERE c.tsv @@ websearch_to_tsquery('english', $1)\n    21\t   AND NOT c.quarantined\n    22\t   AND (c.expires_at IS NULL OR c.expires_at > now())\n    23\t   AND (c.audience = 'all' OR (c.audience = 'employee' AND $2 = ANY (c.allowed_employees)))\n    24\t ORDER BY rank DESC\n    25\t LIMIT $3\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass PolicyIndex:\n    30\t    def __init__(self, pool: asyncpg.Pool, top_k: int, cache_ttl: float):\n    31\t        self._pool = pool\n    32\t        self._top_k = top_k\n    33\t        self._ttl = cache_ttl\n    34\t        self._cache: dict[str, tuple[float, str, list[dict[str, Any]]]] = {}\n    35\t\n    36\t    async def _index_version(self) -> str:\n    37\t        # Bumped by ingest on every add, expiry, quarantine or permission change.\n    38\t        return await self._pool.fetchval(\"SELECT version FROM retrieval.index_state WHERE id = 1\")\n    39\t\n    40\t    def _key(self, query: str) -> str:\n    41\t        normalized = \" \".join(query.lower().split())\n    42\t        return hashlib.sha256(f\"{self._top_k}|{normalized}\".encode()).hexdigest()\n    43\t\n    44\t    async def search(self, query: str, employee_id: str) -> list[dict[str, Any]]:\n    45\t        version = await self._index_version()\n    46\t        key = self._key(query)\n    47\t        hit = self._cache.get(key)\n    48\t        if hit and hit[1] == version and time.monotonic() - hit[0] < self._ttl:\n    49\t            return hit[2]\n    50\t        rows = await self._pool.fetch(_SEARCH, query, employee_id, self._top_k)\n    51\t        chunks = [dict(r) for r in rows]\n    52\t        self._cache[key] = (time.monotonic(), version, chunks)\n    53\t        return chunks\n(eval):1: no matches found: --include=*.py\n(eval):1: no matches found: --include=*\n7:permissions:\n14:    permissions:\n64:    permi