 37\t                       start_ts + i * period, start_ts + (i + 1) * period);\n    38\t    END LOOP;\n    39\t    FOR part IN\n    40\t        SELECT c.oid::regclass AS rel FROM pg_inherits i JOIN pg_class c ON c.oid = i.inhrelid\n    41\t         WHERE i.inhparent = parent ORDER BY c.relname DESC OFFSET keep + ahead + 1\n    42\t    LOOP\n    43\t        EXECUTE format('DROP TABLE %s', part.rel);\n    44\t    END LOOP;\n    45\tEND $$;\n    46\t\n    47\tCREATE TABLE control.stop_flags (\n    48\t    flag_id bigserial PRIMARY KEY,\n    49\t    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n    50\t    value text, active boolean NOT NULL DEFAULT true, reason text NOT NULL,\n    51\t    set_by text NOT NULL DEFAULT current_user, set_at timestamptz NOT NULL DEFAULT now()\n    52\t);\n    53\t\n    54\tCREATE TABLE approvals.grants (\n    55\t    approval_id uuid PRIMARY KEY, run_id uuid NOT NULL, agent_instance_id text NOT NULL, subject text NOT NULL,\n    56\t    operation text NOT NULL, target text NOT NULL, args_sha256 char(64) NOT NULL, args jsonb NOT NULL,\n    57\t    tool_use_id text NOT NULL, description text NOT NULL,\n    58\t    requested_at timestamptz NOT NULL, expires_at timestamptz NOT NULL,\n    59\t    approved_by text, approved_at timestamptz, used_at timestamptz\n    60\t);\n    61\t\n    62\tCREATE TABLE quota.usage (\n    63\t    scope text NOT NULL, key text NOT NULL, window_start timestamptz NOT NULL,\n    64\t    runs integer NOT NULL DEFAULT 0, tokens bigint NOT NULL DEFAULT 0, cost_usd numeric(12, 4) NOT NULL DEFAULT 0,\n    65\t    PRIMARY KEY (scope, key, window_start)\n    66\t);\n    67\t\n    68\tCREATE TABLE retrieval.index_state (id int PRIMARY KEY CHECK (id = 1), version text NOT NULL);\n    69\tCREATE TABLE retrieval.chunks (\n    70\t    chunk_id text PRIMARY KEY, doc_id text NOT NULL, source text NOT NULL,\n    71\t    added_at timestamptz NOT NULL DEFAULT now(), added_by text NOT NULL DEFAULT current_user,\n    72\t    trust text NOT NULL CHECK (trust IN ('reviewed', 'hr_authored')),\n    73\t    audience text NOT NULL CHECK (audience IN ('all', 'employee')),\n    74\t    allowed_employees text[] NOT NULL DEFAULT '{}',\n    75\t    expires_at timestamptz, quarantined boolean NOT NULL DEFAULT false, text text NOT NULL,\n    76\t    tsv tsvector GENERATED ALWAYS AS (to_tsvector('english', text)) STORED\n    77\t);\n    78\tCREATE INDEX ON retrieval.chunks USING gin (tsv);\n    79\t\n    80\tGRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\n    81\tGRANT INSERT ON audit.events TO hr_agent;\n    82\tGRANT SELECT ON control.stop_flags TO hr_agent;\n    83\tGRANT SELECT, INSERT ON approvals.grants TO hr_agent;\n    84\tGRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\n    85\tGRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\n    86\tGRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n    87\t\n    88\tGRANT USAGE ON SCHEMA audit, control TO hr_gateway;\n    89\tGRANT INSERT ON audit.gateway_decisions TO hr_gateway;\n    90\tGRANT SELECT ON control.stop_flags TO hr_gateway;\n    91\t\n    92\tGRANT USAGE ON SCHEMA control TO hr_agent_operator;\n    93\tGRANT SELECT, INSERT, UPDATE ON control.stop_flags TO hr_agent_operator;\n    94\tGRANT USAGE ON SEQUENCE control.stop_flags_flag_id_seq TO hr_agent_operator;\n    95\t\n    96\tGRANT USAGE ON SCHEMA audit TO hr_audit_reader, hr_audit_maint;\n    97\tGRANT SELECT ON ALL TABLES IN SCHEMA audit TO hr_audit_reader;\n    98\tREVOKE EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) FROM PUBLIC;\n    99\tGRANT EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) TO hr_audit_maint;\n   100\t\n   101\tGRANT USAGE ON SCHEMA retrieval TO hr_docs_ingest;\n   102\tGRANT SELECT, INSERT, UPDATE ON retrieval.chunks, retrieval.index_state TO hr_docs_ingest;\n     1