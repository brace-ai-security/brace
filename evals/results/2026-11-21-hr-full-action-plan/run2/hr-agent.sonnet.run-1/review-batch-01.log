nforced\",\"src/credentials.py:50\",'\"subject_token\": subject_token,',\"RFC 8693 exchange with actor token for the workload.\"),\n  row(\"gateway actor check\",\"enforced\",\"src/gateway.py:91\",\"if claims[\\\"act\\\"].get(\\\"sub\\\") not in ACTORS:\",\"Actor must be listed.\")])\nitem(\"B02\",\"needs_evidence\",\"medium\",\"Delegation and tenant scoping look sound in code, but IAM grants and downstream audience checks are outside this repo.\",\"Get the STS policy for the agent workload and confirm the HRIS and helpdesk MCP servers reject tokens with the wrong audience.\")\n\n# ---- B03\nchk(\"B03.1\",\"unknown\",\"k8s/deployment.yaml:54\",\"valueFrom: {secretKeyRef: {name: hr-agent-anthropic, key: api_key}}\",\"Service tokens come from STS at run time, but ANTHROPIC_API_KEY and DB URLs are static Secrets; whether the provider or database offers federated credentials is not stated in the repo.\")\nchk(\"B03.2\",\"unknown\",\"src/credentials.py:20\",\"TOKEN_TTL_SECONDS = 300\",\"Access tokens are capped at 300 s and the projected token at 600 s, but no rotation period is set for the Anthropic key or DB passwords in this repo.\")\nchk(\"B03.3\",\"yes\",\"Dockerfile:15\",\"COPY --chown=0:0 config/ config/\",\"Image copies only src, prompts, config; secrets come from Kubernetes Secrets by reference; no key-like literals found.\",\n \"Grepped sk-, AKIA, password, secret across the repo: no literals; Dockerfile has no ENV/ARG secrets; system prompt holds no env values.\",\n [row(\"Dockerfile\",\"enforced\",\"Dockerfile:9\",\"ENV PYTHONPATH=/deps:/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1\",\"No secret ENV/ARG.\"),\n  row(\"deployment env\",\"enforced\",\"k8s/deployment.yaml:54\",\"valueFrom: {secretKeyRef: {name: hr-agent-anthropic, key: api_key}}\",\"Secret by reference, not literal.\"),\n  row(\"prompts and config\",\"enforced\",\"prompts/system.md:1\",\"You are the Acme HR helpdesk assistant. You help one employee at a time with questions\",\"No secrets in prompt.\")])\nchk(\"B03.4\",\"unknown\",\"src/gateway.py:89\",\"if cert_hash is None or claims[\\\"cnf\\\"].get(\\\"x5t#S256\\\") != cert_hash:\",\"Gateway binds tokens to the caller certificate (mTLS); whether the MCP servers also check the binding is outside this repo.\")\nitem(\"B03\",\"needs_evidence\",\"medium\",\"Short-lived certificate-bound tokens are used for tool calls; static-secret lifetimes and downstream binding are not shown in the repo.\",\"Record how the Anthropic key and DB credentials are rotated, whether federated options exist, and whether downstream MCP servers check token binding.\")\n\n# ---- B04\nchk(\"B04.1\",\"yes\",\"src/killswitch.py:24\",\"OR (scope = 'agent_principal' AND value = $4))\",\"Stop flags can target agent_principal or agent_instance, separate from scope 'subject', so the agent is cut off without stopping the employee.\",\n \"Searched for revoke/disable paths: only control.stop_flags (migrations/001_init.sql:47) and README runbook; agent never uses the user's token as its own identity.\",\n [row(\"flag scopes\",\"enforced\",\"migrations/001_init.sql:49\",\"scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\",\"Agent-only scopes exist.\"),\n  row(\"gateway check\",\"enforced\",\"src/gateway.py:101\",\"OR (scope = 'agent_instance' AND value = $1) OR (scope = 'subject' AND value = $2)\",\"Gateway honours agent scopes.\")])\nchk(\"B04.2\",\"no\",\"src/gateway_client.py:52\",\"if not spec.direct_route:\",\"On gateway failure, escalate_to_human goes straight to the helpdesk MCP server, skipping the gateway stop-flag check; on that path only agent-process code (killswitch.py) stops it. A gateway stop-store error returns 503, which triggers this fallback.\")\nchk(\"B04.3\",\"no\",\"src/credentials.py:20\",\"TOKEN_TTL_SECONDS = 300\",\"Tokens live 300 s and are cached against a 10 s stop target; the gateway checks flags per call, but the direct route has no per-call revocation check and no limit is shown for MCP servers' own validation.\")\nchk(\"B04.4\",\"unknown\",\"src/credentials.py:68\",\"def drop_subject(self, subject: str) -> None:\",\"Stop flags block later gateway calls and cancel in-flight work, but nothing here revokes issued STS tokens; drop_subject has no caller and STS revocation is outside this repo.\")\nitem(\"B04\",\"gap\",\"medium\",\"The gateway stop check can be skipped by the direct_route fallback, where only the agent process enforces the stop.\",\"Remove direct_route from config/tools.yaml:91 and src/gateway_client.py:51-59, or enforce stop flags at the helpdesk MCP server; shorten token life.\",\"The agent must not need to cooperate\")\n\n# ---- B05\nchk(\"B05.1\",\"no\",\"k8s/audit-maintenance.yaml:34\",\"- name: KEEP_PARTITIONS\",\"Audit partitions are dropped nightly with no approval, and 6 weekly partitions (about six weeks) is set against the six months documented in README; retention is changed by editing this env value.\")\nchk(\"B05.2\",\"yes\",\"src/agent.py:69\",'if spec.approval == \"subject\":',\"Execution-time gate in the loop holds approval-required tools; consume() re-checks agent instance, subject, operation, target and args hash in one UPDATE. Unlisted tools are denied; no suffix/prefix comparisons.\",\n \"Searched endswith/startswith/in-string comparisons for skip-approval values: none. Config requires approval of none or subject.\",\n [row(\"first dispatch\",\"enforced\",\"src/agent.py:69\",'if spec.approval == \"subject\":',\"Holds the call and stores op/target/args hash.\"),\n  row(\"resume path\",\"enforced\",\"src/agent.py:91\",\"grant = await self.approvals.consume(ctx, approval_id, spec.qualified, target, args)\",\"Binds op, target, args.\"),\n  row(\"binding SQL\",\"enforced\",\"src/approvals.py:80\",\"AND args_sha256 = $6\",\"Args hash compared in the UPDATE.\")])\nchk(\"B05.3\",\"yes\",\"src/agent.py:69\",'if spec.approval == \"subject\":',\"All model-callable tools are registry tools (4 names incl. 2 write/send tools) and both go through _handle_tool; no shell, HTTP, browser or peer tool exists. The direct_route second path still sits after the approval gate; its gateway bypass is E06.\",\n \"Searched subprocess/os.system/httpx use: httpx only in gateway_client.py and credentials.py, called from _execute after the gate. max_subagents is 0.\",\n [row(\"search_policies\",\"enforced\",\"src/agent.py:122\",'if spec.kind == \"local\":',\"Read-only DB search.\"),\n  row(\"get_leave_balance\",\"enforced\",\"config/tools.yaml:22\",\"approval: none\",\"Read of own balance only.\"),\n  row(\"file_leave_request\",\"enforced\",\"config/tools.yaml:61\",\"approval: subject\",\"Approval-gated.\"),\n  row(\"escalate_to_human\",\"enforced\",\"config/tools.yaml:88\",\"approval: subject\",\"Approval-gated, including direct_route fallback.\")])\nchk(\"B05.4\",\"yes\",\"src/approvals.py:60\",\"WHERE approval_id = $1 AND subject = $2 AND approved_at IS NULL AND expires_at > now()\",\"Only the authenticated employee's confirm endpoint can approve; consume needs approved_by = subject; expiry blocks rather than proceeds; model and prompt cannot approve.\",\n \"Searched auto-approve, bypass, default yes, timeout-proceeds: none.\",\n [row(\"confirm endpoint\",\"enforced\",\"src/main.py:143\",\"if entry is None or entry[0].subject != employee_id:\",\"Needs the employee's own token.\"),\n  row(\"consume\",\"enforced\",\"src/approvals.py:74\",\"AND approved_by = subject\",\"Approval must exist.\"),\n  row(\"expiry\",\"enforced\",\"src/approvals.py:75\",\"AND expires_at > now()\",\"Expired approvals fail.\")])\nchk(\"B05.5\",\"yes\",\"src/agent.py:69\",'if spec.approval == \"subject\":',\"Agent reads untrusted content, reaches HR data and can send/file; both consequential actions (file_leave_request, escalate_to_human) require approval of the exact action; remaining tools are reads.\",\n \"Listed all four tools; no other outbound-capable tool exists.\",\n [row(\"file_leave_request\",\"enforced\",\"config/tools.yaml:61\",\"approval: subject\",\"Gated.\"),\n  row(\"escalate_to_human\",\"enforced\",\"config/tools.yaml:88\",\"approval: subject\",\"Gated.\")])\nrun(f\"{S}/answer.py\",F,\"flag\",\"B05\",\"--evidence\",\"migrations/001_init.sql:43\",\"--note\",\"Nightly job drops audit partitions with DROP TABLE with no approval step; 6 weekly partitions kept versus six months in README.\")\nitem(\"B05\",\"gap\",\"medium\",\"Audit records are deleted by an unattended nightly job that keeps about six weeks, not the six months the README states.\",\"Set KEEP_PARTITIONS in k8s/audit-maintenance.yaml:34-35 to cover six months and route retention changes through approval.\",\"Treat deleting audit records, or changing how long they are kept, as high-impact too\")\nEOF\ncd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-xqj04pqj && /private/tmp/claude-501/-Users-brenn-dev-brace/255658ca-f19b-460c-8892-2a477de97733/scratchpad/venv/bin/python work/run.py","uuid":"685fe7b0-f348-4376-9723-defdb80ef477","session_id":"01f334bb-6747-4a3e-bd08-50ba1369d440"}
