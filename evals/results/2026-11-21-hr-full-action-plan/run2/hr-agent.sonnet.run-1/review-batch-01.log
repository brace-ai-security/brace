"config/tools.yaml:17\",\"tools:\",\"Single explicit name-keyed map; each entry has a reason.\"),\n  row(\"gateway allowlist\",\"enforced\",\"src/gateway.py:165\",\"spec = registry.by_qualified(tool)\",\"Gateway uses same registry; .mcp.json lists only the gateway.\")])\nchk(\"B01.2\",\"yes\",\"src/tools.py:76\",\"def model_schemas(self) -> list[dict[str, Any]]:\",\"Model sees only registry tools; MCP tools/list is used only to compare fingerprints in the gateway and never forwarded to the model.\",\n \"Searched list_tools/tools/list: only src/gateway.py:62 (fingerprint refresh); result never reaches the model. Refresh path only enables/disables registry tools.\",\n [row(\"MCP discovery in gateway refresh_fingerprints\",\"enforced\",\"src/gateway.py:62\",'resp = await _upstream.post(server[\"endpoint\"], json={\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/list\"}, timeout=5.0)'.split(\"(\")[0] if False else \"async def refresh_fingerprints() -> None:\",\"Discovered tools only matched by exact name against registry; unlisted live tools are ignored.\"),\n  row(\"model-visible tool list\",\"enforced\",\"src/tools.py:76\",\"def model_schemas(self) -> list[dict[str, Any]]:\",\"Built from registry only.\")])\nchk(\"B01.3\",\"yes\",\"src/agent.py:58\",\"if spec is None:\",\"Dispatcher does exact-key lookup and returns an error for names not in the registry; no getattr/eval. The gateway direct_route fallback only re-sends an allowlisted tool and is an E06 (gateway bypass) matter per B01 'not covered'.\",\n \"Searched getattr/globals/eval/registry[ in src/: none. tools.py:68 exact dict get. Unknown-tool error returns without executing.\",\n [row(\"agent dispatcher _handle_tool\",\"enforced\",\"src/agent.py:58\",\"if spec is None:\",\"Unknown names denied and audited.\"),\n  row(\"gateway dispatcher\",\"enforced\",\"src/gateway.py:166\",'if spec is None or spec.kind != \"mcp\" or tool in _disabled:',\"Unlisted tools get 403.\"),\n  row(\"direct_route fallback\",\"not_a