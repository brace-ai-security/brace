ngress:\n    65\t    - fromEndpoints:\n    66\t        - matchLabels: {app: hr-helpdesk-agent}\n    67\t      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n    68\t  egress:\n    69\t    - toEndpoints:\n    70\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": kube-system, k8s-app: kube-dns}\n    71\t      toPorts:\n    72\t        - ports: [{port: \"53\", protocol: UDP}]\n    73\t          rules:\n    74\t            dns:\n    75\t              - matchPattern: \"*.svc.cluster.local\"\n    76\t    - toEndpoints:\n    77\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": hris, app: hris-mcp}\n    78\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": helpdesk, app: helpdesk-mcp}\n    79\t      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n    80\t    - toEndpoints:\n    81\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": identity, app: sts}\n    82\t      toPorts: [{ports: [{port: \"443\", protocol: TCP}]}]\n    83\t    - toEndpoints:\n    84\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": data, app: hr-postgres}\n    85\t      toPorts: [{ports: [{port: \"5432\", protocol: TCP}]}]\n    86\t  egressDeny:\n    87\t    - toCIDR: [169.254.169.254/32, 169.254.170.2/32, 100.100.100.200/32]\n    88\t    - toCIDRSet:\n    89\t        - cidr: fd00:ec2::254/128\n    15\t          labels: {app: audit-maintenance}\n    16\t        spec:\n    17\t          serviceAccountName: hr-audit-maint\n    18\t          automountServiceAccountToken: false\n    19\t          restartPolicy: OnFailure\n    20\t          securityContext:\n    21\t            runAsNonRoot: true\n    22\t            runAsUser: 70\n    23\t            seccompProfile: {type: RuntimeDefault}\n    24\t          containers:\n    25\t            - name: maintain\n    26\t              image: registry.acme.example/platform/psql@sha256:9b2e61c04d7f3a85e1c6b09d2f4a7e3c58d1b6a0f9e2c47d3b8a15e6f0c9d2a4\n    27\t              env:\n    28\t         