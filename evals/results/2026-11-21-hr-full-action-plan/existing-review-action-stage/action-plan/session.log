eads/main\"\n    69\t                    - key: \"{{ runDetails.builder.id }}\"\n    70\t                      operator: Equals\n    71\t                      value: \"https://github.com/actions/runner/github-hosted\"\n    72\t        - imageReferences: [\"registry.acme.example/platform/*\"]\n    73\t          mutateDigest: false\n    74\t          verifyDigest: true\n    75\t          required: true\n    76\t          attestors:\n    77\t            - entries:\n    78\t                - keyless:\n    79\t                    subject: \"https://github.com/acme/platform-images/.github/workflows/build.yml@refs/heads/main\"\n    80\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    81\t                    rekor: {url: \"https://rekor.sigstore.dev\"}\n=== k8s/audit-maintenance.yaml\n     1\tapiVersion: batch/v1\n     2\tkind: CronJob\n     3\tmetadata:\n     4\t  name: audit-partition-maintenance\n     5\t  namespace: hr-agent\n     6\t  labels: {app.kubernetes.io/part-of: hr-helpdesk}\n     7\tspec:\n     8\t  schedule: \"17 2 * * *\"\n     9\t  concurrencyPolicy: Forbid\n    10\t  jobTemplate:\n    11\t    spec:\n    12\t      backoffLimit: 2\n    13\t      template:\n    14\t        metadata:\n    15\t          labels: {app: audit-maintenance}\n    16\t        spec:\n    17\t          serviceAccountName: hr-audit-maint\n    18\t          automountServiceAccountToken: false\n    19\t          restartPolicy: OnFailure\n    20\t          securityContext:\n    21\t            runAsNonRoot: true\n    22\t            runAsUser: 70\n    23\t            seccompProfile: {type: RuntimeDefault}\n    24\t          containers:\n    25\t            - name: maintain\n    26\t              image: registry.acme.example/platform/psql@sha256:9b2e61c04d7f3a85e1c6b09d2f4a7e3c58d1b6a0f9e2c47d3b8a15e6f0c9d2a4\n    27\t              env:\n    28\t                - name: PGSERVICE\n    29\t                  value: hr_audit_maint\n    30\t                - name: PERIOD\n    31\t                  value: \"1 week\"\n    32\t                - name: AHEAD\n    33\t                  value: \"4\"\n    34\t                - name: KEEP_PARTITIONS\n    35\t                  value: \"6\"\n    36\t              command: [\"psql\", \"-v\", \"ON_ERROR_STOP=1\", \"-c\"]\n    37\t              args:\n    38\t                - >-\n    39\t                  SELECT audit.maintain_partitions('audit.events', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    40\t                  SELECT audit.maintain_partitions('audit.gateway_decisions', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    41\t              securityContext:\n    42\t                allowPrivilegeEscalation: false\n    43\t                readOnlyRootFilesystem: true\n    44\t                capabilities: {drop: [ALL]}\n    45\t              volumeMounts:\n    46\t                - {name: pgservice, mountPath: /etc/postgresql-common, readOnly: true}\n    47\t          volumes:\n    48\t            - name: pgservice\n    49\t              secret: {secretName: hr-audit-maint-pgservice}\n=== k8s/deployment.yaml\n     1\tapiVersion: v1\n     2\tkind: ServiceAccount\n     3\tmetadata:\n     4\t  name: hr-helpdesk-agent\n     5\t  namespace: hr-agent\n     6\tautomountServiceAccountToken: false\n     7\t---\n     8\tapiVersion: v1\n     9\tkind: ServiceAccount\n    10\tmetadata:\n    11\t  name: hr-tool-gateway\n    12\t  namespace: hr-agent\n    13\tautomountServiceAccountToken: false\n    14\t---\n    15\tapiVersion: apps/v1\n    16\tkind: Deployment\n    17\tmetadata:\n    18\t  name: hr-helpdesk-agent\n    19\t  namespace: hr-agent\n    20\t  labels: {app: hr-helpdesk-agent, app.kubernetes.io/part-of: hr-helpdesk}\n    21\tspec:\n    22\t  replicas: 3\n    23\t  selector:\n    24\t    matchLabels: {app: hr-helpdesk-agent}\n    25\t  template:\n    26\t    metadata:\n    27\t      labels: {app: hr-helpdesk-agent}\n    28\t      annotations:\n    29\t        acme.example/release-manifest: \"release/manifest.yaml@${GIT_SHA}\"\n    30\t    spec:\n    31\t      serviceAccountName: hr-helpdesk-agent\n    32\t      automountServiceAccountToken: false\n    33\t      hostUsers: false\n    34\t      enableServiceLinks: false\n    35\t      securityContext:\n    36\t        runAsNonRoot: true\n    37\t        runAsUser: 65532\n    38\t        runAsGroup: 65532\n    39\t        fsGroup: 65532\n    40\t        seccompProfile: {type: RuntimeDefault}\n    41\t      containers:\n    42\t        - name: agent\n    43\t          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n    44\t          args: [\"-m\", \"uvicorn\", \"src.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\"]\n    45\t          ports: [{containerPort: 8080}]\n    46\t          env:\n    47\t            - {name: AGENT_TYPE_ID, value: \"${AGENT_TYPE_ID}\"}\n    48\t            - {name: IMAGE_DIGEST, value: \"${IMAGE_DIGEST}\"}\n    49\t            - name: POD_UID\n    50\t              valueFrom: {fieldRef: {fieldPath: metadata.uid}}\n    51\t            - name: DATABASE_URL\n    52\t              valueFrom: {secretKeyRef: {name: hr-agent-db, key: url}}\n    53\t            - name: ANTHROPIC_API_KEY\n    54\t              valueFrom: {secretKeyRef: {name: hr-agent-anthropic, key: api_key}}\n    55\t            - {name: ANTHROPIC_BASE_URL, value: \"https://api.anthropic.com\"}\n    56\t          securityContext:\n    57\t            allowPrivilegeEscalation: false\n    58\t            readOnlyRootFilesystem: true\n    59\t            privileged: false\n    60\t            capabilities: {drop: [ALL]}\n    61\t          resources:\n    62\t            requests: {cpu: 250m, memory: 384Mi}\n    63\t            limits: {cpu: \"1\", memory: 768Mi}\n    64\t          volumeMounts:\n    65\t            - {name: tmp, mountPath: /tmp}\n    66\t            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n    67\t            - {name: svid, mountPath: /etc/svid, readOnly: true}\n    68\t      volumes:\n    69\t        - name: tmp\n    70\t          emptyDir: {medium: Memory, sizeLimit: 32Mi}\n    71\t        - name: sts-token\n    72\t          projected:\n    73\t            sources:\n    74\t              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n    75\t        - name: svid\n    76\t          csi: {driver: csi.spiffe.io, readOnly: true}\n    77\t---\n    78\tapiVersion: apps/v1\n    79\tkind: Deployment\n    80\tmetadata:\n    81\t  name: hr-tool-gateway\n    82\t  namespace: hr-agent\n    83\t  labels: {app: hr-tool-gateway, app.kubernetes.io/part-of: hr-helpdesk}\n    84\tspec:\n    85\t  replicas: 2\n    86\t  selector:\n    87\t    matchLabels: {app: hr-tool-gateway}\n    88\t  template:\n    89\t    metadata:\n    90\t      labels: {app: hr-tool-gateway}\n    91\t    spec:\n    92\t      serviceAccountName: hr-tool-gateway\n    93\t      automountServiceAccountToken: false\n    94\t      hostUsers: false\n    95\t      enableServiceLinks: false\n    96\t      securityContext:\n    97\t        runAsNonRoot: true\n    98\t        runAsUser: 65532\n    99\t        runAsGroup: 65532\n   100\t        seccompProfile: {type: RuntimeDefault}\n   101\t      containers:\n   102\t        - name: gateway\n   103\t          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n   104\t          args: [\"-m\", \"uvicorn\", \"src.gateway:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8443\"]\n   105\t          ports: [{containerPort: 8443}]\n   106\t          env:\n   107\t            - name: GATEWAY_DATABASE_URL\n   108\t              valueFrom: {secretKeyRef: {name: hr-gateway-db, key: url}}\n   109\t          securityContext:\n   110\t            allowPrivilegeEscalation: false\n   111\t            readOnlyRootFilesystem: true\n   112\t            privileged: false\n   113\t            capabilities: {drop: [ALL]}\n   114\t          volumeMounts:\n   115\t            - {name: tmp, mountPath: /tmp}\n   116\t            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n   117\t            - {name: svid, mountPath: /etc/svid, readOnly: true}\n   118\t      volumes:\n   119\t        - name: tmp\n   120\t          emptyDir: {medium: Memory, sizeLimit: 16Mi}\n   121\t        - name: sts-token\n   122\t          projected:\n   123\t            sources:\n   124\t              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n   125\t        - name: svid\n   126\t          csi: {driver: csi.spiffe.io, readOnly: true}\n   127\t---\n   128\tapiVersion: v1\n   129\tkind: Service\n   130\tmetadata:\n   131\t  name: hr-tool-gateway\n   132\t  namespace: hr-agent\n   133\tspec:\n   134\t  selector: {app: hr-tool-gateway}\n   135\t  ports: [{port: 8443, targetPort: 8443}]\n   136\t---\n   137\tapiVersion: v1\n   138\tkind: Service\n   139\tmetadata:\n   140\t  name: hr-helpdesk-agent\n   141\t  namespace: hr-agent\n   142\tspec:\n   143\t  selector: {app: hr-helpdesk-agent}\n   144\t  sessionAffinity: ClientIP\n   145\t  ports: [{port: 80, targetPort: 8080}]\n=== k8s/networkpolicy.yaml\n     1\tapiVersion: networking.k8s.io/v1\n     2\tkind: NetworkPolicy\n     3\tmetadata:\n     4\t  name: default-deny-all\n     5\t  namespace: hr-agent\n     6\tspec:\n     7\t  podSelector: {}\n     8\t  policyTypes: [Ingress, Egress]\n     9\t---\n    10\tapiVersion: cilium.io/v2\n    11\tkind: CiliumNetworkPolicy\n    12\tmetadata:\n    13\t  name: hr-helpdesk-agent-egress\n    14\t  namespace: hr-agent\n    15\tspec:\n    16\t  endpointSelector:\n    17\t    matchLabels: {app: hr-helpdesk-agent}\n    18\t  ingress:\n    19\t    - fromEndpoints:\n    20\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": web-frontends, app: hr-portal-bff}\n    21\t      toPorts: [{ports: [{port: \"8080\", protocol: TCP}]}]\n    22\t  egress:\n    23\t    - toEndpoints:\n    24\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": kube-system, k8s-app: kube-dns}\n    25\t      toPorts:\n    26\t        - ports: [{port: \"53\", protocol: UDP}]\n    27\t          rules:\n    28\t            dns:\n    29\t              - matchName: api.anthropic.com\n    30\t              - matchName: sso.acme.example\n    31\t              - matchPattern: \"*.svc.cluster.local\"\n    32\t    - toFQDNs:\n    33\t        - matchName: api.anthropic.com\n    34\t        - matchName: sso.acme.example\n    35\t      toPorts: [{ports: [{port: \"443\", protocol: TCP}]}]\n    36\t    - toEndpoints:\n    37\t        - matchLabels: {app: hr-tool-gateway}\n    38\t      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n    39\t    - toEndpoints:\n    40\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": identity, app: sts}\n    41\t      toPorts: [{ports: [{port: \"443\", protocol: TCP}]}]\n    42\t    - toEndpoints:\n    43\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": data, app: hr-postgres}\n    44\t      toPorts: [{ports: [{port: \"5432\", protocol: TCP}]}]\n    45\t    - toEndpoints:\n    46\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": observability, app: otel-collector}\n    47\t      toPorts: [{ports: [{port: \"4317\", protocol: TCP}]}]\n    48\t    - toEndpoints:\n    49\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": helpdesk, app: helpdesk-mcp}\n    50\t      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n    51\t  egressDeny:\n    52\t    - toCIDR: [169.254.169.254/32, 169.254.170.2/32, 100.100.100.200/32]\n    53\t    - toCIDRSet:\n    54\t        - cidr: fd00:ec2::254/128\n    55\t---\n    56\tapiVersion: cilium.io/v2\n    57\tkind: CiliumNetworkPolicy\n    58\tmetadata:\n    59\t  name: hr-tool-gateway-egress\n    60\t  namespace: hr-agent\n    61\tspec:\n    62\t  endpointSelector:\n    63\t    matchLabels: {app: hr-tool-gateway}\n    64\t  ingress:\n    65\t    - fromEndpoints:\n    66\t        - matchLabels: {app: hr-helpdesk-agent}\n    67\t      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n    68\t  egress:\n    69\t    - toEndpoints:\n    70\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": kube-system, k8s-app: kube-dns}\n    71\t      toPorts:\n    72\t        - ports: [{port: \"53\", protocol: UDP}]\n    73\t          rules:\n    74\t            dns:\n    75\t              - matchPattern: \"*.svc.cluster.local\"\n    76\t    - toEndpoints:\n    77\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": hris, app: hris-mcp}\n    78\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": helpdesk, app: helpdesk-mcp}\n    79\t      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n    80\t    - toEndpoints:\n    81\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": identity, app: sts}\n    82\t      toPorts: [{ports: [{port: \"443\", protocol: TCP}]}]\n    83\t    - toEndpoints:\n    84\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": data, app: hr-postgres}\n    85\t      toPorts: [{ports: [{port: \"5432\", protocol: TCP}]}]\n    86\t  egressDeny:\n    87\t    - toCIDR: [169.254.169.254/32, 169.254.170.2/32, 100.100.100.200/32]\n    88\t    - toCIDRSet:\n    89\t        - cidr: fd00:ec2::254/128\n=== CODEOWNERS\n     1\t*                         @acme/people-platform\n     2\t/prompts/                 @acme/people-platform @acme/hr-policy-reviewers\n     3\t/config/                  @acme/people-platform @acme/security-engineering\n     4\t/src/gateway.py           @acme/people-platform @acme/security-engineering\n     5\t/src/approvals.py         @acme/people-platform @acme/security-engineering\n     6\t/k8s/                     @acme/people-platform @acme/platform-security\n     7\t/migrations/              @acme/people-platform @acme/data-platform\n     8\t/release/                 @acme/people-platform @acme/security-engineering\n     9\t/.github/                 @acme/platform-security\n    10\t/CODEOWNERS               @acme/platform-security\n=== Dockerfile\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.12.7-slim-bookworm@sha256:032c52613401895aa3d418a4c5bf5c3ad0d5d6fe3c1e9b2c8b5d0a7e6f4c3b21 AS build\n     3\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     4\tWORKDIR /build\n     5\tCOPY requirements.txt .\n     6\tRUN pip install --require-hashes --only-binary=:all: --target /deps -r requirements.txt\n     7\t\n     8\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:7e4c1d2a9f3b8e60c5d47a19b2f03e8d6c1a5b94f7e2d03c8a6b1f5e9d4c2a70\n     9\tENV PYTHONPATH=/deps:/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1\n    10\tWORKDIR /app\n    11\tCOPY --from=build /deps /deps\n    12\tCOPY --chown=0:0 requirements.txt Dockerfile ./\n    13\tCOPY --chown=0:0 src/ src/\n    14\tCOPY --chown=0:0 prompts/ prompts/\n    15\tCOPY --chown=0:0 config/ config/\n    16\tUSER 65532:65532\n    17\tENTRYPOINT [\"python3\"]\n=== release/manifest.yaml\n     1\trelease:\n     2\t  name: hr-helpdesk-agent\n     3\t  version: \"1.8.0\"\n     4\t  git_sha: \"\"            # stamped by CI\n     5\t  agent_type_id: \"\"      # stamped by CI (src/type_id.py, scheme acme-agent-type-id/v1)\n     6\t  image:\n     7\t    repository: registry.acme.example/people/hr-helpdesk-agent\n     8\t    digest: \"\"           # stamped by CI\n     9\t    signer: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    10\t    sbom: attached (BuildKit SPDX)\n    11\t    provenance: SLSA v1 via actions/attest-build-provenance\n    12\t  owners:\n    13\t    accountable_party: \"VP People Operations\"\n    14\t    operational_owner: people-platform\n    15\t\n    16\tstakes:\n    17\t  rating: moderate\n    18\t  autonomy: low (every write requires the employee's confirmation)\n    19\t  rationale: >-\n    20\t    Reads one employee's own leave data and the handbook; writes are leave requests that a\n    21\t    manager must still approve in HRIS, and helpdesk tickets. Worst credible harm: disclosure of\n    22\t    one employee's HR data to another employee, or a misleading policy answer.\n    23\t  approved_by: \"Head of Security Engineering, 2026-09-19\"\n    24\t\n    25\tcapability_combination:\n    26\t  untrusted_input: yes (employee messages, handbook passages, tool output)\n    27\t  sensitive_access: yes (leave records, employee-specific HR documents)\n    28\t  external_change_or_send: yes (leave requests, helpdesk tickets)\n    29\t  containment: every consequential tool requires per-action employee approval bound to args\n    30\t\n    31\tharness:\n    32\t  files: [src/]\n    33\t  entrypoints: {agent: \"src.main:app\", gateway: \"src.gateway:app\"}\n    34\tsystem_prompt: {path: prompts/system.md}\n    35\trules_files: []\n    36\tconfiguration: [config/agent.yaml, config/tools.yaml]\n    37\t\n    38\tmodels:\n    39\t  primary:\n    40\t    role: main agent\n    41\t    owner: people-platform\n    42\t    identity: {provider: anthropic, id: claude-sonnet-4-5-20250929, pinning: snapshot, adapter: none}\n    43\t    pinning_source: \"Anthropic models overview, checked 2026-09-15\"\n    44\t    served_version: recorded per call in audit.events.model_served\n    45\t    fine_tune: none\n    46\t    training_runs: not applicable\n    47\t    training_data: provider-undisclosed\n    48\t  helpers: []            # retrieval is Postgres full-text search; no embedding or reranker model\n    49\t\n    50\ttools:\n    51\t  built_in: []\n    52\t  local: [search_policies]\n    53\t  mcp_servers:\n    54\t    - {id: hris, identity: \"spiffe://acme.example/ns/hris/sa/hris-mcp\", owner: hris-platform, tools: [get_leave_balance, file_leave_request]}\n    55\t    - {id: helpdesk, identity: \"spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\", owner: it-service-desk, tools: [create_ticket]}\n    56\t  policy_version_source: config/tools.yaml#policy_version\n    57\t\n    58\tpermissions:\n    59\t  sts_scopes: [hr.policy.read, hris.leave.read, hris.leave.request, helpdesk.ticket.create]\n    60\t  token_ttl_seconds: 300\n    61\t  database_role: hr_agent (see migrations/001_init.sql grants)\n    62\t\n    63\tmemory: none (conversation state is held per run and discarded; no cross-run memory)\n    64\tretrieval:\n    65\t  store: retrieval.chunks (Postgres FTS)\n    66\t  writers: [hr_docs_ingest]\n    67\t  filters: [quarantined, expires_at, audience/allowed_employees]\n    68\t\n    69\tidentity_bindings:\n    70\t  agent: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n    71\t  gateway: spiffe://acme.example/ns/hr-agent/sa/hr-tool-gateway\n    72\t\n    73\tnetwork: [k8s/networkpolicy.yaml]\n    74\tadmission: [k8s/admission.yaml]\n    75\tbudgets: config/agent.yaml#budgets\n    76\t\n    77\taudit:\n    78\t  store: audit.events, audit.gateway_decisions (Postgres, weekly partitions)\n    79\t  retention: 6 months\n    80\t  readers: hr_audit_reader\n=== .github/workflows/release.yml\n     1\tname: release\n     2\t\n     3\ton:\n     4\t  push:\n     5\t    branches: [main]\n     6\t\n     7\tpermissions:\n     8\t  contents: read\n     9\t\n    10\tjobs:\n    11\t  build:\n    12\t    runs-on: ubuntu-24.04\n    13\t    environment: production   # requires approval from @acme/people-platform-release\n    14\t    permissions:\n    15\t      contents: read\n    16\t      packages: write\n    17\t      id-token: write\n    18\t      attestations: write\n    19\t    env:\n    20\t      PYTHONDONTWRITEBYTECODE: \"1\"\n    21\t      IMAGE: registry.acme.example/people/hr-helpdesk-agent\n    22\t    steps:\n    23\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    24\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    25\t        with: {python-version: \"3.12.7\"}\n    26\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    27\t        with: {cosign-release: \"v2.6.2\"}\n    28\t      - run: pip install --require-hashes -r requirements.txt\n    29\t      - run: python -m pytest -q tests/release\n    30\t      - name: Build and push\n    31\t        id: build\n    32\t        uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    33\t        with:\n    34\t          push: true\n    35\t          tags: ${{ env.IMAGE }}:${{ github.sha }}\n    36\t          sbom: true\n    37\t          provenance: mode=max\n    38\t      - name: Sign image\n    39\t        run: cosign sign --yes \"${IMAGE}@${{ steps.build.outputs.digest }}\"\n    40\t      - uses: actions/attest-build-provenance@e8998f949152b193b063cb0ec769d69d929409be # v2.4.0\n    41\t        with:\n    42\t          subject-name: ${{ env.IMAGE }}\n    43\t          subject-digest: ${{ steps.build.outputs.digest }}\n    44\t          push-to-registry: true\n    45\t      - name: Compute agent-type-id\n    46\t        id: typeid\n    47\t        run: |\n    48\t          python -m src.type_id \"${{ steps.build.outputs.digest }}\" > type-id.json\n    49\t          echo \"id=$(jq -r .agent_type_id type-id.json)\" >> \"$GITHUB_OUTPUT\"\n    50\t      - name: Stamp release manifest\n    51\t        run: |\n    52\t          yq -i '.release.agent_type_id = \"${{ steps.typeid.outputs.id }}\" |\n    53\t                 .release.image.digest = \"${{ steps.build.outputs.digest }}\" |\n    54\t                 .release.git_sha = \"${{ github.sha }}\"' release/manifest.yaml\n    55\t      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\n    56\t        with:\n    57\t          name: release-${{ github.sha }}\n    58\t          path: [type-id.json, release/manifest.yaml]\n    59\t\n    60\t  deploy:\n    61\t    needs: build\n    62\t    runs-on: ubuntu-24.04\n    63\t    environment: production\n    64\t    permissions: {contents: read, id-token: write}\n    65\t    steps:\n    66\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    67\t      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0\n    68\t        with: {name: \"release-${{ github.sha }}\"}\n    69\t      - name: Render and apply\n    70\t        run: |\n    71\t          export IMAGE_DIGEST=$(yq -r .release.image.digest release/manifest.yaml)\n    72\t          export AGENT_TYPE_ID=$(yq -r .release.agent_type_id release/manifest.yaml)\n    73\t          export GIT_SHA=${{ github.sha }}\n    74\t          for f in k8s/*.yaml; do envsubst '$IMAGE_DIGEST $AGENT_TYPE_ID $GIT_SHA' < \"$f\"; echo '---'; done \\\n    75\t            | kubectl apply --server-side -f -\n=== config/agent.yaml\n     1\tagent:\n     2\t  name: hr-helpdesk\n     3\t  accountable_party: \"VP People Operations <people-ops-lead@acme.example>\"\n     4\t  operational_owner: \"people-platform (pager: people-platform-oncall)\"\n     5\t  tenant: acme\n     6\t  workload_identity: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n     7\t\n     8\tmodel:\n     9\t  provider: anthropic\n    10\t  id: claude-sonnet-4-5-20250929\n    11\t  pinning: snapshot          # dated snapshot ID per provider model docs, checked 2026-09-15\n    12\t  adapter: none\n    13\t  max_output_tokens: 1024\n    14\t  temperature: 0.2\n    15\t\n    16\tbudgets:\n    17\t  run:\n    18\t    max_steps: 12\n    19\t    max_wall_seconds: 90\n    20\t    max_total_tokens: 60000\n    21\t    max_cost_usd: 0.40\n    22\t    max_tool_calls_per_minute: 20\n    23\t    max_subagents: 0\n    24\t  quotas:\n    25\t    - scope: user\n    26\t      window_seconds: 86400\n    27\t      max_runs: 150\n    28\t      max_tokens: 400000\n    29\t      max_cost_usd: 3.00\n    30\t    - scope: tenant\n    31\t      window_seconds: 3600\n    32\t      max_runs: 20000\n    33\t      max_tokens: 15000000\n    34\t      max_cost_usd: 250.00\n    35\t    - scope: fleet\n    36\t      window_seconds: 3600\n    37\t      max_runs: 25000\n    38\t      max_tokens: 20000000\n    39\t      max_cost_usd: 300.00\n    40\t\n    41\tpricing:\n    42\t  input_per_mtok: 3.00\n    43\t  output_per_mtok: 15.00\n    44\t  cache_read_per_mtok: 0.30\n    45\t\n    46\tapprovals:\n    47\t  ttl_seconds: 600\n    48\t\n    49\tstop:\n    50\t  poll_seconds: 2\n    51\t  max_stop_seconds: 10\n    52\t\n    53\tretrieval:\n    54\t  top_k: 5\n    55\t  cache_ttl_seconds: 900\n    56\t  max_chunk_chars: 4000\n    57\t\n    58\tlimits:\n    59\t  max_tool_output_bytes: 16384\n    60\t  max_user_message_chars: 4000\n    61\t\n    62\toutput:\n    63\t  allowed_link_hosts: [hr.acme.example, handbook.acme.example]\n=== migrations/001_init.sql\n     1\t-- Roles (created by the platform team): hr_agent, hr_gateway, hr_agent_operator,\n     2\t-- hr_audit_reader, hr_audit_maint, hr_docs_ingest.\n     3\tCREATE SCHEMA audit; CREATE SCHEMA control; CREATE SCHEMA approvals; CREATE SCHEMA quota; CREATE SCHEMA retrieval;\n     4\t\n     5\tCREATE TABLE audit.events (\n     6\t    event_id uuid NOT NULL, ts timestamptz NOT NULL, event_type text NOT NULL,\n     7\t    run_id uuid NOT NULL, step_id uuid, parent_step_id uuid,\n     8\t    accountable_party text NOT NULL, operational_owner text NOT NULL, tenant text NOT NULL,\n     9\t    agent_type_id text NOT NULL, agent_instance_id text NOT NULL,\n    10\t    trace_id char(32) NOT NULL, span_id char(16) NOT NULL, traceparent text NOT NULL,\n    11\t    delegated_subject text NOT NULL, agent_principal text NOT NULL,\n    12\t    tool text, operation_target text, decision text, reason text, policy_version text NOT NULL, approval_id uuid,\n    13\t    args_redacted jsonb, result_redacted jsonb,\n    14\t    context_tokens integer, context_tokens_method text, model_requested text, model_served text,\n    15\t    PRIMARY KEY (event_id, ts)\n    16\t) PARTITION BY RANGE (ts);\n    17\tCREATE INDEX ON audit.events (trace_id);\n    18\tCREATE INDEX ON audit.events (run_id, ts);\n    19\t\n    20\tCREATE TABLE audit.gateway_decisions (\n    21\t    ts timestamptz NOT NULL, traceparent text NOT NULL, tenant text NOT NULL,\n    22\t    accountable_party text NOT NULL, operational_owner text NOT NULL,\n    23\t    agent_type_id_hint text NOT NULL, agent_instance_hint text NOT NULL,   -- caller-supplied; join key only\n    24\t    subject text, actor text, tool text, decision text NOT NULL, reason text, policy_version text NOT NULL\n    25\t) PARTITION BY RANGE (ts);\n    26\t\n    27\t-- Creates `ahead` partitions into the future and drops partitions older than the newest `keep`.\n    28\tCREATE FUNCTION audit.maintain_partitions(parent regclass, period interval, ahead int, keep int)\n    29\tRETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = audit, pg_temp AS $$\n    30\tDECLARE\n    31\t    start_ts timestamptz := date_trunc('week', now());\n    32\t    part record;\n    33\tBEGIN\n    34\t    FOR i IN 0..ahead LOOP\n    35\t        EXECUTE format('CREATE TABLE IF NOT EXISTS %s_%s PARTITION OF %s FOR VALUES FROM (%L) TO (%L)',\n    36\t                       parent, to_char(start_ts + i * period, 'IYYY\"w\"IW'), parent,\n    37\t                       start_ts + i * period, start_ts + (i + 1) * period);\n    38\t    END LOOP;\n    39\t    FOR part IN\n    40\t        SELECT c.oid::regclass AS rel FROM pg_inherits i JOIN pg_class c ON c.oid = i.inhrelid\n    41\t         WHERE i.inhparent = parent ORDER BY c.relname DESC OFFSET keep + ahead + 1\n    42\t    LOOP\n    43\t        EXECUTE format('DROP TABLE %s', part.rel);\n    44\t    END LOOP;\n    45\tEND $$;\n    46\t\n    47\tCREATE TABLE control.stop_flags (\n    48\t    flag_id bigserial PRIMARY KEY,\n    49\t    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n    50\t    value text, active boolean NOT NULL DEFAULT true, reason text NOT NULL,\n    51\t    set_by text NOT NULL DEFAULT current_user, set_at timestamptz NOT NULL DEFAULT now()\n    52\t);\n    53\t\n    54\tCREATE TABLE approvals.grants (\n    55\t    approval_id uuid PRIMARY KEY, run_id uuid NOT NULL, agent_instance_id text NOT NULL, subject text N","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-action-v4fnrafp/20e6f499-b917-4f5e-8f29-138bc3300ddc/tool-results/brrrqscbz.txt","persistedOutputSize":42605},"tool_result_meta":[{"id":"toolu_01Ko61UTDvWFQnijjHcjMJwD","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
