{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VVYekfMQAe7Fuxp7pKhkZJ","type":"tool_result","content":"45\t    44\tclass Agent:\n46\t    45\t    def __init__(self, cfg: dict[str, Any], registry: ToolRegistry, llm: AsyncAnthropic, gateway: GatewayClient,\n47\t    46\t                 index: PolicyIndex, approvals: ApprovalStore, quotas: QuotaStore, audit: AuditWriter, stop: StopControl):\n48\t    47\t        self.cfg, self.registry, self.llm, self.gateway = cfg, registry, llm, gateway\n49\t    48\t        self.index, self.approvals, self.quotas, self.audit, self.stop = index, approvals, quotas, audit, stop\n50\t    49\t\n51\t    50\t    def new_state(self, user_text: str, subject_token: str) -> RunState:\n52\t    51\t        budget = RunBudget(self.cfg[\"budgets\"][\"run\"], self.cfg[\"pricing\"])\n53\t    52\t        return RunState(messages=[{\"role\": \"user\", \"content\": user_text}], budget=budget, subject_token=subject_token)\n54\t    53\t\n55\t    54\t    async def run(self, ctx: RunContext, state: RunState) -> RunState:\n56\t    55\t        with tracer.start_as_current_span(\"agent.run\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n57\t    56\t            try:\n58\t    57\t                await self._loop(ctx, state)\n59\t    58\t            except BudgetExceeded as exc:\n60\t    59\t                await self.audit.record(ctx, \"budget_stop\", decision=\"stop\", reason=exc.limit, parent_step_id=state.last_step)\n61\t    60\t                state.status, state.reply = \"stopped\", \"I've reached the limit for this conversation. An HR advisor can help further.\"\n62\t    61\t            return state\n63\t    62\t\n64\t    63\t    async def _loop(self, ctx: RunContext, state: RunState) -> None:\n65\t    64\t        model = self.cfg[\"model\"]\n66\t    65\t        while True:\n67\t    66\t            await self.stop.raise_if_stopped(ctx)\n68\t    67\t            state.budget.check_step()\n69\t    68\t            step_id = str(uuid.uuid4())\n70\t    69\t            with tracer.start_as_current_span(\"gen_ai.chat\", attributes={\"gen_ai.request.model\": model[\"id\"]}):\n71\t    70\t                resp = await self.llm.messages.create(\n72\t    71\t                    model=model[\"id\"], system=SYSTEM_PROMPT, max_tokens=model[\"max_output_tokens\"],\n73\t    72\t                    temperature=model[\"temperature\"], tools=self.registry.model_schemas(), messages=state.messages,\n74\t    73\t                    timeout=state.budget.remaining_seconds(),\n75\t    74\t                )\n76\t    75\t                tokens, cost = state.budget.record_usage(resp.usage)\n77\t    76\t                ctx_tokens = resp.usage.input_tokens + (resp.usage.cache_read_input_tokens or 0) + (resp.usage.cache_creation_input_tokens or 0)\n78\t    77\t                await self.audit.record(\n79\t    78\t                    ctx, \"model_call\", step_id=step_id, parent_step_id=state.last_step,\n80\t    79\t                    context_tokens=ctx_tokens, context_tokens_method=\"measured:provider_usage_input+cache_read+cache_write\",\n81\t    80\t                    model_requested=model[\"id\"], model_served=resp.model, result={\"stop_reason\": resp.stop_reason},\n82\t    81\t                )\n83\t    82\t                await self.quotas.record_usage(ctx, tokens, cost)\n84\t    83\t            state.last_step = step_id\n85\t    84\t            state.messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n86\t    85\t            if resp.stop_reason != \"tool_use\":\n87\t    86\t                state.status = \"done\"\n88\t    87\t                state.reply = \"\".join(b.text for b in resp.content if b.type == \"text\")\n89\t    88\t                return\n90\t    89\t            results = []\n91\t    90\t            for block in (b for b in resp.content if b.type == \"tool_use\"):\n92\t    91\t                result = await self._handle_tool(ctx, state, step_id, block.id, block.name, block.input)\n93\t    92\t                if result is None:  # paused for employee approval\n94\t    93\t                    return\n95\t    94\t                results.append(result)\n96\t    95\t            state.messages.append({\"role\": \"user\", \"content\": results})\n97\t    96\t\n98\t    97\t    async def _handle_tool(self, ctx: RunContext, state: RunState, parent: str, tool_use_id: str,\n99\t    98\t                           name: str, args: Any) -> dict[str, Any] | None:\n100\t    99\t        step_id = str(uuid.uuid4())\n101\t   100\t        await self.audit.record(ctx, \"proposed_action\", step_id=step_id, parent_step_id=parent, tool=name, args=args)\n102\t   101\t        spec = self.registry.get(name)\n103\t   102\t        if spec is None:\n104\t   103\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=name, decision=\"deny\", reason=\"tool not in allowlist\")\n105\t   104\t            return _tool_result(tool_use_id, \"This tool is not available.\", error=True)\n106\t   105\t        target = spec.target(ctx.subject)\n107\t   106\t        state.budget.check_tool_call()\n108\t   107\t        try:\n109\t   108\t            args = validate_tool_args(spec, args)\n110\t   109\t        except ValidationRejected as exc:\n111\t   110\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target,\n112\t   111\t                                    decision=\"deny\", reason=exc.reason, args=args)\n113\t   112\t            return _tool_result(tool_use_id, f\"Invalid arguments: {exc.reason}\", error=True)\n114\t   113\t        if spec.approval == \"subject\":\n115\t   114\t            approval_id, text = await self.approvals.request(ctx, spec.qualified, target, args, tool_use_id)\n116\t   115\t            await self.audit.record(ctx, \"approval_requested\", step_id=step_id, tool=spec.qualified, target=target,\n117\t   116\t                                    decision=\"hold\", approval_id=approval_id, args=args)\n118\t   117\t            state.status = \"awaiting_approval\"\n119\t   118\t            state.pending_approval = {\"approval_id\": approval_id, \"description\": text}\n120\t   119\t            return None\n121\t   120\t        await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target, decision=\"allow\")\n122\t   121\t        return await self._execute(ctx, state, step_id, tool_use_id, spec, target, args, approval_id=None)\n123\t   122\t\n124\t   123\t    async def resume_with_approval(self, ctx: RunContext, state: RunState, approval_id: str) -> RunState:\n125\t   124\t        with tracer.start_as_current_span(\"agent.resume\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n126\t   125\t            pending = await self.approvals.pending(approval_id)\n127\t   126\t            if pending is None or pending[\"run_id\"] != ctx.run_id:\n128\t   127\t                raise ApprovalInvalid(\"unknown approval for this run\")\n129\t   128\t            spec = self.registry.by_qualified(pending[\"operation\"])\n130\t   129\t            step_id = str(uuid.uuid4())\n131\t   130\t            try:\n132\t   131\t                await self.stop.raise_if_stopped(ctx)\n133\t   132\t                args = validate_tool_args(spec, pending[\"args\"])\n134\t   133\t                target = spec.target(ctx.subject)\n135\t   134\t                await self._recheck_state(ctx, state, spec, args)\n136\t   135\t                grant = await self.approvals.consume(ctx, approval_id, spec.qualified, target, args)\n137\t   136\t            except (ApprovalInvalid, ValidationRejected, ToolDenied, ToolError) as exc:\n138\t   137\t                await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=pending[\"operation\"],\n139\t   138\t                                        decision=\"deny\", reason=str(exc), approval_id=approval_id)\n140\t   139\t                state.status, state.reply = \"done\", \"That action can no longer be carried out as approved.\"\n141\t   140\t                return state\n142\t   141\t            await self.audit.record(ctx, \"approval_used\", step_id=step_id, parent_step_id=state.last_step,\n143\t   142\t                                    tool=spec.qualified, target=target, decision=\"allow\", approval_id=approval_id,\n144\t   143\t                                    result={\"approved_by\": grant[\"approved_by\"], \"approved_at\": grant[\"approved_at\"].isoformat()})\n145\t   144\t            result = await self._execute(ctx, state, step_id, pending[\"tool_use_id\"], spec, target, args, approval_id=approval_id)\n146\t   145\t            state.messages.append({\"role\": \"user\", \"content\": [result]})\n147\t   146\t            state.status, state.pending_approval = \"running\", None\n148\t   147\t            return await self.run(ctx, state)\n149\t   148\t\n150\t   149\t    async def _recheck_state(self, ctx: RunContext, state: RunState, spec: ToolSpec, args: dict[str, Any]) -> None:\n151\t   150\t        \"\"\"Re-read the resource the action depends on, at execution time.\"\"\"\n152\t   151\t        if spec.qualified != \"hris/file_leave_request\" or args[\"leave_type\"] == \"unpaid\":\n153\t   152\t            return\n154\t   153\t        balance_spec = self.registry.get(\"get_leave_balance\")\n155\t   154\t        bal = await self.gateway.call(balance_spec, {\"leave_type\": args[\"leave_type\"]}, ctx, state.subject_token,\n156\t   155\t                                      operation_id=str(uuid.uuid4()))\n157\t   156\t        bal = validate_tool_output(balance_spec, bal, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n158\t   157\t        days = (date.fromisoformat(args[\"end_date\"]) - date.fromisoformat(args[\"start_date\"])).days + 1\n159\t   158\t        if days <= 0 or bal[\"balance_days\"] < days:\n160\t   159\t            raise ApprovalInvalid(\"leave balance no longer covers the request\")\n161\t   160\t\n162\t   161\t    async def _execute(self, ctx: RunContext, state: RunState, step_id: str, tool_use_id: str, spec: ToolSpec,\n163\t   162\t                       target: str, args: dict[str, Any], approval_id: str | None) -> dict[str, Any]:\n164\t   163\t        operation_id = approval_id or str(uuid.uuid4())\n165\t   164\t        with tracer.start_as_current_span(f\"execute_tool {spec.qualified}\", attributes={\"gen_ai.tool.name\": spec.name}):\n166\t   165\t            try:\n167\t   166\t                if spec.kind == \"local\":\n168\t   167\t                    raw = await self.index.search(args[\"query\"], ctx.subject)\n169\t   168\t                    max_chars = self.cfg[\"retrieval\"][\"max_chunk_chars\"]\n170\t   169\t                    clean: Any = []\n171\t   170\t                    for chunk in raw:\n172\t   171\t                        try:\n173\t   172\t                            clean.append(validate_chunk(chunk, max_chars))\n174\t   173\t                        except ValidationRejected as exc:\n175\t   174\t                            await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified,\n176\t   175\t                                                    decision=\"hold\", reason=exc.reason, result={\"chunk_id\": chunk[\"chunk_id\"]})\n177\t   176\t                else:\n178\t   177\t                    raw = await self.gateway.call(spec, args, ctx, state.subject_token, operation_id=operation_id)\n179\t   178\t                    clean = validate_tool_output(spec, raw, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n180\t   179\t            except ToolDenied as exc:\n181\t   180\t                await self.audit.record(ctx, \"tool_denied\", step_id=step_id, tool=spec.qualified, target=target,\n182\t   181\t                                        decision=\"deny\", reason=exc.reason, approval_id=approval_id, args=args)\n183\t   182\t                return _tool_result(tool_use_id, \"The request was refused by policy.\", error=True)\n184\t   183\t            except ToolError as exc:\n185\t   184\t                await self.audit.record(ctx, \"tool_error\", step_id=step_id, tool=spec.qualified, target=target,\n186\t   185\t                                        decision=\"error\", reason=f\"status {exc.status}\", approval_id=approval_id,\n187\t   186\t                                        args=args, result={\"detail\": exc.detail})\n188\t   187\t                log.warning(\"tool error\", extra={\"tool\": spec.qualified, \"detail\": redact(exc.detail)})\n189\t   188\t                return _tool_result(tool_use_id, f\"{spec.name} failed: {exc.detail}\", error=True)\n190\t   189\t            except ValidationRejected as exc:\n191\t   190\t                await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified, target=target,\n192\t   191\t                                        decision=\"hold\", reason=exc.reason, approval_id=approval_id)\n193\t   192\t                return _tool_result(tool_use_id, \"The tool returned data that could not be used.\", error=True)\n194\t   193\t        await self.audit.record(ctx, \"tool_result\", step_id=step_id, tool=spec.qualified, target=target,\n195\t   194\t                                decision=\"ok\", approval_id=approval_id, args=args, result=clean)\n196\t   195\t        envelope = {\"source\": spec.qualified, \"trust\": \"untrusted_data\", \"data\": clean}\n197\t   196\t        return _tool_result(tool_use_id, json.dumps(envelope, ensure_ascii=False))\n198\t   197\t\n199\t   198\t\n200\t   199\tdef _tool_result(tool_use_id: str, content: str, error: bool = False) -> dict[str, Any]:\n201\t   200\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"content\": content, \"is_error\": error}\n202\t=== src/approvals.py\n203\t     1\t\"\"\"Approval records for consequential tool calls.\n204\t     2\t\n205\t     3\tAn approval is bound to one agent instance, one operation, one target and the SHA-256 of\n206\t     4\tthe canonical arguments. Only the employee on whose behalf the run acts may approve, they\n207\t     5\tsee a rendered description of the exact action, and each approval is consumed once.\n208\t     6\t\"\"\"\n209\t     7\tfrom __future__ import annotations\n210\t     8\t\n211\t     9\timport hashlib\n212\t    10\timport json\n213\t    11\timport uuid\n214\t    12\tfrom datetime import timedelta\n215\t    13\tfrom typing import Any\n216\t    14\t\n217\t    15\timport asyncpg\n218\t    16\t\n219\t    17\tfrom .audit import RunContext\n220\t    18\t\n221\t    19\t\n222\t    20\tclass ApprovalInvalid(Exception):\n223\t    21\t    pass\n224\t    22\t\n225\t    23\t\n226\t    24\tdef args_digest(args: dict[str, Any]) -> str:\n227\t    25\t    canonical = json.dumps(args, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False)\n228\t    26\t    return hashlib.sha256(canonical.encode()).hexdigest()\n229\t    27\t\n230\t    28\t\n231\t    29\tdef describe(operation: str, target: str, args: dict[str, Any]) -> str:\n232\t    30\t    if operation == \"hris/file_leave_request\":\n233\t    31\t        return (f\"Submit a {args['leave_type']} leave request from {args['start_date']} to {args['end_date']} \"\n234\t    32\t                f\"for {target}. Your manager will be asked to approve it in HRIS.\")\n235\t    33\t    if operation == \"helpdesk/create_ticket\":\n236\t    34\t        return f\"Send this summary to an HR advisor ({args['category']}):\\n\\n{args['summary']}\"\n237\t    35\t    raise ValueError(operation)\n238\t    36\t\n239\t    37\t\n240\t    38\tclass ApprovalStore:\n241\t    39\t    def __init__(self, pool: asyncpg.Pool, ttl_seconds: int):\n242\t    40\t        self._pool = pool\n243\t    41\t        self._ttl = timedelta(seconds=ttl_seconds)\n244\t    42\t\n245\t    43\t    async def request(self, ctx: RunContext, operation: str, target: str, args: dict[str, Any], tool_use_id: str) -> tuple[str, str]:\n246\t    44\t        approval_id = str(uuid.uuid4())\n247\t    45\t        text = describe(operation, target, args)\n248\t    46\t        await self._pool.execute(\n249\t    47\t            \"\"\"INSERT INTO approvals.grants\n250\t    48\t                 (approval_id, run_id, agent_instance_id, subject, operation, target, args_sha256, args,\n251\t    49\t                  tool_use_id, description, requested_at, expires_at)\n252\t    50\t               VALUES ($1, $2, $3, $4, $5, $6, $7, $8::jsonb, $9, $10, now(), now() + $11)\"\"\",\n253\t    51\t            approval_id, ctx.run_id, ctx.agent_instance_id, ctx.subject, operation, target,\n254\t    52\t            args_digest(args), json.dumps(args), tool_use_id, text, self._ttl,\n255\t    53\t        )\n256\t    54\t        return approval_id, text\n257\t    55\t\n258\t    56\t    async def confirm(self, approval_id: str, approver: str) -> None:\n259\t    57\t        \"\"\"Called from the employee's authenticated session. Approver must be the run's subject.\"\"\"\n260\t    58\t        row = await self._pool.fetchrow(\n261\t    59\t            \"\"\"UPDATE approvals.grants SET approved_by = $2, approved_at = now()\n262\t    60\t                WHERE approval_id = $1 AND subject = $2 AND approved_at IS NULL AND expires_at > now()\n263\t    61\t                RETURNING approval_id\"\"\",\n264\t    62\t            approval_id, approver,\n265\t    63\t        )\n266\t    64\t        if row is None:\n267\t    65\t            raise ApprovalInvalid(\"not found, expired, already decided, or approver lacks authority\")\n268\t    66\t\n269\t    67\t    async def consume(self, ctx: RunContext, approval_id: str, operation: str, target: str, args: dict[str, Any]) -> dict[str, Any]:\n270\t    68\t        \"\"\"Atomically mark the approval used. Every binding is re-checked in the same statement.\"\"\"\n271\t    69\t        row = await self._pool.fetchrow(\n272\t    70\t            \"\"\"UPDATE approvals.grants SET used_at = now()\n273\t    71\t                WHERE approval_id = $1\n274\t    72\t                  AND used_at IS NULL\n275\t    73\t                  AND approved_at IS NOT NULL\n276\t    74\t                  AND approved_by = subject\n277\t    75\t                  AND expires_at > now()\n278\t    76\t                  AND agent_instance_id = $2\n279\t    77\t                  AND subject = $3\n280\t    78\t                  AND operation = $4\n281\t    79\t                  AND target = $5\n282\t    80\t                  AND args_sha256 = $6\n283\t    81\t                RETURNING approval_id, approved_by, approved_at, expires_at\"\"\",\n284\t    82\t            approval_id, ctx.agent_instance_id, ctx.subject, operation, target, args_digest(args),\n285\t    83\t        )\n286\t    84\t        if row is None:\n287\t    85\t            raise ApprovalInvalid(\"approval does not match this action, was used, or expired\")\n288\t    86\t        return dict(row)\n289\t    87\t\n290\t    88\t    async def pending(self, approval_id: str) -> dict[str, Any] | None:\n291\t    89\t        row = await self._pool.fetchrow(\n292\t    90\t            \"SELECT run_id, operation, target, args, tool_use_id FROM approvals.grants WHERE approval_id = $1\",\n293\t    91\t            approval_id,\n294\t    92\t        )\n295\t    93\t        if row is None:\n296\t    94\t            return None\n297\t    95\t        out = dict(row)\n298\t    96\t        out[\"args\"] = json.loads(out[\"args\"])\n299\t    97\t        return out\n300\t=== src/retrieval.py\n301\t     1\t\"\"\"Handbook search over retrieval.chunks (Postgres full-text search).\n302\t     2\t\n303\t     3\tChunks are written only by the hr-docs-ingest job (role hr_docs_ingest). Each chunk carries\n304\t     4\tsource, added_at, added_by, trust, an audience, an optional expiry and a quarantine flag.\n305\t     5\tEmployee-specific documents (offer letters, individual arrangements) have audience\n306\t     6\t'employee' and list the employees allowed to see them.\n307\t     7\t\"\"\"\n308\t     8\tfrom __future__ import annotations\n309\t     9\t\n310\t    10\timport hashlib\n311\t    11\timport time\n312\t    12\tfrom typing import Any\n313\t    13\t\n314\t    14\timport asyncpg\n315\t    15\t\n316\t    16\t_SEARCH = \"\"\"\n317\t    17\tSELECT c.chunk_id, c.source, c.trust, c.text,\n318\t    18\t       ts_rank(c.tsv, websearch_to_tsquery('english', $1)) AS rank\n319\t    19\t  FROM retrieval.chunks c\n320\t    20\t WHERE c.tsv @@ websearch_to_tsquery('english', $1)\n321\t    21\t   AND NOT c.quarantined\n322\t    22\t   AND (c.expires_at IS NULL OR c.expires_at > now())\n323\t    23\t   AND (c.audience = 'all' OR (c.audience = 'employee' AND $2 = ANY (c.allowed_employees)))\n324\t    24\t ORDER BY rank DESC\n325\t    25\t LIMIT $3\n326\t    26\t\"\"\"\n327\t    27\t\n328\t    28\t\n329\t    29\tclass PolicyIndex:\n330\t    30\t    def __init__(self, pool: asyncpg.Pool, top_k: int, cache_ttl: float):\n331\t    31\t        self._pool = pool\n332\t    32\t        self._top_k = top_k\n333\t    33\t        self._ttl = cache_ttl\n334\t    34\t        self._cache: dict[str, tuple[float, str, list[dict[str, Any]]]] = {}\n335\t    35\t\n336\t    36\t    async def _index_version(self) -> str:\n337\t    37\t        # Bumped by ingest on every add, expiry, quarantine or permission change.\n338\t    38\t        return await self._pool.fetchval(\"SELECT version FROM retrieval.index_state WHERE id = 1\")\n339\t    39\t\n340\t    40\t    def _key(self, query: str) -> str:\n341\t    41\t        normalized = \" \".join(query.lower().split())\n342\t    42\t        return hashlib.sha256(f\"{self._top_k}|{normalized}\".encode()).hexdigest()\n343\t    43\t\n344\t    44\t    async def search(self, query: str, employee_id: str) -> list[dict[str, Any]]:\n345\t    45\t        version = await self._index_version()\n346\t    46\t        key = self._key(query)\n347\t    47\t        hit = self._cache.get(key)\n348\t    48\t        if hit and hit[1] == version and time.monotonic() - hit[0] < self._ttl:\n349\t    49\t            return hit[2]\n350\t    50\t        rows = await self._pool.fetch(_SEARCH, query, employee_id, self._top_k)\n351\t    51\t        chunks = [dict(r) for r in rows]\n352\t    52\t        self._cache[key] = (time.monotonic(), version, chunks)\n353\t    53\t        return chunks\n354\t=== src/killswitch.py\n355\t     1\t\"\"\"Stop control. Flags live in control.stop_flags, which the agent's DB role can only read.\n356\t     2\t\n357\t     3\tOperators set flags with the hr_agent_operator role (see README \"Stopping the agent\").\n358\t     4\tThe tool gateway reads the same table, so a stopped instance is refused there too.\n359\t     5\t\"\"\"\n360\t     6\tfrom __future__ import annotations\n361\t     7\t\n362\t     8\timport asyncio\n363\t     9\timport logging\n364\t    10\t\n365\t    11\timport asyncpg\n366\t    12\t\n367\t    13\tfrom .audit import RunContext\n368\t    14\t\n369\t    15\tlog = logging.getLogger(\"hr_agent.stop\")\n370\t    16\t\n371\t    17\t_QUERY = \"\"\"\n372\t    18\tSELECT reason FROM control.stop_flags\n373\t    19\tWHERE active\n374\t    20\t  AND (   scope = 'fleet'"}]},"parent_tool_use_id":null,"session_id":"4970510a-de6f-4924-96ed-914c5d6811d1","uuid":"05fa6b54-e322-4554-ab0f-defe2daabd60","timestamp":"2026-11-21T11:31:39.268Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-action-v4fnrafp/20e6f499-b917-4f5e-8f29-138bc3300ddc/tool-results/bpj63kf9o.txt","content":"    44\tclass Agent:\n    45\t    def __init__(self, cfg: dict[str, Any], registry: ToolRegistry, llm: AsyncAnthropic, gateway: GatewayClient,\n    46\t                 index: PolicyIndex, approvals: ApprovalStore, quotas: QuotaStore, audit: AuditWriter, stop: StopControl):\n    47\t        self.cfg, self.registry, self.llm, self.gateway = cfg, registry, llm, gateway\n    48\t        self.index, self.approvals, self.quotas, self.audit, self.stop = index, approvals, quotas, audit, stop\n    49\t\n    50\t    def new_state(self, user_text: str, subject_token: str) -> RunState:\n    51\t        budget = RunBudget(self.cfg[\"budgets\"][\"run\"], self.cfg[\"pricing\"])\n    52\t        return RunState(messages=[{\"role\": \"user\", \"content\": user_text}], budget=budget, subject_token=subject_token)\n    53\t\n    54\t    async def run(self, ctx: RunContext, state: RunState) -> RunState:\n    55\t        with tracer.start_as_current_span(\"agent.run\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n    56\t            try:\n    57\t                await self._loop(ctx, state)\n    58\t            except BudgetExceeded as exc:\n    59\t                await self.audit.record(ctx, \"budget_stop\", decision=\"stop\", reason=exc.limit, parent_step_id=state.last_step)\n    60\t                state.status, state.reply = \"stopped\", \"I've reached the limit for this conversation. An HR advisor can help further.\"\n    61\t            return state\n    62\t\n    63\t    async def _loop(self, ctx: RunContext, state: RunState) -> None:\n    64\t        model = self.cfg[\"model\"]\n    65\t        while True:\n    66\t            await self.stop.raise_if_stopped(ctx)\n    67\t            state.budget.check_step()\n    68\t            step_id = str(uuid.uuid4())\n    69\t            with tracer.start_as_current_span(\"gen_ai.chat\", attributes={\"gen_ai.request.model\": model[\"id\"]}):\n    70\t                resp = await self.llm.messages.create(\n    71\t                    model=model[\"id\"], system=SYSTEM_PROMPT, max_tokens=model[\"max_output_tokens\"],\n    72\t                    temperature=model[\"temperature\"], tools=self.registry.model_schemas(), messages=state.messages,\n    73\t                    timeout=state.budget.remaining_seconds(),\n    74\t                )\n    75\t                tokens, cost = state.budget.record_usage(resp.usage)\n    76\t                ctx_tokens = resp.usage.input_tokens + (resp.usage.cache_read_input_tokens or 0) + (resp.usage.cache_creation_input_tokens or 0)\n    77\t                await self.audit.record(\n    78\t                    ctx, \"model_call\", step_id=step_id, parent_step_id=state.last_step,\n    79\t                    context_tokens=ctx_tokens, context_tokens_method=\"measured:provider_usage_input+cache_read+cache_write\",\n    80\t                    model_requested=model[\"id\"], model_served=resp.model, result={\"stop_reason\": resp.stop_reason},\n    81\t                )\n    82\t                await self.quotas.record_usage(ctx, tokens, cost)\n    83\t            state.last_step = step_id\n    84\t            state.messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n    85\t            if resp.stop_reason != \"tool_use\":\n    86\t                state.status = \"done\"\n    87\t                state.reply = \"\".join(b.text for b in resp.content if b.type == \"text\")\n    88\t                return\n    89\t            results = []\n    90\t            for block in (b for b in resp.content if b.type == \"tool_use\"):\n    91\t                result = await self._handle_tool(ctx, state, step_id, block.id, block.name, block.input)\n    92\t                if result is None:  # paused for employee approval\n    93\t                    return\n    94\t                results.append(result)\n    95\t            state.messages.append({\"role\": \"user\", \"content\": results})\n    96\t\n    97\t    async def _handle_tool(self, ctx: RunContext, state: RunState, parent: str, tool_use_id: str,\n    98\t                           name: str, args: Any) -> dict[str, Any] | None:\n    99\t        step_id = str(uuid.uuid4())\n   100\t        await self.audit.record(ctx, \"proposed_action\", step_id=step_id, parent_step_id=parent, tool=name, args=args)\n   101\t        spec = self.registry.get(name)\n   102\t        if spec is None:\n   103\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=name, decision=\"deny\", reason=\"tool not in allowlist\")\n   104\t            return _tool_result(tool_use_id, \"This tool is not available.\", error=True)\n   105\t        target = spec.target(ctx.subject)\n   106\t        state.budget.check_tool_call()\n   107\t        try:\n   108\t            args = validate_tool_args(spec, args)\n   109\t        except ValidationRejected as exc:\n   110\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target,\n   111\t                                    decision=\"deny\", reason=exc.reason, args=args)\n   112\t            return _tool_result(tool_use_id, f\"Invalid arguments: {exc.reason}\", error=True)\n   113\t        if spec.approval == \"subject\":\n   114\t            approval_id, text = await self.approvals.request(ctx, spec.qualified, target, args, tool_use_id)\n   115\t            await self.audit.record(ctx, \"approval_requested\", step_id=step_id, tool=spec.qualified, target=target,\n   116\t                                    decision=\"hold\", approval_id=approval_id, args=args)\n   117\t            state.status = \"awaiting_approval\"\n   118\t            state.pending_approval = {\"approval_id\": approval_id, \"description\": text}\n   119\t            return None\n   120\t        await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target, decision=\"allow\")\n   121\t        return await self._execute(ctx, state, step_id, tool_use_id, spec, target, args, approval_id=None)\n   122\t\n   123\t    async def resume_with_approval(self, ctx: RunContext, state: RunState, approval_id: str) -> RunState:\n   124\t        with tracer.start_as_current_span(\"agent.resume\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n   125\t            pending = await self.approvals.pending(approval_id)\n   126\t            if pending is None or pending[\"run_id\"] != ctx.run_id:\n   127\t                raise ApprovalInvalid(\"unknown approval for this run\")\n   128\t            spec = self.registry.by_qualified(pending[\"operation\"])\n   129\t            step_id = str(uuid.uuid4())\n   130\t            try:\n   131\t                await self.stop.raise_if_stopped(ctx)\n   132\t                args = validate_tool_args(spec, pending[\"args\"])\n   133\t                target = spec.target(ctx.subject)\n   134\t                await self._recheck_state(ctx, state, spec, args)\n   135\t                grant = await self.approvals.consume(ctx, approval_id, spec.qualified, target, args)\n   136\t            except (ApprovalInvalid, ValidationRejected, ToolDenied, ToolError) as exc:\n   137\t                await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=pending[\"operation\"],\n   138\t                                        decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   139\t                state.status, state.reply = \"done\", \"That action can no longer be carried out as approved.\"\n   140\t                return state\n   141\t            await self.audit.record(ctx, \"approval_used\", step_id=step_id, parent_step_id=state.last_step,\n   142\t                                    tool=spec.qualified, target=target, decision=\"allow\", approval_id=approval_id,\n   143\t                                    result={\"approved_by\": grant[\"approved_by\"], \"approved_at\": grant[\"approved_at\"].isoformat()})\n   144\t            result = await self._execute(ctx, state, step_id, pending[\"tool_use_id\"], spec, target, args, approval_id=approval_id)\n   145\t            state.messages.append({\"role\": \"user\", \"content\": [result]})\n   146\t            state.status, state.pending_approval = \"running\", None\n   147\t            return await self.run(ctx, state)\n   148\t\n   149\t    async def _recheck_state(self, ctx: RunContext, state: RunState, spec: ToolSpec, args: dict[str, Any]) -> None:\n   150\t        \"\"\"Re-read the resource the action depends on, at execution time.\"\"\"\n   151\t        if spec.qualified != \"hris/file_leave_request\" or args[\"leave_type\"] == \"unpaid\":\n   152\t            return\n   153\t        balance_spec = self.registry.get(\"get_leave_balance\")\n   154\t        bal = await self.gateway.call(balance_spec, {\"leave_type\": args[\"leave_type\"]}, ctx, state.subject_token,\n   155\t                                      operation_id=str(uuid.uuid4()))\n   156\t        bal = validate_tool_output(balance_spec, bal, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n   157\t        days = (date.fromisoformat(args[\"end_date\"]) - date.fromisoformat(args[\"start_date\"])).days + 1\n   158\t        if days <= 0 or bal[\"balance_days\"] < days:\n   159\t            raise ApprovalInvalid(\"leave balance no longer covers the request\")\n   160\t\n   161\t    async def _execute(self, ctx: RunContext, state: RunState, step_id: str, tool_use_id: str, spec: ToolSpec,\n   162\t                       target: str, args: dict[str, Any], approval_id: str | None) -> dict[str, Any]:\n   163\t        operation_id = approval_id or str(uuid.uuid4())\n   164\t        with tracer.start_as_current_span(f\"execute_tool {spec.qualified}\", attributes={\"gen_ai.tool.name\": spec.name}):\n   165\t            try:\n   166\t                if spec.kind == \"local\":\n   167\t                    raw = await self.index.search(args[\"query\"], ctx.subject)\n   168\t                    max_chars = self.cfg[\"retrieval\"][\"max_chunk_chars\"]\n   169\t                    clean: Any = []\n   170\t                    for chunk in raw:\n   171\t                        try:\n   172\t                            clean.append(validate_chunk(chunk, max_chars))\n   173\t                        except ValidationRejected as exc:\n   174\t                            await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified,\n   175\t                                                    decision=\"hold\", reason=exc.reason, result={\"chunk_id\": chunk[\"chunk_id\"]})\n   176\t                else:\n   177\t                    raw = await self.gateway.call(spec, args, ctx, state.subject_token, operation_id=operation_id)\n   178\t                    clean = validate_tool_output(spec, raw, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n   179\t            except ToolDenied as exc:\n   180\t                await self.audit.record(ctx, \"tool_denied\", step_id=step_id, tool=spec.qualified, target=target,\n   181\t                                        decision=\"deny\", reason=exc.reason, approval_id=approval_id, args=args)\n   182\t                return _tool_result(tool_use_id, \"The request was refused by policy.\", error=True)\n   183\t            except ToolError as exc:\n   184\t                await self.audit.record(ctx, \"tool_error\", step_id=step_id, tool=spec.qualified, target=target,\n   185\t                                        decision=\"error\", reason=f\"status {exc.status}\", approval_id=approval_id,\n   186\t                                        args=args, result={\"detail\": exc.detail})\n   187\t                log.warning(\"tool error\", extra={\"tool\": spec.qualified, \"detail\": redact(exc.detail)})\n   188\t                return _tool_result(tool_use_id, f\"{spec.name} failed: {exc.detail}\", error=True)\n   189\t            except ValidationRejected as exc:\n   190\t                await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified, target=target,\n   191\t                                        decision=\"hold\", reason=exc.reason, approval_id=approval_id)\n   192\t                return _tool_result(tool_use_id, \"The tool returned data that could not be used.\", error=True)\n   193\t        await self.audit.record(ctx, \"tool_result\", step_id=step_id, tool=spec.qualified, target=target,\n   194\t                                decision=\"ok\", approval_id=approval_id, args=args, result=clean)\n   195\t        envelope = {\"source\": spec.qualified, \"trust\": \"untrusted_data\", \"data\": clean}\n   196\t        return _tool_result(tool_use_id, json.dumps(envelope, ensure_ascii=False))\n   197\t\n   198\t\n   199\tdef _tool_result(tool_use_id: str, content: str, error: bool = False) -> dict[str, Any]:\n   200\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"content\": content, \"is_error\": error}\n=== src/approvals.py\n     1\t\"\"\"Approval records for consequential tool calls.\n     2\t\n     3\tAn approval is bound to one agent instance, one operation, one target and the SHA-256 of\n     4\tthe canonical arguments. Only the employee on whose behalf the run acts may approve, they\n     5\tsee a rendered description of the exact action, and each approval is consumed once.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport json\n    11\timport uuid\n    12\tfrom datetime import timedelta\n    13\tfrom typing import Any\n    14\t\n    15\timport asyncpg\n    16\t\n    17\tfrom .audit import RunContext\n    18\t\n    19\t\n    20\tclass ApprovalInvalid(Exception):\n    21\t    pass\n    22\t\n    23\t\n    24\tdef args_digest(args: dict[str, Any]) -> str:\n    25\t    canonical = json.dumps(args, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False)\n    26\t    return hashlib.sha256(canonical.encode()).hexdigest()\n    27\t\n    28\t\n    29\tdef describe(operation: str, target: str, args: dict[str, Any]) -> str:\n    30\t    if operation == \"hris/file_leave_request\":\n    31\t        return (f\"Submit a {args['leave_type']} leave request from {args['start_date']} to {args['end_date']} \"\n    32\t                f\"for {target}. Your manager will be asked to approve it in HRIS.\")\n    33\t    if operation == \"helpdesk/create_ticket\":\n    34\t        return f\"Send this summary to an HR advisor ({args['category']}):\\n\\n{args['summary']}\"\n    35\t    raise ValueError(operation)\n    36\t\n    37\t\n    38\tclass ApprovalStore:\n    39\t    def __init__(self, pool: asyncpg.Pool, ttl_seconds: int):\n    40\t        self._pool = pool\n    41\t        self._ttl = timedelta(seconds=ttl_seconds)\n    42\t\n    43\t    async def request(self, ctx: RunContext, operation: str, target: str, args: dict[str, Any], tool_use_id: str) -> tuple[str, str]:\n    44\t        approval_id = str(uuid.uuid4())\n    45\t        text = describe(operation, target, args)\n    46\t        await self._pool.execute(\n    47\t            \"\"\"INSERT INTO approvals.grants\n    48\t                 (approval_id, run_id, agent_instance_id, subject, operation, target, args_sha256, args,\n    49\t                  tool_use_id, description, requested_at, expires_at)\n    50\t               VALUES ($1, $2, $3, $4, $5, $6, $7, $8::jsonb, $9, $10, now(), now() + $11)\"\"\",\n    51\t            approval_id, ctx.run_id, ctx.agent_instance_id, ctx.subject, operation, target,\n    52\t            args_digest(args), json.dumps(args), tool_use_id, text, self._ttl,\n    53\t        )\n    54\t        return approval_id, text\n    55\t\n    56\t    async def confirm(self, approval_id: str, approver: str) -> None:\n    57\t        \"\"\"Called from the employee's authenticated session. Approver must be the run's subject.\"\"\"\n    58\t        row = await self._pool.fetchrow(\n    59\t            \"\"\"UPDATE approvals.grants SET approved_by = $2, approved_at = now()\n    60\t                WHERE approval_id = $1 AND subject = $2 AND approved_at IS NULL AND expires_at > now()\n    61\t                RETURNING approval_id\"\"\",\n    62\t            approval_id, approver,\n    63\t        )\n    64\t        if row is None:\n    65\t            raise ApprovalInvalid(\"not found, expired, already decided, or approver lacks authority\")\n    66\t\n    67\t    async def consume(self, ctx: RunContext, approval_id: str, operation: str, target: str, args: dict[str, Any]) -> dict[str, Any]:\n    68\t        \"\"\"Atomically mark the approval used. Every binding is re-checked in the same statement.\"\"\"\n    69\t        row = await self._pool.fetchrow(\n    70\t            \"\"\"UPDATE approvals.grants SET used_at = now()\n    71\t                WHERE approval_id = $1\n    72\t                  AND used_at IS NULL\n    73\t                  AND approved_at IS NOT NULL\n    74\t                  AND approved_by = subject\n    75\t                  AND expires_at > now()\n    76\t                  AND agent_instance_id = $2\n    77\t                  AND subject = $3\n    78\t                  AND operation = $4\n    79\t                  AND target = $5\n    80\t                  AND args_sha256 = $6\n    81\t                RETURNING approval_id, approved_by, approved_at, expires_at\"\"\",\n    82\t            approval_id, ctx.agent_instance_id, ctx.subject, operation, target, args_digest(args),\n    83\t        )\n    84\t        if row is None:\n    85\t            raise ApprovalInvalid(\"approval does not match this action, was used, or expired\")\n    86\t        return dict(row)\n    87\t\n    88\t    async def pending(self, approval_id: str) -> dict[str, Any] | None:\n    89\t        row = await self._pool.fetchrow(\n    90\t            \"SELECT run_id, operation, target, args, tool_use_id FROM approvals.grants WHERE approval_id = $1\",\n    91\t            approval_id,\n    92\t        )\n    93\t        if row is None:\n    94\t            return None\n    95\t        out = dict(row)\n    96\t        out[\"args\"] = json.loads(out[\"args\"])\n    97\t        return out\n=== src/retrieval.py\n     1\t\"\"\"Handbook search over retrieval.chunks (Postgres full-text search).\n     2\t\n     3\tChunks are written only by the hr-docs-ingest job (role hr_docs_ingest). Each chunk carries\n     4\tsource, added_at, added_by, trust, an audience, an optional expiry and a quarantine flag.\n     5\tEmployee-specific documents (offer letters, individual arrangements) have audience\n     6\t'employee' and list the employees allowed to see them.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport time\n    12\tfrom typing import Any\n    13\t\n    14\timport asyncpg\n    15\t\n    16\t_SEARCH = \"\"\"\n    17\tSELECT c.chunk_id, c.source, c.trust, c.text,\n    18\t       ts_rank(c.tsv, websearch_to_tsquery('english', $1)) AS rank\n    19\t  FROM retrieval.chunks c\n    20\t WHERE c.tsv @@ websearch_to_tsquery('english', $1)\n    21\t   AND NOT c.quarantined\n    22\t   AND (c.expires_at IS NULL OR c.expires_at > now())\n    23\t   AND (c.audience = 'all' OR (c.audience = 'employee' AND $2 = ANY (c.allowed_employees)))\n    24\t ORDER BY rank DESC\n    25\t LIMIT $3\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass PolicyIndex:\n    30\t    def __init__(self, pool: asyncpg.Pool, top_k: int, cache_ttl: float):\n    31\t        self._pool = pool\n    32\t        self._top_k = top_k\n    33\t        self._ttl = cache_ttl\n    34\t        self._cache: dict[str, tuple[float, str, list[dict[str, Any]]]] = {}\n    35\t\n    36\t    async def _index_version(self) -> str:\n    37\t        # Bumped by ingest on every add, expiry, quarantine or permission change.\n    38\t        return await self._pool.fetchval(\"SELECT version FROM retrieval.index_state WHERE id = 1\")\n    39\t\n    40\t    def _key(self, query: str) -> str:\n    41\t        normalized = \" \".join(query.lower().split())\n    42\t        return hashlib.sha256(f\"{self._top_k}|{normalized}\".encode()).hexdigest()\n    43\t\n    44\t    async def search(self, query: str, employee_id: str) -> list[dict[str, Any]]:\n    45\t        version = await self._index_version()\n    46\t        key = self._key(query)\n    47\t        hit = self._cache.get(key)\n    48\t        if hit and hit[1] == version and time.monotonic() - hit[0] < self._ttl:\n    49\t            return hit[2]\n    50\t        rows = await self._pool.fetch(_SEARCH, query, employee_id, self._top_k)\n    51\t        chunks = [dict(r) for r in rows]\n    52\t        self._cache[key] = (time.monotonic(), version, chunks)\n    53\t        return chunks\n=== src/killswitch.py\n     1\t\"\"\"Stop control. Flags live in control.stop_flags, which the agent's DB role can only read.\n     2\t\n     3\tOperators set flags with the hr_agent_operator role (see README \"Stopping the agent\").\n     4\tThe tool gateway reads the same table, so a stopped instance is refused there too.\n     5\t\"\"\"\n     6\tfrom __future__ import annotations\n     7\t\n     8\timport asyncio\n     9\timport logging\n    10\t\n    11\timport asyncpg\n    12\t\n    13\tfrom .audit import RunContext\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.stop\")\n    16\t\n    17\t_QUERY = \"\"\"\n    18\tSELECT reason FROM control.stop_flags\n    19\tWHERE active\n    20\t  AND (   scope = 'fleet'","numLines":330,"startLine":45,"totalLines":899}},"tool_result_meta":[{"id":"toolu_01VVYekfMQAe7Fuxp7pKhkZJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
