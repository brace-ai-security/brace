{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VxHQNLNkRxpDSpHihH2812","type":"tool_result","content":"375\t    21\t       OR (scope = 'agent_type'     AND value = $1)\n376\t    22\t       OR (scope = 'agent_instance' AND value = $2)\n377\t    23\t       OR (scope = 'subject'        AND value = $3)\n378\t    24\t       OR (scope = 'agent_principal' AND value = $4))\n379\t    25\tLIMIT 1\n380\t    26\t\"\"\"\n381\t    27\t\n382\t    28\t\n383\t    29\tclass Stopped(Exception):\n384\t    30\t    pass\n385\t    31\t\n386\t    32\t\n387\t    33\tclass StopControl:\n388\t    34\t    def __init__(self, pool: asyncpg.Pool, poll_seconds: float):\n389\t    35\t        self._pool = pool\n390\t    36\t        self._poll = poll_seconds\n391\t    37\t\n392\t    38\t    async def reason(self, ctx: RunContext) -> str | None:\n393\t    39\t        try:\n394\t    40\t            row = await self._pool.fetchrow(\n395\t    41\t                _QUERY, ctx.agent_type_id, ctx.agent_instance_id, ctx.subject, ctx.agent_principal, timeout=1.0\n396\t    42\t            )\n397\t    43\t        except Exception:\n398\t    44\t            return \"stop store unreachable\"\n399\t    45\t        return row[\"reason\"] if row else None\n400\t    46\t\n401\t    47\t    async def raise_if_stopped(self, ctx: RunContext) -> None:\n402\t    48\t        why = await self.reason(ctx)\n403\t    49\t        if why:\n404\t    50\t            raise Stopped(why)\n405\t    51\t\n406\t    52\t    async def watch(self, ctx: RunContext, task: asyncio.Task) -> None:\n407\t    53\t        \"\"\"Cancel the run task, including any in-flight model or tool call, once a flag appears.\"\"\"\n408\t    54\t        while not task.done():\n409\t    55\t            why = await self.reason(ctx)\n410\t    56\t            if why:\n411\t    57\t                log.warning(\"stop flag observed\", extra={\"run_id\": ctx.run_id, \"reason\": why})\n412\t    58\t                task.cancel(msg=f\"stopped: {why}\")\n413\t    59\t                return\n414\t    60\t            await asyncio.sleep(self._poll)\n415\t=== src/budgets.py\n416\t     1\t\"\"\"Hard limits enforced by the harness, outside the model.\"\"\"\n417\t     2\tfrom __future__ import annotations\n418\t     3\t\n419\t     4\timport time\n420\t     5\tfrom collections import deque\n421\t     6\tfrom dataclasses import dataclass, field\n422\t     7\tfrom typing import Any\n423\t     8\t\n424\t     9\timport asyncpg\n425\t    10\t\n426\t    11\tfrom .audit import RunContext\n427\t    12\t\n428\t    13\t\n429\t    14\tclass BudgetExceeded(Exception):\n430\t    15\t    def __init__(self, limit: str):\n431\t    16\t        super().__init__(limit)\n432\t    17\t        self.limit = limit\n433\t    18\t\n434\t    19\t\n435\t    20\t@dataclass\n436\t    21\tclass RunBudget:\n437\t    22\t    cfg: dict[str, Any]\n438\t    23\t    pricing: dict[str, float]\n439\t    24\t    started: float = field(default_factory=time.monotonic)\n440\t    25\t    steps: int = 0\n441\t    26\t    tokens: int = 0\n442\t    27\t    cost_usd: float = 0.0\n443\t    28\t    tool_calls: deque = field(default_factory=deque)\n444\t    29\t\n445\t    30\t    def check_step(self) -> None:\n446\t    31\t        if self.steps >= self.cfg[\"max_steps\"]:\n447\t    32\t            raise BudgetExceeded(\"max_steps\")\n448\t    33\t        if time.monotonic() - self.started > self.cfg[\"max_wall_seconds\"]:\n449\t    34\t            raise BudgetExceeded(\"max_wall_seconds\")\n450\t    35\t        if self.tokens >= self.cfg[\"max_total_tokens\"]:\n451\t    36\t            raise BudgetExceeded(\"max_total_tokens\")\n452\t    37\t        if self.cost_usd >= self.cfg[\"max_cost_usd\"]:\n453\t    38\t            raise BudgetExceeded(\"max_cost_usd\")\n454\t    39\t        self.steps += 1\n455\t    40\t\n456\t    41\t    def remaining_seconds(self) -> float:\n457\t    42\t        return max(0.0, self.cfg[\"max_wall_seconds\"] - (time.monotonic() - self.started))\n458\t    43\t\n459\t    44\t    def record_usage(self, usage: Any) -> tuple[int, float]:\n460\t    45\t        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n461\t    46\t        cache_write = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n462\t    47\t        tokens_in = usage.input_tokens + cache_read + cache_write\n463\t    48\t        tokens = tokens_in + usage.output_tokens\n464\t    49\t        cost = (\n465\t    50\t            (usage.input_tokens + cache_write) * self.pricing[\"input_per_mtok\"]\n466\t    51\t            + cache_read * self.pricing[\"cache_read_per_mtok\"]\n467\t    52\t            + usage.output_tokens * self.pricing[\"output_per_mtok\"]\n468\t    53\t        ) / 1_000_000\n469\t    54\t        self.tokens += tokens\n470\t    55\t        self.cost_usd += cost\n471\t    56\t        return tokens, cost\n472\t    57\t\n473\t    58\t    def check_tool_call(self) -> None:\n474\t    59\t        now = time.monotonic()\n475\t    60\t        while self.tool_calls and now - self.tool_calls[0] > 60:\n476\t    61\t            self.tool_calls.popleft()\n477\t    62\t        if len(self.tool_calls) >= self.cfg[\"max_tool_calls_per_minute\"]:\n478\t    63\t            raise BudgetExceeded(\"max_tool_calls_per_minute\")\n479\t    64\t        self.tool_calls.append(now)\n480\t    65\t\n481\t    66\t    def check_subagent(self, started_so_far: int) -> None:\n482\t    67\t        if started_so_far >= self.cfg[\"max_subagents\"]:\n483\t    68\t            raise BudgetExceeded(\"max_subagents\")\n484\t    69\t\n485\t    70\t\n486\t    71\t_WINDOW = \"to_timestamp(floor(extract(epoch FROM now()) / $3) * $3)\"\n487\t    72\t\n488\t    73\t_RESERVE_RUN = f\"\"\"\n489\t    74\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n490\t    75\tVALUES ($1, $2, {_WINDOW}, 1, 0, 0)\n491\t    76\tON CONFLICT (scope, key, window_start) DO UPDATE\n492\t    77\t   SET runs = quota.usage.runs + 1\n493\t    78\t WHERE quota.usage.runs + 1 <= $4\n494\t    79\t   AND quota.usage.tokens < $5\n495\t    80\t   AND quota.usage.cost_usd < $6\n496\t    81\tRETURNING runs\n497\t    82\t\"\"\"\n498\t    83\t\n499\t    84\t_RECORD_USAGE = f\"\"\"\n500\t    85\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n501\t    86\tVALUES ($1, $2, {_WINDOW}, 0, $4, $5)\n502\t    87\tON CONFLICT (scope, key, window_start) DO UPDATE\n503\t    88\t   SET tokens = quota.usage.tokens + EXCLUDED.tokens,\n504\t    89\t       cost_usd = quota.usage.cost_usd + EXCLUDED.cost_usd\n505\t    90\tRETURNING tokens, cost_usd\n506\t    91\t\"\"\"\n507\t    92\t\n508\t    93\t\n509\t    94\tclass QuotaStore:\n510\t    95\t    \"\"\"Per-user, per-tenant and fleet-wide quotas, shared by every replica.\"\"\"\n511\t    96\t\n512\t    97\t    def __init__(self, pool: asyncpg.Pool, quotas: list[dict[str, Any]]):\n513\t    98\t        self._pool = pool\n514\t    99\t        self._quotas = quotas\n515\t   100\t\n516\t   101\t    def _key(self, scope: str, ctx: RunContext) -> str:\n517\t   102\t        return {\"user\": ctx.subject, \"tenant\": ctx.tenant, \"fleet\": \"all\"}[scope]\n518\t   103\t\n519\t   104\t    async def reserve_run(self, ctx: RunContext) -> None:\n520\t   105\t        async with self._pool.acquire() as conn, conn.transaction():\n521\t   106\t            for q in self._quotas:\n522\t   107\t                row = await conn.fetchrow(\n523\t   108\t                    _RESERVE_RUN, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"],\n524\t   109\t                    q[\"max_runs\"], q[\"max_tokens\"], q[\"max_cost_usd\"],\n525\t   110\t                )\n526\t   111\t                if row is None:\n527\t   112\t                    raise BudgetExceeded(f\"quota:{q['scope']}\")\n528\t   113\t\n529\t   114\t    async def record_usage(self, ctx: RunContext, tokens: int, cost_usd: float) -> None:\n530\t   115\t        \"\"\"Usage already spent is always recorded; the run stops once any window is over its limit.\"\"\"\n531\t   116\t        exceeded: str | None = None\n532\t   117\t        async with self._pool.acquire() as conn, conn.transaction():\n533\t   118\t            for q in self._quotas:\n534\t   119\t                row = await conn.fetchrow(\n535\t   120\t                    _RECORD_USAGE, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"], tokens, cost_usd\n536\t   121\t                )\n537\t   122\t                if row[\"tokens\"] >= q[\"max_tokens\"] or row[\"cost_usd\"] >= q[\"max_cost_usd\"]:\n538\t   123\t                    exceeded = exceeded or f\"quota:{q['scope']}\"\n539\t   124\t        if exceeded:\n540\t   125\t            raise BudgetExceeded(exceeded)\n541\t=== src/main.py\n542\t     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n543\t     2\tfrom __future__ import annotations\n544\t     3\t\n545\t     4\timport asyncio\n546\t     5\timport logging\n547\t     6\timport os\n548\t     7\timport uuid\n549\t     8\t\n550\t     9\timport asyncpg\n551\t    10\timport httpx\n552\t    11\timport jwt\n553\t    12\tfrom anthropic import AsyncAnthropic\n554\t    13\tfrom opentelemetry import trace\n555\t    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n556\t    15\tfrom opentelemetry.sdk.resources import Resource\n557\t    16\tfrom opentelemetry.sdk.trace import TracerProvider\n558\t    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n559\t    18\tfrom starlette.applications import Starlette\n560\t    19\tfrom starlette.requests import Request\n561\t    20\tfrom starlette.responses import JSONResponse\n562\t    21\tfrom starlette.routing import Route\n563\t    22\t\n564\t    23\tfrom . import type_id\n565\t    24\tfrom .agent import Agent, RunState\n566\t    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n567\t    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n568\t    27\tfrom .budgets import BudgetExceeded, QuotaStore\n569\t    28\tfrom .credentials import CredentialBroker\n570\t    29\tfrom .gateway_client import GatewayClient\n571\t    30\tfrom .killswitch import Stopped, StopControl\n572\t    31\tfrom .redact import RedactingFilter\n573\t    32\tfrom .retrieval import PolicyIndex\n574\t    33\tfrom .tools import ToolRegistry, load_yaml\n575\t    34\tfrom .validation import sanitize_reply\n576\t    35\t\n577\t    36\tSSO_ISSUER = \"https://sso.acme.example\"\n578\t    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n579\t    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n580\t    39\t\n581\t    40\tlogging.basicConfig(level=logging.INFO)\n582\t    41\tfor h in logging.getLogger().handlers:\n583\t    42\t    h.addFilter(RedactingFilter())\n584\t    43\tlog = logging.getLogger(\"hr_agent\")\n585\t    44\t\n586\t    45\tCFG = load_yaml(\"agent.yaml\")\n587\t    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n588\t    47\tPOD_ID = os.environ[\"POD_UID\"]\n589\t    48\t\n590\t    49\tprovider = TracerProvider(resource=Resource.create({\n591\t    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n592\t    51\t}))\n593\t    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n594\t    53\ttrace.set_tracer_provider(provider)\n595\t    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n596\t    55\t\n597\t    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n598\t    57\tagent: Agent\n599\t    58\taudit: AuditWriter\n600\t    59\tapprovals: ApprovalStore\n601\t    60\tstop: StopControl\n602\t    61\t\n603\t    62\t\n604\t    63\tdef _employee(request: Request) -> tuple[str, str]:\n605\t    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n606\t    65\t    auth = request.headers.get(\"authorization\", \"\")\n607\t    66\t    if not auth.startswith(\"Bearer \"):\n608\t    67\t        raise PermissionError(\"missing token\")\n609\t    68\t    token = auth[7:]\n610\t    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n611\t    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n612\t    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n613\t    72\t        raise PermissionError(\"wrong organisation\")\n614\t    73\t    return claims[\"employee_id\"], token\n615\t    74\t\n616\t    75\t\n617\t    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n618\t    77\t    a = CFG[\"agent\"]\n619\t    78\t    return RunContext(\n620\t    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n621\t    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n622\t    81\t        agent_principal=a[\"workload_identity\"],\n623\t    82\t    )\n624\t    83\t\n625\t    84\t\n626\t    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n627\t    86\t    task = asyncio.ensure_future(coro)\n628\t    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n629\t    88\t    try:\n630\t    89\t        return await task\n631\t    90\t    except asyncio.CancelledError:\n632\t    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n633\t    92\t        return None\n634\t    93\t    except Stopped as exc:\n635\t    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n636\t    95\t        return None\n637\t    96\t    finally:\n638\t    97\t        watcher.cancel()\n639\t    98\t\n640\t    99\t\n641\t   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n642\t   101\t    if state is None:\n643\t   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n644\t   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n645\t   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n646\t   105\t    if state.pending_approval:\n647\t   106\t        body[\"approval\"] = state.pending_approval\n648\t   107\t    return JSONResponse(body)\n649\t   108\t\n650\t   109\t\n651\t   110\tasync def chat(request: Request) -> JSONResponse:\n652\t   111\t    try:\n653\t   112\t        employee_id, token = _employee(request)\n654\t   113\t    except (jwt.PyJWTError, PermissionError):\n655\t   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n656\t   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n657\t   116\t    run_id = str(uuid.uuid4())\n658\t   117\t    ctx = _context(run_id, employee_id)\n659\t   118\t    with tracer.start_as_current_span(\"chat\"):\n660\t   119\t        try:\n661\t   120\t            await agent.quotas.reserve_run(ctx)\n662\t   121\t            state = agent.new_state(text, token)\n663\t   122\t            _runs[run_id] = (ctx, state)\n664\t   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n665\t   124\t            state = await _drive(ctx, agent.run(ctx, state))\n666\t   125\t        except BudgetExceeded as exc:\n667\t   126\t            await audit.record(ctx, \"quota_denied\", decision=\"deny\", reason=exc.limit)\n668\t   127\t            return JSONResponse({\"error\": \"quota_exceeded\"}, status_code=429)\n669\t   128\t        except AuditUnavailable:\n670\t   129\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n671\t   130\t        except Exception as exc:\n672\t   131\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__)\n673\t   132\t            raise\n674\t   133\t        return _reply(run_id, state)\n675\t   134\t\n676\t   135\t\n677\t   136\tasync def confirm(request: Request) -> JSONResponse:\n678\t   137\t    try:\n679\t   138\t        employee_id, token = _employee(request)\n680\t   139\t    except (jwt.PyJWTError, PermissionError):\n681\t   140\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n682\t   141\t    run_id, approval_id = request.path_params[\"run_id\"], request.path_params[\"approval_id\"]\n683\t   142\t    entry = _runs.get(run_id)\n684\t   143\t    if entry is None or entry[0].subject != employee_id:\n685\t   144\t        return JSONResponse({\"error\": \"not_found\"}, status_code=404)\n686\t   145\t    ctx, state = entry\n687\t   146\t    state.subject_token = token\n688\t   147\t    with tracer.start_as_current_span(\"approval.confirm\"):\n689\t   148\t        try:\n690\t   149\t            await approvals.confirm(approval_id, employee_id)\n691\t   150\t            await audit.record(ctx, \"approval_granted\", decision=\"allow\", approval_id=approval_id)\n692\t   151\t            state = await _drive(ctx, agent.resume_with_approval(ctx, state, approval_id))\n693\t   152\t        except ApprovalInvalid as exc:\n694\t   153\t            await audit.record(ctx, \"approval_rejected\", decision=\"deny\", reason=str(exc), approval_id=approval_id)\n695\t   154\t            return JSONResponse({\"error\": \"approval_invalid\"}, status_code=409)\n696\t   155\t        except AuditUnavailable:\n697\t   156\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n698\t   157\t        except Exception as exc:\n699\t   158\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__, approval_id=approval_id)\n700\t   159\t            raise\n701\t   160\t        return _reply(run_id, state)\n702\t   161\t\n703\t   162\t\n704\t   163\tasync def startup() -> None:\n705\t   164\t    global agent, audit, approvals, stop\n706\t   165\t    pool = await asyncpg.create_pool(os.environ[\"DATABASE_URL\"], min_size=2, max_size=20)\n707\t   166\t    registry = ToolRegistry.from_config()\n708\t   167\t    mtls = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\", cert=(\"/etc/svid/svid.pem\", \"/etc/svid/svid_key.pem\"))\n709\t   168\t    audit = AuditWriter(pool, registry.policy_version)\n710\t   169\t    approvals = ApprovalStore(pool, CFG[\"approvals\"][\"ttl_seconds\"])\n711\t   170\t    stop = StopControl(pool, CFG[\"stop\"][\"poll_seconds\"])\n712\t   171\t    agent = Agent(\n713\t   172\t        CFG, registry, AsyncAnthropic(max_retries=1), GatewayClient(mtls, CredentialBroker(mtls)),\n714\t   173\t        PolicyIndex(pool, CFG[\"retrieval\"][\"top_k\"], CFG[\"retrieval\"][\"cache_ttl_seconds\"]),\n715\t   174\t        approvals, QuotaStore(pool, CFG[\"budgets\"][\"quotas\"]), audit, stop,\n716\t   175\t    )\n717\t   176\t\n718\t   177\t\n719\t   178\tapp = Starlette(\n720\t   179\t    routes=[\n721\t   180\t        Route(\"/v1/chat\", chat, methods=[\"POST\"]),\n722\t   181\t        Route(\"/v1/runs/{run_id}/approvals/{approval_id}/confirm\", confirm, methods=[\"POST\"]),\n723\t   182\t    ],\n724\t   183\t    on_startup=[startup],\n725\t   184\t)\n726\t=== src/credentials.py\n727\t     1\t\"\"\"Per-tool, per-employee, short-lived tokens for the agent's own workload identity.\n728\t     2\t\n729\t     3\tThe pod's projected service-account token (audience sts.acme.example, 10 min) is the\n730\t     4\tactor token. The employee's verified SSO token is the subject token. The STS returns an\n731\t     5\tRFC 8693 token whose `sub` is the employee, `act.sub` is this workload, `aud` is the\n732\t     6\trequested audience, `scope` is exactly one tool scope, and `cnf.x5t#S256` binds it to the\n733\t     7\tpod's mTLS certificate. Lifetime is 300 s: long enough for one approval-to-execute window\n734\t     8\ton a single call, short enough that a copied token is useless after the run.\n735\t     9\t\"\"\"\n736\t    10\tfrom __future__ import annotations\n737\t    11\t\n738\t    12\timport asyncio\n739\t    13\timport time\n740\t    14\tfrom dataclasses import dataclass\n741\t    15\t\n742\t    16\timport httpx\n743\t    17\t\n744\t    18\tSTS_URL = \"https://sts.identity.svc.cluster.local/oauth2/token\"\n745\t    19\tACTOR_TOKEN_PATH = \"/var/run/secrets/tokens/sts-token\"\n746\t    20\tTOKEN_TTL_SECONDS = 300\n747\t    21\tREFRESH_MARGIN_SECONDS = 30\n748\t    22\t\n749\t    23\t\n750\t    24\t@dataclass\n751\t    25\tclass _Cached:\n752\t    26\t    token: str\n753\t    27\t    expires_at: float\n754\t    28\t\n755\t    29\t\n756\t    30\tclass CredentialBroker:\n757\t    31\t    def __init__(self, client: httpx.AsyncClient):\n758\t    32\t        self._client = client  # configured with the pod's SPIFFE SVID for mTLS\n759\t    33\t        self._cache: dict[tuple[str, str, str], _Cached] = {}\n760\t    34\t        self._lock = asyncio.Lock()\n761\t    35\t\n762\t    36\t    def _actor_token(self) -> str:\n763\t    37\t        # Re-read each time: kubelet rotates the projected token on disk.\n764\t    38\t        with open(ACTOR_TOKEN_PATH, encoding=\"utf-8\") as fh:\n765\t    39\t            return fh.read().strip()\n766\t    40\t\n767\t    41\t    async def token(self, *, audience: str, scope: str, subject_token: str, subject: str) -> str:\n768\t    42\t        key = (audience, scope, subject)\n769\t    43\t        async with self._lock:\n770\t    44\t            hit = self._cache.get(key)\n771\t    45\t            if hit and hit.expires_at - REFRESH_MARGIN_SECONDS > time.time():\n772\t    46\t                return hit.token\n773\t    47\t            resp = await self._client.post(\n774\t    48\t                STS_URL,"}]},"parent_tool_use_id":null,"session_id":"4970510a-de6f-4924-96ed-914c5d6811d1","uuid":"385bb836-de4c-493f-90dc-70093a38e0ef","timestamp":"2026-11-21T11:31:42.623Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brenn/.claude/projects/-private-var-folders-6v-yk9bzvrn5zx0kxll7d4szzb80000gn-T-brace-action-v4fnrafp/20e6f499-b917-4f5e-8f29-138bc3300ddc/tool-results/bpj63kf9o.txt","content":"    21\t       OR (scope = 'agent_type'     AND value = $1)\n    22\t       OR (scope = 'agent_instance' AND value = $2)\n    23\t       OR (scope = 'subject'        AND value = $3)\n    24\t       OR (scope = 'agent_principal' AND value = $4))\n    25\tLIMIT 1\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass Stopped(Exception):\n    30\t    pass\n    31\t\n    32\t\n    33\tclass StopControl:\n    34\t    def __init__(self, pool: asyncpg.Pool, poll_seconds: float):\n    35\t        self._pool = pool\n    36\t        self._poll = poll_seconds\n    37\t\n    38\t    async def reason(self, ctx: RunContext) -> str | None:\n    39\t        try:\n    40\t            row = await self._pool.fetchrow(\n    41\t                _QUERY, ctx.agent_type_id, ctx.agent_instance_id, ctx.subject, ctx.agent_principal, timeout=1.0\n    42\t            )\n    43\t        except Exception:\n    44\t            return \"stop store unreachable\"\n    45\t        return row[\"reason\"] if row else None\n    46\t\n    47\t    async def raise_if_stopped(self, ctx: RunContext) -> None:\n    48\t        why = await self.reason(ctx)\n    49\t        if why:\n    50\t            raise Stopped(why)\n    51\t\n    52\t    async def watch(self, ctx: RunContext, task: asyncio.Task) -> None:\n    53\t        \"\"\"Cancel the run task, including any in-flight model or tool call, once a flag appears.\"\"\"\n    54\t        while not task.done():\n    55\t            why = await self.reason(ctx)\n    56\t            if why:\n    57\t                log.warning(\"stop flag observed\", extra={\"run_id\": ctx.run_id, \"reason\": why})\n    58\t                task.cancel(msg=f\"stopped: {why}\")\n    59\t                return\n    60\t            await asyncio.sleep(self._poll)\n=== src/budgets.py\n     1\t\"\"\"Hard limits enforced by the harness, outside the model.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport time\n     5\tfrom collections import deque\n     6\tfrom dataclasses import dataclass, field\n     7\tfrom typing import Any\n     8\t\n     9\timport asyncpg\n    10\t\n    11\tfrom .audit import RunContext\n    12\t\n    13\t\n    14\tclass BudgetExceeded(Exception):\n    15\t    def __init__(self, limit: str):\n    16\t        super().__init__(limit)\n    17\t        self.limit = limit\n    18\t\n    19\t\n    20\t@dataclass\n    21\tclass RunBudget:\n    22\t    cfg: dict[str, Any]\n    23\t    pricing: dict[str, float]\n    24\t    started: float = field(default_factory=time.monotonic)\n    25\t    steps: int = 0\n    26\t    tokens: int = 0\n    27\t    cost_usd: float = 0.0\n    28\t    tool_calls: deque = field(default_factory=deque)\n    29\t\n    30\t    def check_step(self) -> None:\n    31\t        if self.steps >= self.cfg[\"max_steps\"]:\n    32\t            raise BudgetExceeded(\"max_steps\")\n    33\t        if time.monotonic() - self.started > self.cfg[\"max_wall_seconds\"]:\n    34\t            raise BudgetExceeded(\"max_wall_seconds\")\n    35\t        if self.tokens >= self.cfg[\"max_total_tokens\"]:\n    36\t            raise BudgetExceeded(\"max_total_tokens\")\n    37\t        if self.cost_usd >= self.cfg[\"max_cost_usd\"]:\n    38\t            raise BudgetExceeded(\"max_cost_usd\")\n    39\t        self.steps += 1\n    40\t\n    41\t    def remaining_seconds(self) -> float:\n    42\t        return max(0.0, self.cfg[\"max_wall_seconds\"] - (time.monotonic() - self.started))\n    43\t\n    44\t    def record_usage(self, usage: Any) -> tuple[int, float]:\n    45\t        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n    46\t        cache_write = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n    47\t        tokens_in = usage.input_tokens + cache_read + cache_write\n    48\t        tokens = tokens_in + usage.output_tokens\n    49\t        cost = (\n    50\t            (usage.input_tokens + cache_write) * self.pricing[\"input_per_mtok\"]\n    51\t            + cache_read * self.pricing[\"cache_read_per_mtok\"]\n    52\t            + usage.output_tokens * self.pricing[\"output_per_mtok\"]\n    53\t        ) / 1_000_000\n    54\t        self.tokens += tokens\n    55\t        self.cost_usd += cost\n    56\t        return tokens, cost\n    57\t\n    58\t    def check_tool_call(self) -> None:\n    59\t        now = time.monotonic()\n    60\t        while self.tool_calls and now - self.tool_calls[0] > 60:\n    61\t            self.tool_calls.popleft()\n    62\t        if len(self.tool_calls) >= self.cfg[\"max_tool_calls_per_minute\"]:\n    63\t            raise BudgetExceeded(\"max_tool_calls_per_minute\")\n    64\t        self.tool_calls.append(now)\n    65\t\n    66\t    def check_subagent(self, started_so_far: int) -> None:\n    67\t        if started_so_far >= self.cfg[\"max_subagents\"]:\n    68\t            raise BudgetExceeded(\"max_subagents\")\n    69\t\n    70\t\n    71\t_WINDOW = \"to_timestamp(floor(extract(epoch FROM now()) / $3) * $3)\"\n    72\t\n    73\t_RESERVE_RUN = f\"\"\"\n    74\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    75\tVALUES ($1, $2, {_WINDOW}, 1, 0, 0)\n    76\tON CONFLICT (scope, key, window_start) DO UPDATE\n    77\t   SET runs = quota.usage.runs + 1\n    78\t WHERE quota.usage.runs + 1 <= $4\n    79\t   AND quota.usage.tokens < $5\n    80\t   AND quota.usage.cost_usd < $6\n    81\tRETURNING runs\n    82\t\"\"\"\n    83\t\n    84\t_RECORD_USAGE = f\"\"\"\n    85\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    86\tVALUES ($1, $2, {_WINDOW}, 0, $4, $5)\n    87\tON CONFLICT (scope, key, window_start) DO UPDATE\n    88\t   SET tokens = quota.usage.tokens + EXCLUDED.tokens,\n    89\t       cost_usd = quota.usage.cost_usd + EXCLUDED.cost_usd\n    90\tRETURNING tokens, cost_usd\n    91\t\"\"\"\n    92\t\n    93\t\n    94\tclass QuotaStore:\n    95\t    \"\"\"Per-user, per-tenant and fleet-wide quotas, shared by every replica.\"\"\"\n    96\t\n    97\t    def __init__(self, pool: asyncpg.Pool, quotas: list[dict[str, Any]]):\n    98\t        self._pool = pool\n    99\t        self._quotas = quotas\n   100\t\n   101\t    def _key(self, scope: str, ctx: RunContext) -> str:\n   102\t        return {\"user\": ctx.subject, \"tenant\": ctx.tenant, \"fleet\": \"all\"}[scope]\n   103\t\n   104\t    async def reserve_run(self, ctx: RunContext) -> None:\n   105\t        async with self._pool.acquire() as conn, conn.transaction():\n   106\t            for q in self._quotas:\n   107\t                row = await conn.fetchrow(\n   108\t                    _RESERVE_RUN, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"],\n   109\t                    q[\"max_runs\"], q[\"max_tokens\"], q[\"max_cost_usd\"],\n   110\t                )\n   111\t                if row is None:\n   112\t                    raise BudgetExceeded(f\"quota:{q['scope']}\")\n   113\t\n   114\t    async def record_usage(self, ctx: RunContext, tokens: int, cost_usd: float) -> None:\n   115\t        \"\"\"Usage already spent is always recorded; the run stops once any window is over its limit.\"\"\"\n   116\t        exceeded: str | None = None\n   117\t        async with self._pool.acquire() as conn, conn.transaction():\n   118\t            for q in self._quotas:\n   119\t                row = await conn.fetchrow(\n   120\t                    _RECORD_USAGE, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"], tokens, cost_usd\n   121\t                )\n   122\t                if row[\"tokens\"] >= q[\"max_tokens\"] or row[\"cost_usd\"] >= q[\"max_cost_usd\"]:\n   123\t                    exceeded = exceeded or f\"quota:{q['scope']}\"\n   124\t        if exceeded:\n   125\t            raise BudgetExceeded(exceeded)\n=== src/main.py\n     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport logging\n     6\timport os\n     7\timport uuid\n     8\t\n     9\timport asyncpg\n    10\timport httpx\n    11\timport jwt\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n    15\tfrom opentelemetry.sdk.resources import Resource\n    16\tfrom opentelemetry.sdk.trace import TracerProvider\n    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n    18\tfrom starlette.applications import Starlette\n    19\tfrom starlette.requests import Request\n    20\tfrom starlette.responses import JSONResponse\n    21\tfrom starlette.routing import Route\n    22\t\n    23\tfrom . import type_id\n    24\tfrom .agent import Agent, RunState\n    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n    27\tfrom .budgets import BudgetExceeded, QuotaStore\n    28\tfrom .credentials import CredentialBroker\n    29\tfrom .gateway_client import GatewayClient\n    30\tfrom .killswitch import Stopped, StopControl\n    31\tfrom .redact import RedactingFilter\n    32\tfrom .retrieval import PolicyIndex\n    33\tfrom .tools import ToolRegistry, load_yaml\n    34\tfrom .validation import sanitize_reply\n    35\t\n    36\tSSO_ISSUER = \"https://sso.acme.example\"\n    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    39\t\n    40\tlogging.basicConfig(level=logging.INFO)\n    41\tfor h in logging.getLogger().handlers:\n    42\t    h.addFilter(RedactingFilter())\n    43\tlog = logging.getLogger(\"hr_agent\")\n    44\t\n    45\tCFG = load_yaml(\"agent.yaml\")\n    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n    47\tPOD_ID = os.environ[\"POD_UID\"]\n    48\t\n    49\tprovider = TracerProvider(resource=Resource.create({\n    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n    51\t}))\n    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n    53\ttrace.set_tracer_provider(provider)\n    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n    55\t\n    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n    57\tagent: Agent\n    58\taudit: AuditWriter\n    59\tapprovals: ApprovalStore\n    60\tstop: StopControl\n    61\t\n    62\t\n    63\tdef _employee(request: Request) -> tuple[str, str]:\n    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n    65\t    auth = request.headers.get(\"authorization\", \"\")\n    66\t    if not auth.startswith(\"Bearer \"):\n    67\t        raise PermissionError(\"missing token\")\n    68\t    token = auth[7:]\n    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n    72\t        raise PermissionError(\"wrong organisation\")\n    73\t    return claims[\"employee_id\"], token\n    74\t\n    75\t\n    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n    77\t    a = CFG[\"agent\"]\n    78\t    return RunContext(\n    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n    81\t        agent_principal=a[\"workload_identity\"],\n    82\t    )\n    83\t\n    84\t\n    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n    86\t    task = asyncio.ensure_future(coro)\n    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n    88\t    try:\n    89\t        return await task\n    90\t    except asyncio.CancelledError:\n    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n    92\t        return None\n    93\t    except Stopped as exc:\n    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n    95\t        return None\n    96\t    finally:\n    97\t        watcher.cancel()\n    98\t\n    99\t\n   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n   101\t    if state is None:\n   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n   105\t    if state.pending_approval:\n   106\t        body[\"approval\"] = state.pending_approval\n   107\t    return JSONResponse(body)\n   108\t\n   109\t\n   110\tasync def chat(request: Request) -> JSONResponse:\n   111\t    try:\n   112\t        employee_id, token = _employee(request)\n   113\t    except (jwt.PyJWTError, PermissionError):\n   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n   116\t    run_id = str(uuid.uuid4())\n   117\t    ctx = _context(run_id, employee_id)\n   118\t    with tracer.start_as_current_span(\"chat\"):\n   119\t        try:\n   120\t            await agent.quotas.reserve_run(ctx)\n   121\t            state = agent.new_state(text, token)\n   122\t            _runs[run_id] = (ctx, state)\n   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n   124\t            state = await _drive(ctx, agent.run(ctx, state))\n   125\t        except BudgetExceeded as exc:\n   126\t            await audit.record(ctx, \"quota_denied\", decision=\"deny\", reason=exc.limit)\n   127\t            return JSONResponse({\"error\": \"quota_exceeded\"}, status_code=429)\n   128\t        except AuditUnavailable:\n   129\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   130\t        except Exception as exc:\n   131\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__)\n   132\t            raise\n   133\t        return _reply(run_id, state)\n   134\t\n   135\t\n   136\tasync def confirm(request: Request) -> JSONResponse:\n   137\t    try:\n   138\t        employee_id, token = _employee(request)\n   139\t    except (jwt.PyJWTError, PermissionError):\n   140\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   141\t    run_id, approval_id = request.path_params[\"run_id\"], request.path_params[\"approval_id\"]\n   142\t    entry = _runs.get(run_id)\n   143\t    if entry is None or entry[0].subject != employee_id:\n   144\t        return JSONResponse({\"error\": \"not_found\"}, status_code=404)\n   145\t    ctx, state = entry\n   146\t    state.subject_token = token\n   147\t    with tracer.start_as_current_span(\"approval.confirm\"):\n   148\t        try:\n   149\t            await approvals.confirm(approval_id, employee_id)\n   150\t            await audit.record(ctx, \"approval_granted\", decision=\"allow\", approval_id=approval_id)\n   151\t            state = await _drive(ctx, agent.resume_with_approval(ctx, state, approval_id))\n   152\t        except ApprovalInvalid as exc:\n   153\t            await audit.record(ctx, \"approval_rejected\", decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   154\t            return JSONResponse({\"error\": \"approval_invalid\"}, status_code=409)\n   155\t        except AuditUnavailable:\n   156\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   157\t        except Exception as exc:\n   158\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__, approval_id=approval_id)\n   159\t            raise\n   160\t        return _reply(run_id, state)\n   161\t\n   162\t\n   163\tasync def startup() -> None:\n   164\t    global agent, audit, approvals, stop\n   165\t    pool = await asyncpg.create_pool(os.environ[\"DATABASE_URL\"], min_size=2, max_size=20)\n   166\t    registry = ToolRegistry.from_config()\n   167\t    mtls = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\", cert=(\"/etc/svid/svid.pem\", \"/etc/svid/svid_key.pem\"))\n   168\t    audit = AuditWriter(pool, registry.policy_version)\n   169\t    approvals = ApprovalStore(pool, CFG[\"approvals\"][\"ttl_seconds\"])\n   170\t    stop = StopControl(pool, CFG[\"stop\"][\"poll_seconds\"])\n   171\t    agent = Agent(\n   172\t        CFG, registry, AsyncAnthropic(max_retries=1), GatewayClient(mtls, CredentialBroker(mtls)),\n   173\t        PolicyIndex(pool, CFG[\"retrieval\"][\"top_k\"], CFG[\"retrieval\"][\"cache_ttl_seconds\"]),\n   174\t        approvals, QuotaStore(pool, CFG[\"budgets\"][\"quotas\"]), audit, stop,\n   175\t    )\n   176\t\n   177\t\n   178\tapp = Starlette(\n   179\t    routes=[\n   180\t        Route(\"/v1/chat\", chat, methods=[\"POST\"]),\n   181\t        Route(\"/v1/runs/{run_id}/approvals/{approval_id}/confirm\", confirm, methods=[\"POST\"]),\n   182\t    ],\n   183\t    on_startup=[startup],\n   184\t)\n=== src/credentials.py\n     1\t\"\"\"Per-tool, per-employee, short-lived tokens for the agent's own workload identity.\n     2\t\n     3\tThe pod's projected service-account token (audience sts.acme.example, 10 min) is the\n     4\tactor token. The employee's verified SSO token is the subject token. The STS returns an\n     5\tRFC 8693 token whose `sub` is the employee, `act.sub` is this workload, `aud` is the\n     6\trequested audience, `scope` is exactly one tool scope, and `cnf.x5t#S256` binds it to the\n     7\tpod's mTLS certificate. Lifetime is 300 s: long enough for one approval-to-execute window\n     8\ton a single call, short enough that a copied token is useless after the run.\n     9\t\"\"\"\n    10\tfrom __future__ import annotations\n    11\t\n    12\timport asyncio\n    13\timport time\n    14\tfrom dataclasses import dataclass\n    15\t\n    16\timport httpx\n    17\t\n    18\tSTS_URL = \"https://sts.identity.svc.cluster.local/oauth2/token\"\n    19\tACTOR_TOKEN_PATH = \"/var/run/secrets/tokens/sts-token\"\n    20\tTOKEN_TTL_SECONDS = 300\n    21\tREFRESH_MARGIN_SECONDS = 30\n    22\t\n    23\t\n    24\t@dataclass\n    25\tclass _Cached:\n    26\t    token: str\n    27\t    expires_at: float\n    28\t\n    29\t\n    30\tclass CredentialBroker:\n    31\t    def __init__(self, client: httpx.AsyncClient):\n    32\t        self._client = client  # configured with the pod's SPIFFE SVID for mTLS\n    33\t        self._cache: dict[tuple[str, str, str], _Cached] = {}\n    34\t        self._lock = asyncio.Lock()\n    35\t\n    36\t    def _actor_token(self) -> str:\n    37\t        # Re-read each time: kubelet rotates the projected token on disk.\n    38\t        with open(ACTOR_TOKEN_PATH, encoding=\"utf-8\") as fh:\n    39\t            return fh.read().strip()\n    40\t\n    41\t    async def token(self, *, audience: str, scope: str, subject_token: str, subject: str) -> str:\n    42\t        key = (audience, scope, subject)\n    43\t        async with self._lock:\n    44\t            hit = self._cache.get(key)\n    45\t            if hit and hit.expires_at - REFRESH_MARGIN_SECONDS > time.time():\n    46\t                return hit.token\n    47\t            resp = await self._client.post(\n    48\t                STS_URL,","numLines":400,"startLine":375,"totalLines":899}},"tool_result_meta":[{"id":"toolu_01VxHQNLNkRxpDSpHihH2812","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
