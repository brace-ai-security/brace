{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChG14xvxTkC78WhhphBsn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012mwcHgtRXG1S6vmLrUwGCB","name":"Write","input":{"file_path":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-action-v4fnrafp/step9.py","content":"import json, sys\n\nP = sys.argv[1]\nd = json.load(open(P))\n\nNODIRECT_TEST = {\n    \"file\": \"tests/test_no_direct_route.py\",\n    \"code\": ('import pathlib\\nimport yaml\\n\\n\\n'\n             'def test_no_tool_has_a_direct_route():\\n'\n             '    cfg = yaml.safe_load(pathlib.Path(\"config/tools.yaml\").read_text())\\n'\n             '    assert all(\"direct_route\" not in t for t in cfg[\"tools\"].values())\\n'),\n    \"run\": \"python -m pytest tests/test_no_direct_route.py\",\n}\nKEEP_TEST = {\n    \"file\": \"tests/test_audit_retention.py\",\n    \"code\": ('import pathlib\\nimport re\\n\\n\\n'\n             'def test_keep_partitions_covers_six_months():\\n'\n             '    text = pathlib.Path(\"k8s/audit-maintenance.yaml\").read_text()\\n'\n             '    m = re.search(r\\'name: KEEP_PARTITIONS\\\\s+value: \"(\\\\d+)\"\\', text)\\n'\n             '    assert m and int(m.group(1)) >= 27\\n'),\n    \"run\": \"python -m pytest tests/test_audit_retention.py\",\n}\n\ndef direct_steps(extra_first=None):\n    s = []\n    if extra_first:\n        s.append(extra_first)\n    s += [\n        \"Open `src/tools.py`. Delete line 59 (`direct_route=t.get(\\\"direct_route\\\"),`). Then delete line 31, the `direct_route` field of `ToolSpec`.\",\n        \"Open `src/gateway_client.py`. Delete lines 51 to 59, the whole `except GatewayUnavailable:` block.\",\n        \"In the same file, delete line 46 (`try:`). Then move lines 47 to 50 left by four spaces so they sit directly under `async def call`.\",\n        \"Open `config/tools.yaml`. Delete lines 91 to 93, the `direct_route:` key with its `endpoint` and `audience`, under `escalate_to_human`.\",\n        \"Open `k8s/networkpolicy.yaml`. Delete lines 48 to 50, the egress rule that lets the agent reach `helpdesk-mcp` directly.\",\n        \"Create the test below, then run it. Also ask the it-service-desk team to make `helpdesk-mcp` accept calls only from the gateway identity.\",\n    ]\n    return s\n\nF = {}\n\nF[\"A01\"] = dict(\n    components=[\"agent\", \"data:hr-postgres\", \"tool:escalate_to_human\", \"mcp:helpdesk\"],\n    problem=\"The agent logs in to its database with a fixed password. Escalations can also skip the gateway's identity check.\",\n    steps=[\n        \"Do E06 first. It removes the direct route to `helpdesk-mcp` that skips the gateway.\",\n        \"Ask the platform team to issue short-lived database logins for role `hr_agent`, tied to the agent's service account, for example with Vault dynamic roles.\",\n        \"Open `k8s/deployment.yaml`. Replace the `DATABASE_URL` secret on lines 51 and 52 with the short-lived login the platform team gives you.\",\n        \"In `release/manifest.yaml` line 61, write the new login lifetime next to `database_role`.\",\n        \"Ask the platform team to show that the agent database login expires on its own. Run the E06 test to confirm no call skips the gateway.\",\n    ],\n    done_when=\"The agent database login expires on its own, and no tool call skips the gateway.\",\n    effort=\"large\")\n\nF[\"A02\"] = dict(\n    components=[\"mcp:hr-tool-gateway\", \"data:audit-log\"],\n    problem=\"Some gateway denials are logged with caller-supplied or `unknown` ids. If the denial log write fails, the failure is ignored.\",\n    steps=[\n        \"Ask the identity team to add `agent_type_id` and `agent_instance_id` claims to the tokens the STS issues. Do not start the code steps until they confirm.\",\n        \"Open `src/gateway.py`. Replace lines 196 and 197 with `except Exception:` then `log.critical(\\\"gateway deny not audited\\\", extra={\\\"tool\\\": tool})`.\",\n        \"In the same file, replace line 139 with `c.get(\\\"agent_instance_id\\\") or \\\"unknown\\\",` and line 138's header lookup with `c.get(\\\"agent_type_id\\\") or \\\"unknown\\\"`.\",\n        \"Ask the security team to add an alert on the log message `gateway deny not audited`.\",\n        \"Send the gateway a request with a bad token. Check that the new `audit.gateway_decisions` row has no `missing` values, or that the alert fires.\",\n    ],\n    done_when=\"Every row in `audit.gateway_decisions` has verified type and instance ids, and a failed denial write raises an alert.\",\n    effort=\"medium\")\n\nF[\"A04\"] = dict(\n    components=[\"mcp:hr-tool-gateway\", \"api:sts\"],\n    problem=\"The gateway takes the instance id from a header the caller sets. A caller can pick any id and dodge stop and rate limits.\",\n    steps=[\n        \"Ask the identity team to add `agent_instance_id` and `agent_type_id` claims to STS tokens. Do not deploy the code steps before they confirm.\",\n        \"Open `src/credentials.py`. In the `data` dict on lines 49 to 59, add `\\\"agent_instance_id\\\": instance_id`. Add `instance_id` as an argument of `token()` and update its callers in `src/gateway_client.py`.\",\n        \"Open `src/gateway.py`. Replace line 170 with `instance = claims.get(\\\"agent_instance_id\\\", \\\"\\\")`.\",\n        \"In the same file, add `OR (scope = 'agent_type' AND value = $4)` to the SQL on line 101, and pass `claims.get(\\\"agent_type_id\\\")` as the fourth argument on line 102.\",\n        \"Send a call with a forged `X-Agent-Instance` header. Check that the gateway uses the id in the token, not the header.\",\n    ],\n    done_when=\"A stop flag on an instance or agent type blocks the gateway call, even when the header says another id.\",\n    effort=\"medium\")\n\nF[\"A05\"] = dict(\n    components=[\"agent\", \"data:audit-log\"],\n    problem=\"An operator can read the agent type id from the audit log but cannot find its manifest. Manifests are kept in CI by git commit only.\",\n    steps=[\n        \"Ask the platform team for a store that keeps manifests by `agent_type_id`, for as long as audit rows are kept (at least six months).\",\n        \"Open `.github/workflows/release.yml`. After line 58, add a step that copies `release/manifest.yaml` and `type-id.json` into that store under the id `${{ steps.typeid.outputs.id }}`.\",\n        \"Open `config/agent.yaml`. On line 4, add the store location to the ownership text so an operator knows where to look.\",\n        \"Take one agent type id from `audit.events` and fetch its manifest from the store. Confirm the owner and image digest show up.\",\n    ],\n    done_when=\"Given an `agent_type_id` from an audit row, an operator can fetch the matching manifest from the store.\",\n    effort=\"medium\")\n\nF[\"B01\"] = dict(\n    components=[\"tool:escalate_to_human\", \"mcp:hr-tool-gateway\", \"mcp:helpdesk\"],\n    problem=\"When the gateway fails, `escalate_to_human` goes straight to `helpdesk-mcp`. The gateway's tool allowlist and disable check are skipped.\",\n    steps=direct_steps(),\n    done_when=\"Every MCP tool call must pass the gateway allowlist, and no tool in `config/tools.yaml` has a `direct_route`.\",\n    effort=\"small\", test=NODIRECT_TEST)\n\nF[\"B03\"] = dict(\n    components=[\"agent\", \"api:sts\", \"data:hr-postgres\", \"mcp:hr-tool-gateway\"],\n    problem=\"The Anthropic key and database logins have no expiry or rotation. The gateway does not check how long its downstream tokens last.\",\n    steps=[\n        \"Ask the platform team to rotate secrets `hr-agent-anthropic` and `hr-agent-db` on a schedule, for example every 30 days. Ask them to write the lifetime down.\",\n        \"Open `src/gateway.py`. Replace line 126 with `data = resp.json()`. Then add `if data.get(\\\"expires_in\\\", 10**9) > 300:` and, indented under it, `raise PermissionError(\\\"downstream token too long\\\")`.\",\n        \"On the next line of the same function add `return data[\\\"access_token\\\"]`.\",\n        \"Open `release/manifest.yaml`. Under `permissions:` near line 60, add the rotation period of each secret.\",\n        \"Ask the identity team to cap downstream token lifetime at 300 seconds for audiences `hris-mcp` and `helpdesk-mcp`. Check that a longer token is refused.\",\n    ],\n    done_when=\"Each secret has a written rotation period, and the gateway refuses a downstream token that lives longer than 300 seconds.\",\n    effort=\"medium\")\n\nF[\"B04\"] = dict(\n    components=[\"tool:escalate_to_human\", \"mcp:hr-tool-gateway\", \"mcp:helpdesk\"],\n    problem=\"When the gateway errors, the agent sends escalations straight to `helpdesk-mcp`. A stop flag is not enforced on that path.\",\n    steps=direct_steps() + [\"Run the timed revocation drill (recipe B04): set a stop flag, then time how long until all calls are refused.\"],\n    done_when=\"A stop flag blocks every tool call, because every call passes through the gateway.\",\n    effort=\"small\", test=NODIRECT_TEST)\n\nF[\"B05\"] = dict(\n    components=[\"agent\", \"data:hr-postgres\", \"mcp:hr-tool-gateway\", \"tool:file_leave_request\", \"tool:escalate_to_human\"],\n    problem=\"Approval is checked only inside the agent. The agent's own database role can write approvals, and the gateway never checks one.\",\n    steps=[\n        \"Do not deploy this until the platform team has created database role `hr_approver` and given it a login.\",\n        \"Open `src/gateway.py`. Before line 177, add: if `spec.approval == \\\"subject\\\"`, look up `approvals.grants` for the `Approval-Id` header. Deny with 403 unless `used_at` is under 60 seconds old and `approved_by = subject`.\",\n        \"Open `src/gateway_client.py`. In `_post` after line 71, add the header `\\\"Approval-Id\\\": operation_id`. For approved calls, `operation_id` is the approval id.\",\n        \"Open `src/main.py`. Create a second pool from env `APPROVER_DATABASE_URL`. Pass it to `ApprovalStore` on line 169 for `confirm()` only.\",\n        \"Create `migrations/002_approval_roles.sql`. Add `REVOKE UPDATE (approved_by, approved_at) ON approvals.grants FROM hr_agent;` and grant that update plus select to `hr_approver`. Grant `hr_gateway` select on the table.\",\n        \"Send a tool call with no approval to the gateway. It must be refused with 403.\",\n    ],\n    done_when=\"The gateway refuses an approval-required tool call that has no consumed approval, and `hr_agent` cannot write `approved_by`.\",\n    effort=\"large\")\n\nF[\"B06\"] = dict(\n    components=[\"agent\", \"data:hr-postgres\", \"tool:file_leave_request\", \"tool:escalate_to_human\"],\n    problem=\"An approval is tied to the instance, operation, target and arguments, but not to the tool scope the action runs under.\",\n    steps=[\n        \"Do not deploy the code steps until the platform team has run the new migration.\",\n        \"Create `migrations/002_approval_scope.sql` with `ALTER TABLE approvals.grants ADD COLUMN scope text NOT NULL DEFAULT '';`.\",\n        \"Open `src/approvals.py`. In `consume`, add `AND scope = $7` after line 80 and add `spec_scope` as the last value on line 82. Add `spec_scope` to the signature on line 67.\",\n        \"In the same file, in `request`, add `scope` to the column list on line 48, add a `$12` placeholder on line 50, and pass the value on line 52. Add `scope` to the signature on line 43.\",\n        \"Open `src/agent.py`. Pass `spec.scope` to `self.approvals.consume(...)` on line 135, and to `self.approvals.request(...)` on line 114.\",\n        \"Approve a request, change the scope in the database, and try to consume it. It must fail with `ApprovalInvalid`.\",\n    ],\n    done_when=\"An approval that was granted for one tool scope cannot be used under a different scope.\",\n    effort=\"medium\")\n\nF[\"B07\"] = dict(\n    components=[\"agent\", \"unit:src/agent.py\"],\n    problem=\"Wall time is checked only between model steps. One step with many tool calls can run well past the 90 second limit.\",\n    steps=[\n        \"Open `src/agent.py`. Replace line 177 with `raw = await asyncio.wait_for(self.gateway.call(spec, args, ctx, state.subject_token, operation_id=operation_id), timeout=max(state.budget.remaining_seconds(), 0.1))`.\",\n        \"In the same file, add `import asyncio` as a new line 4, above `import json`.\",\n        \"Open `src/budgets.py`. At the start of `check_tool_call` (line 58), add `if time.monotonic() - self.started > self.cfg[\\\"max_wall_seconds\\\"]:` then, indented, `raise BudgetExceeded(\\\"max_wall_seconds\\\")`.\",\n        \"Create the test below and run it.\",\n    ],\n    done_when=\"A tool call that starts after the 90 second wall limit is refused with `BudgetExceeded`.\",\n    effort=\"small\",\n    test={\"file\": \"tests/test_budget_wall.py\",\n          \"code\": ('import time\\n\\nimport pytest\\n\\nfrom src.budgets import BudgetExceeded, RunBudget\\n\\n\\n'\n                   'def test_tool_call_refused_after_wall_time():\\n'\n                   '    cfg = {\"max_steps\": 12, \"max_wall_seconds\": 90, \"max_total_tokens\": 60000,\\n'\n                   '           \"max_cost_usd\": 0.4, \"max_tool_calls_per_minute\": 20, \"max_subagents\": 0}\\n'\n                   '    budget = RunBudget(cfg, {})\\n'\n                   '    budget.started = time.monotonic() - 100\\n'\n                   '    with pytest.raises(BudgetExceeded):\\n'\n                   '        budget.check_tool_call()\\n'),\n          \"run\": \"python -m pytest tests/test_budget_wall.py\"})\n\nF[\"B08\"] = dict(\n    components=[\"tool:escalate_to_human\", \"mcp:helpdesk\", \"mcp:hr-tool-gateway\"],\n    problem=\"The agent pod may open a network connection to the production helpdesk server directly. That path skips the tool gateway.\",\n    steps=direct_steps(),\n    done_when=\"The agent pod has no network route to `helpdesk-mcp`, and no tool has a `direct_route`.\",\n    effort=\"small\", test=NODIRECT_TEST)\n\nF[\"B09\"] = dict(\n    components=[\"tool:escalate_to_human\", \"mcp:helpdesk\", \"mcp:hr-tool-gateway\"],\n    problem=\"The agent's egress policy lets it reach `helpdesk-mcp` directly, and the client code uses it. Blocked traffic is not shown to reach a responder.\",\n    steps=direct_steps() + [\"Ask the platform team to show that Cilium drop alerts for the `hr-agent` namespace reach the on-call person.\"],\n    done_when=\"The agent cannot reach `helpdesk-mcp`, and a blocked connection raises an alert for the on-call person.\",\n    effort=\"small\", test=NODIRECT_TEST)\n\nF[\"B10\"] = dict(\n    components=[\"agent\"],\n    problem=\"Kyverno accepts any digest-pinned image from `registry.acme.example` in `hr-agent`, even one that no signature rule covers.\",\n    steps=[\n        \"Open `k8s/admission.yaml`. On line 35, replace the pattern with `\\\"registry.acme.example/people/hr-helpdesk-agent@sha256:* | registry.acme.example/platform/*@sha256:*\\\"`.\",\n        \"On line 33 (the `initContainers` pattern), make the same replacement.\",\n        \"Ask the platform team for the Kyverno version. In `release/manifest.yaml`, change line 74 to `admission: [k8s/admission.yaml]  # kyverno <version>`.\",\n        \"Run `kyverno test` with a pod whose image is `registry.acme.example/other/app@sha256:...`. It must be rejected.\",\n    ],\n    done_when=\"Kyverno rejects a pod in `hr-agent` whose image is not under the two signed registry paths.\",\n    effort=\"small\")\n\nF[\"B12\"] = dict(\n    components=[\"agent\", \"unit:src/agent.py\"],\n    problem=\"Code shows that only `main` is deployed. Nothing shows that the `main` branch blocks force pushes and needs code owner review.\",\n    steps=[\n        \"Ask a repository admin to open the repository settings, then Rules, then the ruleset for `main`.\",\n        \"Ask them to run `gh api repos/acme/hr-helpdesk-agent/rulesets` and save the JSON output.\",\n        \"Check that the ruleset blocks force pushes, blocks deletion, and requires review from code owners.\",\n        \"Save the output as `release/evidence/main-ruleset.json`. Create the folder if it does not exist.\",\n        \"Ask the security team to read the file and confirm the three rules are on.\",\n    ],\n    done_when=\"A saved export of the `main` ruleset shows force push blocked, deletion blocked and code owner review required.\",\n    effort=\"small\")\n\nF[\"C01\"] = dict(\n    components=[\"agent\", \"tool:escalate_to_human\", \"mcp:hris\", \"mcp:helpdesk\"],\n    problem=\"The release manifest leaves out the direct route to `helpdesk-mcp`. Some entries have no owner or fixed version.\",\n    steps=[\n        \"Do E06 first. It removes the direct route, so the manifest needs no entry for it.\",\n        \"Open `release/manifest.yaml`. On lines 54 and 55, add `version_or_digest:` to each MCP server. Ask hris-platform and it-service-desk for the values.\",\n        \"On lines 34, 31 to 33 and 36, add `owner:` and a `ref:` (a git commit or digest) to the prompt, harness and configuration entries.\",\n        \"Compare the manifest with `config/tools.yaml`. Every server and tool in that file must appear in the manifest.\",\n    ],\n    done_when=\"Every artifact in the release manifest has an owner and a fixed version, and the manifest lists no direct route.\",\n    effort=\"medium\")\n\nF[\"C02\"] = dict(\n    components=[\"agent\"],\n    problem=\"One team, people-platform, owns every line of `CODEOWNERS`. It alone can approve config, k8s and release changes. No emergency path is written down.\",\n    steps=[\n        \"Open `CODEOWNERS`. After line 10, add `/src/ @acme/people-platform @acme/security-engineering`, `/Dockerfile @acme/security-engineering` and `/requirements.txt @acme/security-engineering`.\",\n        \"On line 8 (`/release/`) and line 3 (`/config/`), keep only the security team. Remove `@acme/people-platform` from both.\",\n        \"On line 6 (`/k8s/`), keep only `@acme/platform-security`. On line 1, change the owner to `@acme/people-platform @acme/security-engineering`.\",\n        \"Create `release/break-glass.md`. List who may approve an emergency change, what to record (reason, time, approver), and that a second review follows within two working days.\",\n        \"Ask the security team to turn on \\\"Require review from Code Owners\\\" for `main`. Then open a test pull request that edits `config/agent.yaml`. It must need a security reviewer.\",\n    ],\n    done_when=\"A change to `config/`, `k8s/` or `release/` cannot be merged with only a people-platform approval.\",\n    effort=\"small\")\n\nF[\"C03\"] = dict(\n    components=[\"agent\", \"unit:src/agent.py\"],\n    problem=\"Only Kyverno and the pod itself check what is running. Nothing outside the agent compares the running image and type id with the approved manifest.\",\n    steps=[\n        \"Ask the platform team for read-only cluster access for a CI job, limited to the `hr-agent` namespace.\",\n        \"Create `.github/workflows/verify-running.yml` with a daily schedule. It runs `kubectl get deploy hr-helpdesk-agent -n hr-agent -o jsonpath='{.spec.template.spec.containers[0].image}'`.\",\n        \"In the same job, read `.release.image.digest` and `.release.agent_type_id` from `release/manifest.yaml` with `yq`. Fail the job if the digest or the type id differs.\",\n        \"Add a step that sends the failure to the on-call channel. Ask the operations team to name the channel.\",\n        \"Change the digest in a staging copy of the manifest. Run the job. It must fail and alert.\",\n    ],\n    done_when=\"A scheduled job outside the agent fails and alerts when the running image digest or type id differs from the approved manifest.\",\n    effort=\"medium\")\n\nF[\"C04\"] = dict(\n    components=[\"agent\", \"mcp:hr-tool-gateway\"],\n    problem=\"The only drift check is a hash at pod start. Network policy, permissions and the MCP server list are never compared, and no alert is sent.\",\n    steps=[\n        \"Ask the platform team to turn on GitOps drift detection, for example Argo CD or Flux, for everything in `k8s/` in the `hr-agent` namespace.\",\n        \"Ask them to set an alert on any drift and a response time limit, for example one hour. Ask them to write both in `release/manifest.yaml`.\",\n        \"Create `.github/workflows/verify-config.yml` that compares `.mcp.json` and `config/tools.yaml` with the copy in the release artifact. Fail on any difference.\",\n        \"Change a network rule in a staging cluster by hand. Check that the alert fires within the time limit.\",\n    ],\n    done_when=\"A hand change to a network rule, permission or MCP server list raises an alert within the stated time limit.\",\n    effort=\"large\")\n\nF[\"C05\"] = dict(\n    components=[\"agent\"],\n    problem=\"The Dockerfile pulls its build syntax image by the changeable tag `docker/dockerfile:1.10`. The tag can point to different code later.\",\n    steps=[\n        \"Run `docker buildx imagetools inspect docker/dockerfile:1.10`. Copy the `Digest:` value.\",\n        \"Open `Dockerfile`. Change line 1 to `# syntax=docker/dockerfile:1.10@sha256:<digest>` using the digest you copied.\",\n        \"Create the test below and run it. Then run the release build once to check that it still works.\",\n    ],\n    done_when=\"Line 1 of `Dockerfile` names the syntax image with a `sha256` digest.\",\n    effort=\"small\",\n    test={\"file\": \"tests/test_dockerfile_pin.py\",\n          \"code\": ('def test_syntax_frontend_is_pinned_by_digest():\\n'\n                   '    with open(\"Dockerfile\", encoding=\"utf-8\") as fh:\\n'\n                   '        assert \"@sha256:\" in fh.readline()\\n'),\n          \"run\": \"python -m pytest tests/test_dockerfile_pin.py\"})\n\nF[\"C06\"] = dict(\n    components=[\"agent\"],\n    problem=\"Release test results are not stored with the release. The attack test suite is not in the repository.\",\n    steps=[\n        \"Open `.github/workflows/release.yml`. Replace line 58 with a block: `path: |` then, on three lines below, `type-id.json`, `release/manifest.yaml` and `test-results.xml`.\",\n        \"On line 29, change the command to `python -m pytest -q tests/release --junitxml=test-results.xml`.\",\n        \"Create `tests/release/test_attacks.py`. Add tests that send injected tool output, a forged approval and a tool name that looks like another. Each must be refused.\",\n        \"Run the release workflow on a test branch. Check that the artifact `release-<sha>` now contains `test-results.xml`.\",\n    ],\n    done_when=\"The release artifact holds the test results next to the manifest and type id.\",\n    effort=\"medium\")\n\nF[\"C07\"] = dict(\n    components=[\"agent\", \"model:claude-sonnet-4-5-20250929\"],\n    problem=\"There is no recovery or rollback procedure. The hosted model's retirement date is not recorded.\",\n    steps=[\n        \"Open `config/agent.yaml`. After line 11, add `retirement_date: \\\"YYYY-MM-DD\\\"`. Copy the date from the provider's model deprecation page for this model id.\",\n        \"Open `release/manifest.yaml`. Under `release:`, add `previous:` with the last approved image digest and type id.\",\n        \"Create `release/rollback.md`. Give the exact `kubectl` steps to go back to `previous`, and say that stop flags in `control.stop_flags` must stay on.\",\n        \"Ask the operations team to run the rollback in staging and write the date in `release/rollback.md`.\",\n    ],\n    done_when=\"`release/rollback.md` exists with a tested date, and `config/agent.yaml` states the model retirement date.\",\n    effort=\"medium\")\n\nF[\"C08\"] = dict(\n    components=[\"data:audit-log\"],\n    problem=\"The nightly job keeps only six weekly audit partitions. Audit rows are deleted after about six weeks, not six months.\",\n    steps=[\n        \"Open `k8s/audit-maintenance.yaml`. On line 35, change `value: \\\"6\\\"` to `value: \\\"27\\\"`. That is 26 weeks plus one spare.\",\n        \"Open `release/manifest.yaml`. Line 79 says `6 months`. Leave it, and add a note that the value is set by `KEEP_PARTITIONS`.\",\n        \"Do A05 so manifests are kept as long as the audit rows. Then create the test below and run it.\",\n    ],\n    done_when=\"`KEEP_PARTITIONS` in `k8s/audit-maintenance.yaml` is at least 27.\",\n    effort=\"small\", test=KEEP_TEST)\n\nF[\"E01\"] = dict(\n    components=[\"agent\", \"api:sts\", \"api:sso\", \"api:otel-collector\", \"data:hr-postgres\"],\n    problem=\"The release manifest leaves out services the code calls. Entries do not name an agent-team owner and a platform owner.\",\n    steps=[\n        \"Open `release/manifest.yaml`. After line 80, add a `dependencies:` list. Add one entry each for STS, SSO, the stop channel `control.stop_flags` and the telemetry collector.\",\n        \"Give each entry a `service`, an `agent_team_owner`, a `platform_owner` and `evidence:`. Use `src/credentials.py:18`, `src/main.py:36`, `src/killswitch.py:18` and `src/main.py:52`.\",\n        \"Add the same two owners to the MCP server entries on lines 54 and 55.\",\n        \"Compare the list with every URL in `src/`. Each outside service must be in the manifest.\",\n    ],\n    done_when=\"Every service the code calls has a manifest entry with an agent-team owner and a platform owner.\",\n    effort=\"small\")\n\nF[\"E02\"] = dict(\n    components=[\"agent\"],\n    problem=\"No scan looks for known flaws in packages. The base image signature is not checked. Packages and remote MCP servers have no approval record.\",\n    steps=[\n        \"Open `.github/workflows/release.yml`. After line 39, add a step that runs Trivy on `${IMAGE}@${{ steps.build.outputs.digest }}` with `--exit-code 1 --severity HIGH,CRITICAL`.\",\n        \"After line 29, add a step: `cosign verify` on the distroless base image digest from `Dockerfile` line 8, with the publisher's certificate identity and issuer.\",\n        \"After line 28, add `pip install pip-audit` and `pip-audit -r requirements.txt --require-hashes`.\",\n        \"Create `release/dependency-approvals.md`. For each package and MCP server, record the publisher, its permissions, the update source and who approved it.\",\n        \"Push a test branch with a known-bad package version pinned. The workflow must fail.\",\n    ],\n    done_when=\"The release workflow fails on a known-vulnerable package, and every package and server has an approval record.\",\n    effort=\"medium\")\n\nF[\"E03\"] = dict(\n    components=[\"mcp:hris\", \"mcp:helpdesk\", \"mcp:hr-tool-gateway\"],\n    problem=\"The gateway checks tool descriptions, but nothing records which version of each MCP server is approved, or when it is next reviewed.\",\n    steps=[\n        \"Ask hris-platform and it-service-desk for the image digest or version of `hris-mcp` and `helpdesk-mcp`, and for the date of their last review.\",\n        \"Open `release/manifest.yaml`. On lines 54 and 55, add `version_or_digest:` and `review_by:` to each server.\",\n        \"Open `config/tools.yaml`. Under each server on lines 4 to 13, add `version_or_digest:` with the same value.\",\n        \"Check that every server in `config/tools.yaml` has the two fields in the manifest.\",\n    ],\n    done_when=\"Each MCP server in the manifest has a recorded version or digest and a review date.\",\n    effort=\"small\")\n\nF[\"E05\"] = dict(\n    components=[\"mcp:hr-tool-gateway\"],\n    problem=\"The lookalike name check misses letters from other alphabets that look the same, and it only writes a log line.\",\n    steps=[\n        \"Open `src/gateway.py`. After line 48, add `_blocked_servers: set[str] = set()`.\",\n        \"In `mcp()`, change line 166 to also deny when `spec.server in _blocked_servers`.\",\n        \"In `refresh_fingerprints`, replace lines 66 and 67 with: if the name is a lookalike, add both server ids to `_blocked_servers` and log the error.\",\n        \"Before line 65, add `if not name.isascii(): _blocked_servers.add(server_id)`. After line 60, add `_blocked_servers.clear()`.\",\n        \"Make a test server list a tool named with a Cyrillic `а`. Check that every call to that server is refused with 403.\",\n    ],\n    done_when=\"A server that lists a non-ASCII or lookalike tool name has all its tools refused by the gateway.\",\n    effort=\"medium\")\n\nF[\"E06\"] = dict(\n    components=[\"tool:escalate_to_human\", \"mcp:helpdesk\", \"mcp:hr-tool-gateway\"],\n    problem=\"When the gateway is down, `escalate_to_human` goes straight to `helpdesk-mcp` with a token the agent makes itself. All gateway checks are skipped.\",\n    steps=direct_steps() + [\"Update `README.md` line 36, which says escalations are delivered during gateway maintenance. State that they now wait.\"],\n    done_when=\"No tool call can reach `helpdesk-mcp` without passing the gateway, and `config/tools.yaml` has no `direct_route`.\",\n    effort=\"small\", test=NODIRECT_TEST)\n\nF[\"E09\"] = dict(\n    components=[\"agent\", \"api:sts\", \"data:audit-log\"],\n    problem=\"A stop cancels running work, but cached 300 second tokens stay. Effects that finished before the stop are not recorded for follow-up.\",\n    steps=[\n        \"Open `src/main.py`. Make `startup` (line 163) build `creds = CredentialBroker(mtls)`, and use `creds` on line 172. Add `creds` to the `global` list on line 164. Declare `creds: CredentialBroker` near line 60.\",\n        \"In `_drive`, after the `audit.record` calls on lines 91 and 94, add `creds.drop_subject(ctx.subject)`.\",\n        \"In the same two places, also record `await audit.record(ctx, \\\"stop_reconcile\\\", decision=\\\"stop\\\", result={\\\"completed\\\": _runs[ctx.run_id][1].extra.get(\\\"completed\\\", [])})`.\",\n        \"Open `src/agent.py`. After line 193 (`tool_result` audit call), add `state.extra.setdefault(\\\"completed\\\", []).append(f\\\"{spec.qualified}:{operation_id}\\\")`.\",\n        \"Ask the identity team for a token revoke call on the STS. Add it next to `drop_subject`.\",\n        \"Set a stop flag mid-run. Check that the cache is empty and a `stop_reconcile` row lists the finished calls, within 10 seconds.\",\n    ],\n    done_when=\"After a stop, the agent holds no cached tokens for that employee, and a `stop_reconcile` audit row lists completed tool calls.\",\n    effort=\"medium\")\n\nF[\"E10\"] = dict(\n    components=[\"mcp:hr-tool-gateway\", \"data:audit-log\", \"mcp:hris\", \"mcp:helpdesk\"],\n    problem=\"Gateway audit rows take ids from unverified headers and never store the vendor's receipt id. Direct route calls leave no gateway row.\",\n    steps=[\n        \"Do E06 first. It removes the direct route. Do A02 first. It fixes the unverified ids.\",\n        \"Create `migrations/002_gateway_receipt.sql` with `ALTER TABLE audit.gateway_decisions ADD COLUMN vendor_receipt_id text;`.\",\n        \"Open `src/gateway.py`. In line 190, pass `receipt=structured.get(\\\"request_id\\\") or structured.get(\\\"ticket_id\\\")` to `_log`.\",\n        \"In `_log` (line 129), add `receipt: str | None = None`. Add `vendor_receipt_id` and `$13` to the SQL on lines 134 to 136, and pass `receipt` on line 140.\",\n        \"Make one allowed call in staging. Check that the new row holds the ticket or request id.\",\n    ],\n    done_when=\"Every allowed gateway call has a row in `audit.gateway_decisions` with the vendor receipt id.\",\n    effort=\"medium\")\n\nF[\"E11\"] = dict(\n    components=[\"data:audit-log\", \"mcp:hr-tool-gateway\"],\n    problem=\"Audit partitions are dropped after about six weeks. Rows have no way to show gaps. The gateway writes the allow record only after it acts.\",\n    steps=[\n        \"Open `src/gateway.py`. Before line 177, add `await _log(request, claims, tool, \\\"pending\\\", \\\"forwarding\\\")` so a record exists before the call is sent.\",\n        \"Open `k8s/audit-maintenance.yaml`. On line 35, change `value: \\\"6\\\"` to `value: \\\"27\\\"`.\",\n        \"Ask the data-platform team to add a sequence number or hash chain to `audit.events`, and an alert when numbers skip.\",\n        \"Create the test below and run it. Then ask the data-platform team to show a gap alert firing in staging.\",\n    ],\n    done_when=\"Audit rows are kept for at least 26 weeks, and a missing row raises an alert.\",\n    effort=\"medium\", test=KEEP_TEST)\n\nF[\"E12\"] = dict(\n    components=[\"agent\", \"mcp:helpdesk\", \"mcp:hr-tool-gateway\"],\n    problem=\"Stop flags and tool checks exist, but no drill shows the team can find and stop work tied to a bad MCP server.\",\n    steps=[\n        \"Create `runbooks/compromised-mcp.md`. List who runs the drill, who is paged, and the steps below.\",\n        \"In staging, pretend `helpdesk-mcp` is bad. Run `SELECT DISTINCT agent_instance_id FROM audit.events WHERE tool LIKE 'helpdesk/%'` to find the affected instances.\",\n        \"Set a stop flag in `control.stop_flags` and disable the tool in the gateway. Revoke the tokens. Check that an alert reaches the responder.\",\n        \"Write the date, the time taken and any problem at the end of `runbooks/compromised-mcp.md`.\",\n    ],\n    done_when=\"`runbooks/compromised-mcp.md` has a dated drill record showing instances found, work stopped and the responder alerted.\",\n    effort=\"medium\")\n\nF[\"R01\"] = dict(\n    components=[\"unit:src/agent.py\", \"mcp:hr-tool-gateway\", \"mcp:helpdesk\"],\n    problem=\"Error messages from tools reach the model as free text. They get no size, content or redaction checks.\",\n    steps=[\n        \"Open `src/gateway_client.py`. Replace line 94 with `raise ToolError(200, \\\"upstream error\\\")`. Replace line 91 with `raise ToolError(resp.status_code, \\\"upstream error\\\")`.\",\n        \"Open `src/gateway.py`. Replace line 184 with `return JSONResponse({\\\"error\\\": \\\"upstream_error\\\"}, status_code=502)`.\",\n        \"Open `src/agent.py`. Replace line 188 with `return _tool_result(tool_use_id, f\\\"{spec.name} failed with status {exc.status}.\\\", error=True)`.\",\n        \"Keep line 186. The audit log still stores the detail, and the audit writer redacts it.\",\n        \"Make a fake tool return an error that says \\\"ignore previous instructions\\\". Check that the model sees only the fixed text.\",\n    ],\n    done_when=\"The model only ever sees a fixed error message with the status number, never text from a tool.\",\n    effort=\"small\")\n\nF[\"R02\"] = dict(\n    components=[\"unit:src/agent.py\", \"mcp:hr-tool-gateway\"],\n    problem=\"Tool results are labeled as untrusted, but error results pass raw text with no label. Injection tests are not repeated or adaptive.\",\n    steps=[\n        \"Do R01 first. It makes error text fixed.\",\n        \"Open `src/agent.py`. On line 188, wrap the fixed text in the envelope: `json.dumps({\\\"source\\\": spec.qualified, \\\"trust\\\": \\\"untrusted_data\\\", \\\"data\\\": {\\\"error\\\": f\\\"status {exc.status}\\\"}})`.\",\n        \"Create `tests/release/test_injection.py`. Send 20 different injected strings in tool results, retried with new wording. Record how many get the model to act.\",\n        \"Write the success rate in `release/manifest.yaml` and set a maximum, for example zero.\",\n        \"Run `python -m pytest tests/release/test_injection.py`.\",\n    ],\n    done_when=\"Every tool result and error reaches the model inside the `untrusted_data` envelope, and injection test results are recorded.\",\n    effort=\"medium\")\n\nF[\"R03\"] = dict(\n    components=[\"unit:src/agent.py\", \"mcp:hr-tool-gateway\"],\n    problem=\"Tool error text reaches the model without redaction. Logs, audit rows and tool output are redacted.\",\n    steps=[\n        \"Open `src/agent.py`. Replace line 188 with `return _tool_result(tool_use_id, f\\\"{spec.name} failed with status {exc.status}.\\\", error=True)`.\",\n        \"Keep lines 186 and 187. The audit row and the log already redact the detail.\",\n        \"Ask the HR portal team to confirm that its content security policy has `img-src` limited to approved hosts.\",\n        \"Make a fake tool return an error with an email address. Check that the model sees only the fixed text.\",\n    ],\n    done_when=\"The model never sees raw tool error text, and the HR portal blocks images from other hosts.\",\n    effort=\"small\")\n\nF[\"R04\"] = dict(\n    components=[\"data:hr-postgres\", \"tool:search_policies\"],\n    problem=\"The handbook search cache ignores who is asking. A result cached for one employee can be shown to another.\",\n    steps=[\n        \"Open `src/retrieval.py`. Replace line 46 with `key = self._key(query, employee_id)`.\",\n        \"In the same file, change line 40 to `def _key(self, query: str, employee_id: str) -> str:`.\",\n        \"Change line 42 to `return hashlib.sha256(f\\\"{self._top_k}|{employee_id}|{normalized}\\\".encode()).hexdigest()`.\",\n        \"Create the test below and run it.\",\n    ],\n    done_when=\"Two different employees asking the same question never share a cache entry.\",\n    effort=\"small\",\n    test={\"file\": \"tests/test_retrieval_cache.py\",\n          \"code\": ('from src.retrieval import PolicyIndex\\n\\n\\n'\n                   'def test_cache_key_differs_per_employee():\\n'\n                   '    index = PolicyIndex(None, 5, 900.0)\\n'\n                   '    assert index._key(\"leave policy\", \"emp-1\") != index._key(\"leave policy\", \"emp-2\")\\n'),\n          \"run\": \"python -m pytest tests/test_retrieval_cache.py\"})\n\nF[\"R07\"] = dict(\n    components=[\"unit:src/agent.py\", \"data:audit-log\"],\n    problem=\"Only model call rows hold the context size. Action rows have none, and approved actions run under a new trace.\",\n    steps=[\n        \"Open `src/agent.py`. After line 76, add `state.extra[\\\"context_tokens\\\"] = ctx_tokens`.\",\n        \"In `_handle_tool` and `_execute`, add `context_tokens=state.extra.get(\\\"context_tokens\\\"), context_tokens_method=\\\"measured:provider_usage_input+cache_read+cache_write\\\"` to every `self.audit.record(...)` call.\",\n        \"On line 76, if `resp.usage.cache_read_input_tokens` is `None`, set the method text to `\\\"measured:input_only_cache_unreported\\\"` instead of counting it as 0.\",\n        \"Before line 119 (pause for approval), save the trace headers: `inject(carrier := {})` and `state.extra[\\\"carrier\\\"] = carrier`.\",\n        \"In `resume_with_approval` (line 124), start the span with `context=TraceContextTextMapPropagator().extract(state.extra[\\\"carrier\\\"])`.\",\n        \"Run one approved action. Check that all its `audit.events` rows share one `trace_id` and carry `context_tokens`.\",\n    ],\n    done_when=\"Every audit row for a model step or action has `context_tokens`, and an approved action keeps the trace id of its run.\",\n    effort=\"medium\")\n\nF[\"R08\"] = dict(\n    components=[\"agent\", \"data:audit-log\", \"mcp:hr-tool-gateway\"],\n    problem=\"Denials are written to the audit tables, but no rule watches them and no named person receives an alert.\",\n    steps=[\n        \"Ask the security team which SIEM they use and who is on call for this agent.\",\n        \"Create `detections/hr-agent-rules.md`. Write rules over `audit.events` and `audit.gateway_decisions`: many denials per employee in 5 minutes, any `authn` failure, and any `tool_denied` event.\",\n        \"Ask the security team to load the rules and route them to the named responder.\",\n        \"Run recipe R08. Trigger each rule in staging and note the time the responder was paged.\",\n    ],\n    done_when=\"Each rule fires in staging and pages the named responder.\",\n    effort=\"medium\")\n\nF[\"R09\"] = dict(\n    components=[\"agent\", \"data:audit-log\", \"tool:file_leave_request\", \"tool:escalate_to_human\"],\n    problem=\"Each action is checked by the employee, but nothing looks at action sequences or tests different kinds of content separately.\",\n    steps=[\n        \"Ask the security team who owns sequence detection for this agent.\",\n        \"Create `detections/hr-agent-sequences.md`. Write rules such as: three approval requests in one run, or a ticket right after a policy search.\",\n        \"Add a test run per content range: handbook text, employee messages and tool output. Write the result of each in the same file.\",\n        \"Ask the security team to load the rules and show one firing in staging.\",\n    ],\n    done_when=\"Sequence rules exist, fire in staging, and results are listed per content range.\",\n    effort=\"medium\")\n\nF[\"R10\"] = dict(\n    components=[\"agent\", \"model:claude-sonnet-4-5-20250929\"],\n    problem=\"Nothing says whether deliberate model misalignment is in scope. No second reviewer model is present.\",\n    steps=[\n        \"Ask the security team and the business owner to decide whether deliberate misalignment is in scope for this agent.\",\n        \"Open `release/manifest.yaml`. After line 29, add `misalignment_scope:` with `in_scope: yes` or `no`, the reason and the approver.\",\n        \"If it is in scope, run recipe R10 and store the result in `release/evidence/`. If not, ask governance to approve an N/A record.\",\n    ],\n    done_when=\"`release/manifest.yaml` states whether misalignment is in scope, who decided, and links the R10 result or N/A approval.\",\n    effort=\"small\")\n\nF[\"R11\"] = dict(\n    components=[\"mcp:hr-tool-gateway\", \"tool:escalate_to_human\", \"agent\"],\n    problem=\"A stop on an agent type is enforced only in the agent. The gateway does not check it, and escalations can skip the gateway.\",\n    steps=[\n        \"Do A04 first. It puts `agent_type_id` in the token. Do E06 first. It removes the direct route.\",\n        \"Open `src/gateway.py`. On line 102, add `claims.get(\\\"agent_type_id\\\")` as a fourth argument after `claims[\\\"act\\\"][\\\"sub\\\"]`.\",\n        \"On line 101, add `OR (scope = 'agent_type' AND value = $4)` inside the `WHERE`.\",\n        \"Run recipe R11. Set an `agent_type` stop flag, time how long until the gateway refuses calls, and save the dated result.\",\n    ],\n    done_when=\"A stop flag with scope `agent_type` makes the gateway refuse that agent's tool calls.\",\n    effort=\"small\")\n\nF[\"R12\"] = dict(\n    components=[\"tool:file_leave_request\", \"tool:escalate_to_human\", \"unit:src/agent.py\"],\n    problem=\"No tool says what happens on a stop. A write that times out is returned to the model as a normal error, so it may be tried again.\",\n    steps=[\n        \"Open `src/agent.py`. In `_execute`, before line 183, add a branch: if `exc.status == 504`, store `state.extra[\\\"hold\\\"] = operation_id`, record an `outcome_unknown` audit event, and return a fixed message.\",\n        \"In `_handle_tool`, before line 106, add: if `state.extra.get(\\\"hold\\\")`, return `_tool_result(tool_use_id, \\\"An advisor will check this first.\\\", error=True)`.\",\n        \"Open `config/tools.yaml`. Under each tool (lines 18, 30, 55 and 82) add `on_stop:` as `cancel`, `complete` or `reconcile`.\",\n        \"Ask hris-platform and it-service-desk how to check a request by its `Idempotency-Key`. Write the answer in `release/runbook.md`. Create it.\",\n        \"Simulate a timeout in staging. Check that no second call is sent and a hold row exists.\",\n    ],\n    done_when=\"A timed-out write is held with an owner, and no retry is sent until someone checks the other system.\",\n    effort=\"medium\")\n\nF[\"R13\"] = dict(\n    components=[\"unit:src/agent.py\", \"mcp:hr-tool-gateway\", \"data:audit-log\"],\n    problem=\"A gateway outage on a normal tool leaves no step record. Retries by the model library are not recorded.\",\n    steps=[\n        \"Open `src/main.py`. On line 172, change `AsyncAnthropic(max_retries=1)` to `AsyncAnthropic(max_retries=0)`.\",\n        \"Open `src/agent.py`. Before line 179, add `except GatewayUnavailable as exc:`. Record `tool_error` with `reason=f\\\"gateway unavailable, operation {operation_id}\\\"`. Return `_tool_result(tool_use_id, \\\"The tool is not available right now.\\\", error=True)`.\",\n        \"On line 18, add `GatewayUnavailable` to the import from `.gateway_client`.\",\n        \"Do E06 first, so no fallback call goes unrecorded.\",\n        \"Stop the gateway in staging and make one call. Check that an `audit.events` row shows the failure.\",\n    ],\n    done_when=\"A call that fails because the gateway is down has an audit row naming the operation id.\",\n    effort=\"small\")\n\nF[\"R14\"] = dict(\n    components=[\"tool:escalate_to_human\", \"mcp:hr-tool-gateway\", \"mcp:helpdesk\"],\n    problem=\"After a 503 from the gateway, the agent resends the helpdesk ticket on the direct route. The first call may already have gone through.\",\n    steps=direct_steps(\"Do R12 first. It adds the hold for an unknown outcome.\") + [\n        \"Open `src/gateway_client.py`. Replace lines 86 and 87 with: if the status is 503, `raise ToolError(503, f\\\"outcome unknown for operation {operation_id}\\\")`.\",\n        \"Ask it-service-desk to confirm that `helpdesk-mcp` ignores a repeat `Idempotency-Key`.\",\n    ],\n    done_when=\"After a 503 the agent never resends a write. It marks the outcome unknown and holds it.\",\n    effort=\"medium\", test=NODIRECT_TEST)\n\nfor f in d[\"findings\"]:\n    if f[\"rating\"] in (\"gap\", \"needs_evidence\"):\n        x = F.pop(f[\"item\"])\n        f[\"components\"] = x[\"components\"]\n        fix = {\"problem\": x[\"problem\"], \"steps\": x[\"steps\"], \"done_when\": x[\"done_when\"], \"effort\": x[\"effort\"]}\n        if \"test\" in x:\n            fix[\"test\"] = x[\"test\"]\n        f[\"fix\"] = fix\n        f[\"assignee\"] = None\nassert not F, F.keys()\njson.dump(d, open(P, \"w\"), indent=2, ensure_ascii=False)\nprint(\"ok\")\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5353,"cache_read_input_tokens":87482,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5353},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4970510a-de6f-4924-96ed-914c5d6811d1","uuid":"cb29e072-0671-44e7-b1ba-e0182eeffb97","timestamp":"2026-11-21T11:35:53.140Z","request_id":"req_011ChG14xknmTSg46sgVFeA1","wire_tool_inputs":{"toolu_012mwcHgtRXG1S6vmLrUwGCB":{"file_path":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-action-v4fnrafp/step9.py","content":"import json, sys\n\nP = sys.argv[1]\nd = json.load(open(P))\n\nNODIRECT_TEST = {\n    \"file\": \"tests/test_no_direct_route.py\",\n    \"code\": ('import pathlib\\nimport yaml\\n\\n\\n'\n             'def test_no_tool_has_a_direct_route():\\n'\n             '    cfg = yaml.safe_load(pathlib.Path(\"config/tools.yaml\").read_text())\\n'\n             '    assert all(\"direct_route\" not in t for t in cfg[\"tools\"].values())\\n'),\n    \"run\": \"python -m pytest tests/test_no_direct_route.py\",\n}\nKEEP_TEST = {\n    \"file\": \"tests/test_audit_retention.py\",\n    \"code\": ('import pathlib\\nimport re\\n\\n\\n'\n             'def test_keep_partitions_covers_six_months():\\n'\n             '    text = pathlib.Path(\"k8s/audit-maintenance.yaml\").read_text()\\n'\n             '    m = re.search(r\\'name: KEEP_PARTITIONS\\\\s+value: \"(\\\\d+)\"\\', text)\\n'\n             '    assert m and int(m.group(1)) >= 27\\n'),\n    \"run\": \"python -m pytest tests/test_audit_retention.py\",\n}\n\ndef direct_steps(extra_first=None):\n    s = []\n    if extra_first:\n        s.append(extra_first)\n    s += [\n        \"Open `src/tools.py`. Delete line 59 (`direct_route=t.get(\\\"direct_route\\\"),`). Then delete line 31, the `direct_route` field of `ToolSpec`.\",\n        \"Open `src/gateway_client.py`. Delete lines 51 to 59, the whole `except GatewayUnavailable:` block.\",\n        \"In the same file, delete line 46 (`try:`). Then move lines 47 to 50 left by four spaces so they sit directly under `async def call`.\",\n        \"Open `config/tools.yaml`. Delete lines 91 to 93, the `direct_route:` key with its `endpoint` and `audience`, under `escalate_to_human`.\",\n        \"Open `k8s/networkpolicy.yaml`. Delete lines 48 to 50, the egress rule that lets the agent reach `helpdesk-mcp` directly.\",\n        \"Create the test below, then run it. Also ask the it-service-desk team to make `helpdesk-mcp` accept calls only from the gateway identity.\",\n    ]\n    return s\n\nF = {}\n\nF[\"A01\"] = dict(\n    components=[\"agent\", \"data:hr-postgres\", \"tool:escalate_to_human\", \"mcp:helpdesk\"],\n    problem=\"The agent logs in to its database with a fixed password. Escalations can also skip the gateway's identity check.\",\n    steps=[\n        \"Do E06 first. It removes the direct route to `helpdesk-mcp` that skips the gateway.\",\n        \"Ask the platform team to issue short-lived database logins for role `hr_agent`, tied to the agent's service account, for example with Vault dynamic roles.\",\n        \"Open `k8s/deployment.yaml`. Replace the `DATABASE_URL` secret on lines 51 and 52 with the short-lived login the platform team gives you.\",\n        \"In `release/manifest.yaml` line 61, write the new login lifetime next to `database_role`.\",\n        \"Ask the platform team to show that the agent database login expires on its own. Run the E06 test to confirm no call skips the gateway.\",\n    ],\n    done_when=\"The agent database login expires on its own, and no tool call skips the gateway.\",\n    effort=\"large\")\n\nF[\"A02\"] = dict(\n    components=[\"mcp:hr-tool-gateway\", \"data:audit-log\"],\n    problem=\"Some gateway denials are logged with caller-supplied or `unknown` ids. If the denial log write fails, the failure is ignored.\",\n    steps=[\n        \"Ask the identity team to add `agent_type_id` and `agent_instance_id` claims to the tokens the STS issues. Do not start the code steps until they confirm.\",\n        \"Open `src/gateway.py`. Replace lines 196 and 197 with `except Exception:` then `log.critical(\\\"gateway deny not audited\\\", extra={\\\"tool\\\": tool})`.\",\n        \"In the same file, replace line 139 with `c.get(\\\"agent_instance_id\\\") or \\\"unknown\\\",` and line 138's header lookup with `c.get(\\\"agent_type_id\\\") or \\\"unknown\\\"`.\",\n        \"Ask the security team to add an alert on the log message `gateway deny not audited`.\",\n        \"Send the gateway a request with a bad token. Check that the new `audit.gateway_decisions` row has no `missing` values, or that the alert fires.\",\n    ],\n    done_when=\"Every row in `audit.gateway_decisions` has verified type and instance ids, and a failed denial write raises an alert.\",\n    effort=\"medium\")\n\nF[\"A04\"] = dict(\n    components=[\"mcp:hr-tool-gateway\", \"api:sts\"],\n    problem=\"The gateway takes the instance id from a header the caller sets. A caller can pick any id and dodge stop and rate limits.\",\n    steps=[\n        \"Ask the identity team to add `agent_instance_id` and `agent_type_id` claims to STS tokens. Do not deploy the code steps before they confirm.\",\n        \"Open `src/credentials.py`. In the `data` dict on lines 49 to 59, add `\\\"agent_instance_id\\\": instance_id`. Add `instance_id` as an argument of `token()` and update its callers in `src/gateway_client.py`.\",\n        \"Open `src/gateway.py`. Replace line 170 with `instance = claims.get(\\\"agent_instance_id\\\", \\\"\\\")`.\",\n        \"In the same file, add `OR (scope = 'agent_type' AND value = $4)` to the SQL on line 101, and pass `claims.get(\\\"agent_type_id\\\")` as the fourth argument on line 102.\",\n        \"Send a call with a forged `X-Agent-Instance` header. Check that the gateway uses the id in the token, not the header.\",\n    ],\n    done_when=\"A stop flag on an instance or agent type blocks the gateway call, even when the header says another id.\",\n    effort=\"medium\")\n\nF[\"A05\"] = dict(\n    components=[\"agent\", \"data:audit-log\"],\n    problem=\"An operator can read the agent type id from the audit log but cannot find its manifest. Manifests are kept in CI by git commit only.\",\n    steps=[\n        \"Ask the platform team for a store that keeps manifests by `agent_type_id`, for as long as audit rows are kept (at least six months).\",\n        \"Open `.github/workflows/release.yml`. After line 58, add a step that copies `release/manifest.yaml` and `type-id.json` into that store under the id `${{ steps.typeid.outputs.id }}`.\",\n        \"Open `config/agent.yaml`. On line 4, add the store location to the ownership text so an operator knows where to look.\",\n        \"Take one agent type id from `audit.events` and fetch its manifest from the store. Confirm the owner and image digest show up.\",\n    ],\n    done_when=\"Given an `agent_type_id` from an audit row, an operator can fetch the matching manifest from the store.\",\n    effort=\"medium\")\n\nF[\"B01\"] = dict(\n    components=[\"tool:escalate_to_human\", \"mcp:hr-tool-gateway\", \"mcp:helpdesk\"],\n    problem=\"When the gateway fails, `escalate_to_human` goes straight to `helpdesk-mcp`. The gateway's tool allowlist and disable check are skipped.\",\n    steps=direct_steps(),\n    done_when=\"Every MCP tool call must pass the gateway allowlist, and no tool in `config/tools.yaml` has a `direct_route`.\",\n    effort=\"small\", test=NODIRECT_TEST)\n\nF[\"B03\"] = dict(\n    components=[\"agent\", \"api:sts\", \"data:hr-postgres\", \"mcp:hr-tool-gateway\"],\n    problem=\"The Anthropic key and database logins have no expiry or rotation. The gateway does not check how long its downstream tokens last.\",\n    steps=[\n        \"Ask the platform team to rotate secrets `hr-agent-anthropic` and `hr-agent-db` on a schedule, for example every 30 days. Ask them to write the lifetime down.\",\n        \"Open `src/gateway.py`. Replace line 126 with `data = resp.json()`. Then add `if data.get(\\\"expires_in\\\", 10**9) > 300:` and, indented under it, `raise PermissionError(\\\"downstream token too long\\\")`.\",\n        \"On the next line of the same function add `return data[\\\"access_token\\\"]`.\",\n        \"Open `release/manifest.yaml`. Under `permissions:` near line 60, add the rotation period of each secret.\",\n        \"Ask the identity team to cap downstream token lifetime at 300 seconds for audiences `hris-mcp` and `helpdesk-mcp`. Check that a longer token is refused.\",\n    ],\n    done_when=\"Each secret has a written rotation period, and the gateway refuses a downstream token that lives longer than 300 seconds.\",\n    effort=\"medium\")\n\nF[\"B04\"] = dict(\n    components=[\"tool:escalate_to_human\", \"mcp:hr-tool-gateway\", \"mcp:helpdesk\"],\n    problem=\"When the gateway errors, the agent sends escalations straight to `helpdesk-mcp`. A stop flag is not enforced on that path.\",\n    steps=direct_steps() + [\"Run the timed revocation drill (recipe B04): set a stop flag, then time how long until all calls are refused.\"],\n    done_when=\"A stop flag blocks every tool call, because every call passes through the gateway.\",\n    effort=\"small\", test=NODIRECT_TEST)\n\nF[\"B05\"] = dict(\n    components=[\"agent\", \"data:hr-postgres\", \"mcp:hr-tool-gateway\", \"tool:file_leave_request\", \"tool:escalate_to_human\"],\n    problem=\"Approval is checked only inside the agent. The agent's own database role can write approvals, and the gateway never checks one.\",\n    steps=[\n        \"Do not deploy this until the platform team has created database role `hr_approver` and given it a login.\",\n        \"Open `src/gateway.py`. Before line 177, add: if `spec.approval == \\\"subject\\\"`, look up `approvals.grants` for the `Approval-Id` header. Deny with 403 unless `used_at` is under 60 seconds old and `approved_by = subject`.\",\n        \"Open `src/gateway_client.py`. In `_post` after line 71, add the header `\\\"Approval-Id\\\": operation_id`. For approved calls, `operation_id` is the approval id.\",\n        \"Open `src/main.py`. Create a second pool from env `APPROVER_DATABASE_URL`. Pass it to `ApprovalStore` on line 169 for `confirm()` only.\",\n        \"Create `migrations/002_approval_roles.sql`. Add `REVOKE UPDATE (approved_by, approved_at) ON approvals.grants FROM hr_agent;` and grant that update plus select to `hr_approver`. Grant `hr_gateway` select on the table.\",\n        \"Send a tool call with no approval to the gateway. It must be refused with 403.\",\n    ],\n    done_when=\"The gateway refuses an approval-required tool call that has no consumed approval, and `hr_agent` cannot write `approved_by`.\",\n    effort=\"large\")\n\nF[\"B06\"] = dict(\n    components=[\"agent\", \"data:hr-postgres\", \"tool:file_leave_request\", \"tool:escalate_to_human\"],\n    problem=\"An approval is tied to the instance, operation, target and arguments, but not to the tool scope the action runs under.\",\n    steps=[\n        \"Do not deploy the code steps until the platform team has run the new migration.\",\n        \"Create `migrations/002_approval_scope.sql` with `ALTER TABLE approvals.grants ADD COLUMN scope text NOT NULL DEFAULT '';`.\",\n        \"Open `src/approvals.py`. In `consume`, add `AND scope = $7` after line 80 and add `spec_scope` as the last value on line 82. Add `spec_scope` to the signature on line 67.\",\n        \"In the same file, in `request`, add `scope` to the column list on line 48, add a `$12` placeholder on line 50, and pass the value on line 52. Add `scope` to the signature on line 43.\",\n        \"Open `src/agent.py`. Pass `spec.scope` to `self.approvals.consume(...)` on line 135, and to `self.approvals.request(...)` on line 114.\",\n        \"Approve a request, change the scope in the database, and try to consume it. It must fail with `ApprovalInvalid`.\",\n    ],\n    done_when=\"An approval that was granted for one tool scope cannot be used under a different scope.\",\n    effort=\"medium\")\n\nF[\"B07\"] = dict(\n    components=[\"agent\", \"unit:src/agent.py\"],\n    problem=\"Wall time is checked only between model steps. One step with many tool calls can run well past the 90 second limit.\",\n    steps=[\n        \"Open `src/agent.py`. Replace line 177 with `raw = await asyncio.wait_for(self.gateway.call(spec, args, ctx, state.subject_token, operation_id=operation_id), timeout=max(state.budget.remaining_seconds(), 0.1))`.\",\n        \"In the same file, add `import asyncio` as a new line 4, above `import json`.\",\n        \"Open `src/budgets.py`. At the start of `check_tool_call` (line 58), add `if time.monotonic() - self.started > self.cfg[\\\"max_wall_seconds\\\"]:` then, indented, `raise BudgetExceeded(\\\"max_wall_seconds\\\")`.\",\n        \"Create the test below and run it.\",\n    ],\n    done_when=\"A tool call that starts after the 90 second wall limit is refused with `BudgetExceeded`.\",\n    effort=\"small\",\n    test={\"file\": \"tests/test_budget_wall.py\",\n          \"code\": ('import time\\n\\nimport pytest\\n\\nfrom src.budgets import BudgetExceeded, RunBudget\\n\\n\\n'\n                   'def test_tool_call_refused_after_wall_time():\\n'\n                   '    cfg = {\"max_steps\": 12, \"max_wall_seconds\": 90, \"max_total_tokens\": 60000,\\n'\n                   '           \"max_cost_usd\": 0.4, \"max_tool_calls_per_minute\": 20, \"max_subagents\": 0}\\n'\n                   '    budget = RunBudget(cfg, {})\\n'\n                   '    budget.started = time.monotonic() - 100\\n'\n                   '    with pytest.raises(BudgetExceeded):\\n'\n                   '        budget.check_tool_call()\\n'),\n          \"run\": \"python -m pytest tests/test_budget_wall.py\"})\n\nF[\"B08\"] = dict(\n    components=[\"tool:escalate_to_human\", \"mcp:helpdesk\", \"mcp:hr-tool-gateway\"],\n    problem=\"The agent pod may open a network connection to the production helpdesk server directly. That path skips the tool gateway.\",\n    steps=direct_steps(),\n    done_when=\"The agent pod has no network route to `helpdesk-mcp`, and no tool has a `direct_route`.\",\n    effort=\"small\", test=NODIRECT_TEST)\n\nF[\"B09\"] = dict(\n    components=[\"tool:escalate_to_human\", \"mcp:helpdesk\", \"mcp:hr-tool-gateway\"],\n    problem=\"The agent's egress policy lets it reach `helpdesk-mcp` directly, and the client code uses it. Blocked traffic is not shown to reach a responder.\",\n    steps=direct_steps() + [\"Ask the platform team to show that Cilium drop alerts for the `hr-agent` namespace reach the on-call person.\"],\n    done_when=\"The agent cannot reach `helpdesk-mcp`, and a blocked connection raises an alert for the on-call person.\",\n    effort=\"small\", test=NODIRECT_TEST)\n\nF[\"B10\"] = dict(\n    components=[\"agent\"],\n    problem=\"Kyverno accepts any digest-pinned image from `registry.acme.example` in `hr-agent`, even one that no signature rule covers.\",\n    steps=[\n        \"Open `k8s/admission.yaml`. On line 35, replace the pattern with `\\\"registry.acme.example/people/hr-helpdesk-agent@sha256:* | registry.acme.example/platform/*@sha256:*\\\"`.\",\n        \"On line 33 (the `initContainers` pattern), make the same replacement.\",\n        \"Ask the platform team for the Kyverno version. In `release/manifest.yaml`, change line 74 to `admission: [k8s/admission.yaml]  # kyverno <version>`.\",\n        \"Run `kyverno test` with a pod whose image is `registry.acme.example/other/app@sha256:...`. It must be rejected.\",\n    ],\n    done_when=\"Kyverno rejects a pod in `hr-agent` whose image is not under the two signed registry paths.\",\n    effort=\"small\")\n\nF[\"B12\"] = dict(\n    components=[\"agent\", \"unit:src/agent.py\"],\n    problem=\"Code shows that only `main` is deployed. Nothing shows that the `main` branch blocks force pushes and needs code owner review.\",\n    steps=[\n        \"Ask a repository admin to open the repository settings, then Rules, then the ruleset for `main`.\",\n        \"Ask them to run `gh api repos/acme/hr-helpdesk-agent/rulesets` and save the JSON output.\",\n        \"Check that the ruleset blocks force pushes, blocks deletion, and requires review from code owners.\",\n        \"Save the output as `release/evidence/main-ruleset.json`. Create the folder if it does not exist.\",\n        \"Ask the security team to read the file and confirm the three rules are on.\",\n    ],\n    done_when=\"A saved export of the `main` ruleset shows force push blocked, deletion blocked and code owner review required.\",\n    effort=\"small\")\n\nF[\"C01\"] = dict(\n    components=[\"agent\", \"tool:escalate_to_human\", \"mcp:hris\", \"mcp:helpdesk\"],\n    problem=\"The release manifest leaves out the direct route to `helpdesk-mcp`. Some entries have no owner or fixed version.\",\n    steps=[\n        \"Do E06 first. It removes the direct route, so the manifest needs no entry for it.\",\n        \"Open `release/manifest.yaml`. On lines 54 and 55, add `version_or_digest:` to each MCP server. Ask hris-platform and it-service-desk for the values.\",\n        \"On lines 34, 31 to 33 and 36, add `owner:` and a `ref:` (a git commit or digest) to the prompt, harness and configuration entries.\",\n        \"Compare the manifest with `config/tools.yaml`. Every server and tool in that file must appear in the manifest.\",\n    ],\n    done_when=\"Every artifact in the release manifest has an owner and a fixed version, and the manifest lists no direct route.\",\n    effort=\"medium\")\n\nF[\"C02\"] = dict(\n    components=[\"agent\"],\n    problem=\"One team, people-platform, owns every line of `CODEOWNERS`. It alone can approve config, k8s and release changes. No emergency path is written down.\",\n    steps=[\n        \"Open `CODEOWNERS`. After line 10, add `/src/ @acme/people-platform @acme/security-engineering`, `/Dockerfile @acme/security-engineering` and `/requirements.txt @acme/security-engineering`.\",\n        \"On line 8 (`/release/`) and line 3 (`/config/`), keep only the security team. Remove `@acme/people-platform` from both.\",\n        \"On line 6 (`/k8s/`), keep only `@acme/platform-security`. On line 1, change the owner to `@acme/people-platform @acme/security-engineering`.\",\n        \"Create `release/break-glass.md`. List who may approve an emergency change, what to record (reason, time, approver), and that a second review follows within two working days.\",\n        \"Ask the security team to turn on \\\"Require review from Code Owners\\\" for `main`. Then open a test pull request that edits `config/agent.yaml`. It must need a security reviewer.\",\n    ],\n    done_when=\"A change to `config/`, `k8s/` or `release/` cannot be merged with only a people-platform approval.\",\n    effort=\"small\")\n\nF[\"C03\"] = dict(\n    components=[\"agent\", \"unit:src/agent.py\"],\n    problem=\"Only Kyverno and the pod itself check what is running. Nothing outside the agent compares the running image and type id with the approved manifest.\",\n    steps=[\n        \"Ask the platform team for read-only cluster access for a CI job, limited to the `hr-agent` namespace.\",\n        \"Create `.github/workflows/verify-running.yml` with a daily schedule. It runs `kubectl get deploy hr-helpdesk-agent -n hr-agent -o jsonpath='{.spec.template.spec.containers[0].image}'`.\",\n        \"In the same job, read `.release.image.digest` and `.release.agent_type_id` from `release/manifest.yaml` with `yq`. Fail the job if the digest or the type id differs.\",\n        \"Add a step that sends the failure to the on-call channel. Ask the operations team to name the channel.\",\n        \"Change the digest in a staging copy of the manifest. Run the job. It must fail and alert.\",\n    ],\n    done_when=\"A scheduled job outside the agent fails and alerts when the running image digest or type id differs from the approved manifest.\",\n    effort=\"medium\")\n\nF[\"C04\"] = dict(\n    components=[\"agent\", \"mcp:hr-tool-gateway\"],\n    problem=\"The only drift check is a hash at pod start. Network policy, permissions and the MCP server list are never compared, and no alert is sent.\",\n    steps=[\n        \"Ask the platform team to turn on GitOps drift detection, for example Argo CD or Flux, for everything in `k8s/` in the `hr-agent` namespace.\",\n        \"Ask them to set an alert on any drift and a response time limit, for example one hour. Ask them to write both in `release/manifest.yaml`.\",\n        \"Create `.github/workflows/verify-config.yml` that compares `.mcp.json` and `config/tools.yaml` with the copy in the release artifact. Fail on any difference.\",\n        \"Change a network rule in a staging cluster by hand. Check that the alert fires within the time limit.\",\n    ],\n    done_when=\"A hand change to a network rule, permission or MCP server list raises an alert within the stated time limit.\",\n    effort=\"large\")\n\nF[\"C05\"] = dict(\n    components=[\"agent\"],\n    problem=\"The Dockerfile pulls its build syntax image by the changeable tag `docker/dockerfile:1.10`. The tag can point to different code later.\",\n    steps=[\n        \"Run `docker buildx imagetools inspect docker/dockerfile:1.10`. Copy the `Digest:` value.\",\n        \"Open `Dockerfile`. Change line 1 to `# syntax=docker/dockerfile:1.10@sha256:<digest>` using the digest you copied.\",\n        \"Create the test below and run it. Then run the release build once to check that it still works.\",\n    ],\n    done_when=\"Line 1 of `Dockerfile` names the syntax image with a `sha256` digest.\",\n    effort=\"small\",\n    test={\"file\": \"tests/test_dockerfile_pin.py\",\n          \"code\": ('def test_syntax_frontend_is_pinned_by_digest():\\n'\n                   '    with open(\"Dockerfile\", encoding=\"utf-8\") as fh:\\n'\n                   '        assert \"@sha256:\" in fh.readline()\\n'),\n          \"run\": \"python -m pytest tests/test_dockerfile_pin.py\"})\n\nF[\"C06\"] = dict(\n    components=[\"agent\"],\n    problem=\"Release test results are not stored with the release. The attack test suite is not in the repository.\",\n    steps=[\n        \"Open `.github/workflows/release.yml`. Replace line 58 with a block: `path: |` then, on three lines below, `type-id.json`, `release/manifest.yaml` and `test-results.xml`.\",\n        \"On line 29, change the command to `python -m pytest -q tests/release --junitxml=test-results.xml`.\",\n        \"Create `tests/release/test_attacks.py`. Add tests that send injected tool output, a forged approval and a tool name that looks like another. Each must be refused.\",\n        \"Run the release workflow on a test branch. Check that the artifact `release-<sha>` now contains `test-results.xml`.\",\n    ],\n    done_when=\"The release artifact holds the test results next to the manifest and type id.\",\n    effort=\"medium\")\n\nF[\"C07\"] = dict(\n    components=[\"agent\", \"model:claude-sonnet-4-5-20250929\"],\n    problem=\"There is no recovery or rollback procedure. The hosted model's retirement date is not recorded.\",\n    steps=[\n        \"Open `config/agent.yaml`. After line 11, add `retirement_date: \\\"YYYY-MM-DD\\\"`. Copy the date from the provider's model deprecation page for this model id.\",\n        \"Open `release/manifest.yaml`. Under `release:`, add `previous:` with the last approved image digest and type id.\",\n        \"Create `release/rollback.md`. Give the exact `kubectl` steps to go back to `previous`, and say that stop flags in `control.stop_flags` must stay on.\",\n        \"Ask the operations team to run the rollback in staging and write the date in `release/rollback.md`.\",\n    ],\n    done_when=\"`release/rollback.md` exists with a tested date, and `config/agent.yaml` states the model retirement date.\",\n    effort=\"medium\")\n\nF[\"C08\"] = dict(\n    components=[\"data:audit-log\"],\n    problem=\"The nightly job keeps only six weekly audit partitions. Audit rows are deleted after about six weeks, not six months.\",\n    steps=[\n        \"Open `k8s/audit-maintenance.yaml`. On line 35, change `value: \\\"6\\\"` to `value: \\\"27\\\"`. That is 26 weeks plus one spare.\",\n        \"Open `release/manifest.yaml`. Line 79 says `6 months`. Leave it, and add a note that the value is set by `KEEP_PARTITIONS`.\",\n        \"Do A05 so manifests are kept as long as the audit rows. Then create the test below and run it.\",\n    ],\n    done_when=\"`KEEP_PARTITIONS` in `k8s/audit-maintenance.yaml` is at least 27.\",\n    effort=\"small\", test=KEEP_TEST)\n\nF[\"E01\"] = dict(\n    components=[\"agent\", \"api:sts\", \"api:sso\", \"api:otel-collector\", \"data:hr-postgres\"],\n    problem=\"The release manifest leaves out services the code calls. Entries do not name an agent-team owner and a platform owner.\",\n    steps=[\n        \"Open `release/manifest.yaml`. After line 80, add a `dependencies:` list. Add one entry each for STS, SSO, the stop channel `control.stop_flags` and the telemetry collector.\",\n        \"Give each entry a `service`, an `agent_team_owner`, a `platform_owner` and `evidence:`. Use `src/credentials.py:18`, `src/main.py:36`, `src/killswitch.py:18` and `src/main.py:52`.\",\n        \"Add the same two owners to the MCP server entries on lines 54 and 55.\",\n        \"Compare the list with every URL in `src/`. Each outside service must be in the manifest.\",\n    ],\n    done_when=\"Every service the code calls has a manifest entry with an agent-team owner and a platform owner.\",\n    effort=\"small\")\n\nF[\"E02\"] = dict(\n    components=[\"agent\"],\n    problem=\"No scan looks for known flaws in packages. The base image signature is not checked. Packages and remote MCP servers have no approval record.\",\n    steps=[\n        \"Open `.github/workflows/release.yml`. After line 39, add a step that runs Trivy on `${IMAGE}@${{ steps.build.outputs.digest }}` with `--exit-code 1 --severity HIGH,CRITICAL`.\",\n        \"After line 29, add a step: `cosign verify` on the distroless base image digest from `Dockerfile` line 8, with the publisher's certificate identity and issuer.\",\n        \"After line 28, add `pip install pip-audit` and `pip-audit -r requirements.txt --require-hashes`.\",\n        \"Create `release/dependency-approvals.md`. For each package and MCP server, record the publisher, its permissions, the update source and who approved it.\",\n        \"Push a test branch with a known-bad package version pinned. The workflow must fail.\",\n    ],\n    done_when=\"The release workflow fails on a known-vulnerable package, and every package and server has an approval record.\",\n    effort=\"medium\")\n\nF[\"E03\"] = dict(\n    components=[\"mcp:hris\", \"mcp:helpdesk\", \"mcp:hr-tool-gateway\"],\n    problem=\"The gateway checks tool descriptions, but nothing records which version of each MCP server is approved, or when it is next reviewed.\",\n    steps=[\n        \"Ask hris-platform and it-service-desk for the image digest or version of `hris-mcp` and `helpdesk-mcp`, and for the date of their last review.\",\n        \"Open `release/manifest.yaml`. On lines 54 and 55, add `version_or_digest:` and `review_by:` to each server.\",\n        \"Open `config/tools.yaml`. Under each server on lines 4 to 13, add `version_or_digest:` with the same value.\",\n        \"Check that every server in `config/tools.yaml` has the two fields in the manifest.\",\n    ],\n    done_when=\"Each MCP server in the manifest has a recorded version or digest and a review date.\",\n    effort=\"small\")\n\nF[\"E05\"] = dict(\n    components=[\"mcp:hr-tool-gateway\"],\n    problem=\"The lookalike name check misses letters from other alphabets that look the same, and it only writes a log line.\",\n    steps=[\n        \"Open `src/gateway.py`. After line 48, add `_blocked_servers: set[str] = set()`.\",\n        \"In `mcp()`, change line 166 to also deny when `spec.server in _blocked_servers`.\",\n        \"In `refresh_fingerprints`, replace lines 66 and 67 with: if the name is a lookalike, add both server ids to `_blocked_servers` and log the error.\",\n        \"Before line 65, add `if not name.isascii(): _blocked_servers.add(server_id)`. After line 60, add `_blocked_servers.clear()`.\",\n        \"Make a test server list a tool named with a Cyrillic `а`. Check that every call to that server is refused with 403.\",\n    ],\n    done_when=\"A server that lists a non-ASCII or lookalike tool name has all its tools refused by the gateway.\",\n    effort=\"medium\")\n\nF[\"E06\"] = dict(\n    components=[\"tool:escalate_to_human\", \"mcp:helpdesk\", \"mcp:hr-tool-gateway\"],\n    problem=\"When the gateway is down, `escalate_to_human` goes straight to `helpdesk-mcp` with a token the agent makes itself. All gateway checks are skipped.\",\n    steps=direct_steps() + [\"Update `README.md` line 36, which says escalations are delivered during gateway maintenance. State that they now wait.\"],\n    done_when=\"No tool call can reach `helpdesk-mcp` without passing the gateway, and `config/tools.yaml` has no `direct_route`.\",\n    effort=\"small\", test=NODIRECT_TEST)\n\nF[\"E09\"] = dict(\n    components=[\"agent\", \"api:sts\", \"data:audit-log\"],\n    problem=\"A stop cancels running work, but cached 300 second tokens stay. Effects that finished before the stop are not recorded for follow-up.\",\n    steps=[\n        \"Open `src/main.py`. Make `startup` (line 163) build `creds = CredentialBroker(mtls)`, and use `creds` on line 172. Add `creds` to the `global` list on line 164. Declare `creds: CredentialBroker` near line 60.\",\n        \"In `_drive`, after the `audit.record` calls on lines 91 and 94, add `creds.drop_subject(ctx.subject)`.\",\n        \"In the same two places, also record `await audit.record(ctx, \\\"stop_reconcile\\\", decision=\\\"stop\\\", result={\\\"completed\\\": _runs[ctx.run_id][1].extra.get(\\\"completed\\\", [])})`.\",\n        \"Open `src/agent.py`. After line 193 (`tool_result` audit call), add `state.extra.setdefault(\\\"completed\\\", []).append(f\\\"{spec.qualified}:{operation_id}\\\")`.\",\n        \"Ask the identity team for a token revoke call on the STS. Add it next to `drop_subject`.\",\n        \"Set a stop flag mid-run. Check that the cache is empty and a `stop_reconcile` row lists the finished calls, within 10 seconds.\",\n    ],\n    done_when=\"After a stop, the agent holds no cached tokens for that employee, and a `stop_reconcile` audit row lists completed tool calls.\",\n    effort=\"medium\")\n\nF[\"E10\"] = dict(\n    components=[\"mcp:hr-tool-gateway\", \"data:audit-log\", \"mcp:hris\", \"mcp:helpdesk\"],\n    problem=\"Gateway audit rows take ids from unverified headers and never store the vendor's receipt id. Direct route calls leave no gateway row.\",\n    steps=[\n        \"Do E06 first. It removes the direct route. Do A02 first. It fixes the unverified ids.\",\n        \"Create `migrations/002_gateway_receipt.sql` with `ALTER TABLE audit.gateway_decisions ADD COLUMN vendor_receipt_id text;`.\",\n        \"Open `src/gateway.py`. In line 190, pass `receipt=structured.get(\\\"request_id\\\") or structured.get(\\\"ticket_id\\\")` to `_log`.\",\n        \"In `_log` (line 129), add `receipt: str | None = None`. Add `vendor_receipt_id` and `$13` to the SQL on lines 134 to 136, and pass `receipt` on line 140.\",\n        \"Make one allowed call in staging. Check that the new row holds the ticket or request id.\",\n    ],\n    done_when=\"Every allowed gateway call has a row in `audit.gateway_decisions` with the vendor receipt id.\",\n    effort=\"medium\")\n\nF[\"E11\"] = dict(\n    components=[\"data:audit-log\", \"mcp:hr-tool-gateway\"],\n    problem=\"Audit partitions are dropped after about six weeks. Rows have no way to show gaps. The gateway writes the allow record only after it acts.\",\n    steps=[\n        \"Open `src/gateway.py`. Before line 177, add `await _log(request, claims, tool, \\\"pending\\\", \\\"forwarding\\\")` so a record exists before the call is sent.\",\n        \"Open `k8s/audit-maintenance.yaml`. On line 35, change `value: \\\"6\\\"` to `value: \\\"27\\\"`.\",\n        \"Ask the data-platform team to add a sequence number or hash chain to `audit.events`, and an alert when numbers skip.\",\n        \"Create the test below and run it. Then ask the data-platform team to show a gap alert firing in staging.\",\n    ],\n    done_when=\"Audit rows are kept for at least 26 weeks, and a missing row raises an alert.\",\n    effort=\"medium\", test=KEEP_TEST)\n\nF[\"E12\"] = dict(\n    components=[\"agent\", \"mcp:helpdesk\", \"mcp:hr-tool-gateway\"],\n    problem=\"Stop flags and tool checks exist, but no drill shows the team can find and stop work tied to a bad MCP server.\",\n    steps=[\n        \"Create `runbooks/compromised-mcp.md`. List who runs the drill, who is paged, and the steps below.\",\n        \"In staging, pretend `helpdesk-mcp` is bad. Run `SELECT DISTINCT agent_instance_id FROM audit.events WHERE tool LIKE 'helpdesk/%'` to find the affected instances.\",\n        \"Set a stop flag in `control.stop_flags` and disable the tool in the gateway. Revoke the tokens. Check that an alert reaches the responder.\",\n        \"Write the date, the time taken and any problem at the end of `runbooks/compromised-mcp.md`.\",\n    ],\n    done_when=\"`runbooks/compromised-mcp.md` has a dated drill record showing instances found, work stopped and the responder alerted.\",\n    effort=\"medium\")\n\nF[\"R01\"] = dict(\n    components=[\"unit:src/agent.py\", \"mcp:hr-tool-gateway\", \"mcp:helpdesk\"],\n    problem=\"Error messages from tools reach the model as free text. They get no size, content or redaction checks.\",\n    steps=[\n        \"Open `src/gateway_client.py`. Replace line 94 with `raise ToolError(200, \\\"upstream error\\\")`. Replace line 91 with `raise ToolError(resp.status_code, \\\"upstream error\\\")`.\",\n        \"Open `src/gateway.py`. Replace line 184 with `return JSONResponse({\\\"error\\\": \\\"upstream_error\\\"}, status_code=502)`.\",\n        \"Open `src/agent.py`. Replace line 188 with `return _tool_result(tool_use_id, f\\\"{spec.name} failed with status {exc.status}.\\\", error=True)`.\",\n        \"Keep line 186. The audit log still stores the detail, and the audit writer redacts it.\",\n        \"Make a fake tool return an error that says \\\"ignore previous instructions\\\". Check that the model sees only the fixed text.\",\n    ],\n    done_when=\"The model only ever sees a fixed error message with the status number, never text from a tool.\",\n    effort=\"small\")\n\nF[\"R02\"] = dict(\n    components=[\"unit:src/agent.py\", \"mcp:hr-tool-gateway\"],\n    problem=\"Tool results are labeled as untrusted, but error results pass raw text with no label. Injection tests are not repeated or adaptive.\",\n    steps=[\n        \"Do R01 first. It makes error text fixed.\",\n        \"Open `src/agent.py`. On line 188, wrap the fixed text in the envelope: `json.dumps({\\\"source\\\": spec.qualified, \\\"trust\\\": \\\"untrusted_data\\\", \\\"data\\\": {\\\"error\\\": f\\\"status {exc.status}\\\"}})`.\",\n        \"Create `tests/release/test_injection.py`. Send 20 different injected strings in tool results, retried with new wording. Record how many get the model to act.\",\n        \"Write the success rate in `release/manifest.yaml` and set a maximum, for example zero.\",\n        \"Run `python -m pytest tests/release/test_injection.py`.\",\n    ],\n    done_when=\"Every tool result and error reaches the model inside the `untrusted_data` envelope, and injection test results are recorded.\",\n    effort=\"medium\")\n\nF[\"R03\"] = dict(\n    components=[\"unit:src/agent.py\", \"mcp:hr-tool-gateway\"],\n    problem=\"Tool error text reaches the model without redaction. Logs, audit rows and tool output are redacted.\",\n    steps=[\n        \"Open `src/agent.py`. Replace line 188 with `return _tool_result(tool_use_id, f\\\"{spec.name} failed with status {exc.status}.\\\", error=True)`.\",\n        \"Keep lines 186 and 187. The audit row and the log already redact the detail.\",\n        \"Ask the HR portal team to confirm that its content security policy has `img-src` limited to approved hosts.\",\n        \"Make a fake tool return an error with an email address. Check that the model sees only the fixed text.\",\n    ],\n    done_when=\"The model never sees raw tool error text, and the HR portal blocks images from other hosts.\",\n    effort=\"small\")\n\nF[\"R04\"] = dict(\n    components=[\"data:hr-postgres\", \"tool:search_policies\"],\n    problem=\"The handbook search cache ignores who is asking. A result cached for one employee can be shown to another.\",\n    steps=[\n        \"Open `src/retrieval.py`. Replace line 46 with `key = self._key(query, employee_id)`.\",\n        \"In the same file, change line 40 to `def _key(self, query: str, employee_id: str) -> str:`.\",\n        \"Change line 42 to `return hashlib.sha256(f\\\"{self._top_k}|{employee_id}|{normalized}\\\".encode()).hexdigest()`.\",\n        \"Create the test below and run it.\",\n    ],\n    done_when=\"Two different employees asking the same question never share a cache entry.\",\n    effort=\"small\",\n    test={\"file\": \"tests/test_retrieval_cache.py\",\n          \"code\": ('from src.retrieval import PolicyIndex\\n\\n\\n'\n                   'def test_cache_key_differs_per_employee():\\n'\n                   '    index = PolicyIndex(None, 5, 900.0)\\n'\n                   '    assert index._key(\"leave policy\", \"emp-1\") != index._key(\"leave policy\", \"emp-2\")\\n'),\n          \"run\": \"python -m pytest tests/test_retrieval_cache.py\"})\n\nF[\"R07\"] = dict(\n    components=[\"unit:src/agent.py\", \"data:audit-log\"],\n    problem=\"Only model call rows hold the context size. Action rows have none, and approved actions run under a new trace.\",\n    steps=[\n        \"Open `src/agent.py`. After line 76, add `state.extra[\\\"context_tokens\\\"] = ctx_tokens`.\",\n        \"In `_handle_tool` and `_execute`, add `context_tokens=state.extra.get(\\\"context_tokens\\\"), context_tokens_method=\\\"measured:provider_usage_input+cache_read+cache_write\\\"` to every `self.audit.record(...)` call.\",\n        \"On line 76, if `resp.usage.cache_read_input_tokens` is `None`, set the method text to `\\\"measured:input_only_cache_unreported\\\"` instead of counting it as 0.\",\n        \"Before line 119 (pause for approval), save the trace headers: `inject(carrier := {})` and `state.extra[\\\"carrier\\\"] = carrier`.\",\n        \"In `resume_with_approval` (line 124), start the span with `context=TraceContextTextMapPropagator().extract(state.extra[\\\"carrier\\\"])`.\",\n        \"Run one approved action. Check that all its `audit.events` rows share one `trace_id` and carry `context_tokens`.\",\n    ],\n    done_when=\"Every audit row for a model step or action has `context_tokens`, and an approved action keeps the trace id of its run.\",\n    effort=\"medium\")\n\nF[\"R08\"] = dict(\n    components=[\"agent\", \"data:audit-log\", \"mcp:hr-tool-gateway\"],\n    problem=\"Denials are written to the audit tables, but no rule watches them and no named person receives an alert.\",\n    steps=[\n        \"Ask the security team which SIEM they use and who is on call for this agent.\",\n        \"Create `detections/hr-agent-rules.md`. Write rules over `audit.events` and `audit.gateway_decisions`: many denials per employee in 5 minutes, any `authn` failure, and any `tool_denied` event.\",\n        \"Ask the security team to load the rules and route them to the named responder.\",\n        \"Run recipe R08. Trigger each rule in staging and note the time the responder was paged.\",\n    ],\n    done_when=\"Each rule fires in staging and pages the named responder.\",\n    effort=\"medium\")\n\nF[\"R09\"] = dict(\n    components=[\"agent\", \"data:audit-log\", \"tool:file_leave_request\", \"tool:escalate_to_human\"],\n    problem=\"Each action is checked by the employee, but nothing looks at action sequences or tests different kinds of content separately.\",\n    steps=[\n        \"Ask the security team who owns sequence detection for this agent.\",\n        \"Create `detections/hr-agent-sequences.md`. Write rules such as: three approval requests in one run, or a ticket right after a policy search.\",\n        \"Add a test run per content range: handbook text, employee messages and tool output. Write the result of each in the same file.\",\n        \"Ask the security team to load the rules and show one firing in staging.\",\n    ],\n    done_when=\"Sequence rules exist, fire in staging, and results are listed per content range.\",\n    effort=\"medium\")\n\nF[\"R10\"] = dict(\n    components=[\"agent\", \"model:claude-sonnet-4-5-20250929\"],\n    problem=\"Nothing says whether deliberate model misalignment is in scope. No second reviewer model is present.\",\n    steps=[\n        \"Ask the security team and the business owner to decide whether deliberate misalignment is in scope for this agent.\",\n        \"Open `release/manifest.yaml`. After line 29, add `misalignment_scope:` with `in_scope: yes` or `no`, the reason and the approver.\",\n        \"If it is in scope, run recipe R10 and store the result in `release/evidence/`. If not, ask governance to approve an N/A record.\",\n    ],\n    done_when=\"`release/manifest.yaml` states whether misalignment is in scope, who decided, and links the R10 result or N/A approval.\",\n    effort=\"small\")\n\nF[\"R11\"] = dict(\n    components=[\"mcp:hr-tool-gateway\", \"tool:escalate_to_human\", \"agent\"],\n    problem=\"A stop on an agent type is enforced only in the agent. The gateway does not check it, and escalations can skip the gateway.\",\n    steps=[\n        \"Do A04 first. It puts `agent_type_id` in the token. Do E06 first. It removes the direct route.\",\n        \"Open `src/gateway.py`. On line 102, add `claims.get(\\\"agent_type_id\\\")` as a fourth argument after `claims[\\\"act\\\"][\\\"sub\\\"]`.\",\n        \"On line 101, add `OR (scope = 'agent_type' AND value = $4)` inside the `WHERE`.\",\n        \"Run recipe R11. Set an `agent_type` stop flag, time how long until the gateway refuses calls, and save the dated result.\",\n    ],\n    done_when=\"A stop flag with scope `agent_type` makes the gateway refuse that agent's tool calls.\",\n    effort=\"small\")\n\nF[\"R12\"] = dict(\n    components=[\"tool:file_leave_request\", \"tool:escalate_to_human\", \"unit:src/agent.py\"],\n    problem=\"No tool says what happens on a stop. A write that times out is returned to the model as a normal error, so it may be tried again.\",\n    steps=[\n        \"Open `src/agent.py`. In `_execute`, before line 183, add a branch: if `exc.status == 504`, store `state.extra[\\\"hold\\\"] = operation_id`, record an `outcome_unknown` audit event, and return a fixed message.\",\n        \"In `_handle_tool`, before line 106, add: if `state.extra.get(\\\"hold\\\")`, return `_tool_result(tool_use_id, \\\"An advisor will check this first.\\\", error=True)`.\",\n        \"Open `config/tools.yaml`. Under each tool (lines 18, 30, 55 and 82) add `on_stop:` as `cancel`, `complete` or `reconcile`.\",\n        \"Ask hris-platform and it-service-desk how to check a request by its `Idempotency-Key`. Write the answer in `release/runbook.md`. Create it.\",\n        \"Simulate a timeout in staging. Check that no second call is sent and a hold row exists.\",\n    ],\n    done_when=\"A timed-out write is held with an owner, and no retry is sent until someone checks the other system.\",\n    effort=\"medium\")\n\nF[\"R13\"] = dict(\n    components=[\"unit:src/agent.py\", \"mcp:hr-tool-gateway\", \"data:audit-log\"],\n    problem=\"A gateway outage on a normal tool leaves no step record. Retries by the model library are not recorded.\",\n    steps=[\n        \"Open `src/main.py`. On line 172, change `AsyncAnthropic(max_retries=1)` to `AsyncAnthropic(max_retries=0)`.\",\n        \"Open `src/agent.py`. Before line 179, add `except GatewayUnavailable as exc:`. Record `tool_error` with `reason=f\\\"gateway unavailable, operation {operation_id}\\\"`. Return `_tool_result(tool_use_id, \\\"The tool is not available right now.\\\", error=True)`.\",\n        \"On line 18, add `GatewayUnavailable` to the import from `.gateway_client`.\",\n        \"Do E06 first, so no fallback call goes unrecorded.\",\n        \"Stop the gateway in staging and make one call. Check that an `audit.events` row shows the failure.\",\n    ],\n    done_when=\"A call that fails because the gateway is down has an audit row naming the operation id.\",\n    effort=\"small\")\n\nF[\"R14\"] = dict(\n    components=[\"tool:escalate_to_human\", \"mcp:hr-tool-gateway\", \"mcp:helpdesk\"],\n    problem=\"After a 503 from the gateway, the agent resends the helpdesk ticket on the direct route. The first call may already have gone through.\",\n    steps=direct_steps(\"Do R12 first. It adds the hold for an unknown outcome.\") + [\n        \"Open `src/gateway_client.py`. Replace lines 86 and 87 with: if the status is 503, `raise ToolError(503, f\\\"outcome unknown for operation {operation_id}\\\")`.\",\n        \"Ask it-service-desk to confirm that `helpdesk-mcp` ignores a repeat `Idempotency-Key`.\",\n    ],\n    done_when=\"After a 503 the agent never resends a write. It marks the outcome unknown and holds it.\",\n    effort=\"medium\", test=NODIRECT_TEST)\n\nfor f in d[\"findings\"]:\n    if f[\"rating\"] in (\"gap\", \"needs_evidence\"):\n        x = F.pop(f[\"item\"])\n        f[\"components\"] = x[\"components\"]\n        fix = {\"problem\": x[\"problem\"], \"steps\": x[\"steps\"], \"done_when\": x[\"done_when\"], \"effort\": x[\"effort\"]}\n        if \"test\" in x:\n            fix[\"test\"] = x[\"test\"]\n        f[\"fix\"] = fix\n        f[\"assignee\"] = None\nassert not F, F.keys()\njson.dump(d, open(P, \"w\"), indent=2, ensure_ascii=False)\nprint(\"ok\")\n"}}}
