        category: {enum: [payroll, leave, benefits, conduct, other]}\n99\t      required: [summary, category]\n100\t      additionalProperties: false\n101\t    output_schema:\n102\t      type: object\n103\t      properties:\n104\t        ticket_id: {type: string, pattern: \"^HR-[0-9]{6}$\"}\n105\t        queue: {type: string, maxLength: 40}\n106\t      required: [ticket_id]\n107\t      additionalProperties: false\n108\t"}]},"parent_tool_use_id":null,"session_id":"981bf4ba-51f4-44d7-811c-79f7b4ddcca3","uuid":"d9e5247e-645a-401e-9658-bc336ffc6060","timestamp":"2026-11-21T12:33:52.633Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-action-_pgwuimk/agent/config/tools.yaml","content":"policy_version: \"2026-09-18.3\"\n\nservers:\n  hris:\n    endpoint: https://hris-mcp.hris.svc.cluster.local:8443/mcp\n    identity: spiffe://acme.example/ns/hris/sa/hris-mcp\n    downstream_audience: hris-mcp\n    owner: hris-platform\n  helpdesk:\n    endpoint: https://helpdesk-mcp.helpdesk.svc.cluster.local:8443/mcp\n    identity: spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\n    downstream_audience: helpdesk-mcp\n    owner: it-service-desk\n\n# Model-facing name -> qualified tool. Server annotations (readOnlyHint etc.)\n# are never consulted; approval comes only from this file.\ntools:\n  search_policies:\n    kind: local\n    reason: \"Answer policy questions from the approved HR handbook index.\"\n    scope: hr.policy.read\n    approval: none\n    input_schema:\n      type: object\n      properties:\n        query: {type: string, minLength: 3, maxLength: 300}\n      required: [query]\n      additionalProperties: false\n\n  get_leave_balance:\n    kind: mcp\n    qualified: hris/get_leave_balance\n    server: hris\n    reason: \"Show the asking employee their own leave balance.\"\n    scope: hris.leave.read\n    approval: none\n    target: \"employee:{subject}\"\n    fingerprint: \"sha256:5d1c0e9a7b3f48e2a61c9d04