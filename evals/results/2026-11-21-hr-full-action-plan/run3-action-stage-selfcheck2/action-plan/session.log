{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017J3o6dcaxsqbEdPpZ8bSq7","type":"tool_result","content":"1\t\"\"\"Handbook search over retrieval.chunks (Postgres full-text search).\n2\t\n3\tChunks are written only by the hr-docs-ingest job (role hr_docs_ingest). Each chunk carries\n4\tsource, added_at, added_by, trust, an audience, an optional expiry and a quarantine flag.\n5\tEmployee-specific documents (offer letters, individual arrangements) have audience\n6\t'employee' and list the employees allowed to see them.\n7\t\"\"\"\n8\tfrom __future__ import annotations\n9\t\n10\timport hashlib\n11\timport time\n12\tfrom typing import Any\n13\t\n14\timport asyncpg\n15\t\n16\t_SEARCH = \"\"\"\n17\tSELECT c.chunk_id, c.source, c.trust, c.text,\n18\t       ts_rank(c.tsv, websearch_to_tsquery('english', $1)) AS rank\n19\t  FROM retrieval.chunks c\n20\t WHERE c.tsv @@ websearch_to_tsquery('english', $1)\n21\t   AND NOT c.quarantined\n22\t   AND (c.expires_at IS NULL OR c.expires_at > now())\n23\t   AND (c.audience = 'all' OR (c.audience = 'employee' AND $2 = ANY (c.allowed_employees)))\n24\t ORDER BY rank DESC\n25\t LIMIT $3\n26\t\"\"\"\n27\t\n28\t\n29\tclass PolicyIndex:\n30\t    def __init__(self, pool: asyncpg.Pool, top_k: int, cache_ttl: float):\n31\t        self._pool = pool\n32\t        self._top_k = top_k\n33\t        self._ttl = cache_ttl\n34\t        self._cache: dict[str, tuple[float, str, list[dict[str, Any]]]] = {}\n35\t\n36\t    async def _index_version(self) -> str:\n37\t        # Bumped by ingest on every add, expiry, quarantine or permission change.\n38\t        return await self._pool.fetchval(\"SELECT version FROM retrieval.index_state WHERE id = 1\")\n39\t\n40\t    def _key(self, query: str) -> str:\n41\t        normalized = \" \".join(query.lower().split())\n42\t        return hashlib.sha256(f\"{self._top_k}|{normalized}\".encode()).hexdigest()\n43\t\n44\t    async def search(self, query: str, employee_id: str) -> list[dict[str, Any]]:\n45\t        version = await self._index_version()\n46\t        key = self._key(query)\n47\t        hit = self._cache.get(key)\n48\t        if hit and hit[1] == version and time.monotonic() - hit[0] < self._ttl:\n49\t            return hit[2]\n50\t        rows = await self._pool.fetch(_SEARCH, query, employee_id, self._top_k)\n51\t        chunks = [dict(r) for r in rows]\n52\t        self._cache[key] = (time.monotonic(), version, chunks)\n53\t        return chunks\n54\t"}]},"parent_tool_use_id":null,"session_id":"981bf4ba-51f4-44d7-811c-79f7b4ddcca3","uuid":"d5b2c425-3c20-46ac-aaa1-04e7e61ccd17","timestamp":"2026-11-21T12:33:53.049Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-action-_pgwuimk/agent/src/retrieval.py","content":"\"\"\"Handbook search over retrieval.chunks (Postgres full-text search).\n\nChunks are written only by the hr-docs-ingest job (role hr_docs_ingest). Each chunk carries\nsource, added_at, added_by, trust, an audience, an optional expiry and a quarantine flag.\nEmployee-specific documents (offer letters, individual arrangements) have audience\n'employee' and list the employees allowed to see them.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport time\nfrom typing import Any\n\nimport asyncpg\n\n_SEARCH = \"\"\"\nSELECT c.chunk_id, c.source, c.trust, c.text,\n       ts_rank(c.tsv, websearch_to_tsquery('english', $1)) AS rank\n  FROM retrieval.chunks c\n WHERE c.tsv @@ websearch_to_tsquery('english', $1)\n   AND NOT c.quarantined\n   AND (c.expires_at IS NULL OR c.expires_at > now())\n   AND (c.audience = 'all' OR (c.audience = 'employee' AND $2 = ANY (c.allowed_employees)))\n ORDER BY rank DESC\n LIMIT $3\n\"\"\"\n\n\nclass PolicyIndex:\n    def __init__(self, pool: asyncpg.Pool, top_k: int, cache_ttl: float):\n        self._pool = pool\n        self._top_k = top_k\n        self._ttl = cache_ttl\n        self._cache: dict[str, tuple[float, str, list[dict[str, Any]]]] = {}\n\n    async def _index_version(self) -> str:\n        # Bumped by ingest on every add, expiry, quarantine or permission change.\n        return await self._pool.fetchval(\"SELECT version FROM retrieval.index_state WHERE id = 1\")\n\n    def _key(self, query: str) -> str:\n        normalized = \" \".join(query.lower().split())\n        return hashlib.sha256(f\"{self._top_k}|{normalized}\".encode()).hexdigest()\n\n    async def search(self, query: str, employee_id: str) -> list[dict[str, Any]]:\n        version = await self._index_version()\n        key = self._key(query)\n        hit = self._cache.get(key)\n        if hit and hit[1] == version and time.monotonic() - hit[0] < self._ttl:\n            return hit[2]\n        rows = await self._pool.fetch(_SEARCH, query, employee_id, self._top_k)\n        chunks = [dict(r) for r in rows]\n        self._cache[key] = (time.monotonic(), version, chunks)\n        return chunks\n","numLines":54,"startLine":1,"totalLines":54}},"tool_result_meta":[{"id":"toolu_017J3o6dcaxsqbEdPpZ8bSq7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChG5cqiEsuzPE4MdJJgkm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FehQsCwDZu6XuLV56H2TVo","name":"Read","input":{"file_path":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-action-_pgwuimk/agent/src/approvals.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2385,"cache_read_input_tokens":28105,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2385},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"981bf4ba-51f4-44d7-811c-79f7b4ddcca3","uuid":"766f9523-400e-4fb0-9af1-c256ec1c2252","timestamp":"2026-11-21T12:33:53.471Z","request_id":"req_011ChG5cqYZqfLSagc8UqQb9","wire_tool_inputs":{"toolu_01FehQsCwDZu6XuLV56H2TVo":{"file_path":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-action-_pgwuimk/agent/src/approvals.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FehQsCwDZu6XuLV56H2TVo","type":"tool_result","content":"1\t\"\"\"Approval records for consequential tool calls.\n2\t\n3\tAn approval is bound to one agent instance, one operation, one target and the SHA-256 of\n4\tthe canonical arguments. Only the employee on whose behalf the run acts may approve, they\n5\tsee a rendered description of the exact action, and each approval is consumed once.\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\timport hashlib\n10\timport json\n11\timport uuid\n12\tfrom datetime import timedelta\n13\tfrom typing import Any\n14\t\n15\timport asyncpg\n16\t\n17\tfrom .audit import RunContext\n18\t\n19\t\n20\tclass ApprovalInvalid(Exception):\n21\t    pass\n22\t\n23\t\n24\tdef args_digest(args: dict[str, Any]) -> str:\n25\t    canonical = json.dumps(args, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False)\n26\t    return hashlib.sha256(canonical.encode()).hexdigest()\n27\t\n28\t\n29\tdef describe(operation: str, target: str, args: dict[str, Any]) -> str:\n30\t    if operation == \"hris/file_leave_request\":\n31\t        return (f\"Submit a {args['leave_type']} leave request from {args['start_date']} to {args['end_date']} \"\n32\t                f\"for {target}. Your manager will be asked to approve it in HRIS.\")\n33\t    if operation == \"helpdesk/create_ticket\":\n34\t        return f\"Send this summary to an HR advisor ({args['category']}):\\n\\n{args['summary']}\"\n35\t    raise ValueError(operation)\n36\t\n37\t\n38\tclass ApprovalStore:\n39\t    def __init__(self, pool: asyncpg.Pool, ttl_seconds: int):\n40\t        self._pool = pool\n41\t        self._ttl = timedelta(seconds=ttl_seconds)\n42\t\n43\t    async def request(self, ctx: RunContext, operation: str, target: str, args: dict[str, Any], tool_use_id: str) -> tuple[str, str]:\n44\t        approval_id = str(uuid.uuid4())\n45\t        text = describe(operation, target, args)\n46\t        await self._pool.execute(\n47\t            \"\"\"INSERT INTO approvals.grants\n48\t                 (approval_id, run_id, agent_instance_id, subject, operation, target, args_sha256, args,\n49\t                  tool_use_id, description, requested_at, expires_at)\n50\t               VALUES ($1, $2, $3, $4, $5, $6, $7, $8::jsonb, $9, $10, now(), now() + $11)\"\"\",\n51\t            approval_id, ctx.run_id, ctx.agent_instance_id, ctx.subject, operation, target,\n52\t            args_digest(args), json.dumps(args), tool_use_id, text, self._ttl,\n53\t        )\n54\t        return approval_id, text\n55\t\n56\t    async def confirm(self, approval_id: str, approver: str) -> None:\n57\t        \"\"\"Called from the employee's authenticated session. Approver must be the run's subject.\"\"\"\n58\t        row = await self._pool.fetchrow(\n59\t            \"\"\"UPDATE approvals.grants SET approved_by = $2, approved_at = now()\n60\t                WHERE approval_id = $1 AND subject = $2 AND approved_at IS NULL AND expires_at > now()\n61\t                RETURNING approval_id\"\"\",\n62\t            approval_id, approver,\n63\t        )\n64\t        if row is None:\n65\t            raise ApprovalInvalid(\"not found, expired, already decided, or approver lacks authority\")\n66\t\n67\t    async def consume(self, ctx: RunContext, approval_id: str, operation: str, target: str, args: dict[str, Any]) -> dict[str, Any]:\n68\t        \"\"\"Atomically mark the approval used. Every binding is re-checked in the same statement.\"\"\"\n69\t        row = await self._pool.fetchrow(\n70\t            \"\"\"UPDATE approvals.grants SET used_at = now()\n71\t                WHERE approval_id = $1\n72\t                  AND used_at IS NULL\n73\t                  AND approved_at IS NOT NULL\n74\t                  AND approved_by = subject\n75\t                  AND expires_at > now()\n76\t                  AND agent_instance_id = $2\n77\t                  AND subject = $3\n78\t                  AND operation = $4\n79\t                  AND target = $5\n80\t                  AND args_sha256 = $6\n81\t                RETURNING approval_id, approved_by, approved_at, expires_at\"\"\",\n82\t            approval_id, ctx.agent_instance_id, ctx.subject, operation, target, args_digest(args),\n83\t        )\n84\t        if row is None:\n85\t            raise ApprovalInvalid(\"approval does not match this action, was used, or expired\")\n86\t        return dict(row)\n87\t\n88\t    async def pending(self, approval_id: str) -> dict[str, Any] | None:\n89\t        row = await self._pool.fetchrow(\n90\t            \"SELECT run_id, operation, target, args, tool_use_id FROM approvals.grants WHERE approval_id = $1\",\n91\t            approval_id,\n92\t        )\n93\t        if row is None:\n94\t            return None\n95\t        out = dict(row)\n96\t        out[\"args\"] = json.loads(out[\"args\"])\n97\t        return out\n98\t"}]},"parent_tool_use_id":null,"session_id":"981bf4ba-51f4-44d7-811c-79f7b4ddcca3","uuid":"f8344b20-7ba0-412f-922e-408e18dc05c3","timestamp":"2026-11-21T12:33:53.489Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-action-_pgwuimk/agent/src/approvals.py","content":"\"\"\"Approval records for consequential tool calls.\n\nAn approval is bound to one agent instance, one operation, one target and the SHA-256 of\nthe canonical arguments. Only the employee on whose behalf the run acts may approve, they\nsee a rendered description of the exact action, and each approval is consumed once.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport uuid\nfrom datetime import timedelta\nfrom typing import Any\n\nimport asyncpg\n\nfrom .audit import RunContext\n\n\nclass ApprovalInvalid(Exception):\n    pass\n\n\ndef args_digest(args: dict[str, Any]) -> str:\n    canonical = json.dumps(args, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False)\n    return hashlib.sha256(canonical.encode()).hexdigest()\n\n\ndef describe(operation: str, target: str, args: dict[str, Any]) -> str:\n    if operation == \"hris/file_leave_request\":\n        return (f\"Submit a {args['leave_type']} leave request from {args['start_date']} to {args['end_date']} \"\n                f\"for {target}. Your manager will be asked to approve it in HRIS.\")\n    if operation == \"helpdesk/create_ticket\":\n        return f\"Send this summary to an HR advisor ({args['category']}):\\n\\n{args['summary']}\"\n    raise ValueError(operation)\n\n\nclass ApprovalStore:\n    def __init__(self, pool: asyncpg.Pool, ttl_seconds: int):\n        self._pool = pool\n        self._ttl = timedelta(seconds=ttl_seconds)\n\n    async def request(self, ctx: RunContext, operation: str, target: str, args: dict[str, Any], tool_use_id: str) -> tuple[str, str]:\n        approval_id = str(uuid.uuid4())\n        text = describe(operation, target, args)\n        await self._pool.execute(\n            \"\"\"INSERT INTO approvals.grants\n                 (approval_id, run_id, agent_instance_id, subject, operation, target, args_sha256, args,\n                  tool_use_id, description, requested_at, expires_at)\n               VALUES ($1, $2, $3, $4, $5, $6, $7, $8::jsonb, $9, $10, now(), now() + $11)\"\"\",\n            approval_id, ctx.run_id, ctx.agent_instance_id, ctx.subject, operation, target,\n            args_digest(args), json.dumps(args), tool_use_id, text, self._ttl,\n        )\n        return approval_id, text\n\n    async def confirm(self, approval_id: str, approver: str) -> None:\n        \"\"\"Called from the employee's authenticated session. Approver must be the run's subject.\"\"\"\n        row = await self._pool.fetchrow(\n            \"\"\"UPDATE approvals.grants SET approved_by = $2, approved_at = now()\n                WHERE approval_id = $1 AND subject = $2 AND approved_at IS NULL AND expires_at > now()\n                RETURNING approval_id\"\"\",\n            approval_id, approver,\n        )\n        if row is None:\n            raise ApprovalInvalid(\"not found, expired, already decided, or approver lacks authority\")\n\n    async def consume(self, ctx: RunContext, approval_id: str, operation: str, target: str, args: dict[str, Any]) -> dict[str, Any]:\n        \"\"\"Atomically mark the approval used. Every binding is re-checked in the same statement.\"\"\"\n        row = await self._pool.fetchrow(\n            \"\"\"UPDATE approvals.grants SET used_at = now()\n                WHERE approval_id = $1\n                  AND used_at IS NULL\n                  AND approved_at IS NOT NULL\n                  AND approved_by = subject\n                  AND expires_at > now()\n                  AND agent_instance_id = $2\n                  AND subject = $3\n                  AND operation = $4\n                  AND target = $5\n                  AND args_sha256 = $6\n                RETURNING approval_id, approved_by, approved_at, expires_at\"\"\",\n            approval_id, ctx.agent_instance_id, ctx.subject, operation, target, args_digest(args),\n        )\n        if row is None:\n            raise ApprovalInvalid(\"approval does not match this action, was used, or expired\")\n        return dict(row)\n\n    async def pending(self, approval_id: str) -> dict[str, Any] | None:\n        row = await self._pool.fetchrow(\n            \"SELECT run_id, operation, target, args, tool_use_id FROM approvals.grants WHERE approval_id = $1\",\n            approval_id,\n        )\n        if row is None:\n            return None\n        out = dict(row)\n        out[\"args\"] = json.loads(out[\"args\"])\n        return out\n","numLines":98,"startLine":1,"totalLines":98}},"tool_result_meta":[{"id":"toolu_01FehQsCwDZu6XuLV56H2TVo","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
