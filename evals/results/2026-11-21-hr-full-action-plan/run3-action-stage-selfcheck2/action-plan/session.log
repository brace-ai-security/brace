   direct_route:\n      endpoint: https://helpdesk-mcp.helpdesk.svc.cluster.local:8443/mcp\n      audience: helpdesk-mcp\n    input_schema:\n      type: object\n      properties:\n        summary: {type: string, minLength: 10, maxLength: 1000}\n        category: {enum: [payroll, leave, benefits, conduct, other]}\n      required: [summary, category]\n      additionalProperties: false\n    output_schema:\n      type: object\n      properties:\n        ticket_id: {type: string, pattern: \"^HR-[0-9]{6}$\"}\n        queue: {type: string, maxLength: 40}\n      required: [ticket_id]\n      additionalProperties: false\n","numLines":108,"startLine":1,"totalLines":108}},"tool_result_meta":[{"id":"toolu_01BHTuLgis3hCRYKNfPbwFih","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
