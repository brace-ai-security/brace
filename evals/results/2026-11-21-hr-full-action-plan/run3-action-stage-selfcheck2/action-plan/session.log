{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017Mqcg8UxMHJHJnyNUZeecQ","type":"tool_result","content":"=== src/credentials.py\n     1\t\"\"\"Per-tool, per-employee, short-lived tokens for the agent's own workload identity.\n     2\t\n     3\tThe pod's projected service-account token (audience sts.acme.example, 10 min) is the\n     4\tactor token. The employee's verified SSO token is the subject token. The STS returns an\n     5\tRFC 8693 token whose `sub` is the employee, `act.sub` is this workload, `aud` is the\n     6\trequested audience, `scope` is exactly one tool scope, and `cnf.x5t#S256` binds it to the\n     7\tpod's mTLS certificate. Lifetime is 300 s: long enough for one approval-to-execute window\n     8\ton a single call, short enough that a copied token is useless after the run.\n     9\t\"\"\"\n    10\tfrom __future__ import annotations\n    11\t\n    12\timport asyncio\n    13\timport time\n    14\tfrom dataclasses import dataclass\n    15\t\n    16\timport httpx\n    17\t\n    18\tSTS_URL = \"https://sts.identity.svc.cluster.local/oauth2/token\"\n    19\tACTOR_TOKEN_PATH = \"/var/run/secrets/tokens/sts-token\"\n    20\tTOKEN_TTL_SECONDS = 300\n    21\tREFRESH_MARGIN_SECONDS = 30\n    22\t\n    23\t\n    24\t@dataclass\n    25\tclass _Cached:\n    26\t    token: str\n    27\t    expires_at: float\n    28\t\n    29\t\n    30\tclass CredentialBroker:\n    31\t    def __init__(self, client: httpx.AsyncClient):\n    32\t        self._client = client  # configured with the pod's SPIFFE SVID for mTLS\n    33\t        self._cache: dict[tuple[str, str, str], _Cached] = {}\n    34\t        self._lock = asyncio.Lock()\n    35\t\n    36\t    def _actor_token(self) -> str:\n    37\t        # Re-read each time: kubelet rotates the projected token on disk.\n    38\t        with open(ACTOR_TOKEN_PATH, encoding=\"utf-8\") as fh:\n    39\t            return fh.read().strip()\n    40\t\n    41\t    async def token(self, *, audience: str, scope: str, subject_token: str, subject: str) -> str:\n    42\t        key = (audience, scope, subject)\n    43\t        async with self._lock:\n    44\t            hit = self._cache.get(key)\n    45\t            if hit and hit.expires_at - REFRESH_MARGIN_SECONDS > time.time():\n    46\t                return hit.token\n    47\t            resp = await self._client.post(\n    48\t                STS_URL,\n    49\t                data={\n    50\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    51\t                    \"subject_token\": subject_token,\n    52\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:id_token\",\n    53\t                    \"actor_token\": self._actor_token(),\n    54\t                    \"actor_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n    55\t                    \"audience\": audience,\n    56\t                    \"scope\": scope,\n    57\t                    \"requested_token_type\": \"urn:ietf:params:oauth:token-type:access_token\",\n    58\t                    \"requested_ttl\": str(TOKEN_TTL_SECONDS),\n    59\t                },\n    60\t                timeout=3.0,\n    61\t            )\n    62\t            resp.raise_for_status()\n    63\t            body = resp.json()\n    64\t            ttl = min(int(body.get(\"expires_in\", TOKEN_TTL_SECONDS)), TOKEN_TTL_SECONDS)\n    65\t            self._cache[key] = _Cached(body[\"access_token\"], time.time() + ttl)\n    66\t            return body[\"access_token\"]\n    67\t\n    68\t    def drop_subject(self, subject: str) -> None:\n    69\t        for key in [k for k in self._cache if k[2] == subject]:\n    70\t            del self._cache[key]\n=== src/type_id.py\n     1\t\"\"\"agent-type-id: SHA-256 over every identity-defining input.\n     2\t\n     3\tInputs (all, no exclusions):\n     4\t  - every file under src/, prompts/ and config/, plus requirements.txt and Dockerfile\n     5\t  - the image digest the pod runs\n     6\t  - the model record (provider, requested ID, snapshot/alias label, adapter)\n     7\tCanonical form: JSON with sorted keys, no whitespace, file paths relative to the repo root\n     8\tin POSIX form, each file hashed as raw bytes. The same command runs in CI (to stamp the\n     9\trelease manifest) and at pod start (to refuse running under an identity it does not match).\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport hashlib\n    14\timport json\n    15\timport pathlib\n    16\timport sys\n    17\tfrom typing import Any\n    18\t\n    19\tROOT = pathlib.Path(__file__).resolve().parent.parent\n    20\tINPUT_DIRS = (\"src\", \"prompts\", \"config\")\n    21\tINPUT_FILES = (\"requirements.txt\", \"Dockerfile\")\n    22\tHASH_SCHEME = \"acme-agent-type-id/v1\"\n    23\t\n    24\t\n    25\tdef _file_hashes() -> dict[str, str]:\n    26\t    out: dict[str, str] = {}\n    27\t    for d in INPUT_DIRS:\n    28\t        for p in sorted((ROOT / d).rglob(\"*\")):\n    29\t            if p.is_file():\n    30\t                out[p.relative_to(ROOT).as_posix()] = hashlib.sha256(p.read_bytes()).hexdigest()\n    31\t    for f in INPUT_FILES:\n    32\t        out[f] = hashlib.sha256((ROOT / f).read_bytes()).hexdigest()\n    33\t    return out\n    34\t\n    35\t\n    36\tdef compute(image_digest: str, model: dict[str, Any]) -> tuple[str, dict[str, Any]]:\n    37\t    if not image_digest.startswith(\"sha256:\") or len(image_digest) != 71:\n    38\t        raise ValueError(\"image digest must be sha256:<64 hex>\")\n    39\t    for k in (\"provider\", \"id\", \"pinning\", \"adapter\"):\n    40\t        if k not in model:\n    41\t            raise ValueError(f\"model record missing {k}\")\n    42\t    manifest = {\"scheme\": HASH_SCHEME, \"image_digest\": image_digest, \"model\": model, \"files\": _file_hashes()}\n    43\t    canonical = json.dumps(manifest, sort_keys=True, separators=(\",\", \":\")).encode()\n    44\t    return \"sha256:\" + hashlib.sha256(canonical).hexdigest(), manifest\n    45\t\n    46\t\n    47\tdef model_record(cfg: dict[str, Any]) -> dict[str, Any]:\n    48\t    m = cfg[\"model\"]\n    49\t    return {\"provider\": m[\"provider\"], \"id\": m[\"id\"], \"pinning\": m[\"pinning\"], \"adapter\": m[\"adapter\"]}\n    50\t\n    51\t\n    52\tdef verify_or_exit(expected: str, image_digest: str, model: dict[str, Any]) -> str:\n    53\t    actual, _ = compute(image_digest, model)\n    54\t    if actual != expected:\n    55\t        print(f\"agent-type-id mismatch: expected {expected}, computed {actual}\", file=sys.stderr)\n    56\t        sys.exit(78)\n    57\t    return actual\n    58\t\n    59\t\n    60\tif __name__ == \"__main__\":\n    61\t    import yaml\n    62\t\n    63\t    cfg = yaml.safe_load((ROOT / \"config\" / \"agent.yaml\").read_text())\n    64\t    tid, man = compute(sys.argv[1], model_record(cfg))\n    65\t    json.dump({\"agent_type_id\": tid, \"inputs\": man}, sys.stdout, indent=2, sort_keys=True)\n=== src/killswitch.py\n     1\t\"\"\"Stop control. Flags live in control.stop_flags, which the agent's DB role can only read.\n     2\t\n     3\tOperators set flags with the hr_agent_operator role (see README \"Stopping the agent\").\n     4\tThe tool gateway reads the same table, so a stopped instance is refused there too.\n     5\t\"\"\"\n     6\tfrom __future__ import annotations\n     7\t\n     8\timport asyncio\n     9\timport logging\n    10\t\n    11\timport asyncpg\n    12\t\n    13\tfrom .audit import RunContext\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.stop\")\n    16\t\n    17\t_QUERY = \"\"\"\n    18\tSELECT reason FROM control.stop_flags\n    19\tWHERE active\n    20\t  AND (   scope = 'fleet'\n    21\t       OR (scope = 'agent_type'     AND value = $1)\n    22\t       OR (scope = 'agent_instance' AND value = $2)\n    23\t       OR (scope = 'subject'        AND value = $3)\n    24\t       OR (scope = 'agent_principal' AND value = $4))\n    25\tLIMIT 1\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass Stopped(Exception):\n    30\t    pass\n    31\t\n    32\t\n    33\tclass StopControl:\n    34\t    def __init__(self, pool: asyncpg.Pool, poll_seconds: float):\n    35\t        self._pool = pool\n    36\t        self._poll = poll_seconds\n    37\t\n    38\t    async def reason(self, ctx: RunContext) -> str | None:\n    39\t        try:\n    40\t            row = await self._pool.fetchrow(\n    41\t                _QUERY, ctx.agent_type_id, ctx.agent_instance_id, ctx.subject, ctx.agent_principal, timeout=1.0\n    42\t            )\n    43\t        except Exception:\n    44\t            return \"stop store unreachable\"\n    45\t        return row[\"reason\"] if row else None\n    46\t\n    47\t    async def raise_if_stopped(self, ctx: RunContext) -> None:\n    48\t        why = await self.reason(ctx)\n    49\t        if why:\n    50\t            raise Stopped(why)\n    51\t\n    52\t    async def watch(self, ctx: RunContext, task: asyncio.Task) -> None:\n    53\t        \"\"\"Cancel the run task, including any in-flight model or tool call, once a flag appears.\"\"\"\n    54\t        while not task.done():\n    55\t            why = await self.reason(ctx)\n    56\t            if why:\n    57\t                log.warning(\"stop flag observed\", extra={\"run_id\": ctx.run_id, \"reason\": why})\n    58\t                task.cancel(msg=f\"stopped: {why}\")\n    59\t                return\n    60\t            await asyncio.sleep(self._poll)\n=== src/audit.py\n     1\t\"\"\"Append-only audit records. Every record carries the six identity fields.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport json\n     5\timport logging\n     6\timport uuid\n     7\tfrom dataclasses import dataclass\n     8\tfrom typing import Any\n     9\t\n    10\timport asyncpg\n    11\tfrom opentelemetry import trace\n    12\t\n    13\tfrom .redact import redact_obj\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.audit\")\n    16\t\n    17\t\n    18\t@dataclass(frozen=True)\n    19\tclass RunContext:\n    20\t    \"\"\"Built by the harness from verified identity. Never from model output.\"\"\"\n    21\t\n    22\t    run_id: str\n    23\t    agent_instance_id: str\n    24\t    agent_type_id: str\n    25\t    tenant: str\n    26\t    subject: str              # employee whose authority is being used (verified SSO token)\n    27\t    accountable_party: str\n    28\t    operational_owner: str\n    29\t    agent_principal: str      # workload identity of this agent\n    30\t\n    31\t\n    32\tclass AuditUnavailable(Exception):\n    33\t    pass\n    34\t\n    35\t\n    36\t_INSERT = \"\"\"\n    37\tINSERT INTO audit.events (\n    38\t    event_id, ts, event_type, run_id, step_id, parent_step_id,\n    39\t    accountable_party, operational_owner, tenant, agent_type_id, agent_instance_id,\n    40\t    trace_id, span_id, traceparent,\n    41\t    delegated_subject, agent_principal,\n    42\t    tool, operation_target, decision, reason, policy_version, approval_id,\n    43\t    args_redacted, result_redacted, context_tokens, context_tokens_method, model_requested, model_served\n    44\t) VALUES (\n    45\t    $1, now(), $2, $3, $4, $5,\n    46\t    $6, $7, $8, $9, $10,\n    47\t    $11, $12, $13,\n    48\t    $14, $15,\n    49\t    $16, $17, $18, $19, $20, $21,\n    50\t    $22::jsonb, $23::jsonb, $24, $25, $26, $27\n    51\t)\n    52\t\"\"\"\n    53\t\n    54\t\n    55\tclass AuditWriter:\n    56\t    def __init__(self, pool: asyncpg.Pool, policy_version: str):\n    57\t        self._pool = pool\n    58\t        self._policy_version = policy_version\n    59\t\n    60\t    async def record(\n    61\t        self,\n    62\t        ctx: RunContext,\n    63\t        event_type: str,\n    64\t        *,\n    65\t        step_id: str | None = None,\n    66\t        parent_step_id: str | None = None,\n    67\t        tool: str | None = None,\n    68\t        target: str | None = None,\n    69\t        decision: str | None = None,\n    70\t        reason: str | None = None,\n    71\t        approval_id: str | None = None,\n    72\t        args: Any = None,\n    73\t        result: Any = None,\n    74\t        context_tokens: int | None = None,\n    75\t        context_tokens_method: str | None = None,\n    76\t        model_requested: str | None = None,\n    77\t        model_served: str | None = None,\n    78\t    ) -> str:\n    79\t        span_ctx = trace.get_current_span().get_span_context()\n    80\t        if not span_ctx.is_valid:\n    81\t            raise AuditUnavailable(\"no active trace context\")\n    82\t        trace_id = format(span_ctx.trace_id, \"032x\")\n    83\t        span_id = format(span_ctx.span_id, \"016x\")\n    84\t        traceparent = f\"00-{trace_id}-{span_id}-{span_ctx.trace_flags:02x}\"\n    85\t        event_id = str(uuid.uuid4())\n    86\t        try:\n    87\t            await self._pool.execute(\n    88\t                _INSERT,\n    89\t                event_id, event_type, ctx.run_id, step_id, parent_step_id,\n    90\t                ctx.accountable_party, ctx.operational_owner, ctx.tenant, ctx.agent_type_id, ctx.agent_instance_id,\n    91\t                trace_id, span_id, traceparent,\n    92\t                ctx.subject, ctx.agent_principal,\n    93\t                tool, target, decision, reason, self._policy_version, approval_id,\n    94\t                json.dumps(redact_obj(args)), json.dumps(redact_obj(result)),\n    95\t                context_tokens, context_tokens_method, model_requested, model_served,\n    96\t                timeout=2.0,\n    97\t            )\n    98\t        except Exception as exc:  # any failure to persist stops the run\n    99\t            log.error(\"audit write failed\", extra={\"event_type\": event_type, \"run_id\": ctx.run_id})\n   100\t            raise AuditUnavailable(str(type(exc).__name__)) from exc\n   101\t        return event_id\n=== src/budgets.py\n     1\t\"\"\"Hard limits enforced by the harness, outside the model.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport time\n     5\tfrom collections import deque\n     6\tfrom dataclasses import dataclass, field\n     7\tfrom typing import Any\n     8\t\n     9\timport asyncpg\n    10\t\n    11\tfrom .audit import RunContext\n    12\t\n    13\t\n    14\tclass BudgetExceeded(Exception):\n    15\t    def __init__(self, limit: str):\n    16\t        super().__init__(limit)\n    17\t        self.limit = limit\n    18\t\n    19\t\n    20\t@dataclass\n    21\tclass RunBudget:\n    22\t    cfg: dict[str, Any]\n    23\t    pricing: dict[str, float]\n    24\t    started: float = field(default_factory=time.monotonic)\n    25\t    steps: int = 0\n    26\t    tokens: int = 0\n    27\t    cost_usd: float = 0.0\n    28\t    tool_calls: deque = field(default_factory=deque)\n    29\t\n    30\t    def check_step(self) -> None:\n    31\t        if self.steps >= self.cfg[\"max_steps\"]:\n    32\t            raise BudgetExceeded(\"max_steps\")\n    33\t        if time.monotonic() - self.started > self.cfg[\"max_wall_seconds\"]:\n    34\t            raise BudgetExceeded(\"max_wall_seconds\")\n    35\t        if self.tokens >= self.cfg[\"max_total_tokens\"]:\n    36\t            raise BudgetExceeded(\"max_total_tokens\")\n    37\t        if self.cost_usd >= self.cfg[\"max_cost_usd\"]:\n    38\t            raise BudgetExceeded(\"max_cost_usd\")\n    39\t        self.steps += 1\n    40\t\n    41\t    def remaining_seconds(self) -> float:\n    42\t        return max(0.0, self.cfg[\"max_wall_seconds\"] - (time.monotonic() - self.started))\n    43\t\n    44\t    def record_usage(self, usage: Any) -> tuple[int, float]:\n    45\t        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n    46\t        cache_write = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n    47\t        tokens_in = usage.input_tokens + cache_read + cache_write\n    48\t        tokens = tokens_in + usage.output_tokens\n    49\t        cost = (\n    50\t            (usage.input_tokens + cache_write) * self.pricing[\"input_per_mtok\"]\n    51\t            + cache_read * self.pricing[\"cache_read_per_mtok\"]\n    52\t            + usage.output_tokens * self.pricing[\"output_per_mtok\"]\n    53\t        ) / 1_000_000\n    54\t        self.tokens += tokens\n    55\t        self.cost_usd += cost\n    56\t        return tokens, cost\n    57\t\n    58\t    def check_tool_call(self) -> None:\n    59\t        now = time.monotonic()\n    60\t        while self.tool_calls and now - self.tool_calls[0] > 60:\n    61\t            self.tool_calls.popleft()\n    62\t        if len(self.tool_calls) >= self.cfg[\"max_tool_calls_per_minute\"]:\n    63\t            raise BudgetExceeded(\"max_tool_calls_per_minute\")\n    64\t        self.tool_calls.append(now)\n    65\t\n    66\t    def check_subagent(self, started_so_far: int) -> None:\n    67\t        if started_so_far >= self.cfg[\"max_subagents\"]:\n    68\t            raise BudgetExceeded(\"max_subagents\")\n    69\t\n    70\t\n    71\t_WINDOW = \"to_timestamp(floor(extract(epoch FROM now()) / $3) * $3)\"\n    72\t\n    73\t_RESERVE_RUN = f\"\"\"\n    74\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    75\tVALUES ($1, $2, {_WINDOW}, 1, 0, 0)\n    76\tON CONFLICT (scope, key, window_start) DO UPDATE\n    77\t   SET runs = quota.usage.runs + 1\n    78\t WHERE quota.usage.runs + 1 <= $4\n    79\t   AND quota.usage.tokens < $5\n    80\t   AND quota.usage.cost_usd < $6\n    81\tRETURNING runs\n    82\t\"\"\"\n    83\t\n    84\t_RECORD_USAGE = f\"\"\"\n    85\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    86\tVALUES ($1, $2, {_WINDOW}, 0, $4, $5)\n    87\tON CONFLICT (scope, key, window_start) DO UPDATE\n    88\t   SET tokens = quota.usage.tokens + EXCLUDED.tokens,\n    89\t       cost_usd = quota.usage.cost_usd + EXCLUDED.cost_usd\n    90\tRETURNING tokens, cost_usd\n    91\t\"\"\"\n    92\t\n    93\t\n    94\tclass QuotaStore:\n    95\t    \"\"\"Per-user, per-tenant and fleet-wide quotas, shared by every replica.\"\"\"\n    96\t\n    97\t    def __init__(self, pool: asyncpg.Pool, quotas: list[dict[str, Any]]):\n    98\t        self._pool = pool\n    99\t        self._quotas = quotas\n   100\t\n   101\t    def _key(self, scope: str, ctx: RunContext) -> str:\n   102\t        return {\"user\": ctx.subject, \"tenant\": ctx.tenant, \"fleet\": \"all\"}[scope]\n   103\t\n   104\t    async def reserve_run(self, ctx: RunContext) -> None:\n   105\t        async with self._pool.acquire() as conn, conn.transaction():\n   106\t            for q in self._quotas:\n   107\t                row = await conn.fetchrow(\n   108\t                    _RESERVE_RUN, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"],\n   109\t                    q[\"max_runs\"], q[\"max_tokens\"], q[\"max_cost_usd\"],\n   110\t                )\n   111\t                if row is None:\n   112\t                    raise BudgetExceeded(f\"quota:{q['scope']}\")\n   113\t\n   114\t    async def record_usage(self, ctx: RunContext, tokens: int, cost_usd: float) -> None:\n   115\t        \"\"\"Usage already spent is always recorded; the run stops once any window is over its limit.\"\"\"\n   116\t        exceeded: str | None = None\n   117\t        async with self._pool.acquire() as conn, conn.transaction():\n   118\t            for q in self._quotas:\n   119\t                row = await conn.fetchrow(\n   120\t                    _RECORD_USAGE, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"], tokens, cost_usd\n   121\t                )\n   122\t                if row[\"tokens\"] >= q[\"max_tokens\"] or row[\"cost_usd\"] >= q[\"max_cost_usd\"]:\n   123\t                    exceeded = exceeded or f\"quota:{q['scope']}\"\n   124\t        if exceeded:\n   125\t            raise BudgetExceeded(exceeded)\n1:-- Roles (created by the platform team): hr_agent, hr_gateway, hr_agent_operator,\n2:-- hr_audit_reader, hr_audit_maint, hr_docs_ingest.\n3:CREATE SCHEMA audit; CREATE SCHEMA control; CREATE SCHEMA approvals; CREATE SCHEMA quota; CREATE SCHEMA retrieval;\n4:\n5:CREATE TABLE audit.events (\n6:    event_id uuid NOT NULL, ts timestamptz NOT NULL, event_type text NOT NULL,\n7:    run_id uuid NOT NULL, step_id uuid, parent_step_id uuid,\n8:    accountable_party text NOT NULL, operational_owner text NOT NULL, tenant text NOT NULL,\n9:    agent_type_id text NOT NULL, agent_instance_id text NOT NULL,\n10:    trace_id char(32) NOT NULL, span_id char(16) NOT NULL, traceparent text NOT NULL,\n11:    delegated_subject text NOT NULL, agent_principal text NOT NULL,\n12:    tool text, operation_target text, decision text, reason text, policy_version text NOT NULL, approval_id uuid,\n13:    args_redacted jsonb, result_redacted jsonb,\n14:    context_tokens integer, context_tokens_method text, model_requested text, model_served text,\n15:    PRIMARY KEY (event_id, ts)\n16:) PARTITION BY RANGE (ts);\n17:CREATE INDEX ON audit.events (trace_id);\n18:CREATE INDEX ON audit.events (run_id, ts);\n19:\n20:CREATE TABLE audit.gateway_decisions (\n21:    ts timestamptz NOT NULL, traceparent text NOT NULL, tenant text NOT NULL,\n22:    accountable_party text NOT NULL, operational_owner text NOT NULL,\n23:    agent_type_id_hint text NOT NULL, agent_instance_hint text NOT NULL,   -- caller-supplied; join key only\n24:    subject text, actor text, tool text, decision text NOT NULL, reason text, policy_version text NOT NULL\n25:) PARTITION BY RANGE (ts);\n26:\n27:-- Creates `ahead` partitions into the future and drops partitions older than the newest `keep`.\n28:CREATE FUNCTION audit.maintain_partitions(parent regclass, period interval, ahead int, keep int)\n29:RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = audit, pg_temp AS $$\n30:DECLARE\n31:    start_ts timestamptz := date_trunc('week', now());\n32:    part record;\n33:BEGIN\n34:    FOR i IN 0..ahead LOOP\n35:        EXECUTE format('CREATE TABLE IF NOT EXISTS %s_%s PARTITION OF %s FOR VALUES FROM (%L) TO (%L)',\n36:                       parent, to_char(start_ts + i * period, 'IYYY\"w\"IW'), parent,\n37:                       start_ts + i * period, start_ts + (i + 1) * period);\n38:    END LOOP;\n39:    FOR part IN\n40:        SELECT c.oid::regclass AS rel FROM pg_inherits i JOIN pg_class c ON c.oid = i.inhrelid\n41:         WHERE i.inhparent = parent ORDER BY c.relname DESC OFFSET keep + ahead + 1\n42:    LOOP\n43:        EXECUTE format('DROP TABLE %s', part.rel);\n44:    END LOOP;\n45:END $$;\n46:\n47:CREATE TABLE control.stop_flags (\n48:    flag_id bigserial PRIMARY KEY,\n49:    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n50:    value text, active boolean NOT NULL DEFAULT true, reason text NOT NULL,\n51:    set_by text NOT NULL DEFAULT current_user, set_at timestamptz NOT NULL DEFAULT now()\n52:);\n53:\n54:CREATE TABLE approvals.grants (\n55:    approval_id uuid PRIMARY KEY, run_id uuid NOT NULL, agent_instance_id text NOT NULL, subject text NOT NULL,\n56:    operation text NOT NULL, target text NOT NULL, args_sha256 char(64) NOT NULL, args jsonb NOT NULL,\n57:    tool_use_id text NOT NULL, description text NOT NULL,\n58:    requested_at timestamptz NOT NULL, expires_at timestamptz NOT NULL,\n59:    approved_by text, approved_at timestamptz, used_at timestamptz\n60:);\n61:\n62:CREATE TABLE quota.usage (\n63:    scope text NOT NULL, key text NOT NULL, window_start timestamptz NOT NULL,\n64:    runs integer NOT NULL DEFAULT 0, tokens bigint NOT NULL DEFAULT 0, cost_usd numeric(12, 4) NOT NULL DEFAULT 0,\n65:    PRIMARY KEY (scope, key, window_start)\n66:);\n67:\n68:CREATE TABLE retrieval.index_state (id int PRIMARY KEY CHECK (id = 1), version text NOT NULL);\n69:CREATE TABLE retrieval.chunks (\n70:    chunk_id text PRIMARY KEY, doc_id text NOT NULL, source text NOT NULL,\n71:    added_at timestamptz NOT NULL DEFAULT now(), added_by text NOT NULL DEFAULT current_user,\n72:    trust text NOT NULL CHECK (trust IN ('reviewed', 'hr_authored')),\n73:    audience text NOT NULL CHECK (audience IN ('all', 'employee')),\n74:    allowed_employees text[] NOT NULL DEFAULT '{}',\n75:    expires_at timestamptz, quarantined boolean NOT NULL DEFAULT false, text text NOT NULL,\n76:    tsv tsvector GENERATED ALWAYS AS (to_tsvector('english', text)) STORED\n77:);\n78:CREATE INDEX ON retrieval.chunks USING gin (tsv);\n79:\n80:GRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\n81:GRANT INSERT ON audit.events TO hr_agent;\n82:GRANT SELECT ON control.stop_flags TO hr_agent;\n83:GRANT SELECT, INSERT ON approvals.grants TO hr_agent;\n84:GRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\n85:GRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\n86:GRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n87:\n88:GRANT USAGE ON SCHEMA audit, control TO hr_gateway;\n89:GRANT INSERT ON audit.gateway_decisions TO hr_gateway;\n90:GRANT SELECT ON control.stop_flags TO hr_gateway;\n91:\n92:GRANT USAGE ON SCHEMA control TO hr_agent_operator;\n93:GRANT SELECT, INSERT, UPDATE ON control.stop_flags TO hr_agent_operator;\n94:GRANT USAGE ON SEQUENCE control.stop_flags_flag_id_seq TO hr_agent_operator;\n95:\n96:GRANT USAGE ON SCHEMA audit TO hr_audit_reader, hr_audit_maint;\n97:GRANT SELECT ON ALL TABLES IN SCHEMA audit TO hr_audit_reader;\n98:REVOKE EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) FROM PUBLIC;\n99:GRANT EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) TO hr_audit_maint;\n100:\n101:GRANT USAGE ON SCHEMA retrieval TO hr_docs_ingest;\n102:GRANT SELECT, INSERT, UPDATE ON retrieval.chunks, retrieval.index_state TO hr_docs_ingest;","is_error":false}]},"parent_tool_use_id":null,"session_id":"981bf4ba-51f4-44d7-811c-79f7b4ddcca3","uuid":"6a248166-174c-44fe-9638-235233c33d40","timestamp":"2026-11-21T12:34:08.750Z","tool_use_result":{"stdout":"=== src/credentials.py\n     1\t\"\"\"Per-tool, per-employee, short-lived tokens for the agent's own workload identity.\n     2\t\n     3\tThe pod's projected service-account token (audience sts.acme.example, 10 min) is the\n     4\tactor token. The employee's verified SSO token is the subject token. The STS returns an\n     5\tRFC 8693 token whose `sub` is the employee, `act.sub` is this workload, `aud` is the\n     6\trequested audience, `scope` is exactly one tool scope, and `cnf.x5t#S256` binds it to the\n     7\tpod's mTLS certificate. Lifetime is 300 s: long enough for one approval-to-execute window\n     8\ton a single call, short enough that a copied token is useless after the run.\n     9\t\"\"\"\n    10\tfrom __future__ import annotations\n    11\t\n    12\timport asyncio\n    13\timport time\n    14\tfrom dataclasses import dataclass\n    15\t\n    16\timport httpx\n    17\t\n    18\tSTS_URL = \"https://sts.identity.svc.cluster.local/oauth2/token\"\n    19\tACTOR_TOKEN_PATH = \"/var/run/secrets/tokens/sts-token\"\n    20\tTOKEN_TTL_SECONDS = 300\n    21\tREFRESH_MARGIN_SECONDS = 30\n    22\t\n    23\t\n    24\t@dataclass\n    25\tclass _Cached:\n    26\t    token: str\n    27\t    expires_at: float\n    28\t\n    29\t\n    30\tclass CredentialBroker:\n    31\t    def __init__(self, client: httpx.AsyncClient):\n    32\t        self._client = client  # configured with the pod's SPIFFE SVID for mTLS\n    33\t        self._cache: dict[tuple[str, str, str], _Cached] = {}\n    34\t        self._lock = asyncio.Lock()\n    35\t\n    36\t    def _actor_token(self) -> str:\n    37\t        # Re-read each time: kubelet rotates the projected token on disk.\n    38\t        with open(ACTOR_TOKEN_PATH, encoding=\"utf-8\") as fh:\n    39\t            return fh.read().strip()\n    40\t\n    41\t    async def token(self, *, audience: str, scope: str, subject_token: str, subject: str) -> str:\n    42\t        key = (audience, scope, subject)\n    43\t        async with self._lock:\n    44\t            hit = self._cache.get(key)\n    45\t            if hit and hit.expires_at - REFRESH_MARGIN_SECONDS > time.time():\n    46\t                return hit.token\n    47\t            resp = await self._client.post(\n    48\t                STS_URL,\n    49\t                data={\n    50\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    51\t                    \"subject_token\": subject_token,\n    52\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:id_token\",\n    53\t                    \"actor_token\": self._actor_token(),\n    54\t                    \"actor_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n    55\t                    \"audience\": audience,\n    56\t                    \"scope\": scope,\n    57\t                    \"requested_token_type\": \"urn:ietf:params:oauth:token-type:access_token\",\n    58\t                    \"requested_ttl\": str(TOKEN_TTL_SECONDS),\n    59\t                },\n    60\t                timeout=3.0,\n    61\t            )\n    62\t            resp.raise_for_status()\n    63\t            body = resp.json()\n    64\t            ttl = min(int(body.get(\"expires_in\", TOKEN_TTL_SECONDS)), TOKEN_TTL_SECONDS)\n    65\t            self._cache[key] = _Cached(body[\"access_token\"], time.time() + ttl)\n    66\t            return body[\"access_token\"]\n    67\t\n    68\t    def drop_subject(self, subject: str) -> None:\n    69\t        for key in [k for k in self._cache if k[2] == subject]:\n    70\t            del self._cache[key]\n=== src/type_id.py\n     1\t\"\"\"agent-type-id: SHA-256 over every identity-defining input.\n     2\t\n     3\tInputs (all, no exclusions):\n     4\t  - every file under src/, prompts/ and config/, plus requirements.txt and Dockerfile\n     5\t  - the image digest the pod runs\n     6\t  - the model record (provider, requested ID, snapshot/alias label, adapter)\n     7\tCanonical form: JSON with sorted keys, no whitespace, file paths relative to the repo root\n     8\tin POSIX form, each file hashed as raw bytes. The same command runs in CI (to stamp the\n     9\trelease manifest) and at pod start (to refuse running under an identity it does not match).\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport hashlib\n    14\timport json\n    15\timport pathlib\n    16\timport sys\n    17\tfrom typing import Any\n    18\t\n    19\tROOT = pathlib.Path(__file__).resolve().parent.parent\n    20\tINPUT_DIRS = (\"src\", \"prompts\", \"config\")\n    21\tINPUT_FILES = (\"requirements.txt\", \"Dockerfile\")\n    22\tHASH_SCHEME = \"acme-agent-type-id/v1\"\n    23\t\n    24\t\n    25\tdef _file_hashes() -> dict[str, str]:\n    26\t    out: dict[str, str] = {}\n    27\t    for d in INPUT_DIRS:\n    28\t        for p in sorted((ROOT / d).rglob(\"*\")):\n    29\t            if p.is_file():\n    30\t                out[p.relative_to(ROOT).as_posix()] = hashlib.sha256(p.read_bytes()).hexdigest()\n    31\t    for f in INPUT_FILES:\n    32\t        out[f] = hashlib.sha256((ROOT / f).read_bytes()).hexdigest()\n    33\t    return out\n    34\t\n    35\t\n    36\tdef compute(image_digest: str, model: dict[str, Any]) -> tuple[str, dict[str, Any]]:\n    37\t    if not image_digest.startswith(\"sha256:\") or len(image_digest) != 71:\n    38\t        raise ValueError(\"image digest must be sha256:<64 hex>\")\n    39\t    for k in (\"provider\", \"id\", \"pinning\", \"adapter\"):\n    40\t        if k not in model:\n    41\t            raise ValueError(f\"model record missing {k}\")\n    42\t    manifest = {\"scheme\": HASH_SCHEME, \"image_digest\": image_digest, \"model\": model, \"files\": _file_hashes()}\n    43\t    canonical = json.dumps(manifest, sort_keys=True, separators=(\",\", \":\")).encode()\n    44\t    return \"sha256:\" + hashlib.sha256(canonical).hexdigest(), manifest\n    45\t\n    46\t\n    47\tdef model_record(cfg: dict[str, Any]) -> dict[str, Any]:\n    48\t    m = cfg[\"model\"]\n    49\t    return {\"provider\": m[\"provider\"], \"id\": m[\"id\"], \"pinning\": m[\"pinning\"], \"adapter\": m[\"adapter\"]}\n    50\t\n    51\t\n    52\tdef verify_or_exit(expected: str, image_digest: str, model: dict[str, Any]) -> str:\n    53\t    actual, _ = compute(image_digest, model)\n    54\t    if actual != expected:\n    55\t        print(f\"agent-type-id mismatch: expected {expected}, computed {actual}\", file=sys.stderr)\n    56\t        sys.exit(78)\n    57\t    return actual\n    58\t\n    59\t\n    60\tif __name__ == \"__main__\":\n    61\t    import yaml\n    62\t\n    63\t    cfg = yaml.safe_load((ROOT / \"config\" / \"agent.yaml\").read_text())\n    64\t    tid, man = compute(sys.argv[1], model_record(cfg))\n    65\t    json.dump({\"agent_type_id\": tid, \"inputs\": man}, sys.stdout, indent=2, sort_keys=True)\n=== src/killswitch.py\n     1\t\"\"\"Stop control. Flags live in control.stop_flags, which the agent's DB role can only read.\n     2\t\n     3\tOperators set flags with the hr_agent_operator role (see README \"Stopping the agent\").\n     4\tThe tool gateway reads the same table, so a stopped instance is refused there too.\n     5\t\"\"\"\n     6\tfrom __future__ import annotations\n     7\t\n     8\timport asyncio\n     9\timport logging\n    10\t\n    11\timport asyncpg\n    12\t\n    13\tfrom .audit import RunContext\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.stop\")\n    16\t\n    17\t_QUERY = \"\"\"\n    18\tSELECT reason FROM control.stop_flags\n    19\tWHERE active\n    20\t  AND (   scope = 'fleet'\n    21\t       OR (scope = 'agent_type'     AND value = $1)\n    22\t       OR (scope = 'agent_instance' AND value = $2)\n    23\t       OR (scope = 'subject'        AND value = $3)\n    24\t       OR (scope = 'agent_principal' AND value = $4))\n    25\tLIMIT 1\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass Stopped(Exception):\n    30\t    pass\n    31\t\n    32\t\n    33\tclass StopControl:\n    34\t    def __init__(self, pool: asyncpg.Pool, poll_seconds: float):\n    35\t        self._pool = pool\n    36\t        self._poll = poll_seconds\n    37\t\n    38\t    async def reason(self, ctx: RunContext) -> str | None:\n    39\t        try:\n    40\t            row = await self._pool.fetchrow(\n    41\t                _QUERY, ctx.agent_type_id, ctx.agent_instance_id, ctx.subject, ctx.agent_principal, timeout=1.0\n    42\t            )\n    43\t        except Exception:\n    44\t            return \"stop store unreachable\"\n    45\t        return row[\"reason\"] if row else None\n    46\t\n    47\t    async def raise_if_stopped(self, ctx: RunContext) -> None:\n    48\t        why = await self.reason(ctx)\n    49\t        if why:\n    50\t            raise Stopped(why)\n    51\t\n    52\t    async def watch(self, ctx: RunContext, task: asyncio.Task) -> None:\n    53\t        \"\"\"Cancel the run task, including any in-flight model or tool call, once a flag appears.\"\"\"\n    54\t        while not task.done():\n    55\t            why = await self.reason(ctx)\n    56\t            if why:\n    57\t                log.warning(\"stop flag observed\", extra={\"run_id\": ctx.run_id, \"reason\": why})\n    58\t                task.cancel(msg=f\"stopped: {why}\")\n    59\t                return\n    60\t            await asyncio.sleep(self._poll)\n=== src/audit.py\n     1\t\"\"\"Append-only audit records. Every record carries the six identity fields.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport json\n     5\timport logging\n     6\timport uuid\n     7\tfrom dataclasses import dataclass\n     8\tfrom typing import Any\n     9\t\n    10\timport asyncpg\n    11\tfrom opentelemetry import trace\n    12\t\n    13\tfrom .redact import redact_obj\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.audit\")\n    16\t\n    17\t\n    18\t@dataclass(frozen=True)\n    19\tclass RunContext:\n    20\t    \"\"\"Built by the harness from verified identity. Never from model output.\"\"\"\n    21\t\n    22\t    run_id: str\n    23\t    agent_instance_id: str\n    24\t    agent_type_id: str\n    25\t    tenant: str\n    26\t    subject: str              # employee whose authority is being used (verified SSO token)\n    27\t    accountable_party: str\n    28\t    operational_owner: str\n    29\t    agent_principal: str      # workload identity of this agent\n    30\t\n    31\t\n    32\tclass AuditUnavailable(Exception):\n    33\t    pass\n    34\t\n    35\t\n    36\t_INSERT = \"\"\"\n    37\tINSERT INTO audit.events (\n    38\t    event_id, ts, event_type, run_id, step_id, parent_step_id,\n    39\t    accountable_party, operational_owner, tenant, agent_type_id, agent_instance_id,\n    40\t    trace_id, span_id, traceparent,\n    41\t    delegated_subject, agent_principal,\n    42\t    tool, operation_target, decision, reason, policy_version, approval_id,\n    43\t    args_redacted, result_redacted, context_tokens, context_tokens_method, model_requested, model_served\n    44\t) VALUES (\n    45\t    $1, now(), $2, $3, $4, $5,\n    46\t    $6, $7, $8, $9, $10,\n    47\t    $11, $12, $13,\n    48\t    $14, $15,\n    49\t    $16, $17, $18, $19, $20, $21,\n    50\t    $22::jsonb, $23::jsonb, $24, $25, $26, $27\n    51\t)\n    52\t\"\"\"\n    53\t\n    54\t\n    55\tclass AuditWriter:\n    56\t    def __init__(self, pool: asyncpg.Pool, policy_version: str):\n    57\t        self._pool = pool\n    58\t        self._policy_version = policy_version\n    59\t\n    60\t    async def record(\n    61\t        self,\n    62\t        ctx: RunContext,\n    63\t        event_type: str,\n    64\t        *,\n    65\t        step_id: str | None = None,\n    66\t        parent_step_id: str | None = None,\n    67\t        tool: str | None = None,\n    68\t        target: str | None = None,\n    69\t        decision: str | None = None,\n    70\t        reason: str | None = None,\n    71\t        approval_id: str | None = None,\n    72\t        args: Any = None,\n    73\t        result: Any = None,\n    74\t        context_tokens: int | None = None,\n    75\t        context_tokens_method: str | None = None,\n    76\t        model_requested: str | None = None,\n    77\t        model_served: str | None = None,\n    78\t    ) -> str:\n    79\t        span_ctx = trace.get_current_span().get_span_context()\n    80\t        if not span_ctx.is_valid:\n    81\t            raise AuditUnavailable(\"no active trace context\")\n    82\t        trace_id = format(span_ctx.trace_id, \"032x\")\n    83\t        span_id = format(span_ctx.span_id, \"016x\")\n    84\t        traceparent = f\"00-{trace_id}-{span_id}-{span_ctx.trace_flags:02x}\"\n    85\t        event_id = str(uuid.uuid4())\n    86\t        try:\n    87\t            await self._pool.execute(\n    88\t                _INSERT,\n    89\t                event_id, event_type, ctx.run_id, step_id, parent_step_id,\n    90\t                ctx.accountable_party, ctx.operational_owner, ctx.tenant, ctx.agent_type_id, ctx.agent_instance_id,\n    91\t                trace_id, span_id, traceparent,\n    92\t                ctx.subject, ctx.agent_principal,\n    93\t                tool, target, decision, reason, self._policy_version, approval_id,\n    94\t                json.dumps(redact_obj(args)), json.dumps(redact_obj(result)),\n    95\t                context_tokens, context_tokens_method, model_requested, model_served,\n    96\t                timeout=2.0,\n    97\t            )\n    98\t        except Exception as exc:  # any failure to persist stops the run\n    99\t            log.error(\"audit write failed\", extra={\"event_type\": event_type, \"run_id\": ctx.run_id})\n   100\t            raise AuditUnavailable(str(type(exc).__name__)) from exc\n   101\t        return event_id\n=== src/budgets.py\n     1\t\"\"\"Hard limits enforced by the harness, outside the model.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport time\n     5\tfrom collections import deque\n     6\tfrom dataclasses import dataclass, field\n     7\tfrom typing import Any\n     8\t\n     9\timport asyncpg\n    10\t\n    11\tfrom .audit import RunContext\n    12\t\n    13\t\n    14\tclass BudgetExceeded(Exception):\n    15\t    def __init__(self, limit: str):\n    16\t        super().__init__(limit)\n    17\t        self.limit = limit\n    18\t\n    19\t\n    20\t@dataclass\n    21\tclass RunBudget:\n    22\t    cfg: dict[str, Any]\n    23\t    pricing: dict[str, float]\n    24\t    started: float = field(default_factory=time.monotonic)\n    25\t    steps: int = 0\n    26\t    tokens: int = 0\n    27\t    cost_usd: float = 0.0\n    28\t    tool_calls: deque = field(default_factory=deque)\n    29\t\n    30\t    def check_step(self) -> None:\n    31\t        if self.steps >= self.cfg[\"max_steps\"]:\n    32\t            raise BudgetExceeded(\"max_steps\")\n    33\t        if time.monotonic() - self.started > self.cfg[\"max_wall_seconds\"]:\n    34\t            raise BudgetExceeded(\"max_wall_seconds\")\n    35\t        if self.tokens >= self.cfg[\"max_total_tokens\"]:\n    36\t            raise BudgetExceeded(\"max_total_tokens\")\n    37\t        if self.cost_usd >= self.cfg[\"max_cost_usd\"]:\n    38\t            raise BudgetExceeded(\"max_cost_usd\")\n    39\t        self.steps += 1\n    40\t\n    41\t    def remaining_seconds(self) -> float:\n    42\t        return max(0.0, self.cfg[\"max_wall_seconds\"] - (time.monotonic() - self.started))\n    43\t\n    44\t    def record_usage(self, usage: Any) -> tuple[int, float]:\n    45\t        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n    46\t        cache_write = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n    47\t        tokens_in = usage.input_tokens + cache_read + cache_write\n    48\t        tokens = tokens_in + usage.output_tokens\n    49\t        cost = (\n    50\t            (usage.input_tokens + cache_write) * self.pricing[\"input_per_mtok\"]\n    51\t            + cache_read * self.pricing[\"cache_read_per_mtok\"]\n    52\t            + usage.output_tokens * self.pricing[\"output_per_mtok\"]\n    53\t        ) / 1_000_000\n    54\t        self.tokens += tokens\n    55\t        self.cost_usd += cost\n    56\t        return tokens, cost\n    57\t\n    58\t    def check_tool_call(self) -> None:\n    59\t        now = time.monotonic()\n    60\t        while self.tool_calls and now - self.tool_calls[0] > 60:\n    61\t            self.tool_calls.popleft()\n    62\t        if len(self.tool_calls) >= self.cfg[\"max_tool_calls_per_minute\"]:\n    63\t            raise BudgetExceeded(\"max_tool_calls_per_minute\")\n    64\t        self.tool_calls.append(now)\n    65\t\n    66\t    def check_subagent(self, started_so_far: int) -> None:\n    67\t        if started_so_far >= self.cfg[\"max_subagents\"]:\n    68\t            raise BudgetExceeded(\"max_subagents\")\n    69\t\n    70\t\n    71\t_WINDOW = \"to_timestamp(floor(extract(epoch FROM now()) / $3) * $3)\"\n    72\t\n    73\t_RESERVE_RUN = f\"\"\"\n    74\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    75\tVALUES ($1, $2, {_WINDOW}, 1, 0, 0)\n    76\tON CONFLICT (scope, key, window_start) DO UPDATE\n    77\t   SET runs = quota.usage.runs + 1\n    78\t WHERE quota.usage.runs + 1 <= $4\n    79\t   AND quota.usage.tokens < $5\n    80\t   AND quota.usage.cost_usd < $6\n    81\tRETURNING runs\n    82\t\"\"\"\n    83\t\n    84\t_RECORD_USAGE = f\"\"\"\n    85\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    86\tVALUES ($1, $2, {_WINDOW}, 0, $4, $5)\n    87\tON CONFLICT (scope, key, window_start) DO UPDATE\n    88\t   SET tokens = quota.usage.tokens + EXCLUDED.tokens,\n    89\t       cost_usd = quota.usage.cost_usd + EXCLUDED.cost_usd\n    90\tRETURNING tokens, cost_usd\n    91\t\"\"\"\n    92\t\n    93\t\n    94\tclass QuotaStore:\n    95\t    \"\"\"Per-user, per-tenant and fleet-wide quotas, shared by every replica.\"\"\"\n    96\t\n    97\t    def __init__(self, pool: asyncpg.Pool, quotas: list[dict[str, Any]]):\n    98\t        self._pool = pool\n    99\t        self._quotas = quotas\n   100\t\n   101\t    def _key(self, scope: str, ctx: RunContext) -> str:\n   102\t        return {\"user\": ctx.subject, \"tenant\": ctx.tenant, \"fleet\": \"all\"}[scope]\n   103\t\n   104\t    async def reserve_run(self, ctx: RunContext) -> None:\n   105\t        async with self._pool.acquire() as conn, conn.transaction():\n   106\t            for q in self._quotas:\n   107\t                row = await conn.fetchrow(\n   108\t                    _RESERVE_RUN, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"],\n   109\t                    q[\"max_runs\"], q[\"max_tokens\"], q[\"max_cost_usd\"],\n   110\t                )\n   111\t                if row is None:\n   112\t                    raise BudgetExceeded(f\"quota:{q['scope']}\")\n   113\t\n   114\t    async def record_usage(self, ctx: RunContext, tokens: int, cost_usd: float) -> None:\n   115\t        \"\"\"Usage already spent is always recorded; the run stops once any window is over its limit.\"\"\"\n   116\t        exceeded: str | None = None\n   117\t        async with self._pool.acquire() as conn, conn.transaction():\n   118\t            for q in self._quotas:\n   119\t                row = await conn.fetchrow(\n   120\t                    _RECORD_USAGE, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"], tokens, cost_usd\n   121\t                )\n   122\t                if row[\"tokens\"] >= q[\"max_tokens\"] or row[\"cost_usd\"] >= q[\"max_cost_usd\"]:\n   123\t                    exceeded = exceeded or f\"quota:{q['scope']}\"\n   124\t        if exceeded:\n   125\t            raise BudgetExceeded(exceeded)\n1:-- Roles (created by the platform team): hr_agent, hr_gateway, hr_agent_operator,\n2:-- hr_audit_reader, hr_audit_maint, hr_docs_ingest.\n3:CREATE SCHEMA audit; CREATE SCHEMA control; CREATE SCHEMA approvals; CREATE SCHEMA quota; CREATE SCHEMA retrieval;\n4:\n5:CREATE TABLE audit.events (\n6:    event_id uuid NOT NULL, ts timestamptz NOT NULL, event_type text NOT NULL,\n7:    run_id uuid NOT NULL, step_id uuid, parent_step_id uuid,\n8:    accountable_party text NOT NULL, operational_owner text NOT NULL, tenant text NOT NULL,\n9:    agent_type_id text NOT NULL, agent_instance_id text NOT NULL,\n10:    trace_id char(32) NOT NULL, span_id char(16) NOT NULL, traceparent text NOT NULL,\n11:    delegated_subject text NOT NULL, agent_principal text NOT NULL,\n12:    tool text, operation_target text, decision text, reason text, policy_version text NOT NULL, approval_id uuid,\n13:    args_redacted jsonb, result_redacted jsonb,\n14:    context_tokens integer, context_tokens_method text, model_requested text, model_served text,\n15:    PRIMARY KEY (event_id, ts)\n16:) PARTITION BY RANGE (ts);\n17:CREATE INDEX ON audit.events (trace_id);\n18:CREATE INDEX ON audit.events (run_id, ts);\n19:\n20:CREATE TABLE audit.gateway_decisions (\n21:    ts timestamptz NOT NULL, traceparent text NOT NULL, tenant text NOT NULL,\n22:    accountable_party text NOT NULL, operational_owner text NOT NULL,\n23:    agent_type_id_hint text NOT NULL, agent_instance_hint text NOT NULL,   -- caller-supplied; join key only\n24:    subject text, actor text, tool text, decision text NOT NULL, reason text, policy_version text NOT NULL\n25:) PARTITION BY RANGE (ts);\n26:\n27:-- Creates `ahead` partitions into the future and drops partitions older than the newest `keep`.\n28:CREATE FUNCTION audit.maintain_partitions(parent regclass, period interval, ahead int, keep int)\n29:RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = audit, pg_temp AS $$\n30:DECLARE\n31:    start_ts timestamptz := date_trunc('week', now());\n32:    part record;\n33:BEGIN\n34:    FOR i IN 0..ahead LOOP\n35:        EXECUTE format('CREATE TABLE IF NOT EXISTS %s_%s PARTITION OF %s FOR VALUES FROM (%L) TO (%L)',\n36:                       parent, to_char(start_ts + i * period, 'IYYY\"w\"IW'), parent,\n37:                       start_ts + i * period, start_ts + (i + 1) * period);\n38:    END LOOP;\n39:    FOR part IN\n40:        SELECT c.oid::regclass AS rel FROM pg_inherits i JOIN pg_class c ON c.oid = i.inhrelid\n41:         WHERE i.inhparent = parent ORDER BY c.relname DESC OFFSET keep + ahead + 1\n42:    LOOP\n43:        EXECUTE format('DROP TABLE %s', part.rel);\n44:    END LOOP;\n45:END $$;\n46:\n47:CREATE TABLE control.stop_flags (\n48:    flag_id bigserial PRIMARY KEY,\n49:    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n50:    value text, active boolean NOT NULL DEFAULT true, reason text NOT NULL,\n51:    set_by text NOT NULL DEFAULT current_user, set_at timestamptz NOT NULL DEFAULT now()\n52:);\n53:\n54:CREATE TABLE approvals.grants (\n55:    approval_id uuid PRIMARY KEY, run_id uuid NOT NULL, agent_instance_id text NOT NULL, subject text NOT NULL,\n56:    operation text NOT NULL, target text NOT NULL, args_sha256 char(64) NOT NULL, args jsonb NOT NULL,\n57:    tool_use_id text NOT NULL, description text NOT NULL,\n58:    requested_at timestamptz NOT NULL, expires_at timestamptz NOT NULL,\n59:    approved_by text, approved_at timestamptz, used_at timestamptz\n60:);\n61:\n62:CREATE TABLE quota.usage (\n63:    scope text NOT NULL, key text NOT NULL, window_start timestamptz NOT NULL,\n64:    runs integer NOT NULL DEFAULT 0, tokens bigint NOT NULL DEFAULT 0, cost_usd numeric(12, 4) NOT NULL DEFAULT 0,\n65:    PRIMARY KEY (scope, key, window_start)\n66:);\n67:\n68:CREATE TABLE retrieval.index_state (id int PRIMARY KEY CHECK (id = 1), version text NOT NULL);\n69:CREATE TABLE retrieval.chunks (\n70:    chunk_id text PRIMARY KEY, doc_id text NOT NULL, source text NOT NULL,\n71:    added_at timestamptz NOT NULL DEFAULT now(), added_by text NOT NULL DEFAULT current_user,\n72:    trust text NOT NULL CHECK (trust IN ('reviewed', 'hr_authored')),\n73:    audience text NOT NULL CHECK (audience IN ('all', 'employee')),\n74:    allowed_employees text[] NOT NULL DEFAULT '{}',\n75:    expires_at timestamptz, quarantined boolean NOT NULL DEFAULT false, text text NOT NULL,\n76:    tsv tsvector GENERATED ALWAYS AS (to_tsvector('english', text)) STORED\n77:);\n78:CREATE INDEX ON retrieval.chunks USING gin (tsv);\n79:\n80:GRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\n81:GRANT INSERT ON audit.events TO hr_agent;\n82:GRANT SELECT ON control.stop_flags TO hr_agent;\n83:GRANT SELECT, INSERT ON approvals.grants TO hr_agent;\n84:GRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\n85:GRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\n86:GRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n87:\n88:GRANT USAGE ON SCHEMA audit, control TO hr_gateway;\n89:GRANT INSERT ON audit.gateway_decisions TO hr_gateway;\n90:GRANT SELECT ON control.stop_flags TO hr_gateway;\n91:\n92:GRANT USAGE ON SCHEMA control TO hr_agent_operator;\n93:GRANT SELECT, INSERT, UPDATE ON control.stop_flags TO hr_agent_operator;\n94:GRANT USAGE ON SEQUENCE control.stop_flags_flag_id_seq TO hr_agent_operator;\n95:\n96:GRANT USAGE ON SCHEMA audit TO hr_audit_reader, hr_audit_maint;\n97:GRANT SELECT ON ALL TABLES IN SCHEMA audit TO hr_audit_reader;\n98:REVOKE EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) FROM PUBLIC;\n99:GRANT EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) TO hr_audit_maint;\n100:\n101:GRANT USAGE ON SCHEMA retrieval TO hr_docs_ingest;\n102:GRANT SELECT, INSERT, UPDATE ON retrieval.chunks, retrieval.index_state TO hr_docs_ingest;","stderr":"","interrupted":false,"isImag