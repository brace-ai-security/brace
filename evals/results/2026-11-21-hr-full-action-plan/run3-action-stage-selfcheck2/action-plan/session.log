{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AFMKRErX3dT9MF4agxhshy","type":"tool_result","content":"1\t\"\"\"Calls MCP tools through the hr-tool-gateway.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport logging\n5\timport uuid\n6\tfrom typing import Any\n7\t\n8\timport httpx\n9\tfrom opentelemetry.propagate import inject\n10\t\n11\tfrom .audit import RunContext\n12\tfrom .credentials import CredentialBroker\n13\tfrom .tools import ToolSpec\n14\t\n15\tlog = logging.getLogger(\"hr_agent.gateway_client\")\n16\t\n17\tGATEWAY_URL = \"https://hr-tool-gateway.hr-agent.svc.cluster.local:8443/mcp\"\n18\tGATEWAY_AUDIENCE = \"hr-tool-gateway\"\n19\t\n20\t\n21\tclass ToolDenied(Exception):\n22\t    def __init__(self, reason: str):\n23\t        super().__init__(reason)\n24\t        self.reason = reason\n25\t\n26\t\n27\tclass ToolError(Exception):\n28\t    def __init__(self, status: int, detail: str):\n29\t        super().__init__(f\"{status}\")\n30\t        self.status = status\n31\t        self.detail = detail\n32\t\n33\t\n34\tclass GatewayUnavailable(Exception):\n35\t    pass\n36\t\n37\t\n38\tclass GatewayClient:\n39\t    def __init__(self, client: httpx.AsyncClient, creds: CredentialBroker):\n40\t        self._client = client\n41\t        self._creds = creds\n42\t\n43\t    async def call(\n44\t        self, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, subject_token: str, *, operation_id: str\n45\t    ) -> dict[str, Any]:\n46\t        try:\n47\t            token = await self._creds.token(\n48\t                audience=GATEWAY_AUDIENCE, scope=spec.scope, subject_token=subject_token, subject=ctx.subject\n49\t            )\n50\t            return await self._post(GATEWAY_URL, token, spec, args, ctx, operation_id)\n51\t        except GatewayUnavailable:\n52\t            if not spec.direct_route:\n53\t                raise\n54\t            log.warning(\"gateway unavailable, using direct route\", extra={\"tool\": spec.qualified})\n55\t            token = await self._creds.token(\n56\t                audience=spec.direct_route[\"audience\"], scope=spec.scope,\n57\t                subject_token=subject_token, subject=ctx.subject,\n58\t            )\n59\t            return await self._post(spec.direct_route[\"endpoint\"], token, spec, args, ctx, operation_id)\n60\t\n61\t    async def _post(\n62\t        self, url: str, token: str, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, operation_id: str\n63\t    ) -> dict[str, Any]:\n64\t        tool_name = spec.qualified.split(\"/\", 1)[1]\n65\t        headers = {\n66\t            \"Authorization\": f\"Bearer {token}\",\n67\t            \"Mcp-Method\": \"tools/call\",\n68\t            \"Mcp-Name\": tool_name,\n69\t            \"Idempotency-Key\": operation_id,\n70\t            \"X-Agent-Instance\": ctx.agent_instance_id,\n71\t            \"X-Agent-Type-Id\": ctx.agent_type_id,\n72\t        }\n73\t        inject(headers)\n74\t        body = {\n75\t            \"jsonrpc\": \"2.0\",\n76\t            \"id\": str(uuid.uuid4()),\n77\t            \"method\": \"tools/call\",\n78\t            \"params\": {\"name\": tool_name, \"arguments\": args, \"_meta\": {\"server\": spec.server}},\n79\t        }\n80\t        try:\n81\t            resp = await self._client.post(url, json=body, headers=headers, timeout=10.0)\n82\t        except (httpx.ConnectError, httpx.ConnectTimeout) as exc:\n83\t            raise GatewayUnavailable(str(exc)) from exc\n84\t        except httpx.TimeoutException as exc:\n85\t            raise ToolError(504, f\"no response; outcome unknown for operation {operation_id}\") from exc\n86\t        if resp.status_code == 503:\n87\t            raise GatewayUnavailable(resp.text[:200])\n88\t        if resp.status_code in (401, 403, 429):\n89\t            raise ToolDenied(resp.json().get(\"error\", \"denied\"))\n90\t        if resp.status_code >= 400:\n91\t            raise ToolError(resp.status_code, resp.json().get(\"detail\", resp.text))\n92\t        payload = resp.json()\n93\t        if \"error\" in payload:\n94\t            raise ToolError(200, str(payload[\"error\"].get(\"message\", \"\")))\n95\t        return payload[\"result\"][\"structuredContent\"]\n96\t"}]},"parent_tool_use_id":null,"session_id":"981bf4ba-51f4-44d7-811c-79f7b4ddcca3","uuid":"cba059bb-ae3d-4fc1-967a-648b3abe27c2","timestamp":"2026-11-21T12:33:52.114Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-action-_pgwuimk/agent/src/gateway_client.py","content":"\"\"\"Calls MCP tools through the hr-tool-gateway.\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport uuid\nfrom typing import Any\n\nimport httpx\nfrom opentelemetry.propagate import inject\n\nfrom .audit import RunContext\nfrom .credentials import CredentialBroker\nfrom .tools import ToolSpec\n\nlog = logging.getLogger(\"hr_agent.gateway_client\")\n\nGATEWAY_URL = \"https://hr-tool-gateway.hr-agent.svc.cluster.local:8443/mcp\"\nGATEWAY_AUDIENCE = \"hr-tool-gateway\"\n\n\nclass ToolDenied(Exception):\n    def __init__(self, reason: str):\n        super().__init__(reason)\n        self.reason = reason\n\n\nclass ToolError(Exception):\n    def __init__(self, status: int, detail: str):\n        super().__init__(f\"{status}\")\n        self.status = status\n        self.detail = detail\n\n\nclass GatewayUnavailable(Exception):\n    pass\n\n\nclass GatewayClient:\n    def __init__(self, client: httpx.AsyncClient, creds: CredentialBroker):\n        self._client = client\n        self._creds = creds\n\n    async def call(\n        self, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, subject_token: str, *, operation_id: str\n    ) -> dict[str, Any]:\n        try:\n            token = await self._creds.token(\n                audience=GATEWAY_AUDIENCE, scope=spec.scope, subject_token=subject_token, subject=ctx.subject\n            )\n            return await self._post(GATEWAY_URL, token, spec, args, ctx, operation_id)\n        except GatewayUnavailable:\n            if not spec.direct_route:\n                raise\n            log.warning(\"gateway unavailable, using direct route\", extra={\"tool\": spec.qualified})\n            token = await self._creds.token(\n                audience=spec.direct_route[\"audience\"], scope=spec.scope,\n                subject_token=subject_token, subject=ctx.subject,\n            )\n            return await self._post(spec.direct_route[\"endpoint\"], token, spec, args, ctx, operation_id)\n\n    async def _post(\n        self, url: str, token: str, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, operation_id: str\n    ) -> dict[str, Any]:\n        tool_name = spec.qualified.split(\"/\", 1)[1]\n        headers = {\n            \"Authorization\": f\"Bearer {token}\",\n            \"Mcp-Method\": \"tools/call\",\n            \"Mcp-Name\": tool_name,\n            \"Idempotency-Key\": operation_id,\n            \"X-Agent-Instance\": ctx.agent_instance_id,\n            \"X-Agent-Type-Id\": ctx.agent_type_id,\n        }\n        inject(headers)\n        body = {\n            \"jsonrpc\": \"2.0\",\n            \"id\": str(uuid.uuid4()),\n            \"method\": \"tools/call\",\n            \"params\": {\"name\": tool_name, \"arguments\": args, \"_meta\": {\"server\": spec.server}},\n        }\n        try:\n            resp = await self._client.post(url, json=body, headers=headers, timeout=10.0)\n        except (httpx.ConnectError, httpx.ConnectTimeout) as exc:\n            raise GatewayUnavailable(str(exc)) from exc\n        except httpx.TimeoutException as exc:\n            raise ToolError(504, f\"no response; outcome unknown for operation {operation_id}\") from exc\n        if resp.status_code == 503:\n            raise GatewayUnavailable(resp.text[:200])\n        if resp.status_code in (401, 403, 429):\n            raise ToolDenied(resp.json().get(\"error\", \"denied\"))\n        if resp.status_code >= 400:\n            raise ToolError(resp.status_code, resp.json().get(\"detail\", resp.text))\n        payload = resp.json()\n        if \"error\" in payload:\n            raise ToolError(200, str(payload[\"error\"].get(\"message\", \"\")))\n        return payload[\"result\"][\"structuredContent\"]\n","numLines":96,"startLine":1,"totalLines":96}},"tool_result_meta":[{"id":"toolu_01AFMKRErX3dT9MF4agxhshy","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
