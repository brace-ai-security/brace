{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NNE2tURYZ2K9vvjBRriGX9","type":"tool_result","content":"1\t-- Roles (created by the platform team): hr_agent, hr_gateway, hr_agent_operator,\n2\t-- hr_audit_reader, hr_audit_maint, hr_docs_ingest.\n3\tCREATE SCHEMA audit; CREATE SCHEMA control; CREATE SCHEMA approvals; CREATE SCHEMA quota; CREATE SCHEMA retrieval;\n4\t\n5\tCREATE TABLE audit.events (\n6\t    event_id uuid NOT NULL, ts timestamptz NOT NULL, event_type text NOT NULL,\n7\t    run_id uuid NOT NULL, step_id uuid, parent_step_id uuid,\n8\t    accountable_party text NOT NULL, operational_owner text NOT NULL, tenant text NOT NULL,\n9\t    agent_type_id text NOT NULL, agent_instance_id text NOT NULL,\n10\t    trace_id char(32) NOT NULL, span_id char(16) NOT NULL, traceparent text NOT NULL,\n11\t    delegated_subject text NOT NULL, agent_principal text NOT NULL,\n12\t    tool text, operation_target text, decision text, reason text, policy_version text NOT NULL, approval_id uuid,\n13\t    args_redacted jsonb, result_redacted jsonb,\n14\t    context_tokens integer, context_tokens_method text, model_requested text, model_served text,\n15\t    PRIMARY KEY (event_id, ts)\n16\t) PARTITION BY RANGE (ts);\n17\tCREATE INDEX ON audit.events (trace_id);\n18\tCREATE INDEX ON audit.events (run_id, ts);\n19\t\n20\tCREATE TABLE audit.gateway_decisions (\n21\t    ts timestamptz NOT NULL, traceparent text NOT NULL, tenant text NOT NULL,\n22\t    accountable_party text NOT NULL, operational_owner text NOT NULL,\n23\t    agent_type_id_hint text NOT NULL, agent_instance_hint text NOT NULL,   -- caller-supplied; join key only\n24\t    subject text, actor text, tool text, decision text NOT NULL, reason text, policy_version text NOT NULL\n25\t) PARTITION BY RANGE (ts);\n26\t\n27\t-- Creates `ahead` partitions into the future and drops partitions older than the newest `keep`.\n28\tCREATE FUNCTION audit.maintain_partitions(parent regclass, period interval, ahead int, keep int)\n29\tRETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = audit, pg_temp AS $$\n30\tDECLARE\n31\t    start_ts timestamptz := date_trunc('week', now());\n32\t    part record;\n33\tBEGIN\n34\t    FOR i IN 0..ahead LOOP\n35\t        EXECUTE format('CREATE TABLE IF NOT EXISTS %s_%s PARTITION OF %s FOR VALUES FROM (%L) TO (%L)',\n36\t                       parent, to_char(start_ts + i * period, 'IYYY\"w\"IW'), parent,\n37\t                       start_ts + i * period, start_ts + (i + 1) * period);\n38\t    END LOOP;\n39\t    FOR part IN\n40\t        SELECT c.oid::regclass AS rel FROM pg_inherits i JOIN pg_class c ON c.oid = i.inhrelid\n41\t         WHERE i.inhparent = parent ORDER BY c.relname DESC OFFSET keep + ahead + 1\n42\t    LOOP\n43\t        EXECUTE format('DROP TABLE %s', part.rel);\n44\t    END LOOP;\n45\tEND $$;\n46\t\n47\tCREATE TABLE control.stop_flags (\n48\t    flag_id bigserial PRIMARY KEY,\n49\t    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n50\t    value text, active boolean NOT NULL DEFAULT true, reason text NOT NULL,\n51\t    set_by text NOT NULL DEFAULT current_user, set_at timestamptz NOT NULL DEFAULT now()\n52\t);\n53\t\n54\tCREATE TABLE approvals.grants (\n55\t    approval_id uuid PRIMARY KEY, run_id uuid NOT NULL, agent_instance_id text NOT NULL, subject text NOT NULL,\n56\t    operation text NOT NULL, target text NOT NULL, args_sha256 char(64) NOT NULL, args jsonb NOT NULL,\n57\t    tool_use_id text NOT NULL, description text NOT NULL,\n58\t    requested_at timestamptz NOT NULL, expires_at timestamptz NOT NULL,\n59\t    approved_by text, approved_at timestamptz, used_at timestamptz\n60\t);\n61\t\n62\tCREATE TABLE quota.usage (\n63\t    scope text NOT NULL, key text NOT NULL, window_start timestamptz NOT NULL,\n64\t    runs integer NOT NULL DEFAULT 0, tokens bigint NOT NULL DEFAULT 0, cost_usd numeric(12, 4) NOT NULL DEFAULT 0,\n65\t    PRIMARY KEY (scope, key, window_start)\n66\t);\n67\t\n68\tCREATE TABLE retrieval.index_state (id int PRIMARY KEY CHECK (id = 1), version text NOT NULL);\n69\tCREATE TABLE retrieval.chunks (\n70\t    chunk_id text PRIMARY KEY, doc_id text NOT NULL, source text NOT NULL,\n71\t    added_at timestamptz NOT NULL DEFAULT now(), added_by text NOT NULL DEFAULT current_user,\n72\t    trust text NOT NULL CHECK (trust IN ('reviewed', 'hr_authored')),\n73\t    audience text NOT NULL CHECK (audience IN ('all', 'employee')),\n74\t    allowed_employees text[] NOT NULL DEFAULT '{}',\n75\t    expires_at timestamptz, quarantined boolean NOT NULL DEFAULT false, text text NOT NULL,\n76\t    tsv tsvector GENERATED ALWAYS AS (to_tsvector('english', text)) STORED\n77\t);\n78\tCREATE INDEX ON retrieval.chunks USING gin (tsv);\n79\t\n80\tGRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\n81\tGRANT INSERT ON audit.events TO hr_agent;\n82\tGRANT SELECT ON control.stop_flags TO hr_agent;\n83\tGRANT SELECT, INSERT ON approvals.grants TO hr_agent;\n84\tGRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\n85\tGRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\n86\tGRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n87\t\n88\tGRANT USAGE ON SCHEMA audit, control TO hr_gateway;\n89\tGRANT INSERT ON audit.gateway_decisions TO hr_gateway;\n90\tGRANT SELECT ON control.stop_flags TO hr_gateway;\n91\t\n92\tGRANT USAGE ON SCHEMA control TO hr_agent_operator;\n93\tGRANT SELECT, INSERT, UPDATE ON control.stop_flags TO hr_agent_operator;\n94\tGRANT USAGE ON SEQUENCE control.stop_flags_flag_id_seq TO hr_agent_operator;\n95\t\n96\tGRANT USAGE ON SCHEMA audit TO hr_audit_reader, hr_audit_maint;\n97\tGRANT SELECT ON ALL TABLES IN SCHEMA audit TO hr_audit_reader;\n98\tREVOKE EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) FROM PUBLIC;\n99\tGRANT EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) TO hr_audit_maint;\n100\t\n101\tGRANT USAGE ON SCHEMA retrieval TO hr_docs_ingest;\n102\tGRANT SELECT, INSERT, UPDATE ON retrieval.chunks, retrieval.index_state TO hr_docs_ingest;\n103\t"}]},"parent_tool_use_id":null,"session_id":"71ed5773-a566-47b2-9286-6c65525da62e","uuid":"974a7f87-3cc2-4b32-8d67-2fcefb916e70","timestamp":"2026-11-21T11:56:37.241Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-hses_u_o/agent/migrations/001_init.sql","content":"-- Roles (created by the platform team): hr_agent, hr_gateway, hr_agent_operator,\n-- hr_audit_reader, hr_audit_maint, hr_docs_ingest.\nCREATE SCHEMA audit; CREATE SCHEMA control; CREATE SCHEMA approvals; CREATE SCHEMA quota; CREATE SCHEMA retrieval;\n\nCREATE TABLE audit.events (\n    event_id uuid NOT NULL, ts timestamptz NOT NULL, event_type text NOT NULL,\n    run_id uuid NOT NULL, step_id uuid, parent_step_id uuid,\n    accountable_party text NOT NULL, operational_owner text NOT NULL, tenant text NOT NULL,\n    agent_type_id text NOT NULL, agent_instance_id text NOT NULL,\n    trace_id char(32) NOT NULL, span_id char(16) NOT NULL, traceparent text NOT NULL,\n    delegated_subject text NOT NULL, agent_principal text NOT NULL,\n    tool text, operation_target text, decision text, reason text, policy_version text NOT NULL, approval_id uuid,\n    args_redacted jsonb, result_redacted jsonb,\n    context_tokens integer, context_tokens_method text, model_requested text, model_served text,\n    PRIMARY KEY (event_id, ts)\n) PARTITION BY RANGE (ts);\nCREATE INDEX ON audit.events (trace_id);\nCREATE INDEX ON audit.events (run_id, ts);\n\nCREATE TABLE audit.gateway_decisions (\n    ts timestamptz NOT NULL, traceparent text NOT NULL, tenant text NOT NULL,\n    accountable_party text NOT NULL, operational_owner text NOT NULL,\n    agent_type_id_hint text NOT NULL, agent_instance_hint text NOT NULL,   -- caller-supplied; join key only\n    subject text, actor text, tool text, decision text NOT NULL, reason text, policy_version text NOT NULL\n) PARTITION BY RANGE (ts);\n\n-- Creates `ahead` partitions into the future and drops partitions older than the newest `keep`.\nCREATE FUNCTION audit.maintain_partitions(parent regclass, period interval, ahead int, keep int)\nRETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = audit, pg_temp AS $$\nDECLARE\n    start_ts timestamptz := date_trunc('week', now());\n    part record;\nBEGIN\n    FOR i IN 0..ahead LOOP\n        EXECUTE format('CREATE TABLE IF NOT EXISTS %s_%s PARTITION OF %s FOR VALUES FROM (%L) TO (%L)',\n                       parent, to_char(start_ts + i * period, 'IYYY\"w\"IW'), parent,\n                       start_ts + i * period, start_ts + (i + 1) * period);\n    END LOOP;\n    FOR part IN\n        SELECT c.oid::regclass AS rel FROM pg_inherits i JOIN pg_class c ON c.oid = i.inhrelid\n         WHERE i.inhparent = parent ORDER BY c.relname DESC OFFSET keep + ahead + 1\n    LOOP\n        EXECUTE format('DROP TABLE %s', part.rel);\n    END LOOP;\nEND $$;\n\nCREATE TABLE control.stop_flags (\n    flag_id bigserial PRIMARY KEY,\n    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n    value text, active boolean NOT NULL DEFAULT true, reason text NOT NULL,\n    set_by text NOT NULL DEFAULT current_user, set_at timestamptz NOT NULL DEFAULT now()\n);\n\nCREATE TABLE approvals.grants (\n    approval_id uuid PRIMARY KEY, run_id uuid NOT NULL, agent_instance_id text NOT NULL, subject text NOT NULL,\n    operation text NOT NULL, target text NOT NULL, args_sha256 char(64) NOT NULL, args jsonb NOT NULL,\n    tool_use_id text NOT NULL, description text NOT NULL,\n    requested_at timestamptz NOT NULL, expires_at timestamptz NOT NULL,\n    approved_by text, approved_at timestamptz, used_at timestamptz\n);\n\nCREATE TABLE quota.usage (\n    scope text NOT NULL, key text NOT NULL, window_start timestamptz NOT NULL,\n    runs integer NOT NULL DEFAULT 0, tokens bigint NOT NULL DEFAULT 0, cost_usd numeric(12, 4) NOT NULL DEFAULT 0,\n    PRIMARY KEY (scope, key, window_start)\n);\n\nCREATE TABLE retrieval.index_state (id int PRIMARY KEY CHECK (id = 1), version text NOT NULL);\nCREATE TABLE retrieval.chunks (\n    chunk_id text PRIMARY KEY, doc_id text NOT NULL, source text NOT NULL,\n    added_at timestamptz NOT NULL DEFAULT now(), added_by text NOT NULL DEFAULT current_user,\n    trust text NOT NULL CHECK (trust IN ('reviewed', 'hr_authored')),\n    audience text NOT NULL CHECK (audience IN ('all', 'employee')),\n    allowed_employees text[] NOT NULL DEFAULT '{}',\n    expires_at timestamptz, quarantined boolean NOT NULL DEFAULT false, text text NOT NULL,\n    tsv tsvector GENERATED ALWAYS AS (to_tsvector('english', text)) STORED\n);\nCREATE INDEX ON retrieval.chunks USING gin (tsv);\n\nGRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\nGRANT INSERT ON audit.events TO hr_agent;\nGRANT SELECT ON control.stop_flags TO hr_agent;\nGRANT SELECT, INSERT ON approvals.grants TO hr_agent;\nGRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\nGRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\nGRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n\nGRANT USAGE ON SCHEMA audit, control TO hr_gateway;\nGRANT INSERT ON audit.gateway_decisions TO hr_gateway;\nGRANT SELECT ON control.stop_flags TO hr_gateway;\n\nGRANT USAGE ON SCHEMA control TO hr_agent_operator;\nGRANT SELECT, INSERT, UPDATE ON control.stop_flags TO hr_agent_operator;\nGRANT USAGE ON SEQUENCE control.stop_flags_flag_id_seq TO hr_agent_operator;\n\nGRANT USAGE ON SCHEMA audit TO hr_audit_reader, hr_audit_maint;\nGRANT SELECT ON ALL TABLES IN SCHEMA audit TO hr_audit_reader;\nREVOKE EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) FROM PUBLIC;\nGRANT EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) TO hr_audit_maint;\n\nGRANT USAGE ON SCHEMA retrieval TO hr_docs_ingest;\nGRANT SELECT, INSERT, UPDATE ON retrieval.chunks, retrieval.index_state TO hr_docs_ingest;\n","numLines":103,"startLine":1,"totalLines":103}},"tool_result_meta":[{"id":"toolu_01NNE2tURYZ2K9vvjBRriGX9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
