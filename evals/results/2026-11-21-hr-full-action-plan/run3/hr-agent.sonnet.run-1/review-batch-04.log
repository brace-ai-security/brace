{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019BRjYf7ExjhRz38XFkr9hU","type":"tool_result","content":"1\t\"\"\"Agent loop for the HR helpdesk.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport json\n5\timport logging\n6\timport pathlib\n7\timport uuid\n8\tfrom dataclasses import dataclass, field\n9\tfrom datetime import date\n10\tfrom typing import Any\n11\t\n12\tfrom anthropic import AsyncAnthropic\n13\tfrom opentelemetry import trace\n14\t\n15\tfrom .approvals import ApprovalInvalid, ApprovalStore\n16\tfrom .audit import AuditWriter, RunContext\n17\tfrom .budgets import BudgetExceeded, QuotaStore, RunBudget\n18\tfrom .gateway_client import GatewayClient, ToolDenied, ToolError\n19\tfrom .killswitch import StopControl\n20\tfrom .redact import redact\n21\tfrom .retrieval import PolicyIndex\n22\tfrom .tools import ToolRegistry, ToolSpec\n23\tfrom .validation import ValidationRejected, validate_chunk, validate_tool_args, validate_tool_output\n24\t\n25\tlog = logging.getLogger(\"hr_agent.loop\")\n26\ttracer = trace.get_tracer(\"hr_agent\")\n27\t\n28\tSYSTEM_PROMPT = (pathlib.Path(__file__).resolve().parent.parent / \"prompts\" / \"system.md\").read_text()\n29\t\n30\t\n31\t@dataclass\n32\tclass RunState:\n33\t    messages: list[dict[str, Any]]\n34\t    budget: RunBudget\n35\t    subject_token: str\n36\t    status: str = \"running\"\n37\t    reply: str | None = None\n38\t    pending_approval: dict[str, Any] | None = None\n39\t    last_step: str | None = None\n40\t    subagents_started: int = 0\n41\t    extra: dict[str, Any] = field(default_factory=dict)\n42\t\n43\t\n44\tclass Agent:\n45\t    def __init__(self, cfg: dict[str, Any], registry: ToolRegistry, llm: AsyncAnthropic, gateway: GatewayClient,\n46\t                 index: PolicyIndex, approvals: ApprovalStore, quotas: QuotaStore, audit: AuditWriter, stop: StopControl):\n47\t        self.cfg, self.registry, self.llm, self.gateway = cfg, registry, llm, gateway\n48\t        self.index, self.approvals, self.quotas, self.audit, self.stop = index, approvals, quotas, audit, stop\n49\t\n50\t    def new_state(self, user_text: str, subject_token: str) -> RunState:\n51\t        budget = RunBudget(self.cfg[\"budgets\"][\"run\"], self.cfg[\"pricing\"])\n52\t        return RunState(messages=[{\"role\": \"user\", \"content\": user_text}], budget=budget, subject_token=subject_token)\n53\t\n54\t    async def run(self, ctx: RunContext, state: RunState) -> RunState:\n55\t        with tracer.start_as_current_span(\"agent.run\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n56\t            try:\n57\t                await self._loop(ctx, state)\n58\t            except BudgetExceeded as exc:\n59\t                await self.audit.record(ctx, \"budget_stop\", decision=\"stop\", reason=exc.limit, parent_step_id=state.last_step)\n60\t                state.status, state.reply = \"stopped\", \"I've reached the limit for this conversation. An HR advisor can help further.\"\n61\t            return state\n62\t\n63\t    async def _loop(self, ctx: RunContext, state: RunState) -> None:\n64\t        model = self.cfg[\"model\"]\n65\t        while True:\n66\t            await self.stop.raise_if_stopped(ctx)\n67\t            state.budget.check_step()\n68\t            step_id = str(uuid.uuid4())\n69\t            with tracer.start_as_current_span(\"gen_ai.chat\", attributes={\"gen_ai.request.model\": model[\"id\"]}):\n70\t                resp = await self.llm.messages.create(\n71\t                    model=model[\"id\"], system=SYSTEM_PROMPT, max_tokens=model[\"max_output_tokens\"],\n72\t                    temperature=model[\"temperature\"], tools=self.registry.model_schemas(), messages=state.messages,\n73\t                    timeout=state.budget.remaining_seconds(),\n74\t                )\n75\t                tokens, cost = state.budget.record_usage(resp.usage)\n76\t                ctx_tokens = resp.usage.input_tokens + (resp.usage.cache_read_input_tokens or 0) + (resp.usage.cache_creation_input_tokens or 0)\n77\t                await self.audit.record(\n78\t                    ctx, \"model_call\", step_id=step_id, parent_step_id=state.last_step,\n79\t                    context_tokens=ctx_tokens, context_tokens_method=\"measured:provider_usage_input+cache_read+cache_write\",\n80\t                    model_requested=model[\"id\"], model_served=resp.model, result={\"stop_reason\": resp.stop_reason},\n81\t                )\n82\t                await self.quotas.record_usage(ctx, tokens, cost)\n83\t            state.last_step = step_id\n84\t            state.messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n85\t            if resp.stop_reason != \"tool_use\":\n86\t                state.status = \"done\"\n87\t                state.reply = \"\".join(b.text for b in resp.content if b.type == \"text\")\n88\t                return\n89\t            results = []\n90\t            for block in (b for b in resp.content if b.type == \"tool_use\"):\n91\t                result = await self._handle_tool(ctx, state, step_id, block.id, block.name, block.input)\n92\t                if result is None:  # paused for employee approval\n93\t                    return\n94\t                results.append(result)\n95\t            state.messages.append({\"role\": \"user\", \"content\": results})\n96\t\n97\t    async def _handle_tool(self, ctx: RunContext, state: RunState, parent: str, tool_use_id: str,\n98\t                           name: str, args: Any) -> dict[str, Any] | None:\n99\t        step_id = str(uuid.uuid4())\n100\t        await self.audit.record(ctx, \"proposed_action\", step_id=step_id, parent_step_id=parent, tool=name, args=args)\n101\t        spec = self.registry.get(name)\n102\t        if spec is None:\n103\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=name, decision=\"deny\", reason=\"tool not in allowlist\")\n104\t            return _tool_result(tool_use_id, \"This tool is not available.\", error=True)\n105\t        target = spec.target(ctx.subject)\n106\t        state.budget.check_tool_call()\n107\t        try:\n108\t            args = validate_tool_args(spec, args)\n109\t        except ValidationRejected as exc:\n110\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target,\n111\t                                    decision=\"deny\", reason=exc.reason, args=args)\n112\t            return _tool_result(tool_use_id, f\"Invalid arguments: {exc.reason}\", error=True)\n113\t        if spec.approval == \"subject\":\n114\t            approval_id, text = await self.approvals.request(ctx, spec.qualified, target, args, tool_use_id)\n115\t            await self.audit.record(ctx, \"approval_requested\", step_id=step_id, tool=spec.qualified, target=target,\n116\t                                    decision=\"hold\", approval_id=approval_id, args=args)\n117\t            state.status = \"awaiting_approval\"\n118\t            state.pending_approval = {\"approval_id\": approval_id, \"description\": text}\n119\t            return None\n120\t        await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target, decision=\"allow\")\n121\t        return await self._execute(ctx, state, step_id, tool_use_id, spec, target, args, approval_id=None)\n122\t\n123\t    async def resume_with_approval(self, ctx: RunContext, state: RunState, approval_id: str) -> RunState:\n124\t        with tracer.start_as_current_span(\"agent.resume\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n125\t            pending = await self.approvals.pending(approval_id)\n126\t            if pending is None or pending[\"run_id\"] != ctx.run_id:\n127\t                raise ApprovalInvalid(\"unknown approval for this run\")\n128\t            spec = self.registry.by_qualified(pending[\"operation\"])\n129\t            step_id = str(uuid.uuid4())\n130\t            try:\n131\t                await self.stop.raise_if_stopped(ctx)\n132\t                args = validate_tool_args(spec, pending[\"args\"])\n133\t                target = spec.target(ctx.subject)\n134\t                await self._recheck_state(ctx, state, spec, args)\n135\t                grant = await self.approvals.consume(ctx, approval_id, spec.qualified, target, args)\n136\t            except (ApprovalInvalid, ValidationRejected, ToolDenied, ToolError) as exc:\n137\t                await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=pending[\"operation\"],\n138\t                                        decision=\"deny\", reason=str(exc), approval_id=approval_id)\n139\t                state.status, state.reply = \"done\", \"That action can no longer be carried out as approved.\"\n140\t                return state\n141\t            await self.audit.record(ctx, \"approval_used\", step_id=step_id, parent_step_id=state.last_step,\n142\t                                    tool=spec.qualified, target=target, decision=\"allow\", approval_id=approval_id,\n143\t                                    result={\"approved_by\": grant[\"approved_by\"], \"approved_at\": grant[\"approved_at\"].isoformat()})\n144\t            result = await self._execute(ctx, state, step_id, pending[\"tool_use_id\"], spec, target, args, approval_id=approval_id)\n145\t            state.messages.append({\"role\": \"user\", \"content\": [result]})\n146\t            state.status, state.pending_approval = \"running\", None\n147\t            return await self.run(ctx, state)\n148\t\n149\t    async def _recheck_state(self, ctx: RunContext, state: RunState, spec: ToolSpec, args: dict[str, Any]) -> None:\n150\t        \"\"\"Re-read the resource the action depends on, at execution time.\"\"\"\n151\t        if spec.qualified != \"hris/file_leave_request\" or args[\"leave_type\"] == \"unpaid\":\n152\t            return\n153\t        balance_spec = self.registry.get(\"get_leave_balance\")\n154\t        bal = await self.gateway.call(balance_spec, {\"leave_type\": args[\"leave_type\"]}, ctx, state.subject_token,\n155\t                                      operation_id=str(uuid.uuid4()))\n156\t        bal = validate_tool_output(balance_spec, bal, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n157\t        days = (date.fromisoformat(args[\"end_date\"]) - date.fromisoformat(args[\"start_date\"])).days + 1\n158\t        if days <= 0 or bal[\"balance_days\"] < days:\n159\t            raise ApprovalInvalid(\"leave balance no longer covers the request\")\n160\t\n161\t    async def _execute(self, ctx: RunContext, state: RunState, step_id: str, tool_use_id: str, spec: ToolSpec,\n162\t                       target: str, args: dict[str, Any], approval_id: str | None) -> dict[str, Any]:\n163\t        operation_id = approval_id or str(uuid.uuid4())\n164\t        with tracer.start_as_current_span(f\"execute_tool {spec.qualified}\", attributes={\"gen_ai.tool.name\": spec.name}):\n165\t            try:\n166\t                if spec.kind == \"local\":\n167\t                    raw = await self.index.search(args[\"query\"], ctx.subject)\n168\t                    max_chars = self.cfg[\"retrieval\"][\"max_chunk_chars\"]\n169\t                    clean: Any = []\n170\t                    for chunk in raw:\n171\t                        try:\n172\t                            clean.append(validate_chunk(chunk, max_chars))\n173\t                        except ValidationRejected as exc:\n174\t                            await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified,\n175\t                                                    decision=\"hold\", reason=exc.reason, result={\"chunk_id\": chunk[\"chunk_id\"]})\n176\t                else:\n177\t                    raw = await self.gateway.call(spec, args, ctx, state.subject_token, operation_id=operation_id)\n178\t                    clean = validate_tool_output(spec, raw, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n179\t            except ToolDenied as exc:\n180\t                await self.audit.record(ctx, \"tool_denied\", step_id=step_id, tool=spec.qualified, target=target,\n181\t                                        decision=\"deny\", reason=exc.reason, approval_id=approval_id, args=args)\n182\t                return _tool_result(tool_use_id, \"The request was refused by policy.\", error=True)\n183\t            except ToolError as exc:\n184\t                await self.audit.record(ctx, \"tool_error\", step_id=step_id, tool=spec.qualified, target=target,\n185\t                                        decision=\"error\", reason=f\"status {exc.status}\", approval_id=approval_id,\n186\t                                        args=args, result={\"detail\": exc.detail})\n187\t                log.warning(\"tool error\", extra={\"tool\": spec.qualified, \"detail\": redact(exc.detail)})\n188\t                return _tool_result(tool_use_id, f\"{spec.name} failed: {exc.detail}\", error=True)\n189\t            except ValidationRejected as exc:\n190\t                await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified, target=target,\n191\t                                        decision=\"hold\", reason=exc.reason, approval_id=approval_id)\n192\t                return _tool_result(tool_use_id, \"The tool returned data that could not be used.\", error=True)\n193\t        await self.audit.record(ctx, \"tool_result\", step_id=step_id, tool=spec.qualified, target=target,\n194\t                                decision=\"ok\", approval_id=approval_id, args=args, result=clean)\n195\t        envelope = {\"source\": spec.qualified, \"trust\": \"untrusted_data\", \"data\": clean}\n196\t        return _tool_result(tool_use_id, json.dumps(envelope, ensure_ascii=False))\n197\t\n198\t\n199\tdef _tool_result(tool_use_id: str, content: str, error: bool = False) -> dict[str, Any]:\n200\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"content\": content, \"is_error\": error}\n201\t"}]},"parent_tool_use_id":null,"session_id":"71ed5773-a566-47b2-9286-6c65525da62e","uuid":"4eec302a-4938-4075-b024-09690d93bb95","timestamp":"2026-11-21T11:56:38.144Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-hses_u_o/agent/src/agent.py","content":"\"\"\"Agent loop for the HR helpdesk.\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport logging\nimport pathlib\nimport uuid\nfrom dataclasses import dataclass, field\nfrom datetime import date\nfrom typing import Any\n\nfrom anthropic import AsyncAnthropic\nfrom opentelemetry import trace\n\nfrom .approvals import ApprovalInvalid, ApprovalStore\nfrom .audit import AuditWriter, RunContext\nfrom .budgets import BudgetExceeded, QuotaStore, RunBudget\nfrom .gateway_client import GatewayClient, ToolDenied, ToolError\nfrom .killswitch import StopControl\nfrom .redact import redact\nfrom .retrieval import PolicyIndex\nfrom .tools import ToolRegistry, ToolSpec\nfrom .validation import ValidationRejected, validate_chunk, validate_tool_args, validate_tool_output\n\nlog = logging.getLogger(\"hr_agent.loop\")\ntracer = trace.get_tracer(\"hr_agent\")\n\nSYSTEM_PROMPT = (pathlib.Path(__file__).resolve().parent.parent / \"prompts\" / \"system.md\").read_text()\n\n\n@dataclass\nclass RunState:\n    messages: list[dict[str, Any]]\n    budget: RunBudget\n    subject_token: str\n    status: str = \"running\"\n    reply: str | None = None\n    pending_approval: dict[str, Any] | None = None\n    last_step: str | None = None\n    subagents_started: int = 0\n    extra: dict[str, Any] = field(default_factory=dict)\n\n\nclass Agent:\n    def __init__(self, cfg: dict[str, Any], registry: ToolRegistry, llm: AsyncAnthropic, gateway: GatewayClient,\n                 index: PolicyIndex, approvals: ApprovalStore, quotas: QuotaStore, audit: AuditWriter, stop: StopControl):\n        self.cfg, self.registry, self.llm, self.gateway = cfg, registry, llm, gateway\n        self.index, self.approvals, self.quotas, self.audit, self.stop = index, approvals, quotas, audit, stop\n\n    def new_state(self, user_text: str, subject_token: str) -> RunState:\n        budget = RunBudget(self.cfg[\"budgets\"][\"run\"], self.cfg[\"pricing\"])\n        return RunState(messages=[{\"role\": \"user\", \"content\": user_text}], budget=budget, subject_token=subject_token)\n\n    async def run(self, ctx: RunContext, state: RunState) -> RunState:\n        with tracer.start_as_current_span(\"agent.run\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n            try:\n                await self._loop(ctx, state)\n            except BudgetExceeded as exc:\n                await self.audit.record(ctx, \"budget_stop\", decision=\"stop\", reason=exc.limit, parent_step_id=state.last_step)\n                state.status, state.reply = \"stopped\", \"I've reached the limit for this conversation. An HR advisor can help further.\"\n            return state\n\n    async def _loop(self, ctx: RunContext, state: RunState) -> None:\n        model = self.cfg[\"model\"]\n        while True:\n            await self.stop.raise_if_stopped(ctx)\n            state.budget.check_step()\n            step_id = str(uuid.uuid4())\n            with tracer.start_as_current_span(\"gen_ai.chat\", attributes={\"gen_ai.request.model\": model[\"id\"]}):\n                resp = await self.llm.messages.create(\n                    model=model[\"id\"], system=SYSTEM_PROMPT, max_tokens=model[\"max_output_tokens\"],\n                    temperature=model[\"temperature\"], tools=self.registry.model_schemas(), messages=state.messages,\n                    timeout=state.budget.remaining_seconds(),\n                )\n                tokens, cost = state.budget.record_usage(resp.usage)\n                ctx_tokens = resp.usage.input_tokens + (resp.usage.cache_read_input_tokens or 0) + (resp.usage.cache_creation_input_tokens or 0)\n                await self.audit.record(\n                    ctx, \"model_call\", step_id=step_id, parent_step_id=state.last_step,\n                    context_tokens=ctx_tokens, context_tokens_method=\"measured:provider_usage_input+cache_read+cache_write\",\n                    model_requested=model[\"id\"], model_served=resp.model, result={\"stop_reason\": resp.stop_reason},\n                )\n                await self.quotas.record_usage(ctx, tokens, cost)\n            state.last_step = step_id\n            state.messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n            if resp.stop_reason != \"tool_use\":\n                state.status = \"done\"\n                state.reply = \"\".join(b.text for b in resp.content if b.type == \"text\")\n                return\n            results = []\n            for block in (b for b in resp.content if b.type == \"tool_use\"):\n                result = await self._handle_tool(ctx, state, step_id, block.id, block.name, block.input)\n                if result is None:  # paused for employee approval\n                    return\n                results.append(result)\n            state.messages.append({\"role\": \"user\", \"content\": results})\n\n    async def _handle_tool(self, ctx: RunContext, state: RunState, parent: str, tool_use_id: str,\n                           name: str, args: Any) -> dict[str, Any] | None:\n        step_id = str(uuid.uuid4())\n        await self.audit.record(ctx, \"proposed_action\", step_id=step_id, parent_step_id=parent, tool=name, args=args)\n        spec = self.registry.get(name)\n        if spec is None:\n            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=name, decision=\"deny\", reason=\"tool not in allowlist\")\n            return _tool_result(tool_use_id, \"This tool is not available.\", error=True)\n        target = spec.target(ctx.subject)\n        state.budget.check_tool_call()\n        try:\n            args = validate_tool_args(spec, args)\n        except ValidationRejected as exc:\n            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target,\n                                    decision=\"deny\", reason=exc.reason, args=args)\n            return _tool_result(tool_use_id, f\"Invalid arguments: {exc.reason}\", error=True)\n        if spec.approval == \"subject\":\n            approval_id, text = await self.approvals.request(ctx, spec.qualified, target, args, tool_use_id)\n            await self.audit.record(ctx, \"approval_requested\", step_id=step_id, tool=spec.qualified, target=target,\n                                    decision=\"hold\", approval_id=approval_id, args=args)\n            state.status = \"awaiting_approval\"\n            state.pending_approval = {\"approval_id\": approval_id, \"description\": text}\n            return None\n        await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target, decision=\"allow\")\n        return await self._execute(ctx, state, step_id, tool_use_id, spec, target, args, approval_id=None)\n\n    async def resume_with_approval(self, ctx: RunContext, state: RunState, approval_id: str) -> RunState:\n        with tracer.start_as_current_span(\"agent.resume\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n            pending = await self.approvals.pending(approval_id)\n            if pending is None or pending[\"run_id\"] != ctx.run_id:\n                raise ApprovalInvalid(\"unknown approval for this run\")\n            spec = self.registry.by_qualified(pending[\"operation\"])\n            step_id = str(uuid.uuid4())\n            try:\n                await self.stop.raise_if_stopped(ctx)\n                args = validate_tool_args(spec, pending[\"args\"])\n                target = spec.target(ctx.subject)\n                await self._recheck_state(ctx, state, spec, args)\n                grant = await self.approvals.consume(ctx, approval_id, spec.qualified, target, args)\n            except (ApprovalInvalid, ValidationRejected, ToolDenied, ToolError) as exc:\n                await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=pending[\"operation\"],\n                                        decision=\"deny\", reason=str(exc), approval_id=approval_id)\n                state.status, state.reply = \"done\", \"That action can no longer be carried out as approved.\"\n                return state\n            await self.audit.record(ctx, \"approval_used\", step_id=step_id, parent_step_id=state.last_step,\n                                    tool=spec.qualified, target=target, decision=\"allow\", approval_id=approval_id,\n                                    result={\"approved_by\": grant[\"approved_by\"], \"approved_at\": grant[\"approved_at\"].isoformat()})\n            result = await self._execute(ctx, state, step_id, pending[\"tool_use_id\"], spec, target, args, approval_id=approval_id)\n            state.messages.append({\"role\": \"user\", \"content\": [result]})\n            state.status, state.pending_approval = \"running\", None\n            return await self.run(ctx, state)\n\n    async def _recheck_state(self, ctx: RunContext, state: RunState, spec: ToolSpec, args: dict[str, Any]) -> None:\n        \"\"\"Re-read the resource the action depends on, at execution time.\"\"\"\n        if spec.qualified != \"hris/file_leave_request\" or args[\"leave_type\"] == \"unpaid\":\n            return\n        balance_spec = self.registry.get(\"get_leave_balance\")\n        bal = await self.gateway.call(balance_spec, {\"leave_type\": args[\"leave_type\"]}, ctx, state.subject_token,\n                                      operation_id=str(uuid.uuid4()))\n        bal = validate_tool_output(balance_spec, bal, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n        days = (date.fromisoformat(args[\"end_date\"]) - date.fromisoformat(args[\"start_date\"])).days + 1\n        if days <= 0 or bal[\"balance_days\"] < days:\n            raise ApprovalInvalid(\"leave balance no longer covers the request\")\n\n    async def _execute(self, ctx: RunContext, state: RunState, step_id: str, tool_use_id: str, spec: ToolSpec,\n                       target: str, args: dict[str, Any], approval_id: str | None) -> dict[str, Any]:\n        operation_id = approval_id or str(uuid.uuid4())\n        with tracer.start_as_current_span(f\"execute_tool {spec.qualified}\", attributes={\"gen_ai.tool.name\": spec.name}):\n            try:\n                if spec.kind == \"local\":\n                    raw = await self.index.search(args[\"query\"], ctx.subject)\n                    max_chars = self.cfg[\"retrieval\"][\"max_chunk_chars\"]\n                    clean: Any = []\n                    for chunk in raw:\n                        try:\n                            clean.append(validate_chunk(chunk, max_chars))\n                        except ValidationRejected as exc:\n                            await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified,\n                                                    decision=\"hold\", reason=exc.reason, result={\"chunk_id\": chunk[\"chunk_id\"]})\n                else:\n                    raw = await self.gateway.call(spec, args, ctx, state.subject_token, operation_id=operation_id)\n                    clean = validate_tool_output(spec, raw, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n            except ToolDenied as exc:\n                await self.audit.record(ctx, \"tool_denied\", step_id=step_id, tool=spec.qualified, target=target,\n                                        decision=\"deny\", reason=exc.reason, approval_id=approval_id, args=args)\n                return _tool_result(tool_use_id, \"The request was refused by policy.\", error=True)\n            except ToolError as exc:\n                await self.audit.record(ctx, \"tool_error\", step_id=step_id, tool=spec.qualified, target=target,\n                                        decision=\"error\", reason=f\"status {exc.status}\", approval_id=approval_id,\n                                        args=args, result={\"detail\": exc.detail})\n                log.warning(\"tool error\", extra={\"tool\": spec.qualified, \"detail\": redact(exc.detail)})\n                return _tool_result(tool_use_id, f\"{spec.name} failed: {exc.detail}\", error=True)\n            except ValidationRejected as exc:\n                await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified, target=target,\n                                        decision=\"hold\", reason=exc.reason, approval_id=approval_id)\n                return _tool_result(tool_use_id, \"The tool returned data that could not be used.\", error=True)\n        await self.audit.record(ctx, \"tool_result\", step_id=step_id, tool=spec.qualified, target=target,\n                                decision=\"ok\", approval_id=approval_id, args=args, result=clean)\n        envelope = {\"source\": spec.qualified, \"trust\": \"untrusted_data\", \"data\": clean}\n        return _tool_result(tool_use_id, json.dumps(envelope, ensure_ascii=False))\n\n\ndef _tool_result(tool_use_id: str, content: str, error: bool = False) -> dict[str, Any]:\n    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"content\": content, \"is_error\": error}\n","numLines":201,"startLine":1,"totalLines":201}},"tool_result_meta":[{"id":"toolu_019BRjYf7ExjhRz38XFkr9hU","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
