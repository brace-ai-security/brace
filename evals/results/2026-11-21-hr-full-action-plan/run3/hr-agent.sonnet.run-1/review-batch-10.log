{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R86Q3qrvLXMb9XyMFs4PYN","type":"tool_result","content":"src/gateway.py:34:STS_BASE = \"https://sts.identity.svc.cluster.local\"\nsrc/audit.py:1:\"\"\"Append-only audit records. Every record carries the six identity fields.\"\"\"\nsrc/audit.py:20:    \"\"\"Built by the harness from verified identity. Never from model output.\"\"\"\nsrc/audit.py:29:    agent_principal: str      # workload identity of this agent\nsrc/credentials.py:1:\"\"\"Per-tool, per-employee, short-lived tokens for the agent's own workload identity.\nsrc/credentials.py:18:STS_URL = \"https://sts.identity.svc.cluster.local/oauth2/token\"\nsrc/type_id.py:1:\"\"\"agent-type-id: SHA-256 over every identity-defining input.\nsrc/type_id.py:9:release manifest) and at pod start (to refuse running under an identity it does not match).\nsrc/main.py:81:        agent_principal=a[\"workload_identity\"],\n     1\t\"\"\"Approval records for consequential tool calls.\n     2\t\n     3\tAn approval is bound to one agent instance, one operation, one target and the SHA-256 of\n     4\tthe canonical arguments. Only the employee on whose behalf the run acts may approve, they\n     5\tsee a rendered description of the exact action, and each approval is consumed once.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport json\n    11\timport uuid\n    12\tfrom datetime import timedelta\n    13\tfrom typing import Any\n    14\t\n    15\timport asyncpg\n    16\t\n    17\tfrom .audit import RunContext\n    18\t\n    19\t\n    20\tclass ApprovalInvalid(Exception):\n    21\t    pass\n    22\t\n    23\t\n    24\tdef args_digest(args: dict[str, Any]) -> str:\n    25\t    canonical = json.dumps(args, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False)\n    26\t    return hashlib.sha256(canonical.encode()).hexdigest()\n    27\t\n    28\t\n    29\tdef describe(operation: str, target: str, args: dict[str, Any]) -> str:\n    30\t    if operation == \"hris/file_leave_request\":\n    31\t        return (f\"Submit a {args['leave_type']} leave request from {args['start_date']} to {args['end_date']} \"\n    32\t                f\"for {target}. Your manager will be asked to approve it in HRIS.\")\n    33\t    if operation == \"helpdesk/create_ticket\":\n    34\t        return f\"Send this summary to an HR advisor ({args['category']}):\\n\\n{args['summary']}\"\n    35\t    raise ValueError(operation)\n    36\t\n    37\t\n    38\tclass ApprovalStore:\n    39\t    def __init__(self, pool: asyncpg.Pool, ttl_seconds: int):\n    40\t        self._pool = pool\n    41\t        self._ttl = timedelta(seconds=ttl_seconds)\n    42\t\n    43\t    async def request(self, ctx: RunContext, operation: str, target: str, args: dict[str, Any], tool_use_id: str) -> tuple[str, str]:\n    44\t        approval_id = str(uuid.uuid4())\n    45\t        text = describe(operation, target, args)\n    46\t        await self._pool.execute(\n    47\t            \"\"\"INSERT INTO approvals.grants\n    48\t                 (approval_id, run_id, agent_instance_id, subject, operation, target, args_sha256, args,\n    49\t                  tool_use_id, description, requested_at, expires_at)\n    50\t               VALUES ($1, $2, $3, $4, $5, $6, $7, $8::jsonb, $9, $10, now(), now() + $11)\"\"\",\n    51\t            approval_id, ctx.run_id, ctx.agent_instance_id, ctx.subject, operation, target,\n    52\t            args_digest(args), json.dumps(args), tool_use_id, text, self._ttl,\n    53\t        )\n    54\t        return approval_id, text\n    55\t\n    56\t    async def confirm(self, approval_id: str, approver: str) -> None:\n    57\t        \"\"\"Called from the employee's authenticated session. Approver must be the run's subject.\"\"\"\n    58\t        row = await self._pool.fetchrow(\n    59\t            \"\"\"UPDATE approvals.grants SET approved_by = $2, approved_at = now()\n    60\t                WHERE approval_id = $1 AND subject = $2 AND approved_at IS NULL AND expires_at > now()\n    61\t                RETURNING approval_id\"\"\",\n    62\t            approval_id, approver,\n    63\t        )\n    64\t        if row is None:\n    65\t            raise ApprovalInvalid(\"not found, expired, already decided, or approver lacks authority\")\n    66\t\n    67\t    async def consume(self, ctx: RunContext, approval_id: str, operation: str, target: str, args: dict[str, Any]) -> dict[str, Any]:\n    68\t        \"\"\"Atomically mark the approval used. Every binding is re-checked in the same statement.\"\"\"\n    69\t        row = await self._pool.fetchrow(\n    70\t            \"\"\"UPDATE approvals.grants SET used_at = now()\n    71\t                WHERE approval_id = $1\n    72\t                  AND used_at IS NULL\n    73\t                  AND approved_at IS NOT NULL\n    74\t                  AND approved_by = subject\n    75\t                  AND expires_at > now()\n    76\t                  AND agent_instance_id = $2\n    77\t                  AND subject = $3\n    78\t                  AND operation = $4\n    79\t                  AND target = $5\n    80\t                  AND args_sha256 = $6\n    81\t                RETURNING approval_id, approved_by, approved_at, expires_at\"\"\",\n    82\t            approval_id, ctx.agent_instance_id, ctx.subject, operation, target, args_digest(args),\n    83\t        )\n    84\t        if row is None:\n    85\t            raise ApprovalInvalid(\"approval does not match this action, was used, or expired\")\n    86\t        return dict(row)\n    87\t\n    88\t    async def pending(self, approval_id: str) -> dict[str, Any] | None:\n    89\t        row = await self._pool.fetchrow(\n    90\t            \"SELECT run_id, operation, target, args, tool_use_id FROM approvals.grants WHERE approval_id = $1\",\n    91\t            approval_id,\n    92\t        )\n    93\t        if row is None:\n    94\t            return None\n    95\t        out = dict(row)\n    96\t        out[\"args\"] = json.loads(out[\"args\"])\n    97\t        return out\n            state.messages.append({\"role\": \"user\", \"content\": results})\n\n    async def _handle_tool(self, ctx: RunContext, state: RunState, parent: str, tool_use_id: str,\n                           name: str, args: Any) -> dict[str, Any] | None:\n        step_id = str(uuid.uuid4())\n        await self.audit.record(ctx, \"proposed_action\", step_id=step_id, parent_step_id=parent, tool=name, args=args)\n        spec = self.registry.get(name)\n        if spec is None:\n            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=name, decision=\"deny\", reason=\"tool not in allowlist\")\n            return _tool_result(tool_use_id, \"This tool is not available.\", error=True)\n        target = spec.target(ctx.subject)\n        state.budget.check_tool_call()\n        try:\n            args = validate_tool_args(spec, args)\n        except ValidationRejected as exc:\n            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target,\n                                    decision=\"deny\", reason=exc.reason, args=args)\n            return _tool_result(tool_use_id, f\"Invalid arguments: {exc.reason}\", error=True)\n        if spec.approval == \"subject\":\n            approval_id, text = await self.approvals.request(ctx, spec.qualified, target, args, tool_use_id)\n            await self.audit.record(ctx, \"approval_requested\", step_id=step_id, tool=spec.qualified, target=target,\n                                    decision=\"hold\", approval_id=approval_id, args=args)\n            state.status = \"awaiting_approval\"\n            state.pending_approval = {\"approval_id\": approval_id, \"description\": text}\n            return None\n        await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target, decision=\"allow\")\n        return await self._execute(ctx, state, step_id, tool_use_id, spec, target, args, approval_id=None)\n\n    async def resume_with_approval(self, ctx: RunContext, state: RunState, approval_id: str) -> RunState:\n        with tracer.start_as_current_span(\"agent.resume\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n            pending = await self.approvals.pending(approval_id)\n            if pending is None or pending[\"run_id\"] != ctx.run_id:\n                raise ApprovalInvalid(\"unknown approval for this run\")\n            spec = self.registry.by_qualified(pending[\"operation\"])\n            step_id = str(uuid.uuid4())\n            try:\n                await self.stop.raise_if_stopped(ctx)\n                args = validate_tool_args(spec, pending[\"args\"])\n                target = spec.target(ctx.subject)\n                await self._recheck_state(ctx, state, spec, args)\n                grant = await self.approvals.consume(ctx, approval_id, spec.qualified, target, args)\n            except (ApprovalInvalid, ValidationRejected, ToolDenied, ToolError) as exc:\n                await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=pending[\"operation\"],\n                                        decision=\"deny\", reason=str(exc), approval_id=approval_id)\n                state.status, state.reply = \"done\", \"That action can no longer be carried out as approved.\"\n                return state\n            await self.audit.record(ctx, \"approval_used\", step_id=step_id, parent_step_id=state.last_step,\n                                    tool=spec.qualified, target=target, decision=\"allow\", approval_id=approval_id,\n                                    result={\"approved_by\": grant[\"approved_by\"], \"approved_at\": grant[\"approved_at\"].isoformat()})\n            result = await self._execute(ctx, state, step_id, pending[\"tool_use_id\"], spec, target, args, approval_id=approval_id)\n            state.messages.append({\"role\": \"user\", \"content\": [result]})\n            state.status, state.pending_approval = \"running\", None\n            return await self.run(ctx, state)\n\n    async def _recheck_state(self, ctx: RunContext, state: RunState, spec: ToolSpec, args: dict[str, Any]) -> None:\n        \"\"\"Re-read the resource the action depends on, at execution time.\"\"\"\n        if spec.qualified != \"hris/file_leave_request\" or args[\"leave_type\"] == \"unpaid\":\n            return\n        balance_spec = self.registry.get(\"get_leave_balance\")\n        bal = await self.gateway.call(balance_spec, {\"leave_type\": args[\"leave_type\"]}, ctx, state.subject_token,\n                                      operation_id=str(uuid.uuid4()))\n        bal = validate_tool_output(balance_spec, bal, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n        days = (date.fromisoformat(args[\"end_date\"]) - date.fromisoformat(args[\"start_date\"])).days + 1\n        if days <= 0 or bal[\"balance_days\"] < days:\n            raise ApprovalInvalid(\"leave balance no longer covers the request\")\n\n    async def _execute(self, ctx: RunContext, state: RunState, step_id: str, tool_use_id: str, spec: ToolSpec,\n                       target: str, args: dict[str, Any], approval_id: str | None) -> dict[str, Any]:\n        operation_id = approval_id or str(uuid.uuid4())\n        with tracer.start_as_current_span(f\"execute_tool {spec.qualified}\", attributes={\"gen_ai.tool.name\": spec.name}):\n            try:\n                if spec.kind == \"local\":\n                    raw = await self.index.search(args[\"query\"], ctx.subject)\n                    max_chars = self.cfg[\"retrieval\"][\"max_chunk_chars\"]\n                    clean: Any = []\n                    for chunk in raw:\n                        try:\n                            clean.append(validate_chunk(chunk, max_chars))\n                        except ValidationRejected as exc:\n                            await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified,\n                                                    decision=\"hold\", reason=exc.reason, result={\"chunk_id\": chunk[\"chunk_id\"]})\n                else:\n                    raw = await self.gateway.call(spec, args, ctx, state.subject_token, operation_id=operation_id)\n                    clean = validate_tool_output(spec, raw, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n            except ToolDenied as exc:\n                await self.audit.record(ctx, \"tool_denied\", step_id=step_id, tool=spec.qualified, target=target,\n                                        decision=\"deny\", reason=exc.reason, approval_id=approval_id, args=args)\n                return _tool_result(tool_use_id, \"The request was refused by policy.\", error=True)\n            except ToolError as exc:\n                await self.audit.record(ctx, \"tool_error\", step_id=step_id, tool=spec.qualified, target=target,\n                                        decision=\"error\", reason=f\"status {exc.status}\", approval_id=approval_id,\n                                        args=args, result={\"detail\": exc.detail})\n                log.warning(\"tool error\", extra={\"tool\": spec.qualified, \"detail\": redact(exc.detail)})\n                return _tool_result(tool_use_id, f\"{spec.name} failed: {exc.detail}\", error=True)\n            except ValidationRejected as exc:\n                await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified, target=target,\n                                        decision=\"hold\", reason=exc.reason, approval_id=approval_id)\n                return _tool_result(tool_use_id, \"The tool returned data that could not be used.\", error=True)\n        await self.audit.record(ctx, \"tool_result\", step_id=step_id, tool=spec.qualified, target=target,\n                                decision=\"ok\", approval_id=approval_id, args=args, result=clean)\n        envelope = {\"source\": spec.qualified, \"trust\": \"untrusted_data\", \"data\": clean}\n        return _tool_result(tool_use_id, json.dumps(envelope, ensure_ascii=False))\n\n\ndef _tool_result(tool_use_id: str, content: str, error: bool = False) -> dict[str, Any]:\n    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"content\": content, \"is_error\": error}\n66:    ap.add_argument(\"findings\")\n67:    ap.add_argument(\"kind\", choices=[\"check\", \"flag\", \"item\", \"prescan\", \"next\"])\n68:    ap.add_argument(\"target\", nargs=\"?\")\n69:    ap.add_argument(\"--repo\")\n70:    ap.add_argument(\"--met\", choices=[\"yes\", \"no\", \"unknown\"])\n71:    ap.add_argument(\"--evidence\", default=\"\")\n72:    ap.add_argument(\"--quote\", default=\"\")\n73:    ap.add_argument(\"--counter\", default=\"\")\n74:    ap.add_argument(\"--note\", default=\"\")\n75:    ap.add_argument(\"--rating\", choices=[\"likely_pass\", \"gap\", \"needs_evidence\", \"na_candidate\"])\n76:    ap.add_argument(\"--confidence\", choices=[\"high\", \"medium\", \"low\"], default=\"medium\")\n77:    ap.add_argument(\"--summary\", default=\"\")\n78:    ap.add_argument(\"--next\", dest=\"next_step\", default=\"\")\n79:    ap.add_argument(\"--violates\", action=\"append\", default=[])\n80:    ap.add_argument(\"--also-affects\", action=\"append\", default=[])\n81:    ap.add_argument(\"--verdict\", choices=[\"confirmed\", \"dismissed\"])\n82:    ap.add_argument(\"--item\")\n83:    ap.add_argument(\"--reason\", default=\"\")\n468:    ap.add_argument(\"mode\", choices=[\"make\", \"apply\"])\n469:    ap.add_argument(\"findings\")\n470:    ap.add_argument(\"--repo\")\n471:    ap.add_argument(\"--out\")\n472:    ap.add_argument(\"--hunt\", action=\"store_true\")\n566:    ap.add_argument(\"out\")\n567:    ap.add_argument(\"--repo\", default=\"\")\n568:    ap.add_argument(\"--commit\", default=None)\n569:    ap.add_argument(\"--aspect\", choices=list(\"BRACE\"))\n570:    ap.add_argument('--items', help='Only these comma-separated items, at most five for a bounded batch')\n783:    ap.add_argument(\"repo\")\n784:    ap.add_argument(\"--out\", help=\"output JSON (default REPO/brace-prescan.json)\")\n785:    ap.add_argument(\"--patterns\", default=str(PATTERNS_FILE), help=argparse.SUPPRESS)\n957:    sub = ap.add_subparsers(dest='command', required=True)\n958:    scan = sub.add_parser('inventory'); scan.add_argument('repo')\n959:    policy = sub.add_parser('policy'); policy.add_argument('check'); policy.add_argument('--repo')\n960:    record = sub.add_parser('ledger'); record.add_argument('findings'); record.add_argument('check')\n961:    record.add_argument('--rows', required=True); record.add_argument('--attempts'); record.add_argument('--deviations')\n1831:    ap.add_argument(\"findings\")\n1832:    ap.add_argument(\"--repo\")\n1833:    ap.add_argument(\"--fix\", action=\"store_true\")\n1834:    ap.add_argument(\"--conservative\", action=\"store_true\")\n1835:    ap.add_argument(\"--aspect\", choices=list(\"BRACE\"))\n1836:    ap.add_argument(\"--batch\", help=\"Validate only these comma-separated completed item IDs\")\n1837:    ap.add_argument(\"--topology\", help=\"CycloneDX topology whose bom-refs findings may name\")\n1838:    ap.add_argument(\"--before-challenges\", action=\"store_true\", help=\"Suppress only expected unchallenged-rating errors\")\n__pycache__\nanswer.py\nchallenge.py\nmerge_findings.py\nnew_findings.py\nprescan.py\nreview_coverage.py\ntest_challenge.py\ntest_prescan.py\ntest_review_coverage.py\nvalidate_findings.py","is_error":false}]},"parent_tool_use_id":null,"session_id":"dedaacba-96f3-4714-844e-d917838eca87","uuid":"c7381155-4f0c-4a23-bb9c-445be5c75b0b","timestamp":"2026-11-21T12:13:21.750Z","tool_use_result":{"stdout":"src/gateway.py:34:STS_BASE = \"https://sts.identity.svc.cluster.local\"\nsrc/audit.py:1:\"\"\"Append-only audit records. Every record carries the six identity fields.\"\"\"\nsrc/audit.py:20:    \"\"\"Built by the harness from verified identity. Never from model output.\"\"\"\nsrc/audit.py:29:    agent_principal: str      # workload identity of this agent\nsrc/credentials.py:1:\"\"\"Per-tool, per-employee, short-lived tokens for the agent's own workload identity.\nsrc/credentials.py:18:STS_URL = \"https://sts.identity.svc.cluster.local/oauth2/token\"\nsrc/type_id.py:1:\"\"\"agent-type-id: SHA-256 over every identity-defining input.\nsrc/type_id.py:9:release manifest) and at pod start (to refuse running under an identity it does not match).\nsrc/main.py:81:        agent_principal=a[\"workload_identity\"],\n     1\t\"\"\"Approval records for consequential tool calls.\n     2\t\n     3\tAn approval is bound to one agent instance, one operation, one target and the SHA-256 of\n     4\tthe canonical arguments. Only the employee on whose behalf the run acts may approve, they\n     5\tsee a rendered description of the exact action, and each approval is consumed once.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport json\n    11\timport uuid\n    12\tfrom datetime import timedelta\n    13\tfrom typing import Any\n    14\t\n    15\timport asyncpg\n    16\t\n    17\tfrom .audit import RunContext\n    18\t\n    19\t\n    20\tclass ApprovalInvalid(Exception):\n    21\t    pass\n    22\t\n    23\t\n    24\tdef args_digest(args: dict[str, Any]) -> str:\n    25\t    canonical = json.dumps(args, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False)\n    26\t    return hashlib.sha256(canonical.encode()).hexdigest()\n    27\t\n    28\t\n    29\tdef describe(operation: str, target: str, args: dict[str, Any]) -> str:\n    30\t    if operation == \"hris/file_leave_request\":\n    31\t        return (f\"Submit a {args['leave_type']} leave request from {args['start_date']} to {args['end_date']} \"\n    32\t                f\"for {target}. Your manager will be asked to approve it in HRIS.\")\n    33\t    if operation == \"helpdesk/create_ticket\":\n    34\t        return f\"Send this summary to an HR advisor ({args['category']}):\\n\\n{args['summary']}\"\n    35\t    raise ValueError(operation)\n    36\t\n    37\t\n    38\tclass ApprovalStore:\n    39\t    def __init__(self, pool: asyncpg.Pool, ttl_seconds: int):\n    40\t        self._pool = pool\n    41\t        self._ttl = timedelta(seconds=ttl_seconds)\n    42\t\n    43\t    async def request(self, ctx: RunContext, operation: str, target: str, args: dict[str, Any], tool_use_id: str) -> tuple[str, str]:\n    44\t        approval_id = str(uuid.uuid4())\n    45\t        text = describe(operation, target, args)\n    46\t        await self._pool.execute(\n    47\t            \"\"\"INSERT INTO approvals.grants\n    48\t                 (approval_id, run_id, agent_instance_id, subject, operation, target, args_sha256, args,\n    49\t                  tool_use_id, description, requested_at, expires_at)\n    50\t               VALUES ($1, $2, $3, $4, $5, $6, $7, $8::jsonb, $9, $10, now(), now() + $11)\"\"\",\n    51\t            approval_id, ctx.run_id, ctx.agent_instance_id, ctx.subject, operation, target,\n    52\t            args_digest(args), json.dumps(args), tool_use_id, text, self._ttl,\n    53\t        )\n    54\t        return approval_id, text\n    55\t\n    56\t    async def confirm(self, approval_id: str, approver: str) -> None:\n    57\t        \"\"\"Called from the employee's authenticated session. Approver must be the run's subject.\"\"\"\n    58\t        row = await self._pool.fetchrow(\n    59\t            \"\"\"UPDATE approvals.grants SET approved_by = $2, approved_at = now()\n    60\t                WHERE approval_id = $1 AND subject = $2 AND approved_at IS NULL AND expires_at > now()\n    61\t                RETURNING approval_id\"\"\",\n    62\t            approval_id, approver,\n    63\t        )\n    64\t        if row is None:\n    65\t            raise ApprovalInvalid(\"not found, expired, already decided, or approver lacks authority\")\n    66\t\n    67\t    async def consume(self, ctx: RunContext, approval_id: str, operation: str, target: str, args: dict[str, Any]) -> dict[str, Any]:\n    68\t        \"\"\"Atomically mark the approval used. Every binding is re-checked in the same statement.\"\"\"\n    69\t        row = await self._pool.fetchrow(\n    70\t            \"\"\"UPDATE approvals.grants SET used_at = now()\n    71\t                WHERE approval_id = $1\n    72\t                  AND used_at IS NULL\n    73\t                  AND approved_at IS NOT NULL\n    74\t                  AND approved_by = subject\n    75\t                  AND expires_at > now()\n    76\t                  AND agent_instance_id = $2\n    77\t                  AND subject = $3\n    78\t                  AND operation = $4\n    79\t                  AND target = $5\n    80\t                  AND args_sha256 = $6\n    81\t                RETURNING approval_id, approved_by, approved_at, expires_at\"\"\",\n    82\t            approval_id, ctx.agent_instance_id, ctx.subject, operation, target, args_digest(args),\n    83\t        )\n    84\t        if row is None:\n    85\t            raise ApprovalInvalid(\"approval does not match this action, was used, or expired\")\n    86\t        return dict(row)\n    87\t\n    88\t    async def pending(self, approval_id: str) -> dict[str, Any] | None:\n    89\t        row = await self._pool.fetchrow(\n    90\t            \"SELECT run_id, operation, target, args, tool_use_id FROM approvals.grants WHERE approval_id = $1\",\n    91\t            approval_id,\n    92\t        )\n    93\t        if row is None:\n    94\t            return None\n    95\t        out = dict(row)\n    96\t        out[\"args\"] = json.loads(out[\"args\"])\n    97\t        return out\n            state.messages.append({\"role\": \"user\", \"content\": results})\n\n    async def _handle_tool(self, ctx: RunContext, state: RunState, parent: str, tool_use_id: str,\n                           name: str, args: Any) -> dict[str, Any] | None:\n        step_id = str(uuid.uuid4())\n        await self.audit.record(ctx, \"proposed_action\", step_id=step_id, parent_step_id=parent, tool=name, args=args)\n        spec = self.registry.get(name)\n        if spec is None:\n            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=name, decision=\"deny\", reason=\"tool not in allowlist\")\n            return _tool_result(tool_use_id, \"This tool is not available.\", error=True)\n        target = spec.target(ctx.subject)\n        state.budget.check_tool_call()\n        try:\n            args = validate_tool_args(spec, args)\n        except ValidationRejected as exc:\n            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target,\n                                    decision=\"deny\", reason=exc.reason, args=args)\n            return _tool_result(tool_use_id, f\"Invalid arguments: {exc.reason}\", error=True)\n        if spec.approval == \"subject\":\n            approval_id, text = await self.approvals.request(ctx, spec.qualified, target, args, tool_use_id)\n            await self.audit.record(ctx, \"approval_requested\", step_id=step_id, tool=spec.qualified, target=target,\n                                    decision=\"hold\", approval_id=approval_id, args=args)\n            state.status = \"awaiting_approval\"\n            state.pending_approval = {\"approval_id\": approval_id, \"description\": text}\n            return None\n        await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target, decision=\"allow\")\n        return await self._execute(ctx, state, step_id, tool_use_id, spec, target, args, approval_id=None)\n\n    async def resume_with_approval(self, ctx: RunContext, state: RunState, approval_id: str) -> RunState:\n        with tracer.start_as_current_span(\"agent.resume\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n            pending = awa