ce: hr-agent\n     6\t  labels: {app.kubernetes.io/part-of: hr-helpdesk}\n     7\tspec:\n     8\t  schedule: \"17 2 * * *\"\n     9\t  concurrencyPolicy: Forbid\n    10\t  jobTemplate:\n    11\t    spec:\n    12\t      backoffLimit: 2\n    13\t      template:\n    14\t        metadata:\n    15\t          labels: {app: audit-maintenance}\n    16\t        spec:\n    17\t          serviceAccountName: hr-audit-maint\n    18\t          automountServiceAccountToken: false\n    19\t          restartPolicy: OnFailure\n    20\t          securityContext:\n    21\t            runAsNonRoot: true\n    22\t            runAsUser: 70\n    23\t            seccompProfile: {type: RuntimeDefault}\n    24\t          containers:\n    25\t            - name: maintain\n    26\t              image: registry.acme.example/platform/psql@sha256:9b2e61c04d7f3a85e1c6b09d2f4a7e3c58d1b6a0f9e2c47d3b8a15e6f0c9d2a4\n    27\t              env:\n    28\t                - name: PGSERVICE\n    29\t                  value: hr_audit_maint\n    30\t                - name: PERIOD\n    31\t                  value: \"1 week\"\n    32\t                - name: AHEAD\n    33\t                  value: \"4\"\n    34\t                - name: KEEP_PARTITIONS\n    35\t                  value: \"6\"\n    36\t              command: [\"psql\", \"-v\", \"ON_ERROR_STOP=1\", \"-c\"]\n    37\t              args:\n    38\t                - >-\n    39\t                  SELECT audit.maintain_partitions('audit.events', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    40\t                  SELECT audit.maintain_partitions('audit.gateway_decisions', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    41\t              securityContext:\n    42\t                allowPrivilegeEscalation: false\n    43\t                readOnlyRootFilesystem: true\n    44\t                capabilities: {drop: [ALL]}\n    45\t              volumeMounts:\n    46\t                - {name: pgservice, mountPath: /etc/postgresql-common, readOnly: true}\n    47\t          volumes:\n    48\t            - name: pgservice\n    49\t              secret: {secretName: hr-audit-maint-pgservice}\n=== config/agent.yaml\n     1\tagent:\n     2\t  name: hr-helpdesk\n     3\t  accountable_party: \"VP People Operations <people-ops-lead@acme.example>\"\n     4\t  operational_owner: \"people-platform (pager: people-platform-oncall)\"\n     5\t  tenant: acme\n     6\t  workload_identity: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n     7\t\n     8\tmodel:\n     9\t  provider: anthropic\n    10\t  id: claude-sonnet-4-5-20250929\n    11\t  pinning: snapshot          # dated snapshot ID per provider model docs, checked 2026-09-15\n    12\t  adapter: none\n    13\t  max_output_tokens: 1024\n    14\t  temperature: 0.2\n    15\t\n    16\tbudgets:\n    17\t  run:\n    18\t    max_steps: 12\n    19\t    max_wall_seconds: 90\n    20\t    max_total_tokens: 60000\n    21\t    max_cost_usd: 0.40\n    22\t    max_tool_calls_per_minute: 20\n    23\t    max_subagents: 0\n    24\t  quotas:\n    25\t    - scope: user\n    26\t      window_seconds: 86400\n    27\t      max_runs: 150\n    28\t      max_tokens: 400000\n    29\t      max_cost_usd: 3.00\n    30\t    - scope: tenant\n    31\t      window_seconds: 3600\n    32\t      max_runs: 20000\n    33\t      max_tokens: 15000000\n    34\t      max_cost_usd: 250.00\n    35\t    - scope: fleet\n    36\t      window_seconds: 3600\n    37\t      max_runs: 25000\n    38\t      max_tokens: 20000000\n    39\t      max_cost_usd: 300.00\n    40\t\n    41\tpricing:\n    42\t  input_per_mtok: 3.00\n    43\t  output_per_mtok: 15.00\n    44\t  cache_read_per_mtok: 0.30\n    45\t\n    46\tapprovals:\n    47\t  ttl_seconds: 600\n    48\t\n    49\tstop:\n    50\t  poll_seconds: 2\n    51\t  max_stop_seconds: 10\n    52\t\n    53\tretrieval:\n    54\t  top_k: 5\n    55\t  cache_ttl_seconds: 900\n    56\t  max_chunk_chars: 4000\n    57\t\n    58\tlimits:\n    59\t  max_tool_output_bytes: 16384\n    60\t  max_user_message_chars: 4000\n    61\t\n    62\toutput:\n    63\t  allowed_link_hosts: [hr.acme.example, handbook.acme.example]\n=== .mcp.json\n     1\t{\n     2\t  \"mcpServers\": {\n     3\t    \"hr-tool-gateway\": {\n     4\t      \"type\": \"http\",\n     5\t      \"url\": \"https://hr-tool-gateway.hr-agent.svc.cluster.local:8443/mcp\",\n     6\t      \"headers\": {\n     7\t        \"Authorization\": \"Bearer ${HR_GATEWAY_TOKEN}\"\n     8\t      }\n     9\t    }\n    10\t  }\n    11\t}\n=== src/type_id.py\n     1\t\"\"\"agent-type-id: SHA-256 over every identity-defining input.\n     2\t\n     3\tInputs (all, no exclusions):\n     4\t  - every file under src/, prompts/ and config/, plus requirements.txt and Dockerfile\n     5\t  - the image digest the pod runs\n     6\t  - the model record (provider, requested ID, snapshot/alias label, adapter)\n     7\tCanonical form: JSON with sorted keys, no whitespace, file paths relative to the repo root\n     8\tin POSIX form, each file hashed as raw bytes. The same command runs in CI (to stamp the\n     9\trelease manifest) and at pod start (to refuse running under an identity it does not match).\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport hashlib\n    14\timport json\n    15\timport pathlib\n    16\timport sys\n    17\tfrom typing import Any\n    18\t\n    19\tROOT = pathlib.Path(__file__).resolve().parent.parent\n    20\tINPUT_DIRS = (\"src\", \"prompts\", \"config\")\n    21\tINPUT_FILES = (\"requirements.txt\", \"Dockerfile\")\n    22\tHASH_SCHEME = \"acme-agent-type-id/v1\"\n    23\t\n    24\t\n    25\tdef _file_hashes() -> dict[str, str]:\n    26\t    out: dict[str, str] = {}\n    27\t    for d in INPUT_DIRS:\n    28\t        for p in sorted((ROOT / d).rglob(\"*\")):\n    29\t            if p.is_file():\n    30\t                out[p.relative_to(ROOT).as_posix()] = hashlib.sha256(p.read_bytes()).hexdigest()\n    31\t    for f in INPUT_FILES:\n    32\t        out[f] = hashlib.sha256((ROOT / f).read_bytes()).hexdigest()\n    33\t    return out\n    34\t\n    35\t\n    36\tdef compute(image_digest: str, model: dict[str, Any]) -> tuple[str, dict[str, Any]]:\n    37\t    if not image_digest.startswith(\"sha256:\") or len(image_digest) != 71:\n    38\t        raise ValueError(\"image digest must be sha256:<64 hex>\")\n    39\t    for k in (\"provider\", \"id\", \"pinning\", \"adapter\"):\n    40\t        if k not in model:\n    41\t            raise ValueError(f\"model record missing {k}\")\n    42\t    manifest = {\"scheme\": HASH_SCHEME, \"image_digest\": image_digest, \"model\": model, \"files\": _file_hashes()}\n    43\t    canonical = json.dumps(manifest, sort_keys=True, separators=(\",\", \":\")).encode()\n    44\t    return \"sha256:\" + hashlib.sha256(canonical).hexdigest(), manifest\n    45\t\n    46\t\n    47\tdef model_record(cfg: dict[str, Any]) -> dict[str, Any]:\n    48\t    m = cfg[\"model\"]\n    49\t    return {\"provider\": m[\"provider\"], \"id\": m[\"id\"], \"pinning\": m[\"pinning\"], \"adapter\": m[\"adapter\"]}\n    50\t\n    51\t\n    52\tdef verify_or_exit(expected: str, image_digest: str, model: dict[str, Any]) -> str:\n    53\t    actual, _ = compute(image_digest, model)\n    54\t    if actual != expected:\n    55\t        print(f\"agent-type-id mismatch: expected {expected}, computed {actual}\", file=sys.stderr)\n    56\t        sys.exit(78)\n    57\t    return actual\n    58\t\n    59\t\n    60\tif __name__ == \"__main__\":\n    61\t    import yaml\n    62\t\n    63\t    cfg = yaml.safe_load((ROOT / \"config\" / \"agent.yaml\").read_text())\n    64\t    tid, man = compute(sys.argv[1], model_record(cfg))\n    65\t    json.dump({\"agent_type_id\": tid, \"inputs\": man}, sys.stdout, indent=2, sort_keys=True)","is_error":false}]},"parent_tool_use_id":null,"session_id":"a00fa697-4ff4-47e0-b05d-0840929b6822","uuid":"9af36ecf-2907-4212-9c3b-cff18b0291f2","timestamp":"2026-11-21T12:07:17.997Z","tool_use_result":{"stdout":"Tra