{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012bP2mSQVpbfxvLTBi3mxuS","type":"tool_result","content":"1+43\tclass Agent:\n2+43\t    def __init__(self, cfg: dict[str, Any], registry: ToolRegistry, llm: AsyncAnthropic, gateway: GatewayClient,\n3+43\t                 index: PolicyIndex, approvals: ApprovalStore, quotas: QuotaStore, audit: AuditWriter, stop: StopControl):\n4+43\t        self.cfg, self.registry, self.llm, self.gateway = cfg, registry, llm, gateway\n5+43\t        self.index, self.approvals, self.quotas, self.audit, self.stop = index, approvals, quotas, audit, stop\n6+43\t\n7+43\t    def new_state(self, user_text: str, subject_token: str) -> RunState:\n8+43\t        budget = RunBudget(self.cfg[\"budgets\"][\"run\"], self.cfg[\"pricing\"])\n9+43\t        return RunState(messages=[{\"role\": \"user\", \"content\": user_text}], budget=budget, subject_token=subject_token)\n10+43\t\n11+43\t    async def run(self, ctx: RunContext, state: RunState) -> RunState:\n12+43\t        with tracer.start_as_current_span(\"agent.run\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n13+43\t            try:\n14+43\t                await self._loop(ctx, state)\n15+43\t            except BudgetExceeded as exc:\n16+43\t                await self.audit.record(ctx, \"budget_stop\", decision=\"stop\", reason=exc.limit, parent_step_id=state.last_step)\n17+43\t                state.status, state.reply = \"stopped\", \"I've reached the limit for this conversation. An HR advisor can help further.\"\n18+43\t            return state\n19+43\t\n20+43\t    async def _loop(self, ctx: RunContext, state: RunState) -> None:\n21+43\t        model = self.cfg[\"model\"]\n22+43\t        while True:\n23+43\t            await self.stop.raise_if_stopped(ctx)\n24+43\t            state.budget.check_step()\n25+43\t            step_id = str(uuid.uuid4())\n26+43\t            with tracer.start_as_current_span(\"gen_ai.chat\", attributes={\"gen_ai.request.model\": model[\"id\"]}):\n27+43\t                resp = await self.llm.messages.create(\n28+43\t                    model=model[\"id\"], system=SYSTEM_PROMPT, max_tokens=model[\"max_output_tokens\"],\n29+43\t                    temperature=model[\"temperature\"], tools=self.registry.model_schemas(), messages=state.messages,\n30+43\t                    timeout=state.budget.remaining_seconds(),\n31+43\t                )\n32+43\t                tokens, cost = state.budget.record_usage(resp.usage)\n33+43\t                ctx_tokens = resp.usage.input_tokens + (resp.usage.cache_read_input_tokens or 0) + (resp.usage.cache_creation_input_tokens or 0)\n34+43\t                await self.audit.record(\n35+43\t                    ctx, \"model_call\", step_id=step_id, parent_step_id=state.last_step,\n36+43\t                    context_tokens=ctx_tokens, context_tokens_method=\"measured:provider_usage_input+cache_read+cache_write\",\n37+43\t                    model_requested=model[\"id\"], model_served=resp.model, result={\"stop_reason\": resp.stop_reason},\n38+43\t                )\n39+43\t                await self.quotas.record_usage(ctx, tokens, cost)\n40+43\t            state.last_step = step_id\n41+43\t            state.messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n42+43\t            if resp.stop_reason != \"tool_use\":\n43+43\t                state.status = \"done\"\n44+43\t                state.reply = \"\".join(b.text for b in resp.content if b.type == \"text\")\n45+43\t                return\n46+43\t            results = []\n47+43\t            for block in (b for b in resp.content if b.type == \"tool_use\"):\n48+43\t                result = await self._handle_tool(ctx, state, step_id, block.id, block.name, block.input)\n49+43\t                if result is None:  # paused for employee approval\n50+43\t                    return\n51+43\t                results.append(result)\n52+43\t            state.messages.append({\"role\": \"user\", \"content\": results})\n53+43\t\n54+43\t    async def _handle_tool(self, ctx: RunContext, state: RunState, parent: str, tool_use_id: str,\n55+43\t                           name: str, args: Any) -> dict[str, Any] | None:\n56+43\t        step_id = str(uuid.uuid4())\n57+43\t        await self.audit.record(ctx, \"proposed_action\", step_id=step_id, parent_step_id=parent, tool=name, args=args)\n58+43\t        spec = self.registry.get(name)\n59+43\t        if spec is None:\n60+43\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=name, decision=\"deny\", reason=\"tool not in allowlist\")\n61+43\t            return _tool_result(tool_use_id, \"This tool is not available.\", error=True)\n62+43\t        target = spec.target(ctx.subject)\n63+43\t        state.budget.check_tool_call()\n64+43\t        try:\n65+43\t            args = validate_tool_args(spec, args)\n66+43\t        except ValidationRejected as exc:\n67+43\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target,\n68+43\t                                    decision=\"deny\", reason=exc.reason, args=args)\n69+43\t            return _tool_result(tool_use_id, f\"Invalid arguments: {exc.reason}\", error=True)\n70+43\t        if spec.approval == \"subject\":\n71+43\t            approval_id, text = await self.approvals.request(ctx, spec.qualified, target, args, tool_use_id)\n72+43\t            await self.audit.record(ctx, \"approval_requested\", step_id=step_id, tool=spec.qualified, target=target,\n73+43\t                                    decision=\"hold\", approval_id=approval_id, args=args)\n74+43\t            state.status = \"awaiting_approval\"\n75+43\t            state.pending_approval = {\"approval_id\": approval_id, \"description\": text}\n76+43\t            return None\n77+43\t        await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target, decision=\"allow\")\n78+43\t        return await self._execute(ctx, state, step_id, tool_use_id, spec, target, args, approval_id=None)\n79+43\t\n80+43\t    async def resume_with_approval(self, ctx: RunContext, state: RunState, approval_id: str) -> RunState:\n81+43\t        with tracer.start_as_current_span(\"agent.resume\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n82+43\t            pending = await self.approvals.pending(approval_id)\n83+43\t            if pending is None or pending[\"run_id\"] != ctx.run_id:\n84+43\t                raise ApprovalInvalid(\"unknown approval for this run\")\n85+43\t            spec = self.registry.by_qualified(pending[\"operation\"])\n86+43\t            step_id = str(uuid.uuid4())\n87+43\t            try:\n88+43\t                await self.stop.raise_if_stopped(ctx)\n89+43\t                args = validate_tool_args(spec, pending[\"args\"])\n90+43\t                target = spec.target(ctx.subject)\n91+43\t                await self._recheck_state(ctx, state, spec, args)\n92+43\t                grant = await self.approvals.consume(ctx, approval_id, spec.qualified, target, args)\n93+43\t            except (ApprovalInvalid, ValidationRejected, ToolDenied, ToolError) as exc:\n94+43\t                await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=pending[\"operation\"],\n95+43\t                                        decision=\"deny\", reason=str(exc), approval_id=approval_id)\n96+43\t                state.status, state.reply = \"done\", \"That action can no longer be carried out as approved.\"\n97+43\t                return state\n98+43\t            await self.audit.record(ctx, \"approval_used\", step_id=step_id, parent_step_id=state.last_step,\n99+43\t                                    tool=spec.qualified, target=target, decision=\"allow\", approval_id=approval_id,\n100+43\t                                    result={\"approved_by\": grant[\"approved_by\"], \"approved_at\": grant[\"approved_at\"].isoformat()})\n101+43\t            result = await self._execute(ctx, state, step_id, pending[\"tool_use_id\"], spec, target, args, approval_id=approval_id)\n102+43\t            state.messages.append({\"role\": \"user\", \"content\": [result]})\n103+43\t            state.status, state.pending_approval = \"running\", None\n104+43\t            return await self.run(ctx, state)\n105+43\t\n106+43\t    async def _recheck_state(self, ctx: RunContext, state: RunState, spec: ToolSpec, args: dict[str, Any]) -> None:\n107+43\t        \"\"\"Re-read the resource the action depends on, at execution time.\"\"\"\n108+43\t        if spec.qualified != \"hris/file_leave_request\" or args[\"leave_type\"] == \"unpaid\":\n109+43\t            return\n110+43\t        balance_spec = self.registry.get(\"get_leave_balance\")\n111+43\t        bal = await self.gateway.call(balance_spec, {\"leave_type\": args[\"leave_type\"]}, ctx, state.subject_token,\n112+43\t                                      operation_id=str(uuid.uuid4()))\n113+43\t        bal = validate_tool_output(balance_spec, bal, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n114+43\t        days = (date.fromisoformat(args[\"end_date\"]) - date.fromisoformat(args[\"start_date\"])).days + 1\n115+43\t        if days <= 0 or bal[\"balance_days\"] < days:\n116+43\t            raise ApprovalInvalid(\"leave balance no longer covers the request\")\n117+43\t\n118+43\t    async def _execute(self, ctx: RunContext, state: RunState, step_id: str, tool_use_id: str, spec: ToolSpec,\n119+43\t                       target: str, args: dict[str, Any], approval_id: str | None) -> dict[str, Any]:\n120+43\t        operation_id = approval_id or str(uuid.uuid4())\n121+43\t        with tracer.start_as_current_span(f\"execute_tool {spec.qualified}\", attributes={\"gen_ai.tool.name\": spec.name}):\n122+43\t            try:\n123+43\t                if spec.kind == \"local\":\n124+43\t                    raw = await self.index.search(args[\"query\"], ctx.subject)\n125+43\t                    max_chars = self.cfg[\"retrieval\"][\"max_chunk_chars\"]\n126+43\t                    clean: Any = []\n127+43\t                    for chunk in raw:\n128+43\t                        try:\n129+43\t                            clean.append(validate_chunk(chunk, max_chars))\n130+43\t                        except ValidationRejected as exc:\n131+43\t                            await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified,\n132+43\t                                                    decision=\"hold\", reason=exc.reason, result={\"chunk_id\": chunk[\"chunk_id\"]})\n133+43\t                else:\n134+43\t                    raw = await self.gateway.call(spec, args, ctx, state.subject_token, operation_id=operation_id)\n135+43\t                    clean = validate_tool_output(spec, raw, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n136+43\t            except ToolDenied as exc:\n137+43\t                await self.audit.record(ctx, \"tool_denied\", step_id=step_id, tool=spec.qualified, target=target,\n138+43\t                                        decision=\"deny\", reason=exc.reason, approval_id=approval_id, args=args)\n139+43\t                return _tool_result(tool_use_id, \"The request was refused by policy.\", error=True)\n140+43\t            except ToolError as exc:\n141+43\t                await self.audit.record(ctx, \"tool_error\", step_id=step_id, tool=spec.qualified, target=target,\n142+43\t                                        decision=\"error\", reason=f\"status {exc.status}\", approval_id=approval_id,\n143+43\t                                        args=args, result={\"detail\": exc.detail})\n144+43\t                log.warning(\"tool error\", extra={\"tool\": spec.qualified, \"detail\": redact(exc.detail)})\n145+43\t                return _tool_result(tool_use_id, f\"{spec.name} failed: {exc.detail}\", error=True)\n146+43\t            except ValidationRejected as exc:\n147+43\t                await self.audi