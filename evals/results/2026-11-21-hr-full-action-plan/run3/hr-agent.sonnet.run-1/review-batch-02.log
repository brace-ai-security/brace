spec, pending[\\\"args\\\"])\",\"args reloaded from the approvals table, not from model output after the check\")])\ncheck(\"B06.3\",\"yes\",A,\"AND used_at IS NULL\",\n \"Single UPDATE ... WHERE used_at IS NULL RETURNING marks use atomically, so replay and parallel reuse affect one row once.\",\n counter=\"Searched for separate SELECT-then-UPDATE of used_at or in-memory counters: none; only consume() writes used_at.\",\n rows=[row(\"consume statement\",\"enforced\",A,\"UPDATE approvals.grants SET used_at = now()\",\"one compare-and-set statement\"),\n       row(\"single-use guard\",\"enforced\",A,\"AND used_at IS NULL\",\"second use returns no row and raises ApprovalInvalid\"),\n       row(\"confirm decision is one-shot\",\"enforced\",A,\"approved_at IS NULL AND expires_at > now()\",\"confirm also compare-and-set\")])\ncheck(\"B06.4\",\"yes\",A,\"AND approved_by = subject\",\n \"Only the run's subject can approve (confirm requires subject = approver; consume requires approved_by = subject). At execution the balance is re-read and the gateway re-verifies token scope and stop flags.\",\n counter=\"Searched for any-user approval paths: confirm route requires JWT employee and entry subject match (main.py:143); no role-based override.\",\n rows=[row(\"approver authority at confirm\",\"enforced\",A,\"WHERE approval_id = $1 AND subject = $2\",\"approver must equal the grant subject\"),\n       row(\"approver authority at use\",\"enforced\",A,\"AND approved_by = subject\",\"re-checked when consumed\"),\n       row(\"resource state recheck: file_leave_request\",\"enforced\",\"src/agent.py\",\"raise ApprovalInvalid(\\\"leave balance no longer covers the request\\\")\",\"balance re-read before consume for non-unpaid leave\"),\n       row(\"resource state recheck: create_ticket\",\"not_applicable\",\"src/agent.py\",\"if spec.qualified != \\\"hris/file_leave_request\\\" or args[\\\"leave_type\\\"] == \\\"unpaid\\\":\",\"ticket creation depends on no mutable resource state; early return is by design\"),\n       row(\"permission recheck at execution\",\"enforced\",\"src/gateway.py\",\"if spec.scope not in claims[\\\"scope\\\"].split():\",\"gateway re-verifies token scope per call\")])\ncheck(\"B06.5\",\"yes\",\"src/main.py\",\"except Exception as exc:\",\n \"Approval store is Postgres. Errors in request/confirm/consume are not swallowed: ApprovalInvalid is a denial, other exceptions re-raise (main.py:157-159) before any execution.\",\n counter=\"Searched for except blocks around approvals.* that continue to _execute: resume_with_approval catches only ApprovalInvalid, ValidationRejected, ToolDenied, ToolError and returns a denial; none proceeds.\",\n rows=[row(\"request() failure\",\"enforced\",\"src/agent.py\",\"approval_id, text = await self.approvals.request(\",\"no try/except; exception aborts the tool call\"),\n       row(\"confirm() failure\",\"enforced\",\"src/main.py\",\"await approvals.confirm(approval_id, employee_id)\",\"ApprovalInvalid gives 409; other errors re-raise\"),\n       row(\"consume() failure\",\"enforced\",\"src/agent.py\",\"grant = await self.approvals.consume(\",\"ApprovalInvalid is denied at agent.py:136; DB errors propagate and execution is not reached\"),\n       row(\"catch-all in confirm\",\"enforced\",\"src/main.py\",\"except Exception as exc:\",\"records run_error and raises\")])\nE\nPY=/private/tmp/claude-501/-Users-brenn-dev-brace/255658ca-f19b-460c-8892-2a477de97733/scratchpad/venv/bin/python; $PY work/b06.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":974,"cache_read_input_tokens":87620,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":974},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"59246f9b-6f28-4e6c-8986