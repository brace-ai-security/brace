 row(\"agent->postgres\",\"enforced\",N,\"app: hr-postgres}\",\"named database peer on 5432\"),\n       row(\"agent->otel\",\"enforced\",N,\"app: otel-collector}\",\"named telemetry peer on 4317\"),\n       row(\"agent->helpdesk-mcp direct\",\"unclear\",N,\"app: helpdesk-mcp}\",\"listed system, but reachable directly around the gateway; see B09.2\"),\n       row(\"gateway egress\",\"enforced\",N,\"app: hris-mcp}\",\"gateway reaches only listed MCP servers sts and postgres\")])\ncheck(\"B08.2\",\"yes\",N,\"- cidr: fd00:ec2::254/128\",\"No broad egress. Cloud metadata endpoints are explicitly denied; no hostNetwork or docker.sock; mounts are tmp, sts-token and svid only.\",\n counter=\"Searched k8s/deployment.yaml for hostNetwork, hostPath, docker.sock, privileged: none; automountServiceAccountToken false. Secrets mounted: DB url and Anthropic key (agent), gateway DB url.\",\n rows=[row(\"metadata egress deny\",\"enforced\",N,\"- toCIDR: [169.254.169.254/32, 169.254.170.2/32, 100.100.100.200/32]\",\"metadata addresses explicitly denied for agent\"),\n       row(\"IPv6 metadata deny\",\"enforced\",N,\"- cidr: fd00:ec2::254/128\",\"IPv6 metadata address explicitly denied\"),\n       row(\"host network and sockets\",\"enforced\",\"k8s/deployment.yaml\",\"privileged: false\",\"no hostNetwork, hostPath or docker.sock in either pod\"),\n       row(\"mounted volumes\",\"enforced\",\"k8s/deployment.yaml\",\"- {name: svid, mountPath: /etc/svid, readOnly: true}\",\"only read-only identity and token mounts\"),\n       row(\"service account token\",\"enforced\",\"k8s/deployment.yaml\",\"automountServiceAccountToken: false\",\"no Kubernetes API credential in pod\")])\ncheck(\"B08.3\",\"yes\",N,\"kind: CiliumNetworkPolicy\",\"Isolation is defined in Cilium and Kubernetes network policy plus a namespace; app code holds no URL allowlist the model could steer.\",\n counter=\"Searched src for host or URL allowlists driving isolation: only output link host filtering (agent.yaml:63), which is output sanitising, not isolation.\",\n rows=[row(\"network isolation location\",\"enforced\",N,\"kind: CiliumNetworkPolicy\",\"enforced by the cluster network layer\"),\n       row(\"namespace separation\",\"enforced\",\"k8s/admission.yaml\",\"namespace: hr-agent\",\"agent lives in its own namespace\") if False else row(\"default deny infra rule\",\"enforced\",N,\"name: default-deny-all\",\"infrastructure level default deny policy\")])\nE\ncat > work/b09.py <<'E'\nimport sys; sys.path.insert(0,\"work\")\nfrom drive import *\nN=\"k8s/networkpolicy.yaml\"\ncheck(\"B09.1\",\"yes\",N,\"- toFQDNs:\",\"Egress is default-deny and the agent allowlist names api.anthropic.com and sso.acme.example by FQDN plus in-cluster peers.\",\n counter=\"Searched for 0.0.0.0/0 and broad CIDR allows in egress: none.\",\n rows=[row(\"default deny egress\",\"enforced\",N,\"policyTypes: [Ingress, Egress]\",\"egress denied unless allowed below\"),\n       row(\"external FQDN allowlist\",\"enforced\",N,\"- matchName: api.anthropic.com\",\"only the model API and SSO leave the cluster\"),\n       row(\"gateway egress allowlist\",\"enforced\",N,\"app: hris-mcp}\",\"gateway reaches only named internal servers\")])\ncheck(\"B09.2\",\"no\",N,\"app: helpdesk-mcp}\",\"The agent pod may connect straight to helpdesk-mcp on 8443, and gateway_client falls back to that route when the gateway returns 503 or cannot connect, skipping gateway authz, stop flags, rate limits and schema checks.\")\ncheck(\"B09.3\",\"unknown\",N,\"- toCIDR: [169.254.169.254/32, 169.254.170.2/32, 100.100.100.200/32]\",\"Metadata addresses are denied, and Cilium FQDN rules match resolved IPs. Loopback is not listed and the PyJWKClient fetches use urllib, which follows redirects; httpx clients leave redirects at the default. Per-hop redirect checks are not in this repo, so unknown.\")\ncheck(\"B09.4\",\"unknown\",N,\"- matchName: api.anthropic.com\",\"api.anthropic.com is allowed by name only; limiting by account or tenant is done by the API key, outside this repo.\")\ncheck(\"B09.5\",\"unknown\",N,\"name: hr-helpdesk-agent-egress\",\"No policy-deny logging or alert route to a named operator exists in this repo; Hubble or Cilium audit and alerting would be platform config outside it.\")\nE\ncat > work/b10.py <<'E'\nimport sys; sys.path.insert(0,\"work\")\nfrom drive import *\nK=\"k8s/admission.yaml\"; D=\"k8s/deployment.yaml\"\ncheck(\"B10.1\",\"yes\",D,\"image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\",\"Both Deployments use @${IMAGE_DIGEST}, stamped by CI from the build digest; Dockerfile base images are digest-pinned.\",\n counter=\"Searched all manifests for image: fields and for tag-only images or digest defaults: only these two; no default tag. Kyverno rule only-approved-registry also rejects non-digest images.\",\n rows=[row(\"agent image\",\"enforced\",D,\"image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\",\"digest reference, no tag fallback\"),\n       row(\"gateway image\",\"enforced\",D,\"image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\",\"same image by digest for the gateway\"),\n       row(\"build base image\",\"enforced\",\"Dockerfile\",\"FROM python:3.12.7-slim-bookworm@sha256:\",\"base image pinned by digest\"),\n       row(\"runtime base image\",\"enforced\",\"Dockerfile\",\"FROM gcr.io/distroless/python3-debian12:nonroot@sha256:\",\"runtime base pinned by digest\")])\ncheck(\"B10.2\",\"yes\",K,\"issuer: \\\"https://token.actions.githubusercontent.com\\\"\",\"verifyImages uses keyless identity with an exact workflow subject and the GitHub Actions issuer; no regex or wildcard identity.\",\n counter=\"Searched admission.yaml for subjectRegExp, issuerRegExp, .* and * in identities: none; wildcards appear only in imageReferences.\",\n rows=[row(\"agent image signature subject\",\"enforced\",K,\"subject: \\\"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\\\"\",\"exact pinned workflow and ref\"),\n       row(\"agent image issuer\",\"enforced\",K,\"issuer: \\\"https://token.actions.githubusercontent.com\\\"\",\"exact pinned issuer\"),\n       row(\"platform image subject\",\"enforced\",K,\"subject: \\\"https://github.com/acme/platform-images/.github/workflows/build.yml@refs/heads/main\\\"\",\"exact pinned platform workflow\")])\ncheck(\"B10.3\",\"no\",K,\"- imageReferences: [\\\"registry.acme.example/platform/*\\\"]\".replace(\"- \",\"\"),\"The people/hr-helpdesk-agent rule compares builder id, build type, repository and ref. The platform/* rule has no attestations block, so such images are admitted to hr-agent with no provenance check.\")\ncheck(\"B10.4\",\"no\",K,\"- image: \\\"registry.acme.example/*@sha256:*\\\"\",\"Mode is Enforce with failurePolicy Fail for hr-agent, but no rule denies images that match no verifyImages entry: any registry.acme.example/<other>@sha256:... image passes the pattern rule and matches neither verifyImages reference, so it is admitted unsigned.\")\ncheck(\"B10.5\",\"unknown\",\".github/workflows/release.yml\",\"cosign-release: \\\"v2.6.2\\\"\",\"CI pins cosign v2.6.2 (not below 2.6.2), but admission verification is done by Kyverno whose version and embedded cosign are not pinned in this repo.\")\nE\nPY=/private/tmp/claude-501/-Users-brenn-dev-brace/255658ca-f19b-460c-8892-2a477de97733/scratchpad/venv/bin/python; for b in 07 08 09 10; do $PY work/b$b.py 2>&1 | grep -E \"NOT FOUND|Record|RC|rror|Traceback\"; done","is_backgrounded":false,"task_type":"local_bash","uuid":"6eb0f80c-1e16-43ee-9145-604561047789","session_id":"59246f9b-6f28-4e6c-8986-ba3133bba698"}
