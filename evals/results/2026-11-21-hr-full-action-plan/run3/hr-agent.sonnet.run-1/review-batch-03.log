{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X6SbfyWJkjs4kV5BQDm2ej","type":"tool_result","content":"     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport logging\n     6\timport os\n     7\timport uuid\n     8\t\n     9\timport asyncpg\n    10\timport httpx\n    11\timport jwt\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n    15\tfrom opentelemetry.sdk.resources import Resource\n    16\tfrom opentelemetry.sdk.trace import TracerProvider\n    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n    18\tfrom starlette.applications import Starlette\n    19\tfrom starlette.requests import Request\n    20\tfrom starlette.responses import JSONResponse\n    21\tfrom starlette.routing import Route\n    22\t\n    23\tfrom . import type_id\n    24\tfrom .agent import Agent, RunState\n    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n    27\tfrom .budgets import BudgetExceeded, QuotaStore\n    28\tfrom .credentials import CredentialBroker\n    29\tfrom .gateway_client import GatewayClient\n    30\tfrom .killswitch import Stopped, StopControl\n    31\tfrom .redact import RedactingFilter\n    32\tfrom .retrieval import PolicyIndex\n    33\tfrom .tools import ToolRegistry, load_yaml\n    34\tfrom .validation import sanitize_reply\n    35\t\n    36\tSSO_ISSUER = \"https://sso.acme.example\"\n    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    39\t\n    40\tlogging.basicConfig(level=logging.INFO)\n    41\tfor h in logging.getLogger().handlers:\n    42\t    h.addFilter(RedactingFilter())\n    43\tlog = logging.getLogger(\"hr_agent\")\n    44\t\n    45\tCFG = load_yaml(\"agent.yaml\")\n    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n    47\tPOD_ID = os.environ[\"POD_UID\"]\n    48\t\n    49\tprovider = TracerProvider(resource=Resource.create({\n    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n    51\t}))\n    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n    53\ttrace.set_tracer_provider(provider)\n    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n    55\t\n    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n    57\tagent: Agent\n    58\taudit: AuditWriter\n    59\tapprovals: ApprovalStore\n    60\tstop: StopControl\n    61\t\n    62\t\n    63\tdef _employee(request: Request) -> tuple[str, str]:\n    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n    65\t    auth = request.headers.get(\"authorization\", \"\")\n    66\t    if not auth.startswith(\"Bearer \"):\n    67\t        raise PermissionError(\"missing token\")\n    68\t    token = auth[7:]\n    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n    72\t        raise PermissionError(\"wrong organisation\")\n    73\t    return claims[\"employee_id\"], token\n    74\t\n    75\t\n    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n    77\t    a = CFG[\"agent\"]\n    78\t    return RunContext(\n    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n    81\t        agent_principal=a[\"workload_identity\"],\n    82\t    )\n    83\t\n    84\t\n    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n    86\t    task = asyncio.ensure_future(coro)\n    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n    88\t    try:\n    89\t        return await task\n    90\t    except asyncio.CancelledError:\n    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n    92\t        return None\n    93\t    except Stopped as exc:\n    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n    95\t        return None\n    96\t    finally:\n    97\t        watcher.cancel()\n    98\t\n    99\t\n   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n   101\t    if state is None:\n   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n   105\t    if state.pending_approval:\n   106\t        body[\"approval\"] = state.pending_approval\n   107\t    return JSONResponse(body)\n   108\t\n   109\t\n   110\tasync def chat(request: Request) -> JSONResponse:\n   111\t    try:\n   112\t        employee_id, token = _employee(request)\n   113\t    except (jwt.PyJWTError, PermissionError):\n   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n   116\t    run_id = str(uuid.uuid4())\n   117\t    ctx = _context(run_id, employee_id)\n   118\t    with tracer.start_as_current_span(\"chat\"):\n   119\t        try:\n   120\t            await agent.quotas.reserve_run(ctx)\n   121\t            state = agent.new_state(text, token)\n   122\t            _runs[run_id] = (ctx, state)\n   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n   124\t            state = await _drive(ctx, agent.run(ctx, state))\n   125\t        except BudgetExceeded as exc:\n   126\t            await audit.record(ctx, \"quota_denied\", decision=\"deny\", reason=exc.limit)\n   127\t            return JSONResponse({\"error\": \"quota_exceeded\"}, status_code=429)\n   128\t        except AuditUnavailable:\n   129\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   130\t        except Exception as exc:\n   131\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__)\n   132\t            raise\n   133\t        return _reply(run_id, state)\n   134\t\n   135\t\n   136\tasync def confirm(request: Request) -> JSONResponse:\n   137\t    try:\n   138\t        employee_id, token = _employee(request)\n   139\t    except (jwt.PyJWTError, PermissionError):\n   140\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   141\t    run_id, approval_id = request.path_params[\"run_id\"], request.path_params[\"approval_id\"]\n   142\t    entry = _runs.get(run_id)\n   143\t    if entry is None or entry[0].subject != employee_id:\n   144\t        return JSONResponse({\"error\": \"not_found\"}, status_code=404)\n   145\t    ctx, state = entry\n   146\t    state.subject_token = token\n   147\t    with tracer.start_as_current_span(\"approval.confirm\"):\n   148\t        try:\n   149\t            await approvals.confirm(approval_id, employee_id)\n   150\t            await audit.record(ctx, \"approval_granted\", decision=\"allow\", approval_id=approval_id)\n   151\t            state = await _drive(ctx, agent.resume_with_approval(ctx, state, approval_id))\n   152\t        except ApprovalInvalid as exc:\n   153\t            await audit.record(ctx, \"approval_rejected\", decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   154\t            return JSONResponse({\"error\": \"approval_invalid\"}, status_code=409)\n   155\t        except AuditUnavailable:\n   156\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   157\t        except Exception as exc:\n   158\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__, approval_id=approval_id)\n   159\t            raise\n   160\t        return _reply(run_id, state)\n   161\t\n   162\t\n   163\tasync def startup() -> None:\n   164\t    global agent, audit, approvals, stop\n   165\t    pool = await asyncpg.create_pool(os.environ[\"DATABASE_URL\"], min_size=2, max_size=20)\n   166\t    registry = ToolRegistry.from_config()\n   167\t    mtls = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\", cert=(\"/etc/svid/svid.pem\", \"/etc/svid/svid_key.pem\"))\n   168\t    audit = AuditWriter(pool, registry.policy_version)\n   169\t    approvals = ApprovalStore(pool, CFG[\"approvals\"][\"ttl_seconds\"])\n   170\t    stop = StopControl(pool, CFG[\"stop\"][\"poll_seconds\"])\n   171\t    agent = Agent(\n   172\t        CFG, registry, AsyncAnthropic(max_retries=1), GatewayClient(mtls, CredentialBroker(mtls)),\n   173\t        PolicyIndex(pool, CFG[\"retrieval\"][\"top_k\"], CFG[\"retrieval\"][\"cache_ttl_seconds\"]),\n   174\t        approvals, QuotaStore(pool, CFG[\"budgets\"][\"quotas\"]), audit, stop,\n   175\t    )\n   176\t\n   177\t\n   178\tapp = Starlette(\n   179\t    routes=[\n   180\t        Route(\"/v1/chat\", chat, methods=[\"POST\"]),\n   181\t        Route(\"/v1/runs/{run_id}/approvals/{approval_id}/confirm\", confirm, methods=[\"POST\"]),\n   182\t    ],\n   183\t    on_startup=[startup],\n   184\t)\n     1\t\"\"\"Handbook search over retrieval.chunks (Postgres full-text search).\n     2\t\n     3\tChunks are written only by the hr-docs-ingest job (role hr_docs_ingest). Each chunk carries\n     4\tsource, added_at, added_by, trust, an audience, an optional expiry and a quarantine flag.\n     5\tEmployee-specific documents (offer letters, individual arrangements) have audience\n     6\t'employee' and list the employees allowed to see them.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport time\n    12\tfrom typing import Any\n    13\t\n    14\timport asyncpg\n    15\t\n    16\t_SEARCH = \"\"\"\n    17\tSELECT c.chunk_id, c.source, c.trust, c.text,\n    18\t       ts_rank(c.tsv, websearch_to_tsquery('english', $1)) AS rank\n    19\t  FROM retrieval.chunks c\n    20\t WHERE c.tsv @@ websearch_to_tsquery('english', $1)\n    21\t   AND NOT c.quarantined\n    22\t   AND (c.expires_at IS NULL OR c.expires_at > now())\n    23\t   AND (c.audience = 'all' OR (c.audience = 'employee' AND $2 = ANY (c.allowed_employees)))\n    24\t ORDER BY rank DESC\n    25\t LIMIT $3\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass PolicyIndex:\n    30\t    def __init__(self, pool: asyncpg.Pool, top_k: int, cache_ttl: float):\n    31\t        self._pool = pool\n    32\t        self._top_k = top_k\n    33\t        self._ttl = cache_ttl\n    34\t        self._cache: dict[str, tuple[float, str, list[dict[str, Any]]]] = {}\n    35\t\n    36\t    async def _index_version(self) -> str:\n    37\t        # Bumped by ingest on every add, expiry, quarantine or permission change.\n    38\t        return await self._pool.fetchval(\"SELECT version FROM retrieval.index_state WHERE id = 1\")\n    39\t\n    40\t    def _key(self, query: str) -> str:\n    41\t        normalized = \" \".join(query.lower().split())\n    42\t        return hashlib.sha256(f\"{self._top_k}|{normalized}\".encode()).hexdigest()\n    43\t\n    44\t    async def search(self, query: str, employee_id: str) -> list[dict[str, Any]]:\n    45\t        version = await self._index_version()\n    46\t        key = self._key(query)\n    47\t        hit = self._cache.get(key)\n    48\t        if hit and hit[1] == version and time.monotonic() - hit[0] < self._ttl:\n    49\t            return hit[2]\n    50\t        rows = await self._pool.fetch(_SEARCH, query, employee_id, self._top_k)\n    51\t        chunks = [dict(r) for r in rows]\n    52\t        self._cache[key] = (time.monotonic(), version, chunks)\n    53\t        return chunks\n     1\tname: release\n     2\t\n     3\ton:\n     4\t  push:\n     5\t    branches: [main]\n     6\t\n     7\tpermissions:\n     8\t  contents: read\n     9\t\n    10\tjobs:\n    11\t  build:\n    12\t    runs-on: ubuntu-24.04\n    13\t    environment: production   # requires approval from @acme/people-platform-release\n    14\t    permissions:\n    15\t      contents: read\n    16\t      packages: write\n    17\t      id-token: write\n    18\t      attestations: write\n    19\t    env:\n    20\t      PYTHONDONTWRITEBYTECODE: \"1\"\n    21\t      IMAGE: registry.acme.example/people/hr-helpdesk-agent\n    22\t    steps:\n    23\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    24\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    25\t        with: {python-version: \"3.12.7\"}\n    26\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    27\t        with: {cosign-release: \"v2.6.2\"}\n    28\t      - run: pip install --require-hashes -r requirements.txt\n    29\t      - run: python -m pytest -q tests/release\n    30\t      - name: Build and push\n    31\t        id: build\n    32\t        uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    33\t        with:\n    34\t          push: true\n    35\t          tags: ${{ env.IMAGE }}:${{ github.sha }}\n    36\t          sbom: true\n    37\t          provenance: mode=max\n    38\t      - name: Sign image\n    39\t        run: cosign sign --yes \"${IMAGE}@${{ steps.build.outputs.digest }}\"\n    40\t      - uses: actions/attest-build-provenance@e8998f949152b193b063cb0ec769d69d929409be # v2.4.0\n    41\t        with:\n    42\t          subject-name: ${{ env.IMAGE }}\n    43\t          subject-digest: ${{ steps.build.outputs.digest }}\n    44\t          push-to-registry: true\n    45\t      - name: Compute agent-type-id\n    46\t        id: typeid\n    47\t        run: |\n    48\t          python -m src.type_id \"${{ steps.build.outputs.digest }}\" > type-id.json\n    49\t          echo \"id=$(jq -r .agent_type_id type-id.json)\" >> \"$GITHUB_OUTPUT\"\n    50\t      - name: Stamp release manifest\n    51\t        run: |\n    52\t          yq -i '.release.agent_type_id = \"${{ steps.typeid.outputs.id }}\" |\n    53\t                 .release.image.digest = \"${{ steps.build.outputs.digest }}\" |\n    54\t                 .release.git_sha = \"${{ github.sha }}\"' release/manifest.yaml\n    55\t      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\n    56\t        with:\n    57\t          name: release-${{ github.sha }}\n    58\t          path: [type-id.json, release/manifest.yaml]\n    59\t\n    60\t  deploy:\n    61\t    needs: build\n    62\t    runs-on: ubuntu-24.04\n    63\t    environment: production\n    64\t    permissions: {contents: read, id-token: write}\n    65\t    steps:\n    66\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    67\t      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0\n    68\t        with: {name: \"release-${{ github.sha }}\"}\n    69\t      - name: Render and apply\n    70\t        run: |\n    71\t          export IMAGE_DIGEST=$(yq -r .release.image.digest release/manifest.yaml)\n    72\t          export AGENT_TYPE_ID=$(yq -r .release.agent_type_id release/manifest.yaml)\n    73\t          export GIT_SHA=${{ github.sha }}\n    74\t          for f in k8s/*.yaml; do envsubst '$IMAGE_DIGEST $AGENT_TYPE_ID $GIT_SHA' < \"$f\"; echo '---'; done \\\n    75\t            | kubectl apply --server-side -f -\n     1\tagent:\n     2\t  name: hr-helpdesk\n     3\t  accountable_party: \"VP People Operations <people-ops-lead@acme.example>\"\n     4\t  operational_owner: \"people-platform (pager: people-platform-oncall)\"\n     5\t  tenant: acme\n     6\t  workload_identity: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n     7\t\n     8\tmodel:\n     9\t  provider: anthropic\n    10\t  id: claude-sonnet-4-5-20250929\n    11\t  pinning: snapshot          # dated snapshot ID per provider model docs, checked 2026-09-15\n    12\t  adapter: none\n    13\t  max_output_tokens: 1024\n    14\t  temperature: 0.2\n    15\t\n    16\tbudgets:\n    17\t  run:\n    18\t    max_steps: 12\n    19\t    max_wall_seconds: 90\n    20\t    max_total_tokens: 60000\n    21\t    max_cost_usd: 0.40\n    22\t    max_tool_calls_per_minute: 20\n    23\t    max_subagents: 0\n    24\t  quotas:\n    25\t    - scope: user\n    26\t      window_seconds: 86400\n    27\t      max_runs: 150\n    28\t      max_tokens: 400000\n    29\t      max_cost_usd: 3.00\n    30\t    - scope: tenant\n    31\t      window_seconds: 3600\n    32\t      max_runs: 20000\n    33\t      max_tokens: 15000000\n    34\t      max_cost_usd: 250.00\n    35\t    - scope: fleet\n    36\t      window_seconds: 3600\n    37\t      max_runs: 25000\n    38\t      max_tokens: 20000000\n    39\t      max_cost_usd: 300.00\n    40\t\n    41\tpricing:\n    42\t  input_per_mtok: 3.00\n    43\t  output_per_mtok: 15.00\n    44\t  cache_read_per_mtok: 0.30\n    45\t\n    46\tapprovals:\n    47\t  ttl_seconds: 600\n    48\t\n    49\tstop:\n    50\t  poll_seconds: 2\n    51\t  max_stop_seconds: 10\n    52\t\n    53\tretrieval:\n    54\t  top_k: 5\n    55\t  cache_ttl_seconds: 900\n    56\t  max_chunk_chars: 4000\n    57\t\n    58\tlimits:\n    59\t  max_tool_output_bytes: 16384\n    60\t  max_user_message_chars: 4000\n    61\t\n    62\toutput:\n    63\t  allowed_link_hosts: [hr.acme.example, handbook.acme.example]\n# hr-helpdesk-agent\n\nAn HR helpdesk assistant for Acme employees. It answers policy questions from the HR handbook,\nshows the signed-in employee their own leave balance, files leave requests (the manager approves\nthem in HRIS), and hands conversations to an HR advisor.\n\n## Components\n\n| Component | Code | Identity |\n|---|---|---|\n| Agent API and loop | `src/main.py`, `src/agent.py` | SA `hr-helpdesk-agent`, SPIFFE SVID |\n| Tool gateway | `src/gateway.py` | SA `hr-tool-gateway` |\n| HRIS MCP server | owned by hris-platform | `spiffe://acme.example/ns/hris/sa/hris-mcp` |\n| Helpdesk MCP server | owned by it-service-desk | `spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp` |\n| Audit, approvals, quotas, stop flags, handbook index | Postgres (`migrations/001_init.sql`) | per-component DB roles |\n\n## How a request flows\n\n1. The HR portal sends the employee's SSO token. `main.py` verifies issuer, audience, expiry and\n   organisation; the employee id and tenant come only from that token.\n2. The loop (`agent.py`) checks the stop flags and the run budget before every model call, and\n   records usage against per-user, tenant and fleet quotas.\n3. Tool calls are looked up by exact name in `config/tools.yaml`. Arguments are schema-checked.\n   `file_leave_request` and `escalate_to_human` pause the run and show the employee exactly what\n   will be sent; the approval is bound to the run instance, operation, target and argument hash,\n   expires after 10 minutes, and is consumed once.\n4. MCP calls go to the gateway with a 300-second token for that one tool scope, minted by STS\n   from the agent's workload identity and the employee's token. The gateway verifies the token\n   and its certificate binding, checks scope, stop flags, rate limits and argument schema, swaps\n   the token for one addressed to the MCP server, and validates the response schema.\n5. Tool output is size-, schema- and content-checked and redacted before the model sees it.\n   Handbook passages are filtered at query time to documents the employee may see.\n6. Every step writes an `audit.events` row with the six identity fields and trace context.\n   If the audit write fails, the run stops.\n\nEscalations are delivered even during gateway maintenance windows.\n\n## Stopping the agent\n\nOperators with the `hr_agent_operator` DB role insert into `control.stop_flags`:\n\n```sql\nINSERT INTO control.stop_flags (scope, value, reason) VALUES ('fleet', NULL, 'incident 2291');\n-- or scope 'agent_type' / 'agent_instance' / 'subject' / 'agent_principal'\n```\n\nRunning agents see the flag within 2 seconds and cancel in-flight work; the gateway refuses\ncalls immediately. Target stop time: 10 seconds. The agent's DB role can only read this table.\nLast drill: see `docs/drills/` in the ops repo.\n\n## Audit retention\n\nAudit records are kept for six months (Acme records policy; employment-related AI use in the EU).\nPartitions are created and dropped nightly by `k8s/audit-maintenance.yaml`. Access is limited to\n`hr_audit_reader`.\n\n## Releases\n\nMerges to `main` build, sign and attest the image, compute the agent-type-id over every file in\n`src/`, `prompts/`, `config/`, plus `requirements.txt`, `Dockerfile`, the image digest and the model","is_error":false}]},"parent_tool_use_id":null,"session_id":"db59a6d5-eede-4f12-ba96-e4e021287180","uuid":"56cd66da-3f2a-45dc-80df-cae17a069aaa","timestamp":"2026-11-21T11:53:04.350Z","tool_use_result":{"stdout":"     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport logging\n     6\timport os\n     7\timport uuid\n     8\t\n     9\timport asyncpg\n    10\timport httpx\n    11\timport jwt\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n    15\tfrom opentelemetry.sdk.resources import Resource\n    16\tfrom opentelemetry.sdk.trace import TracerProvider\n    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n    18\tfrom starlette.applications import Starlette\n    19\tfrom starlette.requests import Request\n    20\tfrom starlette.responses import JSONResponse\n    21\tfrom starlette.routing import Route\n    22\t\n    23\tfrom . import type_id\n    24\tfrom .agent import Agent, RunState\n    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n    27\tfrom .budgets import BudgetExceeded, QuotaStore\n    28\tfrom .credentials import CredentialBroker\n    29\tfrom .gateway_client import GatewayClient\n    30\tfrom .killswitch import Stopped, StopControl\n    31\tfrom .redact import RedactingFilter\n    32\tfrom .retrieval import PolicyIndex\n    33\tfrom .tools import ToolRegistry, load_yaml\n    34\tfrom .validation import sanitize_reply\n    35\t\n    36\tSSO_ISSUER = \"https://sso.acme.example\"\n    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    39\t\n    40\tlogging.basicConfig(level=logging.INFO)\n    41\tfor h in logging.getLogger().handlers:\n    42\t    h.addFilter(RedactingFilter())\n    43\tlog = logging.getLogger(\"hr_agent\")\n    44\t\n    45\tCFG = load_yaml(\"agent.yaml\")\n    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n    47\tPOD_ID = os.environ[\"POD_UID\"]\n    48\t\n    49\tprovider = TracerProvider(resource=Resource.create({\n    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n    51\t}))\n    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n    53\ttrace.set_tracer_provider(provider)\n    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n    55\t\n    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n    57\tagent: Agent\n    58\taudit: AuditWriter\n    59\tapprovals: ApprovalStore\n    60\tstop: StopControl\n    61\t\n    62\t\n    63\tdef _employee(request: Request) -> tuple[str, str]:\n    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n    65\t    auth = request.headers.get(\"authorization\", \"\")\n    66\t    if not auth.startswith(\"Bearer \"):\n    67\t        raise PermissionError(\"missing token\")\n    68\t    token = auth[7:]\n    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n    72\t        raise PermissionError(\"wrong organisation\")\n    73\t    return claims[\"employee_id\"], token\n    74\t\n    75\t\n    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n    77\t    a = CFG[\"agent\"]\n    78\t    return RunContext(\n    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n    81\t        agent_principal=a[\"workload_identity\"],\n    82\t    )\n    83\t\n    84\t\n    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n    86\t    task = asyncio.ensure_future(coro)\n    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n    88\t    try:\n    89\t        return await task\n    90\t    except asyncio.CancelledError:\n    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n    92\t        return None\n    93\t    except Stopped as exc:\n    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n    95\t        return None\n    96\t    finally:\n    97\t        watcher.cancel()\n    98\t\n    99\t\n   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n   101\t    if state is None:\n   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n   105\t    if state.pending_approval:\n   106\t        body[\"approval\"] = state.pending_approval\n   107\t    return JSONResponse(body)\n   108\t\n   109\t\n   110\tasync def chat(request: Request) -> JSONResponse:\n   111\t    try:\n   112\t        employee_id, token = _employee(request)\n   113\t    except (jwt.PyJWTError, PermissionError):\n   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n   116\t    run_id = str(uuid.uuid4())\n   117\t    ctx = _context(run_id, employee_id)\n   118\t    with tracer.start_as_current_span(\"chat\"):\n   119\t        try:\n   120\t            await agent.quotas.reserve_run(ctx)\n   121\t            state = agent.new_state(text, token)\n   122\t            _runs[run_id] = (ctx, state)\n   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n   124\t            state = await _drive(ctx, agent.run(ctx, state))\n   125\t        except BudgetExceeded as exc:\n   126\t            await audit.record(ctx, \"quota_denied\", decision=\"deny\", reason=exc.limit)\n   127\t            return JSONResponse({\"error\": \"quota_exceeded\"}, status_code=429)\n   128\t        except AuditUnavailable:\n   129\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   130\t        except Exception as exc:\n   131\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__)\n   132\t            raise\n   133\t        return _reply(run_id, state)\n   134\t\n   135\t\n   136\tasync def confirm(request: Request) -> JSONResponse:\n   137\t    try:\n   138\t        employee_id, token = _employee(request)\n   139\t    except (jwt.PyJWTError, PermissionError):\n   140\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   141\t    run_id, approval_id = request.path_params[\"run_id\"], request.path_params[\"approval_id\"]\n   142\t    entry = _runs.get(run_id)\n   143\t    if entry is None or entry[0].subject != employee_id:\n   144\t        return JSONResponse({\"error\": \"not_found\"}, status_code=404)\n   145\t    ctx, state = entry\n   146\t    state.subject_token = token\n   147\t    with tracer.start_as_current_span(\"approval.confirm\"):\n   148\t        try:\n   149\t            await approvals.confirm(approval_id, employee_id)\n   150\t            await audit.record(ctx, \"approval_granted\", decision=\"allow\", approval_id=approval_id)\n   151\t            state = await _drive(ctx, agent.resume_with_approval(ctx, state, approval_id))\n   152\t        except ApprovalInvalid as exc:\n   153\t            await audit.record(ctx, \"approval_rejected\", decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   154\t            return JSONResponse({\"error\": \"approval_invalid\"}, status_code=409)\n   155\t        except AuditUnavailable:\n   156\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   157\t        except Exception as exc:\n   158\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__, approval_id=approval_id)\n   159\t            raise\n   160\t        return _reply(run_id, state)\n   161\t\n   162\t\n   163\tasync def startup() -> None:\n   164\t    global agent, audit, approvals, stop\n   165\t    pool = await asyncpg.create_pool(os.environ[\"DATABASE_URL\"], min_size=2, max_size=20)\n   166\t    registry = ToolRegistry.from_config()\n   167\t    mtls = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\", cert=(\"/etc/svid/svid.pem\", \"/etc/svid/svid_key.pem\"))\n   168\t    audit = AuditWriter(pool, registry.policy_version)\n   169\t    approvals = ApprovalStore(pool, CFG[\"approvals\"][\"ttl_seconds\"])\n   170\t    stop = StopControl(pool, CFG[\"stop\"][\"poll_seconds\"])\n   171\t    agent = Agent(\n   172\t        CFG, registry, AsyncAnthropic(max_retries=1), GatewayClient(mtls, CredentialBroker(mtls)),\n   173\t        PolicyIndex(pool, CFG[\"retrieval\"][\"top_k\"], CFG[\"retrieval\"][\"cache_ttl_seconds\"]),\n   174\t        approvals, QuotaStore(pool, CFG[\"budgets\"][\"quotas\"]), audit, stop,\n   175\t    )\n   176\t\n   177\t\n   178\tapp = Starlette(\n   179\t    routes=[\n   180\t        Route(\"/v1/chat\", chat, methods=[\"POST\"]),\n   181\t        Route(\"/v1/runs/{run_id}/approvals/{approval_id}/confirm\", confirm, methods=[\"POST\"]),\n   182\t    ],\n   183\t    on_startup=[startup],\n   184\t)\n     1\t\"\"\"Handbook search over retrieval.chunks (Postgres full-text search).\n     2\t\n     3\tChunks are written only by the hr-docs-ingest job (role hr_docs_ingest). Each chunk carries\n     4\tsource, added_at, added_by, trust, an audience, an optional expiry and a quarantine flag.\n     5\tEmployee-specific documents (offer letters, individual arrangements) have audience\n     6\t'employee' and list the employees allowed to see them.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport time\n    12\tfrom typing import Any\n    13\t\n    14\timport asyncpg\n    15\t\n    16\t_SEARCH = \"\"\"\n    17\tSELECT c.chunk_id, c.source, c.trust, c.text,\n    18\t       ts_rank(c.tsv, websearch_to_tsquery('english', $1)) AS rank\n    19\t  FROM retrieval.chunks c\n    20\t WHERE c.tsv @@ websearch_to_tsquery('english', $1)\n    21\t   AND NOT c.quarantined\n    22\t   AND (c.expires_at IS NULL OR c.expires_at > now())\n    23\t   AND (c.audience = 'all' OR (c.audience = 'employee' AND $2 = ANY (c.allowed_employees)))\n    24\t ORDER BY rank DESC\n    25\t LIMIT $3\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass PolicyIndex:\n    30\t    def __init__(self, pool: asyncpg.Pool, top_k: int, cache_ttl: float):\n    31\t        self._pool = pool\n    32\t        self._top_k = top_k\n    33\t        self._ttl = cache_ttl\n    34\t        self._cache: dict[str, tuple[float, str, list[dict[str, Any]]]] = {}\n    35\t\n    36\t    async def _index_version(self) -> str:\n    37\t        # Bumped by ingest on every add, expiry, quarantine or permission change.\n    38\t        return await self._pool.fetchval(\"SELECT version FROM retrieval.index_state WHERE id = 1\")\n    39\t\n    40\t    def _key(self, query: str) -> str:\n    41\t        normalized = \" \".join(query.lower().split())\n    42\t        return hashlib.sha256(f\"{self._top_k}|{normalized}\".encode()).hexdigest()\n    43\t\n    44\t    async def search(self, query: str, employee_id: str) -> list[dict[str, Any]]:\n    45\t        version = await self._index_version()\n    46\t        key = self._key(query)\n    47\t        hit = self._cache.get(key)\n    48\t        if hit and hit[1] == version and time.monotonic() - hit[0] < self._ttl:\n    49\t            return hit[2]\n    50\t        rows = await self._pool.fetch(_SEARCH, query, employee_id, self._top_k)\n    51\t        chunks = [dict(r) for r in rows]\n    52\t        self._cache[key] = (time.monotonic(), version, chunks)\n    53\t        return chunks\n     1\tname: release\n     2\t\n     3\ton:\n     4\t  push:\n     5\t    branches: [main]\n     6\t\n     7\tpermissions:\n     8\t  contents: read\n     9\t\n    10\tjobs:\n    11\t  build:\n    12\t    runs-on: ubuntu-24.04\n    13\t    environment: production   # requires approval from @acme/people-platform-release\n    14\t    permissions:\n    15\t      contents: read\n    16\t      packages: write\n    17\t      id-token: write\n    18\t      attestations: write\n    19\t    env:\n    20\t      PYTHONDONTWRITEBYTECODE: \"1\"\n    21\t      IMAGE: registry.acme.example/people/hr-helpdesk-agent\n    22\t    steps:\n    23\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    24\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    25\t        with: {python-version: \"3.12.7\"}\n    26\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    27\t        with: {cosign-release: \"v2.6.2\"}\n    28\t      - run: pip install --require-hashes -r requirements.txt\n    29\t      - run: python -m pytest -q tests/release\n    30\t      - name: Build and push\n    31\t        id: build\n    32\t        uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    33\t        with:\n    34\t          push: true\n    35\t          tags: ${{ env.IMAGE }}:${{ github.sha }}\n    36\t          sbom: true\n    37\t          provenance: mode=max\n    38\t      - name: Sign image\n    39\t        run: cosign sign --yes \"${IMAGE}@${{ steps.build.outputs.digest }}\"\n    40\t      - uses: actions/attest-build-provenance@e8998f949152b193b063cb0ec769d69d929409be # v2.4.0\n    41\t        with:\n    42\t          subject-name: ${{ env.IMAGE }}\n    43\t          subject-digest: ${{ steps.build.outputs.digest }}\n    44\t          push-to-registry: true\n    45\t      - name: Compute agent-type-id\n    46\t        id: typeid\n    47\t        run: |\n    48\t          python -m src.type_id \"${{ steps.build.outputs.digest }}\" > type-id.json\n    49\t          echo \"id=$(jq -r .agent_type_id type-id.json)\" >> \"$GITHUB_OUTPUT\"\n    50\t      - name: Stamp release manifest\n    51\t        run: |\n    52\t          yq -i '.release.agent_type_id = \"${{ steps.typeid.outputs.id }}\" |\n    53\t                 .release.image.digest = \"${{ steps.build.outputs.digest }}\" |\n    54\t                 .release.git_sha = \"${{ github.sha }}\"' release/manifest.yaml\n    55\t      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\n    56\t        with:\n    57\t          name: release-${{ github.sha }}\n    58\t          path: [type-id.json, release/manifest.yaml]\n    59\t\n    60\t  deploy:\n    61\t    needs: build\n    62\t    runs-on: ubuntu-24.04\n    63\t    environment: production\n    64\t    permissions: {contents: read, id-token: write}\n    65\t    steps:\n    66\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    67\t      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0\n    68\t        with: {name: \"release-${{ github.sha }}\"}\n    69\t      - name: Render and apply\n    70\t        run: |\n    71\t          export IMAGE_DIGEST=$(yq -r .release.image.digest release/manifest.yaml)\n    72\t          export AGENT_TYPE_ID=$(yq -r .release.agent_type_id release/manifest.yaml)\n    73\t          export GIT_SHA=${{ github.sha }}\n    74\t          for f in k8s/*.yaml; do envsubst '$IMAGE_DIGEST $AGENT_TYPE_ID $GIT_SHA' < \"$f\"; echo '---'; done \\\n    75\t            | kubectl apply --server-side -f -\n     1\tagent:\n     2\t  name: hr-helpdesk\n     3\t  accountable_party: \"VP People Operations <people-ops-lead@acme.example>\"\n     4\t  operational_owner: \"people-platform (pager: people-platform-oncall)\"\n     5\t  tenant: acme\n     6\t  workload_identity: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n     7\t\n     8\tmodel:\n     9\t  provider: anthropic\n    10\t  id: claude-sonnet-4-5-20250929\n    11\t  pinning: snapshot          # dated snapshot ID per provider model docs, checked 2026-09-15\n    12\t  adapter: none\n    13\t  max_output_tokens: 1024\n    14\t  temperature: 0.2\n    15\t\n    16\tbudgets:\n    17\t  run:\n    18\t    max_steps: 12\n    19\t    max_wall_seconds: 90\n    20\t    max_total_tokens: 60000\n    21\t    max_cost_usd: 0.40\n    22\t    max_tool_calls_per_minute: 20\n    23\t    max_subagents: 0\n    24\t  quotas:\n    25\t    - scope: user\n    26\t      window_seconds: 86400\n    27\t      max_runs: 150\n    28\t      max_tokens: 400000\n    29\t      max_cost_usd: 3.00\n    30\t    - scope: tenant\n    31\t      window_seconds: 3600\n    32\t      max_runs: 20000\n    33\t      max_tokens: 15000000\n    34\t      max_cost_usd: 250.00\n    35\t    - scope: fleet\n    36\t      window_seconds: 3600\n    37\t      max_runs: 25000\n    38\t      max_tokens: 20000000\n    39\t      max_cost_usd: 300.00\n    40\t\n    41\tpricing:\n    42\t  input_per_mtok: 3.00\n    43\t  output_per_mtok: 15.00\n    44\t  cache_read_per_mtok: 0.30\n    45\t\n    46\tapprovals:\n    47\t  ttl_seconds: 600\n    48\t\n    49\tstop:\n    50\t  poll_seconds: 2\n    51\t  max_stop_seconds: 10\n    52\t\n    53\tretrieval:\n    54\t  top_k: 5\n    55\t  cache_ttl_seconds: 900\n    56\t  max_chunk_chars: 4000\n    57\t\n    58\tlimits:\n    59\t  max_tool_output_bytes: 16384\n    60\t  max_user_message_chars: 4000\n    61\t\n    62\toutput:\n    63\t  allowed_link_hosts: [hr.acme.example, handbook.acme.example]\n# hr-helpdesk-agent\n\nAn HR helpdesk assistant for Acme employees. It answers policy questions from the HR handbook,\nshows the signed-in employee their own leave balance, files leave requests (the manager approves\nthem in HRIS), and hands conversations to an HR advisor.\n\n## Components\n\n| Component | Code | Identity |\n|---|---|---|\n| Agent API and loop | `src/main.py`, `src/agent.py` | SA `hr-helpdesk-agent`, SPIFFE SVID |\n| Tool gateway | `src/gateway.py` | SA `hr-tool-gateway` |\n| HRIS MCP server | owned by hris-platform | `spiffe://acme.example/ns/hris/sa/hris-mcp` |\n| Helpdesk MCP server | owned by it-service-desk | `spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp` |\n| Audit, approvals, quotas, stop flags, handbook index | Postgres (`migrations/001_init.sql`) | per-component DB roles |\n\n## How a request flows\n\n1. The HR portal sends the employee's SSO token. `main.py` verifies issuer, audience, expiry and\n   organisation; the employee id and tenant come only from that token.\n2. The loop (`agent.py`) checks the stop flags and the run budget before every model call, and\n   records usage against per-user, tenant and fleet quotas.\n3. Tool calls are looked up by exact name in `config/tools.yaml`. Arguments are schema-checked.\n   `file_leave_request` and `escalate_to_human` pause the run and show the employee exactly what\n   will be sent; the approval is bound to the run instance, operation, target and argument hash,\n   expires after 10 minutes, and is consumed once.\n4. MCP calls go to the gateway with a 300-second token for that one tool scope, minted by STS\n   from the agent's workload identity and the employee's token. The gateway verifies the token\n   and its certificate binding, checks scope, stop flags, rate limits and argument schema, swaps\n   the token for one addressed to the MCP server, and validates the response schema.\n5. Tool output is size-, schema- and content-checked and redacted before the model sees it.\n   Handbook passages are filtered at query time to documents the employee may see.\n6. Every step writes an `audit.events` row with the six identity fields and trace context.\n   If the audit write fails, the run stops.\n\nEscalations are delivered even during gateway maintenance windows.\n\n## Stopping the agent\n\nOperators with the `hr_agent_operator` DB role insert into `control.stop_flags`:\n\n```sql\nINSERT INTO control.stop_flags (scope, value, reason) VALUES ('fleet', NULL, 'incident 2291');\n-- or scope 'agent_type' / 'agent_instance' / 'subject' / 'agent_principal'\n```\n\nRunning agents see the flag within 2 seconds and cancel in-flight work; the gateway refuses\ncalls immediately. Target stop time: 10 seconds. The agent's DB role can only read this table.\nLast drill: see `docs/drills/` in the ops repo.\n\n## Audit retention\n\nAudit records are kept for six months (Acme records policy; employment-related AI use in the EU).\nPartitions are created and dropped nightly by `k8s/audit-maintenance.yaml`. Access is limited to\n`hr_audit_reader`.\n\n## Releases\n\nMerges to `main` build, sign and attest the image, compute the agent-type-id over every file in\n`src/`, `prompts/`, `config/`, plus `requirements.txt`, `Dockerfile`, the image digest and the model","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01X6SbfyWJkjs4kV5BQDm2ej","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
