nf\\\"].get(\\\"x5t#S256\\\") != cert_hash:\"),\"Gateway verifies JWT (ES256, audience, issuer, cnf) and cert binding, and agent verifies SSO JWT (main.py:69). Binding relies on the mesh setting X-Forwarded-Client-Cert and stripping client copies (gateway.py:86), a platform control not visible in this repo.\")\nother(\"R01.4\",\"no\",(\"src/agent.py\",\"return _tool_result(tool_use_id, f\\\"{spec.name} failed: {exc.detail}\\\", error=True)\"),\"Injection-marker/Unicode screening (validation.py:36) covers tool output and chunks but is skipped for error text; markers are also a fixed regex list.\")\nother(\"R01.5\",\"no\",(\"src/agent.py\",\"return _tool_result(tool_use_id, f\\\"{spec.name} failed: {exc.detail}\\\", error=True)\"),\"Validation failures hold content (agent.py:174,190), but the error path never runs the checks, so unvalidated content is used instead of blocked.\")\n\nyes(\"R02.1\", [\n (\"system prompt\", \"src/agent.py\", \"model=model[\\\"id\\\"], system=SYSTEM_PROMPT,\", \"enforced\", \"system= is the static file-loaded prompt only (H020 dismissed).\"),\n (\"tool results\", \"src/agent.py\", \"state.messages.append({\\\"role\\\": \\\"user\\\", \\\"content\\\": results})\", \"enforced\", \"Tool output goes in a user-role message.\"),\n (\"resumed tool result\", \"src/agent.py\", \"state.messages.append({\\\"role\\\": \\\"user\\\", \\\"content\\\": [result]})\", \"enforced\", \"Same after approval.\"),\n (\"user text\", \"src/agent.py\", \"messages=[{\\\"role\\\": \\\"user\\\", \\\"content\\\": user_text}]\", \"enforced\", \"Employee text is a user turn.\"),\n (\"tool descriptions\", \"src/tools.py\", \"{\\\"name\\\": s.name, \\\"description\\\": s.reason, \\\"input_schema\\\": s.input_schema}\", \"enforced\", \"Descriptions come from reviewed config, not servers.\"),\n], \"Searched for other system= arguments, role system, string concatenation into the prompt; retrieved chunks arrive only via tool results.\",\n \"Outside content never enters the system prompt.\", (\"src/agent.py\",\"model=model[\\\"id\\\"], system=SYSTEM_PROMPT,\"))\nother(\"R02.2\",\"no\",(\"src/agent.py\",\"return _tool_result(tool_use_id, f\\\"{spec.name} failed: {exc.detail}\\\", error=True)\"),\"Successful results carry source and trust (agent.py:195) and chunks carry source/trust from the DB, but error text from servers has no source or trust label.\")\nyes(\"R02.3\", [\n (\"tool allowlist\", \"src/agent.py\", \"decision=\\\"deny\\\", reason=\\\"tool not in allowlist\\\"\", \"enforced\", \"Unknown tool names denied.\"),\n (\"write approval gate\", \"src/agent.py\", \"if spec.approval == \\\"subject\\\":\", \"enforced\", \"Writes pause for employee approval.\"),\n (\"approval binding\", \"src/approvals.py\", \"AND args_sha256 = $6\", \"enforced\", \"Approval bound to instance, operation, target and args hash.\"),\n (\"credential scope\", \"src/gateway.py\", \"if spec.scope not in claims[\\\"scope\\\"].split():\", \"enforced\", \"STS-scoped token checked in gateway.\"),\n (\"subject from token\", \"src/main.py\", \"return claims[\\\"employee_id\\\"], token\", \"enforced\", \"Subject comes from verified SSO token, not model.\"),\n (\"retrieval filter\", \"src/retrieval.py\", \"AND (c.audience = 'all' OR\", \"enforced\", \"Employee-specific chunks filtered in SQL.\"),\n], \"Searched for write/send paths outside _handle_tool and for model-controlled target/scope; the target comes from config template and ctx.subject. escalate_to_human direct_route (config/tools.yaml:91) skips gateway stop/rate checks but still needs approval.\",\n \"Injected-instruction actions are blocked by allowlist, approval, scope in code.\", (\"src/agent.py\",\"if spec.approval == \\\"subject\\\":\"))\nyes(\"R02.4\", [\n (\"approval gate independent of prompt\", \"src/agent.py\", \"if spec.approval == \\\"subject\\\":\", \"enforced\", \"Does not depend on prompt wording or detector.\"),\n (\"detector not relied on\", \"src/validation.py\", \"_INJECTION_MARKERS = [\", \"enforced\", \"Marker scan is defense in depth; removing it leaves approval, scope and allowlist blocks.\"),\n (\"scope check\", \"src/gateway.py\", \"if spec.scope not in claims[\\\"scope\\\"].split():\", \"enforced\", \"Code-level credential limit.\"),\n], \"Considered removing system-prompt rule (system.md:18), JSON envelope and marker scan: writes still need approval and scopes; reads are limited to the employee's own data.\",\n \"Containment holds without prompt, delimiters or detector.\", (\"src/agent.py\",\"if spec.approval == \\\"subject\\\":\"))\nother(\"R02.5\",\"unknown\",(\".github/workflows/release.yml\",\"python -m pytest -q tests/release\"),\"No tests/ directory or injection fixtures exist in the repo (searched); the release workflow references tests/release, which is not present. Evidence of repeated injection tests with success rates would live elsewhere.\")\n\nother(\"R03.1\",\"no\",(\"src/agent.py\",\"return _tool_result(tool_use_id, f\\\"{spec.name} failed: {exc.detail}\\\", error=True)\"),\"exc.detail is sent to the model unredacted (only the log copy at agent.py:187 is redacted). Also audit reason columns (audit.py:93) store jsonschema error text unredacted, which can quote the offending value.\")\nother(\"R03.2\",\"no\",(\"src/main.py\",\"body[\\\"approval\\\"] = state.pending_approval\"),\"sanitize_reply is applied only to reply (main.py:104). The approval description includes the model-written ticket summary (approvals.py:34) and is returned unsanitized, so a Markdown image or link there is not stripped. The client renderer is outside the repo.\")\nyes(\"R03.3\", [\n (\"retrieval SQL\", \"src/retrieval.py\", \"websearch_to_tsquery('english', $1)\", \"enforced\", \"Query text is bound parameter $1.\"),\n (\"approval SQL\", \"src/approvals.py\", \"VALUES ($1, $2, $3, $4, $5, $6, $7, $8::jsonb,\", \"enforced\", \"All values bound.\"),\n (\"audit SQL\", \"src/audit.py\", \"$22::jsonb, $23::jsonb, $24, $25, $26, $27\", \"enforced\", \"All bound.\"),\n (\"quota SQL f-strings\", \"src/budgets.py\", \"VALUES ($1, $2, {_WINDOW}, 1, 0, 0)\", \"enforced\", \"f-string interpolates only the constant _WINDOW.\"),\n (\"gateway SQL\", \"src/gateway.py\", \"OR (scope = 'agent_instance' AND value = $1)\", \"enforced\", \"Bound.\"),\n (\"shell/HTML\", \"src/validation.py\", \"def sanitize_reply(text: str, allowed_hosts: list[str]) -> str:\", \"enforced\", \"No shell calls exist; replies are JSON, no HTML built.\"),\n], \"Searched src/ for subprocess, os.system, shell=True, execute(f, innerHTML; none.\",\n \"SQL parameterized, no shell, no HTML.\", (\"src/retrieval.py\",\"websearch_to_tsquery('english', $1)\"))\nyes(\"R03.4\", [\n (\"audit args/result redaction\", \"src/audit.py\", \"json.dumps(redact_obj(args)), json.dumps(redact_obj(result)),\", \"enforced\", \"Redacted copy is written to audit.events; record is kept.\"),\n (\"tool result audit\", \"src/agent.py\", \"await self.audit.record(ctx, \\\"tool_result\\\"\", \"enforced\", \"Redacted result stored.\"),\n (\"gateway decisions\", \"src/gateway.py\", \"decision, redact(reason),\", \"enforced\", \"Redacted reason written to audit.gateway_decisions.\"),\n (\"held content\", \"src/agent.py\", \"await self.audit.record(ctx, \\\"content_held\\\"\", \"enforced\", \"Held chunks are recorded.\"),\n], \"Searched redact paths for dropping records (return None/continue); redaction substitutes text and the row is still written.\",\n \"Redacted records are written to the audit store.\", (\"src/audit.py\",\"json.dumps(redact_obj(args)), json.dumps(redact_obj(result)),\"))\nEOF\ncd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-aagsnue5 && /private/tmp/claude-501/-Users-brenn-dev-brace/255658ca-f19b-460c-8892-2a477de97733/scratchpad/venv/bin/python /private/tmp/claude-501/-Users-brenn-dev-brace/255658ca-f19b-460c-8892-2a477de97733/scratchpad/drv/run.py","uuid":"386aa243-f437-43b0-9757-18da5c45c409","session_id":"db59a6d5-eede-4f12-ba96-e4e021287180"}
