    verifyDigest: true\n    75\t          required: true\n    76\t          attestors:\n    77\t            - entries:\n    78\t                - keyless:\n    79\t                    subject: \"https://github.com/acme/platform-images/.github/workflows/build.yml@refs/heads/main\"\n    80\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    81\t                    rekor: {url: \"https://rekor.sigstore.dev\"}\n     1\t*                         @acme/people-platform\n     2\t/prompts/                 @acme/people-platform @acme/hr-policy-reviewers\n     3\t/config/                  @acme/people-platform @acme/security-engineering\n     4\t/src/gateway.py           @acme/people-platform @acme/security-engineering\n     5\t/src/approvals.py         @acme/people-platform @acme/security-engineering\n     6\t/k8s/                     @acme/people-platform @acme/platform-security\n     7\t/migrations/              @acme/people-platform @acme/data-platform\n     8\t/release/                 @acme/people-platform @acme/security-engineering\n     9\t/.github/                 @acme/platform-security\n    10\t/CODEOWNERS               @acme/platform-security\n     1\trelease:\n     2\t  name: hr-helpdesk-agent\n     3\t  version: \"1.8.0\"\n     4\t  git_sha: \"\"            # stamped by CI\n     5\t  agent_type_id: \"\"      # stamped by CI (src/type_id.py, scheme acme-agent-type-id/v1)\n     6\t  image:\n     7\t    repository: registry.acme.example/people/hr-helpdesk-agent\n     8\t    digest: \"\"           # stamped by CI\n     9\t    signer: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    10\t    sbom: attached (BuildKit SPDX)\n    11\t    provenance: SLSA v1 via actions/attest-build-provenance\n    12\t  owners:\n    13\t    accountable_party: \"VP People Operations\"\n    14\t    operational_owner: people-platform\n    15\t\n    16\tstakes:\n    17\t  rating: moderate\n    18\t  autonomy: low (every write requires the employee's confirmation)\n    19\t  rationale: >-\n    20\t    Reads one employee's own leave data and the handbook; writes are leave requests that a\n    21\t    manager must still approve in HRIS, and helpdesk tickets. Worst credible harm: disclosure of\n    22\t    one employee's HR data to another employee, or a misleading policy answer.\n    23\t  approved_by: \"Head of Security Engineering, 2026-09-19\"\n    24\t\n    25\tcapability_combination:\n    26\t  untrusted_input: yes (employee messages, handbook passages, tool output)\n    27\t  sensitive_access: yes (leave records, employee-specific HR documents)\n    28\t  external_change_or_send: yes (leave requests, helpdesk tickets)\n    29\t  containment: every consequential tool requires per-action employee approval bound to args\n    30\t\n    31\tharness:\n    32\t  files: [src/]\n    33\t  entrypoints: {agent: \"src.main:app\", gateway: \"src.gateway:app\"}\n    34\tsystem_prompt: {path: prompts/system.md}\n    35\trules_files: []\n    36\tconfiguration: [config/agent.yaml, config/tools.yaml]\n    37\t\n    38\tmodels:\n    39\t  primary:\n    40\t    role: main agent\n    41\t    owner: people-platform\n    42\t    identity: {provider: anthropic, id: claude-sonnet-4-5-20250929, pinning: snapshot, adapter: none}\n    43\t    pinning_source: \"Anthropic models overview, checked 2026-09-15\"\n    44\t    served_version: recorded per call in audit.events.model_served\n    45\t    fine_tune: none\n    46\t    training_runs: not applicable\n    47\t    training_data: provider-undisclosed\n    48\t  helpers: []            # retrieval is Postgres full-text search; no embedding or reranker model\n    49\t\n    50\ttools:\n    51\t  built_in: []\n    52\t  local: [search_policies]\n    53\t  mcp_servers:\n    54\t    - {id: hris, identity: \"spiffe://acme.example/ns/hris/sa/hris-mcp\", owner: hris-platform, tools: [get_leave_balance, file_leave_request]}\n    55\t    - {id: helpdesk, identity: \"spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\", owner: it-service-desk, tools: [create_ticket]}\n    56\t  policy_version_source: config/tools.yaml#policy_version\n    57\t\n    58\tpermissions:\n    59\t  sts_scopes: [hr.policy.read, hris.leave.read, hris.leave.request, helpdesk.ticket.create]\n    60\t  token_ttl_seconds: 300\n    61\t  database_role: hr_agent (see migrations/001_init.sql grants)\n    62\t\n    63\tmemory: none (conversation state is held per run and discarded; no cross-run memory)\n    64\tretrieval:\n    65\t  store: retrieval.chunks (Postgres FTS)\n    66\t  writers: [hr_docs_ingest]\n    67\t  filters: [quarantined, expires_at, audience/allowed_employees]\n    68\t\n    69\tidentity_bindings:\n    70\t  agent: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n    71\t  gateway: spiffe://acme.example/ns/hr-agent/sa/hr-tool-gateway\n    72\t\n    73\tnetwork: [k8s/networkpolicy.yaml]\n    74\tadmission: [k8s/admission.yaml]\n    75\tbudgets: config/agent.yaml#budgets\n    76\t\n    77\taudit:\n    78\t  store: audit.events, audit.gateway_decisions (Postgres, weekly partitions)\n    79\t  retention: 6 months\n    80\t  readers: hr_audit_reader\n     200 src/agent.py\n      97 src/approvals.py\n     101 src/audit.py\n     125 src/budgets.py\n      70 src/credentials.py\n      95 src/gateway_client.py\n     218 src/gateway.py\n      60 src/killswitch.py\n     184 src/main.py\n      43 src/redact.py\n      53 src/retrieval.py\n      80 src/tools.py\n      65 src/type_id.py\n     109 src/validation.py\n    1500 total\n.\n..\n.github\n.mcp.json\nbrace-findings.json\nbrace-prescan.json\nCODEOWNERS\nconfig\nDockerfile\nk8s\nmigrations\nprompts\nREADME.md\nrelease\nrequirements.txt\nsrc\n.\n..\nagent\nbatch-policy.json\nbatch-prescan.json\nskill\nworkflows\n     1\t\"\"\"Agent loop for the HR helpdesk.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport json\n     5\timport logging\n     6\timport pathlib\n     7\timport uuid\n     8\tfrom dataclasses import dataclass, field\n     9\tfrom datetime import date\n    10\tfrom typing import Any\n    11\t\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    16\tfrom .audit import AuditWriter, RunContext\n    17\tfrom .budgets import BudgetExceeded, QuotaStore, RunBudget\n    18\tfrom .gateway_client import GatewayClient, ToolDenied, ToolError\n    19\tfrom .killswitch import StopControl\n    20\tfrom .redact import redact\n    21\tfrom .retrieval import PolicyIndex\n    22\tfrom .tools import ToolRegistry, ToolSpec\n    23\tfrom .validation import ValidationRejected, validate_chunk, validate_tool_args, validate_tool_output\n    24\t\n    25\tlog = logging.getLogger(\"hr_agent.loop\")\n    26\ttracer = trace.get_tracer(\"hr_agent\")\n    27\t\n    28\tSYSTEM_PROMPT = (pathlib.Path(__file__).resolve().parent.parent / \"prompts\" / \"system.md\").read_text()\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass RunState:\n    33\t    messages: list[dict[str, Any]]\n    34\t    budget: RunBudget\n    35\t    subject_token: str\n    36\t    status: str = \"running\"\n    37\t    reply: str | None = None\n    38\t    pending_approval: dict[str, Any] | None = None\n    39\t    last_step: str | None = None\n    40\t    subagents_started: int = 0\n    41\t    extra: dict[str, Any] = field(default_factory=dict)\n    42\t\n    43\t\n    44\tclass Agent:\n    45\t    def __init__(self, cfg: dict[str, Any], registry: ToolRegistry, llm: AsyncAnthropic, gateway: GatewayClient,\n    46\t                 index: PolicyIndex, approvals: ApprovalStore, quotas: QuotaStore, audit: AuditWriter, stop: StopControl):\n    47\t        self.cfg, self.registry, self.llm, self.gateway = cfg, registry, llm, gateway\n    48\t        self.index, self.approvals, self.quotas, self.audit, self.stop = index, approvals, quotas, audit, stop\n    49\t\n    50\t    def new_state(self, user_text: str, subject_token: str) -> RunState:\n    51\t        budget = RunBudget(self.cfg[\"budgets\"][\"run\"], self.cfg[\"pricing\"])\n    52\t        return RunState(messages=[{\"role\": \"user\", \"content\": user_text}], budget=budget, subject_token=subject_token)\n    53\t\n    54\t    async def run(self, ctx: RunContext, state: RunState) -> RunState:\n    55\t        with tracer.start_as_current_span(\"agent.run\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n    56\t            try:\n    57\t                await self._loop(ctx, state)\n    58\t            except BudgetExceeded as exc:\n    59\t                await self.audit.record(ctx, \"budget_stop\", decision=\"stop\", reason=exc.limit, parent_step_id=state.last_step)\n    60\t                state.status, state.reply = \"stopped\", \"I've reached the limit for this conversation. An HR advisor can help further.\"\n    61\t            return state\n    62\t\n    63\t    async def _loop(self, ctx: RunContext, state: RunState) -> None:\n    64\t        model = self.cfg[\"model\"]\n    65\t        while True:\n    66\t            await self.stop.raise_if_stopped(ctx)\n    67\t            state.budget.check_step()\n    68\t            step_id = str(uuid.uuid4())\n    69\t            with tracer.start_as_current_span(\"gen_ai.chat\", attributes={\"gen_ai.request.model\": model[\"id\"]}):\n    70\t                resp = await self.llm.messages.create(\n    71\t                    model=model[\"id\"], system=SYSTEM_PROMPT, max_tokens=model[\"max_output_tokens\"],\n    72\t                    temperature=model[\"temperature\"], tools=self.registry.model_schemas(), messages=state.messages,\n    73\t                    timeout=state.budget.remaining_seconds(),\n    74\t                )\n    75\t                tokens, cost = state.budget.record_usage(resp.usage)\n    76\t                ctx_tokens = resp.usage.input_tokens + (resp.usage.cache_read_input_tokens or 0) + (resp.usage.cache_creation_input_tokens or 0)\n    77\t                await self.audit.record(\n    78\t                    ctx, \"model_call\", step_id=step_id, parent_step_id=state.last_step,\n    79\t                    context_tokens=ctx_tokens, context_tokens_method=\"measured:provider_usage_input+cache_read+cache_write\",\n    80\t                    model_requested=model[\"id\"], model_served=resp.model, result={\"stop_reason\": resp.stop_reason},\n    81\t                )\n    82\t                await self.quotas.record_usage(ctx, tokens, cost)\n    83\t            state.last_step = step_id\n    84\t            state.messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n    85\t            if resp.stop_reason != \"tool_use\":\n    86\t                state.status = \"done\"\n    87\t                state.reply = \"\".join(b.text for b in resp.content if b.type == \"text\")\n    88\t                return\n    89\t            results = []\n    90\t            for block in (b for b in resp.content if b.type == \"tool_use\"):\n    91\t                result = await self._handle_tool(ctx, state, step_id, block.id, block.name, block.input)\n    92\t                if result is None:  # paused for employee approval\n    93\t                    return\n    94\t                results.append(result)\n    95\t            state.messages.append({\"role\": \"user\", \"content\": results})\n    96\t\n    97\t    async def _handle_tool(self, ctx: RunContext, state: RunState, parent: str, tool_use_id: str,\n    98\t                           name: str, args: Any) -> dict[str, Any] | None:\n    99\t        step_id = str(uuid.uuid4())\n   100\t        await self.audit.record(ctx, \"proposed_action\", step_id=step_id, parent_step_id=parent, tool=name, args=args)\n   101\t        spec = self.registry.get(name)\n   102\t        if spec is None:\n   103\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=name, decision=\"deny\", reason=\"tool not in allowlist\")\n   104\t            return _tool_result(tool_use_id, \"This tool is not available.\", error=True)\n   105\t        target = spec.target(ctx.subject)\n   106\t        state.budget.check_tool_call()\n   107\t        try:\n   108\t            args = validate_tool_args(spec, args)\n   109\t        except ValidationRejected as exc:\n   110\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target,\n   111\t                                    decision=\"deny\", reason=exc.reason, args=args)\n   112\t            return _tool_result(tool_use_id, f\"Invalid arguments: {exc.reason}\", error=True)\n   113\t        if spec.approval == \"subject\":\n   114\t            approval_id, text = await self.approvals.request(ctx, spec.qualified, target, args, tool_use_id)\n   115\t            await self.audit.record(ctx, \"approval_requested\", step_id=step_id, tool=spec.qualified, target=target,\n   116\t                                    decision=\"hold\", approval_id=approval_id, args=args)\n   117\t            state.status = \"awaiting_approval\"\n   118\t            state.pending_approval = {\"approval_id\": approval_id, \"description\": text}\n   119\t            return None\n   120\t        await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target, decision=\"allow\")\n   121\t        return await self._execute(ctx, state, step_id, tool_use_id, spec, target, args, approval_id=None)\n   122\t\n   123\t    async def resume_with_approval(self, ctx: RunContext, state: RunState, approval_id: str) -> RunState:\n   124\t        with tracer.start_as_current_span(\"agent.resume\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n   125\t            pending = await self.approvals.pending(approval_id)\n   126\t            if pending is None or pending[\"run_id\"] != ctx.run_id:\n   127\t                raise ApprovalInvalid(\"unknown approval for this run\")\n   128\t            spec = self.registry.by_qualified(pending[\"operation\"])\n   129\t            step_id = str(uuid.uuid4())\n   130\t            try:\n   131\t                await self.stop.raise_if_stopped(ctx)\n   132\t                args = validate_tool_args(spec, pending[\"args\"])\n   133\t                target = spec.target(ctx.subject)\n   134\t                await self._recheck_state(ctx, state, spec, args)\n   135\t                grant = await self.approvals.consume(ctx, approval_id, spec.qualified, target, args)\n   136\t            except (ApprovalInvalid, ValidationRejected, ToolDenied, ToolError) as exc:\n   137\t                await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=pending[\"operation\"],\n   138\t                                        decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   139\t                state.status, state.reply = \"done\", \"That action can no longer be carried out as approved.\"\n   140\t                return state\n   141\t            await self.audit.record(ctx, \"approval_used\", step_id=step_id, parent_step_id=state.last_step,\n   142\t                                    tool=spec.qualified, target=target, decision=\"allow\", approval_id=approval_id,\n   143\t                                    result={\"approved_by\": grant[\"approved_by\"], \"approved_at\": grant[\"approved_at\"].isoformat()})\n   144\t            result = await self._execute(ctx, state, step_id, pending[\"tool_use_id\"], spec, target, args, approval_id=approval_id)\n   145\t            state.messages.append({\"role\": \"user\", \"content\": [result]})\n   146\t            state.status, state.pending_approval = \"running\", None\n   147\t            return await self.run(ctx, state)\n   148\t\n   149\t    async def _recheck_state(self, ctx: RunContext, state: RunState, spec: ToolSpec, args: dict[str, Any]) -> None:\n   150\t        \"\"\"Re-read the resource the action depends on, at execution time.\"\"\"\n   151\t        if spec.qualified != \"hris/file_leave_request\" or args[\"leave_type\"] == \"unpaid\":\n   152\t            return\n   153\t        balance_spec = self.registry.get(\"get_leave_balance\")\n   154\t        bal = await self.gateway.call(balance_spec, {\"leave_type\": args[\"leave_type\"]}, ctx, state.subject_token,\n   155\t                                      operation_id=str(uuid.uuid4()))\n   156\t        bal = validate_tool_output(balance_spec, bal, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n   157\t        days = (date.fromisoformat(args[\"end_date\"]) - date.fromisoformat(args[\"start_date\"])).days + 1\n   158\t        if days <= 0 or bal[\"balance_days\"] < days:\n   159\t            raise ApprovalInvalid(\"leave balance no longer covers the request\")\n   160\t\n   161\t    async def _execute(self, ctx: RunContext, state: RunState, step_id: str, tool_use_id: str, spec: ToolSpec,\n   162\t                       target: str, args: dict[str, Any], approval_id: str | None) -> dict[str, Any]:\n   163\t        operation_id = approval_id or str(uuid.uuid4())\n   164\t        with tracer.start_as_current_span(f\"execute_tool {spec.qualified}\", attributes={\"gen_ai.tool.name\": spec.name}):\n   165\t            try:\n   166\t                if spec.kind == \"local\":\n   167\t                    raw = await self.index.search(args[\"query\"], ctx.subject)\n   168\t                    max_chars = self.cfg[\"retrieval\"][\"max_chunk_chars\"]\n   169\t                    clean: Any = []\n   170\t                    for chunk in raw:\n   171\t                        try:\n   172\t                            clean.append(validate_chunk(chunk, max_chars))\n   173\t                        except ValidationRejected as exc:\n   174\t                            await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified,\n   175\t                                                    decision=\"hold\", reason=exc.reason, result={\"chunk_id\": chunk[\"chunk_id\"]})\n   176\t                else:\n   177\t                    raw = await self.gateway.call(spec, args, ctx, state.subject_token, operation_id=operation_id)\n   178\t                    clean = validate_tool_output(spec, raw, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n   179\t            except ToolDenied as exc:\n   180\t                await self.audit.record(ctx, \"tool_denied\", step_id=step_id, tool=spec.qualified, target=target,\n   181\t                                        decision=\"deny\", reason=exc.reason, approval_id=approval_id, args=args)\n   182\t                return _tool_result(tool_use_id, \"The request was refused by policy.\", error=True)\n   183\t            except ToolError as exc:\n   184\t                await self.audit.record(ctx, \"tool_error\", step_id=step_id, tool=spec.qualified, target=target,\n   185\t                                        decision=\"error\", reason=f\"status {exc.status}\", approval_id=approval_id,\n   186\t                                        args=args, result={\"detail\": exc.detail})\n   187\t                log.warning(\"tool error\", extra={\"tool\": spec.qualified, \"detail\": redact(exc.detail)})\n   188\t                return _tool_result(tool_use_id, f\"{spec.name} failed: {exc.detail}\", error=True)\n   189\t            except ValidationRejected as exc:\n   190\t                await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified, target=target,\n   191\t                                        decision=\"hold\", reason=exc.reason, approval_id=approval_id)\n   192\t                return _tool_result(tool_use_id, \"The tool returned data that could not be used.\", error=True)\n   193\t        await self.audit.record(ctx, \"tool_result\", step_id=step_id, tool=spec.qualified, target=target,\n   194\t                                decision=\"ok\", approval_id=approval_id, args=args, result=clean)\n   195\t        envelope = {\"source\": spec.qualified, \"trust\": \"untrusted_data\", \"data\": clean}\n   196\t        return _tool_result(tool_use_id, json.dumps(envelope, ensure_ascii=False))\n   197\t\n   198\t\n   199\tdef _tool_result(tool_use_id: str, content: str, error: bool = False) -> dict[str, Any]:\n   200\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"content\": content, \"is_error\": error}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0152S685GHb3sDDH1NfwVA57","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
