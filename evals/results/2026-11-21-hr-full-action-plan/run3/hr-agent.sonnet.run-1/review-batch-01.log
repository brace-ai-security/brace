{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A21etsdvvkcvt8DHMtbMC1","type":"tool_result","content":"(eval):1: no matches found: --include=*\n     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport logging\n     6\timport os\n     7\timport uuid\n     8\t\n     9\timport asyncpg\n    10\timport httpx\n    11\timport jwt\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n    15\tfrom opentelemetry.sdk.resources import Resource\n    16\tfrom opentelemetry.sdk.trace import TracerProvider\n    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n    18\tfrom starlette.applications import Starlette\n    19\tfrom starlette.requests import Request\n    20\tfrom starlette.responses import JSONResponse\n    21\tfrom starlette.routing import Route\n    22\t\n    23\tfrom . import type_id\n    24\tfrom .agent import Agent, RunState\n    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n    27\tfrom .budgets import BudgetExceeded, QuotaStore\n    28\tfrom .credentials import CredentialBroker\n    29\tfrom .gateway_client import GatewayClient\n    30\tfrom .killswitch import Stopped, StopControl\n    31\tfrom .redact import RedactingFilter\n    32\tfrom .retrieval import PolicyIndex\n    33\tfrom .tools import ToolRegistry, load_yaml\n    34\tfrom .validation import sanitize_reply\n    35\t\n    36\tSSO_ISSUER = \"https://sso.acme.example\"\n    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    39\t\n    40\tlogging.basicConfig(level=logging.INFO)\n    41\tfor h in logging.getLogger().handlers:\n    42\t    h.addFilter(RedactingFilter())\n    43\tlog = logging.getLogger(\"hr_agent\")\n    44\t\n    45\tCFG = load_yaml(\"agent.yaml\")\n    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n    47\tPOD_ID = os.environ[\"POD_UID\"]\n    48\t\n    49\tprovider = TracerProvider(resource=Resource.create({\n    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n    51\t}))\n    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n    53\ttrace.set_tracer_provider(provider)\n    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n    55\t\n    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n    57\tagent: Agent\n    58\taudit: AuditWriter\n    59\tapprovals: ApprovalStore\n    60\tstop: StopControl\n    61\t\n    62\t\n    63\tdef _employee(request: Request) -> tuple[str, str]:\n    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n    65\t    auth = request.headers.get(\"authorization\", \"\")\n    66\t    if not auth.startswith(\"Bearer \"):\n    67\t        raise PermissionError(\"missing token\")\n    68\t    token = auth[7:]\n    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n    72\t        raise PermissionError(\"wrong organisation\")\n    73\t    return claims[\"employee_id\"], token\n    74\t\n    75\t\n    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n    77\t    a = CFG[\"agent\"]\n    78\t    return RunContext(\n    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n    81\t        agent_principal=a[\"workload_identity\"],\n    82\t    )\n    83\t\n    84\t\n    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n    86\t    task = asyncio.ensure_future(coro)\n    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n    88\t    try:\n    89\t        return await task\n    90\t    except asyncio.CancelledError:\n    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n    92\t        return None\n    93\t    except Stopped as exc:\n    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n    95\t        return None\n    96\t    finally:\n    97\t        watcher.cancel()\n    98\t\n    99\t\n   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n   101\t    if state is None:\n   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n   105\t    if state.pending_approval:\n   106\t        body[\"approval\"] = state.pending_approval\n   107\t    return JSONResponse(body)\n   108\t\n   109\t\n   110\tasync def chat(request: Request) -> JSONResponse:\n   111\t    try:\n   112\t        employee_id, token = _employee(request)\n   113\t    except (jwt.PyJWTError, PermissionError):\n   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n   116\t    run_id = str(uuid.uuid4())\n   117\t    ctx = _context(run_id, employee_id)\n   118\t    with tracer.start_as_current_span(\"chat\"):\n   119\t        try:\n   120\t            await agent.quotas.reserve_run(ctx)\n   121\t            state = agent.new_state(text, token)\n   122\t            _runs[run_id] = (ctx, state)\n   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n   124\t            state = await _drive(ctx, agent.run(ctx, state))\n   125\t        except BudgetExceeded as exc:\n   126\t            await audit.record(ctx, \"quota_denied\", decision=\"deny\", reason=exc.limit)\n   127\t            return JSONResponse({\"error\": \"quota_exceeded\"}, status_code=429)\n   128\t        except AuditUnavailable:\n   129\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   130\t        except Exception as exc:\n   131\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__)\n   132\t            raise\n   133\t        return _reply(run_id, state)\n   134\t\n   135\t\n   136\tasync def confirm(request: Request) -> JSONResponse:\n   137\t    try:\n   138\t        employee_id, token = _employee(request)\n   139\t    except (jwt.PyJWTError, PermissionError):\n   140\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   141\t    run_id, approval_id = request.path_params[\"run_id\"], request.path_params[\"approval_id\"]\n   142\t    entry = _runs.get(run_id)\n   143\t    if entry is None or entry[0].subject != employee_id:\n   144\t        return JSONResponse({\"error\": \"not_found\"}, status_code=404)\n   145\t    ctx, state = entry\n   146\t    state.subject_token = token\n   147\t    with tracer.start_as_current_span(\"approval.confirm\"):\n   148\t        try:\n   149\t            await approvals.confirm(approval_id, employee_id)\n   150\t            await audit.record(ctx, \"approval_granted\", decision=\"allow\", approval_id=approval_id)\n   151\t            state = await _drive(ctx, agent.resume_with_approval(ctx, state, approval_id))\n   152\t        except ApprovalInvalid as exc:\n   153\t            await audit.record(ctx, \"approval_rejected\", decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   154\t            return JSONResponse({\"error\": \"approval_invalid\"}, status_code=409)\n   155\t        except AuditUnavailable:\n   156\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   157\t        except Exception as exc:\n   158\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__, approval_id=approval_id)\n   159\t            raise\n   160\t        return _reply(run_id, state)\n   161\t\n   162\t\n   163\tasync def startup() -> None:\n   164\t    global agent, audit, approvals, stop\n   165\t    pool = await asyncpg.create_pool(os.environ[\"DATABASE_URL\"], min_size=2, max_size=20)\n   166\t    registry = ToolRegistry.from_config()\n   167\t    mtls = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\", cert=(\"/etc/svid/svid.pem\", \"/etc/svid/svid_key.pem\"))\n   168\t    audit = AuditWriter(pool, registry.policy_version)\n   169\t    approvals = ApprovalStore(pool, CFG[\"approvals\"][\"ttl_seconds\"])\n   170\t    stop = StopControl(pool, CFG[\"stop\"][\"poll_seconds\"])\n   171\t    agent = Agent(\n   172\t        CFG, registry, AsyncAnthropic(max_retries=1), GatewayClient(mtls, CredentialBroker(mtls)),\n   173\t        PolicyIndex(pool, CFG[\"retrieval\"][\"top_k\"], CFG[\"retrieval\"][\"cache_ttl_seconds\"]),\n   174\t        approvals, QuotaStore(pool, CFG[\"budgets\"][\"quotas\"]), audit, stop,\n   175\t    )\n   176\t\n   177\t\n   178\tapp = Starlette(\n   179\t    routes=[\n   180\t        Route(\"/v1/chat\", chat, methods=[\"POST\"]),\n   181\t        Route(\"/v1/runs/{run_id}/approvals/{approval_id}/confirm\", confirm, methods=[\"POST\"]),\n   182\t    ],\n   183\t    on_startup=[startup],\n   184\t)\n# hr-helpdesk-agent\n\nAn HR helpdesk assistant for Acme employees. It answers policy questions from the HR handbook,\nshows the signed-in employee their own leave balance, files leave requests (the manager approves\nthem in HRIS), and hands conversations to an HR advisor.\n\n## Components\n\n| Component | Code | Identity |\n|---|---|---|\n| Agent API and loop | `src/main.py`, `src/agent.py` | SA `hr-helpdesk-agent`, SPIFFE SVID |\n| Tool gateway | `src/gateway.py` | SA `hr-tool-gateway` |\n| HRIS MCP server | owned by hris-platform | `spiffe://acme.example/ns/hris/sa/hris-mcp` |\n| Helpdesk MCP server | owned by it-service-desk | `spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp` |\n| Audit, approvals, quotas, stop flags, handbook index | Postgres (`migrations/001_init.sql`) | per-component DB roles |\n\n## How a request flows\n\n1. The HR portal sends the employee's SSO token. `main.py` verifies issuer, audience, expiry and\n   organisation; the employee id and tenant come only from that token.\n2. The loop (`agent.py`) checks the stop flags and the run budget before every model call, and\n   records usage against per-user, tenant and fleet quotas.\n3. Tool calls are looked up by exact name in `config/tools.yaml`. Arguments are schema-checked.\n   `file_leave_request` and `escalate_to_human` pause the run and show the employee exactly what\n   will be sent; the approval is bound to the run instance, operation, target and argument hash,\n   expires after 10 minutes, and is consumed once.\n4. MCP calls go to the gateway with a 300-second token for that one tool scope, minted by STS\n   from the agent's workload identity and the employee's token. The gateway verifies the token\n   and its certificate binding, checks scope, stop flags, rate limits and argument schema, swaps\n   the token for one addressed to the MCP server, and validates the response schema.\n5. Tool output is size-, schema- and content-checked and redacted before the model sees it.\n   Handbook passages are filtered at query time to documents the employee may see.\n6. Every step writes an `audit.events` row with the six identity fields and trace context.\n   If the audit write fails, the run stops.\n\nEscalations are delivered even during gateway maintenance windows.\n\n## Stopping the agent\n\nOperators with the `hr_agent_operator` DB role insert into `control.stop_flags`:\n\n```sql\nINSERT INTO control.stop_flags (scope, value, reason) VALUES ('fleet', NULL, 'incident 2291');\n-- or scope 'agent_type' / 'agent_instance' / 'subject' / 'agent_principal'\n```\n\nRunning agents see the flag within 2 seconds and cancel in-flight work; the gateway refuses\ncalls immediately. Target stop time: 10 seconds. The agent's DB role can only read this table.\nLast drill: see `docs/drills/` in the ops repo.\n\n## Audit retention\n\nAudit records are kept for six months (Acme records policy; employment-related AI use in the EU).\nPartitions are created and dropped nightly by `k8s/audit-maintenance.yaml`. Access is limited to\n`hr_audit_reader`.\n\n## Releases\n\nMerges to `main` build, sign and attest the image, compute the agent-type-id over every file in\n`src/`, `prompts/`, `config/`, plus `requirements.txt`, `Dockerfile`, the image digest and the model\nrecord, and stamp `release/manifest.yaml`. Pods refuse to start if the type id they compute\ndiffers from the one they were deployed with. Kyverno admits only signed images built by this\nworkflow from `main`.\nrelease:\n  name: hr-helpdesk-agent\n  version: \"1.8.0\"\n  git_sha: \"\"            # stamped by CI\n  agent_type_id: \"\"      # stamped by CI (src/type_id.py, scheme acme-agent-type-id/v1)\n  image:\n    repository: registry.acme.example/people/hr-helpdesk-agent\n    digest: \"\"           # stamped by CI\n    signer: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    sbom: attached (BuildKit SPDX)\n    provenance: SLSA v1 via actions/attest-build-provenance\n  owners:\n    accountable_party: \"VP People Operations\"\n    operational_owner: people-platform\n\nstakes:\n  rating: moderate\n  autonomy: low (every write requires the employee's confirmation)\n  rationale: >-\n    Reads one employee's own leave data and the handbook; writes are leave requests that a\n    manager must still approve in HRIS, and helpdesk tickets. Worst credible harm: disclosure of\n    one employee's HR data to another employee, or a misleading policy answer.\n  approved_by: \"Head of Security Engineering, 2026-09-19\"\n\ncapability_combination:\n  untrusted_input: yes (employee messages, handbook passages, tool output)\n  sensitive_access: yes (leave records, employee-specific HR documents)\n  external_change_or_send: yes (leave requests, helpdesk tickets)\n  containment: every consequential tool requires per-action employee approval bound to args\n\nharness:\n  files: [src/]\n  entrypoints: {agent: \"src.main:app\", gateway: \"src.gateway:app\"}\nsystem_prompt: {path: prompts/system.md}\nrules_files: []\nconfiguration: [config/agent.yaml, config/tools.yaml]\n\nmodels:\n  primary:\n    role: main agent\n    owner: people-platform\n    identity: {provider: anthropic, id: claude-sonnet-4-5-20250929, pinning: snapshot, adapter: none}\n    pinning_source: \"Anthropic models overview, checked 2026-09-15\"\n    served_version: recorded per call in audit.events.model_served\n    fine_tune: none\n    training_runs: not applicable\n    training_data: provider-undisclosed\n  helpers: []            # retrieval is Postgres full-text search; no embedding or reranker model\n\ntools:\n  built_in: []\n  local: [search_policies]\n  mcp_servers:\n    - {id: hris, identity: \"spiffe://acme.example/ns/hris/sa/hris-mcp\", owner: hris-platform, tools: [get_leave_balance, file_leave_request]}\n    - {id: helpdesk, identity: \"spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\", owner: it-service-desk, tools: [create_ticket]}\n  policy_version_source: config/tools.yaml#policy_version\n\npermissions:\n  sts_scopes: [hr.policy.read, hris.leave.read, hris.leave.request, helpdesk.ticket.create]\n  token_ttl_seconds: 300\n  database_role: hr_agent (see migrations/001_init.sql grants)\n\nmemory: none (conversation state is held per run and discarded; no cross-run memory)\nretrieval:\n  store: retrieval.chunks (Postgres FTS)\n  writers: [hr_docs_ingest]\n  filters: [quarantined, expires_at, audience/allowed_employees]\n\nidentity_bindings:\n  agent: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n  gateway: spiffe://acme.example/ns/hr-agent/sa/hr-tool-gateway\n\nnetwork: [k8s/networkpolicy.yaml]\nadmission: [k8s/admission.yaml]\nbudgets: config/agent.yaml#budgets\n\naudit:\n  store: audit.events, audit.gateway_decisions (Postgres, weekly partitions)\n  retention: 6 months\n  readers: hr_audit_reader\n*                         @acme/people-platform\n/prompts/                 @acme/people-platform @acme/hr-policy-reviewers\n/config/                  @acme/people-platform @acme/security-engineering\n/src/gateway.py           @acme/people-platform @acme/security-engineering\n/src/approvals.py         @acme/people-platform @acme/security-engineering\n/k8s/                     @acme/people-platform @acme/platform-security\n/migrations/              @acme/people-platform @acme/data-platform\n/release/                 @acme/people-platform @acme/security-engineering\n/.github/                 @acme/platform-security\n/CODEOWNERS               @acme/platform-security\n-- Roles (created by the platform team): hr_agent, hr_gateway, hr_agent_operator,\n-- hr_audit_reader, hr_audit_maint, hr_docs_ingest.\nCREATE SCHEMA audit; CREATE SCHEMA control; CREATE SCHEMA approvals; CREATE SCHEMA quota; CREATE SCHEMA retrieval;\n\nCREATE TABLE audit.events (\n    event_id uuid NOT NULL, ts timestamptz NOT NULL, event_type text NOT NULL,\n    run_id uuid NOT NULL, step_id uuid, parent_step_id uuid,\n    accountable_party text NOT NULL, operational_owner text NOT NULL, tenant text NOT NULL,\n    agent_type_id text NOT NULL, agent_instance_id text NOT NULL,\n    trace_id char(32) NOT NULL, span_id char(16) NOT NULL, traceparent text NOT NULL,\n    delegated_subject text NOT NULL, agent_principal text NOT NULL,\n    tool text, operation_target text, decision text, reason text, policy_version text NOT NULL, approval_id uuid,\n    args_redacted jsonb, result_redacted jsonb,\n    context_tokens integer, context_tokens_method text, model_requested text, model_served text,\n    PRIMARY KEY (event_id, ts)\n) PARTITION BY RANGE (ts);\nCREATE INDEX ON audit.events (trace_id);\nCREATE INDEX ON audit.events (run_id, ts);\n\nCREATE TABLE audit.gateway_decisions (\n    ts timestamptz NOT NULL, traceparent text NOT NULL, tenant text NOT NULL,\n    accountable_party text NOT NULL, operational_owner text NOT NULL,\n    agent_type_id_hint text NOT NULL, agent_instance_hint text NOT NULL,   -- caller-supplied; join key only\n    subject text, actor text, tool text, decision text NOT NULL, reason text, policy_version text NOT NULL\n) PARTITION BY RANGE (ts);\n\n-- Creates `ahead` partitions into the future and drops partitions older than the newest `keep`.\nCREATE FUNCTION audit.maintain_partitions(parent regclass, period interval, ahead int, keep int)\nRETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = audit, pg_temp AS $$\nDECLARE\n    start_ts timestamptz := date_trunc('week', now());\n    part record;\nBEGIN\n    FOR i IN 0..ahead LOOP\n        EXECUTE format('CREATE TABLE IF NOT EXISTS %s_%s PARTITION OF %s FOR VALUES FROM (%L) TO (%L)',\n                       parent, to_char(start_ts + i * period, 'IYYY\"w\"IW'), parent,\n                       start_ts + i * period, start_ts + (i + 1) * period);\n    END LOOP;\n    FOR part IN\n        SELECT c.oid::regclass AS rel FROM pg_inherits i JOIN pg_class c ON c.oid = i.inhrelid\n         WHERE i.inhparent = parent ORDER BY c.relname DESC OFFSET keep + ahead + 1\n    LOOP\n        EXECUTE format('DROP TABLE %s', part.rel);\n    END LOOP;\nEND $$;\n\nCREATE TABLE control.stop_flags (\n    flag_id bigserial PRIMARY KEY,\n    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n    value text, active boolean NOT NULL DEFAULT true, reason text NOT NULL,\n    set_by text NOT NULL DEFAULT current_user, set_at timestamptz NOT NULL DEFAULT now()\n);\n\nCREATE TABLE approvals.grants (\n    approval_id uuid PRIMARY KEY, run_id uuid NOT NULL, agent_instance_id text NOT NULL, subject text NOT NULL,\n    operation text NOT NULL, target text NOT NULL, args_sha256 char(64) NOT NULL, args jsonb NOT NULL,\n    tool_use_id text NOT NULL, description text NOT NULL,\n    requested_at timestamptz NOT NULL, expires_at timestamptz NOT NULL,\n    approved_by text, approved_at timestamptz, used_at timestamptz\n);\n\nCREATE TABLE quota.usage (\n    scope text NOT NULL, key text NOT NULL, window_start timestamptz NOT NULL,\n    runs integer NOT NULL DEFAULT 0, tokens bigint NOT NULL DEFAULT 0, cost_usd numeric(12, 4) NOT NULL DEFAULT 0,\n    PRIMARY KEY (scope, key, window_start)\n);\n\nCREATE TABLE retrieval.index_state (id int PRIMARY KEY CHECK (id = 1), version text NOT NULL);\nCREATE TABLE retrieval.chunks (\n    chunk_id text PRIMARY KEY, doc_id text NOT NULL, source text NOT NULL,\n    added_at timestamptz NOT NULL DEFAULT now(), added_by text NOT NULL DEFAULT current_user,\n    trust text NOT NULL CHECK (trust IN ('reviewed', 'hr_authored')),\n    audience text NOT NULL CHECK (audience IN ('all', 'employee')),\n    allowed_employees text[] NOT NULL DEFAULT '{}',\n    expires_at timestamptz, quarantined boolean NOT NULL DEFAULT false, text text NOT NULL,\n    tsv tsvector GENERATED ALWAYS AS (to_tsvector('english', text)) STORED\n);\nCREATE INDEX ON retrieval.chunks USING gin (tsv);\n\nGRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\nGRANT INSERT ON audit.events TO hr_agent;\nGRANT SELECT ON control.stop_flags TO hr_agent;\nGRANT SELECT, INSERT ON approvals.grants TO hr_agent;\nGRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\nGRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\nGRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n\nGRANT USAGE ON SCHEMA audit, control TO hr_gateway;\nGRANT INSERT ON audit.gateway_decisions TO hr_gateway;\nGRANT SELECT ON control.stop_flags TO hr_gateway;\n\nGRANT USAGE ON SCHEMA control TO hr_agent_operator;\nGRANT SELECT, INSERT, UPDATE ON control.stop_flags TO hr_agent_operator;\nGRANT USAGE ON SEQUENCE control.stop_flags_flag_id_seq TO hr_agent_operator;\n\nGRANT USAGE ON SCHEMA audit TO hr_audit_reader, hr_audit_maint;\nGRANT SELECT ON ALL TABLES IN SCHEMA audit TO hr_audit_reader;\nREVOKE EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) FROM PUBLIC;\nGRANT EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) TO hr_audit_maint;\n\nGRANT USAGE ON SCHEMA retrieval TO hr_docs_ingest;\nGRANT SELECT, INSERT, UPDATE ON retrieval.chunks, retrieval.index_state TO hr_docs_ingest;","is_error":false}]},"parent_tool_use_id":null,"session_id":"5c0e1d7c-1c3d-4042-9555-abf3c43a76e6","uuid":"0eefd86e-01bc-48e9-8d92-1d330e8e7dc2","timestamp":"2026-11-21T11:43:47.747Z","tool_use_result":{"stdout":"(eval):1: no matches found: --include=*\n     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport logging\n     6\timport os\n     7\timport uuid\n     8\t\n     9\timport asyncpg\n    10\timport httpx\n    11\timport jwt\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n    15\tfrom opentelemetry.sdk.resources import Resource\n    16\tfrom opentelemetry.sdk.trace import TracerProvider\n    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n    18\tfrom starlette.applications import Starlette\n    19\tfrom starlette.requests import Request\n    20\tfrom starlette.responses import JSONResponse\n    21\tfrom starlette.routing import Route\n    22\t\n    23\tfrom . import type_id\n    24\tfrom .agent import Agent, RunState\n    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n    27\tfrom .budgets import BudgetExceeded, QuotaStore\n    28\tfrom .credentials import CredentialBroker\n    29\tfrom .gateway_client import GatewayClient\n    30\tfrom .killswitch import Stopped, StopControl\n    31\tfrom .redact import RedactingFilter\n    32\tfrom .retrieval import PolicyIndex\n    33\tfrom .tools import ToolRegistry, load_yaml\n    34\tfrom .validation import sanitize_reply\n    35\t\n    36\tSSO_ISSUER = \"https://sso.acme.example\"\n    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    39\t\n    40\tlogging.basicConfig(level=logging.INFO)\n    41\tfor h in logging.getLogger().handlers:\n    42\t    h.addFilter(RedactingFilter())\n    43\tlog = logging.getLogger(\"hr_agent\")\n    44\t\n    45\tCFG = load_yaml(\"agent.yaml\")\n    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n    47\tPOD_ID = os.environ[\"POD_UID\"]\n    48\t\n    49\tprovider = TracerProvider(resource=Resource.create({\n    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n    51\t}))\n    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n    53\ttrace.set_tracer_provider(provider)\n    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n    55\t\n    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n    57\tagent: Agent\n    58\taudit: AuditWriter\n    59\tapprovals: ApprovalStore\n    60\tstop: StopControl\n    61\t\n    62\t\n    63\tdef _employee(request: Request) -> tuple[str, str]:\n    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n    65\t    auth = request.headers.get(\"authorization\", \"\")\n    66\t    if not auth.startswith(\"Bearer \"):\n    67\t        raise PermissionError(\"missing token\")\n    68\t    token = auth[7:]\n    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n    72\t        raise PermissionError(\"wrong organisation\")\n    73\t    return claims[\"employee_id\"], token\n    74\t\n    75\t\n    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n    77\t    a = CFG[\"agent\"]\n    78\t    return RunContext(\n    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n    81\t        agent_principal=a[\"workload_identity\"],\n    82\t    )\n    83\t\n    84\t\n    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n    86\t    task = asyncio.ensure_future(coro)\n    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n    88\t    try:\n    89\t        return await task\n    90\t    except asyncio.CancelledError:\n    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n    92\t        return None\n    93\t    except Stopped as exc:\n    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n    95\t        return None\n    96\t    finally:\n    97\t        watcher.cancel()\n    98\t\n    99\t\n   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n   101\t    if state is None:\n   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n   105\t    if state.pending_approval:\n   106\t        body[\"approval\"] = state.pending_approval\n   107\t    return JSONResponse(body)\n   108\t\n   109\t\n   110\tasync def chat(request: Request) -> JSONResponse:\n   111\t    try:\n   112\t        employee_id, token = _employee(request)\n   113\t    except (jwt.PyJWTError, PermissionError):\n   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n   116\t    run_id = str(uuid.uuid4())\n   117\t    ctx = _context(run_id, employee_id)\n   118\t    with tracer.start_as_current_span(\"chat\"):\n   119\t        try:\n   120\t            await agent.quotas.reserve_run(ctx)\n   121\t            state = agent.new_state(text, token)\n   122\t            _runs[run_id] = (ctx, state)\n   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n   124\t            state = await _drive(ctx, agent.run(ctx, state))\n   125\t        except BudgetExceeded as exc:\n   126\t            await audit.record(ctx, \"quota_denied\", decision=\"deny\", reason=exc.limit)\n   127\t            return JSONResponse({\"error\": \"quota_exceeded\"}, status_code=429)\n   128\t        except AuditUnavailable:\n   129\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   130\t        except Exception as exc:\n   131\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__)\n   132\t            raise\n   133\t        return _reply(run_id, state)\n   134\t\n   135\t\n   136\tasync def confirm(request: Request) -> JSONResponse:\n   137\t    try:\n   138\t        employee_id, token = _employee(request)\n   139\t    except (jwt.PyJWTError, PermissionError):\n   140\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   141\t    run_id, approval_id = request.path_params[\"run_id\"], request.path_params[\"approval_id\"]\n   142\t    entry = _runs.get(run_id)\n   143\t    if entry is None or entry[0].subject != employee_id:\n   144\t        return JSONResponse({\"error\": \"not_found\"}, status_code=404)\n   145\t    ctx, state = entry\n   146\t    state.subject_token = token\n   147\t    with tracer.start_as_current_span(\"approval.confirm\"):\n   148\t        try:\n   149\t            await approvals.confirm(approval_id, employee_id)\n   150\t            await audit.record(ctx, \"approval_granted\", decision=\"allow\", approval_id=approval_id)\n   151\t            state = await _drive(ctx, agent.resume_with_approval(ctx, state, approval_id))\n   152\t        except ApprovalInvalid as exc:\n   153\t            await audit.record(ctx, \"approval_rejected\", decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   154\t            return JSONResponse({\"error\": \"approval_invalid\"}, status_code=409)\n   155\t        except AuditUnavailable:\n   156\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   157\t        except Exception as exc:\n   158\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__, approval_id=approval_id)\n   159\t            raise\n   160\t        return _reply(run_id, state)\n   161\t\n   162\t\n   163\tasync def startup() -> None:\n   164\t    global agent, audit, approvals, stop\n   165\t    pool = await asyncpg.create_pool(os.environ[\"DATABASE_URL\"], min_size=2, max_size=20)\n   166\t    registry = ToolRegistry.from_config()\n   167\t    mtls = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\", cert=(\"/etc/svid/svid.pem\", \"/etc/svid/svid_key.pem\"))\n   168\t    audit = AuditWriter(pool, registry.policy_version)\n   169\t    approvals = ApprovalStore(pool, CFG[\"approvals\"][\"ttl_seconds\"])\n   170\t    stop = StopControl(pool, CFG[\"stop\"][\"poll_seconds\"])\n   171\t    agent = Agent(\n   172\t        CFG, registry, AsyncAnthropic(max_retries=1), GatewayClient(mtls, CredentialBroker(mtls)),\n   173\t        PolicyIndex(pool, CFG[\"retrieval\"][\"top_k\"], CFG[\"retrieval\"][\"cache_ttl_seconds\"]),\n   174\t        approvals, QuotaStore(pool, CFG[\"budgets\"][\"quotas\"]), audit, stop,\n   175\t    )\n   176\t\n   177\t\n   178\tapp = Starlette(\n   179\t    routes=[\n   180\t        Route(\"/v1/chat\", chat, methods=[\"POST\"]),\n   181\t        Route(\"/v1/runs/{run_id}/approvals/{approval_id}/confirm\", confirm, methods=[\"POST\"]),\n   182\t    ],\n   183\t    on_startup=[startup],\n   184\t)\n# hr-helpdesk-agent\n\nAn HR helpdesk assistant for Acme employees. It answers policy questions from the HR handbook,\nshows the signed-in employee their own leave balance, files leave requests (the manager approves\nthem in HRIS), and hands conversations to an HR advisor.\n\n## Components\n\n| Component | Code | Identity |\n|---|---|---|\n| Agent API and loop | `src/main.py`, `src/agent.py` | SA `hr-helpdesk-agent`, SPIFFE SVID |\n| Tool gateway | `src/gateway.py` | SA `hr-tool-gateway` |\n| HRIS MCP server | owned by hris-platform | `spiffe://acme.example/ns/hris/sa/hris-mcp` |\n| Helpdesk MCP server | owned by it-service-desk | `spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp` |\n| Audit, approvals, quotas, stop flags, handbook index | Postgres (`migrations/001_init.sql`) | per-component DB roles |\n\n## How a request flows\n\n1. The HR portal sends the employee's SSO token. `main.py` verifies issuer, audience, expiry and\n   organisation; the employee id and tenant come only from that token.\n2. The loop (`agent.py`) checks the stop flags and the run budget before every model call, and\n   records usage against per-user, tenant and fleet quotas.\n3. Tool calls are looked up by exact name in `config/tools.yaml`. Arguments are schema-checked.\n   `file_leave_request` and `escalate_to_human` pause the run and show the employee exactly what\n   will be sent; the approval is bound to the run instance, operation, target and argument hash,\n   expires after 10 minutes, and is consumed once.\n4. MCP calls go to the gateway with a 300-second token for that one tool scope, minted by STS\n   from the agent's workload identity and the employee's token. The gateway verifies the token\n   and its certificate binding, checks scope, stop flags, rate limits and argument schema, swaps\n   the token for one addressed to the MCP server, and validates the response schema.\n5. Tool output is size-, schema- and content-checked and redacted before the model sees it.\n   Handbook passages are filtered at query time to documents the employee may see.\n6. Every step writes an `audit.events` row with the six identity fields and trace context.\n   If the audit write fails, the run stops.\n\nEscalations are delivered even during gateway maintenance windows.\n\n## Stopping the agent\n\nOperators with the `hr_agent_operator` DB role insert into `control.stop_flags`:\n\n```sql\nINSERT INTO control.stop_flags (scope, value, reason) VALUES ('fleet', NULL, 'incident 2291');\n-- or scope 'agent_type' / 'agent_instance' / 'subject' / 'agent_principal'\n```\n\nRunning agents see the flag within 2 seconds and cancel in-flight work; the gateway refuses\ncalls immediately. Target stop time: 10 seconds. The agent's DB role can only read this table.\nLast drill: see `docs/drills/` in the ops repo.\n\n## Audit retention\n\nAudit records are kept for six months (Acme records policy; employment-related AI use in the EU).\nPartitions are created and dropped nightly by `k8s/audit-maintenance.yaml`. Access is limited to\n`hr_audit_reader`.\n\n## Releases\n\nMerges to `main` build, sign and attest the image, compute the agent-type-id over every file in\n`src/`, `prompts/`, `config/`, plus `requirements.txt`, `Dockerfile`, the image digest and the model\nrecord, and stamp `release/manifest.yaml`. Pods refuse to start if the type id they compute\ndiffers from the one they were deployed with. Kyverno admits only signed images built by this\nworkflow from `main`.\nrelease:\n  name: hr-helpdesk-agent\n  version: \"1.8.0\"\n  git_sha: \"\"            # stamped by CI\n  agent_type_id: \"\"      # stamped by CI (src/type_id.py, scheme acme-agent-type-id/v1)\n  image:\n    repository: registry.acme.example/people/hr-helpdesk-agent\n    digest: \"\"           # stamped by CI\n    signer: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    sbom: attached (BuildKit SPDX)\n    provenance: SLSA v1 via actions/attest-build-provenance\n  owners:\n    accountable_party: \"VP People Operations\"\n    operational_owner: people-platform\n\nstakes:\n  rating: moderate\n  autonomy: low (every write requires the employee's confirmation)\n  rationale: >-\n    Reads one employee's own leave data and the handbook; writes are leave requests that a\n    manager must still approve in HRIS, and helpdesk tickets. Worst credible harm: disclosure of\n    one employee's HR data to another employee, or a misleading policy answer.\n  approved_by: \"Head of Security Engineering, 2026-09-19\"\n\ncapability_combination:\n  untrusted_input: yes (employee messages, handbook passages, tool output)\n  sensitive_access: yes (leave records, employee-specific HR documents)\n  external_change_or_send: yes (leave requests, helpdesk tickets)\n  containment: every consequential tool requires per-action employee approval bound to args\n\nharness:\n  files: [src/]\n  entrypoints: {agent: \"src.main:app\", gateway: \"src.gateway:app\"}\nsystem_prompt: {path: prompts/system.md}\nrules_files: []\nconfiguration: [config/agent.yaml, config/tools.yaml]\n\nmodels:\n  primary:\n    role: main agent\n    owner: people-platform\n    identity: {provider: anthropic, id: claude-sonnet-4-5-20250929, pinning: snapshot, adapter: none}\n    pinning_source: \"Anthropic models overview, checked 2026-09-15\"\n    served_version: recorded per call in audit.events.model_served\n    fine_tune: none\n    training_runs: not applicable\n    training_data: provider-undisclosed\n  helpers: []            # retrieval is Postgres full-text search; no embedding or reranker model\n\ntools:\n  built_in: []\n  local: [search_policies]\n  mcp_servers:\n    - {id: hris, identity: \"spiffe://acme.example/ns/hris/sa/hris-mcp\", owner: hris-platform, tools: [get_leave_balance, file_leave_request]}\n    - {id: helpdesk, identity: \"spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\", owner: it-service-desk, tools: [create_ticket]}\n  policy_version_source: config/tools.yaml#policy_version\n\npermissions:\n  sts_scopes: [hr.policy.read, hris.leave.read, hris.leave.request, helpdesk.ticket.create]\n  token_ttl_seconds: 300\n  database_role: hr_agent (see migrations/001_init.sql grants)\n\nmemory: none (conversation state is held per run and discarded; no cross-run memory)\nretrieval:\n  store: retrieval.chunks (Postgres FTS)\n  writers: [hr_docs_ingest]\n  filters: [quarantined, expires_at, audience/allowed_employees]\n\nidentity_bindings:\n  agent: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n  gateway: spiffe://acme.example/ns/hr-agent/sa/hr-tool-gateway\n\nnetwork: [k8s/networkpolicy.yaml]\nadmission: [k8s/admission.yaml]\nbudgets: config/agent.yaml#budgets\n\naudit:\n  store: audit.events, audit.gateway_decisions (Postgres, weekly partitions)\n  retention: 6 months\n  readers: hr_audit_reader\n*                         @acme/people-platform\n/prompts/                 @acme/people-platform @acme/hr-policy-reviewers\n/config/                  @acme/people-platform @acme/security-engineering\n/src/gateway.py           @acme/people-platform @acme/security-engineering\n/src/approvals.py         @acme/people-platform @acme/security-engineering\n/k8s/                     @acme/people-platform @acme/platform-security\n/migrations/              @acme/people-platform @acme/data-platform\n/release/                 @acme/people-platform @acme/security-engineering\n/.github/                 @acme/platform-security\n/CODEOWNERS               @acme/platform-security\n-- Roles (created by the platform team): hr_agent, hr_gateway, hr_agent_operator,\n-- hr_audit_reader, hr_audit_maint, hr_docs_ingest.\nCREATE SCHEMA audit; CREATE SCHEMA control; CREATE SCHEMA approvals; CREATE SCHEMA quota; CREATE SCHEMA retrieval;\n\nCREATE TABLE audit.events (\n    event_id uuid NOT NULL, ts timestamptz NOT NULL, event_type text NOT NULL,\n    run_id uuid NOT NULL, step_id uuid, parent_step_id uuid,\n    accountable_party text NOT NULL, operational_owner text NOT NULL, tenant text NOT NULL,\n    agent_type_id text NOT NULL, agent_instance_id text NOT NULL,\n    trace_id char(32) NOT NULL, span_id char(16) NOT NULL, traceparent text NOT NULL,\n    delegated_subject text NOT NULL, agent_principal text NOT NULL,\n    tool text, operation_target text, decision text, reason text, policy_version text NOT NULL, approval_id uuid,\n    args_redacted jsonb, result_redacted jsonb,\n    context_tokens integer, context_tokens_method text, model_requested text, model_served text,\n    PRIMARY KEY (event_id, ts)\n) PARTITION BY RANGE (ts);\nCREATE INDEX ON audit.events (trace_id);\nCREATE INDEX ON audit.events (run_id, ts);\n\nCREATE TABLE audit.gateway_decisions (\n    ts timestamptz NOT NULL, traceparent text NOT NULL, tenant text NOT NULL,\n    accountable_party text NOT NULL, operational_owner text NOT NULL,\n    agent_type_id_hint text NOT NULL, agent_instance_hint text NOT NULL,   -- caller-supplied; join key only\n    subject text, actor text, tool text, decision text NOT NULL, reason text, policy_version text NOT NULL\n) PARTITION BY RANGE (ts);\n\n-- Creates `ahead` partitions into the future and drops partitions older than the newest `keep`.\nCREATE FUNCTION audit.maintain_partitions(parent regclass, period interval, ahead int, keep int)\nRETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = audit, pg_temp AS $$\nDECLARE\n    start_ts timestamptz := date_trunc('week', now());\n    part record;\nBEGIN\n    FOR i IN 0..ahead LOOP\n        EXECUTE format('CREATE TABLE IF NOT EXISTS %s_%s PARTITION OF %s FOR VALUES FROM (%L) TO (%L)',\n                       parent, to_char(start_ts + i * period, 'IYYY\"w\"IW'), parent,\n                       start_ts + i * period, start_ts + (i + 1) * period);\n    END LOOP;\n    FOR part IN\n        SELECT c.oid::regclass AS rel FROM pg_inherits i JOIN pg_class c ON c.oid = i.inhrelid\n         WHERE i.inhparent = parent ORDER BY c.relname DESC OFFSET keep + ahead + 1\n    LOOP\n        EXECUTE format('DROP TABLE %s', part.rel);\n    END LOOP;\nEND $$;\n\nCREATE TABLE control.stop_flags (\n    flag_id bigserial PRIMARY KEY,\n    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n    value text, active boolean NOT NULL DEFAULT true, reason text NOT NULL,\n    set_by text NOT NULL DEFAULT current_user, set_at timestamptz NOT NULL DEFAULT now()\n);\n\nCREATE TABLE approvals.grants (\n    approval_id uuid PRIMARY KEY, run_id uuid NOT NULL, agent_instance_id text NOT NULL, subject text NOT NULL,\n    operation text NOT NULL, target text NOT NULL, args_sha256 char(64) NOT NULL, args jsonb NOT NULL,\n    tool_use_id text NOT NULL, description text NOT NULL,\n    requested_at timestamptz NOT NULL, expires_at timestamptz NOT NULL,\n    approved_by text, approved_at timestamptz, used_at timestamptz\n);\n\nCREATE TABLE quota.usage (\n    scope text NOT NULL, key text NOT NULL, window_start timestamptz NOT NULL,\n    runs integer NOT NULL DEFAULT 0, tokens bigint NOT NULL DEFAULT 0, cost_usd numeric(12, 4) NOT NULL DEFAULT 0,\n    PRIMARY KEY (scope, key, window_start)\n);\n\nCREATE TABLE retrieval.index_state (id int PRIMARY KEY CHECK (id = 1), version text NOT NULL);\nCREATE TABLE retrieval.chunks (\n    chunk_id text PRIMARY KEY, doc_id text NOT NULL, source text NOT NULL,\n    added_at timestamptz NOT NULL DEFAULT now(), added_by text NOT NULL DEFAULT current_user,\n    trust text NOT NULL CHECK (trust IN ('reviewed', 'hr_authored')),\n    audience text NOT NULL CHECK (audience IN ('all', 'employee')),\n    allowed_employees text[] NOT NULL DEFAULT '{}',\n    expires_at timestamptz, quarantined boolean NOT NULL DEFAULT false, text text NOT NULL,\n    tsv tsvector GENERATED ALWAYS AS (to_tsvector('english', text)) STORED\n);\nCREATE INDEX ON retrieval.chunks USING gin (tsv);\n\nGRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\nGRANT INSERT ON audit.events TO hr_agent;\nGRANT SELECT ON control.stop_flags TO hr_agent;\nGRANT SELECT, INSERT ON approvals.grants TO hr_agent;\nGRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\nGRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\nGRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n\nGRANT USAGE ON SCHEMA audit, control TO hr_gateway;\nGRANT INSERT ON audit.gateway_decisions TO hr_gateway;\nGRANT SELECT ON control.stop_flags TO hr_gateway;\n\nGRANT USAGE ON SCHEMA control TO hr_agent_operator;\nGRANT SELECT, INSERT, UPDATE ON control.stop_flags TO hr_agent_operator;\nGRANT USAGE ON SEQUENCE control.stop_flags_flag_id_seq TO hr_agent_operator;\n\nGRANT USAGE ON SCHEMA audit TO hr_audit_reader, hr_audit_maint;\nGRANT SELECT ON ALL TABLES IN SCHEMA audit TO hr_audit_reader;\nREVOKE EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) FROM PUBLIC;\nGRANT EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) TO hr_audit_maint;\n\nGRANT USAGE ON SCHEMA retrieval TO hr_docs_ingest;\nGRANT SELECT, INSERT, UPDATE ON retrieval.chunks, retrieval.index_state TO hr_docs_ingest;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01A21etsdvvkcvt8DHMtbMC1","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
