\",\"for spec in (s for s in MCP_TOOLS if s.server == server_id):\",\"Discovered tools are only matched by exact name against registry specs; unmatched tools stay disabled.\",\n \"Searched for list_tools or tools/list use outside the gateway refresh; the agent never discovers tools and only the gateway calls tools/list (gateway.py:62). Failure path disables everything (gateway.py:212).\",\n rows=[row(\"gateway tools/list discovery\",\"src/gateway.py:62\",'resp = await _upstream.post(server[\"endpoint\"], json={\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/list\"}, timeout=5.0)',\"Discovery result is only used inside the gateway fingerprint refresh.\"),\n  row(\"allowlist filter\",\"src/gateway.py:70\",\"if local in live and fingerprint(live[local]) == spec.fingerprint:\",\"Only registry tools whose live fingerprint matches are enabled.\"),\n  row(\"call-time check\",\"src/gateway.py:166\",'if spec is None or spec.kind != \"mcp\" or tool in _disabled:',\"A call to any unlisted or disabled tool is refused with 403.\"),\n  row(\"refresh failure path\",\"src/gateway.py:212\",\"_disabled.update(s.qualified for s in MCP_TOOLS)\",\"A failed refresh disables every MCP tool instead of enabling any.\"),\n  row(\"model hand-off\",\"src/agent.py:72\",\"tools=self.registry.model_schemas()\",\"The model never sees discovered tools, only registry entries.\")])\ncheck(\"B01.3\",\"no\",\"src/gateway_client.py:52\",\"if not spec.direct_route:\",\"escalate_to_human has a direct_route, so when the gateway is unavailable the agent calls the helpdesk MCP server directly, skipping the gateway allowlist and disabled-tool checks.\",\n rows=[row(\"registry lookup in agent\",\"src/agent.py:102\",\"if spec is None:\",\"Unknown tool names are denied with an error.\")],\n dev=[dict(subject=\"escalate_to_human fallback\",status=\"missing\",evidence=\"src/gateway_client.py:59\",quote='return await self._post(spec.direct_route[\"endpoint\"], token, spec, args, ctx, operation_id)',note=\"Direct call to the MCP server skips the gateway allowlist, disabled-tool and stop checks.\"),\n      dict(subject=\"direct route config\",status=\"missing\",evidence=\"config/tools.yaml:91\",quote=\"direct_route:\",note=\"Config declares a gateway bypass for this tool.\")])\ncheck(\"B01.4\",\"yes\",\"src/agent.py:113\",'if spec.approval == \"subject\":',\"Approval mode comes from the static approval field in tools.yaml, never from server hints or descriptions.\",\n \"Searched for readOnlyHint, destructiveHint and annotations; only gateway.py:54 reads annotations, to compute a pinned fingerprint that disables a tool on change, never to allow or skip approval.\",\n rows=[row(\"approval decision\",\"src/tools.py:45\",'if t[\"approval\"] not in (\"none\", \"subject\"):',\"Approval mode is a fixed config enum checked at load.\"),\n  row(\"agent approval branch\",\"src/agent.py:113\",'if spec.approval == \"subject\":',\"Approval branch reads only the configured mode.\"),\n  row(\"gateway allow decision\",\"src/gateway.py:166\",'if spec is None or spec.kind != \"mcp\" or tool in _disabled:',\"Allow decision uses registry membership and fingerprint state only.\"),\n  row(\"annotations in fingerprint\",\"src/gateway.py:54\",'material = {k: tool.get(k) for k in (\"name\", \"title\", \"description\", \"inputSchema\", \"outputSchema\", \"annotations\")}',\"Annotations are hashed for change detection only, never interpreted.\")])\ncheck(\"B01.5\",\"yes\",\"k8s/deployment.yaml:58\",\"readOnlyRootFilesystem: true\",\"The agent has no file tool, its code opens only fixed paths, and pod mounts are named and read-only except a small tmp.\",\n \"Searched for open(, fs tools, shell tools and path arguments; found only fixed-path reads in credentials.py, tools.py, gateway.py and agent.py, none with model-controlled paths.\",\n rows=[row(\"tool surface has no file tool\",\"config/tools.yaml:17\",\"tools:\",\"Four registry tools; none takes a path or reads files.\"),\n  row(\"actor token read