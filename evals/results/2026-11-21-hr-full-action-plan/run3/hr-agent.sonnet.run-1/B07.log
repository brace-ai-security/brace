{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016XL8H5fmr54uVKguu11uZo","type":"tool_result","content":"1\t\"\"\"Hard limits enforced by the harness, outside the model.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport time\n5\tfrom collections import deque\n6\tfrom dataclasses import dataclass, field\n7\tfrom typing import Any\n8\t\n9\timport asyncpg\n10\t\n11\tfrom .audit import RunContext\n12\t\n13\t\n14\tclass BudgetExceeded(Exception):\n15\t    def __init__(self, limit: str):\n16\t        super().__init__(limit)\n17\t        self.limit = limit\n18\t\n19\t\n20\t@dataclass\n21\tclass RunBudget:\n22\t    cfg: dict[str, Any]\n23\t    pricing: dict[str, float]\n24\t    started: float = field(default_factory=time.monotonic)\n25\t    steps: int = 0\n26\t    tokens: int = 0\n27\t    cost_usd: float = 0.0\n28\t    tool_calls: deque = field(default_factory=deque)\n29\t\n30\t    def check_step(self) -> None:\n31\t        if self.steps >= self.cfg[\"max_steps\"]:\n32\t            raise BudgetExceeded(\"max_steps\")\n33\t        if time.monotonic() - self.started > self.cfg[\"max_wall_seconds\"]:\n34\t            raise BudgetExceeded(\"max_wall_seconds\")\n35\t        if self.tokens >= self.cfg[\"max_total_tokens\"]:\n36\t            raise BudgetExceeded(\"max_total_tokens\")\n37\t        if self.cost_usd >= self.cfg[\"max_cost_usd\"]:\n38\t            raise BudgetExceeded(\"max_cost_usd\")\n39\t        self.steps += 1\n40\t\n41\t    def remaining_seconds(self) -> float:\n42\t        return max(0.0, self.cfg[\"max_wall_seconds\"] - (time.monotonic() - self.started))\n43\t\n44\t    def record_usage(self, usage: Any) -> tuple[int, float]:\n45\t        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n46\t        cache_write = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n47\t        tokens_in = usage.input_tokens + cache_read + cache_write\n48\t        tokens = tokens_in + usage.output_tokens\n49\t        cost = (\n50\t            (usage.input_tokens + cache_write) * self.pricing[\"input_per_mtok\"]\n51\t            + cache_read * self.pricing[\"cache_read_per_mtok\"]\n52\t            + usage.output_tokens * self.pricing[\"output_per_mtok\"]\n53\t        ) / 1_000_000\n54\t        self.tokens += tokens\n55\t        self.cost_usd += cost\n56\t        return tokens, cost\n57\t\n58\t    def check_tool_call(self) -> None:\n59\t        now = time.monotonic()\n60\t        while self.tool_calls and now - self.tool_calls[0] > 60:\n61\t            self.tool_calls.popleft()\n62\t        if len(self.tool_calls) >= self.cfg[\"max_tool_calls_per_minute\"]:\n63\t            raise BudgetExceeded(\"max_tool_calls_per_minute\")\n64\t        self.tool_calls.append(now)\n65\t\n66\t    def check_subagent(self, started_so_far: int) -> None:\n67\t        if started_so_far >= self.cfg[\"max_subagents\"]:\n68\t            raise BudgetExceeded(\"max_subagents\")\n69\t\n70\t\n71\t_WINDOW = \"to_timestamp(floor(extract(epoch FROM now()) / $3) * $3)\"\n72\t\n73\t_RESERVE_RUN = f\"\"\"\n74\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n75\tVALUES ($1, $2, {_WINDOW}, 1, 0, 0)\n76\tON CONFLICT (scope, key, window_start) DO UPDATE\n77\t   SET runs = quota.usage.runs + 1\n78\t WHERE quota.usage.runs + 1 <= $4\n79\t   AND quota.usage.tokens < $5\n80\t   AND quota.usage.cost_usd < $6\n81\tRETURNING runs\n82\t\"\"\"\n83\t\n84\t_RECORD_USAGE = f\"\"\"\n85\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n86\tVALUES ($1, $2, {_WINDOW}, 0, $4, $5)\n87\tON CONFLICT (scope, key, window_start) DO UPDATE\n88\t   SET tokens = quota.usage.tokens + EXCLUDED.tokens,\n89\t       cost_usd = quota.usage.cost_usd + EXCLUDED.cost_usd\n90\tRETURNING tokens, cost_usd\n91\t\"\"\"\n92\t\n93\t\n94\tclass QuotaStore:\n95\t    \"\"\"Per-user, per-tenant and fleet-wide quotas, shared by every replica.\"\"\"\n96\t\n97\t    def __init__(self, pool: asyncpg.Pool, quotas: list[dict[str, Any]]):\n98\t        self._pool = pool\n99\t        self._quotas = quotas\n100\t\n101\t    def _key(self, scope: str, ctx: RunContext) -> str:\n102\t        return {\"user\": ctx.subject, \"tenant\": ctx.tenant, \"fleet\": \"all\"}[scope]\n103\t\n104\t    async def reserve_run(self, ctx: RunContext) -> None:\n105\t        async with self._pool.acquire() as conn, conn.transaction():\n106\t            for q in self._quotas:\n107\t                row = await conn.fetchrow(\n108\t                    _RESERVE_RUN, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"],\n109\t                    q[\"max_runs\"], q[\"max_tokens\"], q[\"max_cost_usd\"],\n110\t                )\n111\t                if row is None:\n112\t                    raise BudgetExceeded(f\"quota:{q['scope']}\")\n113\t\n114\t    async def record_usage(self, ctx: RunContext, tokens: int, cost_usd: float) -> None:\n115\t        \"\"\"Usage already spent is always recorded; the run stops once any window is over its limit.\"\"\"\n116\t        exceeded: str | None = None\n117\t        async with self._pool.acquire() as conn, conn.transaction():\n118\t            for q in self._quotas:\n119\t                row = await conn.fetchrow(\n120\t                    _RECORD_USAGE, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"], tokens, cost_usd\n121\t                )\n122\t                if row[\"tokens\"] >= q[\"max_tokens\"] or row[\"cost_usd\"] >= q[\"max_cost_usd\"]:\n123\t                    exceeded = exceeded or f\"quota:{q['scope']}\"\n124\t        if exceeded:\n125\t            raise BudgetExceeded(exceeded)\n126\t"}]},"parent_tool_use_id":null,"session_id":"0a27d388-71fe-43a1-8895-fdfbe1de2cd4","uuid":"941ce88a-84cb-4cd8-ba0e-395ddc13852e","timestamp":"2026-11-21T12:17:42.055Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-3x7p5ehr/agent/src/budgets.py","content":"\"\"\"Hard limits enforced by the harness, outside the model.\"\"\"\nfrom __future__ import annotations\n\nimport time\nfrom collections import deque\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nimport asyncpg\n\nfrom .audit import RunContext\n\n\nclass BudgetExceeded(Exception):\n    def __init__(self, limit: str):\n        super().__init__(limit)\n        self.limit = limit\n\n\n@dataclass\nclass RunBudget:\n    cfg: dict[str, Any]\n    pricing: dict[str, float]\n    started: float = field(default_factory=time.monotonic)\n    steps: int = 0\n    tokens: int = 0\n    cost_usd: float = 0.0\n    tool_calls: deque = field(default_factory=deque)\n\n    def check_step(self) -> None:\n        if self.steps >= self.cfg[\"max_steps\"]:\n            raise BudgetExceeded(\"max_steps\")\n        if time.monotonic() - self.started > self.cfg[\"max_wall_seconds\"]:\n            raise BudgetExceeded(\"max_wall_seconds\")\n        if self.tokens >= self.cfg[\"max_total_tokens\"]:\n            raise BudgetExceeded(\"max_total_tokens\")\n        if self.cost_usd >= self.cfg[\"max_cost_usd\"]:\n            raise BudgetExceeded(\"max_cost_usd\")\n        self.steps += 1\n\n    def remaining_seconds(self) -> float:\n        return max(0.0, self.cfg[\"max_wall_seconds\"] - (time.monotonic() - self.started))\n\n    def record_usage(self, usage: Any) -> tuple[int, float]:\n        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n        cache_write = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n        tokens_in = usage.input_tokens + cache_read + cache_write\n        tokens = tokens_in + usage.output_tokens\n        cost = (\n            (usage.input_tokens + cache_write) * self.pricing[\"input_per_mtok\"]\n            + cache_read * self.pricing[\"cache_read_per_mtok\"]\n            + usage.output_tokens * self.pricing[\"output_per_mtok\"]\n        ) / 1_000_000\n        self.tokens += tokens\n        self.cost_usd += cost\n        return tokens, cost\n\n    def check_tool_call(self) -> None:\n        now = time.monotonic()\n        while self.tool_calls and now - self.tool_calls[0] > 60:\n            self.tool_calls.popleft()\n        if len(self.tool_calls) >= self.cfg[\"max_tool_calls_per_minute\"]:\n            raise BudgetExceeded(\"max_tool_calls_per_minute\")\n        self.tool_calls.append(now)\n\n    def check_subagent(self, started_so_far: int) -> None:\n        if started_so_far >= self.cfg[\"max_subagents\"]:\n            raise BudgetExceeded(\"max_subagents\")\n\n\n_WINDOW = \"to_timestamp(floor(extract(epoch FROM now()) / $3) * $3)\"\n\n_RESERVE_RUN = f\"\"\"\nINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\nVALUES ($1, $2, {_WINDOW}, 1, 0, 0)\nON CONFLICT (scope, key, window_start) DO UPDATE\n   SET runs = quota.usage.runs + 1\n WHERE quota.usage.runs + 1 <= $4\n   AND quota.usage.tokens < $5\n   AND quota.usage.cost_usd < $6\nRETURNING runs\n\"\"\"\n\n_RECORD_USAGE = f\"\"\"\nINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\nVALUES ($1, $2, {_WINDOW}, 0, $4, $5)\nON CONFLICT (scope, key, window_start) DO UPDATE\n   SET tokens = quota.usage.tokens + EXCLUDED.tokens,\n       cost_usd = quota.usage.cost_usd + EXCLUDED.cost_usd\nRETURNING tokens, cost_usd\n\"\"\"\n\n\nclass QuotaStore:\n    \"\"\"Per-user, per-tenant and fleet-wide quotas, shared by every replica.\"\"\"\n\n    def __init__(self, pool: asyncpg.Pool, quotas: list[dict[str, Any]]):\n        self._pool = pool\n        self._quotas = quotas\n\n    def _key(self, scope: str, ctx: RunContext) -> str:\n        return {\"user\": ctx.subject, \"tenant\": ctx.tenant, \"fleet\": \"all\"}[scope]\n\n    async def reserve_run(self, ctx: RunContext) -> None:\n        async with self._pool.acquire() as conn, conn.transaction():\n            for q in self._quotas:\n                row = await conn.fetchrow(\n                    _RESERVE_RUN, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"],\n                    q[\"max_runs\"], q[\"max_tokens\"], q[\"max_cost_usd\"],\n                )\n                if row is None:\n                    raise BudgetExceeded(f\"quota:{q['scope']}\")\n\n    async def record_usage(self, ctx: RunContext, tokens: int, cost_usd: float) -> None:\n        \"\"\"Usage already spent is always recorded; the run stops once any window is over its limit.\"\"\"\n        exceeded: str | None = None\n        async with self._pool.acquire() as conn, conn.transaction():\n            for q in self._quotas:\n                row = await conn.fetchrow(\n                    _RECORD_USAGE, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"], tokens, cost_usd\n                )\n                if row[\"tokens\"] >= q[\"max_tokens\"] or row[\"cost_usd\"] >= q[\"max_cost_usd\"]:\n                    exceeded = exceeded or f\"quota:{q['scope']}\"\n        if exceeded:\n            raise BudgetExceeded(exceeded)\n","numLines":126,"startLine":1,"totalLines":126}},"tool_result_meta":[{"id":"toolu_016XL8H5fmr54uVKguu11uZo","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
