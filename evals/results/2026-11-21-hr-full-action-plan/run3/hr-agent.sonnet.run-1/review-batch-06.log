{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChG37Xz6TK2twR6zDukyo","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0119jqKhWcHwjU9LaHFPgQKy","name":"Bash","input":{"command":"cat -n src/main.py src/credentials.py src/killswitch.py config/agent.yaml release/manifest.yaml"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14904,"cache_read_input_tokens":20443,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14904},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71f043ed-19c9-490b-9dd2-a2aeb708a377","uuid":"9b773598-f647-4d18-8e97-064e5b7937c9","timestamp":"2026-11-21T12:01:01.241Z","request_id":"req_011ChG37XpvKCXPr9xTEhTGL","wire_tool_inputs":{"toolu_0119jqKhWcHwjU9LaHFPgQKy":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-yewkl197/agent && cat -n src/main.py src/credentials.py src/killswitch.py config/agent.yaml release/manifest.yaml"}},"wire_ingest_context":{"toolu_0119jqKhWcHwjU9LaHFPgQKy":{"cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-batch-yewkl197/agent"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0119jqKhWcHwjU9LaHFPgQKy","type":"tool_result","content":"     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport logging\n     6\timport os\n     7\timport uuid\n     8\t\n     9\timport asyncpg\n    10\timport httpx\n    11\timport jwt\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n    15\tfrom opentelemetry.sdk.resources import Resource\n    16\tfrom opentelemetry.sdk.trace import TracerProvider\n    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n    18\tfrom starlette.applications import Starlette\n    19\tfrom starlette.requests import Request\n    20\tfrom starlette.responses import JSONResponse\n    21\tfrom starlette.routing import Route\n    22\t\n    23\tfrom . import type_id\n    24\tfrom .agent import Agent, RunState\n    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n    27\tfrom .budgets import BudgetExceeded, QuotaStore\n    28\tfrom .credentials import CredentialBroker\n    29\tfrom .gateway_client import GatewayClient\n    30\tfrom .killswitch import Stopped, StopControl\n    31\tfrom .redact import RedactingFilter\n    32\tfrom .retrieval import PolicyIndex\n    33\tfrom .tools import ToolRegistry, load_yaml\n    34\tfrom .validation import sanitize_reply\n    35\t\n    36\tSSO_ISSUER = \"https://sso.acme.example\"\n    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    39\t\n    40\tlogging.basicConfig(level=logging.INFO)\n    41\tfor h in logging.getLogger().handlers:\n    42\t    h.addFilter(RedactingFilter())\n    43\tlog = logging.getLogger(\"hr_agent\")\n    44\t\n    45\tCFG = load_yaml(\"agent.yaml\")\n    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n    47\tPOD_ID = os.environ[\"POD_UID\"]\n    48\t\n    49\tprovider = TracerProvider(resource=Resource.create({\n    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n    51\t}))\n    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n    53\ttrace.set_tracer_provider(provider)\n    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n    55\t\n    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n    57\tagent: Agent\n    58\taudit: AuditWriter\n    59\tapprovals: ApprovalStore\n    60\tstop: StopControl\n    61\t\n    62\t\n    63\tdef _employee(request: Request) -> tuple[str, str]:\n    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n    65\t    auth = request.headers.get(\"authorization\", \"\")\n    66\t    if not auth.startswith(\"Bearer \"):\n    67\t        raise PermissionError(\"missing token\")\n    68\t    token = auth[7:]\n    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n    72\t        raise PermissionError(\"wrong organisation\")\n    73\t    return claims[\"employee_id\"], token\n    74\t\n    75\t\n    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n    77\t    a = CFG[\"agent\"]\n    78\t    return RunContext(\n    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n    81\t        agent_principal=a[\"workload_identity\"],\n    82\t    )\n    83\t\n    84\t\n    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n    86\t    task = asyncio.ensure_future(coro)\n    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n    88\t    try:\n    89\t        return await task\n    90\t    except asyncio.CancelledError:\n    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n    92\t        return None\n    93\t    except Stopped as exc:\n    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n    95\t        return None\n    96\t    finally:\n    97\t        watcher.cancel()\n    98\t\n    99\t\n   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n   101\t    if state is None:\n   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n   105\t    if state.pending_approval:\n   106\t        body[\"approval\"] = state.pending_approval\n   107\t    return JSONResponse(body)\n   108\t\n   109\t\n   110\tasync def chat(request: Request) -> JSONResponse:\n   111\t    try:\n   112\t        employee_id, token = _employee(request)\n   113\t    except (jwt.PyJWTError, PermissionError):\n   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n   116\t    run_id = str(uuid.uuid4())\n   117\t    ctx = _context(run_id, employee_id)\n   118\t    with tracer.start_as_current_span(\"chat\"):\n   119\t        try:\n   120\t            await agent.quotas.reserve_run(ctx)\n   121\t            state = agent.new_state(text, token)\n   122\t            _runs[run_id] = (ctx, state)\n   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n   124\t            state = await _drive(ctx, agent.run(ctx, state))\n   125\t        except BudgetExceeded as exc:\n   126\t            await audit.record(ctx, \"quota_denied\", decision=\"deny\", reason=exc.limit)\n   127\t            return JSONResponse({\"error\": \"quota_exceeded\"}, status_code=429)\n   128\t        except AuditUnavailable:\n   129\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   130\t        except Exception as exc:\n   131\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__)\n   132\t            raise\n   133\t        return _reply(run_id, state)\n   134\t\n   135\t\n   136\tasync def confirm(request: Request) -> JSONResponse:\n   137\t    try:\n   138\t        employee_id, token = _employee(request)\n   139\t    except (jwt.PyJWTError, PermissionError):\n   140\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   141\t    run_id, approval_id = request.path_params[\"run_id\"], request.path_params[\"approval_id\"]\n   142\t    entry = _runs.get(run_id)\n   143\t    if entry is None or entry[0].subject != employee_id:\n   144\t        return JSONResponse({\"error\": \"not_found\"}, status_code=404)\n   145\t    ctx, state = entry\n   146\t    state.subject_token = token\n   147\t    with tracer.start_as_current_span(\"approval.confirm\"):\n   148\t        try:\n   149\t            await approvals.confirm(approval_id, employee_id)\n   150\t            await audit.record(ctx, \"approval_granted\", decision=\"allow\", approval_id=approval_id)\n   151\t            state = await _drive(ctx, agent.resume_with_approval(ctx, state, approval_id))\n   152\t        except ApprovalInvalid as exc:\n   153\t            await audit.record(ctx, \"approval_rejected\", decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   154\t            return JSONResponse({\"error\": \"approval_invalid\"}, status_code=409)\n   155\t        except AuditUnavailable:\n   156\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   157\t        except Exception as exc:\n   158\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__, approval_id=approval_id)\n   159\t            raise\n   160\t        return _reply(run_id, state)\n   161\t\n   162\t\n   163\tasync def startup() -> None:\n   164\t    global agent, audit, approvals, stop\n   165\t    pool = await asyncpg.create_pool(os.environ[\"DATABASE_URL\"], min_size=2, max_size=20)\n   166\t    registry = ToolRegistry.from_config()\n   167\t    mtls = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\", cert=(\"/etc/svid/svid.pem\", \"/etc/svid/svid_key.pem\"))\n   168\t    audit = AuditWriter(pool, registry.policy_version)\n   169\t    approvals = ApprovalStore(pool, CFG[\"approvals\"][\"ttl_seconds\"])\n   170\t    stop = StopControl(pool, CFG[\"stop\"][\"poll_seconds\"])\n   171\t    agent = Agent(\n   172\t        CFG, registry, AsyncAnthropic(max_retries=1), GatewayClient(mtls, CredentialBroker(mtls)),\n   173\t        PolicyIndex(pool, CFG[\"retrieval\"][\"top_k\"], CFG[\"retrieval\"][\"cache_ttl_seconds\"]),\n   174\t        approvals, QuotaStore(pool, CFG[\"budgets\"][\"quotas\"]), audit, stop,\n   175\t    )\n   176\t\n   177\t\n   178\tapp = Starlette(\n   179\t    routes=[\n   180\t        Route(\"/v1/chat\", chat, methods=[\"POST\"]),\n   181\t        Route(\"/v1/runs/{run_id}/approvals/{approval_id}/confirm\", confirm, methods=[\"POST\"]),\n   182\t    ],\n   183\t    on_startup=[startup],\n   184\t)\n     1\t\"\"\"Per-tool, per-employee, short-lived tokens for the agent's own workload identity.\n     2\t\n     3\tThe pod's projected service-account token (audience sts.acme.example, 10 min) is the\n     4\tactor token. The employee's verified SSO token is the subject token. The STS returns an\n     5\tRFC 8693 token whose `sub` is the employee, `act.sub` is this workload, `aud` is the\n     6\trequested audience, `scope` is exactly one tool scope, and `cnf.x5t#S256` binds it to the\n     7\tpod's mTLS certificate. Lifetime is 300 s: long enough for one approval-to-execute window\n     8\ton a single call, short enough that a copied token is useless after the run.\n     9\t\"\"\"\n    10\tfrom __future__ import annotations\n    11\t\n    12\timport asyncio\n    13\timport time\n    14\tfrom dataclasses import dataclass\n    15\t\n    16\timport httpx\n    17\t\n    18\tSTS_URL = \"https://sts.identity.svc.cluster.local/oauth2/token\"\n    19\tACTOR_TOKEN_PATH = \"/var/run/secrets/tokens/sts-token\"\n    20\tTOKEN_TTL_SECONDS = 300\n    21\tREFRESH_MARGIN_SECONDS = 30\n    22\t\n    23\t\n    24\t@dataclass\n    25\tclass _Cached:\n    26\t    token: str\n    27\t    expires_at: float\n    28\t\n    29\t\n    30\tclass CredentialBroker:\n    31\t    def __init__(self, client: httpx.AsyncClient):\n    32\t        self._client = client  # configured with the pod's SPIFFE SVID for mTLS\n    33\t        self._cache: dict[tuple[str, str, str], _Cached] = {}\n    34\t        self._lock = asyncio.Lock()\n    35\t\n    36\t    def _actor_token(self) -> str:\n    37\t        # Re-read each time: kubelet rotates the projected token on disk.\n    38\t        with open(ACTOR_TOKEN_PATH, encoding=\"utf-8\") as fh:\n    39\t            return fh.read().strip()\n    40\t\n    41\t    async def token(self, *, audience: str, scope: str, subject_token: str, subject: str) -> str:\n    42\t        key = (audience, scope, subject)\n    43\t        async with self._lock:\n    44\t            hit = self._cache.get(key)\n    45\t            if hit and hit.expires_at - REFRESH_MARGIN_SECONDS > time.time():\n    46\t                return hit.token\n    47\t            resp = await self._client.post(\n    48\t                STS_URL,\n    49\t                data={\n    50\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    51\t                    \"subject_token\": subject_token,\n    52\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:id_token\",\n    53\t                    \"actor_token\": self._actor_token(),\n    54\t                    \"actor_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n    55\t                    \"audience\": audience,\n    56\t                    \"scope\": scope,\n    57\t                    \"requested_token_type\": \"urn:ietf:params:oauth:token-type:access_token\",\n    58\t                    \"requested_ttl\": str(TOKEN_TTL_SECONDS),\n    59\t                },\n    60\t                timeout=3.0,\n    61\t            )\n    62\t            resp.raise_for_status()\n    63\t            body = resp.json()\n    64\t            ttl = min(int(body.get(\"expires_in\", TOKEN_TTL_SECONDS)), TOKEN_TTL_SECONDS)\n    65\t            self._cache[key] = _Cached(body[\"access_token\"], time.time() + ttl)\n    66\t            return body[\"access_token\"]\n    67\t\n    68\t    def drop_subject(self, subject: str) -> None:\n    69\t        for key in [k for k in self._cache if k[2] == subject]:\n    70\t            del self._cache[key]\n     1\t\"\"\"Stop control. Flags live in control.stop_flags, which the agent's DB role can only read.\n     2\t\n     3\tOperators set flags with the hr_agent_operator role (see README \"Stopping the agent\").\n     4\tThe tool gateway reads the same table, so a stopped instance is refused there too.\n     5\t\"\"\"\n     6\tfrom __future__ import annotations\n     7\t\n     8\timport asyncio\n     9\timport logging\n    10\t\n    11\timport asyncpg\n    12\t\n    13\tfrom .audit import RunContext\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.stop\")\n    16\t\n    17\t_QUERY = \"\"\"\n    18\tSELECT reason FROM control.stop_flags\n    19\tWHERE active\n    20\t  AND (   scope = 'fleet'\n    21\t       OR (scope = 'agent_type'     AND value = $1)\n    22\t       OR (scope = 'agent_instance' AND value = $2)\n    23\t       OR (scope = 'subject'        AND value = $3)\n    24\t       OR (scope = 'agent_principal' AND value = $4))\n    25\tLIMIT 1\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass Stopped(Exception):\n    30\t    pass\n    31\t\n    32\t\n    33\tclass StopControl:\n    34\t    def __init__(self, pool: asyncpg.Pool, poll_seconds: float):\n    35\t        self._pool = pool\n    36\t        self._poll = poll_seconds\n    37\t\n    38\t    async def reason(self, ctx: RunContext) -> str | None:\n    39\t        try:\n    40\t            row = await self._pool.fetchrow(\n    41\t                _QUERY, ctx.agent_type_id, ctx.agent_instance_id, ctx.subject, ctx.agent_principal, timeout=1.0\n    42\t            )\n    43\t        except Exception:\n    44\t            return \"stop store unreachable\"\n    45\t        return row[\"reason\"] if row else None\n    46\t\n    47\t    async def raise_if_stopped(self, ctx: RunContext) -> None:\n    48\t        why = await self.reason(ctx)\n    49\t        if why:\n    50\t            raise Stopped(why)\n    51\t\n    52\t    async def watch(self, ctx: RunContext, task: asyncio.Task) -> None:\n    53\t        \"\"\"Cancel the run task, including any in-flight model or tool call, once a flag appears.\"\"\"\n    54\t        while not task.done():\n    55\t            why = await self.reason(ctx)\n    56\t            if why:\n    57\t                log.warning(\"stop flag observed\", extra={\"run_id\": ctx.run_id, \"reason\": why})\n    58\t                task.cancel(msg=f\"stopped: {why}\")\n    59\t                return\n    60\t            await asyncio.sleep(self._poll)\n     1\tagent:\n     2\t  name: hr-helpdesk\n     3\t  accountable_party: \"VP People Operations <people-ops-lead@acme.example>\"\n     4\t  operational_owner: \"people-platform (pager: people-platform-oncall)\"\n     5\t  tenant: acme\n     6\t  workload_identity: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n     7\t\n     8\tmodel:\n     9\t  provider: anthropic\n    10\t  id: claude-sonnet-4-5-20250929\n    11\t  pinning: snapshot          # dated snapshot ID per provider model docs, checked 2026-09-15\n    12\t  adapter: none\n    13\t  max_output_tokens: 1024\n    14\t  temperature: 0.2\n    15\t\n    16\tbudgets:\n    17\t  run:\n    18\t    max_steps: 12\n    19\t    max_wall_seconds: 90\n    20\t    max_total_tokens: 60000\n    21\t    max_cost_usd: 0.40\n    22\t    max_tool_calls_per_minute: 20\n    23\t    max_subagents: 0\n    24\t  quotas:\n    25\t    - scope: user\n    26\t      window_seconds: 86400\n    27\t      max_runs: 150\n    28\t      max_tokens: 400000\n    29\t      max_cost_usd: 3.00\n    30\t    - scope: tenant\n    31\t      window_seconds: 3600\n    32\t      max_runs: 20000\n    33\t      max_tokens: 15000000\n    34\t      max_cost_usd: 250.00\n    35\t    - scope: fleet\n    36\t      window_seconds: 3600\n    37\t      max_runs: 25000\n    38\t      max_tokens: 20000000\n    39\t      max_cost_usd: 300.00\n    40\t\n    41\tpricing:\n    42\t  input_per_mtok: 3.00\n    43\t  output_per_mtok: 15.00\n    44\t  cache_read_per_mtok: 0.30\n    45\t\n    46\tapprovals:\n    47\t  ttl_seconds: 600\n    48\t\n    49\tstop:\n    50\t  poll_seconds: 2\n    51\t  max_stop_seconds: 10\n    52\t\n    53\tretrieval:\n    54\t  top_k: 5\n    55\t  cache_ttl_seconds: 900\n    56\t  max_chunk_chars: 4000\n    57\t\n    58\tlimits:\n    59\t  max_tool_output_bytes: 16384\n    60\t  max_user_message_chars: 4000\n    61\t\n    62\toutput:\n    63\t  allowed_link_hosts: [hr.acme.example, handbook.acme.example]\n     1\trelease:\n     2\t  name: hr-helpdesk-agent\n     3\t  version: \"1.8.0\"\n     4\t  git_sha: \"\"            # stamped by CI\n     5\t  agent_type_id: \"\"      # stamped by CI (src/type_id.py, scheme acme-agent-type-id/v1)\n     6\t  image:\n     7\t    repository: registry.acme.example/people/hr-helpdesk-agent\n     8\t    digest: \"\"           # stamped by CI\n     9\t    signer: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    10\t    sbom: attached (BuildKit SPDX)\n    11\t    provenance: SLSA v1 via actions/attest-build-provenance\n    12\t  owners:\n    13\t    accountable_party: \"VP People Operations\"\n    14\t    operational_owner: people-platform\n    15\t\n    16\tstakes:\n    17\t  rating: moderate\n    18\t  autonomy: low (every write requires the employee's confirmation)\n    19\t  rationale: >-\n    20\t    Reads one employee's own leave data and the handbook; writes are leave requests that a\n    21\t    manager must still approve in HRIS, and helpdesk tickets. Worst credible harm: disclosure of\n    22\t    one employee's HR data to another employee, or a misleading policy answer.\n    23\t  approved_by: \"Head of Security Engineering, 2026-09-19\"\n    24\t\n    25\tcapability_combination:\n    26\t  untrusted_input: yes (employee messages, handbook passages, tool output)\n    27\t  sensitive_access: yes (leave records, employee-specific HR documents)\n    28\t  external_change_or_send: yes (leave requests, helpdesk tickets)\n    29\t  containment: every consequential tool requires per-action employee approval bound to args\n    30\t\n    31\tharness:\n    32\t  files: [src/]\n    33\t  entrypoints: {agent: \"src.main:app\", gateway: \"src.gateway:app\"}\n    34\tsystem_prompt: {path: prompts/system.md}\n    35\trules_files: []\n    36\tconfiguration: [config/agent.yaml, config/tools.yaml]\n    37\t\n    38\tmodels:\n    39\t  primary:\n    40\t    role: main agent\n    41\t    owner: people-platform\n    42\t    identity: {provider: anthropic, id: claude-sonnet-4-5-20250929, pinning: snapshot, adapter: none}\n    43\t    pinning_source: \"Anthropic models overview, checked 2026-09-15\"\n    44\t    served_version: recorded per call in audit.events.model_served\n    45\t    fine_tune: none\n    46\t    training_runs: not applicable\n    47\t    training_data: provider-undisclosed\n    48\t  helpers: []            # retrieval is Postgres full-text search; no embedding or reranker model\n    49\t\n    50\ttools:\n    51\t  built_in: []\n    52\t  local: [search_policies]\n    53\t  mcp_servers:\n    54\t    - {id: hris, identity: \"spiffe://acme.example/ns/hris/sa/hris-mcp\", owner: hris-platform, tools: [get_leave_balance, file_leave_request]}\n    55\t    - {id: helpdesk, identity: \"spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\", owner: it-service-desk, tools: [create_ticket]}\n    56\t  policy_version_source: config/tools.yaml#policy_version\n    57\t\n    58\tpermissions:\n    59\t  sts_scopes: [hr.policy.read, hris.leave.read, hris.leave.request, helpdesk.ticket.create]\n    60\t  token_ttl_seconds: 300\n    61\t  database_role: hr_agent (see migrations/001_init.sql grants)\n    62\t\n    63\tmemory: none (conversation state is held per run and discarded; no cross-run memory)\n    64\tretrieval:\n    65\t  store: retrieval.chunks (Postgres FTS)\n    66\t  writers: [hr_docs_ingest]\n    67\t  filters: [quarantined, expires_at, audience/allowed_employees]\n    68\t\n    69\tidentity_bindings:\n    70\t  agent: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n    71\t  gateway: spiffe://acme.example/ns/hr-agent/sa/hr-tool-gateway\n    72\t\n    73\tnetwork: [k8s/networkpolicy.yaml]\n    74\tadmission: [k8s/admission.yaml]\n    75\tbudgets: config/agent.yaml#budgets\n    76\t\n    77\taudit:\n    78\t  store: audit.events, audit.gateway_decisions (Postgres, weekly partitions)\n    79\t  retention: 6 months\n    80\t  readers: hr_audit_reader","is_error":false}]},"parent_tool_use_id":null,"session_id":"71f043ed-19c9-490b-9dd2-a2aeb708a377","uuid":"ae8ac36b-e383-4c9a-bf1e-5cad6448dbfa","timestamp":"2026-11-21T12:01:01.273Z","tool_use_result":{"stdout":"     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport logging\n     6\timport os\n     7\timport uuid\n     8\t\n     9\timport asyncpg\n    10\timport httpx\n    11\timport jwt\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n    15\tfrom opentelemetry.sdk.resources import Resource\n    16\tfrom opentelemetry.sdk.trace import TracerProvider\n    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n    18\tfrom starlette.applications import Starlette\n    19\tfrom starlette.requests import Request\n    20\tfrom starlette.responses import JSONResponse\n    21\tfrom starlette.routing import Route\n    22\t\n    23\tfrom . import type_id\n    24\tfrom .agent import Agent, RunState\n    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n    27\tfrom .budgets import BudgetExceeded, QuotaStore\n    28\tfrom .credentials import CredentialBroker\n    29\tfrom .gateway_client import GatewayClient\n    30\tfrom .killswitch import Stopped, StopControl\n    31\tfrom .redact import RedactingFilter\n    32\tfrom .retrieval import PolicyIndex\n    33\tfrom .tools import ToolRegistry, load_yaml\n    34\tfrom .validation import sanitize_reply\n    35\t\n    36\tSSO_ISSUER = \"https://sso.acme.example\"\n    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    39\t\n    40\tlogging.basicConfig(level=logging.INFO)\n    41\tfor h in logging.getLogger().handlers:\n    42\t    h.addFilter(RedactingFilter())\n    43\tlog = logging.getLogger(\"hr_agent\")\n    44\t\n    45\tCFG = load_yaml(\"agent.yaml\")\n    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n    47\tPOD_ID = os.environ[\"POD_UID\"]\n    48\t\n    49\tprovider = TracerProvider(resource=Resource.create({\n    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n    51\t}))\n    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n    53\ttrace.set_tracer_provider(provider)\n    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n    55\t\n    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n    57\tagent: Agent\n    58\taudit: AuditWriter\n    59\tapprovals: ApprovalStore\n    60\tstop: StopControl\n    61\t\n    62\t\n    63\tdef _employee(request: Request) -> tuple[str, str]:\n    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n    65\t    auth = request.headers.get(\"authorization\", \"\")\n    66\t    if not auth.startswith(\"Bearer \"):\n    67\t        raise PermissionError(\"missing token\")\n    68\t    token = auth[7:]\n    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n    72\t        raise PermissionError(\"wrong organisation\")\n    73\t    return claims[\"employee_id\"], token\n    74\t\n    75\t\n    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n    77\t    a = CFG[\"agent\"]\n    78\t    return RunContext(\n    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n    81\t        agent_principal=a[\"workload_identity\"],\n    82\t    )\n    83\t\n    84\t\n    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n    86\t    task = asyncio.ensure_future(coro)\n    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n    88\t    try:\n    89\t        return await task\n    90\t    except asyncio.CancelledError:\n    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n    92\t        return None\n    93\t    except Stopped as exc:\n    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n    95\t        return None\n    96\t    finally:\n    97\t        watcher.cancel()\n    98\t\n    99\t\n   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n   101\t    if state is None:\n   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n   105\t    if state.pending_approval:\n   106\t        body[\"approval\"] = state.pending_approval\n   107\t    return JSONResponse(body)\n   108\t\n   109\t\n   110\tasync def chat(request: Request) -> JSONResponse:\n   111\t    try:\n   112\t        employee_id, token = _employee(request)\n   113\t    except (jwt.PyJWTError, PermissionError):\n   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n   116\t    run_id = str(uuid.uuid4())\n   117\t    ctx = _context(run_id, employee_id)\n   118\t    with tracer.start_as_current_span(\"chat\"):\n   119\t        try:\n   120\t            await agent.quotas.reserve_run(ctx)\n   121\t            state = agent.new_state(text, token)\n   122\t            _runs[run_id] = (ctx, state)\n   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n   124\t            state = await _drive(ctx, agent.run(ctx, state))\n   125\t        except BudgetExceeded as exc:\n   126\t            await audit.record(ctx, \"quota_denied\", decision=\"deny\", reason=exc.limit)\n   127\t            return JSONResponse({\"error\": \"quota_exceeded\"}, status_code=429)\n   128\t        except AuditUnavailable:\n   129\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   130\t        except Exception as exc:\n   131\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__)\n   132\t            raise\n   133\t        return _reply(run_id, state)\n   134\t\n   135\t\n   136\tasync def confirm(request: Request) -> JSONResponse:\n   137\t    try:\n   138\t        employee_id, token = _employee(request)\n   139\t    except (jwt.PyJWTError, PermissionError):\n   140\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   141\t    run_id, approval_id = request.path_params[\"run_id\"], request.path_params[\"approval_id\"]\n   142\t    entry = _runs.get(run_id)\n   143\t    if entry is None or entry[0].subject != employee_id:\n   144\t        return JSONResponse({\"error\": \"not_found\"}, status_code=404)\n   145\t    ctx, state = entry\n   146\t    state.subject_token = token\n   147\t    with tracer.start_as_current_span(\"approval.confirm\"):\n   148\t        try:\n   149\t            await approvals.confirm(approval_id, employee_id)\n   150\t            await audit.record(ctx, \"approval_granted\", decision=\"allow\", approval_id=approval_id)\n   151\t            state = await _drive(ctx, agent.resume_with_approval(ctx, state, approval_id))\n   152\t        except ApprovalInvalid as exc:\n   153\t            await audit.record(ctx, \"approval_rejected\", decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   154\t            return JSONResponse({\"error\": \"approval_invalid\"}, status_code=409)\n   155\t        except AuditUnavailable:\n   156\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   157\t        except Exception as exc:\n   158\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__, approval_id=approval_id)\n   159\t            raise\n   160\t        return _reply(run_id, state)\n   161\t\n   162\t\n   163\tasync def startup() -> None:\n   164\t    global agent, audit, approvals, stop\n   165\t    pool = await asyncpg.create_pool(os.environ[\"DATABASE_URL\"], min_size=2, max_size=20)\n   166\t    registry = ToolRegistry.from_config()\n   167\t    mtls = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\", cert=(\"/etc/svid/svid.pem\", \"/etc/svid/svid_key.pem\"))\n   168\t    audit = AuditWriter(pool, registry.policy_version)\n   169\t    approvals = ApprovalStore(pool, CFG[\"approvals\"][\"ttl_seconds\"])\n   170\t    stop = StopControl(pool, CFG[\"stop\"][\"poll_seconds\"])\n   171\t    agent = Agent(\n   172\t        CFG, registry, AsyncAnthropic(max_retries=1), GatewayClient(mtls, CredentialBroker(mtls)),\n   173\t        PolicyIndex(pool, CFG[\"retrieval\"][\"top_k\"], CFG[\"retrieval\"][\"cache_ttl_seconds\"]),\n   174\t        approvals, QuotaStore(pool, CFG[\"budgets\"][\"quotas\"]), audit, stop,\n   175\t    )\n   176\t\n   177\t\n   178\tapp = Starlette(\n   179\t    routes=[\n   180\t        Route(\"/v1/chat\", chat, methods=[\"POST\"]),\n   181\t        Route(\"/v1/runs/{run_id}/approvals/{approval_id}/confirm\", confirm, methods=[\"POST\"]),\n   182\t    ],\n   183\t    on_startup=[startup],\n   184\t)\n     1\t\"\"\"Per-tool, per-employee, short-lived tokens for the agent's own workload identity.\n     2\t\n     3\tThe pod's projected service-account token (audience sts.acme.example, 10 min) is the\n     4\tactor token. The employee's verified SSO token is the subject token. The STS returns an\n     5\tRFC 8693 token whose `sub` is the employee, `act.sub` is this workload, `aud` is the\n     6\trequested audience, `scope` is exactly one tool scope, and `cnf.x5t#S256` binds it to the\n     7\tpod's mTLS certificate. Lifetime is 300 s: long enough for one approval-to-execute window\n     8\ton a single call, short enough that a copied token is useless after the run.\n     9\t\"\"\"\n    10\tfrom __future__ import annotations\n    11\t\n    12\timport asyncio\n    13\timport time\n    14\tfrom dataclasses import dataclass\n    15\t\n    16\timport httpx\n    17\t\n    18\tSTS_URL = \"https://sts.identity.svc.cluster.local/oauth2/token\"\n    19\tACTOR_TOKEN_PATH = \"/var/run/secrets/tokens/sts-token\"\n    20\tTOKEN_TTL_SECONDS = 300\n    21\tREFRESH_MARGIN_SECONDS = 30\n    22\t\n    23\t\n    24\t@dataclass\n    25\tclass _Cached:\n    26\t    token: str\n    27\t    expires_at: float\n    28\t\n    29\t\n    30\tclass CredentialBroker:\n    31\t    def __init__(self, client: httpx.AsyncClient):\n    32\t        self._client = client  # configured with the pod's SPIFFE SVID for mTLS\n    33\t        self._cache: dict[tuple[str, str, str], _Cached] = {}\n    34\t        self._lock = asyncio.Lock()\n    35\t\n    36\t    def _actor_token(self) -> str:\n    37\t        # Re-read each time: kubelet rotates the projected token on disk.\n    38\t        with open(ACTOR_TOKEN_PATH, encoding=\"utf-8\") as fh:\n    39\t            return fh.read().strip()\n    40\t\n    41\t    async def token(self, *, audience: str, scope: str, subject_token: str, subject: str) -> str:\n    42\t        key = (audience, scope, subject)\n    43\t        async with self._lock:\n    44\t            hit = self._cache.get(key)\n    45\t            if hit and hit.expires_at - REFRESH_MARGIN_SECONDS > time.time():\n    46\t                return hit.token\n    47\t            resp = await self._client.post(\n    48\t                STS_URL,\n    49\t                data={\n    50\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    51\t                    \"subject_token\": subject_token,\n    52\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:id_token\",\n    53\t                    \"actor_token\": self._actor_token(),\n    54\t                    \"actor_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n    55\t                    \"audience\": audience,\n    56\t                    \"scope\": scope,\n    57\t                    \"requested_token_type\": \"urn:ietf:params:oauth:token-type:access_token\",\n    58\t                    \"requested_ttl\": str(TOKEN_TTL_SECONDS),\n    59\t                },\n    60\t                timeout=3.0,\n    61\t            )\n    62\t            resp.raise_for_status()\n    63\t            body = resp.json()\n    64\t            ttl = min(int(body.get(\"expires_in\", TOKEN_TTL_SECONDS)), TOKEN_TTL_SECONDS)\n    65\t            self._cache[key] = _Cached(body[\"access_token\"], time.time() + ttl)\n    66\t            return body[\"access_token\"]\n    67\t\n    68\t    def drop_subject(self, subject: str) -> None:\n    69\t        for key in [k for k in self._cache if k[2] == subject]:\n    70\t            del self._cache[key]\n     1\t\"\"\"Stop control. Flags live in control.stop_flags, which the agent's DB role can only read.\n     2\t\n     3\tOperators set flags with the hr_agent_operator role (see README \"Stopping the agent\").\n     4\tThe tool gateway reads the same table, so a stopped instance is refused there too.\n     5\t\"\"\"\n     6\tfrom __future__ import annotations\n     7\t\n     8\timport asyncio\n     9\timport logging\n    10\t\n    11\timport asyncpg\n    12\t\n    13\tfrom .audit import RunContext\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.stop\")\n    16\t\n    17\t_QUERY = \"\"\"\n    18\tSELECT reason FROM control.stop_flags\n    19\tWHERE active\n    20\t  AND (   scope = 'fleet'\n    21\t       OR (scope = 'agent_type'     AND value = $1)\n    22\t       OR (scope = 'agent_instance' AND value = $2)\n    23\t       OR (scope = 'subject'        AND value = $3)\n    24\t       OR (scope = 'agent_principal' AND value = $4))\n    25\tLIMIT 1\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass Stopped(Exception):\n    30\t    pass\n    31\t\n    32\t\n    33\tclass StopControl:\n    34\t    def __init__(self, pool: asyncpg.Pool, poll_seconds: float):\n    35\t        self._pool = pool\n    36\t        self._poll = poll_seconds\n    37\t\n    38\t    async def reason(self, ctx: RunContext) -> str | None:\n    39\t        try:\n    40\t            row = await self._pool.fetchrow(\n    41\t                _QUERY, ctx.agent_type_id, ctx.agent_instance_id, ctx.subject, ctx.agent_principal, timeout=1.0\n    42\t            )\n    43\t        except Exception:\n    44\t            return \"stop store unreachable\"\n    45\t        return row[\"reason\"] if row else None\n    46\t\n    47\t    async def raise_if_stopped(self, ctx: RunContext) -> None:\n    48\t        why = await self.reason(ctx)\n    49\t        if why:\n    50\t            raise Stopped(why)\n    51\t\n    52\t    async def watch(self, ctx: RunContext, task: asyncio.Task) -> None:\n    53\t        \"\"\"Cancel the run task, including any in-flight model or tool call, once a flag appears.\"\"\"\n    54\t        while not task.done():\n    55\t            why = await self.reason(ctx)\n    56\t            if why:\n    57\t                log.warning(\"stop flag observed\", extra={\"run_id\": ctx.run_id, \"reason\": why})\n    58\t                task.cancel(msg=f\"stopped: {why}\")\n    59\t                return\n    60\t            await asyncio.sleep(self._poll)\n     1\tagent:\n     2\t  name: hr-helpdesk\n     3\t  accountable_party: \"VP People Operations <people-ops-lead@acme.example>\"\n     4\t  operational_owner: \"people-platform (pager: people-platform-oncall)\"\n     5\t  tenant: acme\n     6\t  workload_identity: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n     7\t\n     8\tmodel:\n     9\t  provider: anthropic\n    10\t  id: claude-sonnet-4-5-20250929\n    11\t  pinning: snapshot          # dated snapshot ID per provider model docs, checked 2026-09-15\n    12\t  adapter: none\n    13\t  max_output_tokens: 1024\n    14\t  temperature: 0.2\n    15\t\n    16\tbudgets:\n    17\t  run:\n    18\t    max_steps: 12\n    19\t    max_wall_seconds: 90\n    20\t    max_total_tokens: 60000\n    21\t    max_cost_usd: 0.40\n    22\t    max_tool_calls_per_minute: 20\n    23\t    max_subagents: 0\n    24\t  quotas:\n    25\t    - scope: user\n    26\t      window_seconds: 86400\n    27\t      max_runs: 150\n    28\t      max_tokens: 400000\n    29\t      max_cost_usd: 3.00\n    30\t    - scope: tenant\n    31\t      window_seconds: 3600\n    32\t      max_runs: 20000\n    33\t      max_tokens: 15000000\n    34\t      max_cost_usd: 250.00\n    35\t    - scope: fleet\n    36\t      window_seconds: 3600\n    37\t      max_runs: 25000\n    38\t      max_tokens: 20000000\n    39\t      max_cost_usd: 300.00\n    40\t\n    41\tpricing:\n    42\t  input_per_mtok: 3.00\n    43\t  output_per_mtok: 15.00\n    44\t  cache_read_per_mtok: 0.30\n    45\t\n    46\tapprovals:\n    47\t  ttl_seconds: 600\n    48\t\n    49\tstop:\n    50\t  poll_seconds: 2\n    51\t  max_stop_seconds: 10\n    52\t\n    53\tretrieval:\n    54\t  top_k: 5\n    55\t  cache_ttl_seconds: 900\n    56\t  max_chunk_chars: 4000\n    57\t\n    58\tlimits:\n    59\t  max_tool_output_bytes: 16384\n    60\t  max_user_message_chars: 4000\n    61\t\n    62\toutput:\n    63\t  allowed_link_hosts: [hr.acme.example, handbook.acme.example]\n     1\trelease:\n     2\t  name: hr-helpdesk-agent\n     3\t  version: \"1.8.0\"\n     4\t  git_sha: \"\"            # stamped by CI\n     5\t  agent_type_id: \"\"      # stamped by CI (src/type_id.py, scheme acme-agent-type-id/v1)\n     6\t  image:\n     7\t    repository: registry.acme.example/people/hr-helpdesk-agent\n     8\t    digest: \"\"           # stamped by CI\n     9\t    signer: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    10\t    sbom: attached (BuildKit SPDX)\n    11\t    provenance: SLSA v1 via actions/attest-build-provenance\n    12\t  owners:\n    13\t    accountable_party: \"VP People Operations\"\n    14\t    operational_owner: people-platform\n    15\t\n    16\tstakes:\n    17\t  rating: moderate\n    18\t  autonomy: low (every write requires the employee's confirmation)\n    19\t  rationale: >-\n    20\t    Reads one employee's own leave data and the handbook; writes are leave requests that a\n    21\t    manager must still approve in HRIS, and helpdesk tickets. Worst credible harm: disclosure of\n    22\t    one employee's HR data to another employee, or a misleading policy answer.\n    23\t  approved_by: \"Head of Security Engineering, 2026-09-19\"\n    24\t\n    25\tcapability_combination:\n    26\t  untrusted_input: yes (employee messages, handbook passages, tool output)\n    27\t  sensitive_access: yes (leave records, employee-specific HR documents)\n    28\t  external_change_or_send: yes (leave requests, helpdesk tickets)\n    29\t  containment: every consequential tool requires per-action employee approval bound to args\n    30\t\n    31\tharness:\n    32\t  files: [src/]\n    33\t  entrypoints: {agent: \"src.main:app\", gateway: \"src.gateway:app\"}\n    34\tsystem_prompt: {path: prompts/system.md}\n    35\trules_files: []\n    36\tconfiguration: [config/agent.yaml, config/tools.yaml]\n    37\t\n    38\tmodels:\n    39\t  primary:\n    40\t    role: main agent\n    41\t    owner: people-platform\n    42\t    identity: {provider: anthropic, id: claude-sonnet-4-5-20250929, pinning: snapshot, adapter: none}\n    43\t    pinning_source: \"Anthropic models overview, checked 2026-09-15\"\n    44\t    served_version: recorded per call in audit.events.model_served\n    45\t    fine_tune: none\n    46\t    training_runs: not applicable\n    47\t    training_data: provider-undisclosed\n    48\t  helpers: []            # retrieval is Postgres full-text search; no embedding or reranker model\n    49\t\n    50\ttools:\n    51\t  built_in: []\n    52\t  local: [search_policies]\n    53\t  mcp_servers:\n    54\t    - {id: hris, identity: \"spiffe://acme.example/ns/hris/sa/hris-mcp\", owner: hris-platform, tools: [get_leave_balance, file_leave_request]}\n    55\t    - {id: helpdesk, identity: \"spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\", owner: it-service-desk, tools: [create_ticket]}\n    56\t  policy_version_source: config/tools.yaml#policy_version\n    57\t\n    58\tpermissions:\n    59\t  sts_scopes: [hr.policy.read, hris.leave.read, hris.leave.request, helpdesk.ticket.create]\n    60\t  token_ttl_seconds: 300\n    61\t  database_role: hr_agent (see migrations/001_init.sql grants)\n    62\t\n    63\tmemory: none (conversation state is held per run and discarded; no cross-run memory)\n    64\tretrieval:\n    65\t  store: retrieval.chunks (Postgres FTS)\n    66\t  writers: [hr_docs_ingest]\n    67\t  filters: [quarantined, expires_at, audience/allowed_employees]\n    68\t\n    69\tidentity_bindings:\n    70\t  agent: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n    71\t  gateway: spiffe://acme.example/ns/hr-agent/sa/hr-tool-gateway\n    72\t\n    73\tnetwork: [k8s/networkpolicy.yaml]\n    74\tadmission: [k8s/admission.yaml]\n    75\tbudgets: config/agent.yaml#budgets\n    76\t\n    77\taudit:\n    78\t  store: audit.events, audit.gateway_decisions (Postgres, weekly partitions)\n    79\t  retention: 6 months\n    80\t  readers: hr_audit_reader","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0119jqKhWcHwjU9LaHFPgQKy","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
