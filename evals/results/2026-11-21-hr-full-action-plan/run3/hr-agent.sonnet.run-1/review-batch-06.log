{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vrj945U5UZPqRpRkFgvkyF","type":"tool_result","content":"     1\tapiVersion: v1\n     2\tkind: ServiceAccount\n     3\tmetadata:\n     4\t  name: hr-helpdesk-agent\n     5\t  namespace: hr-agent\n     6\tautomountServiceAccountToken: false\n     7\t---\n     8\tapiVersion: v1\n     9\tkind: ServiceAccount\n    10\tmetadata:\n    11\t  name: hr-tool-gateway\n    12\t  namespace: hr-agent\n    13\tautomountServiceAccountToken: false\n    14\t---\n    15\tapiVersion: apps/v1\n    16\tkind: Deployment\n    17\tmetadata:\n    18\t  name: hr-helpdesk-agent\n    19\t  namespace: hr-agent\n    20\t  labels: {app: hr-helpdesk-agent, app.kubernetes.io/part-of: hr-helpdesk}\n    21\tspec:\n    22\t  replicas: 3\n    23\t  selector:\n    24\t    matchLabels: {app: hr-helpdesk-agent}\n    25\t  template:\n    26\t    metadata:\n    27\t      labels: {app: hr-helpdesk-agent}\n    28\t      annotations:\n    29\t        acme.example/release-manifest: \"release/manifest.yaml@${GIT_SHA}\"\n    30\t    spec:\n    31\t      serviceAccountName: hr-helpdesk-agent\n    32\t      automountServiceAccountToken: false\n    33\t      hostUsers: false\n    34\t      enableServiceLinks: false\n    35\t      securityContext:\n    36\t        runAsNonRoot: true\n    37\t        runAsUser: 65532\n    38\t        runAsGroup: 65532\n    39\t        fsGroup: 65532\n    40\t        seccompProfile: {type: RuntimeDefault}\n    41\t      containers:\n    42\t        - name: agent\n    43\t          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n    44\t          args: [\"-m\", \"uvicorn\", \"src.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\"]\n    45\t          ports: [{containerPort: 8080}]\n    46\t          env:\n    47\t            - {name: AGENT_TYPE_ID, value: \"${AGENT_TYPE_ID}\"}\n    48\t            - {name: IMAGE_DIGEST, value: \"${IMAGE_DIGEST}\"}\n    49\t            - name: POD_UID\n    50\t              valueFrom: {fieldRef: {fieldPath: metadata.uid}}\n    51\t            - name: DATABASE_URL\n    52\t              valueFrom: {secretKeyRef: {name: hr-agent-db, key: url}}\n    53\t            - name: ANTHROPIC_API_KEY\n    54\t              valueFrom: {secretKeyRef: {name: hr-agent-anthropic, key: api_key}}\n    55\t            - {name: ANTHROPIC_BASE_URL, value: \"https://api.anthropic.com\"}\n    56\t          securityContext:\n    57\t            allowPrivilegeEscalation: false\n    58\t            readOnlyRootFilesystem: true\n    59\t            privileged: false\n    60\t            capabilities: {drop: [ALL]}\n    61\t          resources:\n    62\t            requests: {cpu: 250m, memory: 384Mi}\n    63\t            limits: {cpu: \"1\", memory: 768Mi}\n    64\t          volumeMounts:\n    65\t            - {name: tmp, mountPath: /tmp}\n    66\t            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n    67\t            - {name: svid, mountPath: /etc/svid, readOnly: true}\n    68\t      volumes:\n    69\t        - name: tmp\n    70\t          emptyDir: {medium: Memory, sizeLimit: 32Mi}\n    71\t        - name: sts-token\n    72\t          projected:\n    73\t            sources:\n    74\t              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n    75\t        - name: svid\n    76\t          csi: {driver: csi.spiffe.io, readOnly: true}\n    77\t---\n    78\tapiVersion: apps/v1\n    79\tkind: Deployment\n    80\tmetadata:\n    81\t  name: hr-tool-gateway\n    82\t  namespace: hr-agent\n    83\t  labels: {app: hr-tool-gateway, app.kubernetes.io/part-of: hr-helpdesk}\n    84\tspec:\n    85\t  replicas: 2\n    86\t  selector:\n    87\t    matchLabels: {app: hr-tool-gateway}\n    88\t  template:\n    89\t    metadata:\n    90\t      labels: {app: hr-tool-gateway}\n    91\t    spec:\n    92\t      serviceAccountName: hr-tool-gateway\n    93\t      automountServiceAccountToken: false\n    94\t      hostUsers: false\n    95\t      enableServiceLinks: false\n    96\t      securityContext:\n    97\t        runAsNonRoot: true\n    98\t        runAsUser: 65532\n    99\t        runAsGroup: 65532\n   100\t        seccompProfile: {type: RuntimeDefault}\n   101\t      containers:\n   102\t        - name: gateway\n   103\t          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n   104\t          args: [\"-m\", \"uvicorn\", \"src.gateway:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8443\"]\n   105\t          ports: [{containerPort: 8443}]\n   106\t          env:\n   107\t            - name: GATEWAY_DATABASE_URL\n   108\t              valueFrom: {secretKeyRef: {name: hr-gateway-db, key: url}}\n   109\t          securityContext:\n   110\t            allowPrivilegeEscalation: false\n   111\t            readOnlyRootFilesystem: true\n   112\t            privileged: false\n   113\t            capabilities: {drop: [ALL]}\n   114\t          volumeMounts:\n   115\t            - {name: tmp, mountPath: /tmp}\n   116\t            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n   117\t            - {name: svid, mountPath: /etc/svid, readOnly: true}\n   118\t      volumes:\n   119\t        - name: tmp\n   120\t          emptyDir: {medium: Memory, sizeLimit: 16Mi}\n   121\t        - name: sts-token\n   122\t          projected:\n   123\t            sources:\n   124\t              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n   125\t        - name: svid\n   126\t          csi: {driver: csi.spiffe.io, readOnly: true}\n   127\t---\n   128\tapiVersion: v1\n   129\tkind: Service\n   130\tmetadata:\n   131\t  name: hr-tool-gateway\n   132\t  namespace: hr-agent\n   133\tspec:\n   134\t  selector: {app: hr-tool-gateway}\n   135\t  ports: [{port: 8443, targetPort: 8443}]\n   136\t---\n   137\tapiVersion: v1\n   138\tkind: Service\n   139\tmetadata:\n   140\t  name: hr-helpdesk-agent\n   141\t  namespace: hr-agent\n   142\tspec:\n   143\t  selector: {app: hr-helpdesk-agent}\n   144\t  sessionAffinity: ClientIP\n   145\t  ports: [{port: 80, targetPort: 8080}]\n     1\t-- Roles (created by the platform team): hr_agent, hr_gateway, hr_agent_operator,\n     2\t-- hr_audit_reader, hr_audit_maint, hr_docs_ingest.\n     3\tCREATE SCHEMA audit; CREATE SCHEMA control; CREATE SCHEMA approvals; CREATE SCHEMA quota; CREATE SCHEMA retrieval;\n     4\t\n     5\tCREATE TABLE audit.events (\n     6\t    event_id uuid NOT NULL, ts timestamptz NOT NULL, event_type text NOT NULL,\n     7\t    run_id uuid NOT NULL, step_id uuid, parent_step_id uuid,\n     8\t    accountable_party text NOT NULL, operational_owner text NOT NULL, tenant text NOT NULL,\n     9\t    agent_type_id text NOT NULL, agent_instance_id text NOT NULL,\n    10\t    trace_id char(32) NOT NULL, span_id char(16) NOT NULL, traceparent text NOT NULL,\n    11\t    delegated_subject text NOT NULL, agent_principal text NOT NULL,\n    12\t    tool text, operation_target text, decision text, reason text, policy_version text NOT NULL, approval_id uuid,\n    13\t    args_redacted jsonb, result_redacted jsonb,\n    14\t    context_tokens integer, context_tokens_method text, model_requested text, model_served text,\n    15\t    PRIMARY KEY (event_id, ts)\n    16\t) PARTITION BY RANGE (ts);\n    17\tCREATE INDEX ON audit.events (trace_id);\n    18\tCREATE INDEX ON audit.events (run_id, ts);\n    19\t\n    20\tCREATE TABLE audit.gateway_decisions (\n    21\t    ts timestamptz NOT NULL, traceparent text NOT NULL, tenant text NOT NULL,\n    22\t    accountable_party text NOT NULL, operational_owner text NOT NULL,\n    23\t    agent_type_id_hint text NOT NULL, agent_instance_hint text NOT NULL,   -- caller-supplied; join key only\n    24\t    subject text, actor text, tool text, decision text NOT NULL, reason text, policy_version text NOT NULL\n    25\t) PARTITION BY RANGE (ts);\n    26\t\n    27\t-- Creates `ahead` partitions into the future and drops partitions older than the newest `keep`.\n    28\tCREATE FUNCTION audit.maintain_partitions(parent regclass, period interval, ahead int, keep int)\n    29\tRETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = audit, pg_temp AS $$\n    30\tDECLARE\n    31\t    start_ts timestamptz := date_trunc('week', now());\n    32\t    part record;\n    33\tBEGIN\n    34\t    FOR i IN 0..ahead LOOP\n    35\t        EXECUTE format('CREATE TABLE IF NOT EXISTS %s_%s PARTITION OF %s FOR VALUES FROM (%L) TO (%L)',\n    36\t                       parent, to_char(start_ts + i * period, 'IYYY\"w\"IW'), parent,\n    37\t                       start_ts + i * period, start_ts + (i + 1) * period);\n    38\t    END LOOP;\n    39\t    FOR part IN\n    40\t        SELECT c.oid::regclass AS rel FROM pg_inherits i JOIN pg_class c ON c.oid = i.inhrelid\n    41\t         WHERE i.inhparent = parent ORDER BY c.relname DESC OFFSET keep + ahead + 1\n    42\t    LOOP\n    43\t        EXECUTE format('DROP TABLE %s', part.rel);\n    44\t    END LOOP;\n    45\tEND $$;\n    46\t\n    47\tCREATE TABLE control.stop_flags (\n    48\t    flag_id bigserial PRIMARY KEY,\n    49\t    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n    50\t    value text, active boolean NOT NULL DEFAULT true, reason text NOT NULL,\n    51\t    set_by text NOT NULL DEFAULT current_user, set_at timestamptz NOT NULL DEFAULT now()\n    52\t);\n    53\t\n    54\tCREATE TABLE approvals.grants (\n    55\t    approval_id uuid PRIMARY KEY, run_id uuid NOT NULL, agent_instance_id text NOT NULL, subject text NOT NULL,\n    56\t    operation text NOT NULL, target text NOT NULL, args_sha256 char(64) NOT NULL, args jsonb NOT NULL,\n    57\t    tool_use_id text NOT NULL, description text NOT NULL,\n    58\t    requested_at timestamptz NOT NULL, expires_at timestamptz NOT NULL,\n    59\t    approved_by text, approved_at timestamptz, used_at timestamptz\n    60\t);\n    61\t\n    62\tCREATE TABLE quota.usage (\n    63\t    scope text NOT NULL, key text NOT NULL, window_start timestamptz NOT NULL,\n    64\t    runs integer NOT NULL DEFAULT 0, tokens bigint NOT NULL DEFAULT 0, cost_usd numeric(12, 4) NOT NULL DEFAULT 0,\n    65\t    PRIMARY KEY (scope, key, window_start)\n    66\t);\n    67\t\n    68\tCREATE TABLE retrieval.index_state (id int PRIMARY KEY CHECK (id = 1), version text NOT NULL);\n    69\tCREATE TABLE retrieval.chunks (\n    70\t    chunk_id text PRIMARY KEY, doc_id text NOT NULL, source text NOT NULL,\n    71\t    added_at timestamptz NOT NULL DEFAULT now(), added_by text NOT NULL DEFAULT current_user,\n    72\t    trust text NOT NULL CHECK (trust IN ('reviewed', 'hr_authored')),\n    73\t    audience text NOT NULL CHECK (audience IN ('all', 'employee')),\n    74\t    allowed_employees text[] NOT NULL DEFAULT '{}',\n    75\t    expires_at timestamptz, quarantined boolean NOT NULL DEFAULT false, text text NOT NULL,\n    76\t    tsv tsvector GENERATED ALWAYS AS (to_tsvector('english', text)) STORED\n    77\t);\n    78\tCREATE INDEX ON retrieval.chunks USING gin (tsv);\n    79\t\n    80\tGRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\n    81\tGRANT INSERT ON audit.events TO hr_agent;\n    82\tGRANT SELECT ON control.stop_flags TO hr_agent;\n    83\tGRANT SELECT, INSERT ON approvals.grants TO hr_agent;\n    84\tGRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\n    85\tGRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\n    86\tGRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n    87\t\n    88\tGRANT USAGE ON SCHEMA audit, control TO hr_gateway;\n    89\tGRANT INSERT ON audit.gateway_decisions TO hr_gateway;\n    90\tGRANT SELECT ON control.stop_flags TO hr_gateway;\n    91\t\n    92\tGRANT USAGE ON SCHEMA control TO hr_agent_operator;\n    93\tGRANT SELECT, INSERT, UPDATE ON control.stop_flags TO hr_agent_operator;\n    94\tGRANT USAGE ON SEQUENCE control.stop_flags_flag_id_seq TO hr_agent_operator;\n    95\t\n    96\tGRANT USAGE ON SCHEMA audit TO hr_audit_reader, hr_audit_maint;\n    97\tGRANT SELECT ON ALL TABLES IN SCHEMA audit TO hr_audit_reader;\n    98\tREVOKE EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) FROM PUBLIC;\n    99\tGRANT EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) TO hr_audit_maint;\n   100\t\n   101\tGRANT USAGE ON SCHEMA retrieval TO hr_docs_ingest;\n   102\tGRANT SELECT, INSERT, UPDATE ON retrieval.chunks, retrieval.index_state TO hr_docs_ingest;\n     1\tapiVersion: batch/v1\n     2\tkind: CronJob\n     3\tmetadata:\n     4\t  name: audit-partition-maintenance\n     5\t  namespace: hr-agent\n     6\t  labels: {app.kubernetes.io/part-of: hr-helpdesk}\n     7\tspec:\n     8\t  schedule: \"17 2 * * *\"\n     9\t  concurrencyPolicy: Forbid\n    10\t  jobTemplate:\n    11\t    spec:\n    12\t      backoffLimit: 2\n    13\t      template:\n    14\t        metadata:\n    15\t          labels: {app: audit-maintenance}\n    16\t        spec:\n    17\t          serviceAccountName: hr-audit-maint\n    18\t          automountServiceAccountToken: false\n    19\t          restartPolicy: OnFailure\n    20\t          securityContext:\n    21\t            runAsNonRoot: true\n    22\t            runAsUser: 70\n    23\t            seccompProfile: {type: RuntimeDefault}\n    24\t          containers:\n    25\t            - name: maintain\n    26\t              image: registry.acme.example/platform/psql@sha256:9b2e61c04d7f3a85e1c6b09d2f4a7e3c58d1b6a0f9e2c47d3b8a15e6f0c9d2a4\n    27\t              env:\n    28\t                - name: PGSERVICE\n    29\t                  value: hr_audit_maint\n    30\t                - name: PERIOD\n    31\t                  value: \"1 week\"\n    32\t                - name: AHEAD\n    33\t                  value: \"4\"\n    34\t                - name: KEEP_PARTITIONS\n    35\t                  value: \"6\"\n    36\t              command: [\"psql\", \"-v\", \"ON_ERROR_STOP=1\", \"-c\"]\n    37\t              args:\n    38\t                - >-\n    39\t                  SELECT audit.maintain_partitions('audit.events', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    40\t                  SELECT audit.maintain_partitions('audit.gateway_decisions', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    41\t              securityContext:\n    42\t                allowPrivilegeEscalation: false\n    43\t                readOnlyRootFilesystem: true\n    44\t                capabilities: {drop: [ALL]}\n    45\t              volumeMounts:\n    46\t                - {name: pgservice, mountPath: /etc/postgresql-common, readOnly: true}\n    47\t          volumes:\n    48\t            - name: pgservice\n    49\t              secret: {secretName: hr-audit-maint-pgservice}\n     1\tname: release\n     2\t\n     3\ton:\n     4\t  push:\n     5\t    branches: [main]\n     6\t\n     7\tpermissions:\n     8\t  contents: read\n     9\t\n    10\tjobs:\n    11\t  build:\n    12\t    runs-on: ubuntu-24.04\n    13\t    environment: production   # requires approval from @acme/people-platform-release\n    14\t    permissions:\n    15\t      contents: read\n    16\t      packages: write\n    17\t      id-token: write\n    18\t      attestations: write\n    19\t    env:\n    20\t      PYTHONDONTWRITEBYTECODE: \"1\"\n    21\t      IMAGE: registry.acme.example/people/hr-helpdesk-agent\n    22\t    steps:\n    23\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    24\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    25\t        with: {python-version: \"3.12.7\"}\n    26\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    27\t        with: {cosign-release: \"v2.6.2\"}\n    28\t      - run: pip install --require-hashes -r requirements.txt\n    29\t      - run: python -m pytest -q tests/release\n    30\t      - name: Build and push\n    31\t        id: build\n    32\t        uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    33\t        with:\n    34\t          push: true\n    35\t          tags: ${{ env.IMAGE }}:${{ github.sha }}\n    36\t          sbom: true\n    37\t          provenance: mode=max\n    38\t      - name: Sign image\n    39\t        run: cosign sign --yes \"${IMAGE}@${{ steps.build.outputs.digest }}\"\n    40\t      - uses: actions/attest-build-provenance@e8998f949152b193b063cb0ec769d69d929409be # v2.4.0\n    41\t        with:\n    42\t          subject-name: ${{ env.IMAGE }}\n    43\t          subject-digest: ${{ steps.build.outputs.digest }}\n    44\t          push-to-registry: true\n    45\t      - name: Compute agent-type-id\n    46\t        id: typeid\n    47\t        run: |\n    48\t          python -m src.type_id \"${{ steps.build.outputs.digest }}\" > type-id.json\n    49\t          echo \"id=$(jq -r .agent_type_id type-id.json)\" >> \"$GITHUB_OUTPUT\"\n    50\t      - name: Stamp release manifest\n    51\t        run: |\n    52\t          yq -i '.release.agent_type_id = \"${{ steps.typeid.outputs.id }}\" |\n    53\t                 .release.image.digest = \"${{ steps.build.outputs.digest }}\" |\n    54\t                 .release.git_sha = \"${{ github.sha }}\"' release/manifest.yaml\n    55\t      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\n    56\t        with:\n    57\t          name: release-${{ github.sha }}\n    58\t          path: [type-id.json, release/manifest.yaml]\n    59\t\n    60\t  deploy:\n    61\t    needs: build\n    62\t    runs-on: ubuntu-24.04\n    63\t    environment: production\n    64\t    permissions: {contents: read, id-token: write}\n    65\t    steps:\n    66\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    67\t      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0\n    68\t        with: {name: \"release-${{ github.sha }}\"}\n    69\t      - name: Render and apply\n    70\t        run: |\n    71\t          export IMAGE_DIGEST=$(yq -r .release.image.digest release/manifest.yaml)\n    72\t          export AGENT_TYPE_ID=$(yq -r .release.agent_type_id release/manifest.yaml)\n    73\t          export GIT_SHA=${{ github.sha }}\n    74\t          for f in k8s/*.yaml; do envsubst '$IMAGE_DIGEST $AGENT_TYPE_ID $GIT_SHA' < \"$f\"; echo '---'; done \\\n    75\t            | kubectl apply --server-side -f -","is_error":false}]},"parent_tool_use_id":null,"session_id":"71f043ed-19c9-490b-9dd2-a2aeb708a377","uuid":"9ef99433-7b54-46d8-8129-f77e47f11d53","timestamp":"2026-11-21T12:01:02.461Z","tool_use_result":{"stdout":"     1\tapiVersion: v1\n     2\tkind: ServiceAccount\n     3\tmetadata:\n     4\t  name: hr-helpdesk-agent\n     5\t  namespace: hr-agent\n     6\tautomountServiceAccountToken: false\n     7\t---\n     8\tapiVersion: v1\n     9\tkind: ServiceAccount\n    10\tmetadata:\n    11\t  name: hr-tool-gateway\n    12\t  namespace: hr-agent\n    13\tautomountServiceAccountToken: false\n    14\t---\n    15\tapiVersion: apps/v1\n    16\tkind: Deployment\n    17\tmetadata:\n    18\t  name: hr-helpdesk-agent\n    19\t  namespace: hr-agent\n    20\t  labels: {app: hr-helpdesk-agent, app.kubernetes.io/part-of: hr-helpdesk}\n    21\tspec:\n    22\t  replicas: 3\n    23\t  selector:\n    24\t    matchLabels: {app: hr-helpdesk-agent}\n    25\t  template:\n    26\t    metadata:\n    27\t      labels: {app: hr-helpdesk-agent}\n    28\t      annotations:\n    29\t        acme.example/release-manifest: \"release/manifest.yaml@${GIT_SHA}\"\n    30\t    spec:\n    31\t      serviceAccountName: hr-helpdesk-agent\n    32\t      automountServiceAccountToken: false\n    33\t      hostUsers: false\n    34\t      enableServiceLinks: false\n    35\t      securityContext:\n    36\t        runAsNonRoot: true\n    37\t        runAsUser: 65532\n    38\t        runAsGroup: 65532\n    39\t        fsGroup: 65532\n    40\t        seccompProfile: {type: RuntimeDefault}\n    41\t      containers:\n    42\t        - name: agent\n    43\t          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n    44\t          args: [\"-m\", \"uvicorn\", \"src.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\"]\n    45\t          ports: [{containerPort: 8080}]\n    46\t          env:\n    47\t            - {name: AGENT_TYPE_ID, value: \"${AGENT_TYPE_ID}\"}\n    48\t            - {name: IMAGE_DIGEST, value: \"${IMAGE_DIGEST}\"}\n    49\t            - name: POD_UID\n    50\t              valueFrom: {fieldRef: {fieldPath: metadata.uid}}\n    51\t            - name: DATABASE_URL\n    52\t              valueFrom: {secretKeyRef: {name: hr-agent-db, key: url}}\n    53\t            - name: ANTHROPIC_API_KEY\n    54\t              valueFrom: {secretKeyRef: {name: hr-agent-anthropic, key: api_key}}\n    55\t            - {name: ANTHROPIC_BASE_URL, value: \"https://api.anthropic.com\"}\n    56\t          securityContext:\n    57\t            allowPrivilegeEscalation: false\n    58\t            readOnlyRootFilesystem: true\n    59\t            privileged: false\n    60\t            capabilities: {drop: [ALL]}\n    61\t          resources:\n    62\t            requests: {cpu: 250m, memory: 384Mi}\n    63\t            limits: {cpu: \"1\", memory: 768Mi}\n    64\t          volumeMounts:\n    65\t            - {name: tmp, mountPath: /tmp}\n    66\t            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n    67\t            - {name: svid, mountPath: /etc/svid, readOnly: true}\n    68\t      volumes:\n    69\t        - name: tmp\n    70\t          emptyDir: {medium: Memory, sizeLimit: 32Mi}\n    71\t        - name: sts-token\n    72\t          projected:\n    73\t            sources:\n    74\t              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n    75\t        - name: svid\n    76\t          csi: {driver: csi.spiffe.io, readOnly: true}\n    77\t---\n    78\tapiVersion: apps/v1\n    79\tkind: Deployment\n    80\tmetadata:\n    81\t  name: hr-tool-gateway\n    82\t  namespace: hr-agent\n    83\t  labels: {app: hr-tool-gateway, app.kubernetes.io/part-of: hr-helpdesk}\n    84\tspec:\n    85\t  replicas: 2\n    86\t  selector:\n    87\t    matchLabels: {app: hr-tool-gateway}\n    88\t  template:\n    89\t    metadata:\n    90\t      labels: {app: hr-tool-gateway}\n    91\t    spec:\n    92\t      serviceAccountName: hr-tool-gateway\n    93\t      automountServiceAccountToken: false\n    94\t      hostUsers: false\n    95\t      enableServiceLinks: false\n    96\t      securityContext:\n    97\t        runAsNonRoot: true\n    98\t        runAsUser: 65532\n    99\t        runAsGroup: 65532\n   100\t        seccompProfile: {type: RuntimeDefault}\n   101\t      containers:\n   102\t        - name: gateway\n   103\t          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n   104\t          args: [\"-m\", \"uvicorn\", \"src.gateway:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8443\"]\n   105\t          ports: [{containerPort: 8443}]\n   106\t          env:\n   107\t            - name: GATEWAY_DATABASE_URL\n   108\t              valueFrom: {secretKeyRef: {name: hr-gateway-db, key: url}}\n   109\t          securityContext:\n   110\t            allowPrivilegeEscalation: false\n   111\t            readOnlyRootFilesystem: true\n   112\t            privileged: false\n   113\t            capabilities: {drop: [ALL]}\n   114\t          volumeMounts:\n   115\t            - {name: tmp, mountPath: /tmp}\n   116\t            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n   117\t            - {name: svid, mountPath: /etc/svid, readOnly: true}\n   118\t      volumes:\n   119\t        - name: tmp\n   120\t          emptyDir: {medium: Memory, sizeLimit: 16Mi}\n   121\t        - name: sts-token\n   122\t          projected:\n   123\t            sources:\n   124\t              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n   125\t        - name: svid\n   126\t          csi: {driver: csi.spiffe.io, readOnly: true}\n   127\t---\n   128\tapiVersion: v1\n   129\tkind: Service\n   130\tmetadata:\n   131\t  name: hr-tool-gateway\n   132\t  namespace: hr-agent\n   133\tspec:\n   134\t  selector: {app: hr-tool-gateway}\n   135\t  ports: [{port: 8443, targetPort: 8443}]\n   136\t---\n   137\tapiVersion: v1\n   138\tkind: Service\n   139\tmetadata:\n   140\t  name: hr-helpdesk-agent\n   141\t  namespace: hr-agent\n   142\tspec:\n   143\t  selector: {app: hr-helpdesk-agent}\n   144\t  sessionAffinity: ClientIP\n   145\t  ports: [{port: 80, targetPort: 8080}]\n     1\t-- Roles (created by the platform team): hr_agent, hr_gateway, hr_agent_operator,\n     2\t-- hr_audit_reader, hr_audit_maint, hr_docs_ingest.\n     3\tCREATE SCHEMA audit; CREATE SCHEMA control; CREATE SCHEMA approvals; CREATE SCHEMA quota; CREATE SCHEMA retrieval;\n     4\t\n     5\tCREATE TABLE audit.events (\n     6\t    event_id uuid NOT NULL, ts timestamptz NOT NULL, event_type text NOT NULL,\n     7\t    run_id uuid NOT NULL, step_id uuid, parent_step_id uuid,\n     8\t    accountable_party text NOT NULL, operational_owner text NOT NULL, tenant text NOT NULL,\n     9\t    agent_type_id text NOT NULL, agent_instance_id text NOT NULL,\n    10\t    trace_id char(32) NOT NULL, span_id char(16) NOT NULL, traceparent text NOT NULL,\n    11\t    delegated_subject text NOT NULL, agent_principal text NOT NULL,\n    12\t    tool text, operation_target text, decision text, reason text, policy_version text NOT NULL, approval_id uuid,\n    13\t    args_redacted jsonb, result_redacted jsonb,\n    14\t    context_tokens integer, context_tokens_method text, model_requested text, model_served text,\n    15\t    PRIMARY KEY (event_id, ts)\n    16\t) PARTITION BY RANGE (ts);\n    17\tCREATE INDEX ON audit.events (trace_id);\n    18\tCREATE INDEX ON audit.events (run_id, ts);\n    19\t\n    20\tCREATE TABLE audit.gateway_decisions (\n    21\t    ts timestamptz NOT NULL, traceparent text NOT NULL, tenant text NOT NULL,\n    22\t    accountable_party text NOT NULL, operational_owner text NOT NULL,\n    23\t    agent_type_id_hint text NOT NULL, agent_instance_hint text NOT NULL,   -- caller-supplied; join key only\n    24\t    subject text, actor text, tool text, decision text NOT NULL, reason text, policy_version text NOT NULL\n    25\t) PARTITION BY RANGE (ts);\n    26\t\n    27\t-- Creates `ahead` partitions into the future and drops partitions older than the newest `keep`.\n    28\tCREATE FUNCTION audit.maintain_partitions(parent regclass, period interval, ahead int, keep int)\n    29\tRETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = audit, pg_temp AS $$\n    30\tDECLARE\n    31\t    start_ts timestamptz := date_trunc('week', now());\n    32\t    part record;\n    33\tBEGIN\n    34\t    FOR i IN 0..ahead LOOP\n    35\t        EXECUTE format('CREATE TABLE IF NOT EXISTS %s_%s PARTITION OF %s FOR VALUES FROM (%L) TO (%L)',\n    36\t                       parent, to_char(start_ts + i * period, 'IYYY\"w\"IW'), parent,\n    37\t                       start_ts + i * period, start_ts + (i + 1) * period);\n    38\t    END LOOP;\n    39\t    FOR part IN\n    40\t        SELECT c.oid::regclass AS rel FROM pg_inherits i JOIN pg_class c ON c.oid = i.inhrelid\n    41\t         WHERE i.inhparent = parent ORDER BY c.relname DESC OFFSET keep + ahead + 1\n    42\t    LOOP\n    43\t        EXECUTE format('DROP TABLE %s', part.rel);\n    44\t    END LOOP;\n    45\tEND $$;\n    46\t\n    47\tCREATE TABLE control.stop_flags (\n    48\t    flag_id bigserial PRIMARY KEY,\n    49\t    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n    50\t    value text, active boolean NOT NULL DEFAULT true, reason text NOT NULL,\n    51\t    set_by text NOT NULL DEFAULT current_user, set_at timestamptz NOT NULL DEFAULT now()\n    52\t);\n    53\t\n    54\tCREATE TABLE approvals.grants (\n    55\t    approval_id uuid PRIMARY KEY, run_id uuid NOT NULL, agent_instance_id text NOT NULL, subject text NOT NULL,\n    56\t    operation text NOT NULL, target text NOT NULL, args_sha256 char(64) NOT NULL, args jsonb NOT NULL,\n    57\t    tool_use_id text NOT NULL, description text NOT NULL,\n    58\t    requested_at timestamptz NOT NULL, expires_at timestamptz NOT NULL,\n    59\t    approved_by text, approved_at timestamptz, used_at timestamptz\n    60\t);\n    61\t\n    62\tCREATE TABLE quota.usage (\n    63\t    scope text NOT NULL, key text NOT NULL, window_start timestamptz NOT NULL,\n    64\t    runs integer NOT NULL DEFAULT 0, tokens bigint NOT NULL DEFAULT 0, cost_usd numeric(12, 4) NOT NULL DEFAULT 0,\n    65\t    PRIMARY KEY (scope, key, window_start)\n    66\t);\n    67\t\n    68\tCREATE TABLE retrieval.index_state (id int PRIMARY KEY CHECK (id = 1), version text NOT NULL);\n    69\tCREATE TABLE retrieval.chunks (\n    70\t    chunk_id text PRIMARY KEY, doc_id text NOT NULL, source text NOT NULL,\n    71\t    added_at timestamptz NOT NULL DEFAULT now(), added_by text NOT NULL DEFAULT current_user,\n    72\t    trust text NOT NULL CHECK (trust IN ('reviewed', 'hr_authored')),\n    73\t    audience text NOT NULL CHECK (audience IN ('all', 'employee')),\n    74\t    allowed_employees text[] NOT NULL DEFAULT '{}',\n    75\t    expires_at timestamptz, quarantined boolean NOT NULL DEFAULT false, text text NOT NULL,\n    76\t    tsv tsvector GENERATED ALWAYS AS (to_tsvector('english', text)) STORED\n    77\t);\n    78\tCREATE INDEX ON retrieval.chunks USING gin (tsv);\n    79\t\n    80\tGRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\n    81\tGRANT INSERT ON audit.events TO hr_agent;\n    82\tGRANT SELECT ON control.stop_flags TO hr_agent;\n    83\tGRANT SELECT, INSERT ON approvals.grants TO hr_agent;\n    84\tGRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\n    85\tGRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\n    86\tGRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n    87\t\n    88\tGRANT USAGE ON SCHEMA audit, control TO hr_gateway;\n    89\tGRANT INSERT ON audit.gateway_decisions TO hr_gateway;\n    90\tGRANT SELECT ON control.stop_flags TO hr_gateway;\n    91\t\n    92\tGRANT USAGE ON SCHEMA control TO hr_agent_operator;\n    93\tGRANT SELECT, INSERT, UPDATE ON control.stop_flags TO hr_agent_operator;\n    94\tGRANT USAGE ON SEQUENCE control.stop_flags_flag_id_seq TO hr_agent_operator;\n    95\t\n    96\tGRANT USAGE ON SCHEMA audit TO hr_audit_reader, hr_audit_maint;\n    97\tGRANT SELECT ON ALL TABLES IN SCHEMA audit TO hr_audit_reader;\n    98\tREVOKE EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) FROM PUBLIC;\n    99\tGRANT EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) TO hr_audit_maint;\n   100\t\n   101\tGRANT USAGE ON SCHEMA retrieval TO hr_docs_ingest;\n   102\tGRANT SELECT, INSERT, UPDATE ON retrieval.chunks, retrieval.index_state TO hr_docs_ingest;\n     1\tapiVersion: batch/v1\n     2\tkind: CronJob\n     3\tmetadata:\n     4\t  name: audit-partition-maintenance\n     5\t  namespace: hr-agent\n     6\t  labels: {app.kubernetes.io/part-of: hr-helpdesk}\n     7\tspec:\n     8\t  schedule: \"17 2 * * *\"\n     9\t  concurrencyPolicy: Forbid\n    10\t  jobTemplate:\n    11\t    spec:\n    12\t      backoffLimit: 2\n    13\t      template:\n    14\t        metadata:\n    15\t          labels: {app: audit-maintenance}\n    16\t        spec:\n    17\t          serviceAccountName: hr-audit-maint\n    18\t          automountServiceAccountToken: false\n    19\t          restartPolicy: OnFailure\n    20\t          securityContext:\n    21\t            runAsNonRoot: true\n    22\t            runAsUser: 70\n    23\t            seccompProfile: {type: RuntimeDefault}\n    24\t          containers:\n    25\t            - name: maintain\n    26\t              image: registry.acme.example/platform/psql@sha256:9b2e61c04d7f3a85e1c6b09d2f4a7e3c58d1b6a0f9e2c47d3b8a15e6f0c9d2a4\n    27\t              env:\n    28\t                - name: PGSERVICE\n    29\t                  value: hr_audit_maint\n    30\t                - name: PERIOD\n    31\t                  value: \"1 week\"\n    32\t                - name: AHEAD\n    33\t                  value: \"4\"\n    34\t                - name: KEEP_PARTITIONS\n    35\t                  value: \"6\"\n    36\t              command: [\"psql\", \"-v\", \"ON_ERROR_STOP=1\", \"-c\"]\n    37\t              args:\n    38\t                - >-\n    39\t                  SELECT audit.maintain_partitions('audit.events', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    40\t                  SELECT audit.maintain_partitions('audit.gateway_decisions', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    41\t              securityContext:\n    42\t                allowPrivilegeEscalation: false\n    43\t                readOnlyRootFilesystem: true\n    44\t                capabilities: {drop: [ALL]}\n    45\t              volumeMounts:\n    46\t                - {name: pgservice, mountPath: /etc/postgresql-common, readOnly: true}\n    47\t          volumes:\n    48\t            - name: pgservice\n    49\t              secret: {secretName: hr-audit-maint-pgservice}\n     1\tname: release\n     2\t\n     3\ton:\n     4\t  push:\n     5\t    branches: [main]\n     6\t\n     7\tpermissions:\n     8\t  contents: read\n     9\t\n    10\tjobs:\n    11\t  build:\n    12\t    runs-on: ubuntu-24.04\n    13\t    environment: production   # requires approval from @acme/people-platform-release\n    14\t    permissions:\n    15\t      contents: read\n    16\t      packages: write\n    17\t      id-token: write\n    18\t      attestations: write\n    19\t    env:\n    20\t      PYTHONDONTWRITEBYTECODE: \"1\"\n    21\t      IMAGE: registry.acme.example/people/hr-helpdesk-agent\n    22\t    steps:\n    23\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    24\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    25\t        with: {python-version: \"3.12.7\"}\n    26\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    27\t        with: {cosign-release: \"v2.6.2\"}\n    28\t      - run: pip install --require-hashes -r requirements.txt\n    29\t      - run: python -m pytest -q tests/release\n    30\t      - name: Build and push\n    31\t        id: build\n    32\t        uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    33\t        with:\n    34\t          push: true\n    35\t          tags: ${{ env.IMAGE }}:${{ github.sha }}\n    36\t          sbom: true\n    37\t          provenance: mode=max\n    38\t      - name: Sign image\n    39\t        run: cosign sign --yes \"${IMAGE}@${{ steps.build.outputs.digest }}\"\n    40\t      - uses: actions/attest-build-provenance@e8998f949152b193b063cb0ec769d69d929409be # v2.4.0\n    41\t        with:\n    42\t          subject-name: ${{ env.IMAGE }}\n    43\t          subject-digest: ${{ steps.build.outputs.digest }}\n    44\t          push-to-registry: true\n    45\t      - name: Compute agent-type-id\n    46\t        id: typeid\n    47\t        run: |\n    48\t          python -m src.type_id \"${{ steps.build.outputs.digest }}\" > type-id.json\n    49\t          echo \"id=$(jq -r .agent_type_id type-id.json)\" >> \"$GITHUB_OUTPUT\"\n    50\t      - name: Stamp release manifest\n    51\t        run: |\n    52\t          yq -i '.release.agent_type_id = \"${{ steps.typeid.outputs.id }}\" |\n    53\t                 .release.image.digest = \"${{ steps.build.outputs.digest }}\" |\n    54\t                 .release.git_sha = \"${{ github.sha }}\"' release/manifest.yaml\n    55\t      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\n    56\t        with:\n    57\t          name: release-${{ github.sha }}\n    58\t          path: [type-id.json, release/manifest.yaml]\n    59\t\n    60\t  deploy:\n    61\t    needs: build\n    62\t    runs-on: ubuntu-24.04\n    63\t    environment: production\n    64\t    permissions: {contents: read, id-token: write}\n    65\t    steps:\n    66\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    67\t      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0\n    68\t        with: {name: \"release-${{ github.sha }}\"}\n    69\t      - name: Render and apply\n    70\t        run: |\n    71\t          export IMAGE_DIGEST=$(yq -r .release.image.digest release/manifest.yaml)\n    72\t          export AGENT_TYPE_ID=$(yq -r .release.agent_type_id release/manifest.yaml)\n    73\t          export GIT_SHA=${{ github.sha }}\n    74\t          for f in k8s/*.yaml; do envsubst '$IMAGE_DIGEST $AGENT_TYPE_ID $GIT_SHA' < \"$f\"; echo '---'; done \\\n    75\t            | kubectl apply --server-side -f -","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Vrj945U5UZPqRpRkFgvkyF","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
