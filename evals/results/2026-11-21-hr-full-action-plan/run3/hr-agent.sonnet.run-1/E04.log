{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016p5rwUs3APDvHGsh7KsoyG","type":"tool_result","content":"     1\t\"\"\"Checks applied to content before the model sees it, and to model output.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport json\n     5\timport re\n     6\timport unicodedata\n     7\tfrom typing import Any\n     8\tfrom urllib.parse import urlparse\n     9\t\n    10\tfrom jsonschema import Draft202012Validator, FormatChecker\n    11\t\n    12\tfrom .redact import redact_obj\n    13\tfrom .tools import ToolSpec\n    14\t\n    15\t_INJECTION_MARKERS = [\n    16\t    re.compile(r\"(?i)\\bignore (all|any|the)? ?(previous|prior|above) (instructions|rules)\"),\n    17\t    re.compile(r\"(?i)\\byou are now\\b\"),\n    18\t    re.compile(r\"(?i)\\bsystem prompt\\b\"),\n    19\t    re.compile(r\"(?i)<\\s*/?\\s*(system|assistant|tool_use|instructions)\\b\"),\n    20\t    re.compile(r\"(?i)\\b(call|use|invoke) the [a-z_]+ tool\\b\"),\n    21\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    22\t]\n    23\t\n    24\t\n    25\tclass ValidationRejected(Exception):\n    26\t    def __init__(self, reason: str):\n    27\t        super().__init__(reason)\n    28\t        self.reason = reason\n    29\t\n    30\t\n    31\tdef _scan_text(value: str, where: str) -> None:\n    32\t    for ch in value:\n    33\t        cat = unicodedata.category(ch)\n    34\t        if cat in (\"Cf\", \"Co\", \"Cs\") or (cat == \"Cc\" and ch not in \"\\n\\t\"):\n    35\t            raise ValidationRejected(f\"{where}: control or invisible character\")\n    36\t    for marker in _INJECTION_MARKERS:\n    37\t        if marker.search(value):\n    38\t            raise ValidationRejected(f\"{where}: instruction-like content\")\n    39\t\n    40\t\n    41\tdef _walk_strings(value: Any, where: str) -> None:\n    42\t    if isinstance(value, str):\n    43\t        _scan_text(value, where)\n    44\t    elif isinstance(value, dict):\n    45\t        for k, v in value.items():\n    46\t            _walk_strings(v, f\"{where}.{k}\")\n    47\t    elif isinstance(value, list):\n    48\t        for i, v in enumerate(value):\n    49\t            _walk_strings(v, f\"{where}[{i}]\")\n    50\t\n    51\t\n    52\tdef validate_tool_args(spec: ToolSpec, args: Any) -> dict[str, Any]:\n    53\t    if not isinstance(args, dict):\n    54\t        raise ValidationRejected(\"arguments must be an object\")\n    55\t    errors = sorted(Draft202012Validator(spec.input_schema, format_checker=FormatChecker()).iter_errors(args), key=str)\n    56\t    if errors:\n    57\t        raise ValidationRejected(f\"argument schema: {errors[0].message}\")\n    58\t    return args\n    59\t\n    60\t\n    61\tdef validate_tool_output(spec: ToolSpec, payload: Any, max_bytes: int) -> dict[str, Any]:\n    62\t    \"\"\"Type, size, schema and content checks. Any failure rejects the payload.\"\"\"\n    63\t    if spec.output_schema is None:\n    64\t        raise ValidationRejected(\"no output schema configured\")\n    65\t    encoded = json.dumps(payload, ensure_ascii=False)\n    66\t    if len(encoded.encode()) > max_bytes:\n    67\t        raise ValidationRejected(\"output too large\")\n    68\t    if not isinstance(payload, dict):\n    69\t        raise ValidationRejected(\"output must be an object\")\n    70\t    errors = list(Draft202012Validator(spec.output_schema, format_checker=FormatChecker()).iter_errors(payload))\n    71\t    if errors:\n    72\t        raise ValidationRejected(f\"output schema: {errors[0].message}\")\n    73\t    _walk_strings(payload, spec.qualified)\n    74\t    return redact_obj(payload)\n    75\t\n    76\t\n    77\tdef validate_chunk(chunk: dict[str, Any], max_chars: int) -> dict[str, Any]:\n    78\t    text = chunk[\"text\"]\n    79\t    if not isinstance(text, str) or len(text) > max_chars:\n    80\t        raise ValidationRejected(\"chunk size\")\n    81\t    _walk_strings(text, f\"chunk:{chunk['chunk_id']}\")\n    82\t    return {\n    83\t        \"chunk_id\": chunk[\"chunk_id\"],\n    84\t        \"source\": chunk[\"source\"],\n    85\t        \"trust\": chunk[\"trust\"],\n    86\t        \"text\": redact_obj(text),\n    87\t    }\n    88\t\n    89\t\n    90\t_MD_IMAGE = re.compile(r\"!\\[[^\\]]*\\]\\([^)]*\\)\")\n    91\t_MD_LINK = re.compile(r\"\\[([^\\]]*)\\]\\(([^)\\s]+)[^)]*\\)\")\n    92\t_BARE_URL = re.compile(r\"https?://[^\\s)>\\]]+\")\n    93\t\n    94\t\n    95\tdef sanitize_reply(text: str, allowed_hosts: list[str]) -> str:\n    96\t    \"\"\"Strip images and links to hosts outside the allowlist before the chat client renders them.\"\"\"\n    97\t    text = _MD_IMAGE.sub(\"[image removed]\", text)\n    98\t\n    99\t    def _link(m: re.Match[str]) -> str:\n   100\t        host = urlparse(m.group(2)).hostname or \"\"\n   101\t        return m.group(0) if host in allowed_hosts else m.group(1)\n   102\t\n   103\t    text = _MD_LINK.sub(_link, text)\n   104\t\n   105\t    def _bare(m: re.Match[str]) -> str:\n   106\t        host = urlparse(m.group(0)).hostname or \"\"\n   107\t        return m.group(0) if host in allowed_hosts else \"[link removed]\"\n   108\t\n   109\t    return _BARE_URL.sub(_bare, text)\nsrc/agent.py:23:from .validation import ValidationRejected, validate_chunk, validate_tool_args, validate_tool_output\nsrc/main.py:34:from .validation import sanitize_reply\n    fine_tune: none\n    training_runs: not applicable\n    training_data: provider-undisclosed\n  helpers: []            # retrieval is Postgres full-text search; no embedding or reranker model\n\ntools:\n  built_in: []\n  local: [search_policies]\n  mcp_servers:\n    - {id: hris, identity: \"spiffe://acme.example/ns/hris/sa/hris-mcp\", owner: hris-platform, tools: [get_leave_balance, file_leave_request]}\n    - {id: helpdesk, identity: \"spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\", owner: it-service-desk, tools: [create_ticket]}\n  policy_version_source: config/tools.yaml#policy_version\n\npermissions:\n  sts_scopes: [hr.policy.read, hris.leave.read, hris.leave.request, helpdesk.ticket.create]\n  token_ttl_seconds: 300\n  database_role: hr_agent (see migrations/001_init.sql grants)","is_error":false}]},"parent_tool_use_id":null,"session_id":"2fb495e1-5cee-4588-9ca4-e5c662eec784","uuid":"83f1faf2-3084-40e4-86f7-17c80ea839fc","timestamp":"2026-11-21T12:22:20.317Z","tool_use_result":{"stdout":"     1\t\"\"\"Checks applied to content before the model sees it, and to model output.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport json\n     5\timport re\n     6\timport unicodedata\n     7\tfrom typing import Any\n     8\tfrom urllib.parse import urlparse\n     9\t\n    10\tfrom jsonschema import Draft202012Validator, FormatChecker\n    11\t\n    12\tfrom .redact import redact_obj\n    13\tfrom .tools import ToolSpec\n    14\t\n    15\t_INJECTION_MARKERS = [\n    16\t    re.compile(r\"(?i)\\bignore (all|any|the)? ?(previous|prior|above) (instructions|rules)\"),\n    17\t    re.compile(r\"(?i)\\byou are now\\b\"),\n    18\t    re.compile(r\"(?i)\\bsystem prompt\\b\"),\n    19\t    re.compile(r\"(?i)<\\s*/?\\s*(system|assistant|tool_use|instructions)\\b\"),\n    20\t    re.compile(r\"(?i)\\b(call|use|invoke) the [a-z_]+ tool\\b\"),\n    21\t    re.compile(r\"[A-Za-z0-9+/]{120,}={0,2}\"),\n    22\t]\n    23\t\n    24\t\n    25\tclass ValidationRejected(Exception):\n    26\t    def __init__(self, reason: str):\n    27\t        super().__init__(reason)\n    28\t        self.reason = reason\n    29\t\n    30\t\n    31\tdef _scan_text(value: str, where: str) -> None:\n    32\t    for ch in value:\n    33\t        cat = unicodedata.category(ch)\n    34\t        if cat in (\"Cf\", \"Co\", \"Cs\") or (cat == \"Cc\" and ch not in \"\\n\\t\"):\n    35\t            raise ValidationRejected(f\"{where}: control or invisible character\")\n    36\t    for marker in _INJECTION_MARKERS:\n    37\t        if marker.search(value):\n    3