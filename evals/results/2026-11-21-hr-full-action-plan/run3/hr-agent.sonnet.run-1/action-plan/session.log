tion   # requires approval from @acme/people-platform-release\n    14\t    permissions:\n    15\t      contents: read\n    16\t      packages: write\n    17\t      id-token: write\n    18\t      attestations: write\n    19\t    env:\n    20\t      PYTHONDONTWRITEBYTECODE: \"1\"\n    21\t      IMAGE: registry.acme.example/people/hr-helpdesk-agent\n    22\t    steps:\n    23\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    24\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    25\t        with: {python-version: \"3.12.7\"}\n    26\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    27\t        with: {cosign-release: \"v2.6.2\"}\n    28\t      - run: pip install --require-hashes -r requirements.txt\n    29\t      - run: python -m pytest -q tests/release\n    30\t      - name: Build and push\n    31\t        id: build\n    32\t        uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    33\t        with:\n    34\t          push: true\n    35\t          tags: ${{ env.IMAGE }}:${{ github.sha }}\n    36\t          sbom: true\n    37\t          provenance: mode=max\n    38\t      - name: Sign image\n    39\t        run: cosign sign --yes \"${IMAGE}@${{ steps.build.outputs.digest }}\"\n    40\t      - uses: actions/attest-build-provenance@e8998f949152b193b063cb0ec769d69d929409be # v2.4.0\n    41\t        with:\n    42\t          subject-name: ${{ env.IMAGE }}\n    43\t          subject-digest: ${{ steps.build.outputs.digest }}\n    44\t          push-to-registry: true\n    45\t      - name: Compute agent-type-id\n    46\t        id: typeid\n    47\t        run: |\n    48\t          python -m src.type_id \"${{ steps.build.outputs.digest }}\" > type-id.json\n    49\t          echo \"id=$(jq -r .agent_type_id type-id.json)\" >> \"$GITHUB_OUTPUT\"\n    50\t      - name: Stamp release manifest\n    51\t        run: |\n    52\t          yq -i '.release.agent_type_id = \"${{ steps.typeid.outputs.id }}\" |\n    53\t                 .release.image.digest = \"${{ steps.build.outputs.digest }}\" |\n    54\t                 .release.git_sha = \"${{ github.sha }}\"' release/manifest.yaml\n    55\t      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\n    56\t        with:\n    57\t          name: release-${{ github.sha }}\n    58\t          path: [type-id.json, release/manifest.yaml]\n    59\t\n    60\t  deploy:\n    61\t    needs: build\n    62\t    runs-on: ubuntu-24.04\n    63\t    environment: production\n    64\t    permissions: {contents: read, id-token: write}\n    65\t    steps:\n    66\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    67\t      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0\n    68\t        with: {name: \"release-${{ github.sha }}\"}\n    69\t      - name: Render and apply\n    70\t        run: |\n    71\t          export IMAGE_DIGEST=$(yq -r .release.image.digest release/manifest.yaml)\n    72\t          export AGENT_TYPE_ID=$(yq -r .release.agent_type_id release/manifest.yaml)\n    73\t          export GIT_SHA=${{ github.sha }}\n    74\t          for f in k8s/*.yaml; do envsubst '$IMAGE_DIGEST $AGENT_TYPE_ID $GIT_SHA' < \"$f\"; echo '---'; done \\\n    75\t            | kubectl apply --server-side -f -\n     1\t*                         @acme/people-platform\n     2\t/prompts/                 @acme/people-platform @acme/hr-policy-reviewers\n     3\t/config/                  @acme/people-platform @acme/security-engineering\n     4\t/src/gateway.py           @acme/people-platform @acme/security-engineering\n     5\t/src/approvals.py         @acme/people-platform @acme/security-engineering\n     6\t/k8s/                     @acme/people-platform @acme/platform-security\n     7\t/migrations/              @acme/people-platform @acme/data-platform\n     8\t/release/                 @acme/people-platform @acme/security-engineering\n     9\t/.github/                 @acme/platform-security\n    10\t/CODEOWNERS               @acme/platform-security\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.12.7-slim-bookworm@sha256:032c52613401895aa3d418a4c5bf5c3ad0d5d6fe3c1e9b2c8b5d0a7e6f4c3b21 AS build\n     3\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     4\tWORKDIR /build\n     5\tCOPY requirements.txt .\n     6\tRUN pip install --require-hashes --only-binary=:all: --target /deps -r requirements.txt\n     7\t\n     8\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:7e4c1d2a9f3b8e60c5d47a19b2f03e8d6c1a5b94f7e2d03c8a6b1f5e9d4c2a70\n     9\tENV PYTHONPATH=/deps:/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1\n    10\tWORKDIR /app\n    11\tCOPY --from=build /deps /deps\n    12\tCOPY --chown=0:0 requirements.txt Dockerfile ./\n    13\tCOPY --chown=0:0 src/ src/\n    14\tCOPY --chown=0:0 prompts/ prompts/\n    15\tCOPY --chown=0:0 config/ config/\n    16\tUSER 65532:65532\n    17\tENTRYPOINT [\"python3\"]\n     1\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": web-frontends, app: hr-portal-bff}\n     2\t      toPorts: [{ports: [{port: \"8080\", protocol: TCP}]}]\n     3\t  egress:\n     4\t    - toEndpoints:\n     5\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": kube-system, k8s-app: kube-dns}\n     6\t      toPorts:\n     7\t        - ports: [{port: \"53\", protocol: UDP}]\n     8\t          rules:\n     9\t            dns:\n    10\t              - matchName: api.anthropic.com\n    11\t              - matchName: sso.acme.example\n    12\t              - matchPattern: \"*.svc.cluster.local\"\n    13\t    - toFQDNs:\n    14\t        - matchName: api.anthropic.com\n    15\t        - matchName: sso.acme.example\n    16\t      toPorts: [{ports: [{port: \"443\", protocol: TCP}]}]\n    17\t    - toEndpoints:\n    18\t        - matchLabels: {app: hr-tool-gateway}\n    19\t      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n    20\t    - toEndpoints:\n    21\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": identity, app: sts}\n    22\t      toPorts: [{ports: [{port: \"443\", protocol: TCP}]}]\n    23\t    - toEndpoints:\n    24\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": data, app: hr-postgres}\n    25\t      toPorts: [{ports: [{port: \"5432\", protocol: TCP}]}]\n    26\t    - toEndpoints:\n    27\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": observability, app: otel-collector}\n    28\t      toPorts: [{ports: [{port: \"4317\", protocol: TCP}]}]\n    29\t    - toEndpoints:\n    30\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": helpdesk, app: helpdesk-mcp}\n    31\t      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n    32\t  egressDeny:\n    33\t    - toCIDR: [169.254.169.254/32, 169.254.170.2/32, 100.100.100.200/32]\n    34\t    - toCIDRSet:\n    35\t        - cidr: fd00:ec2::254/128\n    36\t---\n    37\tapiVersion: cilium.io/v2\n    38\tkind: CiliumNetworkPolicy\n    39\tmetadata:\n    40\t  name: hr-tool-gateway-egress\n    41\t  namespace: hr-agent\n    spec:\n      serviceAccountName: hr-helpdesk-agent\n      automountServiceAccountToken: false\n      hostUsers: false\n      enableServiceLinks: false\n      securityContext:\n        runAsNonRoot: true\n        runAsUser: 65532\n        runAsGroup: 65532\n        fsGroup: 65532\n        seccompProfile: {type: RuntimeDefault}\n      containers:\n        - name: agent\n          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n          args: [\"-m\", \"uvicorn\", \"src.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\"]\n          ports: [{containerPort: 8080}]\n          env:\n            - {name: AGENT_TYPE_ID, value: \"${AGENT_TYPE_ID}\"}\n            - {name: IMAGE_DIGEST, value: \"${IMAGE_DIGEST}\"}\n            - name: POD_UID\n              valueFrom: {fieldRef: {fieldPath: meta