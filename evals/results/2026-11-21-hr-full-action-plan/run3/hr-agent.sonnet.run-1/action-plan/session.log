{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015L5ByWnWa1X9bPaknzqfrg","type":"tool_result","content":"     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport logging\n     6\timport os\n     7\timport uuid\n     8\t\n     9\timport asyncpg\n    10\timport httpx\n    11\timport jwt\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n    15\tfrom opentelemetry.sdk.resources import Resource\n    16\tfrom opentelemetry.sdk.trace import TracerProvider\n    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n    18\tfrom starlette.applications import Starlette\n    19\tfrom starlette.requests import Request\n    20\tfrom starlette.responses import JSONResponse\n    21\tfrom starlette.routing import Route\n    22\t\n    23\tfrom . import type_id\n    24\tfrom .agent import Agent, RunState\n    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n    27\tfrom .budgets import BudgetExceeded, QuotaStore\n    28\tfrom .credentials import CredentialBroker\n    29\tfrom .gateway_client import GatewayClient\n    30\tfrom .killswitch import Stopped, StopControl\n    31\tfrom .redact import RedactingFilter\n    32\tfrom .retrieval import PolicyIndex\n    33\tfrom .tools import ToolRegistry, load_yaml\n    34\tfrom .validation import sanitize_reply\n    35\t\n    36\tSSO_ISSUER = \"https://sso.acme.example\"\n    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    39\t\n    40\tlogging.basicConfig(level=logging.INFO)\n    41\tfor h in logging.getLogger().handlers:\n    42\t    h.addFilter(RedactingFilter())\n    43\tlog = logging.getLogger(\"hr_agent\")\n    44\t\n    45\tCFG = load_yaml(\"agent.yaml\")\n    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n    47\tPOD_ID = os.environ[\"POD_UID\"]\n    48\t\n    49\tprovider = TracerProvider(resource=Resource.create({\n    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n    51\t}))\n    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n    53\ttrace.set_tracer_provider(provider)\n    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n    55\t\n    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n    57\tagent: Agent\n    58\taudit: AuditWriter\n    59\tapprovals: ApprovalStore\n    60\tstop: StopControl\n    61\t\n    62\t\n    63\tdef _employee(request: Request) -> tuple[str, str]:\n    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n    65\t    auth = request.headers.get(\"authorization\", \"\")\n    66\t    if not auth.startswith(\"Bearer \"):\n    67\t        raise PermissionError(\"missing token\")\n    68\t    token = auth[7:]\n    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n    72\t        raise PermissionError(\"wrong organisation\")\n    73\t    return claims[\"employee_id\"], token\n    74\t\n    75\t\n    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n    77\t    a = CFG[\"agent\"]\n    78\t    return RunContext(\n    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n    81\t        agent_principal=a[\"workload_identity\"],\n    82\t    )\n    83\t\n    84\t\n    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n    86\t    task = asyncio.ensure_future(coro)\n    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n    88\t    try:\n    89\t        return await task\n    90\t    except asyncio.CancelledError:\n    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n    92\t        return None\n    93\t    except Stopped as exc:\n    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n    95\t        return None\n    96\t    finally:\n    97\t        watcher.cancel()\n    98\t\n    99\t\n   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n   101\t    if state is None:\n   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n   105\t    if state.pending_approval:\n   106\t        body[\"approval\"] = state.pending_approval\n   107\t    return JSONResponse(body)\n   108\t\n   109\t\n   110\tasync def chat(request: Request) -> JSONResponse:\n   111\t    try:\n   112\t        employee_id, token = _employee(request)\n   113\t    except (jwt.PyJWTError, PermissionError):\n   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n   116\t    run_id = str(uuid.uuid4())\n   117\t    ctx = _context(run_id, employee_id)\n   118\t    with tracer.start_as_current_span(\"chat\"):\n   119\t        try:\n   120\t            await agent.quotas.reserve_run(ctx)\n   121\t            state = agent.new_state(text, token)\n   122\t            _runs[run_id] = (ctx, state)\n   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n   124\t            state = await _drive(ctx, agent.run(ctx, state))\n   125\t        except BudgetExceeded as exc:\n   126\t            await audit.record(ctx, \"quota_denied\", decision=\"deny\", reason=exc.limit)\n   127\t            return JSONResponse({\"error\": \"quota_exceeded\"}, status_code=429)\n   128\t        except AuditUnavailable:\n   129\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   130\t        except Exception as exc:\n   131\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__)\n   132\t            raise\n   133\t        return _reply(run_id, state)\n   134\t\n   135\t\n   136\tasync def confirm(request: Request) -> JSONResponse:\n   137\t    try:\n   138\t        employee_id, token = _employee(request)\n   139\t    except (jwt.PyJWTError, PermissionError):\n   140\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   141\t    run_id, approval_id = request.path_params[\"run_id\"], request.path_params[\"approval_id\"]\n   142\t    entry = _runs.get(run_id)\n   143\t    if entry is None or entry[0].subject != employee_id:\n   144\t        return JSONResponse({\"error\": \"not_found\"}, status_code=404)\n   145\t    ctx, state = entry\n   146\t    state.subject_token = token\n   147\t    with tracer.start_as_current_span(\"approval.confirm\"):\n   148\t        try:\n   149\t            await approvals.confirm(approval_id, employee_id)\n   150\t            await audit.record(ctx, \"approval_granted\", decision=\"allow\", approval_id=approval_id)\n   151\t            state = await _drive(ctx, agent.resume_with_approval(ctx, state, approval_id))\n   152\t        except ApprovalInvalid as exc:\n   153\t            await audit.record(ctx, \"approval_rejected\", decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   154\t            return JSONResponse({\"error\": \"approval_invalid\"}, status_code=409)\n   155\t        except AuditUnavailable:\n   156\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   157\t        except Exception as exc:\n   158\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__, approval_id=approval_id)\n   159\t            raise\n   160\t        return _reply(run_id, state)\n   161\t\n   162\t\n   163\tasync def startup() -> None:\n   164\t    global agent, audit, approvals, stop\n   165\t    pool = await asyncpg.create_pool(os.environ[\"DATABASE_URL\"], min_size=2, max_size=20)\n   166\t    registry = ToolRegistry.from_config()\n   167\t    mtls = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\", cert=(\"/etc/svid/svid.pem\", \"/etc/svid/svid_key.pem\"))\n   168\t    audit = AuditWriter(pool, registry.policy_version)\n   169\t    approvals = ApprovalStore(pool, CFG[\"approvals\"][\"ttl_seconds\"])\n   170\t    stop = StopControl(pool, CFG[\"stop\"][\"poll_seconds\"])\n   171\t    agent = Agent(\n   172\t        CFG, registry, AsyncAnthropic(max_retries=1), GatewayClient(mtls, CredentialBroker(mtls)),\n   173\t        PolicyIndex(pool, CFG[\"retrieval\"][\"top_k\"], CFG[\"retrieval\"][\"cache_ttl_seconds\"]),\n   174\t        approvals, QuotaStore(pool, CFG[\"budgets\"][\"quotas\"]), audit, stop,\n   175\t    )\n   176\t\n   177\t\n   178\tapp = Starlette(\n   179\t    routes=[\n   180\t        Route(\"/v1/chat\", chat, methods=[\"POST\"]),\n   181\t        Route(\"/v1/runs/{run_id}/approvals/{approval_id}/confirm\", confirm, methods=[\"POST\"]),\n   182\t    ],\n   183\t    on_startup=[startup],\n   184\t)\n     1\t\"\"\"Hard limits enforced by the harness, outside the model.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport time\n     5\tfrom collections import deque\n     6\tfrom dataclasses import dataclass, field\n     7\tfrom typing import Any\n     8\t\n     9\timport asyncpg\n    10\t\n    11\tfrom .audit import RunContext\n    12\t\n    13\t\n    14\tclass BudgetExceeded(Exception):\n    15\t    def __init__(self, limit: str):\n    16\t        super().__init__(limit)\n    17\t        self.limit = limit\n    18\t\n    19\t\n    20\t@dataclass\n    21\tclass RunBudget:\n    22\t    cfg: dict[str, Any]\n    23\t    pricing: dict[str, float]\n    24\t    started: float = field(default_factory=time.monotonic)\n    25\t    steps: int = 0\n    26\t    tokens: int = 0\n    27\t    cost_usd: float = 0.0\n    28\t    tool_calls: deque = field(default_factory=deque)\n    29\t\n    30\t    def check_step(self) -> None:\n    31\t        if self.steps >= self.cfg[\"max_steps\"]:\n    32\t            raise BudgetExceeded(\"max_steps\")\n    33\t        if time.monotonic() - self.started > self.cfg[\"max_wall_seconds\"]:\n    34\t            raise BudgetExceeded(\"max_wall_seconds\")\n    35\t        if self.tokens >= self.cfg[\"max_total_tokens\"]:\n    36\t            raise BudgetExceeded(\"max_total_tokens\")\n    37\t        if self.cost_usd >= self.cfg[\"max_cost_usd\"]:\n    38\t            raise BudgetExceeded(\"max_cost_usd\")\n    39\t        self.steps += 1\n    40\t\n    41\t    def remaining_seconds(self) -> float:\n    42\t        return max(0.0, self.cfg[\"max_wall_seconds\"] - (time.monotonic() - self.started))\n    43\t\n    44\t    def record_usage(self, usage: Any) -> tuple[int, float]:\n    45\t        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n    46\t        cache_write = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n    47\t        tokens_in = usage.input_tokens + cache_read + cache_write\n    48\t        tokens = tokens_in + usage.output_tokens\n    49\t        cost = (\n    50\t            (usage.input_tokens + cache_write) * self.pricing[\"input_per_mtok\"]\n    51\t            + cache_read * self.pricing[\"cache_read_per_mtok\"]\n    52\t            + usage.output_tokens * self.pricing[\"output_per_mtok\"]\n    53\t        ) / 1_000_000\n    54\t        self.tokens += tokens\n    55\t        self.cost_usd += cost\n    56\t        return tokens, cost\n    57\t\n    58\t    def check_tool_call(self) -> None:\n    59\t        now = time.monotonic()\n    60\t        while self.tool_calls and now - self.tool_calls[0] > 60:\n    61\t            self.tool_calls.popleft()\n    62\t        if len(self.tool_calls) >= self.cfg[\"max_tool_calls_per_minute\"]:\n    63\t            raise BudgetExceeded(\"max_tool_calls_per_minute\")\n    64\t        self.tool_calls.append(now)\n    65\t\n    66\t    def check_subagent(self, started_so_far: int) -> None:\n    67\t        if started_so_far >= self.cfg[\"max_subagents\"]:\n    68\t            raise BudgetExceeded(\"max_subagents\")\n    69\t\n    70\t\n    71\t_WINDOW = \"to_timestamp(floor(extract(epoch FROM now()) / $3) * $3)\"\n    72\t\n    73\t_RESERVE_RUN = f\"\"\"\n    74\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    75\tVALUES ($1, $2, {_WINDOW}, 1, 0, 0)\n    76\tON CONFLICT (scope, key, window_start) DO UPDATE\n    77\t   SET runs = quota.usage.runs + 1\n    78\t WHERE quota.usage.runs + 1 <= $4\n    79\t   AND quota.usage.tokens < $5\n    80\t   AND quota.usage.cost_usd < $6\n    81\tRETURNING runs\n    82\t\"\"\"\n    83\t\n    84\t_RECORD_USAGE = f\"\"\"\n    85\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    86\tVALUES ($1, $2, {_WINDOW}, 0, $4, $5)\n    87\tON CONFLICT (scope, key, window_start) DO UPDATE\n    88\t   SET tokens = quota.usage.tokens + EXCLUDED.tokens,\n    89\t       cost_usd = quota.usage.cost_usd + EXCLUDED.cost_usd\n    90\tRETURNING tokens, cost_usd\n    91\t\"\"\"\n    92\t\n    93\t\n    94\tclass QuotaStore:\n    95\t    \"\"\"Per-user, per-tenant and fleet-wide quotas, shared by every replica.\"\"\"\n    96\t\n    97\t    def __init__(self, pool: asyncpg.Pool, quotas: list[dict[str, Any]]):\n    98\t        self._pool = pool\n    99\t        self._quotas = quotas\n   100\t\n   101\t    def _key(self, scope: str, ctx: RunContext) -> str:\n   102\t        return {\"user\": ctx.subject, \"tenant\": ctx.tenant, \"fleet\": \"all\"}[scope]\n   103\t\n   104\t    async def reserve_run(self, ctx: RunContext) -> None:\n   105\t        async with self._pool.acquire() as conn, conn.transaction():\n   106\t            for q in self._quotas:\n   107\t                row = await conn.fetchrow(\n   108\t                    _RESERVE_RUN, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"],\n   109\t                    q[\"max_runs\"], q[\"max_tokens\"], q[\"max_cost_usd\"],\n   110\t                )\n   111\t                if row is None:\n   112\t                    raise BudgetExceeded(f\"quota:{q['scope']}\")\n   113\t\n   114\t    async def record_usage(self, ctx: RunContext, tokens: int, cost_usd: float) -> None:\n   115\t        \"\"\"Usage already spent is always recorded; the run stops once any window is over its limit.\"\"\"\n   116\t        exceeded: str | None = None\n   117\t        async with self._pool.acquire() as conn, conn.transaction():\n   118\t            for q in self._quotas:\n   119\t                row = await conn.fetchrow(\n   120\t                    _RECORD_USAGE, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"], tokens, cost_usd\n   121\t                )\n   122\t                if row[\"tokens\"] >= q[\"max_tokens\"] or row[\"cost_usd\"] >= q[\"max_cost_usd\"]:\n   123\t                    exceeded = exceeded or f\"quota:{q['scope']}\"\n   124\t        if exceeded:\n   125\t            raise BudgetExceeded(exceeded)\n     1\t\"\"\"Tool registry: the only tools this agent can see or call.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport pathlib\n     5\tfrom dataclasses import dataclass, field\n     6\tfrom typing import Any\n     7\t\n     8\timport yaml\n     9\t\n    10\tCONFIG_DIR = pathlib.Path(__file__).resolve().parent.parent / \"config\"\n    11\t\n    12\t\n    13\tdef load_yaml(name: str) -> dict[str, Any]:\n    14\t    with open(CONFIG_DIR / name, encoding=\"utf-8\") as fh:\n    15\t        return yaml.safe_load(fh)\n    16\t\n    17\t\n    18\t@dataclass(frozen=True)\n    19\tclass ToolSpec:\n    20\t    name: str\n    21\t    kind: str\n    22\t    qualified: str\n    23\t    reason: str\n    24\t    scope: str\n    25\t    approval: str\n    26\t    input_schema: dict[str, Any]\n    27\t    output_schema: dict[str, Any] | None = None\n    28\t    server: str | None = None\n    29\t    target_template: str | None = None\n    30\t    fingerprint: str | None = None\n    31\t    direct_route: dict[str, str] | None = field(default=None, hash=False)\n    32\t\n    33\t    def target(self, subject: str) -> str:\n    34\t        return (self.target_template or self.qualified).format(subject=subject)\n    35\t\n    36\t\n    37\tclass ToolRegistry:\n    38\t    def __init__(self, raw: dict[str, Any]):\n    39\t        self.policy_version: str = raw[\"policy_version\"]\n    40\t        self.servers: dict[str, dict[str, str]] = raw[\"servers\"]\n    41\t        self._tools: dict[str, ToolSpec] = {}\n    42\t        for name, t in raw[\"tools\"].items():\n    43\t            if not t.get(\"reason\"):\n    44\t                raise ValueError(f\"tool {name} has no task reason\")\n    45\t            if t[\"approval\"] not in (\"none\", \"subject\"):\n    46\t                raise ValueError(f\"tool {name}: unknown approval mode\")\n    47\t            self._tools[name] = ToolSpec(\n    48\t                name=name,\n    49\t                kind=t[\"kind\"],\n    50\t                qualified=t.get(\"qualified\", name),\n    51\t                reason=t[\"reason\"],\n    52\t                scope=t[\"scope\"],\n    53\t                approval=t[\"approval\"],\n    54\t                input_schema=t[\"input_schema\"],\n    55\t                output_schema=t.get(\"output_schema\"),\n    56\t                server=t.get(\"server\"),\n    57\t                target_template=t.get(\"target\"),\n    58\t                fingerprint=t.get(\"fingerprint\"),\n    59\t                direct_route=t.get(\"direct_route\"),\n    60\t            )\n    61\t\n    62\t    @classmethod\n    63\t    def from_config(cls) -> \"ToolRegistry\":\n    64\t        return cls(load_yaml(\"tools.yaml\"))\n    65\t\n    66\t    def get(self, name: str) -> ToolSpec | None:\n    67\t        # Exact key lookup only; no prefix, case folding or alias matching.\n    68\t        return self._tools.get(name)\n    69\t\n    70\t    def by_qualified(self, qualified: str) -> ToolSpec | None:\n    71\t        for spec in self._tools.values():\n    72\t            if spec.qualified == qualified:\n    73\t                return spec\n    74\t        return None\n    75\t\n    76\t    def model_schemas(self) -> list[dict[str, Any]]:\n    77\t        return [\n    78\t            {\"name\": s.name, \"description\": s.reason, \"input_schema\": s.input_schema}\n    79\t            for s in self._tools.values()\n    80\t        ]\n     1\t\"\"\"agent-type-id: SHA-256 over every identity-defining input.\n     2\t\n     3\tInputs (all, no exclusions):\n     4\t  - every file under src/, prompts/ and config/, plus requirements.txt and Dockerfile\n     5\t  - the image digest the pod runs\n     6\t  - the model record (provider, requested ID, snapshot/alias label, adapter)\n     7\tCanonical form: JSON with sorted keys, no whitespace, file paths relative to the repo root\n     8\tin POSIX form, each file hashed as raw bytes. The same command runs in CI (to stamp the\n     9\trelease manifest) and at pod start (to refuse running under an identity it does not match).\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport hashlib\n    14\timport json\n    15\timport pathlib\n    16\timport sys\n    17\tfrom typing import Any\n    18\t\n    19\tROOT = pathlib.Path(__file__).resolve().parent.parent\n    20\tINPUT_DIRS = (\"src\", \"prompts\", \"config\")\n    21\tINPUT_FILES = (\"requirements.txt\", \"Dockerfile\")\n    22\tHASH_SCHEME = \"acme-agent-type-id/v1\"\n    23\t\n    24\t\n    25\tdef _file_hashes() -> dict[str, str]:\n    26\t    out: dict[str, str] = {}\n    27\t    for d in INPUT_DIRS:\n    28\t        for p in sorted((ROOT / d).rglob(\"*\")):\n    29\t            if p.is_file():\n    30\t                out[p.relative_to(ROOT).as_posix()] = hashlib.sha256(p.read_bytes()).hexdigest()\n    31\t    for f in INPUT_FILES:\n    32\t        out[f] = hashlib.sha256((ROOT / f).read_bytes()).hexdigest()\n    33\t    return out\n    34\t\n    35\t\n    36\tdef compute(image_digest: str, model: dict[str, Any]) -> tuple[str, dict[str, Any]]:\n    37\t    if not image_digest.startswith(\"sha256:\") or len(image_digest) != 71:\n    38\t        raise ValueError(\"image digest must be sha256:<64 hex>\")\n    39\t    for k in (\"provider\", \"id\", \"pinning\", \"adapter\"):\n    40\t        if k not in model:\n    41\t            raise ValueError(f\"model record missing {k}\")\n    42\t    manifest = {\"scheme\": HASH_SCHEME, \"image_digest\": image_digest, \"model\": model, \"files\": _file_hashes()}\n    43\t    canonical = json.dumps(manifest, sort_keys=True, separators=(\",\", \":\")).encode()\n    44\t    return \"sha256:\" + hashlib.sha256(canonical).hexdigest(), manifest\n    45\t\n    46\t\n    47\tdef model_record(cfg: dict[str, Any]) -> dict[str, Any]:\n    48\t    m = cfg[\"model\"]\n    49\t    return {\"provider\": m[\"provider\"], \"id\": m[\"id\"], \"pinning\": m[\"pinning\"], \"adapter\": m[\"adapter\"]}\n    50\t\n    51\t\n    52\tdef verify_or_exit(expected: str, image_digest: str, model: dict[str, Any]) -> str:\n    53\t    actual, _ = compute(image_digest, model)\n    54\t    if actual != expected:\n    55\t        print(f\"agent-type-id mismatch: expected {expected}, computed {actual}\", file=sys.stderr)\n    56\t        sys.exit(78)\n    57\t    return actual\n    58\t\n    59\t\n    60\tif __name__ == \"__main__\":\n    61\t    import yaml\n    62\t\n    63\t    cfg = yaml.safe_load((ROOT / \"config\" / \"agent.yaml\").read_text())\n    64\t    tid, man = compute(sys.argv[1], model_record(cfg))\n    65\t    json.dump({\"agent_type_id\": tid, \"inputs\": man}, sys.stdout, indent=2, sort_keys=True)\n     1\t\"\"\"Stop control. Flags live in control.stop_flags, which the agent's DB role can only read.\n     2\t\n     3\tOperators set flags with the hr_agent_operator role (see README \"Stopping the agent\").\n     4\tThe tool gateway reads the same table, so a stopped instance is refused there too.\n     5\t\"\"\"\n     6\tfrom __future__ import annotations\n     7\t\n     8\timport asyncio\n     9\timport logging\n    10\t\n    11\timport asyncpg\n    12\t\n    13\tfrom .audit import RunContext\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.stop\")\n    16\t\n    17\t_QUERY = \"\"\"\n    18\tSELECT reason FROM control.stop_flags\n    19\tWHERE active\n    20\t  AND (   scope = 'fleet'\n    21\t       OR (scope = 'agent_type'     AND value = $1)\n    22\t       OR (scope = 'agent_instance' AND value = $2)\n    23\t       OR (scope = 'subject'        AND value = $3)\n    24\t       OR (scope = 'agent_principal' AND value = $4))\n    25\tLIMIT 1\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass Stopped(Exception):\n    30\t    pass\n    31\t\n    32\t\n    33\tclass StopControl:\n    34\t    def __init__(self, pool: asyncpg.Pool, poll_seconds: float):\n    35\t        self._pool = pool\n    36\t        self._poll = poll_seconds\n    37\t\n    38\t    async def reason(self, ctx: RunContext) -> str | None:\n    39\t        try:\n    40\t            row = await self._pool.fetchrow(\n    41\t                _QUERY, ctx.agent_type_id, ctx.agent_instance_id, ctx.subject, ctx.agent_principal, timeout=1.0\n    42\t            )\n    43\t        except Exception:\n    44\t            return \"stop store unreachable\"\n    45\t        return row[\"reason\"] if row else None\n    46\t\n    47\t    async def raise_if_stopped(self, ctx: RunContext) -> None:\n    48\t        why = await self.reason(ctx)\n    49\t        if why:\n    50\t            raise Stopped(why)\n    51\t\n    52\t    async def watch(self, ctx: RunContext, task: asyncio.Task) -> None:\n    53\t        \"\"\"Cancel the run task, including any in-flight model or tool call, once a flag appears.\"\"\"\n    54\t        while not task.done():\n    55\t            why = await self.reason(ctx)\n    56\t            if why:\n    57\t                log.warning(\"stop flag observed\", extra={\"run_id\": ctx.run_id, \"reason\": why})\n    58\t                task.cancel(msg=f\"stopped: {why}\")\n    59\t                return\n    60\t            await asyncio.sleep(self._poll)","is_error":false}]},"parent_tool_use_id":null,"session_id":"7b8c65a4-289c-4e70-b08b-57e71d1d702f","uuid":"40f228ca-f998-43aa-8ea5-3842bb88c107","timestamp":"2026-11-21T12:24:37.314Z","tool_use_result":{"stdout":"     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport logging\n     6\timport os\n     7\timport uuid\n     8\t\n     9\timport asyncpg\n    10\timport httpx\n    11\timport jwt\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n    15\tfrom opentelemetry.sdk.resources import Resource\n    16\tfrom opentelemetry.sdk.trace import TracerProvider\n    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n    18\tfrom starlette.applications import Starlette\n    19\tfrom starlette.requests import Request\n    20\tfrom starlette.responses import JSONResponse\n    21\tfrom starlette.routing import Route\n    22\t\n    23\tfrom . import type_id\n    24\tfrom .agent import Agent, RunState\n    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n    27\tfrom .budgets import BudgetExceeded, QuotaStore\n    28\tfrom .credentials import CredentialBroker\n    29\tfrom .gateway_client import GatewayClient\n    30\tfrom .killswitch import Stopped, StopControl\n    31\tfrom .redact import RedactingFilter\n    32\tfrom .retrieval import PolicyIndex\n    33\tfrom .tools import ToolRegistry, load_yaml\n    34\tfrom .validation import sanitize_reply\n    35\t\n    36\tSSO_ISSUER = \"https://sso.acme.example\"\n    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    39\t\n    40\tlogging.basicConfig(level=logging.INFO)\n    41\tfor h in logging.getLogger().handlers:\n    42\t    h.addFilter(RedactingFilter())\n    43\tlog = logging.getLogger(\"hr_agent\")\n    44\t\n    45\tCFG = load_yaml(\"agent.yaml\")\n    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n    47\tPOD_ID = os.environ[\"POD_UID\"]\n    48\t\n    49\tprovider = TracerProvider(resource=Resource.create({\n    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n    51\t}))\n    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n    53\ttrace.set_tracer_provider(provider)\n    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n    55\t\n    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n    57\tagent: Agent\n    58\taudit: AuditWriter\n    59\tapprovals: ApprovalStore\n    60\tstop: StopControl\n    61\t\n    62\t\n    63\tdef _employee(request: Request) -> tuple[str, str]:\n    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n    65\t    auth = request.headers.get(\"authorization\", \"\")\n    66\t    if not auth.startswith(\"Bearer \"):\n    67\t        raise PermissionError(\"missing token\")\n    68\t    token = auth[7:]\n    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n    72\t        raise PermissionError(\"wrong organisation\")\n    73\t    return claims[\"employee_id\"], token\n    74\t\n    75\t\n    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n    77\t    a = CFG[\"agent\"]\n    78\t    return RunContext(\n    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n    81\t        agent_principal=a[\"workload_identity\"],\n    82\t    )\n    83\t\n    84\t\n    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n    86\t    task = asyncio.ensure_future(coro)\n    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n    88\t    try:\n    89\t        return await task\n    90\t    except asyncio.CancelledError:\n    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n    92\t        return None\n    93\t    except Stopped as exc:\n    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n    95\t        return None\n    96\t    finally:\n    97\t        watcher.cancel()\n    98\t\n    99\t\n   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n   101\t    if state is None:\n   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n   105\t    if state.pending_approval:\n   106\t        body[\"approval\"] = state.pending_approval\n   107\t    return JSONResponse(body)\n   108\t\n   109\t\n   110\tasync def chat(request: Request) -> JSONResponse:\n   111\t    try:\n   112\t        employee_id, token = _employee(request)\n   113\t    except (jwt.PyJWTError, PermissionError):\n   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n   116\t    run_id = str(uuid.uuid4())\n   117\t    ctx = _context(run_id, employee_id)\n   118\t    with tracer.start_as_current_span(\"chat\"):\n   119\t        try:\n   120\t            await agent.quotas.reserve_run(ctx)\n   121\t            state = agent.new_state(text, token)\n   122\t            _runs[run_id] = (ctx, state)\n   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n   124\t            state = await _drive(ctx, agent.run(ctx, state))\n   125\t        except BudgetExceeded as exc:\n   126\t            await audit.record(ctx, \"quota_denied\", decision=\"deny\", reason=exc.limit)\n   127\t            return JSONResponse({\"error\": \"quota_exceeded\"}, status_code=429)\n   128\t        except AuditUnavailable:\n   129\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   130\t        except Exception as exc:\n   131\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__)\n   132\t            raise\n   133\t        return _reply(run_id, state)\n   134\t\n   135\t\n   136\tasync def confirm(request: Request) -> JSONResponse:\n   137\t    try:\n   138\t        employee_id, token = _employee(request)\n   139\t    except (jwt.PyJWTError, PermissionError):\n   140\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   141\t    run_id, approval_id = request.path_params[\"run_id\"], request.path_params[\"approval_id\"]\n   142\t    entry = _runs.get(run_id)\n   143\t    if entry is None or entry[0].subject != employee_id:\n   144\t        return JSONResponse({\"error\": \"not_found\"}, status_code=404)\n   145\t    ctx, state = entry\n   146\t    state.subject_token = token\n   147\t    with tracer.start_as_current_span(\"approval.confirm\"):\n   148\t        try:\n   149\t            await approvals.confirm(approval_id, employee_id)\n   150\t            await audit.record(ctx, \"approval_granted\", decision=\"allow\", approval_id=approval_id)\n   151\t            state = await _drive(ctx, agent.resume_with_approval(ctx, state, approval_id))\n   152\t        except ApprovalInvalid as exc:\n   153\t            await audit.record(ctx, \"approval_rejected\", decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   154\t            return JSONResponse({\"error\": \"approval_invalid\"}, status_code=409)\n   155\t        except AuditUnavailable:\n   156\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   157\t        except Exception as exc:\n   158\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__, approval_id=approval_id)\n   159\t            raise\n   160\t        return _reply(run_id, state)\n   161\t\n   162\t\n   163\tasync def startup() -> None:\n   164\t    global agent, audit, approvals, stop\n   165\t    pool = await asyncpg.create_pool(os.environ[\"DATABASE_URL\"], min_size=2, max_size=20)\n   166\t    registry = ToolRegistry.from_config()\n   167\t    mtls = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\", cert=(\"/etc/svid/svid.pem\", \"/etc/svid/svid_key.pem\"))\n   168\t    audit = AuditWriter(pool, registry.policy_version)\n   169\t    approvals = ApprovalStore(pool, CFG[\"approvals\"][\"ttl_seconds\"])\n   170\t    stop = StopControl(pool, CFG[\"stop\"][\"poll_seconds\"])\n   171\t    agent = Agent(\n   172\t        CFG, registry, AsyncAnthropic(max_retries=1), GatewayClient(mtls, CredentialBroker(mtls)),\n   173\t        PolicyIndex(pool, CFG[\"retrieval\"][\"top_k\"], CFG[\"retrieval\"][\"cache_ttl_seconds\"]),\n   174\t        approvals, QuotaStore(pool, CFG[\"budgets\"][\"quotas\"]), audit, stop,\n   175\t    )\n   176\t\n   177\t\n   178\tapp = Starlette(\n   179\t    routes=[\n   180\t        Route(\"/v1/chat\", chat, methods=[\"POST\"]),\n   181\t        Route(\"/v1/runs/{run_id}/approvals/{approval_id}/confirm\", confirm, methods=[\"POST\"]),\n   182\t    ],\n   183\t    on_startup=[startup],\n   184\t)\n     1\t\"\"\"Hard limits enforced by the harness, outside the model.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport time\n     5\tfrom collections import deque\n     6\tfrom dataclasses import dataclass, field\n     7\tfrom typing import Any\n     8\t\n     9\timport asyncpg\n    10\t\n    11\tfrom .audit import RunContext\n    12\t\n    13\t\n    14\tclass BudgetExceeded(Exception):\n    15\t    def __init__(self, limit: str):\n    16\t        super().__init__(limit)\n    17\t        self.limit = limit\n    18\t\n    19\t\n    20\t@dataclass\n    21\tclass RunBudget:\n    22\t    cfg: dict[str, Any]\n    23\t    pricing: dict[str, float]\n    24\t    started: float = field(default_factory=time.monotonic)\n    25\t    steps: int = 0\n    26\t    tokens: int = 0\n    27\t    cost_usd: float = 0.0\n    28\t    tool_calls: deque = field(default_factory=deque)\n    29\t\n    30\t    def check_step(self) -> None:\n    31\t        if self.steps >= self.cfg[\"max_steps\"]:\n    32\t            raise BudgetExceeded(\"max_steps\")\n    33\t        if time.monotonic() - self.started > self.cfg[\"max_wall_seconds\"]:\n    34\t            raise BudgetExceeded(\"max_wall_seconds\")\n    35\t        if self.tokens >= self.cfg[\"max_total_tokens\"]:\n    36\t            raise BudgetExceeded(\"max_total_tokens\")\n    37\t        if self.cost_usd >= self.cfg[\"max_cost_usd\"]:\n    38\t            raise BudgetExceeded(\"max_cost_usd\")\n    39\t        self.steps += 1\n    40\t\n    41\t    def remaining_seconds(self) -> float:\n    42\t        return max(0.0, self.cfg[\"max_wall_seconds\"] - (time.monotonic() - self.started))\n    43\t\n    44\t    def record_usage(self, usage: Any) -> tuple[int, float]:\n    45\t        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n    46\t        cache_write = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n    47\t        tokens_in = usage.input_tokens + cache_read + cache_write\n    48\t        tokens = tokens_in + usage.output_tokens\n    49\t        cost = (\n    50\t            (usage.input_tokens + cache_write) * self.pricing[\"input_per_mtok\"]\n    51\t            + cache_read * self.pricing[\"cache_read_per_mtok\"]\n    52\t            + usage.output_tokens * self.pricing[\"output_per_mtok\"]\n    53\t        ) / 1_000_000\n    54\t        self.tokens += tokens\n    55\t        self.cost_usd += cost\n    56\t        return tokens, cost\n    57\t\n    58\t    def check_tool_call(self) -> None:\n    59\t        now = time.monotonic()\n    60\t        while self.tool_calls and now - self.tool_calls[0] > 60:\n    61\t            self.tool_calls.popleft()\n    62\t        if len(self.tool_calls) >= self.cfg[\"max_tool_calls_per_minute\"]:\n    63\t            raise BudgetExceeded(\"max_tool_calls_per_minute\")\n    64\t        self.tool_calls.append(now)\n    65\t\n    66\t    def check_subagent(self, started_so_far: int) -> None:\n    67\t        if started_so_far >= self.cfg[\"max_subagents\"]:\n    68\t            raise BudgetExceeded(\"max_subagents\")\n    69\t\n    70\t\n    71\t_WINDOW = \"to_timestamp(floor(extract(epoch FROM now()) / $3) * $3)\"\n    72\t\n    73\t_RESERVE_RUN = f\"\"\"\n    74\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    75\tVALUES ($1, $2, {_WINDOW}, 1, 0, 0)\n    76\tON CONFLICT (scope, key, window_start) DO UPDATE\n    77\t   SET runs = quota.usage.runs + 1\n    78\t WHERE quota.usage.runs + 1 <= $4\n    79\t   AND quota.usage.tokens < $5\n    80\t   AND quota.usage.cost_usd < $6\n    81\tRETURNING runs\n    82\t\"\"\"\n    83\t\n    84\t_RECORD_USAGE = f\"\"\"\n    85\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    86\tVALUES ($1, $2, {_WINDOW}, 0, $4, $5)\n    87\tON CONFLICT (scope, key, window_start) DO UPDATE\n    88\t   SET tokens = quota.usage.tokens + EXCLUDED.tokens,\n    89\t       cost_usd = quota.usage.cost_usd + EXCLUDED.cost_usd\n    90\tRETURNING tokens, cost_usd\n    91\t\"\"\"\n    92\t\n    93\t\n    94\tclass QuotaStore:\n    95\t    \"\"\"Per-user, per-tenant and fleet-wide quotas, shared by every replica.\"\"\"\n    96\t\n    97\t    def __init__(self, pool: asyncpg.Pool, quotas: list[dict[str, Any]]):\n    98\t        self._pool = pool\n    99\t        self._quotas = quotas\n   100\t\n   101\t    def _key(self, scope: str, ctx: RunContext) -> str:\n   102\t        return {\"user\": ctx.subject, \"tenant\": ctx.tenant, \"fleet\": \"all\"}[scope]\n   103\t\n   104\t    async def reserve_run(self, ctx: RunContext) -> None:\n   105\t        async with self._pool.acquire() as conn, conn.transaction():\n   106\t            for q in self._quotas:\n   107\t                row = await conn.fetchrow(\n   108\t                    _RESERVE_RUN, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"],\n   109\t                    q[\"max_runs\"], q[\"max_tokens\"], q[\"max_cost_usd\"],\n   110\t                )\n   111\t                if row is None:\n   112\t                    raise BudgetExceeded(f\"quota:{q['scope']}\")\n   113\t\n   114\t    async def record_usage(self, ctx: RunContext, tokens: int, cost_usd: float) -> None:\n   115\t        \"\"\"Usage already spent is always recorded; the run stops once any window is over its limit.\"\"\"\n   116\t        exceeded: str | None = None\n   117\t        async with self._pool.acquire() as conn, conn.transaction():\n   118\t            for q in self._quotas:\n   119\t                row = await conn.fetchrow(\n   120\t                    _RECORD_USAGE, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"], tokens, cost_usd\n   121\t                )\n   122\t                if row[\"tokens\"] >= q[\"max_tokens\"] or row[\"cost_usd\"] >= q[\"max_cost_usd\"]:\n   123\t                    exceeded = exceeded or f\"quota:{q['scope']}\"\n   124\t        if exceeded:\n   125\t            raise BudgetExceeded(exceeded)\n     1\t\"\"\"Tool registry: the only tools this agent can see or call.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport pathlib\n     5\tfrom dataclasses import dataclass, field\n     6\tfrom typing import Any\n     7\t\n     8\timport yaml\n     9\t\n    10\tCONFIG_DIR = pathlib.Path(__file__).resolve().parent.parent / \"config\"\n    11\t\n    12\t\n    13\tdef load_yaml(name: str) -> dict[str, Any]:\n    14\t    with open(CONFIG_DIR / name, encoding=\"utf-8\") as fh:\n    15\t        return yaml.safe_load(fh)\n    16\t\n    17\t\n    18\t@dataclass(frozen=True)\n    19\tclass ToolSpec:\n    20\t    name: str\n    21\t    kind: str\n    22\t    qualified: str\n    23\t    reason: str\n    24\t    scope: str\n    25\t    approval: str\n    26\t    input_schema: dict[str, Any]\n    27\t    output_schema: dict[str, Any] | None = None\n    28\t    server: str | None = None\n    29\t    target_template: str | None = None\n    30\t    fingerprint: str | None = None\n    31\t    direct_route: dict[str, str] | None = field(default=None, hash=False)\n    32\t\n    33\t    def target(self, subject: str) -> str:\n    34\t        return (self.target_template or self.qualified).format(subject=subject)\n    35\t\n    36\t\n    37\tclass ToolRegistry:\n    38\t    def __init__(self, raw: dict[str, Any]):\n    39\t        self.policy_version: str = raw[\"policy_version\"]\n    40\t        self.servers: dict[str, dict[str, str]] = raw[\"servers\"]\n    41\t        self._tools: dict[str, ToolSpec] = {}\n    42\t        for name, t in raw[\"tools\"].items():\n    43\t            if not t.get(\"reason\"):\n    44\t                raise ValueError(f\"tool {name} has no task reason\")\n    45\t            if t[\"approval\"] not in (\"none\", \"subject\"):\n    46\t                raise ValueError(f\"tool {name}: unknown approval mode\")\n    47\t            self._tools[name] = ToolSpec(\n    48\t                name=name,\n    49\t                kind=t[\"kind\"],\n    50\t                qualified=t.get(\"qualified\", name),\n    51\t                reason=t[\"reason\"],\n    52\t                scope=t[\"scope\"],\n    53\t                approval=t[\"approval\"],\n    54\t                input_schema=t[\"input_schema\"],\n    55\t                output_schema=t.get(\"output_schema\"),\n    56\t                server=t.get(\"server\"),\n    57\t                target_template=t.get(\"target\"),\n    58\t                fingerprint=t.get(\"fingerprint\"),\n    59\t                direct_route=t.get(\"direct_route\"),\n    60\t            )\n    61\t\n    62\t    @classmethod\n    63\t    def from_config(cls) -> \"ToolRegistry\":\n    64\t        return cls(load_yaml(\"tools.yaml\"))\n    65\t\n    66\t    def get(self, name: str) -> ToolSpec | None:\n    67\t        # Exact key lookup only; no prefix, case folding or alias matching.\n    68\t        return self._tools.get(name)\n    69\t\n    70\t    def by_qualified(self, qualified: str) -> ToolSpec | None:\n    71\t        for spec in self._tools.values():\n    72\t            if spec.qualified == qualified:\n    73\t                return spec\n    74\t        return None\n    75\t\n    76\t    def model_schemas(self) -> list[dict[str, Any]]:\n    77\t        return [\n    78\t            {\"name\": s.name, \"description\": s.reason, \"input_schema\": s.input_schema}\n    79\t            for s in self._tools.values()\n    80\t        ]\n     1\t\"\"\"agent-type-id: SHA-256 over every identity-defining input.\n     2\t\n     3\tInputs (all, no exclusions):\n     4\t  - every file under src/, prompts/ and config/, plus requirements.txt and Dockerfile\n     5\t  - the image digest the pod runs\n     6\t  - the model record (provider, requested ID, snapshot/alias label, adapter)\n     7\tCanonical form: JSON with sorted keys, no whitespace, file paths relative to the repo root\n     8\tin POSIX form, each file hashed as raw bytes. The same command runs in CI (to stamp the\n     9\trelease manifest) and at pod start (to refuse running under an identity it does not match).\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport hashlib\n    14\timport json\n    15\timport pathlib\n    16\timport sys\n    17\tfrom typing import Any\n    18\t\n    19\tROOT = pathlib.Path(__file__).resolve().parent.parent\n    20\tINPUT_DIRS = (\"src\", \"prompts\", \"config\")\n    21\tINPUT_FILES = (\"requirements.txt\", \"Dockerfile\")\n    22\tHASH_SCHEME = \"acme-agent-type-id/v1\"\n    23\t\n    24\t\n    25\tdef _file_hashes() -> dict[str, str]:\n    26\t    out: dict[str, str] = {}\n    27\t    for d in INPUT_DIRS:\n    28\t        for p in sorted((ROOT / d).rglob(\"*\")):\n    29\t            if p.is_file():\n    30\t                out[p.relative_to(ROOT).as_posix()] = hashlib.sha256(p.read_bytes()).hexdigest()\n    31\t    for f in INPUT_FILES:\n    32\t        out[f] = hashlib.sha256((ROOT / f).read_bytes()).hexdigest()\n    33\t    return out\n    34\t\n    35\t\n    36\tdef compute(image_digest: str, model: dict[str, Any]) -> tuple[str, dict[str, Any]]:\n    37\t    if not image_digest.startswith(\"sha256:\") or len(image_digest) != 71:\n    38\t        raise ValueError(\"image digest must be sha256:<64 hex>\")\n    39\t    for k in (\"provider\", \"id\", \"pinning\", \"adapter\"):\n    40\t        if k not in model:\n    41\t            raise ValueError(f\"model record missing {k}\")\n    42\t    manifest = {\"scheme\": HASH_SCHEME, \"image_digest\": image_digest, \"model\": model, \"files\": _file_hashes()}\n    43\t    canonical = json.dumps(manifest, sort_keys=True, separators=(\",\", \":\")).encode()\n    44\t    return \"sha256:\" + hashlib.sha256(canonical).hexdigest(), manifest\n    45\t\n    46\t\n    47\tdef model_record(cfg: dict[str, Any]) -> dict[str, Any]:\n    48\t    m = cfg[\"model\"]\n    49\t    return {\"provider\": m[\"provider\"], \"id\": m[\"id\"], \"pinning\": m[\"pinning\"], \"adapter\": m[\"adapter\"]}\n    50\t\n    51\t\n    52\tdef verify_or_exit(expected: str, image_digest: str, model: dict[str, Any]) -> str:\n    53\t    actual, _ = compute(image_digest, model)\n    54\t    if actual != expected:\n    55\t        print(f\"agent-type-id mismatch: expected {expected}, computed {actual}\", file=sys.stderr)\n    56\t        sys.exit(78)\n    57\t    return actual\n    58\t\n    59\t\n    60\tif __name__ == \"__main__\":\n    61\t    import yaml\n    62\t\n    63\t    cfg = yaml.safe_load((ROOT / \"config\" / \"agent.yaml\").read_text())\n    64\t    tid, man = compute(sys.argv[1], model_record(cfg))\n    65\t    json.dump({\"agent_type_id\": tid, \"inputs\": man}, sys.stdout, indent=2, sort_keys=True)\n     1\t\"\"\"Stop control. Flags live in control.stop_flags, which the agent's DB role can only read.\n     2\t\n     3\tOperators set flags with the hr_agent_operator role (see README \"Stopping the agent\").\n     4\tThe tool gateway reads the same table, so a stopped instance is refused there too.\n     5\t\"\"\"\n     6\tfrom __future__ import annotations\n     7\t\n     8\timport asyncio\n     9\timport logging\n    10\t\n    11\timport asyncpg\n    12\t\n    13\tfrom .audit import RunContext\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.stop\")\n    16\t\n    17\t_QUERY = \"\"\"\n    18\tSELECT reason FROM control.stop_flags\n    19\tWHERE active\n    20\t  AND (   scope = 'fleet'\n    21\t       OR (scope = 'agent_type'     AND value = $1)\n    22\t       OR (scope = 'agent_instance' AND value = $2)\n    23\t       OR (scope = 'subject'        AND value = $3)\n    24\t       OR (scope = 'agent_principal' AND value = $4))\n    25\tLIMIT 1\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass Stopped(Exception):\n    30\t    pass\n    31\t\n    32\t\n    33\tclass StopControl:\n    34\t    def __init__(self, pool: asyncpg.Pool, poll_seconds: float):\n    35\t        self._pool = pool\n    36\t        self._poll = poll_seconds\n    37\t\n    38\t    async def reason(self, ctx: RunContext) -> str | None:\n    39\t        try:\n    40\t            row = await self._pool.fetchrow(\n    41\t                _QUERY, ctx.agent_type_id, ctx.agent_instance_id, ctx.subject, ctx.agent_principal, timeout=1.0\n    42\t            )\n    43\t        except Exception:\n    44\t            return \"stop store unreachable\"\n    45\t        return row[\"reason\"] if row else None\n    46\t\n    47\t    async def raise_if_stopped(self, ctx: RunContext) -> None:\n    48\t        why = await self.reason(ctx)\n    49\t        if why:\n    50\t            raise Stopped(why)\n    51\t\n    52\t    async def watch(self, ctx: RunContext, task: asyncio.Task) -> None:\n    53\t        \"\"\"Cancel the run task, including any in-flight model or tool call, once a flag appears.\"\"\"\n    54\t        while not task.done():\n    55\t            why = await self.reason(ctx)\n    56\t            if why:\n    57\t                log.warning(\"stop flag observed\", extra={\"run_id\": ctx.run_id, \"reason\": why})\n    58\t                task.cancel(msg=f\"stopped: {why}\")\n    59\t                return\n    60\t            await asyncio.sleep(self._poll)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_015L5ByWnWa1X9bPaknzqfrg","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
