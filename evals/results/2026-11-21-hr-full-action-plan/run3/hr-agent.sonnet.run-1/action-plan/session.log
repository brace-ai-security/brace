   subject: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    49\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    50\t                    rekor: {url: \"https://rekor.sigstore.dev\"}\n    51\t          attestations:\n    52\t            - type: https://slsa.dev/provenance/v1\n    53\t              attestors:\n    54\t                - entries:\n    55\t                    - keyless:\n    56\t                        subject: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    57\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    58\t              conditions:\n    59\t                - all:\n    60\t                    - key: \"{{ buildDefinition.buildType }}\"\n    61\t                      operator: Equals\n    62\t                      value: \"https://actions.github.io/buildtypes/workflow/v1\"\n    63\t                    - key: \"{{ buildDefinition.externalParameters.workflow.repository }}\"\n    64\t                      operator: Equals\n    65\t                      value: \"https://github.com/acme/hr-helpdesk-agent\"\n    66\t                    - key: \"{{ buildDefinition.externalParameters.workflow.ref }}\"\n    67\t                      operator: Equals\n    68\t                      value: \"refs/heads/main\"\n    69\t                    - key: \"{{ runDetails.builder.id }}\"\n    70\t                      operator: Equals\n    71\t                      value: \"https://github.com/actions/runner/github-hosted\"\n    72\t        - imageReferences: [\"registry.acme.example/platform/*\"]\n    73\t          mutateDigest: false\n    74\t          verifyDigest: true\n    75\t          required: true\n    76\t          attestors:\n    77\t            - entries:\n    78\t                - keyless:\n    79\t                    subject: \"https://github.com/acme/platform-images/.github/workflows/build.yml@refs/heads/main\"\n    80\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    81\t                    rekor: {url: \"https://rekor.sigstore.dev\"}\n     1\tapiVersion: batch/v1\n     2\tkind: CronJob\n     3\tmetadata:\n     4\t  name: audit-partition-maintenance\n     5\t  namespace: hr-agent\n     6\t  labels: {app.kubernetes.io/part-of: hr-helpdesk}\n     7\tspec:\n     8\t  schedule: \"17 2 * * *\"\n     9\t  concurrencyPolicy: Forbid\n    10\t  jobTemplate:\n    11\t    spec:\n    12\t      backoffLimit: 2\n    13\t      template:\n    14\t        metadata:\n    15\t          labels: {app: audit-maintenance}\n    16\t        spec:\n    17\t          serviceAccountName: hr-audit-maint\n    18\t          automountServiceAccountToken: false\n    19\t          restartPolicy: OnFailure\n    20\t          securityContext:\n    21\t            runAsNonRoot: true\n    22\t            runAsUser: 70\n    23\t            seccompProfile: {type: RuntimeDefault}\n    24\t          containers:\n    25\t            - name: maintain\n    26\t              image: registry.acme.example/platform/psql@sha256:9b2e61c04d7f3a85e1c6b09d2f4a7e3c58d1b6a0f9e2c47d3b8a15e6f0c9d2a4\n    27\t              env:\n    28\t                - name: PGSERVICE\n    29\t                  value: hr_audit_maint\n    30\t                - name: PERIOD\n    31\t                  value: \"1 week\"\n    32\t                - name: AHEAD\n    33\t                  value: \"4\"\n    34\t                - name: KEEP_PARTITIONS\n    35\t                  value: \"6\"\n    36\t              command: [\"psql\", \"-v\", \"ON_ERROR_STOP=1\", \"-c\"]\n    37\t              args:\n    38\t                - >-\n    39\t                  SELECT audit.maintain_partitions('audit.events', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    40\t                  SELECT audit.maintain_partitions('audit.gateway_decisions', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    41\t              securityContext:\n    42\t                allowPrivilegeEscalation: false\n    43\t                readOnlyRootFilesystem: true\n    44\t                capabilities: {drop: [ALL]}\n    45\t              volumeMounts:\n    46\t                - {name: pgservice, mountPath: /etc/postgresql-common, readOnly: true}\n    47\t          volumes:\n    48\t            - name: pgservice\n    49\t              secret: {secretName: hr-audit-maint-pgservice}\n     1\trelease:\n     2\t  name: hr-helpdesk-agent\n     3\t  version: \"1.8.0\"\n     4\t  git_sha: \"\"            # stamped by CI\n     5\t  agent_type_id: \"\"      # stamped by CI (src/type_id.py, scheme acme-agent-type-id/v1)\n     6\t  image:\n     7\t    repository: registry.acme.example/people/hr-helpdesk-agent\n     8\t    digest: \"\"           # stamped by CI\n     9\t    signer: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    10\t    sbom: attached (BuildKit SPDX)\n    11\t    provenance: SLSA v1 via actions/attest-build-provenance\n    12\t  owners:\n    13\t    accountable_party: \"VP People Operations\"\n    14\t    operational_owner: people-platform\n    15\t\n    16\tstakes:\n    17\t  rating: moderate\n    18\t  autonomy: low (every write requires the employee's confirmation)\n    19\t  rationale: >-\n    20\t    Reads one employee's own leave data and the handbook; writes are leave requests that a\n    21\t    manager must still approve in HRIS, and helpdesk tickets. Worst credible harm: disclosure of\n    22\t    one employee's HR data to another employee, or a misleading policy answer.\n    23\t  approved_by: \"Head of Security Engineering, 2026-09-19\"\n    24\t\n    25\tcapability_combination:\n    26\t  untrusted_input: yes (employee messages, handbook passages, tool output)\n    27\t  sensitive_access: yes (leave records, employee-specific HR documents)\n    28\t  external_change_or_send: yes (leave requests, helpdesk tickets)\n    29\t  containment: every consequential tool requires per-action employee approval bound to args\n    30\t\n    31\tharness:\n    32\t  files: [src/]\n    33\t  entrypoints: {agent: \"src.main:app\", gateway: \"src.gateway:app\"}\n    34\tsystem_prompt: {path: prompts/system.md}\n    35\trules_files: []\n    36\tconfiguration: [config/agent.yaml, config/tools.yaml]\n    37\t\n    38\tmodels:\n    39\t  primary:\n    40\t    role: main agent\n    41\t    owner: people-platform\n    42\t    identity: {provider: anthropic, id: claude-sonnet-4-5-20250929, pinning: snapshot, adapter: none}\n    43\t    pinning_source: \"Anthropic models overview, checked 2026-09-15\"\n    44\t    served_version: recorded per call in audit.events.model_served\n    45\t    fine_tune: none\n    46\t    training_runs: not applicable\n    47\t    training_data: provider-undisclosed\n    48\t  helpers: []            # retrieval is Postgres full-text search; no embedding or reranker model\n    49\t\n    50\ttools:\n    51\t  built_in: []\n    52\t  local: [search_policies]\n    53\t  mcp_servers:\n    54\t    - {id: hris, identity: \"spiffe://acme.example/ns/hris/sa/hris-mcp\", owner: hris-platform, tools: [get_leave_balance, file_leave_request]}\n    55\t    - {id: helpdesk, identity: \"spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\", owner: it-service-desk, tools: [create_ticket]}\n    56\t  policy_version_source: config/tools.yaml#policy_version\n    57\t\n    58\tpermissions:\n    59\t  sts_scopes: [hr.policy.read, hris.leave.read, hris.leave.request, helpdesk.ticket.create]\n    60\t  token_ttl_seconds: 300\n    61\t  database_role: hr_agent (see migrations/001_init.sql grants)\n    62\t\n    63\tmemory: none (conversation state is held per run and discarded; no cross-run memory)\n    64\tretrieval:\n    65\t  store: retrieval.chunks (Postgres FTS)\n    66\t  writers: [hr_docs_ingest]\n    67\t  filters: [quarantined, expires_at, audience/allowed_employees]\n    68\t\n    69\tidentity_bindings:\n    70\t  agent: 