 toPorts: [{ports: [{port: \"5432\", protocol: TCP}]}]\n    86\t  egressDeny:\n    87\t    - toCIDR: [169.254.169.254/32, 169.254.170.2/32, 100.100.100.200/32]\n    88\t    - toCIDRSet:\n    89\t        - cidr: fd00:ec2::254/128\n     1\tapiVersion: v1\n     2\tkind: ServiceAccount\n     3\tmetadata:\n     4\t  name: hr-helpdesk-agent\n     5\t  namespace: hr-agent\n     6\tautomountServiceAccountToken: false\n     7\t---\n     8\tapiVersion: v1\n     9\tkind: ServiceAccount\n    10\tmetadata:\n    11\t  name: hr-tool-gateway\n    12\t  namespace: hr-agent\n    13\tautomountServiceAccountToken: false\n    14\t---\n    15\tapiVersion: apps/v1\n    16\tkind: Deployment\n    17\tmetadata:\n    18\t  name: hr-helpdesk-agent\n    19\t  namespace: hr-agent\n    20\t  labels: {app: hr-helpdesk-agent, app.kubernetes.io/part-of: hr-helpdesk}\n    21\tspec:\n    22\t  replicas: 3\n    23\t  selector:\n    24\t    matchLabels: {app: hr-helpdesk-agent}\n    25\t  template:\n    26\t    metadata:\n    27\t      labels: {app: hr-helpdesk-agent}\n    28\t      annotations:\n    29\t        acme.example/release-manifest: \"release/manifest.yaml@${GIT_SHA}\"\n    30\t    spec:\n    31\t      serviceAccountName: hr-helpdesk-agent\n    32\t      automountServiceAccountToken: false\n    33\t      hostUsers: false\n    34\t      enableServiceLinks: false\n    35\t      securityContext:\n    36\t        runAsNonRoot: true\n    37\t        runAsUser: 65532\n    38\t        runAsGroup: 65532\n    39\t        fsGroup: 65532\n    40\t        seccompProfile: {type: RuntimeDefault}\n    41\t      containers:\n    42\t        - name: agent\n    43\t          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n    44\t          args: [\"-m\", \"uvicorn\", \"src.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\"]\n    45\t          ports: [{containerPort: 8080}]\n    46\t          env:\n    47\t            - {name: AGENT_TYPE_ID, value: \"${AGENT_TYPE_ID}\"}\n    48\t            - {name: IMAGE_DIGEST, value: \"${IMAGE_DIGEST}\"}\n    49\t            - name: POD_UID\n    50\t              valueFrom: {fieldRef: {fieldPath: metadata.uid}}\n    51\t            - name: DATABASE_URL\n    52\t              valueFrom: {secretKeyRef: {name: hr-agent-db, key: url}}\n    53\t            - name: ANTHROPIC_API_KEY\n    54\t              valueFrom: {secretKeyRef: {name: hr-agent-anthropic, key: api_key}}\n    55\t            - {name: ANTHROPIC_BASE_URL, value: \"https://api.anthropic.com\"}\n    56\t          securityContext:\n    57\t            allowPrivilegeEscalation: false\n    58\t            readOnlyRootFilesystem: true\n    59\t            privileged: false\n    60\t            capabilities: {drop: [ALL]}\n    61\t          resources:\n    62\t            requests: {cpu: 250m, memory: 384Mi}\n    63\t            limits: {cpu: \"1\", memory: 768Mi}\n    64\t          volumeMounts:\n    65\t            - {name: tmp, mountPath: /tmp}\n    66\t            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n    67\t            - {name: svid, mountPath: /etc/svid, readOnly: true}\n    68\t      volumes:\n    69\t        - name: tmp\n    70\t          emptyDir: {medium: Memory, sizeLimit: 32Mi}\n    71\t        - name: sts-token\n    72\t          projected:\n    73\t            sources:\n    74\t              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n    75\t        - name: svid\n    76\t          csi: {driver: csi.spiffe.io, readOnly: true}\n    77\t---\n    78\tapiVersion: apps/v1\n    79\tkind: Deployment\n    80\tmetadata:\n    81\t  name: hr-tool-gateway\n    82\t  namespace: hr-agent\n    83\t  labels: {app: hr-tool-gateway, app.kubernetes.io/part-of: hr-helpdesk}\n    84\tspec:\n    85\t  replicas: 2\n    86\t  selector:\n    87\t    matchLabels: {app: hr-tool-gateway}\n    88\t  template:\n    89\t    metadata:\n    90\t      labels: {app: hr-tool-gateway}\n    91\t    spec:\n    92\t      serviceAccountName: hr-tool-gateway\n    93\t      automountServiceAccountToken: false\n    94\t      hostUsers: false\n    95\t      enableServiceLinks: false\n    96\t      securityContext:\n    97\t        runAsNonRoot: true\n    98\t        runAsUser: 65532\n    99\t        runAsGroup: 65532\n   100\t        seccompProfile: {type: RuntimeDefault}\n   101\t      containers:\n   102\t        - name: gateway\n   103\t          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n   104\t          args: [\"-m\", \"uvicorn\", \"src.gateway:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8443\"]\n   105\t          ports: [{containerPort: 8443}]\n   106\t          env:\n   107\t            - name: GATEWAY_DATABASE_URL\n   108\t              valueFrom: {secretKeyRef: {name: hr-gateway-db, key: url}}\n   109\t          securityContext:\n   110\t            allowPrivilegeEscalation: false\n   111\t            readOnlyRootFilesystem: true\n   112\t            privileged: false\n   113\t            capabilities: {drop: [ALL]}\n   114\t          volumeMounts:\n   115\t            - {name: tmp, mountPath: /tmp}\n   116\t            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n   117\t            - {name: svid, mountPath: /etc/svid, readOnly: true}\n   118\t      volumes:\n   119\t        - name: tmp\n   120\t          emptyDir: {medium: Memory, sizeLimit: 16Mi}\n   121\t        - name: sts-token\n   122\t          projected:\n   123\t            sources:\n   124\t              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n   125\t        - name: svid\n   126\t          csi: {driver: csi.spiffe.io, readOnly: true}\n   127\t---\n   128\tapiVersion: v1\n   129\tkind: Service\n   130\tmetadata:\n   131\t  name: hr-tool-gateway\n   132\t  namespace: hr-agent\n   133\tspec:\n   134\t  selector: {app: hr-tool-gateway}\n   135\t  ports: [{port: 8443, targetPort: 8443}]\n   136\t---\n   137\tapiVersion: v1\n   138\tkind: Service\n   139\tmetadata:\n   140\t  name: hr-helpdesk-agent\n   141\t  namespace: hr-agent\n   142\tspec:\n   143\t  selector: {app: hr-helpdesk-agent}\n   144\t  sessionAffinity: ClientIP\n   145\t  ports: [{port: 80, targetPort: 8080}]\n     1\tapiVersion: batch/v1\n     2\tkind: CronJob\n     3\tmetadata:\n     4\t  name: audit-partition-maintenance\n     5\t  namespace: hr-agent\n     6\t  labels: {app.kubernetes.io/part-of: hr-helpdesk}\n     7\tspec:\n     8\t  schedule: \"17 2 * * *\"\n     9\t  concurrencyPolicy: Forbid\n    10\t  jobTemplate:\n    11\t    spec:\n    12\t      backoffLimit: 2\n    13\t      template:\n    14\t        metadata:\n    15\t          labels: {app: audit-maintenance}\n    16\t        spec:\n    17\t          serviceAccountName: hr-audit-maint\n    18\t          automountServiceAccountToken: false\n    19\t          restartPolicy: OnFailure\n    20\t          securityContext:\n    21\t            runAsNonRoot: true\n    22\t            runAsUser: 70\n    23\t            seccompProfile: {type: RuntimeDefault}\n    24\t          containers:\n    25\t            - name: maintain\n    26\t              image: registry.acme.example/platform/psql@sha256:9b2e61c04d7f3a85e1c6b09d2f4a7e3c58d1b6a0f9e2c47d3b8a15e6f0c9d2a4\n    27\t              env:\n    28\t                - name: PGSERVICE\n    29\t                  value: hr_audit_maint\n    30\t                - name: PERIOD\n    31\t                  value: \"1 week\"\n    32\t                - name: AHEAD\n    33\t                  value: \"4\"\n    34\t                - name: KEEP_PARTITIONS\n    35\t                  value: \"6\"\n    36\t              command: [\"psql\", \"-v\", \"ON_ERROR_STOP=1\", \"-c\"]\n    37\t              args:\n    38\t                - >-\n    39\t                  SELECT audit.maintain_partitions('audit.events', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    40\t                  SELECT audit.maintain_partitions('audit.gateway_decisions', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    41\t              securityContext:\n    42\t                allowPrivilegeEscalation: false\n    43\t                readOnlyRootFilesystem: true\n    44\t                capabilities: {drop: [ALL]}\n    45\t              volumeMounts:\n    46\t                - {name: pgservice, mountPath: /etc/postgresql-common, readOnly: true}\n    47\t          volumes:\n    48\t            - name: pgservice\n    49\t              secret: {secretName: hr-audit-maint-pgservice}\n     1\t{\n     2\t  \"mcpServers\": {\n     3\t    \"hr-tool-gateway\": {\n     4\t      \"type\": \"http\",\n     5\t      \"url\": \"https://hr-tool-gateway.hr-agent.svc.cluster.local:8443/mcp\",\n     6\t      \"headers\": {\n     7\t        \"Authorization\": \"Bearer ${HR_GATEWAY_TOKEN}\"\n     8\t      }\n     9\t    }\n    10\t  }\n    11\t}\n     1\tpolicy_version: \"2026-09-18.3\"\n     2\t\n     3\tservers:\n     4\t  hris:\n     5\t    endpoint: https://hris-mcp.hris.svc.cluster.local:8443/mcp\n     6\t    identity: spiffe://acme.example/ns/hris/sa/hris-mcp\n     7\t    downstream_audience: hris-mcp\n     8\t    owner: hris-platform\n     9\t  helpdesk:\n    10\t    endpoint: https://helpdesk-mcp.helpdesk.svc.cluster.local:8443/mcp\n    11\t    identity: spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\n    12\t    downstream_audience: helpdesk-mcp\n    13\t    owner: it-service-desk\n    14\t\n    15\t# Model-facing name -> qualified tool. Server annotations (readOnlyHint etc.)\n    16\t# are never consulted; approval comes only from this file.\n    17\ttools:\n    18\t  search_policies:\n    19\t    kind: local\n    20\t    reason: \"Answer policy questions from the approved HR handbook index.\"\n    21\t    scope: hr.policy.read\n    22\t    approval: none\n    23\t    input_schema:\n    24\t      type: object\n    25\t      properties:\n    26\t        query: {type: string, minLength: 3, maxLength: 300}\n    27\t      required: [query]\n    28\t      additionalProperties: false\n    29\t\n    30\t  get_leave_balance:\n    31\t    kind: mcp\n    32\t    qualified: hris/get_leave_balance\n    33\t    server: hris\n    34\t    reason: \"Show the asking employee their own leave balance.\"\n    35\t    scope: hris.leave.read\n    36\t    approval: none\n    37\t    target: \"employee:{subject}\"\n    38\t    fingerprint: \"sha256:5d1c0e9a7b3f48e2a61c9d04f7be3a92c815e6d07ab4f3c2e19d8a6b5c4f0e71\"\n    39\t    input_schema:\n    40\t      type: object\n    41\t      properties:\n    42\t        leave_type: {enum: [annual, sick, parental, unpaid]}\n    43\t      required: [leave_type]\n    44\t      additionalProperties: false\n    45\t    output_schema:\n    46\t      type: object\n    47\t      properties:\n    48\t        leave_type: {type: string, maxLength: 20}\n    49\t        balance_days: {type: number, minimum: 0, maximum: 400}\n    50\t        accrual_per_month: {type: number, minimum: 0, maximum: 5}\n    51\t        as_of: {type: string, format: date}\n    52\t      required: [leave_type, balance_days, as_of]\n    53\t      additionalProperties: false\n    54\t\n    55\t  file_leave_request:\n    56\t    kind: mcp\n    57\t    qualified: hris/file_leave_request\n    58\t    server: hris\n    59\t    reason: \"File a leave request for the asking employee; the manager approves it in HRIS.\"\n    60\t    scope: hris.leave.request\n    61\t    approval: subject\n    62\t    target: \"employee:{subject}\"\n    63\t    fingerprint: \"sha256:a0f7c3d95e21b84f6c0d19e3a7b25f48d6e0c1a93b7f2e54d81c6a09f3e7b2d4\"\n    64\t    input_schema:\n    65\t      type: object\n    66\t      properties:\n    67\t        leave_type: {enum: [annual, sick, parental, unpaid]}\n    68\t        start_date: {type: string, format: date}\n    69\t        end_date: {type: string, format: date}\n    70\t        note: {type: string, maxLength: 280}\n    71\t      required: [leave_type, start_date, end_date]\n    72\t      additionalProperties: false\n    73\t    output_schema:\n    74\t      type: object\n    75\t      properties:\n    76\t        request_id: {type: string, pattern: \"^LR-[0-9]{8}$\"}\n    77\t        status: {enum: [submitted, duplicate]}\n    78\t        approver_role: {type: string, maxLength: 40}\n    79\t      required: [request_id, status]\n    80\t      additionalProperties: false\n    81\t\n    82\t  escalate_to_human:\n    83\t    kind: mcp\n    84\t    qualified: helpdesk/create_ticket\n    85\t    server: helpdesk\n    86\t    reason: \"Hand the conversation to an HR advisor when the agent cannot help.\"\n    87\t    scope: helpdesk.ticket.create\n    88\t    approval: subject\n    89\t    target: \"queue:hr-advisors\"\n    90\t    fingerprint: \"sha256:3e9b71f0c2d84a6e5b17f9c03d2a8e46b1f5c07d93a2e68b4c1d0f7a5e3b9c28\"\n    91\t    direct_route:\n    92\t      endpoint: https://helpdesk-mcp.helpdesk.svc.cluster.local:8443/mcp\n    93\t      audience: helpdesk-mcp\n    94\t    input_schema:\n    95\t      type: object\n    96\t      properties:\n    97\t        summary: {type: string, minLength: 10, maxLength: 1000}\n    98\t        category: {enum: [payroll, leave, benefits, conduct, other]}\n    99\t      required: [summary, category]\n   100\t      additionalProperties: false\n   101\t    output_schema:\n   102\t      type: object\n   103\t      properties:\n   104\t        ticket_id: {type: string, pattern: \"^HR-[0-9]{6}$\"}\n   105\t        queue: {type: string, maxLength: 40}\n   106\t      required: [ticket_id]\n   107\t      additionalProperties: false\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.12.7-slim-bookworm@sha256:032c52613401895aa3d418a4c5bf5c3ad0d5d6fe3c1e9b2c8b5d0a7e6f4c3b21 AS build\n     3\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     4\tWORKDIR /build\n     5\tCOPY requirements.txt .\n     6\tRUN pip install --require-hashes --only-binary=:all: --target /deps -r requir