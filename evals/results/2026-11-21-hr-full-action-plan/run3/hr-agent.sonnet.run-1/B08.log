n    14\t        metadata:\n    15\t          labels: {app: audit-maintenance}\n    16\t        spec:\n    17\t          serviceAccountName: hr-audit-maint\n    18\t          automountServiceAccountToken: false\n    19\t          restartPolicy: OnFailure\n    20\t          securityContext:\n    21\t            runAsNonRoot: true\n    22\t            runAsUser: 70\n    23\t            seccompProfile: {type: RuntimeDefault}\n    24\t          containers:\n    25\t            - name: maintain\n    26\t              image: registry.acme.example/platform/psql@sha256:9b2e61c04d7f3a85e1c6b09d2f4a7e3c58d1b6a0f9e2c47d3b8a15e6f0c9d2a4\n    27\t              env:\n    28\t                - name: PGSERVICE\n    29\t                  value: hr_audit_maint\n    30\t                - name: PERIOD\n    31\t                  value: \"1 week\"\n    32\t                - name: AHEAD\n    33\t                  value: \"4\"\n    34\t                - name: KEEP_PARTITIONS\n    35\t                  value: \"6\"\n    36\t              command: [\"psql\", \"-v\", \"ON_ERROR_STOP=1\", \"-c\"]\n    37\t              args:\n    38\t                - >-\n    39\t                  SELECT audit.maintain_partitions('audit.events', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    40\t                  SELECT audit.maintain_partitions('audit.gateway_decisions', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    41\t              securityContext:\n    42\t                allowPrivilegeEscalation: false\n    43\t                readOnlyRootFilesystem: true\n    44\t                capabilities: {drop: [ALL]}\n    45\t              volumeMounts:\n    46\t                - {name: pgservice, mountPath: /etc/postgresql-common, readOnly: true}\n    47\t          volumes:\n    48\t            - name: pgservice\n    49\t              secret: {secretName: hr-audit-maint-pgservice}\n     1\t{\n     2\t  \"mcpServers\": {\n     3\t    \"hr-tool-gateway\": {\n     4\t      \"type\": \"http\",\n     5\t      \"url\": \"https://hr-tool-gateway.hr-agent.svc.cluster.local:8443/mcp\",\n     6\t      \"headers\": {\n     7\t        \"Authorization\": \"Bearer ${HR_GATEWAY_TOKEN}\"\n     8\t      }\n     9\t    }\n    10\t  }\n    11\t}\n     1\tpolicy_version: \"2026-09-18.3\"\n     2\t\n     3\tservers:\n     4\t  hris:\n     5\t    endpoint: https://hris-mcp.hris.svc.cluster.local:8443/mcp\n     6\t    identity: spiffe://acme.example/ns/hris/sa/hris-mcp\n     7\t    downstream_audience: hris-mcp\n     8\t    owner: hris-platform\n     9\t  helpdesk:\n    10\t    endpoint: https://helpdesk-mcp.helpdesk.svc.cluster.local:8443/mcp\n    11\t    identity: spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\n    12\t    downstream_audience: helpdesk-mcp\n    13\t    owner: it-service-desk\n    14\t\n    15\t# Model-facing name -> qualified tool. Server annotations (readOnlyHint etc.)\n    16\t# are never consulted; approval comes only from this file.\n    17\ttools:\n    18\t  search_policies:\n    19\t    kind: local\n    20\t    reason: \"Answer policy questions from the approved HR handbook index.\"\n    21\t    scope: hr.policy.read\n    22\t    approval: none\n    23\t    input_schema:\n    24\t      type: object\n    25\t      properties:\n    26\t        query: {type: string, minLength: 3, maxLength: 300}\n    27\t      required: [query]\n    28\t      additionalProperties: false\n    29\t\n    30\t  get_leave_balance:\n    31\t    kind: mcp\n    32\t    qualified: hris/get_leave_balance\n    33\t    server: hris\n    34\t    reason: \"Show the asking employee their own leave balance.\"\n    35\t    scope: hris.leave.read\n    36\t    approval: none\n    37\t    target: \"employee:{subject}\"\n    38\t    fingerprint: \"sha256:5d1c0e9a7b3f48e2a61c9d04f7be3a92c815e6d07ab4f3c2e19d8a6b5c4f0e71\"\n    39\t    input_schema:\n    40\t      type: object\n    41\t      properties:\n    42\t        leave_type: {enum: [annual, sick, parental, unpaid]}\n    43\t      required: [leave_type]\n    44\t      additionalProperties: false\n    45\t    output_schema:\n    46\t      type: object\n    47\t      properties:\n    48\t        leave_type: {type: string, maxLength: 20}\n    49\t        balance_days: {type: number, minimum: 0, maximum: 400}\n    50\t        accrual_per_month: {type: number, minimum: 0, maximum: 5}\n    51\t        as_of: {type: string, format: date}\n    52\t      required: [leave_type, balance_days, as_of]\n    53\t      additionalProperties: false\n    54\t\n    55\t  file_leave_request:\n    56\t    kind: mcp\n    57\t    qualified: hris/file_leave_request\n    58\t    server: hris\n    59\t    reason: \"File a leave request for the asking employee; the manager approves it in HRIS.\"\n    60\t    scope: hris.leave.request\n    61\t    approval: subject\n    62\t    target: \"employee:{subject}\"\n    63\t    fingerprint: \"sha256:a0f7c3d95e21b84f6c0d19e3a7b25f48d6e0c1a93b7f2e54d81c6a09f3e7b2d4\"\n    64\t    input_schema:\n    65\t      type: object\n    66\t      properties:\n    67\t        leave_type: {enum: [annual, sick, parental, unpaid]}\n    68\t        start_date: {type: string, format: date}\n    69\t        end_date: {type: string, format: date}\n    70\t        note: {type: string, maxLength: 280}\n    71\t      required: [leave_type, start_date, end_date]\n    72\t      additionalProperties: false\n    73\t    output_schema:\n    74\t      type: object\n    75\t      properties:\n    76\t        request_id: {type: string, pattern: \"^LR-[0-9]{8}$\"}\n    77\t        status: {enum: [submitted, duplicate]}\n    78\t        approver_role: {type: string, maxLength: 40}\n    79\t      required: [request_id, status]\n    80\t      additionalProperties: false\n    81\t\n    82\t  escalate_to_human:\n    83\t    kind: mcp\n    84\t    qualified: helpdesk/create_ticket\n    85\t    server: helpdesk\n    86\t    reason: \"Hand the conversation to an HR advisor when the agent cannot help.\"\n    87\t    scope: helpdesk.ticket.create\n    88\t    approval: subject\n    89\t    target: \"queue:hr-advisors\"\n    90\t    fingerprint: \"sha256:3e9b71f0c2d84a6e5b17f9c03d2a8e46b1f5c07d93a2e68b4c1d0f7a5e3b9c28\"\n    91\t    direct_route:\n    92\t      endpoint: https://helpdesk-mcp.helpdesk.svc.cluster.local:8443/mcp\n    93\t      audience: helpdesk-mcp\n    94\t    input_schema:\n    95\t      type: object\n    96\t      properties:\n    97\t        summary: {type: string, minLength: 10, maxLength: 1000}\n    98\t        category: {enum: [payroll, leave, benefits, conduct, other]}\n    99\t      required: [summary, category]\n   100\t      additionalProperties: false\n   101\t    output_schema:\n   102\t      type: object\n   103\t      properties:\n   104\t        ticket_id: {type: string, pattern: \"^HR-[0-9]{6}$\"}\n   105\t        queue: {type: string, maxLength: 40}\n   106\t      required: [ticket_id]\n   107\t      additionalProperties: false\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.12.7-slim-bookworm@sha256:032c52613401895aa3d418a4c5bf5c3ad0d5d6fe3c1e9b2c8b5d0a7e6f4c3b21 AS build\n     3\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     4\tWORKDIR /build\n     5\tCOPY requirements.txt .\n     6\tRUN pip install --require-hashes --only-binary=:all: --target /deps -r requirements.txt\n     7\t\n     8\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:7e4c1d2a9f3b8e60c5d47a19b2f03e8d6c1a5b94f7e2d03c8a6b1f5e9d4c2a70\n     9\tENV PYTHONPATH=/deps:/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1\n    10\tWORKDIR /app\n    11\tCOPY --from=build /deps /deps\n    12\tCOPY --chown=0:0 requirements.txt Dockerfile ./\n    13\tCOPY --chown=0:0 src/ src/\n    14\tCOPY --chown=0:0 prompts/ prompts/\n    15\tCOPY --chown=0:0 config/ config/\n    16\tUSER 65532:65532\n    17\tENTRYPOINT [\"python3\"]\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: hr-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.31\n     8\t    pod-security.kubernetes.io/warn: restricted\n     9\t    pod-security.kubernetes.io/audit: restricted\n    10\t    istio.io/dataplane-mode: ambient\n    11\t---\n    12\tapiVersion: kyverno.io/v1\n    13\tkind: ClusterPolicy\n    14\tmetadata:\n    15\t  name: hr-agent-verify-images\n    16\t  annotations:\n    17\t    policies.kyverno.io/owner: people-platform\n    18\tspec:\n    19\t  validationFailureAction: Enforce\n    20\t  failurePolicy: Fail\n    21\t  webhookTimeoutSeconds: 15\n    22\t  background: false\n    23\t  rules:\n    24\t    - name: only-approved-registry\n    25\t      match:\n    26\t        any:\n    27\t          - resources: {kinds: [Pod], namespaces: [hr-agent]}\n    28\t      validate:\n    29\t        message: \"Images in hr-agent must come from registry.acme.example and be referenced by digest.\"\n    30\t        pattern:\n    31\t          spec:\n    32\t            =(initContainers):\n    33\t              - image: \"registry.acme.example/*@sha256:*\"\n    34\t            containers:\n    35\t              - image: \"registry.acme.example/*@sha256:*\"\n    36\t    - name: verify-signature-and-provenance\n    37\t      match:\n    38\t        any:\n    39\t          - resources: {kinds: [Pod], namespaces: [hr-agent]}\n    40\t      verifyImages:\n    41\t        - imageReferences: [\"registry.acme.example/people/hr-helpdesk-agent*\"]\n    42\t          mutateDigest: false\n    43\t          verifyDigest: true\n    44\t          required: true\n    45\t          attestors:\n    46\t            - entries:\n    47\t                - keyless:\n    48\t                    subject: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    49\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    50\t                    rekor: {url: \"https://rekor.sigstore.dev\"}\n    51\t          attestations:\n    52\t            - type: https://slsa.dev/provenance/v1\n    53\t              attestors:\n    54\t                - entries:\n    55\t                    - keyless:\n    56\t                        subject: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    57\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    58\t              conditions:\n    59\t                - all:\n    60\t                    - key: \"{{ buildDefinition.buildType }}\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_017SfeCv2odmv6tfoPBNpgHY","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChG4TW3wcqcv6jFeT2Dsb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011DAWZ9uXPq23pkW6YbRtg5","name":"Bash","input":{"command":"cat -n src/tools.py src/gateway_client.py src/credentials.py config/agent.yaml; grep -n -i \"http\\|url\\|host\" src/*.py | head -60"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2298,"cache_read_input_tokens":7334,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2298},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d84ee291-4b5e-4d57-8dbd-4136d20d05c6","uuid":"d9b3926e-c93e-4dce-b291-ebbd9ae05886","timestamp":"2026-11-21T12:18:38.498Z","request_id":"req_011ChG4TVuWAPgRC3t5xkbPt","wire_tool_inputs":{"toolu_011DAWZ9uXPq23pkW6YbRtg5":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-riql_58r/agent && cat -n src/tools.py src/gateway_client.py src/credentials.py config/agent.yaml; grep -n -i \"http\\|url\\|host\" src/*.py | head -60"}},"wire_ingest_context":{"toolu_011DAWZ9uXPq23pkW6YbRtg5":{"cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-riql_58r/agent"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011DAWZ9uXPq23pkW6YbRtg5","type":"tool_result","content":"     1\t\"\"\"Tool registry: the only tools this agent can see or call.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport pathlib\n     5\tfrom dataclasses import dataclass, field\n     6\tfrom typing import Any\n     7\t\n     8\timport yaml\n     9\t\n    10\tCONFIG_DIR = pathlib.Path(__file__).resolve().parent.parent / \"config\"\n    11\t\n    12\t\n    13\tdef load_yaml(name: str) -> dict[str, Any]:\n    14\t    with open(CONFIG_DIR / name, encoding=\"utf-8\") as fh:\n    15\t        return yaml.safe_load(fh)\n    16\t\n    17\t\n    18\t@dataclass(frozen=True)\n    19\tclass ToolSpec:\n    20\t    name: str\n    21\t    kind: str\n    22\t    qualified: str\n    23\t    reason: str\n    24\t    scope: str\n    25\t    approval: str\n    26\t    input_schema: dict[str, Any]\n    27\t    output_schema: dict[str, Any] | None = None\n    28\t    server: str | None = None\n    29\t    target_template: str | None = None\n    30\t    fingerprint: str | None = None\n    31\t    direct_route: dict[str, str] | None = field(default=None, hash=False)\n    32\t\n    33\t    def target(self, subject: str) -> str:\n    34\t        return (self.target_template or self.qualified).format(subject=subject)\n    35\t\n    36\t\n    37\tclass ToolRegistry:\n    38\t    def __init__(self, raw: dict[str, Any]):\n    39\t        self.policy_version: str = raw[\"policy_version\"]\n    40\t        self.servers: dict[str, dict[str, str]] = raw[\"servers\"]\n    41\t        self._tools: dict[str, ToolSpec] = {}\n    42\t        for name, t in raw[\"tools\"].items():\n    43\t            if not t.get(\"reason\"):\n    44\t                raise ValueError(f\"tool {name} has no task reason\")\n    45\t            if t[\"approval\"] not in (\"none\", \"subject\"):\n    46\t                raise ValueError(f\"tool {name}: unknown approval mode\")\n    47\t            self._tools[name] = ToolSpec(\n    48\t                name=name,\n    49\t                kind=t[\"kind\"],\n    50\t                qualified=t.get(\"qualified\", name),\n    51\t                reason=t[\"reason\"],\n    52\t                scope=t[\"scope\"],\n    53\t                approval=t[\"approval\"],\n    54\t                input_schema=t[\"input_schema\"],\n    55\t                output_schema=t.get(\"output_schema\"),\n    56\t                server=t.get(\"server\"),\n    57\t                target_template=t.get(\"target\"),\n    58\t                fingerprint=t.get(\"fingerprint\"),\n    59\t                direct_route=t.get(\"direct_route\"),\n    60\t            )\n    61\t\n    62\t    @classmethod\n    63\t    def from_config(cls) -> \"ToolRegistry\":\n    64\t        return cls(load_yaml(\"tools.yaml\"))\n    65\t\n    66\t    def get(self, name: str) -> ToolSpec | None:\n    67\t        # Exact key lookup only; no prefix, case folding or alias matching.\n    68\t        return self._tools.get(name)\n    69\t\n    70\t    def by_qualified(self, qualified: str) -> ToolSpec | None:\n    71\t        for spec in self._tools.values():\n    72\t            if spec.qualified == qualified:\n    73\t                return spec\n    74\t        return None\n    75\t\n    76\t    def model_schemas(self) -> list[dict[str, Any]]:\n    77\t        return [\n    78\t            {\"name\": s.name, \"description\": s.reason, \"input_schema\": s.input_schema}\n    79\t            for s in self._tools.values()\n    80\t        ]\n     1\t\"\"\"Calls MCP tools through the hr-tool-gateway.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport logging\n     5\timport uuid\n     6\tfrom typing import Any\n     7\t\n     8\timport httpx\n     9\tfrom opentelemetry.propagate import inject\n    10\t\n    11\tfrom .audit import RunContext\n    12\tfrom .credentials import CredentialBroker\n    13\tfrom .tools import ToolSpec\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.gateway_client\")\n    16\t\n    17\tGATEWAY_URL = \"https://hr-tool-gateway.hr-agent.svc.cluster.local:8443/mcp\"\n    18\tGATEWAY_AUDIENCE = \"hr-tool-gateway\"\n    19\t\n    20\t\n    21\tclass ToolDenied(Exception):\n    22\t    def __init__(self, reason: str):\n    23\t        super().__init__(reason)\n    24\t        self.reason = reason\n    25\t\n    26\t\n    27\tclass ToolError(Exception):\n    28\t    def __init__(self, status: int, detail: str):\n    29\t        super().__init__(f\"{status}\")\n    30\t        self.status = status\n    31\t        self.detail = detail\n    32\t\n    33\t\n    34\tclass GatewayUnavailable(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass GatewayClient:\n    39\t    def __init__(self, client: httpx.AsyncClient, creds: CredentialBroker):\n    40\t        self._client = client\n    41\t        self._creds = creds\n    42\t\n    43\t    async def call(\n    44\t        self, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, subject_token: str, *, operation_id: str\n    45\t    ) -> dict[str, Any]:\n    46\t        try:\n    47\t            token = await self._creds.token(\n    48\t                audience=GATEWAY_AUDIENCE, scope=spec.scope, subject_token=subject_token, subject=ctx.subject\n    49\t            )\n    50\t            return await self._post(GATEWAY_URL, token, spec, args, ctx, operation_id)\n    51\t        except GatewayUnavailable:\n    52\t            if not spec.direct_route:\n    53\t                raise\n    54\t            log.warning(\"gateway unavailable, using direct route\", extra={\"tool\": spec.qualified})\n    55\t            token = await self._creds.token(\n    56\t                audience=spec.direct_route[\"audience\"], scope=spec.scope,\n    57\t                subject_token=subject_token, subject=ctx.subject,\n    58\t            )\n    59\t            return await self._post(spec.direct_route[\"endpoint\"], token, spec, args, ctx, operation_id)\n    60\t\n    61\t    async def _post(\n    62\t        self, url: str, token: str, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, operation_id: str\n    63\t    ) -> dict[str, Any]:\n    64\t        tool_name = spec.qualified.split(\"/\", 1)[1]\n    65\t        headers = {\n    66\t            \"Authorization\": f\"Bearer {token}\",\n    67\t            \"Mcp-Method\": \"tools/call\",\n    68\t            \"Mcp-Name\": tool_name,\n    69\t            \"Idempotency-Key\": operation_id,\n    70\t            \"X-Agent-Instance\": ctx.agent_instance_id,\n    71\t            \"X-Agent-Type-Id\": ctx.agent_type_id,\n    72\t        }\n    73\t        inject(headers)\n    74\t        body = {\n    75\t            \"jsonrpc\": \"2.0\",\n    76\t            \"id\": str(uuid.uuid4()),\n    77\t            \"method\": \"tools/call\",\n    78\t            \"params\": {\"name\": tool_name, \"arguments\": args, \"_meta\": {\"server\": spec.server}},\n    79\t        }\n    80\t        try:\n    81\t            resp = await self._client.post(url, json=body, headers=headers, timeout=10.0)\n    82\t        except (httpx.ConnectError, httpx.ConnectTimeout) as exc:\n    83\t            raise GatewayUnavailable(str(exc)) from exc\n    84\t        except httpx.TimeoutException as exc:\n    85\t            raise ToolError(504, f\"no response; outcome unknown for operation {operation_id}\") from exc\n    86\t        if resp.status_code == 503:\n    87\t            raise GatewayUnavailable(resp.text[:200])\n    88\t        if resp.status_code in (401, 403, 429):\n    89\t            raise ToolDenied(resp.json().get(\"error\", \"denied\"))\n    90\t        if resp.status_code >= 400:\n    91\t            raise ToolError(resp.status_code, resp.json().get(\"detail\", resp.text))\n    92\t        payload = resp.json()\n    93\t        if \"error\" in payload:\n    94\t            raise ToolError(200, str(payload[\"error\"].get(\"message\", \"\")))\n    95\t        return payload[\"result\"][\"structuredContent\"]\n     1\t\"\"\"Per-tool, per-employee, short-lived tokens for the agent's own workload identity.\n     2\t\n     3\tThe pod's projected service-account token (audience sts.acme.example, 10 min) is the\n     4\tactor token. The employee's verified SSO token is the subject token. The STS returns an\n     5\tRFC 8693 token whose `sub` is the employee, `act.sub` is this workload, `aud` is the\n     6\trequested audience, `scope` is exactly one tool scope, and `cnf.x5t#S256` binds it to the\n     7\tpod's mTLS certificate. Lifetime is 300 s: long enough for one approval-to-execute window\n     8\ton a single call, short enough that a copied token is useless after the run.\n     9\t\"\"\"\n    10\tfrom __future__ import annotations\n    11\t\n    12\timport asyncio\n    13\timport time\n    14\tfrom dataclasses import dataclass\n    15\t\n    16\timport httpx\n    17\t\n    18\tSTS_URL = \"https://sts.identity.svc.cluster.local/oauth2/token\"\n    19\tACTOR_TOKEN_PATH = \"/var/run/secrets/tokens/sts-token\"\n    20\tTOKEN_TTL_SECONDS = 300\n    21\tREFRESH_MARGIN_SECONDS = 30\n    22\t\n    23\t\n    24\t@dataclass\n    25\tclass _Cached:\n    26\t    token: str\n    27\t    expires_at: float\n    28\t\n    29\t\n    30\tclass CredentialBroker:\n    31\t    def __init__(self, client: httpx.AsyncClient):\n    32\t        self._client = client  # configured with the pod's SPIFFE SVID for mTLS\n    33\t        self._cache: dict[tuple[str, str, str], _Cached] = {}\n    34\t        self._lock = asyncio.Lock()\n    35\t\n    36\t    def _actor_token(self) -> str:\n    37\t        # Re-read each time: kubelet rotates the projected token on disk.\n    38\t        with open(ACTOR_TOKEN_PATH, encoding=\"utf-8\") as fh:\n    39\t            return fh.read().strip()\n    40\t\n    41\t    async def token(self, *, audience: str, scope: str, subject_token: str, subject: str) -> str:\n    42\t        key = (audience, scope, subject)\n    43\t        async with self._lock:\n    44\t            hit = self._cache.get(key)\n    45\t            if hit and hit.expires_at - REFRESH_MARGIN_SECONDS > time.time():\n    46\t                return hit.token\n    47\t            resp = await self._client.post(\n    48\t                STS_URL,\n    49\t                data={\n    50\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    51\t                    \"subject_token\": subject_token,\n    52\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:id_token\",\n    53\t                    \"actor_token\": self._actor_token(),\n    54\t                    \"actor_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n    55\t                    \"audience\": audience,\n    56\t                    \"scope\": scope,\n    57\t                    \"requested_token_type\": \"urn:ietf:params:oauth:token-type:access_token\",\n    58\t                    \"requested_ttl\": str(TOKEN_TTL_SECONDS),\n    59\t                },\n    60\t                timeout=3.0,\n    61\t            )\n    62\t            resp.raise_for_status()\n    63\t            body = resp.json()\n    64\t            ttl = min(int(body.get(\"expires_in\", TOKEN_TTL_SECONDS)), TOKEN_TTL_SECONDS)\n    65\t            self._cache[key] = _Cached(body[\"access_token\"], time.time() + ttl)\n    66\t            return body[\"access_token\"]\n    67\t\n    68\t    def drop_subject(self, subject: str) -> None:\n    69\t        for key in [k for k in self._cache if k[2] == subject]:\n    70\t            del self._cache[key]\n     1\tagent:\n     2\t  name: hr-helpdesk\n     3\t  accountable_party: \"VP People Operations <people-ops-lead@acme.example>\"\n     4\t  operational_owner: \"people-platform (pager: people-platform-oncall)\"\n     5\t  tenant: acme\n     6\t  workload_identity: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n     7\t\n     8\tmodel:\