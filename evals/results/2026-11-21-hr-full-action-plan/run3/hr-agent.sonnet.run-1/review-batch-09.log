{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TQTuVDPGuyhhbCGi5HjGD1","type":"tool_result","content":"     1\t# Generated by: uv pip compile requirements.in --generate-hashes --python-version 3.12\n     2\tanthropic==0.69.0 --hash=sha256:195b8cacfef3d1c6a675b88ef39969ce8973f93c8ced6423dfe0d12ef8307cce --hash=sha256:993c53cf831745f0e64c62d7edae1e1e5c9bdd50ba83bff23ceb262df55c6861\n     3\tasyncpg==0.30.0 --hash=sha256:b6b92bb65c90b2f0021eb3a07a00b1ba86121b903c63c5e7d886d5bb01ae75c8 --hash=sha256:4091cc4ff944aa26d10fec6fa14e825b170437082162fc43d7e3ef43763c6582\n     4\thttpx==0.28.1 --hash=sha256:41989ee577a16868199c6fa98d8de899296004dd7b2702a84753f9d6cf937221 --hash=sha256:daca608a9349068bcf9bb5128258d6c7d70dd3007a8f79ad77b0045978b09077\n     5\tjsonschema==4.25.1 --hash=sha256:305a92a6d768f487e631523cd1517c7c032ae20c82a4c6a49a01edd65e0839b0 --hash=sha256:1dce1dec65770c771d3ca7a9ca631cf694780951ddf94720c40973bee72cb667\n     6\topentelemetry-api==1.37.0 --hash=sha256:aa170874a075dfba7084f009410de29d6fe3a9fba809237ec1dcecf31ef09659 --hash=sha256:adfe125b669855a528ebb5166eb930e21ccdde3425aac1bf636f3145f354aa67\n     7\topentelemetry-sdk==1.37.0 --hash=sha256:97163bab89eb4f6224572d6fd2789187df3576b73095a4f395d0dacfe65f8ef3 --hash=sha256:584321cbbf1718625348ac96bfb04d67cc2c9d45cdb682d6dc1c49567b77a894\n     8\topentelemetry-exporter-otlp-proto-grpc==1.37.0 --hash=sha256:1a51f4e0b05d4fdc60119efaef84a0be6154f38def98353d105c3881b1578a40 --hash=sha256:b29f85df6cb6ab4d6366fc36a30c9dada977f6d49aa4ed0a55839fc2f76c69a0\n     9\tpyjwt[crypto]==2.10.1 --hash=sha256:97c15ee62fb27553378fe5dba0421b4b7211a5c46b6d31e273032c0b0ef54566 --hash=sha256:6414692c15de6e6338215aec870f7d41218cdbcf4b53a3730aeb97ed9dd32b8d\n    10\tpyyaml==6.0.3 --hash=sha256:b470954528c73fcc5805b828d59819d22a889f7a86f0b733a6c44dd2194d1d70 --hash=sha256:ed02dc5ae2cc8f2a377ee48ee900c83c74be1a62ea6f0b00fd5ca7a50e88fe0c\n    11\tstarlette==0.48.0 --hash=sha256:e6f04517ef81c63b26d52ae69a13aa5f75e026cfddb3e49ac09d3c3f96b4eaf0 --hash=sha256:dc73e3668ac1f64957872526656071a6a1aab6e1cfb9676b642326172fa1e238\n    12\tuvicorn==0.37.0 --hash=sha256:88af2c0d245e36a7c87e7dc9fd92708e5b03a49272c7846a51688286ae327990 --hash=sha256:75db15f027bd9abbc70180099b655106579dfd302ec7d1d469a7c887c72942af\n    13\tcryptography==46.0.2 --hash=sha256:d74dca2649993657569ec6627e0d8d3f56f0f189e585db382faed5030fe8d35b --hash=sha256:45c3a26d8cf0e47760556fc200e502abf1ba72969aa75c60d70feec98b527a6c\n    14\trfc3339-validator==0.1.4 --hash=sha256:04cac5c0da297bbdd84278cfa85111e25d07ed2cf9c1c7d1125d19b58b9dcbf5 --hash=sha256:60ba45604e428785f98b6e3b1e432f19ec9ce9cd1df584d509217399acb7e206\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.12.7-slim-bookworm@sha256:032c52613401895aa3d418a4c5bf5c3ad0d5d6fe3c1e9b2c8b5d0a7e6f4c3b21 AS build\n     3\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     4\tWORKDIR /build\n     5\tCOPY requirements.txt .\n     6\tRUN pip install --require-hashes --only-binary=:all: --target /deps -r requirements.txt\n     7\t\n     8\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:7e4c1d2a9f3b8e60c5d47a19b2f03e8d6c1a5b94f7e2d03c8a6b1f5e9d4c2a70\n     9\tENV PYTHONPATH=/deps:/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1\n    10\tWORKDIR /app\n    11\tCOPY --from=build /deps /deps\n    12\tCOPY --chown=0:0 requirements.txt Dockerfile ./\n    13\tCOPY --chown=0:0 src/ src/\n    14\tCOPY --chown=0:0 prompts/ prompts/\n    15\tCOPY --chown=0:0 config/ config/\n    16\tUSER 65532:65532\n    17\tENTRYPOINT [\"python3\"]\n     1\tname: release\n     2\t\n     3\ton:\n     4\t  push:\n     5\t    branches: [main]\n     6\t\n     7\tpermissions:\n     8\t  contents: read\n     9\t\n    10\tjobs:\n    11\t  build:\n    12\t    runs-on: ubuntu-24.04\n    13\t    environment: production   # requires approval from @acme/people-platform-release\n    14\t    permissions:\n    15\t      contents: read\n    16\t      packages: write\n    17\t      id-token: write\n    18\t      attestations: write\n    19\t    env:\n    20\t      PYTHONDONTWRITEBYTECODE: \"1\"\n    21\t      IMAGE: registry.acme.example/people/hr-helpdesk-agent\n    22\t    steps:\n    23\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    24\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    25\t        with: {python-version: \"3.12.7\"}\n    26\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    27\t        with: {cosign-release: \"v2.6.2\"}\n    28\t      - run: pip install --require-hashes -r requirements.txt\n    29\t      - run: python -m pytest -q tests/release\n    30\t      - name: Build and push\n    31\t        id: build\n    32\t        uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    33\t        with:\n    34\t          push: true\n    35\t          tags: ${{ env.IMAGE }}:${{ github.sha }}\n    36\t          sbom: true\n    37\t          provenance: mode=max\n    38\t      - name: Sign image\n    39\t        run: cosign sign --yes \"${IMAGE}@${{ steps.build.outputs.digest }}\"\n    40\t      - uses: actions/attest-build-provenance@e8998f949152b193b063cb0ec769d69d929409be # v2.4.0\n    41\t        with:\n    42\t          subject-name: ${{ env.IMAGE }}\n    43\t          subject-digest: ${{ steps.build.outputs.digest }}\n    44\t          push-to-registry: true\n    45\t      - name: Compute agent-type-id\n    46\t        id: typeid\n    47\t        run: |\n    48\t          python -m src.type_id \"${{ steps.build.outputs.digest }}\" > type-id.json\n    49\t          echo \"id=$(jq -r .agent_type_id type-id.json)\" >> \"$GITHUB_OUTPUT\"\n    50\t      - name: Stamp release manifest\n    51\t        run: |\n    52\t          yq -i '.release.agent_type_id = \"${{ steps.typeid.outputs.id }}\" |\n    53\t                 .release.image.digest = \"${{ steps.build.outputs.digest }}\" |\n    54\t                 .release.git_sha = \"${{ github.sha }}\"' release/manifest.yaml\n    55\t      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\n    56\t        with:\n    57\t          name: release-${{ github.sha }}\n    58\t          path: [type-id.json, release/manifest.yaml]\n    59\t\n    60\t  deploy:\n    61\t    needs: build\n    62\t    runs-on: ubuntu-24.04\n    63\t    environment: production\n    64\t    permissions: {contents: read, id-token: write}\n    65\t    steps:\n    66\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    67\t      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0\n    68\t        with: {name: \"release-${{ github.sha }}\"}\n    69\t      - name: Render and apply\n    70\t        run: |\n    71\t          export IMAGE_DIGEST=$(yq -r .release.image.digest release/manifest.yaml)\n    72\t          export AGENT_TYPE_ID=$(yq -r .release.agent_type_id release/manifest.yaml)\n    73\t          export GIT_SHA=${{ github.sha }}\n    74\t          for f in k8s/*.yaml; do envsubst '$IMAGE_DIGEST $AGENT_TYPE_ID $GIT_SHA' < \"$f\"; echo '---'; done \\\n    75\t            | kubectl apply --server-side -f -\n     1\t*                         @acme/people-platform\n     2\t/prompts/                 @acme/people-platform @acme/hr-policy-reviewers\n     3\t/config/                  @acme/people-platform @acme/security-engineering\n     4\t/src/gateway.py           @acme/people-platform @acme/security-engineering\n     5\t/src/approvals.py         @acme/people-platform @acme/security-engineering\n     6\t/k8s/                     @acme/people-platform @acme/platform-security\n     7\t/migrations/              @acme/people-platform @acme/data-platform\n     8\t/release/                 @acme/people-platform @acme/security-engineering\n     9\t/.github/                 @acme/platform-security\n    10\t/CODEOWNERS               @acme/platform-security\n     1\t\"\"\"agent-type-id: SHA-256 over every identity-defining input.\n     2\t\n     3\tInputs (all, no exclusions):\n     4\t  - every file under src/, prompts/ and config/, plus requirements.txt and Dockerfile\n     5\t  - the image digest the pod runs\n     6\t  - the model record (provider, requested ID, snapshot/alias label, adapter)\n     7\tCanonical form: JSON with sorted keys, no whitespace, file paths relative to the repo root\n     8\tin POSIX form, each file hashed as raw bytes. The same command runs in CI (to stamp the\n     9\trelease manifest) and at pod start (to refuse running under an identity it does not match).\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport hashlib\n    14\timport json\n    15\timport pathlib\n    16\timport sys\n    17\tfrom typing import Any\n    18\t\n    19\tROOT = pathlib.Path(__file__).resolve().parent.parent\n    20\tINPUT_DIRS = (\"src\", \"prompts\", \"config\")\n    21\tINPUT_FILES = (\"requirements.txt\", \"Dockerfile\")\n    22\tHASH_SCHEME = \"acme-agent-type-id/v1\"\n    23\t\n    24\t\n    25\tdef _file_hashes() -> dict[str, str]:\n    26\t    out: dict[str, str] = {}\n    27\t    for d in INPUT_DIRS:\n    28\t        for p in sorted((ROOT / d).rglob(\"*\")):\n    29\t            if p.is_file():\n    30\t                out[p.relative_to(ROOT).as_posix()] = hashlib.sha256(p.read_bytes()).hexdigest()\n    31\t    for f in INPUT_FILES:\n    32\t        out[f] = hashlib.sha256((ROOT / f).read_bytes()).hexdigest()\n    33\t    return out\n    34\t\n    35\t\n    36\tdef compute(image_digest: str, model: dict[str, Any]) -> tuple[str, dict[str, Any]]:\n    37\t    if not image_digest.startswith(\"sha256:\") or len(image_digest) != 71:\n    38\t        raise ValueError(\"image digest must be sha256:<64 hex>\")\n    39\t    for k in (\"provider\", \"id\", \"pinning\", \"adapter\"):\n    40\t        if k not in model:\n    41\t            raise ValueError(f\"model record missing {k}\")\n    42\t    manifest = {\"scheme\": HASH_SCHEME, \"image_digest\": image_digest, \"model\": model, \"files\": _file_hashes()}\n    43\t    canonical = json.dumps(manifest, sort_keys=True, separators=(\",\", \":\")).encode()\n    44\t    return \"sha256:\" + hashlib.sha256(canonical).hexdigest(), manifest\n    45\t\n    46\t\n    47\tdef model_record(cfg: dict[str, Any]) -> dict[str, Any]:\n    48\t    m = cfg[\"model\"]\n    49\t    return {\"provider\": m[\"provider\"], \"id\": m[\"id\"], \"pinning\": m[\"pinning\"], \"adapter\": m[\"adapter\"]}\n    50\t\n    51\t\n    52\tdef verify_or_exit(expected: str, image_digest: str, model: dict[str, Any]) -> str:\n    53\t    actual, _ = compute(image_digest, model)\n    54\t    if actual != expected:\n    55\t        print(f\"agent-type-id mismatch: expected {expected}, computed {actual}\", file=sys.stderr)\n    56\t        sys.exit(78)\n    57\t    return actual\n    58\t\n    59\t\n    60\tif __name__ == \"__main__\":\n    61\t    import yaml\n    62\t\n    63\t    cfg = yaml.safe_load((ROOT / \"config\" / \"agent.yaml\").read_text())\n    64\t    tid, man = compute(sys.argv[1], model_record(cfg))\n    65\t    json.dump({\"agent_type_id\": tid, \"inputs\": man}, sys.stdout, indent=2, sort_keys=True)\n     1\t\"\"\"Append-only audit records. Every record carries the six identity fields.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport json\n     5\timport logging\n     6\timport uuid\n     7\tfrom dataclasses import dataclass\n     8\tfrom typing import Any\n     9\t\n    10\timport asyncpg\n    11\tfrom opentelemetry import trace\n    12\t\n    13\tfrom .redact import redact_obj\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.audit\")\n    16\t\n    17\t\n    18\t@dataclass(frozen=True)\n    19\tclass RunContext:\n    20\t    \"\"\"Built by the harness from verified identity. Never from model output.\"\"\"\n    21\t\n    22\t    run_id: str\n    23\t    agent_instance_id: str\n    24\t    agent_type_id: str\n    25\t    tenant: str\n    26\t    subject: str              # employee whose authority is being used (verified SSO token)\n    27\t    accountable_party: str\n    28\t    operational_owner: str\n    29\t    agent_principal: str      # workload identity of this agent\n    30\t\n    31\t\n    32\tclass AuditUnavailable(Exception):\n    33\t    pass\n    34\t\n    35\t\n    36\t_INSERT = \"\"\"\n    37\tINSERT INTO audit.events (\n    38\t    event_id, ts, event_type, run_id, step_id, parent_step_id,\n    39\t    accountable_party, operational_owner, tenant, agent_type_id, agent_instance_id,\n    40\t    trace_id, span_id, traceparent,\n    41\t    delegated_subject, agent_principal,\n    42\t    tool, operation_target, decision, reason, policy_version, approval_id,\n    43\t    args_redacted, result_redacted, context_tokens, context_tokens_method, model_requested, model_served\n    44\t) VALUES (\n    45\t    $1, now(), $2, $3, $4, $5,\n    46\t    $6, $7, $8, $9, $10,\n    47\t    $11, $12, $13,\n    48\t    $14, $15,\n    49\t    $16, $17, $18, $19, $20, $21,\n    50\t    $22::jsonb, $23::jsonb, $24, $25, $26, $27\n    51\t)\n    52\t\"\"\"\n    53\t\n    54\t\n    55\tclass AuditWriter:\n    56\t    def __init__(self, pool: asyncpg.Pool, policy_version: str):\n    57\t        self._pool = pool\n    58\t        self._policy_version = policy_version\n    59\t\n    60\t    async def record(\n    61\t        self,\n    62\t        ctx: RunContext,\n    63\t        event_type: str,\n    64\t        *,\n    65\t        step_id: str | None = None,\n    66\t        parent_step_id: str | None = None,\n    67\t        tool: str | None = None,\n    68\t        target: str | None = None,\n    69\t        decision: str | None = None,\n    70\t        reason: str | None = None,\n    71\t        approval_id: str | None = None,\n    72\t        args: Any = None,\n    73\t        result: Any = None,\n    74\t        context_tokens: int | None = None,\n    75\t        context_tokens_method: str | None = None,\n    76\t        model_requested: str | None = None,\n    77\t        model_served: str | None = None,\n    78\t    ) -> str:\n    79\t        span_ctx = trace.get_current_span().get_span_context()\n    80\t        if not span_ctx.is_valid:\n    81\t            raise AuditUnavailable(\"no active trace context\")\n    82\t        trace_id = format(span_ctx.trace_id, \"032x\")\n    83\t        span_id = format(span_ctx.span_id, \"016x\")\n    84\t        traceparent = f\"00-{trace_id}-{span_id}-{span_ctx.trace_flags:02x}\"\n    85\t        event_id = str(uuid.uuid4())\n    86\t        try:\n    87\t            await self._pool.execute(\n    88\t                _INSERT,\n    89\t                event_id, event_type, ctx.run_id, step_id, parent_step_id,\n    90\t                ctx.accountable_party, ctx.operational_owner, ctx.tenant, ctx.agent_type_id, ctx.agent_instance_id,\n    91\t                trace_id, span_id, traceparent,\n    92\t                ctx.subject, ctx.agent_principal,\n    93\t                tool, target, decision, reason, self._policy_version, approval_id,\n    94\t                json.dumps(redact_obj(args)), json.dumps(redact_obj(result)),\n    95\t                context_tokens, context_tokens_method, model_requested, model_served,\n    96\t                timeout=2.0,\n    97\t            )\n    98\t        except Exception as exc:  # any failure to persist stops the run\n    99\t            log.error(\"audit write failed\", extra={\"event_type\": event_type, \"run_id\": ctx.run_id})\n   100\t            raise AuditUnavailable(str(type(exc).__name__)) from exc\n   101\t        return event_id","is_error":false}]},"parent_tool_use_id":null,"session_id":"9d5b9d43-862a-4769-8505-8bbb88cc48b5","uuid":"1913fbdf-f62e-4d6c-8b62-2e103777d67e","timestamp":"2026-11-21T12:10:16.439Z","tool_use_result":{"stdout":"     1\t# Generated by: uv pip compile requirements.in --generate-hashes --python-version 3.12\n     2\tanthropic==0.69.0 --hash=sha256:195b8cacfef3d1c6a675b88ef39969ce8973f93c8ced6423dfe0d12ef8307cce --hash=sha256:993c53cf831745f0e64c62d7edae1e1e5c9bdd50ba83bff23ceb262df55c6861\n     3\tasyncpg==0.30.0 --hash=sha256:b6b92bb65c90b2f0021eb3a07a00b1ba86121b903c63c5e7d886d5bb01ae75c8 --hash=sha256:4091cc4ff944aa26d10fec6fa14e825b170437082162fc43d7e3ef43763c6582\n     4\thttpx==0.28.1 --hash=sha256:41989ee577a16868199c6fa98d8de899296004dd7b2702a84753f9d6cf937221 --hash=sha256:daca608a9349068bcf9bb5128258d6c7d70dd3007a8f79ad77b0045978b09077\n     5\tjsonschema==4.25.1 --hash=sha256:305a92a6d768f487e631523cd1517c7c032ae20c82a4c6a49a01edd65e0839b0 --hash=sha256:1dce1dec65770c771d3ca7a9ca631cf694780951ddf94720c40973bee72cb667\n     6\topentelemetry-api==1.37.0 --hash=sha256:aa170874a075dfba7084f009410de29d6fe3a9fba809237ec1dcecf31ef09659 --hash=sha256:adfe125b669855a528ebb5166eb930e21ccdde3425aac1bf636f3145f354aa67\n     7\topentelemetry-sdk==1.37.0 --hash=sha256:97163bab89eb4f6224572d6fd2789187df3576b73095a4f395d0dacfe65f8ef3 --hash=sha256:584321cbbf1718625348ac96bfb04d67cc2c9d45cdb682d6dc1c49567b77a894\n     8\topentelemetry-exporter-otlp-proto-grpc==1.37.0 --hash=sha256:1a51f4e0b05d4fdc60119efaef84a0be6154f38def98353d105c3881b1578a40 --hash=sha256:b29f85df6cb6ab4d6366fc36a30c9dada977f6d49aa4ed0a55839fc2f76c69a0\n     9\tpyjwt[crypto]==2.10.1 --hash=sha256:97c15ee62fb27553378fe5dba0421b4b7211a5c46b6d31e273032c0b0ef54566 --hash=sha256:6414692c15de6e6338215aec870f7d41218cdbcf4b53a3730aeb97ed9dd32b8d\n    10\tpyyaml==6.0.3 --hash=sha256:b470954528c73fcc5805b828d59819d22a889f7a86f0b733a6c44dd2194d1d70 --hash=sha256:ed02dc5ae2cc8f2a377ee48ee900c83c74be1a62ea6f0b00fd5ca7a50e88fe0c\n    11\tstarlette==0.48.0 --hash=sha256:e6f04517ef81c63b26d52ae69a13aa5f75e026cfddb3e49ac09d3c3f96b4eaf0 --hash=sha256:dc73e3668ac1f64957872526656071a6a1aab6e1cfb9676b642326172fa1e238\n    12\tuvicorn==0.37.0 --hash=sha256:88af2c0d245e36a7c87e7dc9fd92708e5b03a49272c7846a51688286ae327990 --hash=sha256:75db15f027bd9abbc70180099b655106579dfd302ec7d1d469a7c887c72942af\n    13\tcryptography==46.0.2 --hash=sha256:d74dca2649993657569ec6627e0d8d3f56f0f189e585db382faed5030fe8d35b --hash=sha256:45c3a26d8cf0e47760556fc200e502abf1ba72969aa75c60d70feec98b527a6c\n    14\trfc3339-validator==0.1.4 --hash=sha256:04cac5c0da297bbdd84278cfa85111e25d07ed2cf9c1c7d1125d19b58b9dcbf5 --hash=sha256:60ba45604e428785f98b6e3b1e432f19ec9ce9cd1df584d509217399acb7e206\n     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.12.7-slim-bookworm@sha256:032c52613401895aa3d418a4c5bf5c3ad0d5d6fe3c1e9b2c8b5d0a7e6f4c3b21 AS build\n     3\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     4\tWORKDIR /build\n     5\tCOPY requirements.txt .\n     6\tRUN pip install --require-hashes --only-binary=:all: --target /deps -r requirements.txt\n     7\t\n     8\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:7e4c1d2a9f3b8e60c5d47a19b2f03e8d6c1a5b94f7e2d03c8a6b1f5e9d4c2a70\n     9\tENV PYTHONPATH=/deps:/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1\n    10\tWORKDIR /app\n    11\tCOPY --from=build /deps /deps\n    12\tCOPY --chown=0:0 requirements.txt Dockerfile ./\n    13\tCOPY --chown=0:0 src/ src/\n    14\tCOPY --chown=0:0 prompts/ prompts/\n    15\tCOPY --chown=0:0 config/ config/\n    16\tUSER 65532:65532\n    17\tENTRYPOINT [\"python3\"]\n     1\tname: release\n     2\t\n     3\ton:\n     4\t  push:\n     5\t    branches: [main]\n     6\t\n     7\tpermissions:\n     8\t  contents: read\n     9\t\n    10\tjobs:\n    11\t  build:\n    12\t    runs-on: ubuntu-24.04\n    13\t    environment: production   # requires approval from @acme/people-platform-release\n    14\t    permissions:\n    15\t      contents: read\n    16\t      packages: write\n    17\t      id-token: write\n    18\t      attestations: write\n    19\t    env:\n    20\t      PYTHONDONTWRITEBYTECODE: \"1\"\n    21\t      IMAGE: registry.acme.example/people/hr-helpdesk-agent\n    22\t    steps:\n    23\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    24\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    25\t        with: {python-version: \"3.12.7\"}\n    26\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    27\t        with: {cosign-release: \"v2.6.2\"}\n    28\t      - run: pip install --require-hashes -r requirements.txt\n    29\t      - run: python -m pytest -q tests/release\n    30\t      - name: Build and push\n    31\t        id: build\n    32\t        uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    33\t        with:\n    34\t          push: true\n    35\t          tags: ${{ env.IMAGE }}:${{ github.sha }}\n    36\t          sbom: true\n    37\t          provenance: mode=max\n    38\t      - name: Sign image\n    39\t        run: cosign sign --yes \"${IMAGE}@${{ steps.build.outputs.digest }}\"\n    40\t      - uses: actions/attest-build-provenance@e8998f949152b193b063cb0ec769d69d929409be # v2.4.0\n    41\t        with:\n    42\t          subject-name: ${{ env.IMAGE }}\n    43\t          subject-digest: ${{ steps.build.outputs.digest }}\n    44\t          push-to-registry: true\n    45\t      - name: Compute agent-type-id\n    46\t        id: typeid\n    47\t        run: |\n    48\t          python -m src.type_id \"${{ steps.build.outputs.digest }}\" > type-id.json\n    49\t          echo \"id=$(jq -r .agent_type_id type-id.json)\" >> \"$GITHUB_OUTPUT\"\n    50\t      - name: Stamp release manifest\n    51\t        run: |\n    52\t          yq -i '.release.agent_type_id = \"${{ steps.typeid.outputs.id }}\" |\n    53\t                 .release.image.digest = \"${{ steps.build.outputs.digest }}\" |\n    54\t                 .release.git_sha = \"${{ github.sha }}\"' release/manifest.yaml\n    55\t      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\n    56\t        with:\n    57\t          name: release-${{ github.sha }}\n    58\t          path: [type-id.json, release/manifest.yaml]\n    59\t\n    60\t  deploy:\n    61\t    needs: build\n    62\t    runs-on: ubuntu-24.04\n    63\t    environment: production\n    64\t    permissions: {contents: read, id-token: write}\n    65\t    steps:\n    66\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    67\t      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0\n    68\t        with: {name: \"release-${{ github.sha }}\"}\n    69\t      - name: Render and apply\n    70\t        run: |\n    71\t          export IMAGE_DIGEST=$(yq -r .release.image.digest release/manifest.yaml)\n    72\t          export AGENT_TYPE_ID=$(yq -r .release.agent_type_id release/manifest.yaml)\n    73\t          export GIT_SHA=${{ github.sha }}\n    74\t          for f in k8s/*.yaml; do envsubst '$IMAGE_DIGEST $AGENT_TYPE_ID $GIT_SHA' < \"$f\"; echo '---'; done \\\n    75\t            | kubectl apply --server-side -f -\n     1\t*                         @acme/people-platform\n     2\t/prompts/                 @acme/people-platform @acme/hr-policy-reviewers\n     3\t/config/                  @acme/people-platform @acme/security-engineering\n     4\t/src/gateway.py           @acme/people-platform @acme/security-engineering\n     5\t/src/approvals.py         @acme/people-platform @acme/security-engineering\n     6\t/k8s/                     @acme/people-platform @acme/platform-security\n     7\t/migrations/              @acme/people-platform @acme/data-platform\n     8\t/release/                 @acme/people-platform @acme/security-engineering\n     9\t/.github/                 @acme/platform-security\n    10\t/CODEOWNERS               @acme/platform-security\n     1\t\"\"\"agent-type-id: SHA-256 over every identity-defining input.\n     2\t\n     3\tInputs (all, no exclusions):\n     4\t  - every file under src/, prompts/ and config/, plus requirements.txt and Dockerfile\n     5\t  - the image digest the pod runs\n     6\t  - the model record (provider, requested ID, snapshot/alias label, adapter)\n     7\tCanonical form: JSON with sorted keys, no whitespace, file paths relative to the repo root\n     8\tin POSIX form, each file hashed as raw bytes. The same command runs in CI (to stamp the\n     9\trelease manifest) and at pod start (to refuse running under an identity it does not match).\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport hashlib\n    14\timport json\n    15\timport pathlib\n    16\timport sys\n    17\tfrom typing import Any\n    18\t\n    19\tROOT = pathlib.Path(__file__).resolve().parent.parent\n    20\tINPUT_DIRS = (\"src\", \"prompts\", \"config\")\n    21\tINPUT_FILES = (\"requirements.txt\", \"Dockerfile\")\n    22\tHASH_SCHEME = \"acme-agent-type-id/v1\"\n    23\t\n    24\t\n    25\tdef _file_hashes() -> dict[str, str]:\n    26\t    out: dict[str, str] = {}\n    27\t    for d in INPUT_DIRS:\n    28\t        for p in sorted((ROOT / d).rglob(\"*\")):\n    29\t            if p.is_file():\n    30\t                out[p.relative_to(ROOT).as_posix()] = hashlib.sha256(p.read_bytes()).hexdigest()\n    31\t    for f in INPUT_FILES:\n    32\t        out[f] = hashlib.sha256((ROOT / f).read_bytes()).hexdigest()\n    33\t    return out\n    34\t\n    35\t\n    36\tdef compute(image_digest: str, model: dict[str, Any]) -> tuple[str, dict[str, Any]]:\n    37\t    if not image_digest.startswith(\"sha256:\") or len(image_digest) != 71:\n    38\t        raise ValueError(\"image digest must be sha256:<64 hex>\")\n    39\t    for k in (\"provider\", \"id\", \"pinning\", \"adapter\"):\n    40\t        if k not in model:\n    41\t            raise ValueError(f\"model record missing {k}\")\n    42\t    manifest = {\"scheme\": HASH_SCHEME, \"image_digest\": image_digest, \"model\": model, \"files\": _file_hashes()}\n    43\t    canonical = json.dumps(manifest, sort_keys=True, separators=(\",\", \":\")).encode()\n    44\t    return \"sha256:\" + hashlib.sha256(canonical).hexdigest(), manifest\n    45\t\n    46\t\n    47\tdef model_record(cfg: dict[str, Any]) -> dict[str, Any]:\n    48\t    m = cfg[\"model\"]\n    49\t    return {\"provider\": m[\"provider\"], \"id\": m[\"id\"], \"pinning\": m[\"pinning\"], \"adapter\": m[\"adapter\"]}\n    50\t\n    51\t\n    52\tdef verify_or_exit(expected: str, image_digest: str, model: dict[str, Any]) -> str:\n    53\t    actual, _ = compute(image_digest, model)\n    54\t    if actual != expected:\n    55\t        print(f\"agent-type-id mismatch: expected {expected}, computed {actual}\", file=sys.stderr)\n    56\t        sys.exit(78)\n    57\t    return actual\n    58\t\n    59\t\n    60\tif __name__ == \"__main__\":\n    61\t    import yaml\n    62\t\n    63\t    cfg = yaml.safe_load((ROOT / \"config\" / \"agent.yaml\").read_text())\n    64\t    tid, man = compute(sys.argv[1], model_record(cfg))\n    65\t    json.dump({\"agent_type_id\": tid, \"inputs\": man}, sys.stdout, indent=2, sort_keys=True)\n     1\t\"\"\"Append-only audit records. Every record carries the six identity fields.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport json\n     5\timport logging\n     6\timport uuid\n     7\tfrom dataclasses import dataclass\n     8\tfrom typing import Any\n     9\t\n    10\timport asyncpg\n    11\tfrom opentelemetry import trace\n    12\t\n    13\tfrom .redact import redact_obj\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.audit\")\n    16\t\n    17\t\n    18\t@dataclass(frozen=True)\n    19\tclass RunContext:\n    20\t    \"\"\"Built by the harness from verified identity. Never from model output.\"\"\"\n    21\t\n    22\t    run_id: str\n    23\t    agent_instance_id: str\n    24\t    agent_type_id: str\n    25\t    tenant: str\n    26\t    subject: str              # employee whose authority is being used (verified SSO token)\n    27\t    accountable_party: str\n    28\t    operational_owner: str\n    29\t    agent_principal: str      # workload identity of this agent\n    30\t\n    31\t\n    32\tclass AuditUnavailable(Exception):\n    33\t    pass\n    34\t\n    35\t\n    36\t_INSERT = \"\"\"\n    37\tINSERT INTO audit.events (\n    38\t    event_id, ts, event_type, run_id, step_id, parent_step_id,\n    39\t    accountable_party, operational_owner, tenant, agent_type_id, agent_instance_id,\n    40\t    trace_id, span_id, traceparent,\n    41\t    delegated_subject, agent_principal,\n    42\t    tool, operation_target, decision, reason, policy_version, approval_id,\n    43\t    args_redacted, result_redacted, context_tokens, context_tokens_method, model_requested, model_served\n    44\t) VALUES (\n    45\t    $1, now(), $2, $3, $4, $5,\n    46\t    $6, $7, $8, $9, $10,\n    47\t    $11, $12, $13,\n    48\t    $14, $15,\n    49\t    $16, $17, $18, $19, $20, $21,\n    50\t    $22::jsonb, $23::jsonb, $24, $25, $26, $27\n    51\t)\n    52\t\"\"\"\n    53\t\n    54\t\n    55\tclass AuditWriter:\n    56\t    def __init__(self, pool: asyncpg.Pool, policy_version: str):\n    57\t        self._pool = pool\n    58\t        self._policy_version = policy_version\n    59\t\n    60\t    async def record(\n    61\t        self,\n    62\t        ctx: RunContext,\n    63\t        event_type: str,\n    64\t        *,\n    65\t        step_id: str | None = None,\n    66\t        parent_step_id: str | None = None,\n    67\t        tool: str | None = None,\n    68\t        target: str | None = None,\n    69\t        decision: str | None = None,\n    70\t        reason: str | None = None,\n    71\t        approval_id: str | None = None,\n    72\t        args: Any = None,\n    73\t        result: Any = None,\n    74\t        context_tokens: int | None = None,\n    75\t        context_tokens_method: str | None = None,\n    76\t        model_requested: str | None = None,\n    77\t        model_served: str | None = None,\n    78\t    ) -> str:\n    79\t        span_ctx = trace.get_current_span().get_span_context()\n    80\t        if not span_ctx.is_valid:\n    81\t            raise AuditUnavailable(\"no active trace context\")\n    82\t        trace_id = format(span_ctx.trace_id, \"032x\")\n    83\t        span_id = format(span_ctx.span_id, \"016x\")\n    84\t        traceparent = f\"00-{trace_id}-{span_id}-{span_ctx.trace_flags:02x}\"\n    85\t        event_id = str(uuid.uuid4())\n    86\t        try:\n    87\t            await self._pool.execute(\n    88\t                _INSERT,\n    89\t                event_id, event_type, ctx.run_id, step_id, parent_step_id,\n    90\t                ctx.accountable_party, ctx.operational_owner, ctx.tenant, ctx.agent_type_id, ctx.agent_instance_id,\n    91\t                trace_id, span_id, traceparent,\n    92\t                ctx.subject, ctx.agent_principal,\n    93\t                tool, target, decision, reason, self._policy_version, approval_id,\n    94\t                json.dumps(redact_obj(args)), json.dumps(redact_obj(result)),\n    95\t                context_tokens, context_tokens_method, model_requested, model_served,\n    96\t                timeout=2.0,\n    97\t            )\n    98\t        except Exception as exc:  # any failure to persist stops the run\n    99\t            log.error(\"audit write failed\", extra={\"event_type\": event_type, \"run_id\": ctx.run_id})\n   100\t            raise AuditUnavailable(str(type(exc).__name__)) from exc\n   101\t        return event_id","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01TQTuVDPGuyhhbCGi5HjGD1","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
