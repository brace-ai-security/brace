{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017tUMeyvCWSzauUfi6iqVi4","type":"tool_result","content":"        note: {type: string, maxLength: 280}\n      required: [leave_type, start_date, end_date]\n      additionalProperties: false\n    output_schema:\n      type: object\n      properties:\n        request_id: {type: string, pattern: \"^LR-[0-9]{8}$\"}\n        status: {enum: [submitted, duplicate]}\n        approver_role: {type: string, maxLength: 40}\n      required: [request_id, status]\n      additionalProperties: false\n\n  escalate_to_human:\n    kind: mcp\n    qualified: helpdesk/create_ticket\n    server: helpdesk\n    reason: \"Hand the conversation to an HR advisor when the agent cannot help.\"\n    scope: helpdesk.ticket.create\n    approval: subject\n    target: \"queue:hr-advisors\"\n    fingerprint: \"sha256:3e9b71f0c2d84a6e5b17f9c03d2a8e46b1f5c07d93a2e68b4c1d0f7a5e3b9c28\"\n    direct_route:\n      endpoint: https://helpdesk-mcp.helpdesk.svc.cluster.local:8443/mcp\n      audience: helpdesk-mcp\n    input_schema:\n      type: object\n      properties:\n        summary: {type: string, minLength: 10, maxLength: 1000}\n        category: {enum: [payroll, leave, benefits, conduct, other]}\n      required: [summary, category]\n      additionalProperties: false\n    output_schema:\n      type: object\n      properties:\n        ticket_id: {type: string, pattern: \"^HR-[0-9]{6}$\"}\n        queue: {type: string, maxLength: 40}\n      required: [ticket_id]\n      additionalProperties: false\n\n\ndef _verify(request: Request) -> dict[str, Any]:\n    auth = request.headers.get(\"authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        raise PermissionError(\"missing bearer token\")\n    token = auth[7:]\n    claims = jwt.decode(\n        token, JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"ES256\"], audience=AUDIENCE, issuer=ISSUER,\n        options={\"require\": [\"exp\", \"iat\", \"sub\", \"scope\", \"act\", \"cnf\"]}, leeway=5,\n    )\n    # The mesh sets X-Forwarded-Client-Cert from the verified peer certificate and strips client copies.\n    xfcc = request.headers.get(\"x-forwarded-client-cert\", \"\")\n    cert_hash = next((p.split(\"=\", 1)[1] for p in xfcc.split(\";\") if p.startswith(\"Hash=\")), None)\n    if cert_hash is None or claims[\"cnf\"].get(\"x5t#S256\") != cert_hash:\n        raise PermissionError(\"token not bound to caller certificate\")\n    if claims[\"act\"].get(\"sub\") not in ACTORS:\n        raise PermissionError(\"actor not allowed\")\n    claims[\"_raw\"] = token\n    return claims\n\n\nasync def _stop_reason(claims: dict[str, Any], instance: str) -> str | None:\n    return await _pool.fetchval(\n        \"\"\"SELECT reason FROM control.stop_flags WHERE active AND (scope = 'fleet'\n             OR (scope = 'agent_instance' AND value = $1) OR (scope = 'subject' AND value = $2)\n             OR (scope = 'agent_principal' AND value = $3)) LIMIT 1\"\"\",\n        instance, claims[\"sub\"], claims[\"act\"][\"sub\"], timeout=1.0,\n    )\n\n\ndef _rate_ok(kind: str, key: str) -> bool:\n    q, now = _rate[(kind, key)], time.monotonic()\n    while q and now - q[0] > 60:\n        q.popleft()\n    if len(q) >= RATE_PER_MINUTE[kind]:\nsrc/gateway.py:22:from starlette.applications import Starlette\nsrc/gateway.py:25:from starlette.routing import Route\nsrc/gateway.py:218:app = Starlette(routes=[Route(\"/mcp\", mcp, methods=[\"POST\"])], on_startup=[_startup])\nsrc/main.py:18:from starlette.applications import Starlette\nsrc/main.py:21:from starlette.routing import Route\nsrc/main.py:178:app = Starlette(\nsrc/main.py:180:        Route(\"/v1/chat\", chat, methods=[\"POST\"]),\nsrc/main.py:181:        Route(\"/v1/runs/{run_id}/approvals/{approval_id}/confirm\", confirm, methods=[\"POST\"]),\napiVersion: networking.k8s.io/v1\nkind: NetworkPolicy\nmetadata:\n  name: default-deny-all\n  namespace: hr-agent\nspec:\n  podSelector: {}\n  policyTypes: [Ingress