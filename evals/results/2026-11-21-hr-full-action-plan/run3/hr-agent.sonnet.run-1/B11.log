{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JorcKWQ7GZ2N9ZEjJDCLax","type":"tool_result","content":"     1\t# syntax=docker/dockerfile:1.10\n     2\tFROM python:3.12.7-slim-bookworm@sha256:032c52613401895aa3d418a4c5bf5c3ad0d5d6fe3c1e9b2c8b5d0a7e6f4c3b21 AS build\n     3\tENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1\n     4\tWORKDIR /build\n     5\tCOPY requirements.txt .\n     6\tRUN pip install --require-hashes --only-binary=:all: --target /deps -r requirements.txt\n     7\t\n     8\tFROM gcr.io/distroless/python3-debian12:nonroot@sha256:7e4c1d2a9f3b8e60c5d47a19b2f03e8d6c1a5b94f7e2d03c8a6b1f5e9d4c2a70\n     9\tENV PYTHONPATH=/deps:/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1\n    10\tWORKDIR /app\n    11\tCOPY --from=build /deps /deps\n    12\tCOPY --chown=0:0 requirements.txt Dockerfile ./\n    13\tCOPY --chown=0:0 src/ src/\n    14\tCOPY --chown=0:0 prompts/ prompts/\n    15\tCOPY --chown=0:0 config/ config/\n    16\tUSER 65532:65532\n    17\tENTRYPOINT [\"python3\"]\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: hr-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.31\n     8\t    pod-security.kubernetes.io/warn: restricted\n     9\t    pod-security.kubernetes.io/audit: restricted\n    10\t    istio.io/dataplane-mode: ambient\n    11\t---\n    12\tapiVersion: kyverno.io/v1\n    13\tkind: ClusterPolicy\n    14\tmetadata:\n    15\t  name: hr-agent-verify-images\n    16\t  annotations:\n    17\t    policies.kyverno.io/owner: people-platform\n    18\tspec:\n    19\t  validationFailureAction: Enforce\n    20\t  failurePolicy: Fail\n    21\t  webhookTimeoutSeconds: 15\n    22\t  background: false\n    23\t  rules:\n    24\t    - name: only-approved-registry\n    25\t      match:\n    26\t        any:\n    27\t          - resources: {kinds: [Pod], namespaces: [hr-agent]}\n    28\t      validate:\n    29\t        message: \"Images in hr-agent must come from registry.acme.example and be referenced by digest.\"\n    30\t        pattern:\n    31\t          spec:\n    32\t            =(initContainers):\n    33\t              - image: \"registry.acme.example/*@sha256:*\"\n    34\t            containers:\n    35\t              - image: \"registry.acme.example/*@sha256:*\"\n    36\t    - name: verify-signature-and-provenance\n    37\t      match:\n    38\t        any:\n    39\t          - resources: {kinds: [Pod], namespaces: [hr-agent]}\n    40\t      verifyImages:\n    41\t        - imageReferences: [\"registry.acme.example/people/hr-helpdesk-agent*\"]\n    42\t          mutateDigest: false\n    43\t          verifyDigest: true\n    44\t          required: true\n    45\t          attestors:\n    46\t            - entries:\n    47\t                - keyless:\n    48\t                    subject: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    49\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    50\t                    rekor: {url: \"https://rekor.sigstore.dev\"}\n    51\t          attestations:\n    52\t            - type: https://slsa.dev/provenance/v1\n    53\t              attestors:\n    54\t                - entries:\n    55\t                    - keyless:\n    56\t                        subject: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    57\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    58\t              conditions:\n    59\t                - all:\n    60\t                    - key: \"{{ buildDefinition.buildType }}\"\n    61\t                      operator: Equals\n    62\t                      value: \"https://actions.github.io/buildtypes/workflow/v1\"\n    63\t                    - key: \"{{ buildDefinition.externalParameters.workflow.repository }}\"\n    64\t                      operator: Equals\n    65\t                      value: \"https://github.com/acme/hr-helpdesk-agent\"\n    66\t                    - key: \"{{ buildDefinition.externalParameters.workflow.ref }}\"\n    67\t                      operator: Equals\n    68\t                      value: \"refs/heads/main\"\n    69\t                    - key: \"{{ runDetails.builder.id }}\"\n    70\t                      operator: Equals\n    71\t                      value: \"https://github.com/actions/runner/github-hosted\"\n    72\t        - imageReferences: [\"registry.acme.example/platform/*\"]\n    73\t          mutateDigest: false\n    74\t          verifyDigest: true\n    75\t          required: true\n    76\t          attestors:\n    77\t            - entries:\n    78\t                - keyless:\n    79\t                    subject: \"https://github.com/acme/platform-images/.github/workflows/build.yml@refs/heads/main\"\n    80\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    81\t                    rekor: {url: \"https://rekor.sigstore.dev\"}\n     1\tapiVersion: batch/v1\n     2\tkind: CronJob\n     3\tmetadata:\n     4\t  name: audit-partition-maintenance\n     5\t  namespace: hr-agent\n     6\t  labels: {app.kubernetes.io/part-of: hr-helpdesk}\n     7\tspec:\n     8\t  schedule: \"17 2 * * *\"\n     9\t  concurrencyPolicy: Forbid\n    10\t  jobTemplate:\n    11\t    spec:\n    12\t      backoffLimit: 2\n    13\t      template:\n    14\t        metadata:\n    15\t          labels: {app: audit-maintenance}\n    16\t        spec:\n    17\t          serviceAccountName: hr-audit-maint\n    18\t          automountServiceAccountToken: false\n    19\t          restartPolicy: OnFailure\n    20\t          securityContext:\n    21\t            runAsNonRoot: true\n    22\t            runAsUser: 70\n    23\t            seccompProfile: {type: RuntimeDefault}\n    24\t          containers:\n    25\t            - name: maintain\n    26\t              image: registry.acme.example/platform/psql@sha256:9b2e61c04d7f3a85e1c6b09d2f4a7e3c58d1b6a0f9e2c47d3b8a15e6f0c9d2a4\n    27\t              env:\n    28\t                - name: PGSERVICE\n    29\t                  value: hr_audit_maint\n    30\t                - name: PERIOD\n    31\t                  value: \"1 week\"\n    32\t                - name: AHEAD\n    33\t                  value: \"4\"\n    34\t                - name: KEEP_PARTITIONS\n    35\t                  value: \"6\"\n    36\t              command: [\"psql\", \"-v\", \"ON_ERROR_STOP=1\", \"-c\"]\n    37\t              args:\n    38\t                - >-\n    39\t                  SELECT audit.maintain_partitions('audit.events', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    40\t                  SELECT audit.maintain_partitions('audit.gateway_decisions', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    41\t              securityContext:\n    42\t                allowPrivilegeEscalation: false\n    43\t                readOnlyRootFilesystem: true\n    44\t                capabilities: {drop: [ALL]}\n    45\t              volumeMounts:\n    46\t                - {name: pgservice, mountPath: /etc/postgresql-common, readOnly: true}\n    47\t          volumes:\n    48\t            - name: pgservice\n    49\t              secret: {secretName: hr-audit-maint-pgservice}\n     1\tapiVersion: v1\n     2\tkind: ServiceAccount\n     3\tmetadata:\n     4\t  name: hr-helpdesk-agent\n     5\t  namespace: hr-agent\n     6\tautomountServiceAccountToken: false\n     7\t---\n     8\tapiVersion: v1\n     9\tkind: ServiceAccount\n    10\tmetadata:\n    11\t  name: hr-tool-gateway\n    12\t  namespace: hr-agent\n    13\tautomountServiceAccountToken: false\n    14\t---\n    15\tapiVersion: apps/v1\n    16\tkind: Deployment\n    17\tmetadata:\n    18\t  name: hr-helpdesk-agent\n    19\t  namespace: hr-agent\n    20\t  labels: {app: hr-helpdesk-agent, app.kubernetes.io/part-of: hr-helpdesk}\n    21\tspec:\n    22\t  replicas: 3\n    23\t  selector:\n    24\t    matchLabels: {app: hr-helpdesk-agent}\n    25\t  template:\n    26\t    metadata:\n    27\t      labels: {app: hr-helpdesk-agent}\n    28\t      annotations:\n    29\t        acme.example/release-manifest: \"release/manifest.yaml@${GIT_SHA}\"\n    30\t    spec:\n    31\t      serviceAccountName: hr-helpdesk-agent\n    32\t      automountServiceAccountToken: false\n    33\t      hostUsers: false\n    34\t      enableServiceLinks: false\n    35\t      securityContext:\n    36\t        runAsNonRoot: true\n    37\t        runAsUser: 65532\n    38\t        runAsGroup: 65532\n    39\t        fsGroup: 65532\n    40\t        seccompProfile: {type: RuntimeDefault}\n    41\t      containers:\n    42\t        - name: agent\n    43\t          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n    44\t          args: [\"-m\", \"uvicorn\", \"src.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\"]\n    45\t          ports: [{containerPort: 8080}]\n    46\t          env:\n    47\t            - {name: AGENT_TYPE_ID, value: \"${AGENT_TYPE_ID}\"}\n    48\t            - {name: IMAGE_DIGEST, value: \"${IMAGE_DIGEST}\"}\n    49\t            - name: POD_UID\n    50\t              valueFrom: {fieldRef: {fieldPath: metadata.uid}}\n    51\t            - name: DATABASE_URL\n    52\t              valueFrom: {secretKeyRef: {name: hr-agent-db, key: url}}\n    53\t            - name: ANTHROPIC_API_KEY\n    54\t              valueFrom: {secretKeyRef: {name: hr-agent-anthropic, key: api_key}}\n    55\t            - {name: ANTHROPIC_BASE_URL, value: \"https://api.anthropic.com\"}\n    56\t          securityContext:\n    57\t            allowPrivilegeEscalation: false\n    58\t            readOnlyRootFilesystem: true\n    59\t            privileged: false\n    60\t            capabilities: {drop: [ALL]}\n    61\t          resources:\n    62\t            requests: {cpu: 250m, memory: 384Mi}\n    63\t            limits: {cpu: \"1\", memory: 768Mi}\n    64\t          volumeMounts:\n    65\t            - {name: tmp, mountPath: /tmp}\n    66\t            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n    67\t            - {name: svid, mountPath: /etc/svid, readOnly: true}\n    68\t      volumes:\n    69\t        - name: tmp\n    70\t          emptyDir: {medium: Memory, sizeLimit: 32Mi}\n    71\t        - name: sts-token\n    72\t          projected:\n    73\t            sources:\n    74\t              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n    75\t        - name: svid\n    76\t          csi: {driver: csi.spiffe.io, readOnly: true}\n    77\t---\n    78\tapiVersion: apps/v1\n    79\tkind: Deployment\n    80\tmetadata:\n    81\t  name: hr-tool-gateway\n    82\t  namespace: hr-agent\n    83\t  labels: {app: hr-tool-gateway, app.kubernetes.io/part-of: hr-helpdesk}\n    84\tspec:\n    85\t  replicas: 2\n    86\t  selector:\n    87\t    matchLabels: {app: hr-tool-gateway}\n    88\t  template:\n    89\t    metadata:\n    90\t      labels: {app: hr-tool-gateway}\n    91\t    spec:\n    92\t      serviceAccountName: hr-tool-gateway\n    93\t      automountServiceAccountToken: false\n    94\t      hostUsers: false\n    95\t      enableServiceLinks: false\n    96\t      securityContext:\n    97\t        runAsNonRoot: true\n    98\t        runAsUser: 65532\n    99\t        runAsGroup: 65532\n   100\t        seccompProfile: {type: RuntimeDefault}\n   101\t      containers:\n   102\t        - name: gateway\n   103\t          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n   104\t          args: [\"-m\", \"uvicorn\", \"src.gateway:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8443\"]\n   105\t          ports: [{containerPort: 8443}]\n   106\t          env:\n   107\t            - name: GATEWAY_DATABASE_URL\n   108\t              valueFrom: {secretKeyRef: {name: hr-gateway-db, key: url}}\n   109\t          securityContext:\n   110\t            allowPrivilegeEscalation: false\n   111\t            readOnlyRootFilesystem: true\n   112\t            privileged: false\n   113\t            capabilities: {drop: [ALL]}\n   114\t          volumeMounts:\n   115\t            - {name: tmp, mountPath: /tmp}\n   116\t            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n   117\t            - {name: svid, mountPath: /etc/svid, readOnly: true}\n   118\t      volumes:\n   119\t        - name: tmp\n   120\t          emptyDir: {medium: Memory, sizeLimit: 16Mi}\n   121\t        - name: sts-token\n   122\t          projected:\n   123\t            sources:\n   124\t              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n   125\t        - name: svid\n   126\t          csi: {driver: csi.spiffe.io, readOnly: true}\n   127\t---\n   128\tapiVersion: v1\n   129\tkind: Service\n   130\tmetadata:\n   131\t  name: hr-tool-gateway\n   132\t  namespace: hr-agent\n   133\tspec:\n   134\t  selector: {app: hr-tool-gateway}\n   135\t  ports: [{port: 8443, targetPort: 8443}]\n   136\t---\n   137\tapiVersion: v1\n   138\tkind: Service\n   139\tmetadata:\n   140\t  name: hr-helpdesk-agent\n   141\t  namespace: hr-agent\n   142\tspec:\n   143\t  selector: {app: hr-helpdesk-agent}\n   144\t  sessionAffinity: ClientIP\n   145\t  ports: [{port: 80, targetPort: 8080}]\n     1\tapiVersion: networking.k8s.io/v1\n     2\tkind: NetworkPolicy\n     3\tmetadata:\n     4\t  name: default-deny-all\n     5\t  namespace: hr-agent\n     6\tspec:\n     7\t  podSelector: {}\n     8\t  policyTypes: [Ingress, Egress]\n     9\t---\n    10\tapiVersion: cilium.io/v2\n    11\tkind: CiliumNetworkPolicy\n    12\tmetadata:\n    13\t  name: hr-helpdesk-agent-egress\n    14\t  namespace: hr-agent\n    15\tspec:\n    16\t  endpointSelector:\n    17\t    matchLabels: {app: hr-helpdesk-agent}\n    18\t  ingress:\n    19\t    - fromEndpoints:\n    20\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": web-frontends, app: hr-portal-bff}\n    21\t      toPorts: [{ports: [{port: \"8080\", protocol: TCP}]}]\n    22\t  egress:\n    23\t    - toEndpoints:\n    24\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": kube-system, k8s-app: kube-dns}\n    25\t      toPorts:\n    26\t        - ports: [{port: \"53\", protocol: UDP}]\n    27\t          rules:\n    28\t            dns:\n    29\t              - matchName: api.anthropic.com\n    30\t              - matchName: sso.acme.example\n    31\t              - matchPattern: \"*.svc.cluster.local\"\n    32\t    - toFQDNs:\n    33\t        - matchName: api.anthropic.com\n    34\t        - matchName: sso.acme.example\n    35\t      toPorts: [{ports: [{port: \"443\", protocol: TCP}]}]\n    36\t    - toEndpoints:\n    37\t        - matchLabels: {app: hr-tool-gateway}\n    38\t      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n    39\t    - toEndpoints:\n    40\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": identity, app: sts}\n    41\t      toPorts: [{ports: [{port: \"443\", protocol: TCP}]}]\n    42\t    - toEndpoints:\n    43\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": data, app: hr-postgres}\n    44\t      toPorts: [{ports: [{port: \"5432\", protocol: TCP}]}]\n    45\t    - toEndpoints:\n    46\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": observability, app: otel-collector}\n    47\t      toPorts: [{ports: [{port: \"4317\", protocol: TCP}]}]\n    48\t    - toEndpoints:\n    49\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": helpdesk, app: helpdesk-mcp}\n    50\t      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n    51\t  egressDeny:\n    52\t    - toCIDR: [169.254.169.254/32, 169.254.170.2/32, 100.100.100.200/32]\n    53\t    - toCIDRSet:\n    54\t        - cidr: fd00:ec2::254/128\n    55\t---\n    56\tapiVersion: cilium.io/v2\n    57\tkind: CiliumNetworkPolicy\n    58\tmetadata:\n    59\t  name: hr-tool-gateway-egress\n    60\t  namespace: hr-agent\n    61\tspec:\n    62\t  endpointSelector:\n    63\t    matchLabels: {app: hr-tool-gateway}\n    64\t  ingress:\n    65\t    - fromEndpoints:\n    66\t        - matchLabels: {app: hr-helpdesk-agent}\n    67\t      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n    68\t  egress:\n    69\t    - toEndpoints:\n    70\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": kube-system, k8s-app: kube-dns}\n    71\t      toPorts:\n    72\t        - ports: [{port: \"53\", protocol: UDP}]\n    73\t          rules:\n    74\t            dns:\n    75\t              - matchPattern: \"*.svc.cluster.local\"\n    76\t    - toEndpoints:\n    77\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": hris, app: hris-mcp}\n    78\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": helpdesk, app: helpdesk-mcp}\n    79\t      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n    80\t    - toEndpoints:\n    81\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": identity, app: sts}\n    82\t      toPorts: [{ports: [{port: \"443\", protocol: TCP}]}]\n    83\t    - toEndpoints:\n    84\t        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": data, app: hr-postgres}\n    85\t      toPorts: [{ports: [{port: \"5432\", protocol: TCP}]}]\n    86\t  egressDeny:\n    87\t    - toCIDR: [169.254.169.254/32, 169.254.170.2/32, 100.100.100.200/32]\n    88\t    - toCIDRSet:\n    89\t        - cidr: fd00:ec2::254/128\n     1\tpolicy_version: \"2026-09-18.3\"\n     2\t\n     3\tservers:\n     4\t  hris:\n     5\t    endpoint: https://hris-mcp.hris.svc.cluster.local:8443/mcp\n     6\t    identity: spiffe://acme.example/ns/hris/sa/hris-mcp\n     7\t    downstream_audience: hris-mcp\n     8\t    owner: hris-platform\n     9\t  helpdesk:\n    10\t    endpoint: https://helpdesk-mcp.helpdesk.svc.cluster.local:8443/mcp\n    11\t    identity: spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\n    12\t    downstream_audience: helpdesk-mcp\n    13\t    owner: it-service-desk\n    14\t\n    15\t# Model-facing name -> qualified tool. Server annotations (readOnlyHint etc.)\n    16\t# are never consulted; approval comes only from this file.\n    17\ttools:\n    18\t  search_policies:\n    19\t    kind: local\n    20\t    reason: \"Answer policy questions from the approved HR handbook index.\"\n    21\t    scope: hr.policy.read\n    22\t    approval: none\n    23\t    input_schema:\n    24\t      type: object\n    25\t      properties:\n    26\t        query: {type: string, minLength: 3, maxLength: 300}\n    27\t      required: [query]\n    28\t      additionalProperties: false\n    29\t\n    30\t  get_leave_balance:\n    31\t    kind: mcp\n    32\t    qualified: hris/get_leave_balance\n    33\t    server: hris\n    34\t    reason: \"Show the asking employee their own leave balance.\"\n    35\t    scope: hris.leave.read\n    36\t    approval: none\n    37\t    target: \"employee:{subject}\"\n    38\t    fingerprint: \"sha256:5d1c0e9a7b3f48e2a61c9d04f7be3a92c815e6d07ab4f3c2e19d8a6b5c4f0e71\"\n    39\t    input_schema:\n    40\t      type: object\n    41\t      properties:\n    42\t        leave_type: {enum: [annual, sick, parental, unpaid]}\n    43\t      required: [leave_type]\n    44\t      additionalProperties: false\n    45\t    output_schema:\n    46\t      type: object\n    47\t      properties:\n    48\t        leave_type: {type: string, maxLength: 20}\n    49\t        balance_days: {type: number, minimum: 0, maximum: 400}\n    50\t        accrual_per_month: {type: number, minimum: 0, maximum: 5}\n    51\t        as_of: {type: string, format: date}\n    52\t      required: [leave_type, balance_days, as_of]\n    53\t      additionalProperties: false\n    54\t\n    55\t  file_leave_request:\n    56\t    kind: mcp\n    57\t    qualified: hris/file_leave_request\n    58\t    server: hris\n    59\t    reason: \"File a leave request for the asking employee; the manager approves it in HRIS.\"\n    60\t    scope: hris.leave.request\n    61\t    approval: subject\n    62\t    target: \"employee:{subject}\"\n    63\t    fingerprint: \"sha256:a0f7c3d95e21b84f6c0d19e3a7b25f48d6e0c1a93b7f2e54d81c6a09f3e7b2d4\"\n    64\t    input_schema:\n    65\t      type: object\n    66\t      properties:\n    67\t        leave_type: {enum: [annual, sick, parental, unpaid]}\n    68\t        start_date: {type: string, format: date}\n    69\t        end_date: {type: string, format: date}\n    70\t        note: {type: string, maxLength: 280}\n    71\t      required: [leave_type, start_date, end_date]\n    72\t      additionalProperties: false\n    73\t    output_schema:\n    74\t      type: object\n    75\t      properties:\n    76\t        request_id: {type: string, pattern: \"^LR-[0-9]{8}$\"}\n    77\t        status: {enum: [submitted, duplicate]}\n    78\t        approver_role: {type: string, maxLength: 40}\n    79\t      required: [request_id, status]\n    80\t      additionalProperties: false\n    81\t\n    82\t  escalate_to_human:\n    83\t    kind: mcp\n    84\t    qualified: helpdesk/create_ticket\n    85\t    server: helpdesk\n    86\t    reason: \"Hand the conversation to an HR advisor when the agent cannot help.\"\n    87\t    scope: helpdesk.ticket.create\n    88\t    approval: subject\n    89\t    target: \"queue:hr-advisors\"\n    90\t    fingerprint: \"sha256:3e9b71f0c2d84a6e5b17f9c03d2a8e46b1f5c07d93a2e68b4c1d0f7a5e3b9c28\"\n    91\t    direct_route:\n    92\t      endpoint: https://helpdesk-mcp.helpdesk.svc.cluster.local:8443/mcp\n    93\t      audience: helpdesk-mcp\n    94\t    input_schema:\n    95\t      type: object\n    96\t      properties:\n    97\t        summary: {type: string, minLength: 10, maxLength: 1000}\n    98\t        category: {enum: [payroll, leave, benefits, conduct, other]}\n    99\t      required: [summary, category]\n   100\t      additionalProperties: false\n   101\t    output_schema:\n   102\t      type: object\n   103\t 