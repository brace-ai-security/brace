{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fbc4mK2LeqggpFFDdHduJ7","type":"tool_result","content":"     1\tapiVersion: v1\n     2\tkind: ServiceAccount\n     3\tmetadata:\n     4\t  name: hr-helpdesk-agent\n     5\t  namespace: hr-agent\n     6\tautomountServiceAccountToken: false\n     7\t---\n     8\tapiVersion: v1\n     9\tkind: ServiceAccount\n    10\tmetadata:\n    11\t  name: hr-tool-gateway\n    12\t  namespace: hr-agent\n    13\tautomountServiceAccountToken: false\n    14\t---\n    15\tapiVersion: apps/v1\n    16\tkind: Deployment\n    17\tmetadata:\n    18\t  name: hr-helpdesk-agent\n    19\t  namespace: hr-agent\n    20\t  labels: {app: hr-helpdesk-agent, app.kubernetes.io/part-of: hr-helpdesk}\n    21\tspec:\n    22\t  replicas: 3\n    23\t  selector:\n    24\t    matchLabels: {app: hr-helpdesk-agent}\n    25\t  template:\n    26\t    metadata:\n    27\t      labels: {app: hr-helpdesk-agent}\n    28\t      annotations:\n    29\t        acme.example/release-manifest: \"release/manifest.yaml@${GIT_SHA}\"\n    30\t    spec:\n    31\t      serviceAccountName: hr-helpdesk-agent\n    32\t      automountServiceAccountToken: false\n    33\t      hostUsers: false\n    34\t      enableServiceLinks: false\n    35\t      securityContext:\n    36\t        runAsNonRoot: true\n    37\t        runAsUser: 65532\n    38\t        runAsGroup: 65532\n    39\t        fsGroup: 65532\n    40\t        seccompProfile: {type: RuntimeDefault}\n    41\t      containers:\n    42\t        - name: agent\n    43\t          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n    44\t          args: [\"-m\", \"uvicorn\", \"src.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\"]\n    45\t          ports: [{containerPort: 8080}]\n    46\t          env:\n    47\t            - {name: AGENT_TYPE_ID, value: \"${AGENT_TYPE_ID}\"}\n    48\t            - {name: IMAGE_DIGEST, value: \"${IMAGE_DIGEST}\"}\n    49\t            - name: POD_UID\n    50\t              valueFrom: {fieldRef: {fieldPath: metadata.uid}}\n    51\t            - name: DATABASE_URL\n    52\t              valueFrom: {secretKeyRef: {name: hr-agent-db, key: url}}\n    53\t            - name: ANTHROPIC_API_KEY\n    54\t              valueFrom: {secretKeyRef: {name: hr-agent-anthropic, key: api_key}}\n    55\t            - {name: ANTHROPIC_BASE_URL, value: \"https://api.anthropic.com\"}\n    56\t          securityContext:\n    57\t            allowPrivilegeEscalation: false\n    58\t            readOnlyRootFilesystem: true\n    59\t            privileged: false\n    60\t            capabilities: {drop: [ALL]}\n    61\t          resources:\n    62\t            requests: {cpu: 250m, memory: 384Mi}\n    63\t            limits: {cpu: \"1\", memory: 768Mi}\n    64\t          volumeMounts:\n    65\t            - {name: tmp, mountPath: /tmp}\n    66\t            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n    67\t            - {name: svid, mountPath: /etc/svid, readOnly: true}\n    68\t      volumes:\n    69\t        - name: tmp\n    70\t          emptyDir: {medium: Memory, sizeLimit: 32Mi}\n    71\t        - name: sts-token\n    72\t          projected:\n    73\t            sources:\n    74\t              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n    75\t        - name: svid\n    76\t          csi: {driver: csi.spiffe.io, readOnly: true}\n    77\t---\n    78\tapiVersion: apps/v1\n    79\tkind: Deployment\n    80\tmetadata:\n    81\t  name: hr-tool-gateway\n    82\t  namespace: hr-agent\n    83\t  labels: {app: hr-tool-gateway, app.kubernetes.io/part-of: hr-helpdesk}\n    84\tspec:\n    85\t  replicas: 2\n    86\t  selector:\n    87\t    matchLabels: {app: hr-tool-gateway}\n    88\t  template:\n    89\t    metadata:\n    90\t      labels: {app: hr-tool-gateway}\n    91\t    spec:\n    92\t      serviceAccountName: hr-tool-gateway\n    93\t      automountServiceAccountToken: false\n    94\t      hostUsers: false\n    95\t      enableServiceLinks: false\n    96\t      securityContext:\n    97\t        runAsNonRoot: true\n    98\t        runAsUser: 65532\n    99\t        runAsGroup: 65532\n   100\t        seccompProfile: {type: RuntimeDefault}\n   101\t      containers:\n   102\t        - name: gateway\n   103\t          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n   104\t          args: [\"-m\", \"uvicorn\", \"src.gateway:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8443\"]\n   105\t          ports: [{containerPort: 8443}]\n   106\t          env:\n   107\t            - name: GATEWAY_DATABASE_URL\n   108\t              valueFrom: {secretKeyRef: {name: hr-gateway-db, key: url}}\n   109\t          securityContext:\n   110\t            allowPrivilegeEscalation: false\n   111\t            readOnlyRootFilesystem: true\n   112\t            privileged: false\n   113\t            capabilities: {drop: [ALL]}\n   114\t          volumeMounts:\n   115\t            - {name: tmp, mountPath: /tmp}\n   116\t            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n   117\t            - {name: svid, mountPath: /etc/svid, readOnly: true}\n   118\t      volumes:\n   119\t        - name: tmp\n   120\t          emptyDir: {medium: Memory, sizeLimit: 16Mi}\n   121\t        - name: sts-token\n   122\t          projected:\n   123\t            sources:\n   124\t              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n   125\t        - name: svid\n   126\t          csi: {driver: csi.spiffe.io, readOnly: true}\n   127\t---\n   128\tapiVersion: v1\n   129\tkind: Service\n   130\tmetadata:\n   131\t  name: hr-tool-gateway\n   132\t  namespace: hr-agent\n   133\tspec:\n   134\t  selector: {app: hr-tool-gateway}\n   135\t  ports: [{port: 8443, targetPort: 8443}]\n   136\t---\n   137\tapiVersion: v1\n   138\tkind: Service\n   139\tmetadata:\n   140\t  name: hr-helpdesk-agent\n   141\t  namespace: hr-agent\n   142\tspec:\n   143\t  selector: {app: hr-helpdesk-agent}\n   144\t  sessionAffinity: ClientIP\n   145\t  ports: [{port: 80, targetPort: 8080}]\n     1\tapiVersion: v1\n     2\tkind: Namespace\n     3\tmetadata:\n     4\t  name: hr-agent\n     5\t  labels:\n     6\t    pod-security.kubernetes.io/enforce: restricted\n     7\t    pod-security.kubernetes.io/enforce-version: v1.31\n     8\t    pod-security.kubernetes.io/warn: restricted\n     9\t    pod-security.kubernetes.io/audit: restricted\n    10\t    istio.io/dataplane-mode: ambient\n    11\t---\n    12\tapiVersion: kyverno.io/v1\n    13\tkind: ClusterPolicy\n    14\tmetadata:\n    15\t  name: hr-agent-verify-images\n    16\t  annotations:\n    17\t    policies.kyverno.io/owner: people-platform\n    18\tspec:\n    19\t  validationFailureAction: Enforce\n    20\t  failurePolicy: Fail\n    21\t  webhookTimeoutSeconds: 15\n    22\t  background: false\n    23\t  rules:\n    24\t    - name: only-approved-registry\n    25\t      match:\n    26\t        any:\n    27\t          - resources: {kinds: [Pod], namespaces: [hr-agent]}\n    28\t      validate:\n    29\t        message: \"Images in hr-agent must come from registry.acme.example and be referenced by digest.\"\n    30\t        pattern:\n    31\t          spec:\n    32\t            =(initContainers):\n    33\t              - image: \"registry.acme.example/*@sha256:*\"\n    34\t            containers:\n    35\t              - image: \"registry.acme.example/*@sha256:*\"\n    36\t    - name: verify-signature-and-provenance\n    37\t      match:\n    38\t        any:\n    39\t          - resources: {kinds: [Pod], namespaces: [hr-agent]}\n    40\t      verifyImages:\n    41\t        - imageReferences: [\"registry.acme.example/people/hr-helpdesk-agent*\"]\n    42\t          mutateDigest: false\n    43\t          verifyDigest: true\n    44\t          required: true\n    45\t          attestors:\n    46\t            - entries:\n    47\t                - keyless:\n    48\t                    subject: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    49\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    50\t                    rekor: {url: \"https://rekor.sigstore.dev\"}\n    51\t          attestations:\n    52\t            - type: https://slsa.dev/provenance/v1\n    53\t              attestors:\n    54\t                - entries:\n    55\t                    - keyless:\n    56\t                        subject: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    57\t                        issuer: \"https://token.actions.githubusercontent.com\"\n    58\t              conditions:\n    59\t                - all:\n    60\t                    - key: \"{{ buildDefinition.buildType }}\"\n    61\t                      operator: Equals\n    62\t                      value: \"https://actions.github.io/buildtypes/workflow/v1\"\n    63\t                    - key: \"{{ buildDefinition.externalParameters.workflow.repository }}\"\n    64\t                      operator: Equals\n    65\t                      value: \"https://github.com/acme/hr-helpdesk-agent\"\n    66\t                    - key: \"{{ buildDefinition.externalParameters.workflow.ref }}\"\n    67\t                      operator: Equals\n    68\t                      value: \"refs/heads/main\"\n    69\t                    - key: \"{{ runDetails.builder.id }}\"\n    70\t                      operator: Equals\n    71\t                      value: \"https://github.com/actions/runner/github-hosted\"\n    72\t        - imageReferences: [\"registry.acme.example/platform/*\"]\n    73\t          mutateDigest: false\n    74\t          verifyDigest: true\n    75\t          required: true\n    76\t          attestors:\n    77\t            - entries:\n    78\t                - keyless:\n    79\t                    subject: \"https://github.com/acme/platform-images/.github/workflows/build.yml@refs/heads/main\"\n    80\t                    issuer: \"https://token.actions.githubusercontent.com\"\n    81\t                    rekor: {url: \"https://rekor.sigstore.dev\"}\n     1\tapiVersion: batch/v1\n     2\tkind: CronJob\n     3\tmetadata:\n     4\t  name: audit-partition-maintenance\n     5\t  namespace: hr-agent\n     6\t  labels: {app.kubernetes.io/part-of: hr-helpdesk}\n     7\tspec:\n     8\t  schedule: \"17 2 * * *\"\n     9\t  concurrencyPolicy: Forbid\n    10\t  jobTemplate:\n    11\t    spec:\n    12\t      backoffLimit: 2\n    13\t      template:\n    14\t        metadata:\n    15\t          labels: {app: audit-maintenance}\n    16\t        spec:\n    17\t          serviceAccountName: hr-audit-maint\n    18\t          automountServiceAccountToken: false\n    19\t          restartPolicy: OnFailure\n    20\t          securityContext:\n    21\t            runAsNonRoot: true\n    22\t            runAsUser: 70\n    23\t            seccompProfile: {type: RuntimeDefault}\n    24\t          containers:\n    25\t            - name: maintain\n    26\t              image: registry.acme.example/platform/psql@sha256:9b2e61c04d7f3a85e1c6b09d2f4a7e3c58d1b6a0f9e2c47d3b8a15e6f0c9d2a4\n    27\t              env:\n    28\t                - name: PGSERVICE\n    29\t                  value: hr_audit_maint\n    30\t                - name: PERIOD\n    31\t                  value: \"1 week\"\n    32\t                - name: AHEAD\n    33\t                  value: \"4\"\n    34\t                - name: KEEP_PARTITIONS\n    35\t                  value: \"6\"\n    36\t              command: [\"psql\", \"-v\", \"ON_ERROR_STOP=1\", \"-c\"]\n    37\t              args:\n    38\t                - >-\n    39\t                  SELECT audit.maintain_partitions('audit.events', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    40\t                  SELECT audit.maintain_partitions('audit.gateway_decisions', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n    41\t              securityContext:\n    42\t                allowPrivilegeEscalation: false\n    43\t                readOnlyRootFilesystem: true\n    44\t                capabilities: {drop: [ALL]}\n    45\t              volumeMounts:\n    46\t                - {name: pgservice, mountPath: /etc/postgresql-common, readOnly: true}\n    47\t          volumes:\n    48\t            - name: pgservice\n    49\t              secret: {secretName: hr-audit-maint-pgservice}\n     1\t\"\"\"Per-tool, per-employee, short-lived tokens for the agent's own workload identity.\n     2\t\n     3\tThe pod's projected service-account token (audience sts.acme.example, 10 min) is the\n     4\tactor token. The employee's verified SSO token is the subject token. The STS returns an\n     5\tRFC 8693 token whose `sub` is the employee, `act.sub` is this workload, `aud` is the\n     6\trequested audience, `scope` is exactly one tool scope, and `cnf.x5t#S256` binds it to the\n     7\tpod's mTLS certificate. Lifetime is 300 s: long enough for one approval-to-execute window\n     8\ton a single call, short enough that a copied token is useless after the run.\n     9\t\"\"\"\n    10\tfrom __future__ import annotations\n    11\t\n    12\timport asyncio\n    13\timport time\n    14\tfrom dataclasses import dataclass\n    15\t\n    16\timport httpx\n    17\t\n    18\tSTS_URL = \"https://sts.identity.svc.cluster.local/oauth2/token\"\n    19\tACTOR_TOKEN_PATH = \"/var/run/secrets/tokens/sts-token\"\n    20\tTOKEN_TTL_SECONDS = 300\n    21\tREFRESH_MARGIN_SECONDS = 30\n    22\t\n    23\t\n    24\t@dataclass\n    25\tclass _Cached:\n    26\t    token: str\n    27\t    expires_at: float\n    28\t\n    29\t\n    30\tclass CredentialBroker:\n    31\t    def __init__(self, client: httpx.AsyncClient):\n    32\t        self._client = client  # configured with the pod's SPIFFE SVID for mTLS\n    33\t        self._cache: dict[tuple[str, str, str], _Cached] = {}\n    34\t        self._lock = asyncio.Lock()\n    35\t\n    36\t    def _actor_token(self) -> str:\n    37\t        # Re-read each time: kubelet rotates the projected token on disk.\n    38\t        with open(ACTOR_TOKEN_PATH, encoding=\"utf-8\") as fh:\n    39\t            return fh.read().strip()\n    40\t\n    41\t    async def token(self, *, audience: str, scope: str, subject_token: str, subject: str) -> str:\n    42\t        key = (audience, scope, subject)\n    43\t        async with self._lock:\n    44\t            hit = self._cache.get(key)\n    45\t            if hit and hit.expires_at - REFRESH_MARGIN_SECONDS > time.time():\n    46\t                return hit.token\n    47\t            resp = await self._client.post(\n    48\t                STS_URL,\n    49\t                data={\n    50\t                    \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n    51\t                    \"subject_token\": subject_token,\n    52\t                    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:id_token\",\n    53\t                    \"actor_token\": self._actor_token(),\n    54\t                    \"actor_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n    55\t                    \"audience\": audience,\n    56\t                    \"scope\": scope,\n    57\t                    \"requested_token_type\": \"urn:ietf:params:oauth:token-type:access_token\",\n    58\t                    \"requested_ttl\": str(TOKEN_TTL_SECONDS),\n    59\t                },\n    60\t                timeout=3.0,\n    61\t            )\n    62\t            resp.raise_for_status()\n    63\t            body = resp.json()\n    64\t            ttl = min(int(body.get(\"expires_in\", TOKEN_TTL_SECONDS)), TOKEN_TTL_SECONDS)\n    65\t            self._cache[key] = _Cached(body[\"access_token\"], time.time() + ttl)\n    66\t            return body[\"access_token\"]\n    67\t\n    68\t    def drop_subject(self, subject: str) -> None:\n    69\t        for key in [k for k in self._cache if k[2] == subject]:\n    70\t            del self._cache[key]\n     1\t\"\"\"Calls MCP tools through the hr-tool-gateway.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport logging\n     5\timport uuid\n     6\tfrom typing import Any\n     7\t\n     8\timport httpx\n     9\tfrom opentelemetry.propagate import inject\n    10\t\n    11\tfrom .audit import RunContext\n    12\tfrom .credentials import CredentialBroker\n    13\tfrom .tools import ToolSpec\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.gateway_client\")\n    16\t\n    17\tGATEWAY_URL = \"https://hr-tool-gateway.hr-agent.svc.cluster.local:8443/mcp\"\n    18\tGATEWAY_AUDIENCE = \"hr-tool-gateway\"\n    19\t\n    20\t\n    21\tclass ToolDenied(Exception):\n    22\t    def __init__(self, reason: str):\n    23\t        super().__init__(reason)\n    24\t        self.reason = reason\n    25\t\n    26\t\n    27\tclass ToolError(Exception):\n    28\t    def __init__(self, status: int, detail: str):\n    29\t        super().__init__(f\"{status}\")\n    30\t        self.status = status\n    31\t        self.detail = detail\n    32\t\n    33\t\n    34\tclass GatewayUnavailable(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass GatewayClient:\n    39\t    def __init__(self, client: httpx.AsyncClient, creds: CredentialBroker):\n    40\t        self._client = client\n    41\t        self._creds = creds\n    42\t\n    43\t    async def call(\n    44\t        self, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, subject_token: str, *, operation_id: str\n    45\t    ) -> dict[str, Any]:\n    46\t        try:\n    47\t            token = await self._creds.token(\n    48\t                audience=GATEWAY_AUDIENCE, scope=spec.scope, subject_token=subject_token, subject=ctx.subject\n    49\t            )\n    50\t            return await self._post(GATEWAY_URL, token, spec, args, ctx, operation_id)\n    51\t        except GatewayUnavailable:\n    52\t            if not spec.direct_route:\n    53\t                raise\n    54\t            log.warning(\"gateway unavailable, using direct route\", extra={\"tool\": spec.qualified})\n    55\t            token = await self._creds.token(\n    56\t                audience=spec.direct_route[\"audience\"], scope=spec.scope,\n    57\t                subject_token=subject_token, subject=ctx.subject,\n    58\t            )\n    59\t            return await self._post(spec.direct_route[\"endpoint\"], token, spec, args, ctx, operation_id)\n    60\t\n    61\t    async def _post(\n    62\t        self, url: str, token: str, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, operation_id: str\n    63\t    ) -> dict[str, Any]:\n    64\t        tool_name = spec.qualified.split(\"/\", 1)[1]\n    65\t        headers = {\n    66\t            \"Authorization\": f\"Bearer {token}\",\n    67\t            \"Mcp-Method\": \"tools/call\",\n    68\t            \"Mcp-Name\": tool_name,\n    69\t            \"Idempotency-Key\": operation_id,\n    70\t            \"X-Agent-Instance\": ctx.agent_instance_id,\n    71\t            \"X-Agent-Type-Id\": ctx.agent_type_id,\n    72\t        }\n    73\t        inject(headers)\n    74\t        body = {\n    75\t            \"jsonrpc\": \"2.0\",\n    76\t            \"id\": str(uuid.uuid4()),\n    77\t            \"method\": \"tools/call\",\n    78\t            \"params\": {\"name\": tool_name, \"arguments\": args, \"_meta\": {\"server\": spec.server}},\n    79\t        }\n    80\t        try:\n    81\t            resp = await self._client.post(url, json=body, headers=headers, timeout=10.0)\n    82\t        except (httpx.ConnectError, httpx.ConnectTimeout) as exc:\n    83\t            raise GatewayUnavailable(str(exc)) from exc\n    84\t        except httpx.TimeoutException as exc:\n    85\t            raise ToolError(504, f\"no response; outcome unknown for operation {operation_id}\") from exc\n    86\t        if resp.status_code == 503:\n    87\t            raise GatewayUnavailable(resp.text[:200])\n    88\t        if resp.status_code in (401, 403, 429):\n    89\t            raise ToolDenied(resp.json().get(\"error\", \"denied\"))\n    90\t        if resp.status_code >= 400:\n    91\t            raise ToolError(resp.status_code, resp.json().get(\"detail\", resp.text))\n    92\t        payload = resp.json()\n    93\t        if \"error\" in payload:\n    94\t            raise ToolError(200, str(payload[\"error\"].get(\"message\", \"\")))\n    95\t        return payload[\"result\"][\"structuredContent\"]\n     1\t{\n     2\t  \"mcpServers\": {\n     3\t    \"hr-tool-gateway\": {\n     4\t      \"type\": \"http\",\n     5\t      \"url\": \"https://hr-tool-gateway.hr-agent.svc.cluster.local:8443/mcp\",\n     6\t      \"headers\": {\n     7\t        \"Authorization\": \"Bearer ${HR_GATEWAY_TOKEN}\"\n     8\t      }\n     9\t    }\n    10\t  }\n    11\t}\n     1\tagent:\n     2\t  name: hr-helpdesk\n     3\t  accountable_party: \"VP People Operations <people-ops-lead@acme.example>\"\n     4\t  operational_owner: \"people-platform (pager: people-platform-oncall)\"\n     5\t  tenant: acme\n     6\t  workload_identity: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n     7\t\n     8\tmodel:\n     9\t  provider: anthropic\n    10\t  id: claude-sonnet-4-5-20250929\n    11\t  pinning: snapshot          # dated snapshot ID per provider model docs, checked 2026-09-15\n    12\t  adapter: none\n    13\t  max_output_tokens: 1024\n    14\t  temperature: 0.2\n    15\t\n    16\tbudgets:\n    17\t  run:\n    18\t    max_steps: 12\n    19\t    max_wall_seconds: 90\n    20\t    max_total_tokens: 60000\n    21\t    max_cost_usd: 0.40\n    22\t    max_tool_calls_per_minute: 20\n    23\t    max_subagents: 0\n    24\t  quotas:\n    25\t    - scope: user\n    26\t      window_seconds: 86400\n    27\t      max_runs: 150\n    28\t      max_tokens: 400000\n    29\t      max_cost_usd: 3.00\n    30\t    - scope: tenant\n    31\t     