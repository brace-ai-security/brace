{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChG4bzEJrwjck36rB3b2v","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LhME9Hw3KYxaTMbkNn7oNz","name":"Bash","input":{"command":"cat -n src/gateway.py | sed -n 30,135p; cat -n migrations/001_init.sql | grep -nE \"GRANT|ROLE|control|principal\" ; cat -n src/killswitch.py | sed -n 15,50p; cat README.md | sed -n 36,70p; cat k8s/networkpolicy.yaml | head -60"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8155,"cache_read_input_tokens":20996,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8155},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a3319f45-445c-413d-9771-d5bdb944cf4e","uuid":"4c65d198-e308-4905-a287-15019c2948c7","timestamp":"2026-11-21T12:20:35.512Z","request_id":"req_011ChG4bz5NqhqxHkeyLDX8t","wire_tool_inputs":{"toolu_01LhME9Hw3KYxaTMbkNn7oNz":{"command":"cd /private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-9fkqral0/agent && cat -n src/gateway.py | sed -n 30,135p; cat -n migrations/001_init.sql | grep -nE \"GRANT|ROLE|control|principal\" ; cat -n src/killswitch.py | sed -n 15,50p; cat README.md | sed -n 36,70p; cat k8s/networkpolicy.yaml | head -60"}},"wire_ingest_context":{"toolu_01LhME9Hw3KYxaTMbkNn7oNz":{"cwd":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-challenger-9fkqral0/agent"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LhME9Hw3KYxaTMbkNn7oNz","type":"tool_result","content":"    30\tlog = logging.getLogger(\"hr_gateway\")\n    31\t\n    32\tISSUER = \"https://sts.acme.example\"\n    33\tAUDIENCE = \"hr-tool-gateway\"\n    34\tSTS_BASE = \"https://sts.identity.svc.cluster.local\"\n    35\tJWKS = jwt.PyJWKClient(f\"{STS_BASE}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    36\t# Owner and tenant for each allowed actor come from this table, not from the request.\n    37\tACTORS = {\n    38\t    \"spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\": {\n    39\t        \"tenant\": \"acme\", \"accountable_party\": \"VP People Operations <people-ops-lead@acme.example>\",\n    40\t        \"operational_owner\": \"people-platform (pager: people-platform-oncall)\",\n    41\t    },\n    42\t}\n    43\tRATE_PER_MINUTE = {\"instance\": 20, \"subject\": 30}\n    44\t\n    45\tregistry = ToolRegistry.from_config()\n    46\tMCP_TOOLS = [s for s in map(registry.get, [t[\"name\"] for t in registry.model_schemas()]) if s.kind == \"mcp\"]\n    47\t_disabled: set[str] = {s.qualified for s in MCP_TOOLS}   # enabled only after a fingerprint match\n    48\t_rate: dict[tuple[str, str], deque] = defaultdict(deque)\n    49\t_pool: asyncpg.Pool\n    50\t_upstream: httpx.AsyncClient\n    51\t\n    52\t\n    53\tdef fingerprint(tool: dict[str, Any]) -> str:\n    54\t    material = {k: tool.get(k) for k in (\"name\", \"title\", \"description\", \"inputSchema\", \"outputSchema\", \"annotations\")}\n    55\t    return \"sha256:\" + hashlib.sha256(json.dumps(material, sort_keys=True, separators=(\",\", \":\")).encode()).hexdigest()\n    56\t\n    57\t\n    58\tasync def refresh_fingerprints() -> None:\n    59\t    \"\"\"Enable a tool only while its live description and schemas match the reviewed fingerprint.\"\"\"\n    60\t    seen: dict[str, str] = {}\n    61\t    for server_id, server in registry.servers.items():\n    62\t        resp = await _upstream.post(server[\"endpoint\"], json={\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/list\"}, timeout=5.0)\n    63\t        live = {t[\"name\"]: t for t in resp.json()[\"result\"][\"tools\"]}\n    64\t        for name in live:\n    65\t            norm = unicodedata.normalize(\"NFKC\", name).casefold().replace(\"-\", \"\").replace(\"_\", \"\")\n    66\t            if seen.setdefault(norm, server_id) != server_id:\n    67\t                log.error(\"lookalike tool name across servers\", extra={\"tool\": name})\n    68\t        for spec in (s for s in MCP_TOOLS if s.server == server_id):\n    69\t            local = spec.qualified.split(\"/\", 1)[1]\n    70\t            if local in live and fingerprint(live[local]) == spec.fingerprint:\n    71\t                _disabled.discard(spec.qualified)\n    72\t            else:\n    73\t                _disabled.add(spec.qualified)\n    74\t                log.error(\"tool fingerprint mismatch; disabled\", extra={\"tool\": spec.qualified})\n    75\t\n    76\t\n    77\tdef _verify(request: Request) -> dict[str, Any]:\n    78\t    auth = request.headers.get(\"authorization\", \"\")\n    79\t    if not auth.startswith(\"Bearer \"):\n    80\t        raise PermissionError(\"missing bearer token\")\n    81\t    token = auth[7:]\n    82\t    claims = jwt.decode(\n    83\t        token, JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"ES256\"], audience=AUDIENCE, issuer=ISSUER,\n    84\t        options={\"require\": [\"exp\", \"iat\", \"sub\", \"scope\", \"act\", \"cnf\"]}, leeway=5,\n    85\t    )\n    86\t    # The mesh sets X-Forwarded-Client-Cert from the verified peer certificate and strips client copies.\n    87\t    xfcc = request.headers.get(\"x-forwarded-client-cert\", \"\")\n    88\t    cert_hash = next((p.split(\"=\", 1)[1] for p in xfcc.split(\";\") if p.startswith(\"Hash=\")), None)\n    89\t    if cert_hash is None or claims[\"cnf\"].get(\"x5t#S256\") != cert_hash:\n    90\t        raise PermissionError(\"token not bound to caller certificate\")\n    91\t    if claims[\"act\"].get(\"sub\") not in ACTORS:\n    92\t        raise PermissionError(\"actor not allowed\")\n    93\t    claims[\"_raw\"] = token\n    94\t    return claims\n    95\t\n    96\t\n    97\tasync def _stop_reason(claims: dict[str, Any], instance: str) -> str | None:\n    98\t    return await _pool.fetchval(\n    99\t        \"\"\"SELECT reason FROM control.stop_flags WHERE active AND (scope = 'fleet'\n   100\t             OR (scope = 'agent_instance' AND value = $1) OR (scope = 'subject' AND value = $2)\n   101\t             OR (scope = 'agent_principal' AND value = $3)) LIMIT 1\"\"\",\n   102\t        instance, claims[\"sub\"], claims[\"act\"][\"sub\"], timeout=1.0,\n   103\t    )\n   104\t\n   105\t\n   106\tdef _rate_ok(kind: str, key: str) -> bool:\n   107\t    q, now = _rate[(kind, key)], time.monotonic()\n   108\t    while q and now - q[0] > 60:\n   109\t        q.popleft()\n   110\t    if len(q) >= RATE_PER_MINUTE[kind]:\n   111\t        return False\n   112\t    q.append(now)\n   113\t    return True\n   114\t\n   115\t\n   116\tasync def _downstream_token(spec: ToolSpec, claims: dict[str, Any]) -> str:\n   117\t    with open(\"/var/run/secrets/tokens/sts-token\", encoding=\"utf-8\") as fh:\n   118\t        actor = fh.read().strip()\n   119\t    resp = await _upstream.post(f\"{STS_BASE}/oauth2/token\", timeout=3.0, data={\n   120\t        \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n   121\t        \"subject_token\": claims[\"_raw\"], \"subject_token_type\": \"urn:ietf:params:oauth:token-type:access_token\",\n   122\t        \"actor_token\": actor, \"actor_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n   123\t        \"audience\": registry.servers[spec.server][\"downstream_audience\"], \"scope\": spec.scope,\n   124\t    })\n   125\t    resp.raise_for_status()\n   126\t    return resp.json()[\"access_token\"]\n   127\t\n   128\t\n   129\tasync def _log(request: Request, claims: dict[str, Any] | None, tool: str | None, decision: str, reason: str) -> None:\n   130\t    c = claims or {}\n   131\t    actor = (c.get(\"act\") or {}).get(\"sub\")\n   132\t    owner = ACTORS.get(actor, {\"tenant\": \"unknown\", \"accountable_party\": \"unknown\", \"operational_owner\": \"unknown\"})\n   133\t    await _pool.execute(\n   134\t        \"\"\"INSERT INTO audit.gateway_decisions (ts, traceparent, tenant, accountable_party, operational_owner,\n   135\t               agent_type_id_hint, agent_instance_hint, subject, actor, tool, decision, reason, policy_version)\n3:     3\tCREATE SCHEMA audit; CREATE SCHEMA control; CREATE SCHEMA approvals; CREATE SCHEMA quota; CREATE SCHEMA retrieval;\n11:    11\t    delegated_subject text NOT NULL, agent_principal text NOT NULL,\n47:    47\tCREATE TABLE control.stop_flags (\n49:    49\t    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n80:    80\tGRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\n81:    81\tGRANT INSERT ON audit.events TO hr_agent;\n82:    82\tGRANT SELECT ON control.stop_flags TO hr_agent;\n83:    83\tGRANT SELECT, INSERT ON approvals.grants TO hr_agent;\n84:    84\tGRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\n85:    85\tGRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\n86:    86\tGRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n88:    88\tGRANT USAGE ON SCHEMA audit, control TO hr_gateway;\n89:    89\tGRANT INSERT ON audit.gateway_decisions TO hr_gateway;\n90:    90\tGRANT SELECT ON control.stop_flags TO hr_gateway;\n92:    92\tGRANT USAGE ON SCHEMA control TO hr_agent_operator;\n93:    93\tGRANT SELECT, INSERT, UPDATE ON control.stop_flags TO hr_agent_operator;\n94:    94\tGRANT USAGE ON SEQUENCE control.stop_flags_flag_id_seq TO hr_agent_operator;\n96:    96\tGRANT USAGE ON SCHEMA audit TO hr_audit_reader, hr_audit_maint;\n97:    97\tGRANT SELECT ON ALL TABLES IN SCHEMA audit TO hr_audit_reader;\n99:    99\tGRANT EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) TO hr_audit_maint;\n101:   101\tGRANT USAGE ON SCHEMA retrieval TO hr_docs_ingest;\n102:   102\tGRANT SELECT, INSERT, UPDATE ON retrieval.chunks, retrieval.index_state TO hr_docs_ingest;\n    15\tlog = logging.getLogger(\"hr_agent.stop\")\n    16\t\n    17\t_QUERY = \"\"\"\n    18\tSELECT reason FROM control.stop_flags\n    19\tWHERE active\n    20\t  AND (   scope = 'fleet'\n    21\t       OR (scope = 'agent_type'     AND value = $1)\n    22\t       OR (scope = 'agent_instance' AND value = $2)\n    23\t       OR (scope = 'subject'        AND value = $3)\n    24\t       OR (scope = 'agent_principal' AND value = $4))\n    25\tLIMIT 1\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass Stopped(Exception):\n    30\t    pass\n    31\t\n    32\t\n    33\tclass StopControl:\n    34\t    def __init__(self, pool: asyncpg.Pool, poll_seconds: float):\n    35\t        self._pool = pool\n    36\t        self._poll = poll_seconds\n    37\t\n    38\t    async def reason(self, ctx: RunContext) -> str | None:\n    39\t        try:\n    40\t            row = await self._pool.fetchrow(\n    41\t                _QUERY, ctx.agent_type_id, ctx.agent_instance_id, ctx.subject, ctx.agent_principal, timeout=1.0\n    42\t            )\n    43\t        except Exception:\n    44\t            return \"stop store unreachable\"\n    45\t        return row[\"reason\"] if row else None\n    46\t\n    47\t    async def raise_if_stopped(self, ctx: RunContext) -> None:\n    48\t        why = await self.reason(ctx)\n    49\t        if why:\n    50\t            raise Stopped(why)\nEscalations are delivered even during gateway maintenance windows.\n\n## Stopping the agent\n\nOperators with the `hr_agent_operator` DB role insert into `control.stop_flags`:\n\n```sql\nINSERT INTO control.stop_flags (scope, value, reason) VALUES ('fleet', NULL, 'incident 2291');\n-- or scope 'agent_type' / 'agent_instance' / 'subject' / 'agent_principal'\n```\n\nRunning agents see the flag within 2 seconds and cancel in-flight work; the gateway refuses\ncalls immediately. Target stop time: 10 seconds. The agent's DB role can only read this table.\nLast drill: see `docs/drills/` in the ops repo.\n\n## Audit retention\n\nAudit records are kept for six months (Acme records policy; employment-related AI use in the EU).\nPartitions are created and dropped nightly by `k8s/audit-maintenance.yaml`. Access is limited to\n`hr_audit_reader`.\n\n## Releases\n\nMerges to `main` build, sign and attest the image, compute the agent-type-id over every file in\n`src/`, `prompts/`, `config/`, plus `requirements.txt`, `Dockerfile`, the image digest and the model\nrecord, and stamp `release/manifest.yaml`. Pods refuse to start if the type id they compute\ndiffers from the one they were deployed with. Kyverno admits only signed images built by this\nworkflow from `main`.\napiVersion: networking.k8s.io/v1\nkind: NetworkPolicy\nmetadata:\n  name: default-deny-all\n  namespace: hr-agent\nspec:\n  podSelector: {}\n  policyTypes: [Ingress, Egress]\n---\napiVersion: cilium.io/v2\nkind: CiliumNetworkPolicy\nmetadata:\n  name: hr-helpdesk-agent-egress\n  namespace: hr-agent\nspec:\n  endpointSelector:\n    matchLabels: {app: hr-helpdesk-agent}\n  ingress:\n    - fromEndpoints:\n        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": web-frontends, app: hr-portal-bff}\n      toPorts: [{ports: [{port: \"8080\", protocol: TCP}]}]\n  egress:\n    - toEndpoints:\n        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": kube-system, k8s-app: kube-dns}\n      toPorts:\n        - ports: [{port: \"53\", protocol: UDP}]\n          rules:\n            dns:\n              - matchName: api.anthropic.com\n              - matchName: sso.acme.example\n              - matchPattern: \"*.svc.cluster.local\"\n    - toFQDNs:\n        - matchName: api.anthropic.com\n        - matchName: sso.acme.example\n      toPorts: [{ports: [{port: \"443\", protocol: TCP}]}]\n    - toEndpoints:\n        - matchLabels: {app: hr-tool-gateway}\n      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n    - toEndpoints:\n        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": identity, app: sts}\n      toPorts: [{ports: [{port: \"443\", protocol: TCP}]}]\n    - toEndpoints:\n        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": data, app: hr-postgres}\n      toPorts: [{ports: [{port: \"5432\", protocol: TCP}]}]\n    - toEndpoints:\n        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": observability, app: otel-collector}\n      toPorts: [{ports: [{port: \"4317\", protocol: TCP}]}]\n    - toEndpoints:\n        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": helpdesk, app: helpdesk-mcp}\n      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n  egressDeny:\n    - toCIDR: [169.254.169.254/32, 169.254.170.2/32, 100.100.100.200/32]\n    - toCIDRSet:\n        - cidr: fd00:ec2::254/128\n---\napiVersion: cilium.io/v2\nkind: CiliumNetworkPolicy\nmetadata:\n  name: hr-tool-gateway-egress\n  namespace: hr-agent","is_error":false}]},"parent_tool_use_id":null,"session_id":"a3319f45-445c-413d-9771-d5bdb944cf4e","uuid":"536d7d5a-ed67-4a0c-be38-f7160b7a491a","timestamp":"2026-11-21T12:20:35.593Z","tool_use_result":{"stdout":"    30\tlog = logging.getLogger(\"hr_gateway\")\n    31\t\n    32\tISSUER = \"https://sts.acme.example\"\n    33\tAUDIENCE = \"hr-tool-gateway\"\n    34\tSTS_BASE = \"https://sts.identity.svc.cluster.local\"\n    35\tJWKS = jwt.PyJWKClient(f\"{STS_BASE}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    36\t# Owner and tenant for each allowed actor come from this table, not from the request.\n    37\tACTORS = {\n    38\t    \"spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\": {\n    39\t        \"tenant\": \"acme\", \"accountable_party\": \"VP People Operations <people-ops-lead@acme.example>\",\n    40\t        \"operational_owner\": \"people-platform (pager: people-platform-oncall)\",\n    41\t    },\n    42\t}\n    43\tRATE_PER_MINUTE = {\"instance\": 20, \"subject\": 30}\n    44\t\n    45\tregistry = ToolRegistry.from_config()\n    46\tMCP_TOOLS = [s for s in map(registry.get, [t[\"name\"] for t in registry.model_schemas()]) if s.kind == \"mcp\"]\n    47\t_disabled: set[str] = {s.qualified for s in MCP_TOOLS}   # enabled only after a fingerprint match\n    48\t_rate: dict[tuple[str, str], deque] = defaultdict(deque)\n    49\t_pool: asyncpg.Pool\n    50\t_upstream: httpx.AsyncClient\n    51\t\n    52\t\n    53\tdef fingerprint(tool: dict[str, Any]) -> str:\n    54\t    material = {k: tool.get(k) for k in (\"name\", \"title\", \"description\", \"inputSchema\", \"outputSchema\", \"annotations\")}\n    55\t    return \"sha256:\" + hashlib.sha256(json.dumps(material, sort_keys=True, separators=(\",\", \":\")).encode()).hexdigest()\n    56\t\n    57\t\n    58\tasync def refresh_fingerprints() -> None:\n    59\t    \"\"\"Enable a tool only while its live description and schemas match the reviewed fingerprint.\"\"\"\n    60\t    seen: dict[str, str] = {}\n    61\t    for server_id, server in registry.servers.items():\n    62\t        resp = await _upstream.post(server[\"endpoint\"], json={\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/list\"}, timeout=5.0)\n    63\t        live = {t[\"name\"]: t for t in resp.json()[\"result\"][\"tools\"]}\n    64\t        for name in live:\n    65\t            norm = unicodedata.normalize(\"NFKC\", name).casefold().replace(\"-\", \"\").replace(\"_\", \"\")\n    66\t            if seen.setdefault(norm, server_id) != server_id:\n    67\t                log.error(\"lookalike tool name across servers\", extra={\"tool\": name})\n    68\t        for spec in (s for s in MCP_TOOLS if s.server == server_id):\n    69\t            local = spec.qualified.split(\"/\", 1)[1]\n    70\t            if local in live and fingerprint(live[local]) == spec.fingerprint:\n    71\t                _disabled.discard(spec.qualified)\n    72\t            else:\n    73\t                _disabled.add(spec.qualified)\n    74\t                log.error(\"tool fingerprint mismatch; disabled\", extra={\"tool\": spec.qualified})\n    75\t\n    76\t\n    77\tdef _verify(request: Request) -> dict[str, Any]:\n    78\t    auth = request.headers.get(\"authorization\", \"\")\n    79\t    if not auth.startswith(\"Bearer \"):\n    80\t        raise PermissionError(\"missing bearer token\")\n    81\t    token = auth[7:]\n    82\t    claims = jwt.decode(\n    83\t        token, JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"ES256\"], audience=AUDIENCE, issuer=ISSUER,\n    84\t        options={\"require\": [\"exp\", \"iat\", \"sub\", \"scope\", \"act\", \"cnf\"]}, leeway=5,\n    85\t    )\n    86\t    # The mesh sets X-Forwarded-Client-Cert from the verified peer certificate and strips client copies.\n    87\t    xfcc = request.headers.get(\"x-forwarded-client-cert\", \"\")\n    88\t    cert_hash = next((p.split(\"=\", 1)[1] for p in xfcc.split(\";\") if p.startswith(\"Hash=\")), None)\n    89\t    if cert_hash is None or claims[\"cnf\"].get(\"x5t#S256\") != cert_hash:\n    90\t        raise PermissionError(\"token not bound to caller certificate\")\n    91\t    if claims[\"act\"].get(\"sub\") not in ACTORS:\n    92\t        raise PermissionError(\"actor not allowed\")\n    93\t    claims[\"_raw\"] = token\n    94\t    return claims\n    95\t\n    96\t\n    97\tasync def _stop_reason(claims: dict[str, Any], instance: str) -> str | None:\n    98\t    return await _pool.fetchval(\n    99\t        \"\"\"SELECT reason FROM control.stop_flags WHERE active AND (scope = 'fleet'\n   100\t             OR (scope = 'agent_instance' AND value = $1) OR (scope = 'subject' AND value = $2)\n   101\t             OR (scope = 'agent_principal' AND value = $3)) LIMIT 1\"\"\",\n   102\t        instance, claims[\"sub\"], claims[\"act\"][\"sub\"], timeout=1.0,\n   103\t    )\n   104\t\n   105\t\n   106\tdef _rate_ok(kind: str, key: str) -> bool:\n   107\t    q, now = _rate[(kind, key)], time.monotonic()\n   108\t    while q and now - q[0] > 60:\n   109\t        q.popleft()\n   110\t    if len(q) >= RATE_PER_MINUTE[kind]:\n   111\t        return False\n   112\t    q.append(now)\n   113\t    return True\n   114\t\n   115\t\n   116\tasync def _downstream_token(spec: ToolSpec, claims: dict[str, Any]) -> str:\n   117\t    with open(\"/var/run/secrets/tokens/sts-token\", encoding=\"utf-8\") as fh:\n   118\t        actor = fh.read().strip()\n   119\t    resp = await _upstream.post(f\"{STS_BASE}/oauth2/token\", timeout=3.0, data={\n   120\t        \"grant_type\": \"urn:ietf:params:oauth:grant-type:token-exchange\",\n   121\t        \"subject_token\": claims[\"_raw\"], \"subject_token_type\": \"urn:ietf:params:oauth:token-type:access_token\",\n   122\t        \"actor_token\": actor, \"actor_token_type\": \"urn:ietf:params:oauth:token-type:jwt\",\n   123\t        \"audience\": registry.servers[spec.server][\"downstream_audience\"], \"scope\": spec.scope,\n   124\t    })\n   125\t    resp.raise_for_status()\n   126\t    return resp.json()[\"access_token\"]\n   127\t\n   128\t\n   129\tasync def _log(request: Request, claims: dict[str, Any] | None, tool: str | None, decision: str, reason: str) -> None:\n   130\t    c = claims or {}\n   131\t    actor = (c.get(\"act\") or {}).get(\"sub\")\n   132\t    owner = ACTORS.get(actor, {\"tenant\": \"unknown\", \"accountable_party\": \"unknown\", \"operational_owner\": \"unknown\"})\n   133\t    await _pool.execute(\n   134\t        \"\"\"INSERT INTO audit.gateway_decisions (ts, traceparent, tenant, accountable_party, operational_owner,\n   135\t               agent_type_id_hint, agent_instance_hint, subject, actor, tool, decision, reason, policy_version)\n3:     3\tCREATE SCHEMA audit; CREATE SCHEMA control; CREATE SCHEMA approvals; CREATE SCHEMA quota; CREATE SCHEMA retrieval;\n11:    11\t    delegated_subject text NOT NULL, agent_principal text NOT NULL,\n47:    47\tCREATE TABLE control.stop_flags (\n49:    49\t    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n80:    80\tGRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\n81:    81\tGRANT INSERT ON audit.events TO hr_agent;\n82:    82\tGRANT SELECT ON control.stop_flags TO hr_agent;\n83:    83\tGRANT SELECT, INSERT ON approvals.grants TO hr_agent;\n84:    84\tGRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\n85:    85\tGRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\n86:    86\tGRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n88:    88\tGRANT USAGE ON SCHEMA audit, control TO hr_gateway;\n89:    89\tGRANT INSERT ON audit.gateway_decisions TO hr_gateway;\n90:    90\tGRANT SELECT ON control.stop_flags TO hr_gateway;\n92:    92\tGRANT USAGE ON SCHEMA control TO hr_agent_operator;\n93:    93\tGRANT SELECT, INSERT, UPDATE ON control.stop_flags TO hr_agent_operator;\n94:    94\tGRANT USAGE ON SEQUENCE control.stop_flags_flag_id_seq TO hr_agent_operator;\n96:    96\tGRANT USAGE ON SCHEMA audit TO hr_audit_reader, hr_audit_maint;\n97:    97\tGRANT SELECT ON ALL TABLES IN SCHEMA audit TO hr_audit_reader;\n99:    99\tGRANT EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) TO hr_audit_maint;\n101:   101\tGRANT USAGE ON SCHEMA retrieval TO hr_docs_ingest;\n102:   102\tGRANT SELECT, INSERT, UPDATE ON retrieval.chunks, retrieval.index_state TO hr_docs_ingest;\n    15\tlog = logging.getLogger(\"hr_agent.stop\")\n    16\t\n    17\t_QUERY = \"\"\"\n    18\tSELECT reason FROM control.stop_flags\n    19\tWHERE active\n    20\t  AND (   scope = 'fleet'\n    21\t       OR (scope = 'agent_type'     AND value = $1)\n    22\t       OR (scope = 'agent_instance' AND value = $2)\n    23\t       OR (scope = 'subject'        AND value = $3)\n    24\t       OR (scope = 'agent_principal' AND value = $4))\n    25\tLIMIT 1\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass Stopped(Exception):\n    30\t    pass\n    31\t\n    32\t\n    33\tclass StopControl:\n    34\t    def __init__(self, pool: asyncpg.Pool, poll_seconds: float):\n    35\t        self._pool = pool\n    36\t        self._poll = poll_seconds\n    37\t\n    38\t    async def reason(self, ctx: RunContext) -> str | None:\n    39\t        try:\n    40\t            row = await self._pool.fetchrow(\n    41\t                _QUERY, ctx.agent_type_id, ctx.agent_instance_id, ctx.subject, ctx.agent_principal, timeout=1.0\n    42\t            )\n    43\t        except Exception:\n    44\t            return \"stop store unreachable\"\n    45\t        return row[\"reason\"] if row else None\n    46\t\n    47\t    async def raise_if_stopped(self, ctx: RunContext) -> None:\n    48\t        why = await self.reason(ctx)\n    49\t        if why:\n    50\t            raise Stopped(why)\nEscalations are delivered even during gateway maintenance windows.\n\n## Stopping the agent\n\nOperators with the `hr_agent_operator` DB role insert into `control.stop_flags`:\n\n```sql\nINSERT INTO control.stop_flags (scope, value, reason) VALUES ('fleet', NULL, 'incident 2291');\n-- or scope 'agent_type' / 'agent_instance' / 'subject' / 'agent_principal'\n```\n\nRunning agents see the flag within 2 seconds and cancel in-flight work; the gateway refuses\ncalls immediately. Target stop time: 10 seconds. The agent's DB role can only read this table.\nLast drill: see `docs/drills/` in the ops repo.\n\n## Audit retention\n\nAudit records are kept for six months (Acme records policy; employment-related AI use in the EU).\nPartitions are created and dropped nightly by `k8s/audit-maintenance.yaml`. Access is limited to\n`hr_audit_reader`.\n\n## Releases\n\nMerges to `main` build, sign and attest the image, compute the agent-type-id over every file in\n`src/`, `prompts/`, `config/`, plus `requirements.txt`, `Dockerfile`, the image digest and the model\nrecord, and stamp `release/manifest.yaml`. Pods refuse to start if the type id they compute\ndiffers from the one they were deployed with. Kyverno admits only signed images built by this\nworkflow from `main`.\napiVersion: networking.k8s.io/v1\nkind: NetworkPolicy\nmetadata:\n  name: default-deny-all\n  namespace: hr-agent\nspec:\n  podSelector: {}\n  policyTypes: [Ingress, Egress]\n---\napiVersion: cilium.io/v2\nkind: CiliumNetworkPolicy\nmetadata:\n  name: hr-helpdesk-agent-egress\n  namespace: hr-agent\nspec:\n  endpointSelector:\n    matchLabels: {app: hr-helpdesk-agent}\n  ingress:\n    - fromEndpoints:\n        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": web-frontends, app: hr-portal-bff}\n      toPorts: [{ports: [{port: \"8080\", protocol: TCP}]}]\n  egress:\n    - toEndpoints:\n        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": kube-system, k8s-app: kube-dns}\n      toPorts:\n        - ports: [{port: \"53\", protocol: UDP}]\n          rules:\n            dns:\n              - matchName: api.anthropic.com\n              - matchName: sso.acme.example\n              - matchPattern: \"*.svc.cluster.local\"\n    - toFQDNs:\n        - matchName: api.anthropic.com\n        - matchName: sso.acme.example\n      toPorts: [{ports: [{port: \"443\", protocol: TCP}]}]\n    - toEndpoints:\n        - matchLabels: {app: hr-tool-gateway}\n      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n    - toEndpoints:\n        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": identity, app: sts}\n      toPorts: [{ports: [{port: \"443\", protocol: TCP}]}]\n    - toEndpoints:\n        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": data, app: hr-postgres}\n      toPorts: [{ports: [{port: \"5432\", protocol: TCP}]}]\n    - toEndpoints:\n        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": observability, app: otel-collector}\n      toPorts: [{ports: [{port: \"4317\", protocol: TCP}]}]\n    - toEndpoints:\n        - matchLabels: {\"k8s:io.kubernetes.pod.namespace\": helpdesk, app: helpdesk-mcp}\n      toPorts: [{ports: [{port: \"8443\", protocol: TCP}]}]\n  egressDeny:\n    - toCIDR: [169.254.169.254/32, 169.254.170.2/32, 100.100.100.200/32]\n    - toCIDRSet:\n        - cidr: fd00:ec2::254/128\n---\napiVersion: cilium.io/v2\nkind: CiliumNetworkPolicy\nmetadata:\n  name: hr-tool-gateway-egress\n  namespace: hr-agent","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01LhME9Hw3KYxaTMbkNn7oNz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
