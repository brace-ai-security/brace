{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015RRvcvv2rng1ibcogodME4","type":"tool_result","content":"     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport logging\n     6\timport os\n     7\timport uuid\n     8\t\n     9\timport asyncpg\n    10\timport httpx\n    11\timport jwt\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n    15\tfrom opentelemetry.sdk.resources import Resource\n    16\tfrom opentelemetry.sdk.trace import TracerProvider\n    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n    18\tfrom starlette.applications import Starlette\n    19\tfrom starlette.requests import Request\n    20\tfrom starlette.responses import JSONResponse\n    21\tfrom starlette.routing import Route\n    22\t\n    23\tfrom . import type_id\n    24\tfrom .agent import Agent, RunState\n    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n    27\tfrom .budgets import BudgetExceeded, QuotaStore\n    28\tfrom .credentials import CredentialBroker\n    29\tfrom .gateway_client import GatewayClient\n    30\tfrom .killswitch import Stopped, StopControl\n    31\tfrom .redact import RedactingFilter\n    32\tfrom .retrieval import PolicyIndex\n    33\tfrom .tools import ToolRegistry, load_yaml\n    34\tfrom .validation import sanitize_reply\n    35\t\n    36\tSSO_ISSUER = \"https://sso.acme.example\"\n    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    39\t\n    40\tlogging.basicConfig(level=logging.INFO)\n    41\tfor h in logging.getLogger().handlers:\n    42\t    h.addFilter(RedactingFilter())\n    43\tlog = logging.getLogger(\"hr_agent\")\n    44\t\n    45\tCFG = load_yaml(\"agent.yaml\")\n    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n    47\tPOD_ID = os.environ[\"POD_UID\"]\n    48\t\n    49\tprovider = TracerProvider(resource=Resource.create({\n    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n    51\t}))\n    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n    53\ttrace.set_tracer_provider(provider)\n    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n    55\t\n    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n    57\tagent: Agent\n    58\taudit: AuditWriter\n    59\tapprovals: ApprovalStore\n    60\tstop: StopControl\n    61\t\n    62\t\n    63\tdef _employee(request: Request) -> tuple[str, str]:\n    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n    65\t    auth = request.headers.get(\"authorization\", \"\")\n    66\t    if not auth.startswith(\"Bearer \"):\n    67\t        raise PermissionError(\"missing token\")\n    68\t    token = auth[7:]\n    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n    72\t        raise PermissionError(\"wrong organisation\")\n    73\t    return claims[\"employee_id\"], token\n    74\t\n    75\t\n    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n    77\t    a = CFG[\"agent\"]\n    78\t    return RunContext(\n    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n    81\t        agent_principal=a[\"workload_identity\"],\n    82\t    )\n    83\t\n    84\t\n    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n    86\t    task = asyncio.ensure_future(coro)\n    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n    88\t    try:\n    89\t        return await task\n    90\t    except asyncio.CancelledError:\n    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n    92\t        return None\n    93\t    except Stopped as exc:\n    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n    95\t        return None\n    96\t    finally:\n    97\t        watcher.cancel()\n    98\t\n    99\t\n   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n   101\t    if state is None:\n   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n   105\t    if state.pending_approval:\n   106\t        body[\"approval\"] = state.pending_approval\n   107\t    return JSONResponse(body)\n   108\t\n   109\t\n   110\tasync def chat(request: Request) -> JSONResponse:\n   111\t    try:\n   112\t        employee_id, token = _employee(request)\n   113\t    except (jwt.PyJWTError, PermissionError):\n   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n   116\t    run_id = str(uuid.uuid4())\n   117\t    ctx = _context(run_id, employee_id)\n   118\t    with tracer.start_as_current_span(\"chat\"):\n   119\t        try:\n   120\t            await agent.quotas.reserve_run(ctx)\n   121\t            state = agent.new_state(text, token)\n   122\t            _runs[run_id] = (ctx, state)\n   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n   124\t            state = await _drive(ctx, agent.run(ctx, state))\n   125\t        except BudgetExceeded as exc:\n     1\t# hr-helpdesk-agent\n     2\t\n     3\tAn HR helpdesk assistant for Acme employees. It answers policy questions from the HR handbook,\n     4\tshows the signed-in employee their own leave balance, files leave requests (the manager approves\n     5\tthem in HRIS), and hands conversations to an HR advisor.\n     6\t\n     7\t## Components\n     8\t\n     9\t| Component | Code | Identity |\n    10\t|---|---|---|\n    11\t| Agent API and loop | `src/main.py`, `src/agent.py` | SA `hr-helpdesk-agent`, SPIFFE SVID |\n    12\t| Tool gateway | `src/gateway.py` | SA `hr-tool-gateway` |\n    13\t| HRIS MCP server | owned by hris-platform | `spiffe://acme.example/ns/hris/sa/hris-mcp` |\n    14\t| Helpdesk MCP server | owned by it-service-desk | `spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp` |\n    15\t| Audit, approvals, quotas, stop flags, handbook index | Postgres (`migrations/001_init.sql`) | per-component DB roles |\n    16\t\n    17\t## How a request flows\n    18\t\n    19\t1. The HR portal sends the employee's SSO token. `main.py` verifies issuer, audience, expiry and\n    20\t   organisation; the employee id and tenant come only from that token.\n    21\t2. The loop (`agent.py`) checks the stop flags and the run budget before every model call, and\n    22\t   records usage against per-user, tenant and fleet quotas.\n    23\t3. Tool calls are looked up by exact name in `config/tools.yaml`. Arguments are schema-checked.\n    24\t   `file_leave_request` and `escalate_to_human` pause the run and show the employee exactly what\n    25\t   will be sent; the approval is bound to the run instance, operation, target and argument hash,\n    26\t   expires after 10 minutes, and is consumed once.\n    27\t4. MCP calls go to the gateway with a 300-second token for that one tool scope, minted by STS\n    28\t   from the agent's workload identity and the employee's token. The gateway verifies the token\n    29\t   and its certificate binding, checks scope, stop flags, rate limits and argument schema, swaps\n    30\t   the token for one addressed to the MCP server, and validates the response schema.\n    31\t5. Tool output is size-, schema- and content-checked and redacted before the model sees it.\n    32\t   Handbook passages are filtered at query time to documents the employee may see.\n    33\t6. Every step writes an `audit.events` row with the six identity fields and trace context.\n    34\t   If the audit write fails, the run stops.\n    35\t\n    36\tEscalations are delivered even during gateway maintenance windows.\n    37\t\n    38\t## Stopping the agent\n    39\t\n    40\tOperators with the `hr_agent_operator` DB role insert into `control.stop_flags`:\n    41\t\n    42\t```sql\n    43\tINSERT INTO control.stop_flags (scope, value, reason) VALUES ('fleet', NULL, 'incident 2291');\n    44\t-- or scope 'agent_type' / 'agent_instance' / 'subject' / 'agent_principal'\n    45\t```\n    46\t\n    47\tRunning agents see the flag within 2 seconds and cancel in-flight work; the gateway refuses\n    48\tcalls immediately. Target stop time: 10 seconds. The agent's DB role can only read this table.\n    49\tLast drill: see `docs/drills/` in the ops repo.\n    50\t\n    51\t## Audit retention\n    52\t\n    53\tAudit records are kept for six months (Acme records policy; employment-related AI use in the EU).\n    54\tPartitions are created and dropped nightly by `k8s/audit-maintenance.yaml`. Access is limited to\n    55\t`hr_audit_reader`.\n    56\t\n    57\t## Releases\n    58\t\n    59\tMerges to `main` build, sign and attest the image, compute the agent-type-id over every file in\n    60\t`src/`, `prompts/`, `config/`, plus `requirements.txt`, `Dockerfile`, the image digest and the model\n    61\trecord, and stamp `release/manifest.yaml`. Pods refuse to start if the type id they compute\n    62\tdiffers from the one they were deployed with. Kyverno admits only signed images built by this\n    63\tworkflow from `main`.\n9:    agent_type_id text NOT NULL, agent_instance_id text NOT NULL,\n23:    agent_type_id_hint text NOT NULL, agent_instance_hint text NOT NULL,   -- caller-supplied; join key only\n47:CREATE TABLE control.stop_flags (\n49:    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n54:CREATE TABLE approvals.grants (\n80:GRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\n81:GRANT INSERT ON audit.events TO hr_agent;\n82:GRANT SELECT ON control.stop_flags TO hr_agent;\n83:GRANT SELECT, INSERT ON approvals.grants TO hr_agent;\n84:GRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\n85:GRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\n86:GRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n88:GRANT USAGE ON SCHEMA audit, control TO hr_gateway;\n89:GRANT INSERT ON audit.gateway_decisions TO hr_gateway;\n90:GRANT SELECT ON control.stop_flags TO hr_gateway;\n92:GRANT USAGE ON SCHEMA control TO hr_agent_operator;\n93:GRANT SELECT, INSERT, UPDATE ON control.stop_flags TO hr_agent_operator;\n94:GRANT USAGE ON SEQUENCE control.stop_flags_flag_id_seq TO hr_agent_operator;\n96:GRANT USAGE ON SCHEMA audit TO hr_audit_reader, hr_audit_maint;\n97:GRANT SELECT ON ALL TABLES IN SCHEMA audit TO hr_audit_reader;\n99:GRANT EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) TO hr_audit_maint;\n101:GRANT USAGE ON SCHEMA retrieval TO hr_docs_ingest;\n102:GRANT SELECT, INSERT, UPDATE ON retrieval.chunks, retrieval.index_state TO hr_docs_ingest;\nsrc/agent.py:40:    subagents_started: int = 0\nsrc/budgets.py:66:    def check_subagent(self, started_so_far: int) -> None:\nsrc/budgets.py:67:        if started_so_far >= self.cfg[\"max_subagents\"]:\nsrc/budgets.py:68:            raise BudgetExceeded(\"max_subagents\")\nconfig/agent.yaml:23:    max_subagents: 0\n     1\tapiVersion: v1\n     2\tkind: ServiceAccount\n     3\tmetadata:\n     4\t  name: hr-helpdesk-agent\n     5\t  namespace: hr-agent\n     6\tautomountServiceAccountToken: false\n     7\t---\n     8\tapiVersion: v1\n     9\tkind: ServiceAccount\n    10\tmetadata:\n    11\t  name: hr-tool-gateway\n    12\t  namespace: hr-agent\n    13\tautomountServiceAccountToken: false\n    14\t---\n    15\tapiVersion: apps/v1\n    16\tkind: Deployment\n    17\tmetadata:\n    18\t  name: hr-helpdesk-agent\n    19\t  namespace: hr-agent\n    20\t  labels: {app: hr-helpdesk-agent, app.kubernetes.io/part-of: hr-helpdesk}\n    21\tspec:\n    22\t  replicas: 3\n    23\t  selector:\n    24\t    matchLabels: {app: hr-helpdesk-agent}\n    25\t  template:\n    26\t    metadata:\n    27\t      labels: {app: hr-helpdesk-agent}\n    28\t      annotations:\n    29\t        acme.example/release-manifest: \"release/manifest.yaml@${GIT_SHA}\"\n    30\t    spec:\n    31\t      serviceAccountName: hr-helpdesk-agent\n    32\t      automountServiceAccountToken: false\n    33\t      hostUsers: false\n    34\t      enableServiceLinks: false\n    35\t      securityContext:\n    36\t        runAsNonRoot: true\n    37\t        runAsUser: 65532\n    38\t        runAsGroup: 65532\n    39\t        fsGroup: 65532\n    40\t        seccompProfile: {type: RuntimeDefault}\n    41\t      containers:\n    42\t        - name: agent\n    43\t          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n    44\t          args: [\"-m\", \"uvicorn\", \"src.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\"]\n    45\t          ports: [{containerPort: 8080}]\n    46\t          env:\n    47\t            - {name: AGENT_TYPE_ID, value: \"${AGENT_TYPE_ID}\"}\n    48\t            - {name: IMAGE_DIGEST, value: \"${IMAGE_DIGEST}\"}\n    49\t            - name: POD_UID\n    50\t              valueFrom: {fieldRef: {fieldPath: metadata.uid}}\n    51\t            - name: DATABASE_URL\n    52\t              valueFrom: {secretKeyRef: {name: hr-agent-db, key: url}}\n    53\t            - name: ANTHROPIC_API_KEY\n    54\t              valueFrom: {secretKeyRef: {name: hr-agent-anthropic, key: api_key}}\n    55\t            - {name: ANTHROPIC_BASE_URL, value: \"https://api.anthropic.com\"}\n    56\t          securityContext:\n    57\t            allowPrivilegeEscalation: false\n    58\t            readOnlyRootFilesystem: true\n    59\t            privileged: false\n    60\t            capabilities: {drop: [ALL]}\n    61\t          resources:\n    62\t            requests: {cpu: 250m, memory: 384Mi}\n    63\t            limits: {cpu: \"1\", memory: 768Mi}\n    64\t          volumeMounts:\n    65\t            - {name: tmp, mountPath: /tmp}\n    66\t            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n    67\t            - {name: svid, mountPath: /etc/svid, readOnly: true}\n    68\t      volumes:\n    69\t        - name: tmp\n    70\t          emptyDir: {medium: Memory, sizeLimit: 32Mi}\n    71\t        - name: sts-token\n    72\t          projected:\n    73\t            sources:\n    74\t              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n    75\t        - name: svid\n    76\t          csi: {driver: csi.spiffe.io, readOnly: true}\n    77\t---\n    78\tapiVersion: apps/v1\n    79\tkind: Deployment\n    80\tmetadata:\n{\n  \"mcpServers\": {\n    \"hr-tool-gateway\": {\n      \"type\": \"http\",\n      \"url\": \"https://hr-tool-gateway.hr-agent.svc.cluster.local:8443/mcp\",\n      \"headers\": {\n        \"Authorization\": \"Bearer ${HR_GATEWAY_TOKEN}\"\n      }\n    }\n  }\n}\nk8s/admission.yaml:49:                    issuer: \"https://token.actions.githubusercontent.com\"\nk8s/admission.yaml:57:                        issuer: \"https://token.actions.githubusercontent.com\"\nk8s/admission.yaml:80:                    issuer: \"https://token.actions.githubusercontent.com\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"a335d60e-ff32-4a28-88b1-c25423668c78","uuid":"06a434e2-94f7-4805-86b5-ff62a14304fb","timestamp":"2026-11-21T12:05:02.939Z","tool_use_result":{"stdout":"     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport logging\n     6\timport os\n     7\timport uuid\n     8\t\n     9\timport asyncpg\n    10\timport httpx\n    11\timport jwt\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n    15\tfrom opentelemetry.sdk.resources import Resource\n    16\tfrom opentelemetry.sdk.trace import TracerProvider\n    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n    18\tfrom starlette.applications import Starlette\n    19\tfrom starlette.requests import Request\n    20\tfrom starlette.responses import JSONResponse\n    21\tfrom starlette.routing import Route\n    22\t\n    23\tfrom . import type_id\n    24\tfrom .agent import Agent, RunState\n    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n    27\tfrom .budgets import BudgetExceeded, QuotaStore\n    28\tfrom .credentials import CredentialBroker\n    29\tfrom .gateway_client import GatewayClient\n    30\tfrom .killswitch import Stopped, StopControl\n    31\tfrom .redact import RedactingFilter\n    32\tfrom .retrieval import PolicyIndex\n    33\tfrom .tools import ToolRegistry, load_yaml\n    34\tfrom .validation import sanitize_reply\n    35\t\n    36\tSSO_ISSUER = \"https://sso.acme.example\"\n    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    39\t\n    40\tlogging.basicConfig(level=logging.INFO)\n    41\tfor h in logging.getLogger().handlers:\n    42\t    h.addFilter(RedactingFilter())\n    43\tlog = logging.getLogger(\"hr_agent\")\n    44\t\n    45\tCFG = load_yaml(\"agent.yaml\")\n    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n    47\tPOD_ID = os.environ[\"POD_UID\"]\n    48\t\n    49\tprovider = TracerProvider(resource=Resource.create({\n    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n    51\t}))\n    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n    53\ttrace.set_tracer_provider(provider)\n    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n    55\t\n    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n    57\tagent: Agent\n    58\taudit: AuditWriter\n    59\tapprovals: ApprovalStore\n    60\tstop: StopControl\n    61\t\n    62\t\n    63\tdef _employee(request: Request) -> tuple[str, str]:\n    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n    65\t    auth = request.headers.get(\"authorization\", \"\")\n    66\t    if not auth.startswith(\"Bearer \"):\n    67\t        raise PermissionError(\"missing token\")\n    68\t    token = auth[7:]\n    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n    72\t        raise PermissionError(\"wrong organisation\")\n    73\t    return claims[\"employee_id\"], token\n    74\t\n    75\t\n    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n    77\t    a = CFG[\"agent\"]\n    78\t    return RunContext(\n    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n    81\t        agent_principal=a[\"workload_identity\"],\n    82\t    )\n    83\t\n    84\t\n    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n    86\t    task = asyncio.ensure_future(coro)\n    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n    88\t    try:\n    89\t        return await task\n    90\t    except asyncio.CancelledError:\n    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n    92\t        return None\n    93\t    except Stopped as exc:\n    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n    95\t        return None\n    96\t    finally:\n    97\t        watcher.cancel()\n    98\t\n    99\t\n   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n   101\t    if state is None:\n   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n   105\t    if state.pending_approval:\n   106\t        body[\"approval\"] = state.pending_approval\n   107\t    return JSONResponse(body)\n   108\t\n   109\t\n   110\tasync def chat(request: Request) -> JSONResponse:\n   111\t    try:\n   112\t        employee_id, token = _employee(request)\n   113\t    except (jwt.PyJWTError, PermissionError):\n   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n   116\t    run_id = str(uuid.uuid4())\n   117\t    ctx = _context(run_id, employee_id)\n   118\t    with tracer.start_as_current_span(\"chat\"):\n   119\t        try:\n   120\t            await agent.quotas.reserve_run(ctx)\n   121\t            state = agent.new_state(text, token)\n   122\t            _runs[run_id] = (ctx, state)\n   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n   124\t            state = await _drive(ctx, agent.run(ctx, state))\n   125\t        except BudgetExceeded as exc:\n     1\t# hr-helpdesk-agent\n     2\t\n     3\tAn HR helpdesk assistant for Acme employees. It answers policy questions from the HR handbook,\n     4\tshows the signed-in employee their own leave balance, files leave requests (the manager approves\n     5\tthem in HRIS), and hands conversations to an HR advisor.\n     6\t\n     7\t## Components\n     8\t\n     9\t| Component | Code | Identity |\n    10\t|---|---|---|\n    11\t| Agent API and loop | `src/main.py`, `src/agent.py` | SA `hr-helpdesk-agent`, SPIFFE SVID |\n    12\t| Tool gateway | `src/gateway.py` | SA `hr-tool-gateway` |\n    13\t| HRIS MCP server | owned by hris-platform | `spiffe://acme.example/ns/hris/sa/hris-mcp` |\n    14\t| Helpdesk MCP server | owned by it-service-desk | `spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp` |\n    15\t| Audit, approvals, quotas, stop flags, handbook index | Postgres (`migrations/001_init.sql`) | per-component DB roles |\n    16\t\n    17\t## How a request flows\n    18\t\n    19\t1. The HR portal sends the employee's SSO token. `main.py` verifies issuer, audience, expiry and\n    20\t   organisation; the employee id and tenant come only from that token.\n    21\t2. The loop (`agent.py`) checks the stop flags and the run budget before every model call, and\n    22\t   records usage against per-user, tenant and fleet quotas.\n    23\t3. Tool calls are looked up by exact name in `config/tools.yaml`. Arguments are schema-checked.\n    24\t   `file_leave_request` and `escalate_to_human` pause the run and show the employee exactly what\n    25\t   will be sent; the approval is bound to the run instance, operation, target and argument hash,\n    26\t   expires after 10 minutes, and is consumed once.\n    27\t4. MCP calls go to the gateway with a 300-second token for that one tool scope, minted by STS\n    28\t   from the agent's workload identity and the employee's token. The gateway verifies the token\n    29\t   and its certificate binding, checks scope, stop flags, rate limits and argument schema, swaps\n    30\t   the token for one addressed to the MCP server, and validates the response schema.\n    31\t5. Tool output is size-, schema- and content-checked and redacted before the model sees it.\n    32\t   Handbook passages are filtered at query time to documents the employee may see.\n    33\t6. Every step writes an `audit.events` row with the six identity fields and trace context.\n    34\t   If the audit write fails, the run stops.\n    35\t\n    36\tEscalations are delivered even during gateway maintenance windows.\n    37\t\n    38\t## Stopping the agent\n    39\t\n    40\tOperators with the `hr_agent_operator` DB role insert into `control.stop_flags`:\n    41\t\n    42\t```sql\n    43\tINSERT INTO control.stop_flags (scope, value, reason) VALUES ('fleet', NULL, 'incident 2291');\n    44\t-- or scope 'agent_type' / 'agent_instance' / 'subject' / 'agent_principal'\n    45\t```\n    46\t\n    47\tRunning agents see the flag within 2 seconds and cancel in-flight work; the gateway refuses\n    48\tcalls immediately. Target stop time: 10 seconds. The agent's DB role can only read this table.\n    49\tLast drill: see `docs/drills/` in the ops repo.\n    50\t\n    51\t## Audit retention\n    52\t\n    53\tAudit records are kept for six months (Acme records policy; employment-related AI use in the EU).\n    54\tPartitions are created and dropped nightly by `k8s/audit-maintenance.yaml`. Access is limited to\n    55\t`hr_audit_reader`.\n    56\t\n    57\t## Releases\n    58\t\n    59\tMerges to `main` build, sign and attest the image, compute the agent-type-id over every file in\n    60\t`src/`, `prompts/`, `config/`, plus `requirements.txt`, `Dockerfile`, the image digest and the model\n    61\trecord, and stamp `release/manifest.yaml`. Pods refuse to start if the type id they compute\n    62\tdiffers from the one they were deployed with. Kyverno admits only signed images built by this\n    63\tworkflow from `main`.\n9:    agent_type_id text NOT NULL, agent_instance_id text NOT NULL,\n23:    agent_type_id_hint text NOT NULL, agent_instance_hint text NOT NULL,   -- caller-supplied; join key only\n47:CREATE TABLE control.stop_flags (\n49:    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n54:CREATE TABLE approvals.grants (\n80:GRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\n81:GRANT INSERT ON audit.events TO hr_agent;\n82:GRANT SELECT ON control.stop_flags TO hr_agent;\n83:GRANT SELECT, INSERT ON approvals.grants TO hr_agent;\n84:GRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\n85:GRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\n86:GRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n88:GRANT USAGE ON SCHEMA audit, control TO hr_gateway;\n89:GRANT INSERT ON audit.gateway_decisions TO hr_gateway;\n90:GRANT SELECT ON control.stop_flags TO hr_gateway;\n92:GRANT USAGE ON SCHEMA control TO hr_agent_operator;\n93:GRANT SELECT, INSERT, UPDATE ON control.stop_flags TO hr_agent_operator;\n94:GRANT USAGE ON SEQUENCE control.stop_flags_flag_id_seq TO hr_agent_operator;\n96:GRANT USAGE ON SCHEMA audit TO hr_audit_reader, hr_audit_maint;\n97:GRANT SELECT ON ALL TABLES IN SCHEMA audit TO hr_audit_reader;\n99:GRANT EXECUTE ON FUNCTION audit.maintain_partitions(regclass, interval, int, int) TO hr_audit_maint;\n101:GRANT USAGE ON SCHEMA retrieval TO hr_docs_ingest;\n102:GRANT SELECT, INSERT, UPDATE ON retrieval.chunks, retrieval.index_state TO hr_docs_ingest;\nsrc/agent.py:40:    subagents_started: int = 0\nsrc/budgets.py:66:    def check_subagent(self, started_so_far: int) -> None:\nsrc/budgets.py:67:        if started_so_far >= self.cfg[\"max_subagents\"]:\nsrc/budgets.py:68:            raise BudgetExceeded(\"max_subagents\")\nconfig/agent.yaml:23:    max_subagents: 0\n     1\tapiVersion: v1\n     2\tkind: ServiceAccount\n     3\tmetadata:\n     4\t  name: hr-helpdesk-agent\n     5\t  namespace: hr-agent\n     6\tautomountServiceAccountToken: false\n     7\t---\n     8\tapiVersion: v1\n     9\tkind: ServiceAccount\n    10\tmetadata:\n    11\t  name: hr-tool-gateway\n    12\t  namespace: hr-agent\n    13\tautomountServiceAccountToken: false\n    14\t---\n    15\tapiVersion: apps/v1\n    16\tkind: Deployment\n    17\tmetadata:\n    18\t  name: hr-helpdesk-agent\n    19\t  namespace: hr-agent\n    20\t  labels: {app: hr-helpdesk-agent, app.kubernetes.io/part-of: hr-helpdesk}\n    21\tspec:\n    22\t  replicas: 3\n    23\t  selector:\n    24\t    matchLabels: {app: hr-helpdesk-agent}\n    25\t  template:\n    26\t    metadata:\n    27\t      labels: {app: hr-helpdesk-agent}\n    28\t      annotations:\n    29\t        acme.example/release-manifest: \"release/manifest.yaml@${GIT_SHA}\"\n    30\t    spec:\n    31\t      serviceAccountName: hr-helpdesk-agent\n    32\t      automountServiceAccountToken: false\n    33\t      hostUsers: false\n    34\t      enableServiceLinks: false\n    35\t      securityContext:\n    36\t        runAsNonRoot: true\n    37\t        runAsUser: 65532\n    38\t        runAsGroup: 65532\n    39\t        fsGroup: 65532\n    40\t        seccompProfile: {type: RuntimeDefault}\n    41\t      containers: