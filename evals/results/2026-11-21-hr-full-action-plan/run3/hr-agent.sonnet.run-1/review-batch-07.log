{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0114QkJ3KfH5gmWHXkHDdSVY","type":"tool_result","content":"     1\t\"\"\"Append-only audit records. Every record carries the six identity fields.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport json\n     5\timport logging\n     6\timport uuid\n     7\tfrom dataclasses import dataclass\n     8\tfrom typing import Any\n     9\t\n    10\timport asyncpg\n    11\tfrom opentelemetry import trace\n    12\t\n    13\tfrom .redact import redact_obj\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.audit\")\n    16\t\n    17\t\n    18\t@dataclass(frozen=True)\n    19\tclass RunContext:\n    20\t    \"\"\"Built by the harness from verified identity. Never from model output.\"\"\"\n    21\t\n    22\t    run_id: str\n    23\t    agent_instance_id: str\n    24\t    agent_type_id: str\n    25\t    tenant: str\n    26\t    subject: str              # employee whose authority is being used (verified SSO token)\n    27\t    accountable_party: str\n    28\t    operational_owner: str\n    29\t    agent_principal: str      # workload identity of this agent\n    30\t\n    31\t\n    32\tclass AuditUnavailable(Exception):\n    33\t    pass\n    34\t\n    35\t\n    36\t_INSERT = \"\"\"\n    37\tINSERT INTO audit.events (\n    38\t    event_id, ts, event_type, run_id, step_id, parent_step_id,\n    39\t    accountable_party, operational_owner, tenant, agent_type_id, agent_instance_id,\n    40\t    trace_id, span_id, traceparent,\n    41\t    delegated_subject, agent_principal,\n    42\t    tool, operation_target, decision, reason, policy_version, approval_id,\n    43\t    args_redacted, result_redacted, context_tokens, context_tokens_method, model_requested, model_served\n    44\t) VALUES (\n    45\t    $1, now(), $2, $3, $4, $5,\n    46\t    $6, $7, $8, $9, $10,\n    47\t    $11, $12, $13,\n    48\t    $14, $15,\n    49\t    $16, $17, $18, $19, $20, $21,\n    50\t    $22::jsonb, $23::jsonb, $24, $25, $26, $27\n    51\t)\n    52\t\"\"\"\n    53\t\n    54\t\n    55\tclass AuditWriter:\n    56\t    def __init__(self, pool: asyncpg.Pool, policy_version: str):\n    57\t        self._pool = pool\n    58\t        self._policy_version = policy_version\n    59\t\n    60\t    async def record(\n    61\t        self,\n    62\t        ctx: RunContext,\n    63\t        event_type: str,\n    64\t        *,\n    65\t        step_id: str | None = None,\n    66\t        parent_step_id: str | None = None,\n    67\t        tool: str | None = None,\n    68\t        target: str | None = None,\n    69\t        decision: str | None = None,\n    70\t        reason: str | None = None,\n    71\t        approval_id: str | None = None,\n    72\t        args: Any = None,\n    73\t        result: Any = None,\n    74\t        context_tokens: int | None = None,\n    75\t        context_tokens_method: str | None = None,\n    76\t        model_requested: str | None = None,\n    77\t        model_served: str | None = None,\n    78\t    ) -> str:\n    79\t        span_ctx = trace.get_current_span().get_span_context()\n    80\t        if not span_ctx.is_valid:\n    81\t            raise AuditUnavailable(\"no active trace context\")\n    82\t        trace_id = format(span_ctx.trace_id, \"032x\")\n    83\t        span_id = format(span_ctx.span_id, \"016x\")\n    84\t        traceparent = f\"00-{trace_id}-{span_id}-{span_ctx.trace_flags:02x}\"\n    85\t        event_id = str(uuid.uuid4())\n    86\t        try:\n    87\t            await self._pool.execute(\n    88\t                _INSERT,\n    89\t                event_id, event_type, ctx.run_id, step_id, parent_step_id,\n    90\t                ctx.accountable_party, ctx.operational_owner, ctx.tenant, ctx.agent_type_id, ctx.agent_instance_id,\n    91\t                trace_id, span_id, traceparent,\n    92\t                ctx.subject, ctx.agent_principal,\n    93\t                tool, target, decision, reason, self._policy_version, approval_id,\n    94\t                json.dumps(redact_obj(args)), json.dumps(redact_obj(result)),\n    95\t                context_tokens, context_tokens_method, model_requested, model_served,\n    96\t                timeout=2.0,\n    97\t            )\n    98\t        except Exception as exc:  # any failure to persist stops the run\n    99\t            log.error(\"audit write failed\", extra={\"event_type\": event_type, \"run_id\": ctx.run_id})\n   100\t            raise AuditUnavailable(str(type(exc).__name__)) from exc\n   101\t        return event_id\n     1\t\"\"\"Stop control. Flags live in control.stop_flags, which the agent's DB role can only read.\n     2\t\n     3\tOperators set flags with the hr_agent_operator role (see README \"Stopping the agent\").\n     4\tThe tool gateway reads the same table, so a stopped instance is refused there too.\n     5\t\"\"\"\n     6\tfrom __future__ import annotations\n     7\t\n     8\timport asyncio\n     9\timport logging\n    10\t\n    11\timport asyncpg\n    12\t\n    13\tfrom .audit import RunContext\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.stop\")\n    16\t\n    17\t_QUERY = \"\"\"\n    18\tSELECT reason FROM control.stop_flags\n    19\tWHERE active\n    20\t  AND (   scope = 'fleet'\n    21\t       OR (scope = 'agent_type'     AND value = $1)\n    22\t       OR (scope = 'agent_instance' AND value = $2)\n    23\t       OR (scope = 'subject'        AND value = $3)\n    24\t       OR (scope = 'agent_principal' AND value = $4))\n    25\tLIMIT 1\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass Stopped(Exception):\n    30\t    pass\n    31\t\n    32\t\n    33\tclass StopControl:\n    34\t    def __init__(self, pool: asyncpg.Pool, poll_seconds: float):\n    35\t        self._pool = pool\n    36\t        self._poll = poll_seconds\n    37\t\n    38\t    async def reason(self, ctx: RunContext) -> str | None:\n    39\t        try:\n    40\t            row = await self._pool.fetchrow(\n    41\t                _QUERY, ctx.agent_type_id, ctx.agent_instance_id, ctx.subject, ctx.agent_principal, timeout=1.0\n    42\t            )\n    43\t        except Exception:\n    44\t            return \"stop store unreachable\"\n    45\t        return row[\"reason\"] if row else None\n    46\t\n    47\t    async def raise_if_stopped(self, ctx: RunContext) -> None:\n    48\t        why = await self.reason(ctx)\n    49\t        if why:\n    50\t            raise Stopped(why)\n    51\t\n    52\t    async def watch(self, ctx: RunContext, task: asyncio.Task) -> None:\n    53\t        \"\"\"Cancel the run task, including any in-flight model or tool call, once a flag appears.\"\"\"\n    54\t        while not task.done():\n    55\t            why = await self.reason(ctx)\n    56\t            if why:\n    57\t                log.warning(\"stop flag observed\", extra={\"run_id\": ctx.run_id, \"reason\": why})\n    58\t                task.cancel(msg=f\"stopped: {why}\")\n    59\t                return\n    60\t            await asyncio.sleep(self._poll)\n     1\t\"\"\"agent-type-id: SHA-256 over every identity-defining input.\n     2\t\n     3\tInputs (all, no exclusions):\n     4\t  - every file under src/, prompts/ and config/, plus requirements.txt and Dockerfile\n     5\t  - the image digest the pod runs\n     6\t  - the model record (provider, requested ID, snapshot/alias label, adapter)\n     7\tCanonical form: JSON with sorted keys, no whitespace, file paths relative to the repo root\n     8\tin POSIX form, each file hashed as raw bytes. The same command runs in CI (to stamp the\n     9\trelease manifest) and at pod start (to refuse running under an identity it does not match).\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport hashlib\n    14\timport json\n    15\timport pathlib\n    16\timport sys\n    17\tfrom typing import Any\n    18\t\n    19\tROOT = pathlib.Path(__file__).resolve().parent.parent\n    20\tINPUT_DIRS = (\"src\", \"prompts\", \"config\")\n    21\tINPUT_FILES = (\"requirements.txt\", \"Dockerfile\")\n    22\tHASH_SCHEME = \"acme-agent-type-id/v1\"\n    23\t\n    24\t\n    25\tdef _file_hashes() -> dict[str, str]:\n    26\t    out: dict[str, str] = {}\n    27\t    for d in INPUT_DIRS:\n    28\t        for p in sorted((ROOT / d).rglob(\"*\")):\n    29\t            if p.is_file():\n    30\t                out[p.relative_to(ROOT).as_posix()] = hashlib.sha256(p.read_bytes()).hexdigest()\n    31\t    for f in INPUT_FILES:\n    32\t        out[f] = hashlib.sha256((ROOT / f).read_bytes()).hexdigest()\n    33\t    return out\n    34\t\n    35\t\n    36\tdef compute(image_digest: str, model: dict[str, Any]) -> tuple[str, dict[str, Any]]:\n    37\t    if not image_digest.startswith(\"sha256:\") or len(image_digest) != 71:\n    38\t        raise ValueError(\"image digest must be sha256:<64 hex>\")\n    39\t    for k in (\"provider\", \"id\", \"pinning\", \"adapter\"):\n    40\t        if k not in model:\n    41\t            raise ValueError(f\"model record missing {k}\")\n    42\t    manifest = {\"scheme\": HASH_SCHEME, \"image_digest\": image_digest, \"model\": model, \"files\": _file_hashes()}\n    43\t    canonical = json.dumps(manifest, sort_keys=True, separators=(\",\", \":\")).encode()\n    44\t    return \"sha256:\" + hashlib.sha256(canonical).hexdigest(), manifest\n    45\t\n    46\t\n    47\tdef model_record(cfg: dict[str, Any]) -> dict[str, Any]:\n    48\t    m = cfg[\"model\"]\n    49\t    return {\"provider\": m[\"provider\"], \"id\": m[\"id\"], \"pinning\": m[\"pinning\"], \"adapter\": m[\"adapter\"]}\n    50\t\n    51\t\n    52\tdef verify_or_exit(expected: str, image_digest: str, model: dict[str, Any]) -> str:\n    53\t    actual, _ = compute(image_digest, model)\n    54\t    if actual != expected:\n    55\t        print(f\"agent-type-id mismatch: expected {expected}, computed {actual}\", file=sys.stderr)\n    56\t        sys.exit(78)\n    57\t    return actual\n    58\t\n    59\t\n    60\tif __name__ == \"__main__\":\n    61\t    import yaml\n    62\t\n    63\t    cfg = yaml.safe_load((ROOT / \"config\" / \"agent.yaml\").read_text())\n    64\t    tid, man = compute(sys.argv[1], model_record(cfg))\n    65\t    json.dump({\"agent_type_id\": tid, \"inputs\": man}, sys.stdout, indent=2, sort_keys=True)\n     1\t*                         @acme/people-platform\n     2\t/prompts/                 @acme/people-platform @acme/hr-policy-reviewers\n     3\t/config/                  @acme/people-platform @acme/security-engineering\n     4\t/src/gateway.py           @acme/people-platform @acme/security-engineering\n     5\t/src/approvals.py         @acme/people-platform @acme/security-engineering\n     6\t/k8s/                     @acme/people-platform @acme/platform-security\n     7\t/migrations/              @acme/people-platform @acme/data-platform\n     8\t/release/                 @acme/people-platform @acme/security-engineering\n     9\t/.github/                 @acme/platform-security\n    10\t/CODEOWNERS               @acme/platform-security\n     1\trelease:\n     2\t  name: hr-helpdesk-agent\n     3\t  version: \"1.8.0\"\n     4\t  git_sha: \"\"            # stamped by CI\n     5\t  agent_type_id: \"\"      # stamped by CI (src/type_id.py, scheme acme-agent-type-id/v1)\n     6\t  image:\n     7\t    repository: registry.acme.example/people/hr-helpdesk-agent\n     8\t    digest: \"\"           # stamped by CI\n     9\t    signer: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    10\t    sbom: attached (BuildKit SPDX)\n    11\t    provenance: SLSA v1 via actions/attest-build-provenance\n    12\t  owners:\n    13\t    accountable_party: \"VP People Operations\"\n    14\t    operational_owner: people-platform\n    15\t\n    16\tstakes:\n    17\t  rating: moderate\n    18\t  autonomy: low (every write requires the employee's confirmation)\n    19\t  rationale: >-\n    20\t    Reads one employee's own leave data and the handbook; writes are leave requests that a\n    21\t    manager must still approve in HRIS, and helpdesk tickets. Worst credible harm: disclosure of\n    22\t    one employee's HR data to another employee, or a misleading policy answer.\n    23\t  approved_by: \"Head of Security Engineering, 2026-09-19\"\n    24\t\n    25\tcapability_combination:\n    26\t  untrusted_input: yes (employee messages, handbook passages, tool output)\n    27\t  sensitive_access: yes (leave records, employee-specific HR documents)\n    28\t  external_change_or_send: yes (leave requests, helpdesk tickets)\n    29\t  containment: every consequential tool requires per-action employee approval bound to args\n    30\t\n    31\tharness:\n    32\t  files: [src/]\n    33\t  entrypoints: {agent: \"src.main:app\", gateway: \"src.gateway:app\"}\n    34\tsystem_prompt: {path: prompts/system.md}\n    35\trules_files: []\n    36\tconfiguration: [config/agent.yaml, config/tools.yaml]\n    37\t\n    38\tmodels:\n    39\t  primary:\n    40\t    role: main agent\n    41\t    owner: people-platform\n    42\t    identity: {provider: anthropic, id: claude-sonnet-4-5-20250929, pinning: snapshot, adapter: none}\n    43\t    pinning_source: \"Anthropic models overview, checked 2026-09-15\"\n    44\t    served_version: recorded per call in audit.events.model_served\n    45\t    fine_tune: none\n    46\t    training_runs: not applicable\n    47\t    training_data: provider-undisclosed\n    48\t  helpers: []            # retrieval is Postgres full-text search; no embedding or reranker model\n    49\t\n    50\ttools:\n    51\t  built_in: []\n    52\t  local: [search_policies]\n    53\t  mcp_servers:\n    54\t    - {id: hris, identity: \"spiffe://acme.example/ns/hris/sa/hris-mcp\", owner: hris-platform, tools: [get_leave_balance, file_leave_request]}\n    55\t    - {id: helpdesk, identity: \"spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\", owner: it-service-desk, tools: [create_ticket]}\n    56\t  policy_version_source: config/tools.yaml#policy_version\n    57\t\n    58\tpermissions:\n    59\t  sts_scopes: [hr.policy.read, hris.leave.read, hris.leave.request, helpdesk.ticket.create]\n    60\t  token_ttl_seconds: 300\n    61\t  database_role: hr_agent (see migrations/001_init.sql grants)\n    62\t\n    63\tmemory: none (conversation state is held per run and discarded; no cross-run memory)\n    64\tretrieval:\n    65\t  store: retrieval.chunks (Postgres FTS)\n    66\t  writers: [hr_docs_ingest]\n    67\t  filters: [quarantined, expires_at, audience/allowed_employees]\n    68\t\n    69\tidentity_bindings:\n    70\t  agent: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n    71\t  gateway: spiffe://acme.example/ns/hr-agent/sa/hr-tool-gateway\n    72\t\n    73\tnetwork: [k8s/networkpolicy.yaml]\n    74\tadmission: [k8s/admission.yaml]\n    75\tbudgets: config/agent.yaml#budgets\n    76\t\n    77\taudit:\n    78\t  store: audit.events, audit.gateway_decisions (Postgres, weekly partitions)\n    79\t  retention: 6 months\n    80\t  readers: hr_audit_reader\n     1\tagent:\n     2\t  name: hr-helpdesk\n     3\t  accountable_party: \"VP People Operations <people-ops-lead@acme.example>\"\n     4\t  operational_owner: \"people-platform (pager: people-platform-oncall)\"\n     5\t  tenant: acme\n     6\t  workload_identity: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n     7\t\n     8\tmodel:\n     9\t  provider: anthropic\n    10\t  id: claude-sonnet-4-5-20250929\n    11\t  pinning: snapshot          # dated snapshot ID per provider model docs, checked 2026-09-15\n    12\t  adapter: none\n    13\t  max_output_tokens: 1024\n    14\t  temperature: 0.2\n    15\t\n    16\tbudgets:\n    17\t  run:\n    18\t    max_steps: 12\n    19\t    max_wall_seconds: 90\n    20\t    max_total_tokens: 60000\n    21\t    max_cost_usd: 0.40\n    22\t    max_tool_calls_per_minute: 20\n    23\t    max_subagents: 0\n    24\t  quotas:\n    25\t    - scope: user\n    26\t      window_seconds: 86400\n    27\t      max_runs: 150\n    28\t      max_tokens: 400000\n    29\t      max_cost_usd: 3.00\n    30\t    - scope: tenant\n    31\t      window_seconds: 3600\n    32\t      max_runs: 20000\n    33\t      max_tokens: 15000000\n    34\t      max_cost_usd: 250.00\n    35\t    - scope: fleet\n    36\t      window_seconds: 3600\n    37\t      max_runs: 25000\n    38\t      max_tokens: 20000000\n    39\t      max_cost_usd: 300.00\n    40\t\n    41\tpricing:\n    42\t  input_per_mtok: 3.00\n    43\t  output_per_mtok: 15.00\n    44\t  cache_read_per_mtok: 0.30\n    45\t\n    46\tapprovals:\n    47\t  ttl_seconds: 600\n    48\t\n    49\tstop:\n    50\t  poll_seconds: 2\n    51\t  max_stop_seconds: 10\n    52\t\n    53\tretrieval:\n    54\t  top_k: 5\n    55\t  cache_ttl_seconds: 900\n    56\t  max_chunk_chars: 4000\n    57\t\n    58\tlimits:\n    59\t  max_tool_output_bytes: 16384\n    60\t  max_user_message_chars: 4000\n    61\t\n    62\toutput:\n    63\t  allowed_link_hosts: [hr.acme.example, handbook.acme.example]\n     1\tname: release\n     2\t\n     3\ton:\n     4\t  push:\n     5\t    branches: [main]\n     6\t\n     7\tpermissions:\n     8\t  contents: read\n     9\t\n    10\tjobs:\n    11\t  build:\n    12\t    runs-on: ubuntu-24.04\n    13\t    environment: production   # requires approval from @acme/people-platform-release\n    14\t    permissions:\n    15\t      contents: read\n    16\t      packages: write\n    17\t      id-token: write\n    18\t      attestations: write\n    19\t    env:\n    20\t      PYTHONDONTWRITEBYTECODE: \"1\"\n    21\t      IMAGE: registry.acme.example/people/hr-helpdesk-agent\n    22\t    steps:\n    23\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    24\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    25\t        with: {python-version: \"3.12.7\"}\n    26\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    27\t        with: {cosign-release: \"v2.6.2\"}\n    28\t      - run: pip install --require-hashes -r requirements.txt\n    29\t      - run: python -m pytest -q tests/release\n    30\t      - name: Build and push\n    31\t        id: build\n    32\t        uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    33\t        with:\n    34\t          push: true\n    35\t          tags: ${{ env.IMAGE }}:${{ github.sha }}\n    36\t          sbom: true\n    37\t          provenance: mode=max\n    38\t      - name: Sign image\n    39\t        run: cosign sign --yes \"${IMAGE}@${{ steps.build.outputs.digest }}\"\n    40\t      - uses: actions/attest-build-provenance@e8998f949152b193b063cb0ec769d69d929409be # v2.4.0\n    41\t        with:\n    42\t          subject-name: ${{ env.IMAGE }}\n    43\t          subject-digest: ${{ steps.build.outputs.digest }}\n    44\t          push-to-registry: true\n    45\t      - name: Compute agent-type-id\n    46\t        id: typeid\n    47\t        run: |\n    48\t          python -m src.type_id \"${{ steps.build.outputs.digest }}\" > type-id.json\n    49\t          echo \"id=$(jq -r .agent_type_id type-id.json)\" >> \"$GITHUB_OUTPUT\"\n    50\t      - name: Stamp release manifest\n    51\t        run: |\n    52\t          yq -i '.release.agent_type_id = \"${{ steps.typeid.outputs.id }}\" |\n    53\t                 .release.image.digest = \"${{ steps.build.outputs.digest }}\" |\n    54\t                 .release.git_sha = \"${{ github.sha }}\"' release/manifest.yaml\n    55\t      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\n    56\t        with:\n    57\t          name: release-${{ github.sha }}\n    58\t          path: [type-id.json, release/manifest.yaml]\n    59\t\n    60\t  deploy:\n    61\t    needs: build\n    62\t    runs-on: ubuntu-24.04\n    63\t    environment: production\n    64\t    permissions: {contents: read, id-token: write}\n    65\t    steps:\n    66\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    67\t      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0\n    68\t        with: {name: \"release-${{ github.sha }}\"}\n    69\t      - name: Render and apply\n    70\t        run: |\n    71\t          export IMAGE_DIGEST=$(yq -r .release.image.digest release/manifest.yaml)\n    72\t          export AGENT_TYPE_ID=$(yq -r .release.agent_type_id release/manifest.yaml)\n    73\t          export GIT_SHA=${{ github.sha }}\n    74\t          for f in k8s/*.yaml; do envsubst '$IMAGE_DIGEST $AGENT_TYPE_ID $GIT_SHA' < \"$f\"; echo '---'; done \\\n    75\t            | kubectl apply --server-side -f -\n     1\t\"\"\"Agent loop for the HR helpdesk.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport json\n     5\timport logging\n     6\timport pathlib\n     7\timport uuid\n     8\tfrom dataclasses import dataclass, field\n     9\tfrom datetime import date\n    10\tfrom typing import Any\n    11\t\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    16\tfrom .audit import AuditWriter, RunContext\n    17\tfrom .budgets import BudgetExceeded, QuotaStore, RunBudget\n    18\tfrom .gateway_client import GatewayClient, ToolDenied, ToolError\n    19\tfrom .killswitch import StopControl\n    20\tfrom .redact import redact\n    21\tfrom .retrieval import PolicyIndex\n    22\tfrom .tools import ToolRegistry, ToolSpec\n    23\tfrom .validation import ValidationRejected, validate_chunk, validate_tool_args, validate_tool_output\n    24\t\n    25\tlog = logging.getLogger(\"hr_agent.loop\")\n    26\ttracer = trace.get_tracer(\"hr_agent\")\n    27\t\n    28\tSYSTEM_PROMPT = (pathlib.Path(__file__).resolve().parent.parent / \"prompts\" / \"system.md\").read_text()\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass RunState:\n    33\t    messages: list[dict[str, Any]]\n    34\t    budget: RunBudget\n    35\t    subject_token: str\n    36\t    status: str = \"running\"\n    37\t    reply: str | None = None\n    38\t    pending_approval: dict[str, Any] | None = None\n    39\t    last_step: str | None = None\n    40\t    subagents_started: int = 0\n    41\t    extra: dict[str, Any] = field(default_factory=dict)\n    42\t\n    43\t\n    44\tclass Agent:\n    45\t    def __init__(self, cfg: dict[str, Any], registry: ToolRegistry, llm: AsyncAnthropic, gateway: GatewayClient,\n    46\t                 index: PolicyIndex, approvals: ApprovalStore, quotas: QuotaStore, audit: AuditWriter, stop: StopControl):\n    47\t        self.cfg, self.registry, self.llm, self.gateway = cfg, registry, llm, gateway\n    48\t        self.index, self.approvals, self.quotas, self.audit, self.stop = index, approvals, quotas, audit, stop\n    49\t\n    50\t    def new_state(self, user_text: str, subject_token: str) -> RunState:\n    51\t        budget = RunBudget(self.cfg[\"budgets\"][\"run\"], self.cfg[\"pricing\"])\n    52\t        return RunState(messages=[{\"role\": \"user\", \"content\": user_text}], budget=budget, subject_token=subject_token)\n    53\t\n    54\t    async def run(self, ctx: RunContext, state: RunState) -> RunState:\n    55\t        with tracer.start_as_current_span(\"agent.run\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n    56\t            try:\n    57\t                await self._loop(ctx, state)\n    58\t            except BudgetExceeded as exc:\n    59\t                await self.audit.record(ctx, \"budget_stop\", decision=\"stop\", reason=exc.limit, parent_step_id=state.last_step)\n    60\t                state.status, state.reply = \"stopped\", \"I've reached the limit for this conversation. An HR advisor can help further.\"\n    61\t            return state\n    62\t\n    63\t    async def _loop(self, ctx: RunContext, state: RunState) -> None:\n    64\t        model = self.cfg[\"model\"]\n    65\t        while True:\n    66\t            await self.stop.raise_if_stopped(ctx)\n    67\t            state.budget.check_step()\n    68\t            step_id = str(uuid.uuid4())\n    69\t            with tracer.start_as_current_span(\"gen_ai.chat\", attributes={\"gen_ai.request.model\": model[\"id\"]}):\n    70\t                resp = await self.llm.messages.create(\n    71\t                    model=model[\"id\"], system=SYSTEM_PROMPT, max_tokens=model[\"max_output_tokens\"],\n    72\t                    temperature=model[\"temperature\"], tools=self.registry.model_schemas(), messages=state.messages,\n    73\t                    timeout=state.budget.remaining_seconds(),\n    74\t                )\n    75\t                tokens, cost = state.budget.record_usage(resp.usage)\n    76\t                ctx_tokens = resp.usage.input_tokens + (resp.usage.cache_read_input_tokens or 0) + (resp.usage.cache_creation_input_tokens or 0)\n    77\t                await self.audit.record(\n    78\t                    ctx, \"model_call\", step_id=step_id, parent_step_id=state.last_step,\n    79\t                    context_tokens=ctx_tokens, context_tokens_method=\"measured:provider_usage_input+cache_read+cache_write\",\n    80\t                    model_requested=model[\"id\"], model_served=resp.model, result={\"stop_reason\": resp.stop_reason},\n    81\t                )\n    82\t                await self.quotas.record_usage(ctx, tokens, cost)\n    83\t            state.last_step = step_id\n    84\t            state.messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n    85\t            if resp.stop_reason != \"tool_use\":\n    86\t                state.status = \"done\"\n    87\t                state.reply = \"\".join(b.text for b in resp.content if b.type == \"text\")\n    88\t                return\n    89\t            results = []\n    90\t            for block in (b for b in resp.content if b.type == \"tool_use\"):\n    91\t                result = await self._handle_tool(ctx, state, step_id, block.id, block.name, block.input)\n    92\t                if result is None:  # paused for employee approval\n    93\t                    return\n    94\t                results.append(result)\n    95\t            state.messages.append({\"role\": \"user\", \"content\": results})\n    96\t\n    97\t    async def _handle_tool(self, ctx: RunContext, state: RunState, parent: str, tool_use_id: str,\n    98\t                           name: str, args: Any) -> dict[str, Any] | None:\n    99\t        step_id = str(uuid.uuid4())\n   100\t        await self.audit.record(ctx, \"proposed_action\", step_id=step_id, parent_step_id=parent, tool=name, args=args)\n   101\t        spec = self.registry.get(name)\n   102\t        if spec is None:\n   103\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=name, decision=\"deny\", reason=\"tool not in allowlist\")\n   104\t            return _tool_result(tool_use_id, \"This tool is not available.\", error=True)\n   105\t        target = spec.target(ctx.subject)\n   106\t        state.budget.check_tool_call()\n   107\t        try:\n   108\t            args = validate_tool_args(spec, args)\n   109\t        except ValidationRejected as exc:\n   110\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target,","is_error":false}]},"parent_tool_use_id":null,"session_id":"a335d60e-ff32-4a28-88b1-c25423668c78","uuid":"052aea69-816c-4f61-a784-4bc4481d3780","timestamp":"2026-11-21T12:04:59.424Z","tool_use_result":{"stdout":"     1\t\"\"\"Append-only audit records. Every record carries the six identity fields.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport json\n     5\timport logging\n     6\timport uuid\n     7\tfrom dataclasses import dataclass\n     8\tfrom typing import Any\n     9\t\n    10\timport asyncpg\n    11\tfrom opentelemetry import trace\n    12\t\n    13\tfrom .redact import redact_obj\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.audit\")\n    16\t\n    17\t\n    18\t@dataclass(frozen=True)\n    19\tclass RunContext:\n    20\t    \"\"\"Built by the harness from verified identity. Never from model output.\"\"\"\n    21\t\n    22\t    run_id: str\n    23\t    agent_instance_id: str\n    24\t    agent_type_id: str\n    25\t    tenant: str\n    26\t    subject: str              # employee whose authority is being used (verified SSO token)\n    27\t    accountable_party: str\n    28\t    operational_owner: str\n    29\t    agent_principal: str      # workload identity of this agent\n    30\t\n    31\t\n    32\tclass AuditUnavailable(Exception):\n    33\t    pass\n    34\t\n    35\t\n    36\t_INSERT = \"\"\"\n    37\tINSERT INTO audit.events (\n    38\t    event_id, ts, event_type, run_id, step_id, parent_step_id,\n    39\t    accountable_party, operational_owner, tenant, agent_type_id, agent_instance_id,\n    40\t    trace_id, span_id, traceparent,\n    41\t    delegated_subject, agent_principal,\n    42\t    tool, operation_target, decision, reason, policy_version, approval_id,\n    43\t    args_redacted, result_redacted, context_tokens, context_tokens_method, model_requested, model_served\n    44\t) VALUES (\n    45\t    $1, now(), $2, $3, $4, $5,\n    46\t    $6, $7, $8, $9, $10,\n    47\t    $11, $12, $13,\n    48\t    $14, $15,\n    49\t    $16, $17, $18, $19, $20, $21,\n    50\t    $22::jsonb, $23::jsonb, $24, $25, $26, $27\n    51\t)\n    52\t\"\"\"\n    53\t\n    54\t\n    55\tclass AuditWriter:\n    56\t    def __init__(self, pool: asyncpg.Pool, policy_version: str):\n    57\t        self._pool = pool\n    58\t        self._policy_version = policy_version\n    59\t\n    60\t    async def record(\n    61\t        self,\n    62\t        ctx: RunContext,\n    63\t        event_type: str,\n    64\t        *,\n    65\t        step_id: str | None = None,\n    66\t        parent_step_id: str | None = None,\n    67\t        tool: str | None = None,\n    68\t        target: str | None = None,\n    69\t        decision: str | None = None,\n    70\t        reason: str | None = None,\n    71\t        approval_id: str | None = None,\n    72\t        args: Any = None,\n    73\t        result: Any = None,\n    74\t        context_tokens: int | None = None,\n    75\t        context_tokens_method: str | None = None,\n    76\t        model_requested: str | None = None,\n    77\t        model_served: str | None = None,\n    78\t    ) -> str:\n    79\t        span_ctx = trace.get_current_span().get_span_context()\n    80\t        if not span_ctx.is_valid:\n    81\t            raise AuditUnavailable(\"no active trace context\")\n    82\t        trace_id = format(span_ctx.trace_id, \"032x\")\n    83\t        span_id = format(span_ctx.span_id, \"016x\")\n    84\t        traceparent = f\"00-{trace_id}-{span_id}-{span_ctx.trace_flags:02x}\"\n    85\t        event_id = str(uuid.uuid4())\n    86\t        try:\n    87\t            await self._pool.execute(\n    88\t                _INSERT,\n    89\t                event_id, event_type, ctx.run_id, step_id, parent_step_id,\n    90\t                ctx.accountable_party, ctx.operational_owner, ctx.tenant, ctx.agent_type_id, ctx.agent_instance_id,\n    91\t                trace_id, span_id, traceparent,\n    92\t                ctx.subject, ctx.agent_principal,\n    93\t                tool, target, decision, reason, self._policy_version, approval_id,\n    94\t                json.dumps(redact_obj(args)), json.dumps(redact_obj(result)),\n    95\t                context_tokens, context_tokens_method, model_requested, model_served,\n    96\t                timeout=2.0,\n    97\t            )\n    98\t        except Exception as exc:  # any failure to persist stops the run\n    99\t            log.error(\"audit write failed\", extra={\"event_type\": event_type, \"run_id\": ctx.run_id})\n   100\t            raise AuditUnavailable(str(type(exc).__name__)) from exc\n   101\t        return event_id\n     1\t\"\"\"Stop control. Flags live in control.stop_flags, which the agent's DB role can only read.\n     2\t\n     3\tOperators set flags with the hr_agent_operator role (see README \"Stopping the agent\").\n     4\tThe tool gateway reads the same table, so a stopped instance is refused there too.\n     5\t\"\"\"\n     6\tfrom __future__ import annotations\n     7\t\n     8\timport asyncio\n     9\timport logging\n    10\t\n    11\timport asyncpg\n    12\t\n    13\tfrom .audit import RunContext\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.stop\")\n    16\t\n    17\t_QUERY = \"\"\"\n    18\tSELECT reason FROM control.stop_flags\n    19\tWHERE active\n    20\t  AND (   scope = 'fleet'\n    21\t       OR (scope = 'agent_type'     AND value = $1)\n    22\t       OR (scope = 'agent_instance' AND value = $2)\n    23\t       OR (scope = 'subject'        AND value = $3)\n    24\t       OR (scope = 'agent_principal' AND value = $4))\n    25\tLIMIT 1\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass Stopped(Exception):\n    30\t    pass\n    31\t\n    32\t\n    33\tclass StopControl:\n    34\t    def __init__(self, pool: asyncpg.Pool, poll_seconds: float):\n    35\t        self._pool = pool\n    36\t        self._poll = poll_seconds\n    37\t\n    38\t    async def reason(self, ctx: RunContext) -> str | None:\n    39\t        try:\n    40\t            row = await self._pool.fetchrow(\n    41\t                _QUERY, ctx.agent_type_id, ctx.agent_instance_id, ctx.subject, ctx.agent_principal, timeout=1.0\n    42\t            )\n    43\t        except Exception:\n    44\t            return \"stop store unreachable\"\n    45\t        return row[\"reason\"] if row else None\n    46\t\n    47\t    async def raise_if_stopped(self, ctx: RunContext) -> None:\n    48\t        why = await self.reason(ctx)\n    49\t        if why:\n    50\t            raise Stopped(why)\n    51\t\n    52\t    async def watch(self, ctx: RunContext, task: asyncio.Task) -> None:\n    53\t        \"\"\"Cancel the run task, including any in-flight model or tool call, once a flag appears.\"\"\"\n    54\t        while not task.done():\n    55\t            why = await self.reason(ctx)\n    56\t            if why:\n    57\t                log.warning(\"stop flag observed\", extra={\"run_id\": ctx.run_id, \"reason\": why})\n    58\t                task.cancel(msg=f\"stopped: {why}\")\n    59\t                return\n    60\t            await asyncio.sleep(self._poll)\n     1\t\"\"\"agent-type-id: SHA-256 over every identity-defining input.\n     2\t\n     3\tInputs (all, no exclusions):\n     4\t  - every file under src/, prompts/ and config/, plus requirements.txt and Dockerfile\n     5\t  - the image digest the pod runs\n     6\t  - the model record (provider, requested ID, snapshot/alias label, adapter)\n     7\tCanonical form: JSON with sorted keys, no whitespace, file paths relative to the repo root\n     8\tin POSIX form, each file hashed as raw bytes. The same command runs in CI (to stamp the\n     9\trelease manifest) and at pod start (to refuse running under an identity it does not match).\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport hashlib\n    14\timport json\n    15\timport pathlib\n    16\timport sys\n    17\tfrom typing import Any\n    18\t\n    19\tROOT = pathlib.Path(__file__).resolve().parent.parent\n    20\tINPUT_DIRS = (\"src\", \"prompts\", \"config\")\n    21\tINPUT_FILES = (\"requirements.txt\", \"Dockerfile\")\n    22\tHASH_SCHEME = \"acme-agent-type-id/v1\"\n    23\t\n    24\t\n    25\tdef _file_hashes() -> dict[str, str]:\n    26\t    out: dict[str, str] = {}\n    27\t    for d in INPUT_DIRS:\n    28\t        for p in sorted((ROOT / d).rglob(\"*\")):\n    29\t            if p.is_file():\n    30\t                out[p.relative_to(ROOT).as_posix()] = hashlib.sha256(p.read_bytes()).hexdigest()\n    31\t    for f in INPUT_FILES:\n    32\t        out[f] = hashlib.sha256((ROOT / f).read_bytes()).hexdigest()\n    33\t    return out\n    34\t\n    35\t\n    36\tdef compute(image_digest: str, model: dict[str, Any]) -> tuple[str, dict[str, Any]]:\n    37\t    if not image_digest.startswith(\"sha256:\") or len(image_digest) != 71:\n    38\t        raise ValueError(\"image digest must be sha256:<64 hex>\")\n    39\t    for k in (\"provider\", \"id\", \"pinning\", \"adapter\"):\n    40\t        if k not in model:\n    41\t            raise ValueError(f\"model record missing {k}\")\n    42\t    manifest = {\"scheme\": HASH_SCHEME, \"image_digest\": image_digest, \"model\": model, \"files\": _file_hashes()}\n    43\t    canonical = json.dumps(manifest, sort_keys=True, separators=(\",\", \":\")).encode()\n    44\t    return \"sha256:\" + hashlib.sha256(canonical).hexdigest(), manifest\n    45\t\n    46\t\n    47\tdef model_record(cfg: dict[str, Any]) -> dict[str, Any]:\n    48\t    m = cfg[\"model\"]\n    49\t    return {\"provider\": m[\"provider\"], \"id\": m[\"id\"], \"pinning\": m[\"pinning\"], \"adapter\": m[\"adapter\"]}\n    50\t\n    51\t\n    52\tdef verify_or_exit(expected: str, image_digest: str, model: dict[str, Any]) -> str:\n    53\t    actual, _ = compute(image_digest, model)\n    54\t    if actual != expected:\n    55\t        print(f\"agent-type-id mismatch: expected {expected}, computed {actual}\", file=sys.stderr)\n    56\t        sys.exit(78)\n    57\t    return actual\n    58\t\n    59\t\n    60\tif __name__ == \"__main__\":\n    61\t    import yaml\n    62\t\n    63\t    cfg = yaml.safe_load((ROOT / \"config\" / \"agent.yaml\").read_text())\n    64\t    tid, man = compute(sys.argv[1], model_record(cfg))\n    65\t    json.dump({\"agent_type_id\": tid, \"inputs\": man}, sys.stdout, indent=2, sort_keys=True)\n     1\t*                         @acme/people-platform\n     2\t/prompts/                 @acme/people-platform @acme/hr-policy-reviewers\n     3\t/config/                  @acme/people-platform @acme/security-engineering\n     4\t/src/gateway.py           @acme/people-platform @acme/security-engineering\n     5\t/src/approvals.py         @acme/people-platform @acme/security-engineering\n     6\t/k8s/                     @acme/people-platform @acme/platform-security\n     7\t/migrations/              @acme/people-platform @acme/data-platform\n     8\t/release/                 @acme/people-platform @acme/security-engineering\n     9\t/.github/                 @acme/platform-security\n    10\t/CODEOWNERS               @acme/platform-security\n     1\trelease:\n     2\t  name: hr-helpdesk-agent\n     3\t  version: \"1.8.0\"\n     4\t  git_sha: \"\"            # stamped by CI\n     5\t  agent_type_id: \"\"      # stamped by CI (src/type_id.py, scheme acme-agent-type-id/v1)\n     6\t  image:\n     7\t    repository: registry.acme.example/people/hr-helpdesk-agent\n     8\t    digest: \"\"           # stamped by CI\n     9\t    signer: \"https://github.com/acme/hr-helpdesk-agent/.github/workflows/release.yml@refs/heads/main\"\n    10\t    sbom: attached (BuildKit SPDX)\n    11\t    provenance: SLSA v1 via actions/attest-build-provenance\n    12\t  owners:\n    13\t    accountable_party: \"VP People Operations\"\n    14\t    operational_owner: people-platform\n    15\t\n    16\tstakes:\n    17\t  rating: moderate\n    18\t  autonomy: low (every write requires the employee's confirmation)\n    19\t  rationale: >-\n    20\t    Reads one employee's own leave data and the handbook; writes are leave requests that a\n    21\t    manager must still approve in HRIS, and helpdesk tickets. Worst credible harm: disclosure of\n    22\t    one employee's HR data to another employee, or a misleading policy answer.\n    23\t  approved_by: \"Head of Security Engineering, 2026-09-19\"\n    24\t\n    25\tcapability_combination:\n    26\t  untrusted_input: yes (employee messages, handbook passages, tool output)\n    27\t  sensitive_access: yes (leave records, employee-specific HR documents)\n    28\t  external_change_or_send: yes (leave requests, helpdesk tickets)\n    29\t  containment: every consequential tool requires per-action employee approval bound to args\n    30\t\n    31\tharness:\n    32\t  files: [src/]\n    33\t  entrypoints: {agent: \"src.main:app\", gateway: \"src.gateway:app\"}\n    34\tsystem_prompt: {path: prompts/system.md}\n    35\trules_files: []\n    36\tconfiguration: [config/agent.yaml, config/tools.yaml]\n    37\t\n    38\tmodels:\n    39\t  primary:\n    40\t    role: main agent\n    41\t    owner: people-platform\n    42\t    identity: {provider: anthropic, id: claude-sonnet-4-5-20250929, pinning: snapshot, adapter: none}\n    43\t    pinning_source: \"Anthropic models overview, checked 2026-09-15\"\n    44\t    served_version: recorded per call in audit.events.model_served\n    45\t    fine_tune: none\n    46\t    training_runs: not applicable\n    47\t    training_data: provider-undisclosed\n    48\t  helpers: []            # retrieval is Postgres full-text search; no embedding or reranker model\n    49\t\n    50\ttools:\n    51\t  built_in: []\n    52\t  local: [search_policies]\n    53\t  mcp_servers:\n    54\t    - {id: hris, identity: \"spiffe://acme.example/ns/hris/sa/hris-mcp\", owner: hris-platform, tools: [get_leave_balance, file_leave_request]}\n    55\t    - {id: helpdesk, identity: \"spiffe://acme.example/ns/helpdesk/sa/helpdesk-mcp\", owner: it-service-desk, tools: [create_ticket]}\n    56\t  policy_version_source: config/tools.yaml#policy_version\n    57\t\n    58\tpermissions:\n    59\t  sts_scopes: [hr.policy.read, hris.leave.read, hris.leave.request, helpdesk.ticket.create]\n    60\t  token_ttl_seconds: 300\n    61\t  database_role: hr_agent (see migrations/001_init.sql grants)\n    62\t\n    63\tmemory: none (conversation state is held per run and discarded; no cross-run memory)\n    64\tretrieval:\n    65\t  store: retrieval.chunks (Postgres FTS)\n    66\t  writers: [hr_docs_ingest]\n    67\t  filters: [quarantined, expires_at, audience/allowed_employees]\n    68\t\n    69\tidentity_bindings:\n    70\t  agent: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n    71\t  gateway: spiffe://acme.example/ns/hr-agent/sa/hr-tool-gateway\n    72\t\n    73\tnetwork: [k8s/networkpolicy.yaml]\n    74\tadmission: [k8s/admission.yaml]\n    75\tbudgets: config/agent.yaml#budgets\n    76\t\n    77\taudit:\n    78\t  store: audit.events, audit.gateway_decisions (Postgres, weekly partitions)\n    79\t  retention: 6 months\n    80\t  readers: hr_audit_reader\n     1\tagent:\n     2\t  name: hr-helpdesk\n     3\t  accountable_party: \"VP People Operations <people-ops-lead@acme.example>\"\n     4\t  operational_owner: \"people-platform (pager: people-platform-oncall)\"\n     5\t  tenant: acme\n     6\t  workload_identity: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n     7\t\n     8\tmodel:\n     9\t  provider: anthropic\n    10\t  id: claude-sonnet-4-5-20250929\n    11\t  pinning: snapshot          # dated snapshot ID per provider model docs, checked 2026-09-15\n    12\t  adapter: none\n    13\t  max_output_tokens: 1024\n    14\t  temperature: 0.2\n    15\t\n    16\tbudgets:\n    17\t  run:\n    18\t    max_steps: 12\n    19\t    max_wall_seconds: 90\n    20\t    max_total_tokens: 60000\n    21\t    max_cost_usd: 0.40\n    22\t    max_tool_calls_per_minute: 20\n    23\t    max_subagents: 0\n    24\t  quotas:\n    25\t    - scope: user\n    26\t      window_seconds: 86400\n    27\t      max_runs: 150\n    28\t      max_tokens: 400000\n    29\t      max_cost_usd: 3.00\n    30\t    - scope: tenant\n    31\t      window_seconds: 3600\n    32\t      max_runs: 20000\n    33\t      max_tokens: 15000000\n    34\t      max_cost_usd: 250.00\n    35\t    - scope: fleet\n    36\t      window_seconds: 3600\n    37\t      max_runs: 25000\n    38\t      max_tokens: 20000000\n    39\t      max_cost_usd: 300.00\n    40\t\n    41\tpricing:\n    42\t  input_per_mtok: 3.00\n    43\t  output_per_mtok: 15.00\n    44\t  cache_read_per_mtok: 0.30\n    45\t\n    46\tapprovals:\n    47\t  ttl_seconds: 600\n    48\t\n    49\tstop:\n    50\t  poll_seconds: 2\n    51\t  max_stop_seconds: 10\n    52\t\n    53\tretrieval:\n    54\t  top_k: 5\n    55\t  cache_ttl_seconds: 900\n    56\t  max_chunk_chars: 4000\n    57\t\n    58\tlimits:\n    59\t  max_tool_output_bytes: 16384\n    60\t  max_user_message_chars: 4000\n    61\t\n    62\toutput:\n    63\t  allowed_link_hosts: [hr.acme.example, handbook.acme.example]\n     1\tname: release\n     2\t\n     3\ton:\n     4\t  push:\n     5\t    branches: [main]\n     6\t\n     7\tpermissions:\n     8\t  contents: read\n     9\t\n    10\tjobs:\n    11\t  build:\n    12\t    runs-on: ubuntu-24.04\n    13\t    environment: production   # requires approval from @acme/people-platform-release\n    14\t    permissions:\n    15\t      contents: read\n    16\t      packages: write\n    17\t      id-token: write\n    18\t      attestations: write\n    19\t    env:\n    20\t      PYTHONDONTWRITEBYTECODE: \"1\"\n    21\t      IMAGE: registry.acme.example/people/hr-helpdesk-agent\n    22\t    steps:\n    23\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    24\t      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0\n    25\t        with: {python-version: \"3.12.7\"}\n    26\t      - uses: sigstore/cosign-installer@d58896d6a1865668819e1d91763c7751a165e159 # v3.9.2\n    27\t        with: {cosign-release: \"v2.6.2\"}\n    28\t      - run: pip install --require-hashes -r requirements.txt\n    29\t      - run: python -m pytest -q tests/release\n    30\t      - name: Build and push\n    31\t        id: build\n    32\t        uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0\n    33\t        with:\n    34\t          push: true\n    35\t          tags: ${{ env.IMAGE }}:${{ github.sha }}\n    36\t          sbom: true\n    37\t          provenance: mode=max\n    38\t      - name: Sign image\n    39\t        run: cosign sign --yes \"${IMAGE}@${{ steps.build.outputs.digest }}\"\n    40\t      - uses: actions/attest-build-provenance@e8998f949152b193b063cb0ec769d69d929409be # v2.4.0\n    41\t        with:\n    42\t          subject-name: ${{ env.IMAGE }}\n    43\t          subject-digest: ${{ steps.build.outputs.digest }}\n    44\t          push-to-registry: true\n    45\t      - name: Compute agent-type-id\n    46\t        id: typeid\n    47\t        run: |\n    48\t          python -m src.type_id \"${{ steps.build.outputs.digest }}\" > type-id.json\n    49\t          echo \"id=$(jq -r .agent_type_id type-id.json)\" >> \"$GITHUB_OUTPUT\"\n    50\t      - name: Stamp release manifest\n    51\t        run: |\n    52\t          yq -i '.release.agent_type_id = \"${{ steps.typeid.outputs.id }}\" |\n    53\t                 .release.image.digest = \"${{ steps.build.outputs.digest }}\" |\n    54\t                 .release.git_sha = \"${{ github.sha }}\"' release/manifest.yaml\n    55\t      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\n    56\t        with:\n    57\t          name: release-${{ github.sha }}\n    58\t          path: [type-id.json, release/manifest.yaml]\n    59\t\n    60\t  deploy:\n    61\t    needs: build\n    62\t    runs-on: ubuntu-24.04\n    63\t    environment: production\n    64\t    permissions: {contents: read, id-token: write}\n    65\t    steps:\n    66\t      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n    67\t      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0\n    68\t        with: {name: \"release-${{ github.sha }}\"}\n    69\t      - name: Render and apply\n    70\t        run: |\n    71\t          export IMAGE_DIGEST=$(yq -r .release.image.digest release/manifest.yaml)\n    72\t          export AGENT_TYPE_ID=$(yq -r .release.agent_type_id release/manifest.yaml)\n    73\t          export GIT_SHA=${{ github.sha }}\n    74\t          for f in k8s/*.yaml; do envsubst '$IMAGE_DIGEST $AGENT_TYPE_ID $GIT_SHA' < \"$f\"; echo '---'; done \\\n    75\t            | kubectl apply --server-side -f -\n     1\t\"\"\"Agent loop for the HR helpdesk.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport json\n     5\timport logging\n     6\timport pathlib\n     7\timport uuid\n     8\tfrom dataclasses import dataclass, field\n     9\tfrom datetime import date\n    10\tfrom typing import Any\n    11\t\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    16\tfrom .audit import AuditWriter, RunContext\n    17\tfrom .budgets import BudgetExceeded, QuotaStore, RunBudget\n    18\tfrom .gateway_client import GatewayClient, ToolDenied, ToolError\n    19\tfrom .killswitch import StopControl\n    20\tfrom .redact import redact\n    21\tfrom .retrieval import PolicyIndex\n    22\tfrom .tools import ToolRegistry, ToolSpec\n    23\tfrom .validation import ValidationRejected, validate_chunk, validate_tool_args, validate_tool_output\n    24\t\n    25\tlog = logging.getLogger(\"hr_agent.loop\")\n    26\ttracer = trace.get_tracer(\"hr_agent\")\n    27\t\n    28\tSYSTEM_PROMPT = (pathlib.Path(__file__).resolve().parent.parent / \"prompts\" / \"system.md\").read_text()\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass RunState:\n    33\t    messages: list[dict[str, Any]]\n    34\t    budget: RunBudget\n    35\t    subject_token: str\n    36\t    status: str = \"running\"\n    37\t    reply: str | None = None\n    38\t    pending_approval: dict[str, Any] | None = None\n    39\t    last_step: str | None = None\n    40\t    subagents_started: int = 0\n    41\t    extra: dict[str, Any] = field(default_factory=dict)\n    42\t\n    43\t\n    44\tclass Agent:\n    45\t    def __init__(self, cfg: dict[str, Any], registry: ToolRegistry, llm: AsyncAnthropic, gateway: GatewayClient,\n    46\t                 index: PolicyIndex, approvals: ApprovalStore, quotas: QuotaStore, audit: AuditWriter, stop: StopControl):\n    47\t        self.cfg, self.registry, self.llm, self.gateway = cfg, registry, llm, gateway\n    48\t        self.index, self.approvals, self.quotas, self.audit, self.stop = index, approvals, quotas, audit, stop\n    49\t\n    50\t    def new_state(self, user_text: str, subject_token: str) -> RunState:\n    51\t        budget = RunBudget(self.cfg[\"budgets\"][\"run\"], self.cfg[\"pricing\"])\n    52\t        return RunState(messages=[{\"role\": \"user\", \"content\": user_text}], budget=budget, subject_token=subject_token)\n    53\t\n    54\t    async def run(self, ctx: RunContext, state: RunState) -> RunState:\n    55\t        with tracer.start_as_current_span(\"agent.run\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n    56\t            try:\n    57\t                await self._loop(ctx, state)\n    58\t            except BudgetExceeded as exc:\n    59\t                await self.audit.record(ctx, \"budget_stop\", decision=\"stop\", reason=exc.limit, parent_step_id=state.last_step)\n    60\t                state.status, state.reply = \"stopped\", \"I've reached the limit for this conversation. An HR advisor can help further.\"\n    61\t            return state\n    62\t\n    63\t    async def _loop(self, ctx: RunContext, state: RunState) -> None:\n    64\t        model = self.cfg[\"model\"]\n    65\t        while True:\n    66\t            await self.stop.raise_if_stopped(ctx)\n    67\t            state.budget.check_step()\n    68\t            step_id = str(uuid.uuid4())\n    69\t            with tracer.start_as_current_span(\"gen_ai.chat\", attributes={\"gen_ai.request.model\": model[\"id\"]}):\n    70\t                resp = await self.llm.messages.create(\n    71\t                    model=model[\"id\"], system=SYSTEM_PROMPT, max_tokens=model[\"max_output_tokens\"],\n    72\t                    temperature=model[\"temperature\"], tools=self.registry.model_schemas(), messages=state.messages,\n    73\t                    timeout=state.budget.remaining_seconds(),\n    74\t                )\n    75\t                tokens, cost = state.budget.record_usage(resp.usage)\n    76\t                ctx_tokens = resp.usage.input_tokens + (resp.usage.cache_read_input_tokens or 0) + (resp.usage.cache_creation_input_tokens or 0)\n    77\t                await self.audit.record(\n    78\t                    ctx, \"model_call\", step_id=step_id, parent_step_id=state.last_step,\n    79\t                    context_tokens=ctx_tokens, context_tokens_method=\"measured:provider_usage_input+cache_read+cache_write\",\n    80\t                    model_requested=model[\"id\"], model_served=resp.model, result={\"stop_reason\": resp.stop_reason},\n    81\t                )\n    82\t                await self.quotas.record_usage(ctx, tokens, cost)\n    83\t            state.last_step = step_id\n    84\t            state.messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n    85\t            if resp.stop_reason != \"tool_use\":\n    86\t                state.status = \"done\"\n    87\t                state.reply = \"\".join(b.text for b in resp.content if b.type == \"text\")\n    88\t                return\n    89\t            results = []\n    90\t            for block in (b for b in resp.content if b.type == \"tool_use\"):\n    91\t                result = await self._handle_tool(ctx, state, step_id, block.id, block.name, block.input)\n    92\t                if result is None:  # paused for employee approval\n    93\t                    return\n    94\t                results.append(result)\n    95\t            state.messages.append({\"role\": \"user\", \"content\": results})\n    96\t\n    97\t    async def _handle_tool(self, ctx: RunContext, state: RunState, parent: str, tool_use_id: str,\n    98\t                           name: str, args: Any) -> dict[str, Any] | None:\n    99\t        step_id = str(uuid.uuid4())\n   100\t        await self.audit.record(ctx, \"proposed_action\", step_id=step_id, parent_step_id=parent, tool=name, args=args)\n   101\t        spec = self.registry.get(name)\n   102\t        if spec is None:\n   103\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=name, decision=\"deny\", reason=\"tool not in allowlist\")\n   104\t            return _tool_result(tool_use_id, \"This tool is not available.\", error=True)\n   105\t        target = spec.target(ctx.subject)\n   106\t        state.budget.check_tool_call()\n   107\t        try:\n   108\t            args = validate_tool_args(spec, args)\n   109\t        except ValidationRejected as exc:\n   110\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0114QkJ3KfH5gmWHXkHDdSVY","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
