\": \"tools/call\",\n89+89\t                   \"Mcp-Name\": name, \"Idempotency-Key\": request.headers.get(\"idempotency-key\", \"\"),\n90+89\t                   \"traceparent\": request.headers.get(\"traceparent\", \"\")}\n91+89\t        upstream = await _upstream.post(registry.servers[spec.server][\"endpoint\"], headers=headers, timeout=8.0,\n92+89\t                                        json={**body, \"params\": {\"name\": name, \"arguments\": params[\"arguments\"]}})\n93+89\t        if upstream.status_code >= 400:\n94+89\t            await _log(request, claims, tool, \"error\", f\"upstream {upstream.status_code}\")\n95+89\t            return JSONResponse({\"error\": \"upstream_error\", \"detail\": upstream.text[:2000]}, status_code=502)\n96+89\t        result = upstream.json()\n97+89\t        structured = result.get(\"result\", {}).get(\"structuredContent\")\n98+89\t        if structured is None or list(Draft202012Validator(spec.output_schema).iter_errors(structured)):\n99+89\t            await _log(request, claims, tool, \"error\", \"response failed schema\")\n100+89\t            return JSONResponse({\"error\": \"invalid_upstream_response\", \"detail\": \"schema\"}, status_code=502)\n101+89\t        await _log(request, claims, tool, \"allow\", \"ok\")\n102+89\t        return JSONResponse(result)\n103+89\t    except Exception as exc:\n104+89\t        log.exception(\"gateway check failed\", extra={\"tool\": tool})\n105+89\t        try:\n106+89\t            await _log(request, claims, tool, \"deny\", f\"internal: {type(exc).__name__}\")\n107+89\t        except Exception:\n108+89\t            pass\n109+89\t        return JSONResponse({\"error\": \"policy_unavailable\"}, status_code=503)\n110+89\t\n111+89\t\n112+89\tasync def _startup() -> None:\n113+89\t    global _pool, _upstream\n114+89\t    _pool = await asyncpg.create_pool(os.environ[\"GATEWAY_DATABASE_URL\"], min_size=1, max_size=10)\n115+89\t    _upstream = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\",