{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QkeoWJUJvG8RMAxtdtrwQ9","type":"tool_result","content":"1+149\t        return JSONResponse({\"error\": error}, status_code=status)\n2+149\t\n3+149\t    try:\n4+149\t        body = await request.json()\n5+149\t        if body.get(\"method\") != \"tools/call\":\n6+149\t            return await deny(403, \"method_not_allowed\", f\"method {body.get('method')}\")\n7+149\t        params = body[\"params\"]\n8+149\t        name = params[\"name\"]\n9+149\t        tool = f\"{params['_meta']['server']}/{name}\"\n10+149\t        if request.headers.get(\"mcp-method\") != \"tools/call\" or request.headers.get(\"mcp-name\") != name:\n11+149\t            return await deny(400, \"header_body_mismatch\", \"Mcp-Name/Mcp-Method differ from body\")\n12+149\t        try:\n13+149\t            claims = _verify(request)\n14+149\t        except (jwt.PyJWTError, PermissionError) as exc:\n15+149\t            return await deny(401, \"unauthenticated\", f\"authn: {exc}\")\n16+149\t        spec = registry.by_qualified(tool)\n17+149\t        if spec is None or spec.kind != \"mcp\" or tool in _disabled:\n18+149\t            return await deny(403, \"tool_not_allowed\", \"not in allowlist or disabled\")\n19+149\t        if spec.scope not in claims[\"scope\"].split():\n20+149\t            return await deny(403, \"insufficient_scope\", \"scope\")\n21+149\t        instance = request.headers.get(\"x-agent-instance\", \"\")\n22+149\t        if why := await _stop_reason(claims, instance):\n23+149\t            return await deny(403, \"stopped\", f\"stopped: {why}\")\n24+149\t        if not (_rate_ok(\"instance\", instance) and _rate_ok(\"subject\", claims[\"sub\"])):\n25+149\t            return await deny(429, \"rate_limited\", \"rate limit\")\n26+149\t        if errs := list(Draft202012Validator(spec.input_schema, format_checker=FormatChecker()).iter_errors(params[\"arguments\"])):\n27+149\t            return await deny(403, \"invalid_arguments\", f\"args: {errs[0].message}\")\n28+149\t        headers = {\"Authorization\": f\"Bearer {await _downstream_token(spec, claims)}\", \"Mcp-Method\": \"tools/call\",\n29+149\t                   \"Mcp-Name\": name, \"Idempotency-Key\": request.headers.get(\"idempotency-key\", \"\"),\n30+149\t                   \"traceparent\": request.headers.get(\"traceparent\", \"\")}\n31+149\t        upstream = await _upstream.post(registry.servers[spec.server][\"endpoint\"], headers=headers, timeout=8.0,\n32+149\t                                        json={**body, \"params\": {\"name\": name, \"arguments\": params[\"arguments\"]}})\n33+149\t        if upstream.status_code >= 400:\n34+149\t            await _log(request, claims, tool, \"error\", f\"upstream {upstream.status_code}\")\n35+149\t            return JSONResponse({\"error\": \"upstream_error\", \"detail\": upstream.text[:2000]}, status_code=502)\n36+149\t        result = upstream.json()\n37+149\t        structured = result.get(\"result\", {}).get(\"structuredContent\")\n38+149\t        if structured is None or list(Draft202012Validator(spec.output_schema).iter_errors(structured)):\n39+149\t            await _log(request, claims, tool, \"error\", \"response failed schema\")\n40+149\t            return JSONResponse({\"error\": \"invalid_upstream_response\", \"detail\": \"schema\"}, status_code=502)\n41+149\t        await _log(request, claims, tool, \"allow\", \"ok\")\n42+149\t        return JSONResponse(result)\n43+149\t    except Exception as exc:\n44+149\t        log.exception(\"gateway check failed\", extra={\"tool\": tool})\n45+149\t        try:\n46+149\t            await _log(request, claims, tool, \"deny\", f\"internal: {type(exc).__name__}\")\n47+149\t        except Exception:\n48+149\t            pass\n49+149\t        return JSONResponse({\"error\": \"policy_unavailable\"}, status_code=503)\n50+149\t\n51+149\t\n52+149\tasync def _startup() -> None:\n53+149\t    global _pool, _upstream\n54+149\t    _pool = await asyncpg.create_pool(os.environ[\"GATEWAY_DATABASE_URL\"], min_size=1, max_size=10)\n55+149\t    _upstream = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\", cert=(\"/etc/svid/svid.pem\", \"/etc/svid/svid_key.pem\"))\n56+149\t\n57+149\t    async def _loop() -> None:\n58+149\t        while True:\n59+149\t            try:\n60+149\t                await refresh_fingerprints()\n61+149\t            except Exception:\n62+149\t                log.exception(\"fingerprint refresh failed; disabling MCP tools\")\n63+149\t                _disabled.update(s.qualified for s in MCP_TOOLS)\n64+149\t            await asyncio.sleep(300)\n65+149\t\n66+149\t    asyncio.get_running_loop().create_task(_loop())\n67+149\t\n68+149\t\n69+149\tapp = Starlette(routes=[Route(\"/mcp\", mcp, methods=[\"POST\"])], on_startup=[_startup])\nEscalations are delivered even during gateway maintenance windows.\n\n## Stopping the agent\n\nOperators with the `hr_agent_operator` DB role insert into `control.stop_flags`:\n\n```sql\nINSERT INTO control.stop_flags (scope, value, reason) VALUES ('fleet', NULL, 'incident 2291');\n-- or scope 'agent_type' / 'agent_instance' / 'subject' / 'agent_principal'\n```\n\nRunning agents see the flag within 2 seconds and cancel in-flight work; the gateway refuses\ncalls immediately. Target stop time: 10 seconds. The agent's DB role can only read this table.\nLast drill: see `docs/drills/` in the ops repo.\n\n## Audit retention\n\n        SELECT c.oid::regclass AS rel FROM pg_inherits i JOIN pg_class c ON c.oid = i.inhrelid\n         WHERE i.inhparent = parent ORDER BY c.relname DESC OFFSET keep + ahead + 1\n    LOOP\n        EXECUTE format('DROP TABLE %s', part.rel);\n    END LOOP;\nEND $$;\n\nCREATE TABLE control.stop_flags (\n    flag_id bigserial PRIMARY KEY,\n    scope text NOT NULL CHECK (scope IN ('fleet', 'agent_type', 'agent_instance', 'subject', 'agent_principal')),\n    value text, active boolean NOT NULL DEFAULT true, reason text NOT NULL,\n    set_by text NOT NULL DEFAULT current_user, set_at timestamptz NOT NULL DEFAULT now()\n);\n\nCREATE TABLE approvals.grants (\n    approval_id uuid PRIMARY KEY, run_id uuid NOT NULL, agent_instance_id text NOT NULL, subject text NOT NULL,\n    operation text NOT NULL, target text NOT NULL, args_sha256 char(64) NOT NULL, args jsonb NOT NULL,\n    tool_use_id text NOT NULL, description text NOT NULL,\n    requested_at timestamptz NOT NULL, expires_at timestamptz NOT NULL,\n    approved_by text, approved_at timestamptz, used_at timestamptz\n);\n\nCREATE TABLE quota.usage (\n    scope text NOT NULL, key text NOT NULL, window_start timestamptz NOT NULL,\n    runs integer NOT NULL DEFAULT 0, tokens bigint NOT NULL DEFAULT 0, cost_usd numeric(12, 4) NOT NULL DEFAULT 0,\n    PRIMARY KEY (scope, key, window_start)\n);\n\nCREATE TABLE retrieval.index_state (id int PRIMARY KEY CHECK (id = 1), version text NOT NULL);\nCREATE TABLE retrieval.chunks (\n    chunk_id text PRIMARY KEY, doc_id text NOT NULL, source text NOT NULL,\n    added_at timestamptz NOT NULL DEFAULT now(), added_by text NOT NULL DEFAULT current_user,\n    trust text NOT NULL CHECK (trust IN ('reviewed', 'hr_authored')),\n    audience text NOT NULL CHECK (audience IN ('all', 'employee')),\n    allowed_employees text[] NOT NULL DEFAULT '{}',\n    expires_at timestamptz, quarantined boolean NOT NULL DEFAULT false, text text NOT NULL,\n    tsv tsvector GENERATED ALWAYS AS (to_tsvector('english', text)) STORED\n);\nCREATE INDEX ON retrieval.chunks USING gin (tsv);\n\nGRANT USAGE ON SCHEMA audit, control, approvals, quota, retrieval TO hr_agent;\nGRANT INSERT ON audit.events TO hr_agent;\nGRANT SELECT ON control.stop_flags TO hr_agent;\nGRANT SELECT, INSERT ON approvals.grants TO hr_agent;\nGRANT UPDATE (approved_by, approved_at, used_at) ON approvals.grants TO hr_agent;\nGRANT SELECT, INSERT, UPDATE ON quota.usage TO hr_agent;\nGRANT SELECT ON retrieval.chunks, retrieval.index_state TO hr_agent;\n\nGRANT USAGE ON SCHEMA au