{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01918RDsWPAyHcpist5zupHb","type":"tool_result","content":"     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport logging\n     6\timport os\n     7\timport uuid\n     8\t\n     9\timport asyncpg\n    10\timport httpx\n    11\timport jwt\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n    15\tfrom opentelemetry.sdk.resources import Resource\n    16\tfrom opentelemetry.sdk.trace import TracerProvider\n    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n    18\tfrom starlette.applications import Starlette\n    19\tfrom starlette.requests import Request\n    20\tfrom starlette.responses import JSONResponse\n    21\tfrom starlette.routing import Route\n    22\t\n    23\tfrom . import type_id\n    24\tfrom .agent import Agent, RunState\n    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n    27\tfrom .budgets import BudgetExceeded, QuotaStore\n    28\tfrom .credentials import CredentialBroker\n    29\tfrom .gateway_client import GatewayClient\n    30\tfrom .killswitch import Stopped, StopControl\n    31\tfrom .redact import RedactingFilter\n    32\tfrom .retrieval import PolicyIndex\n    33\tfrom .tools import ToolRegistry, load_yaml\n    34\tfrom .validation import sanitize_reply\n    35\t\n    36\tSSO_ISSUER = \"https://sso.acme.example\"\n    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    39\t\n    40\tlogging.basicConfig(level=logging.INFO)\n    41\tfor h in logging.getLogger().handlers:\n    42\t    h.addFilter(RedactingFilter())\n    43\tlog = logging.getLogger(\"hr_agent\")\n    44\t\n    45\tCFG = load_yaml(\"agent.yaml\")\n    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n    47\tPOD_ID = os.environ[\"POD_UID\"]\n    48\t\n    49\tprovider = TracerProvider(resource=Resource.create({\n    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n    51\t}))\n    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n    53\ttrace.set_tracer_provider(provider)\n    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n    55\t\n    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n    57\tagent: Agent\n    58\taudit: AuditWriter\n    59\tapprovals: ApprovalStore\n    60\tstop: StopControl\n    61\t\n    62\t\n    63\tdef _employee(request: Request) -> tuple[str, str]:\n    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n    65\t    auth = request.headers.get(\"authorization\", \"\")\n    66\t    if not auth.startswith(\"Bearer \"):\n    67\t        raise PermissionError(\"missing token\")\n    68\t    token = auth[7:]\n    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n    72\t        raise PermissionError(\"wrong organisation\")\n    73\t    return claims[\"employee_id\"], token\n    74\t\n    75\t\n    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n    77\t    a = CFG[\"agent\"]\n    78\t    return RunContext(\n    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n    81\t        agent_principal=a[\"workload_identity\"],\n    82\t    )\n    83\t\n    84\t\n    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n    86\t    task = asyncio.ensure_future(coro)\n    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n    88\t    try:\n    89\t        return await task\n    90\t    except asyncio.CancelledError:\n    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n    92\t        return None\n    93\t    except Stopped as exc:\n    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n    95\t        return None\n    96\t    finally:\n    97\t        watcher.cancel()\n    98\t\n    99\t\n   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n   101\t    if state is None:\n   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n   105\t    if state.pending_approval:\n   106\t        body[\"approval\"] = state.pending_approval\n   107\t    return JSONResponse(body)\n   108\t\n   109\t\n   110\tasync def chat(request: Request) -> JSONResponse:\n   111\t    try:\n   112\t        employee_id, token = _employee(request)\n   113\t    except (jwt.PyJWTError, PermissionError):\n   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n   116\t    run_id = str(uuid.uuid4())\n   117\t    ctx = _context(run_id, employee_id)\n   118\t    with tracer.start_as_current_span(\"chat\"):\n   119\t        try:\n   120\t            await agent.quotas.reserve_run(ctx)\n   121\t            state = agent.new_state(text, token)\n   122\t            _runs[run_id] = (ctx, state)\n   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n   124\t            state = await _drive(ctx, agent.run(ctx, state))\n   125\t        except BudgetExceeded as exc:\n   126\t            await audit.record(ctx, \"quota_denied\", decision=\"deny\", reason=exc.limit)\n   127\t            return JSONResponse({\"error\": \"quota_exceeded\"}, status_code=429)\n   128\t        except AuditUnavailable:\n   129\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   130\t        except Exception as exc:\n   131\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__)\n   132\t            raise\n   133\t        return _reply(run_id, state)\n   134\t\n   135\t\n   136\tasync def confirm(request: Request) -> JSONResponse:\n   137\t    try:\n   138\t        employee_id, token = _employee(request)\n   139\t    except (jwt.PyJWTError, PermissionError):\n   140\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   141\t    run_id, approval_id = request.path_params[\"run_id\"], request.path_params[\"approval_id\"]\n   142\t    entry = _runs.get(run_id)\n   143\t    if entry is None or entry[0].subject != employee_id:\n   144\t        return JSONResponse({\"error\": \"not_found\"}, status_code=404)\n   145\t    ctx, state = entry\n   146\t    state.subject_token = token\n   147\t    with tracer.start_as_current_span(\"approval.confirm\"):\n   148\t        try:\n   149\t            await approvals.confirm(approval_id, employee_id)\n   150\t            await audit.record(ctx, \"approval_granted\", decision=\"allow\", approval_id=approval_id)\n   151\t            state = await _drive(ctx, agent.resume_with_approval(ctx, state, approval_id))\n   152\t        except ApprovalInvalid as exc:\n   153\t            await audit.record(ctx, \"approval_rejected\", decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   154\t            return JSONResponse({\"error\": \"approval_invalid\"}, status_code=409)\n   155\t        except AuditUnavailable:\n   156\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   157\t        except Exception as exc:\n   158\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__, approval_id=approval_id)\n   159\t            raise\n   160\t        return _reply(run_id, state)\n   161\t\n   162\t\n   163\tasync def startup() -> None:\n   164\t    global agent, audit, approvals, stop\n   165\t    pool = await asyncpg.create_pool(os.environ[\"DATABASE_URL\"], min_size=2, max_size=20)\n   166\t    registry = ToolRegistry.from_config()\n   167\t    mtls = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\", cert=(\"/etc/svid/svid.pem\", \"/etc/svid/svid_key.pem\"))\n   168\t    audit = AuditWriter(pool, registry.policy_version)\n   169\t    approvals = ApprovalStore(pool, CFG[\"approvals\"][\"ttl_seconds\"])\n   170\t    stop = StopControl(pool, CFG[\"stop\"][\"poll_seconds\"])\n   171\t    agent = Agent(\n   172\t        CFG, registry, AsyncAnthropic(max_retries=1), GatewayClient(mtls, CredentialBroker(mtls)),\n   173\t        PolicyIndex(pool, CFG[\"retrieval\"][\"top_k\"], CFG[\"retrieval\"][\"cache_ttl_seconds\"]),\n   174\t        approvals, QuotaStore(pool, CFG[\"budgets\"][\"quotas\"]), audit, stop,\n   175\t    )\n   176\t\n   177\t\n   178\tapp = Starlette(\n   179\t    routes=[\n   180\t        Route(\"/v1/chat\", chat, methods=[\"POST\"]),\n   181\t        Route(\"/v1/runs/{run_id}/approvals/{approval_id}/confirm\", confirm, methods=[\"POST\"]),\n   182\t    ],\n   183\t    on_startup=[startup],\n   184\t)\n     1\t\"\"\"Calls MCP tools through the hr-tool-gateway.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport logging\n     5\timport uuid\n     6\tfrom typing import Any\n     7\t\n     8\timport httpx\n     9\tfrom opentelemetry.propagate import inject\n    10\t\n    11\tfrom .audit import RunContext\n    12\tfrom .credentials import CredentialBroker\n    13\tfrom .tools import ToolSpec\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.gateway_client\")\n    16\t\n    17\tGATEWAY_URL = \"https://hr-tool-gateway.hr-agent.svc.cluster.local:8443/mcp\"\n    18\tGATEWAY_AUDIENCE = \"hr-tool-gateway\"\n    19\t\n    20\t\n    21\tclass ToolDenied(Exception):\n    22\t    def __init__(self, reason: str):\n    23\t        super().__init__(reason)\n    24\t        self.reason = reason\n    25\t\n    26\t\n    27\tclass ToolError(Exception):\n    28\t    def __init__(self, status: int, detail: str):\n    29\t        super().__init__(f\"{status}\")\n    30\t        self.status = status\n    31\t        self.detail = detail\n    32\t\n    33\t\n    34\tclass GatewayUnavailable(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass GatewayClient:\n    39\t    def __init__(self, client: httpx.AsyncClient, creds: CredentialBroker):\n    40\t        self._client = client\n    41\t        self._creds = creds\n    42\t\n    43\t    async def call(\n    44\t        self, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, subject_token: str, *, operation_id: str\n    45\t    ) -> dict[str, Any]:\n    46\t        try:\n    47\t            token = await self._creds.token(\n    48\t                audience=GATEWAY_AUDIENCE, scope=spec.scope, subject_token=subject_token, subject=ctx.subject\n    49\t            )\n    50\t            return await self._post(GATEWAY_URL, token, spec, args, ctx, operation_id)\n    51\t        except GatewayUnavailable:\n    52\t            if not spec.direct_route:\n    53\t                raise\n    54\t            log.warning(\"gateway unavailable, using direct route\", extra={\"tool\": spec.qualified})\n    55\t            token = await self._creds.token(\n    56\t                audience=spec.direct_route[\"audience\"], scope=spec.scope,\n    57\t                subject_token=subject_token, subject=ctx.subject,\n    58\t            )\n    59\t            return await self._post(spec.direct_route[\"endpoint\"], token, spec, args, ctx, operation_id)\n    60\t\n    61\t    async def _post(\n    62\t        self, url: str, token: str, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, operation_id: str\n    63\t    ) -> dict[str, Any]:\n    64\t        tool_name = spec.qualified.split(\"/\", 1)[1]\n    65\t        headers = {\n    66\t            \"Authorization\": f\"Bearer {token}\",\n    67\t            \"Mcp-Method\": \"tools/call\",\n    68\t            \"Mcp-Name\": tool_name,\n    69\t            \"Idempotency-Key\": operation_id,\n    70\t            \"X-Agent-Instance\": ctx.agent_instance_id,\n    71\t            \"X-Agent-Type-Id\": ctx.agent_type_id,\n    72\t        }\n    73\t        inject(headers)\n    74\t        body = {\n    75\t            \"jsonrpc\": \"2.0\",\n    76\t            \"id\": str(uuid.uuid4()),\n    77\t            \"method\": \"tools/call\",\n    78\t            \"params\": {\"name\": tool_name, \"arguments\": args, \"_meta\": {\"server\": spec.server}},\n    79\t        }\n    80\t        try:\n    81\t            resp = await self._client.post(url, json=body, headers=headers, timeout=10.0)\n    82\t        except (httpx.ConnectError, httpx.ConnectTimeout) as exc:\n    83\t            raise GatewayUnavailable(str(exc)) from exc\n    84\t        except httpx.TimeoutException as exc:\n    85\t            raise ToolError(504, f\"no response; outcome unknown for operation {operation_id}\") from exc\n    86\t        if resp.status_code == 503:\n    87\t            raise GatewayUnavailable(resp.text[:200])\n    88\t        if resp.status_code in (401, 403, 429):\n    89\t            raise ToolDenied(resp.json().get(\"error\", \"denied\"))\n    90\t        if resp.status_code >= 400:\n    91\t            raise ToolError(resp.status_code, resp.json().get(\"detail\", resp.text))\n    92\t        payload = resp.json()\n    93\t        if \"error\" in payload:\n    94\t            raise ToolError(200, str(payload[\"error\"].get(\"message\", \"\")))\n    95\t        return payload[\"result\"][\"structuredContent\"]\n     1\t\"\"\"Hard limits enforced by the harness, outside the model.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport time\n     5\tfrom collections import deque\n     6\tfrom dataclasses import dataclass, field\n     7\tfrom typing import Any\n     8\t\n     9\timport asyncpg\n    10\t\n    11\tfrom .audit import RunContext\n    12\t\n    13\t\n    14\tclass BudgetExceeded(Exception):\n    15\t    def __init__(self, limit: str):\n    16\t        super().__init__(limit)\n    17\t        self.limit = limit\n    18\t\n    19\t\n    20\t@dataclass\n    21\tclass RunBudget:\n    22\t    cfg: dict[str, Any]\n    23\t    pricing: dict[str, float]\n    24\t    started: float = field(default_factory=time.monotonic)\n    25\t    steps: int = 0\n    26\t    tokens: int = 0\n    27\t    cost_usd: float = 0.0\n    28\t    tool_calls: deque = field(default_factory=deque)\n    29\t\n    30\t    def check_step(self) -> None:\n    31\t        if self.steps >= self.cfg[\"max_steps\"]:\n    32\t            raise BudgetExceeded(\"max_steps\")\n    33\t        if time.monotonic() - self.started > self.cfg[\"max_wall_seconds\"]:\n    34\t            raise BudgetExceeded(\"max_wall_seconds\")\n    35\t        if self.tokens >= self.cfg[\"max_total_tokens\"]:\n    36\t            raise BudgetExceeded(\"max_total_tokens\")\n    37\t        if self.cost_usd >= self.cfg[\"max_cost_usd\"]:\n    38\t            raise BudgetExceeded(\"max_cost_usd\")\n    39\t        self.steps += 1\n    40\t\n    41\t    def remaining_seconds(self) -> float:\n    42\t        return max(0.0, self.cfg[\"max_wall_seconds\"] - (time.monotonic() - self.started))\n    43\t\n    44\t    def record_usage(self, usage: Any) -> tuple[int, float]:\n    45\t        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n    46\t        cache_write = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n    47\t        tokens_in = usage.input_tokens + cache_read + cache_write\n    48\t        tokens = tokens_in + usage.output_tokens\n    49\t        cost = (\n    50\t            (usage.input_tokens + cache_write) * self.pricing[\"input_per_mtok\"]\n    51\t            + cache_read * self.pricing[\"cache_read_per_mtok\"]\n    52\t            + usage.output_tokens * self.pricing[\"output_per_mtok\"]\n    53\t        ) / 1_000_000\n    54\t        self.tokens += tokens\n    55\t        self.cost_usd += cost\n    56\t        return tokens, cost\n    57\t\n    58\t    def check_tool_call(self) -> None:\n    59\t        now = time.monotonic()\n    60\t        while self.tool_calls and now - self.tool_calls[0] > 60:\n    61\t            self.tool_calls.popleft()\n    62\t        if len(self.tool_calls) >= self.cfg[\"max_tool_calls_per_minute\"]:\n    63\t            raise BudgetExceeded(\"max_tool_calls_per_minute\")\n    64\t        self.tool_calls.append(now)\n    65\t\n    66\t    def check_subagent(self, started_so_far: int) -> None:\n    67\t        if started_so_far >= self.cfg[\"max_subagents\"]:\n    68\t            raise BudgetExceeded(\"max_subagents\")\n    69\t\n    70\t\n    71\t_WINDOW = \"to_timestamp(floor(extract(epoch FROM now()) / $3) * $3)\"\n    72\t\n    73\t_RESERVE_RUN = f\"\"\"\n    74\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    75\tVALUES ($1, $2, {_WINDOW}, 1, 0, 0)\n    76\tON CONFLICT (scope, key, window_start) DO UPDATE\n    77\t   SET runs = quota.usage.runs + 1\n    78\t WHERE quota.usage.runs + 1 <= $4\n    79\t   AND quota.usage.tokens < $5\n    80\t   AND quota.usage.cost_usd < $6\n    81\tRETURNING runs\n    82\t\"\"\"\n    83\t\n    84\t_RECORD_USAGE = f\"\"\"\n    85\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    86\tVALUES ($1, $2, {_WINDOW}, 0, $4, $5)\n    87\tON CONFLICT (scope, key, window_start) DO UPDATE\n    88\t   SET tokens = quota.usage.tokens + EXCLUDED.tokens,\n    89\t       cost_usd = quota.usage.cost_usd + EXCLUDED.cost_usd\n    90\tRETURNING tokens, cost_usd\n    91\t\"\"\"\n    92\t\n    93\t\n    94\tclass QuotaStore:\n    95\t    \"\"\"Per-user, per-tenant and fleet-wide quotas, shared by every replica.\"\"\"\n    96\t\n    97\t    def __init__(self, pool: asyncpg.Pool, quotas: list[dict[str, Any]]):\n    98\t        self._pool = pool\n    99\t        self._quotas = quotas\n   100\t\n   101\t    def _key(self, scope: str, ctx: RunContext) -> str:\n   102\t        return {\"user\": ctx.subject, \"tenant\": ctx.tenant, \"fleet\": \"all\"}[scope]\n   103\t\n   104\t    async def reserve_run(self, ctx: RunContext) -> None:\n   105\t        async with self._pool.acquire() as conn, conn.transaction():\n   106\t            for q in self._quotas:\n   107\t                row = await conn.fetchrow(\n   108\t                    _RESERVE_RUN, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"],\n   109\t                    q[\"max_runs\"], q[\"max_tokens\"], q[\"max_cost_usd\"],\n   110\t                )\n   111\t                if row is None:\n   112\t                    raise BudgetExceeded(f\"quota:{q['scope']}\")\n   113\t\n   114\t    async def record_usage(self, ctx: RunContext, tokens: int, cost_usd: float) -> None:\n   115\t        \"\"\"Usage already spent is always recorded; the run stops once any window is over its limit.\"\"\"\n   116\t        exceeded: str | None = None\n   117\t        async with self._pool.acquire() as conn, conn.transaction():\n   118\t            for q in self._quotas:\n   119\t                row = await conn.fetchrow(\n   120\t                    _RECORD_USAGE, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"], tokens, cost_usd\n   121\t                )\n   122\t                if row[\"tokens\"] >= q[\"max_tokens\"] or row[\"cost_usd\"] >= q[\"max_cost_usd\"]:\n   123\t                    exceeded = exceeded or f\"quota:{q['scope']}\"\n   124\t        if exceeded:\n   125\t            raise BudgetExceeded(exceeded)\nagent:\n  name: hr-helpdesk\n  accountable_party: \"VP People Operations <people-ops-lead@acme.example>\"\n  operational_owner: \"people-platform (pager: people-platform-oncall)\"\n  tenant: acme\n  workload_identity: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n\nmodel:\n  provider: anthropic\n  id: claude-sonnet-4-5-20250929\n  pinning: snapshot          # dated snapshot ID per provider model docs, checked 2026-09-15\n  adapter: none\n  max_output_tokens: 1024\n  temperature: 0.2\n\nbudgets:\n  run:\n    max_steps: 12\n    max_wall_seconds: 90\n    max_total_tokens: 60000\n    max_cost_usd: 0.40\n    max_tool_calls_per_minute: 20\n    max_subagents: 0\n  quotas:\n    - scope: user\n      window_seconds: 86400\n      max_runs: 150\n      max_tokens: 400000\n      max_cost_usd: 3.00\n    - scope: tenant\n      window_seconds: 3600\n      max_runs: 20000\n      max_tokens: 15000000\n      max_cost_usd: 250.00\n    - scope: fleet\n      window_seconds: 3600\n      max_runs: 25000\n      max_tokens: 20000000\n      max_cost_usd: 300.00\n\npricing:\n  input_per_mtok: 3.00\n  output_per_mtok: 15.00\n  cache_read_per_mtok: 0.30\n\napprovals:\n  ttl_seconds: 600\n\nstop:\n  poll_seconds: 2\n  max_stop_seconds: 10\n\nretrieval:\n  top_k: 5\n  cache_ttl_seconds: 900\n  max_chunk_chars: 4000\n\nlimits:\n  max_tool_output_bytes: 16384\n  max_user_message_chars: 4000\n\noutput:\n  allowed_link_hosts: [hr.acme.example, handbook.acme.example]\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: hr-helpdesk-agent\n  namespace: hr-agent\nautomountServiceAccountToken: false\n---\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: hr-tool-gateway\n  namespace: hr-agent\nautomountServiceAccountToken: false\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: hr-helpdesk-agent\n  namespace: hr-agent\n  labels: {app: hr-helpdesk-agent, app.kubernetes.io/part-of: hr-helpdesk}\nspec:\n  replicas: 3\n  selector:\n    matchLabels: {app: hr-helpdesk-agent}\n  template:\n    metadata:\n      labels: {app: hr-helpdesk-agent}\n      annotations:\n        acme.example/release-manifest: \"release/manifest.yaml@${GIT_SHA}\"\n    spec:\n      serviceAccountName: hr-helpdesk-agent\n      automountServiceAccountToken: false\n      hostUsers: false\n      enableServiceLinks: false\n      securityContext:\n        runAsNonRoot: true\n        runAsUser: 65532\n        runAsGroup: 65532\n        fsGroup: 65532\n        seccompProfile: {type: RuntimeDefault}\n      containers:\n        - name: agent\n          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n          args: [\"-m\", \"uvicorn\", \"src.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\"]\n          ports: [{containerPort: 8080}]\n          env:\n            - {name: AGENT_TYPE_ID, value: \"${AGENT_TYPE_ID}\"}\n            - {name: IMAGE_DIGEST, value: \"${IMAGE_DIGEST}\"}\n            - name: POD_UID\n              valueFrom: {fieldRef: {fieldPath: metadata.uid}}\n            - name: DATABASE_URL\n              valueFrom: {secretKeyRef: {name: hr-agent-db, key: url}}\n            - name: ANTHROPIC_API_KEY\n              valueFrom: {secretKeyRef: {name: hr-agent-anthropic, key: api_key}}\n            - {name: ANTHROPIC_BASE_URL, value: \"https://api.anthropic.com\"}\n          securityContext:\n            allowPrivilegeEscalation: false\n            readOnlyRootFilesystem: true\n            privileged: false\n            capabilities: {drop: [ALL]}\n          resources:\n            requests: {cpu: 250m, memory: 384Mi}\n            limits: {cpu: \"1\", memory: 768Mi}\n          volumeMounts:\n            - {name: tmp, mountPath: /tmp}\n            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n            - {name: svid, mountPath: /etc/svid, readOnly: true}\n      volumes:\n        - name: tmp\n          emptyDir: {medium: Memory, sizeLimit: 32Mi}\n        - name: sts-token\n          projected:\n            sources:\n              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n        - name: svid\n          csi: {driver: csi.spiffe.io, readOnly: true}\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: hr-tool-gateway\n  namespace: hr-agent\n  labels: {app: hr-tool-gateway, app.kubernetes.io/part-of: hr-helpdesk}\nspec:\n  replicas: 2\n  selector:\n    matchLabels: {app: hr-tool-gateway}\n  template:\n    metadata:\n      labels: {app: hr-tool-gateway}\n    spec:\n      serviceAccountName: hr-tool-gateway\n      automountServiceAccountToken: false\n      hostUsers: false\n      enableServiceLinks: false\n      securityContext:\n        runAsNonRoot: true\n        runAsUser: 65532\n        runAsGroup: 65532\n        seccompProfile: {type: RuntimeDefault}\n      containers:\n        - name: gateway\n          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n          args: [\"-m\", \"uvicorn\", \"src.gateway:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8443\"]\n          ports: [{containerPort: 8443}]\n          env:\n            - name: GATEWAY_DATABASE_URL\n              valueFrom: {secretKeyRef: {name: hr-gateway-db, key: url}}\n          securityContext:\n            allowPrivilegeEscalation: false\n            readOnlyRootFilesystem: true\n            privileged: false\n            capabilities: {drop: [ALL]}\n          volumeMounts:\n            - {name: tmp, mountPath: /tmp}\n            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n            - {name: svid, mountPath: /etc/svid, readOnly: true}\n      volumes:\n        - name: tmp\n          emptyDir: {medium: Memory, sizeLimit: 16Mi}\n        - name: sts-token\n          projected:\n            sources:\n              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n        - name: svid\n          csi: {driver: csi.spiffe.io, readOnly: true}\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: hr-tool-gateway\n  namespace: hr-agent\nspec:\n  selector: {app: hr-tool-gateway}\n  ports: [{port: 8443, targetPort: 8443}]\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: hr-helpdesk-agent\n  namespace: hr-agent\nspec:\n  selector: {app: hr-helpdesk-agent}\n  sessionAffinity: ClientIP\n  ports: [{port: 80, targetPort: 8080}]\napiVersion: batch/v1\nkind: CronJob\nmetadata:\n  name: audit-partition-maintenance\n  namespace: hr-agent\n  labels: {app.kubernetes.io/part-of: hr-helpdesk}\nspec:\n  schedule: \"17 2 * * *\"\n  concurrencyPolicy: Forbid\n  jobTemplate:\n    spec:\n      backoffLimit: 2\n      template:\n        metadata:\n          labels: {app: audit-maintenance}\n        spec:\n          serviceAccountName: hr-audit-maint\n          automountServiceAccountToken: false\n          restartPolicy: OnFailure\n          securityContext:\n            runAsNonRoot: true\n            runAsUser: 70\n            seccompProfile: {type: RuntimeDefault}\n          containers:\n            - name: maintain\n              image: registry.acme.example/platform/psql@sha256:9b2e61c04d7f3a85e1c6b09d2f4a7e3c58d1b6a0f9e2c47d3b8a15e6f0c9d2a4\n              env:\n                - name: PGSERVICE\n                  value: hr_audit_maint\n                - name: PERIOD\n                  value: \"1 week\"\n                - name: AHEAD\n                  value: \"4\"\n                - name: KEEP_PARTITIONS\n                  value: \"6\"\n              command: [\"psql\", \"-v\", \"ON_ERROR_STOP=1\", \"-c\"]\n              args:\n                - >-\n                  SELECT audit.maintain_partitions('audit.events', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n                  SELECT audit.maintain_partitions('audit.gateway_decisions', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n              securityContext:\n                allowPrivilegeEscalation: false\n                readOnlyRootFilesystem: true\n                capabilities: {drop: [ALL]}\n              volumeMounts:\n                - {name: pgservice, mountPath: /etc/postgresql-common, readOnly: true}\n          volumes:\n            - name: pgservice\n              secret: {secretName: hr-audit-maint-pgservice}","is_error":false}]},"parent_tool_use_id":null,"session_id":"f3392798-873b-4370-b8d2-b96460e8d810","uuid":"2da84446-627e-49bd-befa-60c3af02596c","timestamp":"2026-11-21T11:58:35.157Z","tool_use_result":{"stdout":"     1\t\"\"\"HTTP entry point for the HR helpdesk agent.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport asyncio\n     5\timport logging\n     6\timport os\n     7\timport uuid\n     8\t\n     9\timport asyncpg\n    10\timport httpx\n    11\timport jwt\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\tfrom opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter\n    15\tfrom opentelemetry.sdk.resources import Resource\n    16\tfrom opentelemetry.sdk.trace import TracerProvider\n    17\tfrom opentelemetry.sdk.trace.export import BatchSpanProcessor\n    18\tfrom starlette.applications import Starlette\n    19\tfrom starlette.requests import Request\n    20\tfrom starlette.responses import JSONResponse\n    21\tfrom starlette.routing import Route\n    22\t\n    23\tfrom . import type_id\n    24\tfrom .agent import Agent, RunState\n    25\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    26\tfrom .audit import AuditUnavailable, AuditWriter, RunContext\n    27\tfrom .budgets import BudgetExceeded, QuotaStore\n    28\tfrom .credentials import CredentialBroker\n    29\tfrom .gateway_client import GatewayClient\n    30\tfrom .killswitch import Stopped, StopControl\n    31\tfrom .redact import RedactingFilter\n    32\tfrom .retrieval import PolicyIndex\n    33\tfrom .tools import ToolRegistry, load_yaml\n    34\tfrom .validation import sanitize_reply\n    35\t\n    36\tSSO_ISSUER = \"https://sso.acme.example\"\n    37\tSSO_AUDIENCE = \"hr-helpdesk\"\n    38\tSSO_JWKS = jwt.PyJWKClient(f\"{SSO_ISSUER}/.well-known/jwks.json\", cache_keys=True, lifespan=300)\n    39\t\n    40\tlogging.basicConfig(level=logging.INFO)\n    41\tfor h in logging.getLogger().handlers:\n    42\t    h.addFilter(RedactingFilter())\n    43\tlog = logging.getLogger(\"hr_agent\")\n    44\t\n    45\tCFG = load_yaml(\"agent.yaml\")\n    46\tAGENT_TYPE_ID = type_id.verify_or_exit(os.environ[\"AGENT_TYPE_ID\"], os.environ[\"IMAGE_DIGEST\"], type_id.model_record(CFG))\n    47\tPOD_ID = os.environ[\"POD_UID\"]\n    48\t\n    49\tprovider = TracerProvider(resource=Resource.create({\n    50\t    \"service.name\": \"hr-helpdesk-agent\", \"gen_ai.agent.name\": CFG[\"agent\"][\"name\"], \"gen_ai.agent.id\": AGENT_TYPE_ID,\n    51\t}))\n    52\tprovider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint=\"otel-collector.observability.svc:4317\")))\n    53\ttrace.set_tracer_provider(provider)\n    54\ttracer = trace.get_tracer(\"hr_agent.http\")\n    55\t\n    56\t_runs: dict[str, tuple[RunContext, RunState]] = {}\n    57\tagent: Agent\n    58\taudit: AuditWriter\n    59\tapprovals: ApprovalStore\n    60\tstop: StopControl\n    61\t\n    62\t\n    63\tdef _employee(request: Request) -> tuple[str, str]:\n    64\t    \"\"\"Verified employee id and raw token. Tenant and subject never come from the request body or model.\"\"\"\n    65\t    auth = request.headers.get(\"authorization\", \"\")\n    66\t    if not auth.startswith(\"Bearer \"):\n    67\t        raise PermissionError(\"missing token\")\n    68\t    token = auth[7:]\n    69\t    claims = jwt.decode(token, SSO_JWKS.get_signing_key_from_jwt(token).key, algorithms=[\"RS256\"],\n    70\t                        audience=SSO_AUDIENCE, issuer=SSO_ISSUER, options={\"require\": [\"exp\", \"sub\", \"employee_id\"]})\n    71\t    if claims.get(\"org\") != CFG[\"agent\"][\"tenant\"]:\n    72\t        raise PermissionError(\"wrong organisation\")\n    73\t    return claims[\"employee_id\"], token\n    74\t\n    75\t\n    76\tdef _context(run_id: str, employee_id: str) -> RunContext:\n    77\t    a = CFG[\"agent\"]\n    78\t    return RunContext(\n    79\t        run_id=run_id, agent_instance_id=f\"{POD_ID}/{run_id}\", agent_type_id=AGENT_TYPE_ID, tenant=a[\"tenant\"],\n    80\t        subject=employee_id, accountable_party=a[\"accountable_party\"], operational_owner=a[\"operational_owner\"],\n    81\t        agent_principal=a[\"workload_identity\"],\n    82\t    )\n    83\t\n    84\t\n    85\tasync def _drive(ctx: RunContext, coro) -> RunState | None:\n    86\t    task = asyncio.ensure_future(coro)\n    87\t    watcher = asyncio.ensure_future(stop.watch(ctx, task))\n    88\t    try:\n    89\t        return await task\n    90\t    except asyncio.CancelledError:\n    91\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=\"stop flag\")\n    92\t        return None\n    93\t    except Stopped as exc:\n    94\t        await audit.record(ctx, \"run_stopped\", decision=\"stop\", reason=str(exc))\n    95\t        return None\n    96\t    finally:\n    97\t        watcher.cancel()\n    98\t\n    99\t\n   100\tdef _reply(run_id: str, state: RunState | None) -> JSONResponse:\n   101\t    if state is None:\n   102\t        return JSONResponse({\"run_id\": run_id, \"status\": \"stopped\", \"reply\": \"This assistant is paused. Please contact HR directly.\"})\n   103\t    body = {\"run_id\": run_id, \"status\": state.status,\n   104\t            \"reply\": sanitize_reply(state.reply or \"\", CFG[\"output\"][\"allowed_link_hosts\"])}\n   105\t    if state.pending_approval:\n   106\t        body[\"approval\"] = state.pending_approval\n   107\t    return JSONResponse(body)\n   108\t\n   109\t\n   110\tasync def chat(request: Request) -> JSONResponse:\n   111\t    try:\n   112\t        employee_id, token = _employee(request)\n   113\t    except (jwt.PyJWTError, PermissionError):\n   114\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   115\t    text = str((await request.json()).get(\"message\", \"\"))[: CFG[\"limits\"][\"max_user_message_chars\"]]\n   116\t    run_id = str(uuid.uuid4())\n   117\t    ctx = _context(run_id, employee_id)\n   118\t    with tracer.start_as_current_span(\"chat\"):\n   119\t        try:\n   120\t            await agent.quotas.reserve_run(ctx)\n   121\t            state = agent.new_state(text, token)\n   122\t            _runs[run_id] = (ctx, state)\n   123\t            await audit.record(ctx, \"run_started\", decision=\"allow\")\n   124\t            state = await _drive(ctx, agent.run(ctx, state))\n   125\t        except BudgetExceeded as exc:\n   126\t            await audit.record(ctx, \"quota_denied\", decision=\"deny\", reason=exc.limit)\n   127\t            return JSONResponse({\"error\": \"quota_exceeded\"}, status_code=429)\n   128\t        except AuditUnavailable:\n   129\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   130\t        except Exception as exc:\n   131\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__)\n   132\t            raise\n   133\t        return _reply(run_id, state)\n   134\t\n   135\t\n   136\tasync def confirm(request: Request) -> JSONResponse:\n   137\t    try:\n   138\t        employee_id, token = _employee(request)\n   139\t    except (jwt.PyJWTError, PermissionError):\n   140\t        return JSONResponse({\"error\": \"unauthenticated\"}, status_code=401)\n   141\t    run_id, approval_id = request.path_params[\"run_id\"], request.path_params[\"approval_id\"]\n   142\t    entry = _runs.get(run_id)\n   143\t    if entry is None or entry[0].subject != employee_id:\n   144\t        return JSONResponse({\"error\": \"not_found\"}, status_code=404)\n   145\t    ctx, state = entry\n   146\t    state.subject_token = token\n   147\t    with tracer.start_as_current_span(\"approval.confirm\"):\n   148\t        try:\n   149\t            await approvals.confirm(approval_id, employee_id)\n   150\t            await audit.record(ctx, \"approval_granted\", decision=\"allow\", approval_id=approval_id)\n   151\t            state = await _drive(ctx, agent.resume_with_approval(ctx, state, approval_id))\n   152\t        except ApprovalInvalid as exc:\n   153\t            await audit.record(ctx, \"approval_rejected\", decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   154\t            return JSONResponse({\"error\": \"approval_invalid\"}, status_code=409)\n   155\t        except AuditUnavailable:\n   156\t            return JSONResponse({\"error\": \"temporarily_unavailable\"}, status_code=503)\n   157\t        except Exception as exc:\n   158\t            await audit.record(ctx, \"run_error\", decision=\"error\", reason=type(exc).__name__, approval_id=approval_id)\n   159\t            raise\n   160\t        return _reply(run_id, state)\n   161\t\n   162\t\n   163\tasync def startup() -> None:\n   164\t    global agent, audit, approvals, stop\n   165\t    pool = await asyncpg.create_pool(os.environ[\"DATABASE_URL\"], min_size=2, max_size=20)\n   166\t    registry = ToolRegistry.from_config()\n   167\t    mtls = httpx.AsyncClient(verify=\"/etc/svid/bundle.pem\", cert=(\"/etc/svid/svid.pem\", \"/etc/svid/svid_key.pem\"))\n   168\t    audit = AuditWriter(pool, registry.policy_version)\n   169\t    approvals = ApprovalStore(pool, CFG[\"approvals\"][\"ttl_seconds\"])\n   170\t    stop = StopControl(pool, CFG[\"stop\"][\"poll_seconds\"])\n   171\t    agent = Agent(\n   172\t        CFG, registry, AsyncAnthropic(max_retries=1), GatewayClient(mtls, CredentialBroker(mtls)),\n   173\t        PolicyIndex(pool, CFG[\"retrieval\"][\"top_k\"], CFG[\"retrieval\"][\"cache_ttl_seconds\"]),\n   174\t        approvals, QuotaStore(pool, CFG[\"budgets\"][\"quotas\"]), audit, stop,\n   175\t    )\n   176\t\n   177\t\n   178\tapp = Starlette(\n   179\t    routes=[\n   180\t        Route(\"/v1/chat\", chat, methods=[\"POST\"]),\n   181\t        Route(\"/v1/runs/{run_id}/approvals/{approval_id}/confirm\", confirm, methods=[\"POST\"]),\n   182\t    ],\n   183\t    on_startup=[startup],\n   184\t)\n     1\t\"\"\"Calls MCP tools through the hr-tool-gateway.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport logging\n     5\timport uuid\n     6\tfrom typing import Any\n     7\t\n     8\timport httpx\n     9\tfrom opentelemetry.propagate import inject\n    10\t\n    11\tfrom .audit import RunContext\n    12\tfrom .credentials import CredentialBroker\n    13\tfrom .tools import ToolSpec\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.gateway_client\")\n    16\t\n    17\tGATEWAY_URL = \"https://hr-tool-gateway.hr-agent.svc.cluster.local:8443/mcp\"\n    18\tGATEWAY_AUDIENCE = \"hr-tool-gateway\"\n    19\t\n    20\t\n    21\tclass ToolDenied(Exception):\n    22\t    def __init__(self, reason: str):\n    23\t        super().__init__(reason)\n    24\t        self.reason = reason\n    25\t\n    26\t\n    27\tclass ToolError(Exception):\n    28\t    def __init__(self, status: int, detail: str):\n    29\t        super().__init__(f\"{status}\")\n    30\t        self.status = status\n    31\t        self.detail = detail\n    32\t\n    33\t\n    34\tclass GatewayUnavailable(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass GatewayClient:\n    39\t    def __init__(self, client: httpx.AsyncClient, creds: CredentialBroker):\n    40\t        self._client = client\n    41\t        self._creds = creds\n    42\t\n    43\t    async def call(\n    44\t        self, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, subject_token: str, *, operation_id: str\n    45\t    ) -> dict[str, Any]:\n    46\t        try:\n    47\t            token = await self._creds.token(\n    48\t                audience=GATEWAY_AUDIENCE, scope=spec.scope, subject_token=subject_token, subject=ctx.subject\n    49\t            )\n    50\t            return await self._post(GATEWAY_URL, token, spec, args, ctx, operation_id)\n    51\t        except GatewayUnavailable:\n    52\t            if not spec.direct_route:\n    53\t                raise\n    54\t            log.warning(\"gateway unavailable, using direct route\", extra={\"tool\": spec.qualified})\n    55\t            token = await self._creds.token(\n    56\t                audience=spec.direct_route[\"audience\"], scope=spec.scope,\n    57\t                subject_token=subject_token, subject=ctx.subject,\n    58\t            )\n    59\t            return await self._post(spec.direct_route[\"endpoint\"], token, spec, args, ctx, operation_id)\n    60\t\n    61\t    async def _post(\n    62\t        self, url: str, token: str, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, operation_id: str\n    63\t    ) -> dict[str, Any]:\n    64\t        tool_name = spec.qualified.split(\"/\", 1)[1]\n    65\t        headers = {\n    66\t            \"Authorization\": f\"Bearer {token}\",\n    67\t            \"Mcp-Method\": \"tools/call\",\n    68\t            \"Mcp-Name\": tool_name,\n    69\t            \"Idempotency-Key\": operation_id,\n    70\t            \"X-Agent-Instance\": ctx.agent_instance_id,\n    71\t            \"X-Agent-Type-Id\": ctx.agent_type_id,\n    72\t        }\n    73\t        inject(headers)\n    74\t        body = {\n    75\t            \"jsonrpc\": \"2.0\",\n    76\t            \"id\": str(uuid.uuid4()),\n    77\t            \"method\": \"tools/call\",\n    78\t            \"params\": {\"name\": tool_name, \"arguments\": args, \"_meta\": {\"server\": spec.server}},\n    79\t        }\n    80\t        try:\n    81\t            resp = await self._client.post(url, json=body, headers=headers, timeout=10.0)\n    82\t        except (httpx.ConnectError, httpx.ConnectTimeout) as exc:\n    83\t            raise GatewayUnavailable(str(exc)) from exc\n    84\t        except httpx.TimeoutException as exc:\n    85\t            raise ToolError(504, f\"no response; outcome unknown for operation {operation_id}\") from exc\n    86\t        if resp.status_code == 503:\n    87\t            raise GatewayUnavailable(resp.text[:200])\n    88\t        if resp.status_code in (401, 403, 429):\n    89\t            raise ToolDenied(resp.json().get(\"error\", \"denied\"))\n    90\t        if resp.status_code >= 400:\n    91\t            raise ToolError(resp.status_code, resp.json().get(\"detail\", resp.text))\n    92\t        payload = resp.json()\n    93\t        if \"error\" in payload:\n    94\t            raise ToolError(200, str(payload[\"error\"].get(\"message\", \"\")))\n    95\t        return payload[\"result\"][\"structuredContent\"]\n     1\t\"\"\"Hard limits enforced by the harness, outside the model.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport time\n     5\tfrom collections import deque\n     6\tfrom dataclasses import dataclass, field\n     7\tfrom typing import Any\n     8\t\n     9\timport asyncpg\n    10\t\n    11\tfrom .audit import RunContext\n    12\t\n    13\t\n    14\tclass BudgetExceeded(Exception):\n    15\t    def __init__(self, limit: str):\n    16\t        super().__init__(limit)\n    17\t        self.limit = limit\n    18\t\n    19\t\n    20\t@dataclass\n    21\tclass RunBudget:\n    22\t    cfg: dict[str, Any]\n    23\t    pricing: dict[str, float]\n    24\t    started: float = field(default_factory=time.monotonic)\n    25\t    steps: int = 0\n    26\t    tokens: int = 0\n    27\t    cost_usd: float = 0.0\n    28\t    tool_calls: deque = field(default_factory=deque)\n    29\t\n    30\t    def check_step(self) -> None:\n    31\t        if self.steps >= self.cfg[\"max_steps\"]:\n    32\t            raise BudgetExceeded(\"max_steps\")\n    33\t        if time.monotonic() - self.started > self.cfg[\"max_wall_seconds\"]:\n    34\t            raise BudgetExceeded(\"max_wall_seconds\")\n    35\t        if self.tokens >= self.cfg[\"max_total_tokens\"]:\n    36\t            raise BudgetExceeded(\"max_total_tokens\")\n    37\t        if self.cost_usd >= self.cfg[\"max_cost_usd\"]:\n    38\t            raise BudgetExceeded(\"max_cost_usd\")\n    39\t        self.steps += 1\n    40\t\n    41\t    def remaining_seconds(self) -> float:\n    42\t        return max(0.0, self.cfg[\"max_wall_seconds\"] - (time.monotonic() - self.started))\n    43\t\n    44\t    def record_usage(self, usage: Any) -> tuple[int, float]:\n    45\t        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n    46\t        cache_write = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n    47\t        tokens_in = usage.input_tokens + cache_read + cache_write\n    48\t        tokens = tokens_in + usage.output_tokens\n    49\t        cost = (\n    50\t            (usage.input_tokens + cache_write) * self.pricing[\"input_per_mtok\"]\n    51\t            + cache_read * self.pricing[\"cache_read_per_mtok\"]\n    52\t            + usage.output_tokens * self.pricing[\"output_per_mtok\"]\n    53\t        ) / 1_000_000\n    54\t        self.tokens += tokens\n    55\t        self.cost_usd += cost\n    56\t        return tokens, cost\n    57\t\n    58\t    def check_tool_call(self) -> None:\n    59\t        now = time.monotonic()\n    60\t        while self.tool_calls and now - self.tool_calls[0] > 60:\n    61\t            self.tool_calls.popleft()\n    62\t        if len(self.tool_calls) >= self.cfg[\"max_tool_calls_per_minute\"]:\n    63\t            raise BudgetExceeded(\"max_tool_calls_per_minute\")\n    64\t        self.tool_calls.append(now)\n    65\t\n    66\t    def check_subagent(self, started_so_far: int) -> None:\n    67\t        if started_so_far >= self.cfg[\"max_subagents\"]:\n    68\t            raise BudgetExceeded(\"max_subagents\")\n    69\t\n    70\t\n    71\t_WINDOW = \"to_timestamp(floor(extract(epoch FROM now()) / $3) * $3)\"\n    72\t\n    73\t_RESERVE_RUN = f\"\"\"\n    74\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    75\tVALUES ($1, $2, {_WINDOW}, 1, 0, 0)\n    76\tON CONFLICT (scope, key, window_start) DO UPDATE\n    77\t   SET runs = quota.usage.runs + 1\n    78\t WHERE quota.usage.runs + 1 <= $4\n    79\t   AND quota.usage.tokens < $5\n    80\t   AND quota.usage.cost_usd < $6\n    81\tRETURNING runs\n    82\t\"\"\"\n    83\t\n    84\t_RECORD_USAGE = f\"\"\"\n    85\tINSERT INTO quota.usage (scope, key, window_start, runs, tokens, cost_usd)\n    86\tVALUES ($1, $2, {_WINDOW}, 0, $4, $5)\n    87\tON CONFLICT (scope, key, window_start) DO UPDATE\n    88\t   SET tokens = quota.usage.tokens + EXCLUDED.tokens,\n    89\t       cost_usd = quota.usage.cost_usd + EXCLUDED.cost_usd\n    90\tRETURNING tokens, cost_usd\n    91\t\"\"\"\n    92\t\n    93\t\n    94\tclass QuotaStore:\n    95\t    \"\"\"Per-user, per-tenant and fleet-wide quotas, shared by every replica.\"\"\"\n    96\t\n    97\t    def __init__(self, pool: asyncpg.Pool, quotas: list[dict[str, Any]]):\n    98\t        self._pool = pool\n    99\t        self._quotas = quotas\n   100\t\n   101\t    def _key(self, scope: str, ctx: RunContext) -> str:\n   102\t        return {\"user\": ctx.subject, \"tenant\": ctx.tenant, \"fleet\": \"all\"}[scope]\n   103\t\n   104\t    async def reserve_run(self, ctx: RunContext) -> None:\n   105\t        async with self._pool.acquire() as conn, conn.transaction():\n   106\t            for q in self._quotas:\n   107\t                row = await conn.fetchrow(\n   108\t                    _RESERVE_RUN, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"],\n   109\t                    q[\"max_runs\"], q[\"max_tokens\"], q[\"max_cost_usd\"],\n   110\t                )\n   111\t                if row is None:\n   112\t                    raise BudgetExceeded(f\"quota:{q['scope']}\")\n   113\t\n   114\t    async def record_usage(self, ctx: RunContext, tokens: int, cost_usd: float) -> None:\n   115\t        \"\"\"Usage already spent is always recorded; the run stops once any window is over its limit.\"\"\"\n   116\t        exceeded: str | None = None\n   117\t        async with self._pool.acquire() as conn, conn.transaction():\n   118\t            for q in self._quotas:\n   119\t                row = await conn.fetchrow(\n   120\t                    _RECORD_USAGE, q[\"scope\"], self._key(q[\"scope\"], ctx), q[\"window_seconds\"], tokens, cost_usd\n   121\t                )\n   122\t                if row[\"tokens\"] >= q[\"max_tokens\"] or row[\"cost_usd\"] >= q[\"max_cost_usd\"]:\n   123\t                    exceeded = exceeded or f\"quota:{q['scope']}\"\n   124\t        if exceeded:\n   125\t            raise BudgetExceeded(exceeded)\nagent:\n  name: hr-helpdesk\n  accountable_party: \"VP People Operations <people-ops-lead@acme.example>\"\n  operational_owner: \"people-platform (pager: people-platform-oncall)\"\n  tenant: acme\n  workload_identity: spiffe://acme.example/ns/hr-agent/sa/hr-helpdesk-agent\n\nmodel:\n  provider: anthropic\n  id: claude-sonnet-4-5-20250929\n  pinning: snapshot          # dated snapshot ID per provider model docs, checked 2026-09-15\n  adapter: none\n  max_output_tokens: 1024\n  temperature: 0.2\n\nbudgets:\n  run:\n    max_steps: 12\n    max_wall_seconds: 90\n    max_total_tokens: 60000\n    max_cost_usd: 0.40\n    max_tool_calls_per_minute: 20\n    max_subagents: 0\n  quotas:\n    - scope: user\n      window_seconds: 86400\n      max_runs: 150\n      max_tokens: 400000\n      max_cost_usd: 3.00\n    - scope: tenant\n      window_seconds: 3600\n      max_runs: 20000\n      max_tokens: 15000000\n      max_cost_usd: 250.00\n    - scope: fleet\n      window_seconds: 3600\n      max_runs: 25000\n      max_tokens: 20000000\n      max_cost_usd: 300.00\n\npricing:\n  input_per_mtok: 3.00\n  output_per_mtok: 15.00\n  cache_read_per_mtok: 0.30\n\napprovals:\n  ttl_seconds: 600\n\nstop:\n  poll_seconds: 2\n  max_stop_seconds: 10\n\nretrieval:\n  top_k: 5\n  cache_ttl_seconds: 900\n  max_chunk_chars: 4000\n\nlimits:\n  max_tool_output_bytes: 16384\n  max_user_message_chars: 4000\n\noutput:\n  allowed_link_hosts: [hr.acme.example, handbook.acme.example]\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: hr-helpdesk-agent\n  namespace: hr-agent\nautomountServiceAccountToken: false\n---\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: hr-tool-gateway\n  namespace: hr-agent\nautomountServiceAccountToken: false\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: hr-helpdesk-agent\n  namespace: hr-agent\n  labels: {app: hr-helpdesk-agent, app.kubernetes.io/part-of: hr-helpdesk}\nspec:\n  replicas: 3\n  selector:\n    matchLabels: {app: hr-helpdesk-agent}\n  template:\n    metadata:\n      labels: {app: hr-helpdesk-agent}\n      annotations:\n        acme.example/release-manifest: \"release/manifest.yaml@${GIT_SHA}\"\n    spec:\n      serviceAccountName: hr-helpdesk-agent\n      automountServiceAccountToken: false\n      hostUsers: false\n      enableServiceLinks: false\n      securityContext:\n        runAsNonRoot: true\n        runAsUser: 65532\n        runAsGroup: 65532\n        fsGroup: 65532\n        seccompProfile: {type: RuntimeDefault}\n      containers:\n        - name: agent\n          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n          args: [\"-m\", \"uvicorn\", \"src.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\"]\n          ports: [{containerPort: 8080}]\n          env:\n            - {name: AGENT_TYPE_ID, value: \"${AGENT_TYPE_ID}\"}\n            - {name: IMAGE_DIGEST, value: \"${IMAGE_DIGEST}\"}\n            - name: POD_UID\n              valueFrom: {fieldRef: {fieldPath: metadata.uid}}\n            - name: DATABASE_URL\n              valueFrom: {secretKeyRef: {name: hr-agent-db, key: url}}\n            - name: ANTHROPIC_API_KEY\n              valueFrom: {secretKeyRef: {name: hr-agent-anthropic, key: api_key}}\n            - {name: ANTHROPIC_BASE_URL, value: \"https://api.anthropic.com\"}\n          securityContext:\n            allowPrivilegeEscalation: false\n            readOnlyRootFilesystem: true\n            privileged: false\n            capabilities: {drop: [ALL]}\n          resources:\n            requests: {cpu: 250m, memory: 384Mi}\n            limits: {cpu: \"1\", memory: 768Mi}\n          volumeMounts:\n            - {name: tmp, mountPath: /tmp}\n            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n            - {name: svid, mountPath: /etc/svid, readOnly: true}\n      volumes:\n        - name: tmp\n          emptyDir: {medium: Memory, sizeLimit: 32Mi}\n        - name: sts-token\n          projected:\n            sources:\n              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n        - name: svid\n          csi: {driver: csi.spiffe.io, readOnly: true}\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: hr-tool-gateway\n  namespace: hr-agent\n  labels: {app: hr-tool-gateway, app.kubernetes.io/part-of: hr-helpdesk}\nspec:\n  replicas: 2\n  selector:\n    matchLabels: {app: hr-tool-gateway}\n  template:\n    metadata:\n      labels: {app: hr-tool-gateway}\n    spec:\n      serviceAccountName: hr-tool-gateway\n      automountServiceAccountToken: false\n      hostUsers: false\n      enableServiceLinks: false\n      securityContext:\n        runAsNonRoot: true\n        runAsUser: 65532\n        runAsGroup: 65532\n        seccompProfile: {type: RuntimeDefault}\n      containers:\n        - name: gateway\n          image: registry.acme.example/people/hr-helpdesk-agent@${IMAGE_DIGEST}\n          args: [\"-m\", \"uvicorn\", \"src.gateway:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8443\"]\n          ports: [{containerPort: 8443}]\n          env:\n            - name: GATEWAY_DATABASE_URL\n              valueFrom: {secretKeyRef: {name: hr-gateway-db, key: url}}\n          securityContext:\n            allowPrivilegeEscalation: false\n            readOnlyRootFilesystem: true\n            privileged: false\n            capabilities: {drop: [ALL]}\n          volumeMounts:\n            - {name: tmp, mountPath: /tmp}\n            - {name: sts-token, mountPath: /var/run/secrets/tokens, readOnly: true}\n            - {name: svid, mountPath: /etc/svid, readOnly: true}\n      volumes:\n        - name: tmp\n          emptyDir: {medium: Memory, sizeLimit: 16Mi}\n        - name: sts-token\n          projected:\n            sources:\n              - serviceAccountToken: {path: sts-token, audience: sts.acme.example, expirationSeconds: 600}\n        - name: svid\n          csi: {driver: csi.spiffe.io, readOnly: true}\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: hr-tool-gateway\n  namespace: hr-agent\nspec:\n  selector: {app: hr-tool-gateway}\n  ports: [{port: 8443, targetPort: 8443}]\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: hr-helpdesk-agent\n  namespace: hr-agent\nspec:\n  selector: {app: hr-helpdesk-agent}\n  sessionAffinity: ClientIP\n  ports: [{port: 80, targetPort: 8080}]\napiVersion: batch/v1\nkind: CronJob\nmetadata:\n  name: audit-partition-maintenance\n  namespace: hr-agent\n  labels: {app.kubernetes.io/part-of: hr-helpdesk}\nspec:\n  schedule: \"17 2 * * *\"\n  concurrencyPolicy: Forbid\n  jobTemplate:\n    spec:\n      backoffLimit: 2\n      template:\n        metadata:\n          labels: {app: audit-maintenance}\n        spec:\n          serviceAccountName: hr-audit-maint\n          automountServiceAccountToken: false\n          restartPolicy: OnFailure\n          securityContext:\n            runAsNonRoot: true\n            runAsUser: 70\n            seccompProfile: {type: RuntimeDefault}\n          containers:\n            - name: maintain\n              image: registry.acme.example/platform/psql@sha256:9b2e61c04d7f3a85e1c6b09d2f4a7e3c58d1b6a0f9e2c47d3b8a15e6f0c9d2a4\n              env:\n                - name: PGSERVICE\n                  value: hr_audit_maint\n                - name: PERIOD\n                  value: \"1 week\"\n                - name: AHEAD\n                  value: \"4\"\n                - name: KEEP_PARTITIONS\n                  value: \"6\"\n              command: [\"psql\", \"-v\", \"ON_ERROR_STOP=1\", \"-c\"]\n              args:\n                - >-\n                  SELECT audit.maintain_partitions('audit.events', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n                  SELECT audit.maintain_partitions('audit.gateway_decisions', '$(PERIOD)', $(AHEAD), $(KEEP_PARTITIONS));\n              securityContext:\n                allowPrivilegeEscalation: false\n                readOnlyRootFilesystem: true\n                capabilities: {drop: [ALL]}\n              volumeMounts:\n                - {name: pgservice, mountPath: /etc/postgresql-common, readOnly: true}\n          volumes:\n            - name: pgservice\n              secret: {secretName: hr-audit-maint-pgservice}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01918RDsWPAyHcpist5zupHb","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
