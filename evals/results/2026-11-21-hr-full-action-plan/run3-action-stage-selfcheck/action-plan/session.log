{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wki2Zkr9vBV5X1vX9ZP9os","type":"tool_result","content":"=== src/agent.py\n     1\t\"\"\"Agent loop for the HR helpdesk.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport json\n     5\timport logging\n     6\timport pathlib\n     7\timport uuid\n     8\tfrom dataclasses import dataclass, field\n     9\tfrom datetime import date\n    10\tfrom typing import Any\n    11\t\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    16\tfrom .audit import AuditWriter, RunContext\n    17\tfrom .budgets import BudgetExceeded, QuotaStore, RunBudget\n    18\tfrom .gateway_client import GatewayClient, ToolDenied, ToolError\n    19\tfrom .killswitch import StopControl\n    20\tfrom .redact import redact\n    21\tfrom .retrieval import PolicyIndex\n    22\tfrom .tools import ToolRegistry, ToolSpec\n    23\tfrom .validation import ValidationRejected, validate_chunk, validate_tool_args, validate_tool_output\n    24\t\n    25\tlog = logging.getLogger(\"hr_agent.loop\")\n    26\ttracer = trace.get_tracer(\"hr_agent\")\n    27\t\n    28\tSYSTEM_PROMPT = (pathlib.Path(__file__).resolve().parent.parent / \"prompts\" / \"system.md\").read_text()\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass RunState:\n    33\t    messages: list[dict[str, Any]]\n    34\t    budget: RunBudget\n    35\t    subject_token: str\n    36\t    status: str = \"running\"\n    37\t    reply: str | None = None\n    38\t    pending_approval: dict[str, Any] | None = None\n    39\t    last_step: str | None = None\n    40\t    subagents_started: int = 0\n    41\t    extra: dict[str, Any] = field(default_factory=dict)\n    42\t\n    43\t\n    44\tclass Agent:\n    45\t    def __init__(self, cfg: dict[str, Any], registry: ToolRegistry, llm: AsyncAnthropic, gateway: GatewayClient,\n    46\t                 index: PolicyIndex, approvals: ApprovalStore, quotas: QuotaStore, audit: AuditWriter, stop: StopControl):\n    47\t        self.cfg, self.registry, self.llm, self.gateway = cfg, registry, llm, gateway\n    48\t        self.index, self.approvals, self.quotas, self.audit, self.stop = index, approvals, quotas, audit, stop\n    49\t\n    50\t    def new_state(self, user_text: str, subject_token: str) -> RunState:\n    51\t        budget = RunBudget(self.cfg[\"budgets\"][\"run\"], self.cfg[\"pricing\"])\n    52\t        return RunState(messages=[{\"role\": \"user\", \"content\": user_text}], budget=budget, subject_token=subject_token)\n    53\t\n    54\t    async def run(self, ctx: RunContext, state: RunState) -> RunState:\n    55\t        with tracer.start_as_current_span(\"agent.run\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n    56\t            try:\n    57\t                await self._loop(ctx, state)\n    58\t            except BudgetExceeded as exc:\n    59\t                await self.audit.record(ctx, \"budget_stop\", decision=\"stop\", reason=exc.limit, parent_step_id=state.last_step)\n    60\t                state.status, state.reply = \"stopped\", \"I've reached the limit for this conversation. An HR advisor can help further.\"\n    61\t            return state\n    62\t\n    63\t    async def _loop(self, ctx: RunContext, state: RunState) -> None:\n    64\t        model = self.cfg[\"model\"]\n    65\t        while True:\n    66\t            await self.stop.raise_if_stopped(ctx)\n    67\t            state.budget.check_step()\n    68\t            step_id = str(uuid.uuid4())\n    69\t            with tracer.start_as_current_span(\"gen_ai.chat\", attributes={\"gen_ai.request.model\": model[\"id\"]}):\n    70\t                resp = await self.llm.messages.create(\n    71\t                    model=model[\"id\"], system=SYSTEM_PROMPT, max_tokens=model[\"max_output_tokens\"],\n    72\t                    temperature=model[\"temperature\"], tools=self.registry.model_schemas(), messages=state.messages,\n    73\t                    timeout=state.budget.remaining_seconds(),\n    74\t                )\n    75\t                tokens, cost = state.budget.record_usage(resp.usage)\n    76\t                ctx_tokens = resp.usage.input_tokens + (resp.usage.cache_read_input_tokens or 0) + (resp.usage.cache_creation_input_tokens or 0)\n    77\t                await self.audit.record(\n    78\t                    ctx, \"model_call\", step_id=step_id, parent_step_id=state.last_step,\n    79\t                    context_tokens=ctx_tokens, context_tokens_method=\"measured:provider_usage_input+cache_read+cache_write\",\n    80\t                    model_requested=model[\"id\"], model_served=resp.model, result={\"stop_reason\": resp.stop_reason},\n    81\t                )\n    82\t                await self.quotas.record_usage(ctx, tokens, cost)\n    83\t            state.last_step = step_id\n    84\t            state.messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n    85\t            if resp.stop_reason != \"tool_use\":\n    86\t                state.status = \"done\"\n    87\t                state.reply = \"\".join(b.text for b in resp.content if b.type == \"text\")\n    88\t                return\n    89\t            results = []\n    90\t            for block in (b for b in resp.content if b.type == \"tool_use\"):\n    91\t                result = await self._handle_tool(ctx, state, step_id, block.id, block.name, block.input)\n    92\t                if result is None:  # paused for employee approval\n    93\t                    return\n    94\t                results.append(result)\n    95\t            state.messages.append({\"role\": \"user\", \"content\": results})\n    96\t\n    97\t    async def _handle_tool(self, ctx: RunContext, state: RunState, parent: str, tool_use_id: str,\n    98\t                           name: str, args: Any) -> dict[str, Any] | None:\n    99\t        step_id = str(uuid.uuid4())\n   100\t        await self.audit.record(ctx, \"proposed_action\", step_id=step_id, parent_step_id=parent, tool=name, args=args)\n   101\t        spec = self.registry.get(name)\n   102\t        if spec is None:\n   103\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=name, decision=\"deny\", reason=\"tool not in allowlist\")\n   104\t            return _tool_result(tool_use_id, \"This tool is not available.\", error=True)\n   105\t        target = spec.target(ctx.subject)\n   106\t        state.budget.check_tool_call()\n   107\t        try:\n   108\t            args = validate_tool_args(spec, args)\n   109\t        except ValidationRejected as exc:\n   110\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target,\n   111\t                                    decision=\"deny\", reason=exc.reason, args=args)\n   112\t            return _tool_result(tool_use_id, f\"Invalid arguments: {exc.reason}\", error=True)\n   113\t        if spec.approval == \"subject\":\n   114\t            approval_id, text = await self.approvals.request(ctx, spec.qualified, target, args, tool_use_id)\n   115\t            await self.audit.record(ctx, \"approval_requested\", step_id=step_id, tool=spec.qualified, target=target,\n   116\t                                    decision=\"hold\", approval_id=approval_id, args=args)\n   117\t            state.status = \"awaiting_approval\"\n   118\t            state.pending_approval = {\"approval_id\": approval_id, \"description\": text}\n   119\t            return None\n   120\t        await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target, decision=\"allow\")\n   121\t        return await self._execute(ctx, state, step_id, tool_use_id, spec, target, args, approval_id=None)\n   122\t\n   123\t    async def resume_with_approval(self, ctx: RunContext, state: RunState, approval_id: str) -> RunState:\n   124\t        with tracer.start_as_current_span(\"agent.resume\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n   125\t            pending = await self.approvals.pending(approval_id)\n   126\t            if pending is None or pending[\"run_id\"] != ctx.run_id:\n   127\t                raise ApprovalInvalid(\"unknown approval for this run\")\n   128\t            spec = self.registry.by_qualified(pending[\"operation\"])\n   129\t            step_id = str(uuid.uuid4())\n   130\t            try:\n   131\t                await self.stop.raise_if_stopped(ctx)\n   132\t                args = validate_tool_args(spec, pending[\"args\"])\n   133\t                target = spec.target(ctx.subject)\n   134\t                await self._recheck_state(ctx, state, spec, args)\n   135\t                grant = await self.approvals.consume(ctx, approval_id, spec.qualified, target, args)\n   136\t            except (ApprovalInvalid, ValidationRejected, ToolDenied, ToolError) as exc:\n   137\t                await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=pending[\"operation\"],\n   138\t                                        decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   139\t                state.status, state.reply = \"done\", \"That action can no longer be carried out as approved.\"\n   140\t                return state\n   141\t            await self.audit.record(ctx, \"approval_used\", step_id=step_id, parent_step_id=state.last_step,\n   142\t                                    tool=spec.qualified, target=target, decision=\"allow\", approval_id=approval_id,\n   143\t                                    result={\"approved_by\": grant[\"approved_by\"], \"approved_at\": grant[\"approved_at\"].isoformat()})\n   144\t            result = await self._execute(ctx, state, step_id, pending[\"tool_use_id\"], spec, target, args, approval_id=approval_id)\n   145\t            state.messages.append({\"role\": \"user\", \"content\": [result]})\n   146\t            state.status, state.pending_approval = \"running\", None\n   147\t            return await self.run(ctx, state)\n   148\t\n   149\t    async def _recheck_state(self, ctx: RunContext, state: RunState, spec: ToolSpec, args: dict[str, Any]) -> None:\n   150\t        \"\"\"Re-read the resource the action depends on, at execution time.\"\"\"\n   151\t        if spec.qualified != \"hris/file_leave_request\" or args[\"leave_type\"] == \"unpaid\":\n   152\t            return\n   153\t        balance_spec = self.registry.get(\"get_leave_balance\")\n   154\t        bal = await self.gateway.call(balance_spec, {\"leave_type\": args[\"leave_type\"]}, ctx, state.subject_token,\n   155\t                                      operation_id=str(uuid.uuid4()))\n   156\t        bal = validate_tool_output(balance_spec, bal, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n   157\t        days = (date.fromisoformat(args[\"end_date\"]) - date.fromisoformat(args[\"start_date\"])).days + 1\n   158\t        if days <= 0 or bal[\"balance_days\"] < days:\n   159\t            raise ApprovalInvalid(\"leave balance no longer covers the request\")\n   160\t\n   161\t    async def _execute(self, ctx: RunContext, state: RunState, step_id: str, tool_use_id: str, spec: ToolSpec,\n   162\t                       target: str, args: dict[str, Any], approval_id: str | None) -> dict[str, Any]:\n   163\t        operation_id = approval_id or str(uuid.uuid4())\n   164\t        with tracer.start_as_current_span(f\"execute_tool {spec.qualified}\", attributes={\"gen_ai.tool.name\": spec.name}):\n   165\t            try:\n   166\t                if spec.kind == \"local\":\n   167\t                    raw = await self.index.search(args[\"query\"], ctx.subject)\n   168\t                    max_chars = self.cfg[\"retrieval\"][\"max_chunk_chars\"]\n   169\t                    clean: Any = []\n   170\t                    for chunk in raw:\n   171\t                        try:\n   172\t                            clean.append(validate_chunk(chunk, max_chars))\n   173\t                        except ValidationRejected as exc:\n   174\t                            await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified,\n   175\t                                                    decision=\"hold\", reason=exc.reason, result={\"chunk_id\": chunk[\"chunk_id\"]})\n   176\t                else:\n   177\t                    raw = await self.gateway.call(spec, args, ctx, state.subject_token, operation_id=operation_id)\n   178\t                    clean = validate_tool_output(spec, raw, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n   179\t            except ToolDenied as exc:\n   180\t                await self.audit.record(ctx, \"tool_denied\", step_id=step_id, tool=spec.qualified, target=target,\n   181\t                                        decision=\"deny\", reason=exc.reason, approval_id=approval_id, args=args)\n   182\t                return _tool_result(tool_use_id, \"The request was refused by policy.\", error=True)\n   183\t            except ToolError as exc:\n   184\t                await self.audit.record(ctx, \"tool_error\", step_id=step_id, tool=spec.qualified, target=target,\n   185\t                                        decision=\"error\", reason=f\"status {exc.status}\", approval_id=approval_id,\n   186\t                                        args=args, result={\"detail\": exc.detail})\n   187\t                log.warning(\"tool error\", extra={\"tool\": spec.qualified, \"detail\": redact(exc.detail)})\n   188\t                return _tool_result(tool_use_id, f\"{spec.name} failed: {exc.detail}\", error=True)\n   189\t            except ValidationRejected as exc:\n   190\t                await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified, target=target,\n   191\t                                        decision=\"hold\", reason=exc.reason, approval_id=approval_id)\n   192\t                return _tool_result(tool_use_id, \"The tool returned data that could not be used.\", error=True)\n   193\t        await self.audit.record(ctx, \"tool_result\", step_id=step_id, tool=spec.qualified, target=target,\n   194\t                                decision=\"ok\", approval_id=approval_id, args=args, result=clean)\n   195\t        envelope = {\"source\": spec.qualified, \"trust\": \"untrusted_data\", \"data\": clean}\n   196\t        return _tool_result(tool_use_id, json.dumps(envelope, ensure_ascii=False))\n   197\t\n   198\t\n   199\tdef _tool_result(tool_use_id: str, content: str, error: bool = False) -> dict[str, Any]:\n   200\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"content\": content, \"is_error\": error}\n=== src/gateway_client.py\n     1\t\"\"\"Calls MCP tools through the hr-tool-gateway.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport logging\n     5\timport uuid\n     6\tfrom typing import Any\n     7\t\n     8\timport httpx\n     9\tfrom opentelemetry.propagate import inject\n    10\t\n    11\tfrom .audit import RunContext\n    12\tfrom .credentials import CredentialBroker\n    13\tfrom .tools import ToolSpec\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.gateway_client\")\n    16\t\n    17\tGATEWAY_URL = \"https://hr-tool-gateway.hr-agent.svc.cluster.local:8443/mcp\"\n    18\tGATEWAY_AUDIENCE = \"hr-tool-gateway\"\n    19\t\n    20\t\n    21\tclass ToolDenied(Exception):\n    22\t    def __init__(self, reason: str):\n    23\t        super().__init__(reason)\n    24\t        self.reason = reason\n    25\t\n    26\t\n    27\tclass ToolError(Exception):\n    28\t    def __init__(self, status: int, detail: str):\n    29\t        super().__init__(f\"{status}\")\n    30\t        self.status = status\n    31\t        self.detail = detail\n    32\t\n    33\t\n    34\tclass GatewayUnavailable(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass GatewayClient:\n    39\t    def __init__(self, client: httpx.AsyncClient, creds: CredentialBroker):\n    40\t        self._client = client\n    41\t        self._creds = creds\n    42\t\n    43\t    async def call(\n    44\t        self, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, subject_token: str, *, operation_id: str\n    45\t    ) -> dict[str, Any]:\n    46\t        try:\n    47\t            token = await self._creds.token(\n    48\t                audience=GATEWAY_AUDIENCE, scope=spec.scope, subject_token=subject_token, subject=ctx.subject\n    49\t            )\n    50\t            return await self._post(GATEWAY_URL, token, spec, args, ctx, operation_id)\n    51\t        except GatewayUnavailable:\n    52\t            if not spec.direct_route:\n    53\t                raise\n    54\t            log.warning(\"gateway unavailable, using direct route\", extra={\"tool\": spec.qualified})\n    55\t            token = await self._creds.token(\n    56\t                audience=spec.direct_route[\"audience\"], scope=spec.scope,\n    57\t                subject_token=subject_token, subject=ctx.subject,\n    58\t            )\n    59\t            return await self._post(spec.direct_route[\"endpoint\"], token, spec, args, ctx, operation_id)\n    60\t\n    61\t    async def _post(\n    62\t        self, url: str, token: str, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, operation_id: str\n    63\t    ) -> dict[str, Any]:\n    64\t        tool_name = spec.qualified.split(\"/\", 1)[1]\n    65\t        headers = {\n    66\t            \"Authorization\": f\"Bearer {token}\",\n    67\t            \"Mcp-Method\": \"tools/call\",\n    68\t            \"Mcp-Name\": tool_name,\n    69\t            \"Idempotency-Key\": operation_id,\n    70\t            \"X-Agent-Instance\": ctx.agent_instance_id,\n    71\t            \"X-Agent-Type-Id\": ctx.agent_type_id,\n    72\t        }\n    73\t        inject(headers)\n    74\t        body = {\n    75\t            \"jsonrpc\": \"2.0\",\n    76\t            \"id\": str(uuid.uuid4()),\n    77\t            \"method\": \"tools/call\",\n    78\t            \"params\": {\"name\": tool_name, \"arguments\": args, \"_meta\": {\"server\": spec.server}},\n    79\t        }\n    80\t        try:\n    81\t            resp = await self._client.post(url, json=body, headers=headers, timeout=10.0)\n    82\t        except (httpx.ConnectError, httpx.ConnectTimeout) as exc:\n    83\t            raise GatewayUnavailable(str(exc)) from exc\n    84\t        except httpx.TimeoutException as exc:\n    85\t            raise ToolError(504, f\"no response; outcome unknown for operation {operation_id}\") from exc\n    86\t        if resp.status_code == 503:\n    87\t            raise GatewayUnavailable(resp.text[:200])\n    88\t        if resp.status_code in (401, 403, 429):\n    89\t            raise ToolDenied(resp.json().get(\"error\", \"denied\"))\n    90\t        if resp.status_code >= 400:\n    91\t            raise ToolError(resp.status_code, resp.json().get(\"detail\", resp.text))\n    92\t        payload = resp.json()\n    93\t        if \"error\" in payload:\n    94\t            raise ToolError(200, str(payload[\"error\"].get(\"message\", \"\")))\n    95\t        return payload[\"result\"][\"structuredContent\"]\n=== src/retrieval.py\n     1\t\"\"\"Handbook search over retrieval.chunks (Postgres full-text search).\n     2\t\n     3\tChunks are written only by the hr-docs-ingest job (role hr_docs_ingest). Each chunk carries\n     4\tsource, added_at, added_by, trust, an audience, an optional expiry and a quarantine flag.\n     5\tEmployee-specific documents (offer letters, individual arrangements) have audience\n     6\t'employee' and list the employees allowed to see them.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport time\n    12\tfrom typing import Any\n    13\t\n    14\timport asyncpg\n    15\t\n    16\t_SEARCH = \"\"\"\n    17\tSELECT c.chunk_id, c.source, c.trust, c.text,\n    18\t       ts_rank(c.tsv, websearch_to_tsquery('english', $1)) AS rank\n    19\t  FROM retrieval.chunks c\n    20\t WHERE c.tsv @@ websearch_to_tsquery('english', $1)\n    21\t   AND NOT c.quarantined\n    22\t   AND (c.expires_at IS NULL OR c.expires_at > now())\n    23\t   AND (c.audience = 'all' OR (c.audience = 'employee' AND $2 = ANY (c.allowed_employees)))\n    24\t ORDER BY rank DESC\n    25\t LIMIT $3\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass PolicyIndex:\n    30\t    def __init__(self, pool: asyncpg.Pool, top_k: int, cache_ttl: float):\n    31\t        self._pool = pool\n    32\t        self._top_k = top_k\n    33\t        self._ttl = cache_ttl\n    34\t        self._cache: dict[str, tuple[float, str, list[dict[str, Any]]]] = {}\n    35\t\n    36\t    async def _index_version(self) -> str:\n    37\t        # Bumped by ingest on every add, expiry, quarantine or permission change.\n    38\t        return await self._pool.fetchval(\"SELECT version FROM retrieval.index_state WHERE id = 1\")\n    39\t\n    40\t    def _key(self, query: str) -> str:\n    41\t        normalized = \" \".join(query.lower().split())\n    42\t        return hashlib.sha256(f\"{self._top_k}|{normalized}\".encode()).hexdigest()\n    43\t\n    44\t    async def search(self, query: str, employee_id: str) -> list[dict[str, Any]]:\n    45\t        version = await self._index_version()\n    46\t        key = self._key(query)\n    47\t        hit = self._cache.get(key)\n    48\t        if hit and hit[1] == version and time.monotonic() - hit[0] < self._ttl:\n    49\t            return hit[2]\n    50\t        rows = await self._pool.fetch(_SEARCH, query, employee_id, self._top_k)\n    51\t        chunks = [dict(r) for r in rows]\n    52\t        self._cache[key] = (time.monotonic(), version, chunks)\n    53\t        return chunks\n=== src/approvals.py\n     1\t\"\"\"Approval records for consequential tool calls.\n     2\t\n     3\tAn approval is bound to one agent instance, one operation, one target and the SHA-256 of\n     4\tthe canonical arguments. Only the employee on whose behalf the run acts may approve, they\n     5\tsee a rendered description of the exact action, and each approval is consumed once.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport json\n    11\timport uuid\n    12\tfrom datetime import timedelta\n    13\tfrom typing import Any\n    14\t\n    15\timport asyncpg\n    16\t\n    17\tfrom .audit import RunContext\n    18\t\n    19\t\n    20\tclass ApprovalInvalid(Exception):\n    21\t    pass\n    22\t\n    23\t\n    24\tdef args_digest(args: dict[str, Any]) -> str:\n    25\t    canonical = json.dumps(args, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False)\n    26\t    return hashlib.sha256(canonical.encode()).hexdigest()\n    27\t\n    28\t\n    29\tdef describe(operation: str, target: str, args: dict[str, Any]) -> str:\n    30\t    if operation == \"hris/file_leave_request\":\n    31\t        return (f\"Submit a {args['leave_type']} leave request from {args['start_date']} to {args['end_date']} \"\n    32\t                f\"for {target}. Your manager will be asked to approve it in HRIS.\")\n    33\t    if operation == \"helpdesk/create_ticket\":\n    34\t        return f\"Send this summary to an HR advisor ({args['category']}):\\n\\n{args['summary']}\"\n    35\t    raise ValueError(operation)\n    36\t\n    37\t\n    38\tclass ApprovalStore:\n    39\t    def __init__(self, pool: asyncpg.Pool, ttl_seconds: int):\n    40\t        self._pool = pool\n    41\t        self._ttl = timedelta(seconds=ttl_seconds)\n    42\t\n    43\t    async def request(self, ctx: RunContext, operation: str, target: str, args: dict[str, Any], tool_use_id: str) -> tuple[str, str]:\n    44\t        approval_id = str(uuid.uuid4())\n    45\t        text = describe(operation, target, args)\n    46\t        await self._pool.execute(\n    47\t            \"\"\"INSERT INTO approvals.grants\n    48\t                 (approval_id, run_id, agent_instance_id, subject, operation, target, args_sha256, args,\n    49\t                  tool_use_id, description, requested_at, expires_at)\n    50\t               VALUES ($1, $2, $3, $4, $5, $6, $7, $8::jsonb, $9, $10, now(), now() + $11)\"\"\",\n    51\t            approval_id, ctx.run_id, ctx.agent_instance_id, ctx.subject, operation, target,\n    52\t            args_digest(args), json.dumps(args), tool_use_id, text, self._ttl,\n    53\t        )\n    54\t        return approval_id, text\n    55\t\n    56\t    async def confirm(self, approval_id: str, approver: str) -> None:\n    57\t        \"\"\"Called from the employee's authenticated session. Approver must be the run's subject.\"\"\"\n    58\t        row = await self._pool.fetchrow(\n    59\t            \"\"\"UPDATE approvals.grants SET approved_by = $2, approved_at = now()\n    60\t                WHERE approval_id = $1 AND subject = $2 AND approved_at IS NULL AND expires_at > now()\n    61\t                RETURNING approval_id\"\"\",\n    62\t            approval_id, approver,\n    63\t        )\n    64\t        if row is None:\n    65\t            raise ApprovalInvalid(\"not found, expired, already decided, or approver lacks authority\")\n    66\t\n    67\t    async def consume(self, ctx: RunContext, approval_id: str, operation: str, target: str, args: dict[str, Any]) -> dict[str, Any]:\n    68\t        \"\"\"Atomically mark the approval used. Every binding is re-checked in the same statement.\"\"\"\n    69\t        row = await self._pool.fetchrow(\n    70\t            \"\"\"UPDATE approvals.grants SET used_at = now()\n    71\t                WHERE approval_id = $1\n    72\t                  AND used_at IS NULL\n    73\t                  AND approved_at IS NOT NULL\n    74\t                  AND approved_by = subject\n    75\t                  AND expires_at > now()\n    76\t                  AND agent_instance_id = $2\n    77\t                  AND subject = $3\n    78\t                  AND operation = $4\n    79\t                  AND target = $5\n    80\t                  AND args_sha256 = $6\n    81\t                RETURNING approval_id, approved_by, approved_at, expires_at\"\"\",\n    82\t            approval_id, ctx.agent_instance_id, ctx.subject, operation, target, args_digest(args),\n    83\t        )\n    84\t        if row is None:\n    85\t            raise ApprovalInvalid(\"approval does not match this action, was used, or expired\")\n    86\t        return dict(row)\n    87\t\n    88\t    async def pending(self, approval_id: str) -> dict[str, Any] | None:\n    89\t        row = await self._pool.fetchrow(\n    90\t            \"SELECT run_id, operation, target, args, tool_use_id FROM approvals.grants WHERE approval_id = $1\",\n    91\t            approval_id,\n    92\t        )\n    93\t        if row is None:\n    94\t            return None\n    95\t        out = dict(row)\n    96\t        out[\"args\"] = json.loads(out[\"args\"])\n    97\t        return out","is_error":false}]},"parent_tool_use_id":null,"session_id":"a775c57f-3431-4870-9216-f1a3261464e8","uuid":"97496865-d6f7-4acb-b22e-41509c175da9","timestamp":"2026-11-21T12:30:42.074Z","tool_use_result":{"stdout":"=== src/agent.py\n     1\t\"\"\"Agent loop for the HR helpdesk.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport json\n     5\timport logging\n     6\timport pathlib\n     7\timport uuid\n     8\tfrom dataclasses import dataclass, field\n     9\tfrom datetime import date\n    10\tfrom typing import Any\n    11\t\n    12\tfrom anthropic import AsyncAnthropic\n    13\tfrom opentelemetry import trace\n    14\t\n    15\tfrom .approvals import ApprovalInvalid, ApprovalStore\n    16\tfrom .audit import AuditWriter, RunContext\n    17\tfrom .budgets import BudgetExceeded, QuotaStore, RunBudget\n    18\tfrom .gateway_client import GatewayClient, ToolDenied, ToolError\n    19\tfrom .killswitch import StopControl\n    20\tfrom .redact import redact\n    21\tfrom .retrieval import PolicyIndex\n    22\tfrom .tools import ToolRegistry, ToolSpec\n    23\tfrom .validation import ValidationRejected, validate_chunk, validate_tool_args, validate_tool_output\n    24\t\n    25\tlog = logging.getLogger(\"hr_agent.loop\")\n    26\ttracer = trace.get_tracer(\"hr_agent\")\n    27\t\n    28\tSYSTEM_PROMPT = (pathlib.Path(__file__).resolve().parent.parent / \"prompts\" / \"system.md\").read_text()\n    29\t\n    30\t\n    31\t@dataclass\n    32\tclass RunState:\n    33\t    messages: list[dict[str, Any]]\n    34\t    budget: RunBudget\n    35\t    subject_token: str\n    36\t    status: str = \"running\"\n    37\t    reply: str | None = None\n    38\t    pending_approval: dict[str, Any] | None = None\n    39\t    last_step: str | None = None\n    40\t    subagents_started: int = 0\n    41\t    extra: dict[str, Any] = field(default_factory=dict)\n    42\t\n    43\t\n    44\tclass Agent:\n    45\t    def __init__(self, cfg: dict[str, Any], registry: ToolRegistry, llm: AsyncAnthropic, gateway: GatewayClient,\n    46\t                 index: PolicyIndex, approvals: ApprovalStore, quotas: QuotaStore, audit: AuditWriter, stop: StopControl):\n    47\t        self.cfg, self.registry, self.llm, self.gateway = cfg, registry, llm, gateway\n    48\t        self.index, self.approvals, self.quotas, self.audit, self.stop = index, approvals, quotas, audit, stop\n    49\t\n    50\t    def new_state(self, user_text: str, subject_token: str) -> RunState:\n    51\t        budget = RunBudget(self.cfg[\"budgets\"][\"run\"], self.cfg[\"pricing\"])\n    52\t        return RunState(messages=[{\"role\": \"user\", \"content\": user_text}], budget=budget, subject_token=subject_token)\n    53\t\n    54\t    async def run(self, ctx: RunContext, state: RunState) -> RunState:\n    55\t        with tracer.start_as_current_span(\"agent.run\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n    56\t            try:\n    57\t                await self._loop(ctx, state)\n    58\t            except BudgetExceeded as exc:\n    59\t                await self.audit.record(ctx, \"budget_stop\", decision=\"stop\", reason=exc.limit, parent_step_id=state.last_step)\n    60\t                state.status, state.reply = \"stopped\", \"I've reached the limit for this conversation. An HR advisor can help further.\"\n    61\t            return state\n    62\t\n    63\t    async def _loop(self, ctx: RunContext, state: RunState) -> None:\n    64\t        model = self.cfg[\"model\"]\n    65\t        while True:\n    66\t            await self.stop.raise_if_stopped(ctx)\n    67\t            state.budget.check_step()\n    68\t            step_id = str(uuid.uuid4())\n    69\t            with tracer.start_as_current_span(\"gen_ai.chat\", attributes={\"gen_ai.request.model\": model[\"id\"]}):\n    70\t                resp = await self.llm.messages.create(\n    71\t                    model=model[\"id\"], system=SYSTEM_PROMPT, max_tokens=model[\"max_output_tokens\"],\n    72\t                    temperature=model[\"temperature\"], tools=self.registry.model_schemas(), messages=state.messages,\n    73\t                    timeout=state.budget.remaining_seconds(),\n    74\t                )\n    75\t                tokens, cost = state.budget.record_usage(resp.usage)\n    76\t                ctx_tokens = resp.usage.input_tokens + (resp.usage.cache_read_input_tokens or 0) + (resp.usage.cache_creation_input_tokens or 0)\n    77\t                await self.audit.record(\n    78\t                    ctx, \"model_call\", step_id=step_id, parent_step_id=state.last_step,\n    79\t                    context_tokens=ctx_tokens, context_tokens_method=\"measured:provider_usage_input+cache_read+cache_write\",\n    80\t                    model_requested=model[\"id\"], model_served=resp.model, result={\"stop_reason\": resp.stop_reason},\n    81\t                )\n    82\t                await self.quotas.record_usage(ctx, tokens, cost)\n    83\t            state.last_step = step_id\n    84\t            state.messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n    85\t            if resp.stop_reason != \"tool_use\":\n    86\t                state.status = \"done\"\n    87\t                state.reply = \"\".join(b.text for b in resp.content if b.type == \"text\")\n    88\t                return\n    89\t            results = []\n    90\t            for block in (b for b in resp.content if b.type == \"tool_use\"):\n    91\t                result = await self._handle_tool(ctx, state, step_id, block.id, block.name, block.input)\n    92\t                if result is None:  # paused for employee approval\n    93\t                    return\n    94\t                results.append(result)\n    95\t            state.messages.append({\"role\": \"user\", \"content\": results})\n    96\t\n    97\t    async def _handle_tool(self, ctx: RunContext, state: RunState, parent: str, tool_use_id: str,\n    98\t                           name: str, args: Any) -> dict[str, Any] | None:\n    99\t        step_id = str(uuid.uuid4())\n   100\t        await self.audit.record(ctx, \"proposed_action\", step_id=step_id, parent_step_id=parent, tool=name, args=args)\n   101\t        spec = self.registry.get(name)\n   102\t        if spec is None:\n   103\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=name, decision=\"deny\", reason=\"tool not in allowlist\")\n   104\t            return _tool_result(tool_use_id, \"This tool is not available.\", error=True)\n   105\t        target = spec.target(ctx.subject)\n   106\t        state.budget.check_tool_call()\n   107\t        try:\n   108\t            args = validate_tool_args(spec, args)\n   109\t        except ValidationRejected as exc:\n   110\t            await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target,\n   111\t                                    decision=\"deny\", reason=exc.reason, args=args)\n   112\t            return _tool_result(tool_use_id, f\"Invalid arguments: {exc.reason}\", error=True)\n   113\t        if spec.approval == \"subject\":\n   114\t            approval_id, text = await self.approvals.request(ctx, spec.qualified, target, args, tool_use_id)\n   115\t            await self.audit.record(ctx, \"approval_requested\", step_id=step_id, tool=spec.qualified, target=target,\n   116\t                                    decision=\"hold\", approval_id=approval_id, args=args)\n   117\t            state.status = \"awaiting_approval\"\n   118\t            state.pending_approval = {\"approval_id\": approval_id, \"description\": text}\n   119\t            return None\n   120\t        await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=spec.qualified, target=target, decision=\"allow\")\n   121\t        return await self._execute(ctx, state, step_id, tool_use_id, spec, target, args, approval_id=None)\n   122\t\n   123\t    async def resume_with_approval(self, ctx: RunContext, state: RunState, approval_id: str) -> RunState:\n   124\t        with tracer.start_as_current_span(\"agent.resume\", attributes={\"agent.instance.id\": ctx.agent_instance_id}):\n   125\t            pending = await self.approvals.pending(approval_id)\n   126\t            if pending is None or pending[\"run_id\"] != ctx.run_id:\n   127\t                raise ApprovalInvalid(\"unknown approval for this run\")\n   128\t            spec = self.registry.by_qualified(pending[\"operation\"])\n   129\t            step_id = str(uuid.uuid4())\n   130\t            try:\n   131\t                await self.stop.raise_if_stopped(ctx)\n   132\t                args = validate_tool_args(spec, pending[\"args\"])\n   133\t                target = spec.target(ctx.subject)\n   134\t                await self._recheck_state(ctx, state, spec, args)\n   135\t                grant = await self.approvals.consume(ctx, approval_id, spec.qualified, target, args)\n   136\t            except (ApprovalInvalid, ValidationRejected, ToolDenied, ToolError) as exc:\n   137\t                await self.audit.record(ctx, \"authz_decision\", step_id=step_id, tool=pending[\"operation\"],\n   138\t                                        decision=\"deny\", reason=str(exc), approval_id=approval_id)\n   139\t                state.status, state.reply = \"done\", \"That action can no longer be carried out as approved.\"\n   140\t                return state\n   141\t            await self.audit.record(ctx, \"approval_used\", step_id=step_id, parent_step_id=state.last_step,\n   142\t                                    tool=spec.qualified, target=target, decision=\"allow\", approval_id=approval_id,\n   143\t                                    result={\"approved_by\": grant[\"approved_by\"], \"approved_at\": grant[\"approved_at\"].isoformat()})\n   144\t            result = await self._execute(ctx, state, step_id, pending[\"tool_use_id\"], spec, target, args, approval_id=approval_id)\n   145\t            state.messages.append({\"role\": \"user\", \"content\": [result]})\n   146\t            state.status, state.pending_approval = \"running\", None\n   147\t            return await self.run(ctx, state)\n   148\t\n   149\t    async def _recheck_state(self, ctx: RunContext, state: RunState, spec: ToolSpec, args: dict[str, Any]) -> None:\n   150\t        \"\"\"Re-read the resource the action depends on, at execution time.\"\"\"\n   151\t        if spec.qualified != \"hris/file_leave_request\" or args[\"leave_type\"] == \"unpaid\":\n   152\t            return\n   153\t        balance_spec = self.registry.get(\"get_leave_balance\")\n   154\t        bal = await self.gateway.call(balance_spec, {\"leave_type\": args[\"leave_type\"]}, ctx, state.subject_token,\n   155\t                                      operation_id=str(uuid.uuid4()))\n   156\t        bal = validate_tool_output(balance_spec, bal, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n   157\t        days = (date.fromisoformat(args[\"end_date\"]) - date.fromisoformat(args[\"start_date\"])).days + 1\n   158\t        if days <= 0 or bal[\"balance_days\"] < days:\n   159\t            raise ApprovalInvalid(\"leave balance no longer covers the request\")\n   160\t\n   161\t    async def _execute(self, ctx: RunContext, state: RunState, step_id: str, tool_use_id: str, spec: ToolSpec,\n   162\t                       target: str, args: dict[str, Any], approval_id: str | None) -> dict[str, Any]:\n   163\t        operation_id = approval_id or str(uuid.uuid4())\n   164\t        with tracer.start_as_current_span(f\"execute_tool {spec.qualified}\", attributes={\"gen_ai.tool.name\": spec.name}):\n   165\t            try:\n   166\t                if spec.kind == \"local\":\n   167\t                    raw = await self.index.search(args[\"query\"], ctx.subject)\n   168\t                    max_chars = self.cfg[\"retrieval\"][\"max_chunk_chars\"]\n   169\t                    clean: Any = []\n   170\t                    for chunk in raw:\n   171\t                        try:\n   172\t                            clean.append(validate_chunk(chunk, max_chars))\n   173\t                        except ValidationRejected as exc:\n   174\t                            await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified,\n   175\t                                                    decision=\"hold\", reason=exc.reason, result={\"chunk_id\": chunk[\"chunk_id\"]})\n   176\t                else:\n   177\t                    raw = await self.gateway.call(spec, args, ctx, state.subject_token, operation_id=operation_id)\n   178\t                    clean = validate_tool_output(spec, raw, self.cfg[\"limits\"][\"max_tool_output_bytes\"])\n   179\t            except ToolDenied as exc:\n   180\t                await self.audit.record(ctx, \"tool_denied\", step_id=step_id, tool=spec.qualified, target=target,\n   181\t                                        decision=\"deny\", reason=exc.reason, approval_id=approval_id, args=args)\n   182\t                return _tool_result(tool_use_id, \"The request was refused by policy.\", error=True)\n   183\t            except ToolError as exc:\n   184\t                await self.audit.record(ctx, \"tool_error\", step_id=step_id, tool=spec.qualified, target=target,\n   185\t                                        decision=\"error\", reason=f\"status {exc.status}\", approval_id=approval_id,\n   186\t                                        args=args, result={\"detail\": exc.detail})\n   187\t                log.warning(\"tool error\", extra={\"tool\": spec.qualified, \"detail\": redact(exc.detail)})\n   188\t                return _tool_result(tool_use_id, f\"{spec.name} failed: {exc.detail}\", error=True)\n   189\t            except ValidationRejected as exc:\n   190\t                await self.audit.record(ctx, \"content_held\", step_id=step_id, tool=spec.qualified, target=target,\n   191\t                                        decision=\"hold\", reason=exc.reason, approval_id=approval_id)\n   192\t                return _tool_result(tool_use_id, \"The tool returned data that could not be used.\", error=True)\n   193\t        await self.audit.record(ctx, \"tool_result\", step_id=step_id, tool=spec.qualified, target=target,\n   194\t                                decision=\"ok\", approval_id=approval_id, args=args, result=clean)\n   195\t        envelope = {\"source\": spec.qualified, \"trust\": \"untrusted_data\", \"data\": clean}\n   196\t        return _tool_result(tool_use_id, json.dumps(envelope, ensure_ascii=False))\n   197\t\n   198\t\n   199\tdef _tool_result(tool_use_id: str, content: str, error: bool = False) -> dict[str, Any]:\n   200\t    return {\"type\": \"tool_result\", \"tool_use_id\": tool_use_id, \"content\": content, \"is_error\": error}\n=== src/gateway_client.py\n     1\t\"\"\"Calls MCP tools through the hr-tool-gateway.\"\"\"\n     2\tfrom __future__ import annotations\n     3\t\n     4\timport logging\n     5\timport uuid\n     6\tfrom typing import Any\n     7\t\n     8\timport httpx\n     9\tfrom opentelemetry.propagate import inject\n    10\t\n    11\tfrom .audit import RunContext\n    12\tfrom .credentials import CredentialBroker\n    13\tfrom .tools import ToolSpec\n    14\t\n    15\tlog = logging.getLogger(\"hr_agent.gateway_client\")\n    16\t\n    17\tGATEWAY_URL = \"https://hr-tool-gateway.hr-agent.svc.cluster.local:8443/mcp\"\n    18\tGATEWAY_AUDIENCE = \"hr-tool-gateway\"\n    19\t\n    20\t\n    21\tclass ToolDenied(Exception):\n    22\t    def __init__(self, reason: str):\n    23\t        super().__init__(reason)\n    24\t        self.reason = reason\n    25\t\n    26\t\n    27\tclass ToolError(Exception):\n    28\t    def __init__(self, status: int, detail: str):\n    29\t        super().__init__(f\"{status}\")\n    30\t        self.status = status\n    31\t        self.detail = detail\n    32\t\n    33\t\n    34\tclass GatewayUnavailable(Exception):\n    35\t    pass\n    36\t\n    37\t\n    38\tclass GatewayClient:\n    39\t    def __init__(self, client: httpx.AsyncClient, creds: CredentialBroker):\n    40\t        self._client = client\n    41\t        self._creds = creds\n    42\t\n    43\t    async def call(\n    44\t        self, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, subject_token: str, *, operation_id: str\n    45\t    ) -> dict[str, Any]:\n    46\t        try:\n    47\t            token = await self._creds.token(\n    48\t                audience=GATEWAY_AUDIENCE, scope=spec.scope, subject_token=subject_token, subject=ctx.subject\n    49\t            )\n    50\t            return await self._post(GATEWAY_URL, token, spec, args, ctx, operation_id)\n    51\t        except GatewayUnavailable:\n    52\t            if not spec.direct_route:\n    53\t                raise\n    54\t            log.warning(\"gateway unavailable, using direct route\", extra={\"tool\": spec.qualified})\n    55\t            token = await self._creds.token(\n    56\t                audience=spec.direct_route[\"audience\"], scope=spec.scope,\n    57\t                subject_token=subject_token, subject=ctx.subject,\n    58\t            )\n    59\t            return await self._post(spec.direct_route[\"endpoint\"], token, spec, args, ctx, operation_id)\n    60\t\n    61\t    async def _post(\n    62\t        self, url: str, token: str, spec: ToolSpec, args: dict[str, Any], ctx: RunContext, operation_id: str\n    63\t    ) -> dict[str, Any]:\n    64\t        tool_name = spec.qualified.split(\"/\", 1)[1]\n    65\t        headers = {\n    66\t            \"Authorization\": f\"Bearer {token}\",\n    67\t            \"Mcp-Method\": \"tools/call\",\n    68\t            \"Mcp-Name\": tool_name,\n    69\t            \"Idempotency-Key\": operation_id,\n    70\t            \"X-Agent-Instance\": ctx.agent_instance_id,\n    71\t            \"X-Agent-Type-Id\": ctx.agent_type_id,\n    72\t        }\n    73\t        inject(headers)\n    74\t        body = {\n    75\t            \"jsonrpc\": \"2.0\",\n    76\t            \"id\": str(uuid.uuid4()),\n    77\t            \"method\": \"tools/call\",\n    78\t            \"params\": {\"name\": tool_name, \"arguments\": args, \"_meta\": {\"server\": spec.server}},\n    79\t        }\n    80\t        try:\n    81\t            resp = await self._client.post(url, json=body, headers=headers, timeout=10.0)\n    82\t        except (httpx.ConnectError, httpx.ConnectTimeout) as exc:\n    83\t            raise GatewayUnavailable(str(exc)) from exc\n    84\t        except httpx.TimeoutException as exc:\n    85\t            raise ToolError(504, f\"no response; outcome unknown for operation {operation_id}\") from exc\n    86\t        if resp.status_code == 503:\n    87\t            raise GatewayUnavailable(resp.text[:200])\n    88\t        if resp.status_code in (401, 403, 429):\n    89\t            raise ToolDenied(resp.json().get(\"error\", \"denied\"))\n    90\t        if resp.status_code >= 400:\n    91\t            raise ToolError(resp.status_code, resp.json().get(\"detail\", resp.text))\n    92\t        payload = resp.json()\n    93\t        if \"error\" in payload:\n    94\t            raise ToolError(200, str(payload[\"error\"].get(\"message\", \"\")))\n    95\t        return payload[\"result\"][\"structuredContent\"]\n=== src/retrieval.py\n     1\t\"\"\"Handbook search over retrieval.chunks (Postgres full-text search).\n     2\t\n     3\tChunks are written only by the hr-docs-ingest job (role hr_docs_ingest). Each chunk carries\n     4\tsource, added_at, added_by, trust, an audience, an optional expiry and a quarantine flag.\n     5\tEmployee-specific documents (offer letters, individual arrangements) have audience\n     6\t'employee' and list the employees allowed to see them.\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport hashlib\n    11\timport time\n    12\tfrom typing import Any\n    13\t\n    14\timport asyncpg\n    15\t\n    16\t_SEARCH = \"\"\"\n    17\tSELECT c.chunk_id, c.source, c.trust, c.text,\n    18\t       ts_rank(c.tsv, websearch_to_tsquery('english', $1)) AS rank\n    19\t  FROM retrieval.chunks c\n    20\t WHERE c.tsv @@ websearch_to_tsquery('english', $1)\n    21\t   AND NOT c.quarantined\n    22\t   AND (c.expires_at IS NULL OR c.expires_at > now())\n    23\t   AND (c.audience = 'all' OR (c.audience = 'employee' AND $2 = ANY (c.allowed_employees)))\n    24\t ORDER BY rank DESC\n    25\t LIMIT $3\n    26\t\"\"\"\n    27\t\n    28\t\n    29\tclass PolicyIndex:\n    30\t    def __init__(self, pool: asyncpg.Pool, top_k: int, cache_ttl: float):\n    31\t        self._pool = pool\n    32\t        self._top_k = top_k\n    33\t        self._ttl = cache_ttl\n    34\t        self._cache: dict[str, tuple[float, str, list[dict[str, Any]]]] = {}\n    35\t\n    36\t    async def _index_version(self) -> str:\n    37\t        # Bumped by ingest on every add, expiry, quarantine or permission change.\n    38\t        return await self._pool.fetchval(\"SELECT version FROM retrieval.index_state WHERE id = 1\")\n    39\t\n    40\t    def _key(self, query: str) -> str:\n    41\t        normalized = \" \".join(query.lower().split())\n    42\t        return hashlib.sha256(f\"{self._top_k}|{normalized}\".encode()).hexdigest()\n    43\t\n    44\t    async def search(self, query: str, employee_id: str) -> list[dict[str, Any]]:\n    45\t        version = await self._index_version()\n    46\t        key = self._key(query)\n    47\t        hit = self._cache.get(key)\n    48\t        if hit and hit[1] == version and time.monotonic() - hit[0] < self._ttl:\n    49\t            return hit[2]\n    50\t        rows = await self._pool.fetch(_SEARCH, query, employee_id, self._top_k)\n    51\t        chunks = [dict(r) for r in rows]\n    52\t        self._cache[key] = (time.monotonic(), version, chunks)\n    53\t        return chunks\n=== src/approvals.py\n     1\t\"\"\"Approval records for consequential tool calls.\n     2\t\n     3\tAn approval is bound to one agent instance, one operation, one target and the SHA-256 of\n     4\tthe canonical arguments. Only the employee on whose behalf the run acts may approve, they\n     5\tsee a rendered description of the exact action, and each approval is consumed once.\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport hashlib\n    10\timport json\n    11\timport uuid\n    12\tfrom datetime import timedelta\n    13\tfrom typing import Any\n    14\t\n    15\timport asyncpg\n    16\t\n    17\tfrom .audit import RunContext\n    18\t\n    19\t\n    20\tclass ApprovalInvalid(Exception):\n    21\t    pass\n    22\t\n    23\t\n    24\tdef args_digest(args: dict[str, Any]) -> str:\n    25\t    canonical = json.dumps(args, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False)\n    26\t    return hashlib.sha256(canonical.encode()).hexdigest()\n    27\t\n    28\t\n    29\tdef describe(operation: str, target: str, args: dict[str, Any]) -> str:\n    30\t    if operation == \"hris/file_leave_request\":\n    31\t        return (f\"Submit a {args['leave_type']} leave request from {args['start_date']} to {args['end_date']} \"\n    32\t                f\"for {target}. Your manager will be asked to approve it in HRIS.\")\n    33\t    if operation == \"helpdesk/create_ticket\":\n    34\t        return f\"Send this summary to an HR advisor ({args['category']}):\\n\\n{args['summary']}\"\n    35\t    raise ValueError(operation)\n    36\t\n    37\t\n    38\tclass ApprovalStore:\n    39\t    def __init__(self, pool: asyncpg.Pool, ttl_seconds: int):\n    40\t        self._pool = pool\n    41\t        self._ttl = timedelta(seconds=ttl_seconds)\n    42\t\n    43\t    async def request(self, ctx: RunContext, operation: str, target: str, args: dict[str, Any], tool_use_id: str) -> tuple[str, str]:\n    44\t        approval_id = str(uuid.uuid4())\n    45\t        text = describe(operation, target, args)\n    46\t        await self._pool.execute(\n    47\t            \"\"\"INSERT INTO approvals.grants\n    48\t                 (approval_id, run_id, agent_instance_id, subject, operation, target, args_sha256, args,\n    49\t                  tool_use_id, description, requested_at, expires_at)\n    50\t               VALUES ($1, $2, $3, $4, $5, $6, $7, $8::jsonb, $9, $10, now(), now() + $11)\"\"\",\n    51\t            approval_id, ctx.run_id, ctx.agent_instance_id, ctx.subject, operation, target,\n    52\t            args_digest(args), json.dumps(args), tool_use_id, text, self._ttl,\n    53\t        )\n    54\t        return approval_id, text\n    55\t\n    56\t    async def confirm(self, approval_id: str, approver: str) -> None:\n    57\t        \"\"\"Called from the employee's authenticated session. Approver must be the run's subject.\"\"\"\n    58\t        row = await self._pool.fetchrow(\n    59\t            \"\"\"UPDATE approvals.grants SET approved_by = $2, approved_at = now()\n    60\t                WHERE approval_id = $1 AND subject = $2 AND approved_at IS NULL AND expires_at > now()\n    61\t                RETURNING approval_id\"\"\",\n    62\t            approval_id, approver,\n    63\t        )\n    64\t        if row is None:\n    65\t            raise ApprovalInvalid(\"not found, expired, already decided, or approver lacks authority\")\n    66\t\n    67\t    async def consume(self, ctx: RunContext, approval_id: str, operation: str, target: str, args: dict[str, Any]) -> dict[str, Any]:\n    68\t        \"\"\"Atomically mark the approval used. Every binding is re-checked in the same statement.\"\"\"\n    69\t        row = await self._pool.fetchrow(\n    70\t            \"\"\"UPDATE approvals.grants SET used_at = now()\n    71\t                WHERE approval_id = $1\n    72\t                  AND used_at IS NULL\n    73\t                  AND approved_at IS NOT NULL\n    74\t                  AND approved_by = subject\n    75\t                  AND expires_at > now()\n    76\t                  AND agent_instance_id = $2\n    77\t                  AND subject = $3\n    78\t                  AND operation = $4\n    79\t                  AND target = $5\n    80\t                  AND args_sha256 = $6\n    81\t                RETURNING approval_id, approved_by, approved_at, expires_at\"\"\",\n    82\t            approval_id, ctx.agent_instance_id, ctx.subject, operation, target, args_digest(args),\n    83\t        )\n    84\t        if row is None:\n    85\t            raise ApprovalInvalid(\"approval does not match this action, was used, or expired\")\n    86\t        return dict(row)\n    87\t\n    88\t    async def pending(self, approval_id: str) -> dict[str, Any] | None:\n    89\t        row = await self._pool.fetchrow(\n    90\t            \"SELECT run_id, operation, target, args, tool_use_id FROM approvals.grants WHERE approval_id = $1\",\n    91\t            approval_id,\n    92\t        )\n    93\t        if row is None:\n    94\t            return None\n    95\t        out = dict(row)\n    96\t        out[\"args\"] = json.loads(out[\"args\"])\n    97\t        return out","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Wki2Zkr9vBV5X1vX9ZP9os","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
