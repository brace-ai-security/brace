 object\n    47\t      properties:\n    48\t        leave_type: {type: string, maxLength: 20}\n    49\t        balance_days: {type: number, minimum: 0, maximum: 400}\n    50\t        accrual_per_month: {type: number, minimum: 0, maximum: 5}\n    51\t        as_of: {type: string, format: date}\n    52\t      required: [leave_type, balance_days, as_of]\n    53\t      additionalProperties: false\n    54\t\n    55\t  file_leave_request:\n    56\t    kind: mcp\n    57\t    qualified: hris/file_leave_request\n    58\t    server: hris\n    59\t    reason: \"File a leave request for the asking employee; the manager approves it in HRIS.\"\n    60\t    scope: hris.leave.request\n    61\t    approval: subject\n    62\t    target: \"employee:{subject}\"\n    63\t    fingerprint: \"sha256:a0f7c3d95e21b84f6c0d19e3a7b25f48d6e0c1a93b7f2e54d81c6a09f3e7b2d4\"\n    64\t    input_schema:\n    65\t      type: object\n    66\t      properties:\n    67\t        leave_type: {enum: [annual, sick, parental, unpaid]}\n    68\t        start_date: {type: string, format: date}\n    69\t        end_date: {type: string, format: date}\n    70\t        note: {type: string, maxLength: 280}\n    71\t      required: [leave_type, start_date, end_date]\n    72\t      additionalProperties: false\n    73\t    output_schema:\n    74\t      type: object\n    75\t      properties:\n    76\t        request_id: {type: string, pattern: \"^LR-[0-9]{8}$\"}\n    77\t        status: {enum: [submitted, duplicate]}\n    78\t        approver_role: {type: string, maxLength: 40}\n    79\t      required: [request_id, status]\n    80\t      additionalProperties: false\n    81\t\n    82\t  escalate_to_human:\n    83\t    kind: mcp\n    84\t    qualified: helpdesk/create_ticket\n    85\t    server: helpdesk\n    86\t    reason: \"Hand the conversation to an HR advisor when the agent cannot help.\"\n    87\t    scope: helpdesk.ticket.create\n    88\t    approval: subject\n    89\t    target: \"queue:hr-advisors\"\n    90\t   