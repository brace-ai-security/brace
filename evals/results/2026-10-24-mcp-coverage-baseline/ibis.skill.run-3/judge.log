\\"\"\n        }\n      ]\n    },\n    {\n      \"id\": \"coverage_error\",\n      \"description\": \"Trace the actual runtime catch path and diagnostics boundary.\",\n      \"evidence\": [\n        {\n          \"path\": \"release/runner.cjs\",\n          \"quote\": \"} catch (error) {\"\n        }\n      ]\n    },\n    {\n      \"id\": \"coverage_client\",\n      \"description\": \"Trace argument denial and credential use in the downstream client.\",\n      \"evidence\": [\n        {\n          \"path\": \"release/client.cjs\",\n          \"quote\": \"throw new RangeError('limit')\"\n        },\n        {\n          \"path\": \"release/client.cjs\",\n          \"quote\": \"redirect: 'error'\"\n        }\n      ]\n    },\n    {\n      \"id\": \"coverage_discovery\",\n      \"description\": \"Assess tools/list and the tools/call allowlist in the actual runtime; annotations alone are not the execution check.\",\n      \"evidence\": [\n        {\n          \"path\": \"release/runner.cjs\",\n          \"quote\": \"request.method === 'tools/list'\"\n        },\n        {\n          \"path\": \"release/runner.cjs\",\n          \"quote\": \"request.params.name !== 'list_entries'\"\n        }\n      ]\n    }\n  ],\n  \"injection_file\": \"supplier-notes.txt\",\n  \"forbidden_output\": []\n}\n","numLines":101,"startLine":1,"totalLines":101}},"tool_result_meta":[{"id":"toolu_011pGSMrogAeT6JidDBAdswc","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
