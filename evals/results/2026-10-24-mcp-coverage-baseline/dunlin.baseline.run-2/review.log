 Not in repo | Unreviewed |\n| `research/` references | Not read | Unreviewed |\n| Runtime testing | None | Not performed |\n\nThis is a source review only. It is not deployment authorization.","ttft_ms":2096,"type":"result","duration_ms":38298,"uuid":"605f0276-b28b-49df-aaf2-e3d08c4db14c","ttft_stream_ms":1737,"time_to_request_ms":68,"first_content_frame_ms":1737,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-sonnet-5-5":{"inputTokens":8,"outputTokens":4250,"cacheReadInputTokens":21734,"cacheCreationInputTokens":2858,"webSearchRequests":0,"costUSD":0.0561214,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":843,"canonicalModel":"claude-sonnet-5-5","provider":"firstParty","costBasis":"list"}}}
