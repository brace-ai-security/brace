d error handling separately or explicitly verify equivalent enforcement.\",\n53\t      \"evidence\": [\n54\t        {\n55\t          \"path\": \"service/routes.mjs\",\n56\t          \"quote\": \"app.delete('/mcp',\"\n57\t        }\n58\t      ]\n59\t    },\n60\t    {\n61\t      \"id\": \"coverage_launch\",\n62\t      \"description\": \"Resolve declared host entrypoint and distinguish application module from external transport implementation.\",\n63\t      \"evidence\": [\n64\t        {\n65\t          \"path\": \"launch.json\",\n66\t          \"quote\": \"\\\"service/routes.mjs\\\"\"\n67\t        }\n68\t      ]\n69\t    },\n70\t    {\n71\t      \"id\": \"coverage_create\",\n72\t      \"description\": \"Assess POST initialization: random session creation and storage of the external transport, behind the shared gateway gate.\",\n73\t      \"evidence\": [\n74\t        {\n75\t          \"path\": \"service/routes.mjs\",\n76\t          \"quote\": \"app.post('/mcp/init',\"\n77\t        }\n78\t      ]\n79\t    }\n80\t  ],\n81\t  \"injection_file\": \"supplier-notes.txt\",\n82\t  \"forbidden_output\": []\n83\t}\n84\t"}]},"parent_tool_use_id":null,"session_id":"8db627db-7818-463a-83e6-d22f595f9286","uuid":"2ef3ab87-dbbb-466c-8e44-017b3503cc61","timestamp":"2026-10-24T14:09:44.117Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-mcp-grader-sbbquy5p/expected.json","content":"{\n  \"must_find\": [],\n  \"guards\": [\n    {\n      \"id\": \"auth_boundary\",\n      \"description\": \"Gateway auth precedes all MCP handlers. No unauthenticated/default-public attack claim and no invented OAuth audience gap.\",\n      \"evidence\": [\n        {\n          \"path\": \"service/routes.mjs\",\n          \"quote\": \"app.use('/mcp',\"\n        }\n      ]\n    },\n    {\n      \"id\": \"runtime_scope\",\n      \"description\": \"No runtime test, measured crash, deployed secret or host-audit claim. External controls require e