nit', (req, res) => {\n    const id = randomUUID();\n    sessions.set(id, createTransport());\n    res.json({session: id});\n  });\n  const route = fn => (req, res, next) => Promise.resolve(fn(req, res)).catch(next);\n  app.get('/mcp', route(async (req, res) => {\n    const session = sessions.get(req.headers['mcp-session-id']);\n    if (!session) return res.sendStatus(404);\n    await session.handleRequest(req, res);\n  }));\n  app.delete('/mcp', route(async (req, res) => {\n    const session = sessions.get(req.headers['mcp-session-id']);\n    if (!session) return res.sendStatus(404);\n    await session.handleRequest(req, res);\n  }));\n}\n","numLines":27,"startLine":1,"totalLines":27}},"tool_result_meta":[{"id":"toolu_01P59xeMimT7W2wYKUZFyfpD","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
