{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pv91zLJEomawutsVgGFQM9","type":"tool_result","content":"1\tconst VERSION = process.env.PACKAGE_VERSION || '0.0.0-development';\n2\tconst BASE_USER_AGENT = `stripe-mcp-local/${VERSION}`;\n3\t\n4\t/**\n5\t * Extract the client name from an MCP initialize request message.\n6\t * Returns undefined if the message is not an initialize request or has no clientInfo.\n7\t */\n8\texport function extractClientName(message: {\n9\t  method?: string;\n10\t  params?: unknown;\n11\t  [key: string]: unknown;\n12\t}): string | undefined {\n13\t  if (\n14\t    message.method === 'initialize' &&\n15\t    message.params != null &&\n16\t    typeof message.params === 'object' &&\n17\t    'clientInfo' in message.params &&\n18\t    message.params.clientInfo != null &&\n19\t    typeof message.params.clientInfo === 'object' &&\n20\t    'name' in message.params.clientInfo &&\n21\t    typeof message.params.clientInfo.name === 'string'\n22\t  ) {\n23\t    return message.params.clientInfo.name;\n24\t  }\n25\t  return undefined;\n26\t}\n27\t\n28\t/**\n29\t * Build the User-Agent string, appending the MCP client name if available.\n30\t */\n31\texport function buildUserAgent(clientName?: string): string {\n32\t  if (clientName) {\n33\t    return `${BASE_USER_AGENT} (${clientName})`;\n34\t  }\n35\t  return BASE_USER_AGENT;\n36\t}\n37\t"}]},"parent_tool_use_id":null,"session_id":"6dd27f38-ae7a-4592-b2f0-29d041a6b7c9","uuid":"2a46778f-4ed5-4e37-aad6-986c75446bc8","timestamp":"2026-10-23T09:39:51.815Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-public-mcp-aqip2z4a/repo/tools/modelcontextprotocol/src/userAgent.ts","content":"const VERSION = process.env.PACKAGE_VERSION || '0.0.0-development';\nconst BASE_USER_AGENT = `stripe-mcp-local/${VERSION}`;\n\n/**\n * Extract the client name from an MCP initialize request message.\n * Returns undefined if the message is not an initialize request or has no clientInfo.\n */\nexport function extractClientName(message: {\n  method?: string;\n  params?: unknown;\n  [key: string]: unknown;\n}): string | undefined {\n  if (\n    message.method === 'initialize' &&\n    message.params != null &&\n    typeof message.params === 'object' &&\n    'clientInfo' in message.params &&\n    message.params.clientInfo != null &&\n    typeof message.params.clientInfo === 'object' &&\n    'name' in message.params.clientInfo &&\n    typeof message.params.clientInfo.name === 'string'\n  ) {\n    return message.params.clientInfo.name;\n  }\n  return undefined;\n}\n\n/**\n * Build the User-Agent string, appending the MCP client name if available.\n */\nexport function buildUserAgent(clientName?: string): string {\n  if (clientName) {\n    return `${BASE_USER_AGENT} (${clientName})`;\n  }\n  return BASE_USER_AGENT;\n}\n","numLines":37,"startLine":1,"totalLines":37}},"tool_result_meta":[{"id":"toolu_01Pv91zLJEomawutsVgGFQM9","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
