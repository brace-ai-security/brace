s_url\":\"https://api.github.com/users/Gal3m/repos\",\"events_url\":\"https://api.github.com/users/Gal3m/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/Gal3m/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"type\":\"reporter\",\"state\":\"accepted\"},{\"user\":{\"login\":\"JosephDoUrden\",\"id\":67666222,\"node_id\":\"MDQ6VXNlcjY3NjY2MjIy\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/67666222?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/JosephDoUrden\",\"html_url\":\"https://github.com/JosephDoUrden\",\"followers_url\":\"https://api.github.com/users/JosephDoUrden/followers\",\"following_url\":\"https://api.github.com/users/JosephDoUrden/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/JosephDoUrden/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/JosephDoUrden/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/JosephDoUrden/subscriptions\",\"organizations_url\":\"https://api.github.com/users/JosephDoUrden/orgs\",\"repos_url\":\"https://api.github.com/users/JosephDoUrden/repos\",\"events_url\":\"https://api.github.com/users/JosephDoUrden/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/JosephDoUrden/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"type\":\"reporter\",\"state\":\"accepted\"},{\"user\":{\"login\":\"Igfray\",\"id\":73347775,\"node_id\":\"MDQ6VXNlcjczMzQ3Nzc1\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/73347775?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/Igfray\",\"html_url\":\"https://github.com/Igfray\",\"followers_url\":\"https://api.github.com/users/Igfray/followers\",\"following_url\":\"https://api.github.com/users/Igfray/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/Igfray/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/Igfray/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/Igfray/subscriptions\",\"organizations_url\":\"https://api.github.com/users/Igfray/orgs\",\"repos_url\":\"https://api.github.com/users/Igfray/repos\",\"events_url\":\"https://api.github.com/users/Igfray/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/Igfray/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"type\":\"reporter\",\"state\":\"accepted\"},{\"user\":{\"login\":\"OriginalKazdov\",\"id\":83375859,\"node_id\":\"MDQ6VXNlcjgzMzc1ODU5\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/83375859?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/OriginalKazdov\",\"html_url\":\"https://github.com/OriginalKazdov\",\"followers_url\":\"https://api.github.com/users/OriginalKazdov/followers\",\"following_url\":\"https://api.github.com/users/OriginalKazdov/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/OriginalKazdov/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/OriginalKazdov/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/OriginalKazdov/subscriptions\",\"organizations_url\":\"https://api.github.com/users/OriginalKazdov/orgs\",\"repos_url\":\"https://api.github.com/users/OriginalKazdov/repos\",\"events_url\":\"https://api.github.com/users/OriginalKazdov/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/OriginalKazdov/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"type\":\"reporter\",\"state\":\"accepted\"},{\"user\":{\"login\":\"lwebmedia\",\"id\":197580047,\"node_id\":\"U_kgDOC8bVDw\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/197580047?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/lwebmedia\",\"html_url\":\"https://github.com/lwebmedia\",\"followers_url\":\"https://api.github.com/users/lwebmedia/followers\",\"following_url\":\"https://api.github.com/users/lwebmedia/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/lwebmedia/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/lwebmedia/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/lwebmedia/subscriptions\",\"organizations_url\":\"https://api.github.com/users/lwebmedia/orgs\",\"repos_url\":\"https://api.github.com/users/lwebmedia/repos\",\"events_url\":\"https://api.github.com/users/lwebmedia/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/lwebmedia/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"type\":\"reporter\",\"state\":\"accepted\"}],\"collaborating_users\":null,\"collaborating_teams\":null,\"private_fork\":null,\"comments\":1,\"cvss\":{\"vector_string\":\"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N\",\"score\":7.5}},{\"ghsa_id\":\"GHSA-rvq5-wwqv-78pq\",\"cve_id\":\"CVE-2026-111771\",\"url\":\"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories/GHSA-rvq5-wwqv-78pq\",\"html_url\":\"https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-rvq5-wwqv-78pq\",\"summary\":\"Server bearer authentication accepted tokens issued for another service\",\"description\":\"### Summary\\nIn affected versions, the SDK's server-side bearer authentication had no way to check that a token was issued for your server (its audience). Where one authorization server issues tokens for several services, a valid token for another service was also accepted by your MCP server.\\n\\n### Am I affected?\\nYes, if your HTTP server uses `requireBearerAuth()` or `verifyBearerToken()`, its authorization server also issues tokens for other services, and your `verifyAccessToken()` does not check the token's audience (`aud`) itself.\\n\\nAffected versions:\\n\\n- `@modelcontextprotocol/sdk` 1.6.0 through 1.31.0\\n- `@modelcontextprotocol/server` 2.0.0 through 2.2.0\\n- `@modelcontextprotocol/express` 2.0.0 through 2.0.1\\n- `@modelcontextprotocol/server-legacy` 2.0.0 through 2.3.0\\n\\n### Fix\\nUpgrade to:\\n\\n- 1.x: `@modelcontextprotocol/sdk` 1.32.0 or later\\n- 2.x: `@modelcontextprotocol/server` 2.3.0 or later, together with `@modelcontextprotocol/express` 2.0.2 or later if you use it\\n- `@modelcontextprotocol/server-legacy` 2.3.1 or later\\n\\n**Upgrading alone changes nothing.** The patched versions add an `expectedResource` setting that is off by default. To turn the check on, make both of these changes together:\\n\\n1. Pass the audience your authorization server puts in tokens for your server: `requireBearerAuth({ verifier, expectedResource: new URL('https://mcp.example.com/mcp') })`.\\n2. Return the token's audience from `verifyAccessToken()` as `AuthInfo.resource`, also a `URL`.\\n\\nA token for another service then gets `401`. With only the first change, every request gets `401`.\\n\\nIf you cannot upgrade yet, reject any token whose `aud` does not include your server inside `verifyAccessToken()`. That closes the issue on every version.\",\"severity\":\"medium\",\"author\":null,\"publisher\":{\"login\":\"maxisbey\",\"id\":224885523,\"node_id\":\"U_kgDODWd7Ew\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/224885523?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/maxisbey\",\"html_url\":\"https://github.com/maxisbey\",\"followers_url\":\"https://api.github.com/users/maxisbey/followers\",\"following_url\":\"https://api.github.com/users/maxisbey/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/maxisbey/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/maxisbey/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/maxisbey/subscriptions\",\"organizations_url\":\"https://api.github.com/users/maxisbey/orgs\",\"repos_url\":\"https://api.github.com/users/maxisbey/repos\",\"events_url\":\"https://api.github.com/users/maxisbey/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/maxisbey/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"identifiers\":[{\"value\":\"GHSA-rvq5-wwqv-78pq\",\"type\":\"GHSA\"},{\"value\":\"CVE-2026-111771\",\"type\":\"CVE\"}],\"state\":\"published\",\"created_at\":null,\"updated_at\":\"2026-10-19T20:12:07Z\",\"published_at\":\"2026-10-05T16:01:06Z\",\"closed_at\":null,\"withdrawn_at\":null,\"submission\":null,\"vulnerabilities\":[{\"package\":{\"ecosystem\":\"npm\",\"name\":\"@modelcontextprotocol/sdk\"},\"vulnerable_version_range\":\">= 1.6.0, < 1.32.0\",\"patched_versions\":\"1.32.0\",\"vulnerable_functions\":[]},{\"package\":{\"ecosystem\":\"npm\",\"name\":\"@modelcontextprotocol/server\"},\"vulnerable_version_range\":\">= 2.0.0, < 2.3.0\",\"patched_versions\":\"2.3.0\",\"vulnerable_functions\":[]},{\"package\":{\"ecosystem\":\"npm\",\"name\":\"@modelcontextprotocol/express\"},\"vulnerable_version_range\":\">= 2.0.0, < 2.0.2\",\"patched_versions\":\"2.0.2\",\"vulnerable_functions\":[]},{\"package\":{\"ecosystem\":\"npm\",\"name\":\"@modelcontextprotocol/server-legacy\"},\"vulnerable_version_range\":\">= 2.0.0, < 2.3.1\",\"patched_versions\":\"2.3.1\",\"vulnerable_functions\":[]}],\"cvss_severities\":{\"cvss_v3\":{\"vector_string\":\"CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:U/C:H/I:H/A:N\",\"score\":6.8},\"cvss_v4\":{\"vector_string\":null,\"score\":null}},\"cwes\":[{\"cwe_id\":\"CWE-863\",\"name\":\"Incorrect Authorization\"}],\"cwe_ids\":[\"CWE-863\"],\"credits\":[{\"login\":\"gdegrange\",\"type\":\"reporter\"}],\"credits_detailed\":[{\"user\":{\"login\":\"gdegrange\",\"id\":56841795,\"node_id\":\"MDQ6VXNlcjU2ODQxNzk1\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/56841795?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/gdegrange\",\"html_url\":\"https://github.com/gdegrange\",\"followers_url\":\"https://api.github.com/users/gdegrange/followers\",\"following_url\":\"https://api.github.com/users/gdegrange/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/gdegrange/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/gdegrange/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/gdegrange/subscriptions\",\"organizations_url\":\"https://api.github.com/users/gdegrange/orgs\",\"repos_url\":\"https://api.github.com/users/gdegrange/repos\",\"events_url\":\"https://api.github.com/users/gdegrange/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/gdegrange/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"type\":\"reporter\",\"state\":\"accepted\"}],\"collaborating_users\":null,\"collaborating_teams\":null,\"private_fork\":null,\"comments\":2,\"cvss\":{\"vector_string\":\"CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:U/C:H/I:H/A:N\",\"score\":6.8}},{\"ghsa_id\":\"GHSA-22jm-h49p-29qw\",\"cve_id\":\"CVE-2026-111767\",\"url\":\"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories/GHSA-22jm-h49p-29qw\",\"html_url\":\"https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-22jm-h49p-29qw\",\"summary\":\"Experimental tasks were not tied to the session that created them\",\"description\":\"### Summary\\r\\nIn affected versions, the experimental tasks feature (`taskStore`) did not check which session created a task. Clients sharing one `InMemoryTaskStore` could list, read and cancel each other's tasks.\\r\\n\\r\\nExperimental tasks are deprecated. The 2026-07-28 specification replaced them with a redesigned extension. The best course of action is to stop using them.\\r\\n\\r\\n### Am I affected?\\r\\nOnly if your HTTP server passes `taskStore` to `McpServer` or `Server`. If `grep -ri taskstore --exclude-dir=node_modules .` finds nothing, you are not affected.\\r\\n\\r\\nAffected versions: `@modelcontextprotocol/sdk` 1.24.0 through 1.31.0. The 2.x packages are not affected.\\r\\n\\r\\n### Fix\\r\\nUpgrade to `@modelcontextprotocol/sdk` 1.32.0 or later. Each task is now tied to the session that created it, so a client that starts a new session can no longer reach its earlier tasks.\\r\\n\\r\\nIf you cannot upgrade yet, remove `taskStore`, or create one `InMemoryTaskStore` per session.\\r\\n\",\"severity\":\"high\",\"author\":null,\"publisher\":{\"login\":\"maxisbey\",\"id\":224885523,\"node_id\":\"U_kgDODWd7Ew\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/224885523?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/maxisbey\",\"html_url\":\"https://github.com/maxisbey\",\"followers_url\":\"https://api.github.com/users/maxisbey/followers\",\"following_url\":\"https://api.github.com/users/maxisbey/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/maxisbey/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/maxisbey/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/maxisbey/subscriptions\",\"organizations_url\":\"https://api.github.com/users/maxisbey/orgs\",\"repos_url\":\"https://api.github.com/users/maxisbey/repos\",\"events_url\":\"https://api.github.com/users/maxisbey/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/maxisbey/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"identifiers\":[{\"value\":\"GHSA-22jm-h49p-29qw\",\"type\":\"GHSA\"},{\"value\":\"CVE-2026-111767\",\"type\":\"CVE\"}],\"state\":\"published\",\"created_at\":null,\"updated_at\":\"2026-10-19T19:50:48Z\",\"published_at\":\"2026-10-02T20:54:41Z\",\"closed_at\":null,\"withdrawn_at\":null,\"submission\":null,\"vulnerabilities\":[{\"package\":{\"ecosystem\":\"npm\",\"name\":\"@modelcontextprotocol/sdk\"},\"vulnerable_version_range\":\">= 1.24.0, < 1.32.0\",\"patched_versions\":\"1.32.0\",\"vulnerable_functions\":[]}],\"cvss_severities\":{\"cvss_v3\":{\"vector_string\":\"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:L/A:L\",\"score\":8.6},\"cvss_v4\":{\"vector_string\":null,\"score\":null}},\"cwes\":[{\"cwe_id\":\"CWE-639\",\"name\":\"Authorization Bypass Through User-Controlled Key\"},{\"cwe_id\":\"CWE-862\",\"name\":\"Missing Authorization\"}],\"cwe_ids\":[\"CWE-639\",\"CWE-862\"],\"credits\":[{\"login\":\"cipher-creator\",\"type\":\"reporter\"}],\"credits_detailed\":[{\"user\":{\"login\":\"cipher-creator\",\"id\":249282395,\"node_id\":\"U_kgDODtu_Ww\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/249282395?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/cipher-creator\",\"html_url\":\"https://github.com/cipher-creator\",\"followers_url\":\"https://api.github.com/users/cipher-creator/followers\",\"following_url\":\"https://api.github.com/users/cipher-creator/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/cipher-creator/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/cipher-creator/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/cipher-creator/subscriptions\",\"organizations_url\":\"https://api.github.com/users/cipher-creator/orgs\",\"repos_url\":\"https://api.github.com/users/cipher-creator/repos\",\"events_url\":\"https://api.github.com/users/cipher-creator/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/cipher-creator/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"type\":\"reporter\",\"state\":\"accepted\"}],\"collaborating_users\":null,\"collaborating_teams\":null,\"private_fork\":null,\"comments\":5,\"cvss\":{\"vector_string\":\"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:L/A:L\",\"score\":8.6}},{\"ghsa_id\":\"GHSA-jm63-cq47-j5jp\",\"cve_id\":\"CVE-2026-111770\",\"url\":\"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories/GHSA-jm63-cq47-j5jp\",\"html_url\":\"https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-jm63-cq47-j5jp\",\"summary\":\"Shared transport or server instances delivered one HTTP client's messages to another\",\"description\":\"### Summary\\r\\nIn affected versions, an MCP server reached over HTTP could deliver one client's responses and notifications to another client. This happened when clients shared one stateless transport, or one `McpServer` or `Server` instance.\\r\\n\\r\\nMessages were matched to a connection by JSON-RPC `id` alone. SDK clients number requests from 0, so ids collide in normal use.\\r\\n\\r\\n### Am I affected?\\r\\nYes, if more than one client can reach your HTTP endpoint and your code creates the transport or the server once at startup, instead of once per request or per session. Until this release, the README examples of `@modelcontextprotocol/hono`, `express`, `fastify` and `node` showed that pattern.\\r\\n\\r\\nAffected versions: `@modelcontextprotocol/server` 2.0.0 through 2.2.0.\\r\\n\\r\\nNot affected:\\r\\n\\r\\n- `createMcpHandler()` with a factory that builds a new server on every call\\r\\n- stdio servers\\r\\n- `@modelcontextprotocol/sdk` 1.26.0 and later\\r\\n\\r\\n### Fix\\r\\nUpgrade to `@modelcontextprotocol/server` 2.3.0 or later.\\r\\n\\r\\n**You also need to change your code.** The SDK now refuses to be shared, so an affected app fails requests after upgrading: a second `connect()` rejects with `ALREADY_CONNECTED`, and a stateless transport rejects its second request.\\r\\n\\r\\nChange to one of these:\\r\\n\\r\\n- **`createMcpHandler()`:** pass a factory that builds a new `McpServer` on every call.\\r\\n- **Per request:** build a new `McpServer` and a new transport inside the request handler.\\r\\n- **Per session:** set `sessionIdGenerator` and keep one `McpServer` and one transport per session.\\r\\n\\r\\nIf you cannot upgrade yet, the same change fixes affected versions.\\r\\n\",\"severity\":\"high\",\"author\":null,\"publisher\":{\"login\":\"maxisbey\",\"id\":224885523,\"node_id\":\"U_kgDODWd7Ew\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/224885523?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/maxisbey\",\"html_url\":\"https://github.com/maxisbey\",\"followers_url\":\"https://api.github.com/users/maxisbey/followers\",\"following_url\":\"https://api.github.com/users/maxisbey/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/maxisbey/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/maxisbey/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/maxisbey/subscriptions\",\"organizations_url\":\"https://api.github.com/users/maxisbey/orgs\",\"repos_url\":\"https://api.github.com/users/maxisbey/repos\",\"events_url\":\"https://api.github.com/users/maxisbey/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/maxisbey/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"identifiers\":[{\"value\":\"GHSA-jm63-cq47-j5jp\",\"type\":\"GHSA\"},{\"value\":\"CVE-2026-111770\",\"type\":\"CVE\"}],\"state\":\"published\",\"created_at\":null,\"updated_at\":\"2026-10-19T20:09:41Z\",\"published_at\":\"2026-10-15T13:10:24Z\",\"closed_at\":null,\"withdrawn_at\":null,\"submission\":null,\"vulnerabilities\":[{\"package\":{\"ecosystem\":\"npm\",\"name\":\"@modelcontextprotocol/server\"},\"vulnerable_version_range\":\">= 2.0.0, < 2.3.0\",\"patched_versions\":\"2.3.0\",\"vulnerable_functions\":[]}],\"cvss_severities\":{\"cvss_v3\":{\"vector_string\":\"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:L/A:H\",\"score\":7.7},\"cvss_v4\":{\"vector_string\":null,\"score\":null}},\"cwes\":[{\"cwe_id\":\"CWE-362\",\"name\":\"Concurrent Execution using Shared Resource with Improper Synchronization ('Race Condition')\"}],\"cwe_ids\":[\"CWE-362\"],\"credits\":[{\"login\":\"DavidCarliez\",\"type\":\"reporter\"},{\"login\":\"legitu1337\",\"type\":\"reporter\"}],\"credits_detailed\":[{\"user\":{\"login\":\"DavidCarliez\",\"id\":271374756,\"node_id\":\"U_kgDOECzZpA\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/271374756?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/DavidCarliez\",\"html_url\":\"https://github.com/DavidCarliez\",\"followers_url\":\"https://api.github.com/users/DavidCarliez/followers\",\"following_url\":\"https://api.github.com/users/DavidCarliez/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/DavidCarliez/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/DavidCarliez/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DavidCarliez/subscriptions\",\"organizations_url\":\"https://api.github.com/users/DavidCarliez/orgs\",\"repos_url\":\"https://api.github.com/users/DavidCarliez/repos\",\"events_url\":\"https://api.github.com/users/DavidCarliez/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/DavidCarliez/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"type\":\"reporter\",\"state\":\"accepted\"},{\"user\":{\"login\":\"legitu1337\",\"id\":239555824,\"node_id\":\"U_kgDODkdU8A\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/239555824?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/legitu1337\",\"html_url\":\"https://github.com/legitu1337\",\"followers_url\":\"https://api.github.com/users/legitu1337/followers\",\"following_url\":\"https://api.github.com/users/legitu1337/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/legitu1337/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/legitu1337/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/legitu1337/subscriptions\",\"organizations_url\":\"https://api.github.com/users/legitu1337/orgs\",\"repos_url\":\"https://api.github.com/users/legitu1337/repos\",\"events_url\":\"https://api.github.com/users/legitu1337/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/legitu1337/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"type\":\"reporter\",\"state\":\"accepted\"}],\"collaborating_users\":null,\"collaborating_teams\":null,\"private_fork\":null,\"comments\":1,\"cvss\":{\"vector_string\":\"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:L/A:H\",\"score\":7.7}},{\"ghsa_id\":\"GHSA-6prh-2h8m-c8cw\",\"cve_id\":\"CVE-2026-111769\",\"url\":\"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories/GHSA-6prh-2h8m-c8cw\",\"html_url\":\"https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-6prh-2h8m-c8cw\",\"summary\":\"HTTP client transports and OAuth requests followed cross-origin redirects and re-sent custom headers and request bodies\",\"description\":\"### Summary\\nIn affected versions, the SDK's HTTP client transports and OAuth requests followed redirects to any origin.\\n\\nIf an MCP server or authorization server redirected a request to another origin, that origin received custom request headers (such as an `X-API-Key` set in `requestInit.headers`) and the `mcp-session-id` header. On a `307` or `308` it also received the request body, including OAuth token requests with their `refresh_token` and `client_secret`.\\n\\nOn current runtimes `fetch` already drops the `Authorization` header across origins.\\n\\n### Am I affected?\\nYes, if your application uses `StreamableHTTPClientTransport`, `SSEClientTransport`, or the SDK's OAuth client functions such as `auth()`. stdio clients are not affected.\\n\\nAffected versions:\\n\\n- `@modelcontextprotocol/sdk` all versions through 1.31.0\\n- `@modelcontextprotocol/client` 2.0.0 through 2.2.0\\n\\n### Fix\\nUpgrade to:\\n\\n- 1.x: `@modelcontextprotocol/sdk` 1.32.0 or later\\n- 2.x: `@modelcontextprotocol/client` 2.3.0 or later\\n\\nRedirects are now followed only within the same origin, and not at all in browsers. If your MCP server or authorization server redirects to another origin on purpose, configure the final URL instead. Setting `redirectPolicy: 'follow'` on a transport restores the old behaviour and the exposure.\\n\\nIf a redirect may have reached a host you do not control, rotate the API keys and `client_secret` your application held and revoke its tokens.\\n\\nIf you cannot upgrade yet, pass a `fetch` that refuses redirects, for example `(url, init) => fetch(url, { ...init, redirect: 'error' })`.\\n\",\"severity\":\"medium\",\"author\":null,\"publisher\":{\"login\":\"maxisbey\",\"id\":224885523,\"node_id\":\"U_kgDODWd7Ew\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/224885523?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/maxisbey\",\"html_url\":\"https://github.com/maxisbey\",\"followers_url\":\"https://api.github.com/users/maxisbey/followers\",\"following_url\":\"https://api.github.com/users/maxisbey/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/maxisbey/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/maxisbey/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/maxisbey/subscriptions\",\"organizations_url\":\"https://api.github.com/users/maxisbey/orgs\",\"repos_url\":\"https://api.github.com/users/maxisbey/repos\",\"events_url\":\"https://api.github.com/users/maxisbey/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/maxisbey/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"identifiers\":[{\"value\":\"GHSA-6prh-2h8m-c8cw\",\"type\":\"GHSA\"},{\"value\":\"CVE-2026-111769\",\"type\":\"CVE\"}],\"state\":\"published\",\"created_at\":null,\"updated_at\":\"2026-10-19T20:07:25Z\",\"published_at\":\"2026-10-02T20:42:34Z\",\"closed_at\":null,\"withdrawn_at\":null,\"submission\":null,\"vulnerabilities\":[{\"package\":{\"ecosystem\":\"npm\",\"name\":\"@modelcontextprotocol/sdk\"},\"vulnerable_version_range\":\"< 1.32.0\",\"patched_versions\":\"1.32.0\",\"vulnerable_functions\":[]},{\"package\":{\"ecosystem\":\"npm\",\"name\":\"@modelcontextprotocol/client\"},\"vulnerable_version_range\":\">= 2.0.0, < 2.3.0\",\"patched_versions\":\"2.3.0\",\"vulnerable_functions\":[]}],\"cvss_severities\":{\"cvss_v3\":{\"vector_string\":\"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:L/A:N\",\"score\":6.5},\"cvss_v4\":{\"vector_string\":null,\"score\":null}},\"cwes\":[{\"cwe_id\":\"CWE-200\",\"name\":\"Exposure of Sensitive Information to an Unauthorized Actor\"}],\"cwe_ids\":[\"CWE-200\"],\"credits\":[{\"login\":\"nickelsec\",\"type\":\"reporter\"}],\"credits_detailed\":[{\"user\":{\"login\":\"nickelsec\",\"id\":300981992,\"node_id\":\"U_kgDOEfCe6A\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/300981992?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/nickelsec\",\"html_url\":\"https://github.com/nickelsec\",\"followers_url\":\"https://api.github.com/users/nickelsec/followers\",\"following_url\":\"https://api.github.com/users/nickelsec/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/nickelsec/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/nickelsec/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/nickelsec/subscriptions\",\"organizations_url\":\"https://api.github.com/users/nickelsec/orgs\",\"repos_url\":\"https://api.github.com/users/nickelsec/repos\",\"events_url\":\"https://api.github.com/users/nickelsec/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/nickelsec/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"type\":\"reporter\",\"state\":\"accepted\"}],\"collaborating_users\":null,\"collaborating_teams\":null,\"private_fork\":null,\"comments\":1,\"cvss\":{\"vector_string\":\"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:L/A:N\",\"score\":6.5}},{\"ghsa_id\":\"GHSA-46jr-4wx8-v453\",\"cve_id\":\"CVE-2026-111768\",\"url\":\"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories/GHSA-46jr-4wx8-v453\",\"html_url\":\"https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-46jr-4wx8-v453\",\"summary\":\"One HTTP request within the default size limit could exhaust server memory during validation\",\"description\":\"### Summary\\r\\nIn affected versions, servers put no limit on how many array elements and object keys they validated in one request. One HTTP request within the default 4 MiB size limit could exhaust the server's memory, and the process aborted with `JavaScript heap out of memory`.\\r\\n\\r\\nNo credentials are needed, unless you authenticate requests before they reach the SDK.\\r\\n\\r\\n### Am I affected?\\r\\nYes, if clients you do not fully trust can reach your server over HTTP. The risk is highest for `McpServer` tools whose input contains an array or a record. stdio-only servers are not affected.\\r\\n\\r\\nAffected versions:\\r\\n\\r\\n- `@modelcontextprotocol/sdk` 1.3.0 through 1.31.0\\r\\n- `@modelcontextprotocol/server` 2.0.0 through 2.2.0\\r\\n\\r\\n### Fix\\r\\nUpgrade to:\\r\\n\\r\\n- 1.x: `@modelcontextprotocol/sdk` 1.32.0 or later\\r\\n- 2.x: `@modelcontextprotocol/server` 2.3.0 or later\\r\\n\\r\\n**Upgrading alone changes nothing.** The patched versions add an `McpServer` option, `maxToolInputElements`, that is off by default. Make both of these changes:\\r\\n\\r\\n1. Set `maxToolInputElements` just above the largest input your tools need, for example `new McpServer(info, { maxToolInputElements: 10_000 })`. It counts array elements and object keys in a call's arguments. A call over the limit gets an `isError: true` result.\\r\\n2. Lower the request size limit to what your tools need. The option covers tool arguments only, and the size limit covers everything else. Set `maxRequestBodySize` on the transport or `createMcpHandler()`. If you parse the body yourself, for example with `express.json()` or Fastify, set that parser's limit.\\r\\n\\r\\nIf you cannot upgrade yet, make the second change. `maxRequestBodySize` needs `@modelcontextprotocol/sdk` 1.30.1 or `@modelcontextprotocol/server` 2.1.0. Below that, use a reverse proxy.\\r\\n\",\"severity\":\"high\",\"author\":null,\"publisher\":{\"login\":\"maxisbey\",\"id\":224885523,\"node_id\":\"U_kgDODWd7Ew\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/224885523?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/maxisbey\",\"html_url\":\"https://github.com/maxisbey\",\"followers_url\":\"https://api.github.com/users/maxisbey/followers\",\"following_url\":\"https://api.github.com/users/maxisbey/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/maxisbey/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/maxisbey/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/maxisbey/subscriptions\",\"organizations_url\":\"https://api.github.com/users/maxisbey/orgs\",\"repos_url\":\"https://api.github.com/users/maxisbey/repos\",\"events_url\":\"https://api.github.com/users/maxisbey/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/maxisbey/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"identifiers\":[{\"value\":\"GHSA-46jr-4wx8-v453\",\"type\":\"GHSA\"},{\"value\":\"CVE-2026-111768\",\"type\":\"CVE\"}],\"state\":\"published\",\"created_at\":null,\"updated_at\":\"2026-10-19T20:06:02Z\",\"published_at\":\"2026-10-15T13:10:32Z\",\"closed_at\":null,\"withdrawn_at\":null,\"submission\":null,\"vulnerabilities\":[{\"package\":{\"ecosystem\":\"npm\",\"name\":\"@modelcontextprotocol/sdk\"},\"vulnerable_version_range\":\">= 1.3.0, < 1.32.0\",\"patched_versions\":\"1.32.0\",\"vulnerable_functions\":[]},{\"package\":{\"ecosystem\":\"npm\",\"name\":\"@modelcontextprotocol/server\"},\"vulnerable_version_range\":\">= 2.0.0, < 2.3.0\",\"patched_versions\":\"2.3.0\",\"vulnerable_functions\":[]}],\"cvss_severities\":{\"cvss_v3\":{\"vector_string\":\"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H\",\"score\":7.5},\"cvss_v4\":{\"vector_string\":null,\"score\":null}},\"cwes\":[{\"cwe_id\":\"CWE-770\",\"name\":\"Allocation of Resources Without Limits or Throttling\"}],\"cwe_ids\":[\"CWE-770\"],\"credits\":[{\"login\":\"root-Brainoverflow\",\"type\":\"reporter\"}],\"credits_detailed\":[{\"user\":{\"login\":\"root-Brainoverflow\",\"id\":150696170,\"node_id\":\"U_kgDOCPtw6g\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/150696170?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/root-Brainoverflow\",\"html_url\":\"https://github.com/root-Brainoverflow\",\"followers_url\":\"https://api.github.com/users/root-Brainoverflow/followers\",\"following_url\":\"https://api.github.com/users/root-Brainoverflow/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/root-Brainoverflow/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/root-Brainoverflow/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/root-Brainoverflow/subscriptions\",\"organizations_url\":\"https://api.github.com/users/root-Brainoverflow/orgs\",\"repos_url\":\"https://api.github.com/users/root-Brainoverflow/repos\",\"events_url\":\"https://api.github.com/users/root-Brainoverflow/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/root-Brainoverflow/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"type\":\"reporter\",\"state\":\"accepted\"}],\"collaborating_users\":null,\"collaborating_teams\":null,\"private_fork\":null,\"comments\":4,\"cvss\":{\"vector_string\":\"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H\",\"score\":7.5}},{\"ghsa_id\":\"GHSA-f897-62hf-6gxq\",\"cve_id\":null,\"url\":\"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories/GHSA-f897-62hf-6gxq\",\"html_url\":\"https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-f897-62hf-6gxq\",\"summary\":\"HTTP server transports and handlers did not limit request body size or JSON-RPC batch length\",\"description\":\"### Summary\\nIn affected versions, MCP servers reachable over HTTP put no limit on the size of a POST body or on the number of messages in a JSON-RPC batch. Large requests could exhaust the server's memory, and one long batch could block it from serving anyone else. No credentials were needed, unless your application authenticates requests before they reach the SDK.\\n\\n### Am I affected?\\nYes, if clients you do not fully trust can reach your server over Streamable HTTP. A body parser such as `express.json()` does not protect you, because it does not limit batch length. Servers that only use stdio are not affected.\\n\\nAffected versions:\\n\\n- `@modelcontextprotocol/sdk` 1.10.0 through 1.30.0\\n- `@modelcontextprotocol/server` 2.0.0\\n- `@modelcontextprotocol/node` 2.0.0\\n- `@modelcontextprotocol/hono` 2.0.0\\n\\n### Fix\\nUpgrade to:\\n\\n- 1.x: `@modelcontextprotocol/sdk` 1.30.1 or later\\n- 2.x: `@modelcontextprotocol/server` 2.1.0, `@modelcontextprotocol/node` 2.1.0 and `@modelcontextprotocol/hono` 2.0.1 or later. Upgrade every one you have installed.\\n\\nBodies over 4 MiB now get `413`, and batches over 100 messages get `400`. If your clients send larger bodies, raise the new `maxRequestBodySize` option.\\n\\nIf you cannot upgrade yet, cap request body size in a reverse proxy.\",\"severity\":\"high\",\"author\":null,\"publisher\":{\"login\":\"maxisbey\",\"id\":224885523,\"node_id\":\"U_kgDODWd7Ew\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/224885523?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/maxisbey\",\"html_url\":\"https://github.com/maxisbey\",\"followers_url\":\"https://api.github.com/users/maxisbey/followers\",\"following_url\":\"https://api.github.com/users/maxisbey/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/maxisbey/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/maxisbey/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/maxisbey/subscriptions\",\"organizations_url\":\"https://api.github.com/users/maxisbey/orgs\",\"repos_url\":\"https://api.github.com/users/maxisbey/repos\",\"events_url\":\"https://api.github.com/users/maxisbey/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/maxisbey/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"identifiers\":[{\"value\":\"GHSA-f897-62hf-6gxq\",\"type\":\"GHSA\"}],\"state\":\"published\",\"created_at\":null,\"updated_at\":\"2026-10-15T13:10:21Z\",\"published_at\":\"2026-10-15T13:10:21Z\",\"closed_at\":null,\"withdrawn_at\":null,\"submission\":null,\"vulnerabilities\":[{\"package\":{\"ecosystem\":\"npm\",\"name\":\"@modelcontextprotocol/sdk\"},\"vulnerable_version_range\":\">= 1.10.0, < 1.30.1\",\"patched_versions\":\"1.30.1\",\"vulnerable_functions\":[]},{\"package\":{\"ecosystem\":\"npm\",\"name\":\"@modelcontextprotocol/server\"},\"vulnerable_version_range\":\">= 2.0.0, < 2.1.0\",\"patched_versions\":\"2.1.0\",\"vulnerable_functions\":[]},{\"package\":{\"ecosystem\":\"npm\",\"name\":\"@modelcontextprotocol/node\"},\"vulnerable_version_range\":\">= 2.0.0, < 2.1.0\",\"patched_versions\":\"2.1.0\",\"vulnerable_functions\":[]},{\"package\":{\"ecosystem\":\"npm\",\"name\":\"@modelcontextprotocol/hono\"},\"vulnerable_version_range\":\">= 2.0.0, < 2.0.1\",\"patched_versions\":\"2.0.1\",\"vulnerable_functions\":[]}],\"cvss_severities\":{\"cvss_v3\":{\"vector_string\":\"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H\",\"score\":7.5},\"cvss_v4\":{\"vector_string\":null,\"score\":null}},\"cwes\":[{\"cwe_id\":\"CWE-770\",\"name\":\"Allocation of Resources Without Limits or Throttling\"}],\"cwe_ids\":[\"CWE-770\"],\"credits\":[{\"login\":\"cybercraftsolutionsllc\",\"type\":\"reporter\"},{\"login\":\"hewei-gikaku\",\"type\":\"reporter\"},{\"login\":\"Jvr2022\",\"type\":\"reporter\"},{\"login\":\"Gal3m\",\"type\":\"reporter\"},{\"login\":\"mohammad228\",\"type\":\"reporter\"},{\"login\":\"shmulc8\",\"type\":\"reporter\"},{\"login\":\"JustasMonkev\",\"type\":\"reporter\"},{\"login\":\"subchat\",\"type\":\"reporter\"}],\"credits_detailed\":[{