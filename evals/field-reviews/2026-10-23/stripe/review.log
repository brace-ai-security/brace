{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AxUaC6XoJxE5Wr8aZi2jXD","type":"tool_result","content":"1\timport {yellow} from 'colors';\n2\t\n3\texport type Options = {\n4\t  apiKey: string;\n5\t  stripeAccount?: string;\n6\t};\n7\t\n8\texport const ACCEPTED_ARGS = ['api-key', 'stripe-account'];\n9\t\n10\texport function parseArgs(args: string[]): Options {\n11\t  const options: Partial<Options> = {};\n12\t\n13\t  args.forEach((arg) => {\n14\t    if (arg.startsWith('--')) {\n15\t      const [key, value] = arg.slice(2).split('=');\n16\t\n17\t      if (key === 'tools') {\n18\t        console.warn(\n19\t          yellow(\n20\t            'The --tools flag has been removed. ' +\n21\t              'Tool permissions are now controlled by your Restricted API Key (RAK). ' +\n22\t              'Create a RAK with the desired permissions at https://dashboard.stripe.com/apikeys'\n23\t          )\n24\t        );\n25\t      } else if (key === 'api-key') {\n26\t        options.apiKey = value;\n27\t      } else if (key === 'stripe-account') {\n28\t        options.stripeAccount = value;\n29\t      } else {\n30\t        throw new Error(\n31\t          `Invalid argument: ${key}. Accepted arguments are: ${ACCEPTED_ARGS.join(', ')}`\n32\t        );\n33\t      }\n34\t    }\n35\t  });\n36\t\n37\t  // Check if API key is either provided in args or set in environment variables\n38\t  const apiKey = options.apiKey || process.env.STRIPE_SECRET_KEY;\n39\t  if (!apiKey) {\n40\t    throw new Error(\n41\t      'Stripe API key not provided. Please either pass it as an argument --api-key=$KEY or set the STRIPE_SECRET_KEY environment variable.'\n42\t    );\n43\t  }\n44\t  options.apiKey = apiKey;\n45\t\n46\t  return options as Options;\n47\t}\n48\t\n49\texport function validateApiKey(apiKey: string): void {\n50\t  if (!apiKey.startsWith('sk_') && !apiKey.startsWith('rk_')) {\n51\t    throw new Error(\n52\t      'Invalid API key format. Expected sk_* (secret key) or rk_* (restricted key).'\n53\t    );\n54\t  }\n55\t\n56\t  if (apiKey.startsWith('sk_')) {\n57\t    console.warn(\n58\t      yellow(\n59\t        '[WARNING] We strongly recommend using rk_* (restricted keys) instead of sk_* keys for better security and granular permissions.\\n' +\n60\t          'See: https://docs.stripe.com/keys#create-restricted-api-keys\\n'\n61\t      )\n62\t    );\n63\t  }\n64\t}\n65\t\n66\texport function validateStripeAccount(account: string): void {\n67\t  if (!account.startsWith('acct_')) {\n68\t    throw new Error('Stripe account must start with \"acct_\".');\n69\t  }\n70\t}\n71\t\n72\texport function buildHeaders(\n73\t  options: Options,\n74\t  userAgent: string\n75\t): Record<string, string> {\n76\t  const headers: Record<string, string> = {\n77\t    Authorization: `Bearer ${options.apiKey}`,\n78\t    'User-Agent': userAgent,\n79\t  };\n80\t\n81\t  if (options.stripeAccount) {\n82\t    headers['Stripe-Account'] = options.stripeAccount;\n83\t  }\n84\t\n85\t  return headers;\n86\t}\n87\t"}]},"parent_tool_use_id":null,"session_id":"6dd27f38-ae7a-4592-b2f0-29d041a6b7c9","uuid":"10b2d103-7bdb-4ef7-b9b7-3076a07f123b","timestamp":"2026-10-23T09:39:38.872Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-public-mcp-aqip2z4a/repo/tools/modelcontextprotocol/src/cli.ts","content":"import {yellow} from 'colors';\n\nexport type Options = {\n  apiKey: string;\n  stripeAccount?: string;\n};\n\nexport const ACCEPTED_ARGS = ['api-key', 'stripe-account'];\n\nexport function parseArgs(args: string[]): Options {\n  const options: Partial<Options> = {};\n\n  args.forEach((arg) => {\n    if (arg.startsWith('--')) {\n      const [key, value] = arg.slice(2).split('=');\n\n      if (key === 'tools') {\n        console.warn(\n          yellow(\n            'The --tools flag has been removed. ' +\n              'Tool permissions are now controlled by your Restricted API Key (RAK). ' +\n              'Create a RAK with the desired permissions at https://dashboard.stripe.com/apikeys'\n          )\n        );\n      } else if (key === 'api-key') {\n        options.apiKey = value;\n      } else if (key === 'stripe-account') {\n        options.stripeAccount = value;\n      } else {\n        throw new Error(\n          `Invalid argument: ${key}. Accepted arguments are: ${ACCEPTED_ARGS.join(', ')}`\n        );\n      }\n    }\n  });\n\n  // Check if API key is either provided in args or set in environment variables\n  const apiKey = options.apiKey || process.env.STRIPE_SECRET_KEY;\n  if (!apiKey) {\n    throw new Error(\n      'Stripe API key not provided. Please either pass it as an argument --api-key=$KEY or set the STRIPE_SECRET_KEY environment variable.'\n    );\n  }\n  options.apiKey = apiKey;\n\n  return options as Options;\n}\n\nexport function validateApiKey(apiKey: string): void {\n  if (!apiKey.startsWith('sk_') && !apiKey.startsWith('rk_')) {\n    throw new Error(\n      'Invalid API key format. Expected sk_* (secret key) or rk_* (restricted key).'\n    );\n  }\n\n  if (apiKey.startsWith('sk_')) {\n    console.warn(\n      yellow(\n        '[WARNING] We strongly recommend using rk_* (restricted keys) instead of sk_* keys for better security and granular permissions.\\n' +\n          'See: https://docs.stripe.com/keys#create-restricted-api-keys\\n'\n      )\n    );\n  }\n}\n\nexport function validateStripeAccount(account: string): void {\n  if (!account.startsWith('acct_')) {\n    throw new Error('Stripe account must start with \"acct_\".');\n  }\n}\n\nexport function buildHeaders(\n  options: Options,\n  userAgent: string\n): Record<string, string> {\n  const headers: Record<string, string> = {\n    Authorization: `Bearer ${options.apiKey}`,\n    'User-Agent': userAgent,\n  };\n\n  if (options.stripeAccount) {\n    headers['Stripe-Account'] = options.stripeAccount;\n  }\n\n  return headers;\n}\n","numLines":87,"startLine":1,"totalLines":87}},"tool_result_meta":