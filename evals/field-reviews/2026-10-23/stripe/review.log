ons\",\"organizations_url\":\"https://api.github.com/users/Gal3m/orgs\",\"repos_url\":\"https://api.github.com/users/Gal3m/repos\",\"events_url\":\"https://api.github.com/users/Gal3m/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/Gal3m/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"type\":\"reporter\",\"state\":\"accepted\"},{\"user\":{\"login\":\"mohammad228\",\"id\":33689408,\"node_id\":\"MDQ6VXNlcjMzNjg5NDA4\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/33689408?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/mohammad228\",\"html_url\":\"https://github.com/mohammad228\",\"followers_url\":\"https://api.github.com/users/mohammad228/followers\",\"following_url\":\"https://api.github.com/users/mohammad228/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/mohammad228/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/mohammad228/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/mohammad228/subscriptions\",\"organi","numLines":1,"startLine":1,"totalLines":1,"truncatedByTokenCap":true}},"tool_result_meta":[{"id":"toolu_01DUT5p7ELPtdFyZ3Xe1z8Kh","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
