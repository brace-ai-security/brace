eflightAllowedRequestHeaders(r.Header))\n49\t\t\t\tw.WriteHeader(http.StatusOK)\n50\t\t\t\treturn\n51\t\t\t}\n52\t\t\th.ServeHTTP(w, r)\n53\t\t})\n54\t}\n55\t\n56\t// corsPreflightAllowedRequestHeaders reflects validated projected arguments because CORS has no prefix wildcard.\n57\tfunc corsPreflightAllowedRequestHeaders(requestHeaders http.Header) string {\n58\t\tallowed := make([]string, 0, len(corsAllowedRequestHeaders))\n59\t\tallowed = append(allowed, corsAllowedRequestHeaders...)\n60\t\n61\t\tseen := make(map[string]struct{}, len(allowed))\n62\t\tfor _, header := range allowed {\n63\t\t\tseen[strings.ToLower(header)] = struct{}{}\n64\t\t}\n65\t\n66\t\tprefix := strings.ToLower(headers.MCPParamHeaderPrefix)\n67\t\tprojected := make([]string, 0, maxCORSProjectedRequestHeaders)\n68\trequestedHeaders:\n69\t\tfor _, value := range requestHeaders.Values(\"Access-Control-Request-Headers\") {\n70\t\t\tfor header := range strings.SplitSeq(value, \",\") {\n71\t\t\t\theader = strings.TrimSpace(header)\n72\t\t\t\tif !httpguts.ValidHeaderFieldName(header) {\n73\t\t\t\t\tcontinue\n74\t\t\t\t}\n75\t\n76\t\t\t\tkey := strings.ToLower(header)\n77\t\t\t\tif !strings.HasPrefix(key, prefix) || len(key) == len(prefix) {\n78\t\t\t\t\tcontinue\n79\t\t\t\t}\n80\t\t\t\tif _, ok := seen[key]; ok {\n81\t\t\t\t\tcontinue\n82\t\t\t\t}\n83\t\n84\t\t\t\tseen[key] = struct{}{}\n85\t\t\t\tprojected = append(projected, key)\n86\t\t\t\tif len(projected) == maxCORSProjectedRequestHeaders {\n87\t\t\t\t\tbreak requestedHeaders\n88\t\t\t\t}\n89\t\t\t}\n90\t\t}\n91\t\n92\t\tsort.Strings(projected)\n93\t\tfor _, header := range projected {\n94\t\t\tallowed = append(allowed, http.CanonicalHeaderKey(header))\n95\t\t}\n96\t\treturn strings.Join(allowed, \", \")\n97\t}\n98\t"}]},"parent_tool_use_id":null,"session_id":"612e9875-a4d4-4600-ab4a-29f13531ddbd","uuid":"f3ccb4b1-af91-4571-b4c4-b11730ade7c1","timestamp":"2026-10-23T09:37:41.169Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/