854\t\t\t\t\trequestState, err := sealer.Seal(ctx, state)\n855\t\t\t\t\tif err != nil {\n856\t\t\t\t\t\treturn nil, nil, fmt.Errorf(\"failed to seal repository deletion state: %w\", err)\n857\t\t\t\t\t}\n858\t\t\t\t\treturn &mcp.CallToolResult{\n859\t\t\t\t\t\tInputRequests: mcp.InputRequestMap{\n860\t\t\t\t\t\t\tdeleteRepositoryConfirmationID: &mcp.ElicitParams{\n861\t\t\t\t\t\t\t\tMode:    \"form\",\n862\t\t\t\t\t\t\t\tMessage: fmt.Sprintf(\"Type %q to confirm permanent deletion of this repository.\", fullName),\n863\t\t\t\t\t\t\t\tRequestedSchema: &jsonschema.Schema{\n864\t\t\t\t\t\t\t\t\tType: \"object\",\n865\t\t\t\t\t\t\t\t\tProperties: map[string]*jsonschema.Schema{\n866\t\t\t\t\t\t\t\t\t\tdeleteRepositoryConfirmationField: {\n867\t\t\t\t\t\t\t\t\t\t\tType:        \"string\",\n868\t\t\t\t\t\t\t\t\t\t\tTitle:       \"Repository name\",\n869\t\t\t\t\t\t\t\t\t\t\tDescription: fmt.Sprintf(\"Enter %s exactly to confirm deletion\", fullName),\n870\t\t\t\t\t\t\t\t\t\t},\n871\t\t\t\t\t\t\t\t\t},\n872\t\t\t\t\t\t\t\t\tRequired: []string{deleteRepositoryConfirmationField},\n873\t\t\t\t\t\t\t\t},\n874\t\t\t\t\t\t\t},\n875\t\t\t\t\t\t},\n876\t\t\t\t\t\tRequestState: requestState,\n877\t\t\t\t\t}, nil, nil\n878\t\t\t\t}\n879\t\n880\t\t\t\tif req.Params.RequestState == \"\" {\n881\t\t\t\t\treturn utils.NewToolResultError(\"Repository deletion confirmation state was missing. The repository was not deleted.\"), nil, nil\n882\t\t\t\t}\n883\t\t\t\tstateJSON, err := sealer.Open(req.Params.RequestState)\n884\t\t\t\tif err != nil {\n885\t\t\t\t\treturn utils.NewToolResultError(\"Repository deletion confirmation state was invalid. The repository was not deleted.\"), nil, nil\n886\t\t\t\t}\n887\t\t\t\tif err := json.Unmarshal(stateJSON, &deletionState); err != nil {\n888\t\t\t\t\treturn utils.NewToolResultError(\"Repository deletion confirmation state was invalid. The repository was not deleted.\"), nil, nil\n889\t\t\t\t}\n890\t\t\t\tif deletionState.Owner != owner || deletionState