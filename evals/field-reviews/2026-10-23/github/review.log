{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RSvSuvohsiS5asrPAWLbmP","type":"tool_result","content":"1\tpackage http\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"log/slog\"\n7\t\t\"net/http\"\n8\t\t\"slices\"\n9\t\n10\t\tghcontext \"github.com/github/github-mcp-server/v2/pkg/context\"\n11\t\t\"github.com/github/github-mcp-server/v2/pkg/github\"\n12\t\t\"github.com/github/github-mcp-server/v2/pkg/http/headers\"\n13\t\t\"github.com/github/github-mcp-server/v2/pkg/http/middleware\"\n14\t\t\"github.com/github/github-mcp-server/v2/pkg/http/oauth\"\n15\t\t\"github.com/github/github-mcp-server/v2/pkg/inventory\"\n16\t\t\"github.com/github/github-mcp-server/v2/pkg/scopes\"\n17\t\t\"github.com/github/github-mcp-server/v2/pkg/translations\"\n18\t\t\"github.com/github/github-mcp-server/v2/pkg/utils\"\n19\t\t\"github.com/go-chi/chi/v5\"\n20\t\t\"github.com/modelcontextprotocol/go-sdk/jsonrpc\"\n21\t\t\"github.com/modelcontextprotocol/go-sdk/mcp\"\n22\t)\n23\t\n24\tconst subscriptionsListenMethod = \"subscriptions/listen\"\n25\t\n26\t// InventoryFactoryFunc builds the inventory for one HTTP request. All context\n27\t// values required by its feature checker must be installed before this runs:\n28\t// feature availability is resolved immediately afterward, before MCP receiving\n29\t// middleware can run. Handler-only lazy checks still see receiving-middleware\n30\t// context.\n31\ttype InventoryFactoryFunc func(r *http.Request) (*inventory.Inventory, error)\n32\t\n33\t// GitHubMCPServerFactoryFunc is a function type for creating a new MCP Server instance.\n34\t// middleware are applied AFTER the default GitHub MCP Server middlewares (like error context injection)\n35\ttype GitHubMCPServerFactoryFunc func(r *http.Request, deps github.ToolDependencies, inventory *inventory.Inventory, cfg *github.MCPServerConfig) (*mcp.Server, error)\n36\t\n37\ttype Handler struct {\n38\t\tctx                    context.Context\n39\t\tconfig                 *ServerConfig\n40\t\tdeps                   github.ToolDependencies\n41\t\tlogger                 *slog.Logger\n42\t\tapiHosts               utils.APIHostResolver\n43\t\tt                      translations.TranslationHelperFunc\n44\t\tgithubMcpServerFactory GitHubMCPServerFactoryFunc\n45\t\tinventoryFactoryFunc   InventoryFactoryFunc\n46\t\toauthCfg               *oauth.Config\n47\t\tscopeFetcher           scopes.FetcherInterface\n48\t\tschemaCache            *mcp.SchemaCache\n49\t}\n50\t\n51\ttype HandlerOptions struct {\n52\t\tGitHubMcpServerFactory GitHubMCPServerFactoryFunc\n53\t\tInventoryFactory       InventoryFactoryFunc\n54\t\tOAuthConfig            *oauth.Config\n55\t\tScopeFetcher           scopes.FetcherInterface\n56\t\tFeatureChecker         inventory.FeatureFlagChecker\n57\t}\n58\t\n59\ttype HandlerOption func(*HandlerOptions)\n60\t\n61\tfunc WithScopeFetcher(f scopes.FetcherInterface) HandlerOption {\n62\t\treturn func(o *HandlerOptions) {\n63\t\t\to.ScopeFetcher = f\n64\t\t}\n65\t}\n66\t\n67\tfunc WithGitHubMCPServerFactory(f GitHubMCPServerFactoryFunc) HandlerOption {\n68\t\treturn func(o *HandlerOptions) {\n69\t\t\to.GitHubMcpServerFactory = f\n70\t\t}\n71\t}\n72\t\n73\tfunc WithInventoryFactory(f InventoryFactoryFunc) HandlerOption {\n74\t\treturn func(o *HandlerOptions) {\n75\t\t\to.InventoryFactory = f\n76\t\t}\n77\t}\n78\t\n79\tfunc WithOAuthConfig(cfg *oauth.Config) HandlerOption {\n80\t\treturn func(o *HandlerOptions) {\n81\t\t\to.OAuthConfig = cfg\n82\t\t}\n83\t}\n84\t\n85\tfunc WithFeatureChecker(checker inventory.FeatureFlagChecker) HandlerOption {\n86\t\treturn func(o *HandlerOptions) {\n87\t\t\to.FeatureChecker = checker\n88\t\t}\n89\t}\n90\t\n91\tfunc NewHTTPMcpHandler(\n92\t\tctx context.Context,\n93\t\tcfg *ServerConfig,\n94\t\tdeps github.ToolDependencies,\n95\t\tt translations.TranslationHelperFunc,\n96\t\tlogger *slog.Logger,\n97\t\tapiHost utils.APIHostResolver,\n98\t\toptions ...HandlerOption) *Handler {\n99\t\topts := &HandlerOptions{}\n100\t\tfor _, o := range options {\n101\t\t\to(opts)\n102\t\t}\n103\t\n104\t\tgithubMcpServerFactory := opts.GitHubMcpServerFactory\n105\t\tif githubMcpServerFactory == nil {\n106\t\t\tgithubMcpServerFactory = DefaultGitHubMCPServerFactory\n107\t\t}\n108\t\n109\t\tscopeFetcher := opts.ScopeFetcher\n110\t\tif scopeFetcher == nil {\n111\t\t\tscopeFetcher = scopes.NewFetcher(apiHost, scopes.FetcherOptions{})\n112\t\t}\n113\t\n114\t\tinventoryFactory := opts.InventoryFactory\n115\t\tif inventoryFactory == nil {\n116\t\t\tinventoryFactory = DefaultInventoryFactory(cfg, t, opts.FeatureChecker, scopeFetcher)\n117\t\t}\n118\t\n119\t\t// Create a shared schema cache to avoid repeated JSON schema reflection\n120\t\t// when a new MCP Server is created per request in stateless mode.\n121\t\tschemaCache := mcp.NewSchemaCache()\n122\t\n123\t\treturn &Handler{\n124\t\t\tctx:                    ctx,\n125\t\t\tconfig:                 cfg,\n126\t\t\tdeps:                   deps,\n127\t\t\tlogger:                 logger,\n128\t\t\tapiHosts:               apiHost,\n129\t\t\tt:                      t,\n130\t\t\tgithubMcpServerFactory: githubMcpServerFactory,\n131\t\t\tinventoryFactoryFunc:   inventoryFactory,\n132\t\t\toauthCfg:               opts.OAuthConfig,\n133\t\t\tscopeFetcher:           scopeFetcher,\n134\t\t\tschemaCache:            schemaCache,\n135\t\t}\n136\t}\n137\t\n138\tfunc (h *Handler) RegisterMiddleware(r chi.Router) {\n139\t\tr.Use(\n140\t\t\t// Must run first: bounds the body before anything downstream reads it.\n141\t\t\tmiddleware.WithMaxBodySize(h.maxRequestBodyBytes()),\n142\t\t\tmiddleware.ExtractUserToken(h.oauthCfg),\n143\t\t\tmiddleware.WithRequestConfig,\n144\t\t\tmiddleware.WithMCPParse(),\n145\t\t\tmiddleware.WithPATScopes(h.logger, h.scopeFetcher),\n146\t\t)\n147\t\n148\t\tif h.config.ScopeChallenge {\n149\t\t\tr.Use(middleware.WithScopeChallenge(h.oauthCfg, h.scopeFetcher))\n150\t\t}\n151\t}\n152\t\n153\t// maxRequestBodyBytes returns the effective request-body size limit, applied\n154\t// both by the early middleware and by the MCP SDK handler.\n155\tfunc (h *Handler) maxRequestBodyBytes() int64 {\n156\t\tif h.config != nil && h.config.MaxRequestBodyBytes > 0 {\n157\t\t\treturn h.config.MaxRequestBodyBytes\n158\t\t}\n159\t\treturn middleware.DefaultMaxRequestBodyBytes\n160\t}\n161\t\n162\t// RegisterRoutes registers the routes for the MCP server\n163\t// URL-based values take precedence over header-based values\n164\tfunc (h *Handler) RegisterRoutes(r chi.Router) {\n165\t\t// Base routes\n166\t\tr.Mount(\"/\", h)\n167\t\tr.With(withReadonly).Mount(\"/readonly\", h)\n168\t\tr.With(withInsiders).Mount(\"/insiders\", h)\n169\t\tr.With(withReadonly, withInsiders).Mount(\"/readonly/insiders\", h)\n170\t\n171\t\t// Toolset routes\n172\t\tr.With(withToolset).Mount(\"/x/{toolset}\", h)\n173\t\tr.With(withToolset, withReadonly).Mount(\"/x/{toolset}/readonly\", h)\n174\t\tr.With(withToolset, withInsiders).Mount(\"/x/{toolset}/insiders\", h)\n175\t\tr.With(withToolset, withReadonly, withInsiders).Mount(\"/x/{toolset}/readonly/insiders\", h)\n176\t}\n177\t\n178\t// withReadonly is middleware that sets readonly mode in the request context\n179\tfunc withReadonly(next http.Handler) http.Handler {\n180\t\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n181\t\t\tctx := ghcontext.WithReadonly(r.Context(), true)\n182\t\t\tnext.ServeHTTP(w, r.WithContext(ctx))\n183\t\t})\n184\t}\n185\t\n186\t// withToolset is middleware that extracts the toolset from the URL and sets it in the request context\n187\tfunc withToolset(next http.Handler) http.Handler {\n188\t\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n189\t\t\ttoolset := chi.URLParam(r, \"toolset\")\n190\t\t\tctx := ghcontext.WithToolsets(r.Context(), []string{toolset})\n191\t\t\tnext.ServeHTTP(w, r.WithContext(ctx))\n192\t\t})\n193\t}\n194\t\n195\t// withInsiders is middleware that sets insiders mode in the request context\n196\tfunc withInsiders(next http.Handler) http.Handler {\n197\t\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n198\t\t\tctx := ghcontext.WithInsidersMode(r.Context(), true)\n199\t\t\tnext.ServeHTTP(w, r.WithContext(ctx))\n200\t\t})\n201\t}\n202\t\n203\tfunc (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n204\t\tinv, err := h.inventoryFactoryFunc(r)\n205\t\tif err != nil {\n206\t\t\tif errors.Is(err, inventory.ErrUnknownTools) {\n207\t\t\t\tw.WriteHeader(http.StatusBadRequest)\n208\t\t\t\tif _, writeErr := w.Write([]byte(err.Error())); writeErr != nil {\n209\t\t\t\t\th.logger.Error(\"failed to write response\", \"error\", writeErr)\n210\t\t\t\t}\n211\t\t\t\treturn\n212\t\t\t}\n213\t\n214\t\t\tw.WriteHeader(http.StatusInternalServerError)\n215\t\t\treturn\n216\t\t}\n217\t\n218\t\tinvToUse := inv\n219\t\tif methodInfo, ok := ghcontext.MCPMethod(r.Context()); ok && methodInfo != nil {\n220\t\t\tinvToUse = inv.ForMCPRequest(methodInfo.Method, methodInfo.ItemName)\n221\t\t}\n222\t\t// Tool registration must know availability before the MCP server exists.\n223\t\t// Remote consumers install user identity in HTTP middleware before the\n224\t\t// inventory factory, so their per-user checker has its full context here.\n225\t\tr = r.WithContext(invToUse.WithFeatureState(r.Context()))\n226\t\n227\t\tghServer, err := h.githubMcpServerFactory(r, h.deps, invToUse, &github.MCPServerConfig{\n228\t\t\tVersion:           h.config.Version,\n229\t\t\tTranslator:        h.t,\n230\t\t\tContentWindowSize: h.config.ContentWindowSize,\n231\t\t\tLogger:            h.logger,\n232\t\t\tRepoAccessTTL:     h.config.RepoAccessCacheTTL,\n233\t\t\t// Capabilities (no list-changed advertising) are set by NewMCPServer;\n234\t\t\t// here we only supply the remote-specific schema cache.\n235\t\t\tServerOptions: []github.MCPServerOption{\n236\t\t\t\tfunc(so *mcp.ServerOptions) {\n237\t\t\t\t\tso.SchemaCache = h.schemaCache\n238\t\t\t\t},\n239\t\t\t},\n240\t\t})\n241\t\n242\t\tif err != nil {\n243\t\t\tw.WriteHeader(http.StatusInternalServerError)\n244\t\t\treturn\n245\t\t}\n246\t\n247\t\t// Let the SDK validate missing or mismatched method headers before the\n248\t\t// middleware rejects a well-formed request as unsupported.\n249\t\tif r.Header.Get(headers.MCPMethodHeader) == subscriptionsListenMethod {\n250\t\t\tghServer.AddReceivingMiddleware(rejectSubscriptionsListen)\n251\t\t}\n252\t\n253\t\t// Cross-origin protection is intentionally left unset: this server\n254\t\t// authenticates via bearer tokens (not cookies), so Sec-Fetch-Site CSRF\n255\t\t// checks are unnecessary and would block browser-based MCP clients. As of\n256\t\t// go-sdk v1.6.0 a nil CrossOriginProtection disables the check by default;\n257\t\t// see also PR #2359.\n258\t\tmcpHandler := mcp.NewStreamableHTTPHandler(func(_ *http.Request) *mcp.Server {\n259\t\t\treturn ghServer\n260\t\t}, &mcp.StreamableHTTPOptions{\n261\t\t\tStateless: true,\n262\t\t\t// Required, not just belt-and-braces: the effective limit exceeds the\n263\t\t\t// SDK's own default, which would otherwise cap it.\n264\t\t\tMaxRequestBodyBytes: h.maxRequestBodyBytes(),\n265\t\t})\n266\t\n267\t\tmcpHandler.ServeHTTP(w, r)\n268\t}\n269\t\n270\tfunc rejectSubscriptionsListen(next mcp.MethodHandler) mcp.MethodHandler {\n271\t\treturn func(ctx context.Context, method string, req mcp.Request) (mcp.Result, error) {\n272\t\t\tif method == subscriptionsListenMethod {\n273\t\t\t\treturn nil, &jsonrpc.Error{\n274\t\t\t\t\tCode:    jsonrpc.CodeMethodNotFound,\n275\t\t\t\t\tMessage: \"method not found\",\n276\t\t\t\t}\n277\t\t\t}\n278\t\t\treturn next(ctx, method, req)\n279\t\t}\n280\t}\n281\t\n282\tfunc DefaultGitHubMCPServerFactory(r *http.Request, deps github.ToolDependencies, inventory *inventory.Inventory, cfg *github.MCPServerConfig) (*mcp.Server, error) {\n283\t\treturn github.NewMCPServer(r.Context(), cfg, deps, inventory)\n284\t}\n285\t\n286\t// DefaultInventoryFactory creates the default inventory factory for HTTP mode.\n287\t// When the ServerConfig includes static flags (--toolsets, --read-only, etc.),\n288\t// a static inventory is built once at factory creation to pre-filter the tool\n289\t// universe. Per-request headers can only narrow within these bounds.\n290\tfunc DefaultInventoryFactory(cfg *ServerConfig, t translations.TranslationHelperFunc, featureChecker inventory.FeatureFlagChecker, scopeFetcher scopes.FetcherInterface) InventoryFactoryFunc {\n291\t\tfactory, err := NewDefaultInventoryFactory(cfg, t, featureChecker, scopeFetcher)\n292\t\tif err != nil {\n293\t\t\treturn func(_ *http.Request) (*inventory.Inventory, error) {\n294\t\t\t\treturn nil, err\n295\t\t\t}\n296\t\t}\n297\t\treturn factory\n298\t}\n299\t\n300\t// NewDefaultInventoryFactory creates the default HTTP inventory factory and\n301\t// validates static tool configuration before returning it.\n302\tfunc NewDefaultInventoryFactory(cfg *ServerConfig, t translations.TranslationHelperFunc, featureChecker inventory.FeatureFlagChecker, scopeFetcher scopes.FetcherInterface) (InventoryFactoryFunc, error) {\n303\t\t// Build the static tool/resource/prompt universe from CLI flags.\n304\t\t// This is done once at startup and captured in the closure.\n305\t\tstaticTools, staticResources, staticPrompts, err := buildStaticInventory(cfg, t)\n306\t\tif err != nil {\n307\t\t\treturn nil, err\n308\t\t}\n309\t\thasStaticFilters := hasStaticConfig(cfg)\n310\t\n311\t\t// Pre-compute valid tool names for filtering per-request tool headers.\n312\t\t// When a request asks for a tool by name that's been excluded from the\n313\t\t// static universe, we silently drop it rather than returning an error.\n314\t\tvalidToolNames := make(map[string]bool, len(staticTools))\n315\t\tfor i := range staticTools {\n316\t\t\tvalidToolNames[staticTools[i].Tool.Name] = true\n317\t\t}\n318\t\n319\t\treturn func(r *http.Request) (*inventory.Inventory, error) {\n320\t\t\tb := inventory.NewBuilder().\n321\t\t\t\tSetTools(staticTools).\n322\t\t\t\tSetResources(staticResources).\n323\t\t\t\tSetPrompts(staticPrompts).\n324\t\t\t\tWithDeprecatedAliases(github.DeprecatedToolAliases).\n325\t\t\t\tWithFeatureChecker(featureChecker)\n326\t\n327\t\t\t// When static flags constrain the universe, default to showing\n328\t\t\t// everything within those bounds (per-request filters narrow further).\n329\t\t\t// When no static flags are set, preserve existing behavior where\n330\t\t\t// the default toolsets apply.\n331\t\t\tif hasStaticFilters {\n332\t\t\t\tb = b.WithToolsets([]string{\"all\"})\n333\t\t\t}\n334\t\n335\t\t\t// Static read-only is an upper bound — enforce before request filters\n336\t\t\tif cfg.ReadOnly {\n337\t\t\t\tb = b.WithReadOnly(true)\n338\t\t\t}\n339\t\n340\t\t\t// Filter request tool names to only those in the static universe,\n341\t\t\t// so requests for statically-excluded tools degrade gracefully.\n342\t\t\tif hasStaticFilters {\n343\t\t\t\tr = filterRequestTools(r, validToolNames)\n344\t\t\t}\n345\t\n346\t\t\tb = InventoryFiltersForRequest(r, b)\n347\t\t\tb = PATScopeFilter(b, r, scopeFetcher)\n348\t\n349\t\t\tb.WithServerInstructions()\n350\t\n351\t\t\treturn b.Build()\n352\t\t}, nil\n353\t}\n354\t\n355\t// filterRequestTools returns a shallow copy of the request with any per-request\n356\t// tool names (from X-MCP-Tools header) filtered to only include tools that exist\n357\t// in validNames. This ensures requests for statically-excluded tools are silently\n358\t// ignored rather than causing build errors.\n359\tfunc filterRequestTools(r *http.Request, validNames map[string]bool) *http.Request {\n360\t\treqTools := ghcontext.GetTools(r.Context())\n361\t\tif len(reqTools) == 0 {\n362\t\t\treturn r\n363\t\t}\n364\t\n365\t\tfiltered := make([]string, 0, len(reqTools))\n366\t\tfor _, name := range reqTools {\n367\t\t\tif validNames[name] {\n368\t\t\t\tfiltered = append(filtered, name)\n369\t\t\t}\n370\t\t}\n371\t\tctx := ghcontext.WithTools(r.Context(), filtered)\n372\t\treturn r.WithContext(ctx)\n373\t}\n374\t\n375\t// hasStaticConfig returns true if any static filtering flags are set on the ServerConfig.\n376\tfunc hasStaticConfig(cfg *ServerConfig) bool {\n377\t\treturn cfg.ReadOnly ||\n378\t\t\tcfg.EnabledToolsets != nil ||\n379\t\t\tcfg.EnabledTools != nil ||\n380\t\t\tlen(cfg.ExcludeTools) > 0\n381\t}\n382\t\n383\t// buildStaticInventory pre-filters the full tool/resource/prompt universe using\n384\t// the static config (toolsets, read-only, --tools, --exclude-tools). It does\n385\t// NOT install a feature checker: HTTP feature flags can come from per-request\n386\t// context (/insiders, X-MCP-Features), so dual-name feature variants — for\n387\t// example the granular issues/PRs tools that share a name with their\n388\t// non-granular siblings — must be carried through to the per-request\n389\t// inventory, which then installs a checker and resolves the flag before\n390\t// registering tools with the MCP server.\n391\tfunc buildStaticInventory(cfg *ServerConfig, t translations.TranslationHelperFunc) ([]inventory.ServerTool, []inventory.ServerResourceTemplate, []inventory.ServerPrompt, error) {\n392\t\t// Tools with host-specific capabilities need to know the deployment they\n393\t\t// will talk to. An unparseable host is not fatal here: NewAPIHost rejects\n394\t\t// it later with a clearer error, so fall back to the dotcom default.\n395\t\thostType, err := utils.ParseHostType(cfg.Host)\n396\t\tif err != nil {\n397\t\t\thostType = utils.HostTypeDotcom\n398\t\t}\n399\t\topts := []github.ToolOption{github.WithHost(hostType)}\n400\t\ttools := github.AllTools(t, opts...)\n401\t\tfilterUnavailable := func(tools []inventory.ServerTool) []inventory.ServerTool {\n402\t\t\tif !cfg.disableDeleteRepository {\n403\t\t\t\treturn tools\n404\t\t\t}\n405\t\t\treturn slices.DeleteFunc(tools, func(tool inventory.ServerTool) bool {\n406\t\t\t\treturn tool.Tool.Name == github.DeleteRepositoryToolName\n407\t\t\t})\n408\t\t}\n409\t\n410\t\tif !hasStaticConfig(cfg) {\n411\t\t\treturn filterUnavailable(tools), github.AllResources(t), github.AllPrompts(t), nil\n412\t\t}\n413\t\n414\t\tb := inventory.NewBuilder().\n415\t\t\tSetTools(tools).\n416\t\t\tSetResources(github.AllResources(t)).\n417\t\t\tSetPrompts(github.AllPrompts(t)).\n418\t\t\tWithReadOnly(cfg.ReadOnly).\n419\t\t\tWithToolsets(github.ResolvedEnabledToolsets(cfg.EnabledToolsets, cfg.EnabledTools))\n420\t\n421\t\tif len(cfg.EnabledTools) > 0 {\n422\t\t\tb = b.WithTools(github.CleanTools(cfg.EnabledTools))\n423\t\t}\n424\t\n425\t\tif len(cfg.ExcludeTools) > 0 {\n426\t\t\tb = b.WithExcludeTools(cfg.ExcludeTools)\n427\t\t}\n428\t\n429\t\tinv, err := b.Build()\n430\t\tif err != nil {\n431\t\t\treturn nil, nil, nil, err\n432\t\t}\n433\t\n434\t\tctx := context.Background()\n435\t\treturn filterUnavailable(inv.AvailableTools(ctx)), inv.AvailableResourceTemplates(ctx), inv.AvailablePrompts(ctx), nil\n436\t}\n437\t\n438\t// InventoryFiltersForRequest applies filters to the inventory builder\n439\t// based on the request context and headers.\n440\t// MCP Apps UI metadata is handled by the builder via the feature checker —\n441\t// no need to check headers here.\n442\tfunc InventoryFiltersForRequest(r *http.Request, builder *inventory.Builder) *inventory.Builder {\n443\t\tctx := r.Context()\n444\t\n445\t\tif ghcontext.IsReadonly(ctx) {\n446\t\t\tbuilder = builder.WithReadOnly(true)\n447\t\t}\n448\t\n449\t\ttoolsets := ghcontext.GetToolsets(ctx)\n450\t\ttools := ghcontext.GetTools(ctx)\n451\t\n452\t\tif len(toolsets) > 0 {\n453\t\t\tbuilder = builder.WithToolsets(github.ResolvedEnabledToolsets(toolsets, tools))\n454\t\t}\n455\t\n456\t\tif len(tools) > 0 {\n457\t\t\tif len(toolsets) == 0 {\n458\t\t\t\tbuilder = builder.WithToolsets([]string{})\n459\t\t\t}\n460\t\t\tbuilder = builder.WithTools(github.CleanTools(tools))\n461\t\t}\n462\t\n463\t\tif excluded := ghcontext.GetExcludeTools(ctx); len(excluded) > 0 {\n464\t\t\tbuilder = builder.WithExcludeTools(excluded)\n465\t\t}\n466\t\n467\t\treturn builder\n468\t}\n469\t\n470\tfunc PATScopeFilter(b *inventory.Builder, r *http.Request, fetcher scopes.FetcherInterface) *inventory.Builder {\n471\t\tctx := r.Context()\n472\t\n473\t\ttokenInfo, ok := ghcontext.GetTokenInfo(ctx)\n474\t\tif !ok || tokenInfo == nil {\n475\t\t\treturn b\n476\t\t}\n477\t\n478\t\t// Scopes should have already been fetched by the WithPATScopes middleware.\n479\t\t// Only classic PATs (ghp_ prefix) return OAuth scopes via X-OAuth-Scopes header.\n480\t\t// Fine-grained PATs and other token types don't support this, so we skip filtering.\n481\t\tif tokenInfo.TokenType == utils.TokenTypePersonalAccessToken {\n482\t\t\t// Check if scopes are already in context (should be set by WithPATScopes). If not, fetch them.\n483\t\t\texistingScopes, ok := ghcontext.GetTokenScopes(ctx)\n484\t\t\tif ok {\n485\t\t\t\treturn b.WithFilter(github.CreateToolScopeFilter(existingScopes))\n486\t\t\t}\n487\t\n488\t\t\tscopesList, err := fetcher.FetchTokenScopes(ctx, tokenInfo.Token)\n489\t\t\tif err != nil {\n490\t\t\t\treturn b\n491\t\t\t}\n492\t\n493\t\t\treturn b.WithFilter(github.CreateToolScopeFilter(scopesList))\n494\t\t}\n495\t\n496\t\treturn b\n497\t}\n498\t"}]},"parent_tool_use_id":null,"session_id":"612e9875-a4d4-4600-ab4a-29f13531ddbd","uuid":"3e96139b-63ab-4496-9f3f-ce30182f7167","timestamp":"2026-10-23T09:37:38.820Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-public-mcp-q7nbmmgh/repo/pkg/http/handler.go","content":"package http\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"log/slog\"\n\t\"net/http\"\n\t\"slices\"\n\n\tghcontext \"github.com/github/github-mcp-server/v2/pkg/context\"\n\t\"github.com/github/github-mcp-server/v2/pkg/github\"\n\t\"github.com/github/github-mcp-server/v2/pkg/http/headers\"\n\t\"github.com/github/github-mcp-server/v2/pkg/http/middleware\"\n\t\"github.com/github/github-mcp-server/v2/pkg/http/oauth\"\n\t\"github.com/github/github-mcp-server/v2/pkg/inventory\"\n\t\"github.com/github/github-mcp-server/v2/pkg/scopes\"\n\t\"github.com/github/github-mcp-server/v2/pkg/translations\"\n\t\"github.com/github/github-mcp-server/v2/pkg/utils\"\n\t\"github.com/go-chi/chi/v5\"\n\t\"github.com/modelcontextprotocol/go-sdk/jsonrpc\"\n\t\"github.com/modelcontextprotocol/go-sdk/mcp\"\n)\n\nconst subscriptionsListenMethod = \"subscriptions/listen\"\n\n// InventoryFactoryFunc builds the inventory for one HTTP request. All context\n// values required by its feature checker must be installed before this runs:\n// feature availability is resolved immediately afterward, before MCP receiving\n// middleware can run. Handler-only lazy checks still see receiving-middleware\n// context.\ntype InventoryFactoryFunc func(r *http.Request) (*inventory.Inventory, error)\n\n// GitHubMCPServerFactoryFunc is a function type for creating a new MCP Server instance.\n// middleware are applied AFTER the default GitHub MCP Server middlewares (like error context injection)\ntype GitHubMCPServerFactoryFunc func(r *http.Request, deps github.ToolDependencies, inventory *inventory.Inventory, cfg *github.MCPServerConfig) (*mcp.Server, error)\n\ntype Handler struct {\n\tctx                    context.Context\n\tconfig                 *ServerConfig\n\tdeps                   github.ToolDependencies\n\tlogger                 *slog.Logger\n\tapiHosts               utils.APIHostResolver\n\tt                      translations.TranslationHelperFunc\n\tgithubMcpServerFactory GitHubMCPServerFactoryFunc\n\tinventoryFactoryFunc   InventoryFactoryFunc\n\toauthCfg               *oauth.Config\n\tscopeFetcher           scopes.FetcherInterface\n\tschemaCache            *mcp.SchemaCache\n}\n\ntype HandlerOptions struct {\n\tGitHubMcpServerFactory GitHubMCPServerFactoryFunc\n\tInventoryFactory       InventoryFactoryFunc\n\tOAuthConfig            *oauth.Config\n\tScopeFetcher           scopes.FetcherInterface\n\tFeatureChecker         inventory.FeatureFlagChecker\n}\n\ntype HandlerOption func(*HandlerOptions)\n\nfunc WithScopeFetcher(f scopes.FetcherInterface) HandlerOption {\n\treturn func(o *HandlerOptions) {\n\t\to.ScopeFetcher = f\n\t}\n}\n\nfunc WithGitHubMCPServerFactory(f GitHubMCPServerFactoryFunc) HandlerOption {\n\treturn func(o *HandlerOptions) {\n\t\to.GitHubMcpServerFactory = f\n\t}\n}\n\nfunc WithInventoryFactory(f InventoryFactoryFunc) HandlerOption {\n\treturn func(o *HandlerOptions) {\n\t\to.InventoryFactory = f\n\t}\n}\n\nfunc WithOAuthConfig(cfg *oauth.Config) HandlerOption {\n\treturn func(o *HandlerOptions) {\n\t\to.OAuthConfig = cfg\n\t}\n}\n\nfunc WithFeatureChecker(checker inventory.FeatureFlagChecker) HandlerOption {\n\treturn func(o *HandlerOptions) {\n\t\to.FeatureChecker = checker\n\t}\n}\n\nfunc NewHTTPMcpHandler(\n\tctx context.Context,\n\tcfg *ServerConfig,\n\tdeps github.ToolDependencies,\n\tt translations.TranslationHelperFunc,\n\tlogger *slog.Logger,\n\tapiHost utils.APIHostResolver,\n\toptions ...HandlerOption) *Handler {\n\topts := &HandlerOptions{}\n\tfor _, o := range options {\n\t\to(opts)\n\t}\n\n\tgithubMcpServerFactory := opts.GitHubMcpServerFactory\n\tif githubMcpServerFactory == nil {\n\t\tgithubMcpServerFactory = DefaultGitHubMCPServerFactory\n\t}\n\n\tscopeFetcher := opts.ScopeFetcher\n\tif scopeFetcher == nil {\n\t\tscopeFetcher = scopes.NewFetcher(apiHost, scopes.FetcherOptions{})\n\t}\n\n\tinventoryFactory := opts.InventoryFactory\n\tif inventoryFactory == nil {\n\t\tinventoryFactory = DefaultInventoryFactory(cfg, t, opts.FeatureChecker, scopeFetcher)\n\t}\n\n\t// Create a shared schema cache to avoid repeated JSON schema reflection\n\t// when a new MCP Server is created per request in stateless mode.\n\tschemaCache := mcp.NewSchemaCache()\n\n\treturn &Handler{\n\t\tctx:                    ctx,\n\t\tconfig:                 cfg,\n\t\tdeps:                   deps,\n\t\tlogger:                 logger,\n\t\tapiHosts:               apiHost,\n\t\tt:                      t,\n\t\tgithubMcpServerFactory: githubMcpServerFactory,\n\t\tinventoryFactoryFunc:   inventoryFactory,\n\t\toauthCfg:               opts.OAuthConfig,\n\t\tscopeFetcher:           scopeFetcher,\n\t\tschemaCache:            schemaCache,\n\t}\n}\n\nfunc (h *Handler) RegisterMiddleware(r chi.Router) {\n\tr.Use(\n\t\t// Must run first: bounds the body before anything downstream reads it.\n\t\tmiddleware.WithMaxBodySize(h.maxRequestBodyBytes()),\n\t\tmiddleware.ExtractUserToken(h.oauthCfg),\n\t\tmiddleware.WithRequestConfig,\n\t\tmiddleware.WithMCPParse(),\n\t\tmiddleware.WithPATScopes(h.logger, h.scopeFetcher),\n\t)\n\n\tif h.config.ScopeChallenge {\n\t\tr.Use(middleware.WithScopeChallenge(h.oauthCfg, h.scopeFetcher))\n\t}\n}\n\n// maxRequestBodyBytes returns the effective request-body size limit, applied\n// both by the early middleware and by the MCP SDK handler.\nfunc (h *Handler) maxRequestBodyBytes() int64 {\n\tif h.config != nil && h.config.MaxRequestBodyBytes > 0 {\n\t\treturn h.config.MaxRequestBodyBytes\n\t}\n\treturn middleware.DefaultMaxRequestBodyBytes\n}\n\n// RegisterRoutes registers the routes for the MCP server\n// URL-based values take precedence over header-based values\nfunc (h *Handler) RegisterRoutes(r chi.Router) {\n\t// Base routes\n\tr.Mount(\"/\", h)\n\tr.With(withReadonly).Mount(\"/readonly\", h)\n\tr.With(withInsiders).Mount(\"/insiders\", h)\n\tr.With(withReadonly, withInsiders).Mount(\"/readonly/insiders\", h)\n\n\t// Toolset routes\n\tr.With(withToolset).Mount(\"/x/{toolset}\", h)\n\tr.With(withToolset, withReadonly).Mount(\"/x/{toolset}/readonly\", h)\n\tr.With(withToolset, withInsiders).Mount(\"/x/{toolset}/insiders\", h)\n\tr.With(withToolset, withReadonly, withInsiders).Mount(\"/x/{toolset}/readonly/insiders\", h)\n}\n\n// withReadonly is middleware that sets readonly mode in the request context\nfunc withReadonly(next http.Handler) http.Handler {\n\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\tctx := ghcontext.WithReadonly(r.Context(), true)\n\t\tnext.ServeHTTP(w, r.WithContext(ctx))\n\t})\n}\n\n// withToolset is middleware that extracts the toolset from the URL and sets it in the request context\nfunc withToolset(next http.Handler) http.Handler {\n\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\ttoolset := chi.URLParam(r, \"toolset\")\n\t\tctx := ghcontext.WithToolsets(r.Context(), []string{toolset})\n\t\tnext.ServeHTTP(w, r.WithContext(ctx))\n\t})\n}\n\n// withInsiders is middleware that sets insiders mode in the request context\nfunc withInsiders(next http.Handler) http.Handler {\n\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\tctx := ghcontext.WithInsidersMode(r.Context(), true)\n\t\tnext.ServeHTTP(w, r.WithContext(ctx))\n\t})\n}\n\nfunc (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tinv, err := h.inventoryFactoryFunc(r)\n\tif err != nil {\n\t\tif errors.Is(err, inventory.ErrUnknownTools) {\n\t\t\tw.WriteHeader(http.StatusBadRequest)\n\t\t\tif _, writeErr := w.Write([]byte(err.Error())); writeErr != nil {\n\t\t\t\th.logger.Error(\"failed to write response\", \"error\", writeErr)\n\t\t\t}\n\t\t\treturn\n\t\t}\n\n\t\tw.WriteHeader(http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\tinvToUse := inv\n\tif methodInfo, ok := ghcontext.MCPMethod(r.Context()); ok && methodInfo != nil {\n\t\tinvToUse = inv.ForMCPRequest(methodInfo.Method, methodInfo.ItemName)\n\t}\n\t// Tool registration must know availability before the MCP server exists.\n\t// Remote consumers install user identity in HTTP middleware before the\n\t// inventory factory, so their per-user checker has its full context here.\n\tr = r.WithContext(invToUse.WithFeatureState(r.Context()))\n\n\tghServer, err := h.githubMcpServerFactory(r, h.deps, invToUse, &github.MCPServerConfig{\n\t\tVersion:           h.config.Version,\n\t\tTranslator:        h.t,\n\t\tContentWindowSize: h.config.ContentWindowSize,\n\t\tLogger:            h.logger,\n\t\tRepoAccessTTL:     h.config.RepoAccessCacheTTL,\n\t\t// Capabilities (no list-changed advertising) are set by NewMCPServer;\n\t\t// here we only supply the remote-specific schema cache.\n\t\tServerOptions: []github.MCPServerOption{\n\t\t\tfunc(so *mcp.ServerOptions) {\n\t\t\t\tso.SchemaCache = h.schemaCache\n\t\t\t},\n\t\t},\n\t})\n\n\tif err != nil {\n\t\tw.WriteHeader(http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\t// Let the SDK validate missing or mismatched method headers before the\n\t// middleware rejects a well-formed request as unsupported.\n\tif r.Header.Get(headers.MCPMethodHeader) == subscriptionsListenMethod {\n\t\tghServer.AddReceivingMiddleware(rejectSubscriptionsListen)\n\t}\n\n\t// Cross-origin protection is intentionally left unset: this server\n\t// authenticates via bearer tokens (not cookies), so Sec-Fetch-Site CSRF\n\t// checks are unnecessary and would block browser-based MCP clients. As of\n\t// go-sdk v1.6.0 a nil CrossOriginProtection disables the check by default;\n\t// see also PR #2359.\n\tmcpHandler := mcp.NewStreamableHTTPHandler(func(_ *http.Request) *mcp.Server {\n\t\treturn ghServer\n\t}, &mcp.StreamableHTTPOptions{\n\t\tStateless: true,\n\t\t// Required, not just belt-and-braces: the effective limit exceeds the\n\t\t// SDK's own default, which would otherwise cap it.\n\t\tMaxRequestBodyBytes: h.maxRequestBodyBytes(),\n\t})\n\n\tmcpHandler.ServeHTTP(w, r)\n}\n\nfunc rejectSubscriptionsListen(next mcp.MethodHandler) mcp.MethodHandler {\n\treturn func(ctx context.Context, method string, req mcp.Request) (mcp.Result, error) {\n\t\tif method == subscriptionsListenMethod {\n\t\t\treturn nil, &jsonrpc.Error{\n\t\t\t\tCode:    jsonrpc.CodeMethodNotFound,\n\t\t\t\tMessage: \"method not found\",\n\t\t\t}\n\t\t}\n\t\treturn next(ctx, method, req)\n\t}\n}\n\nfunc DefaultGitHubMCPServerFactory(r *http.Request, deps github.ToolDependencies, inventory *inventory.Inventory, cfg *github.MCPServerConfig) (*mcp.Server, error) {\n\treturn github.NewMCPServer(r.Context(), cfg, deps, inventory)\n}\n\n// DefaultInventoryFactory creates the default inventory factory for HTTP mode.\n// When the ServerConfig includes static flags (--toolsets, --read-only, etc.),\n// a static inventory is built once at factory creation to pre-filter the tool\n// universe. Per-request headers can only narrow within these bounds.\nfunc DefaultInventoryFactory(cfg *ServerConfig, t translations.TranslationHelperFunc, featureChecker inventory.FeatureFlagChecker, scopeFetcher scopes.FetcherInterface) InventoryFactoryFunc {\n\tfactory, err := NewDefaultInventoryFactory(cfg, t, featureChecker, scopeFetcher)\n\tif err != nil {\n\t\treturn func(_ *http.Request) (*inventory.Inventory, error) {\n\t\t\treturn nil, err\n\t\t}\n\t}\n\treturn factory\n}\n\n// NewDefaultInventoryFactory creates the default HTTP inventory factory and\n// validates static tool configuration before returning it.\nfunc NewDefaultInventoryFactory(cfg *ServerConfig, t translations.TranslationHelperFunc, featureChecker inventory.FeatureFlagChecker, scopeFetcher scopes.FetcherInterface) (InventoryFactoryFunc, error) {\n\t// Build the static tool/resource/prompt universe from CLI flags.\n\t// This is done once at startup and captured in the closure.\n\tstaticTools, staticResources, staticPrompts, err := buildStaticInventory(cfg, t)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\thasStaticFilters := hasStaticConfig(cfg)\n\n\t// Pre-compute valid tool names for filtering per-request tool headers.\n\t// When a request asks for a tool by name that's been excluded from the\n\t// static universe, we silently drop it rather than returning an error.\n\tvalidToolNames := make(map[string]bool, len(staticTools))\n\tfor i := range staticTools {\n\t\tvalidToolNames[staticTools[i].Tool.Name] = true\n\t}\n\n\treturn func(r *http.Request) (*inventory.Inventory, error) {\n\t\tb := inventory.NewBuilder().\n\t\t\tSetTools(staticTools).\n\t\t\tSetResources(staticResources).\n\t\t\tSetPrompts(staticPrompts).\n\t\t\tWithDeprecatedAliases(github.DeprecatedToolAliases).\n\t\t\tWithFeatureChecker(featureChecker)\n\n\t\t// When static flags constrain the universe, default to showing\n\t\t// everything within those bounds (per-request filters narrow further).\n\t\t// When no static flags are set, preserve existing behavior where\n\t\t// the default toolsets apply.\n\t\tif hasStaticFilters {\n\t\t\tb = b.WithToolsets([]string{\"all\"})\n\t\t}\n\n\t\t// Static read-only is an upper bound — enforce before request filters\n\t\tif cfg.ReadOnly {\n\t\t\tb = b.WithReadOnly(true)\n\t\t}\n\n\t\t// Filter request tool names to only those in the static universe,\n\t\t// so requests for statically-excluded tools degrade gracefully.\n\t\tif hasStaticFilters {\n\t\t\tr = filterRequestTools(r, validToolNames)\n\t\t}\n\n\t\tb = InventoryFiltersForRequest(r, b)\n\t\tb = PATScopeFilter(b, r, scopeFetcher)\n\n\t\tb.WithServerInstructions()\n\n\t\treturn b.Build()\n\t}, nil\n}\n\n// filterRequestTools returns a shallow copy of the request with any per-request\n// tool names (from X-MCP-Tools header) filtered to only include tools that exist\n// in validNames. This ensures requests for statically-excluded tools are silently\n// ignored rather than causing build errors.\nfunc filterRequestTools(r *http.Request, validNames map[string]bool) *http.Request {\n\treqTools := ghcontext.GetTools(r.Context())\n\tif len(reqTools) == 0 {\n\t\treturn r\n\t}\n\n\tfiltered := make([]string, 0, len(reqTools))\n\tfor _, name := range reqTools {\n\t\tif validNames[name] {\n\t\t\tfiltered = append(filtered, name)\n\t\t}\n\t}\n\tctx := ghcontext.WithTools(r.Context(), filtered)\n\treturn r.WithContext(ctx)\n}\n\n// hasStaticConfig returns true if any static filtering flags are set on the ServerConfig.\nfunc hasStaticConfig(cfg *ServerConfig) bool {\n\treturn cfg.ReadOnly ||\n\t\tcfg.EnabledToolsets != nil ||\n\t\tcfg.EnabledTools != nil ||\n\t\tlen(cfg.ExcludeTools) > 0\n}\n\n// buildStaticInventory pre-filters the full tool/resource/prompt universe using\n// the static config (toolsets, read-only, --tools, --exclude-tools). It does\n// NOT install a feature checker: HTTP feature flags can come from per-request\n// context (/insiders, X-MCP-Features), so dual-name feature variants — for\n// example the granular issues/PRs tools that share a name with their\n// non-granular siblings — must be carried through to the per-request\n// inventory, which then installs a checker and resolves the flag before\n// registering tools with the MCP server.\nfunc buildStaticInventory(cfg *ServerConfig, t translations.TranslationHelperFunc) ([]inventory.ServerTool, []inventory.ServerResourceTemplate, []inventory.ServerPrompt, error) {\n\t// Tools with host-specific capabilities need to know the deployment they\n\t// will talk to. An unparseable host is not fatal here: NewAPIHost rejects\n\t// it later with a clearer error, so fall back to the dotcom default.\n\thostType, err := utils.ParseHostType(cfg.Host)\n\tif err != nil {\n\t\thostType = utils.HostTypeDotcom\n\t}\n\topts := []github.ToolOption{github.WithHost(hostType)}\n\ttools := github.AllTools(t, opts...)\n\tfilterUnavailable := func(tools []inventory.ServerTool) []inventory.ServerTool {\n\t\tif !cfg.disableDeleteRepository {\n\t\t\treturn tools\n\t\t}\n\t\treturn slices.DeleteFunc(tools, func(tool inventory.ServerTool) bool {\n\t\t\treturn tool.Tool.Name == github.DeleteRepositoryToolName\n\t\t})\n\t}\n\n\tif !hasStaticConfig(cfg) {\n\t\treturn filterUnavailable(tools), github.AllResources(t), github.AllPrompts(t), nil\n\t}\n\n\tb := inventory.NewBuilder().\n\t\tSetTools(tools).\n\t\tSetResources(github.AllResources(t)).\n\t\tSetPrompts(github.AllPrompts(t)).\n\t\tWithReadOnly(cfg.ReadOnly).\n\t\tWithToolsets(github.ResolvedEnabledToolsets(cfg.EnabledToolsets, cfg.EnabledTools))\n\n\tif len(cfg.EnabledTools) > 0 {\n\t\tb = b.WithTools(github.CleanTools(cfg.EnabledTools))\n\t}\n\n\tif len(cfg.ExcludeTools) > 0 {\n\t\tb = b.WithExcludeTools(cfg.ExcludeTools)\n\t}\n\n\tinv, err := b.Build()\n\tif err != nil {\n\t\treturn nil, nil, nil, err\n\t}\n\n\tctx := context.Background()\n\treturn filterUnavailable(inv.AvailableTools(ctx)), inv.AvailableResourceTemplates(ctx), inv.AvailablePrompts(ctx), nil\n}\n\n// InventoryFiltersForRequest applies filters to the inventory builder\n// based on the request context and headers.\n// MCP Apps UI metadata is handled by the builder via the feature checker —\n// no need to check headers here.\nfunc InventoryFiltersForRequest(r *http.Request, builder *inventory.Builder) *inventory.Builder {\n\tctx := r.Context()\n\n\tif ghcontext.IsReadonly(ctx) {\n\t\tbuilder = builder.WithReadOnly(true)\n\t}\n\n\ttoolsets := ghcontext.GetToolsets(ctx)\n\ttools := ghcontext.GetTools(ctx)\n\n\tif len(toolsets) > 0 {\n\t\tbuilder = builder.WithToolsets(github.ResolvedEnabledToolsets(toolsets, tools))\n\t}\n\n\tif len(tools) > 0 {\n\t\tif len(toolsets) == 0 {\n\t\t\tbuilder = builder.WithToolsets([]string{})\n\t\t}\n\t\tbuilder = builder.WithTools(github.CleanTools(tools))\n\t}\n\n\tif excluded := ghcontext.GetExcludeTools(ctx); len(excluded) > 0 {\n\t\tbuilder = builder.WithExcludeTools(excluded)\n\t}\n\n\treturn builder\n}\n\nfunc PATScopeFilter(b *inventory.Builder, r *http.Request, fetcher scopes.FetcherInterface) *inventory.Builder {\n\tctx := r.Context()\n\n\ttokenInfo, ok := ghcontext.GetTokenInfo(ctx)\n\tif !ok || tokenInfo == nil {\n\t\treturn b\n\t}\n\n\t// Scopes should have already been fetched by the WithPATScopes middleware.\n\t// Only classic PATs (ghp_ prefix) return OAuth scopes via X-OAuth-Scopes header.\n\t// Fine-grained PATs and other token types don't support this, so we skip filtering.\n\tif tokenInfo.TokenType == utils.TokenTypePersonalAccessToken {\n\t\t// Check if scopes are already in context (should be set by WithPATScopes). If not, fetch them.\n\t\texistingScopes, ok := ghcontext.GetTokenScopes(ctx)\n\t\tif ok {\n\t\t\treturn b.WithFilter(github.CreateToolScopeFilter(existingScopes))\n\t\t}\n\n\t\tscopesList, err := fetcher.FetchTokenScopes(ctx, tokenInfo.Token)\n\t\tif err != nil {\n\t\t\treturn b\n\t\t}\n\n\t\treturn b.WithFilter(github.CreateToolScopeFilter(scopesList))\n\t}\n\n\treturn b\n}\n","numLines":498,"startLine":1,"totalLines":498}},"tool_result_meta":[{"id":"toolu_01RSvSuvohsiS5asrPAWLbmP","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
