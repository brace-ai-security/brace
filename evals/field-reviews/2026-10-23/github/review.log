epositories.Delete(ctx, owner, repo)\n924\t\t\t\tif err != nil {\n925\t\t\t\t\treturn ghErrors.NewGitHubAPIErrorResponse(ctx,\n926\t\t\t\t\t\tfmt.Sprintf(\"failed to delete repository: %s\", fullName),\n927\t\t\t\t\t\tresp,\n928\t\t\t\t\t\terr,\n929\t\t\t\t\t), nil, nil\n930\t\t\t\t}\n931\t\t\t\tdefer func() { _ = resp.Body.Close() }()\n932\t\n933\t\t\t\tif resp.StatusCode != http.StatusNoContent {\n934\t\t\t\t\tbody, err := io.ReadAll(resp.Body)\n935\t\t\t\t\tif err != nil {\n936\t\t\t\t\t\treturn nil, nil, fmt.Errorf(\"failed to read response body: %w\", err)\n937\t\t\t\t\t}\n938\t\t\t\t\treturn ghErrors.NewGitHubAPIStatusErrorResponse(ctx, \"failed to delete repository\", resp, body), nil, nil\n939\t\t\t\t}\n940\t\n941\t\t\t\tmessage := fmt.Sprintf(\"Repository %s was deleted.\", fullName)\n942\t\t\t\treturn utils.NewToolResultText(message), &RepositoryMessageOutput{Message: message}, nil\n943\t\t\t},\n944\t\t)\n945\t\ttool.MinimumProtocolVersion = inventory.ProtocolVersionMultiRoundTrip\n946\t\ttool.RequiredElicitationMode = inventory.ElicitationModeForm\n947\t\treturn tool\n948\t}\n949\t\n950\tfunc repositoryIDForDeletion(ctx context.Context, client *github.Client, owner, repo string) (int64, *mcp.CallToolResult) {\n951\t\trepository, resp, err := client.Repositories.Get(ctx, owner, repo)\n952\t\tif err != nil {\n953\t\t\treturn 0, ghErrors.NewGitHubAPIErrorResponse(ctx,\n954\t\t\t\tfmt.Sprintf(\"failed to get repository: %s/%s\", owner, repo),\n955\t\t\t\tresp,\n956\t\t\t\terr,\n957\t\t\t)\n958\t\t}\n959\t\tif resp != nil && resp.Body != nil {"}]},"parent_tool_use_id":null,"session_id":"612e9875-a4d4-4600-ab4a-29f13531ddbd","uuid":"d25315f6-f56d-4b0a-9835-f5c1b4bdd570","timestamp":"2026-10-23T09:37:55.263Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-public-mcp-q7nbmmgh/repo/pkg/github/repositories.go","content":"}\n\nconst (\n\tDeleteRepositoryToolName          = \"delete_repository\"\n\t