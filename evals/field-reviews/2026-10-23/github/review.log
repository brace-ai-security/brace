nabled for insiders.\n54\t\tInsidersMode bool\n55\t\n56\t\t// Logger is used for logging within the server\n57\t\tLogger *slog.Logger\n58\t\t// RepoAccessTTL overrides the default TTL for repository access cache entries.\n59\t\tRepoAccessTTL *time.Duration\n60\t\n61\t\t// ExcludeTools is a list of tool names that should be disabled regardless of\n62\t\t// other configuration. These tools will be excluded even if their toolset is enabled\n63\t\t// or they are explicitly listed in EnabledTools.\n64\t\tExcludeTools []string\n65\t\n66\t\t// TokenScopes contains the OAuth scopes available to the token.\n67\t\t// When non-nil, tools requiring scopes not in this list will be hidden.\n68\t\t// This is used for PAT scope filtering where we can't issue scope challenges.\n69\t\tTokenScopes []string\n70\t\n71\t\t// TokenProvider, when non-nil, supplies the GitHub token for each API\n72\t\t// request instead of the static Token.\n73\t\tTokenProvider func() string\n74\t\n75\t\t// ToolHandlerMiddleware wraps every registered tool handler. Unlike MCP\n76\t\t// receiving middleware, these wrappers execute inside Server.callTool, so\n77\t\t// SDK result finalization still runs on results they return.\n78\t\tToolHandlerMiddleware []inventory.ToolHandlerMiddleware\n79\t\n80\t\t// Additional server options to apply\n81\t\tServerOptions []MCPServerOption\n82\t}\n83\t\n84\ttype MCPServerOption func(*mcp.ServerOptions)\n85\t\n86\tfunc NewMCPServer(ctx context.Context, cfg *MCPServerConfig, deps ToolDependencies, inv *inventory.Inventory, middleware ...mcp.Middleware) (*mcp.Server, error) {\n87\t\t// Create the MCP server\n88\t\tserverOpts := &mcp.ServerOptions{\n89\t\t\tInstructions:      inv.Instructions(),\n90\t\t\tLogger:            cfg.Logger,\n91\t\t\tCompletionHandler: CompletionsHandler(deps.GetClient),\n92\t\t\t// Advertise tools, prompts, and resources without list-changed\n93\t\t\t// notifications. The server has a static set of tools/prompts/resources\n94\t\t\t// and never mutates them at runtime, so it never emits list_changed\n95\t\t\t// notifications. Left unset, the SDK would infer listChanged:true from\n96\t\t\t// the presence of items and advertise a capability we don't support -\n97\t\t\t// which the 2026-07-28 spec (subscriptions/listen) makes stricter still.\n98\t\t\t// Explicitly declaring these keeps the advertised capabilities honest.\n99\t\t\tCapabilities: &mcp.ServerCapabilities{\n100\t\t\t\tTools:     &mcp.ToolCapabilities{},\n101\t\t\t\tPrompts:   &mcp.PromptCapabilities{},\n102\t\t\t\tResources: &mcp.ResourceCapabilities{},\n103\t\t\t},\n104\t\t}\n105\t\n106\t\t// Apply any additional server options\n107\t\tfor _, o := range cfg.ServerOptions {\n108\t\t\to(serverOpts)\n109\t\t}\n110\t\n111\t\tghServer := NewServer(cfg.Version, cfg.Translator(\"SERVER_NAME\", \"github-mcp-server\"), cfg.Translator(\"SERVER_TITLE\", \"GitHub MCP Server\"), serverOpts)\n112\t\n113\t\tif unrecognized := inv.UnrecognizedToolsets(); len(unrecognized) > 0 {\n114\t\t\tcfg.Logger.Warn(\"Warning: unrecognized toolsets ignored\", \"toolsets\", strings.Join(unrecognized, \", \"))\n115\t\t}\n116\t\n117\t\t// Register GitHub tools/resources/prompts from the inventory.\n118\t\tinv.RegisterAll(ctx, ghServer, deps, cfg.ToolHandlerMiddleware...)\n119\t\n120\t\t// Add request middleware after registering tools so it wraps the protocol\n121\t\t// adapter. Preflight and legacy typed calls then receive the same request\n122\t\t// context as modern typed calls.\n123\t\t// Middleware order matters: the error context wrapper is applied last so it\n124\t\t// runs first and can observe errors from every inner middleware.\n125\t\tghServer.AddReceivingMiddleware(middleware...)\n126\t\tghServer.AddReceivingMiddleware(injectFeatureStateMiddleware(inv))\n127\t\tghServer.AddReceivingMiddleware(InjectDepsMiddleware(deps))\n128\t\tghServer.AddReceivingMiddleware(addGitHubAPIErrorToContext)\n129\t\n130\t\t// Register MCP App UI resources whenever the embedded UI assets are\n131\t\t// available. The resources are static HTML referenced by tools' _meta.ui\n132\t\t// block (the inventory strips that block for clients that do not support\n133\t\t// MCP Apps), so registering them unconditionally is safe.\n134\t\t// Registering here — rather than in the stdio bootstrap — ensures the\n135\t\t// remote/HTTP server also serves them, fixing the \"-32002 Resource not\n136\t\t// found\" error clients hit after the tool returns a ui:// URI.\n137\t\tif UIAssetsAvailable() {\n138\t\t\tRegisterUIResources(ghServer, cfg.ReadOnly)\n139\t\t}\n140\t\n141\t\treturn ghServer, nil\n142\t}\n143\t\n144\tfunc injectFeatureStateMiddleware(inv *inventory.Inventory) mcp.Middleware {\n145\t\treturn func(next mcp.MethodHandler) mcp.MethodHandler {\n146\t\t\treturn func(ctx context.Context, method string, req mcp.Request) (mcp.Result, error) {\n147\t\t\t\treturn next(inv.WithFeatureState(ctx), method, req)\n148\t\t\t}\n149\t\t}\n150\t}\n151\t\n152\t// ResolvedEnabledToolsets determines which toolsets should be enabled based on config.\n153\t// Returns nil for \"use defaults\", empty slice for \"none\", or explicit list.\n154\tfunc ResolvedEnabledToolsets(enabledToolsets []string, enabledTools []string) []string {\n155\t\tif enabledToolsets != nil {\n156\t\t\treturn enabledToolsets\n157\t\t}\n158\t\tif len(enabledTools) > 0 {\n159\t\t\t// When specific tools are requested but no toolsets, don't use default toolsets\n160\t\t\t// This matches the original behavior: --tools=X alone registers only X\n161\t\t\treturn []string{}\n162\t\t}\n163\t\n164\t\t// nil means \"use defaults\" in WithToolsets\n165\t\treturn nil\n166\t}\n167\t\n168\tfunc addGitHubAPIErrorToContext(next mcp.MethodHandler) mcp.MethodHandler {\n169\t\treturn func(ctx context.Context, method string, req mcp.Request) (result mcp.Result, err error) {\n170\t\t\t// Ensure the context is cleared of any previous errors\n171\t\t\t// as context isn't propagated through middleware\n172\t\t\tctx = gherrors.ContextWithGitHubErrors(ctx)\n173\t\t\treturn next(ctx, method, req)\n174\t\t}\n175\t}\n176\t\n177\t// NewServer creates a new GitHub MCP server with the given version, server\n178\t// name, display title, and options. If name or title are empty the defaults\n179\t// \"github-mcp-server\" and \"GitHub MCP Server\" are used.\n180\tfunc NewServer(version, name, title string, opts *mcp.ServerOptions) *mcp.Server {\n181\t\tif opts == nil {\n182\t\t\topts = &mcp.ServerOptions{}\n183\t\t}\n184\t\n185\t\tif name == \"\" {\n186\t\t\tname = \"github-mcp-server\"\n187\t\t}\n188\t\tif title == \"\" {\n189\t\t\ttitle = \"GitHub MCP Server\"\n190\t\t}\n191\t\n192\t\t// Create a new MCP server\n193\t\ts := mcp.NewServer(&mcp.Implementation{\n194\t\t\tName:    name,\n195\t\t\tTitle:   title,\n196\t\t\tVersion: version,\n197\t\t\tIcons:   octicons.Icons(\"mark-github\"),\n198\t\t}, opts)\n199\t\n200\t\treturn s\n201\t}\n202\t\n203\tfunc CompletionsHandler(getClient GetClientFn) func(ctx context.Context, req *mcp.CompleteRequest) (*mcp.CompleteResult, error) {\n204\t\treturn func(ctx context.Context, req *mcp.CompleteRequest) (*mcp.CompleteResult, error) {\n205\t\t\tif req == nil || req.Params == nil || req.Params.Ref == nil {\n206\t\t\t\treturn nil, fmt.Errorf(\"missing required parameter: ref\")\n207\t\t\t}\n208\t\t\tswitch req.Params.Ref.Type {\n209\t\t\tcase \"ref/resource\":\n210\t\t\t\tif strings.HasPrefix(req.Params.Ref.URI, \"repo://\") {\n211\t\t\t\t\treturn RepositoryResourceCompletionHandler(getClient)(ctx, req)\n212\t\t\t\t}\n213\t\t\t\treturn nil, fmt.Errorf(\"unsupported resource URI: %s\", req.Params.Ref.URI)\n214\t\t\tcase \"ref/prompt\":\n215\t\t\t\treturn nil, nil\n216\t\t\tdefault:\n217\t\t\t\treturn nil, fmt.Errorf(\"unsupported ref type: %s\", req.Params.Ref.Type)\n218\t\t\t}\n219\t\t}\n220\t}\n221\t\n222\tfunc MarshalledTextResult(v any) *mcp.CallToolResult {\n223\t\tdata, err := json.Marshal(v)\n224\t\tif err != nil {\n225\t\t\treturn utils.NewToolResultErrorFromErr(\"