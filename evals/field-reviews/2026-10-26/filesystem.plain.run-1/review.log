{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgQgQg2svYbfc8a9ekdfN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PAJjcpmtzYuvSxH5yUn5kE","name":"Read","input":{"file_path":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-real-mcp-review-whfddv30/repo/src/fetch/src/mcp_server_fetch/server.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2529,"cache_read_input_tokens":7280,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2529},"output_tokens":46,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2afe1f4d-1d50-43e3-88e9-5da2ff70c42f","uuid":"79f607d2-f2a2-4038-a70f-1319164dfc2e","timestamp":"2026-10-26T10:20:23.106Z","request_id":"req_011CgQgQfg3DPTsNtLkPwLvD","wire_tool_inputs":{"toolu_01PAJjcpmtzYuvSxH5yUn5kE":{"file_path":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-real-mcp-review-whfddv30/repo/src/fetch/src/mcp_server_fetch/server.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PAJjcpmtzYuvSxH5yUn5kE","type":"tool_result","content":"1\t# The fetch MCP server: one `fetch` tool and one `fetch` prompt that retrieve a\n2\t# URL and convert HTML to Markdown for a model. The network policy lives here\n3\t# beside the handlers because every request path (tool, prompt and robots.txt\n4\t# check) must go through it: the private-address guard on each request and\n5\t# redirect hop, robots.txt for autonomous fetches, and proxy normalization.\n6\t#\n7\t# Built on the MCP Python SDK's high-level `MCPServer` (#5174), as the example\n8\t# to follow: the tool and the prompt are plain decorated functions, whose type\n9\t# hints and `Field` descriptions become the input schema and the prompt's\n10\t# arguments, and which the SDK validates before calling. A failure the server\n11\t# anticipated (robots.txt refusal, an unreachable or erroring URL, a private\n12\t# destination, a bad proxy setting) is raised as `ToolError`, which the SDK\n13\t# returns to the model as an `isError` result. A request naming a tool or a\n14\t# prompt the server does not have, or a prompt call without its `url`, is a\n15\t# malformed request, answered with a JSON-RPC `-32602` protocol error by\n16\t# `reject_unknown_names` before `MCPServer` sees it (see there for why).\n17\t# `serve()` serves both protocol eras (#4853): a 2025-11-25 client through the\n18\t# initialize handshake, and a 2026-07-28 client sessionlessly. No handler reads\n19\t# the session or calls back to the client (roots, sampling, elicitation,\n20\t# logging), so nothing differs between them.\n21\t\n22\timport asyncio\n23\timport ipaddress\n24\timport os\n25\timport socket\n26\tfrom collections.abc import Awaitable, Callable, Mapping\n27\tfrom typing import Annotated, Any, Tuple\n28\tfrom importlib.metadata import version\n29\tfrom urllib.parse import urlparse, urlunparse\n30\t\n31\timport httpx\n32\timport markdownify\n33\timport readabilipy.simple_json\n34\tfrom mcp.server import MCPServer, ServerRequestContext\n35\tfrom mcp.server.context import CallNext, HandlerResult, ServerMiddleware\n36\tfrom mcp.server.mcpserver.exceptions import ToolError\n37\tfrom mcp.shared.exceptions import MCPError\n38\tfrom mcp.types import INVALID_PARAMS, ToolAnnotations\n39\tfrom protego import Protego\n40\tfrom pydantic import AnyUrl, Field\n41\t\n42\t# The version this server reports in serverInfo, read from the installed\n43\t# distribution's metadata (pyproject.toml) so it cannot drift from the\n44\t# published version (#360). Without it the SDK reports its own `mcp` version.\n45\tSERVER_VERSION = version(\"mcp-server-fetch\")\n46\t\n47\tDEFAULT_USER_AGENT_AUTONOMOUS = \"ModelContextProtocol/1.0 (Autonomous; +https://github.com/modelcontextprotocol/servers)\"\n48\tDEFAULT_USER_AGENT_MANUAL = \"ModelContextProtocol/1.0 (User-Specified; +https://github.com/modelcontextprotocol/servers)\"\n49\t\n50\t\n51\tasync def _resolve_host(host: str) -> list[str]:\n52\t    \"\"\"Resolve ``host`` to every address the OS would hand the connector.\n53\t\n54\t    getaddrinfo also parses IP literals, including the shorthand forms such as\n55\t    ``2130706433`` and ``127.1`` that a connector accepts as loopback.\n56\t    \"\"\"\n57\t    infos = await asyncio.get_running_loop().getaddrinfo(host, None)\n58\t    return [str(info[4][0]) for info in infos]\n59\t\n60\t\n61\t# IANA special-purpose ranges that are not public destinations. ``is_global``\n62\t# covers most of them, but its tables were corrected only in recent releases\n63\t# (3.13, and patch releases of 3.11 and 3.12: before them 192.0.0.0/24 and\n64\t# 64:ff9b:1::/48, for example, read as global), so the ranges are listed here\n65\t# too, to give the same answer on every supported Python.\n66\t_NON_PUBLIC_NETWORKS = tuple(\n67\t    ipaddress.ip_network(network)\n68\t    for network in (\n69\t        \"0.0.0.0/8\",\n70\t        \"10.0.0.0/8\",\n71\t        \"100.64.0.0/10\",\n72\t        \"127.0.0.0/8\",\n73\t        \"169.254.0.0/16\",\n74\t        \"172.16.0.0/12\",\n75\t        \"192.0.0.0/24\",\n76\t        \"192.0.2.0/24\",\n77\t        \"192.88.99.0/24\",\n78\t        \"192.168.0.0/16\",\n79\t        \"198.18.0.0/15\",\n80\t        \"198.51.100.0/24\",\n81\t        \"203.0.113.0/24\",\n82\t        \"240.0.0.0/4\",\n83\t        \"::/128\",\n84\t        \"::1/128\",\n85\t        \"64:ff9b:1::/48\",\n86\t        \"100::/64\",\n87\t        \"2001::/23\",\n88\t        \"2001:db8::/32\",\n89\t        \"2002::/16\",\n90\t        \"fc00::/7\",\n91\t        \"fe80::/10\",\n92\t    )\n93\t)\n94\t\n95\t\n96\t# Globally reachable assignments inside the ranges above (anycast services\n97\t# and the like), matching the exceptions in current CPython's tables.\n98\t_PUBLIC_EXCEPTIONS = tuple(\n99\t    ipaddress.ip_network(network)\n100\t    for network in (\n101\t        \"192.0.0.9/32\",\n102\t        \"192.0.0.10/32\",\n103\t        \"2001:1::1/128\",\n104\t        \"2001:1::2/128\",\n105\t        \"2001:3::/32\",\n106\t        \"2001:4:112::/48\",\n107\t        \"2001:20::/28\",\n108\t        \"2001:30::/28\",\n109\t    )\n110\t)\n111\t\n112\t\n113\t# The well-known NAT64 prefix (RFC 6052). A NAT64 gateway forwards an address\n114\t# in it to the IPv4 held in its low 32 bits, so that IPv4 is the destination.\n115\t_NAT64_WELL_KNOWN = ipaddress.IPv6Network(\"64:ff9b::/96\")\n116\t\n117\t\n118\tdef _is_public_address(address: str) -> bool:\n119\t    \"\"\"True when ``address`` is a globally routable unicast address.\n120\t\n121\t    Refused: loopback, RFC 1918, link-local (169.254.0.0/16, which holds most\n122\t    cloud metadata endpoints), shared address space (100.64.0.0/10, which holds\n123\t    Alibaba Cloud's 100.100.100.200), unique local IPv6 (AWS's fd00:ec2::254),\n124\t    multicast, unspecified, documentation and other special-purpose ranges.\n125\t    An IPv4-mapped or well-known NAT64 address is judged by the IPv4 it wraps.\n126\t    \"\"\"\n127\t    ip = ipaddress.ip_address(address)\n128\t    if isinstance(ip, ipaddress.IPv6Address) and ip.ipv4_mapped is not None:\n129\t        ip = ip.ipv4_mapped\n130\t    elif isinstance(ip, ipaddress.IPv6Address) and ip in _NAT64_WELL_KNOWN:\n131\t        ip = ipaddress.IPv4Address(int(ip) & 0xFFFFFFFF)\n132\t    if any(ip in network for network in _PUBLIC_EXCEPTIONS):\n133\t        return True\n134\t    if any(ip in network for network in _NON_PUBLIC_NETWORKS):\n135\t        return False\n136\t    return ip.is_global and not ip.is_multicast\n137\t\n138\t\n139\tasync def _refuse_private_destination(request: httpx.Request) -> None:\n140\t    \"\"\"httpx request hook: refuse a request whose host is not a public address.\n141\t\n142\t    httpx runs request hooks before every request it sends, redirect hops\n143\t    included, so a public URL cannot bounce the fetch to an internal one.\n144\t\n145\t    The name checked is ``raw_host``, the ASCII (IDNA 2008) form the transport\n146\t    connects to. ``host`` is the decoded Unicode form, which getaddrinfo would\n147\t    re-encode with IDNA 2003 into a different name for some labels (``ß``\n148\t    becomes ``ss``), so checking it would vet one name and connect to another.\n149\t    \"\"\"\n150\t    host = request.url.raw_host.decode(\"ascii\")\n151\t    if not host:\n152\t        return  # httpx rejects a URL with no host itself.\n153\t    try:\n154\t        addresses = await _resolve_host(host)\n155\t    except socket.gaierror:\n156\t        # Unresolvable here: a direct connection fails on its own, and a proxy\n157\t        # resolves the name on its side.\n158\t        return\n159\t    for address in addresses:\n160\t        if not _is_public_address(address):\n161\t            raise ToolError(\n162\t                f\"Refused to fetch {request.url}: {host} resolves to {address}, \"\n163\t                \"which is not a public address. Start the server with \"\n164\t                \"--allow-private-ips to allow private, loopback and link-local addresses.\"\n165\t            )\n166\t\n167\t\n168\tdef extract_content_from_html(html: str) -> str:\n169\t    \"\"\"Extract and convert HTML content to Markdown format.\n170\t\n171\t    Args:\n172\t        html: Raw HTML content to process\n173\t\n174\t    Returns:\n175\t        Simplified markdown version of the content\n176\t    \"\"\"\n177\t    ret = readabilipy.simple_json.simple_json_from_html_string(\n178\t        html, use_readability=True\n179\t    )\n180\t    failed = \"<error>Page failed to be simplified from HTML</error>\"\n181\t    if not ret[\"content\"]:\n182\t        return failed\n183\t    content = markdownify.markdownify(\n184\t        ret[\"content\"],\n185\t        heading_style=markdownify.ATX,\n186\t    )\n187\t    # Without Node, readabilipy's pure-Python extractor never returns empty\n188\t    # content: an empty page comes back as \"<div></div>\", which converts to an\n189\t    # empty string. Report that as the same simplification failure the Node\n190\t    # path reports, rather than letting it reach pagination as an exhausted page.\n191\t    if not content.strip():\n192\t        return failed\n193\t    return content\n194\t\n195\t\n196\tdef get_robots_txt_url(url: str) -> str:\n197\t    \"\"\"Get the robots.txt URL for a given website URL.\n198\t\n199\t    Args:\n200\t        url: Website URL to get robots.txt for\n201\t\n202\t    Returns:\n203\t        URL of the robots.txt file\n204\t    \"\"\"\n205\t    # Parse the URL into components\n206\t    parsed = urlparse(url)\n207\t\n208\t    # Reconstruct the base URL with just scheme, netloc, and /robots.txt path\n209\t    robots_url = urlunparse((parsed.scheme, parsed.netloc, \"/robots.txt\", \"\", \"\", \"\"))\n210\t\n211\t    return robots_url\n212\t\n213\t\n214\tPROXY_ENV_VARS = (\n215\t    \"HTTP_PROXY\",\n216\t    \"http_proxy\",\n217\t    \"HTTPS_PROXY\",\n218\t    \"https_proxy\",\n219\t    \"ALL_PROXY\",\n220\t    \"all_proxy\",\n221\t)\n222\t\n223\t\n224\tdef normalize_proxy_url(proxy_url: str) -> str:\n225\t    \"\"\"Rewrite the ``socks://`` alias, which httpx rejects, to ``socks5://``.\n226\t\n227\t    Desktop proxy settings often export ``socks://host:port``; httpx only\n228\t    accepts ``socks5://``. Every other value is returned unchanged.\n229\t    \"\"\"\n230\t    if proxy_url.lower().startswith(\"socks://\"):\n231\t        return \"socks5://\" + proxy_url[len(\"socks://\") :]\n232\t    return proxy_url\n233\t\n234\t\n235\tdef normalize_proxy_env() -> None:\n236\t    \"\"\"Apply ``normalize_proxy_url`` to the proxy variables httpx reads.\"\"\"\n237\t    for name in PROXY_ENV_VARS:\n238\t        value = os.environ.get(name)\n239\t        if value:\n240\t            os.environ[name] = normalize_proxy_url(value)\n241\t\n242\t\n243\tdef make_client(proxy_url: str | None) -> httpx.AsyncClient:\n244\t    \"\"\"Build the httpx client, turning a bad proxy setting into a ``ToolError``.\n245\t\n246\t    httpx validates the proxy (``--proxy-url`` or the proxy environment\n247\t    variables) when the client is constructed, before any request, so this\n248\t    failure is not an ``HTTPError``.\n249\t    \"\"\"\n250\t    try:\n251\t        return httpx.AsyncClient(proxy=proxy_url)\n252\t    except (ValueError, ImportError) as e:\n253\t        raise ToolError(\n254\t            f\"Failed to set up the HTTP client, check the proxy \"\n255\t            f\"configuration (--proxy-url or the HTTP_PROXY, HTTPS_PROXY and \"\n256\t            f\"ALL_PROXY environment variables): {e}\"\n257\t        )\n258\t\n259\t\n260\tasync def check_may_autonomously_fetch_url(\n261\t    url: str,\n262\t    user_agent: str,\n263\t    proxy_url: str | None = None,\n264\t    allow_private_ips: bool = False,\n265\t) -> None:\n266\t    \"\"\"\n267\t    Check if the URL can be fetched by the user agent according to the robots.txt file.\n268\t    Raises a ToolError if not.\n269\t    \"\"\"\n270\t    from httpx import HTTPError\n271\t\n272\t    robot_txt_url = get_robots_txt_url(url)\n273\t\n274\t    async with make_client(proxy_url) as client:\n275\t        if not allow_private_ips:\n276\t            client.event_hooks = {\"request\": [_refuse_private_destination]}\n277\t        try:\n278\t            response = await client.get(\n279\t                robot_txt_url,\n280\t                follow_redirects=True,\n281\t                headers={\"User-Agent\": user_agent},\n282\t            )\n283\t        except HTTPError:\n284\t            raise ToolError(\n285\t                f\"Failed to fetch robots.txt {robot_txt_url} due to a connection issue\"\n286\t            )\n287\t        if response.status_code in (401, 403):\n288\t            raise ToolError(\n289\t                f\"When fetching robots.txt ({robot_txt_url}), received status {response.status_code} so assuming that autonomous fetching is not allowed, the user can try manually fetching by using the fetch prompt\"\n290\t            )\n291\t        elif 400 <= response.status_code < 500:\n292\t            return\n293\t        robot_txt = response.text\n294\t    processed_robot_txt = \"\\n\".join(\n295\t        line for line in robot_txt.splitlines() if not line.strip().startswith(\"#\")\n296\t    )\n297\t    robot_parser = Protego.parse(processed_robot_txt)\n298\t    if not robot_parser.can_fetch(str(url), user_agent):\n299\t        raise ToolError(\n300\t            f\"The sites robots.txt ({robot_txt_url}), specifies that autonomous fetching of this page is not allowed, \"\n301\t            f\"<useragent>{user_agent}</useragent>\\n\"\n302\t            f\"<url>{url}</url>\"\n303\t            f\"<robots>\\n{robot_txt}\\n</robots>\\n\"\n304\t            f\"The assistant must let the user know that it failed to view the page. The assistant may provide further guidance based on the above information.\\n\"\n305\t            f\"The assistant can tell the user that they can try manually fetching the page by using the fetch prompt within their UI.\"\n306\t        )\n307\t\n308\t\n309\tasync def fetch_url(\n310\t    url: str,\n311\t    user_agent: str,\n312\t    force_raw: bool = False,\n313\t    proxy_url: str | None = None,\n314\t    allow_private_ips: bool = False,\n315\t    check_robots_txt: bool = False,\n316\t) -> Tuple[str, str]:\n317\t    \"\"\"\n318\t    Fetch the URL and return the content in a form ready for the LLM, as well as a prefix string with status information.\n319\t\n320\t    With ``check_robots_txt``, every redirect hop is checked against the\n321\t    robots.txt of its own origin before it is requested. The caller has\n322\t    already checked the requested URL itself.\n323\t    \"\"\"\n324\t    from httpx import HTTPError\n325\t\n326\t    seen_first_request = False\n327\t\n328\t    async def _check_redirect_robots_txt(request: httpx.Request) -> None:\n329\t        # httpx runs request hooks before each request, redirect hops included.\n330\t        nonlocal seen_first_request\n331\t        if not seen_first_request:\n332\t            seen_first_request = True\n333\t            return\n334\t        await check_may_autonomously_fetch_url(\n335\t            str(request.url), user_agent, proxy_url, allow_private_ips\n336\t        )\n337\t\n338\t    async with make_client(proxy_url) as client:\n339\t        hooks: list[Callable[[httpx.Request], Awaitable[None]]] = []\n340\t        if not allow_private_ips:\n341\t            hooks.append(_refuse_private_destination)\n342\t        if check_robots_txt:\n343\t            hooks.append(_check_redirect_robots_txt)\n344\t        if hooks:\n345\t            client.event_hooks = {\"request\": hooks}\n346\t        try:\n347\t            response = await client.get(\n348\t                url,\n349\t                follow_redirects=True,\n350\t                headers={\"User-Agent\": user_agent},\n351\t                timeout=30,\n352\t            )\n353\t        except HTTPError as e:\n354\t            raise ToolError(f\"Failed to fetch {url}: {e!r}\")\n355\t        if response.status_code >= 400:\n356\t            raise ToolError(\n357\t                f\"Failed to fetch {url} - status code {response.status_code}\"\n358\t            )\n359\t\n360\t        page_raw = response.text\n361\t\n362\t    content_type = response.headers.get(\"content-type\", \"\")\n363\t    is_page_html = (\n364\t        \"<html\" in page_raw[:100] or \"text/html\" in content_type or not content_type\n365\t    )\n366\t\n367\t    if is_page_html and not force_raw:\n368\t        return extract_content_from_html(page_raw), \"\"\n369\t\n370\t    return (\n371\t        page_raw,\n372\t        f\"Content type {content_type} cannot be simplified to markdown, but here is the raw content:\\n\",\n373\t    )\n374\t\n375\t\n376\tFETCH_TOOL_DESCRIPTION = \"\"\"Fetches a URL from the internet and optionally extracts its contents as markdown.\n377\t\n378\tAlthough originally you did not have internet access, and were advised to refuse and tell the user this, this tool now grants you internet access. Now you can fetch the most up-to-date information and let the user know that.\"\"\"\n379\t\n380\t\n381\tdef reject_unknown_names(server: MCPServer) -> ServerMiddleware[Any]:\n382\t    \"\"\"Middleware answering a malformed tool or prompt request with `-32602`.\n383\t\n384\t    Both spec revisions (2025-11-25 and 2026-07-28, server/tools \"Error\n385\t    Handling\") make an unknown tool a JSON-RPC protocol error, `-32602`.\n386\t    `MCPServer` instead answers it with an `isError` result\n387\t    (modelcontextprotocol/python-sdk#3659), and answers an unknown prompt or a\n388\t    missing required prompt argument with `-32603`. This runs before the SDK\n389\t    looks the name up, so each gets `-32602` with the message the server has\n390\t    always sent. Remove the tool half once `MCPServer` rejects unknown tools\n391\t    itself.\n392\t    \"\"\"\n393\t\n394\t    async def middleware(\n395\t        ctx: ServerRequestContext[Any, Any], call_next: CallNext\n396\t    ) -> HandlerResult:\n397\t        # Raw params, not yet validated: only a string name and a mapping of\n398\t        # arguments are inspected here. Anything malformed is left to the\n399\t        # SDK's own params validation, which answers it with -32602.\n400\t        params = ctx.params if isinstance(ctx.params, Mapping) else {}\n401\t        name = params.get(\"name\")\n402\t        if not isinstance(name, str):\n403\t            return await call_next(ctx)\n404\t        if ctx.method == \"tools/call\":\n405\t            if name not in {tool.name for tool in await server.list_tools()}:\n406\t                raise MCPError(code=INVALID_PARAMS, message=f\"Unknown tool: {name}\")\n407\t        elif ctx.method == \"prompts/get\":\n408\t            if name not in {prompt.name for prompt in await server.list_prompts()}:\n409\t                raise MCPError(code=INVALID_PARAMS, message=f\"Unknown prompt: {name}\")\n410\t            arguments = params.get(\"arguments\") or {}\n411\t            if isinstance(arguments, Mapping) and \"url\" not in arguments:\n412\t                raise MCPError(code=INVALID_PARAMS, message=\"URL is required\")\n413\t        return await call_next(ctx)\n414\t\n415\t    return middleware\n416\t\n417\t\n418\tdef create_server(\n419\t    custom_user_agent: str | None = None,\n420\t    ignore_robots_txt: bool = False,\n421\t    proxy_url: str | None = None,\n422\t    allow_private_ips: bool = False,\n423\t) -> MCPServer:\n424\t    \"\"\"Build the fetch server: the `fetch` tool, the `fetch` prompt, and the guard.\n425\t\n426\t    Args mirror `serve()`'s.\n427\t    \"\"\"\n428\t    if proxy_url:\n429\t        proxy_url = normalize_proxy_url(proxy_url)\n430\t    normalize_proxy_env()\n431\t    user_agent_autonomous = custom_user_agent or DEFAULT_USER_AGENT_AUTONOMOUS\n432\t    user_agent_manual = custom_user_agent or DEFAULT_USER_AGENT_MANUAL\n433\t\n434\t    # subscriptions=False: the tool and prompt lists never change and there are\n435\t    # no resources to watch, so `subscriptions/listen` is not served and the\n436\t    # 2026-07-28 capabilities say `listChanged: false`.\n437\t    server = MCPServer(\"mcp-fetch\", version=SERVER_VERSION, subscriptions=False)\n438\t    server.middleware.append(reject_unknown_names(server))\n439\t\n440\t    @server.tool(\n441\t        name=\"fetch\",\n442\t        description=FETCH_TOOL_DESCRIPTION,\n443\t        # Reads only, changes nothing, and repeating a request has no further\n444\t        # side effect; it reaches arbitrary hosts on the internet (#3572).\n445\t        annotations=ToolAnnotations(\n446\t            read_only_hint=True,\n447\t            destructive_hint=False,\n448\t            idempotent_hint=True,\n449\t            open_world_hint=True,\n450\t        ),\n451\t        # The result is page text for the model, so no outputSchema.\n452\t        structured_output=False,\n453\t    )\n454\t    # strict=True: pydantic would otherwise coerce \"yes\" to True or \"10\" to 10,\n455\t    # accepting arguments the advertised inputSchema rejects.\n456\t    async def fetch(\n457\t        url: Annotated[AnyUrl, Field(description=\"URL to fetch\")],\n458\t        max_length: Annotated[\n459\t            int,\n460\t            Field(\n461\t                description=\"Maximum number of characters to return.\",\n462\t                # ge/le rather than gt/lt: the inclusive bounds emit\n463\t                # minimum/maximum, which every client accepts, while\n464\t                # exclusiveMinimum/exclusiveMaximum are rejected by some\n465\t                # (Gemini, #1624). Same range for an int.\n466\t                ge=1,\n467\t                le=999999,\n468\t                strict=True,\n469\t            ),\n470\t        ] = 5000,\n471\t        start_index: Annotated[\n472\t            int,\n473\t            Field(\n474\t                description=\"On return output starting at this character index, useful if a previous fetch was truncated and more context is required.\",\n475\t                ge=0,\n476\t                strict=True,\n477\t            ),\n478\t        ] = 0,\n479\t        raw: Annotated[\n480\t            bool,\n481\t            Field(\n482\t                description=\"Get the actual HTML content of the requested page, without simplification.\",\n483\t                strict=True,\n484\t            ),\n485\t        ] = False,\n486\t    ) -> str:\n487\t        page_url = str(url)\n488\t\n489\t        if not ignore_robots_txt:\n490\t            await check_may_autonomously_fetch_url(\n491\t                page_url, user_agent_autonomous, proxy_url, allow_private_ips\n492\t            )\n493\t\n494\t        content, prefix = await fetch_url(\n495\t            page_url,\n496\t            user_agent_autonomous,\n497\t            force_raw=raw,\n498\t            proxy_url=proxy_url,\n499\t            allow_private_ips=allow_private_ips,\n500\t            check_robots_txt=not ignore_robots_txt,\n501\t        )\n502\t        original_length = len(content)\n503\t        if start_index >= original_length:\n504\t            content = \"<error>No more content available.</error>\"\n505\t        else:\n506\t            # Never empty: start_index < original_length and max_length > 0.\n507\t            truncated_content = content[start_index : start_index + max_length]\n508\t            content = truncated_content\n509\t            actual_content_length = len(truncated_content)\n510\t            remaining_content = original_length - (start_index + actual_content_length)\n511\t            # Only add the prompt to continue fetching if there is still remaining content\n512\t            if actual_content_length == max_length and remaining_content > 0:\n513\t                next_start = start_index + actual_content_length\n514\t                content += f\"\\n\\n<error>Content truncated. Call the fetch tool with a start_index of {next_start} to get more content.</error>\"\n515\t        return f\"{prefix}Contents of {page_url}:\\n{content}\"\n516\t\n517\t    @server.prompt(\n518\t        name=\"fetch\",\n519\t        description=\"Fetch a URL and extract its contents as markdown\",\n520\t    )\n521\t    async def fetch_prompt(\n522\t        url: Annotated[str, Field(description=\"URL to fetch\")],\n523\t    ) -> str:\n524\t        # The user asked for this page, so robots.txt is not consulted, and a\n525\t        # failure is shown to them as the prompt's text rather than raised.\n526\t        try:\n527\t            content, prefix = await fetch_url(\n528\t                url,\n529\t                user_agent_manual,\n530\t                proxy_url=proxy_url,\n531\t                allow_private_ips=allow_private_ips,\n532\t            )\n533\t        except ToolError as e:\n534\t            return str(e)\n535\t        return prefix + content\n536\t\n537\t    return server\n538\t\n539\t\n540\tasync def serve(\n541\t    custom_user_agent: str | None = None,\n542\t    ignore_robots_txt: bool = False,\n543\t    proxy_url: str | None = None,\n544\t    allow_private_ips: bool = False,\n545\t) -> None:\n546\t    \"\"\"Run the fetch MCP server over stdio.\n547\t\n548\t    Args:\n549\t        custom_user_agent: Optional custom User-Agent string to use for requests\n550\t        ignore_robots_txt: Whether to ignore robots.txt restrictions\n551\t        proxy_url: Optional proxy URL to use for requests\n552\t        allow_private_ips: Allow fetching private, loopback and link-local\n553\t            addresses, which are refused by default\n554\t    \"\"\"\n555\t    server = create_server(\n556\t        custom_user_agent, ignore_robots_txt, proxy_url, allow_private_ips\n557\t    )\n558\t    # Both eras (#4853): the SDK's dual-era loop lets the client's first\n559\t    # request decide. `initialize` gets the 2025-11-25 handshake;\n560\t    # `server/discover` or a request carrying a 2026-07-28 envelope gets the\n561\t    # modern, sessionless era, with its required result fields (resultType,\n562\t    # ttlMs, cacheScope) filled in by the SDK.\n563\t    await server.run_stdio_async()\n564\t"}]},"parent_tool_use_id":null,"session_id":"2afe1f4d-1d50-43e3-88e9-5da2ff70c42f","uuid":"d8cfac28-ae14-4ec0-90e5-3083d1c9997d","timestamp":"2026-10-26T10:20:23.114Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-real-mcp-review-whfddv30/repo/src/fetch/src/mcp_server_fetch/server.py","content":"# The fetch MCP server: one `fetch` tool and one `fetch` prompt that retrieve a\n# URL and convert HTML to Markdown for a model. The network policy lives here\n# beside the handlers because every request path (tool, prompt and robots.txt\n# check) must go through it: the private-address guard on each request and\n# redirect hop, robots.txt for autonomous fetches, and proxy normalization.\n#\n# Built on the MCP Python SDK's high-level `MCPServer` (#5174), as the example\n# to follow: the tool and the prompt are plain decorated functions, whose type\n# hints and `Field` descriptions become the input schema and the prompt's\n# arguments, and which the SDK validates before calling. A failure the server\n# anticipated (robots.txt refusal, an unreachable or erroring URL, a private\n# destination, a bad proxy setting) is raised as `ToolError`, which the SDK\n# returns to the model as an `isError` result. A request naming a tool or a\n# prompt the server does not have, or a prompt call without its `url`, is a\n# malformed request, answered with a JSON-RPC `-32602` protocol error by\n# `reject_unknown_names` before `MCPServer` sees it (see there for why).\n# `serve()` serves both protocol eras (#4853): a 2025-11-25 client through the\n# initialize handshake, and a 2026-07-28 client sessionlessly. No handler reads\n# the session or calls back to the client (roots, sampling, elicitation,\n# logging), so nothing differs between them.\n\nimport asyncio\nimport ipaddress\nimport os\nimport socket\nfrom collections.abc import Awaitable, Callable, Mapping\nfrom typing import Annotated, Any, Tuple\nfrom importlib.metadata import version\nfrom urllib.parse import urlparse, urlunparse\n\nimport httpx\nimport markdownify\nimport readabilipy.simple_json\nfrom mcp.server import MCPServer, ServerRequestContext\nfrom mcp.server.context import CallNext, HandlerResult, ServerMiddleware\nfrom mcp.server.mcpserver.exceptions import ToolError\nfrom mcp.shared.exceptions import MCPError\nfrom mcp.types import INVALID_PARAMS, ToolAnnotations\nfrom protego import Protego\nfrom pydantic import AnyUrl, Field\n\n# The version this server reports in serverInfo, read from the installed\n# distribution's metadata (pyproject.toml) so it cannot drift from the\n# published version (#360). Without it the SDK reports its own `mcp` version.\nSERVER_VERSION = version(\"mcp-server-fetch\")\n\nDEFAULT_USER_AGENT_AUTONOMOUS = \"ModelContextProtocol/1.0 (Autonomous; +https://github.com/modelcontextprotocol/servers)\"\nDEFAULT_USER_AGENT_MANUAL = \"ModelContextProtocol/1.0 (User-Specified; +https://github.com/modelcontextprotocol/servers)\"\n\n\nasync def _resolve_host(host: str) -> list[str]:\n    \"\"\"Resolve ``host`` to every address the OS would hand the connector.\n\n    getaddrinfo also parses IP literals, including the shorthand forms such as\n    ``2130706433`` and ``127.1`` that a connector accepts as loopback.\n    \"\"\"\n    infos = await asyncio.get_running_loop().getaddrinfo(host, None)\n    return [str(info[4][0]) for info in infos]\n\n\n# IANA special-purpose ranges that are not public destinations. ``is_global``\n# covers most of them, but its tables were corrected only in recent releases\n# (3.13, and patch releases of 3.11 and 3.12: before them 192.0.0.0/24 and\n# 64:ff9b:1::/48, for example, read as global), so the ranges are listed here\n# too, to give the same answer on every supported Python.\n_NON_PUBLIC_NETWORKS = tuple(\n    ipaddress.ip_network(network)\n    for network in (\n        \"0.0.0.0/8\",\n        \"10.0.0.0/8\",\n        \"100.64.0.0/10\",\n        \"127.0.0.0/8\",\n        \"169.254.0.0/16\",\n        \"172.16.0.0/12\",\n        \"192.0.0.0/24\",\n        \"192.0.2.0/24\",\n        \"192.88.99.0/24\",\n        \"192.168.0.0/16\",\n        \"198.18.0.0/15\",\n        \"198.51.100.0/24\",\n        \"203.0.113.0/24\",\n        \"240.0.0.0/4\",\n        \"::/128\",\n        \"::1/128\",\n        \"64:ff9b:1::/48\",\n        \"100::/64\",\n        \"2001::/23\",\n        \"2001:db8::/32\",\n        \"2002::/16\",\n        \"fc00::/7\",\n        \"fe80::/10\",\n    )\n)\n\n\n# Globally reachable assignments inside the ranges above (anycast services\n# and the like), matching the exceptions in current CPython's tables.\n_PUBLIC_EXCEPTIONS = tuple(\n    ipaddress.ip_network(network)\n    for network in (\n        \"192.0.0.9/32\",\n        \"192.0.0.10/32\",\n        \"2001:1::1/128\",\n        \"2001:1::2/128\",\n        \"2001:3::/32\",\n        \"2001:4:112::/48\",\n        \"2001:20::/28\",\n        \"2001:30::/28\",\n    )\n)\n\n\n# The well-known NAT64 prefix (RFC 6052). A NAT64 gateway forwards an address\n# in it to the IPv4 held in its low 32 bits, so that IPv4 is the destination.\n_NAT64_WELL_KNOWN = ipaddress.IPv6Network(\"64:ff9b::/96\")\n\n\ndef _is_public_address(address: str) -> bool:\n    \"\"\"True when ``address`` is a globally routable unicast address.\n\n    Refused: loopback, RFC 1918, link-local (169.254.0.0/16, which holds most\n    cloud metadata endpoints), shared address space (100.64.0.0/10, which holds\n    Alibaba Cloud's 100.100.100.200), unique local IPv6 (AWS's fd00:ec2::254),\n    multicast, unspecified, documentation and other special-purpose ranges.\n    An IPv4-mapped or well-known NAT64 address is judged by the IPv4 it wraps.\n    \"\"\"\n    ip = ipaddress.ip_address(address)\n    if isinstance(ip, ipaddress.IPv6Address) and ip.ipv4_mapped is not None:\n        ip = ip.ipv4_mapped\n    elif isinstance(ip, ipaddress.IPv6Address) and ip in _NAT64_WELL_KNOWN:\n        ip = ipaddress.IPv4Address(int(ip) & 0xFFFFFFFF)\n    if any(ip in network for network in _PUBLIC_EXCEPTIONS):\n        return True\n    if any(ip in network for network in _NON_PUBLIC_NETWORKS):\n        return False\n    return ip.is_global and not ip.is_multicast\n\n\nasync def _refuse_private_destination(request: httpx.Request) -> None:\n    \"\"\"httpx request hook: refuse a request whose host is not a public address.\n\n    httpx runs request hooks before every request it sends, redirect hops\n    included, so a public URL cannot bounce the fetch to an internal one.\n\n    The name checked is ``raw_host``, the ASCII (IDNA 2008) form the transport\n    connects to. ``host`` is the decoded Unicode form, which getaddrinfo would\n    re-encode with IDNA 2003 into a different name for some labels (``ß``\n    becomes ``ss``), so checking it would vet one name and connect to another.\n    \"\"\"\n    host = request.url.raw_host.decode(\"ascii\")\n    if not host:\n        return  # httpx rejects a URL with no host itself.\n    try:\n        addresses = await _resolve_host(host)\n    except socket.gaierror:\n        # Unresolvable here: a direct connection fails on its own, and a proxy\n        # resolves the name on its side.\n        return\n    for address in addresses:\n        if not _is_public_address(address):\n            raise ToolError(\n                f\"Refused to fetch {request.url}: {host} resolves to {address}, \"\n                \"which is not a public address. Start the server with \"\n                \"--allow-private-ips to allow private, loopback and link-local addresses.\"\n            )\n\n\ndef extract_content_from_html(html: str) -> str:\n    \"\"\"Extract and convert HTML content to Markdown format.\n\n    Args:\n        html: Raw HTML content to process\n\n    Returns:\n        Simplified markdown version of the content\n    \"\"\"\n    ret = readabilipy.simple_json.simple_json_from_html_string(\n        html, use_readability=True\n    )\n    failed = \"<error>Page failed to be simplified from HTML</error>\"\n    if not ret[\"content\"]:\n        return failed\n    content = markdownify.markdownify(\n        ret[\"content\"],\n        heading_style=markdownify.ATX,\n    )\n    # Without Node, readabilipy's pure-Python extractor never returns empty\n    # content: an empty page comes back as \"<div></div>\", which converts to an\n    # empty string. Report that as the same simplification failure the Node\n    # path reports, rather than letting it reach pagination as an exhausted page.\n    if not content.strip():\n        return failed\n    return content\n\n\ndef get_robots_txt_url(url: str) -> str:\n    \"\"\"Get the robots.txt URL for a given website URL.\n\n    Args:\n        url: Website URL to get robots.txt for\n\n    Returns:\n        URL of the robots.txt file\n    \"\"\"\n    # Parse the URL into components\n    parsed = urlparse(url)\n\n    # Reconstruct the base URL with just scheme, netloc, and /robots.txt path\n    robots_url = urlunparse((parsed.scheme, parsed.netloc, \"/robots.txt\", \"\", \"\", \"\"))\n\n    return robots_url\n\n\nPROXY_ENV_VARS = (\n    \"HTTP_PROXY\",\n    \"http_proxy\",\n    \"HTTPS_PROXY\",\n    \"https_proxy\",\n    \"ALL_PROXY\",\n    \"all_proxy\",\n)\n\n\ndef normalize_proxy_url(proxy_url: str) -> str:\n    \"\"\"Rewrite the ``socks://`` alias, which httpx rejects, to ``socks5://``.\n\n    Desktop proxy settings often export ``socks://host:port``; httpx only\n    accepts ``socks5://``. Every other value is returned unchanged.\n    \"\"\"\n    if proxy_url.lower().startswith(\"socks://\"):\n        return \"socks5://\" + proxy_url[len(\"socks://\") :]\n    return proxy_url\n\n\ndef normalize_proxy_env() -> None:\n    \"\"\"Apply ``normalize_proxy_url`` to the proxy variables httpx reads.\"\"\"\n    for name in PROXY_ENV_VARS:\n        value = os.environ.get(name)\n        if value:\n            os.environ[name] = normalize_proxy_url(value)\n\n\ndef make_client(proxy_url: str | None) -> httpx.AsyncClient:\n    \"\"\"Build the httpx client, turning a bad proxy setting into a ``ToolError``.\n\n    httpx validates the proxy (``--proxy-url`` or the proxy environment\n    variables) when the client is constructed, before any request, so this\n    failure is not an ``HTTPError``.\n    \"\"\"\n    try:\n        return httpx.AsyncClient(proxy=proxy_url)\n    except (ValueError, ImportError) as e:\n        raise ToolError(\n            f\"Failed to set up the HTTP client, check the proxy \"\n            f\"configuration (--proxy-url or the HTTP_PROXY, HTTPS_PROXY and \"\n            f\"ALL_PROXY environment variables): {e}\"\n        )\n\n\nasync def check_may_autonomously_fetch_url(\n    url: str,\n    user_agent: str,\n    proxy_url: str | None = None,\n    allow_private_ips: bool = False,\n) -> None:\n    \"\"\"\n    Check if the URL can be fetched by the user agent according to the robots.txt file.\n    Raises a ToolError if not.\n    \"\"\"\n    from httpx import HTTPError\n\n    robot_txt_url = get_robots_txt_url(url)\n\n    async with make_client(proxy_url) as client:\n        if not allow_private_ips:\n            client.event_hooks = {\"request\": [_refuse_private_destination]}\n        try:\n            response = await client.get(\n                robot_txt_url,\n                follow_redirects=True,\n                headers={\"User-Agent\": user_agent},\n            )\n        except HTTPError:\n            raise ToolError(\n                f\"Failed to fetch robots.txt {robot_txt_url} due to a connection issue\"\n            )\n        if response.status_code in (401, 403):\n            raise ToolError(\n                f\"When fetching robots.txt ({robot_txt_url}), received status {response.status_code} so assuming that autonomous fetching is not allowed, the user can try manually fetching by using the fetch prompt\"\n            )\n        elif 400 <= response.status_code < 500:\n            return\n        robot_txt = response.text\n    processed_robot_txt = \"\\n\".join(\n        line for line in robot_txt.splitlines() if not line.strip().startswith(\"#\")\n    )\n    robot_parser = Protego.parse(processed_robot_txt)\n    if not robot_parser.can_fetch(str(url), user_agent):\n        raise ToolError(\n            f\"The sites robots.txt ({robot_txt_url}), specifies that autonomous fetching of this page is not allowed, \"\n            f\"<useragent>{user_agent}</useragent>\\n\"\n            f\"<url>{url}</url>\"\n            f\"<robots>\\n{robot_txt}\\n</robots>\\n\"\n            f\"The assistant must let the user know that it failed to view the page. The assistant may provide further guidance based on the above information.\\n\"\n            f\"The assistant can tell the user that they can try manually fetching the page by using the fetch prompt within their UI.\"\n        )\n\n\nasync def fetch_url(\n    url: str,\n    user_agent: str,\n    force_raw: bool = False,\n    proxy_url: str | None = None,\n    allow_private_ips: bool = False,\n    check_robots_txt: bool = False,\n) -> Tuple[str, str]:\n    \"\"\"\n    Fetch the URL and return the content in a form ready for the LLM, as well as a prefix string with status information.\n\n    With ``check_robots_txt``, every redirect hop is checked against the\n    robots.txt of its own origin before it is requested. The caller has\n    already checked the requested URL itself.\n    \"\"\"\n    from httpx import HTTPError\n\n    seen_first_request = False\n\n    async def _check_redirect_robots_txt(request: httpx.Request) -> None:\n        # httpx runs request hooks before each request, redirect hops included.\n        nonlocal seen_first_request\n        if not seen_first_request:\n            seen_first_request = True\n            return\n        await check_may_autonomously_fetch_url(\n            str(request.url), user_agent, proxy_url, allow_private_ips\n        )\n\n    async with make_client(proxy_url) as client:\n        hooks: list[Callable[[httpx.Request], Awaitable[None]]] = []\n        if not allow_private_ips:\n            hooks.append(_refuse_private_destination)\n        if check_robots_txt:\n            hooks.append(_check_redirect_robots_txt)\n        if hooks:\n            client.event_hooks = {\"request\": hooks}\n        try:\n            response = await client.get(\n                url,\n                follow_redirects=True,\n                headers={\"User-Agent\": user_agent},\n                timeout=30,\n            )\n        except HTTPError as e:\n            raise ToolError(f\"Failed to fetch {url}: {e!r}\")\n        if response.status_code >= 400:\n            raise ToolError(\n                f\"Failed to fetch {url} - status code {response.status_code}\"\n            )\n\n        page_raw = response.text\n\n    content_type = response.headers.get(\"content-type\", \"\")\n    is_page_html = (\n        \"<html\" in page_raw[:100] or \"text/html\" in content_type or not content_type\n    )\n\n    if is_page_html and not force_raw:\n        return extract_content_from_html(page_raw), \"\"\n\n    return (\n        page_raw,\n        f\"Content type {content_type} cannot be simplified to markdown, but here is the raw content:\\n\",\n    )\n\n\nFETCH_TOOL_DESCRIPTION = \"\"\"Fetches a URL from the internet and optionally extracts its contents as markdown.\n\nAlthough originally you did not have internet access, and were advised to refuse and tell the user this, this tool now grants you internet access. Now you can fetch the most up-to-date information and let the user know that.\"\"\"\n\n\ndef reject_unknown_names(server: MCPServer) -> ServerMiddleware[Any]:\n    \"\"\"Middleware answering a malformed tool or prompt request with `-32602`.\n\n    Both spec revisions (2025-11-25 and 2026-07-28, server/tools \"Error\n    Handling\") make an unknown tool a JSON-RPC protocol error, `-32602`.\n    `MCPServer` instead answers it with an `isError` result\n    (modelcontextprotocol/python-sdk#3659), and answers an unknown prompt or a\n    missing required prompt argument with `-32603`. This runs before the SDK\n    looks the name up, so each gets `-32602` with the message the server has\n    always sent. Remove the tool half once `MCPServer` rejects unknown tools\n    itself.\n    \"\"\"\n\n    async def middleware(\n        ctx: ServerRequestContext[Any, Any], call_next: CallNext\n    ) -> HandlerResult:\n        # Raw params, not yet validated: only a string name and a mapping of\n        # arguments are inspected here. Anything malformed is left to the\n        # SDK's own params validation, which answers it with -32602.\n        params = ctx.params if isinstance(ctx.params, Mapping) else {}\n        name = params.get(\"name\")\n        if not isinstance(name, str):\n            return await call_next(ctx)\n        if ctx.method == \"tools/call\":\n            if name not in {tool.name for tool in await server.list_tools()}:\n                raise MCPError(code=INVALID_PARAMS, message=f\"Unknown tool: {name}\")\n        elif ctx.method == \"prompts/get\":\n            if name not in {prompt.name for prompt in await server.list_prompts()}:\n                raise MCPError(code=INVALID_PARAMS, message=f\"Unknown prompt: {name}\")\n            arguments = params.get(\"arguments\") or {}\n            if isinstance(arguments, Mapping) and \"url\" not in arguments:\n                raise MCPError(code=INVALID_PARAMS, message=\"URL is required\")\n        return await call_next(ctx)\n\n    return middleware\n\n\ndef create_server(\n    custom_user_agent: str | None = None,\n    ignore_robots_txt: bool = False,\n    proxy_url: str | None = None,\n    allow_private_ips: bool = False,\n) -> MCPServer:\n    \"\"\"Build the fetch server: the `fetch` tool, the `fetch` prompt, and the guard.\n\n    Args mirror `serve()`'s.\n    \"\"\"\n    if proxy_url:\n        proxy_url = normalize_proxy_url(proxy_url)\n    normalize_proxy_env()\n    user_agent_autonomous = custom_user_agent or DEFAULT_USER_AGENT_AUTONOMOUS\n    user_agent_manual = custom_user_agent or DEFAULT_USER_AGENT_MANUAL\n\n    # subscriptions=False: the tool and prompt lists never change and there are\n    # no resources to watch, so `subscriptions/listen` is not served and the\n    # 2026-07-28 capabilities say `listChanged: false`.\n    server = MCPServer(\"mcp-fetch\", version=SERVER_VERSION, subscriptions=False)\n    server.middleware.append(reject_unknown_names(server))\n\n    @server.tool(\n        name=\"fetch\",\n        description=FETCH_TOOL_DESCRIPTION,\n        # Reads only, changes nothing, and repeating a request has no further\n        # side effect; it reaches arbitrary hosts on the internet (#3572).\n        annotations=ToolAnnotations(\n            read_only_hint=True,\n            destructive_hint=False,\n            idempotent_hint=True,\n            open_world_hint=True,\n        ),\n        # The result is page text for the model, so no outputSchema.\n        structured_output=False,\n    )\n    # strict=True: pydantic would otherwise coerce \"yes\" to True or \"10\" to 10,\n    # accepting arguments the advertised inputSchema rejects.\n    async def fetch(\n        url: Annotated[AnyUrl, Field(description=\"URL to fetch\")],\n        max_length: Annotated[\n            int,\n            Field(\n                description=\"Maximum number of characters to return.\",\n                # ge/le rather than gt/lt: the inclusive bounds emit\n                # minimum/maximum, which every client accepts, while\n                # exclusiveMinimum/exclusiveMaximum are rejected by some\n                # (Gemini, #1624). Same range for an int.\n                ge=1,\n                le=999999,\n                strict=True,\n            ),\n        ] = 5000,\n        start_index: Annotated[\n            int,\n            Field(\n                description=\"On return output starting at this character index, useful if a previous fetch was truncated and more context is required.\",\n                ge=0,\n                strict=True,\n            ),\n        ] = 0,\n        raw: Annotated[\n            bool,\n            Field(\n                description=\"Get the actual HTML content of the requested page, without simplification.\",\n                strict=True,\n            ),\n        ] = False,\n    ) -> str:\n        page_url = str(url)\n\n        if not ignore_robots_txt:\n            await check_may_autonomously_fetch_url(\n                page_url, user_agent_autonomous, proxy_url, allow_private_ips\n            )\n\n        content, prefix = await fetch_url(\n            page_url,\n            user_agent_autonomous,\n            force_raw=raw,\n            proxy_url=proxy_url,\n            allow_private_ips=allow_private_ips,\n            check_robots_txt=not ignore_robots_txt,\n        )\n        original_length = len(content)\n        if start_index >= original_length:\n            content = \"<error>No more content available.</error>\"\n        else:\n            # Never empty: start_index < original_length and max_length > 0.\n            truncated_content = content[start_index : start_index + max_length]\n            content = truncated_content\n            actual_content_length = len(truncated_content)\n            remaining_content = original_length - (start_index + actual_content_length)\n            # Only add the prompt to continue fetching if there is still remaining content\n            if actual_content_length == max_length and remaining_content > 0:\n                next_start = start_index + actual_content_length\n                content += f\"\\n\\n<error>Content truncated. Call the fetch tool with a start_index of {next_start} to get more content.</error>\"\n        return f\"{prefix}Contents of {page_url}:\\n{content}\"\n\n    @server.prompt(\n        name=\"fetch\",\n        description=\"Fetch a URL and extract its contents as markdown\",\n    )\n    async def fetch_prompt(\n        url: Annotated[str, Field(description=\"URL to fetch\")],\n    ) -> str:\n        # The user asked for this page, so robots.txt is not consulted, and a\n        # failure is shown to them as the prompt's text rather than raised.\n        try:\n            content, prefix = await fetch_url(\n                url,\n                user_agent_manual,\n                proxy_url=proxy_url,\n                allow_private_ips=allow_private_ips,\n            )\n        except ToolError as e:\n            return str(e)\n        return prefix + content\n\n    return server\n\n\nasync def serve(\n    custom_user_agent: str | None = None,\n    ignore_robots_txt: bool = False,\n    proxy_url: str | None = None,\n    allow_private_ips: bool = False,\n) -> None:\n    \"\"\"Run the fetch MCP server over stdio.\n\n    Args:\n        custom_user_agent: Optional custom User-Agent string to use for requests\n        ignore_robots_txt: Whether to ignore robots.txt restrictions\n        proxy_url: Optional proxy URL to use for requests\n        allow_private_ips: Allow fetching private, loopback and link-local\n            addresses, which are refused by default\n    \"\"\"\n    server = create_server(\n        custom_user_agent, ignore_robots_txt, proxy_url, allow_private_ips\n    )\n    # Both eras (#4853): the SDK's dual-era loop lets the client's first\n    # request decide. `initialize` gets the 2025-11-25 handshake;\n    # `server/discover` or a request carrying a 2026-07-28 envelope gets the\n    # modern, sessionless era, with its required result fields (resultType,\n    # ttlMs, cacheScope) filled in by the SDK.\n    await server.run_stdio_async()\n","numLines":564,"startLine":1,"totalLines":564}},"tool_result_meta":[{"id":"toolu_01PAJjcpmtzYuvSxH5yUn5kE","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
