{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0125GF9EghyjjBVPZGrKAebi","type":"tool_result","content":"1\tpackage oauth\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"crypto/rand\"\n6\t\t\"errors\"\n7\t\t\"log/slog\"\n8\t\t\"net/http\"\n9\t\t\"os\"\n10\t\t\"sync\"\n11\t\t\"time\"\n12\t\n13\t\t\"golang.org/x/oauth2\"\n14\t)\n15\t\n16\t// DefaultAuthTimeout bounds how long a single authorization attempt waits for\n17\t// the user to complete the browser or device flow.\n18\tconst DefaultAuthTimeout = 5 * time.Minute\n19\t\n20\t// tokenRefreshTimeout bounds each background refresh of an expiring token so a\n21\t// stalled GitHub token endpoint cannot block a tool call indefinitely.\n22\tconst tokenRefreshTimeout = 30 * time.Second\n23\t\n24\t// ErrStaleAuthorizationFlow indicates that a prompt response belongs to an\n25\t// authorization flow that is no longer current.\n26\tvar ErrStaleAuthorizationFlow = errors.New(\"authorization prompt has expired\")\n27\t\n28\t// flowStatus tracks the manager's single-flight authorization state.\n29\ttype flowStatus int\n30\t\n31\tconst (\n32\t\tstatusIdle         flowStatus = iota // no flow running\n33\t\tstatusStarting                       // a flow is being prepared (brief)\n34\t\tstatusInProgress                     // a flow is running on a secure channel; callers may join\n35\t\tstatusAwaitingUser                   // a flow is running but the user must act out-of-band\n36\t)\n37\t\n38\t// Outcome reports the result of an authorization attempt that did not\n39\t// immediately yield a token.\n40\ttype Outcome struct {\n41\t\t// UserAction, when non-nil, must be surfaced to the user. The authorization\n42\t\t// flow continues in the background; the user should retry once they have\n43\t\t// completed it.\n44\t\tUserAction *UserAction\n45\t\n46\t\t// FlowID correlates a user action with the authorization flow that produced\n47\t\t// it. Callers must pass it back to AwaitToken or Cancel so a delayed response\n48\t\t// cannot affect a newer flow.\n49\t\tFlowID string\n50\t}\n51\t\n52\t// UserAction is an instruction for the user to complete authorization out of\n53\t// band (the last-resort channel, used when neither a browser nor URL\n54\t// elicitation is available).\n55\ttype UserAction struct {\n56\t\t// Message is ready to display to the user.\n57\t\tMessage string\n58\t\t// URL is the authorization URL or device verification URI.\n59\t\tURL string\n60\t\t// UserCode is the device-flow code to enter, if any.\n61\t\tUserCode string\n62\t}\n63\t\n64\t// Manager owns the OAuth login flows and the resulting (refreshing) token for a\n65\t// single stdio session. It is safe for concurrent use; only one authorization\n66\t// flow runs at a time.\n67\ttype Manager struct {\n68\t\tconfig        Config\n69\t\trefreshConfig *oauth2.Config\n70\t\tlogger        *slog.Logger\n71\t\n72\t\t// Test seams, set by NewManager to real implementations.\n73\t\topenURL  func(string) error\n74\t\tinDocker func() bool\n75\t\n76\t\tmu               sync.Mutex\n77\t\tsource           oauth2.TokenSource // refreshing source, set once authorized\n78\t\ttokenGeneration  uint64             // increments whenever source is replaced\n79\t\tstatus           flowStatus\n80\t\tflowID           string\n81\t\tpending          *UserAction\n82\t\tdone             chan struct{}\n83\t\tcancelFlow       context.CancelFunc // cancels the in-flight flow, if any\n84\t\tlastErr          error\n85\t\trefreshErrLogged bool // true once a refresh failure has been logged, reset on re-auth\n86\t}\n87\t\n88\t// NewManager builds a Manager for the given configuration. A nil logger logs to\n89\t// stderr.\n90\tfunc NewManager(cfg Config, logger *slog.Logger) *Manager {\n91\t\tif logger == nil {\n92\t\t\tlogger = slog.New(slog.NewTextHandler(os.Stderr, nil))\n93\t\t}\n94\t\tm := &Manager{\n95\t\t\tconfig:   cfg,\n96\t\t\tlogger:   logger,\n97\t\t\topenURL:  openBrowser,\n98\t\t\tinDocker: isRunningInDocker,\n99\t\t}\n100\t\tm.refreshConfig = m.oauth2Config(\"\")\n101\t\treturn m\n102\t}\n103\t\n104\t// AccessToken returns a currently valid access token, refreshing it if needed,\n105\t// or \"\" if the session is not authorized (or a refresh has failed and\n106\t// re-authorization is required). It is cheap to call repeatedly: the underlying\n107\t// token source caches and only refreshes when the token has expired.\n108\tfunc (m *Manager) AccessToken() string {\n109\t\ttoken, _ := m.accessToken()\n110\t\treturn token\n111\t}\n112\t\n113\t// accessToken returns the token together with the generation of the source it\n114\t// checked. Authenticate uses the generation to detect a source installed while\n115\t// token validation was in progress, without repeating a potentially blocking\n116\t// refresh request.\n117\tfunc (m *Manager) accessToken() (string, uint64) {\n118\t\tm.mu.Lock()\n119\t\tsrc := m.source\n120\t\tgeneration := m.tokenGeneration\n121\t\tm.mu.Unlock()\n122\t\tif src == nil {\n123\t\t\treturn \"\", generation\n124\t\t}\n125\t\t// Refresh (if needed) happens here, off the lock, because ReuseTokenSource may\n126\t\t// make a blocking network call and holding m.mu would serialize every tool call.\n127\t\ttok, err := src.Token()\n128\t\tif err != nil {\n129\t\t\t// A refresh failure (expired GitHub App refresh token, revoked grant, or a\n130\t\t\t// network blip) leaves the session unauthorized and forces a re-login.\n131\t\t\t// Surface it once, otherwise it only manifests as a surprise re-authorization\n132\t\t\t// prompt. The oauth2 error carries the token endpoint's response, not the\n133\t\t\t// access or refresh token.\n134\t\t\tm.mu.Lock()\n135\t\t\tif m.tokenGeneration == generation && !m.refreshErrLogged {\n136\t\t\t\tm.refreshErrLogged = true\n137\t\t\t\tm.logger.Warn(\"OAuth token refresh failed; re-authorization required\", \"error\", err)\n138\t\t\t}\n139\t\t\tm.mu.Unlock()\n140\t\t\treturn \"\", generation\n141\t\t}\n142\t\tif !tok.Valid() {\n143\t\t\treturn \"\", generation\n144\t\t}\n145\t\treturn tok.AccessToken, generation\n146\t}\n147\t\n148\t// HasToken reports whether a valid token is currently available.\n149\tfunc (m *Manager) HasToken() bool {\n150\t\treturn m.AccessToken() != \"\"\n151\t}\n152\t\n153\t// Authenticate ensures the session is authorized.\n154\t//\n155\t// It returns (nil, nil) once a token is available, so the caller may proceed.\n156\t// It returns (&Outcome{UserAction}, nil) when the user must complete the flow\n157\t// out of band; the flow continues in the background and the caller should show\n158\t// the action and have the user retry. It returns (nil, err) on failure.\n159\t//\n160\t// Only one flow runs at a time. Concurrent callers either join a running secure\n161\t// flow, receive the pending user action, or are told to retry shortly.\n162\tfunc (m *Manager) Authenticate(ctx context.Context, prompter Prompter) (*Outcome, error) {\n163\t\tvar flowID string\n164\t\tvar done chan struct{}\n165\t\tfor {\n166\t\t\ttoken, checkedTokenGeneration := m.accessToken()\n167\t\t\tif token != \"\" {\n168\t\t\t\treturn nil, nil\n169\t\t\t}\n170\t\n171\t\t\tm.mu.Lock()\n172\t\t\tswitch m.status {\n173\t\t\tcase statusAwaitingUser:\n174\t\t\t\tua := m.pending\n175\t\t\t\tflowID := m.flowID\n176\t\t\t\tm.mu.Unlock()\n177\t\t\t\treturn &Outcome{UserAction: ua, FlowID: flowID}, nil\n178\t\t\tcase statusStarting:\n179\t\t\t\tflowID := m.flowID\n180\t\t\t\tm.mu.Unlock()\n181\t\t\t\treturn &Outcome{UserAction: &UserAction{\n182\t\t\t\t\tMessage: \"GitHub authorization is already in progress. Please retry your request in a few seconds.\",\n183\t\t\t\t}, FlowID: flowID}, nil\n184\t\t\tcase statusInProgress:\n185\t\t\t\tdone := m.done\n186\t\t\t\tflowID := m.flowID\n187\t\t\t\tm.mu.Unlock()\n188\t\t\t\treturn m.joinWait(ctx, done, flowID)\n189\t\t\t}\n190\t\n191\t\t\t// A flow may have installed a token while the source above was being\n192\t\t\t// checked. Retry if the source changed before claiming the idle state.\n193\t\t\tif m.tokenGeneration != checkedTokenGeneration {\n194\t\t\t\tm.mu.Unlock()\n195\t\t\t\tcontinue\n196\t\t\t}\n197\t\n198\t\t\t// Idle: this call owns the new flow.\n199\t\t\tm.status = statusStarting\n200\t\t\tm.flowID = rand.Text()\n201\t\t\tflowID = m.flowID\n202\t\t\tm.lastErr = nil\n203\t\t\tm.done = make(chan struct{})\n204\t\t\tdone = m.done\n205\t\t\tm.mu.Unlock()\n206\t\t\tbreak\n207\t\t}\n208\t\n209\t\tplan, err := m.begin(prompter)\n210\t\tif err != nil {\n211\t\t\tm.complete(flowID, nil, err)\n212\t\t\treturn nil, err\n213\t\t}\n214\t\n215\t\tbgCtx, cancel := context.WithTimeout(context.Background(), DefaultAuthTimeout)\n216\t\tm.mu.Lock()\n217\t\tif m.flowID != flowID {\n218\t\t\tm.mu.Unlock()\n219\t\t\tcancel()\n220\t\t\treturn nil, ErrStaleAuthorizationFlow\n221\t\t}\n222\t\tif plan.userAction != nil {\n223\t\t\tm.status = statusAwaitingUser\n224\t\t\tm.pending = plan.userAction\n225\t\t} else {\n226\t\t\tm.status = statusInProgress\n227\t\t}\n228\t\tm.cancelFlow = cancel\n229\t\tm.mu.Unlock()\n230\t\tgo m.runFlow(bgCtx, cancel, flowID, plan)\n231\t\n232\t\tif plan.userAction != nil {\n233\t\t\treturn &Outcome{UserAction: plan.userAction, FlowID: flowID}, nil\n234\t\t}\n235\t\treturn m.joinWait(ctx, done, flowID)\n236\t}\n237\t\n238\t// AwaitToken blocks until the in-flight authorization flow yields a token, the\n239\t// flow ends without one, or ctx is done. It is the resume half of the\n240\t// multi-round-trip flow: a transport that presented the authorization prompt\n241\t// itself (via elicitation returned from a tool call) calls this once the user\n242\t// has acted, to wait for the background token acquisition to finish.\n243\t//\n244\t// It returns (nil, nil) once a token is available (proceed), (&Outcome{UserAction},\n245\t// nil) when the user must still act out of band, or (nil, err) on failure.\n246\tfunc (m *Manager) AwaitToken(ctx context.Context, flowID string) (*Outcome, error) {\n247\t\tm.mu.Lock()\n248\t\tif flowID == \"\" || flowID != m.flowID {\n249\t\t\tm.mu.Unlock()\n250\t\t\treturn nil, ErrStaleAuthorizationFlow\n251\t\t}\n252\t\tdone := m.done\n253\t\tm.mu.Unlock()\n254\t\tif m.AccessToken() != \"\" {\n255\t\t\treturn nil, nil\n256\t\t}\n257\t\tif done == nil {\n258\t\t\t// No flow is in flight; report whatever terminal state it left behind.\n259\t\t\treturn m.outcomeAfterFlow(flowID)\n260\t\t}\n261\t\tselect {\n262\t\tcase <-done:\n263\t\t\treturn m.outcomeAfterFlow(flowID)\n264\t\tcase <-ctx.Done():\n265\t\t\treturn nil, ctx.Err()\n266\t\t}\n267\t}\n268\t\n269\t// Cancel retires the matching authorization flow and aborts its background\n270\t// callback listener or device poll. It returns false if flowID is stale.\n271\tfunc (m *Manager) Cancel(flowID string) bool {\n272\t\tm.mu.Lock()\n273\t\tif flowID == \"\" || flowID != m.flowID {\n274\t\t\tm.mu.Unlock()\n275\t\t\treturn false\n276\t\t}\n277\t\tcancel := m.cancelFlow\n278\t\tm.status = statusIdle\n279\t\tm.flowID = \"\"\n280\t\tm.pending = nil\n281\t\tm.cancelFlow = nil\n282\t\tm.lastErr = context.Canceled\n283\t\tif m.done != nil {\n284\t\t\tclose(m.done)\n285\t\t\tm.done = nil\n286\t\t}\n287\t\tm.mu.Unlock()\n288\t\tif cancel != nil {\n289\t\t\tcancel()\n290\t\t}\n291\t\treturn true\n292\t}\n293\t\n294\t// runFlow executes a prepared flow in the background and records the result. The\n295\t// optional display prompt runs concurrently: a decline (or other failure) aborts\n296\t// the flow, while an undeliverable prompt degrades to the manual fallback without\n297\t// tearing the flow down, so the user can still authorize out of band.\n298\tfunc (m *Manager) runFlow(ctx context.Context, cancel context.CancelFunc, flowID string, plan *flowPlan) {\n299\t\tdefer cancel()\n300\t\n301\t\tif plan.display != nil {\n302\t\t\tgo func() {\n303\t\t\t\terr := plan.display(ctx)\n304\t\t\t\tswitch {\n305\t\t\t\tcase err == nil:\n306\t\t\t\t\t// Prompt shown; the flow completes when the token arrives.\n307\t\t\t\tcase ctx.Err() != nil:\n308\t\t\t\t\t// The flow is already ending (timed out or cancelled elsewhere),\n309\t\t\t\t\t// so there is nothing to fall back to. Checking this before the\n310\t\t\t\t\t// fallback also prevents misreading a context-cancelled prompt as\n311\t\t\t\t\t// a transport failure.\n312\t\t\t\tcase errors.Is(err, ErrPromptUnavailable) && plan.fallback != nil:\n313\t\t\t\t\t// The client advertised the capability but could not deliver the\n314\t\t\t\t\t// prompt. Surface the manual instructions instead of failing, and\n315\t\t\t\t\t// keep the background flow alive so the user can still authorize.\n316\t\t\t\t\tm.logger.Debug(\"authorization prompt undeliverable; falling back to manual instructions\", \"reason\", err)\n317\t\t\t\t\tm.fallBackToUserAction(flowID, plan.fallback)\n318\t\t\t\tdefault:\n319\t\t\t\t\t// A user decline (ErrPromptDeclined) or any other prompt failure\n320\t\t\t\t\t// ends the flow.\n321\t\t\t\t\tm.logger.Debug(\"authorization prompt closed\", \"reason\", err)\n322\t\t\t\t\tcancel()\n323\t\t\t\t}\n324\t\t\t}()\n325\t\t}\n326\t\n327\t\ttok, err := plan.run(ctx)\n328\t\tm.complete(flowID, tok, err)\n329\t}\n330\t\n331\t// fallBackToUserAction promotes a running secure flow to the manual user-action\n332\t// channel after its prompt could not be delivered. The background flow keeps\n333\t// running, so the user can complete authorization out of band and retry. It is a\n334\t// no-op if the flow has already resolved.\n335\tfunc (m *Manager) fallBackToUserAction(flowID string, ua *UserAction) {\n336\t\tm.mu.Lock()\n337\t\tdefer m.mu.Unlock()\n338\t\tif m.flowID != flowID || m.status != statusInProgress {\n339\t\t\treturn\n340\t\t}\n341\t\tm.status = statusAwaitingUser\n342\t\tm.pending = ua\n343\t\t// Wake any callers joined on this flow so they receive the action, and clear\n344\t\t// done so complete() does not double-close it when run() later finishes.\n345\t\tif m.done != nil {\n346\t\t\tclose(m.done)\n347\t\t\tm.done = nil\n348\t\t}\n349\t}\n350\t\n351\t// complete records the flow result, installing a refreshing token source on\n352\t// success, and wakes any joined callers.\n353\tfunc (m *Manager) complete(flowID string, tok *oauth2.Token, err error) {\n354\t\tm.mu.Lock()\n355\t\tdefer m.mu.Unlock()\n356\t\tif m.flowID != flowID {\n357\t\t\treturn\n358\t\t}\n359\t\n360\t\tm.status = statusIdle\n361\t\tm.pending = nil\n362\t\tm.cancelFlow = nil\n363\t\tif err != nil {\n364\t\t\tm.lastErr = err\n365\t\t\tm.logger.Debug(\"oauth flow failed\", \"error\", err)\n366\t\t} else {\n367\t\t\tm.lastErr = nil\n368\t\t\t// Config.TokenSource returns a ReuseTokenSource that refreshes expired\n369\t\t\t// tokens using the refresh token — this is what makes GitHub App\n370\t\t\t// (expiring) tokens work transparently. The refresh uses a bounded HTTP\n371\t\t\t// client so a stalled token endpoint can't block a tool call forever.\n372\t\t\trefreshCtx := context.WithValue(context.Background(), oauth2.HTTPClient, &http.Client{Timeout: tokenRefreshTimeout})\n373\t\t\tm.source = m.refreshConfig.TokenSource(refreshCtx, tok)\n374\t\t\tm.tokenGeneration++\n375\t\t\tm.refreshErrLogged = false\n376\t\t\tm.logger.Info(\"github authorization complete\")\n377\t\t}\n378\t\tif m.done != nil {\n379\t\t\tclose(m.done)\n380\t\t\tm.done = nil\n381\t\t}\n382\t}\n383\t\n384\t// joinWait blocks until the running flow finishes or ctx is cancelled. If the\n385\t// flow was promoted to the manual channel while waiting (its prompt could not be\n386\t// delivered), it returns that user action rather than an error.\n387\tfunc (m *Manager) joinWait(ctx context.Context, done chan struct{}, flowID string) (*Outcome, error) {\n388\t\tselect {\n389\t\tcase <-done:\n390\t\t\treturn m.outcomeAfterFlow(flowID)\n391\t\tcase <-ctx.Done():\n392\t\t\treturn nil, ctx.Err()\n393\t\t}\n394\t}\n395\t\n396\t// outcomeAfterFlow reports the result once the flow's done channel has closed\n397\t// (or when there is no flow in flight): a token to proceed (nil, nil), a pending\n398\t// user action to surface, or the flow's error.\n399\tfunc (m *Manager) outcomeAfterFlow(flowID string) (*Outcome, error) {\n400\t\tm.mu.Lock()\n401\t\tif flowID == \"\" || flowID != m.flowID {\n402\t\t\tm.mu.Unlock()\n403\t\t\treturn nil, ErrStaleAuthorizationFlow\n404\t\t}\n405\t\tpending := m.pending\n406\t\terr := m.lastErr\n407\t\tm.mu.Unlock()\n408\t\tif m.AccessToken() != \"\" {\n409\t\t\treturn nil, nil\n410\t\t}\n411\t\tif pending != nil {\n412\t\t\treturn &Outcome{UserAction: pending, FlowID: flowID}, nil\n413\t\t}\n414\t\tif err != nil {\n415\t\t\treturn nil, err\n416\t\t}\n417\t\treturn nil, errors.New(\"authorization did not complete\")\n418\t}\n419\t\n420\tfunc (m *Manager) oauth2Config(redirectURL string) *oauth2.Config {\n421\t\treturn &oauth2.Config{\n422\t\t\tClientID:     m.config.ClientID,\n423\t\t\tClientSecret: m.config.ClientSecret,\n424\t\t\tRedirectURL:  redirectURL,\n425\t\t\tScopes:       m.config.Scopes,\n426\t\t\tEndpoint:     m.config.Endpoint,\n427\t\t}\n428\t}\n429\t"}]},"parent_tool_use_id":null,"session_id":"df051642-2fec-4e59-8ee2-eef5b182d909","uuid":"2330e062-982b-429e-9b57-55fac17096a1","timestamp":"2026-10-26T10:20:27.334Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-real-mcp-review-kiqc28ec/repo/internal/oauth/manager.go","content":"package oauth\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"errors\"\n\t\"log/slog\"\n\t\"net/http\"\n\t\"os\"\n\t\"sync\"\n\t\"time\"\n\n\t\"golang.org/x/oauth2\"\n)\n\n// DefaultAuthTimeout bounds how long a single authorization attempt waits for\n// the user to complete the browser or device flow.\nconst DefaultAuthTimeout = 5 * time.Minute\n\n// tokenRefreshTimeout bounds each background refresh of an expiring token so a\n// stalled GitHub token endpoint cannot block a tool call indefinitely.\nconst tokenRefreshTimeout = 30 * time.Second\n\n// ErrStaleAuthorizationFlow indicates that a prompt response belongs to an\n// authorization flow that is no longer current.\nvar ErrStaleAuthorizationFlow = errors.New(\"authorization prompt has expired\")\n\n// flowStatus tracks the manager's single-flight authorization state.\ntype flowStatus int\n\nconst (\n\tstatusIdle         flowStatus = iota // no flow running\n\tstatusStarting                       // a flow is being prepared (brief)\n\tstatusInProgress                     // a flow is running on a secure channel; callers may join\n\tstatusAwaitingUser                   // a flow is running but the user must act out-of-band\n)\n\n// Outcome reports the result of an authorization attempt that did not\n// immediately yield a token.\ntype Outcome struct {\n\t// UserAction, when non-nil, must be surfaced to the user. The authorization\n\t// flow continues in the background; the user should retry once they have\n\t// completed it.\n\tUserAction *UserAction\n\n\t// FlowID correlates a user action with the authorization flow that produced\n\t// it. Callers must pass it back to AwaitToken or Cancel so a delayed response\n\t// cannot affect a newer flow.\n\tFlowID string\n}\n\n// UserAction is an instruction for the user to complete authorization out of\n// band (the last-resort channel, used when neither a browser nor URL\n// elicitation is available).\ntype UserAction struct {\n\t// Message is ready to display to the user.\n\tMessage string\n\t// URL is the authorization URL or device verification URI.\n\tURL string\n\t// UserCode is the device-flow code to enter, if any.\n\tUserCode string\n}\n\n// Manager owns the OAuth login flows and the resulting (refreshing) token for a\n// single stdio session. It is safe for concurrent use; only one authorization\n// flow runs at a time.\ntype Manager struct {\n\tconfig        Config\n\trefreshConfig *oauth2.Config\n\tlogger        *slog.Logger\n\n\t// Test seams, set by NewManager to real implementations.\n\topenURL  func(string) error\n\tinDocker func() bool\n\n\tmu               sync.Mutex\n\tsource           oauth2.TokenSource // refreshing source, set once authorized\n\ttokenGeneration  uint64             // increments whenever source is replaced\n\tstatus           flowStatus\n\tflowID           string\n\tpending          *UserAction\n\tdone             chan struct{}\n\tcancelFlow       context.CancelFunc // cancels the in-flight flow, if any\n\tlastErr          error\n\trefreshErrLogged bool // true once a refresh failure has been logged, reset on re-auth\n}\n\n// NewManager builds a Manager for the given configuration. A nil logger logs to\n// stderr.\nfunc NewManager(cfg Config, logger *slog.Logger) *Manager {\n\tif logger == nil {\n\t\tlogger = slog.New(slog.NewTextHandler(os.Stderr, nil))\n\t}\n\tm := &Manager{\n\t\tconfig:   cfg,\n\t\tlogger:   logger,\n\t\topenURL:  openBrowser,\n\t\tinDocker: isRunningInDocker,\n\t}\n\tm.refreshConfig = m.oauth2Config(\"\")\n\treturn m\n}\n\n// AccessToken returns a currently valid access token, refreshing it if needed,\n// or \"\" if the session is not authorized (or a refresh has failed and\n// re-authorization is required). It is cheap to call repeatedly: the underlying\n// token source caches and only refreshes when the token has expired.\nfunc (m *Manager) AccessToken() string {\n\ttoken, _ := m.accessToken()\n\treturn token\n}\n\n// accessToken returns the token together with the generation of the source it\n// checked. Authenticate uses the generation to detect a source installed while\n// token validation was in progress, without repeating a potentially blocking\n// refresh request.\nfunc (m *Manager) accessToken() (string, uint64) {\n\tm.mu.Lock()\n\tsrc := m.source\n\tgeneration := m.tokenGeneration\n\tm.mu.Unlock()\n\tif src == nil {\n\t\treturn \"\", generation\n\t}\n\t// Refresh (if needed) happens here, off the lock, because ReuseTokenSource may\n\t// make a blocking network call and holding m.mu would serialize every tool call.\n\ttok, err := src.Token()\n\tif err != nil {\n\t\t// A refresh failure (expired GitHub App refresh token, revoked grant, or a\n\t\t// network blip) leaves the session unauthorized and forces a re-login.\n\t\t// Surface it once, otherwise it only manifests as a surprise re-authorization\n\t\t// prompt. The oauth2 error carries the token endpoint's response, not the\n\t\t// access or refresh token.\n\t\tm.mu.Lock()\n\t\tif m.tokenGeneration == generation && !m.refreshErrLogged {\n\t\t\tm.refreshErrLogged = true\n\t\t\tm.logger.Warn(\"OAuth token refresh failed; re-authorization required\", \"error\", err)\n\t\t}\n\t\tm.mu.Unlock()\n\t\treturn \"\", generation\n\t}\n\tif !tok.Valid() {\n\t\treturn \"\", generation\n\t}\n\treturn tok.AccessToken, generation\n}\n\n// HasToken reports whether a valid token is currently available.\nfunc (m *Manager) HasToken() bool {\n\treturn m.AccessToken() != \"\"\n}\n\n// Authenticate ensures the session is authorized.\n//\n// It returns (nil, nil) once a token is available, so the caller may proceed.\n// It returns (&Outcome{UserAction}, nil) when the user must complete the flow\n// out of band; the flow continues in the background and the caller should show\n// the action and have the user retry. It returns (nil, err) on failure.\n//\n// Only one flow runs at a time. Concurrent callers either join a running secure\n// flow, receive the pending user action, or are told to retry shortly.\nfunc (m *Manager) Authenticate(ctx context.Context, prompter Prompter) (*Outcome, error) {\n\tvar flowID string\n\tvar done chan struct{}\n\tfor {\n\t\ttoken, checkedTokenGeneration := m.accessToken()\n\t\tif token != \"\" {\n\t\t\treturn nil, nil\n\t\t}\n\n\t\tm.mu.Lock()\n\t\tswitch m.status {\n\t\tcase statusAwaitingUser:\n\t\t\tua := m.pending\n\t\t\tflowID := m.flowID\n\t\t\tm.mu.Unlock()\n\t\t\treturn &Outcome{UserAction: ua, FlowID: flowID}, nil\n\t\tcase statusStarting:\n\t\t\tflowID := m.flowID\n\t\t\tm.mu.Unlock()\n\t\t\treturn &Outcome{UserAction: &UserAction{\n\t\t\t\tMessage: \"GitHub authorization is already in progress. Please retry your request in a few seconds.\",\n\t\t\t}, FlowID: flowID}, nil\n\t\tcase statusInProgress:\n\t\t\tdone := m.done\n\t\t\tflowID := m.flowID\n\t\t\tm.mu.Unlock()\n\t\t\treturn m.joinWait(ctx, done, flowID)\n\t\t}\n\n\t\t// A flow may have installed a token while the source above was being\n\t\t// checked. Retry if the source changed before claiming the idle state.\n\t\tif m.tokenGeneration != checkedTokenGeneration {\n\t\t\tm.mu.Unlock()\n\t\t\tcontinue\n\t\t}\n\n\t\t// Idle: this call owns the new flow.\n\t\tm.status = statusStarting\n\t\tm.flowID = rand.Text()\n\t\tflowID = m.flowID\n\t\tm.lastErr = nil\n\t\tm.done = make(chan struct{})\n\t\tdone = m.done\n\t\tm.mu.Unlock()\n\t\tbreak\n\t}\n\n\tplan, err := m.begin(prompter)\n\tif err != nil {\n\t\tm.complete(flowID, nil, err)\n\t\treturn nil, err\n\t}\n\n\tbgCtx, cancel := context.WithTimeout(context.Background(), DefaultAuthTimeout)\n\tm.mu.Lock()\n\tif m.flowID != flowID {\n\t\tm.mu.Unlock()\n\t\tcancel()\n\t\treturn nil, ErrStaleAuthorizationFlow\n\t}\n\tif plan.userAction != nil {\n\t\tm.status = statusAwaitingUser\n\t\tm.pending = plan.userAction\n\t} else {\n\t\tm.status = statusInProgress\n\t}\n\tm.cancelFlow = cancel\n\tm.mu.Unlock()\n\tgo m.runFlow(bgCtx, cancel, flowID, plan)\n\n\tif plan.userAction != nil {\n\t\treturn &Outcome{UserAction: plan.userAction, FlowID: flowID}, nil\n\t}\n\treturn m.joinWait(ctx, done, flowID)\n}\n\n// AwaitToken blocks until the in-flight authorization flow yields a token, the\n// flow ends without one, or ctx is done. It is the resume half of the\n// multi-round-trip flow: a transport that presented the authorization prompt\n// itself (via elicitation returned from a tool call) calls this once the user\n// has acted, to wait for the background token acquisition to finish.\n//\n// It returns (nil, nil) once a token is available (proceed), (&Outcome{UserAction},\n// nil) when the user must still act out of band, or (nil, err) on failure.\nfunc (m *Manager) AwaitToken(ctx context.Context, flowID string) (*Outcome, error) {\n\tm.mu.Lock()\n\tif flowID == \"\" || flowID != m.flowID {\n\t\tm.mu.Unlock()\n\t\treturn nil, ErrStaleAuthorizationFlow\n\t}\n\tdone := m.done\n\tm.mu.Unlock()\n\tif m.AccessToken() != \"\" {\n\t\treturn nil, nil\n\t}\n\tif done == nil {\n\t\t// No flow is in flight; report whatever terminal state it left behind.\n\t\treturn m.outcomeAfterFlow(flowID)\n\t}\n\tselect {\n\tcase <-done:\n\t\treturn m.outcomeAfterFlow(flowID)\n\tcase <-ctx.Done():\n\t\treturn nil, ctx.Err()\n\t}\n}\n\n// Cancel retires the matching authorization flow and aborts its background\n// callback listener or device poll. It returns false if flowID is stale.\nfunc (m *Manager) Cancel(flowID string) bool {\n\tm.mu.Lock()\n\tif flowID == \"\" || flowID != m.flowID {\n\t\tm.mu.Unlock()\n\t\treturn false\n\t}\n\tcancel := m.cancelFlow\n\tm.status = statusIdle\n\tm.flowID = \"\"\n\tm.pending = nil\n\tm.cancelFlow = nil\n\tm.lastErr = context.Canceled\n\tif m.done != nil {\n\t\tclose(m.done)\n\t\tm.done = nil\n\t}\n\tm.mu.Unlock()\n\tif cancel != nil {\n\t\tcancel()\n\t}\n\treturn true\n}\n\n// runFlow executes a prepared flow in the background and records the result. The\n// optional display prompt runs concurrently: a decline (or other failure) aborts\n// the flow, while an undeliverable prompt degrades to the manual fallback without\n// tearing the flow down, so the user can still authorize out of band.\nfunc (m *Manager) runFlow(ctx context.Context, cancel context.CancelFunc, flowID string, plan *flowPlan) {\n\tdefer cancel()\n\n\tif plan.display != nil {\n\t\tgo func() {\n\t\t\terr := plan.display(ctx)\n\t\t\tswitch {\n\t\t\tcase err == nil:\n\t\t\t\t// Prompt shown; the flow completes when the token arrives.\n\t\t\tcase ctx.Err() != nil:\n\t\t\t\t// The flow is already ending (timed out or cancelled elsewhere),\n\t\t\t\t// so there is nothing to fall back to. Checking this before the\n\t\t\t\t// fallback also prevents misreading a context-cancelled prompt as\n\t\t\t\t// a transport failure.\n\t\t\tcase errors.Is(err, ErrPromptUnavailable) && plan.fallback != nil:\n\t\t\t\t// The client advertised the capability but could not deliver the\n\t\t\t\t// prompt. Surface the manual instructions instead of failing, and\n\t\t\t\t// keep the background flow alive so the user can still authorize.\n\t\t\t\tm.logger.Debug(\"authorization prompt undeliverable; falling back to manual instructions\", \"reason\", err)\n\t\t\t\tm.fallBackToUserAction(flowID, plan.fallback)\n\t\t\tdefault:\n\t\t\t\t// A user decline (ErrPromptDeclined) or any other prompt failure\n\t\t\t\t// ends the flow.\n\t\t\t\tm.logger.Debug(\"authorization prompt closed\", \"reason\", err)\n\t\t\t\tcancel()\n\t\t\t}\n\t\t}()\n\t}\n\n\ttok, err := plan.run(ctx)\n\tm.complete(flowID, tok, err)\n}\n\n// fallBackToUserAction promotes a running secure flow to the manual user-action\n// channel after its prompt could not be delivered. The background flow keeps\n// running, so the user can complete authorization out of band and retry. It is a\n// no-op if the flow has already resolved.\nfunc (m *Manager) fallBackToUserAction(flowID string, ua *UserAction) {\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\tif m.flowID != flowID || m.status != statusInProgress {\n\t\treturn\n\t}\n\tm.status = statusAwaitingUser\n\tm.pending = ua\n\t// Wake any callers joined on this flow so they receive the action, and clear\n\t// done so complete() does not double-close it when run() later finishes.\n\tif m.done != nil {\n\t\tclose(m.done)\n\t\tm.done = nil\n\t}\n}\n\n// complete records the flow result, installing a refreshing token source on\n// success, and wakes any joined callers.\nfunc (m *Manager) complete(flowID string, tok *oauth2.Token, err error) {\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\tif m.flowID != flowID {\n\t\treturn\n\t}\n\n\tm.status = statusIdle\n\tm.pending = nil\n\tm.cancelFlow = nil\n\tif err != nil {\n\t\tm.lastErr = err\n\t\tm.logger.Debug(\"oauth flow failed\", \"error\", err)\n\t} else {\n\t\tm.lastErr = nil\n\t\t// Config.TokenSource returns a ReuseTokenSource that refreshes expired\n\t\t// tokens using the refresh token — this is what makes GitHub App\n\t\t// (expiring) tokens work transparently. The refresh uses a bounded HTTP\n\t\t// client so a stalled token endpoint can't block a tool call forever.\n\t\trefreshCtx := context.WithValue(context.Background(), oauth2.HTTPClient, &http.Client{Timeout: tokenRefreshTimeout})\n\t\tm.source = m.refreshConfig.TokenSource(refreshCtx, tok)\n\t\tm.tokenGeneration++\n\t\tm.refreshErrLogged = false\n\t\tm.logger.Info(\"github authorization complete\")\n\t}\n\tif m.done != nil {\n\t\tclose(m.done)\n\t\tm.done = nil\n\t}\n}\n\n// joinWait blocks until the running flow finishes or ctx is cancelled. If the\n// flow was promoted to the manual channel while waiting (its prompt could not be\n// delivered), it returns that user action rather than an error.\nfunc (m *Manager) joinWait(ctx context.Context, done chan struct{}, flowID string) (*Outcome, error) {\n\tselect {\n\tcase <-done:\n\t\treturn m.outcomeAfterFlow(flowID)\n\tcase <-ctx.Done():\n\t\treturn nil, ctx.Err()\n\t}\n}\n\n// outcomeAfterFlow reports the result once the flow's done channel has closed\n// (or when there is no flow in flight): a token to proceed (nil, nil), a pending\n// user action to surface, or the flow's error.\nfunc (m *Manager) outcomeAfterFlow(flowID string) (*Outcome, error) {\n\tm.mu.Lock()\n\tif flowID == \"\" || flowID != m.flowID {\n\t\tm.mu.Unlock()\n\t\treturn nil, ErrStaleAuthorizationFlow\n\t}\n\tpending := m.pending\n\terr := m.lastErr\n\tm.mu.Unlock()\n\tif m.AccessToken() != \"\" {\n\t\treturn nil, nil\n\t}\n\tif pending != nil {\n\t\treturn &Outcome{UserAction: pending, FlowID: flowID}, nil\n\t}\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn nil, errors.New(\"authorization did not complete\")\n}\n\nfunc (m *Manager) oauth2Config(redirectURL string) *oauth2.Config {\n\treturn &oauth2.Config{\n\t\tClientID:     m.config.ClientID,\n\t\tClientSecret: m.config.ClientSecret,\n\t\tRedirectURL:  redirectURL,\n\t\tScopes:       m.config.Scopes,\n\t\tEndpoint:     m.config.Endpoint,\n\t}\n}\n","numLines":429,"startLine":1,"totalLines":429}},"tool_result_meta":[{"id":"toolu_0125GF9EghyjjBVPZGrKAebi","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
