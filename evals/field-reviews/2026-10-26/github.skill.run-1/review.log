{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013qpiVghRBBKTFvTkaUSxa9","type":"tool_result","content":"1\tpackage middleware\n2\t\n3\timport (\n4\t\t\"net/http\"\n5\t\t\"slices\"\n6\t\t\"strings\"\n7\t\n8\t\tghcontext \"github.com/github/github-mcp-server/v2/pkg/context\"\n9\t\t\"github.com/github/github-mcp-server/v2/pkg/http/headers\"\n10\t)\n11\t\n12\tconst queryParamFeatures = \"features\"\n13\t\n14\t// WithRequestConfig is a middleware that extracts MCP-related headers and sets them in the request context.\n15\t// This includes readonly mode, toolsets, tools, lockdown mode, insiders mode, and feature flags.\n16\tfunc WithRequestConfig(next http.Handler) http.Handler {\n17\t\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n18\t\t\t// Header-selected features can change the response for the same URL.\n19\t\t\tw.Header().Add(headers.VaryHeader, headers.MCPFeaturesHeader)\n20\t\n21\t\t\tctx := r.Context()\n22\t\n23\t\t\t// Readonly mode\n24\t\t\tif relaxedParseBool(r.Header.Get(headers.MCPReadOnlyHeader)) {\n25\t\t\t\tctx = ghcontext.WithReadonly(ctx, true)\n26\t\t\t}\n27\t\n28\t\t\t// Toolsets\n29\t\t\tif toolsets := headers.ParseCommaSeparated(r.Header.Get(headers.MCPToolsetsHeader)); len(toolsets) > 0 {\n30\t\t\t\tctx = ghcontext.WithToolsets(ctx, toolsets)\n31\t\t\t}\n32\t\n33\t\t\t// Tools\n34\t\t\tif tools := headers.ParseCommaSeparated(r.Header.Get(headers.MCPToolsHeader)); len(tools) > 0 {\n35\t\t\t\tctx = ghcontext.WithTools(ctx, tools)\n36\t\t\t}\n37\t\n38\t\t\t// Lockdown mode\n39\t\t\tif relaxedParseBool(r.Header.Get(headers.MCPLockdownHeader)) {\n40\t\t\t\tctx = ghcontext.WithLockdownMode(ctx, true)\n41\t\t\t}\n42\t\n43\t\t\t// Excluded tools\n44\t\t\tif excludeTools := headers.ParseCommaSeparated(r.Header.Get(headers.MCPExcludeToolsHeader)); len(excludeTools) > 0 {\n45\t\t\t\tctx = ghcontext.WithExcludeTools(ctx, excludeTools)\n46\t\t\t}\n47\t\n48\t\t\t// Insiders mode\n49\t\t\tif relaxedParseBool(r.Header.Get(headers.MCPInsidersHeader)) {\n50\t\t\t\tctx = ghcontext.WithInsidersMode(ctx, true)\n51\t\t\t}\n52\t\n53\t\t\tquery := r.URL.Query()\n54\t\t\t_, hasHeaderFeatures := r.Header[http.CanonicalHeaderKey(headers.MCPFeaturesHeader)]\n55\t\t\t_, hasQueryFeatures := query[queryParamFeatures]\n56\t\t\tif hasHeaderFeatures {\n57\t\t\t\tctx = ghcontext.WithHeaderFeatures(ctx, headers.ParseCommaSeparated(r.Header.Get(headers.MCPFeaturesHeader)))\n58\t\t\t} else if hasQueryFeatures {\n59\t\t\t\tctx = ghcontext.WithHeaderFeatures(ctx, headers.ParseCommaSeparated(query.Get(queryParamFeatures)))\n60\t\t\t}\n61\t\n62\t\t\tnext.ServeHTTP(w, r.WithContext(ctx))\n63\t\t})\n64\t}\n65\t\n66\t// relaxedParseBool parses a string into a boolean value, treating various\n67\t// common false values or empty strings as false, and everything else as true.\n68\t// It is case-insensitive and trims whitespace.\n69\tfunc relaxedParseBool(s string) bool {\n70\t\ts = strings.TrimSpace(strings.ToLower(s))\n71\t\tfalseValues := []string{\"\", \"false\", \"0\", \"no\", \"off\", \"n\", \"f\"}\n72\t\treturn !slices.Contains(falseValues, s)\n73\t}\n74\t"}]},"parent_tool_use_id":null,"session_id":"deaab419-c428-4eb9-8f29-49cef0e3fa03","uuid":"3f58d97a-ccb4-41ef-b242-9f8b6c83c2a2","timestamp":"2026-10-26T10:20:52.625Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-real-mcp-review-e0ua7zjt/repo/pkg/http/middleware/request_config.go","content":"package middleware\n\nimport (\n\t\"net/http\"\n\t\"slices\"\n\t\"strings\"\n\n\tghcontext \"github.com/github/github-mcp-server/v2/pkg/context\"\n\t\"github.com/github/github-mcp-server/v2/pkg/http/headers\"\n)\n\nconst queryParamFeatures = \"features\"\n\n// WithRequestConfig is a middleware that extracts MCP-related headers and sets them in the request context.\n// This includes readonly mode, toolsets, tools, lockdown mode, insiders mode, and feature flags.\nfunc WithRequestConfig(next http.Handler) http.Handler {\n\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\t// Header-selected features can change the response for the same URL.\n\t\tw.Header().Add(headers.VaryHeader, headers.MCPFeaturesHeader)\n\n\t\tctx := r.Context()\n\n\t\t// Readonly mode\n\t\tif relaxedParseBool(r.Header.Get(headers.MCPReadOnlyHeader)) {\n\t\t\tctx = ghcontext.WithReadonly(ctx, true)\n\t\t}\n\n\t\t// Toolsets\n\t\tif toolsets := headers.ParseCommaSeparated(r.Header.Get(headers.MCPToolsetsHeader)); len(toolsets) > 0 {\n\t\t\tctx = ghcontext.WithToolsets(ctx, toolsets)\n\t\t}\n\n\t\t// Tools\n\t\tif tools := headers.ParseCommaSeparated(r.Header.Get(headers.MCPToolsHeader)); len(tools) > 0 {\n\t\t\tctx = ghcontext.WithTools(ctx, tools)\n\t\t}\n\n\t\t// Lockdown mode\n\t\tif relaxedParseBool(r.Header.Get(headers.MCPLockdownHeader)) {\n\t\t\tctx = ghcontext.WithLockdownMode(ctx, true)\n\t\t}\n\n\t\t// Excluded tools\n\t\tif excludeTools := headers.ParseCommaSeparated(r.Header.Get(headers.MCPExcludeToolsHeader)); len(excludeTools) > 0 {\n\t\t\tctx = ghcontext.WithExcludeTools(ctx, excludeTools)\n\t\t}\n\n\t\t// Insiders mode\n\t\tif relaxedParseBool(r.Header.Get(headers.MCPInsidersHeader)) {\n\t\t\tctx = ghcontext.WithInsidersMode(ctx, true)\n\t\t}\n\n\t\tquery := r.URL.Query()\n\t\t_, hasHeaderFeatures := r.Header[http.CanonicalHeaderKey(headers.MCPFeaturesHeader)]\n\t\t_, hasQueryFeatures := query[queryParamFeatures]\n\t\tif hasHeaderFeatures {\n\t\t\tctx = ghcontext.WithHeaderFeatures(ctx, headers.ParseCommaSeparated(r.Header.Get(headers.MCPFeaturesHeader)))\n\t\t} else if hasQueryFeatures {\n\t\t\tctx = ghcontext.WithHeaderFeatures(ctx, headers.ParseCommaSeparated(query.Get(queryParamFeatures)))\n\t\t}\n\n\t\tnext.ServeHTTP(w, r.WithContext(ctx))\n\t})\n}\n\n// relaxedParseBool parses a string into a boolean value, treating various\n// common false values or empty strings as false, and everything else as true.\n// It is case-insensitive and trims whitespace.\nfunc relaxedParseBool(s string) bool {\n\ts = strings.TrimSpace(strings.ToLower(s))\n\tfalseValues := []string{\"\", \"false\", \"0\", \"no\", \"off\", \"n\", \"f\"}\n\treturn !slices.Contains(falseValues, s)\n}\n","numLines":74,"startLine":1,"totalLines":74}},"tool_result_meta":[{"id":"toolu_013qpiVghRBBKTFvTkaUSxa9","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
