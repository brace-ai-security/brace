{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TE1NvG6SuhtM6LZUmUGzKW","type":"tool_result","content":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"os\"\n8\t\t\"runtime/debug\"\n9\t\t\"strings\"\n10\t\t\"time\"\n11\t\n12\t\t\"github.com/github/github-mcp-server/v2/internal/buildinfo\"\n13\t\t\"github.com/github/github-mcp-server/v2/internal/ghmcp\"\n14\t\t\"github.com/github/github-mcp-server/v2/internal/githubapp\"\n15\t\t\"github.com/github/github-mcp-server/v2/internal/oauth\"\n16\t\t\"github.com/github/github-mcp-server/v2/pkg/github\"\n17\t\tghhttp \"github.com/github/github-mcp-server/v2/pkg/http\"\n18\t\tghoauth \"github.com/github/github-mcp-server/v2/pkg/http/oauth\"\n19\t\t\"github.com/github/github-mcp-server/v2/pkg/utils\"\n20\t\t\"github.com/spf13/cobra\"\n21\t\t\"github.com/spf13/pflag\"\n22\t\t\"github.com/spf13/viper\"\n23\t)\n24\t\n25\t// These variables are set by the build process using ldflags.\n26\tvar version = \"version\"\n27\tvar commit = \"commit\"\n28\tvar date = \"date\"\n29\t\n30\tvar (\n31\t\trootCmd = &cobra.Command{\n32\t\t\tUse:     \"github-mcp-server\",\n33\t\t\tShort:   \"GitHub MCP Server\",\n34\t\t\tLong:    `A GitHub MCP server that handles various tools and resources.`,\n35\t\t\tVersion: fmt.Sprintf(\"Version: %s\\nCommit: %s\\nBuild Date: %s\", version, commit, date),\n36\t\t}\n37\t\n38\t\tstdioCmd = &cobra.Command{\n39\t\t\tUse:   \"stdio\",\n40\t\t\tShort: \"Start stdio server\",\n41\t\t\tLong:  `Start a server that communicates via standard input/output streams using JSON-RPC messages.`,\n42\t\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n43\t\t\t\tinfo, _ := debug.ReadBuildInfo()\n44\t\t\t\tserverVersion := resolveServerVersion(version, commit, info)\n45\t\t\t\tif serverVersion == developmentServerVersion {\n46\t\t\t\t\tcmd.PrintErrln(\"Warning: no usable server build version metadata; using development version dev\")\n47\t\t\t\t}\n48\t\n49\t\t\t\ttoken := viper.GetString(\"personal_access_token\")\n50\t\t\t\tappID := viper.GetString(\"app-id\")\n51\t\t\t\tappInstallationID := viper.GetString(\"app-installation-id\")\n52\t\t\t\tappPrivateKeyPath := viper.GetString(\"app-private-key-path\")\n53\t\t\t\tappPrivateKeyInline := viper.GetString(\"app-private-key\")\n54\t\t\t\tappAuthRequested := appID != \"\" || appInstallationID != \"\" || appPrivateKeyPath != \"\" || appPrivateKeyInline != \"\"\n55\t\n56\t\t\t\toauthClientID := viper.GetString(\"oauth-client-id\")\n57\t\t\t\toauthClientSecret := viper.GetString(\"oauth-client-secret\")\n58\t\t\t\t// Fall back to the build-time baked-in client (official releases) when none is\n59\t\t\t\t// configured explicitly. The baked-in app is registered on github.com, so it is\n60\t\t\t\t// only applied to the default host; GHES/ghe.com users must bring their own\n61\t\t\t\t// --oauth-client-id. Recognizing the host via NormalizeHost means an explicit\n62\t\t\t\t// GITHUB_HOST=github.com (or api.github.com) still counts as the default and keeps\n63\t\t\t\t// zero-config login working. The secret tracks the id, so an explicitly provided\n64\t\t\t\t// id with no secret never picks up the baked-in secret.\n65\t\t\t\tif oauthClientID == \"\" && !appAuthRequested && oauth.NormalizeHost(viper.GetString(\"host\")) == \"https://github.com\" {\n66\t\t\t\t\toauthClientID = buildinfo.OAuthClientID\n67\t\t\t\t\toauthClientSecret = buildinfo.OAuthClientSecret\n68\t\t\t\t}\n69\t\t\t\tif token == \"\" && !appAuthRequested && oauthClientID == \"\" {\n70\t\t\t\t\treturn errors.New(\"authentication required: set GITHUB_PERSONAL_ACCESS_TOKEN, configure GitHub App auth, or pass --oauth-client-id to log in via OAuth\")\n71\t\t\t\t}\n72\t\t\t\tif appAuthRequested && token != \"\" {\n73\t\t\t\t\treturn errors.New(\"GitHub App authentication and GITHUB_PERSONAL_ACCESS_TOKEN are mutually exclusive: set only one\")\n74\t\t\t\t}\n75\t\t\t\tif appAuthRequested && oauthClientID != \"\" {\n76\t\t\t\t\treturn errors.New(\"GitHub App authentication and OAuth login (--oauth-client-id) are mutually exclusive: set only one\")\n77\t\t\t\t}\n78\t\n79\t\t\t\t// If you're wondering why we're not using viper.GetStringSlice(\"toolsets\"),\n80\t\t\t\t// it's because viper doesn't handle comma-separated values correctly for env\n81\t\t\t\t// vars when using GetStringSlice.\n82\t\t\t\t// https://github.com/spf13/viper/issues/380\n83\t\t\t\t//\n84\t\t\t\t// Additionally, viper.UnmarshalKey returns an empty slice even when the flag\n85\t\t\t\t// is not set, but we need nil to indicate \"use defaults\". So we check IsSet first.\n86\t\t\t\tvar enabledToolsets []string\n87\t\t\t\tif viper.IsSet(\"toolsets\") {\n88\t\t\t\t\tif err := viper.UnmarshalKey(\"toolsets\", &enabledToolsets); err != nil {\n89\t\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal toolsets: %w\", err)\n90\t\t\t\t\t}\n91\t\t\t\t}\n92\t\t\t\t// else: enabledToolsets stays nil, meaning \"use defaults\"\n93\t\n94\t\t\t\t// Parse tools (similar to toolsets)\n95\t\t\t\tvar enabledTools []string\n96\t\t\t\tif viper.IsSet(\"tools\") {\n97\t\t\t\t\tif err := viper.UnmarshalKey(\"tools\", &enabledTools); err != nil {\n98\t\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal tools: %w\", err)\n99\t\t\t\t\t}\n100\t\t\t\t}\n101\t\n102\t\t\t\t// Parse excluded tools (similar to tools)\n103\t\t\t\tvar excludeTools []string\n104\t\t\t\tif viper.IsSet(\"exclude_tools\") {\n105\t\t\t\t\tif err := viper.UnmarshalKey(\"exclude_tools\", &excludeTools); err != nil {\n106\t\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal exclude-tools: %w\", err)\n107\t\t\t\t\t}\n108\t\t\t\t}\n109\t\n110\t\t\t\t// Parse enabled features (similar to toolsets)\n111\t\t\t\tvar enabledFeatures []string\n112\t\t\t\tif viper.IsSet(\"features\") {\n113\t\t\t\t\tif err := viper.UnmarshalKey(\"features\", &enabledFeatures); err != nil {\n114\t\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal features: %w\", err)\n115\t\t\t\t\t}\n116\t\t\t\t}\n117\t\n118\t\t\t\tttl := viper.GetDuration(\"repo-access-cache-ttl\")\n119\t\t\t\tstdioServerConfig := ghmcp.StdioServerConfig{\n120\t\t\t\t\tVersion:              serverVersion,\n121\t\t\t\t\tHost:                 viper.GetString(\"host\"),\n122\t\t\t\t\tToken:                token,\n123\t\t\t\t\tEnabledToolsets:      enabledToolsets,\n124\t\t\t\t\tEnabledTools:         enabledTools,\n125\t\t\t\t\tEnabledFeatures:      enabledFeatures,\n126\t\t\t\t\tReadOnly:             viper.GetBool(\"read-only\"),\n127\t\t\t\t\tExportTranslations:   viper.GetBool(\"export-translations\"),\n128\t\t\t\t\tEnableCommandLogging: viper.GetBool(\"enable-command-logging\"),\n129\t\t\t\t\tLogFilePath:          viper.GetString(\"log-file\"),\n130\t\t\t\t\tContentWindowSize:    viper.GetInt(\"content-window-size\"),\n131\t\t\t\t\tLockdownMode:         viper.GetBool(\"lockdown-mode\"),\n132\t\t\t\t\tInsidersMode:         viper.GetBool(\"insiders\"),\n133\t\t\t\t\tExcludeTools:         excludeTools,\n134\t\t\t\t\tRepoAccessCacheTTL:   &ttl,\n135\t\t\t\t}\n136\t\n137\t\t\t\t// When no static token is provided, log in via OAuth using the given\n138\t\t\t\t// client. The requested scopes default to the standard set; high-risk\n139\t\t\t\t// scopes such as delete_repo require explicit --oauth-scopes opt-in.\n140\t\t\t\t// The requested set also filters tools needing other scopes.\n141\t\t\t\tif token == \"\" && !appAuthRequested {\n142\t\t\t\t\tscopes := ghoauth.DefaultScopes\n143\t\t\t\t\tif viper.IsSet(\"oauth-scopes\") {\n144\t\t\t\t\t\tif err := viper.UnmarshalKey(\"oauth-scopes\", &scopes); err != nil {\n145\t\t\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal oauth-scopes: %w\", err)\n146\t\t\t\t\t\t}\n147\t\t\t\t\t}\n148\t\t\t\t\toauthConfig := oauth.NewGitHubConfig(\n149\t\t\t\t\t\toauthClientID,\n150\t\t\t\t\t\toauthClientSecret,\n151\t\t\t\t\t\tscopes,\n152\t\t\t\t\t\tviper.GetString(\"host\"),\n153\t\t\t\t\t\tviper.GetInt(\"oauth-callback-port\"),\n154\t\t\t\t\t)\n155\t\t\t\t\tstdioServerConfig.OAuthManager = oauth.NewManager(oauthConfig, nil)\n156\t\t\t\t\tstdioServerConfig.OAuthScopes = scopes\n157\t\t\t\t}\n158\t\n159\t\t\t\tif appAuthRequested {\n160\t\t\t\t\ttokenProvider, err := newGitHubAppTokenProvider(appID, appInstallationID, appPrivateKeyPath, appPrivateKeyInline, viper.GetString(\"host\"))\n161\t\t\t\t\tif err != nil {\n162\t\t\t\t\t\treturn err\n163\t\t\t\t\t}\n164\t\t\t\t\tstdioServerConfig.TokenProvider = tokenProvider\n165\t\t\t\t}\n166\t\n167\t\t\t\treturn ghmcp.RunStdioServer(stdioServerConfig)\n168\t\t\t},\n169\t\t}\n170\t\n171\t\thttpCmd = &cobra.Command{\n172\t\t\tUse:   \"http\",\n173\t\t\tShort: \"Start HTTP server\",\n174\t\t\tLong:  `Start an HTTP server that listens for MCP requests over HTTP.`,\n175\t\t\tRunE: func(_ *cobra.Command, _ []string) error {\n176\t\t\t\t// Parse toolsets (same approach as stdio — see comment there)\n177\t\t\t\tvar enabledToolsets []string\n178\t\t\t\tif viper.IsSet(\"toolsets\") {\n179\t\t\t\t\tif err := viper.UnmarshalKey(\"toolsets\", &enabledToolsets); err != nil {\n180\t\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal toolsets: %w\", err)\n181\t\t\t\t\t}\n182\t\t\t\t}\n183\t\n184\t\t\t\tvar enabledTools []string\n185\t\t\t\tif viper.IsSet(\"tools\") {\n186\t\t\t\t\tif err := viper.UnmarshalKey(\"tools\", &enabledTools); err != nil {\n187\t\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal tools: %w\", err)\n188\t\t\t\t\t}\n189\t\t\t\t}\n190\t\n191\t\t\t\tvar excludeTools []string\n192\t\t\t\tif viper.IsSet(\"exclude_tools\") {\n193\t\t\t\t\tif err := viper.UnmarshalKey(\"exclude_tools\", &excludeTools); err != nil {\n194\t\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal exclude-tools: %w\", err)\n195\t\t\t\t\t}\n196\t\t\t\t}\n197\t\n198\t\t\t\tvar enabledFeatures []string\n199\t\t\t\tif viper.IsSet(\"features\") {\n200\t\t\t\t\tif err := viper.UnmarshalKey(\"features\", &enabledFeatures); err != nil {\n201\t\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal features: %w\", err)\n202\t\t\t\t\t}\n203\t\t\t\t}\n204\t\n205\t\t\t\tttl := viper.GetDuration(\"repo-access-cache-ttl\")\n206\t\t\t\thttpConfig := ghhttp.ServerConfig{\n207\t\t\t\t\tVersion:              version,\n208\t\t\t\t\tHost:                 viper.GetString(\"host\"),\n209\t\t\t\t\tPort:                 viper.GetInt(\"port\"),\n210\t\t\t\t\tListenHost:           viper.GetString(\"listen-host\"),\n211\t\t\t\t\tBaseURL:              viper.GetString(\"base-url\"),\n212\t\t\t\t\tResourcePath:         viper.GetString(\"base-path\"),\n213\t\t\t\t\tAuthorizationServer:  viper.GetString(\"authorization-server\"),\n214\t\t\t\t\tExportTranslations:   viper.GetBool(\"export-translations\"),\n215\t\t\t\t\tEnableCommandLogging: viper.GetBool(\"enable-command-logging\"),\n216\t\t\t\t\tLogFilePath:          viper.GetString(\"log-file\"),\n217\t\t\t\t\tContentWindowSize:    viper.GetInt(\"content-window-size\"),\n218\t\t\t\t\tLockdownMode:         viper.GetBool(\"lockdown-mode\"),\n219\t\t\t\t\tRepoAccessCacheTTL:   &ttl,\n220\t\t\t\t\tScopeChallenge:       viper.GetBool(\"scope-challenge\"),\n221\t\t\t\t\tReadOnly:             viper.GetBool(\"read-only\"),\n222\t\t\t\t\tEnabledToolsets:      enabledToolsets,\n223\t\t\t\t\tEnabledTools:         enabledTools,\n224\t\t\t\t\tExcludeTools:         excludeTools,\n225\t\t\t\t\tEnabledFeatures:      enabledFeatures,\n226\t\t\t\t\tInsidersMode:         viper.GetBool(\"insiders\"),\n227\t\t\t\t\tTrustProxyHeaders:    viper.GetBool(\"trust-proxy-headers\"),\n228\t\t\t\t\tMRTRStateKey:         os.Getenv(ghhttp.MRTRStateKeyEnv),\n229\t\t\t\t}\n230\t\n231\t\t\t\treturn ghhttp.RunHTTPServer(httpConfig)\n232\t\t\t},\n233\t\t}\n234\t)\n235\t\n236\tfunc init() {\n237\t\tcobra.OnInitialize(initConfig)\n238\t\trootCmd.SetGlobalNormalizationFunc(wordSepNormalizeFunc)\n239\t\n240\t\trootCmd.SetVersionTemplate(\"{{.Short}}\\n{{.Version}}\\n\")\n241\t\n242\t\t// Add global flags that will be shared by all commands\n243\t\trootCmd.PersistentFlags().StringSlice(\"toolsets\", nil, github.GenerateToolsetsHelp())\n244\t\trootCmd.PersistentFlags().StringSlice(\"tools\", nil, \"Comma-separated list of specific tools to enable\")\n245\t\trootCmd.PersistentFlags().StringSlice(\"exclude-tools\", nil, \"Comma-separated list of tool names to disable regardless of other settings\")\n246\t\trootCmd.PersistentFlags().StringSlice(\"features\", nil, \"Comma-separated list of feature flags to enable\")\n247\t\trootCmd.PersistentFlags().Bool(\"read-only\", false, \"Restrict the server to read-only operations\")\n248\t\trootCmd.PersistentFlags().String(\"log-file\", \"\", \"Path to log file\")\n249\t\trootCmd.PersistentFlags().Bool(\"enable-command-logging\", false, \"When enabled, the server will log all command requests and responses to the log file\")\n250\t\trootCmd.PersistentFlags().Bool(\"export-translations\", false, \"Save translations to a JSON file\")\n251\t\trootCmd.PersistentFlags().String(\"gh-host\", \"\", \"Specify the GitHub hostname (for GitHub Enterprise etc.)\")\n252\t\trootCmd.PersistentFlags().Int(\"content-window-size\", 5000, \"Specify the content window size\")\n253\t\trootCmd.PersistentFlags().Bool(\"lockdown-mode\", false, \"Enable lockdown mode\")\n254\t\trootCmd.PersistentFlags().Bool(\"insiders\", false, \"Enable insiders features\")\n255\t\trootCmd.PersistentFlags().Duration(\"repo-access-cache-ttl\", 5*time.Minute, \"Override the repo access cache TTL (e.g. 1m, 0s to disable)\")\n256\t\n257\t\t// stdio-specific OAuth flags. Provide --oauth-client-id (instead of a token)\n258\t\t// to log in via the browser-based OAuth flow on first use. Works for both\n259\t\t// OAuth Apps and GitHub Apps.\n260\t\tstdioCmd.Flags().String(\"oauth-client-id\", \"\", \"OAuth App or GitHub App client ID, enabling interactive OAuth login when no token is set\")\n261\t\tstdioCmd.Flags().String(\"oauth-client-secret\", \"\", \"OAuth client secret, if the app requires one (it is a public, non-confidential credential for distributed clients)\")\n262\t\tstdioCmd.Flags().StringSlice(\"oauth-scopes\", nil, \"Comma-separated OAuth scopes to request; also filters tools to those scopes. Defaults to the full supported set\")\n263\t\tstdioCmd.Flags().Int(\"oauth-callback-port\", 0, \"Fixed local port for the OAuth callback server. Defaults to a random port; set a fixed port when mapping it through Docker\")\n264\t\n265\t\t// The private key has no flag because passing it in argv would expose it.\n266\t\tstdioCmd.Flags().String(\"app-id\", \"\", \"GitHub App ID or client ID, enabling non-interactive server-to-server authentication\")\n267\t\tstdioCmd.Flags().String(\"app-installation-id\", \"\", \"GitHub App installation ID to mint installation access tokens for\")\n268\t\tstdioCmd.Flags().String(\"app-private-key-path\", \"\", \"Path to the GitHub App private key (PEM). Preferred over GITHUB_APP_PRIVATE_KEY: keeps the key off the command line and out of the environment\")\n269\t\n270\t\t// HTTP-specific flags\n271\t\thttpCmd.Flags().Int(\"port\", 8082, \"HTTP server port\")\n272\t\thttpCmd.Flags().String(\"listen-host\", \"\", \"Host the HTTP server binds to (e.g. 127.0.0.1). Empty binds to all interfaces.\")\n273\t\thttpCmd.Flags().String(\"base-url\", \"\", \"Base URL where this server is publicly accessible (for OAuth resource metadata)\")\n274\t\thttpCmd.Flags().String(\"base-path\", \"\", \"Externally visible base path for the HTTP server (for OAuth resource metadata)\")\n275\t\thttpCmd.Flags().String(\"authorization-server\", \"\", \"Override the authorization server URL in OAuth resource metadata. Useful when deploying behind an OAuth proxy (e.g. for GHES). Env: GITHUB_AUTHORIZATION_SERVER\")\n276\t\thttpCmd.Flags().Bool(\"scope-challenge\", false, \"Enable OAuth scope challenge responses\")\n277\t\thttpCmd.Flags().Bool(\"trust-proxy-headers\", false, \"Honor X-Forwarded-Host and X-Forwarded-Proto when constructing OAuth resource metadata URLs. Only enable when the server is deployed behind a trusted proxy that sets these headers. Ignored when --base-url is set.\")\n278\t\n279\t\t// Bind flag to viper\n280\t\t_ = viper.BindPFlag(\"toolsets\", rootCmd.PersistentFlags().Lookup(\"toolsets\"))\n281\t\t_ = viper.BindPFlag(\"tools\", rootCmd.PersistentFlags().Lookup(\"tools\"))\n282\t\t_ = viper.BindPFlag(\"exclude_tools\", rootCmd.PersistentFlags().Lookup(\"exclude-tools\"))\n283\t\t_ = viper.BindPFlag(\"features\", rootCmd.PersistentFlags().Lookup(\"features\"))\n284\t\t_ = viper.BindPFlag(\"read-only\", rootCmd.PersistentFlags().Lookup(\"read-only\"))\n285\t\t_ = viper.BindPFlag(\"log-file\", rootCmd.PersistentFlags().Lookup(\"log-file\"))\n286\t\t_ = viper.BindPFlag(\"enable-command-logging\", rootCmd.PersistentFlags().Lookup(\"enable-command-logging\"))\n287\t\t_ = viper.BindPFlag(\"export-translations\", rootCmd.PersistentFlags().Lookup(\"export-translations\"))\n288\t\t_ = viper.BindPFlag(\"host\", rootCmd.PersistentFlags().Lookup(\"gh-host\"))\n289\t\t_ = viper.BindPFlag(\"content-window-size\", rootCmd.PersistentFlags().Lookup(\"content-window-size\"))\n290\t\t_ = viper.BindPFlag(\"lockdown-mode\", rootCmd.PersistentFlags().Lookup(\"lockdown-mode\"))\n291\t\t_ = viper.BindPFlag(\"insiders\", rootCmd.PersistentFlags().Lookup(\"insiders\"))\n292\t\t_ = viper.BindPFlag(\"repo-access-cache-ttl\", rootCmd.PersistentFlags().Lookup(\"repo-access-cache-ttl\"))\n293\t\t_ = viper.BindPFlag(\"oauth-client-id\", stdioCmd.Flags().Lookup(\"oauth-client-id\"))\n294\t\t_ = viper.BindPFlag(\"oauth-client-secret\", stdioCmd.Flags().Lookup(\"oauth-client-secret\"))\n295\t\t_ = viper.BindPFlag(\"oauth-scopes\", stdioCmd.Flags().Lookup(\"oauth-scopes\"))\n296\t\t_ = viper.BindPFlag(\"oauth-callback-port\", stdioCmd.Flags().Lookup(\"oauth-callback-port\"))\n297\t\t_ = viper.BindPFlag(\"app-id\", stdioCmd.Flags().Lookup(\"app-id\"))\n298\t\t_ = viper.BindPFlag(\"app-installation-id\", stdioCmd.Flags().Lookup(\"app-installation-id\"))\n299\t\t_ = viper.BindPFlag(\"app-private-key-path\", stdioCmd.Flags().Lookup(\"app-private-key-path\"))\n300\t\t_ = viper.BindPFlag(\"port\", httpCmd.Flags().Lookup(\"port\"))\n301\t\t_ = viper.BindPFlag(\"listen-host\", httpCmd.Flags().Lookup(\"listen-host\"))\n302\t\t_ = viper.BindPFlag(\"base-url\", httpCmd.Flags().Lookup(\"base-url\"))\n303\t\t_ = viper.BindPFlag(\"base-path\", httpCmd.Flags().Lookup(\"base-path\"))\n304\t\t_ = viper.BindPFlag(\"authorization-server\", httpCmd.Flags().Lookup(\"authorization-server\"))\n305\t\t_ = viper.BindPFlag(\"scope-challenge\", httpCmd.Flags().Lookup(\"scope-challenge\"))\n306\t\t_ = viper.BindPFlag(\"trust-proxy-headers\", httpCmd.Flags().Lookup(\"trust-proxy-headers\"))\n307\t\t// Add subcommands\n308\t\trootCmd.AddCommand(stdioCmd)\n309\t\trootCmd.AddCommand(httpCmd)\n310\t}\n311\t\n312\tfunc initConfig() {\n313\t\t// Initialize Viper configuration\n314\t\tviper.SetEnvPrefix(\"github\")\n315\t\tviper.SetEnvKeyReplacer(strings.NewReplacer(\"-\", \"_\"))\n316\t\tviper.AutomaticEnv()\n317\t}\n318\t\n319\tfunc main() {\n320\t\tif err := rootCmd.Execute(); err != nil {\n321\t\t\tfmt.Fprintf(os.Stderr, \"%v\\n\", err)\n322\t\t\tos.Exit(1)\n323\t\t}\n324\t}\n325\t\n326\tfunc newGitHubAppTokenProvider(appID, installationID, keyPath, keyInline, host string) (func() string, error) {\n327\t\tkeyBytes, err := loadAppPrivateKey(keyPath, keyInline)\n328\t\tif err != nil {\n329\t\t\treturn nil, err\n330\t\t}\n331\t\n332\t\tapiHost, err := utils.NewAPIHost(host)\n333\t\tif err != nil {\n334\t\t\treturn nil, fmt.Errorf(\"failed to parse host for GitHub App authentication: %w\", err)\n335\t\t}\n336\t\trestURL, err := apiHost.BaseRESTURL(context.Background())\n337\t\tif err != nil {\n338\t\t\treturn nil, fmt.Errorf(\"failed to resolve REST URL for GitHub App authentication: %w\", err)\n339\t\t}\n340\t\n341\t\tprovider, err := githubapp.NewProvider(githubapp.Config{\n342\t\t\tAppID:          appID,\n343\t\t\tInstallationID: installationID,\n344\t\t\tPrivateKeyPEM:  keyBytes,\n345\t\t\tBaseRESTURL:    restURL.String(),\n346\t\t}, nil)\n347\t\tif err != nil {\n348\t\t\treturn nil, fmt.Errorf(\"failed to configure GitHub App authentication: %w\", err)\n349\t\t}\n350\t\treturn provider.AccessToken, nil\n351\t}\n352\t\n353\tfunc loadAppPrivateKey(path, inline string) ([]byte, error) {\n354\t\tswitch {\n355\t\tcase path != \"\":\n356\t\t\tdata, err := os.ReadFile(path) //#nosec G304 -- operator-supplied path to their own key\n357\t\t\tif err != nil {\n358\t\t\t\treturn nil, fmt.Errorf(\"reading GitHub App private key file: %w\", err)\n359\t\t\t}\n360\t\t\treturn data, nil\n361\t\tcase inline != \"\":\n362\t\t\treturn []byte(strings.ReplaceAll(inline, `\\n`, \"\\n\")), nil\n363\t\tdefault:\n364\t\t\treturn nil, errors.New(\"GitHub App authentication requires a private key: set GITHUB_APP_PRIVATE_KEY_PATH (preferred) or GITHUB_APP_PRIVATE_KEY\")\n365\t\t}\n366\t}\n367\t\n368\tfunc wordSepNormalizeFunc(_ *pflag.FlagSet, name string) pflag.NormalizedName {\n369\t\tfrom := []string{\"_\"}\n370\t\tto := \"-\"\n371\t\tfor _, sep := range from {\n372\t\t\tname = strings.ReplaceAll(name, sep, to)\n373\t\t}\n374\t\treturn pflag.NormalizedName(name)\n375\t}\n376\t"}]},"parent_tool_use_id":null,"session_id":"deaab419-c428-4eb9-8f29-49cef0e3fa03","uuid":"81b6ded4-7fd1-4d51-8837-f3e2c1dd0d0a","timestamp":"2026-10-26T10:21:46.715Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-real-mcp-review-e0ua7zjt/repo/cmd/github-mcp-server/main.go","content":"package main\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"runtime/debug\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/github/github-mcp-server/v2/internal/buildinfo\"\n\t\"github.com/github/github-mcp-server/v2/internal/ghmcp\"\n\t\"github.com/github/github-mcp-server/v2/internal/githubapp\"\n\t\"github.com/github/github-mcp-server/v2/internal/oauth\"\n\t\"github.com/github/github-mcp-server/v2/pkg/github\"\n\tghhttp \"github.com/github/github-mcp-server/v2/pkg/http\"\n\tghoauth \"github.com/github/github-mcp-server/v2/pkg/http/oauth\"\n\t\"github.com/github/github-mcp-server/v2/pkg/utils\"\n\t\"github.com/spf13/cobra\"\n\t\"github.com/spf13/pflag\"\n\t\"github.com/spf13/viper\"\n)\n\n// These variables are set by the build process using ldflags.\nvar version = \"version\"\nvar commit = \"commit\"\nvar date = \"date\"\n\nvar (\n\trootCmd = &cobra.Command{\n\t\tUse:     \"github-mcp-server\",\n\t\tShort:   \"GitHub MCP Server\",\n\t\tLong:    `A GitHub MCP server that handles various tools and resources.`,\n\t\tVersion: fmt.Sprintf(\"Version: %s\\nCommit: %s\\nBuild Date: %s\", version, commit, date),\n\t}\n\n\tstdioCmd = &cobra.Command{\n\t\tUse:   \"stdio\",\n\t\tShort: \"Start stdio server\",\n\t\tLong:  `Start a server that communicates via standard input/output streams using JSON-RPC messages.`,\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\tinfo, _ := debug.ReadBuildInfo()\n\t\t\tserverVersion := resolveServerVersion(version, commit, info)\n\t\t\tif serverVersion == developmentServerVersion {\n\t\t\t\tcmd.PrintErrln(\"Warning: no usable server build version metadata; using development version dev\")\n\t\t\t}\n\n\t\t\ttoken := viper.GetString(\"personal_access_token\")\n\t\t\tappID := viper.GetString(\"app-id\")\n\t\t\tappInstallationID := viper.GetString(\"app-installation-id\")\n\t\t\tappPrivateKeyPath := viper.GetString(\"app-private-key-path\")\n\t\t\tappPrivateKeyInline := viper.GetString(\"app-private-key\")\n\t\t\tappAuthRequested := appID != \"\" || appInstallationID != \"\" || appPrivateKeyPath != \"\" || appPrivateKeyInline != \"\"\n\n\t\t\toauthClientID := viper.GetString(\"oauth-client-id\")\n\t\t\toauthClientSecret := viper.GetString(\"oauth-client-secret\")\n\t\t\t// Fall back to the build-time baked-in client (official releases) when none is\n\t\t\t// configured explicitly. The baked-in app is registered on github.com, so it is\n\t\t\t// only applied to the default host; GHES/ghe.com users must bring their own\n\t\t\t// --oauth-client-id. Recognizing the host via NormalizeHost means an explicit\n\t\t\t// GITHUB_HOST=github.com (or api.github.com) still counts as the default and keeps\n\t\t\t// zero-config login working. The secret tracks the id, so an explicitly provided\n\t\t\t// id with no secret never picks up the baked-in secret.\n\t\t\tif oauthClientID == \"\" && !appAuthRequested && oauth.NormalizeHost(viper.GetString(\"host\")) == \"https://github.com\" {\n\t\t\t\toauthClientID = buildinfo.OAuthClientID\n\t\t\t\toauthClientSecret = buildinfo.OAuthClientSecret\n\t\t\t}\n\t\t\tif token == \"\" && !appAuthRequested && oauthClientID == \"\" {\n\t\t\t\treturn errors.New(\"authentication required: set GITHUB_PERSONAL_ACCESS_TOKEN, configure GitHub App auth, or pass --oauth-client-id to log in via OAuth\")\n\t\t\t}\n\t\t\tif appAuthRequested && token != \"\" {\n\t\t\t\treturn errors.New(\"GitHub App authentication and GITHUB_PERSONAL_ACCESS_TOKEN are mutually exclusive: set only one\")\n\t\t\t}\n\t\t\tif appAuthRequested && oauthClientID != \"\" {\n\t\t\t\treturn errors.New(\"GitHub App authentication and OAuth login (--oauth-client-id) are mutually exclusive: set only one\")\n\t\t\t}\n\n\t\t\t// If you're wondering why we're not using viper.GetStringSlice(\"toolsets\"),\n\t\t\t// it's because viper doesn't handle comma-separated values correctly for env\n\t\t\t// vars when using GetStringSlice.\n\t\t\t// https://github.com/spf13/viper/issues/380\n\t\t\t//\n\t\t\t// Additionally, viper.UnmarshalKey returns an empty slice even when the flag\n\t\t\t// is not set, but we need nil to indicate \"use defaults\". So we check IsSet first.\n\t\t\tvar enabledToolsets []string\n\t\t\tif viper.IsSet(\"toolsets\") {\n\t\t\t\tif err := viper.UnmarshalKey(\"toolsets\", &enabledToolsets); err != nil {\n\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal toolsets: %w\", err)\n\t\t\t\t}\n\t\t\t}\n\t\t\t// else: enabledToolsets stays nil, meaning \"use defaults\"\n\n\t\t\t// Parse tools (similar to toolsets)\n\t\t\tvar enabledTools []string\n\t\t\tif viper.IsSet(\"tools\") {\n\t\t\t\tif err := viper.UnmarshalKey(\"tools\", &enabledTools); err != nil {\n\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal tools: %w\", err)\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t// Parse excluded tools (similar to tools)\n\t\t\tvar excludeTools []string\n\t\t\tif viper.IsSet(\"exclude_tools\") {\n\t\t\t\tif err := viper.UnmarshalKey(\"exclude_tools\", &excludeTools); err != nil {\n\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal exclude-tools: %w\", err)\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t// Parse enabled features (similar to toolsets)\n\t\t\tvar enabledFeatures []string\n\t\t\tif viper.IsSet(\"features\") {\n\t\t\t\tif err := viper.UnmarshalKey(\"features\", &enabledFeatures); err != nil {\n\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal features: %w\", err)\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tttl := viper.GetDuration(\"repo-access-cache-ttl\")\n\t\t\tstdioServerConfig := ghmcp.StdioServerConfig{\n\t\t\t\tVersion:              serverVersion,\n\t\t\t\tHost:                 viper.GetString(\"host\"),\n\t\t\t\tToken:                token,\n\t\t\t\tEnabledToolsets:      enabledToolsets,\n\t\t\t\tEnabledTools:         enabledTools,\n\t\t\t\tEnabledFeatures:      enabledFeatures,\n\t\t\t\tReadOnly:             viper.GetBool(\"read-only\"),\n\t\t\t\tExportTranslations:   viper.GetBool(\"export-translations\"),\n\t\t\t\tEnableCommandLogging: viper.GetBool(\"enable-command-logging\"),\n\t\t\t\tLogFilePath:          viper.GetString(\"log-file\"),\n\t\t\t\tContentWindowSize:    viper.GetInt(\"content-window-size\"),\n\t\t\t\tLockdownMode:         viper.GetBool(\"lockdown-mode\"),\n\t\t\t\tInsidersMode:         viper.GetBool(\"insiders\"),\n\t\t\t\tExcludeTools:         excludeTools,\n\t\t\t\tRepoAccessCacheTTL:   &ttl,\n\t\t\t}\n\n\t\t\t// When no static token is provided, log in via OAuth using the given\n\t\t\t// client. The requested scopes default to the standard set; high-risk\n\t\t\t// scopes such as delete_repo require explicit --oauth-scopes opt-in.\n\t\t\t// The requested set also filters tools needing other scopes.\n\t\t\tif token == \"\" && !appAuthRequested {\n\t\t\t\tscopes := ghoauth.DefaultScopes\n\t\t\t\tif viper.IsSet(\"oauth-scopes\") {\n\t\t\t\t\tif err := viper.UnmarshalKey(\"oauth-scopes\", &scopes); err != nil {\n\t\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal oauth-scopes: %w\", err)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\toauthConfig := oauth.NewGitHubConfig(\n\t\t\t\t\toauthClientID,\n\t\t\t\t\toauthClientSecret,\n\t\t\t\t\tscopes,\n\t\t\t\t\tviper.GetString(\"host\"),\n\t\t\t\t\tviper.GetInt(\"oauth-callback-port\"),\n\t\t\t\t)\n\t\t\t\tstdioServerConfig.OAuthManager = oauth.NewManager(oauthConfig, nil)\n\t\t\t\tstdioServerConfig.OAuthScopes = scopes\n\t\t\t}\n\n\t\t\tif appAuthRequested {\n\t\t\t\ttokenProvider, err := newGitHubAppTokenProvider(appID, appInstallationID, appPrivateKeyPath, appPrivateKeyInline, viper.GetString(\"host\"))\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn err\n\t\t\t\t}\n\t\t\t\tstdioServerConfig.TokenProvider = tokenProvider\n\t\t\t}\n\n\t\t\treturn ghmcp.RunStdioServer(stdioServerConfig)\n\t\t},\n\t}\n\n\thttpCmd = &cobra.Command{\n\t\tUse:   \"http\",\n\t\tShort: \"Start HTTP server\",\n\t\tLong:  `Start an HTTP server that listens for MCP requests over HTTP.`,\n\t\tRunE: func(_ *cobra.Command, _ []string) error {\n\t\t\t// Parse toolsets (same approach as stdio — see comment there)\n\t\t\tvar enabledToolsets []string\n\t\t\tif viper.IsSet(\"toolsets\") {\n\t\t\t\tif err := viper.UnmarshalKey(\"toolsets\", &enabledToolsets); err != nil {\n\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal toolsets: %w\", err)\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tvar enabledTools []string\n\t\t\tif viper.IsSet(\"tools\") {\n\t\t\t\tif err := viper.UnmarshalKey(\"tools\", &enabledTools); err != nil {\n\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal tools: %w\", err)\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tvar excludeTools []string\n\t\t\tif viper.IsSet(\"exclude_tools\") {\n\t\t\t\tif err := viper.UnmarshalKey(\"exclude_tools\", &excludeTools); err != nil {\n\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal exclude-tools: %w\", err)\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tvar enabledFeatures []string\n\t\t\tif viper.IsSet(\"features\") {\n\t\t\t\tif err := viper.UnmarshalKey(\"features\", &enabledFeatures); err != nil {\n\t\t\t\t\treturn fmt.Errorf(\"failed to unmarshal features: %w\", err)\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tttl := viper.GetDuration(\"repo-access-cache-ttl\")\n\t\t\thttpConfig := ghhttp.ServerConfig{\n\t\t\t\tVersion:              version,\n\t\t\t\tHost:                 viper.GetString(\"host\"),\n\t\t\t\tPort:                 viper.GetInt(\"port\"),\n\t\t\t\tListenHost:           viper.GetString(\"listen-host\"),\n\t\t\t\tBaseURL:              viper.GetString(\"base-url\"),\n\t\t\t\tResourcePath:         viper.GetString(\"base-path\"),\n\t\t\t\tAuthorizationServer:  viper.GetString(\"authorization-server\"),\n\t\t\t\tExportTranslations:   viper.GetBool(\"export-translations\"),\n\t\t\t\tEnableCommandLogging: viper.GetBool(\"enable-command-logging\"),\n\t\t\t\tLogFilePath:          viper.GetString(\"log-file\"),\n\t\t\t\tContentWindowSize:    viper.GetInt(\"content-window-size\"),\n\t\t\t\tLockdownMode:         viper.GetBool(\"lockdown-mode\"),\n\t\t\t\tRepoAccessCacheTTL:   &ttl,\n\t\t\t\tScopeChallenge:       viper.GetBool(\"scope-challenge\"),\n\t\t\t\tReadOnly:             viper.GetBool(\"read-only\"),\n\t\t\t\tEnabledToolsets:      enabledToolsets,\n\t\t\t\tEnabledTools:         enabledTools,\n\t\t\t\tExcludeTools:         excludeTools,\n\t\t\t\tEnabledFeatures:      enabledFeatures,\n\t\t\t\tInsidersMode:         viper.GetBool(\"insiders\"),\n\t\t\t\tTrustProxyHeaders:    viper.GetBool(\"trust-proxy-headers\"),\n\t\t\t\tMRTRStateKey:         os.Getenv(ghhttp.MRTRStateKeyEnv),\n\t\t\t}\n\n\t\t\treturn ghhttp.RunHTTPServer(httpConfig)\n\t\t},\n\t}\n)\n\nfunc init() {\n\tcobra.OnInitialize(initConfig)\n\trootCmd.SetGlobalNormalizationFunc(wordSepNormalizeFunc)\n\n\trootCmd.SetVersionTemplate(\"{{.Short}}\\n{{.Version}}\\n\")\n\n\t// Add global flags that will be shared by all commands\n\trootCmd.PersistentFlags().StringSlice(\"toolsets\", nil, github.GenerateToolsetsHelp())\n\trootCmd.PersistentFlags().StringSlice(\"tools\", nil, \"Comma-separated list of specific tools to enable\")\n\trootCmd.PersistentFlags().StringSlice(\"exclude-tools\", nil, \"Comma-separated list of tool names to disable regardless of other settings\")\n\trootCmd.PersistentFlags().StringSlice(\"features\", nil, \"Comma-separated list of feature flags to enable\")\n\trootCmd.PersistentFlags().Bool(\"read-only\", false, \"Restrict the server to read-only operations\")\n\trootCmd.PersistentFlags().String(\"log-file\", \"\", \"Path to log file\")\n\trootCmd.PersistentFlags().Bool(\"enable-command-logging\", false, \"When enabled, the server will log all command requests and responses to the log file\")\n\trootCmd.PersistentFlags().Bool(\"export-translations\", false, \"Save translations to a JSON file\")\n\trootCmd.PersistentFlags().String(\"gh-host\", \"\", \"Specify the GitHub hostname (for GitHub Enterprise etc.)\")\n\trootCmd.PersistentFlags().Int(\"content-window-size\", 5000, \"Specify the content window size\")\n\trootCmd.PersistentFlags().Bool(\"lockdown-mode\", false, \"Enable lockdown mode\")\n\trootCmd.PersistentFlags().Bool(\"insiders\", false, \"Enable insiders features\")\n\trootCmd.PersistentFlags().Duration(\"repo-access-cache-ttl\", 5*time.Minute, \"Override the repo access cache TTL (e.g. 1m, 0s to disable)\")\n\n\t// stdio-specific OAuth flags. Provide --oauth-client-id (instead of a token)\n\t// to log in via the browser-based OAuth flow on first use. Works for both\n\t// OAuth Apps and GitHub Apps.\n\tstdioCmd.Flags().String(\"oauth-client-id\", \"\", \"OAuth App or GitHub App client ID, enabling interactive OAuth login when no token is set\")\n\tstdioCmd.Flags().String(\"oauth-client-secret\", \"\", \"OAuth client secret, if the app requires one (it is a public, non-confidential credential for distributed clients)\")\n\tstdioCmd.Flags().StringSlice(\"oauth-scopes\", nil, \"Comma-separated OAuth scopes to request; also filters tools to those scopes. Defaults to the full supported set\")\n\tstdioCmd.Flags().Int(\"oauth-callback-port\", 0, \"Fixed local port for the OAuth callback server. Defaults to a random port; set a fixed port when mapping it through Docker\")\n\n\t// The private key has no flag because passing it in argv would expose it.\n\tstdioCmd.Flags().String(\"app-id\", \"\", \"GitHub App ID or client ID, enabling non-interactive server-to-server authentication\")\n\tstdioCmd.Flags().String(\"app-installation-id\", \"\", \"GitHub App installation ID to mint installation access tokens for\")\n\tstdioCmd.Flags().String(\"app-private-key-path\", \"\", \"Path to the GitHub App private key (PEM). Preferred over GITHUB_APP_PRIVATE_KEY: keeps the key off the command line and out of the environment\")\n\n\t// HTTP-specific flags\n\thttpCmd.Flags().Int(\"port\", 8082, \"HTTP server port\")\n\thttpCmd.Flags().String(\"listen-host\", \"\", \"Host the HTTP server binds to (e.g. 127.0.0.1). Empty binds to all interfaces.\")\n\thttpCmd.Flags().String(\"base-url\", \"\", \"Base URL where this server is publicly accessible (for OAuth resource metadata)\")\n\thttpCmd.Flags().String(\"base-path\", \"\", \"Externally visible base path for the HTTP server (for OAuth resource metadata)\")\n\thttpCmd.Flags().String(\"authorization-server\", \"\", \"Override the authorization server URL in OAuth resource metadata. Useful when deploying behind an OAuth proxy (e.g. for GHES). Env: GITHUB_AUTHORIZATION_SERVER\")\n\thttpCmd.Flags().Bool(\"scope-challenge\", false, \"Enable OAuth scope challenge responses\")\n\thttpCmd.Flags().Bool(\"trust-proxy-headers\", false, \"Honor X-Forwarded-Host and X-Forwarded-Proto when constructing OAuth resource metadata URLs. Only enable when the server is deployed behind a trusted proxy that sets these headers. Ignored when --base-url is set.\")\n\n\t// Bind flag to viper\n\t_ = viper.BindPFlag(\"toolsets\", rootCmd.PersistentFlags().Lookup(\"toolsets\"))\n\t_ = viper.BindPFlag(\"tools\", rootCmd.PersistentFlags().Lookup(\"tools\"))\n\t_ = viper.BindPFlag(\"exclude_tools\", rootCmd.PersistentFlags().Lookup(\"exclude-tools\"))\n\t_ = viper.BindPFlag(\"features\", rootCmd.PersistentFlags().Lookup(\"features\"))\n\t_ = viper.BindPFlag(\"read-only\", rootCmd.PersistentFlags().Lookup(\"read-only\"))\n\t_ = viper.BindPFlag(\"log-file\", rootCmd.PersistentFlags().Lookup(\"log-file\"))\n\t_ = viper.BindPFlag(\"enable-command-logging\", rootCmd.PersistentFlags().Lookup(\"enable-command-logging\"))\n\t_ = viper.BindPFlag(\"export-translations\", rootCmd.PersistentFlags().Lookup(\"export-translations\"))\n\t_ = viper.BindPFlag(\"host\", rootCmd.PersistentFlags().Lookup(\"gh-host\"))\n\t_ = viper.BindPFlag(\"content-window-size\", rootCmd.PersistentFlags().Lookup(\"content-window-size\"))\n\t_ = viper.BindPFlag(\"lockdown-mode\", rootCmd.PersistentFlags().Lookup(\"lockdown-mode\"))\n\t_ = viper.BindPFlag(\"insiders\", rootCmd.PersistentFlags().Lookup(\"insiders\"))\n\t_ = viper.BindPFlag(\"repo-access-cache-ttl\", rootCmd.PersistentFlags().Lookup(\"repo-access-cache-ttl\"))\n\t_ = viper.BindPFlag(\"oauth-client-id\", stdioCmd.Flags().Lookup(\"oauth-client-id\"))\n\t_ = viper.BindPFlag(\"oauth-client-secret\", stdioCmd.Flags().Lookup(\"oauth-client-secret\"))\n\t_ = viper.BindPFlag(\"oauth-scopes\", stdioCmd.Flags().Lookup(\"oauth-scopes\"))\n\t_ = viper.BindPFlag(\"oauth-callback-port\", stdioCmd.Flags().Lookup(\"oauth-callback-port\"))\n\t_ = viper.BindPFlag(\"app-id\", stdioCmd.Flags().Lookup(\"app-id\"))\n\t_ = viper.BindPFlag(\"app-installation-id\", stdioCmd.Flags().Lookup(\"app-installation-id\"))\n\t_ = viper.BindPFlag(\"app-private-key-path\", stdioCmd.Flags().Lookup(\"app-private-key-path\"))\n\t_ = viper.BindPFlag(\"port\", httpCmd.Flags().Lookup(\"port\"))\n\t_ = viper.BindPFlag(\"listen-host\", httpCmd.Flags().Lookup(\"listen-host\"))\n\t_ = viper.BindPFlag(\"base-url\", httpCmd.Flags().Lookup(\"base-url\"))\n\t_ = viper.BindPFlag(\"base-path\", httpCmd.Flags().Lookup(\"base-path\"))\n\t_ = viper.BindPFlag(\"authorization-server\", httpCmd.Flags().Lookup(\"authorization-server\"))\n\t_ = viper.BindPFlag(\"scope-challenge\", httpCmd.Flags().Lookup(\"scope-challenge\"))\n\t_ = viper.BindPFlag(\"trust-proxy-headers\", httpCmd.Flags().Lookup(\"trust-proxy-headers\"))\n\t// Add subcommands\n\trootCmd.AddCommand(stdioCmd)\n\trootCmd.AddCommand(httpCmd)\n}\n\nfunc initConfig() {\n\t// Initialize Viper configuration\n\tviper.SetEnvPrefix(\"github\")\n\tviper.SetEnvKeyReplacer(strings.NewReplacer(\"-\", \"_\"))\n\tviper.AutomaticEnv()\n}\n\nfunc main() {\n\tif err := rootCmd.Execute(); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"%v\\n\", err)\n\t\tos.Exit(1)\n\t}\n}\n\nfunc newGitHubAppTokenProvider(appID, installationID, keyPath, keyInline, host string) (func() string, error) {\n\tkeyBytes, err := loadAppPrivateKey(keyPath, keyInline)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\tapiHost, err := utils.NewAPIHost(host)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to parse host for GitHub App authentication: %w\", err)\n\t}\n\trestURL, err := apiHost.BaseRESTURL(context.Background())\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to resolve REST URL for GitHub App authentication: %w\", err)\n\t}\n\n\tprovider, err := githubapp.NewProvider(githubapp.Config{\n\t\tAppID:          appID,\n\t\tInstallationID: installationID,\n\t\tPrivateKeyPEM:  keyBytes,\n\t\tBaseRESTURL:    restURL.String(),\n\t}, nil)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to configure GitHub App authentication: %w\", err)\n\t}\n\treturn provider.AccessToken, nil\n}\n\nfunc loadAppPrivateKey(path, inline string) ([]byte, error) {\n\tswitch {\n\tcase path != \"\":\n\t\tdata, err := os.ReadFile(path) //#nosec G304 -- operator-supplied path to their own key\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"reading GitHub App private key file: %w\", err)\n\t\t}\n\t\treturn data, nil\n\tcase inline != \"\":\n\t\treturn []byte(strings.ReplaceAll(inline, `\\n`, \"\\n\")), nil\n\tdefault:\n\t\treturn nil, errors.New(\"GitHub App authentication requires a private key: set GITHUB_APP_PRIVATE_KEY_PATH (preferred) or GITHUB_APP_PRIVATE_KEY\")\n\t}\n}\n\nfunc wordSepNormalizeFunc(_ *pflag.FlagSet, name string) pflag.NormalizedName {\n\tfrom := []string{\"_\"}\n\tto := \"-\"\n\tfor _, sep := range from {\n\t\tname = strings.ReplaceAll(name, sep, to)\n\t}\n\treturn pflag.NormalizedName(name)\n}\n","numLines":376,"startLine":1,"totalLines":376}},"tool_result_meta":[{"id":"toolu_01TE1NvG6SuhtM6LZUmUGzKW","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
