 ai_review_label: \"request ai review\"\n          issue_number: ${{ github.event.issue.number }}\n          issue_body: ${{ github.event.issue.body }}\n          prompts_directory: \".github/prompts\"\n          labels_to_prompts_mapping: \"bug,bug-report-review.prompt.yml|default,default-issue-review.prompt.yml\"\n","numLines":28,"startLine":1,"totalLines":28}},"tool_result_meta":[{"id":"toolu_01DvyQDemcPPTdyWigGCfjEL","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
