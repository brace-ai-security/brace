{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RuErSs3hNz3pbn7VTSY8nc","type":"tool_result","content":"1\tpackage ghmcp\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"fmt\"\n6\t\t\"io\"\n7\t\t\"log/slog\"\n8\t\t\"net/http\"\n9\t\t\"os\"\n10\t\t\"os/signal\"\n11\t\t\"strconv\"\n12\t\t\"strings\"\n13\t\t\"syscall\"\n14\t\t\"time\"\n15\t\n16\t\t\"github.com/github/github-mcp-server/v2/internal/oauth\"\n17\t\t\"github.com/github/github-mcp-server/v2/internal/requeststate\"\n18\t\t\"github.com/github/github-mcp-server/v2/pkg/errors\"\n19\t\t\"github.com/github/github-mcp-server/v2/pkg/github\"\n20\t\t\"github.com/github/github-mcp-server/v2/pkg/http/transport\"\n21\t\t\"github.com/github/github-mcp-server/v2/pkg/inventory\"\n22\t\t\"github.com/github/github-mcp-server/v2/pkg/lockdown\"\n23\t\tmcplog \"github.com/github/github-mcp-server/v2/pkg/log\"\n24\t\t\"github.com/github/github-mcp-server/v2/pkg/observability\"\n25\t\t\"github.com/github/github-mcp-server/v2/pkg/observability/metrics\"\n26\t\t\"github.com/github/github-mcp-server/v2/pkg/raw\"\n27\t\t\"github.com/github/github-mcp-server/v2/pkg/scopes\"\n28\t\t\"github.com/github/github-mcp-server/v2/pkg/translations\"\n29\t\t\"github.com/github/github-mcp-server/v2/pkg/utils\"\n30\t\tgogithub \"github.com/google/go-github/v92/github\"\n31\t\t\"github.com/modelcontextprotocol/go-sdk/mcp\"\n32\t\t\"github.com/shurcooL/githubv4\"\n33\t)\n34\t\n35\t// githubClients holds all the GitHub API clients created for a server instance.\n36\ttype githubClients struct {\n37\t\trest       *gogithub.Client\n38\t\tgql        *githubv4.Client\n39\t\traw        *raw.Client\n40\t\trepoAccess *lockdown.RepoAccessCache\n41\t}\n42\t\n43\t// createGitHubClients creates all the GitHub API clients needed by the server.\n44\tfunc createGitHubClients(cfg github.MCPServerConfig, apiHost utils.APIHostResolver) (*githubClients, error) {\n45\t\trestURL, err := apiHost.BaseRESTURL(context.Background())\n46\t\tif err != nil {\n47\t\t\treturn nil, fmt.Errorf(\"failed to get base REST URL: %w\", err)\n48\t\t}\n49\t\n50\t\tuploadURL, err := apiHost.UploadURL(context.Background())\n51\t\tif err != nil {\n52\t\t\treturn nil, fmt.Errorf(\"failed to get upload URL: %w\", err)\n53\t\t}\n54\t\n55\t\tgraphQLURL, err := apiHost.GraphqlURL(context.Background())\n56\t\tif err != nil {\n57\t\t\treturn nil, fmt.Errorf(\"failed to get GraphQL URL: %w\", err)\n58\t\t}\n59\t\n60\t\trawURL, err := apiHost.RawURL(context.Background())\n61\t\tif err != nil {\n62\t\t\treturn nil, fmt.Errorf(\"failed to get Raw URL: %w\", err)\n63\t\t}\n64\t\n65\t\t// allowedHosts scopes the bearer token to the configured GitHub hosts, so a\n66\t\t// response that redirects off them does not carry the token to the redirect\n67\t\t// target. See transport.BearerAuthTransport.\n68\t\tallowedHosts := []string{\n69\t\t\trestURL.Host,\n70\t\t\tuploadURL.Host,\n71\t\t\tgraphQLURL.Host,\n72\t\t\trawURL.Host,\n73\t\t}\n74\t\n75\t\t// Construct REST client. BearerAuthTransport handles both static and\n76\t\t// provider-backed tokens so every authentication mode uses the same host\n77\t\t// restrictions.\n78\t\t//\n79\t\t// ETagTransport sits below the user-agent (and auth) layers so that, by the\n80\t\t// time it runs, the Authorization header is set and can scope the\n81\t\t// conditional-request cache per token. It adds ETag/If-None-Match handling\n82\t\t// so unchanged resources are revalidated with a 304 instead of being\n83\t\t// re-downloaded in full.\n84\t\t//\n85\t\t// The conditional-request cache is enabled only for the REST API client on\n86\t\t// this long-lived local (stdio) server. The raw-content client below uses a\n87\t\t// separate transport without it, so large file bodies are never buffered\n88\t\t// into the cache. The hosted, horizontally-scaled server builds a fresh REST\n89\t\t// client per request (see pkg/github RequestDeps) and does not use this path.\n90\t\trestUATransport := &transport.UserAgentTransport{\n91\t\t\tTransport: &transport.ETagTransport{Transport: http.DefaultTransport},\n92\t\t\tAgent:     stdioUserAgent(cfg, nil),\n93\t\t}\n94\t\trestClient, err := newRESTClient(cfg, restUATransport, restURL.String(), uploadURL.String(), allowedHosts)\n95\t\tif err != nil {\n96\t\t\treturn nil, fmt.Errorf(\"failed to create REST client: %w\", err)\n97\t\t}\n98\t\n99\t\t// Construct GraphQL client\n100\t\t// We use NewEnterpriseClient unconditionally since we already parsed the API host\n101\t\tgqlHTTPClient := &http.Client{\n102\t\t\tTransport: &transport.BearerAuthTransport{\n103\t\t\t\tTransport: &transport.GraphQLFeaturesTransport{\n104\t\t\t\t\tTransport: &transport.UserAgentTransport{\n105\t\t\t\t\t\tTransport: http.DefaultTransport,\n106\t\t\t\t\t\tAgent:     stdioUserAgent(cfg, nil),\n107\t\t\t\t\t},\n108\t\t\t\t},\n109\t\t\t\tToken:         cfg.Token,\n110\t\t\t\tTokenProvider: cfg.TokenProvider,\n111\t\t\t\tAllowedHosts:  allowedHosts,\n112\t\t\t},\n113\t\t}\n114\t\n115\t\tgqlClient := githubv4.NewEnterpriseClient(graphQLURL.String(), gqlHTTPClient)\n116\t\n117\t\t// Create raw content client. It shares the REST client's authentication but\n118\t\t// uses a transport without the conditional-request cache: raw file bodies can\n119\t\t// be large and are streamed rather than retained in memory.\n120\t\trawUATransport := &transport.UserAgentTransport{\n121\t\t\tTransport: http.DefaultTransport,\n122\t\t\tAgent:     stdioUserAgent(cfg, nil),\n123\t\t}\n124\t\trawRESTClient, err := newRESTClient(cfg, rawUATransport, restURL.String(), uploadURL.String(), allowedHosts)\n125\t\tif err != nil {\n126\t\t\treturn nil, fmt.Errorf(\"failed to create raw REST client: %w\", err)\n127\t\t}\n128\t\trawClient, err := raw.NewClient(rawRESTClient, rawURL)\n129\t\tif err != nil {\n130\t\t\treturn nil, fmt.Errorf(\"failed to create raw client: %w\", err)\n131\t\t}\n132\t\n133\t\t// Set up repo access cache for lockdown mode\n134\t\tvar repoAccessCache *lockdown.RepoAccessCache\n135\t\tif cfg.LockdownMode {\n136\t\t\topts := []lockdown.RepoAccessOption{\n137\t\t\t\tlockdown.WithLogger(cfg.Logger.With(\"component\", \"lockdown\")),\n138\t\t\t}\n139\t\t\tif cfg.RepoAccessTTL != nil {\n140\t\t\t\topts = append(opts, lockdown.WithTTL(*cfg.RepoAccessTTL))\n141\t\t\t}\n142\t\t\trepoAccessCache = lockdown.NewRepoAccessCache(gqlClient, restClient, opts...)\n143\t\t}\n144\t\n145\t\treturn &githubClients{\n146\t\t\trest:       restClient,\n147\t\t\tgql:        gqlClient,\n148\t\t\traw:        rawClient,\n149\t\t\trepoAccess: repoAccessCache,\n150\t\t}, nil\n151\t}\n152\t\n153\t// newRESTClient builds a go-github REST client that sends requests through the\n154\t// supplied user-agent transport. Authentication uses BearerAuthTransport for\n155\t// both static and provider-backed tokens, and allowedHosts scopes the token to\n156\t// the configured GitHub hosts so it is never leaked to off-host redirects.\n157\tfunc newRESTClient(cfg github.MCPServerConfig, uaTransport *transport.UserAgentTransport, restURL, uploadURL string, allowedHosts []string) (*gogithub.Client, error) {\n158\t\treturn gogithub.NewClient(\n159\t\t\tgogithub.WithHTTPClient(&http.Client{Transport: &transport.BearerAuthTransport{\n160\t\t\t\tTransport:     uaTransport,\n161\t\t\t\tToken:         cfg.Token,\n162\t\t\t\tTokenProvider: cfg.TokenProvider,\n163\t\t\t\tAllowedHosts:  allowedHosts,\n164\t\t\t}}),\n165\t\t\tgogithub.WithEnterpriseURLs(restURL, uploadURL),\n166\t\t)\n167\t}\n168\t\n169\tfunc NewStdioMCPServer(ctx context.Context, cfg github.MCPServerConfig) (*mcp.Server, error) {\n170\t\tapiHost, err := utils.NewAPIHost(cfg.Host)\n171\t\tif err != nil {\n172\t\t\treturn nil, fmt.Errorf(\"failed to parse API host: %w\", err)\n173\t\t}\n174\t\n175\t\thostType, err := utils.ParseHostType(cfg.Host)\n176\t\tif err != nil {\n177\t\t\treturn nil, fmt.Errorf(\"failed to classify API host: %w\", err)\n178\t\t}\n179\t\n180\t\tclients, err := createGitHubClients(cfg, apiHost)\n181\t\tif err != nil {\n182\t\t\treturn nil, fmt.Errorf(\"failed to create GitHub clients: %w\", err)\n183\t\t}\n184\t\n185\t\t// Create feature checker — resolves explicit features + insiders expansion\n186\t\tfeatureChecker := createFeatureChecker(cfg.EnabledFeatures, cfg.InsidersMode)\n187\t\n188\t\t// Create dependencies for tool handlers\n189\t\tobs, err := observability.NewExporters(cfg.Logger, metrics.NewNoopMetrics())\n190\t\tif err != nil {\n191\t\t\treturn nil, fmt.Errorf(\"failed to create observability exporters: %w\", err)\n192\t\t}\n193\t\tdeps := github.NewBaseDeps(\n194\t\t\tclients.rest,\n195\t\t\tclients.gql,\n196\t\t\tclients.raw,\n197\t\t\tclients.repoAccess,\n198\t\t\tcfg.Translator,\n199\t\t\tgithub.FeatureFlags{\n200\t\t\t\tLockdownMode: cfg.LockdownMode,\n201\t\t\t},\n202\t\t\tcfg.ContentWindowSize,\n203\t\t\tfeatureChecker,\n204\t\t\tobs,\n205\t\t)\n206\t\tdeps.StateSealer, err = requeststate.NewRandom()\n207\t\tif err != nil {\n208\t\t\treturn nil, fmt.Errorf(\"failed to configure request-state protection: %w\", err)\n209\t\t}\n210\t\t// Build and register the tool/resource/prompt inventory\n211\t\tinventoryBuilder := github.NewInventory(cfg.Translator, github.WithHost(hostType)).\n212\t\t\tWithDeprecatedAliases(github.DeprecatedToolAliases).\n213\t\t\tWithReadOnly(cfg.ReadOnly).\n214\t\t\tWithToolsets(github.ResolvedEnabledToolsets(cfg.EnabledToolsets, cfg.EnabledTools)).\n215\t\t\tWithTools(github.CleanTools(cfg.EnabledTools)).\n216\t\t\tWithExcludeTools(cfg.ExcludeTools).\n217\t\t\tWithServerInstructions().\n218\t\t\tWithFeatureChecker(featureChecker)\n219\t\n220\t\t// Apply token scope filtering if scopes are known (for PAT filtering)\n221\t\tif cfg.TokenScopes != nil {\n222\t\t\tinventoryBuilder = inventoryBuilder.WithFilter(github.CreateToolScopeFilter(cfg.TokenScopes))\n223\t\t}\n224\t\n225\t\tinventory, err := inventoryBuilder.Build()\n226\t\tif err != nil {\n227\t\t\treturn nil, fmt.Errorf(\"failed to build inventory: %w\", err)\n228\t\t}\n229\t\n230\t\tghServer, err := github.NewMCPServer(ctx, &cfg, deps, inventory)\n231\t\tif err != nil {\n232\t\t\treturn nil, fmt.Errorf(\"failed to create GitHub MCP server: %w\", err)\n233\t\t}\n234\t\n235\t\tghServer.AddReceivingMiddleware(addUserAgentsMiddleware(cfg))\n236\t\n237\t\treturn ghServer, nil\n238\t}\n239\t\n240\ttype StdioServerConfig struct {\n241\t\t// Version of the server\n242\t\tVersion string\n243\t\n244\t\t// GitHub Host to target for API requests (e.g. github.com or github.enterprise.com)\n245\t\tHost string\n246\t\n247\t\t// GitHub Token to authenticate with the GitHub API\n248\t\tToken string\n249\t\n250\t\t// EnabledToolsets is a list of toolsets to enable\n251\t\t// See: https://github.com/github/github-mcp-server?tab=readme-ov-file#tool-configuration\n252\t\tEnabledToolsets []string\n253\t\n254\t\t// EnabledTools is a list of specific tools to enable (additive to toolsets)\n255\t\t// When specified, these tools are registered in addition to any specified toolset tools\n256\t\tEnabledTools []string\n257\t\n258\t\t// EnabledFeatures is a list of feature flags that are enabled\n259\t\t// Tool feature rules evaluate entries in this list.\n260\t\tEnabledFeatures []string\n261\t\n262\t\t// ReadOnly indicates if we should only register read-only tools\n263\t\tReadOnly bool\n264\t\n265\t\t// ExportTranslations indicates if we should export translations\n266\t\t// See: https://github.com/github/github-mcp-server?tab=readme-ov-file#i18n--overriding-descriptions\n267\t\tExportTranslations bool\n268\t\n269\t\t// EnableCommandLogging indicates if we should log commands\n270\t\tEnableCommandLogging bool\n271\t\n272\t\t// Path to the log file if not stderr\n273\t\tLogFilePath string\n274\t\n275\t\t// Content window size\n276\t\tContentWindowSize int\n277\t\n278\t\t// LockdownMode indicates if we should enable lockdown mode\n279\t\tLockdownMode bool\n280\t\n281\t\t// InsidersMode expands to the curated set of feature flags enabled for insiders.\n282\t\tInsidersMode bool\n283\t\n284\t\t// ExcludeTools is a list of tool names to disable regardless of other settings.\n285\t\t// These tools will be excluded even if their toolset is enabled or they are\n286\t\t// explicitly listed in EnabledTools.\n287\t\tExcludeTools []string\n288\t\n289\t\t// RepoAccessCacheTTL overrides the default TTL for repository access cache entries.\n290\t\tRepoAccessCacheTTL *time.Duration\n291\t\n292\t\t// OAuthManager, when non-nil, enables OAuth 2.1 login for stdio mode. The\n293\t\t// server starts without a token and runs the authorization flow on the\n294\t\t// first tool call (see createOAuthMiddleware). It is mutually exclusive with\n295\t\t// a static Token.\n296\t\tOAuthManager *oauth.Manager\n297\t\n298\t\t// OAuthScopes are the scopes requested during OAuth login. They double as\n299\t\t// the scope set for tool filtering: tools requiring a scope outside this set\n300\t\t// are hidden. The default set is the full supported list, which hides\n301\t\t// nothing; an explicit, narrower list filters accordingly.\n302\t\tOAuthScopes []string\n303\t\n304\t\t// TokenProvider supplies a token for each GitHub API request.\n305\t\tTokenProvider func() string\n306\t}\n307\t\n308\t// RunStdioServer is not concurrent safe.\n309\tfunc RunStdioServer(cfg StdioServerConfig) error {\n310\t\tauthModes := 0\n311\t\tfor _, on := range []bool{cfg.Token != \"\", cfg.OAuthManager != nil, cfg.TokenProvider != nil} {\n312\t\t\tif on {\n313\t\t\t\tauthModes++\n314\t\t\t}\n315\t\t}\n316\t\tif authModes > 1 {\n317\t\t\treturn fmt.Errorf(\"choose exactly one authentication mode: a static Token, OAuthManager, or TokenProvider\")\n318\t\t}\n319\t\n320\t\t// Create app context\n321\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n322\t\tdefer stop()\n323\t\n324\t\tt, dumpTranslations := translations.TranslationHelper()\n325\t\n326\t\tvar slogHandler slog.Handler\n327\t\tvar logOutput io.Writer\n328\t\tif cfg.LogFilePath != \"\" {\n329\t\t\tfile, err := os.OpenFile(cfg.LogFilePath, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0600)\n330\t\t\tif err != nil {\n331\t\t\t\treturn fmt.Errorf(\"failed to open log file: %w\", err)\n332\t\t\t}\n333\t\t\tlogOutput = file\n334\t\t\tslogHandler = slog.NewTextHandler(logOutput, &slog.HandlerOptions{Level: slog.LevelDebug})\n335\t\t} else {\n336\t\t\tlogOutput = os.Stderr\n337\t\t\tslogHandler = slog.NewTextHandler(logOutput, &slog.HandlerOptions{Level: slog.LevelInfo})\n338\t\t}\n339\t\tlogger := slog.New(slogHandler)\n340\t\tlogger.Info(\"starting server\", \"version\", cfg.Version, \"host\", cfg.Host, \"readOnly\", cfg.ReadOnly, \"lockdownEnabled\", cfg.LockdownMode)\n341\t\n342\t\t// Determine the scope set used to filter tools. Classic PATs expose their\n343\t\t// granted scopes via the API; OAuth uses the requested scopes (the default\n344\t\t// set hides nothing, a narrower explicit set filters accordingly). Other\n345\t\t// token types don't advertise scopes, so filtering is skipped.\n346\t\tvar tokenScopes []string\n347\t\tswitch {\n348\t\tcase strings.HasPrefix(cfg.Token, \"ghp_\"):\n349\t\t\tfetchedScopes, err := fetchTokenScopesForHost(ctx, cfg.Token, cfg.Host)\n350\t\t\tif err != nil {\n351\t\t\t\tlogger.Warn(\"failed to fetch token scopes, continuing without scope filtering\", \"error\", err)\n352\t\t\t} else {\n353\t\t\t\ttokenScopes = fetchedScopes\n354\t\t\t\tlogger.Info(\"token scopes fetched for filtering\", \"scopes\", tokenScopes)\n355\t\t\t}\n356\t\tcase cfg.OAuthManager != nil:\n357\t\t\ttokenScopes = cfg.OAuthScopes\n358\t\t\tlogger.Info(\"using requested OAuth scopes for tool filtering\", \"scopes\", tokenScopes)\n359\t\tdefault:\n360\t\t\tlogger.Debug(\"skipping scope filtering for non-PAT token\")\n361\t\t}\n362\t\n363\t\ttokenProvider := cfg.TokenProvider\n364\t\tvar toolHandlerMiddleware []inventory.ToolHandlerMiddleware\n365\t\tif cfg.OAuthManager != nil {\n366\t\t\ttokenProvider = cfg.OAuthManager.AccessToken\n367\t\t\ttoolHandlerMiddleware = append(toolHandlerMiddleware, createOAuthToolMiddleware(cfg.OAuthManager, logger))\n368\t\t}\n369\t\n370\t\tghServer, err := NewStdioMCPServer(ctx, github.MCPServerConfig{\n371\t\t\tVersion:               cfg.Version,\n372\t\t\tHost:                  cfg.Host,\n373\t\t\tToken:                 cfg.Token,\n374\t\t\tEnabledToolsets:       cfg.EnabledToolsets,\n375\t\t\tEnabledTools:          cfg.EnabledTools,\n376\t\t\tEnabledFeatures:       cfg.EnabledFeatures,\n377\t\t\tReadOnly:              cfg.ReadOnly,\n378\t\t\tTranslator:            t,\n379\t\t\tContentWindowSize:     cfg.ContentWindowSize,\n380\t\t\tLockdownMode:          cfg.LockdownMode,\n381\t\t\tInsidersMode:          cfg.InsidersMode,\n382\t\t\tExcludeTools:          cfg.ExcludeTools,\n383\t\t\tLogger:                logger,\n384\t\t\tRepoAccessTTL:         cfg.RepoAccessCacheTTL,\n385\t\t\tTokenScopes:           tokenScopes,\n386\t\t\tTokenProvider:         tokenProvider,\n387\t\t\tToolHandlerMiddleware: toolHandlerMiddleware,\n388\t\t})\n389\t\tif err != nil {\n390\t\t\treturn fmt.Errorf(\"failed to create MCP server: %w\", err)\n391\t\t}\n392\t\n393\t\tif cfg.ExportTranslations {\n394\t\t\t// Once server is initialized, all translations are loaded\n395\t\t\tdumpTranslations()\n396\t\t}\n397\t\n398\t\t// Start listening for messages\n399\t\terrC := make(chan error, 1)\n400\t\tgo func() {\n401\t\t\tvar in io.ReadCloser\n402\t\t\tvar out io.WriteCloser\n403\t\n404\t\t\tin = os.Stdin\n405\t\t\tout = os.Stdout\n406\t\n407\t\t\tif cfg.EnableCommandLogging {\n408\t\t\t\tloggedIO := mcplog.NewIOLogger(in, out, logger)\n409\t\t\t\tin, out = loggedIO, loggedIO\n410\t\t\t}\n411\t\n412\t\t\t// enable GitHub errors in the context\n413\t\t\tctx := errors.ContextWithGitHubErrors(ctx)\n414\t\t\terrC <- ghServer.Run(ctx, &mcp.IOTransport{Reader: in, Writer: out})\n415\t\t}()\n416\t\n417\t\t// Output github-mcp-server string\n418\t\t_, _ = fmt.Fprintf(os.Stderr, \"GitHub MCP Server running on stdio\\n\")\n419\t\n420\t\t// Wait for shutdown signal\n421\t\tselect {\n422\t\tcase <-ctx.Done():\n423\t\t\tlogger.Info(\"shutting down server\", \"signal\", \"context done\")\n424\t\tcase err := <-errC:\n425\t\t\tif err != nil {\n426\t\t\t\tlogger.Error(\"error running server\", \"error\", err)\n427\t\t\t\treturn fmt.Errorf(\"error running server: %w\", err)\n428\t\t\t}\n429\t\t}\n430\t\n431\t\treturn nil\n432\t}\n433\t\n434\t// createFeatureChecker returns a FeatureFlagChecker that resolves features\n435\t// using the centralized ResolveFeatureFlags function. For the local server,\n436\t// features are resolved once at startup from --features CLI flag and insiders mode.\n437\tfunc createFeatureChecker(enabledFeatures []string, insidersMode bool) inventory.FeatureFlagChecker {\n438\t\tfeatureSet := github.ResolveFeatureFlags(enabledFeatures, insidersMode)\n439\t\treturn func(_ context.Context, flagName string) (bool, error) {\n440\t\t\treturn featureSet[flagName], nil\n441\t\t}\n442\t}\n443\t\n444\tfunc stdioUserAgent(cfg github.MCPServerConfig, client *mcp.Implementation) string {\n445\t\tagent := fmt.Sprintf(\"github-mcp-server/%s\", cfg.Version)\n446\t\tif client != nil {\n447\t\t\tcomment := strconv.Quote(client.Name + \"/\" + client.Version)\n448\t\t\tcomment = comment[1 : len(comment)-1]\n449\t\t\tcomment = strings.NewReplacer(\"(\", `\\(`, \")\", `\\)`).Replace(comment)\n450\t\t\tagent += \" (\" + comment + \")\"\n451\t\t}\n452\t\tif cfg.InsidersMode {\n453\t\t\tagent += \" (insiders)\"\n454\t\t}\n455\t\treturn agent\n456\t}\n457\t\n458\tfunc addUserAgentsMiddleware(cfg github.MCPServerConfig) func(next mcp.MethodHandler) mcp.MethodHandler {\n459\t\treturn func(next mcp.MethodHandler) mcp.MethodHandler {\n460\t\t\treturn func(ctx context.Context, method string, request mcp.Request) (result mcp.Result, err error) {\n461\t\t\t\tvar client *mcp.Implementation\n462\t\t\t\tif info, ok := request.(interface{ ClientInfo() *mcp.Implementation }); ok {\n463\t\t\t\t\tclient = info.ClientInfo()\n464\t\t\t\t}\n465\t\t\t\tctx = transport.WithUserAgent(ctx, stdioUserAgent(cfg, client))\n466\t\t\t\treturn next(ctx, method, request)\n467\t\t\t}\n468\t\t}\n469\t}\n470\t\n471\t// fetchTokenScopesForHost fetches the OAuth scopes for a token from the GitHub API.\n472\t// It constructs the appropriate API host URL based on the configured host.\n473\tfunc fetchTokenScopesForHost(ctx context.Context, token, host string) ([]string, error) {\n474\t\tapiHost, err := utils.NewAPIHost(host)\n475\t\tif err != nil {\n476\t\t\treturn nil, fmt.Errorf(\"failed to parse API host: %w\", err)\n477\t\t}\n478\t\n479\t\tfetcher := scopes.NewFetcher(apiHost, scopes.FetcherOptions{})\n480\t\n481\t\treturn fetcher.FetchTokenScopes(ctx, token)\n482\t}\n483\t"}]},"parent_tool_use_id":null,"session_id":"deaab419-c428-4eb9-8f29-49cef0e3fa03","uuid":"5cfb1bba-4e25-431a-8529-8a19fdf6df3e","timestamp":"2026-10-26T10:20:32.875Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-real-mcp-review-e0ua7zjt/repo/internal/ghmcp/server.go","content":"package ghmcp\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/signal\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/github/github-mcp-server/v2/internal/oauth\"\n\t\"github.com/github/github-mcp-server/v2/internal/requeststate\"\n\t\"github.com/github/github-mcp-server/v2/pkg/errors\"\n\t\"github.com/github/github-mcp-server/v2/pkg/github\"\n\t\"github.com/github/github-mcp-server/v2/pkg/http/transport\"\n\t\"github.com/github/github-mcp-server/v2/pkg/inventory\"\n\t\"github.com/github/github-mcp-server/v2/pkg/lockdown\"\n\tmcplog \"github.com/github/github-mcp-server/v2/pkg/log\"\n\t\"github.com/github/github-mcp-server/v2/pkg/observability\"\n\t\"github.com/github/github-mcp-server/v2/pkg/observability/metrics\"\n\t\"github.com/github/github-mcp-server/v2/pkg/raw\"\n\t\"github.com/github/github-mcp-server/v2/pkg/scopes\"\n\t\"github.com/github/github-mcp-server/v2/pkg/translations\"\n\t\"github.com/github/github-mcp-server/v2/pkg/utils\"\n\tgogithub \"github.com/google/go-github/v92/github\"\n\t\"github.com/modelcontextprotocol/go-sdk/mcp\"\n\t\"github.com/shurcooL/githubv4\"\n)\n\n// githubClients holds all the GitHub API clients created for a server instance.\ntype githubClients struct {\n\trest       *gogithub.Client\n\tgql        *githubv4.Client\n\traw        *raw.Client\n\trepoAccess *lockdown.RepoAccessCache\n}\n\n// createGitHubClients creates all the GitHub API clients needed by the server.\nfunc createGitHubClients(cfg github.MCPServerConfig, apiHost utils.APIHostResolver) (*githubClients, error) {\n\trestURL, err := apiHost.BaseRESTURL(context.Background())\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to get base REST URL: %w\", err)\n\t}\n\n\tuploadURL, err := apiHost.UploadURL(context.Background())\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to get upload URL: %w\", err)\n\t}\n\n\tgraphQLURL, err := apiHost.GraphqlURL(context.Background())\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to get GraphQL URL: %w\", err)\n\t}\n\n\trawURL, err := apiHost.RawURL(context.Background())\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to get Raw URL: %w\", err)\n\t}\n\n\t// allowedHosts scopes the bearer token to the configured GitHub hosts, so a\n\t// response that redirects off them does not carry the token to the redirect\n\t// target. See transport.BearerAuthTransport.\n\tallowedHosts := []string{\n\t\trestURL.Host,\n\t\tuploadURL.Host,\n\t\tgraphQLURL.Host,\n\t\trawURL.Host,\n\t}\n\n\t// Construct REST client. BearerAuthTransport handles both static and\n\t// provider-backed tokens so every authentication mode uses the same host\n\t// restrictions.\n\t//\n\t// ETagTransport sits below the user-agent (and auth) layers so that, by the\n\t// time it runs, the Authorization header is set and can scope the\n\t// conditional-request cache per token. It adds ETag/If-None-Match handling\n\t// so unchanged resources are revalidated with a 304 instead of being\n\t// re-downloaded in full.\n\t//\n\t// The conditional-request cache is enabled only for the REST API client on\n\t// this long-lived local (stdio) server. The raw-content client below uses a\n\t// separate transport without it, so large file bodies are never buffered\n\t// into the cache. The hosted, horizontally-scaled server builds a fresh REST\n\t// client per request (see pkg/github RequestDeps) and does not use this path.\n\trestUATransport := &transport.UserAgentTransport{\n\t\tTransport: &transport.ETagTransport{Transport: http.DefaultTransport},\n\t\tAgent:     stdioUserAgent(cfg, nil),\n\t}\n\trestClient, err := newRESTClient(cfg, restUATransport, restURL.String(), uploadURL.String(), allowedHosts)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to create REST client: %w\", err)\n\t}\n\n\t// Construct GraphQL client\n\t// We use NewEnterpriseClient unconditionally since we already parsed the API host\n\tgqlHTTPClient := &http.Client{\n\t\tTransport: &transport.BearerAuthTransport{\n\t\t\tTransport: &transport.GraphQLFeaturesTransport{\n\t\t\t\tTransport: &transport.UserAgentTransport{\n\t\t\t\t\tTransport: http.DefaultTransport,\n\t\t\t\t\tAgent:     stdioUserAgent(cfg, nil),\n\t\t\t\t},\n\t\t\t},\n\t\t\tToken:         cfg.Token,\n\t\t\tTokenProvider: cfg.TokenProvider,\n\t\t\tAllowedHosts:  allowedHosts,\n\t\t},\n\t}\n\n\tgqlClient := githubv4.NewEnterpriseClient(graphQLURL.String(), gqlHTTPClient)\n\n\t// Create raw content client. It shares the REST client's authentication but\n\t// uses a transport without the conditional-request cache: raw file bodies can\n\t// be large and are streamed rather than retained in memory.\n\trawUATransport := &transport.UserAgentTransport{\n\t\tTransport: http.DefaultTransport,\n\t\tAgent:     stdioUserAgent(cfg, nil),\n\t}\n\trawRESTClient, err := newRESTClient(cfg, rawUATransport, restURL.String(), uploadURL.String(), allowedHosts)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to create raw REST client: %w\", err)\n\t}\n\trawClient, err := raw.NewClient(rawRESTClient, rawURL)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to create raw client: %w\", err)\n\t}\n\n\t// Set up repo access cache for lockdown mode\n\tvar repoAccessCache *lockdown.RepoAccessCache\n\tif cfg.LockdownMode {\n\t\topts := []lockdown.RepoAccessOption{\n\t\t\tlockdown.WithLogger(cfg.Logger.With(\"component\", \"lockdown\")),\n\t\t}\n\t\tif cfg.RepoAccessTTL != nil {\n\t\t\topts = append(opts, lockdown.WithTTL(*cfg.RepoAccessTTL))\n\t\t}\n\t\trepoAccessCache = lockdown.NewRepoAccessCache(gqlClient, restClient, opts...)\n\t}\n\n\treturn &githubClients{\n\t\trest:       restClient,\n\t\tgql:        gqlClient,\n\t\traw:        rawClient,\n\t\trepoAccess: repoAccessCache,\n\t}, nil\n}\n\n// newRESTClient builds a go-github REST client that sends requests through the\n// supplied user-agent transport. Authentication uses BearerAuthTransport for\n// both static and provider-backed tokens, and allowedHosts scopes the token to\n// the configured GitHub hosts so it is never leaked to off-host redirects.\nfunc newRESTClient(cfg github.MCPServerConfig, uaTransport *transport.UserAgentTransport, restURL, uploadURL string, allowedHosts []string) (*gogithub.Client, error) {\n\treturn gogithub.NewClient(\n\t\tgogithub.WithHTTPClient(&http.Client{Transport: &transport.BearerAuthTransport{\n\t\t\tTransport:     uaTransport,\n\t\t\tToken:         cfg.Token,\n\t\t\tTokenProvider: cfg.TokenProvider,\n\t\t\tAllowedHosts:  allowedHosts,\n\t\t}}),\n\t\tgogithub.WithEnterpriseURLs(restURL, uploadURL),\n\t)\n}\n\nfunc NewStdioMCPServer(ctx context.Context, cfg github.MCPServerConfig) (*mcp.Server, error) {\n\tapiHost, err := utils.NewAPIHost(cfg.Host)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to parse API host: %w\", err)\n\t}\n\n\thostType, err := utils.ParseHostType(cfg.Host)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to classify API host: %w\", err)\n\t}\n\n\tclients, err := createGitHubClients(cfg, apiHost)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to create GitHub clients: %w\", err)\n\t}\n\n\t// Create feature checker — resolves explicit features + insiders expansion\n\tfeatureChecker := createFeatureChecker(cfg.EnabledFeatures, cfg.InsidersMode)\n\n\t// Create dependencies for tool handlers\n\tobs, err := observability.NewExporters(cfg.Logger, metrics.NewNoopMetrics())\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to create observability exporters: %w\", err)\n\t}\n\tdeps := github.NewBaseDeps(\n\t\tclients.rest,\n\t\tclients.gql,\n\t\tclients.raw,\n\t\tclients.repoAccess,\n\t\tcfg.Translator,\n\t\tgithub.FeatureFlags{\n\t\t\tLockdownMode: cfg.LockdownMode,\n\t\t},\n\t\tcfg.ContentWindowSize,\n\t\tfeatureChecker,\n\t\tobs,\n\t)\n\tdeps.StateSealer, err = requeststate.NewRandom()\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to configure request-state protection: %w\", err)\n\t}\n\t// Build and register the tool/resource/prompt inventory\n\tinventoryBuilder := github.NewInventory(cfg.Translator, github.WithHost(hostType)).\n\t\tWithDeprecatedAliases(github.DeprecatedToolAliases).\n\t\tWithReadOnly(cfg.ReadOnly).\n\t\tWithToolsets(github.ResolvedEnabledToolsets(cfg.EnabledToolsets, cfg.EnabledTools)).\n\t\tWithTools(github.CleanTools(cfg.EnabledTools)).\n\t\tWithExcludeTools(cfg.ExcludeTools).\n\t\tWithServerInstructions().\n\t\tWithFeatureChecker(featureChecker)\n\n\t// Apply token scope filtering if scopes are known (for PAT filtering)\n\tif cfg.TokenScopes != nil {\n\t\tinventoryBuilder = inventoryBuilder.WithFilter(github.CreateToolScopeFilter(cfg.TokenScopes))\n\t}\n\n\tinventory, err := inventoryBuilder.Build()\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to build inventory: %w\", err)\n\t}\n\n\tghServer, err := github.NewMCPServer(ctx, &cfg, deps, inventory)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to create GitHub MCP server: %w\", err)\n\t}\n\n\tghServer.AddReceivingMiddleware(addUserAgentsMiddleware(cfg))\n\n\treturn ghServer, nil\n}\n\ntype StdioServerConfig struct {\n\t// Version of the server\n\tVersion string\n\n\t// GitHub Host to target for API requests (e.g. github.com or github.enterprise.com)\n\tHost string\n\n\t// GitHub Token to authenticate with the GitHub API\n\tToken string\n\n\t// EnabledToolsets is a list of toolsets to enable\n\t// See: https://github.com/github/github-mcp-server?tab=readme-ov-file#tool-configuration\n\tEnabledToolsets []string\n\n\t// EnabledTools is a list of specific tools to enable (additive to toolsets)\n\t// When specified, these tools are registered in addition to any specified toolset tools\n\tEnabledTools []string\n\n\t// EnabledFeatures is a list of feature flags that are enabled\n\t// Tool feature rules evaluate entries in this list.\n\tEnabledFeatures []string\n\n\t// ReadOnly indicates if we should only register read-only tools\n\tReadOnly bool\n\n\t// ExportTranslations indicates if we should export translations\n\t// See: https://github.com/github/github-mcp-server?tab=readme-ov-file#i18n--overriding-descriptions\n\tExportTranslations bool\n\n\t// EnableCommandLogging indicates if we should log commands\n\tEnableCommandLogging bool\n\n\t// Path to the log file if not stderr\n\tLogFilePath string\n\n\t// Content window size\n\tContentWindowSize int\n\n\t// LockdownMode indicates if we should enable lockdown mode\n\tLockdownMode bool\n\n\t// InsidersMode expands to the curated set of feature flags enabled for insiders.\n\tInsidersMode bool\n\n\t// ExcludeTools is a list of tool names to disable regardless of other settings.\n\t// These tools will be excluded even if their toolset is enabled or they are\n\t// explicitly listed in EnabledTools.\n\tExcludeTools []string\n\n\t// RepoAccessCacheTTL overrides the default TTL for repository access cache entries.\n\tRepoAccessCacheTTL *time.Duration\n\n\t// OAuthManager, when non-nil, enables OAuth 2.1 login for stdio mode. The\n\t// server starts without a token and runs the authorization flow on the\n\t// first tool call (see createOAuthMiddleware). It is mutually exclusive with\n\t// a static Token.\n\tOAuthManager *oauth.Manager\n\n\t// OAuthScopes are the scopes requested during OAuth login. They double as\n\t// the scope set for tool filtering: tools requiring a scope outside this set\n\t// are hidden. The default set is the full supported list, which hides\n\t// nothing; an explicit, narrower list filters accordingly.\n\tOAuthScopes []string\n\n\t// TokenProvider supplies a token for each GitHub API request.\n\tTokenProvider func() string\n}\n\n// RunStdioServer is not concurrent safe.\nfunc RunStdioServer(cfg StdioServerConfig) error {\n\tauthModes := 0\n\tfor _, on := range []bool{cfg.Token != \"\", cfg.OAuthManager != nil, cfg.TokenProvider != nil} {\n\t\tif on {\n\t\t\tauthModes++\n\t\t}\n\t}\n\tif authModes > 1 {\n\t\treturn fmt.Errorf(\"choose exactly one authentication mode: a static Token, OAuthManager, or TokenProvider\")\n\t}\n\n\t// Create app context\n\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stop()\n\n\tt, dumpTranslations := translations.TranslationHelper()\n\n\tvar slogHandler slog.Handler\n\tvar logOutput io.Writer\n\tif cfg.LogFilePath != \"\" {\n\t\tfile, err := os.OpenFile(cfg.LogFilePath, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0600)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"failed to open log file: %w\", err)\n\t\t}\n\t\tlogOutput = file\n\t\tslogHandler = slog.NewTextHandler(logOutput, &slog.HandlerOptions{Level: slog.LevelDebug})\n\t} else {\n\t\tlogOutput = os.Stderr\n\t\tslogHandler = slog.NewTextHandler(logOutput, &slog.HandlerOptions{Level: slog.LevelInfo})\n\t}\n\tlogger := slog.New(slogHandler)\n\tlogger.Info(\"starting server\", \"version\", cfg.Version, \"host\", cfg.Host, \"readOnly\", cfg.ReadOnly, \"lockdownEnabled\", cfg.LockdownMode)\n\n\t// Determine the scope set used to filter tools. Classic PATs expose their\n\t// granted scopes via the API; OAuth uses the requested scopes (the default\n\t// set hides nothing, a narrower explicit set filters accordingly). Other\n\t// token types don't advertise scopes, so filtering is skipped.\n\tvar tokenScopes []string\n\tswitch {\n\tcase strings.HasPrefix(cfg.Token, \"ghp_\"):\n\t\tfetchedScopes, err := fetchTokenScopesForHost(ctx, cfg.Token, cfg.Host)\n\t\tif err != nil {\n\t\t\tlogger.Warn(\"failed to fetch token scopes, continuing without scope filtering\", \"error\", err)\n\t\t} else {\n\t\t\ttokenScopes = fetchedScopes\n\t\t\tlogger.Info(\"token scopes fetched for filtering\", \"scopes\", tokenScopes)\n\t\t}\n\tcase cfg.OAuthManager != nil:\n\t\ttokenScopes = cfg.OAuthScopes\n\t\tlogger.Info(\"using requested OAuth scopes for tool filtering\", \"scopes\", tokenScopes)\n\tdefault:\n\t\tlogger.Debug(\"skipping scope filtering for non-PAT token\")\n\t}\n\n\ttokenProvider := cfg.TokenProvider\n\tvar toolHandlerMiddleware []inventory.ToolHandlerMiddleware\n\tif cfg.OAuthManager != nil {\n\t\ttokenProvider = cfg.OAuthManager.AccessToken\n\t\ttoolHandlerMiddleware = append(toolHandlerMiddleware, createOAuthToolMiddleware(cfg.OAuthManager, logger))\n\t}\n\n\tghServer, err := NewStdioMCPServer(ctx, github.MCPServerConfig{\n\t\tVersion:               cfg.Version,\n\t\tHost:                  cfg.Host,\n\t\tToken:                 cfg.Token,\n\t\tEnabledToolsets:       cfg.EnabledToolsets,\n\t\tEnabledTools:          cfg.EnabledTools,\n\t\tEnabledFeatures:       cfg.EnabledFeatures,\n\t\tReadOnly:              cfg.ReadOnly,\n\t\tTranslator:            t,\n\t\tContentWindowSize:     cfg.ContentWindowSize,\n\t\tLockdownMode:          cfg.LockdownMode,\n\t\tInsidersMode:          cfg.InsidersMode,\n\t\tExcludeTools:          cfg.ExcludeTools,\n\t\tLogger:                logger,\n\t\tRepoAccessTTL:         cfg.RepoAccessCacheTTL,\n\t\tTokenScopes:           tokenScopes,\n\t\tTokenProvider:         tokenProvider,\n\t\tToolHandlerMiddleware: toolHandlerMiddleware,\n\t})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to create MCP server: %w\", err)\n\t}\n\n\tif cfg.ExportTranslations {\n\t\t// Once server is initialized, all translations are loaded\n\t\tdumpTranslations()\n\t}\n\n\t// Start listening for messages\n\terrC := make(chan error, 1)\n\tgo func() {\n\t\tvar in io.ReadCloser\n\t\tvar out io.WriteCloser\n\n\t\tin = os.Stdin\n\t\tout = os.Stdout\n\n\t\tif cfg.EnableCommandLogging {\n\t\t\tloggedIO := mcplog.NewIOLogger(in, out, logger)\n\t\t\tin, out = loggedIO, loggedIO\n\t\t}\n\n\t\t// enable GitHub errors in the context\n\t\tctx := errors.ContextWithGitHubErrors(ctx)\n\t\terrC <- ghServer.Run(ctx, &mcp.IOTransport{Reader: in, Writer: out})\n\t}()\n\n\t// Output github-mcp-server string\n\t_, _ = fmt.Fprintf(os.Stderr, \"GitHub MCP Server running on stdio\\n\")\n\n\t// Wait for shutdown signal\n\tselect {\n\tcase <-ctx.Done():\n\t\tlogger.Info(\"shutting down server\", \"signal\", \"context done\")\n\tcase err := <-errC:\n\t\tif err != nil {\n\t\t\tlogger.Error(\"error running server\", \"error\", err)\n\t\t\treturn fmt.Errorf(\"error running server: %w\", err)\n\t\t}\n\t}\n\n\treturn nil\n}\n\n// createFeatureChecker returns a FeatureFlagChecker that resolves features\n// using the centralized ResolveFeatureFlags function. For the local server,\n// features are resolved once at startup from --features CLI flag and insiders mode.\nfunc createFeatureChecker(enabledFeatures []string, insidersMode bool) inventory.FeatureFlagChecker {\n\tfeatureSet := github.ResolveFeatureFlags(enabledFeatures, insidersMode)\n\treturn func(_ context.Context, flagName string) (bool, error) {\n\t\treturn featureSet[flagName], nil\n\t}\n}\n\nfunc stdioUserAgent(cfg github.MCPServerConfig, client *mcp.Implementation) string {\n\tagent := fmt.Sprintf(\"github-mcp-server/%s\", cfg.Version)\n\tif client != nil {\n\t\tcomment := strconv.Quote(client.Name + \"/\" + client.Version)\n\t\tcomment = comment[1 : len(comment)-1]\n\t\tcomment = strings.NewReplacer(\"(\", `\\(`, \")\", `\\)`).Replace(comment)\n\t\tagent += \" (\" + comment + \")\"\n\t}\n\tif cfg.InsidersMode {\n\t\tagent += \" (insiders)\"\n\t}\n\treturn agent\n}\n\nfunc addUserAgentsMiddleware(cfg github.MCPServerConfig) func(next mcp.MethodHandler) mcp.MethodHandler {\n\treturn func(next mcp.MethodHandler) mcp.MethodHandler {\n\t\treturn func(ctx context.Context, method string, request mcp.Request) (result mcp.Result, err error) {\n\t\t\tvar client *mcp.Implementation\n\t\t\tif info, ok := request.(interface{ ClientInfo() *mcp.Implementation }); ok {\n\t\t\t\tclient = info.ClientInfo()\n\t\t\t}\n\t\t\tctx = transport.WithUserAgent(ctx, stdioUserAgent(cfg, client))\n\t\t\treturn next(ctx, method, request)\n\t\t}\n\t}\n}\n\n// fetchTokenScopesForHost fetches the OAuth scopes for a token from the GitHub API.\n// It constructs the appropriate API host URL based on the configured host.\nfunc fetchTokenScopesForHost(ctx context.Context, token, host string) ([]string, error) {\n\tapiHost, err := utils.NewAPIHost(host)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"failed to parse API host: %w\", err)\n\t}\n\n\tfetcher := scopes.NewFetcher(apiHost, scopes.FetcherOptions{})\n\n\treturn fetcher.FetchTokenScopes(ctx, token)\n}\n","numLines":483,"startLine":1,"totalLines":483}},"tool_result_meta":[{"id":"toolu_01RuErSs3hNz3pbn7VTSY8nc","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
