{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YQA7PUicNr7UYgnnCCqYPm","type":"tool_result","content":"1\tpackage http\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"fmt\"\n6\t\t\"io\"\n7\t\t\"log/slog\"\n8\t\t\"net\"\n9\t\t\"net/http\"\n10\t\t\"os\"\n11\t\t\"os/signal\"\n12\t\t\"strconv\"\n13\t\t\"syscall\"\n14\t\t\"time\"\n15\t\n16\t\t\"github.com/github/github-mcp-server/v2/internal/requeststate\"\n17\t\tghcontext \"github.com/github/github-mcp-server/v2/pkg/context\"\n18\t\t\"github.com/github/github-mcp-server/v2/pkg/github\"\n19\t\t\"github.com/github/github-mcp-server/v2/pkg/http/middleware\"\n20\t\t\"github.com/github/github-mcp-server/v2/pkg/http/oauth\"\n21\t\t\"github.com/github/github-mcp-server/v2/pkg/inventory\"\n22\t\t\"github.com/github/github-mcp-server/v2/pkg/lockdown\"\n23\t\t\"github.com/github/github-mcp-server/v2/pkg/observability\"\n24\t\t\"github.com/github/github-mcp-server/v2/pkg/observability/metrics\"\n25\t\t\"github.com/github/github-mcp-server/v2/pkg/scopes\"\n26\t\t\"github.com/github/github-mcp-server/v2/pkg/translations\"\n27\t\t\"github.com/github/github-mcp-server/v2/pkg/utils\"\n28\t\t\"github.com/go-chi/chi/v5\"\n29\t)\n30\t\n31\t// MRTRStateKeyEnv is the environment variable used to configure HTTP request-state encryption.\n32\tconst MRTRStateKeyEnv = \"GITHUB_MCP_SERVER_MRTR_STATE_KEY\"\n33\t\n34\ttype ServerConfig struct {\n35\t\t// Version of the server\n36\t\tVersion string\n37\t\n38\t\t// GitHub Host to target for API requests (e.g. github.com or github.enterprise.com)\n39\t\tHost string\n40\t\n41\t\t// Port to listen on (default: 8082).\n42\t\tPort int\n43\t\n44\t\t// ListenHost is the host the HTTP server binds to (e.g. \"127.0.0.1\").\n45\t\t// When empty, the server binds to all interfaces. Combined with Port.\n46\t\tListenHost string\n47\t\n48\t\t// BaseURL is the publicly accessible URL of this server for OAuth resource metadata.\n49\t\t// If not set, the server will derive the URL from incoming request headers.\n50\t\tBaseURL string\n51\t\n52\t\t// ResourcePath is the externally visible base path for this server (e.g., \"/mcp\").\n53\t\t// This is used to restore the original path when a proxy strips a base path before forwarding.\n54\t\tResourcePath string\n55\t\n56\t\t// AuthorizationServer overrides the authorization server URL advertised in the\n57\t\t// OAuth Protected Resource Metadata (/.well-known/oauth-protected-resource).\n58\t\t// When set, this URL is used instead of the one derived from the GitHub host.\n59\t\t// Useful when deploying behind an OAuth proxy (e.g. for GHES, which does not\n60\t\t// natively support RFC 8414 / RFC 7591 / PKCE).\n61\t\tAuthorizationServer string\n62\t\n63\t\t// TrustProxyHeaders indicates whether X-Forwarded-Host and X-Forwarded-Proto\n64\t\t// should be honored when constructing OAuth resource metadata URLs. Only\n65\t\t// enable this when the server is deployed behind a trusted proxy that sets\n66\t\t// these headers. When BaseURL is set, it always wins and this setting has\n67\t\t// no effect.\n68\t\tTrustProxyHeaders bool\n69\t\n70\t\t// ExportTranslations indicates if we should export translations\n71\t\t// See: https://github.com/github/github-mcp-server?tab=readme-ov-file#i18n--overriding-descriptions\n72\t\tExportTranslations bool\n73\t\n74\t\t// EnableCommandLogging indicates if we should log commands\n75\t\tEnableCommandLogging bool\n76\t\n77\t\t// Path to the log file if not stderr\n78\t\tLogFilePath string\n79\t\n80\t\t// Content window size\n81\t\tContentWindowSize int\n82\t\n83\t\t// LockdownMode indicates if we should enable lockdown mode\n84\t\tLockdownMode bool\n85\t\n86\t\t// RepoAccessCacheTTL overrides the default TTL for repository access cache entries.\n87\t\tRepoAccessCacheTTL *time.Duration\n88\t\n89\t\t// ScopeChallenge indicates if we should return OAuth scope challenges, and if we should perform\n90\t\t// tool filtering based on token scopes.\n91\t\tScopeChallenge bool\n92\t\n93\t\t// ReadOnly indicates if we should only register read-only tools.\n94\t\t// When set via CLI flag, this acts as an upper bound — per-request headers\n95\t\t// cannot re-enable write tools.\n96\t\tReadOnly bool\n97\t\n98\t\t// EnabledToolsets is a list of toolsets to enable.\n99\t\t// When set via CLI flag, per-request headers can only narrow within these toolsets.\n100\t\tEnabledToolsets []string\n101\t\n102\t\t// EnabledTools is a list of specific tools to enable (additive to toolsets).\n103\t\tEnabledTools []string\n104\t\n105\t\t// ExcludeTools is a list of tool names to disable regardless of other settings.\n106\t\t// When set via CLI flag, per-request headers cannot re-include these tools.\n107\t\tExcludeTools []string\n108\t\n109\t\t// EnabledFeatures is a list of feature flags that are enabled.\n110\t\tEnabledFeatures []string\n111\t\n112\t\t// InsidersMode expands to the curated set of feature flags enabled for insiders.\n113\t\tInsidersMode bool\n114\t\n115\t\t// MRTRStateKey is a Base64-encoded 32-byte key used to protect multi-round-trip request state.\n116\t\tMRTRStateKey string\n117\t\n118\t\t// MaxRequestBodyBytes bounds the size of HTTP request bodies accepted by\n119\t\t// the MCP endpoints. When zero, middleware.DefaultMaxRequestBodyBytes is used.\n120\t\tMaxRequestBodyBytes int64\n121\t\n122\t\tdisableDeleteRepository bool\n123\t}\n124\t\n125\tfunc RunHTTPServer(cfg ServerConfig) error {\n126\t\t// Create app context\n127\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n128\t\tdefer stop()\n129\t\n130\t\tt, dumpTranslations := translations.TranslationHelper()\n131\t\n132\t\tvar slogHandler slog.Handler\n133\t\tvar logOutput io.Writer\n134\t\tif cfg.LogFilePath != \"\" {\n135\t\t\tfile, err := os.OpenFile(cfg.LogFilePath, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0600)\n136\t\t\tif err != nil {\n137\t\t\t\treturn fmt.Errorf(\"failed to open log file: %w\", err)\n138\t\t\t}\n139\t\t\tlogOutput = file\n140\t\t\tslogHandler = slog.NewTextHandler(logOutput, &slog.HandlerOptions{Level: slog.LevelDebug})\n141\t\t} else {\n142\t\t\tlogOutput = os.Stderr\n143\t\t\tslogHandler = slog.NewTextHandler(logOutput, &slog.HandlerOptions{Level: slog.LevelInfo})\n144\t\t}\n145\t\tlogger := slog.New(slogHandler)\n146\t\tlogger.Info(\"starting server\", \"version\", cfg.Version, \"host\", cfg.Host, \"lockdownEnabled\", cfg.LockdownMode, \"readOnly\", cfg.ReadOnly, \"insidersMode\", cfg.InsidersMode)\n147\t\n148\t\tstateSealer, err := configureRequestState(&cfg, logger)\n149\t\tif err != nil {\n150\t\t\treturn err\n151\t\t}\n152\t\n153\t\tapiHost, err := utils.NewAPIHost(cfg.Host)\n154\t\tif err != nil {\n155\t\t\treturn fmt.Errorf(\"failed to parse API host: %w\", err)\n156\t\t}\n157\t\thostType, err := utils.ParseHostType(cfg.Host)\n158\t\tif err != nil {\n159\t\t\treturn fmt.Errorf(\"failed to classify API host: %w\", err)\n160\t\t}\n161\t\n162\t\trepoAccessOpts := []lockdown.RepoAccessOption{\n163\t\t\tlockdown.WithLogger(logger.With(\"component\", \"lockdown\")),\n164\t\t}\n165\t\tif cfg.RepoAccessCacheTTL != nil {\n166\t\t\trepoAccessOpts = append(repoAccessOpts, lockdown.WithTTL(*cfg.RepoAccessCacheTTL))\n167\t\t}\n168\t\n169\t\tfeatureChecker := createHTTPFeatureChecker(cfg.EnabledFeatures, cfg.InsidersMode)\n170\t\tscopeFetcher := scopes.NewFetcher(apiHost, scopes.FetcherOptions{})\n171\t\tinventoryFactory, err := NewDefaultInventoryFactory(&cfg, t, featureChecker, scopeFetcher)\n172\t\tif err != nil {\n173\t\t\treturn fmt.Errorf(\"failed to build inventory: %w\", err)\n174\t\t}\n175\t\n176\t\tobs, err := observability.NewExporters(logger, metrics.NewNoopMetrics())\n177\t\tif err != nil {\n178\t\t\treturn fmt.Errorf(\"failed to create observability exporters: %w\", err)\n179\t\t}\n180\t\n181\t\tdeps := github.NewRequestDeps(\n182\t\t\tapiHost,\n183\t\t\tcfg.Version,\n184\t\t\tcfg.LockdownMode,\n185\t\t\trepoAccessOpts,\n186\t\t\tt,\n187\t\t\tcfg.ContentWindowSize,\n188\t\t\tfeatureChecker,\n189\t\t\tobs,\n190\t\t)\n191\t\tdeps.StateSealer = stateSealer\n192\t\n193\t\t// Initialize the global tool scope map\n194\t\terr = initGlobalToolScopeMap(t, hostType)\n195\t\tif err != nil {\n196\t\t\treturn fmt.Errorf(\"failed to initialize tool scope map: %w\", err)\n197\t\t}\n198\t\n199\t\t// Register OAuth protected resource metadata endpoints\n200\t\toauthCfg := newOAuthConfig(cfg)\n201\t\n202\t\tserverOptions := []HandlerOption{\n203\t\t\tWithInventoryFactory(inventoryFactory),\n204\t\t\tWithScopeFetcher(scopeFetcher),\n205\t\t}\n206\t\n207\t\thandler := NewHTTPMcpHandler(ctx, &cfg, deps, t, logger, apiHost, append(serverOptions, WithFeatureChecker(featureChecker), WithOAuthConfig(oauthCfg))...)\n208\t\toauthHandler, err := oauth.NewAuthHandler(oauthCfg, apiHost)\n209\t\tif err != nil {\n210\t\t\treturn fmt.Errorf(\"failed to create OAuth handler: %w\", err)\n211\t\t}\n212\t\n213\t\tr := newHTTPRouter(\n214\t\t\tfunc(r chi.Router) {\n215\t\t\t\t// Register Middleware First, needs to be before route registration\n216\t\t\t\thandler.RegisterMiddleware(r)\n217\t\t\t\t// Register MCP server routes\n218\t\t\t\thandler.RegisterRoutes(r)\n219\t\t\t},\n220\t\t\toauthHandler.RegisterRoutes,\n221\t\t)\n222\t\tlogger.Info(\"MCP endpoints registered\", \"baseURL\", cfg.BaseURL)\n223\t\tlogger.Info(\"OAuth protected resource endpoints registered\", \"baseURL\", cfg.BaseURL)\n224\t\n225\t\taddr := resolveListenAddress(cfg.ListenHost, cfg.Port)\n226\t\thttpSvr := http.Server{\n227\t\t\tAddr:              addr,\n228\t\t\tHandler:           r,\n229\t\t\tReadHeaderTimeout: 60 * time.Second,\n230\t\t}\n231\t\n232\t\tgo func() {\n233\t\t\t<-ctx.Done()\n234\t\t\tshutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n235\t\t\tdefer cancel()\n236\t\t\tlogger.Info(\"shutting down server\")\n237\t\t\tif err := httpSvr.Shutdown(shutdownCtx); err != nil {\n238\t\t\t\tlogger.Error(\"error during server shutdown\", \"error\", err)\n239\t\t\t}\n240\t\t}()\n241\t\n242\t\tif cfg.ExportTranslations {\n243\t\t\t// Once server is initialized, all translations are loaded\n244\t\t\tdumpTranslations()\n245\t\t}\n246\t\n247\t\tlogger.Info(\"HTTP server listening\", \"addr\", addr)\n248\t\tif err := httpSvr.ListenAndServe(); err != nil && err != http.ErrServerClosed {\n249\t\t\treturn fmt.Errorf(\"HTTP server error: %w\", err)\n250\t\t}\n251\t\n252\t\tlogger.Info(\"server stopped gracefully\")\n253\t\treturn nil\n254\t}\n255\t\n256\tfunc newHTTPRouter(registerMCPRoutes, registerOAuthRoutes func(chi.Router)) chi.Router {\n257\t\tr := chi.NewRouter()\n258\t\tr.Use(middleware.SetCorsHeaders)\n259\t\tr.Group(registerMCPRoutes)\n260\t\tr.Group(registerOAuthRoutes)\n261\t\treturn r\n262\t}\n263\t\n264\tfunc newOAuthConfig(cfg ServerConfig) *oauth.Config {\n265\t\treturn &oauth.Config{\n266\t\t\tBaseURL:             cfg.BaseURL,\n267\t\t\tResourcePath:        cfg.ResourcePath,\n268\t\t\tTrustProxyHeaders:   cfg.TrustProxyHeaders,\n269\t\t\tAuthorizationServer: cfg.AuthorizationServer,\n270\t\t}\n271\t}\n272\t\n273\t// resolveListenAddress returns the address string passed to http.Server.\n274\t// When host is empty the server binds to all interfaces on the given port;\n275\t// otherwise host and port are joined into a single address.\n276\tfunc resolveListenAddress(host string, port int) string {\n277\t\tif host == \"\" {\n278\t\t\treturn fmt.Sprintf(\":%d\", port)\n279\t\t}\n280\t\treturn net.JoinHostPort(host, strconv.Itoa(port))\n281\t}\n282\t\n283\tfunc configureRequestState(cfg *ServerConfig, logger *slog.Logger) (github.RequestStateSealer, error) {\n284\t\tif cfg.MRTRStateKey == \"\" {\n285\t\t\tcfg.disableDeleteRepository = true\n286\t\t\tlogger.Warn(\"delete_repository disabled: request-state encryption key is not configured\", \"environmentVariable\", MRTRStateKeyEnv)\n287\t\t\treturn nil, nil\n288\t\t}\n289\t\tsealer, err := requeststate.New(cfg.MRTRStateKey)\n290\t\tif err != nil {\n291\t\t\treturn nil, fmt.Errorf(\"invalid %s: %w\", MRTRStateKeyEnv, err)\n292\t\t}\n293\t\treturn sealer, nil\n294\t}\n295\t\n296\tfunc initGlobalToolScopeMap(t translations.TranslationHelperFunc, hostType utils.HostType) error {\n297\t\t// Build inventory with all tools to extract scope information\n298\t\tinv, err := inventory.NewBuilder().\n299\t\t\tSetTools(github.AllTools(t, github.WithHost(hostType))).\n300\t\t\tBuild()\n301\t\n302\t\tif err != nil {\n303\t\t\treturn fmt.Errorf(\"failed to build inventory for tool scope map: %w\", err)\n304\t\t}\n305\t\n306\t\t// Initialize the global scope map\n307\t\tscopes.SetToolScopeMapFromInventory(inv)\n308\t\n309\t\treturn nil\n310\t}\n311\t\n312\t// createHTTPFeatureChecker creates a feature checker that resolves static CLI\n313\t// features plus per-request features and insiders mode.\n314\tfunc createHTTPFeatureChecker(enabledFeatures []string, insidersMode bool) inventory.FeatureFlagChecker {\n315\t\treturn func(ctx context.Context, flag string) (bool, error) {\n316\t\t\trequestFeatures := ghcontext.GetHeaderFeatures(ctx)\n317\t\t\tfeatures := make([]string, 0, len(enabledFeatures)+len(requestFeatures))\n318\t\t\tfeatures = append(features, enabledFeatures...)\n319\t\t\tfeatures = append(features, requestFeatures...)\n320\t\n321\t\t\teffective := github.ResolveFeatureFlags(features, insidersMode || ghcontext.IsInsidersMode(ctx))\n322\t\t\treturn effective[flag], nil\n323\t\t}\n324\t}\n325\t"}]},"parent_tool_use_id":null,"session_id":"deaab419-c428-4eb9-8f29-49cef0e3fa03","uuid":"9c75e2a5-97e7-4f61-aaf8-d8d1ce5eb0f8","timestamp":"2026-10-26T10:20:52.212Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-real-mcp-review-e0ua7zjt/repo/pkg/http/server.go","content":"package http\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"log/slog\"\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/signal\"\n\t\"strconv\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/github/github-mcp-server/v2/internal/requeststate\"\n\tghcontext \"github.com/github/github-mcp-server/v2/pkg/context\"\n\t\"github.com/github/github-mcp-server/v2/pkg/github\"\n\t\"github.com/github/github-mcp-server/v2/pkg/http/middleware\"\n\t\"github.com/github/github-mcp-server/v2/pkg/http/oauth\"\n\t\"github.com/github/github-mcp-server/v2/pkg/inventory\"\n\t\"github.com/github/github-mcp-server/v2/pkg/lockdown\"\n\t\"github.com/github/github-mcp-server/v2/pkg/observability\"\n\t\"github.com/github/github-mcp-server/v2/pkg/observability/metrics\"\n\t\"github.com/github/github-mcp-server/v2/pkg/scopes\"\n\t\"github.com/github/github-mcp-server/v2/pkg/translations\"\n\t\"github.com/github/github-mcp-server/v2/pkg/utils\"\n\t\"github.com/go-chi/chi/v5\"\n)\n\n// MRTRStateKeyEnv is the environment variable used to configure HTTP request-state encryption.\nconst MRTRStateKeyEnv = \"GITHUB_MCP_SERVER_MRTR_STATE_KEY\"\n\ntype ServerConfig struct {\n\t// Version of the server\n\tVersion string\n\n\t// GitHub Host to target for API requests (e.g. github.com or github.enterprise.com)\n\tHost string\n\n\t// Port to listen on (default: 8082).\n\tPort int\n\n\t// ListenHost is the host the HTTP server binds to (e.g. \"127.0.0.1\").\n\t// When empty, the server binds to all interfaces. Combined with Port.\n\tListenHost string\n\n\t// BaseURL is the publicly accessible URL of this server for OAuth resource metadata.\n\t// If not set, the server will derive the URL from incoming request headers.\n\tBaseURL string\n\n\t// ResourcePath is the externally visible base path for this server (e.g., \"/mcp\").\n\t// This is used to restore the original path when a proxy strips a base path before forwarding.\n\tResourcePath string\n\n\t// AuthorizationServer overrides the authorization server URL advertised in the\n\t// OAuth Protected Resource Metadata (/.well-known/oauth-protected-resource).\n\t// When set, this URL is used instead of the one derived from the GitHub host.\n\t// Useful when deploying behind an OAuth proxy (e.g. for GHES, which does not\n\t// natively support RFC 8414 / RFC 7591 / PKCE).\n\tAuthorizationServer string\n\n\t// TrustProxyHeaders indicates whether X-Forwarded-Host and X-Forwarded-Proto\n\t// should be honored when constructing OAuth resource metadata URLs. Only\n\t// enable this when the server is deployed behind a trusted proxy that sets\n\t// these headers. When BaseURL is set, it always wins and this setting has\n\t// no effect.\n\tTrustProxyHeaders bool\n\n\t// ExportTranslations indicates if we should export translations\n\t// See: https://github.com/github/github-mcp-server?tab=readme-ov-file#i18n--overriding-descriptions\n\tExportTranslations bool\n\n\t// EnableCommandLogging indicates if we should log commands\n\tEnableCommandLogging bool\n\n\t// Path to the log file if not stderr\n\tLogFilePath string\n\n\t// Content window size\n\tContentWindowSize int\n\n\t// LockdownMode indicates if we should enable lockdown mode\n\tLockdownMode bool\n\n\t// RepoAccessCacheTTL overrides the default TTL for repository access cache entries.\n\tRepoAccessCacheTTL *time.Duration\n\n\t// ScopeChallenge indicates if we should return OAuth scope challenges, and if we should perform\n\t// tool filtering based on token scopes.\n\tScopeChallenge bool\n\n\t// ReadOnly indicates if we should only register read-only tools.\n\t// When set via CLI flag, this acts as an upper bound — per-request headers\n\t// cannot re-enable write tools.\n\tReadOnly bool\n\n\t// EnabledToolsets is a list of toolsets to enable.\n\t// When set via CLI flag, per-request headers can only narrow within these toolsets.\n\tEnabledToolsets []string\n\n\t// EnabledTools is a list of specific tools to enable (additive to toolsets).\n\tEnabledTools []string\n\n\t// ExcludeTools is a list of tool names to disable regardless of other settings.\n\t// When set via CLI flag, per-request headers cannot re-include these tools.\n\tExcludeTools []string\n\n\t// EnabledFeatures is a list of feature flags that are enabled.\n\tEnabledFeatures []string\n\n\t// InsidersMode expands to the curated set of feature flags enabled for insiders.\n\tInsidersMode bool\n\n\t// MRTRStateKey is a Base64-encoded 32-byte key used to protect multi-round-trip request state.\n\tMRTRStateKey string\n\n\t// MaxRequestBodyBytes bounds the size of HTTP request bodies accepted by\n\t// the MCP endpoints. When zero, middleware.DefaultMaxRequestBodyBytes is used.\n\tMaxRequestBodyBytes int64\n\n\tdisableDeleteRepository bool\n}\n\nfunc RunHTTPServer(cfg ServerConfig) error {\n\t// Create app context\n\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stop()\n\n\tt, dumpTranslations := translations.TranslationHelper()\n\n\tvar slogHandler slog.Handler\n\tvar logOutput io.Writer\n\tif cfg.LogFilePath != \"\" {\n\t\tfile, err := os.OpenFile(cfg.LogFilePath, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0600)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"failed to open log file: %w\", err)\n\t\t}\n\t\tlogOutput = file\n\t\tslogHandler = slog.NewTextHandler(logOutput, &slog.HandlerOptions{Level: slog.LevelDebug})\n\t} else {\n\t\tlogOutput = os.Stderr\n\t\tslogHandler = slog.NewTextHandler(logOutput, &slog.HandlerOptions{Level: slog.LevelInfo})\n\t}\n\tlogger := slog.New(slogHandler)\n\tlogger.Info(\"starting server\", \"version\", cfg.Version, \"host\", cfg.Host, \"lockdownEnabled\", cfg.LockdownMode, \"readOnly\", cfg.ReadOnly, \"insidersMode\", cfg.InsidersMode)\n\n\tstateSealer, err := configureRequestState(&cfg, logger)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\tapiHost, err := utils.NewAPIHost(cfg.Host)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to parse API host: %w\", err)\n\t}\n\thostType, err := utils.ParseHostType(cfg.Host)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to classify API host: %w\", err)\n\t}\n\n\trepoAccessOpts := []lockdown.RepoAccessOption{\n\t\tlockdown.WithLogger(logger.With(\"component\", \"lockdown\")),\n\t}\n\tif cfg.RepoAccessCacheTTL != nil {\n\t\trepoAccessOpts = append(repoAccessOpts, lockdown.WithTTL(*cfg.RepoAccessCacheTTL))\n\t}\n\n\tfeatureChecker := createHTTPFeatureChecker(cfg.EnabledFeatures, cfg.InsidersMode)\n\tscopeFetcher := scopes.NewFetcher(apiHost, scopes.FetcherOptions{})\n\tinventoryFactory, err := NewDefaultInventoryFactory(&cfg, t, featureChecker, scopeFetcher)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to build inventory: %w\", err)\n\t}\n\n\tobs, err := observability.NewExporters(logger, metrics.NewNoopMetrics())\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to create observability exporters: %w\", err)\n\t}\n\n\tdeps := github.NewRequestDeps(\n\t\tapiHost,\n\t\tcfg.Version,\n\t\tcfg.LockdownMode,\n\t\trepoAccessOpts,\n\t\tt,\n\t\tcfg.ContentWindowSize,\n\t\tfeatureChecker,\n\t\tobs,\n\t)\n\tdeps.StateSealer = stateSealer\n\n\t// Initialize the global tool scope map\n\terr = initGlobalToolScopeMap(t, hostType)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to initialize tool scope map: %w\", err)\n\t}\n\n\t// Register OAuth protected resource metadata endpoints\n\toauthCfg := newOAuthConfig(cfg)\n\n\tserverOptions := []HandlerOption{\n\t\tWithInventoryFactory(inventoryFactory),\n\t\tWithScopeFetcher(scopeFetcher),\n\t}\n\n\thandler := NewHTTPMcpHandler(ctx, &cfg, deps, t, logger, apiHost, append(serverOptions, WithFeatureChecker(featureChecker), WithOAuthConfig(oauthCfg))...)\n\toauthHandler, err := oauth.NewAuthHandler(oauthCfg, apiHost)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to create OAuth handler: %w\", err)\n\t}\n\n\tr := newHTTPRouter(\n\t\tfunc(r chi.Router) {\n\t\t\t// Register Middleware First, needs to be before route registration\n\t\t\thandler.RegisterMiddleware(r)\n\t\t\t// Register MCP server routes\n\t\t\thandler.RegisterRoutes(r)\n\t\t},\n\t\toauthHandler.RegisterRoutes,\n\t)\n\tlogger.Info(\"MCP endpoints registered\", \"baseURL\", cfg.BaseURL)\n\tlogger.Info(\"OAuth protected resource endpoints registered\", \"baseURL\", cfg.BaseURL)\n\n\taddr := resolveListenAddress(cfg.ListenHost, cfg.Port)\n\thttpSvr := http.Server{\n\t\tAddr:              addr,\n\t\tHandler:           r,\n\t\tReadHeaderTimeout: 60 * time.Second,\n\t}\n\n\tgo func() {\n\t\t<-ctx.Done()\n\t\tshutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n\t\tdefer cancel()\n\t\tlogger.Info(\"shutting down server\")\n\t\tif err := httpSvr.Shutdown(shutdownCtx); err != nil {\n\t\t\tlogger.Error(\"error during server shutdown\", \"error\", err)\n\t\t}\n\t}()\n\n\tif cfg.ExportTranslations {\n\t\t// Once server is initialized, all translations are loaded\n\t\tdumpTranslations()\n\t}\n\n\tlogger.Info(\"HTTP server listening\", \"addr\", addr)\n\tif err := httpSvr.ListenAndServe(); err != nil && err != http.ErrServerClosed {\n\t\treturn fmt.Errorf(\"HTTP server error: %w\", err)\n\t}\n\n\tlogger.Info(\"server stopped gracefully\")\n\treturn nil\n}\n\nfunc newHTTPRouter(registerMCPRoutes, registerOAuthRoutes func(chi.Router)) chi.Router {\n\tr := chi.NewRouter()\n\tr.Use(middleware.SetCorsHeaders)\n\tr.Group(registerMCPRoutes)\n\tr.Group(registerOAuthRoutes)\n\treturn r\n}\n\nfunc newOAuthConfig(cfg ServerConfig) *oauth.Config {\n\treturn &oauth.Config{\n\t\tBaseURL:             cfg.BaseURL,\n\t\tResourcePath:        cfg.ResourcePath,\n\t\tTrustProxyHeaders:   cfg.TrustProxyHeaders,\n\t\tAuthorizationServer: cfg.AuthorizationServer,\n\t}\n}\n\n// resolveListenAddress returns the address string passed to http.Server.\n// When host is empty the server binds to all interfaces on the given port;\n// otherwise host and port are joined into a single address.\nfunc resolveListenAddress(host string, port int) string {\n\tif host == \"\" {\n\t\treturn fmt.Sprintf(\":%d\", port)\n\t}\n\treturn net.JoinHostPort(host, strconv.Itoa(port))\n}\n\nfunc configureRequestState(cfg *ServerConfig, logger *slog.Logger) (github.RequestStateSealer, error) {\n\tif cfg.MRTRStateKey == \"\" {\n\t\tcfg.disableDeleteRepository = true\n\t\tlogger.Warn(\"delete_repository disabled: request-state encryption key is not configured\", \"environmentVariable\", MRTRStateKeyEnv)\n\t\treturn nil, nil\n\t}\n\tsealer, err := requeststate.New(cfg.MRTRStateKey)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"invalid %s: %w\", MRTRStateKeyEnv, err)\n\t}\n\treturn sealer, nil\n}\n\nfunc initGlobalToolScopeMap(t translations.TranslationHelperFunc, hostType utils.HostType) error {\n\t// Build inventory with all tools to extract scope information\n\tinv, err := inventory.NewBuilder().\n\t\tSetTools(github.AllTools(t, github.WithHost(hostType))).\n\t\tBuild()\n\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to build inventory for tool scope map: %w\", err)\n\t}\n\n\t// Initialize the global scope map\n\tscopes.SetToolScopeMapFromInventory(inv)\n\n\treturn nil\n}\n\n// createHTTPFeatureChecker creates a feature checker that resolves static CLI\n// features plus per-request features and insiders mode.\nfunc createHTTPFeatureChecker(enabledFeatures []string, insidersMode bool) inventory.FeatureFlagChecker {\n\treturn func(ctx context.Context, flag string) (bool, error) {\n\t\trequestFeatures := ghcontext.GetHeaderFeatures(ctx)\n\t\tfeatures := make([]string, 0, len(enabledFeatures)+len(requestFeatures))\n\t\tfeatures = append(features, enabledFeatures...)\n\t\tfeatures = append(features, requestFeatures...)\n\n\t\teffective := github.ResolveFeatureFlags(features, insidersMode || ghcontext.IsInsidersMode(ctx))\n\t\treturn effective[flag], nil\n\t}\n}\n","numLines":325,"startLine":1,"totalLines":325}},"tool_result_meta":[{"id":"toolu_01YQA7PUicNr7UYgnnCCqYPm","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
