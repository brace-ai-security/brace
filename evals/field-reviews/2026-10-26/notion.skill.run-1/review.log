98\t          \"vulnerable_functions\": []\n599\t        }\n600\t      ],\n601\t      \"excerpt\": \"Summary mcp-server-fetch checks robots.txt for the URL the model asks for, then lets httpx follow redirects without checking robots.txt again.\",\n602\t      \"maintainer_guidance_summary\": \"Other server package advisory in the same monorepo; affected package and ranges are recorded exactly. Not assigned to the filesystem package.\"\n603\t    },\n604\t    {\n605\t      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-4gxg-m5jx-9j57\",\n606\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n607\t      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n608\t      \"published_at\": \"2026-10-25T00:18:21Z\",\n609\t      \"updated_at\": \"2026-10-25T00:18:22Z\",\n610\t      \"advisory_id\": \"GHSA-4gxg-m5jx-9j57\",\n611\t      \"cve_id\": null,\n612\t      \"title\": \"Case-variant path bypasses symlink check and allows creating files outside allowed directories in server-filesystem\",\n613\t      \"severity\": \"medium\",\n614\t      \"vulnerabilities\": [\n615\t        {\n616\t          \"package\": {\n617\t            \"ecosystem\": \"npm\",\n618\t            \"name\": \"@modelcontextprotocol/server-filesystem\"\n619\t          },\n620\t          \"vulnerable_version_range\": \"= 2026.8.31\",\n621\t          \"patched_versions\": null,\n622\t          \"vulnerable_functions\": []\n623\t        },\n624\t        {\n625\t          \"package\": {\n626\t            \"ecosystem\": \"npm\",\n627\t            \"name\": \"@modelcontextprotocol/server-filesystem\"\n628\t          },\n629\t          \"vulnerable_version_range\": \">= 1.0.0, < 2.0.1\",\n630\t          \"patched_versions\": \"2.0.1\",\n631\t          \"vulnerable_functions\": []\n632\t        }\n633\t      ],\n634\t      \"excerpt\": \"Summary On a case-insensitive file system, server-filesystem 2026.8.31, 1.0.0 and 2.0.0 create files and directories outside the allowed directories through\",\n635\t      \"maintainer_guidance_summary\": \"Case-insensitive filesystems with an escaping symlink can permit creation outside allowed directories through case-varied paths. Explicitly install 2.0.1 when migrating from date-version releases.\"\n636\t    },\n637\t    {\n638\t      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-7rgq-gccq-qphx\",\n639\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n640\t      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n641\t      \"published_at\": \"2026-10-25T00:18:38Z\",\n642\t      \"updated_at\": \"2026-10-25T00:18:38Z\",\n643\t      \"advisory_id\": \"GHSA-7rgq-gccq-qphx\",\n644\t      \"cve_id\": null,\n645\t      \"title\": \"Path traversal via trailing quote/whitespace in validatePath (Check/Use Mismatch)\",\n646\t      \"severity\": \"medium\",\n647\t      \"vulnerabilities\": [\n648\t        {\n649\t          \"package\": {\n650\t            \"ecosystem\": \"npm\",\n651\t            \"name\": \"@modelcontextprotocol/server-filesystem\"\n652\t          },\n653\t          \"vulnerable_version_range\": \">= 2025.8.21, <= 2026.8.31\",\n654\t          \"patched_versions\": null,\n655\t          \"vulnerable_functions\": []\n656\t        },\n657\t        {\n658\t          \"package\": {\n659\t            \"ecosystem\": \"npm\",\n660\t            \"name\": \"@modelcontextprotocol/server-filesystem\"\n661\t          },\n662\t          \"vulnerable_version_range\": \">= 1.0.0, < 2.0.1\",\n663\t          \"patched_versions\": \"2.0.1\",\n664\t          \"vulnerable_functions\": []\n665\t        }\n666\t      ],\n667\t      \"excerpt\": \"Summary validatePath in src/filesystem/lib.ts performs the allowlist containment check on normalizePath(absolute) but runs fs.realpath and returns the result from the\",\n668\t      \"maintainer_guidance_summary\": \"Path normalization and filesystem use differ for trailing quotes/whitespace. Explicitly install 2.0.1 when migrating from date-version releases.\"\n669\t    },\n670\t    {\n671\t      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-66qx-2266-pmj6\",\n672\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n673\t      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n674\t      \"published_at\": \"2026-10-25T00:18:52Z\",\n675\t      \"updated_at\": \"2026-10-25T00:18:52Z\",\n676\t      \"advisory_id\": \"GHSA-66qx-2266-pmj6\",\n677\t      \"cve_id\": null,\n678\t      \"title\": \"fetch server: SSRF guard treats the well-known NAT64 prefix 64:ff9b::/96 as public, so a metadata address is reachable on NAT64/DNS64 egress\",\n679\t      \"severity\": \"low\",\n680\t      \"vulnerabilities\": [\n681\t        {\n682\t          \"package\": {\n683\t            \"ecosystem\": \"pip\",\n684\t            \"name\": \"mcp-server-fetch\"\n685\t          },\n686\t          \"vulnerable_version_range\": \">= 2026.10.10, <= 2026.10.19\",\n687\t          \"patched_versions\": \"2026.10.24\",\n688\t          \"vulnerable_functions\": []\n689\t        }\n690\t      ],\n691\t      \"excerpt\": \"Summary In mcp-server-fetch, _is_public_address() (src/fetch/src/mcp_server_fetch/server.py) decides whether a resolved address is a public destination. Its _NON_PUBLIC_NETWORKS list refuses the local-use\",\n692\t      \"maintainer_guidance_summary\": \"Other server package advisory in the same monorepo; affected package and ranges are recorded exactly. Not assigned to the filesystem package.\"\n693\t    },\n694\t    {\n695\t      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-v38p-wf49-hx2j\",\n696\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n697\t      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n698\t      \"published_at\": \"2026-10-25T00:19:06Z\",\n699\t      \"updated_at\": \"2026-10-25T00:19:07Z\",\n700\t      \"advisory_id\": \"GHSA-v38p-wf49-hx2j\",\n701\t      \"cve_id\": null,\n702\t      \"title\": \"fetch: private-address guard bypass via IDNA hostnames (check and connect resolve different names)\",\n703\t      \"severity\": \"medium\",\n704\t      \"vulnerabilities\": [\n705\t        {\n706\t          \"package\": {\n707\t            \"ecosystem\": \"pip\",\n708\t            \"name\": \"mcp-server-fetch\"\n709\t          },\n710\t          \"vulnerable_version_range\": \">= 2026.10.10, <= 2026.10.19\",\n711\t          \"patched_versions\": \"2026.10.24\",\n712\t          \"vulnerable_functions\": []\n713\t        }\n714\t      ],\n715\t      \"excerpt\": \"Summary The private-address guard added in mcp-server-fetch 2026.10.10 checks a different hostname than the one httpx connects to when the\",\n716\t      \"maintainer_guidance_summary\": \"Other server package advisory in the same monorepo; affected package and ranges are recorded exactly. Not assigned to the filesystem package.\"\n717\t    },\n718\t    {\n719\t      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-53mr-w429-c597\",\n720\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n721\t      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n722\t      \"published_at\": \"2026-10-25T00:19:21Z\",\n723\t      \"updated_at\": \"2026-10-25T00:51:09Z\",\n724\t      \"advisory_id\": \"GHSA-53mr-w429-c597\",\n725\t      \"cve_id\": null,\n726\t      \"title\": \"Parent-Directory Fallback TOCTOU in @modelcontextprotocol/server-filesystem Permits Arbitrary File Write Outside allowedDirectories\",\n727\t      \"severity\": \"low\",\n728\t      \"vulnerabilities\": [\n729\t        {\n730\t          \"package\": {\n731\t            \"ecosystem\": \"npm\",\n732\t            \"name\": \"@modelcontextprotocol/server-filesystem\"\n733\t          },\n734\t          \"vulnerable_version_range\": \">= 2025.1.14, <= 2026.8.31\",\n735\t          \"patched_versions\": null,\n736\t          \"vulnerable_functions\": []\n737\t        },\n738\t        {\n739\t          \"package\": {\n740\t            \"ecosystem\": \"npm\",\n741\t            \"name\": \"@modelcontextprotocol/server-filesystem\"\n742\t          },\n743\t          \"vulnerable_version_range\": \"< 2.0.1\",\n744\t          \"patched_versions\": \"2.0.1\",\n745\t          \"vulnerable_functions\": []\n746\t        }\n747\t      ],\n748\t      \"excerpt\": \"Summary validatePath() in lib.js contains an ENOENT fallback intended to permit creation of new files whose parents exist inside an\",\n749\t      \"maintainer_guidance_summary\": \"A separate local process can swap a parent for a symlink after checking it. 2.0.1 anchors writes on Linux/macOS; Windows remains partly unfixed. On Windows avoid allowed directories writable by untrusted local processes/users. Complete fix tracked by issue 5260. Date-version users must explicitly install 2.0.1.\"\n750\t    },\n751\t    {\n752\t      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-hhwq-wxfx-cj7g\",\n753\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n754\t      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n755\t      \"published_at\": \"2026-10-25T00:19:37Z\",\n756\t      \"updated_at\": \"2026-10-25T00:19:37Z\",\n757\t      \"advisory_id\": \"GHSA-hhwq-wxfx-cj7g\",\n758\t      \"cve_id\": null,\n759\t      \"title\": \"@modelcontextprotocol/server-filesystem list_directory_with_sizes follows symlinks and leaks outside-directory file metadata\",\n760\t      \"severity\": \"low\",\n761\t      \"vulnerabilities\": [\n762\t        {\n763\t          \"package\": {\n764\t            \"ecosystem\": \"npm\",\n765\t            \"name\": \"@modelcontextprotocol/server-filesystem\"\n766\t          },\n767\t          \"vulnerable_version_range\": \">= 2025.7.1, <= 2026.8.31\",\n768\t          \"patched_versions\": null,\n769\t          \"vulnerable_functions\": []\n770\t        },\n771\t        {\n772\t          \"package\": {\n773\t            \"ecosystem\": \"npm\",\n774\t            \"name\": \"@modelcontextprotocol/server-filesystem\"\n775\t          },\n776\t          \"vulnerable_version_range\": \">= 1.0.0, < 2.0.1\",\n777\t          \"patched_versions\": \"2.0.1\",\n778\t          \"vulnerable_functions\": []\n779\t        }\n780\t      ],\n781\t      \"excerpt\": \"Description list_directory_with_sizes validates only the requested directory path. It then iterates over entries and calls fs.stat(entryPath) on each child without\",\n782\t      \"maintainer_guidance_summary\": \"list_directory_with_sizes follows child symlinks and discloses outside-target metadata. Validate children or use lstat without following the target. Date-version users must explicitly install 2.0.1.\"\n783\t    },\n784\t    {\n785\t      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-mvf5-2qqv-rg3c\",\n786\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n787\t      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n788\t      \"published_at\": \"2026-10-25T00:19:52Z\",\n789\t      \"updated_at\": \"2026-10-25T00:19:52Z\",\n790\t      \"advisory_id\": \"GHSA-mvf5-2qqv-rg3c\",\n791\t      \"cve_id\": null,\n792\t      \"title\": \" Cross-Origin Environment Variable Exfiltration in @modelcontextprotocol/server-everything\",\n793\t      \"severity\": \"medium\",\n794\t      \"vulnerabilities\": [\n795\t        {\n796\t          \"package\": {\n797\t            \"ecosystem\": \"npm\",\n798\t            \"name\": \"@modelcontextprotocol/server-everything\"\n799\t          },\n800\t          \"vulnerable_version_range\": \">= 2025.9.24, <= 2026.8.31\",\n801\t          \"patched_versions\": null,\n802\t          \"vulnerable_functions\": []\n803\t        },\n804\t        {\n805\t          \"package\": {\n806\t            \"ecosystem\": \"npm\",\n807\t            \"name\": \"@modelcontextprotocol/server-everything\"\n808\t          },\n809\t          \"vulnerable_version_range\": \">= 1.0.0, < 2.0.1\",\n810\t          \"patched_versions\": \"2.0.1\",\n811\t          \"vulnerable_functions\": []\n812\t        }\n813\t      ],\n814\t      \"excerpt\": \"Summary The mcp-server-everything package ships an HTTP MCP server that binds to all network interfaces (0.0.0.0) with wildcard CORS (Access-Control-Allow-Origin:\",\n815\t      \"maintainer_guidance_summary\": \"Other server package advisory in the same monorepo; affected package and ranges are recorded exactly. Not assigned to the filesystem package.\"\n816\t    },\n817\t    {\n818\t      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-vjqx-cfc4-9h6v\",\n819\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n820\t      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n821\t      \"published_at\": \"2026-02-25T23:21:57Z\",\n822\t      \"updated_at\": \"2026-02-25T23:21:57Z\",\n823\t      \"advisory_id\": \"GHSA-vjqx-cfc4-9h6v\",\n824\t      \"cve_id\": \"CVE-2026-27735\",\n825\t      \"title\": \"Path traversal in git_add allows staging files outside repository boundaries in mcp-server-git\",\n826\t      \"severity\": \"medium\",\n827\t      \"vulnerabilities\": [\n828\t        {\n829\t          \"package\": {\n830\t            \"ecosystem\": \"pip\",\n831\t            \"name\": \"mcp-server-git\"\n832\t          },\n833\t          \"vulnerable_version_range\": \"< 2026.1.14\",\n834\t          \"patched_versions\": \"2026.1.14\",\n835\t          \"vulnerable_functions\": []\n836\t        }\n837\t      ],\n838\t      \"excerpt\": \"In mcp-server-git versions prior to 2026.1.14, the git_add tool did not validate that file paths provided in the files argument\",\n839\t      \"maintainer_guidance_summary\": \"Other server package advisory in the same monorepo; affected package and ranges are recorded exactly. Not assigned to the filesystem package.\"\n840\t    },\n841\t    {\n842\t      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-5cgr-j3jf-jw3v\",\n843\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n844\t      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n845\t      \"published_at\": \"2025-12-17T15:55:26Z\",\n846\t      \"updated_at\": \"2025-12-17T15:55:26Z\",\n847\t      \"advisory_id\": \"GHSA-5cgr-j3jf-jw3v\",\n848\t      \"cve_id\": \"CVE-2025-68143\",\n849\t      \"title\": \"Unrestricted git_init tool allows repository creation at arbitrary filesystem locations in mcp-server-git\",\n850\t      \"severity\": \"medium\",\n851\t      \"vulnerabilities\": [\n852\t        {\n853\t          \"package\": {\n854\t            \"ecosystem\": \"pip\",\n855\t            \"name\": \"mcp-server-git\"\n856\t          },\n857\t          \"vulnerable_version_range\": \"< 2025.9.25\",\n858\t          \"patched_versions\": \"2025.9.25\",\n859\t          \"vulnerable_functions\": []\n860\t        }\n861\t      ],\n862\t      \"excerpt\": \"In mcp-server-git versions prior to 2025.9.25, the git_init tool accepted arbitrary filesystem paths and created Git repositories without validating the\",\n863\t      \"maintainer_guidance_summary\": \"Other server package advisory in the same monorepo; affected package and ranges are recorded exactly. Not assigned to the filesystem package.\"\n864\t    },\n865\t    {\n866\t      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-9xwc-hfwc-8w59\",\n867\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n868\t      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n869\t      \"published_at\": \"2025-12-17T16:01:56Z\",\n870\t      \"updated_at\": \"2025-12-18T16:34:24Z\",\n871\t      \"advisory_id\": \"GHSA-9xwc-hfwc-8w59\",\n872\t      \"cve_id\": \"CVE-2025-68144\",\n873\t      \"title\": \"Argument injection in git_diff and git_checkout functions for mcp-server-git allows overwriting local files\",\n874\t      \"severity\": \"medium\",\n875\t      \"vulnerabilities\": [\n876\t        {\n877\t          \"package\": {\n878\t            \"ecosystem\": \"pip\",\n879\t            \"name\": \"mcp-server-git\"\n880\t          },\n881\t          \"vulnerable_version_range\": \"< 2025.12.18\",\n882\t          \"patched_versions\": \"2025.12.18\",\n883\t          \"vulnerable_functions\": []\n884\t        }\n885\t      ],\n886\t      \"excerpt\": \"In mcp-server-git versions prior to 2025.12.18, the git_diff and git_checkout functions passed user-controlled arguments directly to git CLI commands without\",\n887\t      \"maintainer_guidance_summary\": \"Other server package advisory in the same monorepo; affected package and ranges are recorded exactly. Not assigned to the filesystem package.\"\n888\t    },\n889\t    {\n890\t      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-j22h-9j4x-23w5\",\n891\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n892\t      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n893\t      \"published_at\": \"2025-12-17T16:04:43Z\",\n894\t      \"updated_at\": \"2025-12-18T16:34:49Z\",\n895\t      \"advisory_id\": \"GHSA-j22h-9j4x-23w5\",\n896\t      \"cve_id\": \"CVE-2025-68145\",\n897\t      \"title\": \"Missing path validation when using --repository flag in mcp-server-git\",\n898\t      \"severity\": \"medium\",\n899\t      \"vulnerabilities\": [\n900\t        {\n901\t          \"package\": {\n902\t            \"ecosystem\": \"pip\",\n903\t            \"name\": \"mcp-server-git\"\n904\t          },\n905\t          \"vulnerable_version_range\": \"< 2025.12.18\",\n906\t          \"patched_versions\": \"2025.12.18\",\n907\t          \"vulnerable_functions\": []\n908\t        }\n909\t      ],\n910\t      \"excerpt\": \"In mcp-server-git versions prior to 2025.12.18, when the server is started with the --repository flag to restrict operations to a\",\n911\t      \"maintainer_guidance_summary\": \"Other server package advisory in the same monorepo; affected package and ranges are recorded exactly. Not assigned to the filesystem package.\"\n912\t    },\n913\t    {\n914\t      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-hc55-p739-j48w\",\n915\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n916\t      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n917\t      \"published_at\": \"2025-07-01T18:39:04Z\",\n918\t      \"updated_at\": \"2025-07-01T18:39:04Z\",\n919\t      \"advisory_id\": \"GHSA-hc55-p739-j48w\",\n920\t      \"cve_id\": \"CVE-2025-53110\",\n921\t      \"title\": \"Path validation bypass via colliding path prefix\",\n922\t      \"severity\": \"high\",\n923\t      \"vulnerabilities\": [\n924\t        {\n925\t          \"package\": {\n926\t            \"ecosystem\": \"npm\",\n927\t            \"name\": \"@modelcontextprotocol/server-filesystem\"\n928\t          },\n929\t          \"vulnerable_version_range\": \"< 0.6.3, < 2025.3.28\",\n930\t          \"patched_versions\": \"0.6.3, 2025.7.01\",\n931\t          \"vulnerable_functions\": []\n932\t        }\n933\t      ],\n934\t      \"excerpt\": \"Versions of Filesystem prior to 0.6.3 & 2025.3.28 could allow access to unintended files in cases where the prefix matches\",\n935\t      \"maintainer_guidance_summary\": \"Colliding directory prefixes can escape allowed paths. Advisory prose recommends 0.6.4 or 2025.7.01; structured patched field says 0.6.3, 2025.7.01. Preserve this discrepancy.\"\n936\t    },\n937\t    {\n938\t      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-q66q-fx2p-7w4m\",\n939\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n940\t      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n941\t      \"published_at\": \"2025-07-01T18:38:24Z\",\n942\t      \"updated_at\": \"2025-07-01T18:38:24Z\",\n943\t      \"advisory_id\": \"GHSA-q66q-fx2p-7w4m\",\n944\t      \"cve_id\": \"CVE-2025-53109\",\n945\t      \"title\": \"Path validation bypass via symlink handling\",\n946\t      \"severity\": \"high\",\n947\t      \"vulnerabilities\": [\n948\t        {\n949\t          \"package\": {\n950\t            \"ecosystem\": \"npm\",\n951\t            \"name\": \"@modelcontextprotocol/server-filesystem\"\n952\t          },\n953\t          \"vulnerable_version_range\": \"< 0.6.3, < 2025.3.28\",\n954\t          \"patched_versions\": \"0.6.3, 2025.7.01\",\n955\t          \"vulnerable_functions\": []\n956\t        }\n957\t      ],\n958\t      \"excerpt\": \"Versions of Filesystem prior to 0.6.3 & 2025.3.28 could allow access to unintended files via symlinks within allowed directories. Users\",\n959\t      \"maintainer_guidance_summary\": \"Symlinks inside allowed directories can reach unintended files. Advisory prose recommends 0.6.4 or 2025.7.01; structured patched field says 0.6.3, 2025.7.01. Preserve this discrepancy.\"\n960\t    },\n961\t    {\n962\t      \"url\": \"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories?per_page=100\",\n963\t      \"retrieved_at\": \"2026-10-26T10:13:35.940541+00:00\",\n964\t      \"published_at\": null,\n965\t      \"updated_at\": null,\n966\t      \"published_advisory_count\": 10,\n967\t      \"query_scope\": \"Public maintainer repository advisory collection, per_page=100; an empty collection establishes only absence of published entries in this collection.\"\n968\t    },\n969\t    {\n970\t      \"url\": \"https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-6qxp-vccf-f47h\",\n971\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories?per_page=100\",\n972\t      \"retrieved_at\": \"2026-10-26T10:13:35.940541+00:00\",\n973\t      \"published_at\": \"2026-09-30T20:59:40Z\",\n974\t      \"updated_at\": \"2026-10-02T16:21:20Z\",\n975\t      \"advisory_id\": \"GHSA-6qxp-vccf-f47h\",\n976\t      \"cve_id\": \"CVE-2026-104850\",\n977\t      \"title\": \"OAuth client could send credentials to an authorization server chosen by the MCP server\",\n978\t      \"severity\": \"high\",\n979\t      \"vulnerabilities\": [\n980\t        {\n981\t          \"package\": {\n982\t            \"ecosystem\": \"npm\",\n983\t            \"name\": \"@modelcontextprotocol/sdk\"\n984\t          },\n985\t          \"vulnerable_version_range\": \">= 1.12.0, < 1.31.0\",\n986\t          \"patched_versions\": \"1.31.0\",\n987\t          \"vulnerable_functions\": []\n988\t        },\n989\t        {\n990\t          \"package\": {\n991\t            \"ecosystem\": \"npm\",\n992\t            \"name\": \"@modelcontextprotocol/client\"\n993\t          },\n994\t          \"vulnerable_version_range\": \">= 2.0.0, < 2.2.0\",\n995\t          \"patched_versions\": \"2.2.0\",\n996\t          \"vulnerable_functions\": []\n997\t        }\n998\t      ],\n999\t      \"excerpt\": \"Summary In affected versions, the SDK's OAuth client let the MCP server decide which authorization server received the client's OAuth\",\n1000\t      \"maintainer_guidance_summary\": \"HTTP OAuth clients holding credentials can send them to an authorization server selected by an untrusted MCP server. Servers and stdio clients are excluded. Upgrade; bundled providers still need expectedIssuer, saved credentials need issuer or clearing, and custom providers must preserve issuer. Direct refreshAuthorization/exchangeAuthorization calls and skipIssuerMetadataValidation remain outside the fix.\"\n1001\t    },\n1002\t    {\n1003\t      \"url\": \"https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-rvq5-wwqv-78pq\",\n1004\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories?per_page=100\",\n1005\t      \"retrieved_at\": \"2026-10-26T10:13:35.940541+00:00\",\n1006\t      \"published_at\": \"2026-10-05T16:01:06Z\",\n1007\t      \"updated_at\": \"2026-10-19T20:12:07Z\",\n1008\t      \"advisory_id\": \"GHSA-rvq5-wwqv-78pq\",\n1009\t      \"cve_id\": \"CVE-2026-111771\",\n1010\t      \"title\": \"Server bearer authentication accepted tokens issued for another service\",\n1011\t      \"severity\": \"medium\",\n1012\t      \"vulnerabilities\": [\n1013\t        {\n1014\t          \"package\": {\n1015\t            \"ecosystem\": \"npm\",\n1016\t            \"name\": \"@modelcontextprotocol/sdk\"\n1017\t          },\n1018\t          \"vulnerable_version_range\": \">= 1.6.0, < 1.32.0\",\n1019\t          \"patched_versions\": \"1.32.0\",\n1020\t          \"vulnerable_functions\": []\n1021\t        },\n1022\t        {\n1023\t          \"package\": {\n1024\t            \"ecosystem\": \"npm\",\n1025\t            \"name\": \"@modelcontextprotocol/server\"\n1026\t          },\n1027\t          \"vulnerable_version_range\": \">= 2.0.0, < 2.3.0\",\n1028\t          \"patched_versions\": \"2.3.0\",\n1029\t          \"vulnerable_functions\": []\n1030\t        },\n1031\t        {\n1032\t          \"package\": {\n1033\t            \"ecosystem\": \"npm\",\n1034\t            \"name\": \"@modelcontextprotocol/express\"\n1035\t          },\n1036\t          \"vulnerable_version_range\": \">= 2.0.0, < 2.0.2\",\n1037\t          \"patched_versions\": \"2.0.2\",\n1038\t          \"vulnerable_functions\": []\n1039\t        },\n1040\t        {\n1041\t          \"package\": {\n1042\t            \"ecosystem\": \"npm\",\n1043\t            \"name\": \"@modelcontextprotocol/server-legacy\"\n1044\t          },\n1045\t          \"vulnerable_version_range\": \">= 2.0.0, < 2.3.1\",\n1046\t          \"patched_versions\": \"2.3.1\",\n1047\t          \"vulnerable_functions\": []\n1048\t        }\n1049\t      ],\n1050\t      \"excerpt\": \"Summary In affected versions, the SDK's server-side bearer authentication had no way to check that a token was issued for\",\n1051\t      \"maintainer_guidance_summary\": \"HTTP bearer authentication may accept tokens for another audience when the verifier omits audience checks. Upgrading alone does not enable protection: set expectedResource and return AuthInfo.resource from verifyAccessToken; alternatively enforce aud in the verifier.\"\n1052\t    },\n1053\t    {\n1054\t      \"url\": \"https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-22jm-h49p-29qw\",\n1055\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories?per_page=100\",\n1056\t      \"retrieved_at\": \"2026-10-26T10:13:35.940541+00:00\",\n1057\t      \"published_at\": \"2026-10-02T20:54:41Z\",\n1058\t      \"updated_at\": \"2026-10-19T19:50:48Z\",\n1059\t      \"advisory_id\": \"GHSA-22jm-h49p-29qw\",\n1060\t      \"cve_id\": \"CVE-2026-111767\",\n1061\t      \"title\": \"Experimental tasks were not tied to the session that created them\",\n1062\t      \"severity\": \"high\",\n1063\t      \"vulnerabilities\": [\n1064\t        {\n1065\t          \"package\": {\n1066\t            \"ecosystem\": \"npm\",\n1067\t            \"name\": \"@modelcontextprotocol/sdk\"\n1068\t          },\n1069\t          \"vulnerable_version_range\": \">= 1.24.0, < 1.32.0\",\n1070\t          \"patched_versions\": \"1.32.0\",\n1071\t          \"vulnerable_functions\": []\n1072\t        }\n1073\t      ],\n1074\t      \"excerpt\": \"Summary In affected versions, the experimental tasks feature (taskStore) did not check which session created a task. Clients sharing one\",\n1075\t      \"maintainer_guidance_summary\": \"Experimental taskStore tasks were not session-bound. Upgrade or remove taskStore or allocate one InMemoryTaskStore per session; 2.x packages excluded.\"\n1076\t    },\n1077\t    {\n1078\t      \"url\": \"https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-jm63-cq47-j5jp\",\n1079\t      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories?per_page=100\",\n1080\t      \"retrieved_at\": \"2026-10-26T10:13:35.940541+00:00\",\n1081\t      \"published_at\": \"2026-10-15T13:10:24Z\",\n1082\t      \"updated_at\": \"2026-10-19T20:09:41Z\",\n1083\t      \"advisory_id\": \"GHSA-jm63-cq47-j5jp\",\n1084\t      \"cve_id\": \"CVE-2026-111770\",\n1085\t      \"title\": \"Shared transport or server instances delivered one HTTP client's messages to another\",\n1086\t      \"severity\": \"high\",\n1087\t      \"vulnerabilities\": [\n1088\t        {\n1089\t          \"package\": {\n1090\t            \"ecosystem\": \"npm\",\n1091\t            \"name\": \"@modelcontextprotocol/server\"\n1092\t          },"}]},"parent_tool_use_id":null,"session_id":"37fb73b0-c435-4c14-8aa8-60d6fbf1b4a4","uuid":"63d43cfa-84ce-46aa-ba5e-9832ccb690df","timestamp":"2026-10-26T10:18:46.624Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-real-mcp-review-ykafdtru/research/sources.json","content":"{\n  \"schema_version\": 1,\n  \"scope\": \"Public official repository metadata, source manifests, documentation and maintainer advisory records only. Exact reviewed commits are supplied separately. No code execution, live service connection or assessment conclusions.\",\n