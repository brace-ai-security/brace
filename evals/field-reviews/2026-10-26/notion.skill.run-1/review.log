\t          \"vulnerable_functions\": []\n535\t        }\n536\t      ],\n537\t      \"excerpt\": \"Summary When running in HTTP mode with --lockdown-mode enabled, the RepoAccessCache is implemented as a process-global singleton initialized with the\",\n538\t      \"maintainer_guidance_summary\": \"HTTP deployments using --lockdown-mode share the first authenticated user\\u2019s GraphQL client across users. Advisory patch field: 1.1.2.\"\n539\t    },\n540\t    {\n541\t      \"url\": \"https://github.com/github/github-mcp-server/security/advisories/GHSA-w4q6-qw23-4rg7\",\n542\t      \"collection_url\": \"https://api.github.com/repos/github/github-mcp-server/security-advisories?per_page=100\",\n543\t      \"retrieved_at\": \"2026-10-26T10:13:34.559933+00:00\",\n544\t      \"published_at\": \"2026-07-20T12:01:42Z\",\n545\t      \"updated_at\": \"2026-07-20T12:01:42Z\",\n546\t      \"advisory_id\": \"GHSA-w4q6-qw23-4rg7\",\n547\t      \"cve_id\": \"CVE-2026-47427\",\n548\t      \"title\": \"Nil Pointer Dereference DoS in completion/complete Handler\",\n549\t      \"severity\": \"high\",\n550\t      \"vulnerabilities\": [\n551\t        {\n552\t          \"package\": {\n553\t            \"ecosystem\": \"go\",\n554\t            \"name\": \"github.com/github/github-mcp-server\"\n555\t          },\n556\t          \"vulnerable_version_range\": \"<= 0.33.0 (also affects latest main)\",\n557\t          \"patched_versions\": \"\",\n558\t          \"vulnerable_functions\": []\n559\t        }\n560\t      ],\n561\t      \"excerpt\": \"Summary A nil pointer dereference vulnerability in the GitHub MCP Server causes it to crash when receiving a malformed completion/complete\",\n562\t      \"maintainer_guidance_summary\": \"Malformed completion/complete input can panic before authentication. Patched-version field is empty; advisory suggests validating params and ref. Its \\u201clatest main\\u201d wording is historical advisory text, not a verified statement about today\\u2019s main.\"\n