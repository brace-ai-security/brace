vulnerabilities\": [\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/server-filesystem\"\n          },\n          \"vulnerable_version_range\": \">= 2025.1.14, <= 2026.8.31\",\n          \"patched_versions\": null,\n          \"vulnerable_functions\": []\n        },\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/server-filesystem\"\n          },\n          \"vulnerable_version_range\": \"< 2.0.1\",\n          \"patched_versions\": \"2.0.1\",\n          \"vulnerable_functions\": []\n        }\n      ],\n      \"excerpt\": \"Summary validatePath() in lib.js contains an ENOENT fallback intended to permit creation of new files whose parents exist inside an\",\n      \"maintainer_guidance_summary\": \"A separate local process can swap a parent for a symlink after checking it. 2.0.1 anchors writes on Linux/macOS; Windows remains partly unfixed. On Windows avoid allowed directories writable by untrusted local processes/users. Complete fix tracked by issue 5260. Date-version users must explicitly install 2.0.1.\"\n    },\n    {\n      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-hhwq-wxfx-cj7g\",\n      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n      \"published_at\": \"2026-10-25T00:19:37Z\",\n      \"updated_at\": \"2026-10-25T00:19:37Z\",\n      \"advisory_id\": \"GHSA-hhwq-wxfx-cj7g\",\n      \"cve_id\": null,\n      \"title\": \"@modelcontextprotocol/server-filesystem list_directory_with_sizes follows symlinks and leaks outside-directory file metadata\",\n      \"severity\": \"low\",\n      \"vulnerabilities\": [\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/server-filesystem\"\n          },\n          \"vulnerable_version_range\": \">= 2025.7.1, <= 2026.8.31\",\n          \"patched_versions\": null,\n          \"vulnerable_functions\": []\n        },\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/server-filesystem\"\n          },\n          \"vulnerable_version_range\": \">= 1.0.0, < 2.0.1\",\n          \"patched_versions\": \"2.0.1\",\n          \"vulnerable_functions\": []\n        }\n      ],\n      \"excerpt\": \"Description list_directory_with_sizes validates only the requested directory path. It then iterates over entries and calls fs.stat(entryPath) on each child without\",\n      \"maintainer_guidance_summary\": \"list_directory_with_sizes follows child symlinks and discloses outside-target metadata. Validate children or use lstat without following the target. Date-version users must explicitly install 2.0.1.\"\n    },\n    {\n      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-mvf5-2qqv-rg3c\",\n      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n      \"published_at\": \"2026-10-25T00:19:52Z\",\n      \"updated_at\": \"2026-10-25T00:19:52Z\",\n      \"advisory_id\": \"GHSA-mvf5-2qqv-rg3c\",\n      \"cve_id\": null,\n      \"title\": \" Cross-Origin Environment Variable Exfiltration in @modelcontextprotocol/server-everything\",\n      \"severity\": \"medium\",\n      \"vulnerabilities\": [\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/server-everything\"\n          },\n          \"vulnerable_version_range\": \">= 2025.9.24, <= 2026.8.31\",\n          \"patched_versions\": null,\n          \"vulnerable_functions\": []\n        },\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/server-everything\"\n          },\n          \"vulnerable_version_range\": \">= 1.0.0, < 2.0.1\",\n          \"patched_versions\": \"2.0.1\",\n          \"vulnerable_functions\": []\n        }\n      ],\n      \"excerpt\": \"Summary The mcp-server-everything package ships an HTTP MCP server that binds to all network interfaces (0.0.0.0) with wildcard CORS (Access-Control-Allow-Origin:\",\n      \"maintainer_guidance_summary\": \"Other server package advisory in the same monorepo; affected package and ranges are recorded exactly. Not assigned to the filesystem package.\"\n    },\n    {\n      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-vjqx-cfc4-9h6v\",\n      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n      \"published_at\": \"2026-02-25T23:21:57Z\",\n      \"updated_at\": \"2026-02-25T23:21:57Z\",\n      \"advisory_id\": \"GHSA-vjqx-cfc4-9h6v\",\n      \"cve_id\": \"CVE-2026-27735\",\n      \"title\": \"Path traversal in git_add allows staging files outside repository boundaries in mcp-server-git\",\n      \"severity\": \"medium\",\n      \"vulnerabilities\": [\n        {\n          \"package\": {\n            \"ecosystem\": \"pip\",\n            \"name\": \"mcp-server-git\"\n          },\n          \"vulnerable_version_range\": \"< 2026.1.14\",\n          \"patched_versions\": \"2026.1.14\",\n          \"vulnerable_functions\": []\n        }\n      ],\n      \"excerpt\": \"In mcp-server-git versions prior to 2026.1.14, the git_add tool did not validate that file paths provided in the files argument\",\n      \"maintainer_guidance_summary\": \"Other server package advisory in the same monorepo; affected package and ranges are recorded exactly. Not assigned to the filesystem package.\"\n    },\n    {\n      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-5cgr-j3jf-jw3v\",\n      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n      \"published_at\": \"2025-12-17T15:55:26Z\",\n      \"updated_at\": \"2025-12-17T15:55:26Z\",\n      \"advisory_id\": \"GHSA-5cgr-j3jf-jw3v\",\n      \"cve_id\": \"CVE-2025-68143\",\n      \"title\": \"Unrestricted git_init tool allows repository creation at arbitrary filesystem locations in mcp-server-git\",\n      \"severity\": \"medium\",\n      \"vulnerabilities\": [\n        {\n          \"package\": {\n            \"ecosystem\": \"pip\",\n            \"name\": \"mcp-server-git\"\n          },\n          \"vulnerable_version_range\": \"< 2025.9.25\",\n          \"patched_versions\": \"2025.9.25\",\n          \"vulnerable_functions\": []\n        }\n      ],\n      \"excerpt\": \"In mcp-server-git versions prior to 2025.9.25, the git_init tool accepted arbitrary filesystem paths and created Git repositories without validating the\",\n      \"maintainer_guidance_summary\": \"Other server package advisory in the same monorepo; affected package and ranges are recorded exactly. Not assigned to the filesystem package.\"\n    },\n    {\n      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-9xwc-hfwc-8w59\",\n      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n      \"published_at\": \"2025-12-17T16:01:56Z\",\n      \"updated_at\": \"2025-12-18T16:34:24Z\",\n      \"advisory_id\": \"GHSA-9xwc-hfwc-8w59\",\n      \"cve_id\": \"CVE-2025-68144\",\n      \"title\": \"Argument injection in git_diff and git_checkout functions for mcp-server-git allows overwriting local files\",\n      \"severity\": \"medium\",\n      \"vulnerabilities\": [\n        {\n          \"package\": {\n            \"ecosystem\": \"pip\",\n            \"name\": \"mcp-server-git\"\n          },\n          \"vulnerable_version_range\": \"< 2025.12.18\",\n          \"patched_versions\": \"2025.12.18\",\n          \"vulnerable_functions\": []\n        }\n      ],\n      \"excerpt\": \"In mcp-server-git versions prior to 2025.12.18, the git_diff and git_checkout functions passed user-controlled arguments directly to git CLI commands without\",\n      \"maintainer_guidance_summary\": \"Other server package advisory in the same monorepo; affected package and ranges are recorded exactly. Not assigned to the filesystem package.\"\n    },\n    {\n      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-j22h-9j4x-23w5\",\n      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n      \"published_at\": \"2025-12-17T16:04:43Z\",\n      \"updated_at\": \"2025-12-18T16:34:49Z\",\n      \"advisory_id\": \"GHSA-j22h-9j4x-23w5\",\n      \"cve_id\": \"CVE-2025-68145\",\n      \"title\": \"Missing path validation when using --repository flag in mcp-server-git\",\n      \"severity\": \"medium\",\n      \"vulnerabilities\": [\n        {\n          \"package\": {\n            \"ecosystem\": \"pip\",\n            \"name\": \"mcp-server-git\"\n          },\n          \"vulnerable_version_range\": \"< 2025.12.18\",\n          \"patched_versions\": \"2025.12.18\",\n          \"vulnerable_functions\": []\n        }\n      ],\n      \"excerpt\": \"In mcp-server-git versions prior to 2025.12.18, when the server is started with the --repository flag to restrict operations to a\",\n      \"maintainer_guidance_summary\": \"Other server package advisory in the same monorepo; affected package and ranges are recorded exactly. Not assigned to the filesystem package.\"\n    },\n    {\n      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-hc55-p739-j48w\",\n      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n      \"published_at\": \"2025-07-01T18:39:04Z\",\n      \"updated_at\": \"2025-07-01T18:39:04Z\",\n      \"advisory_id\": \"GHSA-hc55-p739-j48w\",\n      \"cve_id\": \"CVE-2025-53110\",\n      \"title\": \"Path validation bypass via colliding path prefix\",\n      \"severity\": \"high\",\n      \"vulnerabilities\": [\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/server-filesystem\"\n          },\n          \"vulnerable_version_range\": \"< 0.6.3, < 2025.3.28\",\n          \"patched_versions\": \"0.6.3, 2025.7.01\",\n          \"vulnerable_functions\": []\n        }\n      ],\n      \"excerpt\": \"Versions of Filesystem prior to 0.6.3 & 2025.3.28 could allow access to unintended files in cases where the prefix matches\",\n      \"maintainer_guidance_summary\": \"Colliding directory prefixes can escape allowed paths. Advisory prose recommends 0.6.4 or 2025.7.01; structured patched field says 0.6.3, 2025.7.01. Preserve this discrepancy.\"\n    },\n    {\n      \"url\": \"https://github.com/modelcontextprotocol/servers/security/advisories/GHSA-q66q-fx2p-7w4m\",\n      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/servers/security-advisories?per_page=100\",\n      \"retrieved_at\": \"2026-10-26T10:13:35.440062+00:00\",\n      \"published_at\": \"2025-07-01T18:38:24Z\",\n      \"updated_at\": \"2025-07-01T18:38:24Z\",\n      \"advisory_id\": \"GHSA-q66q-fx2p-7w4m\",\n      \"cve_id\": \"CVE-2025-53109\",\n      \"title\": \"Path validation bypass via symlink handling\",\n      \"severity\": \"high\",\n      \"vulnerabilities\": [\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/server-filesystem\"\n          },\n          \"vulnerable_version_range\": \"< 0.6.3, < 2025.3.28\",\n          \"patched_versions\": \"0.6.3, 2025.7.01\",\n          \"vulnerable_functions\": []\n        }\n      ],\n      \"excerpt\": \"Versions of Filesystem prior to 0.6.3 & 2025.3.28 could allow access to unintended files via symlinks within allowed directories. Users\",\n      \"maintainer_guidance_summary\": \"Symlinks inside allowed directories can reach unintended files. Advisory prose recommends 0.6.4 or 2025.7.01; structured patched field says 0.6.3, 2025.7.01. Preserve this discrepancy.\"\n    },\n    {\n      \"url\": \"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories?per_page=100\",\n      \"retrieved_at\": \"2026-10-26T10:13:35.940541+00:00\",\n      \"published_at\": null,\n      \"updated_at\": null,\n      \"published_advisory_count\": 10,\n      \"query_scope\": \"Public maintainer repository advisory collection, per_page=100; an empty collection establishes only absence of published entries in this collection.\"\n    },\n    {\n      \"url\": \"https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-6qxp-vccf-f47h\",\n      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories?per_page=100\",\n      \"retrieved_at\": \"2026-10-26T10:13:35.940541+00:00\",\n      \"published_at\": \"2026-09-30T20:59:40Z\",\n      \"updated_at\": \"2026-10-02T16:21:20Z\",\n      \"advisory_id\": \"GHSA-6qxp-vccf-f47h\",\n      \"cve_id\": \"CVE-2026-104850\",\n      \"title\": \"OAuth client could send credentials to an authorization server chosen by the MCP server\",\n      \"severity\": \"high\",\n      \"vulnerabilities\": [\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/sdk\"\n          },\n          \"vulnerable_version_range\": \">= 1.12.0, < 1.31.0\",\n          \"patched_versions\": \"1.31.0\",\n          \"vulnerable_functions\": []\n        },\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/client\"\n          },\n          \"vulnerable_version_range\": \">= 2.0.0, < 2.2.0\",\n          \"patched_versions\": \"2.2.0\",\n          \"vulnerable_functions\": []\n        }\n      ],\n      \"excerpt\": \"Summary In affected versions, the SDK's OAuth client let the MCP server decide which authorization server received the client's OAuth\",\n      \"maintainer_guidance_summary\": \"HTTP OAuth clients holding credentials can send them to an authorization server selected by an untrusted MCP server. Servers and stdio clients are excluded. Upgrade; bundled providers still need expectedIssuer, saved credentials need issuer or clearing, and custom providers must preserve issuer. Direct refreshAuthorization/exchangeAuthorization calls and skipIssuerMetadataValidation remain outside the fix.\"\n    },\n    {\n      \"url\": \"https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-rvq5-wwqv-78pq\",\n      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories?per_page=100\",\n      \"retrieved_at\": \"2026-10-26T10:13:35.940541+00:00\",\n      \"published_at\": \"2026-10-05T16:01:06Z\",\n      \"updated_at\": \"2026-10-19T20:12:07Z\",\n      \"advisory_id\": \"GHSA-rvq5-wwqv-78pq\",\n      \"cve_id\": \"CVE-2026-111771\",\n      \"title\": \"Server bearer authentication accepted tokens issued for another service\",\n      \"severity\": \"medium\",\n      \"vulnerabilities\": [\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/sdk\"\n          },\n          \"vulnerable_version_range\": \">= 1.6.0, < 1.32.0\",\n          \"patched_versions\": \"1.32.0\",\n          \"vulnerable_functions\": []\n        },\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/server\"\n          },\n          \"vulnerable_version_range\": \">= 2.0.0, < 2.3.0\",\n          \"patched_versions\": \"2.3.0\",\n          \"vulnerable_functions\": []\n        },\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/express\"\n          },\n          \"vulnerable_version_range\": \">= 2.0.0, < 2.0.2\",\n          \"patched_versions\": \"2.0.2\",\n          \"vulnerable_functions\": []\n        },\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/server-legacy\"\n          },\n          \"vulnerable_version_range\": \">= 2.0.0, < 2.3.1\",\n          \"patched_versions\": \"2.3.1\",\n          \"vulnerable_functions\": []\n        }\n      ],\n      \"excerpt\": \"Summary In affected versions, the SDK's server-side bearer authentication had no way to check that a token was issued for\",\n      \"maintainer_guidance_summary\": \"HTTP bearer authentication may accept tokens for another audience when the verifier omits audience checks. Upgrading alone does not enable protection: set expectedResource and return AuthInfo.resource from verifyAccessToken; alternatively enforce aud in the verifier.\"\n    },\n    {\n      \"url\": \"https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-22jm-h49p-29qw\",\n      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories?per_page=100\",\n      \"retrieved_at\": \"2026-10-26T10:13:35.940541+00:00\",\n      \"published_at\": \"2026-10-02T20:54:41Z\",\n      \"updated_at\": \"2026-10-19T19:50:48Z\",\n      \"advisory_id\": \"GHSA-22jm-h49p-29qw\",\n      \"cve_id\": \"CVE-2026-111767\",\n      \"title\": \"Experimental tasks were not tied to the session that created them\",\n      \"severity\": \"high\",\n      \"vulnerabilities\": [\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/sdk\"\n          },\n          \"vulnerable_version_range\": \">= 1.24.0, < 1.32.0\",\n          \"patched_versions\": \"1.32.0\",\n          \"vulnerable_functions\": []\n        }\n      ],\n      \"excerpt\": \"Summary In affected versions, the experimental tasks feature (taskStore) did not check which session created a task. Clients sharing one\",\n      \"maintainer_guidance_summary\": \"Experimental taskStore tasks were not session-bound. Upgrade or remove taskStore or allocate one InMemoryTaskStore per session; 2.x packages excluded.\"\n    },\n    {\n      \"url\": \"https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-jm63-cq47-j5jp\",\n      \"collection_url\": \"https://api.github.com/repos/modelcontextprotocol/typescript-sdk/security-advisories?per_page=100\",\n      \"retrieved_at\": \"2026-10-26T10:13:35.940541+00:00\",\n      \"published_at\": \"2026-10-15T13:10:24Z\",\n      \"updated_at\": \"2026-10-19T20:09:41Z\",\n      \"advisory_id\": \"GHSA-jm63-cq47-j5jp\",\n      \"cve_id\": \"CVE-2026-111770\",\n      \"title\": \"Shared transport or server instances delivered one HTTP client's messages to another\",\n      \"severity\": \"high\",\n      \"vulnerabilities\": [\n        {\n          \"package\": {\n            \"ecosystem\": \"npm\",\n            \"name\": \"@modelcontextprotocol/server\"\n          },","numLines":1092,"startLine":1,"totalLines":1444,"truncatedByTokenCap":true}},"tool_result_meta":[{"id":"toolu_01BeAKiPCNjGGXFQTMdYqZyA","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
