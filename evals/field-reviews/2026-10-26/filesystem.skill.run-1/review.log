{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018aHg5f7RF9tFRTgKBZrvev","type":"tool_result","content":"1\timport fs from \"fs/promises\";\n2\timport path from \"path\";\n3\timport { StringDecoder } from \"string_decoder\";\n4\timport { createTwoFilesPatch } from \"diff\";\n5\timport { minimatch } from \"minimatch\";\n6\timport { normalizePathFormat, expandHome } from \"./path-utils.js\";\n7\timport { isPathWithinAllowedDirectories } from \"./path-validation.js\";\n8\timport {\n9\t  createDirectoryInPlace,\n10\t  createFileInDirectory,\n11\t  overwriteFileInDirectory,\n12\t  renameIntoDirectory,\n13\t} from \"./pinned-directory.js\";\n14\t\n15\t// Type definitions\n16\tinterface FileInfo {\n17\t  size: number;\n18\t  created: Date;\n19\t  modified: Date;\n20\t  accessed: Date;\n21\t  isDirectory: boolean;\n22\t  isFile: boolean;\n23\t  permissions: string;\n24\t}\n25\t\n26\texport interface SearchOptions {\n27\t  excludePatterns?: string[];\n28\t}\n29\t\n30\texport interface SearchResult {\n31\t  path: string;\n32\t  isDirectory: boolean;\n33\t}\n34\t\n35\t// Pure Utility Functions\n36\texport function formatSize(bytes: number): string {\n37\t  const units = [\"B\", \"KB\", \"MB\", \"GB\", \"TB\"];\n38\t  if (bytes <= 0) return \"0 B\";\n39\t\n40\t  const i = Math.floor(Math.log(bytes) / Math.log(1024));\n41\t\n42\t  if (i < 0 || i === 0) return `${bytes} ${units[0]}`;\n43\t\n44\t  const unitIndex = Math.min(i, units.length - 1);\n45\t  return `${(bytes / Math.pow(1024, unitIndex)).toFixed(2)} ${units[unitIndex]}`;\n46\t}\n47\t\n48\texport function normalizeLineEndings(text: string): string {\n49\t  return text.replace(/\\r\\n/g, \"\\n\");\n50\t}\n51\t\n52\texport function createUnifiedDiff(\n53\t  originalContent: string,\n54\t  newContent: string,\n55\t  filepath: string = \"file\",\n56\t): string {\n57\t  // Ensure consistent line endings for diff\n58\t  const normalizedOriginal = normalizeLineEndings(originalContent);\n59\t  const normalizedNew = normalizeLineEndings(newContent);\n60\t\n61\t  return createTwoFilesPatch(\n62\t    filepath,\n63\t    filepath,\n64\t    normalizedOriginal,\n65\t    normalizedNew,\n66\t    \"original\",\n67\t    \"modified\",\n68\t  );\n69\t}\n70\t\n71\t// Helper function to resolve relative paths against allowed directories\n72\tfunction resolveRelativePathAgainstAllowedDirectories(\n73\t  relativePath: string,\n74\t  allowedDirectories: readonly string[],\n75\t): string {\n76\t  if (allowedDirectories.length === 0) {\n77\t    // Fallback to process.cwd() if no allowed directories are set\n78\t    return path.resolve(process.cwd(), relativePath);\n79\t  }\n80\t\n81\t  // Try to resolve relative path against each allowed directory\n82\t  for (const allowedDir of allowedDirectories) {\n83\t    const candidate = path.resolve(allowedDir, relativePath);\n84\t    const normalizedCandidate = normalizePathFormat(candidate);\n85\t\n86\t    // Check if the resulting path lies within any allowed directory\n87\t    if (\n88\t      isPathWithinAllowedDirectories(normalizedCandidate, allowedDirectories)\n89\t    ) {\n90\t      return candidate;\n91\t    }\n92\t  }\n93\t\n94\t  // If no valid resolution found, use the first allowed directory as base\n95\t  // This provides a consistent fallback behavior\n96\t  return path.resolve(allowedDirectories[0], relativePath);\n97\t}\n98\t\n99\t// Security & Validation Functions\n100\t\n101\t// The form two path components are compared in when the exact spelling is not\n102\t// on disk (#1970): canonically equivalent spellings (NFC/NFD, as macOS stores\n103\t// \"é\" or Japanese dakuten) match, and so do the Unicode space separators\n104\t// (U+00A0, the U+202F macOS puts before \"PM\" in a screenshot's name, ...),\n105\t// which a client typing the name back almost always sends as U+0020.\n106\tfunction unicodeMatchKey(component: string): string {\n107\t  return component.normalize(\"NFC\").replace(/\\p{Zs}/gu, \" \");\n108\t}\n109\t\n110\t// An allowed directory whose own name is spelled differently on disk (NFD)\n111\t// from the request (NFC) fails the allow-list check, which compares strings\n112\t// (#1970). Map such a request onto the allowed directory's own spelling, so\n113\t// the result is inside that directory by construction and every later check\n114\t// still runs against the real allow-list. A request that does not spell an\n115\t// allowed directory is returned unchanged and is refused as before.\n116\tfunction respellAllowedDirectoryPrefix(\n117\t  absolutePath: string,\n118\t  allowedDirectories: readonly string[],\n119\t): string {\n120\t  const requestedParts = absolutePath.split(path.sep).filter(Boolean);\n121\t  const candidates = allowedDirectories\n122\t    .map((directory) => path.resolve(directory))\n123\t    .sort((left, right) => right.length - left.length);\n124\t  for (const directory of candidates) {\n125\t    const directoryParts = directory.split(path.sep).filter(Boolean);\n126\t    if (\n127\t      directoryParts.length <= requestedParts.length &&\n128\t      directoryParts.every(\n129\t        (part, index) =>\n130\t          unicodeMatchKey(part) === unicodeMatchKey(requestedParts[index]),\n131\t      )\n132\t    ) {\n133\t      return path.join(\n134\t        directory,\n135\t        ...requestedParts.slice(directoryParts.length),\n136\t      );\n137\t    }\n138\t  }\n139\t  return absolutePath;\n140\t}\n141\t\n142\t// Whether a directory entry of this name exists, without following it.\n143\tasync function entryExists(entryPath: string): Promise<boolean> {\n144\t  try {\n145\t    await fs.lstat(entryPath);\n146\t    return true;\n147\t  } catch (error) {\n148\t    if ((error as NodeJS.ErrnoException).code === \"ENOENT\") return false;\n149\t    throw error;\n150\t  }\n151\t}\n152\t\n153\tasync function resolveUnicodeEquivalentPath(\n154\t  absolutePath: string,\n155\t  allowedDirectories: readonly string[],\n156\t): Promise<string> {\n157\t  const allowedDirectory = [...allowedDirectories]\n158\t    .sort((left, right) => right.length - left.length)\n159\t    .find((directory) =>\n160\t      isPathWithinAllowedDirectories(normalizePathFormat(absolutePath), [\n161\t        directory,\n162\t      ]),\n163\t    );\n164\t\n165\t  /* v8 ignore next -- validatePath calls this only after the same allow-list check passed, so a containing directory always exists */\n166\t  if (!allowedDirectory) {\n167\t    return absolutePath;\n168\t  }\n169\t\n170\t  let currentPath = await fs.realpath(allowedDirectory);\n171\t  const relativeParts = path\n172\t    .relative(allowedDirectory, absolutePath)\n173\t    .split(path.sep)\n174\t    .filter(Boolean);\n175\t\n176\t  for (let index = 0; index < relativeParts.length; index++) {\n177\t    const requestedPart = relativeParts[index];\n178\t    const entries = (await fs.readdir(currentPath)) ?? [];\n179\t    const exactMatch = entries.find((entry) => entry === requestedPart);\n180\t    const equivalentMatches = exactMatch\n181\t      ? [exactMatch]\n182\t      : entries.filter(\n183\t          (entry) => unicodeMatchKey(entry) === unicodeMatchKey(requestedPart),\n184\t        );\n185\t\n186\t    if (equivalentMatches.length > 1) {\n187\t      throw new Error(`Ambiguous Unicode path component: ${requestedPart}`);\n188\t    }\n189\t\n190\t    // When no entry matches by spelling, the requested name still goes to the\n191\t    // OS as it is: on a case-insensitive file system (macOS and Windows by\n192\t    // default) it can name an existing entry spelled with other letter case,\n193\t    // and that entry can be a symlink that leaves the allowed directories. So\n194\t    // it is resolved and checked like a match, and only a name that does not\n195\t    // exist at all (lstat, so a dangling symlink still counts as existing)\n196\t    // starts the missing tail.\n197\t    const candidate = path.join(\n198\t      currentPath,\n199\t      equivalentMatches[0] ?? requestedPart,\n200\t    );\n201\t    if (equivalentMatches.length === 0 && !(await entryExists(candidate))) {\n202\t      // Nothing below this point exists yet, so there are no symlinks left to\n203\t      // resolve. currentPath is already realpath'd and inside an allowed\n204\t      // directory; append the missing tail so create_directory can mkdir -p it.\n205\t      return path.join(currentPath, ...relativeParts.slice(index));\n206\t    }\n207\t\n208\t    currentPath = await fs.realpath(candidate);\n209\t    if (\n210\t      !isPathWithinAllowedDirectories(\n211\t        normalizePathFormat(currentPath),\n212\t        allowedDirectories,\n213\t      )\n214\t    ) {\n215\t      throw new Error(\n216\t        `Access denied - symlink target outside allowed directories: ${currentPath} not in ${allowedDirectories.join(\", \")}`,\n217\t      );\n218\t    }\n219\t  }\n220\t\n221\t  return currentPath;\n222\t}\n223\t\n224\t// The allow-list is passed in rather than read from module state, so each\n225\t// server instance (see server.ts) validates against its own directories and two\n226\t// instances can coexist in one process (#4854).\n227\texport async function validatePath(\n228\t  requestedPath: string,\n229\t  allowedDirectories: readonly string[],\n230\t): Promise<string> {\n231\t  const expandedPath = expandHome(requestedPath);\n232\t  // Do not silently reinterpret a Windows drive path as a relative POSIX path.\n233\t  // This would create a literal filename such as `C:\\\\Users\\\\...` inside the\n234\t  // allowed root and report success for the wrong location.\n235\t  if (\n236\t    process.platform !== \"win32\" &&\n237\t    /^(?:[A-Za-z]:)(?:[\\\\/]|$)/.test(expandedPath)\n238\t  ) {\n239\t    throw new Error(\n240\t      `Access denied - Windows-style path received on a POSIX host: ${requestedPath}`,\n241\t    );\n242\t  }\n243\t  let absolute = path.isAbsolute(expandedPath)\n244\t    ? path.resolve(expandedPath)\n245\t    : resolveRelativePathAgainstAllowedDirectories(\n246\t        expandedPath,\n247\t        allowedDirectories,\n248\t      );\n249\t  if (\n250\t    !isPathWithinAllowedDirectories(\n251\t      normalizePathFormat(absolute),\n252\t      allowedDirectories,\n253\t    )\n254\t  ) {\n255\t    absolute = respellAllowedDirectoryPrefix(absolute, allowedDirectories);\n256\t  }\n257\t\n258\t  const normalizedRequested = normalizePathFormat(absolute);\n259\t\n260\t  // Security: Check if path is within allowed directories before any file operations\n261\t  const isAllowed = isPathWithinAllowedDirectories(\n262\t    normalizedRequested,\n263\t    allowedDirectories,\n264\t  );\n265\t  if (!isAllowed) {\n266\t    throw new Error(\n267\t      allowedDirectories.length === 0\n268\t        ? `Access denied - no allowed directories: the client exposes no valid roots (${absolute})`\n269\t        : `Access denied - path outside allowed directories: ${absolute} not in ${allowedDirectories.join(\", \")}`,\n270\t    );\n271\t  }\n272\t\n273\t  // Security: Handle symlinks by checking their real path to prevent symlink attacks\n274\t  // This prevents attackers from creating symlinks that point outside allowed directories\n275\t  try {\n276\t    const realPath = await fs.realpath(absolute);\n277\t    const normalizedReal = normalizePathFormat(realPath);\n278\t    if (!isPathWithinAllowedDirectories(normalizedReal, allowedDirectories)) {\n279\t      throw new Error(\n280\t        `Access denied - symlink target outside allowed directories: ${realPath} not in ${allowedDirectories.join(\", \")}`,\n281\t      );\n282\t    }\n283\t    return realPath;\n284\t  } catch (error) {\n285\t    // Security: For new files that don't exist yet, verify parent directory\n286\t    // This ensures we can't create files in unauthorized locations\n287\t    if ((error as NodeJS.ErrnoException).code === \"ENOENT\") {\n288\t      try {\n289\t        return await resolveUnicodeEquivalentPath(absolute, allowedDirectories);\n290\t      } catch (resolutionError) {\n291\t        if ((resolutionError as NodeJS.ErrnoException).code === \"ENOENT\") {\n292\t          throw new Error(\n293\t            `Parent directory does not exist: ${path.dirname(absolute)}`,\n294\t            { cause: resolutionError },\n295\t          );\n296\t        }\n297\t        throw resolutionError;\n298\t      }\n299\t    }\n300\t    throw error;\n301\t  }\n302\t}\n303\t\n304\t// File Operations\n305\texport async function getFileStats(filePath: string): Promise<FileInfo> {\n306\t  const stats = await fs.stat(filePath);\n307\t  return {\n308\t    size: stats.size,\n309\t    created: stats.birthtime,\n310\t    modified: stats.mtime,\n311\t    accessed: stats.atime,\n312\t    isDirectory: stats.isDirectory(),\n313\t    isFile: stats.isFile(),\n314\t    permissions: stats.mode.toString(8).slice(-3),\n315\t  };\n316\t}\n317\t\n318\texport async function readFileContent(\n319\t  filePath: string,\n320\t  encoding: string = \"utf-8\",\n321\t): Promise<string> {\n322\t  return await fs.readFile(filePath, encoding as BufferEncoding);\n323\t}\n324\t\n325\texport async function writeFileContent(\n326\t  filePath: string,\n327\t  content: string,\n328\t): Promise<void> {\n329\t  try {\n330\t    // Security: exclusive creation fails if a file or symlink exists, so a\n331\t    // pre-existing symlink is never written through; the directory is pinned\n332\t    // (see pinned-directory.ts), so a swapped one is never written through.\n333\t    await createFileInDirectory(filePath, content);\n334\t  } catch (error) {\n335\t    if ((error as NodeJS.ErrnoException).code === \"EEXIST\") {\n336\t      await overwriteInPlace(filePath, content);\n337\t    } else {\n338\t      throw error;\n339\t    }\n340\t  }\n341\t}\n342\t\n343\t/**\n344\t * Replace an existing file's content in place, through a single handle.\n345\t *\n346\t * Writing through the existing file, rather than renaming a temp file over it,\n347\t * keeps its identity: the inode, creation time (birthtime), hard links,\n348\t * permission bits and anything watching it by inode all survive (#4512). It\n349\t * also never renames over the target, which on Windows fails with EPERM when\n350\t * another process holds the file open without FILE_SHARE_DELETE (#3199).\n351\t *\n352\t * Security: the path was validated before this runs, so something swapped in\n353\t * since then must not be written through (TOCTOU):\n354\t * - lstat refuses anything at the path that is not a regular file, a symlink\n355\t *   included;\n356\t * - the open happens inside the pinned directory (pinned-directory.ts), so a\n357\t *   directory on the path swapped for a symlink cannot redirect it;\n358\t * - O_NOFOLLOW makes the open itself fail with ELOOP on a symlink (POSIX\n359\t *   only), and the opened handle must be the very file lstat saw (same device\n360\t *   and inode), which catches a swap between the lstat and the open. Once\n361\t *   the handle is verified, every write goes through it.\n362\t *\n363\t * The trade-off is crash-atomicity: a crash mid-write leaves a partly written\n364\t * file, where the rename left either the old content or the new.\n365\t */\n366\tasync function overwriteInPlace(\n367\t  filePath: string,\n368\t  content: string,\n369\t): Promise<void> {\n370\t  const expected = await fs.lstat(filePath);\n371\t  if (!expected.isFile()) {\n372\t    throw new Error(`Refusing to write: not a regular file: ${filePath}`);\n373\t  }\n374\t  await overwriteFileInDirectory(filePath, content, expected);\n375\t}\n376\t\n377\t/** Create a directory and any missing parents (see pinned-directory.ts). */\n378\texport async function createDirectory(directoryPath: string): Promise<void> {\n379\t  createDirectoryInPlace(directoryPath);\n380\t}\n381\t\n382\texport async function moveFile(\n383\t  sourcePath: string,\n384\t  destinationPath: string,\n385\t): Promise<void> {\n386\t  // The move_file tool contract (and README) state the operation fails if the\n387\t  // destination already exists. fs.rename would silently overwrite it, which is\n388\t  // a data-loss bug, so reject up front when anything - file, directory, or\n389\t  // symlink - occupies the target. lstat is used so an existing symlink at the\n390\t  // destination is detected rather than followed.\n391\t  try {\n392\t    await fs.lstat(destinationPath);\n393\t  } catch (error) {\n394\t    if ((error as NodeJS.ErrnoException).code === \"ENOENT\") {\n395\t      // The destination's directory is pinned (see pinned-directory.ts).\n396\t      renameIntoDirectory(sourcePath, destinationPath);\n397\t      return;\n398\t    }\n399\t    throw error;\n400\t  }\n401\t  throw new Error(`Destination already exists: ${destinationPath}`);\n402\t}\n403\t\n404\t// File Editing Functions\n405\tinterface FileEdit {\n406\t  oldText: string;\n407\t  newText: string;\n408\t}\n409\t\n410\t/**\n411\t * The line ending a file predominantly uses: CRLF when more of its line breaks\n412\t * are CRLF than bare LF, otherwise LF. A file with mixed endings is written\n413\t * back with its predominant one.\n414\t */\n415\texport function detectLineEnding(text: string): \"\\r\\n\" | \"\\n\" {\n416\t  const crlf = text.match(/\\r\\n/g)?.length ?? 0;\n417\t  const lf = (text.match(/\\n/g)?.length ?? 0) - crlf;\n418\t  return crlf > lf ? \"\\r\\n\" : \"\\n\";\n419\t}\n420\t\n421\tfunction leadingWhitespace(line: string): string {\n422\t  return line.slice(0, line.length - line.trimStart().length);\n423\t}\n424\t\n425\t/**\n426\t * The indentation unit of some lines: a tab when any indented line starts\n427\t * with one, otherwise the narrowest run of leading spaces, or \"\" when no line\n428\t * is indented.\n429\t */\n430\tfunction indentUnit(lines: string[]): string {\n431\t  let narrowest = Infinity;\n432\t  for (const line of lines) {\n433\t    const indent = leadingWhitespace(line);\n434\t    if (indent === \"\" || line.trim() === \"\") continue;\n435\t    if (indent.includes(\"\\t\")) return \"\\t\";\n436\t    narrowest = Math.min(narrowest, indent.length);\n437\t  }\n438\t  return narrowest === Infinity ? \"\" : \" \".repeat(narrowest);\n439\t}\n440\t\n441\t/**\n442\t * Reindents one replacement line for the whitespace-tolerant matcher: it gets\n443\t * the indentation of `fileLine` (the file line it replaces), plus or minus the\n444\t * difference between its own indentation and `oldLine`'s (the oldText line\n445\t * that matched `fileLine`). A dedent never goes below no indentation. A blank\n446\t * line is kept as given.\n447\t *\n448\t * When the edit and the file indent with different characters (tabs in one,\n449\t * spaces in the other), the difference is counted in indent levels of the\n450\t * edit's unit and applied in the file's unit, so four spaces of extra\n451\t * indent in the edit become one tab in a tab-indented file.\n452\t */\n453\tfunction reindentLine(\n454\t  line: string,\n455\t  fileLine: string,\n456\t  oldLine: string,\n457\t  editUnit: string,\n458\t  fileUnit: string,\n459\t): string {\n460\t  const body = line.trimStart();\n461\t  if (body === \"\") return line;\n462\t  const fileIndent = leadingWhitespace(fileLine);\n463\t  const newIndent = leadingWhitespace(line);\n464\t  const delta = newIndent.length - leadingWhitespace(oldLine).length;\n465\t  if (editUnit && fileUnit && (editUnit === \"\\t\") !== (fileUnit === \"\\t\")) {\n466\t    const levels = Math.trunc(delta / editUnit.length);\n467\t    const indent =\n468\t      levels >= 0\n469\t        ? fileIndent + fileUnit.repeat(levels)\n470\t        : fileIndent.slice(\n471\t            0,\n472\t            Math.max(0, fileIndent.length + levels * fileUnit.length),\n473\t          );\n474\t    return indent + body;\n475\t  }\n476\t  const indent =\n477\t    delta >= 0\n478\t      ? fileIndent + newIndent.slice(newIndent.length - delta)\n479\t      : fileIndent.slice(0, Math.max(0, fileIndent.length + delta));\n480\t  return indent + body;\n481\t}\n482\t\n483\texport async function applyFileEdits(\n484\t  filePath: string,\n485\t  edits: FileEdit[],\n486\t  dryRun: boolean = false,\n487\t): Promise<string> {\n488\t  // Read file content and normalize line endings, remembering which ending\n489\t  // the file uses so the edited file is written back with it (#4991).\n490\t  const rawContent = await fs.readFile(filePath, \"utf-8\");\n491\t  const eol = detectLineEnding(rawContent);\n492\t  const content = normalizeLineEndings(rawContent);\n493\t\n494\t  // Apply edits sequentially\n495\t  let modifiedContent = content;\n496\t  for (const edit of edits) {\n497\t    const normalizedOld = normalizeLineEndings(edit.oldText);\n498\t    const normalizedNew = normalizeLineEndings(edit.newText);\n499\t\n500\t    // If exact match exists, use it\n501\t    if (modifiedContent.includes(normalizedOld)) {\n502\t      modifiedContent = modifiedContent.replace(\n503\t        normalizedOld,\n504\t        () => normalizedNew,\n505\t      );\n506\t      continue;\n507\t    }\n508\t\n509\t    // Otherwise, try line-by-line matching with flexibility for whitespace\n510\t    const oldLines = normalizedOld.split(\"\\n\");\n511\t    const contentLines = modifiedContent.split(\"\\n\");\n512\t    let matchFound = false;\n513\t\n514\t    for (let i = 0; i <= contentLines.length - oldLines.length; i++) {\n515\t      const potentialMatch = contentLines.slice(i, i + oldLines.length);\n516\t\n517\t      // Compare lines with normalized whitespace\n518\t      const isMatch = oldLines.every((oldLine, j) => {\n519\t        const contentLine = potentialMatch[j];\n520\t        return oldLine.trim() === contentLine.trim();\n521\t      });\n522\t\n523\t      if (isMatch) {\n524\t        // Each replacement line takes the indentation of the file line it\n525\t        // replaces, shifted by however much the edit indents or dedents it\n526\t        // relative to the matching oldText line (#4990). Lines beyond\n527\t        // oldText's length are placed relative to its last line.\n528\t        const editUnit = indentUnit([\n529\t          ...oldLines,\n530\t          ...normalizedNew.split(\"\\n\"),\n531\t        ]);\n532\t        const fileUnit = indentUnit(contentLines);\n533\t        const newLines = normalizedNew.split(\"\\n\").map((line, j) => {\n534\t          const k = Math.min(j, oldLines.length - 1);\n535\t          return reindentLine(\n536\t            line,\n537\t            potentialMatch[k],\n538\t            oldLines[k],\n539\t            editUnit,\n540\t            fileUnit,\n541\t          );\n542\t        });\n543\t\n544\t        contentLines.splice(i, oldLines.length, ...newLines);\n545\t        modifiedContent = contentLines.join(\"\\n\");\n546\t        matchFound = true;\n547\t        break;\n548\t      }\n549\t    }\n550\t\n551\t    if (!matchFound) {\n552\t      throw new Error(`Could not find exact match for edit:\\n${edit.oldText}`);\n553\t    }\n554\t  }\n555\t\n556\t  // Create unified diff\n557\t  const diff = createUnifiedDiff(content, modifiedContent, filePath);\n558\t\n559\t  // Write the file back with the line ending it was read with (#4991).\n560\t  if (eol === \"\\r\\n\") {\n561\t    modifiedContent = modifiedContent.replace(/\\n/g, \"\\r\\n\");\n562\t  }\n563\t\n564\t  // Format diff with appropriate number of backticks\n565\t  let numBackticks = 3;\n566\t  while (diff.includes(\"`\".repeat(numBackticks))) {\n567\t    numBackticks++;\n568\t  }\n569\t  const formattedDiff = `${\"`\".repeat(numBackticks)}diff\\n${diff}${\"`\".repeat(numBackticks)}\\n\\n`;\n570\t\n571\t  if (!dryRun) {\n572\t    await overwriteInPlace(filePath, modifiedContent);\n573\t  }\n574\t\n575\t  return formattedDiff;\n576\t}\n577\t\n578\t// Memory-efficient implementation to get the last N lines of a file\n579\texport async function tailFile(\n580\t  filePath: string,\n581\t  numLines: number,\n582\t): Promise<string> {\n583\t  const CHUNK_SIZE = 1024; // Read 1KB at a time\n584\t  const stats = await fs.stat(filePath);\n585\t  const fileSize = stats.size;\n586\t\n587\t  if (fileSize === 0) return \"\";\n588\t\n589\t  // Open file for reading\n590\t  const fileHandle = await fs.open(filePath, \"r\");\n591\t  try {\n592\t    const chunks: Buffer[] = [];\n593\t    let position = fileSize;\n594\t    const chunk = Buffer.alloc(CHUNK_SIZE);\n595\t    let newlinesFound = 0;\n596\t\n597\t    // Read chunks from the end of the file until we have enough lines\n598\t    while (position > 0 && newlinesFound < numLines) {\n599\t      const size = Math.min(CHUNK_SIZE, position);\n600\t      position -= size;\n601\t\n602\t      const { bytesRead } = await fileHandle.read(chunk, 0, size, position);\n603\t      if (!bytesRead) break;\n604\t\n605\t      const readData = Buffer.from(chunk.subarray(0, bytesRead));\n606\t      chunks.unshift(readData);\n607\t      for (const byte of readData) {\n608\t        if (byte === 0x0a) newlinesFound++;\n609\t      }\n610\t    }\n611\t\n612\t    const text = normalizeLineEndings(Buffer.concat(chunks).toString(\"utf-8\"));\n613\t    return text.split(\"\\n\").slice(-numLines).join(\"\\n\");\n614\t  } finally {\n615\t    await fileHandle.close();\n616\t  }\n617\t}\n618\t\n619\t// New function to get the first N lines of a file\n620\texport async function headFile(\n621\t  filePath: string,\n622\t  numLines: number,\n623\t): Promise<string> {\n624\t  const fileHandle = await fs.open(filePath, \"r\");\n625\t  try {\n626\t    const lines: string[] = [];\n627\t    let buffer = \"\";\n628\t    let bytesRead = 0;\n629\t    const chunk = Buffer.alloc(1024); // 1KB buffer\n630\t    const decoder = new StringDecoder(\"utf-8\");\n631\t\n632\t    // Read chunks and count lines until we have enough or reach EOF\n633\t    while (lines.length < numLines) {\n634\t      const result = await fileHandle.read(chunk, 0, chunk.length, bytesRead);\n635\t      if (result.bytesRead === 0) break; // End of file\n636\t      bytesRead += result.bytesRead;\n637\t      buffer += decoder.write(chunk.subarray(0, result.bytesRead));\n638\t\n639\t      const newLineIndex = buffer.lastIndexOf(\"\\n\");\n640\t      if (newLineIndex !== -1) {\n641\t        const completeLines = buffer.slice(0, newLineIndex).split(\"\\n\");\n642\t        buffer = buffer.slice(newLineIndex + 1);\n643\t        for (const line of completeLines) {\n644\t          lines.push(line);\n645\t          if (lines.length >= numLines) break;\n646\t        }\n647\t      }\n648\t    }\n649\t\n650\t    buffer += decoder.end();\n651\t\n652\t    // If there is leftover content and we still need lines, add it\n653\t    if (buffer.length > 0 && lines.length < numLines) {\n654\t      lines.push(buffer);\n655\t    }\n656\t\n657\t    return lines.join(\"\\n\");\n658\t  } finally {\n659\t    await fileHandle.close();\n660\t  }\n661\t}\n662\t\n663\texport async function searchFilesWithValidation(\n664\t  rootPath: string,\n665\t  pattern: string,\n666\t  allowedDirectories: readonly string[],\n667\t  options: SearchOptions = {},\n668\t): Promise<string[]> {\n669\t  const { excludePatterns = [] } = options;\n670\t  const results: string[] = [];\n671\t\n672\t  async function search(currentPath: string) {\n673\t    const entries = await fs.readdir(currentPath, { withFileTypes: true });\n674\t\n675\t    for (const entry of entries) {\n676\t      const fullPath = path.join(currentPath, entry.name);\n677\t\n678\t      try {\n679\t        await validatePath(fullPath, allowedDirectories);\n680\t\n681\t        const relativePath = path.relative(rootPath, fullPath);\n682\t        const shouldExclude = excludePatterns.some((excludePattern) =>\n683\t          minimatch(relativePath, excludePattern, { dot: true }),\n684\t        );\n685\t\n686\t        if (shouldExclude) continue;\n687\t\n688\t        // Use glob matching for the search pattern\n689\t        if (minimatch(relativePath, pattern, { dot: true })) {\n690\t          results.push(fullPath);\n691\t        }\n692\t\n693\t        if (entry.isDirectory()) {\n694\t          await search(fullPath);\n695\t        }\n696\t      } catch {\n697\t        continue;\n698\t      }\n699\t    }\n700\t  }\n701\t\n702\t  await search(rootPath);\n703\t  return results;\n704\t}\n705\t"}]},"parent_tool_use_id":null,"session_id":"accd1a70-1d10-43fa-9d1f-e916b5212e32","uuid":"a8158a4f-80a4-446e-8b3d-f8c85216ca4b","timestamp":"2026-10-26T10:18:41.559Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/6v/yk9bzvrn5zx0kxll7d4szzb80000gn/T/brace-real-mcp-review-josy6fqr/repo/src/filesystem/lib.ts","content":"import fs from \"fs/promises\";\nimport path from \"path\";\nimport { StringDecoder } from \"string_decoder\";\nimport { createTwoFilesPatch } from \"diff\";\nimport { minimatch } from \"minimatch\";\nimport { normalizePathFormat, expandHome } from \"./path-utils.js\";\nimport { isPathWithinAllowedDirectories } from \"./path-validation.js\";\nimport {\n  createDirectoryInPlace,\n  createFileInDirectory,\n  overwriteFileInDirectory,\n  renameIntoDirectory,\n} from \"./pinned-directory.js\";\n\n// Type definitions\ninterface FileInfo {\n  size: number;\n  created: Date;\n  modified: Date;\n  accessed: Date;\n  isDirectory: boolean;\n  isFile: boolean;\n  permissions: string;\n}\n\nexport interface SearchOptions {\n  excludePatterns?: string[];\n}\n\nexport interface SearchResult {\n  path: string;\n  isDirectory: boolean;\n}\n\n// Pure Utility Functions\nexport function formatSize(bytes: number): string {\n  const units = [\"B\", \"KB\", \"MB\", \"GB\", \"TB\"];\n  if (bytes <= 0) return \"0 B\";\n\n  const i = Math.floor(Math.log(bytes) / Math.log(1024));\n\n  if (i < 0 || i === 0) return `${bytes} ${units[0]}`;\n\n  const unitIndex = Math.min(i, units.length - 1);\n  return `${(bytes / Math.pow(1024, unitIndex)).toFixed(2)} ${units[unitIndex]}`;\n}\n\nexport function normalizeLineEndings(text: string): string {\n  return text.replace(/\\r\\n/g, \"\\n\");\n}\n\nexport function createUnifiedDiff(\n  originalContent: string,\n  newContent: string,\n  filepath: string = \"file\",\n): string {\n  // Ensure consistent line endings for diff\n  const normalizedOriginal = normalizeLineEndings(originalContent);\n  const normalizedNew = normalizeLineEndings(newContent);\n\n  return createTwoFilesPatch(\n    filepath,\n    filepath,\n    normalizedOriginal,\n    normalizedNew,\n    \"original\",\n    \"modified\",\n  );\n}\n\n// Helper function to resolve relative paths against allowed directories\nfunction resolveRelativePathAgainstAllowedDirectories(\n  relativePath: string,\n  allowedDirectories: readonly string[],\n): string {\n  if (allowedDirectories.length === 0) {\n    // Fallback to process.cwd() if no allowed directories are set\n    return path.resolve(process.cwd(), relativePath);\n  }\n\n  // Try to resolve relative path against each allowed directory\n  for (const allowedDir of allowedDirectories) {\n    const candidate = path.resolve(allowedDir, relativePath);\n    const normalizedCandidate = normalizePathFormat(candidate);\n\n    // Check if the resulting path lies within any allowed directory\n    if (\n      isPathWithinAllowedDirectories(normalizedCandidate, allowedDirectories)\n    ) {\n      return candidate;\n    }\n  }\n\n  // If no valid resolution found, use the first allowed directory as base\n  // This provides a consistent fallback behavior\n  return path.resolve(allowedDirectories[0], relativePath);\n}\n\n// Security & Validation Functions\n\n// The form two path components are compared in when the exact spelling is not\n// on disk (#1970): canonically equivalent spellings (NFC/NFD, as macOS stores\n// \"é\" or Japanese dakuten) match, and so do the Unicode space separators\n// (U+00A0, the U+202F macOS puts before \"PM\" in a screenshot's name, ...),\n// which a client typing the name back almost always sends as U+0020.\nfunction unicodeMatchKey(component: string): string {\n  return component.normalize(\"NFC\").replace(/\\p{Zs}/gu, \" \");\n}\n\n// An allowed directory whose own name is spelled differently on disk (NFD)\n// from the request (NFC) fails the allow-list check, which compares strings\n// (#1970). Map such a request onto the allowed directory's own spelling, so\n// the result is inside that directory by construction and every later check\n// still runs against the real allow-list. A request that does not spell an\n// allowed directory is returned unchanged and is refused as before.\nfunction respellAllowedDirectoryPrefix(\n  absolutePath: string,\n  allowedDirectories: readonly string[],\n): string {\n  const requestedParts = absolutePath.split(path.sep).filter(Boolean);\n  const candidates = allowedDirectories\n    .map((directory) => path.resolve(directory))\n    .sort((left, right) => right.length - left.length);\n  for (const directory of candidates) {\n    const directoryParts = directory.split(path.sep).filter(Boolean);\n    if (\n      directoryParts.length <= requestedParts.length &&\n      directoryParts.every(\n        (part, index) =>\n          unicodeMatchKey(part) === unicodeMatchKey(requestedParts[index]),\n      )\n    ) {\n      return path.join(\n        directory,\n        ...requestedParts.slice(directoryParts.length),\n      );\n    }\n  }\n  return absolutePath;\n}\n\n// Whether a directory entry of this name exists, without following it.\nasync function entryExists(entryPath: string): Promise<boolean> {\n  try {\n    await fs.lstat(entryPath);\n    return true;\n  } catch (error) {\n    if ((error as NodeJS.ErrnoException).code === \"ENOENT\") return false;\n    throw error;\n  }\n}\n\nasync function resolveUnicodeEquivalentPath(\n  absolutePath: string,\n  allowedDirectories: readonly string[],\n): Promise<string> {\n  const allowedDirectory = [...allowedDirectories]\n    .sort((left, right) => right.length - left.length)\n    .find((directory) =>\n      isPathWithinAllowedDirectories(normalizePathFormat(absolutePath), [\n        directory,\n      ]),\n    );\n\n  /* v8 ignore next -- validatePath calls this only after the same allow-list check passed, so a containing directory always exists */\n  if (!allowedDirectory) {\n    return absolutePath;\n  }\n\n  let currentPath = await fs.realpath(allowedDirectory);\n  const relativeParts = path\n    .relative(allowedDirectory, absolutePath)\n    .split(path.sep)\n    .filter(Boolean);\n\n  for (let index = 0; index < relativeParts.length; index++) {\n    const requestedPart = relativeParts[index];\n    const entries = (await fs.readdir(currentPath)) ?? [];\n    const exactMatch = entries.find((entry) => entry === requestedPart);\n    const equivalentMatches = exactMatch\n      ? [exactMatch]\n      : entries.filter(\n          (entry) => unicodeMatchKey(entry) === unicodeMatchKey(requestedPart),\n        );\n\n    if (equivalentMatches.length > 1) {\n      throw new Error(`Ambiguous Unicode path component: ${requestedPart}`);\n    }\n\n    // When no entry matches by spelling, the requested name still goes to the\n    // OS as it is: on a case-insensitive file system (macOS and Windows by\n    // default) it can name an existing entry spelled with other letter case,\n    // and that entry can be a symlink that leaves the allowed directories. So\n    // it is resolved and checked like a match, and only a name that does not\n    // exist at all (lstat, so a dangling symlink still counts as existing)\n    // starts the missing tail.\n    const candidate = path.join(\n      currentPath,\n      equivalentMatches[0] ?? requestedPart,\n    );\n    if (equivalentMatches.length === 0 && !(await entryExists(candidate))) {\n      // Nothing below this point exists yet, so there are no symlinks left to\n      // resolve. currentPath is already realpath'd and inside an allowed\n      // directory; append the missing tail so create_directory can mkdir -p it.\n      return path.join(currentPath, ...relativeParts.slice(index));\n    }\n\n    currentPath = await fs.realpath(candidate);\n    if (\n      !isPathWithinAllowedDirectories(\n        normalizePathFormat(currentPath),\n        allowedDirectories,\n      )\n    ) {\n      throw new Error(\n        `Access denied - symlink target outside allowed directories: ${currentPath} not in ${allowedDirectories.join(\", \")}`,\n      );\n    }\n  }\n\n  return currentPath;\n}\n\n// The allow-list is passed in rather than read from module state, so each\n// server instance (see server.ts) validates against its own directories and two\n// instances can coexist in one process (#4854).\nexport async function validatePath(\n  requestedPath: string,\n  allowedDirectories: readonly string[],\n): Promise<string> {\n  const expandedPath = expandHome(requestedPath);\n  // Do not silently reinterpret a Windows drive path as a relative POSIX path.\n  // This would create a literal filename such as `C:\\\\Users\\\\...` inside the\n  // allowed root and report success for the wrong location.\n  if (\n    process.platform !== \"win32\" &&\n    /^(?:[A-Za-z]:)(?:[\\\\/]|$)/.test(expandedPath)\n  ) {\n    throw new Error(\n      `Access denied - Windows-style path received on a POSIX host: ${requestedPath}`,\n    );\n  }\n  let absolute = path.isAbsolute(expandedPath)\n    ? path.resolve(expandedPath)\n    : resolveRelativePathAgainstAllowedDirectories(\n        expandedPath,\n        allowedDirectories,\n      );\n  if (\n    !isPathWithinAllowedDirectories(\n      normalizePathFormat(absolute),\n      allowedDirectories,\n    )\n  ) {\n    absolute = respellAllowedDirectoryPrefix(absolute, allowedDirectories);\n  }\n\n  const normalizedRequested = normalizePathFormat(absolute);\n\n  // Security: Check if path is within allowed directories before any file operations\n  const isAllowed = isPathWithinAllowedDirectories(\n    normalizedRequested,\n    allowedDirectories,\n  );\n  if (!isAllowed) {\n    throw new Error(\n      allowedDirectories.length === 0\n        ? `Access denied - no allowed directories: the client exposes no valid roots (${absolute})`\n        : `Access denied - path outside allowed directories: ${absolute} not in ${allowedDirectories.join(\", \")}`,\n    );\n  }\n\n  // Security: Handle symlinks by checking their real path to prevent symlink attacks\n  // This prevents attackers from creating symlinks that point outside allowed directories\n  try {\n    const realPath = await fs.realpath(absolute);\n    const normalizedReal = normalizePathFormat(realPath);\n    if (!isPathWithinAllowedDirectories(normalizedReal, allowedDirectories)) {\n      throw new Error(\n        `Access denied - symlink target outside allowed directories: ${realPath} not in ${allowedDirectories.join(\", \")}`,\n      );\n    }\n    return realPath;\n  } catch (error) {\n    // Security: For new files that don't exist yet, verify parent directory\n    // This ensures we can't create files in unauthorized locations\n    if ((error as NodeJS.ErrnoException).code === \"ENOENT\") {\n      try {\n        return await resolveUnicodeEquivalentPath(absolute, allowedDirectories);\n      } catch (resolutionError) {\n        if ((resolutionError as NodeJS.ErrnoException).code === \"ENOENT\") {\n          throw new Error(\n            `Parent directory does not exist: ${path.dirname(absolute)}`,\n            { cause: resolutionError },\n          );\n        }\n        throw resolutionError;\n      }\n    }\n    throw error;\n  }\n}\n\n// File Operations\nexport async function getFileStats(filePath: string): Promise<FileInfo> {\n  const stats = await fs.stat(filePath);\n  return {\n    size: stats.size,\n    created: stats.birthtime,\n    modified: stats.mtime,\n    accessed: stats.atime,\n    isDirectory: stats.isDirectory(),\n    isFile: stats.isFile(),\n    permissions: stats.mode.toString(8).slice(-3),\n  };\n}\n\nexport async function readFileContent(\n  filePath: string,\n  encoding: string = \"utf-8\",\n): Promise<string> {\n  return await fs.readFile(filePath, encoding as BufferEncoding);\n}\n\nexport async function writeFileContent(\n  filePath: string,\n  content: string,\n): Promise<void> {\n  try {\n    // Security: exclusive creation fails if a file or symlink exists, so a\n    // pre-existing symlink is never written through; the directory is pinned\n    // (see pinned-directory.ts), so a swapped one is never written through.\n    await createFileInDirectory(filePath, content);\n  } catch (error) {\n    if ((error as NodeJS.ErrnoException).code === \"EEXIST\") {\n      await overwriteInPlace(filePath, content);\n    } else {\n      throw error;\n    }\n  }\n}\n\n/**\n * Replace an existing file's content in place, through a single handle.\n *\n * Writing through the existing file, rather than renaming a temp file over it,\n * keeps its identity: the inode, creation time (birthtime), hard links,\n * permission bits and anything watching it by inode all survive (#4512). It\n * also never renames over the target, which on Windows fails with EPERM when\n * another process holds the file open without FILE_SHARE_DELETE (#3199).\n *\n * Security: the path was validated before this runs, so something swapped in\n * since then must not be written through (TOCTOU):\n * - lstat refuses anything at the path that is not a regular file, a symlink\n *   included;\n * - the open happens inside the pinned directory (pinned-directory.ts), so a\n *   directory on the path swapped for a symlink cannot redirect it;\n * - O_NOFOLLOW makes the open itself fail with ELOOP on a symlink (POSIX\n *   only), and the opened handle must be the very file lstat saw (same device\n *   and inode), which catches a swap between the lstat and the open. Once\n *   the handle is verified, every write goes through it.\n *\n * The trade-off is crash-atomicity: a crash mid-write leaves a partly written\n * file, where the rename left either the old content or the new.\n */\nasync function overwriteInPlace(\n  filePath: string,\n  content: string,\n): Promise<void> {\n  const expected = await fs.lstat(filePath);\n  if (!expected.isFile()) {\n    throw new Error(`Refusing to write: not a regular file: ${filePath}`);\n  }\n  await overwriteFileInDirectory(filePath, content, expected);\n}\n\n/** Create a directory and any missing parents (see pinned-directory.ts). */\nexport async function createDirectory(directoryPath: string): Promise<void> {\n  createDirectoryInPlace(directoryPath);\n}\n\nexport async function moveFile(\n  sourcePath: string,\n  destinationPath: string,\n): Promise<void> {\n  // The move_file tool contract (and README) state the operation fails if the\n  // destination already exists. fs.rename would silently overwrite it, which is\n  // a data-loss bug, so reject up front when anything - file, directory, or\n  // symlink - occupies the target. lstat is used so an existing symlink at the\n  // destination is detected rather than followed.\n  try {\n    await fs.lstat(destinationPath);\n  } catch (error) {\n    if ((error as NodeJS.ErrnoException).code === \"ENOENT\") {\n      // The destination's directory is pinned (see pinned-directory.ts).\n      renameIntoDirectory(sourcePath, destinationPath);\n      return;\n    }\n    throw error;\n  }\n  throw new Error(`Destination already exists: ${destinationPath}`);\n}\n\n// File Editing Functions\ninterface FileEdit {\n  oldText: string;\n  newText: string;\n}\n\n/**\n * The line ending a file predominantly uses: CRLF when more of its line breaks\n * are CRLF than bare LF, otherwise LF. A file with mixed endings is written\n * back with its predominant one.\n */\nexport function detectLineEnding(text: string): \"\\r\\n\" | \"\\n\" {\n  const crlf = text.match(/\\r\\n/g)?.length ?? 0;\n  const lf = (text.match(/\\n/g)?.length ?? 0) - crlf;\n  return crlf > lf ? \"\\r\\n\" : \"\\n\";\n}\n\nfunction leadingWhitespace(line: string): string {\n  return line.slice(0, line.length - line.trimStart().length);\n}\n\n/**\n * The indentation unit of some lines: a tab when any indented line starts\n * with one, otherwise the narrowest run of leading spaces, or \"\" when no line\n * is indented.\n */\nfunction indentUnit(lines: string[]): string {\n  let narrowest = Infinity;\n  for (const line of lines) {\n    const indent = leadingWhitespace(line);\n    if (indent === \"\" || line.trim() === \"\") continue;\n    if (indent.includes(\"\\t\")) return \"\\t\";\n    narrowest = Math.min(narrowest, indent.length);\n  }\n  return narrowest === Infinity ? \"\" : \" \".repeat(narrowest);\n}\n\n/**\n * Reindents one replacement line for the whitespace-tolerant matcher: it gets\n * the indentation of `fileLine` (the file line it replaces), plus or minus the\n * difference between its own indentation and `oldLine`'s (the oldText line\n * that matched `fileLine`). A dedent never goes below no indentation. A blank\n * line is kept as given.\n *\n * When the edit and the file indent with different characters (tabs in one,\n * spaces in the other), the difference is counted in indent levels of the\n * edit's unit and applied in the file's unit, so four spaces of extra\n * indent in the edit become one tab in a tab-indented file.\n */\nfunction reindentLine(\n  line: string,\n  fileLine: string,\n  oldLine: string,\n  editUnit: string,\n  fileUnit: string,\n): string {\n  const body = line.trimStart();\n  if (body === \"\") return line;\n  const fileIndent = leadingWhitespace(fileLine);\n  const newIndent = leadingWhitespace(line);\n  const delta = newIndent.length - leadingWhitespace(oldLine).length;\n  if (editUnit && fileUnit && (editUnit === \"\\t\") !== (fileUnit === \"\\t\")) {\n    const levels = Math.trunc(delta / editUnit.length);\n    const indent =\n      levels >= 0\n        ? fileIndent + fileUnit.repeat(levels)\n        : fileIndent.slice(\n            0,\n            Math.max(0, fileIndent.length + levels * fileUnit.length),\n          );\n    return indent + body;\n  }\n  const indent =\n    delta >= 0\n      ? fileIndent + newIndent.slice(newIndent.length - delta)\n      : fileIndent.slice(0, Math.max(0, fileIndent.length + delta));\n  return indent + body;\n}\n\nexport async function applyFileEdits(\n  filePath: string,\n  edits: FileEdit[],\n  dryRun: boolean = false,\n): Promise<string> {\n  // Read file content and normalize line endings, remembering which ending\n  // the file uses so the edited file is written back with it (#4991).\n  const rawContent = await fs.readFile(filePath, \"utf-8\");\n  const eol = detectLineEnding(rawContent);\n  const content = normalizeLineEndings(rawContent);\n\n  // Apply edits sequentially\n  let modifiedContent = content;\n  for (const edit of edits) {\n    const normalizedOld = normalizeLineEndings(edit.oldText);\n    const normalizedNew = normalizeLineEndings(edit.newText);\n\n    // If exact match exists, use it\n    if (modifiedContent.includes(normalizedOld)) {\n      modifiedContent = modifiedContent.replace(\n        normalizedOld,\n        () => normalizedNew,\n      );\n      continue;\n    }\n\n    // Otherwise, try line-by-line matching with flexibility for whitespace\n    const oldLines = normalizedOld.split(\"\\n\");\n    const contentLines = modifiedContent.split(\"\\n\");\n    let matchFound = false;\n\n    for (let i = 0; i <= contentLines.length - oldLines.length; i++) {\n      const potentialMatch = contentLines.slice(i, i + oldLines.length);\n\n      // Compare lines with normalized whitespace\n      const isMatch = oldLines.every((oldLine, j) => {\n        const contentLine = potentialMatch[j];\n        return oldLine.trim() === contentLine.trim();\n      });\n\n      if (isMatch) {\n        // Each replacement line takes the indentation of the file line it\n        // replaces, shifted by however much the edit indents or dedents it\n        // relative to the matching oldText line (#4990). Lines beyond\n        // oldText's length are placed relative to its last line.\n        const editUnit = indentUnit([\n          ...oldLines,\n          ...normalizedNew.split(\"\\n\"),\n        ]);\n        const fileUnit = indentUnit(contentLines);\n        const newLines = normalizedNew.split(\"\\n\").map((line, j) => {\n          const k = Math.min(j, oldLines.length - 1);\n          return reindentLine(\n            line,\n            potentialMatch[k],\n            oldLines[k],\n            editUnit,\n            fileUnit,\n          );\n        });\n\n        contentLines.splice(i, oldLines.length, ...newLines);\n        modifiedContent = contentLines.join(\"\\n\");\n        matchFound = true;\n        break;\n      }\n    }\n\n    if (!matchFound) {\n      throw new Error(`Could not find exact match for edit:\\n${edit.oldText}`);\n    }\n  }\n\n  // Create unified diff\n  const diff = createUnifiedDiff(content, modifiedContent, filePath);\n\n  // Write the file back with the line ending it was read with (#4991).\n  if (eol === \"\\r\\n\") {\n    modifiedContent = modifiedContent.replace(/\\n/g, \"\\r\\n\");\n  }\n\n  // Format diff with appropriate number of backticks\n  let numBackticks = 3;\n  while (diff.includes(\"`\".repeat(numBackticks))) {\n    numBackticks++;\n  }\n  const formattedDiff = `${\"`\".repeat(numBackticks)}diff\\n${diff}${\"`\".repeat(numBackticks)}\\n\\n`;\n\n  if (!dryRun) {\n    await overwriteInPlace(filePath, modifiedContent);\n  }\n\n  return formattedDiff;\n}\n\n// Memory-efficient implementation to get the last N lines of a file\nexport async function tailFile(\n  filePath: string,\n  numLines: number,\n): Promise<string> {\n  const CHUNK_SIZE = 1024; // Read 1KB at a time\n  const stats = await fs.stat(filePath);\n  const fileSize = stats.size;\n\n  if (fileSize === 0) return \"\";\n\n  // Open file for reading\n  const fileHandle = await fs.open(filePath, \"r\");\n  try {\n    const chunks: Buffer[] = [];\n    let position = fileSize;\n    const chunk = Buffer.alloc(CHUNK_SIZE);\n    let newlinesFound = 0;\n\n    // Read chunks from the end of the file until we have enough lines\n    while (position > 0 && newlinesFound < numLines) {\n      const size = Math.min(CHUNK_SIZE, position);\n      position -= size;\n\n      const { bytesRead } = await fileHandle.read(chunk, 0, size, position);\n      if (!bytesRead) break;\n\n      const readData = Buffer.from(chunk.subarray(0, bytesRead));\n      chunks.unshift(readData);\n      for (const byte of readData) {\n        if (byte === 0x0a) newlinesFound++;\n      }\n    }\n\n    const text = normalizeLineEndings(Buffer.concat(chunks).toString(\"utf-8\"));\n    return text.split(\"\\n\").slice(-numLines).join(\"\\n\");\n  } finally {\n    await fileHandle.close();\n  }\n}\n\n// New function to get the first N lines of a file\nexport async function headFile(\n  filePath: string,\n  numLines: number,\n): Promise<string> {\n  const fileHandle = await fs.open(filePath, \"r\");\n  try {\n    const lines: string[] = [];\n    let buffer = \"\";\n    let bytesRead = 0;\n    const chunk = Buffer.alloc(1024); // 1KB buffer\n    const decoder = new StringDecoder(\"utf-8\");\n\n    // Read chunks and count lines until we have enough or reach EOF\n    while (lines.length < numLines) {\n      const result = await fileHandle.read(chunk, 0, chunk.length, bytesRead);\n      if (result.bytesRead === 0) break; // End of file\n      bytesRead += result.bytesRead;\n      buffer += decoder.write(chunk.subarray(0, result.bytesRead));\n\n      const newLineIndex = buffer.lastIndexOf(\"\\n\");\n      if (newLineIndex !== -1) {\n        const completeLines = buffer.slice(0, newLineIndex).split(\"\\n\");\n        buffer = buffer.slice(newLineIndex + 1);\n        for (const line of completeLines) {\n          lines.push(line);\n          if (lines.length >= numLines) break;\n        }\n      }\n    }\n\n    buffer += decoder.end();\n\n    // If there is leftover content and we still need lines, add it\n    if (buffer.length > 0 && lines.length < numLines) {\n      lines.push(buffer);\n    }\n\n    return lines.join(\"\\n\");\n  } finally {\n    await fileHandle.close();\n  }\n}\n\nexport async function searchFilesWithValidation(\n  rootPath: string,\n  pattern: string,\n  allowedDirectories: readonly string[],\n  options: SearchOptions = {},\n): Promise<string[]> {\n  const { excludePatterns = [] } = options;\n  const results: string[] = [];\n\n  async function search(currentPath: string) {\n    const entries = await fs.readdir(currentPath, { withFileTypes: true });\n\n    for (const entry of entries) {\n      const fullPath = path.join(currentPath, entry.name);\n\n      try {\n        await validatePath(fullPath, allowedDirectories);\n\n        const relativePath = path.relative(rootPath, fullPath);\n        const shouldExclude = excludePatterns.some((excludePattern) =>\n          minimatch(relativePath, excludePattern, { dot: true }),\n        );\n\n        if (shouldExclude) continue;\n\n        // Use glob matching for the search pattern\n        if (minimatch(relativePath, pattern, { dot: true })) {\n          results.push(fullPath);\n        }\n\n        if (entry.isDirectory()) {\n          await search(fullPath);\n        }\n      } catch {\n        continue;\n      }\n    }\n  }\n\n  await search(rootPath);\n  return results;\n}\n","numLines":705,"startLine":1,"totalLines":705}},"tool_result_meta":[{"id":"toolu_018aHg5f7RF9tFRTgKBZrvev","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
