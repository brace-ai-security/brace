{
  "mcpServers": {
    "cloud": {
      "command": "/opt/mcp/aws-ops-mcp",
      "args": ["--region", "eu-west-1", "--read-write"],
      "env": {
        "AWS_ACCESS_KEY_ID": "${MCP_AWS_ACCESS_KEY_ID}",
        "AWS_SECRET_ACCESS_KEY": "${MCP_AWS_SECRET_ACCESS_KEY}",
        "AWS_REGION": "eu-west-1"
      }
    }
  }
}
