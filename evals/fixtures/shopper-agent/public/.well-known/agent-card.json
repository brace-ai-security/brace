{
  "protocolVersion": "0.3.0",
  "name": "Shopper",
  "description": "Consumer shopping assistant. Accepts deal notifications from approved partners.",
  "url": "https://agent.shopper.app/a2a",
  "version": "1.8.2",
  "provider": { "organization": "Shopper Inc.", "url": "https://shopper.app" },
  "capabilities": { "streaming": false, "pushNotifications": true },
  "defaultInputModes": ["application/json"],
  "defaultOutputModes": ["application/json"],
  "securitySchemes": {
    "partnerJwt": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
  },
  "security": [{ "partnerJwt": [] }],
  "skills": [
    {
      "id": "deal-callback",
      "name": "Deal callback",
      "description": "Receives asynchronous coupon results for a pending deals query.",
      "tags": ["deals", "coupons"]
    }
  ]
}
