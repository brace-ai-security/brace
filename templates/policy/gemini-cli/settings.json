{
  "security": {
    "disableYoloMode": true,
    "folderTrust": {
      "enabled": true
    }
  },
  "tools": {
    "sandbox": true,
    "core": [
      "read_file",
      "read_many_files",
      "list_directory",
      "glob",
      "replace",
      "write_file",
      "run_shell_command(git status)",
      "run_shell_command(git diff)",
      "run_shell_command(npm test)"
    ],
    "exclude": [
      "web_fetch"
    ]
  },
  "mcp": {
    "allowed": [
      "github"
    ]
  }
}
